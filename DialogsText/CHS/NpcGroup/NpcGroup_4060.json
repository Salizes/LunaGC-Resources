{
    "groupId": "4060",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 8,
        "谢赫祖拜尔": 27
    },
    "talks": [
        {
            "talkId": "6406001",
            "initDialog": "640600101",
            "dialogues": [
                {
                    "id": "640600101",
                    "speaker": "谢赫祖拜尔",
                    "text": "你好，如果是来采访的记者，请恕我回绝。"
                }
            ]
        },
        {
            "talkId": "6406002",
            "initDialog": "640600201",
            "dialogues": [
                {
                    "id": "640600201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640600202",
                    "speaker": "谢赫祖拜尔",
                    "text": "我是剧作家和经理人，经营着这家树洞里的祖拜尔剧场。"
                },
                {
                    "id": "640600203",
                    "speaker": "谢赫祖拜尔",
                    "text": "此外，也做些作曲、编舞、舞台设计、动作指导等工作。"
                },
                {
                    "id": "640600204",
                    "speaker": "谢赫祖拜尔",
                    "text": "剧团的人不多，除了库洛什以外，大家差不多都身兼数职。"
                },
                {
                    "id": "640600205",
                    "speaker": "谢赫祖拜尔",
                    "text": "所以没什么要事的话，还请不要去打扰这里的工作人员，包括我。"
                }
            ]
        },
        {
            "talkId": "6406003",
            "initDialog": "640600301",
            "dialogues": [
                {
                    "id": "640600301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640600302",
                    "speaker": "谢赫祖拜尔",
                    "text": "不送。"
                }
            ]
        },
        {
            "talkId": "6406004",
            "initDialog": "640600401",
            "dialogues": [
                {
                    "id": "640600401",
                    "speaker": "Player",
                    "text": "关于库洛什…"
                },
                {
                    "id": "640600402",
                    "speaker": "谢赫祖拜尔",
                    "text": "他啊，天赋平平。演出动作僵硬，唱歌有时还没斯汪在调子上。"
                },
                {
                    "id": "640600403",
                    "speaker": "谢赫祖拜尔",
                    "text": "唯一的优点就是百折不挠，至今还没放弃演员这份工作。"
                },
                {
                    "id": "640600404",
                    "speaker": "谢赫祖拜尔",
                    "text": "我是一个有着很高标准的人，但唯独不会放弃执着的学生。只要他还诚心接受批评，我就还愿意指导他。"
                },
                {
                    "id": "640600405",
                    "speaker": "谢赫祖拜尔",
                    "text": "毕竟，不能指望所有的演员都是像妮露一样的天才。"
                },
                {
                    "id": "640600406",
                    "speaker": "谢赫祖拜尔",
                    "text": "啊，提醒我了，关于新剧本的台词，我还得再给他讲讲…"
                }
            ]
        },
        {
            "talkId": "6406005",
            "initDialog": "640600501",
            "dialogues": [
                {
                    "id": "640600501",
                    "speaker": "谢赫祖拜尔",
                    "text": "哦，是你啊，欢迎光临剧场。"
                }
            ]
        },
        {
            "talkId": "6406006",
            "initDialog": "640600601",
            "dialogues": [
                {
                    "id": "640600601",
                    "speaker": "Player",
                    "text": "最近怎么样？"
                },
                {
                    "id": "640600602",
                    "speaker": "谢赫祖拜尔",
                    "text": "还是老样子，作为这里的剧作家和经纪人，我仍然在为经营之事而忙碌。"
                },
                {
                    "id": "640600603",
                    "speaker": "谢赫祖拜尔",
                    "text": "剧团的人不多，除了库洛什以外，大家差不多都身兼数职，我也做些作曲、编舞、舞台设计、动作指导等工作。"
                },
                {
                    "id": "640600604",
                    "speaker": "谢赫祖拜尔",
                    "text": "不过最近有了新人加入，我能有更多时间专注在一件事上，剧场也变得更热闹了。"
                }
            ]
        },
        {
            "talkId": "6406007",
            "initDialog": "640600701",
            "dialogues": [
                {
                    "id": "640600701",
                    "speaker": "Player",
                    "text": "关于妮露和阿娜耶…"
                },
                {
                    "id": "640600702",
                    "speaker": "谢赫祖拜尔",
                    "text": "妮露正在教她跳舞，说实话这个过程不太容易，跳舞应该从小练起。"
                },
                {
                    "id": "640600703",
                    "speaker": "谢赫祖拜尔",
                    "text": "但阿娜耶非常勤奋，除了完成妮露布置的舞蹈任务，还会自主加练。"
                },
                {
                    "id": "640600704",
                    "speaker": "谢赫祖拜尔",
                    "text": "按照现在的进度，或许再过几年，她就能达到登台演出的标准了。"
                },
                {
                    "id": "640600705",
                    "speaker": "谢赫祖拜尔",
                    "text": "要不是有妮露这样优秀又有耐心的老师在，这个时间估计还会翻倍。"
                }
            ]
        },
        {
            "talkId": "6406008",
            "initDialog": "640600801",
            "dialogues": [
                {
                    "id": "640600801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640600802",
                    "speaker": "谢赫祖拜尔",
                    "text": "以后常来。"
                }
            ]
        },
        {
            "talkId": "6406009",
            "initDialog": "640600901",
            "dialogues": [
                {
                    "id": "640600901",
                    "speaker": "Player",
                    "text": "关于库洛什…"
                },
                {
                    "id": "640600902",
                    "speaker": "谢赫祖拜尔",
                    "text": "他啊，天赋平平。演出动作僵硬，唱歌有时还没斯汪在调子上。"
                },
                {
                    "id": "640600903",
                    "speaker": "谢赫祖拜尔",
                    "text": "唯一的优点就是百折不挠，至今还没放弃演员这份工作。"
                },
                {
                    "id": "640600904",
                    "speaker": "谢赫祖拜尔",
                    "text": "我是一个有着很高标准的人，但唯独不会放弃执着的学生。只要他还诚心接受批评，我就还愿意指导他。"
                },
                {
                    "id": "640600905",
                    "speaker": "谢赫祖拜尔",
                    "text": "毕竟，不能指望所有的演员都是像妮露一样的天才。"
                },
                {
                    "id": "640600906",
                    "speaker": "谢赫祖拜尔",
                    "text": "啊，提醒我了，关于新剧本的台词，我还得再给他讲讲…"
                }
            ]
        },
        {
            "talkId": "6406010",
            "initDialog": "640601001",
            "dialogues": [
                {
                    "id": "640601001",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6406011",
            "initDialog": "640601101",
            "dialogues": [
                {
                    "id": "640601101",
                    "speaker": "谢赫祖拜尔",
                    "text": "…我还有要忙的事，好了，没事别来打扰我。"
                }
            ]
        },
        {
            "talkId": "6406012",
            "initDialog": "640601201",
            "dialogues": [
                {
                    "id": "640601201",
                    "speaker": "谢赫祖拜尔",
                    "text": "好了，输了就走吧，我还有其他事要做。"
                }
            ]
        }
    ]
}