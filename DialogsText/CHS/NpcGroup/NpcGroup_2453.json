{
    "groupId": "2453",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "阿泰": 10
    },
    "talks": [
        {
            "talkId": "6245301",
            "initDialog": "624530101",
            "dialogues": [
                {
                    "id": "624530101",
                    "speaker": "阿泰",
                    "text": "哟，来看看呗？每一件可都是不可多得的珍品！"
                }
            ]
        },
        {
            "talkId": "6245302",
            "initDialog": "624530201",
            "dialogues": [
                {
                    "id": "624530201",
                    "speaker": "Player",
                    "text": "你这里都有什么？"
                },
                {
                    "id": "624530202",
                    "speaker": "阿泰",
                    "text": "哟，怎么，您感兴趣？那我就给您挨个说道说道——"
                },
                {
                    "id": "624530203",
                    "speaker": "阿泰",
                    "text": "您先看这个瓷瓶，别看成色一般，但这年头可久了，价格能抵上半个吃虎岩！"
                },
                {
                    "id": "624530204",
                    "speaker": "阿泰",
                    "text": "然后您再看看这小香炉，据说在岩王爷的神像前供奉了千年之久，早就已经沾染上了仙风灵气！"
                },
                {
                    "id": "624530205",
                    "speaker": "阿泰",
                    "text": "还有这茶壶，乃是岩王爷曾经用过的茶壶，绝无仅有啊…"
                }
            ]
        },
        {
            "talkId": "6245303",
            "initDialog": "624530301",
            "dialogues": [
                {
                    "id": "624530301",
                    "speaker": "Player",
                    "text": "不用了，再见。"
                },
                {
                    "id": "624530302",
                    "speaker": "阿泰",
                    "text": "行，哪天有空再来，我来跟您好好讲讲。"
                }
            ]
        },
        {
            "talkId": "6245304",
            "initDialog": "624530401",
            "dialogues": [
                {
                    "id": "624530401",
                    "speaker": "Player",
                    "text": "那这些都多少钱卖呢？"
                },
                {
                    "id": "624530402",
                    "speaker": "阿泰",
                    "text": "卖？不好意思，没说要卖，多少钱都不卖。"
                }
            ]
        },
        {
            "talkId": "6245305",
            "initDialog": "624530501",
            "dialogues": [
                {
                    "id": "624530501",
                    "speaker": "Player",
                    "text": "不卖你为什么要开店…"
                },
                {
                    "id": "624530502",
                    "speaker": "阿泰",
                    "text": "欸，笑话。您这话说的，谁说开店就一定是做生意的？"
                },
                {
                    "id": "624530503",
                    "speaker": "阿泰",
                    "text": "这商铺我们老爷包下来，就是为了展示一下这些宝贝，跟街上的人显摆显摆。"
                },
                {
                    "id": "624530504",
                    "speaker": "阿泰",
                    "text": "每天都有像您这样的过路人，不知天高地厚来问价。不过这也就是老爷他想要达到的效果…"
                }
            ]
        }
    ]
}