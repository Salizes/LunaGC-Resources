{
    "groupId": "2615",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "嘉玮": 12
    },
    "talks": [
        {
            "talkId": "6261501",
            "initDialog": "626150101",
            "dialogues": [
                {
                    "id": "626150101",
                    "speaker": "嘉玮",
                    "text": "唔…昨天给老婆做了「松鼠鱼」，那今天来个「水煮黑背鲈」怎么样？"
                }
            ]
        },
        {
            "talkId": "6261502",
            "initDialog": "626150201",
            "dialogues": [
                {
                    "id": "626150201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "626150202",
                    "speaker": "嘉玮",
                    "text": "啊， 你们好啊！我是嘉玮。"
                },
                {
                    "id": "626150203",
                    "speaker": "嘉玮",
                    "text": "跟你们看到的一样，我是一名渔师，精英渔师。"
                },
                {
                    "id": "626150204",
                    "speaker": "嘉玮",
                    "text": "别看我现在天天呆在港口，曾经我也是出海远航，追捕过传说中的大鱼的。"
                },
                {
                    "id": "626150205",
                    "speaker": "嘉玮",
                    "text": "至于现在嘛，人总是要脚踏实地。整天漂在大海上，风吹浪打的，连家人都跟着担惊受怕，太不踏实了。"
                },
                {
                    "id": "626150206",
                    "speaker": "嘉玮",
                    "text": "你说，是不是这个道理？"
                }
            ]
        },
        {
            "talkId": "6261503",
            "initDialog": "626150301",
            "dialogues": [
                {
                    "id": "626150301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "626150302",
                    "speaker": "嘉玮",
                    "text": "我在准备食材呢，哈哈。"
                },
                {
                    "id": "626150303",
                    "speaker": "嘉玮",
                    "text": "我老婆非常爱吃鱼，而且一定要吃我每天新鲜钓上来的鱼，真是拿她没办法..."
                },
                {
                    "id": "626150304",
                    "speaker": "嘉玮",
                    "text": "不过好在这正是我的拿手好戏，毕竟当年我也是出海追捕过传说中的大鱼的精英渔师了。"
                },
                {
                    "id": "626150305",
                    "speaker": "嘉玮",
                    "text": "哈哈，那还是我没遇到她的时候的往事，不提了不提了。你们找我有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6261504",
            "initDialog": "626150401",
            "dialogues": [
                {
                    "id": "626150401",
                    "speaker": "Player",
                    "text": "我需要一些钓鱼用品。"
                },
                {
                    "id": "626150402",
                    "speaker": "嘉玮",
                    "text": "原来你也是钓鱼爱好者，请看看吧，我这里的可都是精品。"
                }
            ]
        },
        {
            "talkId": "6261505",
            "initDialog": "626150501",
            "dialogues": [
                {
                    "id": "626150501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "626150502",
                    "speaker": "嘉玮",
                    "text": "慢走！祝你渔运昌隆。"
                }
            ]
        }
    ]
}