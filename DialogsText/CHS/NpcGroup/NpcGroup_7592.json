{
    "groupId": "7592",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "克尼亚泽夫": 10
    },
    "talks": [
        {
            "talkId": "6759201",
            "initDialog": "675920101",
            "dialogues": [
                {
                    "id": "675920101",
                    "speaker": "克尼亚泽夫",
                    "text": "欢迎光临…您要点什么？反正我这里的货物都挺便宜的…"
                }
            ]
        },
        {
            "talkId": "6759202",
            "initDialog": "675920201",
            "dialogues": [
                {
                    "id": "675920201",
                    "speaker": "Player",
                    "text": "我看看…"
                },
                {
                    "id": "675920202",
                    "speaker": "克尼亚泽夫",
                    "text": "行。您自己选选吧…"
                }
            ]
        },
        {
            "talkId": "6759203",
            "initDialog": "675920301",
            "dialogues": [
                {
                    "id": "675920301",
                    "speaker": "Player",
                    "text": "你怎么说话有气无力的…"
                },
                {
                    "id": "675920302",
                    "speaker": "克尼亚泽夫",
                    "text": "一说起这个我就，唉…呃，不行不行，父亲说了不能在客户面前叹气…"
                }
            ]
        },
        {
            "talkId": "6759204",
            "initDialog": "675920401",
            "dialogues": [
                {
                    "id": "675920401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "675920402",
                    "speaker": "克尼亚泽夫",
                    "text": "再见。等待您的下次惠顾…"
                }
            ]
        },
        {
            "talkId": "6759205",
            "initDialog": "675920501",
            "dialogues": [
                {
                    "id": "675920501",
                    "speaker": "Player",
                    "text": "你是被家里人训斥了？"
                },
                {
                    "id": "675920502",
                    "speaker": "克尼亚泽夫",
                    "text": "哈哈…如果只是训斥就好了。我父亲可是连我做生意的本钱都收走了…"
                },
                {
                    "id": "675920503",
                    "speaker": "克尼亚泽夫",
                    "text": "…不过，他这么做倒也没错，谁叫我读书读晕了头，仗着书上的理论去做生意，然后被人坑了一笔…赔了个底朝天呢？"
                },
                {
                    "id": "675920504",
                    "speaker": "克尼亚泽夫",
                    "text": "最后还是父亲接手，把我的烂摊子处理好，也安抚好了各个合作方，为我保留了「最后一点做生意的本钱」。"
                },
                {
                    "id": "675920505",
                    "speaker": "克尼亚泽夫",
                    "text": "但父亲也和我说，如果我再想进生意场做商人，那就必须从零开始，累积真正的商业经验…"
                },
                {
                    "id": "675920506",
                    "speaker": "克尼亚泽夫",
                    "text": "所以，我就按照他的安排，来这里摆摊了…但这样真的可以积累商业经验吗？不然我还是继续研究一下商业理论吧…"
                },
                {
                    "id": "675920507",
                    "speaker": "克尼亚泽夫",
                    "text": "唉…呃，算了算了，反正父亲不在这里，叹气就叹气吧…"
                }
            ]
        }
    ]
}