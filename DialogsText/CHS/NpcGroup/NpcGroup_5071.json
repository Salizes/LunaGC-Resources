{
    "groupId": "5071",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "于格": 13
    },
    "talks": [
        {
            "talkId": "6507101",
            "initDialog": "650710101",
            "dialogues": [
                {
                    "id": "650710101",
                    "speaker": "于格",
                    "text": "也不知道吕塞尔过得好不好…"
                }
            ]
        },
        {
            "talkId": "6507102",
            "initDialog": "650710201",
            "dialogues": [
                {
                    "id": "650710201",
                    "speaker": "Player",
                    "text": "吕塞尔？"
                },
                {
                    "id": "650710202",
                    "speaker": "于格",
                    "text": "唉，我的老伙计…明明在被我改造后就能过上自由的生活了，却被他们从我身边夺走。"
                },
                {
                    "id": "650710203",
                    "speaker": "于格",
                    "text": "我甚至没有挽回的机会，因为他们给我换了个新的工作场所——梅洛彼得堡。"
                },
                {
                    "id": "650710204",
                    "speaker": "于格",
                    "text": "顺便一提，吕塞尔在属于我之前，是个警备队的警卫机关。"
                },
                {
                    "id": "650710205",
                    "speaker": "于格",
                    "text": "在我改造它时它没有反抗，我就当它是自愿的了。"
                }
            ]
        },
        {
            "talkId": "6507103",
            "initDialog": "650710301",
            "dialogues": [
                {
                    "id": "650710301",
                    "speaker": "Player",
                    "text": "…所以新工作是蹲大牢。"
                },
                {
                    "id": "650710302",
                    "speaker": "于格",
                    "text": "…对。"
                },
                {
                    "id": "650710303",
                    "speaker": "于格",
                    "text": "和我在枫丹科学院的旧工作相比，新工作也是有可取之处的。"
                },
                {
                    "id": "650710304",
                    "speaker": "于格",
                    "text": "比起院里那些繁琐的流程和无聊的总结大会，我觉得梅洛彼得堡的生活更有创新精神。"
                },
                {
                    "id": "650710305",
                    "speaker": "于格",
                    "text": "就连每天吃的饭都是发条机关送的呢，真羡慕！可惜食堂管理员不肯把那个机关卖给我。"
                }
            ]
        },
        {
            "talkId": "6507104",
            "initDialog": "650710401",
            "dialogues": [
                {
                    "id": "650710401",
                    "speaker": "Player",
                    "text": "不太清楚。"
                },
                {
                    "id": "650710402",
                    "speaker": "于格",
                    "text": "没关系，就当我在自言自语好了。"
                }
            ]
        },
        {
            "talkId": "7493401",
            "initDialog": "749340101",
            "dialogues": [
                {
                    "id": "749340101",
                    "speaker": "Player",
                    "text": "好吧，赞美创新精神。"
                },
                {
                    "id": "749340102",
                    "speaker": "于格",
                    "text": "怎么感觉您这不是在夸我呢。"
                },
                {
                    "id": "749340103",
                    "speaker": "于格",
                    "text": "无论如何，创新精神确实值得称赞。"
                },
                {
                    "id": "749340104",
                    "speaker": "于格",
                    "text": "我这里有些乱七八糟的材料，您拿一些走吧，看看能不能做出什么创新成果。"
                }
            ]
        }
    ]
}