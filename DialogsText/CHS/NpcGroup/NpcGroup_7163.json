{
    "groupId": "7163",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "愚人众特遣队新人": 3,
        "派蒙": 1,
        "阿扎莉娅": 11
    },
    "talks": [
        {
            "talkId": "6716301",
            "initDialog": "671630101",
            "dialogues": [
                {
                    "id": "671630101",
                    "speaker": "愚人众特遣队新人",
                    "text": "（喂，轮到你啦！愣着干嘛？）"
                }
            ]
        },
        {
            "talkId": "6716302",
            "initDialog": "671630201",
            "dialogues": [
                {
                    "id": "671630201",
                    "speaker": "Player",
                    "text": "五！"
                },
                {
                    "id": "671630202",
                    "speaker": "愚人众特遣队新人",
                    "text": "六！"
                },
                {
                    "id": "671630203",
                    "speaker": "阿扎莉娅",
                    "text": "很好！你们接下来的任务就是列队巡逻，不要以为离开了这里就可以松懈了，我会盯着你们的。"
                },
                {
                    "id": "671630204",
                    "speaker": "阿扎莉娅",
                    "text": "那么现在，向后转！注意保持队形！"
                }
            ]
        },
        {
            "talkId": "6716303",
            "initDialog": "671630301",
            "dialogues": [
                {
                    "id": "671630301",
                    "speaker": "Player",
                    "text": "三！"
                },
                {
                    "id": "671630302",
                    "speaker": "愚人众特遣队新人",
                    "text": "…嗯？二、二？"
                },
                {
                    "id": "671630303",
                    "speaker": "阿扎莉娅",
                    "text": "怎么回事！连这么简单的任务都做不到吗！你！那个金发的，对，就是你！你怎么连制服都没有穿？",
                    "choices": [
                        {
                            "id": "671630304",
                            "text": "我…刚来。我想加入你们！",
                            "response": [
                                {
                                    "id": "671630305",
                                    "speaker": "派蒙",
                                    "text": "欸？是、是什么时候有这种计划的？"
                                },
                                {
                                    "id": "671630306",
                                    "speaker": "阿扎莉娅",
                                    "text": "哦？这可有些出乎意料了。不过既然已经走到了这里，多少也表明了你的决心。"
                                },
                                {
                                    "id": "671630307",
                                    "speaker": "阿扎莉娅",
                                    "text": "不过很可惜，像你们这种企图打入我们队伍内的家伙，别以为能骗过我阿扎莉娅的眼睛！"
                                }
                            ]
                        },
                        {
                            "id": "671630308",
                            "text": "制服？没有那种特别的爱好。",
                            "response": [
                                {
                                    "id": "671630309",
                                    "speaker": "阿扎莉娅",
                                    "text": "什么乱七八糟的！你果然很可疑。想狡辩？哼，那就用拳头说吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6716304",
            "initDialog": "671630401",
            "dialogues": [
                {
                    "id": "671630401",
                    "speaker": "Player",
                    "text": "六六六！"
                },
                {
                    "id": "671630402",
                    "speaker": "阿扎莉娅",
                    "text": "有人不想好好训练…你！对，就是你，那个金发的，看来你挺有个性啊？"
                },
                {
                    "id": "671630403",
                    "speaker": "Player",
                    "text": "我…只是想赞颂我们伟大的事业！"
                },
                {
                    "id": "671630404",
                    "speaker": "阿扎莉娅",
                    "text": "年轻人有特立独行的念头，我不反对。但别忘了，我们的事业太重要了，不是你展示个性的舞台。"
                },
                {
                    "id": "671630405",
                    "speaker": "阿扎莉娅",
                    "text": "不过，在你身上，我倒是看到几分我年轻时候的样子。继续磨炼自己吧，别让我失望了！"
                },
                {
                    "id": "671630406",
                    "speaker": "阿扎莉娅",
                    "text": "那么所有人，继续训练！准备前往各自的巡逻点，齐步走！"
                }
            ]
        },
        {
            "talkId": "6716305",
            "initDialog": "671630501",
            "dialogues": [
                {
                    "id": "671630501",
                    "speaker": "Player",
                    "text": "二二三四！愚人众摔得狗啃泥！"
                },
                {
                    "id": "671630502",
                    "speaker": "阿扎莉娅",
                    "text": "哼，看来我们当中混入了一个爱耍贫嘴的奸细。也好，是时候让我看看新人训练的成果了，都给我上！"
                }
            ]
        }
    ]
}