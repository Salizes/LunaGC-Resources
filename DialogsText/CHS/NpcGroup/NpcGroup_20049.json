    },
    "talks": [
        {
            "talkId": "34713",
            "initDialog": "3471301",
            "dialogues": [
                {
                    "id": "3471301",
                    "speaker": "老旧的告示牌",
                    "text": "「鉴于此前发生了二哥与中原杂碎的不幸事件，我决定再次启用这里的信息公告版。以后，但凡有值得同步的事情，都请大家在这里留言说明。」",
                    "choices": [
                        {
                            "id": "3471302",
                            "text": "阅读最新的留言…",
                            "response": [
                                {
                                    "id": "3471305",
                                    "speaker": "最新的留言",
                                    "text": "「由于上头的工作安排，下个月起我们将去层岩巨渊帮那边继续工作。前矿主的宝物传说的念想也该断了，老老实实干活才是正道。不要忘记二哥的教训。」",
                                    "choices": [
                                        {
                                            "id": "3471303",
                                            "text": "阅读较早的留言…",
                                            "response": [
                                                {
                                                    "id": "3471306",
                                                    "speaker": "领班的留言",
                                                    "text": "「关于之前找到的前矿主鸿老爷子的遗训、家书与宝藏的传说，请各位不要太过认真对待。不要为此耽误进度。刻苦工作才是正道。」"
                                                },
                                                {
                                                    "id": "3471307",
                                                    "speaker": "领班的留言",
                                                    "text": "「另外，由于最近荻花洲那边有盗匪出没，这个月行商可能得晚点才能来。」",
                                                    "choices": [
                                                        {
                                                            "id": "3471308",
                                                            "text": "继续阅读…",
                                                            "response": [
                                                                {
                                                                    "id": "3471331",
                                                                    "speaker": "老矿工的留言",
                                                                    "text": "「在矿洞里工作时，如果看到火把冒出蓝光一定要小心。可能是地下生成的有害气体，如果引起爆炸就惨了。顺便为二哥默哀。」",
                                                                    "choices": [
                                                                        {
                                                                            "id": "3471332",
                                                                            "text": "继续阅读…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "3471309",
                                                                                    "speaker": "领班的留言",
                                                                                    "text": "「关于大家抱怨团雀不够用一事，我已经安排预算去采购新的了。另外，有两点需要申明：」"
                                                                                },
                                                                                {
                                                                                    "id": "3471310",
                                                                                    "speaker": "领班的留言",
                                                                                    "text": "「一、团雀对采矿至关重要。可以分辨矿坑里的空气是否安全；」"
                                                                                },
                                                                                {
                                                                                    "id": "3471311",
                                                                                    "speaker": "领班的留言",
                                                                                    "text": "「二、鉴于一，请各位不要随便把团雀做成吃的；」"
                                                                                },
                                                                                {
                                                                                    "id": "3471312",
                                                                                    "speaker": "领班的留言",
                                                                                    "text": "「三、请各位牢记二哥与中原杂碎的教训。」",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "3471313",
                                                                                            "text": "继续阅读…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "3471314",
                                                                                                    "speaker": "年轻矿工的留言",
                                                                                                    "text": "「各位！还记得主屋的遗训吗？今天在矿里，我发现了大概是前矿主留下的线索。里面说红叶萋萋什么的。鸿老爷子不愧是文化人，我一点也看不懂！如果二哥还在就好了！」"
                                                                                                },
                                                                                                {
                                                                                                    "id": "3471315",
                                                                                                    "speaker": "领班的回应",
                                                                                                    "text": "「阿忠，不要把时间浪费在这种东西上。」",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "3471316",
                                                                                                            "text": "继续阅读…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "3471317",
                                                                                                                    "speaker": "领班的留言",
                                                                                                                    "text": "「关于最近矿量减少一事：和老戴讨论了一下，我们推测明蕴镇的矿藏应该快掏空了。」"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "3471318",
                                                                                                                    "speaker": "领班的留言",
                                                                                                                    "text": "「已经和辉山厅的人商量过了。可能过段时间，我们会迁去层岩巨渊继续工作。请各位不要担心。」",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "3471319",
                                                                                                                            "text": "继续阅读…",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "3471320",
                                                                                                                                    "speaker": "行商的留言",
                                                                                                                                    "text": "「给老戴：《碎梦奇珍》最新一卷实在订不到。回头再给你看看。」"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "3471321",
                                                                                                                                    "speaker": "行商的留言",
                                                                                                                                    "text": "「给二哥：这次来没看到你。你定的蘑菇、卷心菜、奶酪、面粉和菜谱我给阿忠了。你管他要。」"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "3471322",
                                                                                                                                    "speaker": "年轻矿工的留言",
                                                                                                                                    "text": "「各位！今晚我请大家吃烤蘑菇披萨！」"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "3471323",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "烤蘑菇披萨！",
                                                                                                                                    "choices": [
                                                                                                                                        {
                                                                                                                                            "id": "3471324",
                                                                                                                                            "text": "继续阅读…",
                                                                                                                                            "response": [
                                                                                                                                                {
                                                                                                                                                    "id": "3471325",
                                                                                                                                                    "speaker": "老矿工的留言",
                                                                                                                                                    "text": "「最近在矿里发现了鸿老爷子留下的东西，说兄弟啥的。可能和老爷子主屋遗训里提到的宝藏有关。」"
                                                                                                                                                },
                                                                                                                                                {
                                                                                                                                                    "id": "3471326",
                                                                                                                                                    "speaker": "老矿工的留言",
                                                                                                                                                    "text": "「但是寻宝千万条，安全第一条。挖矿也一样。要时不时敲敲头顶的石头，如果里面发出空落落的声音的话，可能会塌方。顺便为二哥默哀。」",
                                                                                                                                                    "choices": [
                                                                                                                                                        {
                                                                                                                                                            "id": "3471327",
                                                                                                                                                            "text": "继续阅读…",
                                                                                                                                                            "response": [
                                                                                                                                                                {
                                                                                                                                                                    "id": "3471328",
                                                                                                                                                                    "speaker": "年轻矿工的留言",
                                                                                                                                                                    "text": "「各位！今天是我在矿上的最后一天，下周我就结婚了！如果大家有空的话，欢迎来吃我和我媳妇的酒！」"
                                                                                                                                                                },
                                                                                                                                                                {
                                                                                                                                                                    "id": "3471329",
                                                                                                                                                                    "speaker": "年轻矿工的留言",
                                                                                                                                                                    "text": "「明蕴镇再见！大家再见！如果有人找到了鸿老爷子的宝物，请写信跟我说！」"
                                                                                                                                                                },
                                                                                                                                                                {
                                                                                                                                                                    "id": "3471330",
                                                                                                                                                                    "speaker": "领班的留言",
                                                                                                                                                                    "text": "「祝阿忠前程似锦。也请大家不要浪费时间寻宝，我们是矿工，不是冒险家，不是盗宝团。」"
                                                                                                                                                                }
                                                                                                                                                            ]
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "id": "3471304",
                                                                                                                                                            "text": "离开"
                                                                                                                                                        }
                                                                                                                                                    ]
                                                                                                                                                }
                                                                                                                                            ]
                                                                                                                                        },
