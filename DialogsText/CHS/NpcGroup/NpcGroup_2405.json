{
    "groupId": "2405",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "鉴秋": 8
    },
    "talks": [
        {
            "talkId": "6240501",
            "initDialog": "624050101",
            "dialogues": [
                {
                    "id": "624050101",
                    "speaker": "鉴秋",
                    "text": "请问你有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6240502",
            "initDialog": "624050201",
            "dialogues": [
                {
                    "id": "624050201",
                    "speaker": "Player",
                    "text": "你们正在旅行吗？"
                },
                {
                    "id": "624050202",
                    "speaker": "鉴秋",
                    "text": "我是随小姐出行，要出趟远门。"
                }
            ]
        },
        {
            "talkId": "6240503",
            "initDialog": "624050301",
            "dialogues": [
                {
                    "id": "624050301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624050302",
                    "speaker": "鉴秋",
                    "text": "我在吃虎岩做过几年算术老师，都是些穷人家的孩子。"
                },
                {
                    "id": "624050303",
                    "speaker": "鉴秋",
                    "text": "而现在我是明华钱庄掌柜家的…雇员。"
                },
                {
                    "id": "624050304",
                    "speaker": "鉴秋",
                    "text": "此次出行是为了保护小姐一路安全。"
                },
                {
                    "id": "624050305",
                    "speaker": "Player",
                    "text": "你们要去哪里？"
                },
                {
                    "id": "624050306",
                    "speaker": "鉴秋",
                    "text": "天空岛吧。"
                },
                {
                    "id": "624050307",
                    "speaker": "鉴秋",
                    "text": "呵呵，开玩笑…我们此行的目的不便透露，抱歉。"
                }
            ]
        },
        {
            "talkId": "6240504",
            "initDialog": "624050401",
            "dialogues": [
                {
                    "id": "624050401",
                    "speaker": "Player",
                    "text": "一路平安。"
                },
                {
                    "id": "624050402",
                    "speaker": "鉴秋",
                    "text": "借你吉言，你也一样。"
                }
            ]
        }
    ]
}