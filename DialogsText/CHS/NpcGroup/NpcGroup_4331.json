{
    "groupId": "4331",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "扎蒂斯": 11
    },
    "talks": [
        {
            "talkId": "6433101",
            "initDialog": "643310101",
            "dialogues": [
                {
                    "id": "643310101",
                    "speaker": "扎蒂斯",
                    "text": "教令院有这么多学院，到底选哪个好啊…"
                }
            ]
        },
        {
            "talkId": "6433102",
            "initDialog": "643310201",
            "dialogues": [
                {
                    "id": "643310201",
                    "speaker": "Player",
                    "text": "你在烦恼什么？"
                },
                {
                    "id": "643310202",
                    "speaker": "扎蒂斯",
                    "text": "唉，我正在为要去教令院的哪个学派进修发愁。"
                },
                {
                    "id": "643310203",
                    "speaker": "扎蒂斯",
                    "text": "这次考核的成绩超出我想象的好，每个学派的要求都达标了。可是问题来了，学派有六个啊…"
                },
                {
                    "id": "643310204",
                    "speaker": "扎蒂斯",
                    "text": "听说从阿弥利多学派毕业当医生赚的摩拉多，又有人说刹诃伐罗学派中的建筑方向就业形势好…"
                },
                {
                    "id": "643310205",
                    "speaker": "扎蒂斯",
                    "text": "到底该选哪个呢？"
                }
            ]
        },
        {
            "talkId": "6433103",
            "initDialog": "643310301",
            "dialogues": [
                {
                    "id": "643310301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643310302",
                    "speaker": "扎蒂斯",
                    "text": "唉，我要是考上了一个的话，也不至于这么纠结了…"
                }
            ]
        },
        {
            "talkId": "6433104",
            "initDialog": "643310401",
            "dialogues": [
                {
                    "id": "643310401",
                    "speaker": "Player",
                    "text": "找人占卜看看。"
                },
                {
                    "id": "643310402",
                    "speaker": "扎蒂斯",
                    "text": "哈哈哈，你可真会开玩笑！"
                },
                {
                    "id": "643310403",
                    "speaker": "扎蒂斯",
                    "text": "…是开玩笑的对吧？"
                },
                {
                    "id": "643310404",
                    "speaker": "扎蒂斯",
                    "text": "不管有多难选，这都是关系到我毕生职业规划的重要抉择。"
                },
                {
                    "id": "643310405",
                    "speaker": "扎蒂斯",
                    "text": "如果选错了，没准就会像阿莲佐一样退学，或者像胡塞尼那样一直毕不了业。"
                },
                {
                    "id": "643310406",
                    "speaker": "扎蒂斯",
                    "text": "我可千万不要那样啊！"
                }
            ]
        }
    ]
}