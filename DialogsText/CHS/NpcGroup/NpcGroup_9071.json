{
    "groupId": "9071",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 20,
        "赛诺": 51
    },
    "talks": [
        {
            "talkId": "6907101",
            "initDialog": "690710101",
            "dialogues": [
                {
                    "id": "690710101",
                    "speaker": "赛诺",
                    "text": "哦？你回来了。"
                },
                {
                    "id": "690710102",
                    "speaker": "赛诺",
                    "text": "下次冒险之前，好好休息一下吧。"
                }
            ]
        },
        {
            "talkId": "6907102",
            "initDialog": "690710201",
            "dialogues": [
                {
                    "id": "690710201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690710202",
                    "speaker": "赛诺",
                    "text": "刚开始不太习惯，因为这里太安静了。"
                },
                {
                    "id": "690710203",
                    "speaker": "赛诺",
                    "text": "没有沙漠呼啸的风声，也没有雨林中虫蛇爬动发出的声响。"
                },
                {
                    "id": "690710204",
                    "speaker": "赛诺",
                    "text": "在这里睡觉会有种不真实的感觉。因为太过安静，反而无法放心入睡。"
                },
                {
                    "id": "690710205",
                    "speaker": "Player",
                    "text": "现在好些了吗？"
                },
                {
                    "id": "690710206",
                    "speaker": "赛诺",
                    "text": "嗯，好多了。我告诉自己这是一场度假，暂时不用思考外面的事情。"
                },
                {
                    "id": "690710207",
                    "speaker": "赛诺",
                    "text": "当然，每天睡前我还是会回顾以前的战斗，总结经验教训…"
                },
                {
                    "id": "690710208",
                    "speaker": "Player",
                    "text": "有好好休息吗？"
                },
                {
                    "id": "690710209",
                    "speaker": "赛诺",
                    "text": "不用担心，和在教令院的时候相比，现在的我已经很放松了。"
                },
                {
                    "id": "690710210",
                    "speaker": "赛诺",
                    "text": "休息的目的是舒缓内心的疲劳，并不意味着要彻底改变从前的习惯。"
                },
                {
                    "id": "690710211",
                    "speaker": "赛诺",
                    "text": "我很喜欢这里，在这里我可以获得片刻的安宁。我会利用这段时间调整好状态，为下一次审判做准备。"
                }
            ]
        },
        {
            "talkId": "6907103",
            "initDialog": "690710301",
            "dialogues": [
                {
                    "id": "690710301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690710302",
                    "speaker": "赛诺",
                    "text": "也好，我给你讲两个笑话吧。"
                },
                {
                    "id": "690710303",
                    "speaker": "赛诺",
                    "text": "从前有一只驮兽，每天都驮着很重的东西，终于有一天，它成功当选了「驮兽健美大赛」冠军。"
                },
                {
                    "id": "690710304",
                    "speaker": "赛诺",
                    "text": "…如何？",
                    "choices": [
                        {
                            "id": "690710305",
                            "text": "啊？",
                            "response": [
                                {
                                    "id": "690710307",
                                    "speaker": "赛诺",
                                    "text": "你知道谁是世界上最不爱干净的生物吗？答案是冰史莱姆，因为它们总是在水面上走，从不下去洗澡。"
                                },
                                {
                                    "id": "690710308",
                                    "speaker": "Player",
                                    "text": "？？？"
                                },
                                {
                                    "id": "690710309",
                                    "speaker": "赛诺",
                                    "text": "不好笑吗？",
                                    "choices": [
                                        {
                                            "id": "690710310",
                                            "text": "只能说比较勉强…",
                                            "response": [
                                                {
                                                    "id": "690710312",
                                                    "speaker": "赛诺",
                                                    "text": "这样啊。没事…"
                                                },
                                                {
                                                    "id": "690710313",
                                                    "speaker": "赛诺",
                                                    "text": "我的确分辨不清大家在笑话上的口味。"
                                                },
                                                {
                                                    "id": "690710314",
                                                    "speaker": "Player",
                                                    "text": "赛诺为什么愿意讲笑话呢？"
                                                },
                                                {
                                                    "id": "690710315",
                                                    "speaker": "赛诺",
                                                    "text": "因为我总是面无表情，给了其他风纪官很大压力。"
                                                },
                                                {
                                                    "id": "690710316",
                                                    "speaker": "赛诺",
                                                    "text": "有一次我突发奇想，给他们讲了几个笑话。讲完之后大家都一脸呆滞，片刻后忽然有人笑了起来，说「这是什么笑话啊」。"
                                                },
                                                {
                                                    "id": "690710317",
                                                    "speaker": "赛诺",
                                                    "text": "然后大家都笑了，虽然嘴上说着我讲的笑话不好笑，但我能感觉到他们还是很开心的。"
                                                },
                                                {
                                                    "id": "690710318",
                                                    "speaker": "赛诺",
                                                    "text": "我想，就算笑话本身不好笑，也能让和我聊天的人放松一些。"
                                                },
                                                {
                                                    "id": "690710319",
                                                    "speaker": "赛诺",
                                                    "text": "更何况…我总觉得那么多笑话，总不能全部都不好笑吧？"
                                                },
                                                {
                                                    "id": "690710320",
                                                    "speaker": "赛诺",
                                                    "text": "只要不停尝试下去，肯定能碰对一个…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690710311",
                                            "text": "稍微有点…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690710306",
                            "text": "还有吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907104",
            "initDialog": "690710401",
            "dialogues": [
                {
                    "id": "690710401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690710402",
                    "speaker": "赛诺",
                    "text": "仔细想想，我已经五天没有打七圣召唤了。"
                },
                {
                    "id": "690710403",
                    "speaker": "Player",
                    "text": "这个时间很长吗？"
                },
                {
                    "id": "690710404",
                    "speaker": "赛诺",
                    "text": "不，还好，最长记录是二十天。"
                },
                {
                    "id": "690710405",
                    "speaker": "赛诺",
                    "text": "那时候我在执行一个危险的任务，一直没有抽出时间对战。"
                },
                {
                    "id": "690710406",
                    "speaker": "赛诺",
                    "text": "回来后才发现自己的卡组已经过时，接连输了好几局，才逐渐扭转劣势。"
                },
                {
                    "id": "690710407",
                    "speaker": "赛诺",
                    "text": "想要保住胜率，就要不停对战，学习别人的思路。"
                },
                {
                    "id": "690710408",
                    "speaker": "Player",
                    "text": "赛诺很喜欢七圣召唤吗？"
                },
                {
                    "id": "690710409",
                    "speaker": "赛诺",
                    "text": "嗯。看你的表情…很意外吗？"
                },
                {
                    "id": "690710410",
                    "speaker": "赛诺",
                    "text": "其实第一次尝试的时候，我也只把它当做是一种消遣。"
                },
                {
                    "id": "690710411",
                    "speaker": "赛诺",
                    "text": "做风纪官，心中必须有一根弦。这根弦不能松懈，但也不能一直绷紧，否则不知道什么时候就会断掉。"
                },
                {
                    "id": "690710412",
                    "speaker": "赛诺",
                    "text": "所以一开始我接触七圣召唤，是想用它转移注意力，强迫自己放松休息。"
                },
                {
                    "id": "690710413",
                    "speaker": "赛诺",
                    "text": "…不过现在，它对我倒不仅仅是一种消遣了。",
                    "choices": [
                        {
                            "id": "690710414",
                            "text": "有什么变化吗？",
                            "response": [
                                {
                                    "id": "690710416",
                                    "speaker": "赛诺",
                                    "text": "在以前的工作中，我审判过许多违反规则的罪犯，也听过他们不停控诉。"
                                },
                                {
                                    "id": "690710417",
                                    "speaker": "赛诺",
                                    "text": "在绝大部分时候，我无法理解他们，他们也无法理解我。"
                                },
                                {
                                    "id": "690710418",
                                    "speaker": "赛诺",
                                    "text": "不只是犯人，即便是身边的朋友，也一定有无法相互理解的地方。"
                                },
                                {
                                    "id": "690710419",
                                    "speaker": "赛诺",
                                    "text": "但是在对局的时候，我却能够清晰地感知到对方的想法。"
                                },
                                {
                                    "id": "690710420",
                                    "speaker": "赛诺",
                                    "text": "对胜利的渴望、对卡组的信赖、对决斗的热情…每个人都会隐藏自己的战术，却几乎不会隐藏自身的情感。"
                                },
                                {
                                    "id": "690710421",
                                    "speaker": "Player",
                                    "text": "我也感受到了这种情绪。"
                                },
                                {
                                    "id": "690710422",
                                    "speaker": "赛诺",
                                    "text": "是吗？那要不要来一局？",
                                    "choices": [
                                        {
                                            "id": "690710423",
                                            "text": "求之不得！",
                                            "response": [
                                                {
                                                    "id": "690710425",
                                                    "speaker": "赛诺",
                                                    "text": "我是不会手下留情的。尽力战胜我吧。"
                                                },
                                                {
                                                    "id": "690710426",
                                                    "speaker": "赛诺",
                                                    "text": "等结束后，我会帮你好好分析的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690710424",
                                            "text": "还请手下留情…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690710415",
                            "text": "我大概能够理解。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907105",
            "initDialog": "690710501",
            "dialogues": [
                {
                    "id": "690710501",
                    "speaker": "Player",
                    "text": "早安，赛诺。"
                },
                {
                    "id": "690710502",
                    "speaker": "赛诺",
                    "text": "早，看你精神还算不错。"
                },
                {
                    "id": "690710503",
                    "speaker": "赛诺",
                    "text": "今天有什么安排吗？需要我帮忙的话，直说就好。"
                }
            ]
        },
        {
            "talkId": "6907106",
            "initDialog": "690710601",
            "dialogues": [
                {
                    "id": "690710601",
                    "speaker": "Player",
                    "text": "晚安，赛诺。"
                },
                {
                    "id": "690710602",
                    "speaker": "赛诺",
                    "text": "嗯，放心睡吧，有什么事明天再想。"
                },
                {
                    "id": "690710603",
                    "speaker": "赛诺",
                    "text": "静下心来，平稳呼吸，很快就能入眠。明天早上我会叫你，睡个好觉。"
                }
            ]
        },
        {
            "talkId": "6907110",
            "initDialog": "690711001",
            "dialogues": [
                {
                    "id": "690711001",
                    "speaker": "赛诺",
                    "text": "在这里歇脚，让人回忆起许多过去的事情。"
                },
                {
                    "id": "690711002",
                    "speaker": "赛诺",
                    "text": "出于工作需要，我去过很多地方，也曾在村落间露营或借宿。"
                },
                {
                    "id": "690711003",
                    "speaker": "赛诺",
                    "text": "一开始还有些不习惯，现在却已经习以为常。不知不觉，我也成为风纪官很久了啊…"
                }
            ]
        },
        {
            "talkId": "6907111",
            "initDialog": "690711101",
            "dialogues": [
                {
                    "id": "690711101",
                    "speaker": "赛诺",
                    "text": "嗯，书籍的摆放还算整齐。"
                },
                {
                    "id": "690711102",
                    "speaker": "赛诺",
                    "text": "书脊朝外，同一类典籍被归到一起，里面也没什么违禁的书。"
                },
                {
                    "id": "690711103",
                    "speaker": "赛诺",
                    "text": "等等，是不是有几本放歪了一点？必须立刻摆正…"
                }
            ]
        }
    ]
}