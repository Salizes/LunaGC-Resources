{
    "groupId": "2131",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "辉少": 15
    },
    "talks": [
        {
            "talkId": "6213101",
            "initDialog": "621310101",
            "dialogues": [
                {
                    "id": "621310101",
                    "speaker": "辉少",
                    "text": "要是能再开一块就好了！下一块璞石肯定有货，小爷我都能感觉到了！"
                },
                {
                    "id": "621310102",
                    "speaker": "辉少",
                    "text": "哼，要不是小茜拦着，我现在肯定…"
                }
            ]
        },
        {
            "talkId": "6213102",
            "initDialog": "621310201",
            "dialogues": [
                {
                    "id": "621310201",
                    "speaker": "Player",
                    "text": "璞石？"
                },
                {
                    "id": "621310202",
                    "speaker": "辉少",
                    "text": "怎么？对赌石感兴趣啊？那你可问对人了，让小爷来给你好好讲讲！"
                },
                {
                    "id": "621310203",
                    "speaker": "辉少",
                    "text": "这璞石不光要用眼睛看皮壳的新老程度，真正的行家甚至还会用鼻子去闻味儿！"
                },
                {
                    "id": "621310204",
                    "speaker": "辉少",
                    "text": "嘿，这里面的水可就深了，没个十年八年是玩不明白的，也就小爷天资聪慧…"
                },
                {
                    "id": "621310205",
                    "speaker": "Player",
                    "text": "那你开出来了吗？"
                },
                {
                    "id": "621310206",
                    "speaker": "辉少",
                    "text": "我…小爷这是运气不好！"
                },
                {
                    "id": "621310207",
                    "speaker": "辉少",
                    "text": "要不是小茜一直在念叨说，老爷要来抓我了，影响了我的判断…我那次肯定已经开出来了！"
                },
                {
                    "id": "621310208",
                    "speaker": "辉少",
                    "text": "…当时就该选那块黄的！我要是选了那块黄的，还会是现在这样吗！"
                }
            ]
        },
        {
            "talkId": "6213103",
            "initDialog": "621310301",
            "dialogues": [
                {
                    "id": "621310301",
                    "speaker": "Player",
                    "text": "关于小茜…"
                },
                {
                    "id": "621310302",
                    "speaker": "辉少",
                    "text": "别提了，小爷不就在「解翠行」赌输了百来块璞石吗，这叫积累经验…谁家做生意只赚不赔啊？"
                },
                {
                    "id": "621310303",
                    "speaker": "辉少",
                    "text": "结果我爹那个老顽固，居然一气之下把我赶出来了！"
                },
                {
                    "id": "621310304",
                    "speaker": "辉少",
                    "text": "唉，还是我娘疼我，让小茜拿了些盘缠跟着我…"
                },
                {
                    "id": "621310305",
                    "speaker": "辉少",
                    "text": "…可是小茜居然每天就给我这么点零花钱，得攒小半个月才能去开一块璞石！"
                },
                {
                    "id": "621310306",
                    "speaker": "辉少",
                    "text": "哼，也罢，小爷肯定能咸鱼翻身…呸，是东山再起的！"
                }
            ]
        },
        {
            "talkId": "6213104",
            "initDialog": "621310401",
            "dialogues": [
                {
                    "id": "621310401",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "621310402",
                    "speaker": "辉少",
                    "text": "谢谢啊！等小爷时来运转，就把这个望舒客栈盘下来…"
                },
                {
                    "id": "621310403",
                    "speaker": "辉少",
                    "text": "…到时候就让小茜一个人刷所有的盘子，哼…"
                }
            ]
        }
    ]
}