{
    "groupId": "5134",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "依维莱琳": 15
    },
    "talks": [
        {
            "talkId": "6513401",
            "initDialog": "651340101",
            "dialogues": [
                {
                    "id": "651340101",
                    "speaker": "依维莱琳",
                    "text": "你好。今天风平浪静，虽然故事不多，但不影响安全起航哦。"
                }
            ]
        },
        {
            "talkId": "6513402",
            "initDialog": "651340201",
            "dialogues": [
                {
                    "id": "651340201",
                    "speaker": "Player",
                    "text": "关于故事…"
                },
                {
                    "id": "651340202",
                    "speaker": "依维莱琳",
                    "text": "海港除了是水流和大船交汇的地方，也是故事的集散地。"
                },
                {
                    "id": "651340203",
                    "speaker": "依维莱琳",
                    "text": "这里总是有很多游客、商人，还有从沙漠和雨林那边来的喜欢读书的人。"
                },
                {
                    "id": "651340204",
                    "speaker": "依维莱琳",
                    "text": "很多人大概是因为第一次见到美露莘，都很喜欢找我聊天呢。"
                },
                {
                    "id": "651340205",
                    "speaker": "依维莱琳",
                    "text": "托大家的福，我也听说了很多这片水域之外的故事。能来这里工作真是太好了。"
                }
            ]
        },
        {
            "talkId": "6513403",
            "initDialog": "651340301",
            "dialogues": [
                {
                    "id": "651340301",
                    "speaker": "Player",
                    "text": "关于海洋…"
                },
                {
                    "id": "651340302",
                    "speaker": "依维莱琳",
                    "text": "观察大海是我的工作，我很喜欢。有我在，不用担心风暴和大雨，我会提前提醒大家的。"
                },
                {
                    "id": "651340303",
                    "speaker": "依维莱琳",
                    "text": "哦忘了说…我是美露莘，按照那维莱特大人的说法，是和海洋有着密切联系的生灵。"
                },
                {
                    "id": "651340304",
                    "speaker": "依维莱琳",
                    "text": "而我是我们之间最能感知到海洋动态的美露莘之一，这也是我被派来港口工作的原因吧。"
                },
                {
                    "id": "651340305",
                    "speaker": "依维莱琳",
                    "text": "只需要汇报海面动向，不用去深海游荡，对我来说还挺轻松的呢。"
                }
            ]
        },
        {
            "talkId": "6513404",
            "initDialog": "651340401",
            "dialogues": [
                {
                    "id": "651340401",
                    "speaker": "Player",
                    "text": "真不错。"
                },
                {
                    "id": "651340402",
                    "speaker": "依维莱琳",
                    "text": "嗯，我也这么认为。"
                }
            ]
        },
        {
            "talkId": "6513405",
            "initDialog": "651340501",
            "dialogues": [
                {
                    "id": "651340501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6513406",
            "initDialog": "651340601",
            "dialogues": [
                {
                    "id": "651340601",
                    "speaker": "依维莱琳",
                    "text": "虽然牌不好抓，但是打起来很开心！"
                }
            ]
        },
        {
            "talkId": "6513407",
            "initDialog": "651340701",
            "dialogues": [
                {
                    "id": "651340701",
                    "speaker": "依维莱琳",
                    "text": "牌这么难抓，对局又复杂，真难…"
                }
            ]
        },
        {
            "talkId": "7490501",
            "initDialog": "749050101",
            "dialogues": [
                {
                    "id": "749050101",
                    "speaker": "Player",
                    "text": "深海…"
                },
                {
                    "id": "749050102",
                    "speaker": "依维莱琳",
                    "text": "嗯…说实话，其实我也不确定我对海洋深度的认知和人类的感受是否一致。"
                },
                {
                    "id": "749050103",
                    "speaker": "依维莱琳",
                    "text": "我只知道，对大多数人类来说，潜水是件很困难、需要穿着厚重衣服、经过训练才能做到的事情。"
                },
                {
                    "id": "749050104",
                    "speaker": "依维莱琳",
                    "text": "你会潜水吗？不会也没关系，这些是我从海底带来的，与你分享。"
                }
            ]
        }
    ]
}