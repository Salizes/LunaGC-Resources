{
    "groupId": "2143",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "百闻": 26
    },
    "talks": [
        {
            "talkId": "6214306",
            "initDialog": "621430601",
            "dialogues": [
                {
                    "id": "621430601",
                    "speaker": "百闻",
                    "text": "原来是你，欢迎登门，是来找凝光大人的吧？"
                }
            ]
        },
        {
            "talkId": "6214307",
            "initDialog": "621430701",
            "dialogues": [
                {
                    "id": "621430701",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "621430702",
                    "speaker": "百闻",
                    "text": "嗯，你好，你果然出现了，可见你的行程与我们手头情报所显示的情况相符。"
                },
                {
                    "id": "621430703",
                    "speaker": "百闻",
                    "text": "来找凝光大人的话，选择到群玉阁——璃月智谋与决策的核心，的确十分正确。"
                },
                {
                    "id": "621430704",
                    "speaker": "百闻",
                    "text": "不过依据您的相关情报，我们曾经推断您应该在两个小时之前就到了…"
                },
                {
                    "id": "621430705",
                    "speaker": "百闻",
                    "text": "果然还是要反思反思，究竟是情报侧的误差还是判断上的偏差呢…"
                }
            ]
        },
        {
            "talkId": "6214308",
            "initDialog": "621430801",
            "dialogues": [
                {
                    "id": "621430801",
                    "speaker": "Player",
                    "text": "我只是路过。"
                },
                {
                    "id": "621430802",
                    "speaker": "百闻",
                    "text": "这样吗？那还真是有趣…"
                },
                {
                    "id": "621430803",
                    "speaker": "百闻",
                    "text": "毕竟这是你参与重建的群玉阁，你来到这里，不会仅仅是抱着观光游乐的目的吧？"
                },
                {
                    "id": "621430804",
                    "speaker": "百闻",
                    "text": "按照以往的情报显示，任何人来到群玉阁都是心有所图的，这一点还未曾有过例外。"
                },
                {
                    "id": "621430805",
                    "speaker": "百闻",
                    "text": "我身为为凝光大人收集和整理情报的秘书，无论任何人的信息都要掌握在手中，哪怕是身为贵客的你也一样。"
                }
            ]
        },
        {
            "talkId": "6214309",
            "initDialog": "621430901",
            "dialogues": [
                {
                    "id": "621430901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621430902",
                    "speaker": "百闻",
                    "text": "再见，愿您多结财缘。"
                }
            ]
        },
        {
            "talkId": "7195101",
            "initDialog": "719510101",
            "dialogues": [
                {
                    "id": "719510101",
                    "speaker": "Player",
                    "text": "我很崇拜凝光大人。"
                },
                {
                    "id": "719510102",
                    "speaker": "百闻",
                    "text": "嗯，这并不稀奇，我也一样。"
                },
                {
                    "id": "719510103",
                    "speaker": "百闻",
                    "text": "世人尽知，天权为尊。我能做的，便是为凝光大人织起情报之网。"
                },
                {
                    "id": "719510104",
                    "speaker": "百闻",
                    "text": "待凝光大人抽丝剥茧，刀斩乱麻之后，便会从群玉阁降下「繁荣」的指引…"
                },
                {
                    "id": "719510105",
                    "speaker": "百闻",
                    "text": "你也想领略一下吗？"
                }
            ]
        },
        {
            "talkId": "6214301",
            "initDialog": "621430101",
            "dialogues": [
                {
                    "id": "621430101",
                    "speaker": "百闻",
                    "text": "欢迎登门，您是来找凝光大人的吧？"
                }
            ]
        },
        {
            "talkId": "6214302",
            "initDialog": "621430201",
            "dialogues": [
                {
                    "id": "621430201",
                    "speaker": "Player",
                    "text": "是的。"
                },
                {
                    "id": "621430202",
                    "speaker": "百闻",
                    "text": "果然，您的目的与我们手头情报所显示的情况相符。"
                },
                {
                    "id": "621430203",
                    "speaker": "百闻",
                    "text": "来找凝光大人的话，您来对地方了。这里是群玉阁，璃月智谋与决策的核心。"
                },
                {
                    "id": "621430204",
                    "speaker": "百闻",
                    "text": "不过依据您的相关情报，我们曾经推断您应该在两个小时之前就到了…"
                },
                {
                    "id": "621430205",
                    "speaker": "百闻",
                    "text": "果然还是要反思反思，究竟是情报侧的误差还是判断上的偏差呢…"
                }
            ]
        },
        {
            "talkId": "6214303",
            "initDialog": "621430301",
            "dialogues": [
                {
                    "id": "621430301",
                    "speaker": "Player",
                    "text": "我只是路过。"
                },
                {
                    "id": "621430302",
                    "speaker": "百闻",
                    "text": "这样吗？那还真是有趣…"
                },
                {
                    "id": "621430303",
                    "speaker": "百闻",
                    "text": "毕竟您来到了这里，不会仅仅是抱着观光游乐的目的吧？"
                },
                {
                    "id": "621430304",
                    "speaker": "百闻",
                    "text": "情报显示，任何人来到群玉阁都是心有所图的，这一点还未曾有过例外。"
                },
                {
                    "id": "621430305",
                    "speaker": "百闻",
                    "text": "哼哼…就算你不说，我们也一定会查明并登记在案的，不要小瞧我们的情报网。"
                }
            ]
        },
        {
            "talkId": "6214304",
            "initDialog": "621430401",
            "dialogues": [
                {
                    "id": "621430401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621430402",
                    "speaker": "百闻",
                    "text": "再见，愿您多结财缘。"
                }
            ]
        },
        {
            "talkId": "6214305",
            "initDialog": "621430501",
            "dialogues": [
                {
                    "id": "621430501",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "621430502",
                    "speaker": "百闻",
                    "text": "不好意思，忘了自我介绍。您可以叫我百闻。"
                },
                {
                    "id": "621430503",
                    "speaker": "百闻",
                    "text": "我是凝光的秘书，负责情报收集与整理工作。"
                }
            ]
        }
    ]
}