{
    "groupId": "3409",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "奥克萨娜": 8
    },
    "talks": [
        {
            "talkId": "6340901",
            "initDialog": "634090101",
            "dialogues": [
                {
                    "id": "634090101",
                    "speaker": "奥克萨娜",
                    "text": "欢迎来到赫斯珀利德斯之馆，我是负责在大堂进行接待的奥克萨娜，请问客人有什么需要吗？"
                }
            ]
        },
        {
            "talkId": "6340902",
            "initDialog": "634090201",
            "dialogues": [
                {
                    "id": "634090201",
                    "speaker": "Player",
                    "text": "这里来的客人很多吗？"
                },
                {
                    "id": "634090202",
                    "speaker": "奥克萨娜",
                    "text": "其实…其实受邀请来的人类客人确实比较少，大部分还是生活在别处的雪精。"
                },
                {
                    "id": "634090203",
                    "speaker": "奥克萨娜",
                    "text": "不过，从前这里招待过许多不同的客人。"
                },
                {
                    "id": "634090204",
                    "speaker": "奥克萨娜",
                    "text": "只要是手持请柬的来客，都会受到我们的欢迎。"
                }
            ]
        },
        {
            "talkId": "6340903",
            "initDialog": "634090301",
            "dialogues": [
                {
                    "id": "634090301",
                    "speaker": "Player",
                    "text": "雪精和雪孃…"
                },
                {
                    "id": "634090302",
                    "speaker": "奥克萨娜",
                    "text": "嗯…客人在乎这个称呼上的差别吗？我想想该怎么解释…"
                },
                {
                    "id": "634090303",
                    "speaker": "奥克萨娜",
                    "text": "要用一句话说明的话，那就是…雪精中的女性也被称呼为雪孃。"
                },
                {
                    "id": "634090304",
                    "speaker": "奥克萨娜",
                    "text": "雪精是我们大的族群的名字，雪孃更像是…人类的故事中对女性雪精的称呼，后面不知道怎么回事就流行起来了…"
                }
            ]
        },
        {
            "talkId": "6340904",
            "initDialog": "634090401",
            "dialogues": [
                {
                    "id": "634090401",
                    "speaker": "Player",
                    "text": "没什么需要。"
                },
                {
                    "id": "634090402",
                    "speaker": "奥克萨娜",
                    "text": "好的，如果有需要，还请跟我说…"
                }
            ]
        }
    ]
}