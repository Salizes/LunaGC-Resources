{
    "groupId": "2082",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 1,
        "弗莱琪": 12
    },
    "talks": [
        {
            "talkId": "6208201",
            "initDialog": "620820101",
            "dialogues": [
                {
                    "id": "620820101",
                    "speaker": "弗莱琪",
                    "text": "唉，我弟弟杰里真是太弱了，自己点了菜居然完全不敢吃…"
                },
                {
                    "id": "620820102",
                    "speaker": "弗莱琪",
                    "text": "我前面尝了尝，也不过如此嘛！"
                }
            ]
        },
        {
            "talkId": "6208202",
            "initDialog": "620820201",
            "dialogues": [
                {
                    "id": "620820201",
                    "speaker": "弗莱琪",
                    "text": "你不喜欢璃月的饮食吗？"
                },
                {
                    "id": "620820202",
                    "speaker": "弗莱琪",
                    "text": "说不上讨厌，只是有些…失望？"
                },
                {
                    "id": "620820203",
                    "speaker": "弗莱琪",
                    "text": "比如这个中原杂碎，香辛料的味道完全盖住了食材原本的味道，除了辣和咸之外完全没有食材本身的味道。"
                },
                {
                    "id": "620820204",
                    "speaker": "弗莱琪",
                    "text": "我原本以为会是更有冲击性的味道，没想到也不过如此嘛。"
                },
                {
                    "id": "620820205",
                    "speaker": "弗莱琪",
                    "text": "等会儿再看看《提瓦特游览指南》，去尝尝其他小吃吧。"
                }
            ]
        },
        {
            "talkId": "6208203",
            "initDialog": "620820301",
            "dialogues": [
                {
                    "id": "620820301",
                    "speaker": "弗莱琪",
                    "text": "再见。"
                },
                {
                    "id": "620820302",
                    "speaker": "弗莱琪",
                    "text": "再见，我们也很快就要出发了…"
                }
            ]
        },
        {
            "talkId": "6208204",
            "initDialog": "620820401",
            "dialogues": [
                {
                    "id": "620820401",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "620820402",
                    "speaker": "弗莱琪",
                    "text": "很像的人…是指你的兄弟姐妹吗？我似乎没什么印象。"
                },
                {
                    "id": "620820403",
                    "speaker": "弗莱琪",
                    "text": "我能理解你的心情，要是我与弟弟杰里走散了的话，唉…"
                },
                {
                    "id": "620820404",
                    "speaker": "弗莱琪",
                    "text": "…总之，我会在旅行途中帮你留意的，希望你能早日找到你的家人。"
                }
            ]
        }
    ]
}