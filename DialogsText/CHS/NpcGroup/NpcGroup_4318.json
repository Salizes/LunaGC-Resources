{
    "groupId": "4318",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "卡桑": 11
    },
    "talks": [
        {
            "talkId": "6431801",
            "initDialog": "643180101",
            "dialogues": [
                {
                    "id": "643180101",
                    "speaker": "卡桑",
                    "text": "唉，谁来教教我和小孩们沟通的方法吧…"
                }
            ]
        },
        {
            "talkId": "6431802",
            "initDialog": "643180201",
            "dialogues": [
                {
                    "id": "643180201",
                    "speaker": "Player",
                    "text": "小孩们犯事了？"
                },
                {
                    "id": "643180202",
                    "speaker": "卡桑",
                    "text": "没有没有，这个倒是言重了。"
                },
                {
                    "id": "643180203",
                    "speaker": "卡桑",
                    "text": "是这样的，我不是负责在这边看守最下层的白之梯嘛——就是这个取水用的升降梯——以及水源的安全。"
                },
                {
                    "id": "643180204",
                    "speaker": "卡桑",
                    "text": "阿如村的人都知道在沙漠中水源的重要性，谁都不会过来捣乱。"
                },
                {
                    "id": "643180205",
                    "speaker": "卡桑",
                    "text": "但小孩子玩心有点重，老是想往水里扔石子、打水漂。"
                },
                {
                    "id": "643180206",
                    "speaker": "卡桑",
                    "text": "每次被我拦住时，他们都说「下次注意」、「再也不敢了」，但没过两天就好像忘了这茬，卷土重来…"
                }
            ]
        },
        {
            "talkId": "6431803",
            "initDialog": "643180301",
            "dialogues": [
                {
                    "id": "643180301",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "643180302",
                    "speaker": "卡桑",
                    "text": "呜…"
                }
            ]
        },
        {
            "talkId": "6431804",
            "initDialog": "643180401",
            "dialogues": [
                {
                    "id": "643180401",
                    "speaker": "Player",
                    "text": "要不我去…"
                },
                {
                    "id": "643180402",
                    "speaker": "卡桑",
                    "text": "别、别，没必要。"
                },
                {
                    "id": "643180403",
                    "speaker": "卡桑",
                    "text": "反正我在这也没什么事干，偶尔提醒下他们也还好啦。"
                },
                {
                    "id": "643180404",
                    "speaker": "卡桑",
                    "text": "而且他们最近的注意力好像转到别处去了，有时会大叫着「停运，停运，这不是演习！」朝我冲过来…"
                },
                {
                    "id": "643180405",
                    "speaker": "卡桑",
                    "text": "等等，这么一说好像更麻烦了？"
                }
            ]
        }
    ]
}