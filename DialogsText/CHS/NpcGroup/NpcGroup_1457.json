{
    "groupId": "1457",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "阿托": 8
    },
    "talks": [
        {
            "talkId": "6145701",
            "initDialog": "614570101",
            "dialogues": [
                {
                    "id": "614570101",
                    "speaker": "阿托",
                    "text": "欢迎来到西风骑士团！"
                }
            ]
        },
        {
            "talkId": "6145702",
            "initDialog": "614570201",
            "dialogues": [
                {
                    "id": "614570201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "614570202",
                    "speaker": "阿托",
                    "text": "你好，这里是西风骑士的总部。"
                },
                {
                    "id": "614570203",
                    "speaker": "阿托",
                    "text": "团长办公室、图书馆和其他各类设施都设立在此。"
                },
                {
                    "id": "614570204",
                    "speaker": "阿托",
                    "text": "虽然想要给你当向导，可还有站岗的职责在身，真不好意思。"
                }
            ]
        },
        {
            "talkId": "6145703",
            "initDialog": "614570301",
            "dialogues": [
                {
                    "id": "614570301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614570302",
                    "speaker": "阿托",
                    "text": "祝您办事顺利。"
                }
            ]
        },
        {
            "talkId": "6145704",
            "initDialog": "614570401",
            "dialogues": [
                {
                    "id": "614570401",
                    "speaker": "阿托",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6145705",
            "initDialog": "614570501",
            "dialogues": [
                {
                    "id": "614570501",
                    "speaker": "阿托",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6145706",
            "initDialog": "614570601",
            "dialogues": [
                {
                    "id": "614570601",
                    "speaker": "阿托",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        }
    ]
}