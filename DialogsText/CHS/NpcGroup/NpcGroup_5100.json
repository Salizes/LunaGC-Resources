{
    "groupId": "5100",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "瑟萝": 10
    },
    "talks": [
        {
            "talkId": "6510001",
            "initDialog": "651000101",
            "dialogues": [
                {
                    "id": "651000101",
                    "speaker": "瑟萝",
                    "text": "你好，现在这里既没有演出，也没有庭审哦，所以没有必要长时间停留。"
                }
            ]
        },
        {
            "talkId": "6510002",
            "initDialog": "651000201",
            "dialogues": [
                {
                    "id": "651000201",
                    "speaker": "Player",
                    "text": "你自己在这不寂寞吗？"
                },
                {
                    "id": "651000202",
                    "speaker": "瑟萝",
                    "text": "嗯？不会哦。"
                },
                {
                    "id": "651000203",
                    "speaker": "瑟萝",
                    "text": "这里有时会有很多人来，非常拥挤；有时又会和现在一样，到处空荡荡。"
                },
                {
                    "id": "651000204",
                    "speaker": "瑟萝",
                    "text": "很像来回拍打在海岸上的潮水，对不对？"
                },
                {
                    "id": "651000205",
                    "speaker": "瑟萝",
                    "text": "有这样的潮水陪伴，我一点都不寂寞。"
                }
            ]
        },
        {
            "talkId": "6510003",
            "initDialog": "651000301",
            "dialogues": [
                {
                    "id": "651000301",
                    "speaker": "Player",
                    "text": "明白了。"
                },
                {
                    "id": "651000302",
                    "speaker": "瑟萝",
                    "text": "嗯，出口在那边哦。"
                }
            ]
        },
        {
            "talkId": "7490401",
            "initDialog": "749040101",
            "dialogues": [
                {
                    "id": "749040101",
                    "speaker": "Player",
                    "text": "不愧是美露莘。"
                },
                {
                    "id": "749040102",
                    "speaker": "瑟萝",
                    "text": "谢谢你的夸奖，不过应该不是为了让我放松警惕故意说的吧？"
                },
                {
                    "id": "749040103",
                    "speaker": "瑟萝",
                    "text": "嗯…看你的样子，不是在捉弄我。"
                },
                {
                    "id": "749040104",
                    "speaker": "瑟萝",
                    "text": "那悄悄告诉你，其实，我更喜欢没有潮水的时候哦。"
                },
                {
                    "id": "749040105",
                    "speaker": "瑟萝",
                    "text": "以前住在海边时，我常常趁着风平浪静，游到水下去采海露花呢。"
                }
            ]
        }
    ]
}