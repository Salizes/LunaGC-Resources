{
    "groupId": "9550",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "白术": 10
    },
    "talks": [
        {
            "talkId": "6955001",
            "initDialog": "695500101",
            "dialogues": [
                {
                    "id": "695500101",
                    "speaker": "白术",
                    "text": "这间酒馆中牌客众多，积气不流…至少得开窗子通通风啊。"
                }
            ]
        },
        {
            "talkId": "6955002",
            "initDialog": "695500201",
            "dialogues": [
                {
                    "id": "695500201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955003",
            "initDialog": "695500301",
            "dialogues": [
                {
                    "id": "695500301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695500302",
                    "speaker": "白术",
                    "text": "再见。我稍后也要回去了…希望阿桂没忘记收拾那些晾晒的药草。"
                }
            ]
        },
        {
            "talkId": "6955004",
            "initDialog": "695500401",
            "dialogues": [
                {
                    "id": "695500401",
                    "speaker": "白术",
                    "text": "只是一场牌局罢了，无须挂怀。忧思过重对身体无益。这是医者的忠告。"
                }
            ]
        },
        {
            "talkId": "6955005",
            "initDialog": "695500501",
            "dialogues": [
                {
                    "id": "695500501",
                    "speaker": "白术",
                    "text": "看来我的确不擅这类游戏…对我来说，牌局算计可比调配药性难多了。"
                }
            ]
        },
        {
            "talkId": "6955006",
            "initDialog": "695500601",
            "dialogues": [
                {
                    "id": "695500601",
                    "speaker": "白术",
                    "text": "好。但我并非娴熟牌手，如果牌技让你失望，还请见谅。"
                }
            ]
        },
        {
            "talkId": "6955008",
            "initDialog": "695500801",
            "dialogues": [
                {
                    "id": "695500801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955009",
            "initDialog": "695500901",
            "dialogues": [
                {
                    "id": "695500901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955010",
            "initDialog": "695501001",
            "dialogues": [
                {
                    "id": "695501001",
                    "speaker": "白术",
                    "text": "是我略有薄运了，但是…呵呵，我的牌技看来不会让你失望了。"
                }
            ]
        },
        {
            "talkId": "6955011",
            "initDialog": "695501101",
            "dialogues": [
                {
                    "id": "695501101",
                    "speaker": "白术",
                    "text": "咳…咳咳，我输了。这倒是在我意料之中…"
                }
            ]
        },
        {
            "talkId": "6955012",
            "initDialog": "695501201",
            "dialogues": [
                {
                    "id": "695501201",
                    "speaker": "白术",
                    "text": "没问题。不过，这种卡牌游戏虽有妙趣，但却也耗神颇多，还是得注意休息。"
                }
            ]
        },
        {
            "talkId": "6955014",
            "initDialog": "695501401",
            "dialogues": [
                {
                    "id": "695501401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955015",
            "initDialog": "695501501",
            "dialogues": [
                {
                    "id": "695501501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955016",
            "initDialog": "695501601",
            "dialogues": [
                {
                    "id": "695501601",
                    "speaker": "白术",
                    "text": "是我侥幸赢了…但我看你刚才神情焦郁，注意力似乎也不太集中。是昨晚没睡好么？还是身体哪里有恙？"
                }
            ]
        },
        {
            "talkId": "6955017",
            "initDialog": "695501701",
            "dialogues": [
                {
                    "id": "695501701",
                    "speaker": "白术",
                    "text": "我输了。久思牌局，我的头都有点晕了，等会我泡杯醒神茶，你也喝一些吧。"
                }
            ]
        },
        {
            "talkId": "6955018",
            "initDialog": "695501801",
            "dialogues": [
                {
                    "id": "695501801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}