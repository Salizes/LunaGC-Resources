{
    "groupId": "7015",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 11,
        "奈芙尔": 4,
        "采若": 20,
        "雅珂达": 2
    },
    "talks": [
        {
            "talkId": "6701502",
            "initDialog": "670150201",
            "dialogues": [
                {
                    "id": "670150201",
                    "speaker": "采若",
                    "text": "欢迎来试吃！北地难得一见的品种也应有尽有哦！"
                }
            ]
        },
        {
            "talkId": "6701503",
            "initDialog": "670150301",
            "dialogues": [
                {
                    "id": "670150301",
                    "speaker": "Player",
                    "text": "这些是…"
                },
                {
                    "id": "670150302",
                    "speaker": "采若",
                    "text": "哼哼，都是从各国运来的新鲜食材喔！比如这饱满的墩墩桃，还有从纳塔运来的青蜜莓，在挪德卡莱其他地方可找不到！"
                },
                {
                    "id": "670150303",
                    "speaker": "采若",
                    "text": "怎么样，是不是看着就很有食欲？"
                }
            ]
        },
        {
            "talkId": "6701504",
            "initDialog": "670150401",
            "dialogues": [
                {
                    "id": "670150401",
                    "speaker": "Player",
                    "text": "你是璃月人？"
                },
                {
                    "id": "670150402",
                    "speaker": "采若",
                    "text": "是呀，我是从璃月港来的！俗话说「八方四路，为商为贾」，这地方既然有商机，那自然少不了我们啦。"
                },
                {
                    "id": "670150403",
                    "speaker": "采若",
                    "text": "更何况，多走走看看，了解不同地方的风土人情，对生意总是有帮助的嘛。"
                }
            ]
        },
        {
            "talkId": "6701505",
            "initDialog": "670150501",
            "dialogues": [
                {
                    "id": "670150501",
                    "speaker": "Player",
                    "text": "这些食材是怎么运来的？"
                },
                {
                    "id": "670150502",
                    "speaker": "采若",
                    "text": "哎呀，居然这么直接地向别人打听商业机密吗？还真是大胆呢。"
                },
                {
                    "id": "670150503",
                    "speaker": "采若",
                    "text": "呵呵，开玩笑的啦。主要是靠可靠的商队和特殊的保存方法，不过更具体的细节，那就真的是商业机密啦。"
                },
                {
                    "id": "670150504",
                    "speaker": "采若",
                    "text": "总之，能让大家在这里品尝到异国或者家乡的美食，辛苦点也值得，对吧？"
                }
            ]
        },
        {
            "talkId": "6701506",
            "initDialog": "670150601",
            "dialogues": [
                {
                    "id": "670150601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670150602",
                    "speaker": "采若",
                    "text": "好嘞，路上小心！下次想尝尝鲜或者需要什么食材，欢迎随时再来！"
                }
            ]
        },
        {
            "talkId": "6701507",
            "initDialog": "670150701",
            "dialogues": [
                {
                    "id": "670150701",
                    "speaker": "Player",
                    "text": "有什么特别的水果吗…"
                },
                {
                    "id": "670150702",
                    "speaker": "采若",
                    "text": "特别的水果？你瞧这墩墩桃，还有这青蜜莓，在挪德卡莱已经算是很特别的水果啦。"
                },
                {
                    "id": "670150703",
                    "speaker": "采若",
                    "text": "如果你想要璃月特产，我倒是也能帮你订购，不过，这就要视商队的时间安排啦。",
                    "choices": [
                        {
                            "id": "670150704",
                            "text": "听起来还挺麻烦的…",
                            "response": [
                                {
                                    "id": "670150706",
                                    "speaker": "采若",
                                    "text": "……"
                                },
                                {
                                    "id": "670150707",
                                    "speaker": "采若",
                                    "text": "没问题，客人请您看这边！这一堆墩墩桃可新鲜啦，来来，你直接尝一个吧。"
                                }
                            ]
                        },
                        {
                            "id": "670150705",
                            "text": "那我还是看看别的吧。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6701508",
            "initDialog": "670150801",
            "dialogues": [
                {
                    "id": "670150801",
                    "speaker": "Player",
                    "text": "关于你的商品…"
                },
                {
                    "id": "670150802",
                    "speaker": "采若",
                    "text": "都是新鲜食材，请随意挑选！"
                }
            ]
        },
        {
            "talkId": "6701509",
            "initDialog": "670150901",
            "dialogues": [
                {
                    "id": "670150901",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有话要说…？）"
                },
                {
                    "id": "670150902",
                    "speaker": "奈芙尔",
                    "text": "有什么特别的水果吗？"
                },
                {
                    "id": "670150903",
                    "speaker": "采若",
                    "text": "…那就要看，奈芙尔老板想吃{RUBY#[S]要}什么样的水{RUBY#[D]情报}果了。"
                },
                {
                    "id": "670150904",
                    "speaker": "奈芙尔",
                    "text": "喔？什么都可以？"
                },
                {
                    "id": "670150905",
                    "speaker": "采若",
                    "text": "等您说了之后，我自会去和商队{RUBY#[D]统管上司}老板商量的。"
                },
                {
                    "id": "670150906",
                    "speaker": "奈芙尔",
                    "text": "我想订购的水{RUBY#[D]情报}果数量不少，可能的话，采若小姐能把您的老{RUBY#[D]统管上司}板请来和我面谈么？"
                },
                {
                    "id": "670150907",
                    "speaker": "采若",
                    "text": "啊哈哈，此事亦要等老{RUBY#[D]统管上司}板定夺。您也知道我们的行事风格，不是吗？"
                },
                {
                    "id": "670150908",
                    "speaker": "奈芙尔",
                    "text": "我的耐心一向不错，那就麻烦采若小姐，替我邀请一下这位贵客了。"
                }
            ]
        },
        {
            "talkId": "6701510",
            "initDialog": "670151001",
            "dialogues": [
                {
                    "id": "670151001",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>雅珂达</color>似乎有话要说…？）"
                },
                {
                    "id": "670151002",
                    "speaker": "雅珂达",
                    "text": "有什么特别的水果吗？"
                },
                {
                    "id": "670151003",
                    "speaker": "采若",
                    "text": "雅珂达小姐？真稀奇，平时不都是奈芙尔老板来亲自采买么？"
                },
                {
                    "id": "670151004",
                    "speaker": "雅珂达",
                    "text": "我只是看看，今日不买水{RUBY#[D]情报}果，奈芙尔老板可没给我多少零用{RUBY#[S]采购许可}钱。"
                },
                {
                    "id": "670151005",
                    "speaker": "采若",
                    "text": "这样么？那就请雅珂达小姐随意看看，有什么想买的，告诉我就是。"
                }
            ]
        },
        {
            "talkId": "7690101",
            "initDialog": "769010101",
            "dialogues": [
                {
                    "id": "769010101",
                    "speaker": "Player",
                    "text": "真是让人垂涎欲滴！"
                },
                {
                    "id": "769010102",
                    "speaker": "采若",
                    "text": "嘿嘿，没错吧？来，先拿几个尝尝！要是觉得好吃的话，欢迎随时再来！"
                }
            ]
        }
    ]
}