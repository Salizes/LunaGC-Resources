{
    "groupId": "9401",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "菈乌玛": 9
    },
    "talks": [
        {
            "talkId": "6940101",
            "initDialog": "694010101",
            "dialogues": [
                {
                    "id": "694010101",
                    "speaker": "菈乌玛",
                    "text": "真是个神奇的房间，仿佛是幻想化成的现实…"
                },
                {
                    "id": "694010102",
                    "speaker": "菈乌玛",
                    "text": "那或许这里正是可以让人放下现实，沉浸在幻想中的地方吧。"
                },
                {
                    "id": "694010103",
                    "speaker": "菈乌玛",
                    "text": "我想，这应当可以称作精神的养料。"
                }
            ]
        },
        {
            "talkId": "6940102",
            "initDialog": "694010201",
            "dialogues": [
                {
                    "id": "694010201",
                    "speaker": "菈乌玛",
                    "text": "请让我为深入秘境的勇士们献上祝福。"
                },
                {
                    "id": "694010202",
                    "speaker": "菈乌玛",
                    "text": "伤痛并非磨难的嘉奖，应当被月光抚平。"
                },
                {
                    "id": "694010203",
                    "speaker": "菈乌玛",
                    "text": "希望霜月的庇佑不会辜负你的期待。"
                }
            ]
        },
        {
            "talkId": "6940103",
            "initDialog": "694010301",
            "dialogues": [
                {
                    "id": "694010301",
                    "speaker": "菈乌玛",
                    "text": "刚刚向旁边的小狼询问了一些关于这个房间的问题，它好像很高兴能为我解答。"
                },
                {
                    "id": "694010302",
                    "speaker": "菈乌玛",
                    "text": "呵呵…说来惭愧，我还以为是因为我拥有和动物说话的能力，所以才可以和它交谈。"
                },
                {
                    "id": "694010303",
                    "speaker": "菈乌玛",
                    "text": "看来在这个世界之中，我还有很多需要了解的东西。"
                }
            ]
        }
    ]
}