    },
    "talks": [
        {
            "talkId": "6606601",
            "initDialog": "660660101",
            "dialogues": [
                {
                    "id": "660660101",
                    "speaker": "伊波莱",
                    "text": "还是这个温度舒服…"
                }
            ]
        },
        {
            "talkId": "6606602",
            "initDialog": "660660201",
            "dialogues": [
                {
                    "id": "660660201",
                    "speaker": "Player",
                    "text": "不怕烫吗？"
                },
                {
                    "id": "660660202",
                    "speaker": "伊波莱",
                    "text": "这是什么话，怕烫我就不会来这边泡啦！"
                },
                {
                    "id": "660660203",
                    "speaker": "伊波莱",
                    "text": "看到这些鳍游龙了吗？那你就该知道这里的温度是什么水平了。"
                },
                {
                    "id": "660660204",
                    "speaker": "伊波莱",
                    "text": "你看，能一边泡温泉一边和鳍游龙交流感情，这不是一举多得嘛。"
                },
                {
                    "id": "660660205",
                    "speaker": "伊波莱",
                    "text": "对了，前阵子有个稻妻游客教了我怎么用温泉煮蛋，真厉害，这下连零食都有了。"
                }
            ]
        },
        {
            "talkId": "6606603",
            "initDialog": "660660301",
            "dialogues": [
                {
                    "id": "660660301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660660302",
                    "speaker": "伊波莱",
                    "text": "再见，小心别被水烫伤！"
                }
            ]
        },
        {
            "talkId": "7592901",
            "initDialog": "759290101",
            "dialogues": [
                {
                    "id": "759290101",
                    "speaker": "Player",
                    "text": "还是要注意身体哦。"
                },
                {
                    "id": "759290102",
                    "speaker": "伊波莱",
                    "text": "嗯嗯，明白，我再泡一会儿就回去啦。"
                },
                {
                    "id": "759290103",
                    "speaker": "伊波莱",
                    "text": "呼…这个温度，感觉要从内到外地融化了…"
                }
            ]
        }
    ]
}