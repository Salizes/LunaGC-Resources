{
    "groupId": "9402",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "菲林斯": 9
    },
    "talks": [
        {
            "talkId": "6940201",
            "initDialog": "694020101",
            "dialogues": [
                {
                    "id": "694020101",
                    "speaker": "菲林斯",
                    "text": "稍等，枪刃上似乎沾上了一些不干净的东西。"
                },
                {
                    "id": "694020102",
                    "speaker": "菲林斯",
                    "text": "我想，在下一场战斗开始之前，我们有必要好好保养一下武器，顺便休息一番。"
                },
                {
                    "id": "694020103",
                    "speaker": "菲林斯",
                    "text": "清醒的头脑和锋利的武器，两者缺一不可。"
                }
            ]
        },
        {
            "talkId": "6940202",
            "initDialog": "694020201",
            "dialogues": [
                {
                    "id": "694020201",
                    "speaker": "菲林斯",
                    "text": "在阴影中伺机而动的敌人，似乎很多啊。"
                },
                {
                    "id": "694020202",
                    "speaker": "菲林斯",
                    "text": "毋需忧心，保存力量，集中解决它们之中的匪首就好。"
                },
                {
                    "id": "694020203",
                    "speaker": "菲林斯",
                    "text": "蠕动的魔物和如此美丽的厅堂可不相称。"
                }
            ]
        },
        {
            "talkId": "6940203",
            "initDialog": "694020301",
            "dialogues": [
                {
                    "id": "694020301",
                    "speaker": "菲林斯",
                    "text": "这里的茶水香气很足，请允许我向主人致意。"
                },
                {
                    "id": "694020302",
                    "speaker": "菲林斯",
                    "text": "…看你的表情，似乎有些为难，啊，看来是我的请求有几分唐突了。"
                },
                {
                    "id": "694020303",
                    "speaker": "菲林斯",
                    "text": "品味不俗的茶水，散落着珍奇的房间，此处的秘密正在沉睡…我来到了有意思的地方啊。"
                }
            ]
        }
    ]
}