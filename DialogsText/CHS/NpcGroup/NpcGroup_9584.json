    },
    "talks": [
        {
            "talkId": "6958401",
            "initDialog": "695840101",
            "dialogues": [
                {
                    "id": "695840101",
                    "speaker": "艾梅莉埃",
                    "text": "咳…抱歉，这里的气味可谓有些混杂了。"
                }
            ]
        },
        {
            "talkId": "6958402",
            "initDialog": "695840201",
            "dialogues": [
                {
                    "id": "695840201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958403",
            "initDialog": "695840301",
            "dialogues": [
                {
                    "id": "695840301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695840302",
                    "speaker": "艾梅莉埃",
                    "text": "再见。稍后我也会动身回枫丹廷了，还有诸多事务要处理。"
                }
            ]
        },
        {
            "talkId": "6958404",
            "initDialog": "695840401",
            "dialogues": [
                {
                    "id": "695840401",
                    "speaker": "艾梅莉埃",
                    "text": "你的眼神有些恍惚，是累了么？稍等，我带了一些能提神的香薰片，请你先浅闻一下，但不要深吸，否则会被呛到。"
                }
            ]
        },
        {
            "talkId": "6958405",
            "initDialog": "695840501",
            "dialogues": [
                {
                    "id": "695840501",
                    "speaker": "艾梅莉埃",
                    "text": "失败的气息并不好闻啊…但恭喜你，这是你努力应得的。"
                }
            ]
        },
        {
            "talkId": "6958406",
            "initDialog": "695840601",
            "dialogues": [
                {
                    "id": "695840601",
                    "speaker": "艾梅莉埃",
                    "text": "你亲自来邀请，是我的荣幸。"
                }
            ]
        },
        {
            "talkId": "6958408",
            "initDialog": "695840801",
            "dialogues": [
                {
                    "id": "695840801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958409",
            "initDialog": "695840901",
            "dialogues": [
                {
                    "id": "695840901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958410",
            "initDialog": "695841001",
            "dialogues": [
                {
                    "id": "695841001",
                    "speaker": "艾梅莉埃",
                    "text": "承让，这一局是我赢了。"
                }
            ]
        },
        {
            "talkId": "6958411",
            "initDialog": "695841101",
            "dialogues": [
                {
                    "id": "695841101",
                    "speaker": "艾梅莉埃",
                    "text": "我输了，是你更胜一筹。"
                }
            ]
        },
        {
            "talkId": "6958412",
            "initDialog": "695841201",
            "dialogues": [
                {
                    "id": "695841201",
                    "speaker": "艾梅莉埃",
                    "text": "我对这种卡牌也有些兴趣，请你先落座吧。"
                }
            ]
        },
        {
            "talkId": "6958414",
            "initDialog": "695841401",
            "dialogues": [
                {
                    "id": "695841401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958415",
            "initDialog": "695841501",
            "dialogues": [
                {
                    "id": "695841501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958416",
            "initDialog": "695841601",
            "dialogues": [
                {
                    "id": "695841601",
                    "speaker": "艾梅莉埃",
                    "text": "也算是一个符合期望的结局…呼，计算了整场，神经都绷得过于紧张了。"
                }
            ]
        },
        {
            "talkId": "6958417",
            "initDialog": "695841701",
            "dialogues": [
                {
                    "id": "695841701",
                    "speaker": "艾梅莉埃",
                    "text": "是你胜了。刚才那一手我应该更谨慎些，些许冒进，葬送整局。"
                }
            ]
        },
        {
            "talkId": "6958418",
            "initDialog": "695841801",
            "dialogues": [
                {
                    "id": "695841801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}