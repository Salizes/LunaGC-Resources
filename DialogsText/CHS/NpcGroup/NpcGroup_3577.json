{
    "groupId": "3577",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 15
    },
    "talks": [
        {
            "talkId": "6357701",
            "initDialog": "635770101",
            "dialogues": [
                {
                    "id": "635770101",
                    "speaker": "派蒙",
                    "text": "嗯…让我们看看桌上的东西…"
                }
            ]
        },
        {
            "talkId": "6357702",
            "initDialog": "635770201",
            "dialogues": [
                {
                    "id": "635770201",
                    "speaker": "Player",
                    "text": "关于金发的玩偶…"
                },
                {
                    "id": "635770202",
                    "speaker": "派蒙",
                    "text": "这个娃娃，啊，全是雪精的那个馆里的，伊科尔变成的娃娃…"
                },
                {
                    "id": "635770203",
                    "speaker": "派蒙",
                    "text": "如果我们没能阻止帕芙琳娜，一切又会变成什么样呢…"
                }
            ]
        },
        {
            "talkId": "6357703",
            "initDialog": "635770301",
            "dialogues": [
                {
                    "id": "635770301",
                    "speaker": "Player",
                    "text": "关于娜斯佳的画片…"
                },
                {
                    "id": "635770302",
                    "speaker": "派蒙",
                    "text": "看到这个就想到了娜斯佳…我还是不懂，娜斯佳为什么不愿意和我们一起出来…"
                },
                {
                    "id": "635770303",
                    "speaker": "派蒙",
                    "text": "她现在，变成了那样…还会感觉到寂寞吗？"
                }
            ]
        },
        {
            "talkId": "6357704",
            "initDialog": "635770401",
            "dialogues": [
                {
                    "id": "635770401",
                    "speaker": "Player",
                    "text": "关于列车模型…"
                },
                {
                    "id": "635770402",
                    "speaker": "派蒙",
                    "text": "…这个火车头，咦，你在从前的谧源所见过吗？"
                },
                {
                    "id": "635770403",
                    "speaker": "派蒙",
                    "text": "原来如此，说不定从前列车的原型也是他们造出来的呢…"
                }
            ]
        },
        {
            "talkId": "6357705",
            "initDialog": "635770501",
            "dialogues": [
                {
                    "id": "635770501",
                    "speaker": "Player",
                    "text": "关于套娃…"
                },
                {
                    "id": "635770502",
                    "speaker": "派蒙",
                    "text": "能看得出来这是奥黛塔和沃雅妮莎，怪怪的，但很可爱，嘿嘿。"
                },
                {
                    "id": "635770503",
                    "speaker": "派蒙",
                    "text": "那时候真是在屋子里憋坏了，看什么都很新奇，也从来没觉得到处乱飞是那——么爽的一件事！"
                },
                {
                    "id": "635770504",
                    "speaker": "派蒙",
                    "text": "欸？你问我这两个套娃要是被晃倒了怎么办…说得对哦，要不要粘一下…"
                }
            ]
        },
        {
            "talkId": "6357706",
            "initDialog": "635770601",
            "dialogues": [
                {
                    "id": "635770601",
                    "speaker": "Player",
                    "text": "关于霜精小雕像…"
                },
                {
                    "id": "635770602",
                    "speaker": "派蒙",
                    "text": "嗯，看到这个就想到霜精…"
                },
                {
                    "id": "635770603",
                    "speaker": "派蒙",
                    "text": "它们的村子现在应该不会再被兽怪袭击了吧…"
                }
            ]
        },
        {
            "talkId": "6357707",
            "initDialog": "635770701",
            "dialogues": [
                {
                    "id": "635770701",
                    "speaker": "Player",
                    "text": "关于海报…"
                },
                {
                    "id": "635770702",
                    "speaker": "派蒙",
                    "text": "回想起来，那两周虽然过得忙忙碌碌，但一切都很值得。"
                },
                {
                    "id": "635770703",
                    "speaker": "派蒙",
                    "text": "特别是最后奥黛塔的演出《黑雪鹄》，看得我好感动！在她的舞步中，她就像故事中的主人公一样重获新生了呢！"
                }
            ]
        },
        {
            "talkId": "6357708",
            "initDialog": "635770801",
            "dialogues": [
                {
                    "id": "635770801",
                    "speaker": "派蒙",
                    "text": "这桌子上什么都没有呢…说不定之后在至冬收集到什么，就可以放在这个桌子上…"
                }
            ]
        }
    ]
}