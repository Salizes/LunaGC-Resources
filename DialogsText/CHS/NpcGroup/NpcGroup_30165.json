    "talks": [
        {
            "talkId": "4006344",
            "initDialog": "400634401",
            "dialogues": [
                {
                    "id": "400634401",
                    "speaker": "志穗",
                    "text": "美羽，好点了吗？"
                },
                {
                    "id": "400634402",
                    "speaker": "美羽",
                    "text": "呜呜呜…怎么会这样？鲷鱼烧老师因为工作繁忙，不仅窗掉了这次展会，《来自地心的国度与献给你的花束》也无限期暂停创作？"
                },
                {
                    "id": "400634403",
                    "speaker": "美羽",
                    "text": "呜呜…怎么会这样？上一卷的结尾，两位主人公明明要互诉衷肠了啊…"
                },
                {
                    "id": "400634404",
                    "speaker": "志穗",
                    "text": "美羽，冷静一点…"
                },
                {
                    "id": "400634405",
                    "speaker": "美羽",
                    "text": "你根本不明白我的心情！鲷鱼烧老师这篇同人小说的原作里，两位主人公最终也没能解开误会，最终分道扬镳了！"
                },
                {
                    "id": "400634406",
                    "speaker": "美羽",
                    "text": "我把他们幸福的全部希望，都寄托在了鲷鱼烧老师身上啊！"
                },
                {
                    "id": "400634407",
                    "speaker": "志穗",
                    "text": "既然这么希望他们幸福，你也来写写看怎么样？"
                },
                {
                    "id": "400634408",
                    "speaker": "美羽",
                    "text": "我…我吗？嗯…有道理，求人不如求己！"
                }
            ]
        }
    ]
}