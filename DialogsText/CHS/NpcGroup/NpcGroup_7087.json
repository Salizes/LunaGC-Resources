    "talks": [
        {
            "talkId": "6708701",
            "initDialog": "670870101",
            "dialogues": [
                {
                    "id": "670870101",
                    "speaker": "米科",
                    "text": "卡嘉不会还在生气吧…"
                }
            ]
        },
        {
            "talkId": "6708702",
            "initDialog": "670870201",
            "dialogues": [
                {
                    "id": "670870201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "670870202",
                    "speaker": "米科",
                    "text": "没、没什么大不了的啦，就是…就是之前摔坏了一些东西。"
                },
                {
                    "id": "670870203",
                    "speaker": "米科",
                    "text": "卡嘉也有不对的地方吧，如果按我说的全都换成木头或者铁的，就不会发生这种事了！"
                },
                {
                    "id": "670870204",
                    "speaker": "米科",
                    "text": "唔…她要是还在生气的话，该怎么办呢…"
                }
            ]
        },
        {
            "talkId": "6708703",
            "initDialog": "670870301",
            "dialogues": [
                {
                    "id": "670870301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670870302",
                    "speaker": "米科",
                    "text": "啊，慢、慢走！"
                }
            ]
        },
        {
            "talkId": "6708704",
            "initDialog": "670870401",
            "dialogues": [
                {
                    "id": "670870401",
                    "speaker": "Player",
                    "text": "你道过歉了吗？"
                },
                {
                    "id": "670870402",
                    "speaker": "米科",
                    "text": "可、可是又不全是我的错，为什么要我先道歉！"
                },
                {
                    "id": "670870403",
                    "speaker": "米科",
                    "text": "…你也觉得是我错了？可是要道歉的话…应该给卡嘉准备一些礼物吗？伏尼契商会应该能买到吧…"
                }
            ]
        }
    ]
}