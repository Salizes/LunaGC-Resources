{
    "groupId": "5072",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "莱莲": 12
    },
    "talks": [
        {
            "talkId": "6507201",
            "initDialog": "650720101",
            "dialogues": [
                {
                    "id": "650720101",
                    "speaker": "莱莲",
                    "text": "嘿，朋友！想要换种人生吗？"
                }
            ]
        },
        {
            "talkId": "6507202",
            "initDialog": "650720201",
            "dialogues": [
                {
                    "id": "650720201",
                    "speaker": "Player",
                    "text": "你在说什么？"
                },
                {
                    "id": "650720202",
                    "speaker": "莱莲",
                    "text": "你可能想象不到，这世上有多少人想要一个「重启人生」的机会。"
                },
                {
                    "id": "650720203",
                    "speaker": "莱莲",
                    "text": "若是能直接在外表上下些功夫，那岂不是难度减半？而我就专门在做这项研究呢。"
                },
                {
                    "id": "650720204",
                    "speaker": "莱莲",
                    "text": "这是一项很有前景的研究！你看起来像是个目光长远的聪明人，要不要考虑来赞助我一些经费？"
                },
                {
                    "id": "650720205",
                    "speaker": "莱莲",
                    "text": "我可是正经的枫丹科学院工程师，我是说…前工程师。"
                }
            ]
        },
        {
            "talkId": "6507203",
            "initDialog": "650720301",
            "dialogues": [
                {
                    "id": "650720301",
                    "speaker": "Player",
                    "text": "不了，谢谢。"
                },
                {
                    "id": "650720302",
                    "speaker": "莱莲",
                    "text": "好吧，又失败了…"
                }
            ]
        },
        {
            "talkId": "6507204",
            "initDialog": "650720401",
            "dialogues": [
                {
                    "id": "650720401",
                    "speaker": "Player",
                    "text": "听着可疑，你老实交代。"
                },
                {
                    "id": "650720402",
                    "speaker": "莱莲",
                    "text": "好吧，好吧，看来我确实没有拉投资的天赋…"
                },
                {
                    "id": "650720403",
                    "speaker": "莱莲",
                    "text": "但我的确曾是枫丹科学院的工程师，梦想借助机关装置实现对「绝对美学」的追求。"
                },
                {
                    "id": "650720404",
                    "speaker": "莱莲",
                    "text": "岂知试验发生了意外，一起研究的同事…呃，外表上受到了一些损伤。"
                },
                {
                    "id": "650720405",
                    "speaker": "莱莲",
                    "text": "…总而言之，当我从梅洛彼得堡回来后，就来这里生活了。"
                },
                {
                    "id": "650720406",
                    "speaker": "莱莲",
                    "text": "他们说「灰河」是灰色地带，也许我能在这里搞到一笔经费。"
                },
                {
                    "id": "650720407",
                    "speaker": "莱莲",
                    "text": "但其实根本不是这么回事，刺玫会的人盯这里盯得可紧了。"
                }
            ]
        }
    ]
}