{
    "groupId": "6223",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "特佐佐": 10
    },
    "talks": [
        {
            "talkId": "6622301",
            "initDialog": "662230101",
            "dialogues": [
                {
                    "id": "662230101",
                    "speaker": "特佐佐",
                    "text": "要不要找希皮利哥哥再要一点呢…"
                }
            ]
        },
        {
            "talkId": "6622302",
            "initDialog": "662230201",
            "dialogues": [
                {
                    "id": "662230201",
                    "speaker": "Player",
                    "text": "要什么？"
                },
                {
                    "id": "662230202",
                    "speaker": "特佐佐",
                    "text": "手工材料！希皮利的手工可厉害了，我也想学。"
                },
                {
                    "id": "662230203",
                    "speaker": "特佐佐",
                    "text": "但是哥哥给了我好多稀奇古怪的材料，说是要我自己摸索组合方式才有意思。"
                },
                {
                    "id": "662230204",
                    "speaker": "特佐佐",
                    "text": "的确很有意思，就是我的想法太多了，消耗也很多，有时还会弄丢…"
                },
                {
                    "id": "662230205",
                    "speaker": "特佐佐",
                    "text": "搞着搞着，就只剩这些了…"
                }
            ]
        },
        {
            "talkId": "6622303",
            "initDialog": "662230301",
            "dialogues": [
                {
                    "id": "662230301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662230302",
                    "speaker": "特佐佐",
                    "text": "唔，再见，我再试试别的材料吧。"
                }
            ]
        },
        {
            "talkId": "7594501",
            "initDialog": "759450101",
            "dialogues": [
                {
                    "id": "759450101",
                    "speaker": "Player",
                    "text": "要珍惜已有之物。"
                },
                {
                    "id": "759450102",
                    "speaker": "特佐佐",
                    "text": "嗯…你说的对！"
                },
                {
                    "id": "759450103",
                    "speaker": "特佐佐",
                    "text": "还是要先充分用好手里的东西，再考虑额外的想法。"
                },
                {
                    "id": "759450104",
                    "speaker": "特佐佐",
                    "text": "这些听说是从液态燃素里长出的果实…嗯，我想我暂时还用不好…"
                },
                {
                    "id": "759450105",
                    "speaker": "特佐佐",
                    "text": "请你收下吧，让它们能有自己的用武之地。"
                }
            ]
        }
    ]
}