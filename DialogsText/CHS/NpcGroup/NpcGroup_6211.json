    "talks": [
        {
            "talkId": "5900233",
            "initDialog": "590023301",
            "dialogues": [
                {
                    "id": "590023301",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900234",
            "initDialog": "590023401",
            "dialogues": [
                {
                    "id": "590023401",
                    "speaker": "提帕诺",
                    "text": "嗯…想不到有什么值得一提的…但风景是真的很不错。"
                }
            ]
        },
        {
            "talkId": "6621101",
            "initDialog": "662110101",
            "dialogues": [
                {
                    "id": "662110101",
                    "speaker": "提帕诺",
                    "text": "没人捣乱，轻轻松松。"
                }
            ]
        },
        {
            "talkId": "6621102",
            "initDialog": "662110201",
            "dialogues": [
                {
                    "id": "662110201",
                    "speaker": "Player",
                    "text": "心情不错？"
                },
                {
                    "id": "662110202",
                    "speaker": "提帕诺",
                    "text": "当然。"
                },
                {
                    "id": "662110203",
                    "speaker": "提帕诺",
                    "text": "在烟谜主巡逻可能是最轻松的事情了，这些人要么找不到人影，要么憋在家里不出门。"
                },
                {
                    "id": "662110204",
                    "speaker": "提帕诺",
                    "text": "一些简单的魔物，也能靠准备好的燃素刻录轻松解决。"
                },
                {
                    "id": "662110205",
                    "speaker": "提帕诺",
                    "text": "主要是别让鲁莽的外人去打扰暝视龙们就好。龙要是闹起脾气来，可不是说着玩的。"
                }
            ]
        },
        {
            "talkId": "6621103",
            "initDialog": "662110301",
            "dialogues": [
                {
                    "id": "662110301",
                    "speaker": "Player",
                    "text": "心情不错？"
                },
                {
                    "id": "662110302",
                    "speaker": "提帕诺",
                    "text": "当然。"
                },
                {
                    "id": "662110303",
                    "speaker": "提帕诺",
                    "text": "只要不像之前那样发生大规模的深渊袭击，在烟谜主巡逻可能是最轻松的事情了。"
                },
                {
                    "id": "662110304",
                    "speaker": "提帕诺",
                    "text": "那时可真是够呛，还好有很多外面的朋友赶回来帮忙，真是谢天谢地。"
                },
                {
                    "id": "662110305",
                    "speaker": "提帕诺",
                    "text": "至于平时，本部族的这些人要么找不到人影，要么憋在家里不出门。"
                },
                {
                    "id": "662110306",
                    "speaker": "提帕诺",
                    "text": "一些简单的魔物，也能靠准备好的燃素刻录轻松解决。"
                },
                {
                    "id": "662110307",
                    "speaker": "提帕诺",
                    "text": "主要是别让鲁莽的外人去打扰暝视龙们就好。龙要是闹起脾气来，可不是说着玩的。"
                }
            ]
        },
        {
            "talkId": "6621104",
            "initDialog": "662110401",
            "dialogues": [
                {
                    "id": "662110401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662110402",
                    "speaker": "提帕诺",
                    "text": "再见！"
                }
            ]
        },
        {
            "talkId": "7594601",
            "initDialog": "759460101",
            "dialogues": [
                {
                    "id": "759460101",
                    "speaker": "Player",
                    "text": "安抚需要技巧。"
                },
                {
                    "id": "759460102",
                    "speaker": "提帕诺",
                    "text": "没错啊没错。"
                },
                {
                    "id": "759460103",
                    "speaker": "提帕诺",
                    "text": "而且有些龙太固执了。上次有个人未经同意摸了暝视龙的羽毛，最后写了整整三页保证书呢！"
                },
                {
                    "id": "759460104",
                    "speaker": "提帕诺",
                    "text": "也不知道龙到底看没看懂。这也是一时手欠的代价吧，哈哈。"
                }
            ]
        }
    ]
}