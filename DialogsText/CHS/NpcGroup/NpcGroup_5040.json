{
    "groupId": "5040",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "克叙涅": 13
    },
    "talks": [
        {
            "talkId": "6504001",
            "initDialog": "650400101",
            "dialogues": [
                {
                    "id": "650400101",
                    "speaker": "克叙涅",
                    "text": "这些…好像还不够厉害…"
                }
            ]
        },
        {
            "talkId": "6504002",
            "initDialog": "650400201",
            "dialogues": [
                {
                    "id": "650400201",
                    "speaker": "Player",
                    "text": "在挑礼物吗？"
                },
                {
                    "id": "650400202",
                    "speaker": "克叙涅",
                    "text": "哦，没错，好久没回枫丹了，想看看最近出了些什么新玩意。"
                },
                {
                    "id": "650400203",
                    "speaker": "克叙涅",
                    "text": "出海到其他国家后，发现外国人好像都觉得枫丹的机械工业很厉害，我也挺自豪。"
                },
                {
                    "id": "650400204",
                    "speaker": "克叙涅",
                    "text": "不过回来一看，这些发条商品可能配不上他们心中那么厉害的形象啊…"
                }
            ]
        },
        {
            "talkId": "6504003",
            "initDialog": "650400301",
            "dialogues": [
                {
                    "id": "650400301",
                    "speaker": "Player",
                    "text": "需要有多厉害？"
                },
                {
                    "id": "650400302",
                    "speaker": "克叙涅",
                    "text": "比如…警卫机关？"
                },
                {
                    "id": "650400303",
                    "speaker": "克叙涅",
                    "text": "啊哈哈，我开玩笑的，请不要叫警备队员过来。"
                },
                {
                    "id": "650400304",
                    "speaker": "克叙涅",
                    "text": "唔，我记得之前听说枫丹科学院正在研究什么新材料。"
                },
                {
                    "id": "650400305",
                    "speaker": "克叙涅",
                    "text": "要是那边没有炸毁的话，搞那么一两个反重力沙漏，或者悬浮的交通工具应该不在话下吧？"
                }
            ]
        },
        {
            "talkId": "6504004",
            "initDialog": "650400401",
            "dialogues": [
                {
                    "id": "650400401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "650400402",
                    "speaker": "克叙涅",
                    "text": "没关系。嗯…到底挑什么才好…"
                }
            ]
        },
        {
            "talkId": "6504005",
            "initDialog": "650400501",
            "dialogues": [
                {
                    "id": "650400501",
                    "speaker": "Player",
                    "text": "悬浮巡轨船…"
                },
                {
                    "id": "650400502",
                    "speaker": "克叙涅",
                    "text": "哦！这确实是个好办法…但那样的话，就根本不需要水道了吧？"
                },
                {
                    "id": "650400503",
                    "speaker": "克叙涅",
                    "text": "现在的水道已经很方便了。说起来，我和帮助建造水道的卡雷斯先生还有过一些交情呢。"
                },
                {
                    "id": "650400504",
                    "speaker": "克叙涅",
                    "text": "以前多亏他的帮助，我这商船的路线才能跑通…唉，真令人遗憾…"
                },
                {
                    "id": "650400505",
                    "speaker": "克叙涅",
                    "text": "也不知道他的女儿娜维娅小姐最近怎么样了，有机会我得去问候一下…"
                }
            ]
        }
    ]
}