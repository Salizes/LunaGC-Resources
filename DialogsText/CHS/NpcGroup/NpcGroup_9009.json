{
    "groupId": "9009",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 16,
        "久岐忍": 55
    },
    "talks": [
        {
            "talkId": "6900901",
            "initDialog": "690090101",
            "dialogues": [
                {
                    "id": "690090101",
                    "speaker": "久岐忍",
                    "text": "#{NICKNAME}，最近在忙什么？"
                },
                {
                    "id": "690090102",
                    "speaker": "久岐忍",
                    "text": "难得的休息日，我正准备好好利用一番。"
                }
            ]
        },
        {
            "talkId": "6900902",
            "initDialog": "690090201",
            "dialogues": [
                {
                    "id": "690090201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690090202",
                    "speaker": "久岐忍",
                    "text": "嗯，很舒服，谢谢你的邀请。"
                },
                {
                    "id": "690090203",
                    "speaker": "久岐忍",
                    "text": "刚刚绕了几圈参观了一下，你的规划还挺有意思的，你学过景观设计吗？",
                    "choices": [
                        {
                            "id": "690090204",
                            "text": "没有，随便弄弄而已。",
                            "response": [
                                {
                                    "id": "690090205",
                                    "speaker": "久岐忍",
                                    "text": "噢，那你就是所谓天赋型人才吧，无师自通那种。"
                                },
                                {
                                    "id": "690090208",
                                    "speaker": "久岐忍",
                                    "text": "但其实，这让我也有些心动，我是不是可以去考个景观设计证书呢？"
                                },
                                {
                                    "id": "690090209",
                                    "speaker": "Player",
                                    "text": "想考就考！"
                                },
                                {
                                    "id": "690090210",
                                    "speaker": "久岐忍",
                                    "text": "你倒也很爽快。哈哈，谢谢你的建议。"
                                },
                                {
                                    "id": "690090211",
                                    "speaker": "久岐忍",
                                    "text": "那我就试试看吧。不过在那之前，可以麻烦你提供这个场地让我练手么？"
                                },
                                {
                                    "id": "690090212",
                                    "speaker": "久岐忍",
                                    "text": "作为回报的话…我来包你这阵子的烤堇瓜，如何？"
                                }
                            ]
                        },
                        {
                            "id": "690090206",
                            "text": "确实懂一点，阿忍也学过？",
                            "response": [
                                {
                                    "id": "690090207",
                                    "speaker": "久岐忍",
                                    "text": "我倒还没怎么学…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900903",
            "initDialog": "690090301",
            "dialogues": [
                {
                    "id": "690090301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690090302",
                    "speaker": "久岐忍",
                    "text": "可以啊，闲着也是闲着，想问什么就直接问吧。"
                },
                {
                    "id": "690090303",
                    "speaker": "Player",
                    "text": "阿忍为什么讨厌巫女呢？"
                },
                {
                    "id": "690090304",
                    "speaker": "久岐忍",
                    "text": "我想你可能误会了…"
                },
                {
                    "id": "690090305",
                    "speaker": "久岐忍",
                    "text": "我并不讨厌任何一位具体的巫女，也不针对巫女这个职业。我深知每一项工作都很不容易…"
                },
                {
                    "id": "690090306",
                    "speaker": "久岐忍",
                    "text": "只是巫女这个职业真的不适合我。这里面的原因很复杂，我得想想怎么解释比较好…",
                    "choices": [
                        {
                            "id": "690090307",
                            "text": "是家里的原因吗？",
                            "response": [
                                {
                                    "id": "690090308",
                                    "speaker": "久岐忍",
                                    "text": "嗯…让你见笑了。的确有跟家里赌气的成分…"
                                },
                                {
                                    "id": "690090309",
                                    "speaker": "久岐忍",
                                    "text": "我知道家里人是为我好，但以这个名义为我安排好所有事情，反倒让我不自在。"
                                },
                                {
                                    "id": "690090310",
                                    "speaker": "久岐忍",
                                    "text": "总觉得我是孩子，事事都要叮嘱我别出错。每次接到来信投诉我态度冷淡，都要说上个三天三夜。"
                                },
                                {
                                    "id": "690090311",
                                    "speaker": "久岐忍",
                                    "text": "我本来就不爱笑，根本不是故意对人冷淡…"
                                },
                                {
                                    "id": "690090318",
                                    "speaker": "Player",
                                    "text": "能够理解…"
                                },
                                {
                                    "id": "690090319",
                                    "speaker": "久岐忍",
                                    "text": "总之，还是那些评判标准清晰明了的、付出了就能看到实际效果的工作更适合我。"
                                },
                                {
                                    "id": "690090320",
                                    "speaker": "久岐忍",
                                    "text": "做起来得心应手，也可以让家里人知道，我的选择未必不如他们。"
                                },
                                {
                                    "id": "690090321",
                                    "speaker": "久岐忍",
                                    "text": "最最重要的是，现在的我不用勉强自己，可以过一种相对自由的人生。"
                                }
                            ]
                        },
                        {
                            "id": "690090312",
                            "text": "是自己的原因吗？",
                            "response": [
                                {
                                    "id": "690090313",
                                    "speaker": "久岐忍",
                                    "text": "嗯，可能是吧。"
                                },
                                {
                                    "id": "690090314",
                                    "speaker": "久岐忍",
                                    "text": "很多人求签只是为了讨得吉利，对签文上的结果也不算太在意。"
                                },
                                {
                                    "id": "690090315",
                                    "speaker": "久岐忍",
                                    "text": "但也有些人，他们由于种种原因陷入困境，就把祈愿作为自己最后的救命稻草…"
                                },
                                {
                                    "id": "690090316",
                                    "speaker": "久岐忍",
                                    "text": "渴望有天降的力量帮自己解决一切。"
                                },
                                {
                                    "id": "690090317",
                                    "speaker": "久岐忍",
                                    "text": "我是不认可的。我也没法说出「总会好起来的」这种不太负责的话。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900904",
            "initDialog": "690090401",
            "dialogues": [
                {
                    "id": "690090401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690090402",
                    "speaker": "久岐忍",
                    "text": "嗯，有件事想托你帮忙，而且非你不可。"
                },
                {
                    "id": "690090403",
                    "speaker": "久岐忍",
                    "text": "我正在做「移居置业企划」…"
                },
                {
                    "id": "690090404",
                    "speaker": "久岐忍",
                    "text": "不同国家关于外来务工人员的置业政策我是了解的，但人文情况就不太清楚了…"
                },
                {
                    "id": "690090405",
                    "speaker": "久岐忍",
                    "text": "在不同地区生活要注意什么，有什么帮派组织和地方势力？"
                },
                {
                    "id": "690090406",
                    "speaker": "久岐忍",
                    "text": "你去过的地方多，能帮忙给点建议吗？",
                    "choices": [
                        {
                            "id": "690090407",
                            "text": "等等…",
                            "response": [
                                {
                                    "id": "690090409",
                                    "speaker": "久岐忍",
                                    "text": "哈？！怎么可能！这不关荒泷派什么事。"
                                },
                                {
                                    "id": "690090410",
                                    "speaker": "久岐忍",
                                    "text": "我只是帮客户做「移民企划书」而已，顺便还要出差几天。"
                                },
                                {
                                    "id": "690090411",
                                    "speaker": "久岐忍",
                                    "text": "至于那群家伙…我倒是在准备「荒泷派生存与生活百宝书」，进展还行…"
                                },
                                {
                                    "id": "690090412",
                                    "speaker": "久岐忍",
                                    "text": "你看，那些笨蛋个个心地不坏，却经常惹是生非。"
                                },
                                {
                                    "id": "690090413",
                                    "speaker": "久岐忍",
                                    "text": "我也不能时时刻刻蹲守在他们身边，从长远来看，总得想点办法。",
                                    "choices": [
                                        {
                                            "id": "690090414",
                                            "text": "阿忍不会准备离开荒泷派吧？",
                                            "response": [
                                                {
                                                    "id": "690090415",
                                                    "speaker": "久岐忍",
                                                    "text": "那当然不会，起码也不是现在。作为实际管事人，我还没打造出令我自己满意的荒泷派呢，不能半途而废。"
                                                },
                                                {
                                                    "id": "690090416",
                                                    "speaker": "久岐忍",
                                                    "text": "至于以后的事情，谁都说不准吧。"
                                                },
                                                {
                                                    "id": "690090417",
                                                    "speaker": "久岐忍",
                                                    "text": "要是以后真的走到这一步，大家不得不分开，也只能说是人之常情…"
                                                },
                                                {
                                                    "id": "690090422",
                                                    "speaker": "久岐忍",
                                                    "text": "只要大家都在为各自的人生努力，不管要走向哪个方向，都是值得祝福的。"
                                                },
                                                {
                                                    "id": "690090423",
                                                    "speaker": "久岐忍",
                                                    "text": "就像荒泷派和我，就像我和你。无论将来身处何地，在不在一起，都会支持彼此，你说是吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690090418",
                                            "text": "不管阿忍做什么我都会支持！",
                                            "response": [
                                                {
                                                    "id": "690090419",
                                                    "speaker": "久岐忍",
                                                    "text": "这可是你说的，口头约定同样具有律法效力。"
                                                },
                                                {
                                                    "id": "690090420",
                                                    "speaker": "久岐忍",
                                                    "text": "要是我以后离开荒泷派，转而投奔你的时候，你可不能拒绝。嗯…阿圆作证。"
                                                },
                                                {
                                                    "id": "690090421",
                                                    "speaker": "久岐忍",
                                                    "text": "呵呵，不过可惜。我不想投靠任何人，这不符合我的个性。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690090408",
                            "text": "你要带荒泷派跑路吗…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900905",
            "initDialog": "690090501",
            "dialogues": [
                {
                    "id": "690090501",
                    "speaker": "Player",
                    "text": "早啊，阿忍！"
                },
                {
                    "id": "690090502",
                    "speaker": "久岐忍",
                    "text": "#早，{NICKNAME}。白天有事要忙？需要帮忙就喊我。"
                },
                {
                    "id": "690090503",
                    "speaker": "久岐忍",
                    "text": "我这种「自由职业者」的安排比较灵活，总能腾出时间的。"
                }
            ]
        },
        {
            "talkId": "6900906",
            "initDialog": "690090601",
            "dialogues": [
                {
                    "id": "690090601",
                    "speaker": "Player",
                    "text": "晚安，阿忍。"
                },
                {
                    "id": "690090602",
                    "speaker": "久岐忍",
                    "text": "#嗯，{NICKNAME}，你去休息吧。"
                },
                {
                    "id": "690090603",
                    "speaker": "久岐忍",
                    "text": "我最近接了份编辑活，正给人改稿子，挺有意思的，但还得忙一会。"
                },
                {
                    "id": "690090604",
                    "speaker": "久岐忍",
                    "text": "你别学我，规律作息很重要，快去睡。"
                }
            ]
        },
        {
            "talkId": "6900907",
            "initDialog": "690090701",
            "dialogues": [
                {
                    "id": "690090701",
                    "speaker": "久岐忍",
                    "text": "这里的书比我想象中还要多，种类也很齐全…"
                },
                {
                    "id": "690090702",
                    "speaker": "久岐忍",
                    "text": "嗯？居然连参考书都有，粗粗翻了翻还挺有意思的…"
                },
                {
                    "id": "690090703",
                    "speaker": "久岐忍",
                    "text": "那我不客气了。接下来我可能会花很长时间泡在这里，希望你不要介意。"
                }
            ]
        },
        {
            "talkId": "6900908",
            "initDialog": "690090801",
            "dialogues": [
                {
                    "id": "690090801",
                    "speaker": "久岐忍",
                    "text": "我干过卖玩具的兼职，结果不仅没卖出多少货，还被好多家长投诉…"
                },
                {
                    "id": "690090802",
                    "speaker": "久岐忍",
                    "text": "说我戴着面铠又凶神恶煞的样子容易吓到小孩…可是我明明记得路过的小孩都在说我很酷。"
                },
                {
                    "id": "690090803",
                    "speaker": "久岐忍",
                    "text": "算了，过去就过去了。"
                }
            ]
        }
    ]
}