{
    "groupId": "5291",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "尤维尔": 3,
        "纳蒂亚": 12
    },
    "talks": [
        {
            "talkId": "6529006",
            "initDialog": "652900601",
            "dialogues": [
                {
                    "id": "652900601",
                    "speaker": "尤维尔",
                    "text": "我觉得自己最近变强了一点…下次港口工作不那么忙的日子，我们再去潜水寻宝吧。"
                },
                {
                    "id": "652900602",
                    "speaker": "纳蒂亚",
                    "text": "好，如果又被球球章鱼追着打，我会负起责任，把尤维尔带回来的。"
                },
                {
                    "id": "652900603",
                    "speaker": "尤维尔",
                    "text": "你也该对我有点信心吧？为什么前提就是我这次也一定会输…"
                },
                {
                    "id": "652900604",
                    "speaker": "纳蒂亚",
                    "text": "嗯…虽然不记得尤维尔之前已经输给球球章鱼多少次了，但是我知道，这次输掉的可能性很大。"
                },
                {
                    "id": "652900605",
                    "speaker": "尤维尔",
                    "text": "可恶…但是不管怎么说，要有希望！人就是在一次次失败中获得成长的，对吧？"
                },
                {
                    "id": "652900606",
                    "speaker": "纳蒂亚",
                    "text": "尤维尔是对的。只要坚持下去，一定有成功的机会的。"
                }
            ]
        },
        {
            "talkId": "6529101",
            "initDialog": "652910101",
            "dialogues": [
                {
                    "id": "652910101",
                    "speaker": "纳蒂亚",
                    "text": "你好，谢谢你之前帮我和尤维尔留影，每次看到画片就会记起你的事。"
                }
            ]
        },
        {
            "talkId": "6529102",
            "initDialog": "652910201",
            "dialogues": [
                {
                    "id": "652910201",
                    "speaker": "Player",
                    "text": "最近怎么样？"
                },
                {
                    "id": "652910202",
                    "speaker": "纳蒂亚",
                    "text": "嗯…有好的事也有坏的事。"
                },
                {
                    "id": "652910203",
                    "speaker": "纳蒂亚",
                    "text": "尤维尔在柔灯港找到了工作，很辛苦，但是他说这是好事。他最近吃得比以前多，应该也会比以前更强壮。"
                },
                {
                    "id": "652910204",
                    "speaker": "纳蒂亚",
                    "text": "变得更强壮的话，就能轻松加入舰队了。尤维尔之前一直想加入舰队，如果他的梦想能实现就好了。"
                }
            ]
        },
        {
            "talkId": "6529103",
            "initDialog": "652910301",
            "dialogues": [
                {
                    "id": "652910301",
                    "speaker": "Player",
                    "text": "不客气，先不打扰了。"
                },
                {
                    "id": "652910302",
                    "speaker": "纳蒂亚",
                    "text": "嗯。路上小心。"
                }
            ]
        },
        {
            "talkId": "6529104",
            "initDialog": "652910401",
            "dialogues": [
                {
                    "id": "652910401",
                    "speaker": "Player",
                    "text": "先不提尤维尔，你的近况如何？"
                },
                {
                    "id": "652910402",
                    "speaker": "纳蒂亚",
                    "text": "谢谢，我最近不好也不坏，就和以前一样。"
                },
                {
                    "id": "652910403",
                    "speaker": "纳蒂亚",
                    "text": "……"
                },
                {
                    "id": "652910404",
                    "speaker": "纳蒂亚",
                    "text": "…你呢？你最近过得怎么样？希望你一切都好。"
                }
            ]
        },
        {
            "talkId": "6529105",
            "initDialog": "652910501",
            "dialogues": [
                {
                    "id": "652910501",
                    "speaker": "Player",
                    "text": "还行。"
                },
                {
                    "id": "652910502",
                    "speaker": "纳蒂亚",
                    "text": "嗯，那就好。如果需要帮助的话，我愿意帮忙，尤维尔一定也愿意，虽然我们力量很小。"
                }
            ]
        }
    ]
}