    "talks": [
        {
            "talkId": "7165806",
            "initDialog": "716580601",
            "dialogues": [
                {
                    "id": "716580601",
                    "speaker": "烟绯",
                    "text": "#{NICKNAME}，来得正好！我给你挪个位置…喏，璃月港的景色，真叫人百看不厌。",
                    "choices": [
                        {
                            "id": "716580602",
                            "text": "现在是休息时间？",
                            "response": [
                                {
                                    "id": "716580604",
                                    "speaker": "烟绯",
                                    "text": "是啊。老爹给我寄了封信，说和老妈在外旅行一切都好，还祝姥姥和我海灯节快乐。"
                                },
                                {
                                    "id": "716580605",
                                    "speaker": "烟绯",
                                    "text": "真是的，去年就这么写，连说法都不改改。"
                                },
                                {
                                    "id": "716580606",
                                    "speaker": "烟绯",
                                    "text": "不过嘛，我也算继承了他潇洒自在的作风。这不，我给自己放了几天假，开开心心看风景。"
                                },
                                {
                                    "id": "716580607",
                                    "speaker": "烟绯",
                                    "text": "啊…提醒我了，回信的时候，也和他提一下你的事情吧！遇见有趣的朋友，一定得跟家里人说说。"
                                }
                            ]
                        },
                        {
                            "id": "716580603",
                            "text": "今天没有工作吗？"
                        }
                    ]
                }
            ]
        }
    ]
}