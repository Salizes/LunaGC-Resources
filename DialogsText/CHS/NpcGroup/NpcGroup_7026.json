{
    "groupId": "7026",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "特维杜": 10
    },
    "talks": [
        {
            "talkId": "6702601",
            "initDialog": "670260101",
            "dialogues": [
                {
                    "id": "670260101",
                    "speaker": "特维杜",
                    "text": "我就知道，最后还得靠我们，您就来好好瞧瞧吧，看看谁才是干活最利索的那个！"
                }
            ]
        },
        {
            "talkId": "6702602",
            "initDialog": "670260201",
            "dialogues": [
                {
                    "id": "670260201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "670260202",
                    "speaker": "特维杜",
                    "text": "哈哈，我？我只是个卖力气的，那些是愿意跟着我卖力气的兄弟。"
                },
                {
                    "id": "670260203",
                    "speaker": "特维杜",
                    "text": "在这方面的活计，你在港口上打听打听，我和兄弟们做得又好又精细，那是没得说的。"
                },
                {
                    "id": "670260204",
                    "speaker": "特维杜",
                    "text": "虽然…现在不比当年啦，那些铁牲口又不用吃，又不会累，还不会跟债主叫唤，早就没人再花大价钱雇人哩！"
                },
                {
                    "id": "670260205",
                    "speaker": "特维杜",
                    "text": "不过要我说啊，你看，我们可比那些铁牲口可靠多了！"
                }
            ]
        },
        {
            "talkId": "6702603",
            "initDialog": "670260301",
            "dialogues": [
                {
                    "id": "670260301",
                    "speaker": "Player",
                    "text": "再见，先不打扰你们干活了。"
                },
                {
                    "id": "670260302",
                    "speaker": "特维杜",
                    "text": "好，嘿…这传送带要是修不好，我们的活可少不了啊。"
                }
            ]
        },
        {
            "talkId": "6702604",
            "initDialog": "670260401",
            "dialogues": [
                {
                    "id": "670260401",
                    "speaker": "Player",
                    "text": "那你现在…"
                },
                {
                    "id": "670260402",
                    "speaker": "特维杜",
                    "text": "哦，铁牲口也要罢工了呗，到最后还得是我们这帮人顶上来。"
                },
                {
                    "id": "670260403",
                    "speaker": "特维杜",
                    "text": "早知如此，何必当初，你说是不是。"
                }
            ]
        },
        {
            "talkId": "6702605",
            "initDialog": "670260501",
            "dialogues": [
                {
                    "id": "670260501",
                    "speaker": "Player",
                    "text": "最近港口用人需求好像还是很大。"
                },
                {
                    "id": "670260502",
                    "speaker": "特维杜",
                    "text": "嗯…不过，之后也不用卖死力气啦，我带着弟兄们也捣鼓了个机械公司，也用那什么月矩力当能源。"
                },
                {
                    "id": "670260503",
                    "speaker": "特维杜",
                    "text": "到了那个时候，由我们借那些铁牲口的力量来搬东西，岂不是比单纯的铁牲口好多了，哈哈！"
                }
            ]
        }
    ]
}