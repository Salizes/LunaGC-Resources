{
    "groupId": "6193",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 11,
        "桑科约克": 23
    },
    "talks": [
        {
            "talkId": "7505204",
            "initDialog": "750520401",
            "dialogues": [
                {
                    "id": "750520401",
                    "speaker": "桑科约克",
                    "text": "降价了降价了，卖完就走，现在就是最后机会！"
                },
                {
                    "id": "750520402",
                    "speaker": "Player",
                    "text": "你在这种地方卖什么东西？"
                },
                {
                    "id": "750520403",
                    "speaker": "桑科约克",
                    "text": "你问这么多干什么？哦，是新来的吧？那你应该不需要，等你需要的时候自然会知道。"
                }
            ]
        },
        {
            "talkId": "7505209",
            "initDialog": "750520901",
            "dialogues": [
                {
                    "id": "750520901",
                    "speaker": "桑科约克",
                    "text": "降价了降价了，卖完就走，现在就是最后机会！",
                    "choices": [
                        {
                            "id": "750520902",
                            "text": "听说这里能买到特别的药剂…",
                            "response": [
                                {
                                    "id": "750520903",
                                    "speaker": "桑科约克",
                                    "text": "你的消息很灵通啊。说说吧，你有什么需求。"
                                },
                                {
                                    "id": "750520904",
                                    "speaker": "Player",
                                    "text": "我想要差点害死苏玛克的那种药剂。"
                                },
                                {
                                    "id": "750520905",
                                    "speaker": "桑科约克",
                                    "text": "…苏玛克？哦，我想起来了。但是等一下，她怎么就差点死了？跟我的药剂又有什么关系？"
                                },
                                {
                                    "id": "750520906",
                                    "speaker": "桑科约克",
                                    "text": "你不会是想讹我吧？我这药剂不知道卖了多少了，从来只有回头客，没有来找麻烦的！"
                                },
                                {
                                    "id": "750520907",
                                    "speaker": "Player",
                                    "text": "不是因为出事了就没法来找麻烦了？"
                                },
                                {
                                    "id": "750520908",
                                    "speaker": "桑科约克",
                                    "text": "欸？你还跟我杠上了？在我这儿，信誉就是生命！这药剂的配方我白送你了，你要是试出问题了尽管来找我。"
                                },
                                {
                                    "id": "750520909",
                                    "speaker": "Player",
                                    "text": "我都出问题了还怎么找你？"
                                },
                                {
                                    "id": "750520910",
                                    "speaker": "桑科约克",
                                    "text": "药剂配方都白送你了，你还想让我倒找摩拉不成？还是你会算计。"
                                }
                            ]
                        },
                        {
                            "id": "750520911",
                            "text": "你在这里做买卖？",
                            "response": [
                                {
                                    "id": "750520912",
                                    "speaker": "桑科约克",
                                    "text": "也没碍着谁的事，你说是不是？而且口碑摆在这儿，我也不愁销路。"
                                },
                                {
                                    "id": "750520913",
                                    "speaker": "桑科约克",
                                    "text": "不过天天昼伏夜出还是有点吃不消，改天给豪卡捎个信让他换个人来接替我好了。"
                                }
                            ]
                        },
                        {
                            "id": "750520914",
                            "text": "你这里卖的东西正经吗？",
                            "response": [
                                {
                                    "id": "750520915",
                                    "speaker": "桑科约克",
                                    "text": "怎么不正经了？给人喝的提神药剂，给龙吃的龙龙饼干，哪个不是正经东西。"
                                },
                                {
                                    "id": "750520916",
                                    "speaker": "桑科约克",
                                    "text": "除了这些成品还有炼金素材，从蝴蝶翅膀到鳅鳅宝玉，你尽管提需求，没有我们弄不来的。"
                                },
                                {
                                    "id": "750520917",
                                    "speaker": "桑科约克",
                                    "text": "哦，不过你要是有跟伊柯特洛差不多的嗜好那我可不奉陪。"
                                },
                                {
                                    "id": "750520918",
                                    "speaker": "桑科约克",
                                    "text": "我们虽然也不是什么光明正大的人物，但那家伙的「宝石」买卖…我们也看不过眼。"
                                }
                            ]
                        },
                        {
                            "id": "750520919",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "750520920",
                                    "speaker": "桑科约克",
                                    "text": "慢走。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
