{
    "groupId": "5228",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "奥蒂涅": 10
    },
    "talks": [
        {
            "talkId": "6522801",
            "initDialog": "652280101",
            "dialogues": [
                {
                    "id": "652280101",
                    "speaker": "奥蒂涅",
                    "text": "你好！是来找希格雯的吗？她现在不在哦。"
                }
            ]
        },
        {
            "talkId": "6522802",
            "initDialog": "652280201",
            "dialogues": [
                {
                    "id": "652280201",
                    "speaker": "Player",
                    "text": "你也是这里的犯人吗？"
                },
                {
                    "id": "652280202",
                    "speaker": "奥蒂涅",
                    "text": "嗯？不是哦！虽然美露莘犯罪也要和人类一样受罚，但我可是清白的好公民。"
                },
                {
                    "id": "652280203",
                    "speaker": "奥蒂涅",
                    "text": "而且恰恰相反，我其实是逐影庭的成员啦，只是趁着休息日来找朋友聊天罢了。"
                }
            ]
        },
        {
            "talkId": "6522803",
            "initDialog": "652280301",
            "dialogues": [
                {
                    "id": "652280301",
                    "speaker": "Player",
                    "text": "那我以后再来。"
                },
                {
                    "id": "652280302",
                    "speaker": "奥蒂涅",
                    "text": "好哦。"
                }
            ]
        },
        {
            "talkId": "6522804",
            "initDialog": "652280401",
            "dialogues": [
                {
                    "id": "652280401",
                    "speaker": "Player",
                    "text": "原来是护士长的朋友。"
                },
                {
                    "id": "652280402",
                    "speaker": "奥蒂涅",
                    "text": "对啦。她的医务室很宽敞，非常适合大家聚在一起喝奶昔聊天。"
                },
                {
                    "id": "652280403",
                    "speaker": "奥蒂涅",
                    "text": "希格雯的视觉更接近人类，所以我们都很喜欢听她描述周围的景象，然后再画下来。"
                },
                {
                    "id": "652280404",
                    "speaker": "奥蒂涅",
                    "text": "…不过毕竟还是在梅洛彼得堡的范围内，所以我们一般会低调行事。"
                },
                {
                    "id": "652280405",
                    "speaker": "奥蒂涅",
                    "text": "这里地形很复杂，反而方便了体型小小的我们在不被注意的情况下行动呢。"
                }
            ]
        },
        {
            "talkId": "7494501",
            "initDialog": "749450101",
            "dialogues": [
                {
                    "id": "749450101",
                    "speaker": "Player",
                    "text": "真是身手不凡。"
                },
                {
                    "id": "749450102",
                    "speaker": "奥蒂涅",
                    "text": "哼哼，因为你的夸奖很符合实际，所以我就满心欢喜地收下啦。"
                },
                {
                    "id": "749450103",
                    "speaker": "奥蒂涅",
                    "text": "顺便送你些小礼物吧？是我在附近游泳时捡到的，很漂亮，对不对？"
                }
            ]
        }
    ]
}