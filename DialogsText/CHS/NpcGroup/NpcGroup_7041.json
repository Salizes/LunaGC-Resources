{
    "groupId": "7041",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "尤尔瓦": 7
    },
    "talks": [
        {
            "talkId": "6704101",
            "initDialog": "670410101",
            "dialogues": [
                {
                    "id": "670410101",
                    "speaker": "尤尔瓦",
                    "text": "希望海螺帮…不，希望所有人都能过上自己想要的生活…"
                }
            ]
        },
        {
            "talkId": "6704102",
            "initDialog": "670410201",
            "dialogues": [
                {
                    "id": "670410201",
                    "speaker": "Player",
                    "text": "关于海螺帮…"
                },
                {
                    "id": "670410202",
                    "speaker": "尤尔瓦",
                    "text": "据说那夏镇在最初是由一帮孩子建立的，他们要决定什么事的时候就会吹响海螺召集所有人，然后投票决定。"
                },
                {
                    "id": "670410203",
                    "speaker": "尤尔瓦",
                    "text": "不过这些都只是传说罢了，应该不会有人相信吧。有时我也很好奇，到底是谁编造了这些故事呢…"
                },
                {
                    "id": "670410204",
                    "speaker": "尤尔瓦",
                    "text": "属于我们的海螺帮，原本只是无依无靠的孩子们自然而然地聚在一起…啊，不过现在有卡嘉照看我们了，真的很感谢她。"
                }
            ]
        },
        {
            "talkId": "6704103",
            "initDialog": "670410301",
            "dialogues": [
                {
                    "id": "670410301",
                    "speaker": "Player",
                    "text": "你的梦想听起来很美好。"
                },
                {
                    "id": "670410302",
                    "speaker": "尤尔瓦",
                    "text": "但是很难实现，是吗？没关系，卡嘉说过，比起难以实现的梦想，还是没有梦想更致命。我认为她说得很对。"
                },
                {
                    "id": "670410303",
                    "speaker": "尤尔瓦",
                    "text": "而且，对我来说，比我更小的那些孩子们能够过上现在的生活，已经算是梦想实现了很大一部分啦。"
                }
            ]
        },
        {
            "talkId": "6704104",
            "initDialog": "670410401",
            "dialogues": [
                {
                    "id": "670410401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670410402",
                    "speaker": "尤尔瓦",
                    "text": "祝你度过美好的一天。"
                }
            ]
        }
    ]
}