{
    "groupId": "3131",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "清子": 11
    },
    "talks": [
        {
            "talkId": "6313101",
            "initDialog": "631310101",
            "dialogues": [
                {
                    "id": "631310101",
                    "speaker": "清子",
                    "text": "你好，要买东西吗？我这里的商品价格便宜，方便实用，包你满意！"
                }
            ]
        },
        {
            "talkId": "6313102",
            "initDialog": "631310201",
            "dialogues": [
                {
                    "id": "631310201",
                    "speaker": "Player",
                    "text": "都卖些什么？"
                },
                {
                    "id": "631310202",
                    "speaker": "清子",
                    "text": "都在这边，请随意挑选。"
                }
            ]
        },
        {
            "talkId": "6313103",
            "initDialog": "631310301",
            "dialogues": [
                {
                    "id": "631310301",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "631310302",
                    "speaker": "清子",
                    "text": "我是专门来海祇岛做生意的商人，为村子里的居民们提供物美价廉的商品。"
                },
                {
                    "id": "631310303",
                    "speaker": "清子",
                    "text": "这里的情况你应该也看到了吧，村子很小，村民生活闭塞，还要接济那些士兵…"
                },
                {
                    "id": "631310304",
                    "speaker": "清子",
                    "text": "咳咳，倒不是说我看不起这里啦。正是因为这里不够发达，我们才要多多提供帮助呀。"
                },
                {
                    "id": "631310305",
                    "speaker": "清子",
                    "text": "所以我决定常年在这里售卖低价货物，让岛上的居民都能买到需要的日用品。"
                }
            ]
        },
        {
            "talkId": "6313104",
            "initDialog": "631310401",
            "dialogues": [
                {
                    "id": "631310401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631310402",
                    "speaker": "清子",
                    "text": "慢走，有什么需要欢迎再来哦！"
                }
            ]
        },
        {
            "talkId": "6313105",
            "initDialog": "631310501",
            "dialogues": [
                {
                    "id": "631310501",
                    "speaker": "Player",
                    "text": "进货方便吗？"
                },
                {
                    "id": "631310502",
                    "speaker": "清子",
                    "text": "这个嘛…毕竟这里地方偏远，又不受幕府待见，物资流通困难，真不知道我来之前这些本地人是怎么生活下去的…"
                },
                {
                    "id": "631310503",
                    "speaker": "清子",
                    "text": "咳咳，总之我有我的渠道，出售的商品都是从码头运送进来的正规货物。"
                },
                {
                    "id": "631310504",
                    "speaker": "清子",
                    "text": "只是每次都要被那里的士兵盘问好久，实在是麻烦。"
                },
                {
                    "id": "631310505",
                    "speaker": "清子",
                    "text": "看在我帮了本地人这么大忙的份上，他们应该给我发个免检凭证之类的东西才对…"
                }
            ]
        }
    ]
}