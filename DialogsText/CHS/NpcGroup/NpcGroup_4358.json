{
    "groupId": "4358",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "纳西尔": 10
    },
    "talks": [
        {
            "talkId": "6435801",
            "initDialog": "643580101",
            "dialogues": [
                {
                    "id": "643580101",
                    "speaker": "纳西尔",
                    "text": "你来了啊！…欸，原来不是他啊…"
                }
            ]
        },
        {
            "talkId": "6435802",
            "initDialog": "643580201",
            "dialogues": [
                {
                    "id": "643580201",
                    "speaker": "Player",
                    "text": "在等人？"
                },
                {
                    "id": "643580202",
                    "speaker": "纳西尔",
                    "text": "啊，是了。在等…那个，那个谁。"
                },
                {
                    "id": "643580203",
                    "speaker": "纳西尔",
                    "text": "反正就是老板娘的那个大侄子。这个人哦，虽然酒量不咋样，但打牌还挺有意思的。"
                },
                {
                    "id": "643580204",
                    "speaker": "纳西尔",
                    "text": "今天我专门带了好酒来找他，可他却不在，真是可惜。"
                },
                {
                    "id": "643580205",
                    "speaker": "纳西尔",
                    "text": "本来还想再见识一下他那个…那个杂耍一样的牌组呢。"
                },
                {
                    "id": "643580206",
                    "speaker": "纳西尔",
                    "text": "唉你说，人为什么要工作呢。去工作的话，就没空陪兄弟喝酒吃肉打牌了。"
                }
            ]
        },
        {
            "talkId": "6435803",
            "initDialog": "643580301",
            "dialogues": [
                {
                    "id": "643580301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "643580302",
                    "speaker": "纳西尔",
                    "text": "没事，我再等等…"
                }
            ]
        },
        {
            "talkId": "7395901",
            "initDialog": "739590101",
            "dialogues": [
                {
                    "id": "739590101",
                    "speaker": "Player",
                    "text": "可能是忙吧。"
                },
                {
                    "id": "739590102",
                    "speaker": "纳西尔",
                    "text": "大概是吧，他有时确实会跟我说「大哥，我不是闲人」，然后就又去忙旅店的事情了…"
                },
                {
                    "id": "739590103",
                    "speaker": "纳西尔",
                    "text": "唉，一个人喝酒真是没什么意思，带来的烤肉就这么浪费了也不太好，不如趁着新鲜送给你吧。"
                },
                {
                    "id": "739590104",
                    "speaker": "纳西尔",
                    "text": "找个朋友一起吃，不要像我一样…"
                }
            ]
        }
    ]
}