{
    "groupId": "7004",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "林布": 8
    },
    "talks": [
        {
            "talkId": "6700401",
            "initDialog": "670040101",
            "dialogues": [
                {
                    "id": "670040101",
                    "speaker": "林布",
                    "text": "您要来几张饼吗？胡萝卜丝馅儿的卖得最好，肉馅的也很受欢迎！"
                }
            ]
        },
        {
            "talkId": "6700402",
            "initDialog": "670040201",
            "dialogues": [
                {
                    "id": "670040201",
                    "speaker": "Player",
                    "text": "让我看看都卖什么…"
                },
                {
                    "id": "670040202",
                    "speaker": "林布",
                    "text": "好嘞，您瞧瞧。"
                }
            ]
        },
        {
            "talkId": "6700403",
            "initDialog": "670040301",
            "dialogues": [
                {
                    "id": "670040301",
                    "speaker": "Player",
                    "text": "真的这么受欢迎？"
                },
                {
                    "id": "670040302",
                    "speaker": "林布",
                    "text": "嘿嘿，不是我自夸，我这儿的饼可是收获了周围孩子的一致好评呢…"
                },
                {
                    "id": "670040303",
                    "speaker": "林布",
                    "text": "不过，买得最多的还是那些宝藏猎人，你懂吧，量大，管饱，实惠！直接揣上一袋子，随时饿了就吃两张！"
                },
                {
                    "id": "670040304",
                    "speaker": "林布",
                    "text": "总之，没空去「斯佩兰扎」的家伙，大部分都来我这啦。"
                }
            ]
        },
        {
            "talkId": "6700404",
            "initDialog": "670040401",
            "dialogues": [
                {
                    "id": "670040401",
                    "speaker": "Player",
                    "text": "暂时不需要。"
                },
                {
                    "id": "670040402",
                    "speaker": "林布",
                    "text": "好哦，要是您想吃饼，就来找我，包您觉得物超所值。"
                }
            ]
        },
        {
            "talkId": "6700405",
            "initDialog": "670040501",
            "dialogues": [
                {
                    "id": "670040501",
                    "speaker": "Player",
                    "text": "若是有空去「斯佩兰扎」…"
                },
                {
                    "id": "670040502",
                    "speaker": "林布",
                    "text": "哈哈，有空去「斯佩兰扎」，那便是奔着豪吃一顿去的，我的饼可填不饱那些人的胃口。"
                },
                {
                    "id": "670040503",
                    "speaker": "林布",
                    "text": "更何况，要是不支摊子，我自己有空，我也要去那吃呢！"
                }
            ]
        }
    ]
}