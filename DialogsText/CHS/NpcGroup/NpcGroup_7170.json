{
    "groupId": "7170",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 1,
        "奈芙尔": 8
    },
    "talks": [
        {
            "talkId": "6717001",
            "initDialog": "671700101",
            "dialogues": [
                {
                    "id": "671700101",
                    "speaker": "奈芙尔",
                    "text": "欢迎来到「秘闻馆」。"
                },
                {
                    "id": "671700102",
                    "speaker": "奈芙尔",
                    "text": "有需要委托的事，在那边的留言簿上留言就好。"
                },
                {
                    "id": "671700103",
                    "speaker": "Player",
                    "text": "难得见到奈芙尔在这…"
                },
                {
                    "id": "671700104",
                    "speaker": "奈芙尔",
                    "text": "我今天要接待一个重要的客人，正好雅珂达前几天也向我请假。"
                },
                {
                    "id": "671700105",
                    "speaker": "奈芙尔",
                    "text": "所以，今天就干脆由我做「秘闻馆」的接待了。"
                },
                {
                    "id": "671700106",
                    "speaker": "奈芙尔",
                    "text": "算算时间，那位客人也快到了，嗯…等一下就清场吧。"
                }
            ]
        },
        {
            "talkId": "6717002",
            "initDialog": "671700201",
            "dialogues": [
                {
                    "id": "671700201",
                    "speaker": "奈芙尔",
                    "text": "婕德不愧是从沙漠里摸爬滚打出来的人，干活就是利索。"
                },
                {
                    "id": "671700202",
                    "speaker": "奈芙尔",
                    "text": "没想到，回了一趟须弥，居然还有这样的意外收获。如果以后要在沙漠里办事…"
                },
                {
                    "id": "671700203",
                    "speaker": "奈芙尔",
                    "text": "…算了。还是别再和沙漠扯上关系了，那里的生意都太难做了。"
                }
            ]
        }
    ]
}