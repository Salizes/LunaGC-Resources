        {
            "talkId": "7106411",
            "initDialog": "710641101",
            "dialogues": [
                {
                    "id": "710641101",
                    "speaker": "纪念石",
                    "text": "（纪念石上刻着几排千岩军将士的名字，其下是刻文…）"
                },
                {
                    "id": "710641102",
                    "speaker": "纪念石",
                    "text": "…「时身后即为璃月…将奋勇，士争先，视死如归，不许寸步。」"
                },
                {
                    "id": "710641103",
                    "speaker": "纪念石",
                    "text": "…「终不负帝君所付，不负众民所望，以此石为念。」"
                },
                {
                    "id": "710641104",
                    "speaker": "纪念石",
                    "text": "…「纵岁月消磨，唯千岩不动。」"
                }
            ]
        }
    ]
}