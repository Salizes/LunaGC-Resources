{
    "groupId": "4212",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 8,
        "兰耶师": 16
    },
    "talks": [
        {
            "talkId": "6421201",
            "initDialog": "642120101",
            "dialogues": [
                {
                    "id": "642120101",
                    "speaker": "兰耶师",
                    "text": "无忧节，有点麻烦…要好好看护这里，要担心大家的安全…"
                }
            ]
        },
        {
            "talkId": "6421202",
            "initDialog": "642120201",
            "dialogues": [
                {
                    "id": "642120201",
                    "speaker": "Player",
                    "text": "你在发愁？"
                },
                {
                    "id": "642120202",
                    "speaker": "兰耶师",
                    "text": "啊，是金色的那菈…"
                },
                {
                    "id": "642120203",
                    "speaker": "兰耶师",
                    "text": "真是惭愧…无忧节应该是大家都快乐的节日。但是我一想到如果有很坏很坏的家伙在这种时候闯进来，就不好了。"
                },
                {
                    "id": "642120204",
                    "speaker": "兰耶师",
                    "text": "所以，有些不快乐…"
                }
            ]
        },
        {
            "talkId": "6421203",
            "initDialog": "642120301",
            "dialogues": [
                {
                    "id": "642120301",
                    "speaker": "Player",
                    "text": "关于七天神像…"
                },
                {
                    "id": "642120302",
                    "speaker": "兰耶师",
                    "text": "这是树之王、草之王的石头，是很重要的！"
                }
            ]
        },
        {
            "talkId": "6421204",
            "initDialog": "642120401",
            "dialogues": [
                {
                    "id": "642120401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642120402",
                    "speaker": "兰耶师",
                    "text": "再见，金色的那菈，希望你不会遇到坏家伙。"
                }
            ]
        },
        {
            "talkId": "6421205",
            "initDialog": "642120501",
            "dialogues": [
                {
                    "id": "642120501",
                    "speaker": "Player",
                    "text": "坏家伙由我来打倒。"
                },
                {
                    "id": "642120502",
                    "speaker": "兰耶师",
                    "text": "金色的那菈看起来本事不小，可以打倒坏家伙。"
                },
                {
                    "id": "642120503",
                    "speaker": "兰耶师",
                    "text": "但是兰耶师不想让金色的那菈帮忙，因为金色的那菈是兰那罗的「客人」。"
                }
            ]
        },
        {
            "talkId": "6421206",
            "initDialog": "642120601",
            "dialogues": [
                {
                    "id": "642120601",
                    "speaker": "兰耶师",
                    "text": "无忧节结束了，无留陀也被打败了，桓那兰那安全。"
                }
            ]
        },
        {
            "talkId": "6421207",
            "initDialog": "642120701",
            "dialogues": [
                {
                    "id": "642120701",
                    "speaker": "Player",
                    "text": "你看起来很开心。"
                },
                {
                    "id": "642120702",
                    "speaker": "兰耶师",
                    "text": "#是的，因为无留陀被厉害的那菈{NICKNAME}还有兰罗摩打败了。"
                },
                {
                    "id": "642120703",
                    "speaker": "兰耶师",
                    "text": "对于兰那罗来说，桓那兰那之外也都不用担心遇见气势汹汹的坏家伙。"
                },
                {
                    "id": "642120704",
                    "speaker": "兰耶师",
                    "text": "#这些都要谢谢那菈{NICKNAME}还有兰罗摩。"
                }
            ]
        },
        {
            "talkId": "6421208",
            "initDialog": "642120801",
            "dialogues": [
                {
                    "id": "642120801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642120802",
                    "speaker": "兰耶师",
                    "text": "#再见，树之王、草之王会看顾那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6421209",
            "initDialog": "642120901",
            "dialogues": [
                {
                    "id": "642120901",
                    "speaker": "兰耶师",
                    "text": "节日…更不能放松警惕。"
                }
            ]
        },
        {
            "talkId": "6421210",
            "initDialog": "642121001",
            "dialogues": [
                {
                    "id": "642121001",
                    "speaker": "Player",
                    "text": "关于七天神像…"
                },
                {
                    "id": "642121002",
                    "speaker": "兰耶师",
                    "text": "这是草之王的石头，是很重要的！"
                }
            ]
        },
        {
            "talkId": "6421211",
            "initDialog": "642121101",
            "dialogues": [
                {
                    "id": "642121101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642121102",
                    "speaker": "兰耶师",
                    "text": "#再见，草之王会看顾那菈{NICKNAME}。"
                }
            ]
        }
    ]
}