    "talks": [
        {
            "talkId": "6933501",
            "initDialog": "693350101",
            "dialogues": [
                {
                    "id": "693350101",
                    "speaker": "早柚",
                    "text": "呼…呼…"
                },
                {
                    "id": "693350102",
                    "speaker": "早柚",
                    "text": "啊…有任务吗？"
                },
                {
                    "id": "693350103",
                    "speaker": "早柚",
                    "text": "再睡十分钟，就十分钟，呼…"
                }
            ]
        },
        {
            "talkId": "6933502",
            "initDialog": "693350201",
            "dialogues": [
                {
                    "id": "693350201",
                    "speaker": "早柚",
                    "text": "要是敌人很厉害的话，找一些更厉害的朋友来帮忙会更好吧？"
                },
                {
                    "id": "693350202",
                    "speaker": "早柚",
                    "text": "唔…不是我想偷懒，我的忍术本来就不适合战斗…"
                },
                {
                    "id": "693350203",
                    "speaker": "早柚",
                    "text": "不如让我多睡一会儿，长高一些，或许就有办法了，呼…"
                }
            ]
        },
        {
            "talkId": "6933503",
            "initDialog": "693350301",
            "dialogues": [
                {
                    "id": "693350301",
                    "speaker": "早柚",
                    "text": "好安静，好暖和，真是个适合睡觉的好地方。"
                },
                {
                    "id": "693350302",
                    "speaker": "早柚",
                    "text": "啊，对了，千万不要告诉宫司大人我在这里，被抓到可就糟了…"
                },
                {
                    "id": "693350303",
                    "speaker": "早柚",
                    "text": "要是没有战斗任务，我能不能在这里多待一会儿？"
                }
            ]
        }
    ]
}