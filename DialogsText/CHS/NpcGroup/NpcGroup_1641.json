{
    "groupId": "1641",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 1,
        "喜儿": 21
    },
    "talks": [
        {
            "talkId": "7091601",
            "initDialog": "709160101",
            "dialogues": [
                {
                    "id": "709160101",
                    "speaker": "Player",
                    "text": "真的有那么夸张吗…"
                },
                {
                    "id": "709160102",
                    "speaker": "喜儿",
                    "text": "夸张？我只是在陈述事实。"
                },
                {
                    "id": "709160103",
                    "speaker": "喜儿",
                    "text": "虽然我是璃月人，但作为美食家，我可是很公正、客观的！"
                },
                {
                    "id": "709160104",
                    "speaker": "喜儿",
                    "text": "正好，我今天早上刚做好了一份「水煮黑背鲈」，你可以尝尝，大概就可以理解差距了。"
                }
            ]
        },
        {
            "talkId": "41731",
            "initDialog": "616410207",
            "dialogues": [
                {
                    "id": "616410207",
                    "speaker": "喜儿",
                    "text": "璃菜？"
                },
                {
                    "id": "616410208",
                    "speaker": "喜儿",
                    "text": "嗯，璃月菜肴有名的两大菜系之一！"
                },
                {
                    "id": "616410209",
                    "speaker": "喜儿",
                    "text": "「璃菜」的厨师都以油重色浓、口味多变为特色，擅长料理「山珍」食材…"
                },
                {
                    "id": "616410210",
                    "speaker": "喜儿",
                    "text": "想吃的话一定要去一次璃月港的「琉璃亭」，有着公认最好的「璃菜」大厨！"
                }
            ]
        },
        {
            "talkId": "41732",
            "initDialog": "616410211",
            "dialogues": [
                {
                    "id": "616410211",
                    "speaker": "喜儿",
                    "text": "月菜？"
                },
                {
                    "id": "616410212",
                    "speaker": "喜儿",
                    "text": "是和「璃菜」并列的璃月两大菜系。"
                },
                {
                    "id": "616410213",
                    "speaker": "喜儿",
                    "text": "「月菜」的口味更讲究清淡鲜香，喜欢吃海鲜的话一定要尝尝「月菜」！"
                },
                {
                    "id": "616410214",
                    "speaker": "喜儿",
                    "text": "想吃到地道的「月菜」的话，可以去璃月的「新月轩」尝尝…"
                },
                {
                    "id": "616410215",
                    "speaker": "喜儿",
                    "text": "只是不论「新月轩」还是「琉璃亭」，大概都需要提前半年预定才会有座位的吧…"
                }
            ]
        },
        {
            "talkId": "6164101",
            "initDialog": "616410101",
            "dialogues": [
                {
                    "id": "616410101",
                    "speaker": "喜儿",
                    "text": "要是加点辣椒就好了，该不该去建议一下…"
                }
            ]
        },
        {
            "talkId": "6164102",
            "initDialog": "616410201",
            "dialogues": [
                {
                    "id": "616410201",
                    "speaker": "喜儿",
                    "text": "你在做什么？"
                },
                {
                    "id": "616410202",
                    "speaker": "喜儿",
                    "text": "嗯？你看起来也是外来人的样子。"
                },
                {
                    "id": "616410203",
                    "speaker": "喜儿",
                    "text": "我是家住璃月吃虎岩的喜儿，工作是吃饭！啊不对，应该说叫什么来着…美、美食家！"
                },
                {
                    "id": "616410204",
                    "speaker": "喜儿",
                    "text": "最近特地过来尝尝蒙德的菜肴，毕竟听说「万民堂」的大厨香菱也来这边找食材了嘛。"
                },
                {
                    "id": "616410205",
                    "speaker": "喜儿",
                    "text": "这边的料理虽然都很注重食材的选择和新鲜度…"
                },
                {
                    "id": "616410206",
                    "speaker": "喜儿",
                    "text": "可在花式和调味方面还是璃月料理更胜一筹，不论是比起「璃菜」还是「月菜」。"
                }
            ]
        },
        {
            "talkId": "6164103",
            "initDialog": "616410301",
            "dialogues": [
                {
                    "id": "616410301",
                    "speaker": "喜儿",
                    "text": "再见。"
                },
                {
                    "id": "616410302",
                    "speaker": "喜儿",
                    "text": "嗯，你也要去吃饭了吗？"
                }
            ]
        }
    ]
}