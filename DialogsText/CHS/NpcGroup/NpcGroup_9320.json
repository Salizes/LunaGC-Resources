{
    "groupId": "9320",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "温迪": 9
    },
    "talks": [
        {
            "talkId": "6932001",
            "initDialog": "693200101",
            "dialogues": [
                {
                    "id": "693200101",
                    "speaker": "温迪",
                    "text": "激战开始前的小憩。我明白了，这里应该配一首俏皮的曲子。"
                },
                {
                    "id": "693200102",
                    "speaker": "温迪",
                    "text": "既能让人放松心情，又不至于舒缓到让书页也打起瞌睡。"
                },
                {
                    "id": "693200103",
                    "speaker": "温迪",
                    "text": "选你喜欢的地方坐吧！我要用「斐林」开始演奏喽。"
                }
            ]
        },
        {
            "talkId": "6932002",
            "initDialog": "693200201",
            "dialogues": [
                {
                    "id": "693200201",
                    "speaker": "温迪",
                    "text": "遭遇事件，战胜敌人；不断前进，直至抵达终点…"
                },
                {
                    "id": "693200202",
                    "speaker": "温迪",
                    "text": "#勇敢的{NICKNAME}阁下，请允许我这位小小的吟游诗人随行，将你的身姿谱写成一则「史诗」。"
                },
                {
                    "id": "693200203",
                    "speaker": "温迪",
                    "text": "用一杯冰镇苹果酿打赌，我敢说，它肯定会非常精彩！"
                }
            ]
        },
        {
            "talkId": "6932003",
            "initDialog": "693200301",
            "dialogues": [
                {
                    "id": "693200301",
                    "speaker": "温迪",
                    "text": "我在这里找到了很多有趣的故事书呢。"
                },
                {
                    "id": "693200302",
                    "speaker": "温迪",
                    "text": "别看它们现在沉淀在书页上，只要你眨眨眼睛，它们也会飘扬在琴声中，融化在甜津津的微风里。"
                },
                {
                    "id": "693200303",
                    "speaker": "温迪",
                    "text": "选一则你最喜欢的，我们来试试吧！"
                }
            ]
        }
    ]
}