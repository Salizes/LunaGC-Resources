{
    "groupId": "4300",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "阿什帕齐": 16
    },
    "talks": [
        {
            "talkId": "6430001",
            "initDialog": "643000101",
            "dialogues": [
                {
                    "id": "643000101",
                    "speaker": "阿什帕齐",
                    "text": "有了这些新鲜的肉，就算是笨蛋也能做出好吃的菜！"
                }
            ]
        },
        {
            "talkId": "6430002",
            "initDialog": "643000201",
            "dialogues": [
                {
                    "id": "643000201",
                    "speaker": "Player",
                    "text": "我也想要新鲜的肉。"
                },
                {
                    "id": "643000202",
                    "speaker": "阿什帕齐",
                    "text": "哦吼，看来是识货的人啊，想要什么自己挑吧！"
                }
            ]
        },
        {
            "talkId": "6430003",
            "initDialog": "643000301",
            "dialogues": [
                {
                    "id": "643000301",
                    "speaker": "Player",
                    "text": "你会做饭？"
                },
                {
                    "id": "643000302",
                    "speaker": "阿什帕齐",
                    "text": "欸，这是问的什么话！"
                },
                {
                    "id": "643000303",
                    "speaker": "阿什帕齐",
                    "text": "不要看我穿着巡林官的制服，就小瞧我的厨艺！我可是巡林队里大名鼎鼎的「大厨」！"
                },
                {
                    "id": "643000304",
                    "speaker": "阿什帕齐",
                    "text": "…哈哈，不开玩笑了。"
                },
                {
                    "id": "643000305",
                    "speaker": "阿什帕齐",
                    "text": "虽然没到「大名鼎鼎」的程度，但我的厨艺确实没的说，周围吃过的人都说好。"
                }
            ]
        },
        {
            "talkId": "6430004",
            "initDialog": "643000401",
            "dialogues": [
                {
                    "id": "643000401",
                    "speaker": "Player",
                    "text": "你会打猎？"
                },
                {
                    "id": "643000402",
                    "speaker": "阿什帕齐",
                    "text": "那当然咯。不然你以为我卖的肉都是哪来的，是笨猪往我箭头上撞的吗？"
                },
                {
                    "id": "643000403",
                    "speaker": "阿什帕齐",
                    "text": "…哈哈，不开玩笑了。跟着提纳里先生待久了，连说话方式都跟他差不多了。"
                },
                {
                    "id": "643000404",
                    "speaker": "阿什帕齐",
                    "text": "我是巡林队里负责后勤的人，会打猎做饭不是很正常嘛。"
                },
                {
                    "id": "643000405",
                    "speaker": "阿什帕齐",
                    "text": "要我说，想当个好厨子，就得先当个好猎人。"
                }
            ]
        },
        {
            "talkId": "6430005",
            "initDialog": "643000501",
            "dialogues": [
                {
                    "id": "643000501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643000502",
                    "speaker": "阿什帕齐",
                    "text": "再见，想吃肉时可以来找我！"
                }
            ]
        },
        {
            "talkId": "7390001",
            "initDialog": "739000101",
            "dialogues": [
                {
                    "id": "739000101",
                    "speaker": "Player",
                    "text": "我不信。"
                },
                {
                    "id": "739000102",
                    "speaker": "阿什帕齐",
                    "text": "嘿，怎么还跟我杠上了。"
                },
                {
                    "id": "739000103",
                    "speaker": "阿什帕齐",
                    "text": "看你长得眉清目秀、通情达理的，不像是不讲道理的人啊。"
                },
                {
                    "id": "739000104",
                    "speaker": "阿什帕齐",
                    "text": "哦，我明白了！你一定是想用激将法，骗我的肉吃！"
                },
                {
                    "id": "739000105",
                    "speaker": "阿什帕齐",
                    "text": "不过没关系，在分享美食方面，我不介意上当。"
                },
                {
                    "id": "739000106",
                    "speaker": "阿什帕齐",
                    "text": "只有一个要求，你吃完如果觉得好吃的话，得帮我宣传宣传啊。"
                }
            ]
        }
    ]
}