    },
    "talks": [
        {
            "talkId": "6639301",
            "initDialog": "663930101",
            "dialogues": [
                {
                    "id": "663930101",
                    "speaker": "阿托力",
                    "text": "传奇的新料理！…会不会有点过了？"
                }
            ]
        },
        {
            "talkId": "6639302",
            "initDialog": "663930201",
            "dialogues": [
                {
                    "id": "663930201",
                    "speaker": "Player",
                    "text": "传奇料理？"
                },
                {
                    "id": "663930202",
                    "speaker": "阿托力",
                    "text": "哈哈，被你们听到了吗？真是不好意思啊，我只是在思考怎么宣传新料理，毕竟下一届「豪宴热斗」也快要开始了嘛。"
                },
                {
                    "id": "663930203",
                    "speaker": "阿托力",
                    "text": "不过，说是「传奇料理」，未免也有些夸张了。嗯，该怎么宣传比较好呢…"
                }
            ]
        },
        {
            "talkId": "6639303",
            "initDialog": "663930301",
            "dialogues": [
                {
                    "id": "663930301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "663930302",
                    "speaker": "阿托力",
                    "text": "好，要是饿了的话，记得回来找我！"
                }
            ]
        },
        {
            "talkId": "6639304",
            "initDialog": "663930401",
            "dialogues": [
                {
                    "id": "663930401",
                    "speaker": "Player",
                    "text": "关于「豪宴热斗」…"
                },
                {
                    "id": "663930402",
                    "speaker": "阿托力",
                    "text": "啊，就是类似大胃王比赛之类的活动吧！大家一起放开了吃，吃得最多的选手就获胜了！"
                },
                {
                    "id": "663930403",
                    "speaker": "阿托力",
                    "text": "既能为餐厅带来更多人气，也能顺便推广新的料理…"
                },
                {
                    "id": "663930404",
                    "speaker": "阿托力",
                    "text": "哈哈，不过那些都是次要的！更重要的是，大家都能吃得开开心心的，这才是作为厨师最高的梦想嘛！"
                }
            ]
        }
    ]
}