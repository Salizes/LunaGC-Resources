    "talks": [
        {
            "talkId": "6406101",
            "initDialog": "640610101",
            "dialogues": [
                {
                    "id": "640610101",
                    "speaker": "库洛什",
                    "text": "呜，今天又被经理人骂了…"
                }
            ]
        },
        {
            "talkId": "6406102",
            "initDialog": "640610201",
            "dialogues": [
                {
                    "id": "640610201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "640610202",
                    "speaker": "库洛什",
                    "text": "不太好，但也习惯了…"
                },
                {
                    "id": "640610203",
                    "speaker": "库洛什",
                    "text": "每天就是在练习，被谢赫祖拜尔先生教训，接着练习…这样的循环中度过。"
                },
                {
                    "id": "640610204",
                    "speaker": "库洛什",
                    "text": "中途我想过要放弃，但一想到谢赫祖拜尔先生虽然一直在批评我的各种问题，却从未叫我退出…"
                },
                {
                    "id": "640610205",
                    "speaker": "库洛什",
                    "text": "说明我还是有救的，对吧？"
                },
                {
                    "id": "640610206",
                    "speaker": "库洛什",
                    "text": "但是…我到底有没有在进步呢？"
                }
            ]
        },
        {
            "talkId": "6406103",
            "initDialog": "640610301",
            "dialogues": [
                {
                    "id": "640610301",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "640610302",
                    "speaker": "库洛什",
                    "text": "好的，谢谢你，我不会放弃的…"
                }
            ]
        }
    ]
}