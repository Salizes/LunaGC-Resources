{
    "groupId": "4052",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "哈马维": 13
    },
    "talks": [
        {
            "talkId": "6405201",
            "initDialog": "640520101",
            "dialogues": [
                {
                    "id": "640520101",
                    "speaker": "哈马维",
                    "text": "我这个二儿子哟，什么时候才能做点正经工作呢…"
                },
                {
                    "id": "640520102",
                    "speaker": "哈马维",
                    "text": "啊抱歉，客人你好，想买些什么？"
                }
            ]
        },
        {
            "talkId": "6405202",
            "initDialog": "640520201",
            "dialogues": [
                {
                    "id": "640520201",
                    "speaker": "Player",
                    "text": "都有什么卖的？"
                },
                {
                    "id": "640520202",
                    "speaker": "哈马维",
                    "text": "一些日用杂货，请随意挑选。"
                }
            ]
        },
        {
            "talkId": "6405203",
            "initDialog": "640520301",
            "dialogues": [
                {
                    "id": "640520301",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "640520302",
                    "speaker": "哈马维",
                    "text": "你说他也老大不小了，就连比他还小的朱特都已经成家立业，他却还是整天吊儿郎当，没个正事。"
                },
                {
                    "id": "640520303",
                    "speaker": "哈马维",
                    "text": "哪怕像他大哥一样，用虚空终端申请点技术，稳稳当当找个工作也行啊。"
                },
                {
                    "id": "640520304",
                    "speaker": "哈马维",
                    "text": "整天净琢磨些危险又不靠谱的东西，手上一有点钱就往交易所跑，真是头疼…"
                },
                {
                    "id": "640520305",
                    "speaker": "哈马维",
                    "text": "你说，怎么才能让那些冒险家们离我儿子远一点呢？"
                }
            ]
        },
        {
            "talkId": "6405204",
            "initDialog": "640520401",
            "dialogues": [
                {
                    "id": "640520401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640520402",
                    "speaker": "哈马维",
                    "text": "唉，真不让人省心…"
                }
            ]
        },
        {
            "talkId": "6405205",
            "initDialog": "640520501",
            "dialogues": [
                {
                    "id": "640520501",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "640520502",
                    "speaker": "哈马维",
                    "text": "你说他也老大不小了，就连比他还小的朱特都已经成家立业，他却还是整天吊儿郎当，没个正事。"
                },
                {
                    "id": "640520503",
                    "speaker": "哈马维",
                    "text": "本来以为哪怕像他大哥一样，用虚空终端申请点技术，稳稳当当找个工作也行啊。"
                },
                {
                    "id": "640520504",
                    "speaker": "哈马维",
                    "text": "现在虚空没了，他又不爱读书，这下更找不到工作了…"
                },
                {
                    "id": "640520505",
                    "speaker": "哈马维",
                    "text": "整天净琢磨些危险又不靠谱的东西，手上一有点钱就往交易所跑，真是头疼…"
                },
                {
                    "id": "640520506",
                    "speaker": "哈马维",
                    "text": "你说，怎么才能让那些冒险家们离我儿子远一点呢？"
                }
            ]
        }
    ]
}