{
    "groupId": "7829",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "茨维塔耶娃": 10
    },
    "talks": [
        {
            "talkId": "6782901",
            "initDialog": "678290101",
            "dialogues": [
                {
                    "id": "678290101",
                    "speaker": "茨维塔耶娃",
                    "text": "哼…就不能再开快些吗？我的天哪，庶民总是这样慢吞吞的…"
                }
            ]
        },
        {
            "talkId": "6782902",
            "initDialog": "678290201",
            "dialogues": [
                {
                    "id": "678290201",
                    "speaker": "Player",
                    "text": "别着急，坐下慢慢等就好了嘛。"
                },
                {
                    "id": "678290202",
                    "speaker": "茨维塔耶娃",
                    "text": "啧…瞧您说的，要是有座我不就坐下了吗？"
                },
                {
                    "id": "678290203",
                    "speaker": "茨维塔耶娃",
                    "text": "买不起票有什么办法呢？…您说，如果一个人连列车上的座位都买不起，又该怎么办呢？"
                }
            ]
        },
        {
            "talkId": "6782903",
            "initDialog": "678290301",
            "dialogues": [
                {
                    "id": "678290301",
                    "speaker": "Player",
                    "text": "等等吧。"
                },
                {
                    "id": "678290302",
                    "speaker": "茨维塔耶娃",
                    "text": "唉，您是不知道，以前的日子真的很好，那时的好日子啊…"
                }
            ]
        },
        {
            "talkId": "6782904",
            "initDialog": "678290401",
            "dialogues": [
                {
                    "id": "678290401",
                    "speaker": "Player",
                    "text": "啊？问我吗？"
                },
                {
                    "id": "678290402",
                    "speaker": "茨维塔耶娃",
                    "text": "您要知道，我是在皇都的高等贵族女子中学受过教育的，毕业晚会上还在市长和其他大人物面前跳过披巾舞。"
                },
                {
                    "id": "678290403",
                    "speaker": "茨维塔耶娃",
                    "text": "为此还得了一枚金质奖章和一枚奖状。您想想看，我，科什卡的后人，几乎是个贵族小姐，居然要站着坐列车！"
                },
                {
                    "id": "678290404",
                    "speaker": "茨维塔耶娃",
                    "text": "您可不知道，就连这身衣服呀，我家里都有三套，全是当年直供白冕宫的…可如今…这件事简直…简直…"
                }
            ]
        },
        {
            "talkId": "6782905",
            "initDialog": "678290501",
            "dialogues": [
                {
                    "id": "678290501",
                    "speaker": "Player",
                    "text": "呃…随便卖点什么不就好了？"
                },
                {
                    "id": "678290502",
                    "speaker": "茨维塔耶娃",
                    "text": "哎呀…我亲爱的好人儿，您究竟在说些什么呀！"
                },
                {
                    "id": "678290503",
                    "speaker": "茨维塔耶娃",
                    "text": "请您告诉我，要是把这身衣服卖掉，谁还能知道我是贵族呢？"
                },
                {
                    "id": "678290504",
                    "speaker": "茨维塔耶娃",
                    "text": "这成何体统？您不明白，站着就站着了，无论如何都不能丢了份儿。"
                }
            ]
        }
    ]
}