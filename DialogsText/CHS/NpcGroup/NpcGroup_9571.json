{
    "groupId": "9571",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "娜维娅": 10
    },
    "talks": [
        {
            "talkId": "6957101",
            "initDialog": "695710101",
            "dialogues": [
                {
                    "id": "695710101",
                    "speaker": "娜维娅",
                    "text": "总觉得一打牌就会忘记时间，要不要做些甜点先垫垫肚子呢？"
                }
            ]
        },
        {
            "talkId": "6957102",
            "initDialog": "695710201",
            "dialogues": [
                {
                    "id": "695710201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957103",
            "initDialog": "695710301",
            "dialogues": [
                {
                    "id": "695710301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695710302",
                    "speaker": "娜维娅",
                    "text": "你要走了吗？我还没玩够呢。唔…一定有更多的组牌方式…"
                }
            ]
        },
        {
            "talkId": "6957104",
            "initDialog": "695710401",
            "dialogues": [
                {
                    "id": "695710401",
                    "speaker": "娜维娅",
                    "text": "别灰心啊，你刚才肯定是被太阳晒得有点头晕，才会出现那种失误。来，用我的帽子扇扇风。我们再来一局。"
                }
            ]
        },
        {
            "talkId": "6957105",
            "initDialog": "695710501",
            "dialogues": [
                {
                    "id": "695710501",
                    "speaker": "娜维娅",
                    "text": "呼啊…玩得真开心，这种卡牌游戏果然很有意思。欸？胜负无所谓啦，重点是能和搭档你一起玩卡牌啦。"
                }
            ]
        },
        {
            "talkId": "6957106",
            "initDialog": "695710601",
            "dialogues": [
                {
                    "id": "695710601",
                    "speaker": "娜维娅",
                    "text": "要玩牌吗？好啊，现在就开始吧！"
                }
            ]
        },
        {
            "talkId": "6957108",
            "initDialog": "695710801",
            "dialogues": [
                {
                    "id": "695710801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957109",
            "initDialog": "695710901",
            "dialogues": [
                {
                    "id": "695710901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957110",
            "initDialog": "695711001",
            "dialogues": [
                {
                    "id": "695711001",
                    "speaker": "娜维娅",
                    "text": "好！完美结束，抱歉啦搭档，这一局就由我拿下了。"
                }
            ]
        },
        {
            "talkId": "6957111",
            "initDialog": "695711101",
            "dialogues": [
                {
                    "id": "695711101",
                    "speaker": "娜维娅",
                    "text": "没想到你居然会在牌组里加入那种卡牌…真是出乎意料，这一局是你赢啦。"
                }
            ]
        },
        {
            "talkId": "6957112",
            "initDialog": "695711201",
            "dialogues": [
                {
                    "id": "695711201",
                    "speaker": "娜维娅",
                    "text": "喔…一副这么自信的样子，那就让我见识一下你的全新牌组吧。"
                }
            ]
        },
        {
            "talkId": "6957114",
            "initDialog": "695711401",
            "dialogues": [
                {
                    "id": "695711401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957115",
            "initDialog": "695711501",
            "dialogues": [
                {
                    "id": "695711501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957116",
            "initDialog": "695711601",
            "dialogues": [
                {
                    "id": "695711601",
                    "speaker": "娜维娅",
                    "text": "嗯嗯，不愧是我的牌组，果然实力更胜一筹呢。"
                }
            ]
        },
        {
            "talkId": "6957117",
            "initDialog": "695711701",
            "dialogues": [
                {
                    "id": "695711701",
                    "speaker": "娜维娅",
                    "text": "我的牌组居然输掉了…唔，看来我得让它们接受特训了。"
                }
            ]
        },
        {
            "talkId": "6957118",
            "initDialog": "695711801",
            "dialogues": [
                {
                    "id": "695711801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}