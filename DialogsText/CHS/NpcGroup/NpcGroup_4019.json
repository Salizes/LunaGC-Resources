{
    "groupId": "4019",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 10,
        "凯瑟琳": 27
    },
    "talks": [
        {
            "talkId": "6401901",
            "initDialog": "640190101",
            "dialogues": [
                {
                    "id": "640190101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6401902",
            "initDialog": "640190201",
            "dialogues": [
                {
                    "id": "640190201",
                    "speaker": "Player",
                    "text": "果然是你，凯瑟琳！"
                },
                {
                    "id": "640190202",
                    "speaker": "凯瑟琳",
                    "text": "你好，我的确是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "640190203",
                    "speaker": "凯瑟琳",
                    "text": "看来你已经很熟悉冒险家协会的运作模式，我就不多赘述了。"
                }
            ]
        },
        {
            "talkId": "6401903",
            "initDialog": "640190301",
            "dialogues": [
                {
                    "id": "640190301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640190302",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6401904",
            "initDialog": "640190401",
            "dialogues": [
                {
                    "id": "640190401",
                    "speaker": "Player",
                    "text": "难道凯瑟琳一直在跟着我？"
                },
                {
                    "id": "640190402",
                    "speaker": "凯瑟琳",
                    "text": "呵呵，如果是公费派遣的话，我不会拒绝。"
                },
                {
                    "id": "640190403",
                    "speaker": "凯瑟琳",
                    "text": "但很遗憾，接待员是一份全年无休的工作，我并没有那样的机会。"
                }
            ]
        },
        {
            "talkId": "6401905",
            "initDialog": "640190501",
            "dialogues": [
                {
                    "id": "640190501",
                    "speaker": "凯瑟琳",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6401906",
            "initDialog": "640190601",
            "dialogues": [
                {
                    "id": "640190601",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6401907",
            "initDialog": "640190701",
            "dialogues": [
                {
                    "id": "640190701",
                    "speaker": "Player",
                    "text": "你的身体…没事了吗？"
                },
                {
                    "id": "640190702",
                    "speaker": "凯瑟琳",
                    "text": "我的身体？我的身体怎么了么？"
                },
                {
                    "id": "640190703",
                    "speaker": "凯瑟琳",
                    "text": "不好意思，过去的事我有些记不清了，不过既然我好好地站在这里，想必就应该没什么关系吧。"
                },
                {
                    "id": "640190704",
                    "speaker": "Player",
                    "text": "（凯瑟琳没有之前的记忆，是替换了新的人偶吗？）"
                }
            ]
        },
        {
            "talkId": "6401908",
            "initDialog": "640190801",
            "dialogues": [
                {
                    "id": "640190801",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6401909",
            "initDialog": "640190901",
            "dialogues": [
                {
                    "id": "640190901",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6401910",
            "initDialog": "640191001",
            "dialogues": [
                {
                    "id": "640191001",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6401911",
            "initDialog": "640191101",
            "dialogues": [
                {
                    "id": "640191101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640191102",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "7068804",
            "initDialog": "706880401",
            "dialogues": [
                {
                    "id": "706880401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880402",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880403",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880404",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880407",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880408",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880409",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880405",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880406",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        }
    ]
}