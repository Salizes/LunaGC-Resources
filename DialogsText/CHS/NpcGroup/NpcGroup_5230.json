{
    "groupId": "5230",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "「狡诈泡泡桔」": 11
    },
    "talks": [
        {
            "talkId": "6523001",
            "initDialog": "652300101",
            "dialogues": [
                {
                    "id": "652300101",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "呀？恩人！你怎么进来的？算了，我忘了你是高人，肯定有你的办法。"
                }
            ]
        },
        {
            "talkId": "6523002",
            "initDialog": "652300201",
            "dialogues": [
                {
                    "id": "652300201",
                    "speaker": "Player",
                    "text": "你又是怎么进来的？"
                },
                {
                    "id": "652300202",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "哈哈，问得好，别忘了我的名字，我也有我的办法。"
                }
            ]
        },
        {
            "talkId": "6523003",
            "initDialog": "652300301",
            "dialogues": [
                {
                    "id": "652300301",
                    "speaker": "Player",
                    "text": "你的生意怎么样？"
                },
                {
                    "id": "652300302",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "嘘…小点声，我还在摸这个地方的底呢。"
                },
                {
                    "id": "652300303",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "这里的人买杂货什么的，好像只会去那个叫「破烂骨头商店」的地方，我现在不能高调地把货全铺开，不然被人盯上可不好。"
                },
                {
                    "id": "652300304",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "特别是那个埃尔瓦德…"
                }
            ]
        },
        {
            "talkId": "6523004",
            "initDialog": "652300401",
            "dialogues": [
                {
                    "id": "652300401",
                    "speaker": "Player",
                    "text": "布兰奇还好吗？"
                },
                {
                    "id": "652300402",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "她很好，我进来前给她找了个家庭老师，嘿嘿，你猜是什么老师？留影老师！"
                },
                {
                    "id": "652300403",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "我让老师每天往她眼里灌画片，全是其他国家的绝美风景，这样一定能把她迷得神魂颠倒。"
                },
                {
                    "id": "652300404",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "这样以后再送她去其他国家读书，她一定不会像现在这么抵触了。"
                }
            ]
        },
        {
            "talkId": "6523005",
            "initDialog": "652300501",
            "dialogues": [
                {
                    "id": "652300501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652300502",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "恩人，再见！"
                }
            ]
        },
        {
            "talkId": "6523006",
            "initDialog": "652300601",
            "dialogues": [
                {
                    "id": "652300601",
                    "speaker": "Player",
                    "text": "什么红发的家伙？"
                },
                {
                    "id": "652300602",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "哦，我以前有一个红头发的兄弟，不知道是不是最近没休息好，感觉最近总是在监狱里看见他，一定是眼花了。"
                }
            ]
        },
        {
            "talkId": "7493901",
            "initDialog": "749390101",
            "dialogues": [
                {
                    "id": "749390101",
                    "speaker": "Player",
                    "text": "你还真是一如从前啊。"
                },
                {
                    "id": "749390102",
                    "speaker": "「狡诈泡泡桔」",
                    "text": "做人嘛，当然不能忘本啦。当然，也不能忘记你的恩情，一点心意，请收下吧。"
                }
            ]
        }
    ]
}