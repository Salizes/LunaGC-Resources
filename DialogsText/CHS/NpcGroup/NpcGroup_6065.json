{
    "groupId": "6065",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "白浜": 9
    },
    "talks": [
        {
            "talkId": "6606501",
            "initDialog": "660650101",
            "dialogues": [
                {
                    "id": "660650101",
                    "speaker": "白浜",
                    "text": "得找机会亲自煮个温泉蛋…"
                }
            ]
        },
        {
            "talkId": "6606502",
            "initDialog": "660650201",
            "dialogues": [
                {
                    "id": "660650201",
                    "speaker": "Player",
                    "text": "温泉蛋？"
                },
                {
                    "id": "660650202",
                    "speaker": "白浜",
                    "text": "对！都来泡温泉了，当然得有温泉蛋嘛！"
                },
                {
                    "id": "660650203",
                    "speaker": "白浜",
                    "text": "我之前试了下，人工温泉这边的温度不够，管理员又不让我去温度更高的地方…"
                },
                {
                    "id": "660650204",
                    "speaker": "白浜",
                    "text": "所以我拜托当地人帮我用温度最高的温泉水煮了一个！"
                },
                {
                    "id": "660650205",
                    "speaker": "白浜",
                    "text": "嘿嘿，终于吃上真正的温泉蛋了…不知道是不是错觉，感觉比一般的半熟蛋好吃多了？"
                },
                {
                    "id": "660650206",
                    "speaker": "白浜",
                    "text": "不过我还是想亲自煮一次就是了…得想个办法…"
                }
            ]
        },
        {
            "talkId": "6606503",
            "initDialog": "660650301",
            "dialogues": [
                {
                    "id": "660650301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660650302",
                    "speaker": "白浜",
                    "text": "再见，记得试试温泉蛋！"
                }
            ]
        },
        {
            "talkId": "7592801",
            "initDialog": "759280101",
            "dialogues": [
                {
                    "id": "759280101",
                    "speaker": "Player",
                    "text": "说得我也想试试了…"
                },
                {
                    "id": "759280102",
                    "speaker": "白浜",
                    "text": "非常顺滑的口感，值得一试！"
                },
                {
                    "id": "759280103",
                    "speaker": "白浜",
                    "text": "来，分你几个蛋，一定要试试看哦。"
                }
            ]
        }
    ]
}