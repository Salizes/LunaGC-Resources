{
    "groupId": "6528",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "「穆奇赫」": 8
    },
    "talks": [
        {
            "talkId": "5900249",
            "initDialog": "590024901",
            "dialogues": [
                {
                    "id": "590024901",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900250",
            "initDialog": "590025001",
            "dialogues": [
                {
                    "id": "590025001",
                    "speaker": "「穆奇赫」",
                    "text": "唔…值得留意的吗？要留意不要被沙滩上的贝壳割破脚底板。唔…螃蟹对脚底板也有威胁。总之这些都要留意。"
                }
            ]
        },
        {
            "talkId": "6652801",
            "initDialog": "665280101",
            "dialogues": [
                {
                    "id": "665280101",
                    "speaker": "「穆奇赫」",
                    "text": "悠悠纳塔，悠悠夏天！欢迎来到刺梨镇，哦不，欢迎来到浪浪湾，这里有…呃…后面的台词是什么来着？"
                },
                {
                    "id": "665280102",
                    "speaker": "「穆奇赫」",
                    "text": "这里有经过五百年的洋流冲刷形成的天然细白沙滩！这里还有…呃…"
                }
            ]
        },
        {
            "talkId": "6652802",
            "initDialog": "665280201",
            "dialogues": [
                {
                    "id": "665280201",
                    "speaker": "Player",
                    "text": "台词没记住？不用勉强。"
                },
                {
                    "id": "665280204",
                    "speaker": "「穆奇赫」",
                    "text": "呼…谢谢你，客人。"
                },
                {
                    "id": "665280205",
                    "speaker": "「穆奇赫」",
                    "text": "穆奇赫原本是刺梨镇的原野猎人，前几天，他们让穆奇赫来这里当安全员，所以还不太熟悉…真不好意思。"
                },
                {
                    "id": "665280206",
                    "speaker": "「穆奇赫」",
                    "text": "总之这里是刺…是浪浪湾，客人只管跳进海里玩个痛快就好，安全的事穆奇赫会负责！虽然穆奇赫记性不太行，但是眼神和水性都很行。"
                },
                {
                    "id": "665280207",
                    "speaker": "「穆奇赫」",
                    "text": "穆奇赫会盯住每一个水里游的东西，不管水母、鲨鱼还是客人，穆奇赫都可以捞上来。"
                }
            ]
        },
        {
            "talkId": "6652803",
            "initDialog": "665280301",
            "dialogues": [
                {
                    "id": "665280301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "665280302",
                    "speaker": "「穆奇赫」",
                    "text": "穆奇赫跟您在原野和沙滩告别。"
                }
            ]
        }
    ]
}