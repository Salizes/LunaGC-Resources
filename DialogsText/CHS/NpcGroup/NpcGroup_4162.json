{
    "groupId": "4162",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "娜泽宁": 5,
        "帕森": 4
    },
    "talks": [
        {
            "talkId": "6416101",
            "initDialog": "641610101",
            "dialogues": [
                {
                    "id": "641610101",
                    "speaker": "帕森",
                    "text": "我去加入镀金旅团，既能给家里赚钱，还能有去沙漠冒险的机会，多好啊！"
                },
                {
                    "id": "641610102",
                    "speaker": "娜泽宁",
                    "text": "好？好你个头！连菜刀都拿不稳的笨蛋，打得了架吗！"
                },
                {
                    "id": "641610103",
                    "speaker": "帕森",
                    "text": "菜刀…能、能和猎刀比吗？根本不是一种东西！"
                },
                {
                    "id": "641610104",
                    "speaker": "娜泽宁",
                    "text": "我是不明白你到底哪里来的自信。在家里搬个箱子都叽叽歪歪的，到了沙漠别说遇见野兽强盗，晒太阳都能晒死你！"
                },
                {
                    "id": "641610105",
                    "speaker": "帕森",
                    "text": "你…！"
                },
                {
                    "id": "641610106",
                    "speaker": "娜泽宁",
                    "text": "我怎么啦？我说的不是事实？就连什么都会的赤王都死在了沙漠里，你觉得你比赤王强？"
                },
                {
                    "id": "641610107",
                    "speaker": "帕森",
                    "text": "这…"
                },
                {
                    "id": "641610108",
                    "speaker": "娜泽宁",
                    "text": "你这怂包要是玩完了，我当了寡妇也继承不了几个钱。"
                },
                {
                    "id": "641610109",
                    "speaker": "娜泽宁",
                    "text": "反正就是不许去，听到没！"
                }
            ]
        }
    ]
}