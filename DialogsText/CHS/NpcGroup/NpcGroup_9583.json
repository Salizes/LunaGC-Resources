    "talks": [
        {
            "talkId": "6958301",
            "initDialog": "695830101",
            "dialogues": [
                {
                    "id": "695830101",
                    "speaker": "卡齐娜",
                    "text": "呜哇…这里的气氛就和竞技场一样，大家打牌的时候都好有热情喔…"
                }
            ]
        },
        {
            "talkId": "6958302",
            "initDialog": "695830201",
            "dialogues": [
                {
                    "id": "695830201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958303",
            "initDialog": "695830301",
            "dialogues": [
                {
                    "id": "695830301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695830302",
                    "speaker": "卡齐娜",
                    "text": "欸？要走了吗？稍等一下，我收拾一下和你一起走。"
                }
            ]
        },
        {
            "talkId": "6958304",
            "initDialog": "695830401",
            "dialogues": [
                {
                    "id": "695830401",
                    "speaker": "卡齐娜",
                    "text": "赢啦！嘿嘿，还是多亏了你，教我读懂了那么多卡牌。等下再陪我看看吧，我带了零食，可好吃了。"
                }
            ]
        },
        {
            "talkId": "6958305",
            "initDialog": "695830501",
            "dialogues": [
                {
                    "id": "695830501",
                    "speaker": "卡齐娜",
                    "text": "还是你比较厉害…等一下再陪我看一下卡牌吧，有好多卡牌的效果我都没看懂呢…"
                }
            ]
        },
        {
            "talkId": "6958306",
            "initDialog": "695830601",
            "dialogues": [
                {
                    "id": "695830601",
                    "speaker": "卡齐娜",
                    "text": "嗯！我会加油的！"
                }
            ]
        },
        {
            "talkId": "6958308",
            "initDialog": "695830801",
            "dialogues": [
                {
                    "id": "695830801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958309",
            "initDialog": "695830901",
            "dialogues": [
                {
                    "id": "695830901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958310",
            "initDialog": "695831001",
            "dialogues": [
                {
                    "id": "695831001",
                    "speaker": "卡齐娜",
                    "text": "太好了，赢下来啦！"
                }
            ]
        },
        {
            "talkId": "6958311",
            "initDialog": "695831101",
            "dialogues": [
                {
                    "id": "695831101",
                    "speaker": "卡齐娜",
                    "text": "呜…又搞砸了…不对呀，是哪一手弄错了…"
                }
            ]
        },
        {
            "talkId": "6958312",
            "initDialog": "695831201",
            "dialogues": [
                {
                    "id": "695831201",
                    "speaker": "卡齐娜",
                    "text": "这次我一定会赢的！"
                }
            ]
        },
        {
            "talkId": "6958314",
            "initDialog": "695831401",
            "dialogues": [
                {
                    "id": "695831401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958315",
            "initDialog": "695831501",
            "dialogues": [
                {
                    "id": "695831501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958316",
            "initDialog": "695831601",
            "dialogues": [
                {
                    "id": "695831601",
                    "speaker": "卡齐娜",
                    "text": "呼啊，总算赢了…我好紧张，心跳得也好厉害…"
                }
            ]
        },
        {
            "talkId": "6958317",
            "initDialog": "695831701",
            "dialogues": [
                {
                    "id": "695831701",
                    "speaker": "卡齐娜",
                    "text": "那一手…不该逞强的，难道是因为我太想赢了吗…"
                }
            ]
        },
        {
            "talkId": "6958318",
            "initDialog": "695831801",
            "dialogues": [
                {
                    "id": "695831801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
