{
    "groupId": "2068",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "仁羽": 14
    },
    "talks": [
        {
            "talkId": "6206801",
            "initDialog": "620680101",
            "dialogues": [
                {
                    "id": "620680101",
                    "speaker": "仁羽",
                    "text": "唉，我们家老爷生了点小病，管事让我来抓药，可我又不识字啊…"
                },
                {
                    "id": "620680102",
                    "speaker": "仁羽",
                    "text": "您行行好，帮我看看呗？"
                }
            ]
        },
        {
            "talkId": "6206802",
            "initDialog": "620680201",
            "dialogues": [
                {
                    "id": "620680201",
                    "speaker": "仁羽",
                    "text": "我来帮你吧。"
                },
                {
                    "id": "620680202",
                    "speaker": "仁羽",
                    "text": "那可真是太谢谢您了！"
                },
                {
                    "id": "620680203",
                    "speaker": "仁羽",
                    "text": "来，药方在这里，麻烦您帮我看看…"
                },
                {
                    "id": "620680204",
                    "speaker": "仁羽",
                    "text": "为什么药方上的不是字？"
                },
                {
                    "id": "620680205",
                    "speaker": "仁羽",
                    "text": "啊，原来这不是字吗？我就说第一个字怎么看着这么像一条狗呢…"
                },
                {
                    "id": "620680206",
                    "speaker": "仁羽",
                    "text": "我懂了！肯定是管事知道我不识字，特意画了跟字的发音一样的东西！"
                },
                {
                    "id": "620680207",
                    "speaker": "仁羽",
                    "text": "这是个狗，上面插了个旗子…莫非，这是「枸杞」？"
                },
                {
                    "id": "620680208",
                    "speaker": "仁羽",
                    "text": "这有个大火炉，旁边画了个冰块，化了…难道是「鹿茸」？"
                },
                {
                    "id": "620680209",
                    "speaker": "仁羽",
                    "text": "太感谢您了！您可真是个大学问人啊！这回不会给我们老爷丢人了！"
                },
                {
                    "id": "620680210",
                    "speaker": "仁羽",
                    "text": "…欸，这个黑不溜秋的是个啥？这又是啥？…完了，我连画的啥都看不懂了…"
                }
            ]
        },
        {
            "talkId": "6206803",
            "initDialog": "620680301",
            "dialogues": [
                {
                    "id": "620680301",
                    "speaker": "仁羽",
                    "text": "抱歉，我没空。"
                },
                {
                    "id": "620680302",
                    "speaker": "仁羽",
                    "text": "唉，回去又得挨骂了…"
                }
            ]
        }
    ]
}