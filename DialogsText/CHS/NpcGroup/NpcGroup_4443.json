{
    "groupId": "4443",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "菲多赫": 10
    },
    "talks": [
        {
            "talkId": "6444301",
            "initDialog": "644430101",
            "dialogues": [
                {
                    "id": "644430101",
                    "speaker": "菲多赫",
                    "text": "人类？已经好久没有人类来到这里了。"
                },
                {
                    "id": "644430102",
                    "speaker": "菲多赫",
                    "text": "不过你似乎并非是与花灵建立连结之人，看来不能拜托你了。"
                }
            ]
        },
        {
            "talkId": "6444302",
            "initDialog": "644430201",
            "dialogues": [
                {
                    "id": "644430201",
                    "speaker": "菲多赫",
                    "text": "异乡的「祭主」，是来向「甘露池」供奉「净光翎」的吗？"
                }
            ]
        },
        {
            "talkId": "6444303",
            "initDialog": "644430301",
            "dialogues": [
                {
                    "id": "644430301",
                    "speaker": "Player",
                    "text": "关于「净光翎」…"
                },
                {
                    "id": "644430302",
                    "speaker": "菲多赫",
                    "text": "「净光翎」是记忆的断片。神鸟的、花灵的、人类的，无法回归树与大地的记忆就会变成「净光翎」。"
                },
                {
                    "id": "644430303",
                    "speaker": "菲多赫",
                    "text": "不过只要向「甘露池」供奉，无论什么样的记忆都能被接纳。"
                },
                {
                    "id": "644430304",
                    "speaker": "菲多赫",
                    "text": "在地上还有没来得及化为「净光翎」的追忆，也拜托你去找回了。"
                }
            ]
        },
        {
            "talkId": "6444304",
            "initDialog": "644430401",
            "dialogues": [
                {
                    "id": "644430401",
                    "speaker": "Player",
                    "text": "关于「甘露池」…"
                },
                {
                    "id": "644430402",
                    "speaker": "菲多赫",
                    "text": "甘露之水是最初的水，也是赋予我们花灵生命的地方。"
                },
                {
                    "id": "644430403",
                    "speaker": "菲多赫",
                    "text": "无论是怎样的痛苦与悲怨，甘露之水都能将它们洗净。"
                }
            ]
        },
        {
            "talkId": "6444305",
            "initDialog": "644430501",
            "dialogues": [
                {
                    "id": "644430501",
                    "speaker": "Player",
                    "text": "关于供奉…"
                },
                {
                    "id": "644430502",
                    "speaker": "菲多赫",
                    "text": "只要向「甘露池」供奉，水与树便会降下恩赐。"
                },
                {
                    "id": "644430503",
                    "speaker": "菲多赫",
                    "text": "这也是神明的慈悲。"
                }
            ]
        }
    ]
}