    "talks": [
        {
            "talkId": "6500401",
            "initDialog": "650040101",
            "dialogues": [
                {
                    "id": "650040101",
                    "speaker": "杰柯艾妲",
                    "text": "我就不懂了，那俩领导明明就坐在一个办公室里，还是前后桌，怎么下达的意见还能不一样的？"
                },
                {
                    "id": "650040102",
                    "speaker": "伊莎朵",
                    "text": "感觉是缺乏沟通吧…"
                },
                {
                    "id": "650040103",
                    "speaker": "杰柯艾妲",
                    "text": "而且每次去签字都找不到人，要不就是找到了一个又让我问另一个的意见，你们自己不能先统一一下吗？"
                },
                {
                    "id": "650040104",
                    "speaker": "伊莎朵",
                    "text": "那就是关系不好吧…"
                },
                {
                    "id": "650040105",
                    "speaker": "杰柯艾妲",
                    "text": "最近抗议沫芒宫对「预言」不予作为的民众也变多了，还有一个工程的施工方也搞罢工…"
                },
                {
                    "id": "650040106",
                    "speaker": "杰柯艾妲",
                    "text": "「预言」这东西又说不上真假，我们还有更实际的问题要处理呢…"
                },
                {
                    "id": "650040107",
                    "speaker": "杰柯艾妲",
                    "text": "嗯，说的也是…"
                }
            ]
        },
        {
            "talkId": "6500402",
            "initDialog": "650040201",
            "dialogues": [
                {
                    "id": "650040201",
                    "speaker": "杰柯艾妲",
