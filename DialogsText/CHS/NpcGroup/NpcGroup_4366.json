{
    "groupId": "4366",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "阿什亚": 9
    },
    "talks": [
        {
            "talkId": "6436601",
            "initDialog": "643660101",
            "dialogues": [
                {
                    "id": "643660101",
                    "speaker": "阿什亚",
                    "text": "这次的采购还挺顺利的，还差一点就买齐了。"
                }
            ]
        },
        {
            "talkId": "6436602",
            "initDialog": "643660201",
            "dialogues": [
                {
                    "id": "643660201",
                    "speaker": "Player",
                    "text": "你在买什么？"
                },
                {
                    "id": "643660202",
                    "speaker": "阿什亚",
                    "text": "都是些生活必需品，没什么特别的。"
                },
                {
                    "id": "643660203",
                    "speaker": "阿什亚",
                    "text": "我家在阿如村，地处戈壁。虽然地下水源充足，但物产不是很丰富，所以我会定期来喀万驿采购日常用品。"
                },
                {
                    "id": "643660204",
                    "speaker": "阿什亚",
                    "text": "这边离沙漠近，往来的商贩又多，想买什么都很方便。"
                }
            ]
        },
        {
            "talkId": "6436603",
            "initDialog": "643660301",
            "dialogues": [
                {
                    "id": "643660301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643660302",
                    "speaker": "阿什亚",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6436604",
            "initDialog": "643660401",
            "dialogues": [
                {
                    "id": "643660401",
                    "speaker": "Player",
                    "text": "关于阿如村…"
                },
                {
                    "id": "643660402",
                    "speaker": "阿什亚",
                    "text": "从喀万驿出发往西边的沙漠走，只要不过于另辟蹊径，应该会路过阿如村的。"
                },
                {
                    "id": "643660403",
                    "speaker": "阿什亚",
                    "text": "那里虽然生活简朴，也有一些传统的条条框框，但有着小村庄独有的安逸，至少我很喜欢。"
                },
                {
                    "id": "643660404",
                    "speaker": "阿什亚",
                    "text": "村子里的大家都很友好，无论你是迷路的冒险家，还是被流放的学者，我们都会愿意收留的。"
                },
                {
                    "id": "643660405",
                    "speaker": "阿什亚",
                    "text": "——当然，前提是你对村子没有恶意。否则，就准备迎接坎蒂丝的怒火吧。"
                }
            ]
        }
    ]
}