{
    "groupId": "9021",
    "total_dialogue_lines": 58,
    "speaker_counts": {
        "Player": 17,
        "安柏": 41
    },
    "talks": [
        {
            "talkId": "6902101",
            "initDialog": "690210101",
            "dialogues": [
                {
                    "id": "690210101",
                    "speaker": "安柏",
                    "text": "#是你呀，{NICKNAME}。"
                },
                {
                    "id": "690210102",
                    "speaker": "安柏",
                    "text": "见到你真高兴！"
                }
            ]
        },
        {
            "talkId": "6902102",
            "initDialog": "690210201",
            "dialogues": [
                {
                    "id": "690210201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690210202",
                    "speaker": "安柏",
                    "text": "很习惯！"
                },
                {
                    "id": "690210203",
                    "speaker": "安柏",
                    "text": "我对住的地方不那么挑剔。毕竟侦察骑士，得适应各种各样的环境。"
                },
                {
                    "id": "690210204",
                    "speaker": "安柏",
                    "text": "必要的时候，就算在树枝上也要能睡着。",
                    "choices": [
                        {
                            "id": "690210205",
                            "text": "那还真是厉害啊。",
                            "response": [
                                {
                                    "id": "690210206",
                                    "speaker": "安柏",
                                    "text": "是，是吗…"
                                },
                                {
                                    "id": "690210209",
                                    "speaker": "安柏",
                                    "text": "放心吧！我很喜欢这个地方。"
                                }
                            ]
                        },
                        {
                            "id": "690210207",
                            "text": "希望这里比「树枝」舒适一点。",
                            "response": [
                                {
                                    "id": "690210208",
                                    "speaker": "安柏",
                                    "text": "嘿嘿，那是当然的喽。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902103",
            "initDialog": "690210301",
            "dialogues": [
                {
                    "id": "690210301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690210302",
                    "speaker": "安柏",
                    "text": "好呀。"
                },
                {
                    "id": "690210303",
                    "speaker": "安柏",
                    "text": "……"
                },
                {
                    "id": "690210304",
                    "speaker": "安柏",
                    "text": "抱歉，我不是很擅长讲故事。不像爷爷或者丽莎，脑袋一转就能讲出非常引人入胜的故事。",
                    "choices": [
                        {
                            "id": "690210305",
                            "text": "我记得安柏有本笔记…",
                            "response": [
                                {
                                    "id": "690210306",
                                    "speaker": "安柏",
                                    "text": "欸！你是什么时候发现的！"
                                },
                                {
                                    "id": "690210307",
                                    "speaker": "安柏",
                                    "text": "虽然原本不是什么秘密，但里面记录了不少夸你的话…"
                                },
                                {
                                    "id": "690210308",
                                    "speaker": "安柏",
                                    "text": "真要拿给你看还是会不好意思的啦！"
                                },
                                {
                                    "id": "690210309",
                                    "speaker": "安柏",
                                    "text": "但，我可以摘一点有关冒险的故事和你分享。"
                                },
                                {
                                    "id": "690210315",
                                    "speaker": "安柏",
                                    "text": "好！嘿嘿，那我开始了…"
                                }
                            ]
                        },
                        {
                            "id": "690210310",
                            "text": "我想听听安柏的过往。",
                            "response": [
                                {
                                    "id": "690210311",
                                    "speaker": "安柏",
                                    "text": "过去的事啊…"
                                },
                                {
                                    "id": "690210312",
                                    "speaker": "安柏",
                                    "text": "可能不是那么有趣。而且，以我现在的眼光来看，小时候的自己…还是太调皮了一点。"
                                },
                                {
                                    "id": "690210313",
                                    "speaker": "安柏",
                                    "text": "不过只要你不取笑我的话，我还是愿意讲给你听的！"
                                },
                                {
                                    "id": "690210314",
                                    "speaker": "Player",
                                    "text": "那就拜托喽？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902104",
            "initDialog": "690210401",
            "dialogues": [
                {
                    "id": "690210401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690210402",
                    "speaker": "安柏",
                    "text": "我想和你一起吃晚饭！"
                },
                {
                    "id": "690210403",
                    "speaker": "安柏",
                    "text": "即使是再平常不过的用餐，在餐馆里和在家里是完全不一样的感觉。"
                },
                {
                    "id": "690210404",
                    "speaker": "安柏",
                    "text": "餐馆里虽然很方便，味道也有保证。"
                },
                {
                    "id": "690210405",
                    "speaker": "安柏",
                    "text": "但只有在家里，才有那种独一无二的温暖感。",
                    "choices": [
                        {
                            "id": "690210406",
                            "text": "嗯，我明白。",
                            "response": [
                                {
                                    "id": "690210407",
                                    "speaker": "安柏",
                                    "text": "对吧！那就来嘛！"
                                },
                                {
                                    "id": "690210410",
                                    "speaker": "安柏",
                                    "text": "我来做烤肉，唔…不行，「侦察骑士烤肉」的味道你早就熟悉了。"
                                },
                                {
                                    "id": "690210411",
                                    "speaker": "安柏",
                                    "text": "我得对自己提出更高的要求。"
                                },
                                {
                                    "id": "690210412",
                                    "speaker": "安柏",
                                    "text": "好，干脆，这次就来挑战蜜酱胡萝卜煎肉吧！"
                                },
                                {
                                    "id": "690210413",
                                    "speaker": "安柏",
                                    "text": "啊…不会把你厨房的屋顶熏黑吧…"
                                },
                                {
                                    "id": "690210414",
                                    "speaker": "Player",
                                    "text": "熏黑也没有关系。"
                                },
                                {
                                    "id": "690210415",
                                    "speaker": "Player",
                                    "text": "我也会一起帮忙。"
                                },
                                {
                                    "id": "690210416",
                                    "speaker": "安柏",
                                    "text": "嘿嘿，你对我真好。"
                                },
                                {
                                    "id": "690210417",
                                    "speaker": "安柏",
                                    "text": "我一定会拿出最美味的成品，和你共享。哪怕失败几百遍也不会放弃的！"
                                },
                                {
                                    "id": "690210418",
                                    "speaker": "安柏",
                                    "text": "真期待啊…"
                                }
                            ]
                        },
                        {
                            "id": "690210408",
                            "text": "那就一起吃晚饭吧。",
                            "response": [
                                {
                                    "id": "690210409",
                                    "speaker": "安柏",
                                    "text": "真的吗？！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902105",
            "initDialog": "690210501",
            "dialogues": [
                {
                    "id": "690210501",
                    "speaker": "Player",
                    "text": "早啊，安柏。"
                },
                {
                    "id": "690210502",
                    "speaker": "安柏",
                    "text": "#{NICKNAME}，早啊！"
                },
                {
                    "id": "690210503",
                    "speaker": "安柏",
                    "text": "遇到需要侦察骑士出马的场合，就尽管交给我好了！"
                }
            ]
        },
        {
            "talkId": "6902106",
            "initDialog": "690210601",
            "dialogues": [
                {
                    "id": "690210601",
                    "speaker": "Player",
                    "text": "晚安，安柏。"
                },
                {
                    "id": "690210602",
                    "speaker": "安柏",
                    "text": "晚安，你也要早点休息哦！"
                }
            ]
        },
        {
            "talkId": "6902107",
            "initDialog": "690210701",
            "dialogues": [
                {
                    "id": "690210701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902108",
            "initDialog": "690210801",
            "dialogues": [
                {
                    "id": "690210801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902109",
            "initDialog": "690210901",
            "dialogues": [
                {
                    "id": "690210901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902150",
            "initDialog": "690215001",
            "dialogues": [
                {
                    "id": "690215001",
                    "speaker": "安柏",
                    "text": "真厉害呀，你居然建造了这么宽敞的营地…"
                },
                {
                    "id": "690215002",
                    "speaker": "安柏",
                    "text": "我可以在这里练习弓箭和侦察的技巧吗？"
                },
                {
                    "id": "690215003",
                    "speaker": "安柏",
                    "text": "或者，我们结伴练习！用比赛来决定胜负！"
                }
            ]
        },
        {
            "talkId": "6902151",
            "initDialog": "690215101",
            "dialogues": [
                {
                    "id": "690215101",
                    "speaker": "安柏",
                    "text": "有段时间，学习风之翼的新人，会在清泉镇做简单的练习。"
                },
                {
                    "id": "690215102",
                    "speaker": "安柏",
                    "text": "因为清泉镇的屋子大多只有两三层，高度恰到好处，适合上手嘛。"
                },
                {
                    "id": "690215103",
                    "speaker": "安柏",
                    "text": "但是，要记得不能违规使用风之翼哦！在这里也一样。"
                }
            ]
        }
    ]
}