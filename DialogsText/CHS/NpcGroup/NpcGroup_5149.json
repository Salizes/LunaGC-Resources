{
    "groupId": "5149",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "赫茉莎": 8
    },
    "talks": [
        {
            "talkId": "6514901",
            "initDialog": "651490101",
            "dialogues": [
                {
                    "id": "651490101",
                    "speaker": "赫茉莎",
                    "text": "有几张画片的效果都不错…很难取舍，到时候请编辑来选吧。"
                }
            ]
        },
        {
            "talkId": "6514902",
            "initDialog": "651490201",
            "dialogues": [
                {
                    "id": "651490201",
                    "speaker": "Player",
                    "text": "你是摄影师吗？"
                },
                {
                    "id": "651490202",
                    "speaker": "赫茉莎",
                    "text": "摄影师？不，我虽然很擅长摄影，但我更愿意称呼自己为「冒险家」。"
                },
                {
                    "id": "651490203",
                    "speaker": "赫茉莎",
                    "text": "我会带着猫，去世界各地「冒险」，再拍下一张张有故事的画片。"
                },
                {
                    "id": "651490204",
                    "speaker": "赫茉莎",
                    "text": "谁说图像不能讲述故事呢？这些画片有些会被选登在报纸上，还有些会被作为书刊的插图使用。"
                },
                {
                    "id": "651490205",
                    "speaker": "赫茉莎",
                    "text": "我的画片里基本都会拍到我心爱的猫咪，很好辨认。"
                }
            ]
        },
        {
            "talkId": "6514903",
            "initDialog": "651490301",
            "dialogues": [
                {
                    "id": "651490301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651490302",
                    "speaker": "赫茉莎",
                    "text": "嗯？再见。"
                }
            ]
        },
        {
            "talkId": "6514904",
            "initDialog": "651490401",
            "dialogues": [
                {
                    "id": "651490401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6514905",
            "initDialog": "651490501",
            "dialogues": [
                {
                    "id": "651490501",
                    "speaker": "赫茉莎",
                    "text": "一场精彩的险胜，值得留影纪念，充实我的冒险相册！"
                }
            ]
        },
        {
            "talkId": "6514906",
            "initDialog": "651490601",
            "dialogues": [
                {
                    "id": "651490601",
                    "speaker": "赫茉莎",
                    "text": "唔…这场惜败，要不要留影呢？"
                }
            ]
        }
    ]
}