{
    "groupId": "2517",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "德音": 18
    },
    "talks": [
        {
            "talkId": "6251701",
            "initDialog": "625170101",
            "dialogues": [
                {
                    "id": "625170101",
                    "speaker": "德音",
                    "text": "有道是：「世间兴亡几多事，清泉依旧独自流。」"
                },
                {
                    "id": "625170102",
                    "speaker": "德音",
                    "text": "文人当坚守本心叙说风雅，尽说凡俗之事，不如不说…"
                }
            ]
        },
        {
            "talkId": "6251702",
            "initDialog": "625170201",
            "dialogues": [
                {
                    "id": "625170201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "625170202",
                    "speaker": "德音",
                    "text": "老朽不才，算一个玉匠，半个诗人，之前偶尔也会在遗珑埠的茶馆说说书，讲讲故事。"
                }
            ]
        },
        {
            "talkId": "6251703",
            "initDialog": "625170301",
            "dialogues": [
                {
                    "id": "625170301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "625170302",
                    "speaker": "德音",
                    "text": "来日再会。"
                }
            ]
        },
        {
            "talkId": "6251704",
            "initDialog": "625170401",
            "dialogues": [
                {
                    "id": "625170401",
                    "speaker": "Player",
                    "text": "之前？"
                },
                {
                    "id": "625170402",
                    "speaker": "德音",
                    "text": "最近茶馆里来了个后生，尽讲些街头巷尾的凡俗之事，哗众取宠。"
                },
                {
                    "id": "625170403",
                    "speaker": "德音",
                    "text": "比如什么枫丹人品茶闹的笑话，还有蒙德人败给本地老酒，三碗便倒…"
                },
                {
                    "id": "625170404",
                    "speaker": "德音",
                    "text": "虽说外人的确不懂本地的传统，做过许多不地道的事，但这些在茶余饭后谈谈便好。"
                },
                {
                    "id": "625170405",
                    "speaker": "德音",
                    "text": "真要上了戏台，还是说些风雅的为妙。"
                }
            ]
        },
        {
            "talkId": "6251705",
            "initDialog": "625170501",
            "dialogues": [
                {
                    "id": "625170501",
                    "speaker": "Player",
                    "text": "玉匠？"
                },
                {
                    "id": "625170502",
                    "speaker": "德音",
                    "text": "哈，老朽年轻时，本是沉玉谷诸多玉匠中的翘楚。"
                },
                {
                    "id": "625170503",
                    "speaker": "德音",
                    "text": "美玉和玄妙的故事之间，总有千丝万缕的联系。"
                },
                {
                    "id": "625170504",
                    "speaker": "德音",
                    "text": "因此，老朽会将雕琢美玉时所听闻的故事说予街坊邻居们听，也有了几分名气。"
                },
                {
                    "id": "625170505",
                    "speaker": "德音",
                    "text": "如今，老朽偶尔会将玉器寄放在徒弟那儿出售。"
                },
                {
                    "id": "625170506",
                    "speaker": "德音",
                    "text": "你若是去了遗珑埠，还可以上老朽的徒弟那瞧瞧，说不定能买到称心的玉器。"
                }
            ]
        },
        {
            "talkId": "6251706",
            "initDialog": "625170601",
            "dialogues": [
                {
                    "id": "625170601",
                    "speaker": "Player",
                    "text": "大家开心就好嘛，消消气。"
                },
                {
                    "id": "625170602",
                    "speaker": "德音",
                    "text": "我倒也没置气，只是有些可惜。"
                },
                {
                    "id": "625170603",
                    "speaker": "德音",
                    "text": "遗珑埠的烟火气远大于这翘英庄，来来往往的过客静不下心，只求听个乐呵，我也完全能理解。"
                },
                {
                    "id": "625170604",
                    "speaker": "德音",
                    "text": "可毕竟，沉玉谷有仙人浮锦，有百千筚路蓝缕的先民，值得一说的故事无穷无尽。"
                },
                {
                    "id": "625170605",
                    "speaker": "德音",
                    "text": "凡俗之事和风雅古话，当然可以穿插交错。"
                },
                {
                    "id": "625170606",
                    "speaker": "德音",
                    "text": "也不知那位后生何时才能醒悟…"
                }
            ]
        }
    ]
}