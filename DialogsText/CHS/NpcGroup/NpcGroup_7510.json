        {
            "talkId": "6751008",
            "initDialog": "675100801",
            "dialogues": [
                {
                    "id": "675100801",
                    "speaker": "Player",
                    "text": "让我看看有什么…"
                },
                {
                    "id": "675100802",
                    "speaker": "雅罗斯拉夫",
                    "text": "好嘞，我这里的可都是些在外面收罗来的…嘿嘿，有很多可是货真价实的「遗物」呢！"
                }
            ]
