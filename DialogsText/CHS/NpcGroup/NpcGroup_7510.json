        "雅罗斯拉夫": 14
    },
    "talks": [
        {
            "talkId": "6751001",
            "initDialog": "675100101",
            "dialogues": [
                {
                    "id": "675100101",
                    "speaker": "雅罗斯拉夫",
                    "text": "足不出户，走出至冬！这里什么都有——"
                }
            ]
        },
        {
            "talkId": "6751002",
            "initDialog": "675100201",
            "dialogues": [
                {
                    "id": "675100201",
                    "speaker": "Player",
                    "text": "什么都有？"
                },
                {
                    "id": "675100202",
                    "speaker": "雅罗斯拉夫",
                    "text": "什么都有！世界各地的风物，你都能在我这儿找到。"
                },
                {
                    "id": "675100203",
                    "speaker": "雅罗斯拉夫",
                    "text": "稻妻的小说、须弥的论文集、枫丹的茶点，纳塔的颜料…"
                },
                {
                    "id": "675100204",
                    "speaker": "雅罗斯拉夫",
                    "text": "只要付出一点小小的摩拉，您在这里的收获，说不定比那些周游各国的冒险家还大!"
                }
            ]
        },
        {
            "talkId": "6751003",
            "initDialog": "675100301",
            "dialogues": [
                {
                    "id": "675100301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675100302",
                    "speaker": "雅罗斯拉夫",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6751004",
            "initDialog": "675100401",
            "dialogues": [
                {
                    "id": "675100401",
                    "speaker": "Player",
                    "text": "没有至冬本土商品吗？"
                },
                {
                    "id": "675100402",
                    "speaker": "雅罗斯拉夫",
                    "text": "看来您不是本地人，我跟您说实话吧。我这里做的其实是本地人的生意。"
                },
                {
                    "id": "675100403",
                    "speaker": "雅罗斯拉夫",
                    "text": "在这片广袤的土地上，大多数人终其一生，都没有踏出过至冬的边界。"
                },
                {
                    "id": "675100404",
                    "speaker": "雅罗斯拉夫",
                    "text": "但这不代表他们不对外面的世界感到好奇，不代表他们不想要一点变数。"
                },
                {
                    "id": "675100405",
                    "speaker": "雅罗斯拉夫",
                    "text": "而这些异国风情的小东西，既不昂贵，又能为他们编织一段陌生且奇特的幻梦…"
                },
                {
                    "id": "675100406",
                    "speaker": "雅罗斯拉夫",
                    "text": "正所谓哪里有需求，哪里就有市场。您说对吧？"
                }
            ]
        },
        {
            "talkId": "6751005",
            "initDialog": "675100501",
            "dialogues": [
                {
                    "id": "675100501",
                    "speaker": "Player",
                    "text": "不稀奇，这些地方我都去过。"
                },
                {
                    "id": "675100502",
                    "speaker": "雅罗斯拉夫",
                    "text": "那您真是太幸运了，想必您是一个既有勇气，也有智慧的冒险家。"
                },
                {
                    "id": "675100503",
                    "speaker": "雅罗斯拉夫",
                    "text": "不过，这里还有许多人，终生都没有离开过至冬。"
                },
                {
                    "id": "675100504",
                    "speaker": "雅罗斯拉夫",
                    "text": "也许我卖的只是些平常的小玩意，不过对于他们来说，这些东西何尝又不是领略异国风情最快的方式呢？"
                }
            ]
        },
