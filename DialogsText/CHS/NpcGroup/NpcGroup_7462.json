{
    "groupId": "7462",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "安东": 12
    },
    "talks": [
        {
            "talkId": "6746201",
            "initDialog": "674620101",
            "dialogues": [
                {
                    "id": "674620101",
                    "speaker": "安东",
                    "text": "#是你，{NICKNAME}。没想到还能在至冬堡见到你，真是奇遇。"
                }
            ]
        },
        {
            "talkId": "6746202",
            "initDialog": "674620201",
            "dialogues": [
                {
                    "id": "674620201",
                    "speaker": "Player",
                    "text": "嗯？你是当时在层岩巨渊的…"
                },
                {
                    "id": "674620202",
                    "speaker": "安东",
                    "text": "安东。第九连队的安东。感谢你当初帮助我们，朋友。"
                },
                {
                    "id": "674620203",
                    "speaker": "安东",
                    "text": "我现在正处于休假。如果有什么我能帮到你的，就随时告诉我吧。"
                }
            ]
        },
        {
            "talkId": "6746203",
            "initDialog": "674620301",
            "dialogues": [
                {
                    "id": "674620301",
                    "speaker": "Player",
                    "text": "好好休息。"
                },
                {
                    "id": "674620302",
                    "speaker": "安东",
                    "text": "谢谢你，朋友。也祝你的旅途一切顺利。"
                }
            ]
        },
        {
            "talkId": "6746204",
            "initDialog": "674620401",
            "dialogues": [
                {
                    "id": "674620401",
                    "speaker": "Player",
                    "text": "其他人还好吗？"
                },
                {
                    "id": "674620402",
                    "speaker": "安东",
                    "text": "还好。达尼拉、提莫尔还有拉多米尔，我手下的小伙子们都还活着，目前还在格鲁波夫休养。"
                },
                {
                    "id": "674620403",
                    "speaker": "安东",
                    "text": "层岩巨渊的经历让他们吃了不少苦头，不过万幸，第九连队的编制保住了。我们没有让祖先与陛下蒙羞。"
                },
                {
                    "id": "674620404",
                    "speaker": "安东",
                    "text": "等大家恢复了精神，我们会随时准备迎接新的指令。直到陛下的宏愿实现，我们也许会死去，但不会被击垮。"
                }
            ]
        },
        {
            "talkId": "6746205",
            "initDialog": "674620501",
            "dialogues": [
                {
                    "id": "674620501",
                    "speaker": "Player",
                    "text": "有卡塔琳娜的消息吗？"
                },
                {
                    "id": "674620502",
                    "speaker": "安东",
                    "text": "……"
                },
                {
                    "id": "674620503",
                    "speaker": "安东",
                    "text": "没有消息。但也许…没有消息就是最好的消息。"
                },
                {
                    "id": "674620504",
                    "speaker": "安东",
                    "text": "卡佳和科利亚…他们是壁炉之家的孩子，远比我们更看重家人的羁绊。"
                },
                {
                    "id": "674620505",
                    "speaker": "安东",
                    "text": "如果他们还活着，我希望他们不要再回到这里。"
                },
                {
                    "id": "674620506",
                    "speaker": "安东",
                    "text": "我会相信他们叛离了愚人众，逃到了安全的地方，活了下去。所以对我来说…没有消息就是最好的消息。我还可以这样相信。"
                }
            ]
        }
    ]
}