{
    "groupId": "2260",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "小梁": 10
    },
    "talks": [
        {
            "talkId": "6226001",
            "initDialog": "622600101",
            "dialogues": [
                {
                    "id": "622600101",
                    "speaker": "小梁",
                    "text": "你好啊，叶老板不在，买茶要麻烦你等一阵咯。"
                }
            ]
        },
        {
            "talkId": "6226002",
            "initDialog": "622600201",
            "dialogues": [
                {
                    "id": "622600201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "622600202",
                    "speaker": "小梁",
                    "text": "叫我小梁就行啦，我是叶记的帮工，平时装茶啊记账啊…"
                },
                {
                    "id": "622600203",
                    "speaker": "小梁",
                    "text": "哦，还有订茶咧都可以跟我打声招呼先，一定帮你将那些靓茶留起啊，哈哈。"
                }
            ]
        },
        {
            "talkId": "6226003",
            "initDialog": "622600301",
            "dialogues": [
                {
                    "id": "622600301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622600302",
                    "speaker": "小梁",
                    "text": "好，慢行，欢迎下次帮衬啊。"
                }
            ]
        },
        {
            "talkId": "6226004",
            "initDialog": "622600401",
            "dialogues": [
                {
                    "id": "622600401",
                    "speaker": "Player",
                    "text": "关于靓茶…"
                },
                {
                    "id": "622600402",
                    "speaker": "小梁",
                    "text": "这就问对人啦嘛！我跟老板娘是同乡，前后脚来这边，都好多年咯，什么靓茶没喝过？"
                },
                {
                    "id": "622600403",
                    "speaker": "小梁",
                    "text": "翘英庄的松萝仙芽香气鲜洁，游韵单丛爽啖回甘，都是极品靓茶啊！闭着眼买都不会错的！"
                },
                {
                    "id": "622600404",
                    "speaker": "小梁",
                    "text": "不过咧，如果要买来送礼，还是要早点同叶老板讲声先。"
                }
            ]
        },
        {
            "talkId": "6226005",
            "initDialog": "622600501",
            "dialogues": [
                {
                    "id": "622600501",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "622600502",
                    "speaker": "小梁",
                    "text": "我们庄里的茶叶都统一采摘统一售卖，事后各家按约分红。"
                },
                {
                    "id": "622600503",
                    "speaker": "小梁",
                    "text": "各个老板都同庄里签过协议的啦，这个时候？最靓那批茶早就卖得七七八八咯。"
                },
                {
                    "id": "622600504",
                    "speaker": "小梁",
                    "text": "现在普通茶农手里就剩些自用的散茶，自己冲来饮就没所谓，如果要送礼有点拿不出手喔…"
                }
            ]
        }
    ]
}