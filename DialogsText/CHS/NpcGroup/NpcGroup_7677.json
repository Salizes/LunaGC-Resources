    "talks": [
        {
            "talkId": "6767701",
            "initDialog": "676770101",
            "dialogues": [
                {
                    "id": "676770101",
                    "speaker": "奥什卡里",
                    "text": "#啊！{NICKNAME}，是、是你们呀…"
                },
                {
                    "id": "676770102",
                    "speaker": "奥什卡里",
                    "text": "刚才我远远听到脚步声的时候，还担心是什么魔物呢…"
                },
                {
                    "id": "676770103",
                    "speaker": "雅努什",
                    "text": "嗯？没有魔物的地方，还用得着我们巡逻么？真是的，奥什卡里你怎么还是这么一惊一乍的…"
                },
                {
                    "id": "676770104",
                    "speaker": "雅努什",
                    "text": "之前我说过的吧，不管陷入怎样不利的境地，都不能暴露慌张的情绪。一旦被敌人抓住了弱点，那可就不好办了。"
                },
                {
                    "id": "676770105",
                    "speaker": "奥什卡里",
                    "text": "但…您也说过：「身处不利时，可以故意显露弱点让敌人放下警惕，从而给你留下反击的机会。」"
                },
                {
                    "id": "676770106",
                    "speaker": "雅努什",
                    "text": "…突然伤口又有点痛了。"
                },
                {
                    "id": "676770107",
                    "speaker": "奥什卡里",
                    "text": "欸？！师父的伤口之前不是已经好转了吗…怎、怎么又…"
                },
                {
                    "id": "676770108",
                    "speaker": "雅努什",
                    "text": "开玩笑啦。"
                },
                {
                    "id": "676770109",
                    "speaker": "奥什卡里",
                    "text": "好吧…有点笑不出来。"
                }
            ]
        }
    ]
}