            "dialogues": [
                {
                    "id": "621190101",
                    "speaker": "小羽",
                    "text": "客官，你、你好！…那个，我爸爸现在不在…"
                },
                {
                    "id": "621190102",
                    "speaker": "小羽",
                    "text": "想歇歇脚的话还请随意…"
                }
            ]
        },
        {
            "talkId": "6211902",
            "initDialog": "621190201",
            "dialogues": [
                {
                    "id": "621190201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "621190202",
                    "speaker": "小羽",
                    "text": "我、我在替我爸爸看茶摊，他生病了…"
                },
                {
                    "id": "621190203",
                    "speaker": "小羽",
                    "text": "…虽然有点想和蒙蒙一起去玩，不过我已经是大人了，所以要代替爸爸看着这里。"
                },
                {
                    "id": "621190204",
                    "speaker": "小羽",
                    "text": "没办法，身为大人应该要有责任心的…"
                }
            ]
        },
        {
            "talkId": "6211903",
            "initDialog": "621190301",
            "dialogues": [
                {
                    "id": "621190301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621190302",
                    "speaker": "小羽",
                    "text": "啊，客、客官慢走，下次再来！"
                }
            ]
        }
