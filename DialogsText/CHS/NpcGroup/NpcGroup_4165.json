{
    "groupId": "4165",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "贝海姆": 15
    },
    "talks": [
        {
            "talkId": "6416501",
            "initDialog": "641650101",
            "dialogues": [
                {
                    "id": "641650101",
                    "speaker": "贝海姆",
                    "text": "风神保佑，让我能永远记住那些往事…"
                }
            ]
        },
        {
            "talkId": "6416502",
            "initDialog": "641650201",
            "dialogues": [
                {
                    "id": "641650201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641650202",
                    "speaker": "贝海姆",
                    "text": "我是…唉，我也说不好自己究竟是谁咯，只是一把被留在风中的老骨头罢了。"
                },
                {
                    "id": "641650203",
                    "speaker": "贝海姆",
                    "text": "年少时，我在风吹起的地方遇到了一位来自须弥的少女。"
                },
                {
                    "id": "641650204",
                    "speaker": "贝海姆",
                    "text": "谁能想到，这位如春花般美妙的女孩，竟是一队商船的船长呢！"
                },
                {
                    "id": "641650205",
                    "speaker": "贝海姆",
                    "text": "我被她迷住了，便跟着她来到了草木的故乡，度过了一段比最浪漫的诗歌还要令人愉快的日子。"
                },
                {
                    "id": "641650206",
                    "speaker": "贝海姆",
                    "text": "如今她的花瓣已经化作春泥…而我还留在这里。"
                }
            ]
        },
        {
            "talkId": "6416503",
            "initDialog": "641650301",
            "dialogues": [
                {
                    "id": "641650301",
                    "speaker": "Player",
                    "text": "那些往事？"
                },
                {
                    "id": "641650302",
                    "speaker": "贝海姆",
                    "text": "对咯，就是那些过去的事情…"
                },
                {
                    "id": "641650303",
                    "speaker": "贝海姆",
                    "text": "我已经老了，记忆就像沙丘上的画一样，很快被风抹平。"
                },
                {
                    "id": "641650304",
                    "speaker": "贝海姆",
                    "text": "但巴巴托斯大人保佑，我和她的故事还流淌在风中。"
                },
                {
                    "id": "641650305",
                    "speaker": "贝海姆",
                    "text": "如今那些我还记得的往事，就像是逗留的风，虽然仍旧灵动，但不知何时便会突然消散。"
                },
                {
                    "id": "641650306",
                    "speaker": "贝海姆",
                    "text": "哈哈，我应该去找附近的木匠打一块牌子，就写上「风逗留之地」，立在我家门口，你说如何？"
                },
                {
                    "id": "641650307",
                    "speaker": "贝海姆",
                    "text": "那样的话，就算有一天我真的老糊涂了，也至少不会忘记家的位置。"
                }
            ]
        },
        {
            "talkId": "6416504",
            "initDialog": "641650401",
            "dialogues": [
                {
                    "id": "641650401",
                    "speaker": "Player",
                    "text": "保重。"
                },
                {
                    "id": "641650402",
                    "speaker": "贝海姆",
                    "text": "你也一样，孩子。"
                }
            ]
        },
        {
            "talkId": "7391501",
            "initDialog": "739150101",
            "dialogues": [
                {
                    "id": "739150101",
                    "speaker": "Player",
                    "text": "风神会保佑你的。"
                },
                {
                    "id": "739150102",
                    "speaker": "贝海姆",
                    "text": "对，对，你说得对…"
                },
                {
                    "id": "739150103",
                    "speaker": "贝海姆",
                    "text": "巴巴托斯大人是那样的喜爱诗歌，所以一定会让风记住我写给她的那些诗吧…"
                }
            ]
        }
    ]
}