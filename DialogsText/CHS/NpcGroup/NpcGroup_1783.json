{
    "groupId": "1783",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 7,
        "菲乐丝": 23
    },
    "talks": [
        {
            "talkId": "6178301",
            "initDialog": "617830101",
            "dialogues": [
                {
                    "id": "617830101",
                    "speaker": "菲乐丝",
                    "text": "北大陆的美味就在这里，来尝尝吧？"
                }
            ]
        },
        {
            "talkId": "6178302",
            "initDialog": "617830201",
            "dialogues": [
                {
                    "id": "617830201",
                    "speaker": "菲乐丝",
                    "text": "哎呀，那个香氛…呵呵，让我想起了一位老朋友呢。来，别站那么远，坐下喝杯热茶吧。"
                }
            ]
        },
        {
            "talkId": "6178303",
            "initDialog": "617830301",
            "dialogues": [
                {
                    "id": "617830301",
                    "speaker": "Player",
                    "text": "有什么推荐菜吗？"
                },
                {
                    "id": "617830302",
                    "speaker": "菲乐丝",
                    "text": "呵呵，菜单就在这里了，请看。"
                }
            ]
        },
        {
            "talkId": "6178304",
            "initDialog": "617830401",
            "dialogues": [
                {
                    "id": "617830401",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "617830402",
                    "speaker": "菲乐丝",
                    "text": "只是个普通的餐馆老板而已，没什么特别的。"
                },
                {
                    "id": "617830403",
                    "speaker": "菲乐丝",
                    "text": "比起那个，要不要来尝尝看我们厨师的手艺？既然到了荆夫港，还是应该体验一下这里的特色菜呢。"
                }
            ]
        },
        {
            "talkId": "6178305",
            "initDialog": "617830501",
            "dialogues": [
                {
                    "id": "617830501",
                    "speaker": "Player",
                    "text": "老朋友？"
                },
                {
                    "id": "617830502",
                    "speaker": "菲乐丝",
                    "text": "呵呵…应该也能算是朋友吧。"
                },
                {
                    "id": "617830503",
                    "speaker": "菲乐丝",
                    "text": "很久以前的事了。那时我还年轻，在挪德卡莱做些…不那么光彩的生意，姑且算是一群走投无路的可怜人们的头儿吧。"
                },
                {
                    "id": "617830504",
                    "speaker": "菲乐丝",
                    "text": "快快活活过了几年，结果遇上了一个名叫卡嘉的宝藏猎人。"
                },
                {
                    "id": "617830505",
                    "speaker": "菲乐丝",
                    "text": "那姑娘和我差不多大，只凭着一腔热血，说是要制止我的恶行…前前后后揍了我七八回，却一直没有要我的命。"
                },
                {
                    "id": "617830506",
                    "speaker": "菲乐丝",
                    "text": "她和我说，那样游走法外的日子终究还是长不了的。再这样下去，早晚会有其他人要取我性命…不是她，总有别人。"
                },
                {
                    "id": "617830507",
                    "speaker": "菲乐丝",
                    "text": "她说得对。所以…我就把钱财全都分给了海螺帮的小鬼，出海冒险去了。"
                },
                {
                    "id": "617830508",
                    "speaker": "菲乐丝",
                    "text": "后面的事就没什么意思了。也不知道那女人是不是还活着…"
                },
                {
                    "id": "617830509",
                    "speaker": "菲乐丝",
                    "text": "呵，你这香水倒是让我想起她来了。"
                }
            ]
        },
        {
            "talkId": "6178306",
            "initDialog": "617830601",
            "dialogues": [
                {
                    "id": "617830601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617830602",
                    "speaker": "菲乐丝",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6178307",
            "initDialog": "617830701",
            "dialogues": [
                {
                    "id": "617830701",
                    "speaker": "菲乐丝",
                    "text": "「奶油鲑鱼汤」…是什么味道呢…"
                },
                {
                    "id": "617830702",
                    "speaker": "Player",
                    "text": "「奶油鲑鱼汤」？"
                },
                {
                    "id": "617830703",
                    "speaker": "菲乐丝",
                    "text": "是旅行者吗？虽然有些冒昧，请问你会做挪德卡莱风味的菜式吗？"
                }
            ]
        },
        {
            "talkId": "6178308",
            "initDialog": "617830801",
            "dialogues": [
                {
                    "id": "617830801",
                    "speaker": "Player",
                    "text": "会。"
                },
                {
                    "id": "617830802",
                    "speaker": "菲乐丝",
                    "text": "那能劳烦你帮忙做一道「奶油鲑鱼汤」吗？今天来的客人点名要这道菜，说是想回味一下「过去」。"
                },
                {
                    "id": "617830803",
                    "speaker": "菲乐丝",
                    "text": "但我…都快要忘记「过去」的味道了。能否请你帮个忙呢，报酬绝对让你满意。"
                }
            ]
        },
        {
            "talkId": "6178309",
            "initDialog": "617830901",
            "dialogues": [
                {
                    "id": "617830901",
                    "speaker": "Player",
                    "text": "不会。"
                },
                {
                    "id": "617830902",
                    "speaker": "菲乐丝",
                    "text": "这样啊，那我自己再想想办法吧…"
                }
            ]
        },
        {
            "talkId": "7083401",
            "initDialog": "708340101",
            "dialogues": [
                {
                    "id": "708340101",
                    "speaker": "菲乐丝",
                    "text": "拜托你了，旅行者。你准备好「奶油鲑鱼汤」了吗？"
                }
            ]
        },
        {
            "talkId": "7083402",
            "initDialog": "708340201",
            "dialogues": [
                {
                    "id": "708340201",
                    "speaker": "菲乐丝",
                    "text": "拜托你了，旅行者。你准备好「奶油鲑鱼汤」了吗？"
                }
            ]
        },
        {
            "talkId": "7083403",
            "initDialog": "708340301",
            "dialogues": [
                {
                    "id": "708340301",
                    "speaker": "菲乐丝",
                    "text": "这个香味，这个色泽…真是让人怀念。我这就去给那位客人送过去。"
                },
                {
                    "id": "708340302",
                    "speaker": "菲乐丝",
                    "text": "有了这回的印象，下一次应该不用再麻烦你了。多谢呢，旅行者。"
                }
            ]
        }
    ]
}