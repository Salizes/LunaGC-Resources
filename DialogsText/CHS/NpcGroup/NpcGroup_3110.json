{
    "groupId": "3110",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "陆": 11
    },
    "talks": [
        {
            "talkId": "6311001",
            "initDialog": "631100101",
            "dialogues": [
                {
                    "id": "631100101",
                    "speaker": "陆",
                    "text": "呀，是外国人！你好！"
                }
            ]
        },
        {
            "talkId": "6311002",
            "initDialog": "631100201",
            "dialogues": [
                {
                    "id": "631100201",
                    "speaker": "Player",
                    "text": "要一起玩吗？"
                },
                {
                    "id": "631100202",
                    "speaker": "陆",
                    "text": "好耶！我想玩捉迷藏！"
                },
                {
                    "id": "631100203",
                    "speaker": "陆",
                    "text": "…啊，可是姐姐她还在神社工作，我答应过她不能乱跑，要在这边等她一起回家…"
                },
                {
                    "id": "631100204",
                    "speaker": "陆",
                    "text": "如果姐姐找不到我的话，会担心的吧…"
                },
                {
                    "id": "631100205",
                    "speaker": "陆",
                    "text": "谢谢你，我还是一个人玩吧。"
                }
            ]
        },
        {
            "talkId": "6311003",
            "initDialog": "631100301",
            "dialogues": [
                {
                    "id": "631100301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "631100302",
                    "speaker": "陆",
                    "text": "我在数来神社求签的人呢！"
                },
                {
                    "id": "631100303",
                    "speaker": "陆",
                    "text": "有个个子小小的、穿着狸猫衣服的女孩子求签，许愿想要长高什么的…"
                },
                {
                    "id": "631100304",
                    "speaker": "陆",
                    "text": "还有个长得很漂亮的大姐姐说希望稻妻能安稳什么的…"
                },
                {
                    "id": "631100305",
                    "speaker": "陆",
                    "text": "哦，还有个大哥哥，说希望九条家能繁荣昌盛…"
                },
                {
                    "id": "631100306",
                    "speaker": "陆",
                    "text": "大家的愿望都好特别呀，我的愿望是能和姐姐玩捉迷藏就好了…"
                }
            ]
        },
        {
            "talkId": "6311004",
            "initDialog": "631100401",
            "dialogues": [
                {
                    "id": "631100401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631100402",
                    "speaker": "陆",
                    "text": "嗯，再见！"
                }
            ]
        }
    ]
}