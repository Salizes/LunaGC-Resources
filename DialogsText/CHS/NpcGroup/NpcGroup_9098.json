{
    "groupId": "9098",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 17,
        "克洛琳德": 52
    },
    "talks": [
        {
            "talkId": "6909801",
            "initDialog": "690980101",
            "dialogues": [
                {
                    "id": "690980101",
                    "speaker": "克洛琳德",
                    "text": "你回来了。我想问问你，有没有专供训练的场所？"
                },
                {
                    "id": "690980102",
                    "speaker": "克洛琳德",
                    "text": "我担心在这里练习打靶会吵到别人。"
                }
            ]
        },
        {
            "talkId": "6909802",
            "initDialog": "690980201",
            "dialogues": [
                {
                    "id": "690980201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690980202",
                    "speaker": "克洛琳德",
                    "text": "放心，我对环境并不挑剔。"
                },
                {
                    "id": "690980203",
                    "speaker": "克洛琳德",
                    "text": "拥挤，空旷，吵闹，安静…这些对我来说无关紧要，我向来不受外在因素的影响。"
                },
                {
                    "id": "690980204",
                    "speaker": "克洛琳德",
                    "text": "至于生存方面的隐患…我暂时还没有发现。这点不错。",
                    "choices": [
                        {
                            "id": "690980205",
                            "text": "谢谢？",
                            "response": [
                                {
                                    "id": "690980206",
                                    "speaker": "克洛琳德",
                                    "text": "别客气，这是你的功劳，应当道谢的反倒是我。"
                                },
                                {
                                    "id": "690980211",
                                    "speaker": "克洛琳德",
                                    "text": "总之，感谢你的邀请。"
                                },
                                {
                                    "id": "690980212",
                                    "speaker": "克洛琳德",
                                    "text": "我还会再多待一段时间，希望并不构成对你的打扰。"
                                }
                            ]
                        },
                        {
                            "id": "690980207",
                            "text": "毕竟是壶中洞天嘛。",
                            "response": [
                                {
                                    "id": "690980208",
                                    "speaker": "克洛琳德",
                                    "text": "我钦佩它的原理与设计，令人大开眼界。"
                                }
                            ]
                        },
                        {
                            "id": "690980209",
                            "text": "…我该笑吗？",
                            "response": [
                                {
                                    "id": "690980210",
                                    "speaker": "克洛琳德",
                                    "text": "因人而异，看你心情。我不了解你的笑点高低，不适合为你做出推荐。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909803",
            "initDialog": "690980301",
            "dialogues": [
                {
                    "id": "690980301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690980302",
                    "speaker": "克洛琳德",
                    "text": "当然。你有什么感兴趣的话题吗？",
                    "choices": [
                        {
                            "id": "690980303",
                            "text": "成为最强决斗代理人之前的故事！",
                            "response": [
                                {
                                    "id": "690980304",
                                    "speaker": "克洛琳德",
                                    "text": "在我认识娜维娅之前…"
                                },
                                {
                                    "id": "690980305",
                                    "speaker": "Player",
                                    "text": "那么早吗？！"
                                },
                                {
                                    "id": "690980306",
                                    "speaker": "克洛琳德",
                                    "text": "既然你想听的，是与如今我的生活截然不同的故事，我认为那会是一个很好的节点。"
                                },
                                {
                                    "id": "690980307",
                                    "speaker": "克洛琳德",
                                    "text": "那时，我和师父朝夕相处。她是一位强大而又严格的人，对我的童年造成了许多影响。"
                                },
                                {
                                    "id": "690980308",
                                    "speaker": "克洛琳德",
                                    "text": "我曾害怕夜行的魔物，因为不知它们会从哪个地方发起攻势。"
                                },
                                {
                                    "id": "690980309",
                                    "speaker": "克洛琳德",
                                    "text": "她用布蒙上了我的双眼，把我推到林间，说「这里全是魔物」，要我在白天也靠听觉与直觉做出反应。"
                                },
                                {
                                    "id": "690980310",
                                    "speaker": "克洛琳德",
                                    "text": "我曾惧怕孤独，在她离开我身边后便难以入睡。"
                                },
                                {
                                    "id": "690980311",
                                    "speaker": "克洛琳德",
                                    "text": "后来很长一段时间，她都要我每天练习到再也抬不动手之后才放我去休息。"
                                },
                                {
                                    "id": "690980312",
                                    "speaker": "克洛琳德",
                                    "text": "每天早上睁眼看到师父的脸，反倒成为了新的噩梦…"
                                },
                                {
                                    "id": "690980313",
                                    "speaker": "克洛琳德",
                                    "text": "不知不觉，我也成为了一个如她一般坚强的人。"
                                },
                                {
                                    "id": "690980314",
                                    "speaker": "克洛琳德",
                                    "text": "而可怕的是，如果现在要我收一名徒弟，我想不出比她当年更好的教育方法。"
                                }
                            ]
                        },
                        {
                            "id": "690980315",
                            "text": "决斗代理人工作中的趣闻！",
                            "response": [
                                {
                                    "id": "690980316",
                                    "speaker": "克洛琳德",
                                    "text": "工作…嗯…"
                                },
                                {
                                    "id": "690980317",
                                    "speaker": "克洛琳德",
                                    "text": "即使你把「工作」和「趣闻」两个词组放进同一个杯子里，它们也会分层。"
                                },
                                {
                                    "id": "690980318",
                                    "speaker": "克洛琳德",
                                    "text": "我听说，不少同事曾在下班途中被隔天的决斗对象拽住，拖进咖啡馆里，听对方痛诉衷肠。"
                                },
                                {
                                    "id": "690980319",
                                    "speaker": "克洛琳德",
                                    "text": "很浪费时间的行为，不是吗？我很高兴我从没遇上过。"
                                },
                                {
                                    "id": "690980320",
                                    "speaker": "克洛琳德",
                                    "text": "但我不建议你继续打听下去。"
                                },
                                {
                                    "id": "690980321",
                                    "speaker": "克洛琳德",
                                    "text": "我们这一行很容易见到过剩的故事性与戏剧感，但它们多半虚伪且肮脏…你会失望的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909804",
            "initDialog": "690980401",
            "dialogues": [
                {
                    "id": "690980401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690980402",
                    "speaker": "克洛琳德",
                    "text": "嗯…要来玩有关「决斗」的游戏吗？"
                },
                {
                    "id": "690980403",
                    "speaker": "Player",
                    "text": "我先问问怎么玩…"
                },
                {
                    "id": "690980404",
                    "speaker": "克洛琳德",
                    "text": "很简单，用「命运示数牌」来决定决斗的规则和使用的武器。我以前和师父常玩，不过那时用的是骰子。",
                    "choices": [
                        {
                            "id": "690980405",
                            "text": "如果骰到了「大失败」…",
                            "response": [
                                {
                                    "id": "690980406",
                                    "speaker": "克洛琳德",
                                    "text": "那么很抱歉，你必须绑住自己的双手双脚来和我决斗。"
                                },
                                {
                                    "id": "690980407",
                                    "speaker": "Player",
                                    "text": "我以为「决斗」要讲求公平…"
                                },
                                {
                                    "id": "690980408",
                                    "speaker": "克洛琳德",
                                    "text": "的确。但那是审判庭上用来自证名誉的决斗。这个游戏是用来锻炼逐影猎人野外生存能力的。"
                                },
                                {
                                    "id": "690980409",
                                    "speaker": "克洛琳德",
                                    "text": "有时候，你就算是断了腿，又折了胳膊，依然需要同魔物战斗。"
                                },
                                {
                                    "id": "690980410",
                                    "speaker": "克洛琳德",
                                    "text": "「永远不能停止思考如何胜利」——这是师父教给我的。"
                                },
                                {
                                    "id": "690980411",
                                    "speaker": "克洛琳德",
                                    "text": "她也有次运气非常不好，武器还只骰到了一根小树枝，结果我还是输了。"
                                },
                                {
                                    "id": "690980420",
                                    "speaker": "克洛琳德",
                                    "text": "不论如何，这都是一个充满随机性的游戏，尝试一下自己极限也未尝不可。输了马上重来就行。"
                                },
                                {
                                    "id": "690980421",
                                    "speaker": "克洛琳德",
                                    "text": "怎么样？你准备好了吗？"
                                },
                                {
                                    "id": "690980422",
                                    "speaker": "Player",
                                    "text": "来…来就来！"
                                },
                                {
                                    "id": "690980423",
                                    "speaker": "克洛琳德",
                                    "text": "嗯，你的眼神比你自认为的更加坚定。我欣赏。"
                                },
                                {
                                    "id": "690980424",
                                    "speaker": "克洛琳德",
                                    "text": "那就开始吧，输了的请吃饭。"
                                }
                            ]
                        },
                        {
                            "id": "690980412",
                            "text": "如果骰到了「大成功」…",
                            "response": [
                                {
                                    "id": "690980413",
                                    "speaker": "克洛琳德",
                                    "text": "那么恭喜你，你可以选择自己最顺手的武器，外加一次无视致命攻击的机会。我要击中你两次才能赢。"
                                },
                                {
                                    "id": "690980414",
                                    "speaker": "Player",
                                    "text": "我以为「决斗」要讲求公平…"
                                },
                                {
                                    "id": "690980415",
                                    "speaker": "克洛琳德",
                                    "text": "的确。但那是审判庭上用来自证名誉的决斗。这个游戏是用来锻炼逐影猎人野外生存能力的。"
                                },
                                {
                                    "id": "690980416",
                                    "speaker": "克洛琳德",
                                    "text": "但有时就算运气再好，准备得再充分，优秀的逐影猎人也还是会因麻痹大意而败在魔物手下。"
                                },
                                {
                                    "id": "690980417",
                                    "speaker": "克洛琳德",
                                    "text": "「大成功」，反倒有可能成为「大失败」的伏笔。"
                                },
                                {
                                    "id": "690980418",
                                    "speaker": "克洛琳德",
                                    "text": "我运气不算差，在游戏中经常骰出好点数，却常常在自以为获胜的时候被师父反杀。"
                                },
                                {
                                    "id": "690980419",
                                    "speaker": "克洛琳德",
                                    "text": "「猎物在自以为是的时候，才最容易捕获」——这是师父教给我的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909805",
            "initDialog": "690980501",
            "dialogues": [
                {
                    "id": "690980501",
                    "speaker": "Player",
                    "text": "早啊，克洛琳德。"
                },
                {
                    "id": "690980502",
                    "speaker": "克洛琳德",
                    "text": "早安，祝你今日一切顺利。"
                }
            ]
        },
        {
            "talkId": "6909806",
            "initDialog": "690980601",
            "dialogues": [
                {
                    "id": "690980601",
                    "speaker": "Player",
                    "text": "晚安，克洛琳德。"
                },
                {
                    "id": "690980602",
                    "speaker": "克洛琳德",
                    "text": "晚安，安心休息吧。这里足够安全，看样子不需要我来守夜。"
                }
            ]
        },
        {
            "talkId": "6909810",
            "initDialog": "690981001",
            "dialogues": [
                {
                    "id": "690981001",
                    "speaker": "克洛琳德",
                    "text": "这么一想，枢律庭确实设立过一个档案室，专门用于存储代理决斗的相关资料。"
                },
                {
                    "id": "690981002",
                    "speaker": "克洛琳德",
                    "text": "包括起因、判决、相关人员、负责决斗的决斗代理人，以及决斗结果。"
                },
                {
                    "id": "690981003",
                    "speaker": "克洛琳德",
                    "text": "我一次都没有去过。相信我的其他同事也不愿意去。就让负责那边工作的复律官们去忙碌吧，他们总是乐在其中。"
                }
            ]
        },
        {
            "talkId": "6909811",
            "initDialog": "690981101",
            "dialogues": [
                {
                    "id": "690981101",
                    "speaker": "克洛琳德",
                    "text": "我之前学习过一些与植物相关的知识…"
                },
                {
                    "id": "690981102",
                    "speaker": "克洛琳德",
                    "text": "包括辨别哪些植物的根部能吃，哪些植物的果实有毒…还有哪些植物能用来制作简易染色剂。"
                },
                {
                    "id": "690981103",
                    "speaker": "克洛琳德",
                    "text": "喔，这花坛里的植物基本无害，它们的作用是让人心情愉悦。安心观赏吧。"
                }
            ]
        }
    ]
}