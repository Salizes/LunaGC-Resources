{
    "groupId": "2525",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "婉静": 12
    },
    "talks": [
        {
            "talkId": "6252501",
            "initDialog": "625250101",
            "dialogues": [
                {
                    "id": "625250101",
                    "speaker": "婉静",
                    "text": "还没去完所有的景点，但旅费似乎已经不太够了啊…"
                }
            ]
        },
        {
            "talkId": "6252502",
            "initDialog": "625250201",
            "dialogues": [
                {
                    "id": "625250201",
                    "speaker": "Player",
                    "text": "景点？"
                },
                {
                    "id": "625250202",
                    "speaker": "婉静",
                    "text": "你也是游客吗？"
                },
                {
                    "id": "625250203",
                    "speaker": "婉静",
                    "text": "看你从容不迫的样子，应该是个专家，去过不少知名的景点？"
                },
                {
                    "id": "625250204",
                    "speaker": "婉静",
                    "text": "我就没什么见识了，一路走走停停，只是勉强看过了沉玉谷名气最大的几个地方…"
                },
                {
                    "id": "625250205",
                    "speaker": "婉静",
                    "text": "遗珑台就是我这趟旅途的最后一站了，听说在那个探出山外的香炉上香…异常灵验！"
                },
                {
                    "id": "625250206",
                    "speaker": "婉静",
                    "text": "不过我有些恐高，可能要请专人代劳了…会不会很贵呢？"
                }
            ]
        },
        {
            "talkId": "6252503",
            "initDialog": "625250301",
            "dialogues": [
                {
                    "id": "625250301",
                    "speaker": "Player",
                    "text": "这附近的旅费开销很高吗？"
                },
                {
                    "id": "625250302",
                    "speaker": "婉静",
                    "text": "不不不，不论翘英庄还是遗珑埠，食宿开销和路费都不高，买到的东西也物美价廉。"
                },
                {
                    "id": "625250303",
                    "speaker": "婉静",
                    "text": "只是我的旅费本来就有限，其中大部分还用来买了一个枫丹商人推荐的留影机。"
                },
                {
                    "id": "625250304",
                    "speaker": "婉静",
                    "text": "好在用留影机拍出来的画片都很漂亮，甚至能记录我看见美景时的心境，还是很值的！"
                },
                {
                    "id": "625250305",
                    "speaker": "婉静",
                    "text": "说不定十年二十年后，看见拍下的画片，我还能马上想起这几天的经历呢！"
                },
                {
                    "id": "625250306",
                    "speaker": "婉静",
                    "text": "待会儿，我还要在山顶的遗珑台拍几张照…"
                }
            ]
        },
        {
            "talkId": "6252504",
            "initDialog": "625250401",
            "dialogues": [
                {
                    "id": "625250401",
                    "speaker": "Player",
                    "text": "祝顺利！"
                },
                {
                    "id": "625250402",
                    "speaker": "婉静",
                    "text": "十分感谢！也祝你一路顺风！"
                }
            ]
        }
    ]
}