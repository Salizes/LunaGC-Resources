    "talks": [
        {
            "talkId": "6176301",
            "initDialog": "617630101",
            "dialogues": [
                {
                    "id": "617630101",
                    "speaker": "哥林",
                    "text": "菲洛梅娜修女，我…我下周就要出海航行了，马萨欧斯先生雇我们前往至冬做酒品贸易…"
                },
                {
                    "id": "617630102",
                    "speaker": "哥林",
                    "text": "可是我实在是害怕，您看，我也没当过水手，这还是我第一次出海，万一…"
                },
                {
                    "id": "617630103",
                    "speaker": "菲洛梅娜",
                    "text": "嗯，没关系的。您看，就算您不是第一次出海，海上也很不安全呀。"
                },
                {
                    "id": "617630104",
                    "speaker": "菲洛梅娜",
                    "text": "要是您真的出海，我就为您向风神大人祷告吧。请安心，我也曾经为不少水手祷告过…"
                },
                {
                    "id": "617630105",
                    "speaker": "哥林",
                    "text": "哦哦，谢谢您！所以那些水手们都平安返航了，对吧，菲洛梅娜修女！"
                },
                {
                    "id": "617630106",
                    "speaker": "菲洛梅娜",
                    "text": "……"
                },
                {
                    "id": "617630107",
                    "speaker": "哥林",
                    "text": "对…对吧？"
                }
            ]
        }
    ]
}