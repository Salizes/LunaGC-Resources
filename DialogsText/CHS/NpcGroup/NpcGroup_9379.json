{
    "groupId": "9379",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "希格雯": 9
    },
    "talks": [
        {
            "talkId": "6937901",
            "initDialog": "693790101",
            "dialogues": [
                {
                    "id": "693790101",
                    "speaker": "希格雯",
                    "text": "似乎没有专门的医务室呢。那就先原地休息一会吧。来，放松…"
                },
                {
                    "id": "693790102",
                    "speaker": "希格雯",
                    "text": "没有严重的皮外伤，太好了，你在好好保护自己，请继续保持下去哦。"
                },
                {
                    "id": "693790103",
                    "speaker": "希格雯",
                    "text": "这样一来只需要进行简单的能量补充就行，营养奶昔我准备好了，给~"
                }
            ]
        },
        {
            "talkId": "6937902",
            "initDialog": "693790201",
            "dialogues": [
                {
                    "id": "693790201",
                    "speaker": "希格雯",
                    "text": "这个秘境的观赏性一点都不比拳力斗技场逊色。你投入战斗时的模样非常英勇哦，表扬表扬。"
                },
                {
                    "id": "693790202",
                    "speaker": "希格雯",
                    "text": "可以让我跟你同行吗？"
                },
                {
                    "id": "693790203",
                    "speaker": "希格雯",
                    "text": "我不是质疑你在战斗方面的实力，但里面的危险有点超乎我的想象了。"
                }
            ]
        },
        {
            "talkId": "6937903",
            "initDialog": "693790301",
            "dialogues": [
                {
                    "id": "693790301",
                    "speaker": "希格雯",
                    "text": "刚才在一本童话书里读到一句话，「友情，需要牺牲。只有牺牲，才能成就友情」。"
                },
                {
                    "id": "693790302",
                    "speaker": "希格雯",
                    "text": "我同意，这个道理适用于很多事情。"
                },
                {
                    "id": "693790303",
                    "speaker": "希格雯",
                    "text": "在临床上也是一样呢。只有牺牲某些东西，才能获得健康。"
                }
            ]
        }
    ]
}