    "talks": [
        {
            "talkId": "6752301",
            "initDialog": "675230101",
            "dialogues": [
                {
                    "id": "675230101",
                    "speaker": "扎维亚洛夫",
                    "text": "「影域」果然和前会长说的一样…"
                }
            ]
        },
        {
            "talkId": "6752302",
            "initDialog": "675230201",
            "dialogues": [
                {
                    "id": "675230201",
                    "speaker": "Player",
                    "text": "影域…？"
                },
                {
                    "id": "675230202",
                    "speaker": "扎维亚洛夫",
                    "text": "嗯…啊，我是说，影域果然和前会长说的一样危险。"
                },
                {
                    "id": "675230203",
                    "speaker": "扎维亚洛夫",
                    "text": "众所周知，因为克什尼克之炬遍布至冬…能源协会的人为了维护它们必须到处跑，所以偶尔就会遇上影域…"
                },
                {
                    "id": "675230204",
                    "speaker": "扎维亚洛夫",
                    "text": "那时候就得小心从中脱身，然后报告给冬契军了。"
                }
            ]
        },
        {
            "talkId": "6752303",
            "initDialog": "675230301",
            "dialogues": [
                {
                    "id": "675230301",
                    "speaker": "Player",
                    "text": "关于前会长…"
                },
                {
                    "id": "675230302",
                    "speaker": "扎维亚洛夫",
                    "text": "前会长的离世令人惋惜，在我看来，他可是个非常有趣的矮灵老头…"
                },
                {
                    "id": "675230303",
                    "speaker": "扎维亚洛夫",
                    "text": "世上的人虽然多，但是年长还仍然有趣的却比较少。"
                }
            ]
        },
        {
            "talkId": "6752304",
            "initDialog": "675230401",
            "dialogues": [
                {
                    "id": "675230401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675230402",
                    "speaker": "扎维亚洛夫",
                    "text": "嗯…哦，好的，再见。"
                }
            ]
        }
    ]
}