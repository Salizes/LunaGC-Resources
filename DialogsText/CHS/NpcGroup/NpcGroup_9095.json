{
    "groupId": "9095",
    "total_dialogue_lines": 86,
    "speaker_counts": {
        "Player": 19,
        "希格雯": 67
    },
    "talks": [
        {
            "talkId": "6909501",
            "initDialog": "690950101",
            "dialogues": [
                {
                    "id": "690950101",
                    "speaker": "希格雯",
                    "text": "咦？你回来啦，先别动噢…手脚没问题，精神也还好…"
                },
                {
                    "id": "690950102",
                    "speaker": "希格雯",
                    "text": "嗯嗯…平安归来已经很了不起了哦。"
                }
            ]
        },
        {
            "talkId": "6909502",
            "initDialog": "690950201",
            "dialogues": [
                {
                    "id": "690950201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690950202",
                    "speaker": "希格雯",
                    "text": "跟水下很不一样，明亮开阔，布局也很有你的个人特色，我觉得既新奇又舒适。"
                },
                {
                    "id": "690950203",
                    "speaker": "希格雯",
                    "text": "我观察了一阵子，这里似乎没有生产区，大家也不用忙着赚特许券，身体和精神都很放松。"
                },
                {
                    "id": "690950204",
                    "speaker": "希格雯",
                    "text": "营养餐看来是派不上用场了呢。唔…只好用别的方式来守护大家的健康了。",
                    "choices": [
                        {
                            "id": "690950205",
                            "text": "在这就别顾着工作啦。",
                            "response": [
                                {
                                    "id": "690950206",
                                    "speaker": "希格雯",
                                    "text": "呵呵，没关系哦。我不觉得这是工作，应该说是爱好还是追求好呢？都有吧。"
                                },
                                {
                                    "id": "690950207",
                                    "speaker": "希格雯",
                                    "text": "数数时间…啊，我也已经记不清多少年了…但工作的每一天我都乐在其中。"
                                },
                                {
                                    "id": "690950208",
                                    "speaker": "希格雯",
                                    "text": "当然，医务室空空的时候，我会更高兴，说明大家都健健康康的，真好。"
                                },
                                {
                                    "id": "690950212",
                                    "speaker": "希格雯",
                                    "text": "啊呀，说起这事，差点忘了随身药箱里的药剂消耗得差不多了。"
                                },
                                {
                                    "id": "690950213",
                                    "speaker": "希格雯",
                                    "text": "你下次出门时能帮我采买一些原料回来吗？清单在这里。"
                                },
                                {
                                    "id": "690950214",
                                    "speaker": "希格雯",
                                    "text": "哦，摩拉先给你，要是超出预算了请跟我讲，我会尽快补给你哦。"
                                },
                                {
                                    "id": "690950215",
                                    "speaker": "Player",
                                    "text": "我们之间不用谈摩拉。"
                                },
                                {
                                    "id": "690950216",
                                    "speaker": "希格雯",
                                    "text": "原来如此…我明白了，那我们就用特许券结算吧。"
                                }
                            ]
                        },
                        {
                            "id": "690950209",
                            "text": "别、别的方式？",
                            "response": [
                                {
                                    "id": "690950210",
                                    "speaker": "希格雯",
                                    "text": "对哦，至于是什么方法你就不用太操心啦，这是护士长的职责。"
                                },
                                {
                                    "id": "690950211",
                                    "speaker": "希格雯",
                                    "text": "我会默默行动，不会给任何人添麻烦的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909503",
            "initDialog": "690950301",
            "dialogues": [
                {
                    "id": "690950301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690950302",
                    "speaker": "希格雯",
                    "text": "好哦，我喜欢跟人聊天。"
                },
                {
                    "id": "690950303",
                    "speaker": "希格雯",
                    "text": "通常来说，配合美露莘特殊的感知力，我能大概知道病人身上有哪里不舒服。"
                },
                {
                    "id": "690950304",
                    "speaker": "希格雯",
                    "text": "但想要知道造成病征的原因，靠简单的三两句问诊是远远不够的。"
                },
                {
                    "id": "690950305",
                    "speaker": "希格雯",
                    "text": "聊一聊对方的兴趣爱好、生活习惯甚至心情想法…都很有助于对症下药。",
                    "choices": [
                        {
                            "id": "690950306",
                            "text": "尽责的护士长！",
                            "response": [
                                {
                                    "id": "690950307",
                                    "speaker": "希格雯",
                                    "text": "是吗？我很高兴听到你这么说。"
                                },
                                {
                                    "id": "690950308",
                                    "speaker": "希格雯",
                                    "text": "梅洛彼得堡的大家也会像你这样夸我呢，你们真是太可爱了。"
                                },
                                {
                                    "id": "690950309",
                                    "speaker": "希格雯",
                                    "text": "人类的信任对我来说至关重要。有了信任，病人才会将自己的身体放心交由我来护理。"
                                },
                                {
                                    "id": "690950314",
                                    "speaker": "Player",
                                    "text": "会有人不配合吗？"
                                },
                                {
                                    "id": "690950315",
                                    "speaker": "希格雯",
                                    "text": "有过哦。毕竟…每个人都有自己的小秘密嘛，不想坦白也很正常。"
                                },
                                {
                                    "id": "690950316",
                                    "speaker": "希格雯",
                                    "text": "就在不久前，有位病人经常会意外弄伤手指，每次来医务室，都嚷嚷着只要些绷带和止痛药就行。"
                                },
                                {
                                    "id": "690950317",
                                    "speaker": "希格雯",
                                    "text": "可我一眼就能看出来，他有所隐瞒哟。"
                                },
                                {
                                    "id": "690950318",
                                    "speaker": "希格雯",
                                    "text": "手指的伤不算什么，精神极度疲劳和涣散才是最糟糕的问题，他呀，已经快到临界值了。"
                                },
                                {
                                    "id": "690950319",
                                    "speaker": "Player",
                                    "text": "那怎么办才好…"
                                },
                                {
                                    "id": "690950320",
                                    "speaker": "希格雯",
                                    "text": "很难办呢，只有他自己把实情告诉我，我才能想办法帮助他。"
                                },
                                {
                                    "id": "690950321",
                                    "speaker": "希格雯",
                                    "text": "「哎呀，这手…唉，恐怕没几天…」"
                                },
                                {
                                    "id": "690950322",
                                    "speaker": "希格雯",
                                    "text": "也许他当时被我这番话吓到了，等其他病人都离开后，立刻哭着告诉了我真相。"
                                },
                                {
                                    "id": "690950323",
                                    "speaker": "Player",
                                    "text": "你似乎在吓唬他…"
                                },
                                {
                                    "id": "690950324",
                                    "speaker": "希格雯",
                                    "text": "没有哦。我想说的是「这手恐怕没几天就要痊愈了」。只是还没说完而已。"
                                },
                                {
                                    "id": "690950325",
                                    "speaker": "希格雯",
                                    "text": "原来跟他住一个监舍的兄弟刑满出狱了，他一个人很怕黑，晚上睡不着，白天拖着疲惫的身体工作才频繁出意外。"
                                },
                                {
                                    "id": "690950326",
                                    "speaker": "希格雯",
                                    "text": "他担心别人笑话他长得这么高大还怕黑，所以没好意思告诉任何人。"
                                },
                                {
                                    "id": "690950327",
                                    "speaker": "希格雯",
                                    "text": "不过没关系，我陪他在莫莱妮小姐那里填好了调换监舍的申请表，问题已经从根本上解决啦。"
                                },
                                {
                                    "id": "690950328",
                                    "speaker": "希格雯",
                                    "text": "唔…原来对于某些人而言，「面子」甚至比「健康」还重要…我学到了很多。"
                                },
                                {
                                    "id": "690950329",
                                    "speaker": "Player",
                                    "text": "确实如此…"
                                },
                                {
                                    "id": "690950330",
                                    "speaker": "希格雯",
                                    "text": "那你呢？你也会有什么难以启齿的秘密吗？"
                                },
                                {
                                    "id": "690950331",
                                    "speaker": "希格雯",
                                    "text": "为了排除今后的健康隐患，可以考虑告诉我哦，我随时都在。"
                                }
                            ]
                        },
                        {
                            "id": "690950310",
                            "text": "大家都愿意跟你聊吧。",
                            "response": [
                                {
                                    "id": "690950311",
                                    "speaker": "希格雯",
                                    "text": "我听说有很多人从小就害怕医生和护士，也很排斥消毒水和药剂的味道。"
                                },
                                {
                                    "id": "690950312",
                                    "speaker": "希格雯",
                                    "text": "所幸在梅洛彼得堡，大家还是比较乐意来医务室找我的。"
                                },
                                {
                                    "id": "690950313",
                                    "speaker": "希格雯",
                                    "text": "大多数病人都会乖乖地听我的话，回答我的问题。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909504",
            "initDialog": "690950401",
            "dialogues": [
                {
                    "id": "690950401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690950402",
                    "speaker": "希格雯",
                    "text": "看来你也正好闲下来了呢。"
                },
                {
                    "id": "690950403",
                    "speaker": "希格雯",
                    "text": "想试试我新调制的护肤品吗？这次是一种面部软膏。",
                    "choices": [
                        {
                            "id": "690950404",
                            "text": "能返老还童吗？",
                            "response": [
                                {
                                    "id": "690950405",
                                    "speaker": "希格雯",
                                    "text": "据我所知，暂时没有任何产品可以达到这样的效果。"
                                },
                                {
                                    "id": "690950406",
                                    "speaker": "希格雯",
                                    "text": "如果有人跟你这么介绍的话，我建议上报给附近的警卫队，说不定这个人很快就要来梅洛彼得堡报到了。"
                                },
                                {
                                    "id": "690950411",
                                    "speaker": "希格雯",
                                    "text": "还是不要对护肤和美容产品抱有不切实际的期待比较好哟。人类明明怎么样都很可爱很好看。"
                                },
                                {
                                    "id": "690950412",
                                    "speaker": "Player",
                                    "text": "那最好看的人长什么样？"
                                },
                                {
                                    "id": "690950413",
                                    "speaker": "希格雯",
                                    "text": "很遗憾我没办法回答这个问题呢。在我眼中人类没有美丑的区别，大家各有各的迷人之处。"
                                },
                                {
                                    "id": "690950414",
                                    "speaker": "希格雯",
                                    "text": "而且，不管是谁，都没有资格给别人的长相外貌评分，更别说擅自做比较了。"
                                },
                                {
                                    "id": "690950415",
                                    "speaker": "希格雯",
                                    "text": "就算是最高审判官那维莱特先生也不可以评判任何人的外貌哦。哦，但请放心，他是绝对不会这样做的。"
                                },
                                {
                                    "id": "690950416",
                                    "speaker": "希格雯",
                                    "text": "说来我在《花容美谭》收到的大部分来信，都在抱怨自己长得不好看，想问我变好看的方法。"
                                },
                                {
                                    "id": "690950417",
                                    "speaker": "希格雯",
                                    "text": "唉，我很难过为什么人类要对自己这么苛刻呢？"
                                },
                                {
                                    "id": "690950418",
                                    "speaker": "希格雯",
                                    "text": "我分享美容技巧的初衷，是想要大家重视起自己这副可爱的模样，从而好好护理自己的皮肤，认真爱自己。"
                                },
                                {
                                    "id": "690950419",
                                    "speaker": "希格雯",
                                    "text": "你也是哦，关注自己的外貌是好事，但前提是——要先肯定自己的可爱哟。",
                                    "choices": [
                                        {
                                            "id": "690950420",
                                            "text": "很有启发！",
                                            "response": [
                                                {
                                                    "id": "690950421",
                                                    "speaker": "希格雯",
                                                    "text": "嘻嘻。对你有帮助就好。"
                                                },
                                                {
                                                    "id": "690950424",
                                                    "speaker": "希格雯",
                                                    "text": "嗯…言归正传，我们还是快点开始试用新品吧。"
                                                },
                                                {
                                                    "id": "690950425",
                                                    "speaker": "希格雯",
                                                    "text": "我已经迫不及待想看你全脸涂满紫色软膏的样子了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690950422",
                                            "text": "没错！我真可爱！",
                                            "response": [
                                                {
                                                    "id": "690950423",
                                                    "speaker": "希格雯",
                                                    "text": "没错！你真可爱！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690950407",
                            "text": "能青春永驻吗？",
                            "response": [
                                {
                                    "id": "690950408",
                                    "speaker": "希格雯",
                                    "text": "如果人类各种时刻的样子汇集成一本画片册，那护肤品就是画框。"
                                },
                                {
                                    "id": "690950409",
                                    "speaker": "希格雯",
                                    "text": "在保护画片的同时点缀画面，让整个画面更有特点。"
                                },
                                {
                                    "id": "690950410",
                                    "speaker": "希格雯",
                                    "text": "而不是把画片册上锁，这样不就看不到新的画片了，多可惜呀。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909505",
            "initDialog": "690950501",
            "dialogues": [
                {
                    "id": "690950501",
                    "speaker": "Player",
                    "text": "早啊，希格雯。"
                },
                {
                    "id": "690950502",
                    "speaker": "希格雯",
                    "text": "早啊，哦？这对黑眼圈…"
                },
                {
                    "id": "690950503",
                    "speaker": "希格雯",
                    "text": "请等一下，出门前让我用汐藻帮你湿敷一下眼睛吧，冰冰凉凉的，很舒服哦。"
                }
            ]
        },
        {
            "talkId": "6909506",
            "initDialog": "690950601",
            "dialogues": [
                {
                    "id": "690950601",
                    "speaker": "Player",
                    "text": "晚安，希格雯。"
                },
                {
                    "id": "690950602",
                    "speaker": "希格雯",
                    "text": "要休息了吗？介意我在一旁记录你的睡眠数据吗？"
                },
                {
                    "id": "690950603",
                    "speaker": "希格雯",
                    "text": "我只记录呼吸频率和体温，梦话我会当没听见哦。你就安心睡吧。"
                }
            ]
        },
        {
            "talkId": "6909510",
            "initDialog": "690951001",
            "dialogues": [
                {
                    "id": "690951001",
                    "speaker": "希格雯",
                    "text": "真怀念呀。不管过去多久，这种温暖的气息都会让我感到安心…"
                },
                {
                    "id": "690951002",
                    "speaker": "希格雯",
                    "text": "我也想念「鱼鱼咏唱派」的味道了，你先进房子里坐着等吧，我去准备食材，很快就能吃。"
                },
                {
                    "id": "690951003",
                    "speaker": "希格雯",
                    "text": "进门时请稍微弯点腰，小心别碰着脑袋哟。"
                }
            ]
        },
        {
            "talkId": "6909511",
            "initDialog": "690951101",
            "dialogues": [
                {
                    "id": "690951101",
                    "speaker": "希格雯",
                    "text": "啊哈，拳脚无眼，事故多发地。看来这里是最需要我守护的地方。"
                },
                {
                    "id": "690951102",
                    "speaker": "希格雯",
                    "text": "发生意外的时候，不用转移伤员，这里就能作为第一救治现场。"
                },
                {
                    "id": "690951103",
                    "speaker": "希格雯",
                    "text": "其余时间，我会尽情欣赏人们拉丝的肌肉状态和扭成一团的五官的，嘻嘻。"
                }
            ]
        }
    ]
}