{
    "groupId": "7525",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "伊波利特": 6
    },
    "talks": [
        {
            "talkId": "6752501",
            "initDialog": "675250101",
            "dialogues": [
                {
                    "id": "675250101",
                    "speaker": "伊波利特",
                    "text": "啊，那自由的风，正在呼唤着我…"
                }
            ]
        },
        {
            "talkId": "6752502",
            "initDialog": "675250201",
            "dialogues": [
                {
                    "id": "675250201",
                    "speaker": "Player",
                    "text": "你在说什么？"
                },
                {
                    "id": "675250202",
                    "speaker": "伊波利特",
                    "text": "自由啊，自由，我的朋友！您读过赫赫有名的《温妮莎传奇》吗？"
                },
                {
                    "id": "675250203",
                    "speaker": "伊波利特",
                    "text": "这极星区我早就呆腻了！一天到晚宴会宴会，简直是浪费我的青春！我要自由，我要随心所欲！"
                },
                {
                    "id": "675250204",
                    "speaker": "伊波利特",
                    "text": "我要成为伟大的吟游诗人，讴歌抗争与自由的史诗——"
                },
                {
                    "id": "675250205",
                    "speaker": "伊波利特",
                    "text": "——啊，不过我还是不理解为什么温妮莎会是长发。明明是战士，难道不应该把头发剪短吗？我一定要这么写…"
                }
            ]
        },
        {
            "talkId": "6752503",
            "initDialog": "675250301",
            "dialogues": [
                {
                    "id": "675250301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675250302",
                    "speaker": "伊波利特",
                    "text": "愿风…呃，什么来着？哦对了，愿风神护佑你，陌生的旅人！"
                }
            ]
        }
    ]
}