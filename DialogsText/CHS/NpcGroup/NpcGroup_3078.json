{
    "groupId": "3078",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 6,
        "凉子": 21
    },
    "talks": [
        {
            "talkId": "4006304",
            "initDialog": "400630401",
            "dialogues": [
                {
                    "id": "400630401",
                    "speaker": "凉子",
                    "text": "欢迎光临，客人是来离岛参加光华容彩祭的吧？"
                },
                {
                    "id": "400630402",
                    "speaker": "凉子",
                    "text": "祭典非常热闹，祝您玩得愉快，但也不要忘记填饱肚子哦。"
                },
                {
                    "id": "400630403",
                    "speaker": "凉子",
                    "text": "要是一直忙着排队买东西的话，很容易体力不支，甚至在烈日下晕倒的。"
                },
                {
                    "id": "400630404",
                    "speaker": "凉子",
                    "text": "这种时候，就来凉子我这里补充能量吧，呵呵。"
                }
            ]
        },
        {
            "talkId": "4006361",
            "initDialog": "400636101",
            "dialogues": [
                {
                    "id": "400636101",
                    "speaker": "凉子",
                    "text": "欢迎光临，客人是来离岛参加光华容彩祭的吧？"
                },
                {
                    "id": "400636102",
                    "speaker": "凉子",
                    "text": "现在只是布展阶段，人还不是很多，等到正式开幕，离岛就会比现在热闹得多吧，呵呵。"
                }
            ]
        },
        {
            "talkId": "6307801",
            "initDialog": "630780101",
            "dialogues": [
                {
                    "id": "630780101",
                    "speaker": "凉子",
                    "text": "呵呵，欢迎光临，要来一些特色小吃吗？"
                }
            ]
        },
        {
            "talkId": "6307802",
            "initDialog": "630780201",
            "dialogues": [
                {
                    "id": "630780201",
                    "speaker": "Player",
                    "text": "我想买些小吃。"
                },
                {
                    "id": "630780202",
                    "speaker": "凉子",
                    "text": "您好，菜单在这里哦。"
                }
            ]
        },
        {
            "talkId": "6307803",
            "initDialog": "630780301",
            "dialogues": [
                {
                    "id": "630780301",
                    "speaker": "Player",
                    "text": "关于这家店…"
                },
                {
                    "id": "630780302",
                    "speaker": "凉子",
                    "text": "这个小吃摊…之前啊，是我丈夫拉着我一起开的。"
                },
                {
                    "id": "630780303",
                    "speaker": "凉子",
                    "text": "我本不想做这行生意，起早又贪黑，我丈夫他身体又不好，时间长了怎么吃得消呢。"
                },
                {
                    "id": "630780304",
                    "speaker": "凉子",
                    "text": "只是我丈夫说，很喜欢看别人吃到我手作料理时露出的笑容…最后啊，我还是拗不过他。"
                }
            ]
        },
        {
            "talkId": "6307804",
            "initDialog": "630780401",
            "dialogues": [
                {
                    "id": "630780401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630780402",
                    "speaker": "凉子",
                    "text": "慢走哦，随时恭候您的再次光临…"
                }
            ]
        },
        {
            "talkId": "6307805",
            "initDialog": "630780501",
            "dialogues": [
                {
                    "id": "630780501",
                    "speaker": "Player",
                    "text": "你的丈夫？"
                },
                {
                    "id": "630780502",
                    "speaker": "凉子",
                    "text": "我们本来约好，等攒够了钱，就去花见坂盘一间铺子，这样的话就有更多人能尝到我们的手艺了。"
                },
                {
                    "id": "630780503",
                    "speaker": "凉子",
                    "text": "…可就在两年前那个秋天，他不听我劝，偏要顶着大雨去进货，结果…"
                },
                {
                    "id": "630780504",
                    "speaker": "凉子",
                    "text": "如今，我纪念他的最好的方式，就是经营好这个小摊，守护我们共同的回忆了。"
                },
                {
                    "id": "630780505",
                    "speaker": "凉子",
                    "text": "希望客官能多来惠顾，这样亡夫的在天之灵，也能得到慰藉吧…"
                }
            ]
        },
        {
            "talkId": "6307806",
            "initDialog": "630780601",
            "dialogues": [
                {
                    "id": "630780601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6307807",
            "initDialog": "630780701",
            "dialogues": [
                {
                    "id": "630780701",
                    "speaker": "凉子",
                    "text": "没想到您的牌技如此精湛，思考很累吧，要不要买点什么吃的…"
                }
            ]
        },
        {
            "talkId": "6307808",
            "initDialog": "630780801",
            "dialogues": [
                {
                    "id": "630780801",
                    "speaker": "凉子",
                    "text": "呵呵，看来客人您要再好好考虑一下牌组的构成呢…"
                }
            ]
        },
        {
            "talkId": "7290501",
            "initDialog": "729050101",
            "dialogues": [
                {
                    "id": "729050101",
                    "speaker": "Player",
                    "text": "你的厨艺一定很好吧？"
                },
                {
                    "id": "729050102",
                    "speaker": "凉子",
                    "text": "呵呵，这位客人可真会讲话。我虽不是名厨，但对稻妻小吃的调味可是很有一手哦。"
                },
                {
                    "id": "729050103",
                    "speaker": "凉子",
                    "text": "来，这里刚好新做了一些吃的，客人不如趁热尝尝看？"
                },
                {
                    "id": "729050104",
                    "speaker": "凉子",
                    "text": "看您是外国人呢，若是不合您的口味，以后可以为您特别调整哦。"
                }
            ]
        }
    ]
}