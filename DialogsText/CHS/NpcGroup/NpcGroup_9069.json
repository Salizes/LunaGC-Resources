{
    "groupId": "9069",
    "total_dialogue_lines": 82,
    "speaker_counts": {
        "Player": 20,
        "提纳里": 62
    },
    "talks": [
        {
            "talkId": "6906901",
            "initDialog": "690690101",
            "dialogues": [
                {
                    "id": "690690101",
                    "speaker": "提纳里",
                    "text": "#你好，{NICKNAME}。"
                },
                {
                    "id": "690690102",
                    "speaker": "提纳里",
                    "text": "隔着老远就听到你过来啦。"
                }
            ]
        },
        {
            "talkId": "6906902",
            "initDialog": "690690201",
            "dialogues": [
                {
                    "id": "690690201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690690202",
                    "speaker": "提纳里",
                    "text": "嗯，这里环境宜人，景色优美，令人倍感舒适。"
                },
                {
                    "id": "690690203",
                    "speaker": "提纳里",
                    "text": "…或者说，让我觉得有点太舒适了。"
                },
                {
                    "id": "690690204",
                    "speaker": "提纳里",
                    "text": "你看，我已经连要在这里做什么的日程都安排好了。",
                    "choices": [
                        {
                            "id": "690690205",
                            "text": "在这里还要巡逻吗？",
                            "response": [
                                {
                                    "id": "690690206",
                                    "speaker": "提纳里",
                                    "text": "哈哈，那倒不至于。这里是用法术构筑的空间吧？我没有察觉到任何危险的气息。"
                                },
                                {
                                    "id": "690690207",
                                    "speaker": "提纳里",
                                    "text": "而且能进入这里的，我想应该都是你邀请的伙伴。"
                                },
                                {
                                    "id": "690690208",
                                    "speaker": "提纳里",
                                    "text": "既然是你结交的朋友，估计不会闹出什么出格的动静。"
                                },
                                {
                                    "id": "690690209",
                                    "speaker": "提纳里",
                                    "text": "…呃，应该不会吧？"
                                }
                            ]
                        },
                        {
                            "id": "690690210",
                            "text": "是要做研究吗？",
                            "response": [
                                {
                                    "id": "690690211",
                                    "speaker": "提纳里",
                                    "text": "嗯…不全是吧。"
                                },
                                {
                                    "id": "690690212",
                                    "speaker": "提纳里",
                                    "text": "这里转转，那里看看，到处观察各式各样的植物，就像平常一样。"
                                },
                                {
                                    "id": "690690213",
                                    "speaker": "提纳里",
                                    "text": "既是学术研究，也是日常生活。"
                                },
                                {
                                    "id": "690690214",
                                    "speaker": "提纳里",
                                    "text": "不过在这里的话，我还是以度假的心态，只安排了以往日程中百分之六十的事务。"
                                },
                                {
                                    "id": "690690215",
                                    "speaker": "提纳里",
                                    "text": "所以如果有事找我的话，随时都可以。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906903",
            "initDialog": "690690301",
            "dialogues": [
                {
                    "id": "690690301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690690302",
                    "speaker": "提纳里",
                    "text": "当然好啊，你有什么想聊的话题吗？"
                },
                {
                    "id": "690690303",
                    "speaker": "提纳里",
                    "text": "如果让我起头的话，一定又都是些关于花花草草的事情了。",
                    "choices": [
                        {
                            "id": "690690304",
                            "text": "没关系，我已经预判到了。",
                            "response": [
                                {
                                    "id": "690690306",
                                    "speaker": "提纳里",
                                    "text": "哦？那看来是做好准备咯？"
                                },
                                {
                                    "id": "690690307",
                                    "speaker": "提纳里",
                                    "text": "那我们先从最基础的开始：植物学从属于生物学，主要研究植物的形态、分类、生态、遗传、进化等内容。"
                                },
                                {
                                    "id": "690690308",
                                    "speaker": "提纳里",
                                    "text": "植物分类的基本等级有…",
                                    "choices": [
                                        {
                                            "id": "690690309",
                                            "text": "呼…呼…",
                                            "response": [
                                                {
                                                    "id": "690690311",
                                                    "speaker": "提纳里",
                                                    "text": "不许走神，瞌睡虫！这可是你自己要听的。"
                                                },
                                                {
                                                    "id": "690690312",
                                                    "speaker": "提纳里",
                                                    "text": "…哈哈，不逗你了。不从事相关工作的人不需要背这些死规矩啦。"
                                                },
                                                {
                                                    "id": "690690313",
                                                    "speaker": "提纳里",
                                                    "text": "不过你经常在外旅行，风餐露宿的，还是需要多了解一些常见的野外植物特性。"
                                                },
                                                {
                                                    "id": "690690314",
                                                    "speaker": "提纳里",
                                                    "text": "比如如何通过草木的生长形态辨别方向，如何利用茎杆和叶片获取干净的水源…"
                                                },
                                                {
                                                    "id": "690690315",
                                                    "speaker": "提纳里",
                                                    "text": "再比如有哪些果实无毒又好吃，又有哪些野菜适合与肉类一起烹饪…",
                                                    "choices": [
                                                        {
                                                            "id": "690690316",
                                                            "text": "不好，口水要流下来了…",
                                                            "response": [
                                                                {
                                                                    "id": "690690318",
                                                                    "speaker": "提纳里",
                                                                    "text": "哎，怎么回事！光听见和吃有关的事情了是吧。"
                                                                },
                                                                {
                                                                    "id": "690690319",
                                                                    "speaker": "Player",
                                                                    "text": "这个主要怪派蒙…"
                                                                },
                                                                {
                                                                    "id": "690690320",
                                                                    "speaker": "提纳里",
                                                                    "text": "那个小家伙啊…"
                                                                },
                                                                {
                                                                    "id": "690690321",
                                                                    "speaker": "提纳里",
                                                                    "text": "她虽然看起来…脑瓜是不太灵活，但十分在乎你呢。"
                                                                },
                                                                {
                                                                    "id": "690690322",
                                                                    "speaker": "提纳里",
                                                                    "text": "所以就算是为了保护好你的旅伴，你也要多学习一些自然科学哦。"
                                                                },
                                                                {
                                                                    "id": "690690323",
                                                                    "speaker": "提纳里",
                                                                    "text": "哎呀，一不小心用培训巡林员的语气说话了…不好意思，你多包涵。"
                                                                },
                                                                {
                                                                    "id": "690690324",
                                                                    "speaker": "提纳里",
                                                                    "text": "总之你是聪明人，一定能明白我的意思啦。"
                                                                },
                                                                {
                                                                    "id": "690690325",
                                                                    "speaker": "提纳里",
                                                                    "text": "如果有什么想要了解的「花花草草」，欢迎随时来找我讨论。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690690317",
                                                            "text": "我饿了，「师父」。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690690310",
                                            "text": "呵…欠…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690690305",
                            "text": "教教我吧，「师父」。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906904",
            "initDialog": "690690401",
            "dialogues": [
                {
                    "id": "690690401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690690402",
                    "speaker": "提纳里",
                    "text": "我吗？正在思考一些最近需要处理的待办事项。"
                },
                {
                    "id": "690690403",
                    "speaker": "提纳里",
                    "text": "这周内要去禅那园观察并记录试验结果，另外巡林员们的值班次序也差不多该更替了…"
                },
                {
                    "id": "690690404",
                    "speaker": "提纳里",
                    "text": "不过这些都不急，可以等。"
                },
                {
                    "id": "690690405",
                    "speaker": "提纳里",
                    "text": "你呢，有没有什么特别想做的事情？"
                },
                {
                    "id": "690690406",
                    "speaker": "Player",
                    "text": "唔…没…"
                },
                {
                    "id": "690690407",
                    "speaker": "提纳里",
                    "text": "哦？竟然没有想法吗？"
                },
                {
                    "id": "690690408",
                    "speaker": "提纳里",
                    "text": "那我就不客气了。请回答我一个问题吧。"
                },
                {
                    "id": "690690409",
                    "speaker": "提纳里",
                    "text": "你是不是——很想摸我的耳朵呀？",
                    "choices": [
                        {
                            "id": "690690410",
                            "text": "你这是…反客为主！",
                            "response": [
                                {
                                    "id": "690690411",
                                    "speaker": "提纳里",
                                    "text": "这不怪我哈，我可是给过你主动的机会了。"
                                },
                                {
                                    "id": "690690414",
                                    "speaker": "提纳里",
                                    "text": "其实我嘛…并不介意熟悉的人碰我的耳朵哦？"
                                },
                                {
                                    "id": "690690415",
                                    "speaker": "提纳里",
                                    "text": "不过不知怎么搞的，大家似乎一致认定我会因为这件事情生气。"
                                },
                                {
                                    "id": "690690416",
                                    "speaker": "提纳里",
                                    "text": "渐渐地，「在提纳里面前故意逃避耳朵和尾巴的话题」变成了像是潜规则一样的东西。"
                                },
                                {
                                    "id": "690690417",
                                    "speaker": "提纳里",
                                    "text": "有时看着他们想说些什么又马上吞回去的表情，还挺有意思的。"
                                },
                                {
                                    "id": "690690418",
                                    "speaker": "提纳里",
                                    "text": "也算是好事吧。毕竟那些半生不熟的人要是上来就想对你动手动脚，也很麻烦呢。"
                                },
                                {
                                    "id": "690690419",
                                    "speaker": "Player",
                                    "text": "所以说，我可以…"
                                },
                                {
                                    "id": "690690420",
                                    "speaker": "提纳里",
                                    "text": "嗯，没问题哦。"
                                },
                                {
                                    "id": "690690421",
                                    "speaker": "提纳里",
                                    "text": "不过实际摸上去可能没有你想象的手感那么好啦，其实就跟摸普通的猫猫狗狗是差不多的感觉。",
                                    "choices": [
                                        {
                                            "id": "690690422",
                                            "text": "我觉得好，应该多给几次机会。",
                                            "response": [
                                                {
                                                    "id": "690690424",
                                                    "speaker": "提纳里",
                                                    "text": "得寸进尺是吧？"
                                                },
                                                {
                                                    "id": "690690425",
                                                    "speaker": "提纳里",
                                                    "text": "…唉，好吧好吧。"
                                                },
                                                {
                                                    "id": "690690426",
                                                    "speaker": "提纳里",
                                                    "text": "只要你觉得好，那就是真的好。"
                                                },
                                                {
                                                    "id": "690690427",
                                                    "speaker": "提纳里",
                                                    "text": "如果是你的话，就算合影五百次都行，摸两下又算什么呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690690423",
                                            "text": "嘿嘿，那尾巴也…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690690412",
                            "text": "呀！被看穿了吗？",
                            "response": [
                                {
                                    "id": "690690413",
                                    "speaker": "提纳里",
                                    "text": "你的目光一直在不受控制地往上瞟呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906905",
            "initDialog": "690690501",
            "dialogues": [
                {
                    "id": "690690501",
                    "speaker": "Player",
                    "text": "早啊，提纳里。"
                },
                {
                    "id": "690690502",
                    "speaker": "提纳里",
                    "text": "早。一天之计在于晨，早起的鸟儿有虫吃。"
                },
                {
                    "id": "690690503",
                    "speaker": "提纳里",
                    "text": "虽然早起的虫可能对此有异议吧，不过食物链就是这个样子啦。"
                },
                {
                    "id": "690690504",
                    "speaker": "提纳里",
                    "text": "你看，树叶就算不早起也会被虫吃掉，但树叶也没处抱怨不是？"
                }
            ]
        },
        {
            "talkId": "6906906",
            "initDialog": "690690601",
            "dialogues": [
                {
                    "id": "690690601",
                    "speaker": "Player",
                    "text": "晚安，提纳里。"
                },
                {
                    "id": "690690602",
                    "speaker": "提纳里",
                    "text": "#{NICKNAME}，还不睡吗？"
                },
                {
                    "id": "690690603",
                    "speaker": "提纳里",
                    "text": "这么晚还不休息的话，会被我抓来当研究助手的哦？"
                }
            ]
        },
        {
            "talkId": "6906910",
            "initDialog": "690691001",
            "dialogues": [
                {
                    "id": "690691001",
                    "speaker": "提纳里",
                    "text": "真是个熟悉的小屋。看来和我共同行动的时候，你也没少走神张望啊。"
                },
                {
                    "id": "690691002",
                    "speaker": "提纳里",
                    "text": "在这种环境下，习惯性地就想安排之后的日程…"
                },
                {
                    "id": "690691003",
                    "speaker": "提纳里",
                    "text": "空间很大，你也要试着坐下来一起写点什么吗？"
                }
            ]
        },
        {
            "talkId": "6906911",
            "initDialog": "690691101",
            "dialogues": [
                {
                    "id": "690691101",
                    "speaker": "提纳里",
                    "text": "竟然养护了那么多品种的花草，可见你对植物也很感兴趣。"
                },
                {
                    "id": "690691102",
                    "speaker": "提纳里",
                    "text": "兴趣是知识的萌芽，这很好。不如…这次就轮到你来和我讲讲它们的习性与喜好吧？"
                },
                {
                    "id": "690691103",
                    "speaker": "提纳里",
                    "text": "别有负担，有我帮你查遗补漏，没准能比平时记得更牢。"
                }
            ]
        }
    ]
}