    "talks": [
        {
            "talkId": "4111542",
            "initDialog": "411154201",
            "dialogues": [
                {
                    "id": "411154201",
                    "speaker": "毓华",
                    "text": "贵客啊，快来里面请，现在特殊时期，还是少在外面活动为妙。"
                }
            ]
        },
        {
            "talkId": "6220601",
            "initDialog": "622060101",
            "dialogues": [
                {
                    "id": "622060101",
                    "speaker": "毓华",
                    "text": "贵客啊，今天是吃饭还是投宿呢？"
                }
            ]
        },
        {
            "talkId": "6220602",
            "initDialog": "622060201",
            "dialogues": [
                {
                    "id": "622060201",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "622060202",
                    "speaker": "毓华",
                    "text": "我叫毓华，是望舒客栈的跑堂。"
                },
                {
                    "id": "622060203",
                    "speaker": "毓华",
                    "text": "没什么可疑的啦。",
                    "choices": [
                        {
                            "id": "622060204",
                            "text": "关于身份。",
                            "response": [
                                {
                                    "id": "622060205",
                                    "speaker": "毓华",
                                    "text": "我是这家客栈的跑堂，也就是服务员。如你所见，没什么特殊之处。"
                                }
                            ]
                        },
                        {
                            "id": "622060206",
                            "text": "关于望舒客栈。",
                            "response": [
                                {
                                    "id": "622060207",
                                    "speaker": "毓华",
                                    "text": "望舒客栈地处蒙德璃月的交通要道之上，客房充裕，价钱公道。是您往来两地住宿逗留的不二之选。"
                                },
                                {
                                    "id": "622060208",
                                    "speaker": "毓华",
                                    "text": "没什么可疑的啦，啊哈哈哈。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220603",
            "initDialog": "622060301",
            "dialogues": [
                {
                    "id": "622060301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622060302",
                    "speaker": "毓华",
                    "text": "望舒永远欢迎您，有空常来。"
                }
            ]
        },
        {
            "talkId": "6220604",
            "initDialog": "622060401",
            "dialogues": [
                {
                    "id": "622060401",
                    "speaker": "毓华",
                    "text": "贵客啊，今天是吃饭还是投宿呢？"
                }
            ]
        },
        {
            "talkId": "6220605",
            "initDialog": "622060501",
            "dialogues": [
                {
                    "id": "622060501",
                    "speaker": "Player",
                    "text": "请问你是…？"
                },
                {
                    "id": "622060502",
                    "speaker": "毓华",
                    "text": "我叫…秀华。是望舒客栈的招待。"
                },
                {
                    "id": "622060503",
                    "speaker": "毓华",
                    "text": "没…没什么可疑的。",
                    "choices": [
                        {
                            "id": "622060504",
                            "text": "关于身份…",
                            "response": [
                                {
                                    "id": "622060505",
                                    "speaker": "毓华",
                                    "text": "您、您问身份…难道说被看穿了…啊不，没什么。"
                                }
                            ]
                        },
                        {
                            "id": "622060506",
                            "text": "关于望舒客栈。",
                            "response": [
                                {
                                    "id": "622060507",
                                    "speaker": "毓华",
                                    "text": "您、您问客栈…难道说姐姐一不小心把七星交代的任务说漏嘴了？啊不，没什么…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220606",
            "initDialog": "622060601",
            "dialogues": [
                {
                    "id": "622060601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622060602",
