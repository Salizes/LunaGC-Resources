{
    "groupId": "5219",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "奈莉": 9
    },
    "talks": [
        {
            "talkId": "6521901",
            "initDialog": "652190101",
            "dialogues": [
                {
                    "id": "652190101",
                    "speaker": "奈莉",
                    "text": "看我钓上大新闻！"
                }
            ]
        },
        {
            "talkId": "6521902",
            "initDialog": "652190201",
            "dialogues": [
                {
                    "id": "652190201",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "652190202",
                    "speaker": "奈莉",
                    "text": "我在这里钓…咳，我是说「搜寻」，有没有什么能够让我写成新闻的好材料！"
                },
                {
                    "id": "652190203",
                    "speaker": "奈莉",
                    "text": "啊，你该不会刚才偷偷在心里想到一些关于记者的刻板印象笑话吧？"
                }
            ]
        },
        {
            "talkId": "6521903",
            "initDialog": "652190301",
            "dialogues": [
                {
                    "id": "652190301",
                    "speaker": "Player",
                    "text": "关于生产区…"
                },
                {
                    "id": "652190302",
                    "speaker": "奈莉",
                    "text": "毕竟是生产区，噪音问题不容小觑呢。除了生产机器和发条机关…还有扩音机！"
                },
                {
                    "id": "652190303",
                    "speaker": "奈莉",
                    "text": "我觉得以扩音机为题写一篇报道应该还不错，嗯，就这么办吧！"
                }
            ]
        },
        {
            "talkId": "6521904",
            "initDialog": "652190401",
            "dialogues": [
                {
                    "id": "652190401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652190402",
                    "speaker": "奈莉",
                    "text": "再见！祝你也钓上自己想要的鱼！"
                }
            ]
        },
        {
            "talkId": "6521905",
            "initDialog": "652190501",
            "dialogues": [
                {
                    "id": "652190501",
                    "speaker": "Player",
                    "text": "确实想到了。"
                },
                {
                    "id": "652190502",
                    "speaker": "奈莉",
                    "text": "你想得很对！我觉得要成为记者，首先得模仿记者。所以就先从大家刻板印象里的那些行为开始模仿啦。"
                },
                {
                    "id": "652190503",
                    "speaker": "奈莉",
                    "text": "既然你也这么想，那说明我学得还挺像的，哼哼。"
                }
            ]
        },
        {
            "talkId": "6521906",
            "initDialog": "652190601",
            "dialogues": [
                {
                    "id": "652190601",
                    "speaker": "Player",
                    "text": "我还以为你在钓「鱼」。"
                },
                {
                    "id": "652190602",
                    "speaker": "奈莉",
                    "text": "我觉得你话里有话…但是你说得对！我就是想要白金典藏型嘛，不管别人怎么说。"
                }
            ]
        }
    ]
}