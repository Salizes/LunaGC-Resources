{
    "groupId": "7075",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "雅珂达": 4,
        "雷科": 8
    },
    "talks": [
        {
            "talkId": "6707501",
            "initDialog": "670750101",
            "dialogues": [
                {
                    "id": "670750101",
                    "speaker": "雷科",
                    "text": "海上珍奇，秘境藏宝，瞧一瞧看一看咯。"
                }
            ]
        },
        {
            "talkId": "6707502",
            "initDialog": "670750201",
            "dialogues": [
                {
                    "id": "670750201",
                    "speaker": "Player",
                    "text": "你这儿卖什么？"
                },
                {
                    "id": "670750202",
                    "speaker": "雷科",
                    "text": "随意挑选。"
                }
            ]
        },
        {
            "talkId": "6707503",
            "initDialog": "670750301",
            "dialogues": [
                {
                    "id": "670750301",
                    "speaker": "Player",
                    "text": "关于这些货品…"
                },
                {
                    "id": "670750302",
                    "speaker": "雷科",
                    "text": "问这个可就不地道了，具体的渠道当然不能跟你细说。不过嘛…"
                },
                {
                    "id": "670750303",
                    "speaker": "雷科",
                    "text": "你知道吗，在刻拉蒂之眼附近沉没的阿特拉号，这些年过去了，还有不少宝物沉在海底呢。"
                },
                {
                    "id": "670750304",
                    "speaker": "雷科",
                    "text": "据说那些宝物之中，就有大盗雷德·米勒留下的「识者之证」。"
                }
            ]
        },
        {
            "talkId": "6707504",
            "initDialog": "670750401",
            "dialogues": [
                {
                    "id": "670750401",
                    "speaker": "Player",
                    "text": "下次再来。"
                },
                {
                    "id": "670750402",
                    "speaker": "雷科",
                    "text": "慢走不送。"
                }
            ]
        },
        {
            "talkId": "6707505",
            "initDialog": "670750501",
            "dialogues": [
                {
                    "id": "670750501",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>雅珂达</color>似乎有所思考…）"
                },
                {
                    "id": "670750502",
                    "speaker": "雅珂达",
                    "text": "雷科先生，上次老板在您这边订的那几颗宝石，您找到货了么？"
                },
                {
                    "id": "670750503",
                    "speaker": "雷科",
                    "text": "雅珂达小姐请放心，我已经找到了可靠的供货商，只要宝石运到，马上送到「秘闻馆」里。"
                },
                {
                    "id": "670750504",
                    "speaker": "雅珂达",
                    "text": "那就麻烦您了，等宝石到了，我会过来帮忙护送的。"
                },
                {
                    "id": "670750505",
                    "speaker": "雅珂达",
                    "text": "（一定不能出事，一定不能出事，不然奈姐肯定又要我跑腿…）"
                },
                {
                    "id": "670750506",
                    "speaker": "雅珂达",
                    "text": "（等宝石运到，奈姐肯定心情超好，到时候请假肯定也轻轻松松啦。）"
                },
                {
                    "id": "670750507",
                    "speaker": "雷科",
                    "text": "喔…那样最好，那到时候就麻烦雅珂达小姐了。"
                }
            ]
        }
    ]
}