{
    "groupId": "5137",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "莱克图尔": 9
    },
    "talks": [
        {
            "talkId": "6513701",
            "initDialog": "651370101",
            "dialogues": [
                {
                    "id": "651370101",
                    "speaker": "莱克图尔",
                    "text": "嘿嘿，希望她能喜欢我精心挑选的礼物…"
                }
            ]
        },
        {
            "talkId": "6513702",
            "initDialog": "651370201",
            "dialogues": [
                {
                    "id": "651370201",
                    "speaker": "Player",
                    "text": "礼物？"
                },
                {
                    "id": "651370202",
                    "speaker": "莱克图尔",
                    "text": "对啦，为我心爱的她，专门买了枫丹特有的礼品。"
                },
                {
                    "id": "651370203",
                    "speaker": "莱克图尔",
                    "text": "你一定很奇怪吧，其他的水手到港后都忙着往枫丹廷跑，就我一个人又跑回来了。"
                },
                {
                    "id": "651370204",
                    "speaker": "莱克图尔",
                    "text": "虽然出海很累，但我是真的期盼再次起航，去纳塔见我心爱的姑娘。"
                },
                {
                    "id": "651370205",
                    "speaker": "莱克图尔",
                    "text": "对感情我可是认真的。如果一切顺利的话，我甚至愿意换个工作，在她那里定居。"
                },
                {
                    "id": "651370206",
                    "speaker": "莱克图尔",
                    "text": "不过她那里好像有好几个部族，不同的部落里还有不同的规矩…我能顺利融入吗…"
                }
            ]
        },
        {
            "talkId": "6513703",
            "initDialog": "651370301",
            "dialogues": [
                {
                    "id": "651370301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651370302",
                    "speaker": "莱克图尔",
                    "text": "嗯，祝你一天都有好心情，就像我一样！"
                }
            ]
        },
        {
            "talkId": "6513704",
            "initDialog": "651370401",
            "dialogues": [
                {
                    "id": "651370401",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6513705",
            "initDialog": "651370501",
            "dialogues": [
                {
                    "id": "651370501",
                    "speaker": "莱克图尔",
                    "text": "多谢你配合我！这个牌组还不错，下次就把它送给我心爱的姑娘…"
                }
            ]
        },
        {
            "talkId": "6513706",
            "initDialog": "651370601",
            "dialogues": [
                {
                    "id": "651370601",
                    "speaker": "莱克图尔",
                    "text": "看来这副牌组作为礼物还是有点弱了，我得想想怎么改进搭配…"
                }
            ]
        }
    ]
}