{
    "groupId": "5138",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "安托万": 17
    },
    "talks": [
        {
            "talkId": "6513801",
            "initDialog": "651380101",
            "dialogues": [
                {
                    "id": "651380101",
                    "speaker": "安托万",
                    "text": "好孩子，贝格艾蒂，做得好…哈啊。"
                }
            ]
        },
        {
            "talkId": "6513802",
            "initDialog": "651380201",
            "dialogues": [
                {
                    "id": "651380201",
                    "speaker": "Player",
                    "text": "在忙些什么…"
                },
                {
                    "id": "651380202",
                    "speaker": "安托万",
                    "text": "…抱歉，实在有点困， 刚才没注意到你。"
                },
                {
                    "id": "651380203",
                    "speaker": "安托万",
                    "text": "很少有人在工作时间跟我搭话，毕竟货物安检工作又不需要船员参与。"
                },
                {
                    "id": "651380204",
                    "speaker": "安托万",
                    "text": "如你所见，我在处理货物安检工作。"
                },
                {
                    "id": "651380205",
                    "speaker": "安托万",
                    "text": "不过真正在进行安检的是我的狗贝格艾蒂，我只需要管理好她就行了。"
                }
            ]
        },
        {
            "talkId": "6513803",
            "initDialog": "651380301",
            "dialogues": [
                {
                    "id": "651380301",
                    "speaker": "Player",
                    "text": "关于你的狗…"
                },
                {
                    "id": "651380302",
                    "speaker": "安托万",
                    "text": "哦，贝格艾蒂是个认真敬业的好姑娘，我很爱她。"
                },
                {
                    "id": "651380303",
                    "speaker": "安托万",
                    "text": "她的嗅觉非常灵敏，能闻出所有违禁品名录上的东西。"
                },
                {
                    "id": "651380304",
                    "speaker": "安托万",
                    "text": "在这方面，没有任何一个人类安检员能比她做得更好，但是…"
                },
                {
                    "id": "651380305",
                    "speaker": "安托万",
                    "text": "贝格艾蒂工作起来不知疲倦，拆起家来也不知疲倦。"
                },
                {
                    "id": "651380306",
                    "speaker": "安托万",
                    "text": "唉，要是她在家也能这样安生就好了。"
                }
            ]
        },
        {
            "talkId": "6513804",
            "initDialog": "651380401",
            "dialogues": [
                {
                    "id": "651380401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651380402",
                    "speaker": "安托万",
                    "text": "哈…再见。"
                }
            ]
        },
        {
            "talkId": "6513805",
            "initDialog": "651380501",
            "dialogues": [
                {
                    "id": "651380501",
                    "speaker": "Player",
                    "text": "关于「预言」…"
                },
                {
                    "id": "651380502",
                    "speaker": "安托万",
                    "text": "谢谢你之前送我的魔术口袋！"
                },
                {
                    "id": "651380503",
                    "speaker": "安托万",
                    "text": "无论「预言」是不是真的，这都是极其方便的收纳工具啊。"
                },
                {
                    "id": "651380504",
                    "speaker": "安托万",
                    "text": "我应该提前把家里最贵重的东西都塞进去，就算不是为了搬家，也可以避免被贝格艾蒂弄坏。"
                }
            ]
        },
        {
            "talkId": "6513806",
            "initDialog": "651380601",
            "dialogues": [
                {
                    "id": "651380601",
                    "speaker": "Player",
                    "text": "关于「预言」…"
                },
                {
                    "id": "651380602",
                    "speaker": "安托万",
                    "text": "请容我再次感谢，谢谢你之前送我的魔术口袋！真是极其方便的收纳工具。"
                },
                {
                    "id": "651380603",
                    "speaker": "安托万",
                    "text": "还好我提前把家里最贵重的东西都塞进去了。水涨上来时大家都忙着救援，根本没空管别的事情。"
                },
                {
                    "id": "651380604",
                    "speaker": "安托万",
                    "text": "不过我现在还没把之前装进去的东西拿出来，嘿嘿…毕竟，也能防止贝格艾蒂弄坏东西嘛。"
                }
            ]
        }
    ]
}