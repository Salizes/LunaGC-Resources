{
    "groupId": "3109",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "甘乐": 8
    },
    "talks": [
        {
            "talkId": "6310901",
            "initDialog": "631090101",
            "dialogues": [
                {
                    "id": "631090101",
                    "speaker": "甘乐",
                    "text": "唉，他应该会平安无事的吧…"
                }
            ]
        },
        {
            "talkId": "6310902",
            "initDialog": "631090201",
            "dialogues": [
                {
                    "id": "631090201",
                    "speaker": "Player",
                    "text": "他是…？"
                },
                {
                    "id": "631090202",
                    "speaker": "甘乐",
                    "text": "啊，他是我的恋人，现在正在踏鞴砂当兵。"
                },
                {
                    "id": "631090203",
                    "speaker": "甘乐",
                    "text": "我给他写过一些信，信中询问他是否一切都好…但不知为何，这些信全都石沉大海，没有回音。"
                },
                {
                    "id": "631090204",
                    "speaker": "甘乐",
                    "text": "我没有别的办法，只好来这里为他祈福，希望神明能保佑他平安无事…"
                }
            ]
        },
        {
            "talkId": "6310903",
            "initDialog": "631090301",
            "dialogues": [
                {
                    "id": "631090301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631090302",
                    "speaker": "甘乐",
                    "text": "唉，再见…"
                }
            ]
        },
        {
            "talkId": "7292701",
            "initDialog": "729270101",
            "dialogues": [
                {
                    "id": "729270101",
                    "speaker": "Player",
                    "text": "祝你们好运。"
                },
                {
                    "id": "729270102",
                    "speaker": "甘乐",
                    "text": "哎，你人真好，谢谢你。"
                },
                {
                    "id": "729270103",
                    "speaker": "甘乐",
                    "text": "那个…看你似乎是游历四方的旅人呢，这个护身符就送给你吧，保佑你一路顺风。"
                },
                {
                    "id": "729270104",
                    "speaker": "甘乐",
                    "text": "如果我还能见到我的恋人的话，一定也要为他准备一个…"
                }
            ]
        }
    ]
}