{
    "groupId": "4373",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "苏尔塔尼": 9
    },
    "talks": [
        {
            "talkId": "6437301",
            "initDialog": "643730101",
            "dialogues": [
                {
                    "id": "643730101",
                    "speaker": "苏尔塔尼",
                    "text": "您好，需要我为您指路吗？"
                }
            ]
        },
        {
            "talkId": "6437302",
            "initDialog": "643730201",
            "dialogues": [
                {
                    "id": "643730201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643730202",
                    "speaker": "苏尔塔尼",
                    "text": "我是此处家宅的仆从，愿意为您效劳。"
                },
                {
                    "id": "643730203",
                    "speaker": "苏尔塔尼",
                    "text": "看您在这里漫无目的地闲逛，恕我冒昧，请问…是不是管家又在乱指路了？"
                },
                {
                    "id": "643730204",
                    "speaker": "苏尔塔尼",
                    "text": "唉，如果您「有幸」和管家交谈过的话，请一定不要把他的话放在心上。"
                },
                {
                    "id": "643730205",
                    "speaker": "苏尔塔尼",
                    "text": "此地虽然看起来富丽堂皇，但和城里相比还是较为偏僻；又因为老爷不喜喧闹，所以人手不多。"
                },
                {
                    "id": "643730206",
                    "speaker": "苏尔塔尼",
                    "text": "建议您在附近走动时还是需要多注意身边的情况，尤其是在走出宅院范围的时候。"
                }
            ]
        },
        {
            "talkId": "6437303",
            "initDialog": "643730301",
            "dialogues": [
                {
                    "id": "643730301",
                    "speaker": "Player",
                    "text": "不多叨扰了。"
                },
                {
                    "id": "643730302",
                    "speaker": "苏尔塔尼",
                    "text": "再见，祝您生活愉快。"
                }
            ]
        },
        {
            "talkId": "7396201",
            "initDialog": "739620101",
            "dialogues": [
                {
                    "id": "739620101",
                    "speaker": "Player",
                    "text": "谢谢提醒。"
                },
                {
                    "id": "739620102",
                    "speaker": "苏尔塔尼",
                    "text": "不必客气，只是经验之谈罢了。"
                },
                {
                    "id": "739620103",
                    "speaker": "苏尔塔尼",
                    "text": "像您这样深明事理、愿意听从建议的客人，可是很难得的。"
                }
            ]
        }
    ]
}