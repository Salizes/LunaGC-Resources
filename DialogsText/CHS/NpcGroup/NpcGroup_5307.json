{
    "groupId": "5307",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "薇尔妲": 16
    },
    "talks": [
        {
            "talkId": "6530701",
            "initDialog": "653070101",
            "dialogues": [
                {
                    "id": "653070101",
                    "speaker": "薇尔妲",
                    "text": "必须得努力进行特训才行…咦，好像之前从来没见过你，你是？啊，请别说，先让我来猜一下。"
                },
                {
                    "id": "653070102",
                    "speaker": "薇尔妲",
                    "text": "嗯…高高的，与美露莘截然不同的身形…我知道了，你一定是从村子外面来的人！"
                }
            ]
        },
        {
            "talkId": "6530702",
            "initDialog": "653070201",
            "dialogues": [
                {
                    "id": "653070201",
                    "speaker": "Player",
                    "text": "好精妙的推理哦…"
                },
                {
                    "id": "653070202",
                    "speaker": "薇尔妲",
                    "text": "我、我只是见习探员啦…所以水平有些不足。"
                },
                {
                    "id": "653070203",
                    "speaker": "薇尔妲",
                    "text": "不过，我每天都有努力进行特训，未来一定能够正式加入「逐影庭」！"
                }
            ]
        },
        {
            "talkId": "6530703",
            "initDialog": "653070301",
            "dialogues": [
                {
                    "id": "653070301",
                    "speaker": "Player",
                    "text": "为什么要特训…"
                },
                {
                    "id": "653070302",
                    "speaker": "薇尔妲",
                    "text": "当然是为了加入「逐影庭」，虽然那维莱特大人说，大家都有成为「逐影庭」探员的天分…"
                },
                {
                    "id": "653070303",
                    "speaker": "薇尔妲",
                    "text": "但是真的要成为「逐影庭」的一员，也要经过很严格的考核，所以必须得为此努力才行！"
                }
            ]
        },
        {
            "talkId": "6530704",
            "initDialog": "653070401",
            "dialogues": [
                {
                    "id": "653070401",
                    "speaker": "Player",
                    "text": "为什么要加入「逐影庭」？"
                },
                {
                    "id": "653070402",
                    "speaker": "薇尔妲",
                    "text": "当然是因为加入以后，就能够作为「逐影庭」的一员维护正义，还能穿上帅气的正式探员的制服。"
                },
                {
                    "id": "653070403",
                    "speaker": "薇尔妲",
                    "text": "还有还有，《大侦探赫尔洛克》里，我最喜欢的角色就是「逐影庭」的吉娜探员。"
                },
                {
                    "id": "653070404",
                    "speaker": "薇尔妲",
                    "text": "虽然她的推理总是漏洞百出，但是为了自己的前途，费尽力气抓住犯人的那份努力也令人感动。"
                },
                {
                    "id": "653070405",
                    "speaker": "薇尔妲",
                    "text": "成为「逐影庭」的一员，是我的梦想！"
                }
            ]
        },
        {
            "talkId": "6530705",
            "initDialog": "653070501",
            "dialogues": [
                {
                    "id": "653070501",
                    "speaker": "Player",
                    "text": "加油！"
                },
                {
                    "id": "653070502",
                    "speaker": "薇尔妲",
                    "text": "嗯嗯，我一定会努力的！"
                }
            ]
        },
        {
            "talkId": "6530706",
            "initDialog": "653070601",
            "dialogues": [
                {
                    "id": "653070601",
                    "speaker": "薇尔妲",
                    "text": "看来必须得加倍努力才行啊…啊，对了！之前真是感谢你的出手相助！"
                },
                {
                    "id": "653070602",
                    "speaker": "薇尔妲",
                    "text": "这次帮上了大家的忙，还被瑟琪前辈夸奖了，难道这就是持续不断努力特训的回报？"
                }
            ]
        },
        {
            "talkId": "6530707",
            "initDialog": "653070701",
            "dialogues": [
                {
                    "id": "653070701",
                    "speaker": "Player",
                    "text": "之前的镀金旅团…"
                },
                {
                    "id": "653070702",
                    "speaker": "薇尔妲",
                    "text": "嗯，瑟琪前辈联系了警备队，现在应该已经被「执律庭」的人抓起来啦！"
                },
                {
                    "id": "653070703",
                    "speaker": "薇尔妲",
                    "text": "瑟琪前辈说，「逐影庭」负责找到坏人，这种坏人已经找到的情况，直接把坏人丢给「执律庭」就好！"
                }
            ]
        },
        {
            "talkId": "6530708",
            "initDialog": "653070801",
            "dialogues": [
                {
                    "id": "653070801",
                    "speaker": "Player",
                    "text": "继续努力哦。"
                },
                {
                    "id": "653070802",
                    "speaker": "薇尔妲",
                    "text": "嗯嗯，我一定会努力的！"
                }
            ]
        }
    ]
}