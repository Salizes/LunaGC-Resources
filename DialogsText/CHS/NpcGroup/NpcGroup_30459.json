{
    "groupId": "30459",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "卷舒": 10
    },
    "talks": [
        {
            "talkId": "7153202",
            "initDialog": "715320201",
            "dialogues": [
                {
                    "id": "715320201",
                    "speaker": "卷舒",
                    "text": "#可敬的旅行者{NICKNAME}，有什么需要我做的吗？",
                    "choices": [
                        {
                            "id": "715320202",
                            "text": "关于「熠光云行」的地点…",
                            "response": [
                                {
                                    "id": "715320203",
                                    "speaker": "卷舒",
                                    "text": "嗯！这个问题很有讲究，我和受你鼓舞的冒险家们仔细研究了很久才选出合适的地点——"
                                },
                                {
                                    "id": "715320204",
                                    "speaker": "卷舒",
                                    "text": "「心情低落的人时常在静谧的野外徘徊，远离喧嚣」。"
                                },
                                {
                                    "id": "715320205",
                                    "speaker": "卷舒",
                                    "text": "所以「熠光云行」距离遗珑埠和翘英庄大多不近不远，这样正能让你的光芒照顾更多需要鼓舞的人。"
                                }
                            ]
                        },
                        {
                            "id": "715320206",
                            "text": "关于你自己…",
                            "response": [
                                {
                                    "id": "715320207",
                                    "speaker": "卷舒",
                                    "text": "啊，我自己的经历其实很普通。"
                                },
                                {
                                    "id": "715320208",
                                    "speaker": "卷舒",
                                    "text": "我只是个没有任何特长的民俗研究者，曾在课题陷入停滞时想过改行，为此报考了总务司的岗位，结果落榜了。"
                                },
                                {
                                    "id": "715320209",
                                    "speaker": "卷舒",
                                    "text": "好在，被你鼓舞后，我咬咬牙挺过了资金和认知上的双重难关，才发现完全没有那个必要。"
                                },
                                {
                                    "id": "715320210",
                                    "speaker": "卷舒",
                                    "text": "来到遗珑埠后，我发现沉玉谷有着数不尽的研究题材，一边当说书人学徒，一边钻研文献和民俗故事，每天都过得很充实！"
                                },
                                {
                                    "id": "715320211",
                                    "speaker": "卷舒",
                                    "text": "这一切都多亏了你，再次感谢你！"
                                }
                            ]
                        },
                        {
                            "id": "715320212",
                            "text": "我先走啦，节日快乐！",
                            "response": [
                                {
                                    "id": "715320213",
                                    "speaker": "卷舒",
                                    "text": "海灯节快乐！期待下次与你再见！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}