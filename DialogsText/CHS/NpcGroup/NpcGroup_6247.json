{
    "groupId": "6247",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "因卡纳克": 11
    },
    "talks": [
        {
            "talkId": "6624701",
            "initDialog": "662470101",
            "dialogues": [
                {
                    "id": "662470101",
                    "speaker": "因卡纳克",
                    "text": "果然和能力强的人一起行动，就总能迎接新的挑战。"
                }
            ]
        },
        {
            "talkId": "6624702",
            "initDialog": "662470201",
            "dialogues": [
                {
                    "id": "662470201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "662470202",
                    "speaker": "因卡纳克",
                    "text": "我算是「飞行试炼场」的管理人员吧，这里的很多工作都是由我参与安排的。"
                },
                {
                    "id": "662470203",
                    "speaker": "因卡纳克",
                    "text": "试炼场可是花羽会非常重要的地方，在我心里，重要程度仅次于图腾柱吧。"
                },
                {
                    "id": "662470204",
                    "speaker": "因卡纳克",
                    "text": "毕竟，很多飞行队成员或者准成员的命运，都是在这里决定下来的。"
                },
                {
                    "id": "662470205",
                    "speaker": "因卡纳克",
                    "text": "人的命运跌宕起伏，就像风一样。如果可以，我想成为让大家都能飞起来的那缕。"
                }
            ]
        },
        {
            "talkId": "6624703",
            "initDialog": "662470301",
            "dialogues": [
                {
                    "id": "662470301",
                    "speaker": "Player",
                    "text": "近况如何？"
                },
                {
                    "id": "662470302",
                    "speaker": "因卡纳克",
                    "text": "欢迎回到花羽会，这里一切都好！"
                },
                {
                    "id": "662470303",
                    "speaker": "因卡纳克",
                    "text": "之前的情况可真是惊险啊，还好你是和恰斯卡一样厉害的人，最后顺利解决了问题。"
                },
                {
                    "id": "662470304",
                    "speaker": "因卡纳克",
                    "text": "我也知道有时我提出的方案有点只重效率不顾安全了…"
                },
                {
                    "id": "662470305",
                    "speaker": "因卡纳克",
                    "text": "不过不知怎么的，最后总会有像你们这样的人将它们实施下来，我还真是幸运啊。"
                },
                {
                    "id": "662470306",
                    "speaker": "因卡纳克",
                    "text": "难道说，面对挑战迎难而上，其实是人的天性吗？"
                }
            ]
        },
        {
            "talkId": "6624704",
            "initDialog": "662470401",
            "dialogues": [
                {
                    "id": "662470401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662470402",
                    "speaker": "因卡纳克",
                    "text": "再见！"
                }
            ]
        }
    ]
}