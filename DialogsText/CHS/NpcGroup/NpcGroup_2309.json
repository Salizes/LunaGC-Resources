    "talks": [
        {
            "talkId": "2101801",
            "initDialog": "210180101",
            "dialogues": [
                {
                    "id": "210180101",
                    "speaker": "阿佑",
                    "text": "唉……又跑掉了。啊，是陌生人！"
                }
            ]
        },
        {
            "talkId": "2101802",
            "initDialog": "210180201",
            "dialogues": [
                {
                    "id": "210180201",
                    "speaker": "Player",
                    "text": "要一起玩吗？"
                },
                {
                    "id": "210180202",
                    "speaker": "阿佑",
                    "text": "真的嘛~阿佑不用再和自己的影子玩了吗！那来玩捉迷藏吧，捉迷藏！"
                },
                {
                    "id": "210180203",
                    "speaker": "阿佑",
                    "text": "小六、小星还有东东他们也很早就想玩了，可是一直没有人愿意当鬼，嘿嘿。"
                },
                {
                    "id": "210180204",
                    "speaker": "阿佑",
                    "text": "那等我们藏好，就开始找吧，不许偷看！哦对了！还要通知大家…"
                },
                {
                    "id": "210180205",
                    "speaker": "阿佑",
                    "text": "鬼来啦————！！！"
                }
            ]
        },
        {
            "talkId": "2101803",
            "initDialog": "210180301",
            "dialogues": [
                {
                    "id": "210180301",
                    "speaker": "Player",
                    "text": "我来帮你吧。"
                },
                {
                    "id": "210180302",
                    "speaker": "阿佑",
                    "text": "谢谢，但是我自己就可以做到。"
                },
                {
                    "id": "210180303",
                    "speaker": "阿佑",
                    "text": "我是家里被担心的最多的那一个，我不想要这样。"
                },
                {
                    "id": "210180304",
                    "speaker": "阿佑",
                    "text": "要是我和哥哥一样厉害，那爷爷还有在外面工作的爸爸妈妈就都会放心了吧！"
                }
            ]
        },
        {
            "talkId": "2101804",
            "initDialog": "210180401",
            "dialogues": [
                {
                    "id": "210180401",
                    "speaker": "Player",
                    "text": "为什么不和哥哥一起玩？"
                },
                {
                    "id": "210180402",
                    "speaker": "阿佑",
                    "text": "其实我很想跟他一起玩的，但我哥哥好像不愿意，他很忙，而且…我觉得他有点躲着我。"
                },
                {
                    "id": "210180403",
                    "speaker": "阿佑",
                    "text": "爷爷总是让我做一个懂事的妹妹，我不想给哥哥添麻烦。"
                }
            ]
        },
        {
            "talkId": "2101805",
            "initDialog": "210180501",
            "dialogues": [
                {
                    "id": "210180501",
                    "speaker": "Player",
                    "text": "你在抓什么？"
                },
                {
                    "id": "210180502",
                    "speaker": "阿佑",
                    "text": "我自己的影子，大家都告诉我是抓不到的，我哥哥也这么说。"
                }
            ]
        },
