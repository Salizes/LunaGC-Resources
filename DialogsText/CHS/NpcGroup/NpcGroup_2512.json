{
    "groupId": "2512",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 6,
        "小丁": 20
    },
    "talks": [
        {
            "talkId": "6251201",
            "initDialog": "625120101",
            "dialogues": [
                {
                    "id": "625120101",
                    "speaker": "小丁",
                    "text": "你听说了吗，有关水土的传闻？"
                }
            ]
        },
        {
            "talkId": "6251202",
            "initDialog": "625120201",
            "dialogues": [
                {
                    "id": "625120201",
                    "speaker": "Player",
                    "text": "传闻？"
                },
                {
                    "id": "625120202",
                    "speaker": "小丁",
                    "text": "嘘！让别人听见就不好了！我可只跟你一个人说啊。"
                },
                {
                    "id": "625120203",
                    "speaker": "小丁",
                    "text": "最近那山中的玄文兽越来越多，一定是有妖邪作祟！"
                },
                {
                    "id": "625120204",
                    "speaker": "小丁",
                    "text": "要我说啊，这茶叶的品质不好，肯定也是因为这些妖邪把水土破坏了。"
                }
            ]
        },
        {
            "talkId": "6251203",
            "initDialog": "625120301",
            "dialogues": [
                {
                    "id": "625120301",
                    "speaker": "Player",
                    "text": "传闻？"
                },
                {
                    "id": "625120302",
                    "speaker": "小丁",
                    "text": "嘘！让别人听见就不好了！我可只跟你一个人说啊。"
                },
                {
                    "id": "625120303",
                    "speaker": "小丁",
                    "text": "最近山中有位心善的锦鲤仙人苏醒了，见不得沉玉谷的水土被破坏，叫停了作祟的玄文兽…"
                },
                {
                    "id": "625120304",
                    "speaker": "小丁",
                    "text": "依我看啊，要是这传闻属实，庄里茶叶的品质恢复正常，还不是轻轻松松！"
                },
                {
                    "id": "625120305",
                    "speaker": "小丁",
                    "text": "说不定，还会变得比以前更好！"
                }
            ]
        },
        {
            "talkId": "6251204",
            "initDialog": "625120401",
            "dialogues": [
                {
                    "id": "625120401",
                    "speaker": "Player",
                    "text": "比起传闻，先说说这台机器…"
                },
                {
                    "id": "625120402",
                    "speaker": "小丁",
                    "text": "你倒还挺务实！对传闻不感兴趣，只盯着干活的东西，搞得我都有点不好意思了！"
                },
                {
                    "id": "625120403",
                    "speaker": "小丁",
                    "text": "这是用来烘干茶叶的机器，有些茶叶炒青后，会放到这里来继续加工，去除水分。"
                },
                {
                    "id": "625120404",
                    "speaker": "小丁",
                    "text": "别看这下面的火烧得旺，里头的温度并不算特别高，烘干的过程很慢。"
                },
                {
                    "id": "625120405",
                    "speaker": "小丁",
                    "text": "所以我不用每分每秒都紧盯着机器，这差事暂时还不算累…"
                },
                {
                    "id": "625120406",
                    "speaker": "小丁",
                    "text": "相比之下，老丁那边可就不太能分神了…炒青的活，我现在还干不来啊。"
                }
            ]
        },
        {
            "talkId": "6251205",
            "initDialog": "625120501",
            "dialogues": [
                {
                    "id": "625120501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "625120502",
                    "speaker": "小丁",
                    "text": "走好，下次再见！"
                }
            ]
        },
        {
            "talkId": "6251206",
            "initDialog": "625120601",
            "dialogues": [
                {
                    "id": "625120601",
                    "speaker": "Player",
                    "text": "这未免也太牵强了…"
                },
                {
                    "id": "625120602",
                    "speaker": "小丁",
                    "text": "你可是不知道，这里面的门道可多了去了。"
                },
                {
                    "id": "625120603",
                    "speaker": "小丁",
                    "text": "我看啊，还是要找个方士来驱邪…或者找些大能人来摆平一切！"
                }
            ]
        },
        {
            "talkId": "6251207",
            "initDialog": "625120701",
            "dialogues": [
                {
                    "id": "625120701",
                    "speaker": "Player",
                    "text": "好像勉强也说得通…"
                },
                {
                    "id": "625120702",
                    "speaker": "小丁",
                    "text": "很感人对吧！"
                },
                {
                    "id": "625120703",
                    "speaker": "小丁",
                    "text": "不过，烘茶的工作，还是每天都要做的，日子和以前过得没什么不同…"
                },
                {
                    "id": "625120704",
                    "speaker": "小丁",
                    "text": "要是锦鲤仙人能让茶叶变得更好处理…或者让我的手艺快点进步就好了。"
                }
            ]
        },
        {
            "talkId": "6251208",
            "initDialog": "625120801",
            "dialogues": [
                {
                    "id": "625120801",
                    "speaker": "小丁",
                    "text": "你听说了吗，有关锦鲤仙人的传闻？"
                }
            ]
        }
    ]
}