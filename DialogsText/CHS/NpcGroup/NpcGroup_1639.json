{
    "groupId": "1639",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 3,
        "锋": 22
    },
    "talks": [
        {
            "talkId": "7090901",
            "initDialog": "709090101",
            "dialogues": [
                {
                    "id": "709090101",
                    "speaker": "Player",
                    "text": "你很无聊吗？"
                },
                {
                    "id": "709090102",
                    "speaker": "锋",
                    "text": "那当然了，把魔物赶走了之后就彻底没事做了…"
                },
                {
                    "id": "709090103",
                    "speaker": "锋",
                    "text": "之前少爷还说让我去采些花，结果他和那个姑娘一见面就卿卿我我的…"
                },
                {
                    "id": "709090104",
                    "speaker": "锋",
                    "text": "他们两个，哪里还需要送花什么的，我估计少爷自己都忘了这事儿了…"
                },
                {
                    "id": "709090105",
                    "speaker": "锋",
                    "text": "你要吗？要就拿去吧，反正放我这里也没用。"
                }
            ]
        },
        {
            "talkId": "6163901",
            "initDialog": "616390101",
            "dialogues": [
                {
                    "id": "616390101",
                    "speaker": "锋",
                    "text": "…想干什么？"
                }
            ]
        },
        {
            "talkId": "6163902",
            "initDialog": "616390201",
            "dialogues": [
                {
                    "id": "616390201",
                    "speaker": "锋",
                    "text": "你是？"
                },
                {
                    "id": "616390202",
                    "speaker": "锋",
                    "text": "锋。"
                },
                {
                    "id": "616390203",
                    "speaker": "锋",
                    "text": "歌德老爷子雇来的「铠子」。"
                },
                {
                    "id": "616390204",
                    "speaker": "锋",
                    "text": "听过我名号的话，最好别打「肉」的主意。"
                },
                {
                    "id": "616390205",
                    "speaker": "锋",
                    "text": "铠子？"
                },
                {
                    "id": "616390206",
                    "speaker": "锋",
                    "text": "哼，外行么。"
                },
                {
                    "id": "616390207",
                    "speaker": "锋",
                    "text": "我们那边都这么称呼佣兵，就是替别人挡刀子的。"
                },
                {
                    "id": "616390208",
                    "speaker": "锋",
                    "text": "虽然现在他们叫我私人保镖什么的…不管了。"
                }
            ]
        },
        {
            "talkId": "6163903",
            "initDialog": "616390301",
            "dialogues": [
                {
                    "id": "616390301",
                    "speaker": "锋",
                    "text": "打扰了。"
                },
                {
                    "id": "616390302",
                    "speaker": "锋",
                    "text": "…嗯，走吧。"
                }
            ]
        },
        {
            "talkId": "6163904",
            "initDialog": "616390401",
            "dialogues": [
                {
                    "id": "616390401",
                    "speaker": "锋",
                    "text": "…干嘛？"
                }
            ]
        },
        {
            "talkId": "6163905",
            "initDialog": "616390501",
            "dialogues": [
                {
                    "id": "616390501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "616390502",
                    "speaker": "锋",
                    "text": "拿了歌德老爷子的钱要我护着少爷，又拿了少爷的钱让我把这事对老爷子保密。"
                },
                {
                    "id": "616390503",
                    "speaker": "锋",
                    "text": "想拿双份钱的话，自然就得闭嘴在这儿守着。"
                },
                {
                    "id": "616390504",
                    "speaker": "锋",
                    "text": "哼，有我盯着居然还亲热得起来，不知羞耻的年轻人…"
                },
                {
                    "id": "616390505",
                    "speaker": "锋",
                    "text": "…等等，难道说被我这么盯着反而更加来劲儿？"
                },
                {
                    "id": "616390506",
                    "speaker": "锋",
                    "text": "…可恶，可恶啊…咳咳…"
                }
            ]
        },
        {
            "talkId": "6163906",
            "initDialog": "616390601",
            "dialogues": [
                {
                    "id": "616390601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616390602",
                    "speaker": "锋",
                    "text": "快走吧！"
                }
            ]
        }
    ]
}