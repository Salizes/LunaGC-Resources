    "talks": [
        {
            "talkId": "6510601",
            "initDialog": "651060101",
            "dialogues": [
                {
                    "id": "651060101",
                    "speaker": "柯奈尔",
                    "text": "这样的结局，真令人期待…"
                }
            ]
        },
        {
            "talkId": "6510602",
            "initDialog": "651060201",
            "dialogues": [
                {
                    "id": "651060201",
                    "speaker": "Player",
                    "text": "什么结局？"
                },
                {
                    "id": "651060202",
                    "speaker": "柯奈尔",
                    "text": "当然是戏剧的结局。"
                },
                {
                    "id": "651060203",
                    "speaker": "柯奈尔",
                    "text": "呃…也有可能是连续好几次都还没审完的案件。说实话，在我看来差不多吧。"
                }
            ]
        },
        {
            "talkId": "6510603",
            "initDialog": "651060301",
            "dialogues": [
                {
                    "id": "651060301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651060302",
                    "speaker": "柯奈尔",
                    "text": "嗯，我得再回味下这个故事…"
                }
            ]
        },
        {
            "talkId": "6510604",
            "initDialog": "651060401",
            "dialogues": [
                {
                    "id": "651060401",
                    "speaker": "Player",
                    "text": "是不是太不严肃了？"
                },
                {
                    "id": "651060402",
                    "speaker": "柯奈尔",
                    "text": "有什么关系，罪犯就是罪犯，是犯了错的人，他们造成的案件一定会成为谈资的。"
                },
                {
                    "id": "651060403",
                    "speaker": "柯奈尔",
                    "text": "反正我是遵纪守法的好公民，永远不会触碰法律底线。"
                },
                {
                    "id": "651060404",
                    "speaker": "柯奈尔",
                    "text": "而且多观看庭审，不也是知法学法的途径之一嘛。"
                }
            ]
        }
    ]
}