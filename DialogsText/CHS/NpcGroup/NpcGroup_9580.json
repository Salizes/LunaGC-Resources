{
    "groupId": "9580",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 7,
        "基尼奇": 10,
        "阿乔": 11
    },
    "talks": [
        {
            "talkId": "6958001",
            "initDialog": "695800101",
            "dialogues": [
                {
                    "id": "695800101",
                    "speaker": "阿乔",
                    "text": "哼哼哼，周围的人都在看我，本圣龙的模样果然伟岸惊人！"
                },
                {
                    "id": "695800102",
                    "speaker": "基尼奇",
                    "text": "是因为大家没见过又亮又吵的虫子。"
                },
                {
                    "id": "695800103",
                    "speaker": "阿乔",
                    "text": "基尼奇你说什么？！再说一遍！"
                }
            ]
        },
        {
            "talkId": "6958002",
            "initDialog": "695800201",
            "dialogues": [
                {
                    "id": "695800201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958003",
            "initDialog": "695800301",
            "dialogues": [
                {
                    "id": "695800301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695800302",
                    "speaker": "基尼奇",
                    "text": "稍后我会离开，还有事情要办。"
                },
                {
                    "id": "695800303",
                    "speaker": "阿乔",
                    "text": "嘁，不懂休息的家伙…"
                }
            ]
        },
        {
            "talkId": "6958004",
            "initDialog": "695800401",
            "dialogues": [
                {
                    "id": "695800401",
                    "speaker": "基尼奇",
                    "text": "是我运气稍好，要再来一局么？"
                },
                {
                    "id": "695800402",
                    "speaker": "阿乔",
                    "text": "嘁，无论输赢，你的表情怎么都一模一样？真没劲…"
                }
            ]
        },
        {
            "talkId": "6958005",
            "initDialog": "695800501",
            "dialogues": [
                {
                    "id": "695800501",
                    "speaker": "阿乔",
                    "text": "你这笨蛋！白费了本圣龙这么多口舌！"
                },
                {
                    "id": "695800502",
                    "speaker": "基尼奇",
                    "text": "也没有其他更值得安放你口舌的地方。"
                }
            ]
        },
        {
            "talkId": "6958006",
            "initDialog": "695800601",
            "dialogues": [
                {
                    "id": "695800601",
                    "speaker": "基尼奇",
                    "text": "可以。我平时也玩过几局这种游戏。"
                },
                {
                    "id": "695800602",
                    "speaker": "阿乔",
                    "text": "都是靠我指导你才能赢！"
                }
            ]
        },
        {
            "talkId": "6958008",
            "initDialog": "695800801",
            "dialogues": [
                {
                    "id": "695800801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958009",
            "initDialog": "695800901",
            "dialogues": [
                {
                    "id": "695800901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958010",
            "initDialog": "695801001",
            "dialogues": [
                {
                    "id": "695801001",
                    "speaker": "阿乔",
                    "text": "看见本伟大圣龙库胡勒阿乔的实力了吧？哇哈哈哈哈。"
                },
                {
                    "id": "695801002",
                    "speaker": "基尼奇",
                    "text": "全是馊主意。"
                }
            ]
        },
        {
            "talkId": "6958011",
            "initDialog": "695801101",
            "dialogues": [
                {
                    "id": "695801101",
                    "speaker": "基尼奇",
                    "text": "嗯，是你赢了。"
                },
                {
                    "id": "695801102",
                    "speaker": "阿乔",
                    "text": "你嗯什么？！听本圣龙的指示这一局能输吗？！"
                }
            ]
        },
        {
            "talkId": "6958012",
            "initDialog": "695801201",
            "dialogues": [
                {
                    "id": "695801201",
                    "speaker": "阿乔",
                    "text": "我的仆从，只要本伟大圣龙库胡勒阿乔在旁，你绝对不可能输！"
                },
                {
                    "id": "695801202",
                    "speaker": "基尼奇",
                    "text": "那你退下吧，玩游戏要公平才行。"
                }
            ]
        },
        {
            "talkId": "6958014",
            "initDialog": "695801401",
            "dialogues": [
                {
                    "id": "695801401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958015",
            "initDialog": "695801501",
            "dialogues": [
                {
                    "id": "695801501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958016",
            "initDialog": "695801601",
            "dialogues": [
                {
                    "id": "695801601",
                    "speaker": "基尼奇",
                    "text": "你的发挥有些失常，是阿乔吵到你了吗？稍后，我们单独再来一局吧。"
                },
                {
                    "id": "695801602",
                    "speaker": "阿乔",
                    "text": "我那是在给你出主意！没良心的臭蛋。"
                }
            ]
        },
        {
            "talkId": "6958017",
            "initDialog": "695801701",
            "dialogues": [
                {
                    "id": "695801701",
                    "speaker": "阿乔",
                    "text": "笨蛋基尼奇！这局也能输？伟大圣龙都快被你气笑了。"
                },
                {
                    "id": "695801702",
                    "speaker": "基尼奇",
                    "text": "你行你上。"
                }
            ]
        },
        {
            "talkId": "6958018",
            "initDialog": "695801801",
            "dialogues": [
                {
                    "id": "695801801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}