{
    "groupId": "4315",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "库玛莉": 10
    },
    "talks": [
        {
            "talkId": "6431501",
            "initDialog": "643150101",
            "dialogues": [
                {
                    "id": "643150101",
                    "speaker": "库玛莉",
                    "text": "我的梦想，就是长大后变成像妮露姐姐一样厉害的舞者！"
                }
            ]
        },
        {
            "talkId": "6431502",
            "initDialog": "643150201",
            "dialogues": [
                {
                    "id": "643150201",
                    "speaker": "Player",
                    "text": "关于跳舞…"
                },
                {
                    "id": "643150202",
                    "speaker": "库玛莉",
                    "text": "你说，为什么爸爸不让我学跳舞呢？"
                },
                {
                    "id": "643150203",
                    "speaker": "库玛莉",
                    "text": "爸爸说，在须弥，跳舞会被人瞧不起。为了未来能过上好的生活，比起学跳舞我更应该好好上学。"
                },
                {
                    "id": "643150204",
                    "speaker": "库玛莉",
                    "text": "但是…但是，会跳舞的妮露姐姐明明就很厉害，大家都很喜欢她…"
                },
                {
                    "id": "643150205",
                    "speaker": "库玛莉",
                    "text": "难道学习成绩好，是比跳舞好更受欢迎的事情吗？"
                }
            ]
        },
        {
            "talkId": "6431503",
            "initDialog": "643150301",
            "dialogues": [
                {
                    "id": "643150301",
                    "speaker": "Player",
                    "text": "关于妮露…"
                },
                {
                    "id": "643150302",
                    "speaker": "库玛莉",
                    "text": "我最喜欢妮露姐姐了！她好漂亮，声音也好听，跳舞也好看…"
                },
                {
                    "id": "643150303",
                    "speaker": "库玛莉",
                    "text": "我每次见到妮露姐姐时，她都笑得很开心，还会让我摸她头上的首饰。"
                },
                {
                    "id": "643150304",
                    "speaker": "库玛莉",
                    "text": "我最喜欢的节日就是「花神诞日」了，在祭典上不仅能从花之骑士那里领到糖果，还可以看到妮露姐姐跳最好看的舞蹈！"
                }
            ]
        },
        {
            "talkId": "6431504",
            "initDialog": "643150401",
            "dialogues": [
                {
                    "id": "643150401",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "643150402",
                    "speaker": "库玛莉",
                    "text": "我会的！"
                }
            ]
        },
        {
            "talkId": "7394601",
            "initDialog": "739460101",
            "dialogues": [
                {
                    "id": "739460101",
                    "speaker": "Player",
                    "text": "我也很期待。"
                },
                {
                    "id": "739460102",
                    "speaker": "库玛莉",
                    "text": "那你一定不能错过哦！祝你能亲眼见到妮露姐姐的舞蹈，还能吃上最甜的糖！"
                }
            ]
        }
    ]
}