{
    "groupId": "4407",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 4,
        "杰巴里": 2,
        "萨尼娅": 20
    },
    "talks": [
        {
            "talkId": "6440701",
            "initDialog": "644070101",
            "dialogues": [
                {
                    "id": "644070101",
                    "speaker": "萨尼娅",
                    "text": "数数口袋里的摩拉，又只剩这么几个了…"
                },
                {
                    "id": "644070102",
                    "speaker": "萨尼娅",
                    "text": "再这样下去的话，日子真的要过不下去了！"
                },
                {
                    "id": "644070103",
                    "speaker": "杰巴里",
                    "text": "你、你先别急…"
                },
                {
                    "id": "644070104",
                    "speaker": "杰巴里",
                    "text": "你看，我这不是最近刚做了些手工活儿，给家里换了不少吃的回来吗？"
                },
                {
                    "id": "644070105",
                    "speaker": "萨尼娅",
                    "text": "所以呢？就这么过一天算一天吗？如果有一天你做的东西换不到钱，又该怎么办呢？"
                },
                {
                    "id": "644070106",
                    "speaker": "萨尼娅",
                    "text": "我和你不一样，不是只看眼前的人，不可能不急的！"
                },
                {
                    "id": "644070107",
                    "speaker": "萨尼娅",
                    "text": "唉，有时候我会想，这个家里是不是只有我一个人对未来上心…"
                }
            ]
        },
        {
            "talkId": "6440702",
            "initDialog": "644070201",
            "dialogues": [
                {
                    "id": "644070201",
                    "speaker": "萨尼娅",
                    "text": "唉，真让人发愁…"
                }
            ]
        },
        {
            "talkId": "6440703",
            "initDialog": "644070301",
            "dialogues": [
                {
                    "id": "644070301",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "644070302",
                    "speaker": "萨尼娅",
                    "text": "现在还好，明天就说不定了。"
                },
                {
                    "id": "644070303",
                    "speaker": "萨尼娅",
                    "text": "摊上这样一个老公，每天都过着入不敷出的日子。"
                },
                {
                    "id": "644070304",
                    "speaker": "萨尼娅",
                    "text": "我也不指望他能赚大钱，但至少要有稳定的收入来源吧。"
                },
                {
                    "id": "644070305",
                    "speaker": "萨尼娅",
                    "text": "结果他除了做饭以外，真是什么都不会。"
                },
                {
                    "id": "644070306",
                    "speaker": "萨尼娅",
                    "text": "阿如村的人就这么点，大家都是自己做饭过日子的，谁会花钱在外边买饭吃呢？"
                },
                {
                    "id": "644070307",
                    "speaker": "萨尼娅",
                    "text": "他倒好，不仅赚不到钱，还把做好的饭到处送人！"
                }
            ]
        },
        {
            "talkId": "6440704",
            "initDialog": "644070401",
            "dialogues": [
                {
                    "id": "644070401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644070402",
                    "speaker": "萨尼娅",
                    "text": "再见…我再看看最近有哪些地方的花销可以省下来吧。"
                }
            ]
        },
        {
            "talkId": "6440705",
            "initDialog": "644070501",
            "dialogues": [
                {
                    "id": "644070501",
                    "speaker": "Player",
                    "text": "好好和他谈谈呢？"
                },
                {
                    "id": "644070502",
                    "speaker": "萨尼娅",
                    "text": "谈也谈过了，骂也骂过了。"
                },
                {
                    "id": "644070503",
                    "speaker": "萨尼娅",
                    "text": "也曾想过走出村子找点活干，但他一会儿说舍不得家乡，一会儿又说对湿气过敏…"
                },
                {
                    "id": "644070504",
                    "speaker": "萨尼娅",
                    "text": "说到最后，就是舍不得留我一个人在村子里。都到这个份上了，我还能说什么？"
                },
                {
                    "id": "644070505",
                    "speaker": "萨尼娅",
                    "text": "他人倒是善良得很，善良到散家财去帮助别人。"
                },
                {
                    "id": "644070506",
                    "speaker": "萨尼娅",
                    "text": "我不是说帮助别人是坏事，但也要看看自己家的条件，对吧？"
                }
            ]
        },
        {
            "talkId": "6440706",
            "initDialog": "644070601",
            "dialogues": [
                {
                    "id": "644070601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6440707",
            "initDialog": "644070701",
            "dialogues": [
                {
                    "id": "644070701",
                    "speaker": "萨尼娅",
                    "text": "赢得有点艰难…我想问问你…我的实力算得上专业吗？"
                }
            ]
        },
        {
            "talkId": "6440708",
            "initDialog": "644070801",
            "dialogues": [
                {
                    "id": "644070801",
                    "speaker": "萨尼娅",
                    "text": "还是不行啊…我还得再练练！"
                }
            ]
        }
    ]
}