    "talks": [
        {
            "talkId": "6641301",
            "initDialog": "664130101",
            "dialogues": [
                {
                    "id": "664130101",
                    "speaker": "迷灰中的石碑·其二",
                    "text": "在失色的领域中…似乎无法阅读上面的文字…"
                }
            ]
        },
        {
            "talkId": "6641302",
            "initDialog": "664130201",
            "dialogues": [
                {
                    "id": "664130201",
                    "speaker": "迷灰中的石碑·其二",
                    "text": "（遭岁月磨损，字迹模糊的石碑，余留的文字断断续续写着…）"
                },
                {
                    "id": "664130202",
                    "speaker": "迷灰中的石碑·其二",
                    "text": "「…白日，白袍的贤者将如曜环般的金文刻入石龙。」"
                },
                {
                    "id": "664130203",
                    "speaker": "迷灰中的石碑·其二",
                    "text": "「『你们须对此石龙礼敬，日日祭拜，方可…』」"
                },
                {
                    "id": "664130204",
                    "speaker": "迷灰中的石碑·其二",
                    "text": "「此后…众祭司如斯行事，烬城余灰自此不再遍覆…」"
                }
            ]
        }
    ]
}