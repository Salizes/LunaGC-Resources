{
    "groupId": "5272",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "米勒洛": 10
    },
    "talks": [
        {
            "talkId": "6527201",
            "initDialog": "652720101",
            "dialogues": [
                {
                    "id": "652720101",
                    "speaker": "米勒洛",
                    "text": "嗯？你对「互助会」感兴趣吗？要不要进一步了解下？我很乐意为你介绍。"
                }
            ]
        },
        {
            "talkId": "6527202",
            "initDialog": "652720201",
            "dialogues": [
                {
                    "id": "652720201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "652720202",
                    "speaker": "米勒洛",
                    "text": "如你所见，我正在宣传互助会的理念，希望有更多人愿意加入我们。"
                }
            ]
        },
        {
            "talkId": "6527203",
            "initDialog": "652720301",
            "dialogues": [
                {
                    "id": "652720301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652720302",
                    "speaker": "米勒洛",
                    "text": "啊…再见。如果需要帮忙的话，可以随时来找我。"
                }
            ]
        },
        {
            "talkId": "6527204",
            "initDialog": "652720401",
            "dialogues": [
                {
                    "id": "652720401",
                    "speaker": "Player",
                    "text": "看起来好像没什么人愿意来。"
                },
                {
                    "id": "652720402",
                    "speaker": "米勒洛",
                    "text": "没想到你一眼就看出来了互助会的窘境…"
                },
                {
                    "id": "652720403",
                    "speaker": "米勒洛",
                    "text": "没错，互助会只是个小帮派，很少有人对我们感兴趣，更别提加入我们了。"
                },
                {
                    "id": "652720404",
                    "speaker": "米勒洛",
                    "text": "但我仍然认为自己的工作很有意义。"
                },
                {
                    "id": "652720405",
                    "speaker": "米勒洛",
                    "text": "我刚来梅洛彼得堡时，内心充满了迷茫，每天浑浑噩噩地活着，不敢思考任何有关未来的事情。"
                },
                {
                    "id": "652720406",
                    "speaker": "米勒洛",
                    "text": "直到加入互助会后，我才慢慢明白世上仍有许多「我能做的事」。"
                },
                {
                    "id": "652720407",
                    "speaker": "米勒洛",
                    "text": "哪怕只是些微不足道的小事，也让我感到满足…"
                },
                {
                    "id": "652720408",
                    "speaker": "米勒洛",
                    "text": "我希望能把这种心情传达给更多的人，帮助他们完成蜕变，重新站到阳光下。"
                }
            ]
        }
    ]
}