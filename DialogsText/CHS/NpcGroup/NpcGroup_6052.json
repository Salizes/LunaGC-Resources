{
    "groupId": "6052",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "库希马纳": 13
    },
    "talks": [
        {
            "talkId": "6605201",
            "initDialog": "660520101",
            "dialogues": [
                {
                    "id": "660520101",
                    "speaker": "库希马纳",
                    "text": "你好…我们见过吗？"
                },
                {
                    "id": "660520102",
                    "speaker": "库希马纳",
                    "text": "抱歉，我有点不擅长认人…"
                }
            ]
        },
        {
            "talkId": "6605202",
            "initDialog": "660520201",
            "dialogues": [
                {
                    "id": "660520201",
                    "speaker": "Player",
                    "text": "视力不好吗？"
                },
                {
                    "id": "660520202",
                    "speaker": "库希马纳",
                    "text": "不能说是视力问题吧，我只是在看人的时候有些脸盲。"
                },
                {
                    "id": "660520203",
                    "speaker": "库希马纳",
                    "text": "有的人明明已经见过很多次，还一起聊过天，下次见面却还是认不出来…"
                },
                {
                    "id": "660520204",
                    "speaker": "库希马纳",
                    "text": "尤其是他们换了衣服或者配饰的时候，就更难辨认了。"
                },
                {
                    "id": "660520205",
                    "speaker": "库希马纳",
                    "text": "相反，我对动物的长相倒是很敏感，绝对不会认错。"
                },
                {
                    "id": "660520206",
                    "speaker": "库希马纳",
                    "text": "嘿嘿，我画了很多动物速写呢，每一只都用专门的标签分类了！"
                }
            ]
        },
        {
            "talkId": "6605203",
            "initDialog": "660520301",
            "dialogues": [
                {
                    "id": "660520301",
                    "speaker": "Player",
                    "text": "没关系。"
                },
                {
                    "id": "660520302",
                    "speaker": "库希马纳",
                    "text": "那，期待下次再见，希望我还能认出你来。"
                }
            ]
        },
        {
            "talkId": "6605204",
            "initDialog": "660520401",
            "dialogues": [
                {
                    "id": "660520401",
                    "speaker": "Player",
                    "text": "要不要试试给人画速写？"
                },
                {
                    "id": "660520402",
                    "speaker": "库希马纳",
                    "text": "实不相瞒，我尝试过，但别说见第二面，我在整理标签的时候就失败了…"
                },
                {
                    "id": "660520403",
                    "speaker": "库希马纳",
                    "text": "有时会因为他们戴了颜色差不多的帽子，就不小心分到一个本子里去了。"
                },
                {
                    "id": "660520404",
                    "speaker": "库希马纳",
                    "text": "久而久之，认识我的人也都知道我有这个毛病，不会因为我认错人而怪罪我啦。"
                },
                {
                    "id": "660520405",
                    "speaker": "库希马纳",
                    "text": "大家反而很高兴能有我这样很会识别动物的人呢。"
                },
                {
                    "id": "660520406",
                    "speaker": "库希马纳",
                    "text": "你能想象吗，在他们眼里，所有同一种类的动物竟然长得都一样呢！"
                }
            ]
        }
    ]
}