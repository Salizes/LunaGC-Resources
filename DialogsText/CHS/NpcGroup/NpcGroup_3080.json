{
    "groupId": "3080",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 7,
        "瓦希德": 22
    },
    "talks": [
        {
            "talkId": "6308001",
            "initDialog": "630800101",
            "dialogues": [
                {
                    "id": "630800101",
                    "speaker": "瓦希德",
                    "text": "哦！客官来搭话，莫非是对「丰沃之惠」感兴趣吗？"
                }
            ]
        },
        {
            "talkId": "6308002",
            "initDialog": "630800201",
            "dialogues": [
                {
                    "id": "630800201",
                    "speaker": "Player",
                    "text": "「丰沃之惠」？"
                },
                {
                    "id": "630800202",
                    "speaker": "瓦希德",
                    "text": "客官没听说过吗？"
                },
                {
                    "id": "630800203",
                    "speaker": "瓦希德",
                    "text": "这是我们须弥的特产，是「小吉祥草王」的恩赐！"
                },
                {
                    "id": "630800204",
                    "speaker": "瓦希德",
                    "text": "无论多么贫瘠的土地、多么恶劣的环境，只要加入了一点点就会有无与伦比的效果！"
                }
            ]
        },
        {
            "talkId": "6308003",
            "initDialog": "630800301",
            "dialogues": [
                {
                    "id": "630800301",
                    "speaker": "Player",
                    "text": "关于这家店…"
                },
                {
                    "id": "630800302",
                    "speaker": "瓦希德",
                    "text": "小店「葱茏之愿」专门售卖须弥特产。"
                },
                {
                    "id": "630800303",
                    "speaker": "瓦希德",
                    "text": "除了本店的主打产品「丰沃之惠」外，还有从道成林里小心采摘来的「超美味树王圣体菇」…"
                },
                {
                    "id": "630800304",
                    "speaker": "瓦希德",
                    "text": "这些特产都是远渡重洋、从须弥本地运来的，客官尽管放心，童叟无欺！"
                }
            ]
        },
        {
            "talkId": "6308004",
            "initDialog": "630800401",
            "dialogues": [
                {
                    "id": "630800401",
                    "speaker": "Player",
                    "text": "谢谢，再见。"
                },
                {
                    "id": "630800402",
                    "speaker": "瓦希德",
                    "text": "呃，好吧，欢迎您下次光临。"
                }
            ]
        },
        {
            "talkId": "6308005",
            "initDialog": "630800501",
            "dialogues": [
                {
                    "id": "630800501",
                    "speaker": "Player",
                    "text": "这是什么原理？"
                },
                {
                    "id": "630800502",
                    "speaker": "瓦希德",
                    "text": "呃，这个这个…应该是元素力会让土地变得更有活力，然后那个那个…"
                },
                {
                    "id": "630800503",
                    "speaker": "瓦希德",
                    "text": "咳咳，我不是搞学术的，我也说不清楚，反正我们须弥人种地都用这个，效果好得很。"
                },
                {
                    "id": "630800504",
                    "speaker": "瓦希德",
                    "text": "无论是自己种地还是送给亲朋好友，都是上佳的礼物啊！"
                }
            ]
        },
        {
            "talkId": "6308006",
            "initDialog": "630800601",
            "dialogues": [
                {
                    "id": "630800601",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "630800602",
                    "speaker": "瓦希德",
                    "text": "这话问得，那当然…"
                },
                {
                    "id": "630800603",
                    "speaker": "瓦希德",
                    "text": "…唉，算了，我就和您说实话吧。"
                },
                {
                    "id": "630800604",
                    "speaker": "瓦希德",
                    "text": "「锁国令」之前还偶尔有从鸣神岛来的稻妻人照顾生意。"
                },
                {
                    "id": "630800605",
                    "speaker": "瓦希德",
                    "text": "可自从「锁国令」颁布之后，客流少了，生意是每况愈下，也不知道还能撑多久…"
                },
                {
                    "id": "630800606",
                    "speaker": "瓦希德",
                    "text": "客官，您要来点「丰沃之惠」吗？就当是旅行的纪念品，怎么样？"
                }
            ]
        },
        {
            "talkId": "6308007",
            "initDialog": "630800701",
            "dialogues": [
                {
                    "id": "630800701",
                    "speaker": "Player",
                    "text": "不用了。"
                },
                {
                    "id": "630800702",
                    "speaker": "瓦希德",
                    "text": "哈，哈哈…"
                },
                {
                    "id": "630800703",
                    "speaker": "瓦希德",
                    "text": "唉，也是啊，谁会拿肥料当旅行的纪念品呢…"
                }
            ]
        },
        {
            "talkId": "6308008",
            "initDialog": "630800801",
            "dialogues": [
                {
                    "id": "630800801",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "630800802",
                    "speaker": "瓦希德",
                    "text": "唔…怎么说呢…"
                },
                {
                    "id": "630800803",
                    "speaker": "瓦希德",
                    "text": "本以为锁国令解除之后，生意会有很大起色，但实际上却没有好上太多。"
                },
                {
                    "id": "630800804",
                    "speaker": "瓦希德",
                    "text": "来订购肥料的客户还是那老几位，而且他们还总是忘记使用方法…"
                },
                {
                    "id": "630800805",
                    "speaker": "瓦希德",
                    "text": "客官，您要来点「丰沃之惠」吗？就当是旅行的纪念品，怎么样？"
                }
            ]
        }
    ]
}