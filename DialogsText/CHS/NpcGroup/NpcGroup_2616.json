{
    "groupId": "2616",
    "total_dialogue_lines": 82,
    "speaker_counts": {
        "Player": 16,
        "克里托夫": 5,
        "志琼": 9,
        "派蒙": 4,
        "瑾武": 48
    },
    "talks": [
        {
            "talkId": "6261601",
            "initDialog": "626160101",
            "dialogues": [
                {
                    "id": "626160101",
                    "speaker": "瑾武",
                    "text": "哈哈，你回来了。请随便休息一下吧，把这里当自己家就好！"
                }
            ]
        },
        {
            "talkId": "6261602",
            "initDialog": "626160201",
            "dialogues": [
                {
                    "id": "626160201",
                    "speaker": "Player",
                    "text": "很难把这里当自己家…"
                },
                {
                    "id": "626160202",
                    "speaker": "瑾武",
                    "text": "嗨，都待在这边这么久了，不应该比家还熟悉吗？"
                },
                {
                    "id": "626160203",
                    "speaker": "瑾武",
                    "text": "再说了，这里其实也还不错，虽然见不到阳光，但是也不用担心风霜雨雪。"
                },
                {
                    "id": "626160204",
                    "speaker": "瑾武",
                    "text": "反正啊，我在矿下待了这么久，前一段时间在上面反而不习惯了。"
                }
            ]
        },
        {
            "talkId": "6261603",
            "initDialog": "626160301",
            "dialogues": [
                {
                    "id": "626160301",
                    "speaker": "Player",
                    "text": "关于现状…"
                },
                {
                    "id": "626160302",
                    "speaker": "瑾武",
                    "text": "多亏了你的帮助，营地的氛围也轻松了许多。如果之前我让你感觉太严肃紧张的话，实在是对不起。"
                },
                {
                    "id": "626160303",
                    "speaker": "瑾武",
                    "text": "要紧事务已经完成了，现在留给我们的是长期工作。也就是…常驻地下，关注异变情况。"
                }
            ]
        },
        {
            "talkId": "6261604",
            "initDialog": "626160401",
            "dialogues": [
                {
                    "id": "626160401",
                    "speaker": "Player",
                    "text": "关于以后…"
                },
                {
                    "id": "626160402",
                    "speaker": "瑾武",
                    "text": "过一段时间或许矿坑就可以部分开放了，但这么深的地下还不行。"
                },
                {
                    "id": "626160403",
                    "speaker": "瑾武",
                    "text": "我们要负责封锁这片区域，不能让矿工…不，不能让任何人下到这里来。"
                }
            ]
        },
        {
            "talkId": "6261605",
            "initDialog": "626160501",
            "dialogues": [
                {
                    "id": "626160501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "626160502",
                    "speaker": "瑾武",
                    "text": "好嘞，去各处冒险也都小心点。"
                }
            ]
        },
        {
            "talkId": "6261606",
            "initDialog": "626160601",
            "dialogues": [
                {
                    "id": "626160601",
                    "speaker": "Player",
                    "text": "关于志琼…"
                },
                {
                    "id": "626160602",
                    "speaker": "瑾武",
                    "text": "她吗…我还没有收到她的消息。"
                },
                {
                    "id": "626160603",
                    "speaker": "瑾武",
                    "text": "沐宁派来了一些人帮忙搜寻，也在那里发现了一些通向不明的密道…"
                },
                {
                    "id": "626160604",
                    "speaker": "瑾武",
                    "text": "但继续往深处探索实在太危险了…真不知道那孩子去了哪里…"
                },
                {
                    "id": "626160605",
                    "speaker": "瑾武",
                    "text": "更不知道如果哪天她回来了，我是该揍她一顿，还是该给她做碗热汤…"
                }
            ]
        },
        {
            "talkId": "7103707",
            "initDialog": "710370701",
            "dialogues": [
                {
                    "id": "710370701",
                    "speaker": "瑾武",
                    "text": "啊，你来了。怎么？来找我加工流明石「触媒」吗？",
                    "choices": [
                        {
                            "id": "710370702",
                            "text": "加工流明石「触媒」…"
                        },
                        {
                            "id": "710370703",
                            "text": "再见。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7103729",
            "initDialog": "710372901",
            "dialogues": [
                {
                    "id": "710372901",
                    "speaker": "瑾武",
                    "text": "啊，你来了。怎么？来找我加工流明石「触媒」吗？",
                    "choices": [
                        {
                            "id": "710372902",
                            "text": "加工流明石「触媒」…"
                        },
                        {
                            "id": "710372903",
                            "text": "再见。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7104201",
            "initDialog": "710420101",
            "dialogues": [
                {
                    "id": "710420101",
                    "speaker": "瑾武",
                    "text": "啊，你们回来了。"
                },
                {
                    "id": "710420102",
                    "speaker": "瑾武",
                    "text": "嗯…克里托夫？你来这里做什么？"
                },
                {
                    "id": "710420103",
                    "speaker": "克里托夫",
                    "text": "嘿嘿…这个嘛…"
                },
                {
                    "id": "710420104",
                    "speaker": "志琼",
                    "text": "瑾武姐也认得这家伙？"
                },
                {
                    "id": "710420105",
                    "speaker": "瑾武",
                    "text": "嗯，认得。矿上卖假药的。到处兜售什么「大汉药水」，工人们买来一看，都是落落莓糖浆。"
                },
                {
                    "id": "710420106",
                    "speaker": "瑾武",
                    "text": "不过…无毒无害，便宜不难喝，还专门冰镇过。比大老远上城里采购饮料实惠多了。"
                },
                {
                    "id": "710420107",
                    "speaker": "瑾武",
                    "text": "怎么？几年没见，跟盗宝团混了？"
                },
                {
                    "id": "710420108",
                    "speaker": "克里托夫",
                    "text": "嗯…可以这么说吧…哈哈…"
                },
                {
                    "id": "710420109",
                    "speaker": "志琼",
                    "text": "大姐怎么知道他是…"
                },
                {
                    "id": "710420110",
                    "speaker": "瑾武",
                    "text": "哈哈，你不知道的还多着呢。矿下二十来年不见天日，我是白干的吗？"
                },
                {
                    "id": "710420111",
                    "speaker": "瑾武",
                    "text": "脸上的矿灰好洗，手上染的颜色是洗不掉咯。"
                },
                {
                    "id": "710420112",
                    "speaker": "瑾武",
                    "text": "好了，告诉我，你有什么用？勘探队的物资可喂不饱卖呆耍闲的人。",
                    "choices": [
                        {
                            "id": "710420113",
                            "text": "他说他会调配炸药。",
                            "response": [
                                {
                                    "id": "710420119",
                                    "speaker": "瑾武",
                                    "text": "嗯。之前学的炼金术派上用场了，是吧？不错，我们正好还缺一个爆破组。"
                                },
                                {
                                    "id": "710420120",
                                    "speaker": "志琼",
                                    "text": "可我们不是已经从蒙德联络了一位爆破手吗？为什么一定要信任他？"
                                },
                                {
                                    "id": "710420121",
                                    "speaker": "瑾武",
                                    "text": "啊，你说她呀。沐宁今早收到蒙德那边的致歉信，那孩子因为…唔，炸了「猎鹿人」的灶台？被关了禁闭…"
                                },
                                {
                                    "id": "710420122",
                                    "speaker": "瑾武",
                                    "text": "就连预计要一起来的那位，她的监护人…什么骑兵队长的…也一并被关了禁闭。"
                                },
                                {
                                    "id": "710420123",
                                    "speaker": "瑾武",
                                    "text": "看不明白，不知道是蒙德人的暗号还是什么。反正她来不了了。"
                                },
                                {
                                    "id": "710420124",
                                    "speaker": "派蒙",
                                    "text": "唔…会是谁呢…？",
                                    "choices": [
                                        {
                                            "id": "710420125",
                                            "text": "该说是幸好呢，还是不幸呢…",
                                            "response": [
                                                {
                                                    "id": "710420127",
                                                    "speaker": "瑾武",
                                                    "text": "#哼，{NICKNAME}你们也这么觉得吗？你走运了，克里托夫。"
                                                },
                                                {
                                                    "id": "710420128",
                                                    "speaker": "瑾武",
                                                    "text": "志琼，别发牢骚了。这位克里托夫也是蒙德人，名字也差不太多。能派上用场就行。"
                                                },
                                                {
                                                    "id": "710420129",
                                                    "speaker": "克里托夫",
                                                    "text": "呼…感谢瑾武姐给我机会！所以…我现在也是勘探队的一员了吗？"
                                                },
                                                {
                                                    "id": "710420130",
                                                    "speaker": "瑾武",
                                                    "text": "先证明你的用处再说。"
                                                },
                                                {
                                                    "id": "710420131",
                                                    "speaker": "志琼",
                                                    "text": "哼，我是不相信这个家伙。爆破组可是性命攸关的关键岗位，他是个盗宝团…"
                                                },
                                                {
                                                    "id": "710420132",
                                                    "speaker": "瑾武",
                                                    "text": "你也是，少说话。"
                                                },
                                                {
                                                    "id": "710420133",
                                                    "speaker": "瑾武",
                                                    "text": "我认识这小子的时间比你长，他本性不坏，又没有足够的勇气做坏事。给他点时间看看吧。"
                                                },
                                                {
                                                    "id": "710420134",
                                                    "speaker": "瑾武",
                                                    "text": "嗯…除了介绍新朋友，你们还有别的什么事吗？"
                                                },
                                                {
                                                    "id": "710420135",
                                                    "speaker": "志琼",
                                                    "text": "是这样的，通往下层矿区的道路被碎石封锁了，我们需要用上「开山炮」打开一条通道。"
                                                },
                                                {
                                                    "id": "710420136",
                                                    "speaker": "瑾武",
                                                    "text": "噗…开山…「开山炮」…哈哈哈哈…！"
                                                },
                                                {
                                                    "id": "710420137",
                                                    "speaker": "派蒙",
                                                    "text": "欸？你笑什么呀！",
                                                    "choices": [
                                                        {
                                                            "id": "710420138",
                                                            "text": "哈哈，很好笑。",
                                                            "response": [
                                                                {
                                                                    "id": "710420142",
                                                                    "speaker": "瑾武",
                                                                    "text": "噗…抱歉…哈哈，虽然挺老土的，但我们工程组都管那叫「安全距离爆破机关·贰壹伍陆型」。"
                                                                },
                                                                {
                                                                    "id": "710420143",
                                                                    "speaker": "瑾武",
                                                                    "text": "不过「开山炮」也不错，挺可爱的外号。"
                                                                },
                                                                {
                                                                    "id": "710420144",
                                                                    "speaker": "瑾武",
                                                                    "text": "如果你们要使用那门炮的话…可惜我不是爆破组，而且我需要在这里守护营地…但我想那附近应该会有使用指南。"
                                                                },
                                                                {
                                                                    "id": "710420145",
                                                                    "speaker": "瑾武",
                                                                    "text": "啊…对，还有就是设备库的钥匙，应该分别藏在了两处滤水器附近。我给你们在地图上标出来…"
                                                                },
                                                                {
                                                                    "id": "710420146",
                                                                    "speaker": "派蒙",
                                                                    "text": "什么嘛…一点也不隐蔽…简直就像是在家门口的脚垫下放钥匙一样粗心大意！"
                                                                },
                                                                {
                                                                    "id": "710420147",
                                                                    "speaker": "瑾武",
                                                                    "text": "话是这么说，不过层岩巨渊本身也不是一般人能够下来的。即使那些别有所图的人下来了…"
                                                                },
                                                                {
                                                                    "id": "710420148",
                                                                    "speaker": "瑾武",
                                                                    "text": "也未必能第一时间想到，两枚钥匙全都藏在这么明显的地方。你说对吧，盗宝团朋友？"
                                                                },
                                                                {
                                                                    "id": "710420149",
                                                                    "speaker": "克里托夫",
                                                                    "text": "唔…二哥确实没能找到库房的钥匙。"
                                                                },
                                                                {
                                                                    "id": "710420150",
                                                                    "speaker": "志琼",
                                                                    "text": "笨蛋不作数啦…咳咳，接下来我还要继续地图勘探…克里托夫这家伙需要劳烦前辈您盯牢了。"
                                                                },
                                                                {
                                                                    "id": "710420151",
                                                                    "speaker": "Player",
                                                                    "text": "你不担心克里托夫吗？"
                                                                },
                                                                {
                                                                    "id": "710420152",
                                                                    "speaker": "志琼",
                                                                    "text": "哼…我也会随时小心他的，谁知道他什么时候会把我们都害了。就算瑾武姐对他抱有信任，我也不能掉以轻心…"
                                                                },
                                                                {
                                                                    "id": "710420153",
                                                                    "speaker": "志琼",
                                                                    "text": "不把他交给千岩军，我可放不下心…所以也请前辈多盯紧这个家伙，不要让他有做坏事的机会。"
                                                                },
                                                                {
                                                                    "id": "710420154",
                                                                    "speaker": "瑾武",
                                                                    "text": "好了，既然已经知道库房钥匙在哪了，就请不要打搅我了。"
                                                                },
                                                                {
                                                                    "id": "710420155",
                                                                    "speaker": "瑾武",
                                                                    "text": "#顺便，{NICKNAME}。你在路上一定见到过流明石的原晶吧？"
                                                                },
                                                                {
                                                                    "id": "710420156",
                                                                    "speaker": "瑾武",
                                                                    "text": "有需要的话可以随时来找我，我会帮你打磨它的。在地下深处，这玩意作为「触媒」还挺有用的。"
                                                                },
                                                                {
                                                                    "id": "710420157",
                                                                    "speaker": "瑾武",
                                                                    "text": "它们似乎能克制那些黑泥一样的物质增生，就像天生与之为敌一样…但我不明白原理就是了。"
                                                                },
                                                                {
                                                                    "id": "710420158",
                                                                    "speaker": "瑾武",
                                                                    "text": "哈哈，本业之外的事情我也说不太清楚。等你见到了「那个东西」，就自然明白了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710420139",
                                                            "text": "「开山炮」！「开山炮」！！",
                                                            "response": [
                                                                {
                                                                    "id": "710420140",
                                                                    "speaker": "瑾武",
                                                                    "text": "哈哈哈哈哈哈！别逗我了！哈哈哈哈哈！！"
                                                                },
                                                                {
                                                                    "id": "710420141",
                                                                    "speaker": "志琼",
                                                                    "text": "喂！前辈你也太过分了！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710420126",
                                            "text": "或许克里托夫还安全些…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710420114",
                            "text": "他搞砸了盗宝团的所有任务。",
                            "response": [
                                {
                                    "id": "710420115",
                                    "speaker": "派蒙",
                                    "text": "哈哈哈哈哈哈！这也算吗！"
                                },
                                {
                                    "id": "710420116",
                                    "speaker": "瑾武",
                                    "text": "当然不算。"
                                },
                                {
                                    "id": "710420117",
                                    "speaker": "克里托夫",
                                    "text": "调配炸药…算不算？"
                                },
                                {
                                    "id": "710420118",
                                    "speaker": "瑾武",
                                    "text": "……"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}