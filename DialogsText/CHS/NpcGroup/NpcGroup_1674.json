{
    "groupId": "1674",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "乔瑟夫": 7
    },
    "talks": [
        {
            "talkId": "6167401",
            "initDialog": "616740101",
            "dialogues": [
                {
                    "id": "616740101",
                    "speaker": "乔瑟夫",
                    "text": "你好，我记得你，我们又见面了。"
                }
            ]
        },
        {
            "talkId": "6167402",
            "initDialog": "616740201",
            "dialogues": [
                {
                    "id": "616740201",
                    "speaker": "Player",
                    "text": "最近如何？"
                },
                {
                    "id": "616740202",
                    "speaker": "乔瑟夫",
                    "text": "承蒙关照，一切都好。但是我的记忆还很模糊，不知道什么时候才能完全恢复…"
                },
                {
                    "id": "616740203",
                    "speaker": "乔瑟夫",
                    "text": "乔尔为了让我想起以前的事情，做了不少努力。看他这样兴奋，我也得加把劲呀。"
                }
            ]
        },
        {
            "talkId": "6167403",
            "initDialog": "616740301",
            "dialogues": [
                {
                    "id": "616740301",
                    "speaker": "Player",
                    "text": "他是因为找到你而开心。"
                },
                {
                    "id": "616740302",
                    "speaker": "乔瑟夫",
                    "text": "哈哈，你说得对。只要乔尔开心，我陪他做什么都行。"
                },
                {
                    "id": "616740303",
                    "speaker": "乔瑟夫",
                    "text": "我答应了他一起去堆小狐狸雪人，不知为何心里有些熟悉又温暖的感觉…"
                },
                {
                    "id": "616740304",
                    "speaker": "乔瑟夫",
                    "text": "不过雪山还是很危险，我会保护好乔尔，不让他乱跑的。"
                }
            ]
        },
        {
            "talkId": "6167404",
            "initDialog": "616740401",
            "dialogues": [
                {
                    "id": "616740401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616740402",
                    "speaker": "乔瑟夫",
                    "text": "谢谢你的帮助，祝你一路顺风。"
                }
            ]
        }
    ]
}