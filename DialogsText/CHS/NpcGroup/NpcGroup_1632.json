            "dialogues": [
                {
                    "id": "616320101",
                    "speaker": "约顿",
                    "text": "找我什么事？有话直说就行，我没什么所谓。"
                }
            ]
        },
        {
            "talkId": "6163202",
            "initDialog": "616320201",
            "dialogues": [
                {
                    "id": "616320201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "616320202",
                    "speaker": "约顿",
                    "text": "我是个猎人，住在清泉镇的话一般还是当个猎人比较好吧？"
                },
                {
                    "id": "616320203",
                    "speaker": "约顿",
                    "text": "这种事儿我倒是没什么所谓啦。"
                },
                {
                    "id": "616320204",
                    "speaker": "约顿",
                    "text": "杜拉夫大叔说什么，我就干什么，这样多轻松。"
                },
                {
                    "id": "616320205",
                    "speaker": "约顿",
                    "text": "自己动脑子什么的，最烦人了。"
                }
            ]
        },
        {
            "talkId": "6163203",
            "initDialog": "616320301",
            "dialogues": [
                {
                    "id": "616320301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616320302",
                    "speaker": "约顿",
                    "text": "走了吗，哦，我倒是没什么所谓啦。"
                }
            ]
        }
    ]
