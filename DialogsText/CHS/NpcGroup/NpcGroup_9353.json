{
    "groupId": "9353",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "坎蒂丝": 9
    },
    "talks": [
        {
            "talkId": "6935301",
            "initDialog": "693530101",
            "dialogues": [
                {
                    "id": "693530101",
                    "speaker": "坎蒂丝",
                    "text": "刚才我在此处闲逛了一番。那个衣架上的帽子…颜色和款式看着不错。"
                },
                {
                    "id": "693530102",
                    "speaker": "坎蒂丝",
                    "text": "如果是在商贩处看到的话，我可能会想要试戴一下吧…"
                },
                {
                    "id": "693530103",
                    "speaker": "坎蒂丝",
                    "text": "但它现在是无主之物，我看看就好。"
                }
            ]
        },
        {
            "talkId": "6935302",
            "initDialog": "693530201",
            "dialogues": [
                {
                    "id": "693530201",
                    "speaker": "坎蒂丝",
                    "text": "胆敢威胁同伴安危的人，我绝不会对它们留情。"
                },
                {
                    "id": "693530202",
                    "speaker": "坎蒂丝",
                    "text": "因此，不必惧怕秘境深处的敌人。我的枪，我的盾，随时听候你的调遣。"
                },
                {
                    "id": "693530203",
                    "speaker": "坎蒂丝",
                    "text": "这正是我身为守护者的职责所在。"
                }
            ]
        },
        {
            "talkId": "6935303",
            "initDialog": "693530301",
            "dialogues": [
                {
                    "id": "693530301",
                    "speaker": "坎蒂丝",
                    "text": "传说的本质是「故事」，但当它承载起众人的期许，不免会杂糅杜撰的奇迹。"
                },
                {
                    "id": "693530302",
                    "speaker": "坎蒂丝",
                    "text": "但在我看来，传说的真实与否并没有那么重要。我踏在黄沙之上，我的心向往着拂晓的明眸之光。"
                },
                {
                    "id": "693530303",
                    "speaker": "坎蒂丝",
                    "text": "无论是否存在神明的恩赐，我都将守护大家。"
                }
            ]
        }
    ]
}