{
    "groupId": "4055",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "朱特": 9
    },
    "talks": [
        {
            "talkId": "6405501",
            "initDialog": "640550101",
            "dialogues": [
                {
                    "id": "640550101",
                    "speaker": "朱特",
                    "text": "你好，是要购买香料吗？"
                }
            ]
        },
        {
            "talkId": "6405502",
            "initDialog": "640550201",
            "dialogues": [
                {
                    "id": "640550201",
                    "speaker": "Player",
                    "text": "买。"
                },
                {
                    "id": "640550202",
                    "speaker": "朱特",
                    "text": "没问题，选好了跟我说就行。"
                }
            ]
        },
        {
            "talkId": "6405503",
            "initDialog": "640550301",
            "dialogues": [
                {
                    "id": "640550301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640550302",
                    "speaker": "朱特",
                    "text": "我是做香料生意的商人，主要为附近的居民提供日常所需的香料，另外也卖些香料制作的副食品。"
                },
                {
                    "id": "640550303",
                    "speaker": "朱特",
                    "text": "有的学者还会亲自来挑选香料。"
                },
                {
                    "id": "640550304",
                    "speaker": "朱特",
                    "text": "我甚至还通过镀金旅团的朋友联系到了稀有原料帕蒂沙兰的进货渠道，有需要的话欢迎来找我。"
                }
            ]
        },
        {
            "talkId": "6405504",
            "initDialog": "640550401",
            "dialogues": [
                {
                    "id": "640550401",
                    "speaker": "Player",
                    "text": "下次吧。"
                },
                {
                    "id": "640550402",
                    "speaker": "朱特",
                    "text": "没问题，欢迎再来。"
                }
            ]
        },
        {
            "talkId": "7393501",
            "initDialog": "739350101",
            "dialogues": [
                {
                    "id": "739350101",
                    "speaker": "Player",
                    "text": "人缘很好嘛。"
                },
                {
                    "id": "739350102",
                    "speaker": "朱特",
                    "text": "嘿嘿，也没那么夸张啦…只是在刚开店的时候经常给大家附送小礼品，客人们也就愿意多给我宣传。"
                },
                {
                    "id": "739350103",
                    "speaker": "朱特",
                    "text": "做生意嘛，最重要的还是真诚待人。"
                },
                {
                    "id": "739350104",
                    "speaker": "朱特",
                    "text": "客人你是第一次来吧？这些送给你，希望能为你的餐桌带来不一样的香味。"
                }
            ]
        }
    ]
}