    "talks": [
        {
            "talkId": "6603801",
            "initDialog": "660380101",
            "dialogues": [
                {
                    "id": "660380101",
                    "speaker": "梅西娜",
                    "text": "放弃吧，犹豫再久结果也是一样，还不如干脆一点。"
                },
                {
                    "id": "660380102",
                    "speaker": "库马约",
                    "text": "不行，不是这么算的，得从组队的综合实力考量，再根据每次比赛内容的不同推测…"
                },
                {
                    "id": "660380103",
                    "speaker": "伊泽",
                    "text": "然后被「意外」定胜负？"
                },
                {
                    "id": "660380104",
                    "speaker": "库马约",
                    "text": "啧，就你话多！"
                },
                {
                    "id": "660380105",
                    "speaker": "梅西娜",
                    "text": "儿子说的是实话嘛。赌了这么多次比赛结果，你的「测算」和儿子的乱猜胜率根本就差不多。"
                },
                {
                    "id": "660380106",
                    "speaker": "库马约",
                    "text": "这是因为样本太少了。你等次数多了，我按照规律做个模型出来…"
                },
                {
                    "id": "660380107",
                    "speaker": "伊泽",
                    "text": "然后再洗三个礼拜碗？"
                },
                {
                    "id": "660380108",
                    "speaker": "库马约",
                    "text": "啧，又在乱猜！乱猜也给你老爸我猜点好的！"
                }
            ]
        }
    ]
}