{
    "groupId": "6054",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "爱菲拉": 9
    },
    "talks": [
        {
            "talkId": "6605401",
            "initDialog": "660540101",
            "dialogues": [
                {
                    "id": "660540101",
                    "speaker": "爱菲拉",
                    "text": "唔，现在没有风呢…什么时候才会回来？"
                }
            ]
        },
        {
            "talkId": "6605402",
            "initDialog": "660540201",
            "dialogues": [
                {
                    "id": "660540201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "660540202",
                    "speaker": "爱菲拉",
                    "text": "你好，很高兴见到你。"
                }
            ]
        },
        {
            "talkId": "6605403",
            "initDialog": "660540301",
            "dialogues": [
                {
                    "id": "660540301",
                    "speaker": "Player",
                    "text": "在等人吗？"
                },
                {
                    "id": "660540302",
                    "speaker": "爱菲拉",
                    "text": "不，在等我的龙！它是我的好搭档。"
                },
                {
                    "id": "660540303",
                    "speaker": "爱菲拉",
                    "text": "我们从小就认识了，还一起长大。听部族里的长老们说，我和它的生日就差了一天。"
                },
                {
                    "id": "660540304",
                    "speaker": "爱菲拉",
                    "text": "小时候它长得可比我快多了，我还担心会不会被先一步学会飞翔的它抛下。"
                },
                {
                    "id": "660540305",
                    "speaker": "爱菲拉",
                    "text": "不过没关系，我学得也很快！后来我们一起进行了第一次飞行，我为它取名叫「那天的晚霞」…"
                },
                {
                    "id": "660540306",
                    "speaker": "爱菲拉",
                    "text": "抱歉，我是不是说太多了…"
                },
                {
                    "id": "660540307",
                    "speaker": "爱菲拉",
                    "text": "因为关于它的事情，想说的有很多…抱歉…"
                }
            ]
        },
        {
            "talkId": "6605404",
            "initDialog": "660540401",
            "dialogues": [
                {
                    "id": "660540401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660540402",
                    "speaker": "爱菲拉",
                    "text": "嗯。"
                }
            ]
        }
    ]
}