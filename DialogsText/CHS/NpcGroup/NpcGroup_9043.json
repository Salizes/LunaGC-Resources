{
    "groupId": "9043",
    "total_dialogue_lines": 63,
    "speaker_counts": {
        "Player": 22,
        "砂糖": 41
    },
    "talks": [
        {
            "talkId": "6904301",
            "initDialog": "690430101",
            "dialogues": [
                {
                    "id": "690430101",
                    "speaker": "砂糖",
                    "text": "#你好，{NICKNAME}。"
                },
                {
                    "id": "690430102",
                    "speaker": "砂糖",
                    "text": "托你的福，我的研究进行得很顺利。"
                }
            ]
        },
        {
            "talkId": "6904302",
            "initDialog": "690430201",
            "dialogues": [
                {
                    "id": "690430201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690430202",
                    "speaker": "砂糖",
                    "text": "啊…请不用担心我。"
                },
                {
                    "id": "690430203",
                    "speaker": "砂糖",
                    "text": "对我来说，只要有一个独立的实验室，就已经很满足了。"
                },
                {
                    "id": "690430204",
                    "speaker": "砂糖",
                    "text": "这里比我需要的好了太多。",
                    "choices": [
                        {
                            "id": "690430205",
                            "text": "不必拘束。",
                            "response": [
                                {
                                    "id": "690430207",
                                    "speaker": "砂糖",
                                    "text": "唔…嗯…"
                                },
                                {
                                    "id": "690430208",
                                    "speaker": "砂糖",
                                    "text": "这样麻烦你让我有点不好意思。"
                                },
                                {
                                    "id": "690430209",
                                    "speaker": "砂糖",
                                    "text": "不过，我会好好珍惜你的这份好意。"
                                }
                            ]
                        },
                        {
                            "id": "690430206",
                            "text": "有什么需要的器材都可以跟我说。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904303",
            "initDialog": "690430301",
            "dialogues": [
                {
                    "id": "690430301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690430302",
                    "speaker": "砂糖",
                    "text": "唔，我可能…不太擅长和人聊天。"
                },
                {
                    "id": "690430303",
                    "speaker": "砂糖",
                    "text": "大多数时间，我都是一个人在实验室做研究，一做就是好几个小时。"
                },
                {
                    "id": "690430304",
                    "speaker": "砂糖",
                    "text": "如果遇到了特别不顺的时候，连做几天也是常有的事。"
                },
                {
                    "id": "690430305",
                    "speaker": "砂糖",
                    "text": "外面发生了什么，大家在聊什么有趣的话题。这些我都不太清楚…"
                },
                {
                    "id": "690430306",
                    "speaker": "砂糖",
                    "text": "而且…就算遇到了休息日，我也不太愿意出门社交。",
                    "choices": [
                        {
                            "id": "690430307",
                            "text": "如果是和我一起出门呢？",
                            "response": [
                                {
                                    "id": "690430309",
                                    "speaker": "砂糖",
                                    "text": "欸…和你的话…"
                                },
                                {
                                    "id": "690430310",
                                    "speaker": "砂糖",
                                    "text": "不行…我还是会不知道要讲什么话才合适。",
                                    "choices": [
                                        {
                                            "id": "690430311",
                                            "text": "想到什么就讲什么。",
                                            "response": [
                                                {
                                                    "id": "690430313",
                                                    "speaker": "砂糖",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "690430314",
                                                    "speaker": "砂糖",
                                                    "text": "听上去好像轻松多了。"
                                                },
                                                {
                                                    "id": "690430315",
                                                    "speaker": "砂糖",
                                                    "text": "我可以…试试看。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690430312",
                                            "text": "即使没有话题也不是尴尬的事。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690430308",
                            "text": "如果是和我聊天呢？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904304",
            "initDialog": "690430401",
            "dialogues": [
                {
                    "id": "690430401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690430402",
                    "speaker": "砂糖",
                    "text": "啊，是这样的…我有几个简单的问题想要问你。"
                },
                {
                    "id": "690430403",
                    "speaker": "砂糖",
                    "text": "你只需要告诉我第一感觉就好，没有对错之分。"
                },
                {
                    "id": "690430404",
                    "speaker": "砂糖",
                    "text": "小灯草还是风车菊？",
                    "choices": [
                        {
                            "id": "690430405",
                            "text": "小灯草。",
                            "response": [
                                {
                                    "id": "690430407",
                                    "speaker": "砂糖",
                                    "text": "风种子还是风晶蝶？",
                                    "choices": [
                                        {
                                            "id": "690430408",
                                            "text": "风种子。",
                                            "response": [
                                                {
                                                    "id": "690430410",
                                                    "speaker": "砂糖",
                                                    "text": "云海还是花田？",
                                                    "choices": [
                                                        {
                                                            "id": "690430411",
                                                            "text": "云海。",
                                                            "response": [
                                                                {
                                                                    "id": "690430413",
                                                                    "speaker": "砂糖",
                                                                    "text": "好的，我全记下来了。"
                                                                },
                                                                {
                                                                    "id": "690430414",
                                                                    "speaker": "砂糖",
                                                                    "text": "…之前，我不知道要怎么表达自己的心意。"
                                                                },
                                                                {
                                                                    "id": "690430415",
                                                                    "speaker": "砂糖",
                                                                    "text": "我想过要不要邀请你一起去「仙境」…但现在的我，都还没有创造出「仙境」的能力。"
                                                                },
                                                                {
                                                                    "id": "690430416",
                                                                    "speaker": "砂糖",
                                                                    "text": "所以，我只能像这样…把你选择的这些事物装进这个小小的水晶球里。"
                                                                },
                                                                {
                                                                    "id": "690430417",
                                                                    "speaker": "砂糖",
                                                                    "text": "直到能把它们装进「仙境」里的那一天到来。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "690430418",
                                                                            "text": "一言为定。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "690430419",
                                                                                    "speaker": "砂糖",
                                                                                    "text": "…嗯，一言为定。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "690430420",
                                                                            "text": "也要带上砂糖喜欢的东西。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "690430421",
                                                                                    "speaker": "砂糖",
                                                                                    "text": "嗯…我会努力的！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690430412",
                                                            "text": "花田。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690430409",
                                            "text": "风晶蝶。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690430406",
                            "text": "风车菊。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904305",
            "initDialog": "690430501",
            "dialogues": [
                {
                    "id": "690430501",
                    "speaker": "Player",
                    "text": "早啊，砂糖。"
                },
                {
                    "id": "690430502",
                    "speaker": "砂糖",
                    "text": "#嗯，{NICKNAME}早。"
                },
                {
                    "id": "690430503",
                    "speaker": "砂糖",
                    "text": "嗯…那个…一路小心。"
                }
            ]
        },
        {
            "talkId": "6904306",
            "initDialog": "690430601",
            "dialogues": [
                {
                    "id": "690430601",
                    "speaker": "Player",
                    "text": "晚安，砂糖。"
                },
                {
                    "id": "690430602",
                    "speaker": "砂糖",
                    "text": "#嗯，晚安。{NICKNAME}。"
                },
                {
                    "id": "690430603",
                    "speaker": "砂糖",
                    "text": "经过我的实验，这种贰式嘟嘟莲对改善睡眠有一定帮助。"
                },
                {
                    "id": "690430604",
                    "speaker": "砂糖",
                    "text": "我把它做成了干花包，有需要的话，你可以放在枕边。"
                }
            ]
        },
        {
            "talkId": "6904307",
            "initDialog": "690430701",
            "dialogues": [
                {
                    "id": "690430701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904308",
            "initDialog": "690430801",
            "dialogues": [
                {
                    "id": "690430801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904309",
            "initDialog": "690430901",
            "dialogues": [
                {
                    "id": "690430901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904350",
            "initDialog": "690435001",
            "dialogues": [
                {
                    "id": "690435001",
                    "speaker": "砂糖",
                    "text": "设备齐全的炼金工坊？还布置得相当合理…"
                },
                {
                    "id": "690435002",
                    "speaker": "砂糖",
                    "text": "在这里进行实验的话，哪怕失败了，也不会波及到收藏柜里的样本吧…"
                },
                {
                    "id": "690435003",
                    "speaker": "砂糖",
                    "text": "咦，你什么时候来的？我、我是说…我已经迫不及待想要做实验了…可以吗？"
                }
            ]
        },
        {
            "talkId": "6904351",
            "initDialog": "690435101",
            "dialogues": [
                {
                    "id": "690435101",
                    "speaker": "砂糖",
                    "text": "无论从哪个角度考察，这片营地都没有破绽，只可惜没有现成的骨头…"
                },
                {
                    "id": "690435102",
                    "speaker": "砂糖",
                    "text": "如果能对这座场地稍加改造，或许就能进行更有价值的研究…"
                },
                {
                    "id": "690435103",
                    "speaker": "砂糖",
                    "text": "你有兴趣吗？能…帮帮我的忙吗？"
                }
            ]
        }
    ]
}