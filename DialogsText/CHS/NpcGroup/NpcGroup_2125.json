{
    "groupId": "2125",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "黄巨贾": 14
    },
    "talks": [
        {
            "talkId": "4111541",
            "initDialog": "411154101",
            "dialogues": [
                {
                    "id": "411154101",
                    "speaker": "黄巨贾",
                    "text": "哟，是不是听说了陨石的事儿，你也害怕啦？放心吧，只要待在我这个受仙人保佑的人身边，你就绝不会有事的。"
                },
                {
                    "id": "411154102",
                    "speaker": "黄巨贾",
                    "text": "反正我现在也是闲着，就先陪陪你吧。"
                }
            ]
        },
        {
            "talkId": "6212501",
            "initDialog": "621250101",
            "dialogues": [
                {
                    "id": "621250101",
                    "speaker": "黄巨贾",
                    "text": "哟，是不是听说我被仙人保佑了，所以过来想蹭我的运气啊？"
                },
                {
                    "id": "621250102",
                    "speaker": "黄巨贾",
                    "text": "也罢，我现在也是闲着，就赏光陪你说说话吧。"
                }
            ]
        },
        {
            "talkId": "6212502",
            "initDialog": "621250201",
            "dialogues": [
                {
                    "id": "621250201",
                    "speaker": "Player",
                    "text": "仙人保佑？"
                },
                {
                    "id": "621250202",
                    "speaker": "黄巨贾",
                    "text": "前段时间我捡到了一块像是伸出大拇指和小拇指的手一样的石头！"
                },
                {
                    "id": "621250203",
                    "speaker": "黄巨贾",
                    "text": "这造型这么奇特，肯定是一块仙石，所以这是仙人对我的保佑啊！"
                },
                {
                    "id": "621250204",
                    "speaker": "黄巨贾",
                    "text": "还别说，自从我捡到了这块奇石之后，我走到哪儿，哪里就好事不断啊！这就叫「石来运转」吧？"
                },
                {
                    "id": "621250205",
                    "speaker": "黄巨贾",
                    "text": "这么一想，海灯节大家都是来贺我的啊！这望舒客栈这么多人，也都是慕名而来想得到我的好运的吧？"
                },
                {
                    "id": "621250206",
                    "speaker": "黄巨贾",
                    "text": "…哈哈，如果你以后碰上好事，在心里谢谢我就行了。"
                }
            ]
        },
        {
            "talkId": "6212503",
            "initDialog": "621250301",
            "dialogues": [
                {
                    "id": "621250301",
                    "speaker": "Player",
                    "text": "闲着？"
                },
                {
                    "id": "621250302",
                    "speaker": "黄巨贾",
                    "text": "嘿，说起这事我就来气！"
                },
                {
                    "id": "621250303",
                    "speaker": "黄巨贾",
                    "text": "自从我得到仙人保佑之后，我在蒙德到璃月的路上做生意，那叫一个红火啊！"
                },
                {
                    "id": "621250304",
                    "speaker": "黄巨贾",
                    "text": "后来也不知道是谁，估摸着是商会里的人眼红我的生意吧，居然让商会高层把我给派到轻策庄去了！"
                },
                {
                    "id": "621250305",
                    "speaker": "黄巨贾",
                    "text": "…哼，我就是老死在这望舒客栈，也绝不会去轻策庄的！那种穷乡僻壤怎么能发挥我的才能和财气？"
                }
            ]
        },
        {
            "talkId": "6212504",
            "initDialog": "621250401",
            "dialogues": [
                {
                    "id": "621250401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621250402",
                    "speaker": "黄巨贾",
                    "text": "嘿，也不说声谢谢啊？不过我大人有大量，不和你一般计较，不用谢啊！"
                }
            ]
        }
    ]
}