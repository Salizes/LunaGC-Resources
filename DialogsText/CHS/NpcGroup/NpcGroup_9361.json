{
    "groupId": "9361",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "艾尔海森": 9
    },
    "talks": [
        {
            "talkId": "6936101",
            "initDialog": "693610101",
            "dialogues": [
                {
                    "id": "693610101",
                    "speaker": "艾尔海森",
                    "text": "现在是休息时间？"
                },
                {
                    "id": "693610102",
                    "speaker": "艾尔海森",
                    "text": "嗯。休息时间不用说太多。"
                },
                {
                    "id": "693610103",
                    "speaker": "艾尔海森",
                    "text": "喝杯咖啡，想想平时没空思考的事情。"
                }
            ]
        },
        {
            "talkId": "6936102",
            "initDialog": "693610201",
            "dialogues": [
                {
                    "id": "693610201",
                    "speaker": "艾尔海森",
                    "text": "有能持续一段时间的挑战目标总归是件好事。"
                },
                {
                    "id": "693610202",
                    "speaker": "艾尔海森",
                    "text": "求知、求职和战斗，本质没有区别。"
                },
                {
                    "id": "693610203",
                    "speaker": "艾尔海森",
                    "text": "至于这些事带来的收获，因人而异。"
                }
            ]
        },
        {
            "talkId": "6936103",
            "initDialog": "693610301",
            "dialogues": [
                {
                    "id": "693610301",
                    "speaker": "艾尔海森",
                    "text": "书不少。"
                },
                {
                    "id": "693610302",
                    "speaker": "艾尔海森",
                    "text": "这里放的大多是故事书。智慧宫里很少有这样的书本，说是会耽误学生们进修。"
                },
                {
                    "id": "693610303",
                    "speaker": "艾尔海森",
                    "text": "但如果一个人非得靠外界限制才能勉强写完论文，那他的学术之路也就这样了。"
                }
            ]
        }
    ]
}