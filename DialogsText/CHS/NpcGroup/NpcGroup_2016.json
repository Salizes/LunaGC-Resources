{
    "groupId": "2016",
    "total_dialogue_lines": 129,
    "speaker_counts": {
        "Player": 31,
        "岚姐": 93,
        "派蒙": 5
    },
    "talks": [
        {
            "talkId": "6201611",
            "initDialog": "620161101",
            "dialogues": [
                {
                    "id": "620161101",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6201612",
            "initDialog": "620161201",
            "dialogues": [
                {
                    "id": "620161201",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6201613",
            "initDialog": "620161301",
            "dialogues": [
                {
                    "id": "620161301",
                    "speaker": "岚姐",
                    "text": "看来你的牌技，确实了得啊…"
                }
            ]
        },
        {
            "talkId": "6201614",
            "initDialog": "620161401",
            "dialogues": [
                {
                    "id": "620161401",
                    "speaker": "岚姐",
                    "text": "就凭你这点伎俩，想要破我的局，还是太天真了。"
                }
            ]
        },
        {
            "talkId": "6201615",
            "initDialog": "620161501",
            "dialogues": [
                {
                    "id": "620161501",
                    "speaker": "岚姐",
                    "text": "居然会犯下这样的错误…"
                }
            ]
        },
        {
            "talkId": "6201616",
            "initDialog": "620161601",
            "dialogues": [
                {
                    "id": "620161601",
                    "speaker": "岚姐",
                    "text": "牌技就如同武技，这么看来，你还得多多练习。"
                }
            ]
        },
        {
            "talkId": "7081401",
            "initDialog": "708140101",
            "dialogues": [
                {
                    "id": "708140101",
                    "speaker": "岚姐",
                    "text": "哦，你来了，看你的样子最近也没少冒险吧。"
                },
                {
                    "id": "708140102",
                    "speaker": "岚姐",
                    "text": "我们这边也有一些事，正想找个可靠的冒险家来解决。"
                },
                {
                    "id": "708140103",
                    "speaker": "岚姐",
                    "text": "如果你有兴趣的话，就去找甜甜吧，我让她来负责分发各类委托了。"
                },
                {
                    "id": "708140104",
                    "speaker": "Player",
                    "text": "那你呢？"
                },
                {
                    "id": "708140105",
                    "speaker": "岚姐",
                    "text": "我？还没有什么我感兴趣的任务，而且在这个时候…冒险家协会至少要有个人坐镇才行。"
                },
                {
                    "id": "708140106",
                    "speaker": "岚姐",
                    "text": "好了，你要是想要接受我们这边的委托，那就去找甜甜吧。这孩子必须快点成长起来才行…"
                }
            ]
        },
        {
            "talkId": "7104801",
            "initDialog": "710480101",
            "dialogues": [
                {
                    "id": "710480101",
                    "speaker": "岚姐",
                    "text": "啊，是你呀。怎么，你是来应征探索层岩巨渊的吗？"
                },
                {
                    "id": "710480102",
                    "speaker": "Player",
                    "text": "层岩巨渊？"
                },
                {
                    "id": "710480103",
                    "speaker": "派蒙",
                    "text": "没听说过有这种委托呢…"
                },
                {
                    "id": "710480104",
                    "speaker": "岚姐",
                    "text": "嗯？哦，原来你还不知道冒险家协会的委托…抱歉，是我的失职。"
                },
                {
                    "id": "710480105",
                    "speaker": "岚姐",
                    "text": "毕竟层岩巨渊已经关闭了嘛。若是没有璃月七星等级人士的许可，任何人都无权进入那里…冒险家协会也不例外。",
                    "choices": [
                        {
                            "id": "710480106",
                            "text": "冒险家协会没有特别许可吗？",
                            "response": [
                                {
                                    "id": "710480108",
                                    "speaker": "岚姐",
                                    "text": "我们可不能用这种事干扰玉京台的工作…干涉已成定论的政策，结果只能适得其反。"
                                },
                                {
                                    "id": "710480109",
                                    "speaker": "岚姐",
                                    "text": "即使是那位看起来很好说话的甘雨小姐，恐怕也只会满面微笑地对你来一句「不好意思，请稍等片刻，先喝杯茶吧。」"
                                },
                                {
                                    "id": "710480110",
                                    "speaker": "岚姐",
                                    "text": "然后把你晾半天，让你怀疑她是不是直到快下班才会想起来处理你的请求…"
                                },
                                {
                                    "id": "710480111",
                                    "speaker": "岚姐",
                                    "text": "哼…你也知道，甘雨小姐从来不会下班。"
                                },
                                {
                                    "id": "710480112",
                                    "speaker": "派蒙",
                                    "text": "噗…"
                                },
                                {
                                    "id": "710480113",
                                    "speaker": "Player",
                                    "text": "确实是甘雨特有的拒绝方式…"
                                },
                                {
                                    "id": "710480114",
                                    "speaker": "岚姐",
                                    "text": "所以，探索层岩巨渊的委托自然不适合拜托凯瑟琳小姐公示出来。我们只能私下里寻找更方便的人选。"
                                },
                                {
                                    "id": "710480115",
                                    "speaker": "Player",
                                    "text": "更方便的人选…？"
                                },
                                {
                                    "id": "710480116",
                                    "speaker": "岚姐",
                                    "text": "嗯，比如说辉山厅指定的矿工、千岩军人员、总务司职员之类，他们更容易拿到通行证，以及…"
                                },
                                {
                                    "id": "710480117",
                                    "speaker": "派蒙",
                                    "text": "以及…什么呀？"
                                },
                                {
                                    "id": "710480118",
                                    "speaker": "岚姐",
                                    "text": "嗯…从海魔的触手之下拯救过璃月，却每天无所事事的大英雄，我想在千岩军面前应该也很好说话吧？"
                                },
                                {
                                    "id": "710480119",
                                    "speaker": "Player",
                                    "text": "谁呀…？"
                                },
                                {
                                    "id": "710480120",
                                    "speaker": "岚姐",
                                    "text": "你呀。"
                                },
                                {
                                    "id": "710480121",
                                    "speaker": "派蒙",
                                    "text": "对哦，还能有谁呀！"
                                },
                                {
                                    "id": "710480122",
                                    "speaker": "岚姐",
                                    "text": "别装傻了，我说的还能是岩王爷他老人家不成？",
                                    "choices": [
                                        {
                                            "id": "710480123",
                                            "text": "嘿嘿。",
                                            "response": [
                                                {
                                                    "id": "710480125",
                                                    "speaker": "岚姐",
                                                    "text": "行了，别臭美啦。"
                                                },
                                                {
                                                    "id": "710480126",
                                                    "speaker": "岚姐",
                                                    "text": "总之…感谢你之前一直为冒险家协会提供的帮助，这次的委托也希望你考虑一下。"
                                                },
                                                {
                                                    "id": "710480127",
                                                    "speaker": "岚姐",
                                                    "text": "如果不方便的话也没关系的，只是…假如你路经层岩巨渊的话，希望能替我找一下沐宁这个家伙。"
                                                },
                                                {
                                                    "id": "710480128",
                                                    "speaker": "派蒙",
                                                    "text": "沐宁…那又是谁呀？"
                                                },
                                                {
                                                    "id": "710480129",
                                                    "speaker": "岚姐",
                                                    "text": "他呀，是总务司派驻层岩巨渊的专员。跟我有一点私人事务没有解决…如果你在层岩巨渊遇到了什么阻碍可以找他咨询。"
                                                },
                                                {
                                                    "id": "710480130",
                                                    "speaker": "岚姐",
                                                    "text": "就转达我的话，「你还欠着岚姐的酒钱呢，可别忘了。」——他自然会明白。",
                                                    "choices": [
                                                        {
                                                            "id": "710480131",
                                                            "text": "我明白了。",
                                                            "response": [
                                                                {
                                                                    "id": "710480133",
                                                                    "speaker": "岚姐",
                                                                    "text": "啊，请留步！顺便…如果你同意接下这个委托的话，报酬请直接找沐宁商议吧。"
                                                                },
                                                                {
                                                                    "id": "710480134",
                                                                    "speaker": "岚姐",
                                                                    "text": "请不要问我为何这样安排…总务司方面是这样坚持的，冒险家协会也不好过问。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710480132",
                                                            "text": "我会顺路看看的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710480124",
                                            "text": "我还是有在忙正事的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710480107",
                            "text": "七星也不会对冒险家协会网开一面？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7180301",
            "initDialog": "718030101",
            "dialogues": [
                {
                    "id": "718030101",
                    "speaker": "岚姐",
                    "text": "怎么又是这些委托…"
                },
                {
                    "id": "718030102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718030103",
                    "speaker": "岚姐",
                    "text": "是你啊…我只是在看协会每天接受的委托而已。"
                },
                {
                    "id": "718030104",
                    "speaker": "岚姐",
                    "text": "但是这些委托…真是越来越琐碎了。"
                },
                {
                    "id": "718030105",
                    "speaker": "岚姐",
                    "text": "自从璃月七星全面接管璃月港之后，千岩军的负责领域也在慢慢扩大。"
                },
                {
                    "id": "718030106",
                    "speaker": "岚姐",
                    "text": "最近，对于一些难度比较大的委托，比起委托协会，璃月港的居民们似乎更愿意去找千岩军帮忙。"
                },
                {
                    "id": "718030107",
                    "speaker": "岚姐",
                    "text": "现在冒险家协会里的委托，也只有找猫找狗，搬货送信之类的委托了。"
                },
                {
                    "id": "718030108",
                    "speaker": "岚姐",
                    "text": "比如这份委托…"
                },
                {
                    "id": "718030109",
                    "speaker": "岚姐",
                    "text": "「我家的灰灰在野外走失了，它是一只<color=#00E1FFFF>灰色的猫</color>，详细特征是…」"
                },
                {
                    "id": "718030110",
                    "speaker": "岚姐",
                    "text": "这种委托费时又费力，但是却…算了。"
                },
                {
                    "id": "718030111",
                    "speaker": "岚姐",
                    "text": "虽然我不太管协会的事…但我也不能任凭冒险家协会被这种委托塞满。"
                },
                {
                    "id": "718030112",
                    "speaker": "岚姐",
                    "text": "为了让大家能够信任我们的实力，重新委托给我们更重要的工作。"
                },
                {
                    "id": "718030113",
                    "speaker": "岚姐",
                    "text": "我认为，必须要完成一些高难度的委托才行。"
                },
                {
                    "id": "718030114",
                    "speaker": "岚姐",
                    "text": "不久前的一份委托里，有人拜托我们去处理一只在野外游荡的丘丘岩盔王。"
                },
                {
                    "id": "718030115",
                    "speaker": "岚姐",
                    "text": "因为找不到合适的人选，所以一直搁置着，如果你愿意的话，就帮忙去处理一下吧。",
                    "choices": [
                        {
                            "id": "718030116",
                            "text": "交给我。",
                            "response": [
                                {
                                    "id": "718030117",
                                    "speaker": "岚姐",
                                    "text": "嗯，那就拜托你了，我留在这里继续筛选委托。"
                                },
                                {
                                    "id": "718030118",
                                    "speaker": "岚姐",
                                    "text": "如果协会里多一点像你这样有实力的冒险家，情况也不会变成这样…"
                                }
                            ]
                        },
                        {
                            "id": "718030119",
                            "text": "还有其他的委托吗？",
                            "response": [
                                {
                                    "id": "718030120",
                                    "speaker": "岚姐",
                                    "text": "还有的都是些零零碎碎的琐事了，我要留在这里继续筛选，丘丘岩盔王就拜托你了。"
                                },
                                {
                                    "id": "718030121",
                                    "speaker": "岚姐",
                                    "text": "如果协会里多一点像你这样有实力的冒险家，情况也不会变成这样…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7181201",
            "initDialog": "718120101",
            "dialogues": [
                {
                    "id": "718120101",
                    "speaker": "岚姐",
                    "text": "唔…看来还是没人能解开啊…"
                },
                {
                    "id": "718120102",
                    "speaker": "Player",
                    "text": "解开什么？"
                },
                {
                    "id": "718120103",
                    "speaker": "岚姐",
                    "text": "是一个宝藏的线索，唔…或者说，一个传言。"
                },
                {
                    "id": "718120104",
                    "speaker": "岚姐",
                    "text": "有位冒险家说他在天遒谷附近发现了宝藏的线索…但他费尽办法也没找到宝藏…"
                },
                {
                    "id": "718120105",
                    "speaker": "岚姐",
                    "text": "他最后只能把这个无头线索报告给了协会，协会就把这个所谓的「线索」作为悬赏发布了。"
                },
                {
                    "id": "718120106",
                    "speaker": "岚姐",
                    "text": "任何想要尝试的冒险家都可以循着线索去试试看。如果真的解开了谜题找到宝藏，协会还有些奖励送上。"
                },
                {
                    "id": "718120107",
                    "speaker": "岚姐",
                    "text": "但到现在也没人能找到一点宝藏的踪迹…",
                    "choices": [
                        {
                            "id": "718120108",
                            "text": "我能试试吗？",
                            "response": [
                                {
                                    "id": "718120109",
                                    "speaker": "岚姐",
                                    "text": "唔，可以是可以。"
                                },
                                {
                                    "id": "718120113",
                                    "speaker": "岚姐",
                                    "text": "如果你真有兴趣的话，试试看也没什么问题。"
                                },
                                {
                                    "id": "718120114",
                                    "speaker": "岚姐",
                                    "text": "我把那个线索里提到的地点给你标在地图上，你先去那边看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "718120110",
                            "text": "要是真的找到了什么宝贝…",
                            "response": [
                                {
                                    "id": "718120111",
                                    "speaker": "岚姐",
                                    "text": "那就按照冒险家的规矩，谁找到的就归谁。"
                                },
                                {
                                    "id": "718120112",
                                    "speaker": "岚姐",
                                    "text": "协会想要的只是解开这些谜题的「经验」。对冒险家来说，这才是最重要的东西。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7190301",
            "initDialog": "719030101",
            "dialogues": [
                {
                    "id": "719030101",
                    "speaker": "Player",
                    "text": "…你真厉害。"
                },
                {
                    "id": "719030102",
                    "speaker": "岚姐",
                    "text": "是吗？我做这些事可不是为了博得什么称谓或者赞许。"
                },
                {
                    "id": "719030103",
                    "speaker": "岚姐",
                    "text": "…不过既然在分会长的位置，就稍微做些该做的事吧。"
                },
                {
                    "id": "719030104",
                    "speaker": "岚姐",
                    "text": "这是我寻找「剑」时记录下来的一些冒险心得，或许会对你有所帮助。"
                }
            ]
        },
        {
            "talkId": "6201601",
            "initDialog": "620160101",
            "dialogues": [
                {
                    "id": "620160101",
                    "speaker": "岚姐",
                    "text": "…？冒险者么，去那边找凯瑟琳，协会的事儿我不了解。"
                }
            ]
        },
        {
            "talkId": "6201602",
            "initDialog": "620160201",
            "dialogues": [
                {
                    "id": "620160201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "620160202",
                    "speaker": "岚姐",
                    "text": "如果你要找璃月冒险家协会的会长的话，那很不幸地告诉你，我就是。"
                },
                {
                    "id": "620160203",
                    "speaker": "岚姐",
                    "text": "我的意思是你别指望我能帮上什么忙，协会事务那种麻烦的东西，我一丁点也不想染指。"
                },
                {
                    "id": "620160204",
                    "speaker": "岚姐",
                    "text": "除非，你带来的是「剑」的消息。"
                },
                {
                    "id": "620160205",
                    "speaker": "Player",
                    "text": "「剑」？"
                },
                {
                    "id": "620160206",
                    "speaker": "岚姐",
                    "text": "是我大哥的那把剑，找到的话，就能好好把他下葬了…"
                },
                {
                    "id": "620160207",
                    "speaker": "岚姐",
                    "text": "…那才是武人该有的归宿。"
                },
                {
                    "id": "620160208",
                    "speaker": "岚姐",
                    "text": "那剑样貌平平，却吹毛断发锋利无比，名为「藏锋」。",
                    "choices": [
                        {
                            "id": "620160209",
                            "text": "你是怎么当上分会长的？",
                            "response": [
                                {
                                    "id": "620160210",
                                    "speaker": "岚姐",
                                    "text": "又是这个问题吗…好吧，我就破例给你讲讲。"
                                },
                                {
                                    "id": "620160211",
                                    "speaker": "岚姐",
                                    "text": "当初身为雇佣兵的我，为了找「剑」，想要利用冒险家协会的情报网，所以才加入了协会。"
                                },
                                {
                                    "id": "620160212",
                                    "speaker": "岚姐",
                                    "text": "识字什么的我很不擅长，可是「剑」字我可认得，有「剑」相关的委托我就全接了一遍。"
                                },
                                {
                                    "id": "620160213",
                                    "speaker": "岚姐",
                                    "text": "不记得是第八个还是第九个刚完成的时候，至冬国总部那边发来消息，说我刚刚完成了两个「S级」的委托。"
                                },
                                {
                                    "id": "620160214",
                                    "speaker": "岚姐",
                                    "text": "…然后就这么被提拔成了分会长，真是莫名其妙。"
                                }
                            ]
                        },
                        {
                            "id": "620160215",
                            "text": "我会帮你留意的。",
                            "response": [
                                {
                                    "id": "620160216",
                                    "speaker": "岚姐",
                                    "text": "哦？我很中意你这样爽快的人。"
                                },
                                {
                                    "id": "620160217",
                                    "speaker": "岚姐",
                                    "text": "那就拜托你了，新人，看来我加入这协会还算有些意义。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6201603",
            "initDialog": "620160301",
            "dialogues": [
                {
                    "id": "620160301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620160302",
                    "speaker": "岚姐",
                    "text": "嗯，去吧。"
                }
            ]
        },
        {
            "talkId": "6201604",
            "initDialog": "620160401",
            "dialogues": [
                {
                    "id": "620160401",
                    "speaker": "岚姐",
                    "text": "好久不见。如果是协会的事的话，还是跟凯瑟琳小姐讲吧。"
                }
            ]
        },
        {
            "talkId": "6201605",
            "initDialog": "620160501",
            "dialogues": [
                {
                    "id": "620160501",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "620160502",
                    "speaker": "岚姐",
                    "text": "嗯？居然忘记我是谁了么，亏我还记得你。"
                },
                {
                    "id": "620160503",
                    "speaker": "岚姐",
                    "text": "我是璃月冒险家协会的会长，虽然协会事务那种麻烦的东西，我一丁点也不想染指。"
                },
                {
                    "id": "620160504",
                    "speaker": "岚姐",
                    "text": "我感兴趣的，只有有关「剑」的消息。"
                }
            ]
        },
        {
            "talkId": "6201606",
            "initDialog": "620160601",
            "dialogues": [
                {
                    "id": "620160601",
                    "speaker": "Player",
                    "text": "「剑」？"
                },
                {
                    "id": "620160602",
                    "speaker": "岚姐",
                    "text": "是我大哥的那把剑，找到的话，就能好好把他下葬了…"
                },
                {
                    "id": "620160603",
                    "speaker": "岚姐",
                    "text": "…那才是武人该有的归宿。"
                },
                {
                    "id": "620160604",
                    "speaker": "岚姐",
                    "text": "那剑样貌平平，却吹毛断发锋利无比，名为「藏锋」。"
                }
            ]
        },
        {
            "talkId": "6201607",
            "initDialog": "620160701",
            "dialogues": [
                {
                    "id": "620160701",
                    "speaker": "Player",
                    "text": "你是怎么当上分会长的？"
                },
                {
                    "id": "620160702",
                    "speaker": "岚姐",
                    "text": "又是这个问题吗…好吧，我就破例给你讲讲。"
                },
                {
                    "id": "620160703",
                    "speaker": "岚姐",
                    "text": "当初身为雇佣兵的我，为了找「剑」，想要利用冒险家协会的情报网，所以才加入了协会。"
                },
                {
                    "id": "620160704",
                    "speaker": "岚姐",
                    "text": "识字什么的我很不擅长，可是「剑」字我可认得，有「剑」相关的委托我就全接了一遍。"
                },
                {
                    "id": "620160705",
                    "speaker": "岚姐",
                    "text": "不记得是第八个还是第九个刚完成的时候，至冬国总部那边发来消息，说我刚刚完成了两个「S级」的委托。"
                },
                {
                    "id": "620160706",
                    "speaker": "岚姐",
                    "text": "…然后就这么被提拔成了分会长，真是莫名其妙。"
                }
            ]
        },
        {
            "talkId": "6201608",
            "initDialog": "620160801",
            "dialogues": [
                {
                    "id": "620160801",
                    "speaker": "Player",
                    "text": "我会帮你留意的。"
                },
                {
                    "id": "620160802",
                    "speaker": "岚姐",
                    "text": "哦？我很中意你这样爽快的人。"
                },
                {
                    "id": "620160803",
                    "speaker": "岚姐",
                    "text": "那就拜托你了，新人，看来我加入这协会还算有些意义。"
                }
            ]
        },
        {
            "talkId": "6201609",
            "initDialog": "620160901",
            "dialogues": [
                {
                    "id": "620160901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620160902",
                    "speaker": "岚姐",
                    "text": "嗯，去吧。"
                }
            ]
        },
        {
            "talkId": "6201610",
            "initDialog": "620161001",
            "dialogues": [
                {
                    "id": "620161001",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "620161002",
                    "speaker": "岚姐",
                    "text": "长得很像…原来如此，你在寻找亲人吗。"
                },
                {
                    "id": "620161003",
                    "speaker": "岚姐",
                    "text": "我没有见过，但我会帮你留意的。"
                },
                {
                    "id": "620161004",
                    "speaker": "岚姐",
                    "text": "…我也经历过与亲人的分别，我能明白你的感受。"
                }
            ]
        }
    ]
}