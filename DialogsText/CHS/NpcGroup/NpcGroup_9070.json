{
    "groupId": "9070",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 12,
        "妮露": 52
    },
    "talks": [
        {
            "talkId": "6907001",
            "initDialog": "690700101",
            "dialogues": [
                {
                    "id": "690700101",
                    "speaker": "妮露",
                    "text": "#唔——啊？{NICKNAME}，你好呀。"
                },
                {
                    "id": "690700102",
                    "speaker": "妮露",
                    "text": "要不要和我一起来拍拍手呢？"
                }
            ]
        },
        {
            "talkId": "6907002",
            "initDialog": "690700201",
            "dialogues": [
                {
                    "id": "690700201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690700202",
                    "speaker": "妮露",
                    "text": "我、我没事的…你不用担心我。"
                },
                {
                    "id": "690700203",
                    "speaker": "妮露",
                    "text": "我很开心能收到你的邀请，来这里转转…",
                    "choices": [
                        {
                            "id": "690700204",
                            "text": "妮露在紧张吧？",
                            "response": [
                                {
                                    "id": "690700205",
                                    "speaker": "妮露",
                                    "text": "唔、唔，还是瞒不过你吗…"
                                },
                                {
                                    "id": "690700206",
                                    "speaker": "妮露",
                                    "text": "呼——让我想象一下，现在的我正埋在墩墩桃的海洋里。"
                                },
                                {
                                    "id": "690700207",
                                    "speaker": "妮露",
                                    "text": "把身边的墩墩桃轻轻推开…嗯，这样就能把紧张从身体里赶跑了。"
                                },
                                {
                                    "id": "690700212",
                                    "speaker": "妮露",
                                    "text": "啊，说回刚刚的问题…这里被你布置得温馨又舒适。"
                                },
                                {
                                    "id": "690700213",
                                    "speaker": "妮露",
                                    "text": "但我一直以来都没怎么出过须弥城，突然来到陌生的地方就…"
                                },
                                {
                                    "id": "690700214",
                                    "speaker": "妮露",
                                    "text": "不知道该做点什么，也不知道要找谁说话…"
                                },
                                {
                                    "id": "690700215",
                                    "speaker": "妮露",
                                    "text": "能让我多待一会儿，再等我适应一段时间吗？"
                                },
                                {
                                    "id": "690700216",
                                    "speaker": "妮露",
                                    "text": "等熟悉这里了，我肯定就不会紧张了，嘿嘿。"
                                }
                            ]
                        },
                        {
                            "id": "690700208",
                            "text": "要不要去摸摸阿圆…",
                            "response": [
                                {
                                    "id": "690700209",
                                    "speaker": "妮露",
                                    "text": "欸？原来那个圆滚滚的小家伙就叫阿圆呀？"
                                },
                                {
                                    "id": "690700210",
                                    "speaker": "妮露",
                                    "text": "噗…好厉害的取名方式，把特征概括得很准确哦。"
                                },
                                {
                                    "id": "690700211",
                                    "speaker": "妮露",
                                    "text": "光是看着它就像伸了个大大的懒腰一样，变得放松下来了呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907003",
            "initDialog": "690700301",
            "dialogues": [
                {
                    "id": "690700301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690700302",
                    "speaker": "妮露",
                    "text": "好呀，我很乐意。聊点什么好呢？",
                    "choices": [
                        {
                            "id": "690700303",
                            "text": "最近在想些什么…",
                            "response": [
                                {
                                    "id": "690700304",
                                    "speaker": "妮露",
                                    "text": "欸？我吗？"
                                },
                                {
                                    "id": "690700305",
                                    "speaker": "妮露",
                                    "text": "我在想，最初的最初，是先有观众，还是先有表演呢？"
                                },
                                {
                                    "id": "690700306",
                                    "speaker": "妮露",
                                    "text": "想要知道真实情况的话，应该是要去寻找相关的文献和资料吧，但这不是我擅长做的事情…"
                                },
                                {
                                    "id": "690700307",
                                    "speaker": "妮露",
                                    "text": "嘿嘿，所以我也只是随便想了想而已…"
                                },
                                {
                                    "id": "690700314",
                                    "speaker": "妮露",
                                    "text": "哎呀，说是聊天，结果都是我一个人在说话…"
                                },
                                {
                                    "id": "690700315",
                                    "speaker": "妮露",
                                    "text": "我要把球高高地抛还给你…来听听你身边发生的事情，还有你认识的人。"
                                },
                                {
                                    "id": "690700316",
                                    "speaker": "妮露",
                                    "text": "和我讲讲吧！我很有兴趣！"
                                }
                            ]
                        },
                        {
                            "id": "690700308",
                            "text": "关于大巴扎的大家…",
                            "response": [
                                {
                                    "id": "690700309",
                                    "speaker": "妮露",
                                    "text": "嗯，我很喜欢这种家人般的氛围。"
                                },
                                {
                                    "id": "690700310",
                                    "speaker": "妮露",
                                    "text": "虽然大家的性格各不相同，偶尔也会闹些小矛盾…"
                                },
                                {
                                    "id": "690700311",
                                    "speaker": "妮露",
                                    "text": "但要是谁遇到了什么困难，其他人都会发挥自己的长处，毫不保留地提供帮助…"
                                },
                                {
                                    "id": "690700312",
                                    "speaker": "妮露",
                                    "text": "家人不就是这样吗？"
                                },
                                {
                                    "id": "690700313",
                                    "speaker": "妮露",
                                    "text": "经常吵吵闹闹，但永远都是彼此最坚强的后盾。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907004",
            "initDialog": "690700401",
            "dialogues": [
                {
                    "id": "690700401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690700402",
                    "speaker": "妮露",
                    "text": "嗯…我们来做几个花盆吧…",
                    "choices": [
                        {
                            "id": "690700403",
                            "text": "妮露还会做花盆吗？",
                            "response": [
                                {
                                    "id": "690700404",
                                    "speaker": "妮露",
                                    "text": "我原本不会，但我想和你一起做一件很重要的事…就请教了大巴扎的朋友，悄悄练习了一下。"
                                },
                                {
                                    "id": "690700405",
                                    "speaker": "妮露",
                                    "text": "啊，你不用担心，我是成功做出花盆成品之后才来邀请你的。"
                                },
                                {
                                    "id": "690700406",
                                    "speaker": "妮露",
                                    "text": "因为我想…"
                                },
                                {
                                    "id": "690700411",
                                    "speaker": "妮露",
                                    "text": "移植一些帕蒂沙兰过来。"
                                },
                                {
                                    "id": "690700412",
                                    "speaker": "妮露",
                                    "text": "都是我亲手种的，我已经选好了长势不错的几株。"
                                },
                                {
                                    "id": "690700413",
                                    "speaker": "妮露",
                                    "text": "这是我最喜欢的花朵，所以我想要送给我最重要的人。"
                                },
                                {
                                    "id": "690700414",
                                    "speaker": "妮露",
                                    "text": "希望快乐的时间永驻你的身边。"
                                },
                                {
                                    "id": "690700415",
                                    "speaker": "Player",
                                    "text": "谢谢你，妮露。"
                                },
                                {
                                    "id": "690700416",
                                    "speaker": "妮露",
                                    "text": "不用客气啦，你喜欢就好。"
                                },
                                {
                                    "id": "690700417",
                                    "speaker": "妮露",
                                    "text": "等你方便的时候就和我说哦，我随时都可以「登台」。"
                                },
                                {
                                    "id": "690700418",
                                    "speaker": "妮露",
                                    "text": "放心吧，这次我很有信心，连深呼吸也不用做…毕竟我们已经相处很久了呀。"
                                }
                            ]
                        },
                        {
                            "id": "690700407",
                            "text": "有什么想种的花吗？",
                            "response": [
                                {
                                    "id": "690700408",
                                    "speaker": "妮露",
                                    "text": "嗯——我想了很久。"
                                },
                                {
                                    "id": "690700409",
                                    "speaker": "妮露",
                                    "text": "毕竟你帮了我很多，我也想要为你做点什么。"
                                },
                                {
                                    "id": "690700410",
                                    "speaker": "妮露",
                                    "text": "可是看你似乎都没什么烦恼的样子，我的肢体动作疗愈法也派不上用场，我就想着…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907005",
            "initDialog": "690700501",
            "dialogues": [
                {
                    "id": "690700501",
                    "speaker": "Player",
                    "text": "早啊，妮露。"
                },
                {
                    "id": "690700502",
                    "speaker": "妮露",
                    "text": "#早上好，{NICKNAME}。"
                },
                {
                    "id": "690700503",
                    "speaker": "妮露",
                    "text": "要不要来当我今天的第一位观众？"
                }
            ]
        },
        {
            "talkId": "6907006",
            "initDialog": "690700601",
            "dialogues": [
                {
                    "id": "690700601",
                    "speaker": "Player",
                    "text": "晚安，妮露。"
                },
                {
                    "id": "690700602",
                    "speaker": "妮露",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690700603",
                    "speaker": "妮露",
                    "text": "可以让我用手指轻轻摸摸你的额头吗？听说这样就会做个好梦哦。"
                }
            ]
        },
        {
            "talkId": "6907010",
            "initDialog": "690701001",
            "dialogues": [
                {
                    "id": "690701001",
                    "speaker": "妮露",
                    "text": "哇——真是琳琅满目呀。"
                },
                {
                    "id": "690701002",
                    "speaker": "妮露",
                    "text": "嘿嘿，其实我早就感受到啦，你在艺术欣赏上有着很高的造诣。"
                },
                {
                    "id": "690701003",
                    "speaker": "妮露",
                    "text": "艺术的美都是相通的，不管是对于舞蹈还是珠宝，你都有一双发现美的眼睛。没错吧？"
                }
            ]
        },
        {
            "talkId": "6907011",
            "initDialog": "690701101",
            "dialogues": [
                {
                    "id": "690701101",
                    "speaker": "妮露",
                    "text": "这是…你搭建的剧院吗？简直一模一样…真是令人惊叹。"
                },
                {
                    "id": "690701102",
                    "speaker": "妮露",
                    "text": "最好的舞台已经有了，怎么可以缺少舞者的表演呢？"
                },
                {
                    "id": "690701103",
                    "speaker": "妮露",
                    "text": "我已经等不及想要试试看了，嘿嘿…那新舞蹈的命名，可以拜托你吗？"
                }
            ]
        }
    ]
}