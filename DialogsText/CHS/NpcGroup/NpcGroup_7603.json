{
    "groupId": "7603",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "法尔伽": 5,
        "温弗里德": 12,
        "艾克贝特": 1,
        "莱夫赫姆": 1
    },
    "talks": [
        {
            "talkId": "6760301",
            "initDialog": "676030101",
            "dialogues": [
                {
                    "id": "676030101",
                    "speaker": "温弗里德",
                    "text": "果然还是比不过大团长啊…"
                }
            ]
        },
        {
            "talkId": "6760302",
            "initDialog": "676030201",
            "dialogues": [
                {
                    "id": "676030201",
                    "speaker": "Player",
                    "text": "比不过什么？"
                },
                {
                    "id": "676030202",
                    "speaker": "温弗里德",
                    "text": "当然是酒量啊，不然还能是什么？总不能让我去跟大团长比剑吧！"
                },
                {
                    "id": "676030203",
                    "speaker": "温弗里德",
                    "text": "大团长的身体究竟是个什么构造，怎么喝酒比喝水还轻松？明明我都用上特制的解酒药了，结果还是比不过…"
                }
            ]
        },
        {
            "talkId": "6760303",
            "initDialog": "676030301",
            "dialogues": [
                {
                    "id": "676030301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676030302",
                    "speaker": "温弗里德",
                    "text": "再见，我还是要多练练…"
                }
            ]
        },
        {
            "talkId": "6760304",
            "initDialog": "676030401",
            "dialogues": [
                {
                    "id": "676030401",
                    "speaker": "Player",
                    "text": "身体构造？"
                },
                {
                    "id": "676030402",
                    "speaker": "温弗里德",
                    "text": "呃，我们第八小队负责综合性的战地支援工作，也包括紧急医疗处理。"
                },
                {
                    "id": "676030403",
                    "speaker": "温弗里德",
                    "text": "不过每次给大团长疗伤的时候，我都会严重怀疑自己学过的医学常识。"
                },
                {
                    "id": "676030404",
                    "speaker": "温弗里德",
                    "text": "要么是震惊于这么激烈的战斗，怎么能只受这么点伤；要么是震惊于扛了这么重的伤，居然还活蹦乱跳的。"
                }
            ]
        },
        {
            "talkId": "6760305",
            "initDialog": "676030501",
            "dialogues": [
                {
                    "id": "676030501",
                    "speaker": "Player",
                    "text": "特制的药？"
                },
                {
                    "id": "676030502",
                    "speaker": "温弗里德",
                    "text": "呃，我们第八小队负责综合性的战地支援工作，也包括各种技术开发。"
                },
                {
                    "id": "676030503",
                    "speaker": "温弗里德",
                    "text": "第五小队的远程武器、最新型的防御工事…都是由我们负责的。"
                },
                {
                    "id": "676030504",
                    "speaker": "温弗里德",
                    "text": "阿贝多先生跟丽莎小姐也帮过我们许多忙，可惜他们俩一个是调查小队的，一个不愿意接任支援小队的队长…"
                },
                {
                    "id": "676030505",
                    "speaker": "温弗里德",
                    "text": "顺便一提，在我们联合开发的所有炼金药剂里，最受远征队欢迎的就是解酒药了——虽然大团长从来不用。"
                }
            ]
        },
        {
            "talkId": "7667715",
            "initDialog": "766771501",
            "dialogues": [
                {
                    "id": "766771501",
                    "speaker": "法尔伽",
                    "text": "向左转…向右转！",
                    "choices": [
                        {
                            "id": "766772301",
                            "text": "他们还没醒酒吗？",
                            "response": [
                                {
                                    "id": "766772401",
                                    "speaker": "法尔伽",
                                    "text": "…荣誉骑士，能请你来整肃他们吗？只要<color=#00E1FFFF>一边喊口号，一边找出里面犯错最多的人</color>就行。"
                                }
                            ]
                        },
                        {
                            "id": "766772201",
                            "text": "法尔伽，你们这是在？",
                            "response": [
                                {
                                    "id": "766772202",
                                    "speaker": "法尔伽",
                                    "text": "哦，这是骑士团里的队列训练。他们三个昨晚有点喝高了，我在给他们醒酒。"
                                },
                                {
                                    "id": "766772203",
                                    "speaker": "法尔伽",
                                    "text": "…顺便找出醉得最厉害的，罚跑二十圈。虽然远征军没有禁酒，但什么时候喝、每次喝多少也都是有规矩的。"
                                },
                                {
                                    "id": "766772204",
                                    "speaker": "温弗里德",
                                    "text": "我…我只喝了一点点！"
                                },
                                {
                                    "id": "766772205",
                                    "speaker": "艾克贝特",
                                    "text": "我…我也是！"
                                },
                                {
                                    "id": "766772206",
                                    "speaker": "法尔伽",
                                    "text": "…与其用言语，不如用行动来证明吧！ 给我拿出就算喝醉了也能完美应付的气势来！"
                                },
                                {
                                    "id": "766772207",
                                    "speaker": "莱夫赫姆",
                                    "text": "是…是！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}