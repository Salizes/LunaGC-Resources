{
    "groupId": "4164",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "卡姆拉": 10
    },
    "talks": [
        {
            "talkId": "6416401",
            "initDialog": "641640101",
            "dialogues": [
                {
                    "id": "641640101",
                    "speaker": "卡姆拉",
                    "text": "面朝大海，心情舒畅。"
                }
            ]
        },
        {
            "talkId": "6416402",
            "initDialog": "641640201",
            "dialogues": [
                {
                    "id": "641640201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "641640202",
                    "speaker": "卡姆拉",
                    "text": "你好啊朋友。怎么样，大海很美吧？"
                },
                {
                    "id": "641640203",
                    "speaker": "卡姆拉",
                    "text": "千万不要一直急匆匆地奔波，要懂得停下脚步，欣赏生活中的美。"
                },
                {
                    "id": "641640204",
                    "speaker": "卡姆拉",
                    "text": "自从丈夫做了水手，我就总是在这里看海。——当然，暴风雨的时候除外啦。"
                }
            ]
        },
        {
            "talkId": "6416403",
            "initDialog": "641640301",
            "dialogues": [
                {
                    "id": "641640301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641640302",
                    "speaker": "卡姆拉",
                    "text": "再见啦，好好享受海风吧。"
                }
            ]
        },
        {
            "talkId": "6416404",
            "initDialog": "641640401",
            "dialogues": [
                {
                    "id": "641640401",
                    "speaker": "Player",
                    "text": "关于你的丈夫…"
                },
                {
                    "id": "641640402",
                    "speaker": "卡姆拉",
                    "text": "哦，那个挨刀子的啊…嗯…说实话，我也不清楚他现在在哪里出海呢。"
                },
                {
                    "id": "641640403",
                    "speaker": "卡姆拉",
                    "text": "从寄回家的东西来看，他应该一切平安，还去过不少地方了。"
                },
                {
                    "id": "641640404",
                    "speaker": "卡姆拉",
                    "text": "我收到过枫丹的钟表、璃月的瓷碗、蒙德的干花…"
                },
                {
                    "id": "641640405",
                    "speaker": "卡姆拉",
                    "text": "哎，没想到这家伙还挺浪漫的呢。"
                },
                {
                    "id": "641640406",
                    "speaker": "卡姆拉",
                    "text": "不过这些东西也只能摆在家里看看啦，我嘛，还是更喜欢外面的空气，和大海的浪花。"
                }
            ]
        }
    ]
}