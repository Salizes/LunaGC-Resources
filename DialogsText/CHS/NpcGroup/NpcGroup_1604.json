{
    "groupId": "1604",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "赫尔曼": 19
    },
    "talks": [
        {
            "talkId": "7091201",
            "initDialog": "709120101",
            "dialogues": [
                {
                    "id": "709120101",
                    "speaker": "Player",
                    "text": "那个人是？"
                },
                {
                    "id": "709120102",
                    "speaker": "赫尔曼",
                    "text": "莫非…你没听说过冒险家赫尔曼？"
                },
                {
                    "id": "709120103",
                    "speaker": "赫尔曼",
                    "text": "…不，这一定是你的激将法，想要通过这样的方式来让我复出，我已经猜到了！"
                },
                {
                    "id": "709120104",
                    "speaker": "赫尔曼",
                    "text": "可惜，现在我能做的就只有给你们这样的后辈提供一些我的经验了，我已经不能再冒险了…"
                }
            ]
        },
        {
            "talkId": "41728",
            "initDialog": "616040204",
            "dialogues": [
                {
                    "id": "616040204",
                    "speaker": "Player",
                    "text": "我没说要找你…"
                },
                {
                    "id": "616040205",
                    "speaker": "赫尔曼",
                    "text": "啊，看来是我误会了，我以为又是听说过我的故事的人来打搅我。"
                },
                {
                    "id": "616040206",
                    "speaker": "赫尔曼",
                    "text": "不论你听过冒险家赫尔曼的什么传说，都不要相信。即使那些确实是真的…也不要相信！"
                },
                {
                    "id": "616040207",
                    "speaker": "赫尔曼",
                    "text": "因为那已经不是我了，我的眼里不再有星辰，只有我的妻子，不再有深渊，只有我的女儿。"
                },
                {
                    "id": "616040208",
                    "speaker": "赫尔曼",
                    "text": "只要她们在，我就再没有进行那些赌命的冒险的权利了。"
                }
            ]
        },
        {
            "talkId": "6160401",
            "initDialog": "616040101",
            "dialogues": [
                {
                    "id": "616040101",
                    "speaker": "赫尔曼",
                    "text": "瓦格纳的剑都好贵啊，唉…"
                }
            ]
        },
        {
            "talkId": "6160402",
            "initDialog": "616040201",
            "dialogues": [
                {
                    "id": "616040201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "616040202",
                    "speaker": "赫尔曼",
                    "text": "我？不不，我不是你想的那个人，你找错了。"
                },
                {
                    "id": "616040203",
                    "speaker": "赫尔曼",
                    "text": "我只是正要去买东西的普通父亲，你看，很普通是不是？"
                }
            ]
        },
        {
            "talkId": "6160403",
            "initDialog": "616040301",
            "dialogues": [
                {
                    "id": "616040301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "616040302",
                    "speaker": "赫尔曼",
                    "text": "我的宝贝女儿，艾琳，快到了去骑士团应募的年纪了，那一直是她的梦想。"
                },
                {
                    "id": "616040303",
                    "speaker": "赫尔曼",
                    "text": "她今年生日我准备送她一把剑，可是价格…"
                },
                {
                    "id": "616040304",
                    "speaker": "赫尔曼",
                    "text": "难道不去冒险的我就真的一无是处吗…"
                },
                {
                    "id": "616040305",
                    "speaker": "赫尔曼",
                    "text": "就连当年忍痛卖掉的「冷刃」的钱，都已经花光了，唉…"
                }
            ]
        },
        {
            "talkId": "6160404",
            "initDialog": "616040401",
            "dialogues": [
                {
                    "id": "616040401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616040402",
                    "speaker": "赫尔曼",
                    "text": "再见，有赚钱的方法的话，有空介绍给我吧，不赌命的那种。"
                }
            ]
        },
        {
            "talkId": "6160405",
            "initDialog": "616040501",
            "dialogues": [
                {
                    "id": "616040501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "616040502",
                    "speaker": "赫尔曼",
                    "text": "龙灾？你难道是想要劝我…"
                },
                {
                    "id": "616040503",
                    "speaker": "赫尔曼",
                    "text": "…不，不行，我不能绝对不能复出！"
                },
                {
                    "id": "616040504",
                    "speaker": "赫尔曼",
                    "text": "现在我已经是一个妻子的丈夫、一个女儿的父亲了，那个冒险家赫尔曼已经和我没有关系了！"
                },
                {
                    "id": "616040505",
                    "speaker": "赫尔曼",
                    "text": "我的命已经不属于我了，即使是为了她们我也不能再冒险了…"
                }
            ]
        }
    ]
}