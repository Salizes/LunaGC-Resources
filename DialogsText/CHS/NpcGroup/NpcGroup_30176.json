            "dialogues": [
                {
                    "id": "400634701",
                    "speaker": "翠光像",
                    "text": "（阿贝多绘制的翠光画像。）"
                },
                {
                    "id": "400634702",
                    "speaker": "翠光像",
                    "text": "（此画像以温迪为模特，亦融合了其身上蒙德服饰的特色，绘制了翠光酒后醉卧的情景。）"
                },
                {
                    "id": "400634703",
                    "speaker": "翠光像",
                    "text": "（温迪似乎对这幅作品十分喜欢，某人不得不经常提醒他：「上面画的不是你！」）"
                }
            ]
        }
    ]
