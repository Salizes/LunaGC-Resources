    "talks": [
        {
            "talkId": "6702401",
            "initDialog": "670240101",
            "dialogues": [
                {
                    "id": "670240101",
                    "speaker": "雅洛",
                    "text": "哎呀，您挡着路了。"
                }
            ]
        },
        {
            "talkId": "6702402",
            "initDialog": "670240201",
            "dialogues": [
                {
                    "id": "670240201",
                    "speaker": "Player",
                    "text": "你这么急是要去哪儿？"
                },
                {
                    "id": "670240202",
                    "speaker": "雅洛",
                    "text": "我在这里…呃，帮忙。虽然能做的事不多，但是我会努力的。而且我最近长高了，之后一定会长得更高。"
                },
                {
                    "id": "670240203",
                    "speaker": "雅洛",
                    "text": "长高了就可以像大人那样做更多事了，做更多事，就能拿到更多摩拉…"
                }
            ]
        },
        {
            "talkId": "6702403",
            "initDialog": "670240301",
            "dialogues": [
                {
                    "id": "670240301",
                    "speaker": "Player",
                    "text": "抱歉，我这就让开。"
                },
                {
                    "id": "670240302",
                    "speaker": "雅洛",
                    "text": "谢谢，您真好心。"
                }
            ]
        },
        {
            "talkId": "6702404",
            "initDialog": "670240401",
            "dialogues": [
                {
                    "id": "670240401",
                    "speaker": "Player",
                    "text": "你要那么多摩拉做什么？"
                },
                {
                    "id": "670240402",
                    "speaker": "雅洛",
                    "text": "妈妈生病了…哎呀，我不该说这件事。没什么，您快忘了吧。"
                }
            ]
        }
    ]
}