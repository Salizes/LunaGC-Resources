{
    "groupId": "6498",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "马夸胡伊特尔": 9
    },
    "talks": [
        {
            "talkId": "6649801",
            "initDialog": "664980101",
            "dialogues": [
                {
                    "id": "664980101",
                    "speaker": "马夸胡伊特尔",
                    "text": "悠悠纳塔，悠悠夏天！欢迎来到「阿夏的宝库」纪念品商店。小店售卖各种趣味玩具与纪念品。"
                }
            ]
        },
        {
            "talkId": "6649802",
            "initDialog": "664980201",
            "dialogues": [
                {
                    "id": "664980201",
                    "speaker": "Player",
                    "text": "让我看看你的货。"
                },
                {
                    "id": "664980202",
                    "speaker": "马夸胡伊特尔",
                    "text": "请看。"
                }
            ]
        },
        {
            "talkId": "6649803",
            "initDialog": "664980301",
            "dialogues": [
                {
                    "id": "664980301",
                    "speaker": "Player",
                    "text": "附近还有什么值得一去的店吗？"
                },
                {
                    "id": "664980302",
                    "speaker": "马夸胡伊特尔",
                    "text": "每家店都很有特色，用餐可以去「鱼群之家」餐厅，品尝酒水可以去提提岛的醅蜜和尝露酒吧…"
                },
                {
                    "id": "664980303",
                    "speaker": "马夸胡伊特尔",
                    "text": "如果一定要选一个没必要去的，我选「膨胀胸甲」商店吧，那家店主是我的叔叔，我很了解他。"
                },
                {
                    "id": "664980304",
                    "speaker": "Player",
                    "text": "你们之间不太愉快？"
                },
                {
                    "id": "664980305",
                    "speaker": "马夸胡伊特尔",
                    "text": "倒也不算不愉快，只是和他说话会比较费劲。"
                },
                {
                    "id": "664980306",
                    "speaker": "马夸胡伊特尔",
                    "text": "他总是说我的肌肉还没有他的脑子大，但其实他说反了，是他的脑子没有我的肌肉大才对，毕竟他连度假村的宣传语都能说反。"
                }
            ]
        },
        {
            "talkId": "6649804",
            "initDialog": "664980401",
            "dialogues": [
                {
                    "id": "664980401",
                    "speaker": "Player",
                    "text": "阿夏是什么？"
                },
                {
                    "id": "664980402",
                    "speaker": "马夸胡伊特尔",
                    "text": "你们来的路上没有见过吗？就是那种走路摇摆的可爱小东西。大家都说，它们是悠悠度假村夏天的象征。"
                },
                {
                    "id": "664980403",
                    "speaker": "马夸胡伊特尔",
                    "text": "据说，阿夏两个字在本地还有其它含义，很可惜，我对那些也不是很了解。"
                }
            ]
        },
        {
            "talkId": "6649805",
            "initDialog": "664980501",
            "dialogues": [
                {
                    "id": "664980501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664980502",
                    "speaker": "马夸胡伊特尔",
                    "text": "客人再见。"
                }
            ]
        }
    ]
}