{
    "groupId": "9075",
    "total_dialogue_lines": 73,
    "speaker_counts": {
        "Player": 15,
        "Wanderer": 58
    },
    "talks": [
        {
            "talkId": "6907501",
            "initDialog": "690750101",
            "dialogues": [
                {
                    "id": "690750101",
                    "speaker": "Wanderer",
                    "text": "哦，你在啊。"
                },
                {
                    "id": "690750102",
                    "speaker": "Wanderer",
                    "text": "真是不好意思，差点把你错怪成会把客人晾在家里自力更生的类型。"
                }
            ]
        },
        {
            "talkId": "6907502",
            "initDialog": "690750201",
            "dialogues": [
                {
                    "id": "690750201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690750202",
                    "speaker": "Wanderer",
                    "text": "……",
                    "choices": [
                        {
                            "id": "690750203",
                            "text": "怎、怎么了？",
                            "response": [
                                {
                                    "id": "690750204",
                                    "speaker": "Wanderer",
                                    "text": "你才是这里的主人吧，紧张什么呢，不像样。"
                                },
                                {
                                    "id": "690750207",
                                    "speaker": "Wanderer",
                                    "text": "…也没什么，只是在思考无聊的问题。"
                                },
                                {
                                    "id": "690750208",
                                    "speaker": "Wanderer",
                                    "text": "你这个…住处，怎么有的地方空旷得很哪。",
                                    "choices": [
                                        {
                                            "id": "690750209",
                                            "text": "够用了，这是留白的美。",
                                            "response": [
                                                {
                                                    "id": "690750210",
                                                    "speaker": "Wanderer",
                                                    "text": "随意评论主人的生活风格是不礼貌的。"
                                                },
                                                {
                                                    "id": "690750211",
                                                    "speaker": "Wanderer",
                                                    "text": "你好心招待我来，我自当感激不尽。"
                                                },
                                                {
                                                    "id": "690750215",
                                                    "speaker": "Wanderer",
                                                    "text": "这是你的地盘，按你高兴的方式安排吧。"
                                                },
                                                {
                                                    "id": "690750216",
                                                    "speaker": "Wanderer",
                                                    "text": "我只是过客。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690750212",
                                            "text": "没办法，我也想塞满点的。",
                                            "response": [
                                                {
                                                    "id": "690750213",
                                                    "speaker": "Wanderer",
                                                    "text": "啊，我懂，总有力不能及的事情嘛。"
                                                },
                                                {
                                                    "id": "690750214",
                                                    "speaker": "Wanderer",
                                                    "text": "有时情况会慢慢变好，有时也只能保持现状。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690750205",
                            "text": "有话直说。",
                            "response": [
                                {
                                    "id": "690750206",
                                    "speaker": "Wanderer",
                                    "text": "哼。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907503",
            "initDialog": "690750301",
            "dialogues": [
                {
                    "id": "690750301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690750302",
                    "speaker": "Wanderer",
                    "text": "客随主便，请吧。"
                },
                {
                    "id": "690750303",
                    "speaker": "Wanderer",
                    "text": "…怎么，在等我开启话题吗？那可能等不到了哦。"
                },
                {
                    "id": "690750304",
                    "speaker": "Wanderer",
                    "text": "倒不是无话可说，只是我的话…免不了要煞风景。"
                },
                {
                    "id": "690750305",
                    "speaker": "Player",
                    "text": "没关系，我是知道你的。"
                },
                {
                    "id": "690750306",
                    "speaker": "Wanderer",
                    "text": "了解我并不是什么了不起的事情吧，我现在总是直言不讳。"
                },
                {
                    "id": "690750307",
                    "speaker": "Wanderer",
                    "text": "…虽然在很久以前并非如此。"
                },
                {
                    "id": "690750308",
                    "speaker": "Wanderer",
                    "text": "你知道我为什么喜欢茶吗？"
                },
                {
                    "id": "690750309",
                    "speaker": "Wanderer",
                    "text": "我初次喝茶时只觉得入口艰涩，从第一口苦到最后一口，也全然没有回甘的感受。"
                },
                {
                    "id": "690750310",
                    "speaker": "Wanderer",
                    "text": "但那时的我干坐在刀匠们身边，既不知道怎么才能加入人类的对话，也不了解他们的生活习惯。"
                },
                {
                    "id": "690750311",
                    "speaker": "Wanderer",
                    "text": "有人把盛着茶汤的杯盏推到我面前，我为了有事可做，就一个劲儿地喝茶，一杯接着一杯。"
                },
                {
                    "id": "690750312",
                    "speaker": "Wanderer",
                    "text": "哈哈…现在想来，他们可能是真的以为我喜欢喝茶吧。"
                },
                {
                    "id": "690750313",
                    "speaker": "Player",
                    "text": "那现在呢？"
                },
                {
                    "id": "690750314",
                    "speaker": "Wanderer",
                    "text": "如今尝尽世间百味，结果发现竟然还是苦的最好。"
                },
                {
                    "id": "690750315",
                    "speaker": "Wanderer",
                    "text": "不用刺激遮盖无趣，也不用甘甜粉饰太平，将生活最原本的味道展示在你面前。"
                },
                {
                    "id": "690750316",
                    "speaker": "Wanderer",
                    "text": "我觉得拐弯抹角不好，人就该学着坦率。"
                },
                {
                    "id": "690750317",
                    "speaker": "Wanderer",
                    "text": "苦味就是苦味，不会因为之前或者之后的甜而改变。"
                },
                {
                    "id": "690750318",
                    "speaker": "Wanderer",
                    "text": "所以，没必要用什么「苦尽甘来」糊弄自己。"
                }
            ]
        },
        {
            "talkId": "6907504",
            "initDialog": "690750401",
            "dialogues": [
                {
                    "id": "690750401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690750402",
                    "speaker": "Wanderer",
                    "text": "这样发问，是准备满足我提出的任何需求吗？"
                },
                {
                    "id": "690750403",
                    "speaker": "Wanderer",
                    "text": "那我可得好好想想，测试一下你能为我做到什么程度…"
                },
                {
                    "id": "690750404",
                    "speaker": "Wanderer",
                    "text": "——逗你的。"
                },
                {
                    "id": "690750405",
                    "speaker": "Wanderer",
                    "text": "虽然你在预感不妙时的表情很耐人寻味，但我并没有故意为难你的癖好。"
                },
                {
                    "id": "690750406",
                    "speaker": "Wanderer",
                    "text": "不过你要真是闲着没事，不如去给我弄点吃的吧。"
                },
                {
                    "id": "690750407",
                    "speaker": "Player",
                    "text": "人偶也需要吃饭吗？"
                },
                {
                    "id": "690750408",
                    "speaker": "Wanderer",
                    "text": "不必须，至少我不用。"
                },
                {
                    "id": "690750409",
                    "speaker": "Wanderer",
                    "text": "但饭桌是个很有意思的地方。"
                },
                {
                    "id": "690750410",
                    "speaker": "Wanderer",
                    "text": "大家各怀鬼胎，表面上却还得推杯换盏，互相问候。"
                },
                {
                    "id": "690750411",
                    "speaker": "Wanderer",
                    "text": "嘻嘻，真想带你去见识一次执行官们的饭局。"
                },
                {
                    "id": "690750412",
                    "speaker": "Wanderer",
                    "text": "他们为了逃避不喜欢的任务，什么都做得出来。"
                },
                {
                    "id": "690750413",
                    "speaker": "Wanderer",
                    "text": "可惜现在只有你我，肯定不会有那么戏剧性的场面了。"
                },
                {
                    "id": "690750414",
                    "speaker": "Wanderer",
                    "text": "我不挑剔，你做什么我就吃什么。",
                    "choices": [
                        {
                            "id": "690750415",
                            "text": "还是给点建议吧。",
                            "response": [
                                {
                                    "id": "690750416",
                                    "speaker": "Wanderer",
                                    "text": "那就做你最喜欢的吧。"
                                },
                                {
                                    "id": "690750417",
                                    "speaker": "Wanderer",
                                    "text": "万一吃饭时尴尬到说不出话来，至少还可以享受食物。"
                                }
                            ]
                        },
                        {
                            "id": "690750418",
                            "text": "那我要准备一大桌甜食——",
                            "response": [
                                {
                                    "id": "690750419",
                                    "speaker": "Wanderer",
                                    "text": "…我错了。"
                                },
                                {
                                    "id": "690750420",
                                    "speaker": "Player",
                                    "text": "欸？怎么突然道歉…"
                                },
                                {
                                    "id": "690750421",
                                    "speaker": "Wanderer",
                                    "text": "谁道歉了！"
                                },
                                {
                                    "id": "690750422",
                                    "speaker": "Wanderer",
                                    "text": "只是在承认自己判断失误罢了。"
                                },
                                {
                                    "id": "690750423",
                                    "speaker": "Wanderer",
                                    "text": "不过你能有些坏心思也算是好事。"
                                },
                                {
                                    "id": "690750424",
                                    "speaker": "Wanderer",
                                    "text": "你要是太过善良，我反而很难办呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907505",
            "initDialog": "690750501",
            "dialogues": [
                {
                    "id": "690750501",
                    "speaker": "Player",
                    "text": "早啊。"
                },
                {
                    "id": "690750502",
                    "speaker": "Wanderer",
                    "text": "早上好。"
                },
                {
                    "id": "690750503",
                    "speaker": "Wanderer",
                    "text": "崭新的一天，崭新的生活，呵。"
                }
            ]
        },
        {
            "talkId": "6907506",
            "initDialog": "690750601",
            "dialogues": [
                {
                    "id": "690750601",
                    "speaker": "Player",
                    "text": "晚安。"
                },
                {
                    "id": "690750602",
                    "speaker": "Wanderer",
                    "text": "看样子又是平淡无奇的一天？也好。"
                },
                {
                    "id": "690750603",
                    "speaker": "Wanderer",
                    "text": "劳你费心关照，早些睡吧。"
                },
                {
                    "id": "690750604",
                    "speaker": "Wanderer",
                    "text": "我还不想休息。"
                }
            ]
        },
        {
            "talkId": "6907507",
            "initDialog": "690750701",
            "dialogues": [
                {
                    "id": "690750701",
                    "speaker": "Wanderer",
                    "text": "……"
                },
                {
                    "id": "690750702",
                    "speaker": "Wanderer",
                    "text": "很久以前，我在还祈求成为「人」的时候，也曾希望过上普通的生活。"
                },
                {
                    "id": "690750703",
                    "speaker": "Wanderer",
                    "text": "愿望不会因为没能实现而变得更珍贵，但也不必因其落空就质疑当时的真心，对吧？"
                }
            ]
        },
        {
            "talkId": "6907508",
            "initDialog": "690750801",
            "dialogues": [
                {
                    "id": "690750801",
                    "speaker": "Wanderer",
                    "text": "稻妻的林木过于幽暗，至冬的又都冷冰冰的。"
                },
                {
                    "id": "690750802",
                    "speaker": "Wanderer",
                    "text": "像这样温暖湿润、生机勃勃的环境，我并不讨厌。"
                },
                {
                    "id": "690750803",
                    "speaker": "Wanderer",
                    "text": "惊讶什么，我也有心情好的时候呀。"
                }
            ]
        }
    ]
}