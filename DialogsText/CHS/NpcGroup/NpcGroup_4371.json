{
    "groupId": "4371",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "莎梅耶": 7
    },
    "talks": [
        {
            "talkId": "6437101",
            "initDialog": "643710101",
            "dialogues": [
                {
                    "id": "643710101",
                    "speaker": "莎梅耶",
                    "text": "您好。请问您也是来这里慕名参观的客人吗？"
                }
            ]
        },
        {
            "talkId": "6437102",
            "initDialog": "643710201",
            "dialogues": [
                {
                    "id": "643710201",
                    "speaker": "Player",
                    "text": "这里是著名景点吗？"
                },
                {
                    "id": "643710202",
                    "speaker": "莎梅耶",
                    "text": "呵呵，很遗憾，并不是。这里仅是一处私人住宅罢了。"
                },
                {
                    "id": "643710203",
                    "speaker": "莎梅耶",
                    "text": "只是因为由著名建筑师设计，偶尔会有三三两两前来拜访的人。"
                },
                {
                    "id": "643710204",
                    "speaker": "莎梅耶",
                    "text": "但毕竟是私人住所，所以并不接受室内参观，还请见谅。"
                },
                {
                    "id": "643710205",
                    "speaker": "莎梅耶",
                    "text": "啊…另外，也烦请客人不要大肆宣传此事。"
                },
                {
                    "id": "643710206",
                    "speaker": "莎梅耶",
                    "text": "虽然老爷心胸宽广，并不禁止客人在花园游览，但老爷将家宅建在此处的本意仍是为了清净避世，所以还望您理解。"
                }
            ]
        },
        {
            "talkId": "6437103",
            "initDialog": "643710301",
            "dialogues": [
                {
                    "id": "643710301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643710302",
                    "speaker": "莎梅耶",
                    "text": "再见。"
                }
            ]
        }
    ]
}