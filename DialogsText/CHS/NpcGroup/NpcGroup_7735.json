    "talks": [
        {
            "talkId": "6773501",
            "initDialog": "677350101",
            "dialogues": [
                {
                    "id": "677350101",
                    "speaker": "丛沈",
                    "text": "梦幻空花，何劳把捉？便是究理千年，一心不生，只是不会了。"
                }
            ]
        },
        {
            "talkId": "6773502",
            "initDialog": "677350201",
            "dialogues": [
                {
                    "id": "677350201",
                    "speaker": "Player",
                    "text": "所以…你是在找书吗？"
                },
                {
                    "id": "677350202",
                    "speaker": "丛沈",
                    "text": "你曾到过此地么？",
                    "choices": [
                        {
                            "id": "677350203",
                            "text": "啊？",
                            "response": [
                                {
                                    "id": "677350206",
                                    "speaker": "丛沈",
                                    "text": "那你便会了。",
                                    "choices": [
                                        {
                                            "id": "677350207",
                                            "text": "会…会什么了？",
                                            "response": [
                                                {
                                                    "id": "677350209",
                                                    "speaker": "丛沈",
                                                    "text": "要眠即眠，要会即会。"
                                                },
                                                {
                                                    "id": "677350210",
                                                    "speaker": "丛沈",
                                                    "text": "你且归，世界坏时，归去就是。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "677350208",
                                            "text": "如何是会？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "677350204",
                            "text": "到过。"
                        },
                        {
                            "id": "677350205",
                            "text": "没到过。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6773503",
            "initDialog": "677350301",
            "dialogues": [
                {
                    "id": "677350301",
                    "speaker": "Player",
                    "text": "完全听不懂，告辞。"
                },
                {
                    "id": "677350302",
                    "speaker": "丛沈",
                    "text": "直走。"
                }
            ]
        }
    ]
}