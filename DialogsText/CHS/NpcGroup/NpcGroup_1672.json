{
    "groupId": "1672",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "汤米": 9
    },
    "talks": [
        {
            "talkId": "6167201",
            "initDialog": "616720101",
            "dialogues": [
                {
                    "id": "616720101",
                    "speaker": "汤米",
                    "text": "我这双眼睛真是白长了…要是没接这个委托就好了…"
                }
            ]
        },
        {
            "talkId": "6167202",
            "initDialog": "616720201",
            "dialogues": [
                {
                    "id": "616720201",
                    "speaker": "Player",
                    "text": "你在发愁什么？"
                },
                {
                    "id": "616720202",
                    "speaker": "汤米",
                    "text": "我在说我前段时间接到的那个委托呢。"
                },
                {
                    "id": "616720203",
                    "speaker": "汤米",
                    "text": "当时我一看是低级委托，又看到发布人是我仰慕已久的砂…咳咳，是某位炼金术士小姐…"
                },
                {
                    "id": "616720204",
                    "speaker": "汤米",
                    "text": "…那时我光顾着想委托完成之后，说不定能发展成长期合作的关系什么的…"
                },
                {
                    "id": "616720205",
                    "speaker": "汤米",
                    "text": "结果我回过神才发现，这里面问题太大了！"
                }
            ]
        },
        {
            "talkId": "6167203",
            "initDialog": "616720301",
            "dialogues": [
                {
                    "id": "616720301",
                    "speaker": "Player",
                    "text": "委托很难吗？"
                },
                {
                    "id": "616720302",
                    "speaker": "汤米",
                    "text": "难倒是不难，任务只需要收集一些炼金材料，但是…我当时没留意到地点是龙脊雪山啊！"
                },
                {
                    "id": "616720303",
                    "speaker": "汤米",
                    "text": "要是考虑到委托的地点，这绝对应该算面向顶级冒险家的高难度委托啊！"
                },
                {
                    "id": "616720304",
                    "speaker": "汤米",
                    "text": "协会的委托难度评估绝对不正常啊…不过也怪我接委托时没仔细看，唉…"
                }
            ]
        },
        {
            "talkId": "6167204",
            "initDialog": "616720401",
            "dialogues": [
                {
                    "id": "616720401",
                    "speaker": "Player",
                    "text": "再见，祝你顺利。"
                },
                {
                    "id": "616720402",
                    "speaker": "汤米",
                    "text": "谢谢，也祝你旅途顺利。"
                }
            ]
        }
    ]
}