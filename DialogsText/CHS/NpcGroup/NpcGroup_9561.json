{
    "groupId": "9561",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "夏洛蒂": 10
    },
    "talks": [
        {
            "talkId": "6956101",
            "initDialog": "695610101",
            "dialogues": [
                {
                    "id": "695610101",
                    "speaker": "夏洛蒂",
                    "text": "「七圣召唤」的受众果然很广啊，打牌的人都要把酒馆塞满了。唔，过一会我要去采…呃，不对不对，请教他们几个问题…"
                }
            ]
        },
        {
            "talkId": "6956102",
            "initDialog": "695610201",
            "dialogues": [
                {
                    "id": "695610201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956103",
            "initDialog": "695610301",
            "dialogues": [
                {
                    "id": "695610301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695610302",
                    "speaker": "夏洛蒂",
                    "text": "你要走了？我还得再留一会。总觉得…我刚才提出的那些问题都不算太有价值…"
                }
            ]
        },
        {
            "talkId": "6956104",
            "initDialog": "695610401",
            "dialogues": [
                {
                    "id": "695610401",
                    "speaker": "夏洛蒂",
                    "text": "不好意思，我赢啦。哼哼，可不要小瞧我喔。我偶尔也会从其他杂志和报纸上学几招的。"
                }
            ]
        },
        {
            "talkId": "6956105",
            "initDialog": "695610501",
            "dialogues": [
                {
                    "id": "695610501",
                    "speaker": "夏洛蒂",
                    "text": "你、你最后用的这一手我都没见过！能详细和我讲讲吗？我周末要去采访一位七圣召唤牌手，用这个来打开话题一定不错！"
                }
            ]
        },
        {
            "talkId": "6956106",
            "initDialog": "695610601",
            "dialogues": [
                {
                    "id": "695610601",
                    "speaker": "夏洛蒂",
                    "text": "好呀，我早就想和你来一局七圣召唤了。"
                }
            ]
        },
        {
            "talkId": "6956108",
            "initDialog": "695610801",
            "dialogues": [
                {
                    "id": "695610801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956109",
            "initDialog": "695610901",
            "dialogues": [
                {
                    "id": "695610901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956110",
            "initDialog": "695611001",
            "dialogues": [
                {
                    "id": "695611001",
                    "speaker": "夏洛蒂",
                    "text": "原来在七圣召唤中获胜是这种感觉…不错，值得写一篇文章。"
                }
            ]
        },
        {
            "talkId": "6956111",
            "initDialog": "695611101",
            "dialogues": [
                {
                    "id": "695611101",
                    "speaker": "夏洛蒂",
                    "text": "输掉了，哎呀…只错了那么几手，就输掉了整局比赛。七圣召唤真复杂啊…"
                }
            ]
        },
        {
            "talkId": "6956112",
            "initDialog": "695611201",
            "dialogues": [
                {
                    "id": "695611201",
                    "speaker": "夏洛蒂",
                    "text": "没问题，我早就准备好了。我的牌组可是「集诸家之所长」喔。"
                }
            ]
        },
        {
            "talkId": "6956114",
            "initDialog": "695611401",
            "dialogues": [
                {
                    "id": "695611401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956115",
            "initDialog": "695611501",
            "dialogues": [
                {
                    "id": "695611501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956116",
            "initDialog": "695611601",
            "dialogues": [
                {
                    "id": "695611601",
                    "speaker": "夏洛蒂",
                    "text": "这局是我赢啦。嘿嘿，不愧是我亲手组出来的最强牌组。"
                }
            ]
        },
        {
            "talkId": "6956117",
            "initDialog": "695611701",
            "dialogues": [
                {
                    "id": "695611701",
                    "speaker": "夏洛蒂",
                    "text": "奇怪，我牌组里的每一张牌都很厉害啊，把它们组合起来，不是应该更厉害吗…"
                }
            ]
        },
        {
            "talkId": "6956118",
            "initDialog": "695611801",
            "dialogues": [
                {
                    "id": "695611801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}