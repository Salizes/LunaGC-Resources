            "dialogues": [
                {
                    "id": "716580301",
                    "speaker": "刻晴",
                    "text": "如何？今年的烟花会好看吗？"
                },
                {
                    "id": "716580302",
                    "speaker": "刻晴",
                    "text": "希望我们的节目能让期待节日的人感到高兴。",
                    "choices": [
                        {
                            "id": "716580303",
                            "text": "很好看。",
                            "response": [
                                {
                                    "id": "716580305",
                                    "speaker": "刻晴",
                                    "text": "真的？应该不是为了安慰我才这么说的吧？有意见要直说哦。"
                                },
                                {
                                    "id": "716580306",
                                    "speaker": "刻晴",
                                    "text": "总之…节庆期间你有时间的话，记得到处走走。景致难得，不要错过。"
                                },
                                {
                                    "id": "716580307",
                                    "speaker": "刻晴",
                                    "text": "我的空闲时间能再多一点就好了…真想带你四处逛逛，让你看看我们为这次海灯节精心准备的布设。"
                                }
                            ]
                        },
                        {
                            "id": "716580304",
                            "text": "我很喜欢。"
                        }
                    ]
                }
            ]
        }
    ]
