{
    "groupId": "6059",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "卡拉穆鲁": 14
    },
    "talks": [
        {
            "talkId": "6605901",
            "initDialog": "660590101",
            "dialogues": [
                {
                    "id": "660590101",
                    "speaker": "卡拉穆鲁",
                    "text": "哎呀，早上好！不对，现在是早上吗…总之，白天好！"
                }
            ]
        },
        {
            "talkId": "6605902",
            "initDialog": "660590201",
            "dialogues": [
                {
                    "id": "660590201",
                    "speaker": "Player",
                    "text": "关于我在「流泉之众」的声望…"
                },
                {
                    "id": "660590202",
                    "speaker": "卡拉穆鲁",
                    "text": "感谢感谢，非常感谢你愿意帮忙啊。"
                }
            ]
        },
        {
            "talkId": "6605903",
            "initDialog": "660590301",
            "dialogues": [
                {
                    "id": "660590301",
                    "speaker": "Player",
                    "text": "你好，这里是…"
                },
                {
                    "id": "660590302",
                    "speaker": "卡拉穆鲁",
                    "text": "「曜石图腾柱」，很气派吧！据说能直接和「大灵」连接哦！"
                },
                {
                    "id": "660590303",
                    "speaker": "卡拉穆鲁",
                    "text": "嗯，大概就是这样的圣物。具体我记不太清了，哈哈，我历史学得不是很好。"
                },
                {
                    "id": "660590304",
                    "speaker": "卡拉穆鲁",
                    "text": "如果你有什么想深入了解的知识，请去咨询晚上当值的人吧！"
                },
                {
                    "id": "660590305",
                    "speaker": "卡拉穆鲁",
                    "text": "总之，如果你愿意帮流泉之众一些小忙，曜石图腾柱也会对你好的。"
                }
            ]
        },
        {
            "talkId": "6605904",
            "initDialog": "660590401",
            "dialogues": [
                {
                    "id": "660590401",
                    "speaker": "Player",
                    "text": "白天好。"
                },
                {
                    "id": "660590402",
                    "speaker": "卡拉穆鲁",
                    "text": "你好你好。可惜现在不能和你聊太长时间。"
                },
                {
                    "id": "660590403",
                    "speaker": "卡拉穆鲁",
                    "text": "我不是内向的人哈，但不管怎么说现在是工作时间，被人抓住在偷懒的话总归不太好。"
                },
                {
                    "id": "660590404",
                    "speaker": "卡拉穆鲁",
                    "text": "你问是什么工作？是值班啦。值班就是…只要人在这里就好了，对不对？"
                }
            ]
        },
        {
            "talkId": "6605905",
            "initDialog": "660590501",
            "dialogues": [
                {
                    "id": "660590501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660590502",
                    "speaker": "卡拉穆鲁",
                    "text": "那晚上下班见！"
                }
            ]
        },
        {
            "talkId": "6605906",
            "initDialog": "660590601",
            "dialogues": [
                {
                    "id": "660590601",
                    "speaker": "卡拉穆鲁",
                    "text": "晚风也是伴奏的一部分呢。"
                }
            ]
        },
        {
            "talkId": "6605907",
            "initDialog": "660590701",
            "dialogues": [
                {
                    "id": "660590701",
                    "speaker": "Player",
                    "text": "晚上好。"
                },
                {
                    "id": "660590702",
                    "speaker": "卡拉穆鲁",
                    "text": "你好，如果是有关「曜石图腾柱」的事情，请找卡胡那先生！我现在已经下班啦。"
                },
                {
                    "id": "660590703",
                    "speaker": "卡拉穆鲁",
                    "text": "如果想一起听音乐的话，请便，我不介意多个伙伴。"
                }
            ]
        },
        {
            "talkId": "6605908",
            "initDialog": "660590801",
            "dialogues": [
                {
                    "id": "660590801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660590802",
                    "speaker": "卡拉穆鲁",
                    "text": "不再多听一会儿？"
                }
            ]
        }
    ]
}