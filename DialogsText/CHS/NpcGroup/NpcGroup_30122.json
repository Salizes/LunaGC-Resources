            "dialogues": [
                {
                    "id": "716580501",
                    "speaker": "香菱",
                    "text": "东家预定明晚的酒宴两桌，西家订的餐要送上门…"
                },
                {
                    "id": "716580502",
                    "speaker": "香菱",
                    "text": "#啊，{NICKNAME}，你来了！海灯节快乐！",
                    "choices": [
                        {
                            "id": "716580503",
                            "text": "你还好吗？",
                            "response": [
                                {
                                    "id": "716580504",
                                    "speaker": "香菱",
                                    "text": "还好还好，忙点才是过节嘛。"
                                },
                                {
                                    "id": "716580507",
                                    "speaker": "香菱",
                                    "text": "你要是想念万民堂的味道，千万别怕麻烦我。事情再多，陪你的工夫总是有的，嘿嘿。"
                                }
                            ]
                        },
                        {
                            "id": "716580505",
                            "text": "锅巴最近如何？",
                            "response": [
                                {
                                    "id": "716580506",
                                    "speaker": "香菱",
                                    "text": "嘿嘿，多谢你惦记他。灶前灶后都很火热，锅巴也很开心。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}