{
    "groupId": "5220",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "纳库尔": 8
    },
    "talks": [
        {
            "talkId": "6522001",
            "initDialog": "652200101",
            "dialogues": [
                {
                    "id": "652200101",
                    "speaker": "纳库尔",
                    "text": "其他领域的研究成果也颇有趣味…"
                }
            ]
        },
        {
            "talkId": "6522002",
            "initDialog": "652200201",
            "dialogues": [
                {
                    "id": "652200201",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "652200202",
                    "speaker": "纳库尔",
                    "text": "短期来看，我在这里读绿衣小童赠给我的论文集。他是个很有智慧的有趣人物，令人钦佩。"
                }
            ]
        },
        {
            "talkId": "6522003",
            "initDialog": "652200301",
            "dialogues": [
                {
                    "id": "652200301",
                    "speaker": "Player",
                    "text": "关于梅洛彼得堡…"
                },
                {
                    "id": "652200302",
                    "speaker": "纳库尔",
                    "text": "此处有种迷人的气质，三言两语很难道清。迷人但也危险，会让人难以离开。"
                },
                {
                    "id": "652200303",
                    "speaker": "纳库尔",
                    "text": "我说不准哪种选择更好，但是那些决意留在此处的人的例子总让我感到悚惧。"
                }
            ]
        },
        {
            "talkId": "6522004",
            "initDialog": "652200401",
            "dialogues": [
                {
                    "id": "652200401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "652200402",
                    "speaker": "纳库尔",
                    "text": "哪里的话。对我来说，能在这里和人聊天总是有益的。"
                }
            ]
        },
        {
            "talkId": "6522005",
            "initDialog": "652200501",
            "dialogues": [
                {
                    "id": "652200501",
                    "speaker": "纳库尔",
                    "text": "难办的事就不去管它，从尚有希望能够办成的事开始考虑…"
                }
            ]
        },
        {
            "talkId": "6522006",
            "initDialog": "652200601",
            "dialogues": [
                {
                    "id": "652200601",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "652200602",
                    "speaker": "纳库尔",
                    "text": "短期来看，与卡兰萨交涉。但他太顽固，也许在说服他以前，我已经获得全部所需材料，可以离开枫丹。"
                }
            ]
        },
        {
            "talkId": "6522007",
            "initDialog": "652200701",
            "dialogues": [
                {
                    "id": "652200701",
                    "speaker": "Player",
                    "text": "关于某人…"
                },
                {
                    "id": "652200702",
                    "speaker": "纳库尔",
                    "text": "这世上的确有无论如何也办不成的事。遇上了，最好放弃，越快越好。"
                }
            ]
        }
    ]
}