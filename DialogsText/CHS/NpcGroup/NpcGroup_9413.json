{
    "groupId": "9413",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "布伦妮": 9
    },
    "talks": [
        {
            "talkId": "6941301",
            "initDialog": "694130101",
            "dialogues": [
                {
                    "id": "694130101",
                    "speaker": "布伦妮",
                    "text": "累了才休息？又是大人们那套莫名其妙的理论。"
                },
                {
                    "id": "694130102",
                    "speaker": "布伦妮",
                    "text": "照这个理论，是不是要饿晕了才吃饭，渴死了才喝水？总之你不要听他们的。"
                },
                {
                    "id": "694130103",
                    "speaker": "布伦妮",
                    "text": "我看过相关的医学研究，预防性休息比事后修复重要多了。"
                }
            ]
        },
        {
            "talkId": "6941302",
            "initDialog": "694130201",
            "dialogues": [
                {
                    "id": "694130201",
                    "speaker": "布伦妮",
                    "text": "哼，「幻想真境剧诗」…一看就是魔女的手笔啊。"
                },
                {
                    "id": "694130202",
                    "speaker": "布伦妮",
                    "text": "正合我意，就当提前预演吧！我的「猎魔演练计划」又可以更新一稿了。"
                },
                {
                    "id": "694130203",
                    "speaker": "布伦妮",
                    "text": "这关乎我跟魔女之间的私人恩怨，我绝对不会认输的。"
                }
            ]
        },
        {
            "talkId": "6941303",
            "initDialog": "694130301",
            "dialogues": [
                {
                    "id": "694130301",
                    "speaker": "布伦妮",
                    "text": "艾莉丝——我知道你听得到！你肯定在某个地方偷看吧！"
                },
                {
                    "id": "694130302",
                    "speaker": "布伦妮",
                    "text": "不肯出来？还是不敢出来？又或是有正义的盟友在我身边你自觉理亏？你也为自己做过的事羞耻吧？"
                },
                {
                    "id": "694130303",
                    "speaker": "布伦妮",
                    "text": "啊——再不出来我就！我就…明天还来！记住，我跟你没完！"
                }
            ]
        }
    ]
}