{
    "groupId": "9125",
    "total_dialogue_lines": 98,
    "speaker_counts": {
        "Player": 37,
        "哥伦比娅": 61
    },
    "talks": [
        {
            "talkId": "6912501",
            "initDialog": "691250101",
            "dialogues": [
                {
                    "id": "691250101",
                    "speaker": "哥伦比娅",
                    "text": "你好。"
                },
                {
                    "id": "691250102",
                    "speaker": "哥伦比娅",
                    "text": "这里是你的庭院。所以这次轮到我主动打招呼了。"
                }
            ]
        },
        {
            "talkId": "6912502",
            "initDialog": "691250201",
            "dialogues": [
                {
                    "id": "691250201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691250202",
                    "speaker": "哥伦比娅",
                    "text": "唔…其实不太习惯。"
                },
                {
                    "id": "691250203",
                    "speaker": "Player",
                    "text": "欸…是太吵闹了吗？"
                },
                {
                    "id": "691250204",
                    "speaker": "哥伦比娅",
                    "text": "不，和那没关系。"
                },
                {
                    "id": "691250205",
                    "speaker": "哥伦比娅",
                    "text": "只是以前都是你到我住的地方来做客，现在我突然变成了客人，有些不习惯。"
                },
                {
                    "id": "691250206",
                    "speaker": "哥伦比娅",
                    "text": "我应该做些什么呢？陪你聊聊天？还是和你一起做游戏？",
                    "choices": [
                        {
                            "id": "691250207",
                            "text": "把这里当成「家」…",
                            "response": [
                                {
                                    "id": "691250209",
                                    "speaker": "哥伦比娅",
                                    "text": "真的吗？唔…那，我可以在附近一边散步一边唱歌吗？"
                                },
                                {
                                    "id": "691250210",
                                    "speaker": "Player",
                                    "text": "当然可以。"
                                },
                                {
                                    "id": "691250211",
                                    "speaker": "哥伦比娅",
                                    "text": "也可以想休息的时候，就随便找一个地方睡下？"
                                },
                                {
                                    "id": "691250212",
                                    "speaker": "Player",
                                    "text": "需要枕头就叫我。"
                                },
                                {
                                    "id": "691250213",
                                    "speaker": "哥伦比娅",
                                    "text": "采一些你种的花草也没事吗？就像你偶尔会到银月之庭采走月落银那样。",
                                    "choices": [
                                        {
                                            "id": "691250214",
                                            "text": "原来你都知道…",
                                            "response": [
                                                {
                                                    "id": "691250216",
                                                    "speaker": "哥伦比娅",
                                                    "text": "哈哈，开个小玩笑。如果它们能帮到你的旅途，我自然不会介意的。"
                                                },
                                                {
                                                    "id": "691250217",
                                                    "speaker": "哥伦比娅",
                                                    "text": "你将这里的景致打理得很舒心，我静静享受它们就已经很满足了。"
                                                },
                                                {
                                                    "id": "691250218",
                                                    "speaker": "哥伦比娅",
                                                    "text": "唔…是不是我也该试着装点一下银月之庭了呢？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691250215",
                                            "text": "原来你记仇了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691250208",
                            "text": "做你想做的就好…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912503",
            "initDialog": "691250301",
            "dialogues": [
                {
                    "id": "691250301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691250302",
                    "speaker": "哥伦比娅",
                    "text": "好呀。但或许需要你来开启话题。我平时很少和人聊天。"
                },
                {
                    "id": "691250303",
                    "speaker": "哥伦比娅",
                    "text": "就算是在「愚人众」，开会的时候我也大多待在角落，不加入其他执行官的讨论。"
                },
                {
                    "id": "691250304",
                    "speaker": "哥伦比娅",
                    "text": "他们的话题大多很无聊，他想要那个，他又要争取这个…互不相让。"
                },
                {
                    "id": "691250305",
                    "speaker": "Player",
                    "text": "（结果她自顾自说起来了…）"
                },
                {
                    "id": "691250306",
                    "speaker": "哥伦比娅",
                    "text": "但令我困扰的是，有时他们会来征询我的意见。"
                },
                {
                    "id": "691250307",
                    "speaker": "哥伦比娅",
                    "text": "我一直都是闭着眼睛的，他们以为我在安静地听。但很多时候我不是在想其他事，就是睡着了。"
                },
                {
                    "id": "691250308",
                    "speaker": "哥伦比娅",
                    "text": "但也不是没法接话。每到这种时候，我只要随便选一个提问的人。表示他或她说得对就行了。"
                },
                {
                    "id": "691250309",
                    "speaker": "哥伦比娅",
                    "text": "「富人」和「公鸡」争辩的话，就说「公鸡」说得对。「博士」和阿蕾奇诺的话，就选阿蕾奇诺。"
                },
                {
                    "id": "691250310",
                    "speaker": "哥伦比娅",
                    "text": "「队长」总是对的，桑多涅有时比较固执，但一般也是对的。"
                },
                {
                    "id": "691250311",
                    "speaker": "哥伦比娅",
                    "text": "如果「队长」和桑多涅同时问我意见？唔…这种情况很少见。如果真的发生了的话…我可能会说两边都有道理。"
                },
                {
                    "id": "691250312",
                    "speaker": "哥伦比娅",
                    "text": "毕竟他们两个其实都很有主见，我的意见不会影响他们的判断。"
                },
                {
                    "id": "691250313",
                    "speaker": "哥伦比娅",
                    "text": "咦…？你是要和我聊什么来着…",
                    "choices": [
                        {
                            "id": "691250314",
                            "text": "其实就这样聊天就好…",
                            "response": [
                                {
                                    "id": "691250316",
                                    "speaker": "哥伦比娅",
                                    "text": "是吗？你喜欢听就好。"
                                },
                                {
                                    "id": "691250317",
                                    "speaker": "哥伦比娅",
                                    "text": "比起和人交谈，我更喜欢和月灵们聊天。"
                                },
                                {
                                    "id": "691250318",
                                    "speaker": "哥伦比娅",
                                    "text": "它们的想法都很单纯，不会隐藏自己的想法。"
                                },
                                {
                                    "id": "691250319",
                                    "speaker": "哥伦比娅",
                                    "text": "「想一起玩」，「想听故事」，「想睡觉」，「那里有好东西」…"
                                },
                                {
                                    "id": "691250320",
                                    "speaker": "哥伦比娅",
                                    "text": "它们眼中的世界很单纯，也很美丽。"
                                }
                            ]
                        },
                        {
                            "id": "691250315",
                            "text": "而且你说得很有趣…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912504",
            "initDialog": "691250401",
            "dialogues": [
                {
                    "id": "691250401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691250402",
                    "speaker": "哥伦比娅",
                    "text": "唔…都到你这边来做客了，还要让你实现我的愿望，是不是不太好？",
                    "choices": [
                        {
                            "id": "691250403",
                            "text": "没关系的。",
                            "response": [
                                {
                                    "id": "691250405",
                                    "speaker": "哥伦比娅",
                                    "text": "好吧。那我的确有想让你帮忙的事。"
                                },
                                {
                                    "id": "691250406",
                                    "speaker": "Player",
                                    "text": "说来听听。"
                                },
                                {
                                    "id": "691250407",
                                    "speaker": "哥伦比娅",
                                    "text": "菈乌玛之前说过，会将我介绍给现在的「霜月之子」，希望我能融入这个家庭。"
                                },
                                {
                                    "id": "691250408",
                                    "speaker": "哥伦比娅",
                                    "text": "我很高兴她这么说，但…也会有些担心。"
                                },
                                {
                                    "id": "691250409",
                                    "speaker": "Player",
                                    "text": "担心什么？"
                                },
                                {
                                    "id": "691250410",
                                    "speaker": "哥伦比娅",
                                    "text": "我很少和陌生人相处，有些担心聊天时把握不好尺度。我不希望让「霜月之子」的大家感到不自在。"
                                },
                                {
                                    "id": "691250411",
                                    "speaker": "哥伦比娅",
                                    "text": "所以，我想让你陪我…演练？或者说模仿一下可能会遇到的情况。"
                                },
                                {
                                    "id": "691250412",
                                    "speaker": "Player",
                                    "text": "具体要怎么做？"
                                },
                                {
                                    "id": "691250413",
                                    "speaker": "哥伦比娅",
                                    "text": "很简单，你问我一些「霜月之子」的人们可能会问的问题，我来回答。如果有不合适的答案，就告诉我。",
                                    "choices": [
                                        {
                                            "id": "691250414",
                                            "text": "其实哥伦比娅做自己就好…",
                                            "response": [
                                                {
                                                    "id": "691250415",
                                                    "speaker": "哥伦比娅",
                                                    "text": "我知道。但难得的机会，还是想和「霜月之子」的大家相处得更融洽些。"
                                                },
                                                {
                                                    "id": "691250417",
                                                    "speaker": "哥伦比娅",
                                                    "text": "那就开始吧。"
                                                },
                                                {
                                                    "id": "691250418",
                                                    "speaker": "Player",
                                                    "text": "月神大人还会离开我们吗？"
                                                },
                                                {
                                                    "id": "691250419",
                                                    "speaker": "哥伦比娅",
                                                    "text": "会的。",
                                                    "choices": [
                                                        {
                                                            "id": "691250420",
                                                            "text": "…啊？",
                                                            "response": [
                                                                {
                                                                    "id": "691250422",
                                                                    "speaker": "哥伦比娅",
                                                                    "text": "嗯？旅行的时候就会离开呀。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "691250423",
                                                                            "text": "这个要说清楚…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "691250425",
                                                                                    "speaker": "哥伦比娅",
                                                                                    "text": "哦。好的，要说清楚。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "691250426",
                                                                                            "text": "以防万一…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "691250428",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "好的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250429",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "您能保佑我求婚成功吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250430",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "不行。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250431",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "您能保佑我家孩子长高吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250432",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "如果你家孩子是凛角鹿的话…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250433",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "这种时候也说不行就好。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250434",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "好的，不行。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250435",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "您有想要邀请来做客的人吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250436",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "「愚人众」的桑多涅，还有阿蕾奇诺。她们很好奇我在这里的生活。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250437",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "这个不太合适…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250438",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "欸…？不能让她们看吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250439",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "是对「霜月之子」不合适…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250440",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "好吧。那就邀请梅拉，还有阿贝多先生和尼可小姐。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250441",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "阿贝多先生和梅拉很会画画，尼可小姐有很多写书的点子。我想请他们记录下「霜月之子」如今幸福的模样。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250442",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "不错的想法。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250443",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "嗯，桑多涅和阿蕾奇诺，就等有机会的时候悄悄带她们来吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250444",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "这个不能说哦…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250445",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "好，这个不能说。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250446",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "唔…我是不是回答得不够好？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250447",
                                                                                                    "speaker": "哥伦比娅",
                                                                                                    "text": "有机会的话，再陪我多练练吧。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "691250427",
                                                                                            "text": "问几个有些传统的问题…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "691250424",
                                                                            "text": "他们问的不是这个「离开」…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691250421",
                                                            "text": "会…会吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691250416",
                                            "text": "我明白了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691250404",
                            "text": "这是我的待客之道。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912505",
            "initDialog": "691250501",
            "dialogues": [
                {
                    "id": "691250501",
                    "speaker": "Player",
                    "text": "早啊，哥伦比娅。"
                },
                {
                    "id": "691250502",
                    "speaker": "哥伦比娅",
                    "text": "早安，祝你今日旅途顺利。"
                },
                {
                    "id": "691250503",
                    "speaker": "哥伦比娅",
                    "text": "尽管月亮已经藏起来了。但这份祝福会代我陪在你身边。"
                }
            ]
        },
        {
            "talkId": "6912506",
            "initDialog": "691250601",
            "dialogues": [
                {
                    "id": "691250601",
                    "speaker": "Player",
                    "text": "晚安，哥伦比娅。"
                },
                {
                    "id": "691250602",
                    "speaker": "哥伦比娅",
                    "text": "晚安，我会尽量不在你睡着之后唱歌的。"
                }
            ]
        },
        {
            "talkId": "6912510",
            "initDialog": "691251001",
            "dialogues": [
                {
                    "id": "691251001",
                    "speaker": "哥伦比娅",
                    "text": "你帮我把银月之庭搬过来了？"
                },
                {
                    "id": "691251002",
                    "speaker": "哥伦比娅",
                    "text": "唔，不对。是像水中倒影一样的拟似景象吗？真神奇，想起了许多美好的回忆。"
                },
                {
                    "id": "691251003",
                    "speaker": "哥伦比娅",
                    "text": "现在只缺我的歌声了。"
                }
            ]
        },
        {
            "talkId": "6912511",
            "initDialog": "691251101",
            "dialogues": [
                {
                    "id": "691251101",
                    "speaker": "哥伦比娅",
                    "text": "竟然连这个都有，这种鼓是月灵们最喜欢的乐器了。"
                },
                {
                    "id": "691251102",
                    "speaker": "哥伦比娅",
                    "text": "我曾担心它们贪玩，一不小心弄疼自己，但就像是要大声敲散我的疑虑，它们玩得更起劲了。"
                },
                {
                    "id": "691251103",
                    "speaker": "哥伦比娅",
                    "text": "能教教我它的制作方法吗？要是能收到这份礼物，那些孩子一定会很开心的。"
                }
            ]
        }
    ]
}