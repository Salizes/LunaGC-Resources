{
    "groupId": "4259",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "加扎里": 17
    },
    "talks": [
        {
            "talkId": "6425901",
            "initDialog": "642590101",
            "dialogues": [
                {
                    "id": "642590101",
                    "speaker": "加扎里",
                    "text": "可恶啊，经费快要花完了，研究却还没有什么突破。"
                },
                {
                    "id": "642590102",
                    "speaker": "加扎里",
                    "text": "再这样下去饭都要吃不起了。"
                }
            ]
        },
        {
            "talkId": "6425902",
            "initDialog": "642590201",
            "dialogues": [
                {
                    "id": "642590201",
                    "speaker": "Player",
                    "text": "生论派的项目…"
                },
                {
                    "id": "642590202",
                    "speaker": "加扎里",
                    "text": "虽然申请了但是杳无音信啊，难道最近的学术潮流转向了吗？"
                },
                {
                    "id": "642590203",
                    "speaker": "加扎里",
                    "text": "不过俗话也说「好事多磨」，再等一等说不定就有结果了。"
                },
                {
                    "id": "642590204",
                    "speaker": "加扎里",
                    "text": "放心，到时候我是不会忘记你们的贡献的。"
                }
            ]
        },
        {
            "talkId": "6425903",
            "initDialog": "642590301",
            "dialogues": [
                {
                    "id": "642590301",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "642590302",
                    "speaker": "加扎里",
                    "text": "当然是在整理之前的研究成果。"
                },
                {
                    "id": "642590303",
                    "speaker": "加扎里",
                    "text": "我没想到数据量会有这么大，还不知道要再花多少时间呢。"
                },
                {
                    "id": "642590304",
                    "speaker": "加扎里",
                    "text": "但要是不整理完就发表也太不负责任了。"
                }
            ]
        },
        {
            "talkId": "6425904",
            "initDialog": "642590401",
            "dialogues": [
                {
                    "id": "642590401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "642590402",
                    "speaker": "加扎里",
                    "text": "唉，等经费批下来你再来找我吧。"
                }
            ]
        },
        {
            "talkId": "6425905",
            "initDialog": "642590501",
            "dialogues": [
                {
                    "id": "642590501",
                    "speaker": "加扎里",
                    "text": "哈哈，只要整理完迦毗鸠师的手稿，我一定能一跃而成当代最伟大的妙论学者。"
                },
                {
                    "id": "642590502",
                    "speaker": "加扎里",
                    "text": "这次不仅升为诃般荼不在话下，说不定还会被称为加扎里师呢。"
                }
            ]
        },
        {
            "talkId": "6425906",
            "initDialog": "642590601",
            "dialogues": [
                {
                    "id": "642590601",
                    "speaker": "Player",
                    "text": "原来「师」是称号吗？"
                },
                {
                    "id": "642590602",
                    "speaker": "加扎里",
                    "text": "不是吗？我也不是很清楚，只有知论派的家伙才会在意这种事。"
                },
                {
                    "id": "642590603",
                    "speaker": "加扎里",
                    "text": "我们妙论派只关心真正的技术。"
                }
            ]
        },
        {
            "talkId": "6425907",
            "initDialog": "642590701",
            "dialogues": [
                {
                    "id": "642590701",
                    "speaker": "Player",
                    "text": "关于须弥美食的事…"
                },
                {
                    "id": "642590702",
                    "speaker": "加扎里",
                    "text": "嗯？虽然不记得有答应过要请你们吃什么须弥美食。"
                },
                {
                    "id": "642590703",
                    "speaker": "加扎里",
                    "text": "但是你们帮了我这么多，请你们吃一顿咖喱虾之类的倒也不是不行。"
                },
                {
                    "id": "642590704",
                    "speaker": "加扎里",
                    "text": "不过还是等我的成果顺利发表后吧。到时候别说是咖喱虾，就算是唐杜尔烤鸡，也包你们吃到撑！"
                }
            ]
        },
        {
            "talkId": "6425908",
            "initDialog": "642590801",
            "dialogues": [
                {
                    "id": "642590801",
                    "speaker": "Player",
                    "text": "祝你早日成功。"
                },
                {
                    "id": "642590802",
                    "speaker": "加扎里",
                    "text": "哈哈，那是当然，你就等着看我的致谢吧。"
                }
            ]
        }
    ]
}