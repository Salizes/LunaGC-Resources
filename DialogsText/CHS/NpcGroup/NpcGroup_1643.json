{
    "groupId": "1643",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "阿尔弗雷德": 15
    },
    "talks": [
        {
            "talkId": "6164301",
            "initDialog": "616430101",
            "dialogues": [
                {
                    "id": "616430101",
                    "speaker": "阿尔弗雷德",
                    "text": "夕阳西下，余晖将尽，夜幕降临，寒风凛冽…"
                },
                {
                    "id": "616430102",
                    "speaker": "阿尔弗雷德",
                    "text": "不要害怕长夜，我将伴你左右，直至黎明到来…"
                }
            ]
        },
        {
            "talkId": "6164302",
            "initDialog": "616430201",
            "dialogues": [
                {
                    "id": "616430201",
                    "speaker": "Player",
                    "text": "您在做什么？"
                },
                {
                    "id": "616430202",
                    "speaker": "阿尔弗雷德",
                    "text": "呵呵，老朽啊，在给老朽的女儿吟咏她最喜欢的童谣呢。"
                },
                {
                    "id": "616430203",
                    "speaker": "阿尔弗雷德",
                    "text": "以前每次回到家，她总是缠着我唱给她听，但那时我满心都是工作，不愿意理她…"
                },
                {
                    "id": "616430204",
                    "speaker": "阿尔弗雷德",
                    "text": "…结果就在我去璃月演出时，她因病离开了人世，我连她最后一面都没能见到。"
                },
                {
                    "id": "616430205",
                    "speaker": "阿尔弗雷德",
                    "text": "她的愿望是那么的简单、渺小，可连这样的事情我都没能为她做…"
                },
                {
                    "id": "616430206",
                    "speaker": "阿尔弗雷德",
                    "text": "我的女儿啊，放心吧，爸爸会陪着你，一直都会的…"
                }
            ]
        },
        {
            "talkId": "6164303",
            "initDialog": "616430301",
            "dialogues": [
                {
                    "id": "616430301",
                    "speaker": "Player",
                    "text": "（默默离去…）"
                },
                {
                    "id": "616430302",
                    "speaker": "阿尔弗雷德",
                    "text": "我的孩子安心地睡吧，闭上你那疲惫的双眼…"
                },
                {
                    "id": "616430303",
                    "speaker": "阿尔弗雷德",
                    "text": "我会化作风吹散乌云，让明月照亮你的笑颜…"
                }
            ]
        },
        {
            "talkId": "6164304",
            "initDialog": "616430401",
            "dialogues": [
                {
                    "id": "616430401",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "616430402",
                    "speaker": "阿尔弗雷德",
                    "text": "嗯？那个人是你的亲戚吗？"
                },
                {
                    "id": "616430403",
                    "speaker": "阿尔弗雷德",
                    "text": "不好意思，我没有什么印象，不过我会帮你留意一下的。"
                },
                {
                    "id": "616430404",
                    "speaker": "阿尔弗雷德",
                    "text": "与亲人分别的痛苦，我再了解不过了…"
                },
                {
                    "id": "616430405",
                    "speaker": "阿尔弗雷德",
                    "text": "祝你幸运吧，朋友。"
                }
            ]
        },
        {
            "talkId": "6164305",
            "initDialog": "616430501",
            "dialogues": [
                {
                    "id": "616430501",
                    "speaker": "阿尔弗雷德",
                    "text": "我会化作风吹散乌云，让明月照亮你的笑颜…"
                },
                {
                    "id": "616430502",
                    "speaker": "阿尔弗雷德",
                    "text": "我的女儿啊，放心吧，爸爸会陪着你，一直都会的…"
                }
            ]
        }
    ]
}