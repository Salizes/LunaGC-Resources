{
    "groupId": "1797",
    "total_dialogue_lines": 43,
    "speaker_counts": {
        "Player": 8,
        "科赫": 35
    },
    "talks": [
        {
            "talkId": "6179701",
            "initDialog": "617970101",
            "dialogues": [
                {
                    "id": "617970101",
                    "speaker": "科赫",
                    "text": "铳枪不是蜡笔画，不可能想要什么就画什么，合理改进才保险…有人连维护工作都偷懒，乱改更要出大问题！"
                }
            ]
        },
        {
            "talkId": "6179702",
            "initDialog": "617970201",
            "dialogues": [
                {
                    "id": "617970201",
                    "speaker": "Player",
                    "text": "改进铳枪？"
                },
                {
                    "id": "617970202",
                    "speaker": "科赫",
                    "text": "嗯，如你所见，我是第八小队的枪匠，负责为各小队的铳枪射手提供技术支援。"
                },
                {
                    "id": "617970203",
                    "speaker": "科赫",
                    "text": "近些年来，我们骑士团开始小规模列装铳枪。"
                },
                {
                    "id": "617970204",
                    "speaker": "科赫",
                    "text": "我们采用的铳枪综合了至冬与枫丹的先进技术，由支援小队的工坊专门生产…"
                },
                {
                    "id": "617970205",
                    "speaker": "科赫",
                    "text": "论综合性能，基本持平特巡队和愚人众特辖队列装的型号，对付常见的魔物，已经相当管够了。"
                },
                {
                    "id": "617970206",
                    "speaker": "科赫",
                    "text": "不过，总有些骑士，想要瞬间获得无与伦比的战力，提出大改现有的成熟设计。"
                },
                {
                    "id": "617970207",
                    "speaker": "科赫",
                    "text": "比如…把管状弹仓改成盒式，这样就不用一发发装填弹药，而是将金属夹固定的整组弹药一次塞进枪里…",
                    "choices": [
                        {
                            "id": "617970208",
                            "text": "这不是很快捷吗？",
                            "response": [
                                {
                                    "id": "617970210",
                                    "speaker": "科赫",
                                    "text": "的确如此，我支持改进枪械。"
                                },
                                {
                                    "id": "617970211",
                                    "speaker": "科赫",
                                    "text": "但这需要额外的配合——比如规范弹药金属夹的尺寸和工艺，批量生产，采用正规包装。"
                                },
                                {
                                    "id": "617970212",
                                    "speaker": "科赫",
                                    "text": "这就是后勤小队的工作了，不是改改铳枪的设计就能搞定的。再怎么催我一个小枪匠也没用！"
                                },
                                {
                                    "id": "617970213",
                                    "speaker": "科赫",
                                    "text": "除了弹仓外，有篇至冬的文献甚至提出，在闭锁机构上增加滑槽，通过连杆联动枪栓，利用后坐的冲击退壳…"
                                },
                                {
                                    "id": "617970214",
                                    "speaker": "科赫",
                                    "text": "然后通过内置在枪托中，或是外挂组件的弹簧，让枪机向前复位，自动推弹，完成连续射击…",
                                    "choices": [
                                        {
                                            "id": "617970215",
                                            "text": "这个听起来更生猛。",
                                            "response": [
                                                {
                                                    "id": "617970217",
                                                    "speaker": "科赫",
                                                    "text": "咳咳，能快速连射的武器，我也很想要…尤其是挪德卡莱那些愚人众的新锐装备。"
                                                },
                                                {
                                                    "id": "617970218",
                                                    "speaker": "科赫",
                                                    "text": "但，那些转管武器还属于非卖品，我们只能自行摸索别的连射机构…"
                                                },
                                                {
                                                    "id": "617970219",
                                                    "speaker": "科赫",
                                                    "text": "我跟赫斯塔尔合作，先后试着制造了三把原型样机，进行了连续射击实验——"
                                                },
                                                {
                                                    "id": "617970220",
                                                    "speaker": "科赫",
                                                    "text": "第一把解决不了枪栓旋转开锁的问题，一直卡住，只能更改连杆的结构。"
                                                },
                                                {
                                                    "id": "617970221",
                                                    "speaker": "科赫",
                                                    "text": "第二把打了九十七发后，连杆崩断，碎片打烂了赫斯塔尔的古董茶杯…"
                                                },
                                                {
                                                    "id": "617970222",
                                                    "speaker": "科赫",
                                                    "text": "第三把打了二百四十发后，弹膛严重磨损，闭锁机构失效，枪托开裂，弹簧也耐受不住。"
                                                },
                                                {
                                                    "id": "617970223",
                                                    "speaker": "科赫",
                                                    "text": "还有各种…高温气体喷在脸上，让射手目不能视之类的棘手问题。"
                                                },
                                                {
                                                    "id": "617970224",
                                                    "speaker": "科赫",
                                                    "text": "结论是，要想实现快速连续射击，还需要大改铳枪的基本结构。"
                                                },
                                                {
                                                    "id": "617970225",
                                                    "speaker": "科赫",
                                                    "text": "从侧面联动枪栓的方案不可靠，必须把循环机构沿枪管轴线布置，才能保证受力稳定。"
                                                },
                                                {
                                                    "id": "617970226",
                                                    "speaker": "科赫",
                                                    "text": "不知道可不可以通过…滚柱和节套凹槽之类的机件组合，延迟枪机开锁的时间，来让高膛压变得不那么致命…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "617970216",
                                            "text": "连射怎么想都很强。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "617970209",
                            "text": "听起来还挺方便的。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6179703",
            "initDialog": "617970301",
            "dialogues": [
                {
                    "id": "617970301",
                    "speaker": "Player",
                    "text": "谁懒得维护？训他！"
                },
                {
                    "id": "617970302",
                    "speaker": "科赫",
                    "text": "就是君特那家伙，仗着自己老拿队内射击比试的冠军，不好好擦枪，老把保养的工作丢给我们枪匠。"
                },
                {
                    "id": "617970303",
                    "speaker": "科赫",
                    "text": "可恶…铳枪明明是精妙的艺术品…如果我的射术比他强，我一定按着他的头让他好好向铳枪们道歉！"
                }
            ]
        },
        {
            "talkId": "6179704",
            "initDialog": "617970401",
            "dialogues": [
                {
                    "id": "617970401",
                    "speaker": "Player",
                    "text": "你的脸上还写着别的烦恼…"
                },
                {
                    "id": "617970402",
                    "speaker": "科赫",
                    "text": "呃，你会读心吗…"
                },
                {
                    "id": "617970403",
                    "speaker": "科赫",
                    "text": "我的确遇上了一些麻烦…之前我订了一批金属材料，托商人们自行从陆路运来…"
                },
                {
                    "id": "617970404",
                    "speaker": "科赫",
                    "text": "结果货物在野外被不明魔物劫走，不知下落。"
                },
                {
                    "id": "617970405",
                    "speaker": "科赫",
                    "text": "唉，这是我为了试制新零件，自掏腰包的订单，不可能让别的骑士费心费力去追。"
                },
                {
                    "id": "617970406",
                    "speaker": "科赫",
                    "text": "只能看看，能不能请个假去找找看了…"
                }
            ]
        },
        {
            "talkId": "6179705",
            "initDialog": "617970502",
            "dialogues": [
                {
                    "id": "617970502",
                    "speaker": "科赫",
                    "text": "居然！太走运了…"
                },
                {
                    "id": "617970503",
                    "speaker": "科赫",
                    "text": "这是我为了试制新零件，自掏腰包买下的金属材料！"
                },
                {
                    "id": "617970504",
                    "speaker": "科赫",
                    "text": "之前我托商人们自行从陆路运来，结果货物在野外被不明魔物劫走，不知下落…"
                },
                {
                    "id": "617970505",
                    "speaker": "科赫",
                    "text": "我本来无比头疼，还想着请个假去找找看，这下问题全都解决了！"
                },
                {
                    "id": "617970506",
                    "speaker": "科赫",
                    "text": "太感谢你了！"
                }
            ]
        },
        {
            "talkId": "6179706",
            "initDialog": "617970601",
            "dialogues": [
                {
                    "id": "617970601",
                    "speaker": "Player",
                    "text": "支持！你慢慢琢磨！"
                },
                {
                    "id": "617970602",
                    "speaker": "科赫",
                    "text": "呃，我光自顾自抱怨去了…失礼了！"
                }
            ]
        }
    ]
}