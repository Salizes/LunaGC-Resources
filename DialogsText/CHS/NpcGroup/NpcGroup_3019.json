{
    "groupId": "3019",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "大和田": 14
    },
    "talks": [
        {
            "talkId": "6301901",
            "initDialog": "630190101",
            "dialogues": [
                {
                    "id": "630190101",
                    "speaker": "大和田",
                    "text": "这一天什么时候才能结束啊…哎呦，吓我一跳！"
                },
                {
                    "id": "630190102",
                    "speaker": "大和田",
                    "text": "你…你不会是来报案的吧？"
                }
            ]
        },
        {
            "talkId": "6301902",
            "initDialog": "630190201",
            "dialogues": [
                {
                    "id": "630190201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630190202",
                    "speaker": "大和田",
                    "text": "我是奉行所的与力，是这里同心们的上司，叫我大和田吧。"
                },
                {
                    "id": "630190203",
                    "speaker": "大和田",
                    "text": "奉行所负责治安管理。如果看到什么违法乱纪的事件，可以来这里报案…"
                },
                {
                    "id": "630190204",
                    "speaker": "大和田",
                    "text": "不过话虽如此，还是雷神保佑，别出事比较好。"
                }
            ]
        },
        {
            "talkId": "6301903",
            "initDialog": "630190301",
            "dialogues": [
                {
                    "id": "630190301",
                    "speaker": "Player",
                    "text": "常有人来报案吗？"
                },
                {
                    "id": "630190302",
                    "speaker": "大和田",
                    "text": "嘘！可勿要念叨了。要是天天有案子，那可还得了。"
                },
                {
                    "id": "630190303",
                    "speaker": "大和田",
                    "text": "我年纪大了，只盼能每天准时下班，未来平安退休…"
                },
                {
                    "id": "630190304",
                    "speaker": "大和田",
                    "text": "别误会，倒不是我偷懒啊。我干了这么些年，什么没见过，只是希望天下太平，生活安康，不是很好吗。"
                },
                {
                    "id": "630190305",
                    "speaker": "大和田",
                    "text": "违法乱纪的事情越少越好…若是有什么丢了宠物之类的小事，也请去麻烦侦探社的龙二他们吧。"
                }
            ]
        },
        {
            "talkId": "6301904",
            "initDialog": "630190401",
            "dialogues": [
                {
                    "id": "630190401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630190402",
                    "speaker": "大和田",
                    "text": "再见，祝你平安。"
                }
            ]
        },
        {
            "talkId": "6301905",
            "initDialog": "630190501",
            "dialogues": [
                {
                    "id": "630190501",
                    "speaker": "Player",
                    "text": "龙二？"
                },
                {
                    "id": "630190502",
                    "speaker": "大和田",
                    "text": "龙二是「万端珊瑚侦探社」的人，我跟他是旧相识了。"
                },
                {
                    "id": "630190503",
                    "speaker": "大和田",
                    "text": "当时他被人栽赃陷害，我心里很想帮上点忙，但奈何能力有限…"
                },
                {
                    "id": "630190504",
                    "speaker": "大和田",
                    "text": "还好他后来遇到了侦探社的那位社长，帮他洗清了冤屈。"
                },
                {
                    "id": "630190505",
                    "speaker": "大和田",
                    "text": "总之，还是不要再有类似的案件了…不类似的也不要有，嗯。"
                }
            ]
        }
    ]
}