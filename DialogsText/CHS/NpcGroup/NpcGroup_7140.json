{
    "groupId": "7140",
    "total_dialogue_lines": 99,
    "speaker_counts": {
        "Player": 21,
        "凛角鹿": 2,
        "派蒙": 8,
        "海崖鹦": 3,
        "盗宝鼬": 5,
        "菈乌玛": 56,
        "长翎鹮": 4
    },
    "talks": [
        {
            "talkId": "7665010",
            "initDialog": "766501001",
            "dialogues": [
                {
                    "id": "766501001",
                    "speaker": "派蒙",
                    "text": "菈乌玛，我们来做客啦！",
                    "choices": [
                        {
                            "id": "766501002",
                            "text": "这周围怎么…",
                            "response": [
                                {
                                    "id": "766501004",
                                    "speaker": "派蒙",
                                    "text": "是喔，地上堆着好多盒子和杂物，有的拆开了，有的没拆开…这里不是书库吗？",
                                    "choices": [
                                        {
                                            "id": "766501005",
                                            "text": "感觉更像是仓库。",
                                            "response": [
                                                {
                                                    "id": "766501007",
                                                    "speaker": "派蒙",
                                                    "text": "菈乌玛在那边，她正在和盗宝鼬说话？唔…难道是遇见什么麻烦事了？我们过去看看吧。"
                                                },
                                                {
                                                    "id": "766501008",
                                                    "speaker": "盗宝鼬",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "766501009",
                                                    "speaker": "菈乌玛",
                                                    "text": "…唉，即便如此。眼下也并无要紧的挖掘事务…暂且别四处挖掘了，好么？"
                                                },
                                                {
                                                    "id": "766501010",
                                                    "speaker": "盗宝鼬",
                                                    "text": "♪"
                                                },
                                                {
                                                    "id": "766501011",
                                                    "speaker": "菈乌玛",
                                                    "text": "好孩子，喏，这一枚摩拉是送给你的。"
                                                },
                                                {
                                                    "id": "766501012",
                                                    "speaker": "盗宝鼬",
                                                    "text": "♪♪♪"
                                                },
                                                {
                                                    "id": "766501013",
                                                    "speaker": "派蒙",
                                                    "text": "是上次那只盗宝鼬。菈乌玛在和它说什么呢？难道是又发现什么文物了？"
                                                },
                                                {
                                                    "id": "766501014",
                                                    "speaker": "菈乌玛",
                                                    "text": "#你们好，{NICKNAME}，还有小派蒙。欢迎来书库，有何事需要我帮助么？",
                                                    "choices": [
                                                        {
                                                            "id": "766501015",
                                                            "text": "刚才看见你和盗宝鼬说话了。",
                                                            "response": [
                                                                {
                                                                    "id": "766501017",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "并非如此，我只是在…对这孩子稍作训诫，它最近有点太过于兴奋，总是去叨扰周围的人。"
                                                                },
                                                                {
                                                                    "id": "766501018",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "自从上次把「月谕之像」取回来，这孩子对探索宝藏更加热情了…时不时地就跑来问我，什么时候再继续去寻宝。"
                                                                },
                                                                {
                                                                    "id": "766501019",
                                                                    "speaker": "菈乌玛",
                                                                    "text": "虽然我已经说了，目前书库内存放的书籍和文物已经足够研究，暂时不用外出探寻…但…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "766501020",
                                                                            "text": "它抑制不住自己的本性了。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "766501022",
                                                                                    "speaker": "菈乌玛",
                                                                                    "text": "是的。但这孩子并不了解「文物」之义，只要是看起来值钱的事物，它都会挖掘取回。"
                                                                                },
                                                                                {
                                                                                    "id": "766501023",
                                                                                    "speaker": "菈乌玛",
                                                                                    "text": "虽然这孩子答应我，以后不会再挖掘。但它挖出来的这些东西…也只能由我来处理了。"
                                                                                },
                                                                                {
                                                                                    "id": "766501024",
                                                                                    "speaker": "菈乌玛",
                                                                                    "text": "#抱歉，{NICKNAME}，小派蒙。今日我恐怕没法陪你们游览了。"
                                                                                },
                                                                                {
                                                                                    "id": "766501025",
                                                                                    "speaker": "菈乌玛",
                                                                                    "text": "呼…这个盒子里，是装着什么来着…？"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "766501021",
                                                                            "text": "它还是自己到处搜罗东西了？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766501016",
                                                            "text": "又发现什么埋藏着的文物了？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766501006",
                                            "text": "难道是又要做装修？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766501003",
                            "text": "这么多东西？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7665011",
            "initDialog": "766501101",
            "dialogues": [
                {
                    "id": "766501101",
                    "speaker": "菈乌玛",
                    "text": "也算是告一段落了。接下来，就是怎么把这些东西放回去…"
                },
                {
                    "id": "766501102",
                    "speaker": "Player",
                    "text": "这些东西是…"
                },
                {
                    "id": "766501103",
                    "speaker": "菈乌玛",
                    "text": "是的…里面有已经化石化的古树种子、动物的骨骸化石，彩色的石头…"
                },
                {
                    "id": "766501104",
                    "speaker": "菈乌玛",
                    "text": "…还有人家埋下去的存钱罐、许愿盒、带画片的信件…"
                },
                {
                    "id": "766501105",
                    "speaker": "Player",
                    "text": "什么都往回拿啊！"
                },
                {
                    "id": "766501106",
                    "speaker": "菈乌玛",
                    "text": "毕竟盗宝鼬眼中的「珍贵」和我们眼中的「珍贵」，并非一个概念。只要看着新奇，它就会把那东西收入包里。"
                },
                {
                    "id": "766501107",
                    "speaker": "菈乌玛",
                    "text": "种子和石头倒是好说，但那些存钱罐和许愿盒，看起来必然是被人特意埋下去，预备着将来再挖出来的。"
                },
                {
                    "id": "766501108",
                    "speaker": "Player",
                    "text": "需要我帮忙吗？"
                },
                {
                    "id": "766501109",
                    "speaker": "菈乌玛",
                    "text": "谢谢好意。我已经请了一位稳重些的盗宝鼬过来，到时候，会由它把这些东西都放回原位。"
                },
                {
                    "id": "766501110",
                    "speaker": "菈乌玛",
                    "text": "毕竟是那孩子的心意，若是直接让它放回…难免有些伤它的心。"
                },
                {
                    "id": "766501111",
                    "speaker": "派蒙",
                    "text": "可是，那一只你请过来的盗宝鼬，难道不会把事情都告诉它吗？"
                },
                {
                    "id": "766501112",
                    "speaker": "菈乌玛",
                    "text": "这只小盗宝鼬并不惯于聚居，总是单独出没。它们大概是遇不见的。"
                },
                {
                    "id": "766501113",
                    "speaker": "菈乌玛",
                    "text": "而且它的注意力转移颇快。大约过半个月，它应当就不记得它挖出过什么事物了吧。",
                    "choices": [
                        {
                            "id": "766501114",
                            "text": "菈乌玛真了解动物的习性。",
                            "response": [
                                {
                                    "id": "766501116",
                                    "speaker": "菈乌玛",
                                    "text": "我和它们语言相通，又久日作伴，自然能理解它们，就像是一般人交朋友一样。"
                                },
                                {
                                    "id": "766501117",
                                    "speaker": "菈乌玛",
                                    "text": "不过，一般人并不能听懂动物们的话，想要理解动物，多少会有些差池。"
                                },
                                {
                                    "id": "766501118",
                                    "speaker": "菈乌玛",
                                    "text": "比如在外面作家们的笔下，「兽性」一词往往偏贬，而「人性」一词，却褒贬皆有…",
                                    "choices": [
                                        {
                                            "id": "766501119",
                                            "text": "毕竟是人类写的书嘛。",
                                            "response": [
                                                {
                                                    "id": "766501121",
                                                    "speaker": "菈乌玛",
                                                    "text": "噗…你说得对。如果是让一匹狼，或者是一只凛角鹿来写书的话，或许书中内容就会大为不同了。"
                                                },
                                                {
                                                    "id": "766501122",
                                                    "speaker": "凛角鹿",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "766501123",
                                                    "speaker": "菈乌玛",
                                                    "text": "…但对我来说，无论是「人性」抑或「兽性」，皆为一般「性格」。"
                                                },
                                                {
                                                    "id": "766501124",
                                                    "speaker": "菈乌玛",
                                                    "text": "无论是人是兽，都会时而勇敢，时而怯懦，时而贪婪入脑，时而怒气攻心…"
                                                },
                                                {
                                                    "id": "766501125",
                                                    "speaker": "海崖鹦",
                                                    "text": "♪"
                                                },
                                                {
                                                    "id": "766501126",
                                                    "speaker": "菈乌玛",
                                                    "text": "功成则心喜，功败则垂丧…这一切并无人兽之分，皆为生于「自然」，发于「自然」的「性格」。"
                                                },
                                                {
                                                    "id": "766501127",
                                                    "speaker": "菈乌玛",
                                                    "text": "我有时也会想，假若人兽之语生而相通，周围诸事会不会…更好一些。"
                                                },
                                                {
                                                    "id": "766501128",
                                                    "speaker": "菈乌玛",
                                                    "text": "…但这类想法，终究是无谓空想。"
                                                },
                                                {
                                                    "id": "766501129",
                                                    "speaker": "菈乌玛",
                                                    "text": "有些人，就是无论如何，都不愿意理解自然的。"
                                                },
                                                {
                                                    "id": "766501130",
                                                    "speaker": "菈乌玛",
                                                    "text": "在这类恶徒的眼中，无论屠戮的对象是否与他们语言相通，他们扣动扳机的动作，也不会慢下来半分。"
                                                },
                                                {
                                                    "id": "766501131",
                                                    "speaker": "凛角鹿",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "766501132",
                                                    "speaker": "菈乌玛",
                                                    "text": "…好孩子，我知道你能保护好自己，跑得也比他们快。安心，不会再有人伤害你们了。"
                                                },
                                                {
                                                    "id": "766501133",
                                                    "speaker": "菈乌玛",
                                                    "text": "一不小心聊了这么久，我也该继续给那堆「宝物」做分类了。"
                                                },
                                                {
                                                    "id": "766501134",
                                                    "speaker": "菈乌玛",
                                                    "text": "离我和那条盗宝鼬约的时间还早，应该足够把它们分类好了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766501120",
                                            "text": "毕竟他们听不懂动物说话啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766501115",
                            "text": "也很了解动物的心理。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7665012",
            "initDialog": "766501201",
            "dialogues": [
                {
                    "id": "766501201",
                    "speaker": "盗宝鼬",
                    "text": "♪"
                },
                {
                    "id": "766501202",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}你看，那只盗宝鼬又来了，就站在菈乌玛旁边呢。"
                },
                {
                    "id": "766501203",
                    "speaker": "盗宝鼬",
                    "text": "！！！"
                },
                {
                    "id": "766501204",
                    "speaker": "派蒙",
                    "text": "欸？怎么一下子就走了…"
                },
                {
                    "id": "766501205",
                    "speaker": "Player",
                    "text": "难道是认清之前的错误了？"
                },
                {
                    "id": "766501206",
                    "speaker": "菈乌玛",
                    "text": "#来，{NICKNAME}，这枚摩拉，是那孩子请我转交给你的。"
                },
                {
                    "id": "766501207",
                    "speaker": "派蒙",
                    "text": "#啊？盗宝鼬为什么要给{NICKNAME}摩拉呀？"
                },
                {
                    "id": "766501208",
                    "speaker": "菈乌玛",
                    "text": "#之前我说过，那孩子十分佩服能掘出重宝的{NICKNAME}，希望能跟随你挖出世界上所有的宝箱。"
                },
                {
                    "id": "766501209",
                    "speaker": "菈乌玛",
                    "text": "这一枚摩拉，是它专程送给你的「订金」。"
                },
                {
                    "id": "766501210",
                    "speaker": "Player",
                    "text": "它、它是认真的？"
                },
                {
                    "id": "766501211",
                    "speaker": "菈乌玛",
                    "text": "牵涉摩拉之事，盗宝鼬一族从不撒谎。"
                },
                {
                    "id": "766501212",
                    "speaker": "菈乌玛",
                    "text": "拿好了，这可是你和盗宝鼬一族…至少是与这只盗宝鼬之间的「约定」。",
                    "choices": [
                        {
                            "id": "766501213",
                            "text": "找宝箱只是我的副业…",
                            "response": [
                                {
                                    "id": "766501215",
                                    "speaker": "菈乌玛",
                                    "text": "无需太过担心。说是「约定」，其实只是那孩子想要与你交朋友。"
                                },
                                {
                                    "id": "766501216",
                                    "speaker": "菈乌玛",
                                    "text": "它并不明白你喜欢什么，所以，就把自己最喜欢的东西送给了你。",
                                    "choices": [
                                        {
                                            "id": "766501217",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "766501219",
                                                    "speaker": "菈乌玛",
                                                    "text": "嗯。若是有心，你回去后可以在枕头旁边放些白灵果干，那孩子最喜欢吃这种零食。"
                                                },
                                                {
                                                    "id": "766501220",
                                                    "speaker": "菈乌玛",
                                                    "text": "当然也别放太多了。要是那孩子一不留神吃了太多，只怕就没法打洞离开了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766501218",
                                            "text": "我会收藏好的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766501214",
                            "text": "我真不是做这一行的…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7665013",
            "initDialog": "766501301",
            "dialogues": [
                {
                    "id": "766501301",
                    "speaker": "菈乌玛",
                    "text": "好了。以后若是举不动，就不要勉强自己。"
                },
                {
                    "id": "766501302",
                    "speaker": "长翎鹮",
                    "text": "♪"
                },
                {
                    "id": "766501303",
                    "speaker": "菈乌玛",
                    "text": "…逞这些强，反倒是伤了自己。若是急需帮助，可来找我。"
                },
                {
                    "id": "766501304",
                    "speaker": "长翎鹮",
                    "text": "……"
                },
                {
                    "id": "766501305",
                    "speaker": "菈乌玛",
                    "text": "去吧…哎，稍等。"
                },
                {
                    "id": "766501306",
                    "speaker": "菈乌玛",
                    "text": "这根树枝给你，我刚在路边捡到的，看着还算坚固耐用。"
                },
                {
                    "id": "766501307",
                    "speaker": "长翎鹮",
                    "text": "♪"
                },
                {
                    "id": "766501308",
                    "speaker": "菈乌玛",
                    "text": "嗯。也告诉你的朋友们，最近天寒，若是需要取暖的话，就过来我们这里。"
                },
                {
                    "id": "766501309",
                    "speaker": "长翎鹮",
                    "text": "♪"
                }
            ]
        },
        {
            "talkId": "7665014",
            "initDialog": "766501401",
            "dialogues": [
                {
                    "id": "766501401",
                    "speaker": "菈乌玛",
                    "text": "这本书…应该放在这里。咦，这里怎么缺了一本…"
                },
                {
                    "id": "766501402",
                    "speaker": "菈乌玛",
                    "text": "这架子上的爪痕，还有旁边的羽毛…"
                },
                {
                    "id": "766501403",
                    "speaker": "菈乌玛",
                    "text": "难不成又被哪只海崖鹦拖去窝里当垫子了？没办法…"
                },
                {
                    "id": "766501404",
                    "speaker": "海崖鹦",
                    "text": "……"
                },
                {
                    "id": "766501405",
                    "speaker": "菈乌玛",
                    "text": "请您去林子里看看，是不是又有谁把书拿到了窝里。"
                },
                {
                    "id": "766501406",
                    "speaker": "菈乌玛",
                    "text": "若是有，就请把书拿回来。并且告诉它，需要垫子的话，可以直接找我要。"
                },
                {
                    "id": "766501407",
                    "speaker": "海崖鹦",
                    "text": "♪"
                },
                {
                    "id": "766501408",
                    "speaker": "菈乌玛",
                    "text": "呼…看来还要请大家帮忙，再多做些小尺寸垫子了。"
                }
            ]
        },
        {
            "talkId": "7665015",
            "initDialog": "766501501",
            "dialogues": [
                {
                    "id": "766501501",
                    "speaker": "菈乌玛",
                    "text": "呼…这个盒子里，是装着什么来着…？"
                }
            ]
        },
        {
            "talkId": "7665016",
            "initDialog": "766501601",
            "dialogues": [
                {
                    "id": "766501601",
                    "speaker": "菈乌玛",
                    "text": "这个物品…应该归类在这里才对…"
                }
            ]
        },
        {
            "talkId": "7665017",
            "initDialog": "766501701",
            "dialogues": [
                {
                    "id": "766501701",
                    "speaker": "菈乌玛",
                    "text": "若是有心，你回去后可以在枕头旁边放些白灵果干，那孩子最喜欢吃这种零食了。"
                }
            ]
        }
    ]
}