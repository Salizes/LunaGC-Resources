{
    "groupId": "9080",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Player": 17,
        "米卡": 48
    },
    "talks": [
        {
            "talkId": "6908001",
            "initDialog": "690800101",
            "dialogues": [
                {
                    "id": "690800101",
                    "speaker": "米卡",
                    "text": "#{NICKNAME}，你好啊。"
                },
                {
                    "id": "690800102",
                    "speaker": "米卡",
                    "text": "听见你的声音，我好像就更有精神了…嗯！"
                }
            ]
        },
        {
            "talkId": "6908002",
            "initDialog": "690800201",
            "dialogues": [
                {
                    "id": "690800201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690800202",
                    "speaker": "米卡",
                    "text": "嗯，我很开心！"
                },
                {
                    "id": "690800203",
                    "speaker": "米卡",
                    "text": "这里真的好奇妙，风景优美，宁静平和，还有我从没见过的奇观…"
                },
                {
                    "id": "690800204",
                    "speaker": "米卡",
                    "text": "走遍提瓦特，也找不到第二个这样的好地方了吧？"
                },
                {
                    "id": "690800205",
                    "speaker": "米卡",
                    "text": "就算只给我一个小帐篷，我也能在这里安心地住下去。"
                },
                {
                    "id": "690800206",
                    "speaker": "米卡",
                    "text": "啊…不过，要是在外边露营，我可能要借用一点木材，用来做篝火…",
                    "choices": [
                        {
                            "id": "690800207",
                            "text": "不用篝火，这里冬暖夏凉！",
                            "response": [
                                {
                                    "id": "690800209",
                                    "speaker": "米卡",
                                    "text": "太，太麻烦你了…"
                                },
                                {
                                    "id": "690800210",
                                    "speaker": "米卡",
                                    "text": "那…如果有什么家务活，请尽管让我来做吧！"
                                },
                                {
                                    "id": "690800211",
                                    "speaker": "米卡",
                                    "text": "我以前经常打理屋子和院子，应该还没生疏…",
                                    "choices": [
                                        {
                                            "id": "690800212",
                                            "text": "米卡是客人哦。",
                                            "response": [
                                                {
                                                    "id": "690800214",
                                                    "speaker": "米卡",
                                                    "text": "呜…感觉好安心…太谢谢你了！"
                                                },
                                                {
                                                    "id": "690800215",
                                                    "speaker": "米卡",
                                                    "text": "要是我再啰嗦，也许你会觉得我太见外，反而扫了你的兴…"
                                                },
                                                {
                                                    "id": "690800216",
                                                    "speaker": "米卡",
                                                    "text": "那我就不客气了，我想用心观察这里的一切…争取理解你布置景观的理念！"
                                                },
                                                {
                                                    "id": "690800217",
                                                    "speaker": "米卡",
                                                    "text": "这样一来，如果你需要我帮忙，我就能及时派上用场了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690800213",
                                            "text": "客人只需要享受就好啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690800208",
                            "text": "我当然会为你安排妥当！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908003",
            "initDialog": "690800301",
            "dialogues": [
                {
                    "id": "690800301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690800302",
                    "speaker": "米卡",
                    "text": "当然了！"
                },
                {
                    "id": "690800303",
                    "speaker": "米卡",
                    "text": "难得这样独处…我有很多事想请教你。"
                },
                {
                    "id": "690800304",
                    "speaker": "米卡",
                    "text": "比如，你擅长使用单手剑，却能击败一些弩箭都够不着的强大敌人。"
                },
                {
                    "id": "690800305",
                    "speaker": "米卡",
                    "text": "距离和射程这些因素，对你而言从来不是问题…究竟是怎么做到的呢？",
                    "choices": [
                        {
                            "id": "690800306",
                            "text": "以后我可以给你现场演示哦。",
                            "response": [
                                {
                                    "id": "690800308",
                                    "speaker": "米卡",
                                    "text": "的确呢…以后还要一起旅行，看着你现场演示，我应该理解得更快。"
                                },
                                {
                                    "id": "690800309",
                                    "speaker": "米卡",
                                    "text": "那我们还是聊一点轻松的话题吧…你想听我讲哪方面的故事呢？"
                                },
                                {
                                    "id": "690800310",
                                    "speaker": "Player",
                                    "text": "米卡说什么，我就听什么。"
                                },
                                {
                                    "id": "690800311",
                                    "speaker": "米卡",
                                    "text": "嗯…我想想…那就和你聊聊游击小队的趣事吧！"
                                },
                                {
                                    "id": "690800312",
                                    "speaker": "米卡",
                                    "text": "刚开始，游击小队会用「掰甜甜花的花瓣」来决定收工后由谁做饭。"
                                },
                                {
                                    "id": "690800313",
                                    "speaker": "米卡",
                                    "text": "有的伙伴不擅长下厨，大家也不会介意，而是照常吃完所有饭菜，然后一起讨论优缺点。"
                                },
                                {
                                    "id": "690800314",
                                    "speaker": "米卡",
                                    "text": "多亏大家互相给出建议，一段时间以后，所有人做饭的技术都突飞猛进。"
                                },
                                {
                                    "id": "690800315",
                                    "speaker": "米卡",
                                    "text": "比不上城里的饭馆也没关系，作为行军餐已经很可口了。",
                                    "choices": [
                                        {
                                            "id": "690800316",
                                            "text": "我们也来试试吧。",
                                            "response": [
                                                {
                                                    "id": "690800318",
                                                    "speaker": "米卡",
                                                    "text": "我觉得可以哦！这样有一种惊喜的感觉…"
                                                },
                                                {
                                                    "id": "690800319",
                                                    "speaker": "米卡",
                                                    "text": "嘿嘿，开始期待下一顿饭了…我这就去找几朵甜甜花！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690800317",
                                            "text": "还可以这样决定做什么料理。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690800307",
                            "text": "现在，我想听听米卡的故事。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908004",
            "initDialog": "690800401",
            "dialogues": [
                {
                    "id": "690800401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690800402",
                    "speaker": "米卡",
                    "text": "唔…我想想看…"
                },
                {
                    "id": "690800403",
                    "speaker": "米卡",
                    "text": "那位团雀仙人请我喝茶时告诉我，你可以凭自己的意志改变这里的地貌。"
                },
                {
                    "id": "690800404",
                    "speaker": "米卡",
                    "text": "要是你不介意的话…可以找一片空旷的区域，搭建几座山峰吗？"
                },
                {
                    "id": "690800405",
                    "speaker": "米卡",
                    "text": "不用太在意外观，以你觉得不好翻越的地形为参考就行，越崎岖、越陡峭越好。"
                },
                {
                    "id": "690800406",
                    "speaker": "米卡",
                    "text": "可是，如果改变地貌很费你的时间和心思，还是不麻烦你了…"
                },
                {
                    "id": "690800407",
                    "speaker": "Player",
                    "text": "米卡想在这里锻炼身体吗？"
                },
                {
                    "id": "690800408",
                    "speaker": "米卡",
                    "text": "嗯！多亏你的招待，我在这里吃得好，住得舒服，有点害怕自己过得太安逸，身体变得迟钝…"
                },
                {
                    "id": "690800409",
                    "speaker": "米卡",
                    "text": "我的能力和经验还远远不够，不能怠懈。"
                },
                {
                    "id": "690800410",
                    "speaker": "米卡",
                    "text": "熟悉了你搭建的地形后，我也能了解你心目中麻烦的地形，提早准备应对方案。"
                },
                {
                    "id": "690800411",
                    "speaker": "米卡",
                    "text": "这样一来，以后我应该能更快地帮到你了！",
                    "choices": [
                        {
                            "id": "690800412",
                            "text": "等到时机合适，我试试看。",
                            "response": [
                                {
                                    "id": "690800414",
                                    "speaker": "米卡",
                                    "text": "好！那就麻烦你了…"
                                },
                                {
                                    "id": "690800415",
                                    "speaker": "米卡",
                                    "text": "听见你的回答，我也更有干劲了！"
                                }
                            ]
                        },
                        {
                            "id": "690800413",
                            "text": "我们一起征服险峻的地形。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908005",
            "initDialog": "690800501",
            "dialogues": [
                {
                    "id": "690800501",
                    "speaker": "Player",
                    "text": "早啊，米卡。"
                },
                {
                    "id": "690800502",
                    "speaker": "米卡",
                    "text": "#早上好，{NICKNAME}！"
                },
                {
                    "id": "690800503",
                    "speaker": "米卡",
                    "text": "吃过早饭了吗？还没有的话，请允许我借用一下灶台，马上就做好！"
                }
            ]
        },
        {
            "talkId": "6908006",
            "initDialog": "690800601",
            "dialogues": [
                {
                    "id": "690800601",
                    "speaker": "Player",
                    "text": "晚安，米卡。"
                },
                {
                    "id": "690800602",
                    "speaker": "米卡",
                    "text": "要休息了吗？你的作息时间好规律啊…"
                },
                {
                    "id": "690800603",
                    "speaker": "米卡",
                    "text": "这一点上，我也要向你学习…祝你好梦！"
                }
            ]
        },
        {
            "talkId": "6908007",
            "initDialog": "690800701",
            "dialogues": [
                {
                    "id": "690800701",
                    "speaker": "米卡",
                    "text": "啊！这里的感觉，好熟悉…"
                },
                {
                    "id": "690800702",
                    "speaker": "米卡",
                    "text": "这座营地的布局，和初版「骑士团侦察行动条令」里的典例，有着相通之处…"
                },
                {
                    "id": "690800703",
                    "speaker": "米卡",
                    "text": "真不愧是你！居然连这些细节都一清二楚…我好佩服！"
                }
            ]
        },
        {
            "talkId": "6908008",
            "initDialog": "690800801",
            "dialogues": [
                {
                    "id": "690800801",
                    "speaker": "米卡",
                    "text": "好宽敞的厨房，器具也应有尽有…做出一支小队的行军餐都不成问题。"
                },
                {
                    "id": "690800802",
                    "speaker": "米卡",
                    "text": "待在这里，我就能想起和队友们一起聚餐时的情景。"
                },
                {
                    "id": "690800803",
                    "speaker": "米卡",
                    "text": "不能和大家一起喝酒也没关系，听着大家聊天，我就很开心了！"
                }
            ]
        }
    ]
}