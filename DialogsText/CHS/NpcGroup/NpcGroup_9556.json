    "talks": [
        {
            "talkId": "6955601",
            "initDialog": "695560101",
            "dialogues": [
                {
                    "id": "695560101",
                    "speaker": "琳妮特",
                    "text": "原来是这样的卡牌游戏…也许林尼会喜欢玩吧。"
                }
            ]
        },
        {
            "talkId": "6955602",
            "initDialog": "695560201",
            "dialogues": [
                {
                    "id": "695560201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955603",
            "initDialog": "695560301",
            "dialogues": [
                {
                    "id": "695560301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695560302",
                    "speaker": "琳妮特",
                    "text": "再见，我还要再留一会，记录一下这种卡牌游戏的细节，总有一天用得上。"
                }
            ]
        },
        {
            "talkId": "6955604",
            "initDialog": "695560401",
            "dialogues": [
                {
                    "id": "695560401",
                    "speaker": "琳妮特",
                    "text": "补充一句。我没用特殊手法取胜。"
                }
            ]
        },
        {
            "talkId": "6955605",
            "initDialog": "695560501",
            "dialogues": [
                {
                    "id": "695560501",
                    "speaker": "琳妮特",
                    "text": "卡牌魔术不是我的强项…我还是去喝杯茶，清醒一下吧。"
                }
            ]
        },
        {
            "talkId": "6955606",
            "initDialog": "695560601",
            "dialogues": [
                {
                    "id": "695560601",
                    "speaker": "琳妮特",
                    "text": "好，让我集中精神。"
                }
            ]
        },
        {
            "talkId": "6955608",
            "initDialog": "695560801",
            "dialogues": [
                {
                    "id": "695560801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955609",
            "initDialog": "695560901",
            "dialogues": [
                {
                    "id": "695560901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955610",
            "initDialog": "695561001",
            "dialogues": [
                {
                    "id": "695561001",
                    "speaker": "琳妮特",
                    "text": "轻松取胜，再来一局？"
                }
            ]
        },
        {
            "talkId": "6955611",
            "initDialog": "695561101",
            "dialogues": [
                {
                    "id": "695561101",
                    "speaker": "琳妮特",
                    "text": "输掉了，这种游戏真复杂。"
                }
            ]
        },
        {
            "talkId": "6955612",
            "initDialog": "695561201",
            "dialogues": [
                {
                    "id": "695561201",
                    "speaker": "琳妮特",
                    "text": "那我要启动打牌模式咯。"
                }
            ]
        },
        {
            "talkId": "6955614",
            "initDialog": "695561401",
            "dialogues": [
                {
                    "id": "695561401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955615",
            "initDialog": "695561501",
            "dialogues": [
                {
                    "id": "695561501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
