{
    "groupId": "7816",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "谢格洛夫": 8
    },
    "talks": [
        {
            "talkId": "6781601",
            "initDialog": "678160101",
            "dialogues": [
                {
                    "id": "678160101",
                    "speaker": "谢格洛夫",
                    "text": "嘿嘿…今天的这辆列车是第三批次制造的型号…"
                }
            ]
        },
        {
            "talkId": "6781602",
            "initDialog": "678160201",
            "dialogues": [
                {
                    "id": "678160201",
                    "speaker": "Player",
                    "text": "列车还有型号之分吗…"
                },
                {
                    "id": "678160202",
                    "speaker": "谢格洛夫",
                    "text": "那是当然啦，这位朋友，虽然至冬列车的外形没有太大的变化，但是每一批次制造的列车都会有些许的差别。"
                },
                {
                    "id": "678160203",
                    "speaker": "谢格洛夫",
                    "text": "我们现在坐的列车，就是第三批次大规模制造列车时制造的，列车在轨道上行驶时…轮箍的声音会更轻盈一些…"
                }
            ]
        },
        {
            "talkId": "6781603",
            "initDialog": "678160301",
            "dialogues": [
                {
                    "id": "678160301",
                    "speaker": "Player",
                    "text": "你很喜欢列车吗？"
                },
                {
                    "id": "678160302",
                    "speaker": "谢格洛夫",
                    "text": "嗯，不觉得很了不起吗，人类和妖精共同搭建的轨道，贯穿了对于妖精来说都很难跋涉的冻土…不让人感觉到佩服吗？"
                },
                {
                    "id": "678160303",
                    "speaker": "谢格洛夫",
                    "text": "而且，据说不管是最初的列车的设计，还是现有轨道的设计，都是由人类主导的…"
                },
                {
                    "id": "678160304",
                    "speaker": "谢格洛夫",
                    "text": "列车最初的外形据说是由白沙皇陛下宫廷中的某位不知名女官绘制…轨道的设计则出自三位冒险家协会的大师之手。"
                },
                {
                    "id": "678160305",
                    "speaker": "谢格洛夫",
                    "text": "这点也很了不起，人类没有妖精那样漫长的生命，但他们设计的东西却能这么长久地留存下来。"
                }
            ]
        },
        {
            "talkId": "6781604",
            "initDialog": "678160401",
            "dialogues": [
                {
                    "id": "678160401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678160402",
                    "speaker": "谢格洛夫",
                    "text": "再见…要多多乘坐至冬的列车哦。"
                }
            ]
        }
    ]
}