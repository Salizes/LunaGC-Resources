{
    "groupId": "3136",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "锦野玲玲": 12
    },
    "talks": [
        {
            "talkId": "6313601",
            "initDialog": "631360101",
            "dialogues": [
                {
                    "id": "631360101",
                    "speaker": "锦野玲玲",
                    "text": "你好，找我的话，是需要医疗帮助吗？"
                },
                {
                    "id": "631360102",
                    "speaker": "锦野玲玲",
                    "text": "是跌打外伤，还是感冒发烧？有什么问题快直说。"
                }
            ]
        },
        {
            "talkId": "6313602",
            "initDialog": "631360201",
            "dialogues": [
                {
                    "id": "631360201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "631360202",
                    "speaker": "锦野玲玲",
                    "text": "没看出来吗，我是医生。"
                },
                {
                    "id": "631360203",
                    "speaker": "锦野玲玲",
                    "text": "不，我并不是海祇岛民。我的家人都住在鸣神岛，也大多从事医疗行业。"
                }
            ]
        },
        {
            "talkId": "6313603",
            "initDialog": "631360301",
            "dialogues": [
                {
                    "id": "631360301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "631360302",
                    "speaker": "锦野玲玲",
                    "text": "哦，有事再叫我吧。"
                }
            ]
        },
        {
            "talkId": "6313604",
            "initDialog": "631360401",
            "dialogues": [
                {
                    "id": "631360401",
                    "speaker": "Player",
                    "text": "为什么来海祇岛？"
                },
                {
                    "id": "631360402",
                    "speaker": "锦野玲玲",
                    "text": "我以前到处做游医的时候，偶然在野外救下了一名珊瑚宫军的士兵，听说了海祇岛这边的情况。"
                },
                {
                    "id": "631360403",
                    "speaker": "锦野玲玲",
                    "text": "在物资和人手都很短缺的条件下，珊瑚宫的人能撑到现在，该说他们是韧性够强，还是一意孤行呢…"
                },
                {
                    "id": "631360404",
                    "speaker": "锦野玲玲",
                    "text": "不过现在有我在，情况好转了不少。只要这些伤兵记得听我的话，谨遵医嘱，不乱跑乱动，都会好起来的。"
                },
                {
                    "id": "631360405",
                    "speaker": "锦野玲玲",
                    "text": "只是希望附近的小孩子们能安分一点，不要再摔破了胳膊腿什么的哭着来找我…我可应付不来这些吵吵闹闹的小鬼们啊。"
                }
            ]
        },
        {
            "talkId": "7293801",
            "initDialog": "729380101",
            "dialogues": [
                {
                    "id": "729380101",
                    "speaker": "Player",
                    "text": "你真好。"
                },
                {
                    "id": "729380102",
                    "speaker": "锦野玲玲",
                    "text": "哈？不、不要突然说奇怪的话！"
                },
                {
                    "id": "729380103",
                    "speaker": "锦野玲玲",
                    "text": "医生救人，是再普通不过的事情了吧，不值一提。"
                },
                {
                    "id": "729380104",
                    "speaker": "锦野玲玲",
                    "text": "…喏，这个你拿去吧，没准以后能派上用场。"
                }
            ]
        }
    ]
}