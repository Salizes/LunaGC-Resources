{
    "groupId": "4013",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "法卢克": 9
    },
    "talks": [
        {
            "talkId": "6401301",
            "initDialog": "640130101",
            "dialogues": [
                {
                    "id": "640130101",
                    "speaker": "法卢克",
                    "text": "小心扒手。"
                }
            ]
        },
        {
            "talkId": "6401302",
            "initDialog": "640130201",
            "dialogues": [
                {
                    "id": "640130201",
                    "speaker": "Player",
                    "text": "有很多小偷吗？"
                },
                {
                    "id": "640130202",
                    "speaker": "法卢克",
                    "text": "有「三十人团」在附近巡逻，其实不会有那么多胆大妄为的小偷。"
                },
                {
                    "id": "640130203",
                    "speaker": "法卢克",
                    "text": "但是，没办法排除监守自盗的可能性。"
                },
                {
                    "id": "640130204",
                    "speaker": "法卢克",
                    "text": "如果你见到一个和我长得一样的人，就要小心自己的钱包了。"
                },
                {
                    "id": "640130205",
                    "speaker": "法卢克",
                    "text": "他是我的双胞胎哥哥，小偷小摸成性，而且还满口胡言。"
                },
                {
                    "id": "640130206",
                    "speaker": "法卢克",
                    "text": "你千万不要被他绕糊涂，注意他的手脚就完事了。"
                }
            ]
        },
        {
            "talkId": "6401303",
            "initDialog": "640130301",
            "dialogues": [
                {
                    "id": "640130301",
                    "speaker": "Player",
                    "text": "多谢提醒。"
                },
                {
                    "id": "640130302",
                    "speaker": "法卢克",
                    "text": "嗯，明白就好。"
                }
            ]
        },
        {
            "talkId": "7392601",
            "initDialog": "739260101",
            "dialogues": [
                {
                    "id": "739260101",
                    "speaker": "Player",
                    "text": "你们长得都差不多…"
                },
                {
                    "id": "739260102",
                    "speaker": "法卢克",
                    "text": "那就更简单了——都防备着点吧。"
                },
                {
                    "id": "739260103",
                    "speaker": "法卢克",
                    "text": "要是看见穿着制服的人就卸下防范的话，总有一天要吃亏的。"
                }
            ]
        }
    ]
}