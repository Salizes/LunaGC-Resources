{
    "groupId": "2495",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 7,
        "石坤": 23
    },
    "talks": [
        {
            "talkId": "6249501",
            "initDialog": "624950101",
            "dialogues": [
                {
                    "id": "624950101",
                    "speaker": "石坤",
                    "text": "你好啊贵客！沿着北边那条路再走几步，就到庄里了！"
                }
            ]
        },
        {
            "talkId": "6249502",
            "initDialog": "624950201",
            "dialogues": [
                {
                    "id": "624950201",
                    "speaker": "Player",
                    "text": "贵客？"
                },
                {
                    "id": "624950202",
                    "speaker": "石坤",
                    "text": "外地人来了就是客，我们翘英庄的庄民自然要好好招待。"
                },
                {
                    "id": "624950203",
                    "speaker": "石坤",
                    "text": "我看你仪表不凡，身上有一股高贵之气，说不定要给我们带来财运，可不是贵客嘛！"
                }
            ]
        },
        {
            "talkId": "6249503",
            "initDialog": "624950301",
            "dialogues": [
                {
                    "id": "624950301",
                    "speaker": "Player",
                    "text": "你在干什么呢？"
                },
                {
                    "id": "624950302",
                    "speaker": "石坤",
                    "text": "我们翘英庄有个传统，体力好的大老爷们干完了自家的活，还得帮帮邻居。"
                },
                {
                    "id": "624950303",
                    "speaker": "石坤",
                    "text": "庄主罗叔会安排我们轮班，村子南边站几个，村子北边坐几个，随时等候…"
                },
                {
                    "id": "624950304",
                    "speaker": "石坤",
                    "text": "要是哪家哪户干体力活的时候缺人手，直接过来招呼我们就行！"
                }
            ]
        },
        {
            "talkId": "6249504",
            "initDialog": "624950401",
            "dialogues": [
                {
                    "id": "624950401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624950402",
                    "speaker": "石坤",
                    "text": "再见，有需要帮忙的事，随时可以来找我。"
                }
            ]
        },
        {
            "talkId": "6249505",
            "initDialog": "624950501",
            "dialogues": [
                {
                    "id": "624950501",
                    "speaker": "石坤",
                    "text": "等到今天的夜班结束，应该就能去和大哥们喝两杯了…"
                }
            ]
        },
        {
            "talkId": "6249506",
            "initDialog": "624950601",
            "dialogues": [
                {
                    "id": "624950601",
                    "speaker": "Player",
                    "text": "怎么还有夜班的！"
                },
                {
                    "id": "624950602",
                    "speaker": "石坤",
                    "text": "嘿，有的茶农早上三四点就起床干活了，有个帮手总是好事。"
                },
                {
                    "id": "624950603",
                    "speaker": "石坤",
                    "text": "我这种平常活儿不多，精力又不错的大老爷们，最适合半夜值个班，随叫随到！"
                },
                {
                    "id": "624950604",
                    "speaker": "石坤",
                    "text": "其实半夜到凌晨这段时间，干活的效率还挺高，周围特别安静，注意力更容易集中，有劲！"
                }
            ]
        },
        {
            "talkId": "6249507",
            "initDialog": "624950701",
            "dialogues": [
                {
                    "id": "624950701",
                    "speaker": "Player",
                    "text": "你的兄弟很多呀？"
                },
                {
                    "id": "624950702",
                    "speaker": "石坤",
                    "text": "哦！不是亲兄弟，只是经常一起干活的几个朋友！"
                },
                {
                    "id": "624950703",
                    "speaker": "石坤",
                    "text": "论年龄，我比较小，所以得叫他们大哥！"
                },
                {
                    "id": "624950704",
                    "speaker": "石坤",
                    "text": "因为我们经常帮邻居做事，所以有「翘英庄六小龙」的外号。"
                },
                {
                    "id": "624950705",
                    "speaker": "石坤",
                    "text": "我排第四，所以是四龙，哈哈！"
                },
                {
                    "id": "624950706",
                    "speaker": "石坤",
                    "text": "这两年，五龙六龙两位老弟去跑镖和跑船了，三龙在遗珑埠谋了份差事…"
                },
                {
                    "id": "624950707",
                    "speaker": "石坤",
                    "text": "所以平常我就找大龙和二龙两位龙哥喝喝酒，聊聊家常。"
                },
                {
                    "id": "624950708",
                    "speaker": "石坤",
                    "text": "勤勤恳恳工作的日子令人充实，悠悠哉哉过日子也不错嘛！"
                }
            ]
        },
        {
            "talkId": "6249508",
            "initDialog": "624950801",
            "dialogues": [
                {
                    "id": "624950801",
                    "speaker": "Player",
                    "text": "玩得开心！"
                },
                {
                    "id": "624950802",
                    "speaker": "石坤",
                    "text": "多谢多谢！你也是！"
                }
            ]
        },
        {
            "talkId": "7195401",
            "initDialog": "719540101",
            "dialogues": [
                {
                    "id": "719540101",
                    "speaker": "Player",
                    "text": "那工钱怎么算？"
                },
                {
                    "id": "719540102",
                    "speaker": "石坤",
                    "text": "不算不算，都是老熟人了，没那么见外！"
                },
                {
                    "id": "719540103",
                    "speaker": "石坤",
                    "text": "替邻居家干了活以后，招待我们吃顿饭，一起喝两杯酒，就算是酬劳了！"
                },
                {
                    "id": "719540104",
                    "speaker": "石坤",
                    "text": "嗯，前两天我还帮了德音大伯搬了些衣物和书卷，他做的蛋羹很不错！"
                },
                {
                    "id": "719540105",
                    "speaker": "石坤",
                    "text": "要是你有空，也可以去和德音大伯聊上两句，听他说说沉玉谷的故事！"
                }
            ]
        }
    ]
}