{
    "groupId": "6641",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "卓新": 6
    },
    "talks": [
        {
            "talkId": "600675",
            "initDialog": "60067501",
            "dialogues": [
                {
                    "id": "60067501",
                    "speaker": "卓新",
                    "text": "#{NICKNAME}？好久不见了，希望你跟伊涅芙一切安好。",
                    "choices": [
                        {
                            "id": "60067502",
                            "text": "你这是在…？",
                            "response": [
                                {
                                    "id": "60067503",
                                    "speaker": "卓新",
                                    "text": "先前的风波了结后，火神大人考虑到北方的时局，决定在这增设一处简易港口，方便接纳从挪德卡莱过来的人们。"
                                },
                                {
                                    "id": "60067504",
                                    "speaker": "卓新",
                                    "text": "我受了你们那么多照顾，也想承担一些责任，弥补一些过错…哪怕再微不足道也好。"
                                },
                                {
                                    "id": "60067505",
                                    "speaker": "卓新",
                                    "text": "所以就来到这里，帮助那些跟我们境遇相似的人了。"
                                }
                            ]
                        },
                        {
                            "id": "60067506",
                            "text": "愚人众没再找你麻烦？",
                            "response": [
                                {
                                    "id": "60067507",
                                    "speaker": "卓新",
                                    "text": "花羽会的人帮我盯了很久，但看起来他们确实没有要找麻烦的意思。或许是挪德卡莱那边已经够他们焦头烂额了？"
                                },
                                {
                                    "id": "60067508",
                                    "speaker": "卓新",
                                    "text": "又或许这里发生的一切，不过是手下贪功冒进，而「木偶」本人…从来就没把这些事放在心上吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}