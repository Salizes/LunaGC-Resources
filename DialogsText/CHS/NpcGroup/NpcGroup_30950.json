    },
    "talks": [
        {
            "talkId": "4023159",
            "initDialog": "402315901",
            "dialogues": [
                {
                    "id": "402315901",
                    "speaker": "「浩劫」",
                    "text": "听说这个东西刚发明出来的时候性能很差，一个星期就能抓十几只，研究人员就连改进它的兴趣都没有。"
                },
                {
                    "id": "402315902",
                    "speaker": "「天启」",
                    "text": "但是不知道为什么，在流入市场之后，它受到了冒险家的热烈欢迎。"
                },
                {
                    "id": "402315903",
                    "speaker": "「浩劫」",
                    "text": "是啊，虽然很花时间，但胜在不用自己动手。"
                },
                {
                    "id": "402315904",
                    "speaker": "「天启」",
                    "text": "明明这附近就有很多晶蝶，为什么不自己动手呢？"
                },
                {
                    "id": "402315905",
                    "speaker": "「浩劫」",
                    "text": "可能是比较偏远吧，过去连这种装置都没有的时候，就只能自己动手，一次又一次地来这里。"
                },
                {
                    "id": "402315906",
                    "speaker": "「浩劫」",
                    "text": "…这算不算擅闯私人领地啊？"
                },
                {
                    "id": "402315907",
                    "speaker": "「天启」",
                    "text": "而且现在冒险家们好像没那么热衷于晶蝶了。"
                },
                {
                    "id": "402315908",
                    "speaker": "「浩劫」",
                    "text": "潮流过去了吧，潮流。"
                },
                {
                    "id": "402315909",
                    "speaker": "「天启」",
                    "text": "是啊。"
                },
                {
                    "id": "402315910",
                    "speaker": "派蒙",
                    "text": "叽里咕噜的，在说什么呢？"
                },
                {
                    "id": "402315911",
                    "speaker": "Player",
                    "text": "不知道啊。"
                }
            ]
        },
        {
            "talkId": "4023176",
            "initDialog": "402317601",
            "dialogues": [
                {
                    "id": "402317601",
                    "speaker": "「浩劫」",
                    "text": "潮流过去了吧，潮流。"
                },
                {
                    "id": "402317602",
                    "speaker": "「天启」",
                    "text": "是啊。"
                }
            ]
        }
    ]
}