    "talks": [
        {
            "talkId": "6414001",
            "initDialog": "641400101",
            "dialogues": [
                {
                    "id": "641400101",
                    "speaker": "阿拉耶什",
                    "text": "需要上门理发服务吗？"
                }
            ]
        },
        {
            "talkId": "6414002",
            "initDialog": "641400201",
            "dialogues": [
                {
                    "id": "641400201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641400202",
                    "speaker": "阿拉耶什",
                    "text": "我是理发匠，竭诚为你服务！"
                },
                {
                    "id": "641400203",
                    "speaker": "阿拉耶什",
                    "text": "把你的头发交给我，我一定能为你设计出最时尚，也最适合你的发型。"
                },
                {
                    "id": "641400204",
                    "speaker": "阿拉耶什",
                    "text": "而且在剪、烫、染之中，我最擅长染发，尤其是调配颜色。"
                },
                {
                    "id": "641400205",
                    "speaker": "阿拉耶什",
                    "text": "就拿你举例吧，这里再长一点，后边再短一点，会更加修饰脸型。"
                },
                {
                    "id": "641400206",
                    "speaker": "阿拉耶什",
                    "text": "然后再染个渐变色…嗯，一定很不错！"
                }
            ]
        },
        {
            "talkId": "6414003",
            "initDialog": "641400301",
            "dialogues": [
                {
                    "id": "641400301",
                    "speaker": "Player",
                    "text": "下次再说。"
                },
                {
                    "id": "641400302",
                    "speaker": "阿拉耶什",
                    "text": "换发型就是换心情，记得来找我哦！"
                }
            ]
        }
    ]
}