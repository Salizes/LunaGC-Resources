            "talkId": "1600033",
            "initDialog": "160003301",
            "dialogues": [
                {
                    "id": "160003301",
                    "speaker": "派蒙",
                    "text": "嗯？我们上次来的时候，这里有这么多书稿吗？"
                },
                {
                    "id": "160003302",
                    "speaker": "Player",
                    "text": "都是她后来发表的作品吧。"
                },
                {
                    "id": "160003303",
                    "speaker": "派蒙",
                    "text": "那位魔女在杜林出生后又写了这么多作品吗？让我看看…"
                },
                {
                    "id": "160003304",
                    "speaker": "派蒙",
                    "text": "奇怪…是我的阅读量不够吗？我怎么觉得这些书稿上的内容都没有发表过？"
                },
                {
                    "id": "160003305",
                    "speaker": "派蒙",
                    "text": "这些书稿是为哪个故事准备的？",
                    "choices": [
                        {
                            "id": "160003306",
                            "text": "不太清楚…",
                            "response": [
                                {
                                    "id": "160003308",
                                    "speaker": "派蒙",
                                    "text": "她准备了这么多书稿…我真好奇这个故事会有多精彩。"
                                }
                            ]
                        },
                        {
                            "id": "160003307",
                            "text": "可能我们还没读到吧。"
                        }
                    ]
                }
            ]
        }
    ]
}