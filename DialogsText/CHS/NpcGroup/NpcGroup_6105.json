{
    "groupId": "6105",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "马伊塔": 13
    },
    "talks": [
        {
            "talkId": "6610501",
            "initDialog": "661050101",
            "dialogues": [
                {
                    "id": "661050101",
                    "speaker": "马伊塔",
                    "text": "哎呀，被你抓住了。"
                }
            ]
        },
        {
            "talkId": "6610502",
            "initDialog": "661050201",
            "dialogues": [
                {
                    "id": "661050201",
                    "speaker": "Player",
                    "text": "刚刚在乱跑什么呢？"
                },
                {
                    "id": "661050202",
                    "speaker": "马伊塔",
                    "text": "怎么能说是乱跑呢！我明明是在训练。"
                },
                {
                    "id": "661050203",
                    "speaker": "马伊塔",
                    "text": "大人们都说我跑得贼快，是他们见过的跑得最快的调皮蛋。"
                },
                {
                    "id": "661050204",
                    "speaker": "马伊塔",
                    "text": "所以我要学有所长，继续加油，早日成为在深渊里跑得最快的战士！"
                }
            ]
        },
        {
            "talkId": "6610503",
            "initDialog": "661050301",
            "dialogues": [
                {
                    "id": "661050301",
                    "speaker": "Player",
                    "text": "好吧，放过你。"
                },
                {
                    "id": "661050302",
                    "speaker": "马伊塔",
                    "text": "嘿，那我走咯！"
                }
            ]
        },
        {
            "talkId": "6610504",
            "initDialog": "661050401",
            "dialogues": [
                {
                    "id": "661050401",
                    "speaker": "Player",
                    "text": "有点对，又有点不太对。"
                },
                {
                    "id": "661050402",
                    "speaker": "马伊塔",
                    "text": "嗯？什么意思？"
                },
                {
                    "id": "661050403",
                    "speaker": "马伊塔",
                    "text": "是说方向很对，但方法不对，就像「小悬崖」边上那个外国哥哥吗？"
                },
                {
                    "id": "661050404",
                    "speaker": "马伊塔",
                    "text": "哎呀，他的问题其实很简单啦，就是做事情太小心了！"
                },
                {
                    "id": "661050405",
                    "speaker": "马伊塔",
                    "text": "洛娅姐姐老是担心他受伤，但不受伤是学不快的。"
                },
                {
                    "id": "661050406",
                    "speaker": "马伊塔",
                    "text": "不如让我去当他的教练。我爬很快的，教得也一定很快。等他摔个十次八次，自然就能学会啦。"
                }
            ]
        },
        {
            "talkId": "6610505",
            "initDialog": "661050501",
            "dialogues": [
                {
                    "id": "661050501",
                    "speaker": "Player",
                    "text": "刚刚在乱跑什么呢？"
                },
                {
                    "id": "661050502",
                    "speaker": "马伊塔",
                    "text": "怎么能说是乱跑呢！我明明是在训练。"
                },
                {
                    "id": "661050503",
                    "speaker": "马伊塔",
                    "text": "大人们都说我跑得贼快，是他们见过的跑得最快的调皮蛋。"
                },
                {
                    "id": "661050504",
                    "speaker": "马伊塔",
                    "text": "所以我要学有所长，继续加油，早日成为竞技场里跑得最快的战士！"
                }
            ]
        }
    ]
}