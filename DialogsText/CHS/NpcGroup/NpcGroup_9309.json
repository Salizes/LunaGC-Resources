{
    "groupId": "9309",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "凝光": 9
    },
    "talks": [
        {
            "talkId": "6930901",
            "initDialog": "693090101",
            "dialogues": [
                {
                    "id": "693090101",
                    "speaker": "凝光",
                    "text": "此处真是奥妙无穷…也不知，此地究竟归属何处…"
                },
                {
                    "id": "693090102",
                    "speaker": "凝光",
                    "text": "若是能收集些土壤，或是将这周围摆设的形制记录下来，带回去细细研究…说不定会有所发现。"
                },
                {
                    "id": "693090103",
                    "speaker": "凝光",
                    "text": "我？我自然是在休息，却也是在静思。二者并不冲突。"
                }
            ]
        },
        {
            "talkId": "6930902",
            "initDialog": "693090201",
            "dialogues": [
                {
                    "id": "693090201",
                    "speaker": "凝光",
                    "text": "你亲自邀我同行，我岂有冷拒之理？"
                },
                {
                    "id": "693090202",
                    "speaker": "凝光",
                    "text": "但想要深入秘境，不妨趁此机会，再多去收集一些情报吧。"
                },
                {
                    "id": "693090203",
                    "speaker": "凝光",
                    "text": "如果可以成为掌控全局的庄家，又何必去做身不由己的赌徒呢？"
                }
            ]
        },
        {
            "talkId": "6930903",
            "initDialog": "693090301",
            "dialogues": [
                {
                    "id": "693090301",
                    "speaker": "凝光",
                    "text": "文人的笔墨，市井的烟火，没有资财构筑的地基，都不过是空中楼阁。"
                },
                {
                    "id": "693090302",
                    "speaker": "凝光",
                    "text": "如今我拥有了万贯家财，在夜幕中登高眺远时，我也会思考财富的其他去向。"
                },
                {
                    "id": "693090303",
                    "speaker": "凝光",
                    "text": "受你邀请来这之后，我有了新的答案。一座向孩童们无偿开放的图书馆…或许是个不错的选择。"
                }
            ]
        }
    ]
}