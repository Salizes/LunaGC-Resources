{
    "groupId": "9096",
    "total_dialogue_lines": 89,
    "speaker_counts": {
        "Player": 29,
        "阿蕾奇诺": 60
    },
    "talks": [
        {
            "talkId": "6909601",
            "initDialog": "690960101",
            "dialogues": [
                {
                    "id": "690960101",
                    "speaker": "阿蕾奇诺",
                    "text": "这次换我来做客…倒是一种新奇的体验。"
                },
                {
                    "id": "690960102",
                    "speaker": "阿蕾奇诺",
                    "text": "客随主便，你来安排就好。"
                }
            ]
        },
        {
            "talkId": "6909602",
            "initDialog": "690960201",
            "dialogues": [
                {
                    "id": "690960201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690960202",
                    "speaker": "阿蕾奇诺",
                    "text": "感谢邀请。对我来说，是个度假的选择。"
                },
                {
                    "id": "690960203",
                    "speaker": "阿蕾奇诺",
                    "text": "有考虑转手吗？",
                    "choices": [
                        {
                            "id": "690960204",
                            "text": "啊？",
                            "response": [
                                {
                                    "id": "690960206",
                                    "speaker": "阿蕾奇诺",
                                    "text": "不必惊讶。这里安静隐秘，不受外界打扰，可以当做备用据点。"
                                },
                                {
                                    "id": "690960207",
                                    "speaker": "阿蕾奇诺",
                                    "text": "有了它，许多麻烦都会迎刃而解，付出一些代价也值得。",
                                    "choices": [
                                        {
                                            "id": "690960208",
                                            "text": "不好意思…",
                                            "response": [
                                                {
                                                    "id": "690960210",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "真令人遗憾…不过也算预料中的答案。"
                                                },
                                                {
                                                    "id": "690960211",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "比起「据点」，它更像一个「家」。那就让它保持现状吧。"
                                                },
                                                {
                                                    "id": "690960212",
                                                    "speaker": "Player",
                                                    "text": "说到「家」…"
                                                },
                                                {
                                                    "id": "690960213",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "怎么了？",
                                                    "choices": [
                                                        {
                                                            "id": "690960214",
                                                            "text": "要不要举办「家庭烧烤聚会」？",
                                                            "response": [
                                                                {
                                                                    "id": "690960216",
                                                                    "speaker": "阿蕾奇诺",
                                                                    "text": "不错的提案。周围足够宽敞，是举办家庭聚会的好地方。"
                                                                },
                                                                {
                                                                    "id": "690960217",
                                                                    "speaker": "阿蕾奇诺",
                                                                    "text": "能到朋友家玩，孩子们也会很高兴。就这么说定了…聚会所需的一切开销，由我支付就好。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690960215",
                                                            "text": "可以邀请「壁炉之家」一起来。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690960209",
                                            "text": "这可是非卖品。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690960205",
                            "text": "你想买下尘歌壶？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909603",
            "initDialog": "690960301",
            "dialogues": [
                {
                    "id": "690960301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690960302",
                    "speaker": "阿蕾奇诺",
                    "text": "可以啊，想聊什么？",
                    "choices": [
                        {
                            "id": "690960303",
                            "text": "这个…",
                            "response": [
                                {
                                    "id": "690960305",
                                    "speaker": "阿蕾奇诺",
                                    "text": "孩子们也经常这么说。"
                                },
                                {
                                    "id": "690960306",
                                    "speaker": "阿蕾奇诺",
                                    "text": "「不知道能和『父亲』聊些什么，总是很难找话题…」我听过许多类似的讨论。"
                                },
                                {
                                    "id": "690960307",
                                    "speaker": "阿蕾奇诺",
                                    "text": "其实并不困难，大部分话题我都接得住。",
                                    "choices": [
                                        {
                                            "id": "690960308",
                                            "text": "（聊巡轨船的设计原理。）",
                                            "response": [
                                                {
                                                    "id": "690960309",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "这是一个非常专业的问题，没想到你会对它感兴趣。"
                                                },
                                                {
                                                    "id": "690960310",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "巡轨船内部有着非常精妙的发条装置，可以灵活选择不同能源的驱动方式。"
                                                },
                                                {
                                                    "id": "690960311",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "听说在试运行期间，也有乘客反映，希望使用更有特点的外观。"
                                                },
                                                {
                                                    "id": "690960312",
                                                    "speaker": "Player",
                                                    "text": "还有这回事？"
                                                },
                                                {
                                                    "id": "690960313",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "一部分人建议把它做成「天使海兔」的模样，但综合性能考虑，这个建议并没有被采纳。"
                                                },
                                                {
                                                    "id": "690960314",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "如果你对这段历史感兴趣，改天我可以邀请一位枫丹科学院的「朋友」，一边坐船，一边为你讲解。"
                                                },
                                                {
                                                    "id": "690960328",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "还有什么想问的吗？"
                                                },
                                                {
                                                    "id": "690960329",
                                                    "speaker": "Player",
                                                    "text": "真的什么都能聊！"
                                                },
                                                {
                                                    "id": "690960330",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "当然。建立人际关系时，寻找共同话题是必不可少的技能。"
                                                },
                                                {
                                                    "id": "690960331",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "有情报，自然需要提前准备，但不能将全部希望寄托在情报上。我会尽可能接触各个领域，了解更多知识。"
                                                },
                                                {
                                                    "id": "690960332",
                                                    "speaker": "Player",
                                                    "text": "会感到枯燥吗？"
                                                },
                                                {
                                                    "id": "690960333",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "正相反。涉猎越广，越能清晰地认知世界如何运转。同时，也能让我选择相对优雅的方式生活。"
                                                },
                                                {
                                                    "id": "690960334",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "在照顾别人之前，人总要先学会照顾自己，知识与技巧会带来更多选择。"
                                                },
                                                {
                                                    "id": "690960335",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "遇到想要分享的事情，就来找我吧。相信除了那些需要保持沉默的内容，大部分话题我们都能聊得愉快。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690960315",
                                            "text": "（聊选购甜点的心得。）",
                                            "response": [
                                                {
                                                    "id": "690960316",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "看来我在茶会上选的点心，很对你胃口。"
                                                },
                                                {
                                                    "id": "690960317",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "挑选甜点的技巧有很多，关键在于足够「了解」。"
                                                },
                                                {
                                                    "id": "690960318",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "种类、店铺、工艺、搭配…各项因素综合叠加。如果是为其他人挑选，还要加上更多情报。"
                                                },
                                                {
                                                    "id": "690960319",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "性格、关系、场合、偏好…因地制宜，没有标准答案。"
                                                },
                                                {
                                                    "id": "690960320",
                                                    "speaker": "Player",
                                                    "text": "听上去好复杂。"
                                                },
                                                {
                                                    "id": "690960321",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "对新手来说比较困难，经验总是逐渐累积的，先从为朋友购买点心练起吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690960322",
                                            "text": "（聊最近上映的歌剧。）",
                                            "response": [
                                                {
                                                    "id": "690960323",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "你是说《意外之梦》？那是一部成熟的作品，阴差阳错的爱情最终取得了美满的结果。"
                                                },
                                                {
                                                    "id": "690960324",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "我看过首映。那一场演员准备得并不充分，期间出了不少事故，但仍然给观众带去了欢声笑语。"
                                                },
                                                {
                                                    "id": "690960325",
                                                    "speaker": "Player",
                                                    "text": "听说这次的演员很有名。"
                                                },
                                                {
                                                    "id": "690960326",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "没错，如果你熟悉歌剧，对她应该有印象。她是《情迷海露港》的主演，正处于事业的黄金期。"
                                                },
                                                {
                                                    "id": "690960327",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "后天有第四轮演出，如果你感兴趣，我可以邀请你同行。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690960304",
                            "text": "想不出来…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909604",
            "initDialog": "690960401",
            "dialogues": [
                {
                    "id": "690960401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690960402",
                    "speaker": "阿蕾奇诺",
                    "text": "天气不错，风也很好。出门散散心吧。"
                },
                {
                    "id": "690960403",
                    "speaker": "Player",
                    "text": "去哪里呢？"
                },
                {
                    "id": "690960404",
                    "speaker": "阿蕾奇诺",
                    "text": "有两处景色我比较喜欢，分别是白天的海面与夜晚的天空。"
                },
                {
                    "id": "690960405",
                    "speaker": "阿蕾奇诺",
                    "text": "需要思考的时候，我会选择前者。心情好的时候，更偏向于后者。",
                    "choices": [
                        {
                            "id": "690960406",
                            "text": "为什么喜欢大海呢？",
                            "response": [
                                {
                                    "id": "690960407",
                                    "speaker": "阿蕾奇诺",
                                    "text": "久居枫丹的人，很少不喜欢海。"
                                },
                                {
                                    "id": "690960408",
                                    "speaker": "阿蕾奇诺",
                                    "text": "海洋充满神秘与危险，却也包容所有欲望。而且…大海很广阔，能装下许多烦恼。"
                                },
                                {
                                    "id": "690960409",
                                    "speaker": "Player",
                                    "text": "是说看海会让人心情变好吗？"
                                },
                                {
                                    "id": "690960410",
                                    "speaker": "阿蕾奇诺",
                                    "text": "不，是更为现实的意味。它可以让惹人反感的东西消失，永远不再出现。"
                                },
                                {
                                    "id": "690960411",
                                    "speaker": "阿蕾奇诺",
                                    "text": "对于那些见不得光的秘密，沉到海底就是个不错的主意。"
                                },
                                {
                                    "id": "690960412",
                                    "speaker": "Player",
                                    "text": "听起来好危险…"
                                },
                                {
                                    "id": "690960413",
                                    "speaker": "阿蕾奇诺",
                                    "text": "当你的目光能够穿透明媚的海面，看到大海深处的阴冷，你才算真正认识这个世界。"
                                }
                            ]
                        },
                        {
                            "id": "690960414",
                            "text": "为什么喜欢夜空呢？",
                            "response": [
                                {
                                    "id": "690960415",
                                    "speaker": "阿蕾奇诺",
                                    "text": "嗯…这是一个遥远的故事。"
                                },
                                {
                                    "id": "690960416",
                                    "speaker": "阿蕾奇诺",
                                    "text": "小时候我做过一个梦。梦里的我站在旷野，天上是一轮红色的月亮。"
                                },
                                {
                                    "id": "690960417",
                                    "speaker": "阿蕾奇诺",
                                    "text": "月亮缓缓地转动，我凝望着它，它也注视着我。"
                                },
                                {
                                    "id": "690960418",
                                    "speaker": "阿蕾奇诺",
                                    "text": "很难形容被它盯上的感觉。它的目光充满死气与悲切…或许还有惊恐和怜悯？时间过去太久，我的记忆也模糊了。",
                                    "choices": [
                                        {
                                            "id": "690960419",
                                            "text": "那真的是梦吗？",
                                            "response": [
                                                {
                                                    "id": "690960421",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "我也想知道答案，不过真相不会主动找上门。"
                                                },
                                                {
                                                    "id": "690960422",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "也许有一天我会再见到梦里的景象，也许永远都不会。就像我们有可能拔刀相向，也可能一直保持和平。"
                                                },
                                                {
                                                    "id": "690960423",
                                                    "speaker": "阿蕾奇诺",
                                                    "text": "未来的迷人之处就在于它的不确定性。至少现在，放下烦恼，一同享受这和煦的风吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690960420",
                                            "text": "那真的是月亮吗？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909605",
            "initDialog": "690960501",
            "dialogues": [
                {
                    "id": "690960501",
                    "speaker": "Player",
                    "text": "早啊，阿蕾奇诺。"
                },
                {
                    "id": "690960502",
                    "speaker": "阿蕾奇诺",
                    "text": "早。昨晚休息前，我注意到有些角落很久没有清理过。"
                },
                {
                    "id": "690960503",
                    "speaker": "阿蕾奇诺",
                    "text": "等你有时间，尽早打扫吧。"
                }
            ]
        },
        {
            "talkId": "6909606",
            "initDialog": "690960601",
            "dialogues": [
                {
                    "id": "690960601",
                    "speaker": "Player",
                    "text": "晚安，阿蕾奇诺。"
                },
                {
                    "id": "690960602",
                    "speaker": "阿蕾奇诺",
                    "text": "嗯，我也正准备休息。"
                },
                {
                    "id": "690960603",
                    "speaker": "阿蕾奇诺",
                    "text": "疲惫时早点入睡，才能在醒来后做更多事情。"
                }
            ]
        },
        {
            "talkId": "6909607",
            "initDialog": "690960701",
            "dialogues": [
                {
                    "id": "690960701",
                    "speaker": "阿蕾奇诺",
                    "text": "很多人对我的看法是独来独往、充满神秘。"
                },
                {
                    "id": "690960702",
                    "speaker": "阿蕾奇诺",
                    "text": "其实我并不介意出现在人多的地方。观察人群同样是一件有趣的事情。"
                },
                {
                    "id": "690960703",
                    "speaker": "阿蕾奇诺",
                    "text": "当然，他们是否愿意见到我…就是另一回事了。"
                }
            ]
        },
        {
            "talkId": "6909608",
            "initDialog": "690960801",
            "dialogues": [
                {
                    "id": "690960801",
                    "speaker": "阿蕾奇诺",
                    "text": "如果将世界比作舞台，每个人都要找好自己的位置。"
                },
                {
                    "id": "690960802",
                    "speaker": "阿蕾奇诺",
                    "text": "我更适合坐在观众席上，你呢？"
                },
                {
                    "id": "690960803",
                    "speaker": "阿蕾奇诺",
                    "text": "愿意坐在我的身旁，还是去登台亮相？"
                }
            ]
        }
    ]
}