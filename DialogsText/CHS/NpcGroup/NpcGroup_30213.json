    "talks": [
        {
            "talkId": "7350051",
            "initDialog": "735005101",
            "dialogues": [
                {
                    "id": "735005101",
                    "speaker": "法伊兹",
                    "text": "丹吉尔先生几乎去哪里都会带着他家儿子，两个人感情非常好。"
                },
                {
                    "id": "735005102",
                    "speaker": "法伊兹",
                    "text": "可能这就是他能写出那么好的童话的原因吧。"
                },
                {
                    "id": "735005103",
                    "speaker": "法伊兹",
                    "text": "总之，拜托你们了，一定要找到丹吉尔先生。"
                }
            ]
        },
        {
            "talkId": "7350058",
            "initDialog": "735005801",
            "dialogues": [
                {
                    "id": "735005801",
                    "speaker": "法伊兹",
                    "text": "谢谢你们，之前说好的报酬也都准备好了。以后也请多多惠顾阿折罗造像，我们会为二位提供最大力度的折扣。"
                }
            ]
        },
        {
            "talkId": "7350111",
            "initDialog": "735011101",
            "dialogues": [
                {
                    "id": "735011101",
                    "speaker": "法伊兹",
                    "text": "如果你们决定要收下「试作兰那罗」的话，就和我说一声，我们会尽快把它从仓库里搬过来的。",
                    "choices": [
                        {
                            "id": "735011102",
                            "text": "想看看其他木刻…"
                        },
                        {
                            "id": "735011103",
                            "text": "再见。"
                        }
                    ]
                }
            ]
        }
    ]
}