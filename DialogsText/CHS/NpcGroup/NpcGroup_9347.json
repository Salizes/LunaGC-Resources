{
    "groupId": "9347",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "夜兰": 9
    },
    "talks": [
        {
            "talkId": "6934701",
            "initDialog": "693470101",
            "dialogues": [
                {
                    "id": "693470101",
                    "speaker": "夜兰",
                    "text": "安全屋。我不太喜欢由别人为我准备此类设施，但聊胜于无。"
                },
                {
                    "id": "693470102",
                    "speaker": "夜兰",
                    "text": "就算我很想一次完工，把你托我的探索工作全部干完…但这里的规则和我的体能好像都不允许呢。"
                },
                {
                    "id": "693470103",
                    "speaker": "夜兰",
                    "text": "你也适当保留点精力吧，累着不值。"
                }
            ]
        },
        {
            "talkId": "6934702",
            "initDialog": "693470201",
            "dialogues": [
                {
                    "id": "693470201",
                    "speaker": "夜兰",
                    "text": "接下来还有好几场恶战吧？你做好准备了吗？"
                },
                {
                    "id": "693470202",
                    "speaker": "夜兰",
                    "text": "对我来说，要是日子过得太平淡，时间长了就会麻木。找些刺激的事来做，反倒能更清醒一点。"
                },
                {
                    "id": "693470203",
                    "speaker": "夜兰",
                    "text": "不如我来抛个骰子？如果是我满意的点数，我们就接着挑战下去…当成消遣也不错。"
                }
            ]
        },
        {
            "talkId": "6934703",
            "initDialog": "693470301",
            "dialogues": [
                {
                    "id": "693470301",
                    "speaker": "夜兰",
                    "text": "有些真人真事比故事更为精彩，只可惜不能写进书里。"
                },
                {
                    "id": "693470302",
                    "speaker": "夜兰",
                    "text": "好奇？如果我告诉你…这是连「说都不能说」的呢？"
                },
                {
                    "id": "693470303",
                    "speaker": "夜兰",
                    "text": "呵呵…那我挑一点与机密无关的吧，不过想听的话，我们得换个场合。"
                }
            ]
        }
    ]
}