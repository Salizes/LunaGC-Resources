{
    "groupId": "3172",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "村上": 12
    },
    "talks": [
        {
            "talkId": "6317201",
            "initDialog": "631720101",
            "dialogues": [
                {
                    "id": "631720101",
                    "speaker": "村上",
                    "text": "客人好啊，本摊专供祭典小吃，要来一份尝尝吗？"
                }
            ]
        },
        {
            "talkId": "6317202",
            "initDialog": "631720201",
            "dialogues": [
                {
                    "id": "631720201",
                    "speaker": "Player",
                    "text": "祭典的小吃…"
                },
                {
                    "id": "631720202",
                    "speaker": "村上",
                    "text": "哈哈…说是祭典的小吃，其实和稻妻常见的料理没太大差别，顶多包装变一变。"
                },
                {
                    "id": "631720203",
                    "speaker": "村上",
                    "text": "不过，吃上去都是一样的美味哦！而且在祭典的氛围中吃到的东西，总觉得和平常相比别有一番风味，对不对。"
                },
                {
                    "id": "631720204",
                    "speaker": "村上",
                    "text": "总之我家摊位全年无休，无论有无活动都在这里恭候大驾，肚饿的时候欢迎过来饱餐一顿哦。"
                }
            ]
        },
        {
            "talkId": "6317203",
            "initDialog": "631720301",
            "dialogues": [
                {
                    "id": "631720301",
                    "speaker": "Player",
                    "text": "好久不见！"
                },
                {
                    "id": "631720302",
                    "speaker": "村上",
                    "text": "哦哦，这不是神里小姐的好朋友嘛，欢迎欢迎！"
                },
                {
                    "id": "631720303",
                    "speaker": "村上",
                    "text": "自从上次你带神里小姐光临本摊后，慕名来吃「绯樱饼」和「鸟蛋烧」人变多了不少，多谢啦！"
                },
                {
                    "id": "631720304",
                    "speaker": "村上",
                    "text": "下次你和神里小姐再来的话，我会再好好招待你们的，嘿嘿。"
                },
                {
                    "id": "631720305",
                    "speaker": "村上",
                    "text": "话说回来，「绯樱饼」的菜谱客人学得如何了？"
                }
            ]
        },
        {
            "talkId": "6317204",
            "initDialog": "631720401",
            "dialogues": [
                {
                    "id": "631720401",
                    "speaker": "Player",
                    "text": "我学得可快了。"
                },
                {
                    "id": "631720402",
                    "speaker": "村上",
                    "text": "不错，很有自信嘛！"
                },
                {
                    "id": "631720403",
                    "speaker": "村上",
                    "text": "我本想说，关于菜谱有什么疑问的话都可以来找我，现在看来是我瞎操心了，哈哈！"
                },
                {
                    "id": "631720404",
                    "speaker": "村上",
                    "text": "如果大家都可以享用到自己的手作美食，那一定都能获得幸福吧。"
                }
            ]
        },
        {
            "talkId": "6317205",
            "initDialog": "631720501",
            "dialogues": [
                {
                    "id": "631720501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631720502",
                    "speaker": "村上",
                    "text": "慢走，想吃东西再来啊！"
                }
            ]
        }
    ]
}