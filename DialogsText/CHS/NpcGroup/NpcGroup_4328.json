{
    "groupId": "4328",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "阿莲佐": 9
    },
    "talks": [
        {
            "talkId": "6432801",
            "initDialog": "643280101",
            "dialogues": [
                {
                    "id": "643280101",
                    "speaker": "阿莲佐",
                    "text": "是以前没见过的生面孔呀…是来这里的新游客吗？"
                }
            ]
        },
        {
            "talkId": "6432802",
            "initDialog": "643280201",
            "dialogues": [
                {
                    "id": "643280201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "643280202",
                    "speaker": "阿莲佐",
                    "text": "我呀，我的名字叫阿莲佐，是一名…前教令院学者。"
                },
                {
                    "id": "643280203",
                    "speaker": "阿莲佐",
                    "text": "我和我的弟弟胡塞尼都考上了教令院，只不过呢，我实在是没法适应那样的生活…"
                },
                {
                    "id": "643280204",
                    "speaker": "阿莲佐",
                    "text": "我弟弟看上去倒是乐在其中，那就随他去吧。"
                },
                {
                    "id": "643280205",
                    "speaker": "阿莲佐",
                    "text": "总之，我放弃了学者生涯，回到故乡——也就是这里，过上了没有论文和报告会议的舒适生活啦！"
                }
            ]
        },
        {
            "talkId": "6432803",
            "initDialog": "643280301",
            "dialogues": [
                {
                    "id": "643280301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643280302",
                    "speaker": "阿莲佐",
                    "text": "好哦，希望你在这里玩得愉快！"
                }
            ]
        },
        {
            "talkId": "7395101",
            "initDialog": "739510101",
            "dialogues": [
                {
                    "id": "739510101",
                    "speaker": "Player",
                    "text": "说实话，有点羡慕。"
                },
                {
                    "id": "739510102",
                    "speaker": "阿莲佐",
                    "text": "光嘴上说羡慕是不会获得幸福的哦。如果有期待，就要付诸行动。"
                },
                {
                    "id": "739510103",
                    "speaker": "阿莲佐",
                    "text": "不过看你步履匆匆的样子，应该还有要做的事情吧？"
                },
                {
                    "id": "739510104",
                    "speaker": "阿莲佐",
                    "text": "没关系，天有阴晴，花有开合。等做完那些必须完成的事情，再给自己放个假也不迟。"
                }
            ]
        }
    ]
}