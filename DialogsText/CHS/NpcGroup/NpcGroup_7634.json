{
    "groupId": "7634",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "莱沃蒂": 8
    },
    "talks": [
        {
            "talkId": "6763401",
            "initDialog": "676340101",
            "dialogues": [
                {
                    "id": "676340101",
                    "speaker": "莱沃蒂",
                    "text": "唉，每天都是一样的工作，什么时候才能轮到我上战场…"
                }
            ]
        },
        {
            "talkId": "6763402",
            "initDialog": "676340201",
            "dialogues": [
                {
                    "id": "676340201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "676340202",
                    "speaker": "莱沃蒂",
                    "text": "如你所见，在站岗。"
                },
                {
                    "id": "676340203",
                    "speaker": "莱沃蒂",
                    "text": "马鲁什金军士长叫我检查进出人员的身份…有什么用呢？狂猎难道会伪装成普通人的模样，老老实实接受检查，再混进这里吗？"
                }
            ]
        },
        {
            "talkId": "6763403",
            "initDialog": "676340301",
            "dialogues": [
                {
                    "id": "676340301",
                    "speaker": "Player",
                    "text": "不打扰了，再见。"
                },
                {
                    "id": "676340302",
                    "speaker": "莱沃蒂",
                    "text": "再见…唉。"
                }
            ]
        },
        {
            "talkId": "6763404",
            "initDialog": "676340401",
            "dialogues": [
                {
                    "id": "676340401",
                    "speaker": "Player",
                    "text": "你似乎有些不满？"
                },
                {
                    "id": "676340402",
                    "speaker": "莱沃蒂",
                    "text": "作为执灯士，我尊重马鲁什金军士长的一切决定。对于兵士来说，服从军令是基本中的基本。"
                },
                {
                    "id": "676340403",
                    "speaker": "莱沃蒂",
                    "text": "我只是觉得…我通过了那样严酷的选拔与考核，不是来做门卫的。"
                },
                {
                    "id": "676340404",
                    "speaker": "莱沃蒂",
                    "text": "马鲁什金军士长还说什么「多看看其他人是怎么战斗的，不切实际的英雄幻想只会让你白白送命」…那又如何呢？"
                },
                {
                    "id": "676340405",
                    "speaker": "莱沃蒂",
                    "text": "真正的英雄就该像西格德前辈那样，浴血而战、至死方休，成为众人仰慕的传说，而不是每天傻站在这里，看其他人立功凯旋。"
                }
            ]
        }
    ]
}