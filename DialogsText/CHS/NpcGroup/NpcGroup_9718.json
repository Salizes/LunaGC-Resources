{
    "groupId": "9718",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "Player": 2,
        "马齐尔": 5
    },
    "talks": [
        {
            "talkId": "6971801",
            "initDialog": "697180101",
            "dialogues": [
                {
                    "id": "697180101",
                    "speaker": "马齐尔",
                    "text": "这酒馆还真热闹，要是旅馆里也开设一个专门打牌的活动室，生意肯定会更好…"
                },
                {
                    "id": "697180102",
                    "speaker": "马齐尔",
                    "text": "哦！抱歉，我光想着怎么把「七圣召唤」和工作结合了，没注意到你！要来玩一局吗？"
                }
            ]
        },
        {
            "talkId": "6971802",
            "initDialog": "697180201",
            "dialogues": [
                {
                    "id": "697180201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6971803",
            "initDialog": "697180301",
            "dialogues": [
                {
                    "id": "697180301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697180302",
                    "speaker": "马齐尔",
                    "text": "那你先忙！有机会再来打牌啊！"
                }
            ]
        },
        {
            "talkId": "6971804",
            "initDialog": "697180401",
            "dialogues": [
                {
                    "id": "697180401",
                    "speaker": "马齐尔",
                    "text": "你是不是还留了一手？下次不用给我留情面！我是来学习经验的！"
                }
            ]
        },
        {
            "talkId": "6971805",
            "initDialog": "697180501",
            "dialogues": [
                {
                    "id": "697180501",
                    "speaker": "马齐尔",
                    "text": "原来如此！我从你的牌路里学到了许多…感谢指导！"
                }
            ]
        }
    ]
}