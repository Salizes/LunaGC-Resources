{
    "groupId": "2451",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "阿笨": 9
    },
    "talks": [
        {
            "talkId": "6245101",
            "initDialog": "624510101",
            "dialogues": [
                {
                    "id": "624510101",
                    "speaker": "阿笨",
                    "text": "哦？客官，稀客稀客。"
                }
            ]
        },
        {
            "talkId": "6245102",
            "initDialog": "624510201",
            "dialogues": [
                {
                    "id": "624510201",
                    "speaker": "Player",
                    "text": "怎么就是稀客了？"
                },
                {
                    "id": "624510202",
                    "speaker": "阿笨",
                    "text": "毕竟这附近就没几个客人嘛，荒郊野岭的。"
                },
                {
                    "id": "624510203",
                    "speaker": "阿笨",
                    "text": "您倒是不怕我们这儿是黑店…"
                },
                {
                    "id": "624510204",
                    "speaker": "阿笨",
                    "text": "哈哈哈…玩笑玩笑，可别跟我老板说我又吓唬客人了。"
                }
            ]
        },
        {
            "talkId": "6245103",
            "initDialog": "624510301",
            "dialogues": [
                {
                    "id": "624510301",
                    "speaker": "Player",
                    "text": "说说你自己？"
                },
                {
                    "id": "624510302",
                    "speaker": "阿笨",
                    "text": "我嘛…曾经的我名声倒是不怎么好，喜欢混迹街头，打打闹闹。"
                },
                {
                    "id": "624510303",
                    "speaker": "阿笨",
                    "text": "后来盯上这位朱老板，一看就是个财主，所以来这边领领工钱混日子。"
                },
                {
                    "id": "624510304",
                    "speaker": "阿笨",
                    "text": "不过这日子居然比我想象的还要清闲，久而久之，忽然觉得没有之前那种心劲儿了。"
                },
                {
                    "id": "624510305",
                    "speaker": "阿笨",
                    "text": "现在，我只想找个姑娘结婚安定下来…也不知道是年岁大了，还是这平淡的日子把我给改变了…"
                }
            ]
        },
        {
            "talkId": "6245104",
            "initDialog": "624510401",
            "dialogues": [
                {
                    "id": "624510401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624510402",
                    "speaker": "阿笨",
                    "text": "嗯，祝您一路顺风。"
                }
            ]
        }
    ]
}