{
    "groupId": "2452",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "阿直": 8
    },
    "talks": [
        {
            "talkId": "6245201",
            "initDialog": "624520101",
            "dialogues": [
                {
                    "id": "624520101",
                    "speaker": "阿直",
                    "text": "啊，你好，请问找我有什么事…"
                },
                {
                    "id": "624520102",
                    "speaker": "阿直",
                    "text": "哦不对，现在是工作时间…不好意思，请问客人有什么需要？"
                }
            ]
        },
        {
            "talkId": "6245202",
            "initDialog": "624520201",
            "dialogues": [
                {
                    "id": "624520201",
                    "speaker": "Player",
                    "text": "你在想什么？"
                },
                {
                    "id": "624520202",
                    "speaker": "阿直",
                    "text": "只是有点发呆而已，谢谢客人关心。"
                },
                {
                    "id": "624520203",
                    "speaker": "阿直",
                    "text": "其实我做这份工作，还有一个另外的目的…就是很向往书里那种，浪漫的、偶然的邂逅。"
                },
                {
                    "id": "624520204",
                    "speaker": "阿直",
                    "text": "平平无奇的女侍忽然被英俊的坏小子拐走，到碧水河畔私定终身什么的…唔…"
                },
                {
                    "id": "624520205",
                    "speaker": "阿直",
                    "text": "究竟是这家店生意太差，还是我的运气不好呢…感觉那种故事始终与我无缘啊。"
                },
                {
                    "id": "624520206",
                    "speaker": "阿直",
                    "text": "唉…我在想不然还是放弃吧，找个熟悉的人结婚安定下来之类的…这么等下去也不是办法。"
                }
            ]
        },
        {
            "talkId": "6245203",
            "initDialog": "624520301",
            "dialogues": [
                {
                    "id": "624520301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624520302",
                    "speaker": "阿直",
                    "text": "啊，好的，有什么需要请再和我讲。"
                }
            ]
        }
    ]
}