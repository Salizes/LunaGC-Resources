            "dialogues": [
                {
                    "id": "590019801",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900199",
            "initDialog": "590019901",
            "dialogues": [
                {
                    "id": "590019901",
                    "speaker": "亚格贝乌",
                    "text": "没什么特别的…意思是，环境很安全。"
                }
            ]
        },
        {
            "talkId": "6601701",
            "initDialog": "660170101",
            "dialogues": [
                {
                    "id": "660170101",
                    "speaker": "亚格贝乌",
                    "text": "你好。"
                }
            ]
        },
        {
            "talkId": "6601702",
            "initDialog": "660170201",
            "dialogues": [
                {
                    "id": "660170201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "660170202",
                    "speaker": "亚格贝乌",
                    "text": "哦…"
                },
                {
                    "id": "660170203",
                    "speaker": "亚格贝乌",
                    "text": "一般来讲，不太会有人向独自一人的「花羽会」搭话。"
                }
            ]
        },
        {
            "talkId": "6601703",
            "initDialog": "660170301",
            "dialogues": [
                {
                    "id": "660170301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "660170302",
                    "speaker": "亚格贝乌",
                    "text": "哦。"
                }
            ]
        },
        {
            "talkId": "6601704",
            "initDialog": "660170401",
            "dialogues": [
                {
                    "id": "660170401",
                    "speaker": "Player",
                    "text": "会发生不好的事情吗？"
                },
                {
                    "id": "660170402",
                    "speaker": "亚格贝乌",
                    "text": "不会。"
                },
                {
                    "id": "660170403",
                    "speaker": "亚格贝乌",
                    "text": "只要你没听到我的哨声，那就说明周围一切如常。"
                },
                {
                    "id": "660170404",
                    "speaker": "亚格贝乌",
                    "text": "安心去做你该做的事情就好。"
                }
            ]
        }
    ]
