{
    "groupId": "6134",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "奥尔科": 7
    },
    "talks": [
        {
            "talkId": "7502116",
            "initDialog": "750211601",
            "dialogues": [
                {
                    "id": "750211601",
                    "speaker": "奥尔科",
                    "text": "…去更远一点的地方好了！"
                }
            ]
        },
        {
            "talkId": "7502120",
            "initDialog": "750212001",
            "dialogues": [
                {
                    "id": "750212001",
                    "speaker": "Player",
                    "text": "你的隐藏力量怎么样了？"
                },
                {
                    "id": "750212002",
                    "speaker": "奥尔科",
                    "text": "嗯…还是隐藏的状态，有时我想，它可真沉得住气呀。不过没关系，我有一个长长的清单，上面还有好多没去过的地方。"
                },
                {
                    "id": "750212003",
                    "speaker": "奥尔科",
                    "text": "所以应该还有很多让它觉醒的机会吧？最近也听说了一些别的咒语、说法之类，也想都试试看呢。"
                }
            ]
        },
        {
            "talkId": "7502121",
            "initDialog": "750212101",
            "dialogues": [
                {
                    "id": "750212101",
                    "speaker": "Player",
                    "text": "别让家人太担心了。"
                },
                {
                    "id": "750212102",
                    "speaker": "奥尔科",
                    "text": "知道啦，下次会跟爸爸说明之后再出发的。唔…这个给你！听别人说，这样做可以给下一次旅行带来好运。你就收下吧！"
                }
            ]
        },
        {
            "talkId": "7502122",
            "initDialog": "750212201",
            "dialogues": [
                {
                    "id": "750212201",
                    "speaker": "Player",
                    "text": "关于奎伊露的故事…"
                },
                {
                    "id": "750212202",
                    "speaker": "奥尔科",
                    "text": "现在我知道了，原来那是「烟谜主」流传的故事，爸爸也不是因为受到太阳的惩罚才看不见的…"
                },
                {
                    "id": "750212203",
                    "speaker": "奥尔科",
                    "text": "不过，如果妈妈不是回到星星上去了，那她究竟去哪里了呢？"
                }
            ]
        },
        {
            "talkId": "7502124",
            "initDialog": "750212401",
            "dialogues": [
                {
                    "id": "750212401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "750212402",
                    "speaker": "奥尔科",
                    "text": "再见！"
                }
            ]
        }
    ]
}