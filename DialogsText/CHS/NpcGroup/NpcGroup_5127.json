{
    "groupId": "5127",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "穆纳切洛": 9
    },
    "talks": [
        {
            "talkId": "6512701",
            "initDialog": "651270101",
            "dialogues": [
                {
                    "id": "651270101",
                    "speaker": "穆纳切洛",
                    "text": "嗯，我就是「搬运工」穆纳切洛，规矩你都知道吧？"
                }
            ]
        },
        {
            "talkId": "6512702",
            "initDialog": "651270201",
            "dialogues": [
                {
                    "id": "651270201",
                    "speaker": "Player",
                    "text": "什么规矩？"
                },
                {
                    "id": "651270202",
                    "speaker": "穆纳切洛",
                    "text": "呵呵，是条嫩鱼。"
                },
                {
                    "id": "651270203",
                    "speaker": "穆纳切洛",
                    "text": "没关系，别害怕，「搬运工」穆纳切洛不会欺客。"
                },
                {
                    "id": "651270204",
                    "speaker": "穆纳切洛",
                    "text": "你有问题，我有答案，拿你知道的和我知道的等价交换。"
                },
                {
                    "id": "651270205",
                    "speaker": "穆纳切洛",
                    "text": "这就是「搬运工」穆纳切洛的规矩。"
                }
            ]
        },
        {
            "talkId": "6512703",
            "initDialog": "651270301",
            "dialogues": [
                {
                    "id": "651270301",
                    "speaker": "Player",
                    "text": "「搬运工」？"
                },
                {
                    "id": "651270302",
                    "speaker": "穆纳切洛",
                    "text": "把消息从一些地方搬运到另一些地方，就和码头上搬货的水手一样，这就是我在干的生意。"
                },
                {
                    "id": "651270303",
                    "speaker": "穆纳切洛",
                    "text": "情报就像期货，没底钱是赚不了的。"
                },
                {
                    "id": "651270304",
                    "speaker": "穆纳切洛",
                    "text": "而我手上的底钱够多，「搬运工」穆纳切洛永远不会没货可运。"
                }
            ]
        },
        {
            "talkId": "6512704",
            "initDialog": "651270401",
            "dialogues": [
                {
                    "id": "651270401",
                    "speaker": "Player",
                    "text": "没、没事了。"
                },
                {
                    "id": "651270402",
                    "speaker": "穆纳切洛",
                    "text": "想好了之后可以再来找我，如果你能活到那个时候的话。"
                }
            ]
        }
    ]
}