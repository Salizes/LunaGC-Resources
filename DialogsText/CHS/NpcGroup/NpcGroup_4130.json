{
    "groupId": "4130",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "布特罗斯": 15
    },
    "talks": [
        {
            "talkId": "6413001",
            "initDialog": "641300101",
            "dialogues": [
                {
                    "id": "641300101",
                    "speaker": "布特罗斯",
                    "text": "我的鱼，肉质好，小猫吃了喵喵叫！"
                }
            ]
        },
        {
            "talkId": "6413002",
            "initDialog": "641300201",
            "dialogues": [
                {
                    "id": "641300201",
                    "speaker": "Player",
                    "text": "来点鱼。"
                },
                {
                    "id": "641300202",
                    "speaker": "布特罗斯",
                    "text": "随便挑，个顶个的新鲜！"
                }
            ]
        },
        {
            "talkId": "6413003",
            "initDialog": "641300301",
            "dialogues": [
                {
                    "id": "641300301",
                    "speaker": "Player",
                    "text": "你的鱼…"
                },
                {
                    "id": "641300302",
                    "speaker": "布特罗斯",
                    "text": "当天捕捞，当天售卖，足斤足两，绝无虚言。"
                },
                {
                    "id": "641300303",
                    "speaker": "布特罗斯",
                    "text": "你瞧瞧这鱼，这虾，又肥又新鲜，按下去都能弹回来，再把我顶进海里去。"
                },
                {
                    "id": "641300304",
                    "speaker": "布特罗斯",
                    "text": "要是教令院开设捕鱼学院，我一定能拿全额奖学金。要是鱼的新鲜度能得分，我的鱼就能包揽所有学位证书。"
                }
            ]
        },
        {
            "talkId": "6413004",
            "initDialog": "641300401",
            "dialogues": [
                {
                    "id": "641300401",
                    "speaker": "Player",
                    "text": "你的猫…"
                },
                {
                    "id": "641300402",
                    "speaker": "布特罗斯",
                    "text": "呃，它们算是我的猫吗？…大概不算吧。"
                },
                {
                    "id": "641300403",
                    "speaker": "布特罗斯",
                    "text": "我也不知道这猫们都是从哪来的，自从我喂了第一只后，就陆陆续续来了好多，拖家带口地在我这蹭吃蹭喝。"
                },
                {
                    "id": "641300404",
                    "speaker": "布特罗斯",
                    "text": "我也没办法，谁让小猫实在太可爱了，给它们喂鱼的手就是停不下来啊！"
                },
                {
                    "id": "641300405",
                    "speaker": "布特罗斯",
                    "text": "甚至还有从旅馆老板家跑来不走了的猫咪。喏，就是边上那两只。"
                },
                {
                    "id": "641300406",
                    "speaker": "布特罗斯",
                    "text": "但怎么说呢，也不怪它们吧。听说那个老板老糊涂了，整天絮絮叨叨的，小猫听了也烦死了。"
                }
            ]
        },
        {
            "talkId": "6413005",
            "initDialog": "641300501",
            "dialogues": [
                {
                    "id": "641300501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641300502",
                    "speaker": "布特罗斯",
                    "text": "再见，欢迎再来！"
                }
            ]
        },
        {
            "talkId": "7391101",
            "initDialog": "739110101",
            "dialogues": [
                {
                    "id": "739110101",
                    "speaker": "Player",
                    "text": "太夸张了。"
                },
                {
                    "id": "739110102",
                    "speaker": "布特罗斯",
                    "text": "夸张？不不不！"
                },
                {
                    "id": "739110103",
                    "speaker": "布特罗斯",
                    "text": "我一直在这卖鱼，要是过分自夸，被附近的客人嫌弃，可能早就没生意了。"
                },
                {
                    "id": "739110104",
                    "speaker": "布特罗斯",
                    "text": "空口无凭，送你一些，权当试吃！"
                },
                {
                    "id": "739110105",
                    "speaker": "布特罗斯",
                    "text": "你要是觉得好，今后就请多多照顾我的生意吧。"
                }
            ]
        }
    ]
}