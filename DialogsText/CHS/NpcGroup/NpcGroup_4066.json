            "dialogues": [
                {
                    "id": "640660101",
                    "speaker": "鲁克沙",
                    "text": "你好。"
                }
            ]
        },
        {
            "talkId": "6406602",
            "initDialog": "640660201",
            "dialogues": [
                {
                    "id": "640660201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640660202",
                    "speaker": "鲁克沙",
                    "text": "我是「三十人团」的现任掌旗官，负责统管须弥城内的镀金旅团。"
                }
            ]
        },
        {
            "talkId": "6406603",
            "initDialog": "640660301",
            "dialogues": [
                {
                    "id": "640660301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640660302",
                    "speaker": "鲁克沙",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6406604",
            "initDialog": "640660401",
            "dialogues": [
                {
                    "id": "640660401",
                    "speaker": "Player",
                    "text": "关于「三十人团」…"
                },
                {
                    "id": "640660402",
                    "speaker": "鲁克沙",
                    "text": "「三十人团」大概是须弥最古老的镀金旅团之一，因成立初期由三十个人组成而得名。"
                },
                {
                    "id": "640660403",
                    "speaker": "鲁克沙",
                    "text": "目前「三十人团」主要负责须弥城的防务工作，大部分任务都由教令院下达，此外也会承接居民们的委托。"
                },
                {
                    "id": "640660404",
                    "speaker": "鲁克沙",
                    "text": "不同于其他镀金旅团，「三十人团」的成员会佩戴绿色的围巾。在城内，你可以放心向我们寻求帮助。"
                },
                {
                    "id": "640660405",
                    "speaker": "鲁克沙",
                    "text": "但出了城，哪怕在奥摩斯港，也要留心其他镀金旅团的人。他们可能并非善类。"
                }
            ]
        }
    ]
}