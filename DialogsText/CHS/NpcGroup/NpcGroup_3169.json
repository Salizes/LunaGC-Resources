{
    "groupId": "3169",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "篠冢": 14
    },
    "talks": [
        {
            "talkId": "6316901",
            "initDialog": "631690101",
            "dialogues": [
                {
                    "id": "631690101",
                    "speaker": "篠冢",
                    "text": "啊！你是谁，怎么会出现在这里？"
                },
                {
                    "id": "631690102",
                    "speaker": "篠冢",
                    "text": "呜…抱歉，这附近总感觉有些恐怖，难道是我多心了吗…"
                }
            ]
        },
        {
            "talkId": "6316902",
            "initDialog": "631690201",
            "dialogues": [
                {
                    "id": "631690201",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "631690202",
                    "speaker": "篠冢",
                    "text": "我是专门写恐怖小说的作家，最近正在创作的瓶颈期，一直为写不出稿子而发愁。"
                },
                {
                    "id": "631690203",
                    "speaker": "篠冢",
                    "text": "听说这里的废弃神社有幽灵出没的传闻，所以准备来探险取材。"
                },
                {
                    "id": "631690204",
                    "speaker": "篠冢",
                    "text": "结果过来之后发现，这里氛围真的很不妙啊，感觉温度都比别的地方低了不少…"
                },
                {
                    "id": "631690205",
                    "speaker": "篠冢",
                    "text": "怎么办，到底要不要进神社里看看呢…我、我得壮壮胆子才行，再给我点心理准备的时间…"
                }
            ]
        },
        {
            "talkId": "6316903",
            "initDialog": "631690301",
            "dialogues": [
                {
                    "id": "631690301",
                    "speaker": "Player",
                    "text": "大丘丘病了，二丘丘瞧…"
                },
                {
                    "id": "631690302",
                    "speaker": "篠冢",
                    "text": "呜哇，好阴森的歌，请…请不要再唱了！"
                },
                {
                    "id": "631690303",
                    "speaker": "篠冢",
                    "text": "你、你应该是活人吧？看起来并不是半透明的…"
                },
                {
                    "id": "631690304",
                    "speaker": "篠冢",
                    "text": "但，如果是出现在这里的话，说不定…呜呜，感觉更可怕了…"
                },
                {
                    "id": "631690305",
                    "speaker": "篠冢",
                    "text": "我只是个来这边取材的恐怖小说作者而已，无意冒犯…无意冒犯啊！"
                }
            ]
        },
        {
            "talkId": "6316904",
            "initDialog": "631690401",
            "dialogues": [
                {
                    "id": "631690401",
                    "speaker": "Player",
                    "text": "抱歉…你要注意安全。"
                },
                {
                    "id": "631690402",
                    "speaker": "篠冢",
                    "text": "什么嘛，原来不是鬼怪啊，太好了…谢谢你的提醒，但是可别再吓我了。"
                },
                {
                    "id": "631690403",
                    "speaker": "篠冢",
                    "text": "…不过等等，你刚刚唱的歌，可以再唱一遍吗？"
                },
                {
                    "id": "631690404",
                    "speaker": "篠冢",
                    "text": "听上去很有恐怖的氛围，也教教我吧。赶稿的时候哼一哼，没准能灵感爆发呢。"
                }
            ]
        },
        {
            "talkId": "6316905",
            "initDialog": "631690501",
            "dialogues": [
                {
                    "id": "631690501",
                    "speaker": "Player",
                    "text": "再见，要小心哦。"
                },
                {
                    "id": "631690502",
                    "speaker": "篠冢",
                    "text": "嗯…我再想想究竟要不要进神社…"
                }
            ]
        }
    ]
}