{
    "groupId": "6077",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "海岳": 6
    },
    "talks": [
        {
            "talkId": "6607701",
            "initDialog": "660770101",
            "dialogues": [
                {
                    "id": "660770101",
                    "speaker": "海岳",
                    "text": "这边风景很不错吧？除了空气有些潮湿，基本没什么缺点了。"
                }
            ]
        },
        {
            "talkId": "6607702",
            "initDialog": "660770201",
            "dialogues": [
                {
                    "id": "660770201",
                    "speaker": "Player",
                    "text": "来旅游的吗？"
                },
                {
                    "id": "660770202",
                    "speaker": "海岳",
                    "text": "确切来讲是来工作的，不过已经完成了。"
                },
                {
                    "id": "660770203",
                    "speaker": "海岳",
                    "text": "虽说我是个四处漂荡的水手，永远准备着去拥抱新的冒险，但总有几个地方割舍不下。"
                },
                {
                    "id": "660770204",
                    "speaker": "海岳",
                    "text": "除了家乡以外，这片海域是我最喜欢来的地方了，生活悠闲，当地居民也随和友善。"
                },
                {
                    "id": "660770205",
                    "speaker": "海岳",
                    "text": "我来过一次之后就在「黄金傍晚」办了一张会员卡呢。有时帮老板娘修修载具搬搬货物，还能享受更多折扣。"
                }
            ]
        },
        {
            "talkId": "6607703",
            "initDialog": "660770301",
            "dialogues": [
                {
                    "id": "660770301",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "660770302",
                    "speaker": "海岳",
                    "text": "哈哈，一起享受海风吧！"
                }
            ]
        }
    ]
}