{
    "groupId": "2456",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 10,
        "步云": 29
    },
    "talks": [
        {
            "talkId": "6245609",
            "initDialog": "624560901",
            "dialogues": [
                {
                    "id": "624560901",
                    "speaker": "步云",
                    "text": "云黯天光影疏浅，但见阁中月徘徊…"
                },
                {
                    "id": "624560902",
                    "speaker": "步云",
                    "text": "请问有什么事？"
                }
            ]
        },
        {
            "talkId": "6245610",
            "initDialog": "624561001",
            "dialogues": [
                {
                    "id": "624561001",
                    "speaker": "Player",
                    "text": "你好，这里卖月亮吗？"
                },
                {
                    "id": "624561002",
                    "speaker": "步云",
                    "text": "嗯果然是您，好久不见。"
                },
                {
                    "id": "624561003",
                    "speaker": "步云",
                    "text": "我记得您是之前就得到了「玉衡特许」的贵客，又是助力过群玉阁重建的重要客人，我自然认得出。"
                },
                {
                    "id": "624561004",
                    "speaker": "步云",
                    "text": "失敬了，请由此登阁吧。"
                }
            ]
        },
        {
            "talkId": "6245611",
            "initDialog": "624561101",
            "dialogues": [
                {
                    "id": "624561101",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "624561102",
                    "speaker": "步云",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6245612",
            "initDialog": "624561201",
            "dialogues": [
                {
                    "id": "624561201",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6245613",
            "initDialog": "624561301",
            "dialogues": [
                {
                    "id": "624561301",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6245614",
            "initDialog": "624561401",
            "dialogues": [
                {
                    "id": "624561401",
                    "speaker": "步云",
                    "text": "了不起，居然轻松就被您给破了。"
                }
            ]
        },
        {
            "talkId": "6245615",
            "initDialog": "624561501",
            "dialogues": [
                {
                    "id": "624561501",
                    "speaker": "步云",
                    "text": "可别小看了引路人啊…"
                }
            ]
        },
        {
            "talkId": "6245616",
            "initDialog": "624561601",
            "dialogues": [
                {
                    "id": "624561601",
                    "speaker": "步云",
                    "text": "没想到您牌技如此高超，真是失敬。"
                }
            ]
        },
        {
            "talkId": "6245617",
            "initDialog": "624561701",
            "dialogues": [
                {
                    "id": "624561701",
                    "speaker": "步云",
                    "text": "看来这次是我略胜一筹了。"
                }
            ]
        },
        {
            "talkId": "6245601",
            "initDialog": "624560101",
            "dialogues": [
                {
                    "id": "624560101",
                    "speaker": "步云",
                    "text": "云黯天光影疏浅，但见阁中月徘徊…"
                },
                {
                    "id": "624560102",
                    "speaker": "步云",
                    "text": "请问有什么事？"
                }
            ]
        },
        {
            "talkId": "6245602",
            "initDialog": "624560201",
            "dialogues": [
                {
                    "id": "624560201",
                    "speaker": "Player",
                    "text": "你可以带我们去群玉阁吗？"
                },
                {
                    "id": "624560202",
                    "speaker": "步云",
                    "text": "闻阁不见月，恕难相逢迎。请先等待机缘吧。"
                }
            ]
        },
        {
            "talkId": "6245603",
            "initDialog": "624560301",
            "dialogues": [
                {
                    "id": "624560301",
                    "speaker": "Player",
                    "text": "你好，这里卖月亮吗？"
                },
                {
                    "id": "624560302",
                    "speaker": "步云",
                    "text": "嗯果然是您，我记得您是之前就得到了「玉衡特许」的贵客，我自然认得出。"
                },
                {
                    "id": "624560303",
                    "speaker": "步云",
                    "text": "失敬了，请由此登阁吧。"
                }
            ]
        },
        {
            "talkId": "6245604",
            "initDialog": "624560401",
            "dialogues": [
                {
                    "id": "624560401",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "624560402",
                    "speaker": "步云",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6245605",
            "initDialog": "624560501",
            "dialogues": [
                {
                    "id": "624560501",
                    "speaker": "步云",
                    "text": "明月孤云空映酒，高堂沉珂入流波…"
                },
                {
                    "id": "624560502",
                    "speaker": "步云",
                    "text": "…不知今日，贵客您是为何事而来？"
                }
            ]
        },
        {
            "talkId": "6245606",
            "initDialog": "624560601",
            "dialogues": [
                {
                    "id": "624560601",
                    "speaker": "Player",
                    "text": "「群玉阁」上的人怎么样了？"
                },
                {
                    "id": "624560602",
                    "speaker": "步云",
                    "text": "多亏仙人们慷慨相助与凝光大人的精妙筹划…"
                },
                {
                    "id": "624560603",
                    "speaker": "步云",
                    "text": "「群玉阁」上的秘书、侍女和护卫们全都平安无事，如今已经在璃月港内安顿周全。"
                },
                {
                    "id": "624560604",
                    "speaker": "步云",
                    "text": "如果您是想拜会凝光大人的话…"
                },
                {
                    "id": "624560605",
                    "speaker": "步云",
                    "text": "此时恐怕凝光大人正忙于案牍繁务，暂无闲情接待贵客。"
                }
            ]
        },
        {
            "talkId": "6245607",
            "initDialog": "624560701",
            "dialogues": [
                {
                    "id": "624560701",
                    "speaker": "Player",
                    "text": "关于「群玉阁」…"
                },
                {
                    "id": "624560702",
                    "speaker": "步云",
                    "text": "…昔日遮天掩月的「群玉阁」，如今已被云来海的重重波涛湮没了。"
                },
                {
                    "id": "624560703",
                    "speaker": "步云",
                    "text": "虽说潮起潮落，世事兴衰幻灭乃是常态，古神如此，凡人宫阙亦如此。没什么值得遗憾的。"
                },
                {
                    "id": "624560704",
                    "speaker": "步云",
                    "text": "但「群玉阁」的结局，还是不免令我等喟叹…"
                },
                {
                    "id": "624560705",
                    "speaker": "步云",
                    "text": "竟然就这样亲手牺牲了自己雕琢多年的壮美作品…"
                },
                {
                    "id": "624560706",
                    "speaker": "步云",
                    "text": "如此毫不犹豫，毫无挂念…"
                },
                {
                    "id": "624560707",
                    "speaker": "步云",
                    "text": "凝光大人的筹谋，实在是让人看不透啊…"
                }
            ]
        },
        {
            "talkId": "6245608",
            "initDialog": "624560801",
            "dialogues": [
                {
                    "id": "624560801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624560802",
                    "speaker": "步云",
                    "text": "贵客慢走。"
                }
            ]
        }
    ]
}