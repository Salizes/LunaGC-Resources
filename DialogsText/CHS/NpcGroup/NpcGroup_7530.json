{
    "groupId": "7530",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "奥维先尼科夫": 4,
        "柳比莫娃": 9,
        "派蒙": 4
    },
    "talks": [
        {
            "talkId": "6752902",
            "initDialog": "675290201",
            "dialogues": [
                {
                    "id": "675290201",
                    "speaker": "Player",
                    "text": "出什么事了吗？"
                },
                {
                    "id": "675290202",
                    "speaker": "奥维先尼科夫",
                    "text": "您瞧瞧，现在至冬堡的酒馆，都开始拿火水兑果汁喝了！"
                },
                {
                    "id": "675290203",
                    "speaker": "奥维先尼科夫",
                    "text": "这叫个什么事？早年间喝火水都是有规矩的，就得一口直接灌下去，再配上点酸黄瓜和黑麦面包，那味道才正宗。"
                },
                {
                    "id": "675290204",
                    "speaker": "奥维先尼科夫",
                    "text": "以前我家里长辈跟着老沙皇南征北战的时候，都是这么吃的！"
                },
                {
                    "id": "675290205",
                    "speaker": "奥维先尼科夫",
                    "text": "再瞧瞧现在，这算怎么回事？一个个搞得花里胡哨的，都没有当年的味道了。"
                }
            ]
        },
        {
            "talkId": "6753001",
            "initDialog": "675300101",
            "dialogues": [
                {
                    "id": "675300101",
                    "speaker": "柳比莫娃",
                    "text": "什么「严冬计划」啊，一定是又触怒了黑神…"
                }
            ]
        },
        {
            "talkId": "6753002",
            "initDialog": "675300201",
            "dialogues": [
                {
                    "id": "675300201",
                    "speaker": "Player",
                    "text": "你说的黑神是？"
                },
                {
                    "id": "675300202",
                    "speaker": "柳比莫娃",
                    "text": "现在的后生都不知道啦，那是个顶厉害顶厉害的邪祟，当年老沙皇就是受了它的诅咒才一命呜呼的…"
                },
                {
                    "id": "675300203",
                    "speaker": "柳比莫娃",
                    "text": "最近啊，这至冬堡里到处鸡犬不宁的，我看一定是那个黑神又要回来啦！"
                }
            ]
        },
        {
            "talkId": "6753003",
            "initDialog": "675300301",
            "dialogues": [
                {
                    "id": "675300301",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "675300302",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "675300303",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "675300304",
                    "speaker": "派蒙",
                    "text": ""
                }
            ]
        },
        {
            "talkId": "6753004",
            "initDialog": "675300401",
            "dialogues": [
                {
                    "id": "675300401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675300402",
                    "speaker": "柳比莫娃",
                    "text": "哎，要小心啊！"
                }
            ]
        },
        {
            "talkId": "6753005",
            "initDialog": "675300501",
            "dialogues": [
                {
                    "id": "675300501",
                    "speaker": "Player",
                    "text": "哪有这么玄乎…"
                },
                {
                    "id": "675300502",
                    "speaker": "柳比莫娃",
                    "text": "你别不相信！知道北国银行吧，你以为那只是个银行？没你想的那么简单，老沙皇在的时候就没这东西。"
                },
                {
                    "id": "675300503",
                    "speaker": "柳比莫娃",
                    "text": "就是因为那时候黑神给每一枚摩拉做了标记，女皇陛下才让人建了北国银行，所有的摩拉都得在里面过一手才干净。"
                },
                {
                    "id": "675300504",
                    "speaker": "柳比莫娃",
                    "text": "这可是女皇陛下的贴身扈从亲口告诉我的，这还能有假？"
                }
            ]
        },
        {
            "talkId": "6753006",
            "initDialog": "675300601",
            "dialogues": [
                {
                    "id": "675300601",
                    "speaker": "Player",
                    "text": "那也太可怕了！"
                },
                {
                    "id": "675300602",
                    "speaker": "柳比莫娃",
                    "text": "可不是吗，所以最近可得小心了，没事尽量就少出门。"
                },
                {
                    "id": "675300603",
                    "speaker": "柳比莫娃",
                    "text": "一定要上街的话，走路的时候也要记得每走三步就停一会，免得冲撞了什么不干净的东西！"
                }
            ]
        }
    ]
}