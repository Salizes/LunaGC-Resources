    "talks": [
        {
            "talkId": "6442901",
            "initDialog": "644290101",
            "dialogues": [
                {
                    "id": "644290101",
                    "speaker": "福阿德",
                    "text": "你好，旅行者。"
                }
            ]
        },
        {
            "talkId": "6442902",
            "initDialog": "644290201",
            "dialogues": [
                {
                    "id": "644290201",
                    "speaker": "Player",
                    "text": "你认得我？"
                },
                {
                    "id": "644290202",
                    "speaker": "福阿德",
                    "text": "看你的回答，我猜对了。"
                },
                {
                    "id": "644290203",
                    "speaker": "福阿德",
                    "text": "老大跟我们描述过你的外表，说是我们的新同伴呢。"
                },
                {
                    "id": "644290204",
                    "speaker": "福阿德",
                    "text": "因为特点鲜明，我一看你的样子，一下就认出来了。"
                },
                {
                    "id": "644290205",
                    "speaker": "福阿德",
                    "text": "既然老大都这么说了，那你就是我们的朋友了。镀金旅团欢迎你。"
                }
            ]
        },
        {
            "talkId": "6442903",
            "initDialog": "644290301",
            "dialogues": [
                {
                    "id": "644290301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644290302",
                    "speaker": "福阿德",
                    "text": "慢走不送。"
                }
            ]
        }
    ]
}