{
    "groupId": "9344",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "申鹤": 9
    },
    "talks": [
        {
            "talkId": "6934401",
            "initDialog": "693440101",
            "dialogues": [
                {
                    "id": "693440101",
                    "speaker": "申鹤",
                    "text": "遵照师父嘱托，每当我胸中气息躁动时，我应静心打坐，摈弃杂念。"
                },
                {
                    "id": "693440102",
                    "speaker": "申鹤",
                    "text": "若是丢了本心，只剩杀性，只怕会殃及身边人…"
                },
                {
                    "id": "693440103",
                    "speaker": "申鹤",
                    "text": "这是我绝不愿见到的。"
                }
            ]
        },
        {
            "talkId": "6934402",
            "initDialog": "693440201",
            "dialogues": [
                {
                    "id": "693440201",
                    "speaker": "申鹤",
                    "text": "深入秘境绝非易事。等在前方的，不是魑魅魍魉，就是凶徒恶寇。"
                },
                {
                    "id": "693440202",
                    "speaker": "申鹤",
                    "text": "但我的命途凶险，多这几场恶战，想来也并无太多差别。"
                },
                {
                    "id": "693440203",
                    "speaker": "申鹤",
                    "text": "出战时就由我开路吧。能帮到你，也算是件好事。"
                }
            ]
        },
        {
            "talkId": "6934403",
            "initDialog": "693440301",
            "dialogues": [
                {
                    "id": "693440301",
                    "speaker": "申鹤",
                    "text": "听旁人说，书中常蕴藏笔者的「感情」。"
                },
                {
                    "id": "693440302",
                    "speaker": "申鹤",
                    "text": "若我想要探究世间的种种情感，是否该多花些时间读书呢？"
                },
                {
                    "id": "693440303",
                    "speaker": "申鹤",
                    "text": "#{NICKNAME}，你有什么推荐的吗？"
                }
            ]
        }
    ]
}