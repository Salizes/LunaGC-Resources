{
    "groupId": "5218",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "莫普瓦": 7
    },
    "talks": [
        {
            "talkId": "6521801",
            "initDialog": "652180101",
            "dialogues": [
                {
                    "id": "652180101",
                    "speaker": "莫普瓦",
                    "text": "为什么明明有这么多人在干活，工作却一点也不见减少呢？"
                }
            ]
        },
        {
            "talkId": "6521802",
            "initDialog": "652180201",
            "dialogues": [
                {
                    "id": "652180201",
                    "speaker": "Player",
                    "text": "关于看守的工作…"
                },
                {
                    "id": "652180202",
                    "speaker": "莫普瓦",
                    "text": "呃，我不是对看守的工作内容有什么不满，只是希望大家都能对自己的工作多一点责任心。"
                },
                {
                    "id": "652180203",
                    "speaker": "莫普瓦",
                    "text": "特别是艾蒂安…有时我真害怕他的所谓灵机一动。如果他一定要说「我有一个点子」，我希望他能在我休长假的时候说。"
                }
            ]
        },
        {
            "talkId": "6521803",
            "initDialog": "652180301",
            "dialogues": [
                {
                    "id": "652180301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "652180302",
                    "speaker": "莫普瓦",
                    "text": "那我就继续工作了。"
                }
            ]
        },
        {
            "talkId": "6521804",
            "initDialog": "652180401",
            "dialogues": [
                {
                    "id": "652180401",
                    "speaker": "Player",
                    "text": "要不休个假吧。"
                },
                {
                    "id": "652180402",
                    "speaker": "莫普瓦",
                    "text": "可是我的工作还没有做完…我当然知道就算没有我，梅洛彼得堡也照常运转。可我就是忍不住担心…"
                },
                {
                    "id": "652180403",
                    "speaker": "莫普瓦",
                    "text": "只有亲眼看到所有问题都解决了，最好是我亲手把这些工作都解决了！那时我才能安心休息。"
                }
            ]
        },
        {
            "talkId": "6521805",
            "initDialog": "652180501",
            "dialogues": [
                {
                    "id": "652180501",
                    "speaker": "Player",
                    "text": "真的有所有工作做完的一天吗？"
                },
                {
                    "id": "652180502",
                    "speaker": "莫普瓦",
                    "text": "当然没有，所以我不能停止工作，也不能安心休息。"
                }
            ]
        }
    ]
}