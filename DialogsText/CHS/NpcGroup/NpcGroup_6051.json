{
    "groupId": "6051",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "娜恩希": 8
    },
    "talks": [
        {
            "talkId": "6605101",
            "initDialog": "660510101",
            "dialogues": [
                {
                    "id": "660510101",
                    "speaker": "娜恩希",
                    "text": "找我？是需要治病或者包扎吗？"
                },
                {
                    "id": "660510102",
                    "speaker": "娜恩希",
                    "text": "不是不可以，只不过我手头的药已经用得差不多了。"
                }
            ]
        },
        {
            "talkId": "6605102",
            "initDialog": "660510201",
            "dialogues": [
                {
                    "id": "660510201",
                    "speaker": "Player",
                    "text": "你是医生？"
                },
                {
                    "id": "660510202",
                    "speaker": "娜恩希",
                    "text": "对啊，怎么了？你在路边见到的烟谜主的人，差不多有一多半是忙着出诊的医师哦。"
                },
                {
                    "id": "660510203",
                    "speaker": "娜恩希",
                    "text": "很不巧，我刚刚结束了一次紧急出诊，手里的药材已经用掉七七八八，精神也有些疲惫了。"
                },
                {
                    "id": "660510204",
                    "speaker": "娜恩希",
                    "text": "…这么着吧，你要是实在需要帮助，可以碰碰运气，看看能不能在野外遇见一个戴兜帽的小伙子。"
                },
                {
                    "id": "660510205",
                    "speaker": "娜恩希",
                    "text": "他说话有些神叨叨的，但人挺不错，肯定愿意帮你。"
                }
            ]
        },
        {
            "talkId": "6605103",
            "initDialog": "660510301",
            "dialogues": [
                {
                    "id": "660510301",
                    "speaker": "Player",
                    "text": "不用，我还好。"
                },
                {
                    "id": "660510302",
                    "speaker": "娜恩希",
                    "text": "哦哦，那就好。"
                }
            ]
        },
        {
            "talkId": "7592101",
            "initDialog": "759210101",
            "dialogues": [
                {
                    "id": "759210101",
                    "speaker": "Player",
                    "text": "了解了。"
                },
                {
                    "id": "759210102",
                    "speaker": "娜恩希",
                    "text": "嗯。说起来，他上次送我的蘑菇还有些剩下的…我一个人也用不完，这些品质不错，你拿着吧。"
                }
            ]
        }
    ]
}