{
    "groupId": "7679",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "薇莉亚娜": 14
    },
    "talks": [
        {
            "talkId": "6767901",
            "initDialog": "676790101",
            "dialogues": [
                {
                    "id": "676790101",
                    "speaker": "薇莉亚娜",
                    "text": "没想到，还有这样的妖精朋友呢…"
                }
            ]
        },
        {
            "talkId": "6767902",
            "initDialog": "676790201",
            "dialogues": [
                {
                    "id": "676790201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "676790202",
                    "speaker": "薇莉亚娜",
                    "text": "啊，您好。我的名字是薇莉亚娜·韦列索芙娜·别洛泽尔斯卡娅，是从新基捷来的冒险家…"
                },
                {
                    "id": "676790203",
                    "speaker": "薇莉亚娜",
                    "text": "…虽然不是冒险家协会的正式成员啦。放我出来旅行已经是母亲能接受的底线了，要是再加入冒险家协会，她非得气融了不可。"
                },
                {
                    "id": "676790204",
                    "speaker": "薇莉亚娜",
                    "text": "总之，我正在一边旅行，一边为我的《边乡夜语》搜集灵感。是关于各种各样的妖精朋友的故事喔。"
                }
            ]
        },
        {
            "talkId": "6767903",
            "initDialog": "676790301",
            "dialogues": [
                {
                    "id": "676790301",
                    "speaker": "Player",
                    "text": "关于妖精…"
                },
                {
                    "id": "676790302",
                    "speaker": "薇莉亚娜",
                    "text": "嗯…怎么说呢？因为至冬的妖精种类实在是太多了，所以就算我也是妖精，有些名字也只能在古代的书上看到。"
                },
                {
                    "id": "676790303",
                    "speaker": "薇莉亚娜",
                    "text": "就拿莉奈娅小姐来说吧。来挪德卡莱之前，我都没想到能亲眼见到活着的谶鸟…呜啊，真的太幸运了…"
                },
                {
                    "id": "676790304",
                    "speaker": "薇莉亚娜",
                    "text": "所以我打算在挪德卡莱多待些日子，说不定还能见到其他的妖精朋友呢！"
                }
            ]
        },
        {
            "talkId": "6767904",
            "initDialog": "676790401",
            "dialogues": [
                {
                    "id": "676790401",
                    "speaker": "Player",
                    "text": "你是…雪孃？"
                },
                {
                    "id": "676790402",
                    "speaker": "薇莉亚娜",
                    "text": "欸？啊…看您的表情，应该还没到访过我们至冬堡吧？"
                },
                {
                    "id": "676790403",
                    "speaker": "薇莉亚娜",
                    "text": "呵呵，是呀，我是雪孃。和莉奈娅小姐这样只能在书上读到的谶鸟相比，我们已经是至冬数量最多的妖精之一了。"
                },
                {
                    "id": "676790404",
                    "speaker": "薇莉亚娜",
                    "text": "只不过…您大概也能猜到，我的族人普遍厌恶炎热，所以通常几乎不会离开北方的雪原。"
                },
                {
                    "id": "676790405",
                    "speaker": "薇莉亚娜",
                    "text": "我能独自出来旅行、能像这样与您相遇，已经是我那位被女皇陛下授予勋爵之荣的母亲最开明的体现了。"
                },
                {
                    "id": "676790406",
                    "speaker": "薇莉亚娜",
                    "text": "而我的远房姑姑，赫斯珀利德斯之馆的帕芙琳娜女大公，甚至直接封锁了她的领地，不允许她的领民们外出…"
                },
                {
                    "id": "676790407",
                    "speaker": "薇莉亚娜",
                    "text": "唔，也算是情有可原吧…总之，等您造访过我们美丽的城市，应该就不会对雪孃感到惊讶啦。"
                }
            ]
        },
        {
            "talkId": "6767905",
            "initDialog": "676790501",
            "dialogues": [
                {
                    "id": "676790501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676790502",
                    "speaker": "薇莉亚娜",
                    "text": "嗯嗯，再见啦。对了，要是您见到像莉奈娅小姐这样…特别的妖精朋友，也可以来告诉我喔！"
                }
            ]
        }
    ]
}