{
    "groupId": "7604",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 11,
        "法尔伽": 5,
        "温弗里德": 1,
        "艾克贝特": 21,
        "莱夫赫姆": 1
    },
    "talks": [
        {
            "talkId": "6760401",
            "initDialog": "676040101",
            "dialogues": [
                {
                    "id": "676040101",
                    "speaker": "艾克贝特",
                    "text": "铳枪的保养工作…唔，头好痛…"
                }
            ]
        },
        {
            "talkId": "6760402",
            "initDialog": "676040201",
            "dialogues": [
                {
                    "id": "676040201",
                    "speaker": "Player",
                    "text": "你的枪…"
                },
                {
                    "id": "676040202",
                    "speaker": "艾克贝特",
                    "text": "啊…这是枫丹制的铳枪，从一些至冬商人手里买来的。"
                }
            ]
        },
        {
            "talkId": "6760403",
            "initDialog": "676040301",
            "dialogues": [
                {
                    "id": "676040301",
                    "speaker": "Player",
                    "text": "你的头…"
                },
                {
                    "id": "676040302",
                    "speaker": "艾克贝特",
                    "text": "唔唔…头好痛…昨天喝得好像太多了…"
                },
                {
                    "id": "676040303",
                    "speaker": "艾克贝特",
                    "text": "这副模样，可不能让洛恩队长或者齐格芙丽雅给看到…"
                }
            ]
        },
        {
            "talkId": "6760404",
            "initDialog": "676040401",
            "dialogues": [
                {
                    "id": "676040401",
                    "speaker": "Player",
                    "text": "你的疤…"
                },
                {
                    "id": "676040402",
                    "speaker": "艾克贝特",
                    "text": "啊…这可不是喝醉了在哪磕的，是「远征队」骑士的荣誉勋章哦？"
                },
                {
                    "id": "676040403",
                    "speaker": "艾克贝特",
                    "text": "「来自正面的伤口不是耻辱而是荣耀！」…而且这个位置，看起来是不是还有点像大团长？哈哈！"
                }
            ]
        },
        {
            "talkId": "6760405",
            "initDialog": "676040501",
            "dialogues": [
                {
                    "id": "676040501",
                    "speaker": "Player",
                    "text": "你加油…"
                },
                {
                    "id": "676040502",
                    "speaker": "艾克贝特",
                    "text": "你也加油…荣誉骑士…"
                }
            ]
        },
        {
            "talkId": "6760406",
            "initDialog": "676040601",
            "dialogues": [
                {
                    "id": "676040601",
                    "speaker": "Player",
                    "text": "枫丹的枪？"
                },
                {
                    "id": "676040602",
                    "speaker": "艾克贝特",
                    "text": "嗯…火铳是消耗品，在外征战就得选择适合补充的型号。"
                },
                {
                    "id": "676040603",
                    "speaker": "艾克贝特",
                    "text": "我们第五小队倒是也有列装自己的远程武器，但在挪德卡莱没有稳定的供应…所以还会采购其他地方出产的通用型号。"
                },
                {
                    "id": "676040604",
                    "speaker": "艾克贝特",
                    "text": "洛恩队长说过，武器就跟手段一样…只要能达成目的，用什么都行。要是用不顺手，那就是练得太少。"
                }
            ]
        },
        {
            "talkId": "6760407",
            "initDialog": "676040701",
            "dialogues": [
                {
                    "id": "676040701",
                    "speaker": "Player",
                    "text": "至冬商人？"
                },
                {
                    "id": "676040702",
                    "speaker": "艾克贝特",
                    "text": "至冬人也不全是一见面就打过来的家伙啦，我们在远征中跟至冬的人合作过不少次。"
                },
                {
                    "id": "676040703",
                    "speaker": "艾克贝特",
                    "text": "只能说他们的派系实在太多了，里头有好人也有坏人…这你应该也明白？"
                },
                {
                    "id": "676040704",
                    "speaker": "艾克贝特",
                    "text": "说回那些卖枪给我们的至冬商人吧，我觉得他们就是大好人！"
                },
                {
                    "id": "676040705",
                    "speaker": "艾克贝特",
                    "text": "…因为他们连着火铳一起送来的「火水」，喝起来既真诚又炽烈！"
                }
            ]
        },
        {
            "talkId": "6760408",
            "initDialog": "676040801",
            "dialogues": [
                {
                    "id": "676040801",
                    "speaker": "Player",
                    "text": "洛恩队长？"
                },
                {
                    "id": "676040802",
                    "speaker": "艾克贝特",
                    "text": "洛恩是我们第五小队的副队长…虽然跟队长也没差了！"
                },
                {
                    "id": "676040803",
                    "speaker": "艾克贝特",
                    "text": "你可能也听说过，洛恩队长对待敌人就像寒风一样毫不留情，对待下属…"
                },
                {
                    "id": "676040804",
                    "speaker": "Player",
                    "text": "就像春风一样和煦？"
                },
                {
                    "id": "676040805",
                    "speaker": "艾克贝特",
                    "text": "不，也像寒风一样冰冷，光是想想酒就醒了一半。"
                }
            ]
        },
        {
            "talkId": "6760409",
            "initDialog": "676040901",
            "dialogues": [
                {
                    "id": "676040901",
                    "speaker": "Player",
                    "text": "齐格芙丽雅？"
                },
                {
                    "id": "676040902",
                    "speaker": "艾克贝特",
                    "text": "她是我的妹妹，现在还留在清泉镇。以前每次我喝高了，她都会要我吃一堆野菜来解酒。"
                },
                {
                    "id": "676040903",
                    "speaker": "艾克贝特",
                    "text": "…明明那些野菜给她自己都不够吃。唉，说着说着就有点想念她煮的野菜汤了。"
                },
                {
                    "id": "676040904",
                    "speaker": "艾克贝特",
                    "text": "荣誉骑士，你要是有空…下次路过清泉镇，能帮我去看看她吗？"
                }
            ]
        },
        {
            "talkId": "7667715",
            "initDialog": "766771501",
            "dialogues": [
                {
                    "id": "766771501",
                    "speaker": "法尔伽",
                    "text": "向左转…向右转！",
                    "choices": [
                        {
                            "id": "766772301",
                            "text": "他们还没醒酒吗？",
                            "response": [
                                {
                                    "id": "766772401",
                                    "speaker": "法尔伽",
                                    "text": "…荣誉骑士，能请你来整肃他们吗？只要<color=#00E1FFFF>一边喊口号，一边找出里面犯错最多的人</color>就行。"
                                }
                            ]
                        },
                        {
                            "id": "766772201",
                            "text": "法尔伽，你们这是在？",
                            "response": [
                                {
                                    "id": "766772202",
                                    "speaker": "法尔伽",
                                    "text": "哦，这是骑士团里的队列训练。他们三个昨晚有点喝高了，我在给他们醒酒。"
                                },
                                {
                                    "id": "766772203",
                                    "speaker": "法尔伽",
                                    "text": "…顺便找出醉得最厉害的，罚跑二十圈。虽然远征军没有禁酒，但什么时候喝、每次喝多少也都是有规矩的。"
                                },
                                {
                                    "id": "766772204",
                                    "speaker": "温弗里德",
                                    "text": "我…我只喝了一点点！"
                                },
                                {
                                    "id": "766772205",
                                    "speaker": "艾克贝特",
                                    "text": "我…我也是！"
                                },
                                {
                                    "id": "766772206",
                                    "speaker": "法尔伽",
                                    "text": "…与其用言语，不如用行动来证明吧！ 给我拿出就算喝醉了也能完美应付的气势来！"
                                },
                                {
                                    "id": "766772207",
                                    "speaker": "莱夫赫姆",
                                    "text": "是…是！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}