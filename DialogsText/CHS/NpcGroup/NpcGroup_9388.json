{
    "groupId": "9388",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "恰斯卡": 9
    },
    "talks": [
        {
            "talkId": "6938801",
            "initDialog": "693880101",
            "dialogues": [
                {
                    "id": "693880101",
                    "speaker": "恰斯卡",
                    "text": "这一路下来消耗的子弹还真不少，枪管到现在还在发烫。"
                },
                {
                    "id": "693880102",
                    "speaker": "恰斯卡",
                    "text": "我会留在这里保养一下枪支，你不妨也暂停一下，调整好状态吧。"
                },
                {
                    "id": "693880103",
                    "speaker": "恰斯卡",
                    "text": "枪需要休息，人也一样。"
                }
            ]
        },
        {
            "talkId": "6938802",
            "initDialog": "693880201",
            "dialogues": [
                {
                    "id": "693880201",
                    "speaker": "恰斯卡",
                    "text": "这里没有什么需要调停的矛盾，只有需要击败的敌人。"
                },
                {
                    "id": "693880202",
                    "speaker": "恰斯卡",
                    "text": "所以我也不需要束手束脚，只要尽情战斗就可以了吧？"
                },
                {
                    "id": "693880203",
                    "speaker": "恰斯卡",
                    "text": "呵…这样很好，简单明快。"
                }
            ]
        },
        {
            "talkId": "6938803",
            "initDialog": "693880301",
            "dialogues": [
                {
                    "id": "693880301",
                    "speaker": "恰斯卡",
                    "text": "唔…地上这些亮晶晶的东西是什么？可以从这里带出去吗？"
                },
                {
                    "id": "693880302",
                    "speaker": "恰斯卡",
                    "text": "如果拿来装饰卧房，感觉会很不错。「妈妈」应该也会喜欢这种小玩意儿。"
                },
                {
                    "id": "693880303",
                    "speaker": "恰斯卡",
                    "text": "…不过那么多芒刺，要是放进龙巢，睡觉的时候会不会硌着…"
                }
            ]
        }
    ]
}