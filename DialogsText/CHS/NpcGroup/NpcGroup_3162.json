    },
    "talks": [
        {
            "talkId": "6316201",
            "initDialog": "631620101",
            "dialogues": [
                {
                    "id": "631620101",
                    "speaker": "虎之助",
                    "text": "泽维尔先生，我们还要接着拍下去吗？"
                },
                {
                    "id": "631620102",
                    "speaker": "泽维尔",
                    "text": "那是当然！还有很多题材在等着我去尝试！"
                }
            ]
        },
        {
            "talkId": "6316202",
            "initDialog": "631620201",
            "dialogues": [
                {
                    "id": "631620201",
                    "speaker": "Player",
                    "text": "你们还在拍「映影」吗？"
                },
                {
                    "id": "631620202",
                    "speaker": "泽维尔",
                    "text": "#啊…是您啊！我亲爱的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}！"
                },
                {
                    "id": "631620203",
                    "speaker": "泽维尔",
                    "text": "我正在和这位士兵先生讨论下一部「映影」拍什么好呢。"
                },
                {
                    "id": "631620204",
                    "speaker": "泽维尔",
                    "text": "我想要去记录一下狸猫和狐狸的传说，而这位士兵先生嘛…"
                },
                {
                    "id": "631620205",
                    "speaker": "虎之助",
                    "text": "我则更推荐泽维尔先生去城里，记录一下武士们真正的威武姿态。"
                }
            ]
        },
        {
            "talkId": "6316203",
            "initDialog": "631620301",
            "dialogues": [
                {
                    "id": "631620301",
                    "speaker": "Player",
                    "text": "你们讨论出结果了吗？"
                },
                {
                    "id": "631620302",
                    "speaker": "泽维尔",
                    "text": "喔，这个嘛…在我俩进行了充分的讨论之后，总算还是达成了共识。"
                },
                {
                    "id": "631620303",
                    "speaker": "泽维尔",
                    "text": "那就是…拍一部两者皆有的「映影」。"
                },
                {
                    "id": "631620304",
                    "speaker": "泽维尔",
                    "text": "我现在想的故事，大概就是一位武士在很久很久之前的稻妻斩妖除魔的故事。"
                },
                {
                    "id": "631620305",
                    "speaker": "泽维尔",
                    "text": "当然啦，里面还要填充一些其他元素，比如爱情或者喜剧元素…"
                },
                {
                    "id": "631620306",
                    "speaker": "泽维尔",
                    "text": "但是，这也只是一个初步的想法，我还得再搜集一些素材才行。"
                }
            ]
        },
        {
            "talkId": "6316204",
            "initDialog": "631620401",
            "dialogues": [
                {
                    "id": "631620401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631620402",
                    "speaker": "泽维尔",
                    "text": "#喔，再见，我亲爱的{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HERO|INFO_FEMALE_PRONOUN_HEROINE]}，祝您好运！"
                }
            ]
        },
        {
            "talkId": "6316205",
            "initDialog": "631620501",
            "dialogues": [
                {
                    "id": "631620501",
                    "speaker": "泽维尔",
                    "text": "已经没办法了…"
                }
            ]
        }
    ]
}