{
    "groupId": "4168",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "艾莉亚": 12
    },
    "talks": [
        {
            "talkId": "6416801",
            "initDialog": "641680101",
            "dialogues": [
                {
                    "id": "641680101",
                    "speaker": "艾莉亚",
                    "text": "哼！"
                }
            ]
        },
        {
            "talkId": "6416802",
            "initDialog": "641680201",
            "dialogues": [
                {
                    "id": "641680201",
                    "speaker": "Player",
                    "text": "谁惹你了？"
                },
                {
                    "id": "641680202",
                    "speaker": "艾莉亚",
                    "text": "还能有谁，就是那个家伙呗，整天正事不干，油嘴滑舌。"
                },
                {
                    "id": "641680203",
                    "speaker": "艾莉亚",
                    "text": "我们从小一起长大，我对他再了解不过了。"
                },
                {
                    "id": "641680204",
                    "speaker": "艾莉亚",
                    "text": "你要是在附近见到一个满嘴「邂逅」啦，「缘分」啦的人，可千万别轻信他啊！"
                },
                {
                    "id": "641680205",
                    "speaker": "艾莉亚",
                    "text": "他就是嘴上说得好听，其实没什么正经本事，只会在街上闲逛。"
                },
                {
                    "id": "641680206",
                    "speaker": "艾莉亚",
                    "text": "希望我的小弟弟可别学他，变成没用的大人…"
                }
            ]
        },
        {
            "talkId": "6416803",
            "initDialog": "641680301",
            "dialogues": [
                {
                    "id": "641680301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641680302",
                    "speaker": "艾莉亚",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6416804",
            "initDialog": "641680401",
            "dialogues": [
                {
                    "id": "641680401",
                    "speaker": "Player",
                    "text": "你的小弟弟…"
                },
                {
                    "id": "641680402",
                    "speaker": "艾莉亚",
                    "text": "嗯，我有一个年纪很小的弟弟，应该是和小伙伴一起出去玩了。"
                },
                {
                    "id": "641680403",
                    "speaker": "艾莉亚",
                    "text": "他最近不知怎么回事，对驮兽产生了很大的兴趣。"
                },
                {
                    "id": "641680404",
                    "speaker": "艾莉亚",
                    "text": "他的伙伴家里好像养着驮兽，这不，他一逮着机会就往那跑。"
                },
                {
                    "id": "641680405",
                    "speaker": "艾莉亚",
                    "text": "而且每次有商贩往我家送东西的时候，他就一个劲儿地盯着运货的驮兽看。"
                },
                {
                    "id": "641680406",
                    "speaker": "艾莉亚",
                    "text": "嗯…也好吧，让他早点知道商贩们的做事方式也不错。那样等他长大了，就能帮着家里一起经商了。"
                }
            ]
        }
    ]
}