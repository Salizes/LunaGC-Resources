{
    "groupId": "7641",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "阿莱娜": 9
    },
    "talks": [
        {
            "talkId": "6764101",
            "initDialog": "676410101",
            "dialogues": [
                {
                    "id": "676410101",
                    "speaker": "阿莱娜",
                    "text": "据说最近很多人看到狂猎，不过…怎么都没什么靠谱的消息…"
                }
            ]
        },
        {
            "talkId": "6764102",
            "initDialog": "676410201",
            "dialogues": [
                {
                    "id": "676410201",
                    "speaker": "Player",
                    "text": "这么关注狂猎，你也是执灯士？"
                },
                {
                    "id": "676410202",
                    "speaker": "阿莱娜",
                    "text": "哈哈，怎么可能，看衣服就能看出来吧，我可不是执灯士…也没有和那些魔物战斗的勇气…"
                },
                {
                    "id": "676410203",
                    "speaker": "阿莱娜",
                    "text": "我只是个普通的行商，偶尔帮皮拉米达城运运货，找找那些执灯士们想要的物资之类的。"
                },
                {
                    "id": "676410204",
                    "speaker": "阿莱娜",
                    "text": "顺便，从他们口中问一些他们掌握的狂猎的信息，避开那些危险的商路，也算是这份工作的一部分回报了。"
                }
            ]
        },
        {
            "talkId": "6764103",
            "initDialog": "676410301",
            "dialogues": [
                {
                    "id": "676410301",
                    "speaker": "Player",
                    "text": "很多人看到狂猎？"
                },
                {
                    "id": "676410302",
                    "speaker": "阿莱娜",
                    "text": "…很多人只是「自以为」看到狂猎，其实也许是其他魔物什么的。"
                },
                {
                    "id": "676410303",
                    "speaker": "阿莱娜",
                    "text": "而且有的时候也不是真的遇到了狂猎。举个例子，毕竟我们是行商，路上货物总有些损耗…"
                },
                {
                    "id": "676410304",
                    "speaker": "阿莱娜",
                    "text": "客人们若要问起货物怎么变少了些的时候，许多狂猎就会一股脑地从行商们的借口里涌出来，这种一听就是假的。"
                },
                {
                    "id": "676410305",
                    "speaker": "阿莱娜",
                    "text": "但是偶尔也会有行商朋友们遇到真的，我就会通过我们传递信息的手段通知皮拉米达城。"
                }
            ]
        },
        {
            "talkId": "6764104",
            "initDialog": "676410401",
            "dialogues": [
                {
                    "id": "676410401",
                    "speaker": "Player",
                    "text": "希望真的见到狂猎的人不多。"
                },
                {
                    "id": "676410402",
                    "speaker": "阿莱娜",
                    "text": "是啊，毕竟狂猎很危险…您也一样，要是见到了可得快点跑呀，哪有什么比人命重要。"
                }
            ]
        }
    ]
}