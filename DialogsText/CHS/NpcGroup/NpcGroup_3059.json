    "talks": [
        {
            "talkId": "6305901",
            "initDialog": "630590101",
            "dialogues": [
                {
                    "id": "630590101",
                    "speaker": "渡边",
                    "text": "这些新人，真是要加强训练强度了。明天先来半小时立正，再来一百个俯卧撑。"
                }
            ]
        },
        {
            "talkId": "6305902",
            "initDialog": "630590201",
            "dialogues": [
                {
                    "id": "630590201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630590202",
                    "speaker": "渡边",
                    "text": "我是负责在这里训练新兵的同心，可以叫我渡边教头。"
                },
                {
                    "id": "630590203",
                    "speaker": "渡边",
                    "text": "你说说，现在的新兵，一点毅力都没有。没一点恒心，还想为将军效命…"
                },
                {
                    "id": "630590204",
                    "speaker": "渡边",
                    "text": "欸，我跟你说这些干什么。训练场地谢绝参观。"
                }
            ]
        },
        {
            "talkId": "6305903",
            "initDialog": "630590301",
            "dialogues": [
                {
                    "id": "630590301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630590302",
                    "speaker": "渡边",
                    "text": "常道恢弘，鸣神永恒。"
                }
            ]
        }
    ]
}