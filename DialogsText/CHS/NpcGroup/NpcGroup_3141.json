{
    "groupId": "3141",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "阿波": 12
    },
    "talks": [
        {
            "talkId": "6314101",
            "initDialog": "631410101",
            "dialogues": [
                {
                    "id": "631410101",
                    "speaker": "阿波",
                    "text": "这一带是海上要道，船只往来很多，必须小心看守…"
                }
            ]
        },
        {
            "talkId": "6314102",
            "initDialog": "631410201",
            "dialogues": [
                {
                    "id": "631410201",
                    "speaker": "Player",
                    "text": "你看起来很紧张。"
                },
                {
                    "id": "631410202",
                    "speaker": "阿波",
                    "text": "啊哈哈…这么明显吗…"
                },
                {
                    "id": "631410203",
                    "speaker": "阿波",
                    "text": "确实，我老是容易紧张，可能是因为我的视力很好吧。看见的东西越多，承受的压力就越大。"
                },
                {
                    "id": "631410204",
                    "speaker": "阿波",
                    "text": "我能从这里看到很远的地方哦。上次往海那边看的时候，还发现了外国人的船只，上面的人打扮得挺招摇，好多还戴着面具。"
                },
                {
                    "id": "631410205",
                    "speaker": "阿波",
                    "text": "…难道是愚人众吗？那可得多加留意，不能让他们随便靠岸。"
                }
            ]
        },
        {
            "talkId": "6314103",
            "initDialog": "631410301",
            "dialogues": [
                {
                    "id": "631410301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631410302",
                    "speaker": "阿波",
                    "text": "嗯，我得继续工作了。"
                }
            ]
        },
        {
            "talkId": "6314104",
            "initDialog": "631410401",
            "dialogues": [
                {
                    "id": "631410401",
                    "speaker": "Player",
                    "text": "确实值得注意。"
                },
                {
                    "id": "631410402",
                    "speaker": "阿波",
                    "text": "果然，我的判断是正确的。"
                },
                {
                    "id": "631410403",
                    "speaker": "阿波",
                    "text": "所以最近我对进出码头的人检查更加严格了。不仅要防止幕府的人混进来，还得注意偷渡或者走私行为。"
                },
                {
                    "id": "631410404",
                    "speaker": "阿波",
                    "text": "码头毕竟是交通枢纽，必须谨慎行事。"
                }
            ]
        },
        {
            "talkId": "6314105",
            "initDialog": "631410501",
            "dialogues": [
                {
                    "id": "631410501",
                    "speaker": "Player",
                    "text": "放松一点吧。"
                },
                {
                    "id": "631410502",
                    "speaker": "阿波",
                    "text": "事实上，我一直在想办法放松精神。试了好多朋友推荐的方法，例如在瀑布下冲水、半夜跑步…什么的。"
                },
                {
                    "id": "631410503",
                    "speaker": "阿波",
                    "text": "不过好像没什么用呢，只觉得更紧张了…我问过朋友，他总是回答说：再忍一忍，等超过临界点就会好了。"
                },
                {
                    "id": "631410504",
                    "speaker": "阿波",
                    "text": "我不明白啊，这是什么道理？"
                }
            ]
        }
    ]
}