{
    "groupId": "5053",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "阿鲁埃": 12
    },
    "talks": [
        {
            "talkId": "6505301",
            "initDialog": "650530101",
            "dialogues": [
                {
                    "id": "650530101",
                    "speaker": "阿鲁埃",
                    "text": "欢迎光临咖啡厅·露泽，这里有最苦的咖啡，也有最甜的蛋糕，以及最清醒和最荒谬的客人。"
                }
            ]
        },
        {
            "talkId": "6505302",
            "initDialog": "650530201",
            "dialogues": [
                {
                    "id": "650530201",
                    "speaker": "Player",
                    "text": "关于甜的…"
                },
                {
                    "id": "650530202",
                    "speaker": "阿鲁埃",
                    "text": "保证每一口都像美露莘的笑容一样甜。"
                }
            ]
        },
        {
            "talkId": "6505303",
            "initDialog": "650530301",
            "dialogues": [
                {
                    "id": "650530301",
                    "speaker": "Player",
                    "text": "关于苦的…"
                },
                {
                    "id": "650530302",
                    "speaker": "阿鲁埃",
                    "text": "每位客人对咖啡都有不同口味上的偏好，而我就是那个尽力满足他们偏好的人。"
                },
                {
                    "id": "650530303",
                    "speaker": "阿鲁埃",
                    "text": "但如果有人想要完全没有一丝苦涩的咖啡或茶，我的能力就十分有限了。"
                },
                {
                    "id": "650530304",
                    "speaker": "阿鲁埃",
                    "text": "遇到这种情况，我会建议他去拜访沫芒宫或卡朗代沙龙，并与他们见到的第一位女士或先生聊聊。"
                }
            ]
        },
        {
            "talkId": "6505304",
            "initDialog": "650530401",
            "dialogues": [
                {
                    "id": "650530401",
                    "speaker": "Player",
                    "text": "清醒与荒谬…"
                },
                {
                    "id": "650530402",
                    "speaker": "阿鲁埃",
                    "text": "如你所见，我开的是一家咖啡厅，而不是酒馆。"
                },
                {
                    "id": "650530403",
                    "speaker": "阿鲁埃",
                    "text": "这里常有些先生们一边休息一边高谈阔论，而我会在心中暗自祈祷他们是喝醉了才会说出那些话。"
                },
                {
                    "id": "650530404",
                    "speaker": "阿鲁埃",
                    "text": "人们在清醒时说的话，有时比醉鬼的胡闹还要荒谬呢。"
                }
            ]
        },
        {
            "talkId": "6505305",
            "initDialog": "650530501",
            "dialogues": [
                {
                    "id": "650530501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650530502",
                    "speaker": "阿鲁埃",
                    "text": "慢走，欢迎下次光临。"
                }
            ]
        },
        {
            "talkId": "7492701",
            "initDialog": "749270101",
            "dialogues": [
                {
                    "id": "749270101",
                    "speaker": "Player",
                    "text": "谢谢，但是算了。"
                },
                {
                    "id": "749270102",
                    "speaker": "阿鲁埃",
                    "text": "看来您是位非常理智的人。"
                },
                {
                    "id": "749270103",
                    "speaker": "阿鲁埃",
                    "text": "在我这里，理智与清醒拥有不同的概念。"
                },
                {
                    "id": "749270104",
                    "speaker": "阿鲁埃",
                    "text": "我非常欢迎理智的顾客，并祝福他们能度过快乐而甜蜜的一天。"
                }
            ]
        }
    ]
}