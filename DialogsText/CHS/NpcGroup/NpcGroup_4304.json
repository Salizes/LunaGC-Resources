{
    "groupId": "4304",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "基翁": 26
    },
    "talks": [
        {
            "talkId": "6430401",
            "initDialog": "643040101",
            "dialogues": [
                {
                    "id": "643040101",
                    "speaker": "基翁",
                    "text": "你的脚步声，我第一次听到。"
                },
                {
                    "id": "643040102",
                    "speaker": "基翁",
                    "text": "抱歉，我的眼睛看不见，所以帮不上什么忙。"
                },
                {
                    "id": "643040103",
                    "speaker": "基翁",
                    "text": "不过听力倒是很好。"
                }
            ]
        },
        {
            "talkId": "6430402",
            "initDialog": "643040201",
            "dialogues": [
                {
                    "id": "643040201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "643040202",
                    "speaker": "基翁",
                    "text": "你好你好。"
                },
                {
                    "id": "643040203",
                    "speaker": "基翁",
                    "text": "化城郭经常有来往的旅客、商人、冒险家…但你的脚步声比他们都要轻快，想必是位活泼可爱的年轻人吧。"
                },
                {
                    "id": "643040204",
                    "speaker": "基翁",
                    "text": "在如今的须弥，这可是件难得的好事。"
                },
                {
                    "id": "643040205",
                    "speaker": "基翁",
                    "text": "年轻的旅客，树王大人保佑你。"
                }
            ]
        },
        {
            "talkId": "6430403",
            "initDialog": "643040301",
            "dialogues": [
                {
                    "id": "643040301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643040302",
                    "speaker": "基翁",
                    "text": "再见，树王大人保佑你。"
                }
            ]
        },
        {
            "talkId": "6430404",
            "initDialog": "643040401",
            "dialogues": [
                {
                    "id": "643040401",
                    "speaker": "Player",
                    "text": "须弥发生了什么吗？"
                },
                {
                    "id": "643040402",
                    "speaker": "基翁",
                    "text": "没有没有，须弥风平浪静，就和平常一样。"
                },
                {
                    "id": "643040403",
                    "speaker": "基翁",
                    "text": "只不过是我这个瞎眼的老年人在杞人忧天罢了。"
                },
                {
                    "id": "643040404",
                    "speaker": "基翁",
                    "text": "使用「虚空」的人越来越多，从须弥城往外飞的暝彩鸟却越来越少…"
                },
                {
                    "id": "643040405",
                    "speaker": "基翁",
                    "text": "但愿这是进步的象征吧。"
                }
            ]
        },
        {
            "talkId": "6430405",
            "initDialog": "643040501",
            "dialogues": [
                {
                    "id": "643040501",
                    "speaker": "Player",
                    "text": "关于树王大人…"
                },
                {
                    "id": "643040502",
                    "speaker": "基翁",
                    "text": "树王大人虽已不在，但须弥人会永远记得她曾给予人民的庇佑。"
                },
                {
                    "id": "643040503",
                    "speaker": "基翁",
                    "text": "年轻人，你应知道，这片国度上的每一根小草、每一片树叶，都是树王大人的恩惠啊。"
                },
                {
                    "id": "643040504",
                    "speaker": "基翁",
                    "text": "…唉，人的生命过于短暂，我这辈子还能等到小草神大人重现须弥往昔的日子吗？"
                }
            ]
        },
        {
            "talkId": "6430406",
            "initDialog": "643040601",
            "dialogues": [
                {
                    "id": "643040601",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "643040602",
                    "speaker": "基翁",
                    "text": "你好你好。"
                },
                {
                    "id": "643040603",
                    "speaker": "基翁",
                    "text": "化城郭经常有来往的旅客、商人、冒险家…但你的脚步声比他们都要轻快，想必是位活泼可爱的年轻人吧。"
                },
                {
                    "id": "643040604",
                    "speaker": "基翁",
                    "text": "在如今的须弥，这可是件难得的好事。"
                },
                {
                    "id": "643040605",
                    "speaker": "基翁",
                    "text": "年轻的旅客，小吉祥草王大人保佑你。"
                }
            ]
        },
        {
            "talkId": "6430407",
            "initDialog": "643040701",
            "dialogues": [
                {
                    "id": "643040701",
                    "speaker": "Player",
                    "text": "须弥发生了什么吗？"
                },
                {
                    "id": "643040702",
                    "speaker": "基翁",
                    "text": "虽然我只是个眼瞎的老人，但也能听出，最近似乎发生了好事情哦。"
                },
                {
                    "id": "643040703",
                    "speaker": "基翁",
                    "text": "「虚空」关闭了之后，连林中飞翔的鸟儿都变多了…"
                },
                {
                    "id": "643040704",
                    "speaker": "基翁",
                    "text": "正是这种时候，才更需要你们这样的年轻人啊。"
                }
            ]
        },
        {
            "talkId": "6430408",
            "initDialog": "643040801",
            "dialogues": [
                {
                    "id": "643040801",
                    "speaker": "Player",
                    "text": "关于小吉祥草王…"
                },
                {
                    "id": "643040802",
                    "speaker": "基翁",
                    "text": "小吉祥草王大人已经重新开始引领须弥，一切都会变得越来越好的。"
                },
                {
                    "id": "643040803",
                    "speaker": "基翁",
                    "text": "年轻人，你应该记得，这片国度上的每一根小草、每一片树叶，都是草神大人的恩惠啊。"
                },
                {
                    "id": "643040804",
                    "speaker": "基翁",
                    "text": "…唉，人的生命过于短暂，希望我能等到小草神大人重现须弥往昔的辉煌。"
                }
            ]
        },
        {
            "talkId": "6430409",
            "initDialog": "643040901",
            "dialogues": [
                {
                    "id": "643040901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643040902",
                    "speaker": "基翁",
                    "text": "再见，草神大人保佑你。"
                }
            ]
        }
    ]
}