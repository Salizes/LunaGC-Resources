{
    "groupId": "9034",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Player": 18,
        "诺艾尔": 41
    },
    "talks": [
        {
            "talkId": "6903401",
            "initDialog": "690340101",
            "dialogues": [
                {
                    "id": "690340101",
                    "speaker": "诺艾尔",
                    "text": "#你好，{NICKNAME}，真高兴又见面了。"
                },
                {
                    "id": "690340102",
                    "speaker": "诺艾尔",
                    "text": "有什么需要我为你做的吗？我随时效劳。"
                }
            ]
        },
        {
            "talkId": "6903402",
            "initDialog": "690340201",
            "dialogues": [
                {
                    "id": "690340201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690340202",
                    "speaker": "诺艾尔",
                    "text": "当然，我很喜欢这里的环境。"
                },
                {
                    "id": "690340203",
                    "speaker": "诺艾尔",
                    "text": "户外开阔又惬意，室内的装饰也雅致。"
                },
                {
                    "id": "690340204",
                    "speaker": "诺艾尔",
                    "text": "我觉得胜过我见过的所有庄园。"
                },
                {
                    "id": "690340205",
                    "speaker": "诺艾尔",
                    "text": "唯一的缺陷…"
                },
                {
                    "id": "690340206",
                    "speaker": "Player",
                    "text": "唯一的缺陷？"
                },
                {
                    "id": "690340207",
                    "speaker": "诺艾尔",
                    "text": "相比蒙德城，这里需要女仆做的工作实在太少了。"
                },
                {
                    "id": "690340208",
                    "speaker": "诺艾尔",
                    "text": "感觉有点太悠闲了呢…"
                }
            ]
        },
        {
            "talkId": "6903403",
            "initDialog": "690340301",
            "dialogues": [
                {
                    "id": "690340301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690340209",
                    "speaker": "诺艾尔",
                    "text": "好的，这是我的荣幸。"
                },
                {
                    "id": "690340302",
                    "speaker": "诺艾尔",
                    "text": "说起来…自从来这里之后，我已经很久没有捡到来历不明的失物了。"
                },
                {
                    "id": "690340303",
                    "speaker": "诺艾尔",
                    "text": "感觉还有些不习惯呢。",
                    "choices": [
                        {
                            "id": "690340304",
                            "text": "欸？",
                            "response": [
                                {
                                    "id": "690340305",
                                    "speaker": "诺艾尔",
                                    "text": "就是，在清扫工作中遇到的。"
                                },
                                {
                                    "id": "690340308",
                                    "speaker": "诺艾尔",
                                    "text": "比如…在柜子底下翻到颜色陈旧的发带。"
                                },
                                {
                                    "id": "690340309",
                                    "speaker": "诺艾尔",
                                    "text": "在灌木丛里找到被小猫叼过的球。"
                                },
                                {
                                    "id": "690340310",
                                    "speaker": "诺艾尔",
                                    "text": "还有图书馆角落里的书签，丢在路边的钥匙，教堂门缝里没有署名的忏悔信…",
                                    "choices": [
                                        {
                                            "id": "690340311",
                                            "text": "听起来清扫工作真是辛苦…",
                                            "response": [
                                                {
                                                    "id": "690340312",
                                                    "speaker": "诺艾尔",
                                                    "text": "没有没有！我感到很荣幸哦。"
                                                },
                                                {
                                                    "id": "690340315",
                                                    "speaker": "诺艾尔",
                                                    "text": "不过，这样说起来。"
                                                },
                                                {
                                                    "id": "690340316",
                                                    "speaker": "诺艾尔",
                                                    "text": "这处家园一直都很干净呢。"
                                                },
                                                {
                                                    "id": "690340317",
                                                    "speaker": "Player",
                                                    "text": "其中也有诺艾尔的功劳。"
                                                },
                                                {
                                                    "id": "690340318",
                                                    "speaker": "诺艾尔",
                                                    "text": "谢谢…"
                                                },
                                                {
                                                    "id": "690340319",
                                                    "speaker": "诺艾尔",
                                                    "text": "我工作的时候非常有干劲！比打扫骑士团或者其他任何地方都要高兴。"
                                                },
                                                {
                                                    "id": "690340320",
                                                    "speaker": "诺艾尔",
                                                    "text": "因为…这可是你的家呀。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690340313",
                                            "text": "最后它们都去哪里了呢？",
                                            "response": [
                                                {
                                                    "id": "690340314",
                                                    "speaker": "诺艾尔",
                                                    "text": "我会尽全力为它们找到失主！但也有一部分没人认领的，会被留在骑士团里。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690340306",
                            "text": "诺艾尔还有捡东西的习惯？",
                            "response": [
                                {
                                    "id": "690340307",
                                    "speaker": "诺艾尔",
                                    "text": "不，不是啦。是清扫工作中遇到的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903404",
            "initDialog": "690340401",
            "dialogues": [
                {
                    "id": "690340401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690340402",
                    "speaker": "诺艾尔",
                    "text": "欸？问我吗…"
                },
                {
                    "id": "690340403",
                    "speaker": "诺艾尔",
                    "text": "我…我想量一量你的身高尺码，为你做一身衣服。",
                    "choices": [
                        {
                            "id": "690340404",
                            "text": "怎么会突然想到这个？",
                            "response": [
                                {
                                    "id": "690340407",
                                    "speaker": "诺艾尔",
                                    "text": "如果能让你平时穿我做的衣服…"
                                },
                                {
                                    "id": "690340408",
                                    "speaker": "诺艾尔",
                                    "text": "那一定是一件很幸福很幸福的事情…",
                                    "choices": [
                                        {
                                            "id": "690340409",
                                            "text": "那就要辛苦你了。",
                                            "response": [
                                                {
                                                    "id": "690340411",
                                                    "speaker": "诺艾尔",
                                                    "text": "嗯…嗯…"
                                                },
                                                {
                                                    "id": "690340412",
                                                    "speaker": "诺艾尔",
                                                    "text": "太好了。又要忙碌起来了！"
                                                },
                                                {
                                                    "id": "690340413",
                                                    "speaker": "诺艾尔",
                                                    "text": "不过，这是提瓦特大陆上，最幸福的忙碌了吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690340410",
                                            "text": "到时候…我也会为诺艾尔准备回礼的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690340405",
                            "text": "诺艾尔连缝纫都会吗？",
                            "response": [
                                {
                                    "id": "690340406",
                                    "speaker": "诺艾尔",
                                    "text": "那，那当然了…毕竟我是「万能女仆」嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903405",
            "initDialog": "690340501",
            "dialogues": [
                {
                    "id": "690340501",
                    "speaker": "Player",
                    "text": "早啊，诺艾尔。"
                },
                {
                    "id": "690340502",
                    "speaker": "诺艾尔",
                    "text": "#嗯，{NICKNAME}早。"
                },
                {
                    "id": "690340503",
                    "speaker": "诺艾尔",
                    "text": "最近的气候变化比较大，还请当心不要感冒了哦。"
                }
            ]
        },
        {
            "talkId": "6903406",
            "initDialog": "690340601",
            "dialogues": [
                {
                    "id": "690340601",
                    "speaker": "Player",
                    "text": "晚安，诺艾尔。"
                },
                {
                    "id": "690340602",
                    "speaker": "诺艾尔",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690340603",
                    "speaker": "诺艾尔",
                    "text": "需要热牛奶或者催眠曲的话，我会在此恭候你的差遣。"
                }
            ]
        },
        {
            "talkId": "6903407",
            "initDialog": "690340701",
            "dialogues": [
                {
                    "id": "690340701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903408",
            "initDialog": "690340801",
            "dialogues": [
                {
                    "id": "690340801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903409",
            "initDialog": "690340901",
            "dialogues": [
                {
                    "id": "690340901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903450",
            "initDialog": "690345001",
            "dialogues": [
                {
                    "id": "690345001",
                    "speaker": "诺艾尔",
                    "text": "有了这些设备，保养武器就方便了。"
                },
                {
                    "id": "690345002",
                    "speaker": "诺艾尔",
                    "text": "毕竟为了守护大家，必须随时做好战斗准备！"
                },
                {
                    "id": "690345003",
                    "speaker": "诺艾尔",
                    "text": "谢谢你做的这些，你…也是我要守护的人。"
                }
            ]
        },
        {
            "talkId": "6903451",
            "initDialog": "690345101",
            "dialogues": [
                {
                    "id": "690345101",
                    "speaker": "诺艾尔",
                    "text": "这些都是你亲手布置的吗？"
                },
                {
                    "id": "690345102",
                    "speaker": "诺艾尔",
                    "text": "没早点来帮忙，让你做了这么辛苦的工作，是女仆的失职。"
                },
                {
                    "id": "690345103",
                    "speaker": "诺艾尔",
                    "text": "忙碌了半天一定很累吧，我来为你泡茶，再准备上你喜欢的茶点…请好好休息。"
                }
            ]
        }
    ]
}