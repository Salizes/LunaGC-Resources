{
    "groupId": "4187",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "兰般度": 13
    },
    "talks": [
        {
            "talkId": "6418701",
            "initDialog": "641870101",
            "dialogues": [
                {
                    "id": "641870101",
                    "speaker": "兰般度",
                    "text": "金色的那菈每次都能帮助兰那罗解决问题，可惜金色的那菈太少了。"
                }
            ]
        },
        {
            "talkId": "6418702",
            "initDialog": "641870201",
            "dialogues": [
                {
                    "id": "641870201",
                    "speaker": "Player",
                    "text": "关于金色那菈…"
                },
                {
                    "id": "641870202",
                    "speaker": "兰般度",
                    "text": "兰般度见过许多那菈，高大又阴暗的坏那菈见过不少。"
                },
                {
                    "id": "641870203",
                    "speaker": "兰般度",
                    "text": "#可是金色的那菈，除了那菈法留纳，就只有那菈{NICKNAME}了。"
                }
            ]
        },
        {
            "talkId": "6418703",
            "initDialog": "641870301",
            "dialogues": [
                {
                    "id": "641870301",
                    "speaker": "Player",
                    "text": "关于维摩庄…"
                },
                {
                    "id": "641870302",
                    "speaker": "兰般度",
                    "text": "维摩庄的怪事，兰拉娜知道。"
                },
                {
                    "id": "641870303",
                    "speaker": "兰般度",
                    "text": "可是她在用兰迦拉梨。保护那菈拉娜，等到无忧节结束，可以再去寻找答案。"
                }
            ]
        },
        {
            "talkId": "6418704",
            "initDialog": "641870401",
            "dialogues": [
                {
                    "id": "641870401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641870402",
                    "speaker": "兰般度",
                    "text": "再见，金色的那菈。"
                }
            ]
        },
        {
            "talkId": "6418705",
            "initDialog": "641870501",
            "dialogues": [
                {
                    "id": "641870501",
                    "speaker": "兰般度",
                    "text": "#太阳升起时叫做「法留纳神机」，月亮升起时叫做「{NICKNAME}神机」？"
                }
            ]
        },
        {
            "talkId": "6418706",
            "initDialog": "641870601",
            "dialogues": [
                {
                    "id": "641870601",
                    "speaker": "Player",
                    "text": "你在说什么？"
                },
                {
                    "id": "641870602",
                    "speaker": "兰般度",
                    "text": "#啊，是那菈{NICKNAME}。"
                },
                {
                    "id": "641870603",
                    "speaker": "兰般度",
                    "text": "#因为那菈{NICKNAME}治好了法留纳神机，让树叶与种子重新恢复了生气。"
                },
                {
                    "id": "641870604",
                    "speaker": "兰般度",
                    "text": "#所以想要把「法留纳神机」叫做「{NICKNAME}神机」，为了感谢。"
                },
                {
                    "id": "641870605",
                    "speaker": "兰般度",
                    "text": "可是如果那菈法留纳回来，会伤心的。"
                },
                {
                    "id": "641870606",
                    "speaker": "兰般度",
                    "text": "#所以我在想办法，既能让那菈{NICKNAME}开心，也能让那菈法留纳开心。"
                }
            ]
        },
        {
            "talkId": "6418707",
            "initDialog": "641870701",
            "dialogues": [
                {
                    "id": "641870701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641870702",
                    "speaker": "兰般度",
                    "text": "#唔，不知道叫什么，等想好了再告诉那菈{NICKNAME}。"
                }
            ]
        }
    ]
}