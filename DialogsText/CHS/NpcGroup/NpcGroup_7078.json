{
    "groupId": "7078",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "里卡司": 10
    },
    "talks": [
        {
            "talkId": "6707801",
            "initDialog": "670780101",
            "dialogues": [
                {
                    "id": "670780101",
                    "speaker": "里卡司",
                    "text": "人生的秘诀，当然就是买房子了。别的都是虚妄。"
                }
            ]
        },
        {
            "talkId": "6707802",
            "initDialog": "670780201",
            "dialogues": [
                {
                    "id": "670780201",
                    "speaker": "Player",
                    "text": "好像有些绝对了…"
                },
                {
                    "id": "670780202",
                    "speaker": "里卡司",
                    "text": "哦？是吗？所以像我这样，什么工作都不用做，隔三差五就可以跑去枫丹、须弥旅游的生活，你不想过？"
                }
            ]
        },
        {
            "talkId": "6707803",
            "initDialog": "670780301",
            "dialogues": [
                {
                    "id": "670780301",
                    "speaker": "Player",
                    "text": "…多谢你的秘诀。"
                },
                {
                    "id": "670780302",
                    "speaker": "里卡司",
                    "text": "哎？这就走了？行吧，年轻人嘛，终归要自己碰一碰才懂。"
                }
            ]
        },
        {
            "talkId": "6707804",
            "initDialog": "670780401",
            "dialogues": [
                {
                    "id": "670780401",
                    "speaker": "Player",
                    "text": "…想。"
                },
                {
                    "id": "670780402",
                    "speaker": "里卡司",
                    "text": "对嘛，这才叫坦诚。跟你说，别的都是虚的，有了房子就什么都有了。"
                },
                {
                    "id": "670780403",
                    "speaker": "里卡司",
                    "text": "一看你就是跑来那夏镇闯一闯的小年轻！你信我的，赚了钱就老老实实在这里买房子。我看这房价，还得涨！"
                },
                {
                    "id": "670780404",
                    "speaker": "里卡司",
                    "text": "要是花在了别的地方，小心被人骗到底裤都不剩，下面的广场上可都是这样的倒霉蛋。"
                }
            ]
        },
        {
            "talkId": "6707805",
            "initDialog": "670780501",
            "dialogues": [
                {
                    "id": "670780501",
                    "speaker": "Player",
                    "text": "不想！"
                },
                {
                    "id": "670780502",
                    "speaker": "里卡司",
                    "text": "哈！倒是挺嘴硬的。我跟你说，从那夏镇还是一个小渔村的时候我就开始买房子了。"
                },
                {
                    "id": "670780503",
                    "speaker": "里卡司",
                    "text": "当年跟我差不多收入的，少有我这样有眼光的。那会儿大家都时兴买船，船么，只会贬值。但我的房子，涨了十倍都不止了吧！"
                },
                {
                    "id": "670780504",
                    "speaker": "里卡司",
                    "text": "那些老东西要是看到我现在的生活，估计恨不得把船都炸沉了，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6707806",
            "initDialog": "670780601",
            "dialogues": [
                {
                    "id": "670780601",
                    "speaker": "Player",
                    "text": "我已经过上了。"
                },
                {
                    "id": "670780602",
                    "speaker": "里卡司",
                    "text": "哟！看不出来。那倒也…挺不错的。我看你、你肯定是在别的地方有房子了吧？怪不得这样有底气…"
                }
            ]
        }
    ]
}