{
    "groupId": "7466",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "拉克季奥诺夫": 12
    },
    "talks": [
        {
            "talkId": "6746601",
            "initDialog": "674660101",
            "dialogues": [
                {
                    "id": "674660101",
                    "speaker": "拉克季奥诺夫",
                    "text": "最新最爆炸的新闻，来一份吧！"
                }
            ]
        },
        {
            "talkId": "6746602",
            "initDialog": "674660201",
            "dialogues": [
                {
                    "id": "674660201",
                    "speaker": "Player",
                    "text": "有多爆炸？"
                },
                {
                    "id": "674660202",
                    "speaker": "拉克季奥诺夫",
                    "text": "像进口的烟花炸开那样，整个夜空都是鲜艳的光芒…"
                },
                {
                    "id": "674660203",
                    "speaker": "拉克季奥诺夫",
                    "text": "如果选好烟花的种类，摆放好位置，效果堪比在天上装满五颜六色的灯！"
                }
            ]
        },
        {
            "talkId": "6746603",
            "initDialog": "674660301",
            "dialogues": [
                {
                    "id": "674660301",
                    "speaker": "Player",
                    "text": "有没有平和点的新闻…"
                },
                {
                    "id": "674660302",
                    "speaker": "拉克季奥诺夫",
                    "text": "抱歉，那你要去找卡缇娅，我这里没有平平淡淡的报纸。"
                },
                {
                    "id": "674660303",
                    "speaker": "拉克季奥诺夫",
                    "text": "呃…我指的是，对我自己来说，每条新闻都很有趣。"
                },
                {
                    "id": "674660304",
                    "speaker": "拉克季奥诺夫",
                    "text": "看你气质不凡，谈吐优雅，和其他人都不一样——"
                },
                {
                    "id": "674660305",
                    "speaker": "拉克季奥诺夫",
                    "text": "如果对报纸的趣味度不满意，你尽管说，我去给编辑提意见！"
                }
            ]
        },
        {
            "talkId": "6746604",
            "initDialog": "674660401",
            "dialogues": [
                {
                    "id": "674660401",
                    "speaker": "Player",
                    "text": "下次再买。"
                },
                {
                    "id": "674660402",
                    "speaker": "拉克季奥诺夫",
                    "text": "那…我每天都给你留一份报纸，等你来买。"
                }
            ]
        },
        {
            "talkId": "6746605",
            "initDialog": "674660501",
            "dialogues": [
                {
                    "id": "674660501",
                    "speaker": "Player",
                    "text": "怎么说得你好像很熟一样…"
                },
                {
                    "id": "674660502",
                    "speaker": "拉克季奥诺夫",
                    "text": "对啊，以前我爸花大价钱，带我放过厉害的璃月烟花！"
                },
                {
                    "id": "674660503",
                    "speaker": "拉克季奥诺夫",
                    "text": "可是后来，我老是和他吵架，就再也没一起那样玩了…"
                },
                {
                    "id": "674660504",
                    "speaker": "拉克季奥诺夫",
                    "text": "我没出息，没能读上前途光明的艺术学校，他揍我也揍得很有道理…"
                },
                {
                    "id": "674660505",
                    "speaker": "拉克季奥诺夫",
                    "text": "呃咳，扯远了，总之，相信我卖的报纸有够有料就行！"
                }
            ]
        }
    ]
}