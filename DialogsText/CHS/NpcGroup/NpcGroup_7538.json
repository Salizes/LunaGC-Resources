    "talks": [
        {
            "talkId": "6753801",
            "initDialog": "675380101",
            "dialogues": [
                {
                    "id": "675380101",
                    "speaker": "奥茜珀娃",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6753802",
            "initDialog": "675380201",
            "dialogues": [
                {
                    "id": "675380201",
                    "speaker": "Player",
                    "text": "你也是来看演出的吗？"
                },
                {
                    "id": "675380202",
                    "speaker": "奥茜珀娃",
                    "text": "…请问有什么事吗？"
                },
                {
                    "id": "675380203",
                    "speaker": "奥茜珀娃",
                    "text": "我们应该不认识吧？很抱歉，我不想在演出前进行任何无意义的社交。"
                }
            ]
        },
        {
            "talkId": "6753803",
            "initDialog": "675380301",
            "dialogues": [
                {
                    "id": "675380301",
                    "speaker": "Player",
                    "text": "没事…"
                },
                {
                    "id": "675380302",
                    "speaker": "奥茜珀娃",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6753804",
            "initDialog": "675380401",
            "dialogues": [
                {
                    "id": "675380401",
                    "speaker": "Player",
                    "text": "关于最近演出的剧目…"
                },
                {
                    "id": "675380402",
                    "speaker": "奥茜珀娃",
                    "text": "您来之前都不看演出时间表的吗？又或者只是想随便找个攀谈的话题？"
                },
                {
                    "id": "675380403",
                    "speaker": "奥茜珀娃",
                    "text": "倘若您一定要问的话，最近演出的剧目里，我最喜欢的当然还是《冰湖之死》。我认为每一个至冬人都不应该错过这幕剧。"
                },
                {
                    "id": "675380404",
                    "speaker": "奥茜珀娃",
                    "text": "总之，如果没有其它事情的话，请不要再和我搭话了。"
                }
            ]
        },
        {
            "talkId": "6753805",
            "initDialog": "675380501",
            "dialogues": [
                {
                    "id": "675380501",
                    "speaker": "Player",
                    "text": "好吧。"
                },
                {
                    "id": "675380502",
                    "speaker": "奥茜珀娃",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6753806",
            "initDialog": "675380601",
            "dialogues": [
                {
                    "id": "675380601",
                    "speaker": "Player",
                    "text": "我知道，是沃雅妮莎主演的…"
                },
                {
                    "id": "675380602",
                    "speaker": "奥茜珀娃",
                    "text": "没错，您也看过她的《冰湖之死》吗？那么我必须承认，我就是为了沃雅妮莎小姐而来的。"
                },
                {
                    "id": "675380603",
                    "speaker": "奥茜珀娃",
                    "text": "不知道你是否记得她第三幕的第二个唱段。那种绝望中带着圣洁的颤抖，简直就像是永恒的天使从天国降下附在了她的身上！"
                },
                {
                    "id": "675380604",
                    "speaker": "奥茜珀娃",
                    "text": "如果您感兴趣的话，下周三还有一场她个人的独唱，我这里正好多了张票…"
                },
                {
                    "id": "675380605",
                    "speaker": "奥茜珀娃",
                    "text": "咳，别误会，我只是希望能有更多的人喜欢上这样优秀的歌手。"
                }
            ]
        }
    ]
}