{
    "groupId": "3079",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 9,
        "秋月": 27
    },
    "talks": [
        {
            "talkId": "4006305",
            "initDialog": "400630501",
            "dialogues": [
                {
                    "id": "400630501",
                    "speaker": "秋月",
                    "text": "最近总是有人问我知不知道来自璃月的「枕玉」老师在哪，可我完全没听说过这个人。"
                },
                {
                    "id": "400630502",
                    "speaker": "秋月",
                    "text": "难道他是什么名人，比七星还要显赫吗？"
                },
                {
                    "id": "400630503",
                    "speaker": "秋月",
                    "text": "啊抱歉，客人久等了，请问要来些璃月的矿石吗？"
                }
            ]
        },
        {
            "talkId": "5900005",
            "initDialog": "590000501",
            "dialogues": [
                {
                    "id": "590000501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900006",
            "initDialog": "590000601",
            "dialogues": [
                {
                    "id": "590000601",
                    "speaker": "秋月",
                    "text": "唔…最近的话，还是老样子，从璃月进货的渠道还是很难打通…没什么特别的变化。"
                }
            ]
        },
        {
            "talkId": "5900063",
            "initDialog": "590006301",
            "dialogues": [
                {
                    "id": "590006301",
                    "speaker": "秋月",
                    "text": "唔…最近的话，似乎想要来离岛开店的人越来越多了。"
                },
                {
                    "id": "590006302",
                    "speaker": "秋月",
                    "text": "虽然可能会有生意上的竞争，但顾客也随之变多了，总体上算是好事吧。"
                }
            ]
        },
        {
            "talkId": "6307901",
            "initDialog": "630790101",
            "dialogues": [
                {
                    "id": "630790101",
                    "speaker": "秋月",
                    "text": "客官，要来些璃月的矿石吗？"
                }
            ]
        },
        {
            "talkId": "6307902",
            "initDialog": "630790201",
            "dialogues": [
                {
                    "id": "630790201",
                    "speaker": "Player",
                    "text": "我想买些矿石。"
                },
                {
                    "id": "630790202",
                    "speaker": "秋月",
                    "text": "来，请在这里挑吧，都是上品！"
                }
            ]
        },
        {
            "talkId": "6307903",
            "initDialog": "630790301",
            "dialogues": [
                {
                    "id": "630790301",
                    "speaker": "Player",
                    "text": "关于这家店…"
                },
                {
                    "id": "630790302",
                    "speaker": "秋月",
                    "text": "本店是「楚瑜商行」在稻妻开设的分店，主要经营矿石、珠宝玉器的生意。"
                },
                {
                    "id": "630790303",
                    "speaker": "秋月",
                    "text": "我们的货可都是上好的璃月矿石，每一块都是岩王爷的恩赐。"
                },
                {
                    "id": "630790304",
                    "speaker": "秋月",
                    "text": "虽然名号不如「解翠行」、「明星斋」那样的老字号响亮，但质量一点都不比他们差！"
                }
            ]
        },
        {
            "talkId": "6307904",
            "initDialog": "630790401",
            "dialogues": [
                {
                    "id": "630790401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630790402",
                    "speaker": "秋月",
                    "text": "客官慢走，欢迎再来。"
                }
            ]
        },
        {
            "talkId": "6307905",
            "initDialog": "630790501",
            "dialogues": [
                {
                    "id": "630790501",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "630790502",
                    "speaker": "秋月",
                    "text": "还可以，毕竟矿石这个东西不管在哪都有需求嘛。"
                },
                {
                    "id": "630790503",
                    "speaker": "秋月",
                    "text": "…只要有需求就有市场，我们璃月商人可不会错过商机！"
                },
                {
                    "id": "630790504",
                    "speaker": "秋月",
                    "text": "只是受「锁国令」影响，进货渠道多少还是被影响了…唉，真是让人头疼啊。"
                }
            ]
        },
        {
            "talkId": "6307906",
            "initDialog": "630790601",
            "dialogues": [
                {
                    "id": "630790601",
                    "speaker": "Player",
                    "text": "关于岩王帝君…"
                },
                {
                    "id": "630790602",
                    "speaker": "秋月",
                    "text": "你是想说岩王帝君的离去么？这件事我已经听说了。"
                },
                {
                    "id": "630790603",
                    "speaker": "秋月",
                    "text": "事情发生时稻妻锁国已经开始，我也没能赶上「送仙典仪」…"
                },
                {
                    "id": "630790604",
                    "speaker": "秋月",
                    "text": "唉，这件事令人心痛，没有一个璃月子民不会为此难过…"
                }
            ]
        },
        {
            "talkId": "6307907",
            "initDialog": "630790701",
            "dialogues": [
                {
                    "id": "630790701",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "630790702",
                    "speaker": "秋月",
                    "text": "最近很不错哦，一是因为矿石不管在哪都有需求嘛，只要有需求就有市场，我们璃月商人可不会错过商机！"
                },
                {
                    "id": "630790703",
                    "speaker": "秋月",
                    "text": "另一方面当然是因为商路通畅后，进货的渠道和买家自然也变多了。"
                },
                {
                    "id": "630790704",
                    "speaker": "秋月",
                    "text": "不瞒你说，等我再多攒些本金，还想去稻妻城开家分店！"
                },
                {
                    "id": "630790705",
                    "speaker": "秋月",
                    "text": "在这里应该还没有矿石生意能比得上我家的竞争对手，我可得好好把握机会才是。"
                }
            ]
        },
        {
            "talkId": "6307908",
            "initDialog": "630790801",
            "dialogues": [
                {
                    "id": "630790801",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6307909",
            "initDialog": "630790901",
            "dialogues": [
                {
                    "id": "630790901",
                    "speaker": "秋月",
                    "text": "…这都让你过了，怎么会…等等，让我复盘一下…"
                }
            ]
        },
        {
            "talkId": "6307910",
            "initDialog": "630791001",
            "dialogues": [
                {
                    "id": "630791001",
                    "speaker": "秋月",
                    "text": "怎么样，我「七圣召唤」的水平可不会输给任何人！"
                }
            ]
        },
        {
            "talkId": "7290601",
            "initDialog": "729060101",
            "dialogues": [
                {
                    "id": "729060101",
                    "speaker": "Player",
                    "text": "我见证了送仙典仪…"
                },
                {
                    "id": "729060102",
                    "speaker": "秋月",
                    "text": "哎呀，原来您就是传闻中那位协助完成送仙典仪的异国旅者！"
                },
                {
                    "id": "729060103",
                    "speaker": "秋月",
                    "text": "真是失敬。我作为岩王帝君的子民，要好好感谢您才行。"
                },
                {
                    "id": "729060104",
                    "speaker": "秋月",
                    "text": "这份薄礼，还请您不要推辞，一定要收下。"
                }
            ]
        }
    ]
}