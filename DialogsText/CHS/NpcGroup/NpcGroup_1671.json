{
    "groupId": "1671",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "里瑟": 9
    },
    "talks": [
        {
            "talkId": "6167101",
            "initDialog": "616710101",
            "dialogues": [
                {
                    "id": "616710101",
                    "speaker": "里瑟",
                    "text": "你好，如果是想上雪山的话，请多加小心。"
                }
            ]
        },
        {
            "talkId": "6167102",
            "initDialog": "616710201",
            "dialogues": [
                {
                    "id": "616710201",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "616710202",
                    "speaker": "里瑟",
                    "text": "我奉代理团长大人的命令在这里驻守，警告蒙德的居民不要上雪山。"
                },
                {
                    "id": "616710203",
                    "speaker": "里瑟",
                    "text": "前段时间我就拦下过想要上山野营的一家三口、几个想去山顶打雪仗的小孩子什么的。"
                },
                {
                    "id": "616710204",
                    "speaker": "里瑟",
                    "text": "不过也不能怪他们缺少警惕性，如今蒙德城的生活真是太过安逸了，以至于大多数人都无法想象雪山的环境是何等的恶劣…"
                }
            ]
        },
        {
            "talkId": "6167103",
            "initDialog": "616710301",
            "dialogues": [
                {
                    "id": "616710301",
                    "speaker": "Player",
                    "text": "这里的环境…"
                },
                {
                    "id": "616710302",
                    "speaker": "里瑟",
                    "text": "说到这个，在这里活动一定要多穿些，可别被冻到了。"
                },
                {
                    "id": "616710303",
                    "speaker": "里瑟",
                    "text": "像我的不少同僚来过一次之后便再也不敢来了。"
                },
                {
                    "id": "616710304",
                    "speaker": "里瑟",
                    "text": "嗯？你问我为什么不怕冷？"
                },
                {
                    "id": "616710305",
                    "speaker": "里瑟",
                    "text": "因为我有如钢铁般坚毅的意志和不惧寒风的坚强体魄…以及我还在铠甲里套了三四层衣服，绝对保暖。"
                }
            ]
        },
        {
            "talkId": "6167104",
            "initDialog": "616710401",
            "dialogues": [
                {
                    "id": "616710401",
                    "speaker": "Player",
                    "text": "谢谢你的提醒，再见。"
                },
                {
                    "id": "616710402",
                    "speaker": "里瑟",
                    "text": "愿巴巴托斯大人的风护佑你。"
                }
            ]
        }
    ]
}