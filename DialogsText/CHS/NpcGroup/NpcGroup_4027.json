{
    "groupId": "4027",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "贾法尔": 16
    },
    "talks": [
        {
            "talkId": "6402701",
            "initDialog": "640270101",
            "dialogues": [
                {
                    "id": "640270101",
                    "speaker": "贾法尔",
                    "text": "哪怕是学者，也该有属于自己的生活啊。"
                }
            ]
        },
        {
            "talkId": "6402702",
            "initDialog": "640270201",
            "dialogues": [
                {
                    "id": "640270201",
                    "speaker": "Player",
                    "text": "你是学者？"
                },
                {
                    "id": "640270202",
                    "speaker": "贾法尔",
                    "text": "很不幸，确实是。"
                },
                {
                    "id": "640270203",
                    "speaker": "贾法尔",
                    "text": "但万幸的是，我比其他同僚多懂得一个道理——学术，并不是生活的全部。"
                },
                {
                    "id": "640270204",
                    "speaker": "贾法尔",
                    "text": "整天埋头苦干的话，无论研究成果多么卓越，也会被生活抛下的。"
                },
                {
                    "id": "640270205",
                    "speaker": "贾法尔",
                    "text": "所以啊，还是要多和身边的人接触，喝喝酒，谈谈天，才能维持身心的舒畅。"
                },
                {
                    "id": "640270206",
                    "speaker": "贾法尔",
                    "text": "虽然代价可能是晚上加倍的埋头苦干，但转念一想，白天总是有学生来办公室里问这问那，那我还不如深夜研究，图个清静呢。"
                }
            ]
        },
        {
            "talkId": "6402703",
            "initDialog": "640270301",
            "dialogues": [
                {
                    "id": "640270301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640270302",
                    "speaker": "贾法尔",
                    "text": "再见，要懂得享受生活啊！"
                }
            ]
        },
        {
            "talkId": "6402704",
            "initDialog": "640270401",
            "dialogues": [
                {
                    "id": "640270401",
                    "speaker": "贾法尔",
                    "text": "让我算算，离截稿期还有…"
                }
            ]
        },
        {
            "talkId": "6402705",
            "initDialog": "640270501",
            "dialogues": [
                {
                    "id": "640270501",
                    "speaker": "Player",
                    "text": "截稿期？"
                },
                {
                    "id": "640270502",
                    "speaker": "贾法尔",
                    "text": "嗯，就是论文提交的截止时间嘛。"
                },
                {
                    "id": "640270503",
                    "speaker": "贾法尔",
                    "text": "因为我是只有在晚上才能安静思考问题的类型，所以天生就比别人少了一半的科研时间呢。"
                },
                {
                    "id": "640270504",
                    "speaker": "贾法尔",
                    "text": "你说白天？白天太阳那么好，当然要出门享受生活了。"
                },
                {
                    "id": "640270505",
                    "speaker": "贾法尔",
                    "text": "我是一定要分出时间休息和娱乐的啦，如果全天都处在学术氛围之中，脑子反而会僵掉，无法正常思考。"
                },
                {
                    "id": "640270506",
                    "speaker": "贾法尔",
                    "text": "不多说了，我要高效利用我仅有的一半时间，在截稿期之前做出成果…"
                }
            ]
        },
        {
            "talkId": "6402706",
            "initDialog": "640270601",
            "dialogues": [
                {
                    "id": "640270601",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "640270602",
                    "speaker": "贾法尔",
                    "text": "嗯…还行，时间应该够用…"
                }
            ]
        },
        {
            "talkId": "7392901",
            "initDialog": "739290101",
            "dialogues": [
                {
                    "id": "739290101",
                    "speaker": "Player",
                    "text": "要注意身体哦。"
                },
                {
                    "id": "739290102",
                    "speaker": "贾法尔",
                    "text": "唉，也是。道理我都懂，但我实在受不了自己的人生全被研究占据。"
                },
                {
                    "id": "739290103",
                    "speaker": "贾法尔",
                    "text": "没关系，我会多喝牛奶，注意睡眠质量的，你也共勉吧。"
                }
            ]
        }
    ]
}