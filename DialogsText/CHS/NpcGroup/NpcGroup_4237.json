{
    "groupId": "4237",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "兰耶娑": 7
    },
    "talks": [
        {
            "talkId": "6423701",
            "initDialog": "642370101",
            "dialogues": [
                {
                    "id": "642370101",
                    "speaker": "兰耶娑",
                    "text": "#「命运织就迷途的网，无法让{M#她}{F#他}的旅途放缓一个日升月落。」"
                }
            ]
        },
        {
            "talkId": "6423702",
            "initDialog": "642370201",
            "dialogues": [
                {
                    "id": "642370201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "642370202",
                    "speaker": "兰耶娑",
                    "text": "「漂流的花朵聚集在千树的怀抱，即将唱起梦的歌。」"
                }
            ]
        },
        {
            "talkId": "6423703",
            "initDialog": "642370301",
            "dialogues": [
                {
                    "id": "642370301",
                    "speaker": "Player",
                    "text": "关于兰拉吉…"
                },
                {
                    "id": "642370302",
                    "speaker": "兰耶娑",
                    "text": "「藏身于阴影之中的种子，开出了高悬的太阳也未曾目睹的星光。」"
                },
                {
                    "id": "642370303",
                    "speaker": "兰耶娑",
                    "text": "#谢谢你，那菈{M#先生}{F#小姐}，让兰耶娑能够再次听到兰拉吉的歌。"
                }
            ]
        },
        {
            "talkId": "6423704",
            "initDialog": "642370401",
            "dialogues": [
                {
                    "id": "642370401",
                    "speaker": "兰耶娑",
                    "text": "#「为了再度相逢于千树繁茂的国…命运无法追及{M#她}{F#他}的脚步。」"
                }
            ]
        },
        {
            "talkId": "6423705",
            "initDialog": "642370501",
            "dialogues": [
                {
                    "id": "642370501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642370502",
                    "speaker": "兰耶娑",
                    "text": "「繁星渺茫，但也是光亮的灯火，鸟雀啁哳，但也会伴你憩息。」"
                }
            ]
        },
        {
            "talkId": "6423706",
            "initDialog": "642370601",
            "dialogues": [
                {
                    "id": "642370601",
                    "speaker": "兰耶娑",
                    "text": "「…将你的歌永远唱下去，这是我与你之间的约定。」"
                }
            ]
        }
    ]
}