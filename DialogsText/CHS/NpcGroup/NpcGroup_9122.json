{
    "groupId": "9122",
    "total_dialogue_lines": 78,
    "speaker_counts": {
        "Player": 25,
        "奈芙尔": 53
    },
    "talks": [
        {
            "talkId": "6912201",
            "initDialog": "691220101",
            "dialogues": [
                {
                    "id": "691220101",
                    "speaker": "奈芙尔",
                    "text": "虽说每个人都有着自己的小秘密…"
                },
                {
                    "id": "691220102",
                    "speaker": "奈芙尔",
                    "text": "但你的这个「秘密」，是否有点太夸张了？"
                }
            ]
        },
        {
            "talkId": "6912202",
            "initDialog": "691220201",
            "dialogues": [
                {
                    "id": "691220201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691220202",
                    "speaker": "奈芙尔",
                    "text": "非常优秀的住所，没什么可挑剔的地方。"
                },
                {
                    "id": "691220203",
                    "speaker": "奈芙尔",
                    "text": "要我说的话，甚至有点过于安逸了，太容易滋生偷懒的心思。",
                    "choices": [
                        {
                            "id": "691220204",
                            "text": "本来就是休息的地方。",
                            "response": [
                                {
                                    "id": "691220206",
                                    "speaker": "奈芙尔",
                                    "text": "你说得也没错。但「偷懒」对我来说，实在是一个过于遥远的词汇。"
                                },
                                {
                                    "id": "691220207",
                                    "speaker": "奈芙尔",
                                    "text": "无论是挪德卡莱还是我那个遥远的老家，都没有让我安生过。"
                                },
                                {
                                    "id": "691220208",
                                    "speaker": "奈芙尔",
                                    "text": "呵呵，瞧你的表情，就差在脸上写着：「这家伙明明都是在让雅珂达去跑腿啊。」",
                                    "choices": [
                                        {
                                            "id": "691220209",
                                            "text": "欸…欸？",
                                            "response": [
                                                {
                                                    "id": "691220211",
                                                    "speaker": "奈芙尔",
                                                    "text": "骗你的，你刚才的表情最多算是「无理由的傻笑」，看来是想起了高兴的事。怎么？跑委托的时候赚了一大笔？",
                                                    "choices": [
                                                        {
                                                            "id": "691220212",
                                                            "text": "派蒙答应以后负责做早餐。",
                                                            "response": [
                                                                {
                                                                    "id": "691220213",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "哈哈哈，这样么？那这小家伙可要好好训练了，要是需要做一口专用锅的话，可以去找爱诺问问看。"
                                                                },
                                                                {
                                                                    "id": "691220214",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "看来，你的小旅伴终于要和你分担工作，让你们两个人在奔忙里尽量做到劳逸结合了？"
                                                                },
                                                                {
                                                                    "id": "691220217",
                                                                    "speaker": "Player",
                                                                    "text": "奈芙尔偶尔也放松一点吧。"
                                                                },
                                                                {
                                                                    "id": "691220218",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "我也这么希望。可惜挪德卡莱的诸位，还有我背后那位「大老板」并不希望我停下脚步。"
                                                                },
                                                                {
                                                                    "id": "691220219",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "不过，你还是给我留一间客房吧。说不定哪一天我就能真正开始休息了。"
                                                                },
                                                                {
                                                                    "id": "691220220",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "等到那一天…呵，算了，愿望说出来就不灵了，就说到这里吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691220215",
                                                            "text": "想起这几天不用做委托…",
                                                            "response": [
                                                                {
                                                                    "id": "691220216",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "嗯，这样也不错。劳逸结合，工作的效率才高。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691220210",
                                            "text": "有、有这么明显吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691220205",
                            "text": "就是用来偷懒的。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912203",
            "initDialog": "691220301",
            "dialogues": [
                {
                    "id": "691220301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691220302",
                    "speaker": "奈芙尔",
                    "text": "可以，想聊什么？是挪德卡莱赏金最高的通缉犯，还是黑市的通行口令？或者是…啊，你难不成是需要搞点好用的武器？"
                },
                {
                    "id": "691220303",
                    "speaker": "Player",
                    "text": "就聊点日常什么的…"
                },
                {
                    "id": "691220304",
                    "speaker": "奈芙尔",
                    "text": "嗯…这倒是稀奇，平时也没多少人和我聊过日常生活，你这个问题倒是把我难住了。"
                },
                {
                    "id": "691220305",
                    "speaker": "Player",
                    "text": "你和雅珂达平时聊点什么？"
                },
                {
                    "id": "691220306",
                    "speaker": "奈芙尔",
                    "text": "被她搞砸的委托，如何收拾这一桩被搞砸的委托，当然了，还有即将被她搞砸的委托。"
                },
                {
                    "id": "691220307",
                    "speaker": "奈芙尔",
                    "text": "然后是工资，谁来看店，谁给阿舍鲁喂猫粮…"
                },
                {
                    "id": "691220308",
                    "speaker": "奈芙尔",
                    "text": "啊，喂猫粮这个不用讨论，雅珂达都是抢着去的，阿舍鲁被她喂得都长胖了不少。"
                },
                {
                    "id": "691220309",
                    "speaker": "奈芙尔",
                    "text": "我正在考虑向爱诺订个「跑猫轮」，让阿舍鲁减减肥呢。",
                    "choices": [
                        {
                            "id": "691220310",
                            "text": "除了雅珂达和阿舍鲁之外…",
                            "response": [
                                {
                                    "id": "691220312",
                                    "speaker": "奈芙尔",
                                    "text": "朋友？那可多了，要是你也想认识一下我的那些「朋友」，我可以为你引荐。"
                                },
                                {
                                    "id": "691220313",
                                    "speaker": "Player",
                                    "text": "听着不像什么正经朋友…"
                                },
                                {
                                    "id": "691220314",
                                    "speaker": "奈芙尔",
                                    "text": "当然是正经朋友，那些先生女士可是我们「秘闻馆」的贵客，基于我们之间的友谊，往「秘闻馆」里投了不少钱。"
                                },
                                {
                                    "id": "691220315",
                                    "speaker": "奈芙尔",
                                    "text": "至少在那些摩拉消耗殆尽之前，我们之间的友谊都坚不可摧。",
                                    "choices": [
                                        {
                                            "id": "691220316",
                                            "text": "这应该是客户吧！",
                                            "response": [
                                                {
                                                    "id": "691220318",
                                                    "speaker": "奈芙尔",
                                                    "text": "在「秘闻馆」里，「客人」和「朋友」之间的界限并没有那么明确。"
                                                },
                                                {
                                                    "id": "691220319",
                                                    "speaker": "奈芙尔",
                                                    "text": "毕竟，我们贩卖的货物看不见也摸不着，既没有到货日期，有时候也没有售后保障。"
                                                },
                                                {
                                                    "id": "691220320",
                                                    "speaker": "奈芙尔",
                                                    "text": "要是没有坚实的「友谊」，还有从这份「友谊」里衍生出的「信任」，客人们怎么敢随便把宝贵的摩拉交给我呢？"
                                                },
                                                {
                                                    "id": "691220321",
                                                    "speaker": "Player",
                                                    "text": "那这种「友谊」是怎么建立的？"
                                                },
                                                {
                                                    "id": "691220322",
                                                    "speaker": "奈芙尔",
                                                    "text": "建立方式？嗯…其他的小技巧就不说了，但最重要的还是找到「共同点」。"
                                                },
                                                {
                                                    "id": "691220323",
                                                    "speaker": "奈芙尔",
                                                    "text": "例如共同的爱好，共同的习惯，共同的朋友…或者是敌人。相同之处，就是友谊的源头，只要稍加扩展，就能让这个源头衍生出一条长河。"
                                                },
                                                {
                                                    "id": "691220324",
                                                    "speaker": "奈芙尔",
                                                    "text": "当然，如果你能独自握住「源头」，那你就能把握住整条友谊之河。"
                                                },
                                                {
                                                    "id": "691220325",
                                                    "speaker": "奈芙尔",
                                                    "text": "到时候，这条河究竟是清澈还是浑浊，是自由地奔流还是绝望地干涸…都由你说了算。",
                                                    "choices": [
                                                        {
                                                            "id": "691220326",
                                                            "text": "我不想控制友谊。",
                                                            "response": [
                                                                {
                                                                    "id": "691220328",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "嗯，看得出来，你的确这么想。这应该就是你讨人喜欢的地方了。"
                                                                },
                                                                {
                                                                    "id": "691220329",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "不过，凡事还是当心点好。我见过不少人对人奉上真心，却被人把真心卖了个好价钱。"
                                                                },
                                                                {
                                                                    "id": "691220330",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "如果之后遇见看不准的人，可以来问问我。我会帮你看看，哪些是知恩图报的忠犬，哪些是伺机噬咬你的毒蛇。"
                                                                },
                                                                {
                                                                    "id": "691220331",
                                                                    "speaker": "奈芙尔",
                                                                    "text": "无论那条毒蛇将自己伪装成何物，都逃不过我的眼睛。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691220327",
                                                            "text": "友谊还是自然点好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691220317",
                                            "text": "你刚刚自己都说「贵客」了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691220311",
                            "text": "你在挪德卡莱有其他朋友吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912204",
            "initDialog": "691220401",
            "dialogues": [
                {
                    "id": "691220401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691220402",
                    "speaker": "奈芙尔",
                    "text": "你这个地方，应该算是与世隔绝，外人无法随意进出的，对吧？"
                },
                {
                    "id": "691220403",
                    "speaker": "Player",
                    "text": "算是…？"
                },
                {
                    "id": "691220404",
                    "speaker": "奈芙尔",
                    "text": "那正好，稍后我要借用你的客房写几封信。",
                    "choices": [
                        {
                            "id": "691220405",
                            "text": "专门借用这里的客房…？",
                            "response": [
                                {
                                    "id": "691220407",
                                    "speaker": "奈芙尔",
                                    "text": "难得来到一个天生具有保密功能的地方，我可要好好利用一下。"
                                },
                                {
                                    "id": "691220408",
                                    "speaker": "奈芙尔",
                                    "text": "你是不知道，平时我写信之前，为了保密要做多少工作，就算是一只虫子飞过，我也得把它抓住了之后再继续动笔。"
                                },
                                {
                                    "id": "691220409",
                                    "speaker": "奈芙尔",
                                    "text": "毕竟，我的那些「朋友们」，平时可都紧紧盯着我，想要踩着我的肩膀扬名立万呢。"
                                },
                                {
                                    "id": "691220410",
                                    "speaker": "奈芙尔",
                                    "text": "可惜啊，到目前为止，他们每个人都失败了，摔了个鼻青脸肿。"
                                },
                                {
                                    "id": "691220411",
                                    "speaker": "奈芙尔",
                                    "text": "但就算这么狼狈，他们还能绷着脸，继续和我虚与委蛇，从某种角度来说，我还挺佩服他们的。"
                                },
                                {
                                    "id": "691220412",
                                    "speaker": "奈芙尔",
                                    "text": "虽然脑子不灵光，行动没力气，但至少脸皮够厚。虽然总也吃不饱，但也饿不着。"
                                },
                                {
                                    "id": "691220413",
                                    "speaker": "奈芙尔",
                                    "text": "好了，我先去写信了。之后我可能会经常进壶里打扰。"
                                },
                                {
                                    "id": "691220414",
                                    "speaker": "奈芙尔",
                                    "text": "啊…就这么随意占据一个房间似乎也不太好，如果你想收房租的话，我们可以三个月一结算。好吗？"
                                }
                            ]
                        },
                        {
                            "id": "691220406",
                            "text": "你随便用，但到底是要…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912205",
            "initDialog": "691220501",
            "dialogues": [
                {
                    "id": "691220501",
                    "speaker": "Player",
                    "text": "早啊，奈芙尔。"
                },
                {
                    "id": "691220502",
                    "speaker": "奈芙尔",
                    "text": "早上好，看起来你还没睡醒，那要不要猜个谜语，让脑筋转起来？"
                },
                {
                    "id": "691220503",
                    "speaker": "奈芙尔",
                    "text": "开个玩笑，谁会在大早上猜谜，把这杯热水喝了吧，这样总能提神了。"
                }
            ]
        },
        {
            "talkId": "6912206",
            "initDialog": "691220601",
            "dialogues": [
                {
                    "id": "691220601",
                    "speaker": "Player",
                    "text": "晚安，奈芙尔。"
                },
                {
                    "id": "691220602",
                    "speaker": "奈芙尔",
                    "text": "晚安，睡吧。没想到都已经这个时间了，算了，正好去处理一些事务…"
                }
            ]
        },
        {
            "talkId": "6912210",
            "initDialog": "691221001",
            "dialogues": [
                {
                    "id": "691221001",
                    "speaker": "奈芙尔",
                    "text": "这栋屋子，确实很接近那夏镇的风格…不过，细微处还是欠缺了一点味道。"
                },
                {
                    "id": "691221002",
                    "speaker": "奈芙尔",
                    "text": "没了那些在屋里盘算的投机者，满怀野心的冒险家，一袋又一袋叮啷当啷作响的摩拉…"
                },
                {
                    "id": "691221003",
                    "speaker": "奈芙尔",
                    "text": "换言之，我的本领也无从发挥了啊。"
                }
            ]
        },
        {
            "talkId": "6912211",
            "initDialog": "691221101",
            "dialogues": [
                {
                    "id": "691221101",
                    "speaker": "奈芙尔",
                    "text": "真是难为你了，居然还费心模仿我那家小店的摆设。"
                },
                {
                    "id": "691221102",
                    "speaker": "奈芙尔",
                    "text": "而且…没了阿舍鲁的折腾，这书架上的书，倒是比我店里的书架整齐多了。"
                },
                {
                    "id": "691221103",
                    "speaker": "奈芙尔",
                    "text": "雅珂达怎么不收拾？噢，她收拾书的速度，比不上阿舍鲁扒拉书的速度，这也没办法。"
                }
            ]
        }
    ]
}