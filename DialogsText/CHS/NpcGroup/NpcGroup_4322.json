{
    "groupId": "4322",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "婕叶": 17
    },
    "talks": [
        {
            "talkId": "6432201",
            "initDialog": "643220101",
            "dialogues": [
                {
                    "id": "643220101",
                    "speaker": "婕叶",
                    "text": "哎呀，你是从很远的地方来的客人吗…"
                },
                {
                    "id": "643220102",
                    "speaker": "婕叶",
                    "text": "那可得在维摩庄好好休息一段时间，这里的环境可比沙漠里舒服多了…"
                }
            ]
        },
        {
            "talkId": "6432202",
            "initDialog": "643220201",
            "dialogues": [
                {
                    "id": "643220201",
                    "speaker": "Player",
                    "text": "关于沙漠的环境…"
                },
                {
                    "id": "643220202",
                    "speaker": "婕叶",
                    "text": "沙漠里啊，昼夜温差大得吓人，每天风吹日晒的…"
                },
                {
                    "id": "643220203",
                    "speaker": "婕叶",
                    "text": "年轻的时候不觉得，现在我呀，还是喜欢更湿润温暖的环境…"
                }
            ]
        },
        {
            "talkId": "6432203",
            "initDialog": "643220301",
            "dialogues": [
                {
                    "id": "643220301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "643220302",
                    "speaker": "婕叶",
                    "text": "再见，希望你享受这里平静的生活啊。"
                }
            ]
        },
        {
            "talkId": "6432204",
            "initDialog": "643220401",
            "dialogues": [
                {
                    "id": "643220401",
                    "speaker": "婕叶",
                    "text": "维摩庄的环境，比起沙漠来可好多了，小客人，就在这里好好休息一阵吧…"
                }
            ]
        },
        {
            "talkId": "6432205",
            "initDialog": "643220501",
            "dialogues": [
                {
                    "id": "643220501",
                    "speaker": "Player",
                    "text": "关于沙漠的环境…"
                },
                {
                    "id": "643220502",
                    "speaker": "婕叶",
                    "text": "沙漠里啊，昼夜温差大得吓人，每天风吹日晒的…"
                },
                {
                    "id": "643220503",
                    "speaker": "婕叶",
                    "text": "年轻的时候不觉得，现在我呀，还是喜欢更湿润温暖的环境…"
                }
            ]
        },
        {
            "talkId": "6432206",
            "initDialog": "643220601",
            "dialogues": [
                {
                    "id": "643220601",
                    "speaker": "Player",
                    "text": "关于优丹…"
                },
                {
                    "id": "643220602",
                    "speaker": "婕叶",
                    "text": "优丹啊…以前在维摩庄有一对外国的夫妇，他们离开之前，居然把优丹留了下来…"
                },
                {
                    "id": "643220603",
                    "speaker": "婕叶",
                    "text": "大家都有点不知所措…"
                },
                {
                    "id": "643220604",
                    "speaker": "婕叶",
                    "text": "我当时就觉得，多可怜的孩子呀，他们不愿养，就由我来养！"
                },
                {
                    "id": "643220605",
                    "speaker": "婕叶",
                    "text": "就当家里多了张吃饭的嘴，还能饿着他不成？"
                },
                {
                    "id": "643220606",
                    "speaker": "婕叶",
                    "text": "…优丹也是个懂事的孩子，可听我的话啦，现在，他能好好长大，就是我最大的心愿啦。"
                }
            ]
        },
        {
            "talkId": "6432207",
            "initDialog": "643220701",
            "dialogues": [
                {
                    "id": "643220701",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "643220702",
                    "speaker": "婕叶",
                    "text": "再见，希望你能享受这里平静的生活啊，小客人。"
                }
            ]
        },
        {
            "talkId": "7394701",
            "initDialog": "739470101",
            "dialogues": [
                {
                    "id": "739470101",
                    "speaker": "Player",
                    "text": "优丹一定会健康长大的。"
                },
                {
                    "id": "739470102",
                    "speaker": "婕叶",
                    "text": "谢谢你，小客人。优丹跟我说了许多你的事情，对你很钦佩呢。"
                },
                {
                    "id": "739470103",
                    "speaker": "婕叶",
                    "text": "你还很年轻，还有成长的空间。要好好吃饭，这样就能变得更强壮。这些给你。"
                },
                {
                    "id": "739470104",
                    "speaker": "婕叶",
                    "text": "将来呀，如果你觉得累了，想要休息一下，就到维摩庄来吧。优丹也会很开心的。"
                }
            ]
        }
    ]
}