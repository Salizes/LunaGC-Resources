{
    "groupId": "2209",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "蒂雅": 16
    },
    "talks": [
        {
            "talkId": "4003749",
            "initDialog": "400374901",
            "dialogues": [
                {
                    "id": "400374901",
                    "speaker": "蒂雅",
                    "text": "唉…为什么大人们都不同意让我们去屋顶呢？"
                },
                {
                    "id": "400374902",
                    "speaker": "蒂雅",
                    "text": "刚刚有个小女孩也是，她说想去屋顶看烟花，但她身边那个绿头发的哥哥不许…"
                },
                {
                    "id": "400374903",
                    "speaker": "蒂雅",
                    "text": "我听他们说是因为接下来还有别的事情要做…但我的时间多的很，爸爸却还是不让我去楼顶，究竟是为什么呢？"
                }
            ]
        },
        {
            "talkId": "4111537",
            "initDialog": "411153701",
            "dialogues": [
                {
                    "id": "411153701",
                    "speaker": "蒂雅",
                    "text": "梦是黑的还是白的呀，梦是不是另一个世界呢？我每次做梦，醒来都不记得发生什么了。"
                },
                {
                    "id": "411153702",
                    "speaker": "蒂雅",
                    "text": "但听说摸了那些奇怪的陨石后，会睡好久好久…在梦里那么久的话，醒来的时候就一定能够记住了吧？"
                }
            ]
        },
        {
            "talkId": "7193201",
            "initDialog": "719320101",
            "dialogues": [
                {
                    "id": "719320101",
                    "speaker": "Player",
                    "text": "旅行有意思吗？"
                },
                {
                    "id": "719320102",
                    "speaker": "蒂雅",
                    "text": "嗯！这是蒂雅第一次离开蒙德，外面真是太有趣了！"
                },
                {
                    "id": "719320103",
                    "speaker": "蒂雅",
                    "text": "蒂雅小时候只能看《少女薇拉的忧郁》，想象自己是薇拉，经历很多很多奇妙的冒险…！"
                },
                {
                    "id": "719320104",
                    "speaker": "蒂雅",
                    "text": "…这本《少女薇拉的忧郁》就送给你吧，只是因为翻了很多次有些旧了…"
                },
                {
                    "id": "719320105",
                    "speaker": "蒂雅",
                    "text": "现在蒂雅已经不需要这本书了，因为蒂雅真的在和爸爸冒险了，以后的经历一定会比小说还有趣的！"
                }
            ]
        },
        {
            "talkId": "6220901",
            "initDialog": "622090101",
            "dialogues": [
                {
                    "id": "622090101",
                    "speaker": "蒂雅",
                    "text": "你好啊。你一定来自很远的地方吧？"
                }
            ]
        },
        {
            "talkId": "6220902",
            "initDialog": "622090201",
            "dialogues": [
                {
                    "id": "622090201",
                    "speaker": "Player",
                    "text": "你叫什么名字啊？"
                },
                {
                    "id": "622090202",
                    "speaker": "蒂雅",
                    "text": "我叫做蒂雅。兰达是我的爸爸。"
                }
            ]
        },
        {
            "talkId": "6220903",
            "initDialog": "622090301",
            "dialogues": [
                {
                    "id": "622090301",
                    "speaker": "Player",
                    "text": "再见咯。"
                },
                {
                    "id": "622090302",
                    "speaker": "蒂雅",
                    "text": "嗯嗯，再见！"
                }
            ]
        },
        {
            "talkId": "6220904",
            "initDialog": "622090203",
            "dialogues": [
                {
                    "id": "622090203",
                    "speaker": "Player",
                    "text": "关于你爸爸…"
                },
                {
                    "id": "622090204",
                    "speaker": "蒂雅",
                    "text": "我爸爸和我说，面对陌生人一律回答「他是个旅行商人」。"
                },
                {
                    "id": "622090205",
                    "speaker": "蒂雅",
                    "text": "如果你是蒂雅的熟人的话，就可以告诉你了！"
                }
            ]
        },
        {
            "talkId": "6220905",
            "initDialog": "622090206",
            "dialogues": [
                {
                    "id": "622090206",
                    "speaker": "Player",
                    "text": "那怎么和你做朋友呢？"
                },
                {
                    "id": "622090207",
                    "speaker": "蒂雅",
                    "text": "和蒂雅一起玩就可以了。"
                },
                {
                    "id": "622090208",
                    "speaker": "蒂雅",
                    "text": "不过现在蒂雅想和旺财还有阿伟一起玩！"
                }
            ]
        }
    ]
}