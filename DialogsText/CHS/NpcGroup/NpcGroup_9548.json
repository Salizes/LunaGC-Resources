    "talks": [
        {
            "talkId": "6954801",
            "initDialog": "695480101",
            "dialogues": [
                {
                    "id": "695480101",
                    "speaker": "瑶瑶",
                    "text": "这酒馆里的声音还真是…呃…像是一大锅水在沸腾…叫什么来着。"
                }
            ]
        },
        {
            "talkId": "6954802",
            "initDialog": "695480201",
            "dialogues": [
                {
                    "id": "695480201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954803",
            "initDialog": "695480301",
            "dialogues": [
                {
                    "id": "695480301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695480302",
                    "speaker": "瑶瑶",
                    "text": "嗯，偶尔打打牌作为调剂能够愉悦心情，但正事也不能抛在脑后呢。"
                }
            ]
        },
        {
            "talkId": "6954804",
            "initDialog": "695480401",
            "dialogues": [
                {
                    "id": "695480401",
                    "speaker": "瑶瑶",
                    "text": "你不会每天都在熬夜玩牌吧，这样可不行喔…"
                }
            ]
        },
        {
            "talkId": "6954805",
            "initDialog": "695480501",
            "dialogues": [
                {
                    "id": "695480501",
                    "speaker": "瑶瑶",
                    "text": "这就是师父说的「人有失手，马有失蹄」吗…欸？这句话是这么用的吗…"
                }
            ]
        },
        {
            "talkId": "6954806",
            "initDialog": "695480601",
            "dialogues": [
                {
                    "id": "695480601",
                    "speaker": "瑶瑶",
                    "text": "好嘞，咱们好好享受这场游戏吧。"
                }
            ]
        },
        {
            "talkId": "6954808",
            "initDialog": "695480801",
            "dialogues": [
                {
                    "id": "695480801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954809",
            "initDialog": "695480901",
            "dialogues": [
                {
                    "id": "695480901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954810",
            "initDialog": "695481001",
            "dialogues": [
                {
                    "id": "695481001",
                    "speaker": "瑶瑶",
                    "text": "看来是瑶瑶「技高一筹」呢。"
                }
            ]
        },
        {
            "talkId": "6954811",
            "initDialog": "695481101",
            "dialogues": [
                {
                    "id": "695481101",
                    "speaker": "瑶瑶",
                    "text": "唉，师父没教我玩过这个游戏…"
                }
            ]
        },
        {
            "talkId": "6954812",
            "initDialog": "695481201",
            "dialogues": [
                {
                    "id": "695481201",
                    "speaker": "瑶瑶",
                    "text": "看瑶瑶给你露一手。"
                }
            ]
        },
        {
            "talkId": "6954814",
            "initDialog": "695481401",
            "dialogues": [
                {
                    "id": "695481401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954815",
            "initDialog": "695481501",
            "dialogues": [
                {
                    "id": "695481501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954816",
            "initDialog": "695481601",
            "dialogues": [
                {
                    "id": "695481601",
                    "speaker": "瑶瑶",
                    "text": "别灰心呀，只要你多加练习，一定会有进步的！"
