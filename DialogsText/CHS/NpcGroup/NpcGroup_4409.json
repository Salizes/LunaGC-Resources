{
    "groupId": "4409",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "贾瓦希尔": 7
    },
    "talks": [
        {
            "talkId": "6440901",
            "initDialog": "644090101",
            "dialogues": [
                {
                    "id": "644090101",
                    "speaker": "贾瓦希尔",
                    "text": "哎呦，年轻人穿得有些薄啊。沙漠的晚上可是很冷的，要注意保暖哦。"
                }
            ]
        },
        {
            "talkId": "6440902",
            "initDialog": "644090201",
            "dialogues": [
                {
                    "id": "644090201",
                    "speaker": "Player",
                    "text": "您是…"
                },
                {
                    "id": "644090202",
                    "speaker": "贾瓦希尔",
                    "text": "我是这里的摊主，卖些自己做的手工品，多数是薄毯、衣服，还有其他的一些小东西。"
                },
                {
                    "id": "644090203",
                    "speaker": "贾瓦希尔",
                    "text": "年轻时在城里的毛毯店打工，没想到学来的手艺现在还能用上。"
                },
                {
                    "id": "644090204",
                    "speaker": "贾瓦希尔",
                    "text": "也不指望靠这个赚多少钱啦，只为给邻里乡亲提供些生活便利。"
                },
                {
                    "id": "644090205",
                    "speaker": "贾瓦希尔",
                    "text": "不过我好久没去过城里了，也不知道现在还流不流行这些样式。"
                },
                {
                    "id": "644090206",
                    "speaker": "贾瓦希尔",
                    "text": "看村子里的大人孩子都挺喜欢的，应该还可以吧？"
                }
            ]
        },
        {
            "talkId": "6440903",
            "initDialog": "644090301",
            "dialogues": [
                {
                    "id": "644090301",
                    "speaker": "Player",
                    "text": "多谢关心。"
                },
                {
                    "id": "644090302",
                    "speaker": "贾瓦希尔",
                    "text": "哎，不用客气。身体健康是最重要的。"
                }
            ]
        }
    ]
}