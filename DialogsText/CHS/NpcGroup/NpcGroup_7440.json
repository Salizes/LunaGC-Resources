{
    "groupId": "7440",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "穆欣娜": 8
    },
    "talks": [
        {
            "talkId": "6744001",
            "initDialog": "674400101",
            "dialogues": [
                {
                    "id": "674400101",
                    "speaker": "穆欣娜",
                    "text": "真够没劲的…但还是必须打起精神才行！"
                }
            ]
        },
        {
            "talkId": "6744002",
            "initDialog": "674400201",
            "dialogues": [
                {
                    "id": "674400201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "674400202",
                    "speaker": "穆欣娜",
                    "text": "你好，市民。这里是冬契军管辖的军事重地，如果没有什么要事的话，还请在此止步。"
                }
            ]
        },
        {
            "talkId": "6744003",
            "initDialog": "674400301",
            "dialogues": [
                {
                    "id": "674400301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674400302",
                    "speaker": "穆欣娜",
                    "text": "再见，市民。祝你度过愉快的一天！"
                }
            ]
        },
        {
            "talkId": "6744004",
            "initDialog": "674400401",
            "dialogues": [
                {
                    "id": "674400401",
                    "speaker": "Player",
                    "text": "你一直站在这里吗？"
                },
                {
                    "id": "674400402",
                    "speaker": "穆欣娜",
                    "text": "当然，如你所见，我在履行冬契军最神圣的职责——守卫我们伟大祖国这块三米见方的神圣领土！"
                },
                {
                    "id": "674400403",
                    "speaker": "穆欣娜",
                    "text": "在有新的队员代替我的岗位之前，我绝不会有一丝的懈怠…应该吧…"
                }
            ]
        },
        {
            "talkId": "6744005",
            "initDialog": "674400501",
            "dialogues": [
                {
                    "id": "674400501",
                    "speaker": "Player",
                    "text": "站岗的工作很枯燥吗？"
                },
                {
                    "id": "674400502",
                    "speaker": "穆欣娜",
                    "text": "老实说，确实有点…一看到同僚们在这里进进出出，我就会想什么时候能被安排去，呃…更「灵活」的工作。"
                },
                {
                    "id": "674400503",
                    "speaker": "穆欣娜",
                    "text": "不过长官大人跟我说了，「无法征服枯燥岗位的人，也无法征服真正的敌人」。"
                },
                {
                    "id": "674400504",
                    "speaker": "穆欣娜",
                    "text": "所以在换岗的号角响起之前，我都会像冰雕一样站在这里！"
                }
            ]
        }
    ]
}