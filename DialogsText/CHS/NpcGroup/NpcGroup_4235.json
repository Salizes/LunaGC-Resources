{
    "groupId": "4235",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "齐亚德": 10
    },
    "talks": [
        {
            "talkId": "6423501",
            "initDialog": "642350101",
            "dialogues": [
                {
                    "id": "642350101",
                    "speaker": "齐亚德",
                    "text": "有什么了不起的，哼，下次我还敢！"
                }
            ]
        },
        {
            "talkId": "6423502",
            "initDialog": "642350201",
            "dialogues": [
                {
                    "id": "642350201",
                    "speaker": "Player",
                    "text": "你做了什么？"
                },
                {
                    "id": "642350202",
                    "speaker": "齐亚德",
                    "text": "你也是来教训我的吗？男子汉齐亚德不怕，你来吧。"
                },
                {
                    "id": "642350203",
                    "speaker": "齐亚德",
                    "text": "事先说好，想要我道歉那是不可能的。"
                }
            ]
        },
        {
            "talkId": "6423503",
            "initDialog": "642350301",
            "dialogues": [
                {
                    "id": "642350301",
                    "speaker": "Player",
                    "text": "调皮不好。"
                },
                {
                    "id": "642350302",
                    "speaker": "齐亚德",
                    "text": "大人都好烦哪，只知道教训人，而且每次教训我的理由都一样，都是我太调皮了。"
                },
                {
                    "id": "642350303",
                    "speaker": "齐亚德",
                    "text": "明明是他们先做错事的，我只是在伸张正义！"
                },
                {
                    "id": "642350304",
                    "speaker": "齐亚德",
                    "text": "你说，如果你的爸爸把你的妈妈弄哭了，你会不会不开心？"
                }
            ]
        },
        {
            "talkId": "6423504",
            "initDialog": "642350401",
            "dialogues": [
                {
                    "id": "642350401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642350402",
                    "speaker": "齐亚德",
                    "text": "哦，再见，我还要在外面玩一会儿。等爸爸不生气了我再回家。"
                }
            ]
        },
        {
            "talkId": "6423505",
            "initDialog": "642350501",
            "dialogues": [
                {
                    "id": "642350501",
                    "speaker": "Player",
                    "text": "不是的。"
                },
                {
                    "id": "642350502",
                    "speaker": "齐亚德",
                    "text": "啊？那你来凑什么热闹？真是的…"
                },
                {
                    "id": "642350503",
                    "speaker": "齐亚德",
                    "text": "回家找你妈妈去，别打扰我了，人家心里烦着呢。"
                }
            ]
        },
        {
            "talkId": "6423506",
            "initDialog": "642350601",
            "dialogues": [
                {
                    "id": "642350601",
                    "speaker": "Player",
                    "text": "会。"
                },
                {
                    "id": "642350602",
                    "speaker": "齐亚德",
                    "text": "我就说吧，所以我是为了伸张正义才把虫子放到爸爸的裤子里的，凭什么骂我。"
                }
            ]
        }
    ]
}