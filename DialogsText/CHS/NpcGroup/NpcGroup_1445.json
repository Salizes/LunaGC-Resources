{
    "groupId": "1445",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 5,
        "阿拉米": 23
    },
    "talks": [
        {
            "talkId": "7081201",
            "initDialog": "708120101",
            "dialogues": [
                {
                    "id": "708120101",
                    "speaker": "阿拉米",
                    "text": "怎么被吹了那么高…"
                },
                {
                    "id": "708120102",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "708120103",
                    "speaker": "阿拉米",
                    "text": "哦，是荣誉骑士啊，您好。是这样，之前那阵席卷全城的风暴您应该也见识到了。"
                },
                {
                    "id": "708120104",
                    "speaker": "阿拉米",
                    "text": "虽然风暴已经平息了，但风暴对蒙德城造成的影响，一时半会也没法全部解决…"
                },
                {
                    "id": "708120105",
                    "speaker": "阿拉米",
                    "text": "已经有不止一个商家说，自家放在屋外的海报和告示牌被风暴吹走了。"
                },
                {
                    "id": "708120106",
                    "speaker": "阿拉米",
                    "text": "有的被吹上了屋顶，有的被吹上了城墙…"
                },
                {
                    "id": "708120107",
                    "speaker": "阿拉米",
                    "text": "骑士团本来打算派两个手脚利落的人去快速搞定这件事。"
                },
                {
                    "id": "708120108",
                    "speaker": "阿拉米",
                    "text": "一方面是为市民们排忧解难，一方面也是因为，那些东西老是待在屋顶和城墙上，也有点不太像话…"
                },
                {
                    "id": "708120109",
                    "speaker": "阿拉米",
                    "text": "但是没想到，一时间骑士团里竟然抽不出人手来，只有我来负责这件事。"
                },
                {
                    "id": "708120110",
                    "speaker": "阿拉米",
                    "text": "不过我这个膝盖，最近连爬台阶都有点费劲，要我爬那么高，不是要了我的命吗…"
                },
                {
                    "id": "708120111",
                    "speaker": "阿拉米",
                    "text": "荣誉骑士，能拜托你来帮我解决这件事吗？"
                }
            ]
        },
        {
            "talkId": "7081202",
            "initDialog": "708120201",
            "dialogues": [
                {
                    "id": "708120201",
                    "speaker": "Player",
                    "text": "我义不容辞。"
                },
                {
                    "id": "708120202",
                    "speaker": "阿拉米",
                    "text": "谢谢您，真不好意思，本来是我的职责…"
                },
                {
                    "id": "708120203",
                    "speaker": "阿拉米",
                    "text": "大概有三张海报…和一个告示牌被风暴吹到了屋顶和城墙上。"
                },
                {
                    "id": "708120204",
                    "speaker": "阿拉米",
                    "text": "请您去把那三张海报赶紧拿下来给我吧。告示牌放在地上就行，我会让其他同僚把它还给商家的。"
                },
                {
                    "id": "708120205",
                    "speaker": "阿拉米",
                    "text": "那就拜托您了，实在帮大忙了。"
                }
            ]
        },
        {
            "talkId": "7081203",
            "initDialog": "708120301",
            "dialogues": [
                {
                    "id": "708120301",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "708120302",
                    "speaker": "阿拉米",
                    "text": "没关系，这本来就应该是我的职责，您忙您的事去吧，我再自己想想怎么解决…"
                }
            ]
        },
        {
            "talkId": "6144501",
            "initDialog": "614450101",
            "dialogues": [
                {
                    "id": "614450101",
                    "speaker": "阿拉米",
                    "text": "你好，有什么可疑情况么？"
                }
            ]
        },
        {
            "talkId": "6144502",
            "initDialog": "614450201",
            "dialogues": [
                {
                    "id": "614450201",
                    "speaker": "Player",
                    "text": "你在巡逻？"
                },
                {
                    "id": "614450202",
                    "speaker": "阿拉米",
                    "text": "嗯，我的职责是保障教堂附近的安全，在教堂前的阶梯之间巡视。"
                },
                {
                    "id": "614450203",
                    "speaker": "阿拉米",
                    "text": "我为这份可以守护神像的工作感到自豪，只是这些台阶实在太伤膝盖了…"
                },
                {
                    "id": "614450204",
                    "speaker": "阿拉米",
                    "text": "唉，也不知道十年后还能不能干得下去了。"
                }
            ]
        },
        {
            "talkId": "6144503",
            "initDialog": "614450301",
            "dialogues": [
                {
                    "id": "614450301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614450302",
                    "speaker": "阿拉米",
                    "text": "嗯，有我看着呢。"
                }
            ]
        },
        {
            "talkId": "6144504",
            "initDialog": "614450401",
            "dialogues": [
                {
                    "id": "614450401",
                    "speaker": "阿拉米",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6144505",
            "initDialog": "614450501",
            "dialogues": [
                {
                    "id": "614450501",
                    "speaker": "阿拉米",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6144506",
            "initDialog": "614450601",
            "dialogues": [
                {
                    "id": "614450601",
                    "speaker": "阿拉米",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        }
    ]
}