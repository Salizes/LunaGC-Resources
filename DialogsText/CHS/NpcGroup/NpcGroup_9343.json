{
    "groupId": "9343",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "云堇": 9
    },
    "talks": [
        {
            "talkId": "6934301",
            "initDialog": "693430101",
            "dialogues": [
                {
                    "id": "693430101",
                    "speaker": "云堇",
                    "text": "在我看来，战斗就像登台一般，必须打起十二分的精神，避免出错。但又偏偏少了戏台上的诸多乐趣，时间久了，不免疲倦。"
                },
                {
                    "id": "693430102",
                    "speaker": "云堇",
                    "text": "不妨让自己闲暇片刻，备些茶点，和我话些家常。"
                },
                {
                    "id": "693430103",
                    "speaker": "云堇",
                    "text": "等着气势蓄足了，我们就再开一台戏，去教训那些坏蛋们。"
                }
            ]
        },
        {
            "talkId": "6934302",
            "initDialog": "693430201",
            "dialogues": [
                {
                    "id": "693430201",
                    "speaker": "云堇",
                    "text": "古往今来，诸多戏剧所写之人，无一不是经历了种种劫数，才得圆满。"
                },
                {
                    "id": "693430202",
                    "speaker": "云堇",
                    "text": "前路凶险，但无须担心。"
                },
                {
                    "id": "693430203",
                    "speaker": "云堇",
                    "text": "我们有同伴相助，勠力同心，定能克服艰难。"
                }
            ]
        },
        {
            "talkId": "6934303",
            "initDialog": "693430301",
            "dialogues": [
                {
                    "id": "693430301",
                    "speaker": "云堇",
                    "text": "小说确有其动人之处，但只读文字，我总会觉得少了些许味道。"
                },
                {
                    "id": "693430302",
                    "speaker": "云堇",
                    "text": "直到登上戏台，亲自演绎书中之人所经历的种种，我才能真正体会到深藏其中的情意。"
                },
                {
                    "id": "693430303",
                    "speaker": "云堇",
                    "text": "虽说人在山中，不识全貌。但有些美景，只有亲自往山中走一遭才能看到呢。"
                }
            ]
        }
    ]
}