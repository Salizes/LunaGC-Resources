    "talks": [
        {
            "talkId": "6749901",
            "initDialog": "674990101",
            "dialogues": [
                {
                    "id": "674990101",
                    "speaker": "叶利扎罗夫",
                    "text": "天哪，你到普契涅拉在会上说的那些提案了吗！他这是…他这是要拿我们开刀！"
                },
                {
                    "id": "674990102",
                    "speaker": "叶利扎罗夫",
                    "text": "他还好意思说自己是矮灵吗？他明明都比我们高上了一整个头！"
                },
                {
                    "id": "674990103",
                    "speaker": "萨玛琳娜",
                    "text": "行了，小声点！"
                },
                {
                    "id": "674990104",
                    "speaker": "叶利扎罗夫",
                    "text": "要是白沙皇陛下还在…"
                },
                {
                    "id": "674990105",
                    "speaker": "萨玛琳娜",
                    "text": "就算是白沙皇陛下还在的时候，该要拿出来的摩拉还是得拿出来，你以为能免得了？"
                },
                {
                    "id": "674990106",
                    "speaker": "萨玛琳娜",
                    "text": "普契涅拉大人愿意把这件事放在皇都评议会上谈，已经看顾很多妖精贵族的面子了。"
                },
                {
                    "id": "674990107",
                    "speaker": "萨玛琳娜",
                    "text": "而且，女皇陛下对于我们这些妖精贵族是什么态度…你还敢这样说，不要命啦！"
                }
            ]
        }
    ]
}