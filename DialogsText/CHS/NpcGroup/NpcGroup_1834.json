{
    "groupId": "1834",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "芳年": 9
    },
    "talks": [
        {
            "talkId": "6183401",
            "initDialog": "618340101",
            "dialogues": [
                {
                    "id": "618340101",
                    "speaker": "芳年",
                    "text": "唉，去哪里看砍头呢。"
                }
            ]
        },
        {
            "talkId": "6183402",
            "initDialog": "618340201",
            "dialogues": [
                {
                    "id": "618340201",
                    "speaker": "Player",
                    "text": "砍…头？"
                },
                {
                    "id": "618340202",
                    "speaker": "芳年",
                    "text": "呀，你好啊。不用在意我说的。"
                },
                {
                    "id": "618340203",
                    "speaker": "芳年",
                    "text": "我以前在人间擅长画地狱绘图，或者壮士临终的血涂之相。用以警醒世事无常。"
                },
                {
                    "id": "618340204",
                    "speaker": "芳年",
                    "text": "绝对不是因为我反人类。"
                }
            ]
        },
        {
            "talkId": "6183403",
            "initDialog": "618340301",
            "dialogues": [
                {
                    "id": "618340301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "618340302",
                    "speaker": "芳年",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6183404",
            "initDialog": "618340401",
            "dialogues": [
                {
                    "id": "618340401",
                    "speaker": "Player",
                    "text": "我很怀疑。"
                },
                {
                    "id": "618340402",
                    "speaker": "芳年",
                    "text": "我可是发誓要画一百张月亮画的风雅人呢。"
                },
                {
                    "id": "618340403",
                    "speaker": "芳年",
                    "text": "每一章月亮的姿态背后都是一个故事。这么风雅的人，怎么会是反社会呢。"
                },
                {
                    "id": "618340404",
                    "speaker": "芳年",
                    "text": "可惜了，画完了九十六张，凑不出《月百姿》啊。"
                },
                {
                    "id": "618340405",
                    "speaker": "芳年",
                    "text": "这地方看到的月亮永远都是一张面孔。它是我绝对不想画的第九十七张月亮。"
                }
            ]
        }
    ]
}