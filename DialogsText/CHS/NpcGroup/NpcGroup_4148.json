{
    "groupId": "4148",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "塔维妮儿": 9
    },
    "talks": [
        {
            "talkId": "6414801",
            "initDialog": "641480101",
            "dialogues": [
                {
                    "id": "641480101",
                    "speaker": "塔维妮儿",
                    "text": "我是不是应该再换个地方呢…"
                }
            ]
        },
        {
            "talkId": "6414802",
            "initDialog": "641480201",
            "dialogues": [
                {
                    "id": "641480201",
                    "speaker": "Player",
                    "text": "换个地方？"
                },
                {
                    "id": "641480202",
                    "speaker": "塔维妮儿",
                    "text": "嗯，我是指换个做生意的地方。"
                },
                {
                    "id": "641480203",
                    "speaker": "塔维妮儿",
                    "text": "我是来自枫丹的商人，专门做高级钟表机械和精致奢侈品的生意。"
                },
                {
                    "id": "641480204",
                    "speaker": "塔维妮儿",
                    "text": "之前去蒙德待过一阵，但那里风气太悠闲了，不适合我。"
                },
                {
                    "id": "641480205",
                    "speaker": "塔维妮儿",
                    "text": "我本以为身为智慧之国的须弥会有不亚于枫丹的严谨法度和秩序，但没想到这的社会风貌是这样的松懈、原始！"
                },
                {
                    "id": "641480206",
                    "speaker": "塔维妮儿",
                    "text": "唯一不那么松懈的地方，就是负责贸易监察的学者总是来找麻烦吧。"
                },
                {
                    "id": "641480207",
                    "speaker": "塔维妮儿",
                    "text": "你说我卖枫丹的东西，他们老是问来问去的做什么？"
                },
                {
                    "id": "641480208",
                    "speaker": "塔维妮儿",
                    "text": "我总不能将商品的制作机密直接告诉他们吧？太天真了！"
                }
            ]
        },
        {
            "talkId": "6414803",
            "initDialog": "641480301",
            "dialogues": [
                {
                    "id": "641480301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641480302",
                    "speaker": "塔维妮儿",
                    "text": "再见，不知道至冬会不会好一些呢…"
                }
            ]
        }
    ]
}