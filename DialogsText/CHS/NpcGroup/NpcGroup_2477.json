{
    "groupId": "2477",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "却之": 9
    },
    "talks": [
        {
            "talkId": "6247701",
            "initDialog": "624770101",
            "dialogues": [
                {
                    "id": "624770101",
                    "speaker": "却之",
                    "text": "客官这边请，还有空位。您是想喝茶听戏呢，还是吃顿工作餐？"
                }
            ]
        },
        {
            "talkId": "6247702",
            "initDialog": "624770201",
            "dialogues": [
                {
                    "id": "624770201",
                    "speaker": "Player",
                    "text": "都有什么茶？"
                },
                {
                    "id": "624770202",
                    "speaker": "却之",
                    "text": "沉玉谷最有名的游韵单丛和松萝仙芽，每种还有几个细分的品级，我们茶馆都有！"
                },
                {
                    "id": "624770203",
                    "speaker": "却之",
                    "text": "璃月港那边流行的天衡岩骨、云来白毫和碧水青茗，也一种不差，都是出口级品质！"
                }
            ]
        },
        {
            "talkId": "6247703",
            "initDialog": "624770301",
            "dialogues": [
                {
                    "id": "624770301",
                    "speaker": "Player",
                    "text": "工作餐？"
                },
                {
                    "id": "624770302",
                    "speaker": "却之",
                    "text": "啊不好意思，按照阿绿小姐的建议，更优雅一点的叫法应当是…简餐。"
                },
                {
                    "id": "624770303",
                    "speaker": "却之",
                    "text": "没错，针对来来往往的商务人士的简餐！"
                },
                {
                    "id": "624770304",
                    "speaker": "却之",
                    "text": "当然，正经的午宴晚宴，本店也都有。不过，通常不会在这露天的餐位提供。"
                },
                {
                    "id": "624770305",
                    "speaker": "却之",
                    "text": "这边的餐位都是给客人们品茶听戏和听书用的。"
                },
                {
                    "id": "624770306",
                    "speaker": "却之",
                    "text": "茶馆的室内餐区、雅座和包厢，暂时还在改建中，等改建完毕，客官随时可以来就餐！"
                }
            ]
        },
        {
            "talkId": "6247704",
            "initDialog": "624770401",
            "dialogues": [
                {
                    "id": "624770401",
                    "speaker": "Player",
                    "text": "我就看看，你忙你的。"
                },
                {
                    "id": "624770402",
                    "speaker": "却之",
                    "text": "那就期待客官下次再来了！"
                }
            ]
        }
    ]
}