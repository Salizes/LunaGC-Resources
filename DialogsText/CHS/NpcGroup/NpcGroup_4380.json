    "talks": [
        {
            "talkId": "6438001",
            "initDialog": "643800101",
            "dialogues": [
                {
                    "id": "643800101",
                    "speaker": "乌纳因",
                    "text": "……"
                },
                {
                    "id": "643800102",
                    "speaker": "乌纳因",
                    "text": "你好，有事请讲。"
                }
            ]
        },
        {
            "talkId": "6438002",
            "initDialog": "643800201",
            "dialogues": [
                {
                    "id": "643800201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643800202",
                    "speaker": "乌纳因",
                    "text": "我是来智慧宫借书的学生，最近在申请额外的借阅许可。"
                },
                {
                    "id": "643800203",
                    "speaker": "乌纳因",
                    "text": "平常就能借到的通识书籍已经看得差不多了，希望导师能尽快批准我申请的其他藏书。"
                }
            ]
        },
        {
            "talkId": "6438003",
            "initDialog": "643800301",
            "dialogues": [
                {
                    "id": "643800301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "643800302",
                    "speaker": "乌纳因",
                    "text": "没关系。"
                }
            ]
        },
        {
            "talkId": "6438004",
            "initDialog": "643800401",
            "dialogues": [
                {
                    "id": "643800401",
                    "speaker": "Player",
                    "text": "有什么推荐书籍吗？"
                },
                {
                    "id": "643800402",
                    "speaker": "乌纳因",
                    "text": "那要看你想了解哪个学院和哪门专业的内容了。"
                },
                {
                    "id": "643800403",
                    "speaker": "乌纳因",
                    "text": "有了方向之后，我就能列个书单给你。"
                },
                {
                    "id": "643800404",
                    "speaker": "乌纳因",
                    "text": "不过智慧宫的图书只对教令院的学者和学生开放借阅，你要先确保自己能拿到证明才行。"
                }
            ]
        }
    ]
}