{
    "groupId": "6042",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "伊赫卡": 12
    },
    "talks": [
        {
            "talkId": "6604201",
            "initDialog": "660420101",
            "dialogues": [
                {
                    "id": "660420101",
                    "speaker": "伊赫卡",
                    "text": "你好呀，朋友！最近有没有去「凉快」地方旅行的计划呢？"
                }
            ]
        },
        {
            "talkId": "6604202",
            "initDialog": "660420201",
            "dialogues": [
                {
                    "id": "660420201",
                    "speaker": "Player",
                    "text": "问这个干嘛？"
                },
                {
                    "id": "660420202",
                    "speaker": "伊赫卡",
                    "text": "你看，如果去比较冷的地方，总要带点保暖的东西吧？"
                },
                {
                    "id": "660420203",
                    "speaker": "伊赫卡",
                    "text": "有没有兴趣试一试比羊毛更细、更软、更保暖的绵驮兽毛制品？"
                }
            ]
        },
        {
            "talkId": "6604203",
            "initDialog": "660420301",
            "dialogues": [
                {
                    "id": "660420301",
                    "speaker": "Player",
                    "text": "也许吧。"
                },
                {
                    "id": "660420302",
                    "speaker": "伊赫卡",
                    "text": "哎呀，别敷衍我嘛…"
                }
            ]
        },
        {
            "talkId": "6604204",
            "initDialog": "660420401",
            "dialogues": [
                {
                    "id": "660420401",
                    "speaker": "Player",
                    "text": "哦吼，在纳塔很难卖吧。"
                },
                {
                    "id": "660420402",
                    "speaker": "伊赫卡",
                    "text": "呃…嗯…唔…"
                },
                {
                    "id": "660420403",
                    "speaker": "伊赫卡",
                    "text": "也、也不能说难卖吧，只能说使用场景比较的，呃，「单一」。"
                },
                {
                    "id": "660420404",
                    "speaker": "伊赫卡",
                    "text": "一般来讲，绵驮兽的毛只有烟谜主的人在织毯子时会用到。"
                },
                {
                    "id": "660420405",
                    "speaker": "伊赫卡",
                    "text": "但绵驮兽本身的用处就比较多了，可以当作驮运工具，同时也是很不错的耕地帮手。"
                }
            ]
        },
        {
            "talkId": "6604205",
            "initDialog": "660420501",
            "dialogues": [
                {
                    "id": "660420501",
                    "speaker": "Player",
                    "text": "那看来还不急着卖…"
                },
                {
                    "id": "660420502",
                    "speaker": "伊赫卡",
                    "text": "不，稍等嘛，这不是急不急的问题。"
                },
                {
                    "id": "660420503",
                    "speaker": "伊赫卡",
                    "text": "我作为饲养绵驮兽的农户，让大家知道它们的优点，让绵驮兽能发挥更多的作用，难道不是天经地义的事情。"
                },
                {
                    "id": "660420504",
                    "speaker": "伊赫卡",
                    "text": "如果有人居住在冰天雪地的地方，但是又无缘用上极其保暖的驮绒衣物，岂不是天大的悲剧。"
                },
                {
                    "id": "660420505",
                    "speaker": "伊赫卡",
                    "text": "所以朋友，如果你见到有需要保暖服的人，请一定要向他们推荐驮绒啊！"
                }
            ]
        }
    ]
}