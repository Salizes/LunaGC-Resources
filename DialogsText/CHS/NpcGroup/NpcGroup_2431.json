{
    "groupId": "2431",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "判官儿": 11
    },
    "talks": [
        {
            "talkId": "7194801",
            "initDialog": "719480101",
            "dialogues": [
                {
                    "id": "719480101",
                    "speaker": "Player",
                    "text": "那你找到仙人了吗？"
                },
                {
                    "id": "719480102",
                    "speaker": "判官儿",
                    "text": "还没有，而且也没有仙人把斧子给我送过来，真是太奇怪了…"
                },
                {
                    "id": "719480103",
                    "speaker": "判官儿",
                    "text": "…不过斧子之外，我倒是捡到了一把剑…"
                },
                {
                    "id": "719480104",
                    "speaker": "判官儿",
                    "text": "可，可是我又不会用剑啊！难道是仙人搞错了吗？"
                },
                {
                    "id": "719480105",
                    "speaker": "判官儿",
                    "text": "要不这剑你就拿走吧，我还得等我的斧子呢…"
                }
            ]
        },
        {
            "talkId": "6243101",
            "initDialog": "624310101",
            "dialogues": [
                {
                    "id": "624310101",
                    "speaker": "判官儿",
                    "text": "是旅行者么？来的路上有没有看到我的斧子？"
                }
            ]
        },
        {
            "talkId": "6243102",
            "initDialog": "624310201",
            "dialogues": [
                {
                    "id": "624310201",
                    "speaker": "Player",
                    "text": "你丢东西了吗？"
                },
                {
                    "id": "624310202",
                    "speaker": "判官儿",
                    "text": "我是这附近的普通樵夫，可不知道我的斧子又掉在哪儿了…"
                },
                {
                    "id": "624310203",
                    "speaker": "判官儿",
                    "text": "难道是刚才休息的时候忘在了哪里？"
                },
                {
                    "id": "624310204",
                    "speaker": "判官儿",
                    "text": "可是传说中斧子丢了的话，会有仙人为我送回来的呀？"
                },
                {
                    "id": "624310205",
                    "speaker": "判官儿",
                    "text": "所以说我直接去找仙人会比较快？"
                }
            ]
        },
        {
            "talkId": "6243103",
            "initDialog": "624310301",
            "dialogues": [
                {
                    "id": "624310301",
                    "speaker": "Player",
                    "text": "没有，不好意思。"
                },
                {
                    "id": "624310302",
                    "speaker": "判官儿",
                    "text": "唉…这样吗。"
                }
            ]
        },
        {
            "talkId": "8243101",
            "initDialog": "824310101",
            "dialogues": [
                {
                    "id": "824310101",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "8243102",
            "initDialog": "824310201",
            "dialogues": [
                {
                    "id": "824310201",
                    "speaker": "判官儿",
                    "text": "我为了找我的斧子，把这附近都逛遍了，啥都没看到啊…"
                }
            ]
        }
    ]
}