{
    "groupId": "6029",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "卡马克": 17
    },
    "talks": [
        {
            "talkId": "6602901",
            "initDialog": "660290101",
            "dialogues": [
                {
                    "id": "660290101",
                    "speaker": "卡马克",
                    "text": "朋友，可以耽误你点时间，问你一个问题吗？"
                }
            ]
        },
        {
            "talkId": "6602902",
            "initDialog": "660290201",
            "dialogues": [
                {
                    "id": "660290201",
                    "speaker": "Player",
                    "text": "抱歉，现在手头有点紧…"
                },
                {
                    "id": "660290202",
                    "speaker": "卡马克",
                    "text": "嗐，不是这种问题啦！"
                },
                {
                    "id": "660290203",
                    "speaker": "卡马克",
                    "text": "只是出于个人好奇，想知道你喜欢吃胡萝卜吗？"
                }
            ]
        },
        {
            "talkId": "6602903",
            "initDialog": "660290301",
            "dialogues": [
                {
                    "id": "660290301",
                    "speaker": "Player",
                    "text": "还有别的事…"
                },
                {
                    "id": "660290302",
                    "speaker": "卡马克",
                    "text": "哦，没关系，有缘再会。"
                }
            ]
        },
        {
            "talkId": "6602904",
            "initDialog": "660290401",
            "dialogues": [
                {
                    "id": "660290401",
                    "speaker": "Player",
                    "text": "还不错，很有营养。"
                },
                {
                    "id": "660290402",
                    "speaker": "卡马克",
                    "text": "哎，我就说吧！世界上还是有人能理解胡萝卜的好的。"
                },
                {
                    "id": "660290403",
                    "speaker": "卡马克",
                    "text": "每次有人问我如何保持眼力敏锐时，我都推荐他们吃胡萝卜。"
                },
                {
                    "id": "660290404",
                    "speaker": "卡马克",
                    "text": "结果大部分人都连连摇头，宁愿去喝烟谜主的人给的药水也不要吃胡萝卜。"
                },
                {
                    "id": "660290405",
                    "speaker": "卡马克",
                    "text": "我觉得也不至于那么难吃吧…"
                },
                {
                    "id": "660290406",
                    "speaker": "卡马克",
                    "text": "我的朋友，能听到你的话我真的很感动。不知道这世上有没有胡萝卜魔神，如果有的话，他一定会保佑你的。"
                }
            ]
        },
        {
            "talkId": "6602905",
            "initDialog": "660290501",
            "dialogues": [
                {
                    "id": "660290501",
                    "speaker": "Player",
                    "text": "不太行，尝起来像土…"
                },
                {
                    "id": "660290502",
                    "speaker": "卡马克",
                    "text": "哦…哦…"
                },
                {
                    "id": "660290503",
                    "speaker": "卡马克",
                    "text": "抱歉，我看起来有点失落吧？请不要在意，因为不是你的错。"
                },
                {
                    "id": "660290504",
                    "speaker": "卡马克",
                    "text": "我作为一名比赛裁判，当然尊重每个人自由地喜欢或讨厌胡萝卜的权力。"
                },
                {
                    "id": "660290505",
                    "speaker": "卡马克",
                    "text": "但我确实没想到讨厌胡萝卜的人有那么多，差不多十有八九吧…"
                },
                {
                    "id": "660290506",
                    "speaker": "卡马克",
                    "text": "虽然我也不能保证自己视力很好是因为爱吃胡萝卜，但颜色这么好看的蔬菜应该是好东西，对吧？"
                }
            ]
        },
        {
            "talkId": "7591501",
            "initDialog": "759150101",
            "dialogues": [
                {
                    "id": "759150101",
                    "speaker": "Player",
                    "text": "不可貌相…"
                },
                {
                    "id": "759150102",
                    "speaker": "卡马克",
                    "text": "啊，你这么一说…的确有些长得很可爱的人，相处起来却不太容易呢…"
                },
                {
                    "id": "759150103",
                    "speaker": "卡马克",
                    "text": "呃，我这话没有针对谁的意思！"
                },
                {
                    "id": "759150104",
                    "speaker": "卡马克",
                    "text": "咳咳，说回食物的话题…不喜欢吃胡萝卜的人，一般喜欢吃什么呢？肉吗？"
                }
            ]
        }
    ]
}