{
    "groupId": "6007",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "布纳马": 18
    },
    "talks": [
        {
            "talkId": "6600701",
            "initDialog": "660070101",
            "dialogues": [
                {
                    "id": "660070101",
                    "speaker": "布纳马",
                    "text": "嘘，这里不能大声讲话。"
                },
                {
                    "id": "660070102",
                    "speaker": "布纳马",
                    "text": "想买什么自己拿，把钱留在旁边就好。"
                }
            ]
        },
        {
            "talkId": "6600702",
            "initDialog": "660070201",
            "dialogues": [
                {
                    "id": "660070201",
                    "speaker": "Player",
                    "text": "想要借用合成台。"
                },
                {
                    "id": "660070202",
                    "speaker": "布纳马",
                    "text": "空着的台子随便用，不用特意跟我讲。"
                }
            ]
        },
        {
            "talkId": "6600703",
            "initDialog": "660070301",
            "dialogues": [
                {
                    "id": "660070301",
                    "speaker": "Player",
                    "text": "有什么卖的？"
                },
                {
                    "id": "660070302",
                    "speaker": "布纳马",
                    "text": "喏，这些，和，这些…全在这里了。没有的就是缺货。"
                }
            ]
        },
        {
            "talkId": "6600704",
            "initDialog": "660070401",
            "dialogues": [
                {
                    "id": "660070401",
                    "speaker": "Player",
                    "text": "声音太大会有什么影响吗？"
                },
                {
                    "id": "660070402",
                    "speaker": "布纳马",
                    "text": "这个问题问得好。"
                },
                {
                    "id": "660070403",
                    "speaker": "布纳马",
                    "text": "很多人在做东西的时候会忽略环境因素，你能这样问就已经和他们拉开差距了。"
                },
                {
                    "id": "660070404",
                    "speaker": "布纳马",
                    "text": "他们都知道澄晶实粉的多少会影响药剂的功能，知道符咒多画上一笔就可能导致完全不同的效果。"
                },
                {
                    "id": "660070405",
                    "speaker": "布纳马",
                    "text": "那怎么就不能理解声音也会影响材料合成的结果呢？"
                }
            ]
        },
        {
            "talkId": "6600705",
            "initDialog": "660070501",
            "dialogues": [
                {
                    "id": "660070501",
                    "speaker": "Player",
                    "text": "不怕丢东西吗？"
                },
                {
                    "id": "660070502",
                    "speaker": "布纳马",
                    "text": "你这个问题问得不好。"
                },
                {
                    "id": "660070503",
                    "speaker": "布纳马",
                    "text": "一旦将不劳而获的想法讲出来，就算是品德高尚的人，心中也会被埋下不好的种子。"
                },
                {
                    "id": "660070504",
                    "speaker": "布纳马",
                    "text": "不过这里没关系的，反正卖的都是些寄售在摩尔石屋的杂货。"
                },
                {
                    "id": "660070505",
                    "speaker": "布纳马",
                    "text": "就算搞丢了一两件商品，只要老夫随手画两道祝祷之符，也就赚回来了！"
                }
            ]
        },
        {
            "talkId": "6600706",
            "initDialog": "660070601",
            "dialogues": [
                {
                    "id": "660070601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660070602",
                    "speaker": "布纳马",
                    "text": "慢点走，脚步轻一些。"
                }
            ]
        },
        {
            "talkId": "6600707",
            "initDialog": "660070701",
            "dialogues": [
                {
                    "id": "660070701",
                    "speaker": "Player",
                    "text": "道理我懂，但周围并不安静…"
                },
                {
                    "id": "660070702",
                    "speaker": "布纳马",
                    "text": "嗯？"
                },
                {
                    "id": "660070703",
                    "speaker": "布纳马",
                    "text": "…啊，你说的这个，老夫当然已经考虑在内了！"
                },
                {
                    "id": "660070704",
                    "speaker": "布纳马",
                    "text": "我在这里的一切行动，都是建立在已有的环境基础上进行的。"
                },
                {
                    "id": "660070705",
                    "speaker": "布纳马",
                    "text": "过往的人流自然会带来不同的故事，这些…嗯，这些也是制作工序中的一部分。"
                },
                {
                    "id": "660070706",
                    "speaker": "布纳马",
                    "text": "按照我们烟谜主的说法：「一切都已洞悉，未来已成过去。」"
                }
            ]
        }
    ]
}