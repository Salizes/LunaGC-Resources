{
    "groupId": "5111",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "加维": 10
    },
    "talks": [
        {
            "talkId": "6511101",
            "initDialog": "651110101",
            "dialogues": [
                {
                    "id": "651110101",
                    "speaker": "加维",
                    "text": "我的职业生涯不会还没开始就要结束了吧…"
                }
            ]
        },
        {
            "talkId": "6511102",
            "initDialog": "651110201",
            "dialogues": [
                {
                    "id": "651110201",
                    "speaker": "Player",
                    "text": "需要帮助吗？"
                },
                {
                    "id": "651110202",
                    "speaker": "加维",
                    "text": "呃，还好…不，我是说，感谢您的关心，但我的问题大概只能我自己解决。"
                },
                {
                    "id": "651110203",
                    "speaker": "加维",
                    "text": "我是刚刚进入沫芒宫的新人复律员，被安排到这里进行一些简单的普法工作。"
                },
                {
                    "id": "651110204",
                    "speaker": "加维",
                    "text": "但我…我性格有些内向，不是很适应这份需要和人谈话的工作…"
                },
                {
                    "id": "651110205",
                    "speaker": "加维",
                    "text": "之前那维莱特大人路过，看我状态不好，拍着我的肩膀安慰了我几句，结果…结果我更紧张了…"
                }
            ]
        },
        {
            "talkId": "6511103",
            "initDialog": "651110301",
            "dialogues": [
                {
                    "id": "651110301",
                    "speaker": "Player",
                    "text": "打扰了…"
                },
                {
                    "id": "651110302",
                    "speaker": "加维",
                    "text": "啊，您好，没关系，请慢走…"
                }
            ]
        },
        {
            "talkId": "6511104",
            "initDialog": "651110401",
            "dialogues": [
                {
                    "id": "651110401",
                    "speaker": "Player",
                    "text": "要不要换个职位？"
                },
                {
                    "id": "651110402",
                    "speaker": "加维",
                    "text": "谢谢您的建议，您真是位好心人，就和那维莱特大人一样。"
                },
                {
                    "id": "651110403",
                    "speaker": "加维",
                    "text": "我是新人，这是我的第一份工作，而上司似乎对我有着很高的期待。"
                },
                {
                    "id": "651110404",
                    "speaker": "加维",
                    "text": "他希望我能为死气沉沉的沫芒宫带来年轻人的活力，我实在无法鼓起勇气拒绝。"
                },
                {
                    "id": "651110405",
                    "speaker": "加维",
                    "text": "唉，早知道应该和也是刚来不久的艾尤恩先生换一下了…他看起来可比我开朗多了。"
                }
            ]
        }
    ]
}