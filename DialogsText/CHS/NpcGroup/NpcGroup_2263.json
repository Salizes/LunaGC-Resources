{
    "groupId": "2263",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "前韵": 10
    },
    "talks": [
        {
            "talkId": "6226301",
            "initDialog": "622630101",
            "dialogues": [
                {
                    "id": "622630101",
                    "speaker": "前韵",
                    "text": "今年的茶树枝叶发黄，希望不会对口感产生影响…"
                }
            ]
        },
        {
            "talkId": "6226302",
            "initDialog": "622630201",
            "dialogues": [
                {
                    "id": "622630201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "622630202",
                    "speaker": "前韵",
                    "text": "您好，我是岩上茶室里专门负责茶叶的采办前韵。"
                }
            ]
        },
        {
            "talkId": "6226303",
            "initDialog": "622630301",
            "dialogues": [
                {
                    "id": "622630301",
                    "speaker": "Player",
                    "text": "关于茶叶…"
                },
                {
                    "id": "622630302",
                    "speaker": "前韵",
                    "text": "茶有汤色、叶底、香气、口感四韵，不同的人喜好也全然不同。"
                },
                {
                    "id": "622630303",
                    "speaker": "前韵",
                    "text": "若您打算购买茶叶的话，您可以考虑试试叶老板家的香茗。"
                },
                {
                    "id": "622630304",
                    "speaker": "前韵",
                    "text": "他家的成茶，香气浓郁丰富，滋味强劲厚重，令无数茶友为之倾倒，可谓上佳之选。"
                }
            ]
        },
        {
            "talkId": "6226304",
            "initDialog": "622630401",
            "dialogues": [
                {
                    "id": "622630401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622630402",
                    "speaker": "前韵",
                    "text": "嗯，期待下次再见。"
                }
            ]
        },
        {
            "talkId": "6226305",
            "initDialog": "622630501",
            "dialogues": [
                {
                    "id": "622630501",
                    "speaker": "Player",
                    "text": "关于岩上茶室的情况…"
                },
                {
                    "id": "622630502",
                    "speaker": "前韵",
                    "text": "感谢关心。"
                },
                {
                    "id": "622630503",
                    "speaker": "前韵",
                    "text": "自从老板接手茶室并将愚人众和嗜赌之人一并驱逐后，茶室就清朗了不少。"
                },
                {
                    "id": "622630504",
                    "speaker": "前韵",
                    "text": "如今的岩上茶室，绝对配得上璃月港内第一的名头。"
                },
                {
                    "id": "622630505",
                    "speaker": "前韵",
                    "text": "若您要在璃月港找个休憩处的话，还请务必试试我们岩上茶室。"
                }
            ]
        }
    ]
}