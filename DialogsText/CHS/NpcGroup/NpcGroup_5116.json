    "talks": [
        {
            "talkId": "6511601",
            "initDialog": "651160101",
            "dialogues": [
                {
                    "id": "651160101",
                    "speaker": "埃尔庇艾",
                    "text": "对待不同的案件，应当有不同的报道重点。"
                }
            ]
        },
        {
            "talkId": "6511602",
            "initDialog": "651160201",
            "dialogues": [
                {
                    "id": "651160201",
                    "speaker": "Player",
                    "text": "如何分辨？"
                },
                {
                    "id": "651160202",
                    "speaker": "埃尔庇艾",
                    "text": "这个得具体案情具体分析了，不过呢，我个人有个「偏方」。"
                },
                {
                    "id": "651160203",
                    "speaker": "埃尔庇艾",
                    "text": "若是芙宁娜大人亲临现场并且神色灵动，案件本身可能并不重要，但一定有其荒诞之处。"
                },
                {
                    "id": "651160204",
                    "speaker": "埃尔庇艾",
                    "text": "…就算案件不怎么特别，芙宁娜大人自己也会制造戏剧效果的。"
                },
                {
                    "id": "651160205",
                    "speaker": "埃尔庇艾",
                    "text": "而若是由最高审判官大人亲自审理，那多半很值得关注了。至少从新闻价值上来看，比前者重要得多。"
                },
                {
                    "id": "651160206",
                    "speaker": "埃尔庇艾",
                    "text": "但这种案子并没有那么容易报道，有些甚至会封锁消息呢。"
                }
            ]
        },
        {
            "talkId": "6511603",
            "initDialog": "651160301",
            "dialogues": [
                {
                    "id": "651160301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "651160302",
                    "speaker": "埃尔庇艾",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6511604",
            "initDialog": "651160401",
            "dialogues": [
                {
                    "id": "651160401",
                    "speaker": "Player",
                    "text": "如何分辨？"
                },
                {
                    "id": "651160402",
