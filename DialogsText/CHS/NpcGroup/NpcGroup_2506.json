{
    "groupId": "2506",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "丰泰": 11
    },
    "talks": [
        {
            "talkId": "6250601",
            "initDialog": "625060101",
            "dialogues": [
                {
                    "id": "625060101",
                    "speaker": "丰泰",
                    "text": "欢迎光临丰泰百货，从生活用品到纪念的玉器，这里应有尽有！"
                }
            ]
        },
        {
            "talkId": "6250602",
            "initDialog": "625060201",
            "dialogues": [
                {
                    "id": "625060201",
                    "speaker": "Player",
                    "text": "我看看商品…"
                },
                {
                    "id": "625060202",
                    "speaker": "丰泰",
                    "text": "没问题，请客人随意挑选！"
                }
            ]
        },
        {
            "talkId": "6250603",
            "initDialog": "625060301",
            "dialogues": [
                {
                    "id": "625060301",
                    "speaker": "Player",
                    "text": "玉器？"
                },
                {
                    "id": "625060302",
                    "speaker": "丰泰",
                    "text": "没错，本店也提供玉器定制服务，不过需要预约，加工时间也视玉器的精细程度而定。"
                },
                {
                    "id": "625060303",
                    "speaker": "丰泰",
                    "text": "宝玦可遇而不可求，有缘购得的美玉才与客人相性最好。"
                },
                {
                    "id": "625060304",
                    "speaker": "丰泰",
                    "text": "暂时无法购得玉器，也未必是一件坏事…"
                }
            ]
        },
        {
            "talkId": "6250604",
            "initDialog": "625060401",
            "dialogues": [
                {
                    "id": "625060401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "625060402",
                    "speaker": "丰泰",
                    "text": "客人再见，欢迎下次再来！"
                }
            ]
        },
        {
            "talkId": "6250605",
            "initDialog": "625060501",
            "dialogues": [
                {
                    "id": "625060501",
                    "speaker": "Player",
                    "text": "为什么很少看见玉器工匠？"
                },
                {
                    "id": "625060502",
                    "speaker": "丰泰",
                    "text": "许多客人和你提出过一样的问题，我年轻时也曾感到过疑惑。"
                },
                {
                    "id": "625060503",
                    "speaker": "丰泰",
                    "text": "我的师傅德音告诉我，雕琢美玉时，必须心无旁骛，专心致志。"
                },
                {
                    "id": "625060504",
                    "speaker": "丰泰",
                    "text": "要是玉器工匠要同时关注宣传和销售，心境就会被杂念侵扰，难以制出杰作。"
                },
                {
                    "id": "625060505",
                    "speaker": "丰泰",
                    "text": "因此，沉玉谷的玉器生产和销售是完全分开的。为的就是让玉器工匠们安心雕刻。"
                },
                {
                    "id": "625060506",
                    "speaker": "丰泰",
                    "text": "也许你路过一座毫不起眼的民宅时，屋内便有一位玉器工匠在慢慢雕琢着手中的玉石。"
                }
            ]
        }
    ]
}