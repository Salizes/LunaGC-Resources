{
    "groupId": "6014",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "夸梅": 4,
        "布鲁": 4
    },
    "talks": [
        {
            "talkId": "6601401",
            "initDialog": "660140101",
            "dialogues": [
                {
                    "id": "660140101",
                    "speaker": "布鲁",
                    "text": "虽然我知道，接下来我要问的这个问题，会耽误更多时间。"
                },
                {
                    "id": "660140102",
                    "speaker": "夸梅",
                    "text": "嗯…唔唔，你讲。"
                },
                {
                    "id": "660140103",
                    "speaker": "布鲁",
                    "text": "你知道从我们坐下来吃饭，一直到现在，已经过去多久了吗？"
                },
                {
                    "id": "660140104",
                    "speaker": "夸梅",
                    "text": "没注意，差不多刚吃完一个塔塔可的时间？"
                },
                {
                    "id": "660140105",
                    "speaker": "布鲁",
                    "text": "是你吃完一个塔塔可的时间吧！我这顿饭差不多都快消化完了！"
                },
                {
                    "id": "660140106",
                    "speaker": "夸梅",
                    "text": "喔，真厉害。别急嘛，吃完饭休息一下再出发，可以避免胃不舒服。"
                },
                {
                    "id": "660140107",
                    "speaker": "布鲁",
                    "text": "听你这意思，我还得谢谢你咯？"
                },
                {
                    "id": "660140108",
                    "speaker": "夸梅",
                    "text": "欸，对嘛。"
                }
            ]
        }
    ]
}