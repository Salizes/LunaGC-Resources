            "dialogues": [
                {
                    "id": "650500101",
                    "speaker": "茹斯托",
                    "text": "这样下去真的会出事的，怎么就没人关心呢？"
                }
            ]
        },
        {
            "talkId": "6505002",
            "initDialog": "650500201",
            "dialogues": [
                {
                    "id": "650500201",
                    "speaker": "Player",
                    "text": "关心什么？"
                },
                {
                    "id": "650500202",
                    "speaker": "茹斯托",
                    "text": "枫丹水域的污染问题！"
                },
                {
                    "id": "650500203",
                    "speaker": "茹斯托",
                    "text": "危机是如此醒目，就像将一滴墨水滴入清水里，但人们却都视而不见。"
                },
                {
                    "id": "650500204",
                    "speaker": "茹斯托",
                    "text": "难道只有我们卡朗代沙龙的人还在意枫丹的未来吗…"
                }
            ]
        },
        {
            "talkId": "6505003",
            "initDialog": "650500301",
            "dialogues": [
                {
                    "id": "650500301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650500302",
                    "speaker": "茹斯托",
                    "text": "相信我，朋友，我们都应该做些什么！"
                }
            ]
        }
    ]
