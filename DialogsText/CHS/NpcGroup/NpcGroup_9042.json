{
    "groupId": "9042",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 18,
        "刻晴": 48
    },
    "talks": [
        {
            "talkId": "6904201",
            "initDialog": "690420101",
            "dialogues": [
                {
                    "id": "690420101",
                    "speaker": "刻晴",
                    "text": "#{NICKNAME}，你好啊。"
                },
                {
                    "id": "690420102",
                    "speaker": "刻晴",
                    "text": "嗯…你好像还挺闲的嘛。"
                }
            ]
        },
        {
            "talkId": "6904202",
            "initDialog": "690420201",
            "dialogues": [
                {
                    "id": "690420201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690420202",
                    "speaker": "刻晴",
                    "text": "关于这个问题，如果你问的是感受，那我感觉不错。"
                },
                {
                    "id": "690420203",
                    "speaker": "刻晴",
                    "text": "只是…如果从专业性的角度出发，还有不少提升的空间。"
                },
                {
                    "id": "690420204",
                    "speaker": "刻晴",
                    "text": "首先，不用考虑灾害和外在风险已经让土地规划简化不少了。"
                },
                {
                    "id": "690420205",
                    "speaker": "刻晴",
                    "text": "对你而言最重要的问题，就是合理化空间利用率…"
                },
                {
                    "id": "690420206",
                    "speaker": "刻晴",
                    "text": "另外也要考虑好各资源的分配比例…",
                    "choices": [
                        {
                            "id": "690420207",
                            "text": "我大概明白了…",
                            "response": [
                                {
                                    "id": "690420209",
                                    "speaker": "刻晴",
                                    "text": "啊…没关系。我只是…有点职业习惯。"
                                },
                                {
                                    "id": "690420210",
                                    "speaker": "刻晴",
                                    "text": "按你的想法来做吧！"
                                },
                                {
                                    "id": "690420211",
                                    "speaker": "刻晴",
                                    "text": "这才是你的家，才有你的样子！"
                                }
                            ]
                        },
                        {
                            "id": "690420208",
                            "text": "我一句也没听懂…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904203",
            "initDialog": "690420301",
            "dialogues": [
                {
                    "id": "690420301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690420302",
                    "speaker": "刻晴",
                    "text": "嗯，我没问题。"
                },
                {
                    "id": "690420303",
                    "speaker": "刻晴",
                    "text": "不过有言在先，大多数人认为和我聊天的体验并不好。"
                },
                {
                    "id": "690420304",
                    "speaker": "Player",
                    "text": "欸，比如呢？"
                },
                {
                    "id": "690420305",
                    "speaker": "刻晴",
                    "text": "比如之前有同事问我：「刻晴小姐有什么需要我帮忙的吗？」"
                },
                {
                    "id": "690420306",
                    "speaker": "刻晴",
                    "text": "我说：「先把你自己的工作效率提上去吧。」"
                },
                {
                    "id": "690420307",
                    "speaker": "刻晴",
                    "text": "后来，就再也没来找过我了。"
                },
                {
                    "id": "690420308",
                    "speaker": "刻晴",
                    "text": "还有人问我：「知不知道凝光小姐喜欢怎样的礼物？」"
                },
                {
                    "id": "690420309",
                    "speaker": "刻晴",
                    "text": "我说：「放弃吧。凝光她根本不会在乎献殷勤的对象。」"
                },
                {
                    "id": "690420310",
                    "speaker": "刻晴",
                    "text": "嗯，所以…你也明白了吧。",
                    "choices": [
                        {
                            "id": "690420311",
                            "text": "刻晴只是有话直说吧。",
                            "response": [
                                {
                                    "id": "690420313",
                                    "speaker": "刻晴",
                                    "text": "嗯…我觉得没有必要选择所谓委婉或者含蓄的表达。"
                                },
                                {
                                    "id": "690420314",
                                    "speaker": "刻晴",
                                    "text": "不管是粉饰后的事实或是善意的谎言，那都是浪费彼此的时间。",
                                    "choices": [
                                        {
                                            "id": "690420315",
                                            "text": "不如直接一点。",
                                            "response": [
                                                {
                                                    "id": "690420316",
                                                    "speaker": "刻晴",
                                                    "text": "没错。你果然很了解我。"
                                                },
                                                {
                                                    "id": "690420317",
                                                    "speaker": "刻晴",
                                                    "text": "看来我没有看错，我们还是很聊得来的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690420318",
                                            "text": "不过这样会降低别人对刻晴的评价吗？",
                                            "response": [
                                                {
                                                    "id": "690420319",
                                                    "speaker": "刻晴",
                                                    "text": "如果是这些人的评价，我不在意。"
                                                },
                                                {
                                                    "id": "690420320",
                                                    "speaker": "刻晴",
                                                    "text": "如果是你的评价…"
                                                },
                                                {
                                                    "id": "690420321",
                                                    "speaker": "刻晴",
                                                    "text": "那…我会考虑一下的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690420312",
                            "text": "我觉得这也不是坏事。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904204",
            "initDialog": "690420401",
            "dialogues": [
                {
                    "id": "690420401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690420402",
                    "speaker": "刻晴",
                    "text": "嗯，我们先约个晚上双方都方便的时间吧。"
                },
                {
                    "id": "690420403",
                    "speaker": "刻晴",
                    "text": "不久前，我花了点时间，亲自走遍了这片家园的每一寸土地。"
                },
                {
                    "id": "690420404",
                    "speaker": "刻晴",
                    "text": "找到了三处我心目中风景秀丽的地方。"
                },
                {
                    "id": "690420405",
                    "speaker": "刻晴",
                    "text": "其中有一处，非常适合在夜晚看星星。"
                },
                {
                    "id": "690420406",
                    "speaker": "刻晴",
                    "text": "怎么样，你有兴趣吗？",
                    "choices": [
                        {
                            "id": "690420407",
                            "text": "当然有兴趣。",
                            "response": [
                                {
                                    "id": "690420408",
                                    "speaker": "刻晴",
                                    "text": "那就好。"
                                },
                                {
                                    "id": "690420409",
                                    "speaker": "刻晴",
                                    "text": "问之前我还有些忐忑，甚至考虑了如果你拒绝的话要怎么说服你…"
                                },
                                {
                                    "id": "690420412",
                                    "speaker": "刻晴",
                                    "text": "我是把它当做…对自己完成一阶段工作后的奖励来考虑的。"
                                },
                                {
                                    "id": "690420413",
                                    "speaker": "刻晴",
                                    "text": "这种不可多得的幸福，要小心地使用。"
                                },
                                {
                                    "id": "690420414",
                                    "speaker": "Player",
                                    "text": "刻晴…"
                                },
                                {
                                    "id": "690420415",
                                    "speaker": "刻晴",
                                    "text": "既然你没有异议，那就尽快安排一下你的日程吧。"
                                },
                                {
                                    "id": "690420416",
                                    "speaker": "刻晴",
                                    "text": "问我的话，当然是越快越好。"
                                }
                            ]
                        },
                        {
                            "id": "690420410",
                            "text": "没想到刻晴还有观星的爱好。",
                            "response": [
                                {
                                    "id": "690420411",
                                    "speaker": "刻晴",
                                    "text": "也不算爱好吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904205",
            "initDialog": "690420501",
            "dialogues": [
                {
                    "id": "690420501",
                    "speaker": "Player",
                    "text": "早啊，刻晴。"
                },
                {
                    "id": "690420502",
                    "speaker": "刻晴",
                    "text": "#嗯，早。{NICKNAME}。"
                },
                {
                    "id": "690420503",
                    "speaker": "刻晴",
                    "text": "咳咳…多余的寒暄我就不说了。有事叫我就好。"
                }
            ]
        },
        {
            "talkId": "6904206",
            "initDialog": "690420601",
            "dialogues": [
                {
                    "id": "690420601",
                    "speaker": "Player",
                    "text": "晚安，刻晴。"
                },
                {
                    "id": "690420602",
                    "speaker": "刻晴",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690420603",
                    "speaker": "刻晴",
                    "text": "等等！…如果你有没做完的事情，就不要留到第二天了。"
                },
                {
                    "id": "690420604",
                    "speaker": "刻晴",
                    "text": "可以交给我来做。"
                }
            ]
        },
        {
            "talkId": "6904207",
            "initDialog": "690420701",
            "dialogues": [
                {
                    "id": "690420701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904208",
            "initDialog": "690420801",
            "dialogues": [
                {
                    "id": "690420801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904209",
            "initDialog": "690420901",
            "dialogues": [
                {
                    "id": "690420901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904250",
            "initDialog": "690425001",
            "dialogues": [
                {
                    "id": "690425001",
                    "speaker": "刻晴",
                    "text": "果然，你仔细观察过璃月的街道。"
                },
                {
                    "id": "690425002",
                    "speaker": "刻晴",
                    "text": "对商铺的布局，摊位的摆放，都有深入研究。"
                },
                {
                    "id": "690425003",
                    "speaker": "刻晴",
                    "text": "有兴趣和我讨论讨论吃虎岩的改进规划吗？"
                }
            ]
        },
        {
            "talkId": "6904251",
            "initDialog": "690425101",
            "dialogues": [
                {
                    "id": "690425101",
                    "speaker": "刻晴",
                    "text": "恰到好处的休息，的确是工作的保障。"
                },
                {
                    "id": "690425102",
                    "speaker": "刻晴",
                    "text": "这间睡房万事俱备，只差一件重要的家具，「时钟」，衡量时间的标尺。"
                },
                {
                    "id": "690425103",
                    "speaker": "刻晴",
                    "text": "找个时间，我陪你去采购时钟吧，以防今后睡过头，耽误了要事。"
                }
            ]
        }
    ]
}