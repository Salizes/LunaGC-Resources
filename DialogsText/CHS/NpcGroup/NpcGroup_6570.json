        {
            "talkId": "6657001",
            "initDialog": "665700101",
            "dialogues": [
                {
                    "id": "665700101",
                    "speaker": "厄尔蜜",
                    "text": "为什么我会出现在这种地方…"
                },
                {
                    "id": "665700102",
                    "speaker": "Player",
                    "text": "你看起来不太开心。"
                },
                {
                    "id": "665700103",
                    "speaker": "厄尔蜜",
                    "text": "谁说不是呢？我和塔雅打赌输了，才不得不陪她来这里。"
                },
                {
                    "id": "665700104",
                    "speaker": "厄尔蜜",
                    "text": "原本我们被分到尝露酒吧工作，结果谁想到尝露酒吧有两个，东边一个，西边一个。"
                },
                {
                    "id": "665700105",
                    "speaker": "Player",
                    "text": "所以你们被分开了？"
                },
                {
                    "id": "665700106",
                    "speaker": "厄尔蜜",
                    "text": "谁说不是呢？这下我们就和傍晚的太阳跟月亮一样了，东边一个，西边一个。"
                }
            ]
        }
    ]
}