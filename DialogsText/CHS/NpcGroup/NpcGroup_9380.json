{
    "groupId": "9380",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "克洛琳德": 9
    },
    "talks": [
        {
            "talkId": "6938001",
            "initDialog": "693800101",
            "dialogues": [
                {
                    "id": "693800101",
                    "speaker": "克洛琳德",
                    "text": "我很少遇上中途休息的机会，也没有在战斗间隙慢下来的习惯。"
                },
                {
                    "id": "693800102",
                    "speaker": "克洛琳德",
                    "text": "但现在并非我单独行动的场合，我会配合你。"
                },
                {
                    "id": "693800103",
                    "speaker": "克洛琳德",
                    "text": "不管怎么说，这里作为休息场所是合格的。"
                }
            ]
        },
        {
            "talkId": "6938002",
            "initDialog": "693800201",
            "dialogues": [
                {
                    "id": "693800201",
                    "speaker": "克洛琳德",
                    "text": "旁人常常认为我非常看重胜负，因为我有着决斗代理人的身份。"
                },
                {
                    "id": "693800202",
                    "speaker": "克洛琳德",
                    "text": "事实恰恰相反。只要是敢于迎接挑战的人，无论输赢，我都会给予高于基础水平的尊重。"
                },
                {
                    "id": "693800203",
                    "speaker": "克洛琳德",
                    "text": "实力只需要经验与积累，但勇气来自坚强的内心。"
                }
            ]
        },
        {
            "talkId": "6938003",
            "initDialog": "693800301",
            "dialogues": [
                {
                    "id": "693800301",
                    "speaker": "克洛琳德",
                    "text": "在下一场战斗来临前，我就在这里读点书吧。"
                },
                {
                    "id": "693800302",
                    "speaker": "克洛琳德",
                    "text": "还请不要向我推荐报纸一类的读物，我知道它们从功能上来说更适合打发短暂的休息时间…"
                },
                {
                    "id": "693800303",
                    "speaker": "克洛琳德",
                    "text": "但我不喜欢。"
                }
            ]
        }
    ]
}