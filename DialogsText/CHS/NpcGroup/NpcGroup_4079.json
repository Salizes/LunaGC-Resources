    "talks": [
        {
            "talkId": "6407901",
            "initDialog": "640790101",
            "dialogues": [
                {
                    "id": "640790101",
                    "speaker": "瓦尔坦",
                    "text": "树王大人保佑，我的儿子得以从海难中幸存…"
                }
            ]
        },
        {
            "talkId": "6407902",
            "initDialog": "640790201",
            "dialogues": [
                {
                    "id": "640790201",
                    "speaker": "Player",
                    "text": "关于你的儿子…"
                },
                {
                    "id": "640790202",
                    "speaker": "瓦尔坦",
                    "text": "我儿子以前是渔夫，在一次出海时遭遇了海难。"
                },
                {
                    "id": "640790203",
                    "speaker": "瓦尔坦",
                    "text": "眼见就要性命不保，最后一刻被「健康之家」的医师们救下，这才让我们全家团聚。"
                },
                {
                    "id": "640790204",
                    "speaker": "瓦尔坦",
                    "text": "从此我家便开始为「健康之家」免费提供药草。"
                },
                {
                    "id": "640790205",
                    "speaker": "瓦尔坦",
                    "text": "只是一方小院，产量不多，但只要能帮上一点忙，我就愿意尽力而为。"
                }
            ]
        },
        {
            "talkId": "6407903",
            "initDialog": "640790301",
            "dialogues": [
                {
                    "id": "640790301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640790302",
                    "speaker": "瓦尔坦",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6407904",
            "initDialog": "640790401",
            "dialogues": [
                {
                    "id": "640790401",
                    "speaker": "瓦尔坦",
                    "text": "小吉祥草王大人保佑，我的儿子得以从海难中幸存…"
                }
            ]
        }
    ]
}