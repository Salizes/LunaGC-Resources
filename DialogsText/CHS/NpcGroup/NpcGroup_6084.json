{
    "groupId": "6084",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "伊蜜": 9
    },
    "talks": [
        {
            "talkId": "6608401",
            "initDialog": "660840101",
            "dialogues": [
                {
                    "id": "660840101",
                    "speaker": "伊蜜",
                    "text": "你好！亮闪闪的你，应该配闪亮亮的宝石！"
                }
            ]
        },
        {
            "talkId": "6608402",
            "initDialog": "660840201",
            "dialogues": [
                {
                    "id": "660840201",
                    "speaker": "Player",
                    "text": "有什么推荐？"
                },
                {
                    "id": "660840202",
                    "speaker": "伊蜜",
                    "text": "我家的宝石可受欢迎了！现货只有这些，其他的可以为你「量身定制」。"
                }
            ]
        },
        {
            "talkId": "6608403",
            "initDialog": "660840301",
            "dialogues": [
                {
                    "id": "660840301",
                    "speaker": "Player",
                    "text": "我是亮闪闪的吗？"
                },
                {
                    "id": "660840302",
                    "speaker": "伊蜜",
                    "text": "对啊，对啊，每个人都闪着不同的光，不是吗？"
                },
                {
                    "id": "660840303",
                    "speaker": "伊蜜",
                    "text": "夏温师父是蓝盈盈的，希诺宁姐姐是金灿灿的，卡齐娜则是红通通暖烘烘的…"
                },
                {
                    "id": "660840304",
                    "speaker": "伊蜜",
                    "text": "我的话…嘿嘿，先不告诉你！"
                }
            ]
        },
        {
            "talkId": "6608404",
            "initDialog": "660840401",
            "dialogues": [
                {
                    "id": "660840401",
                    "speaker": "Player",
                    "text": "谢谢夸奖。"
                },
                {
                    "id": "660840402",
                    "speaker": "伊蜜",
                    "text": "不客气，欢迎多来！"
                }
            ]
        },
        {
            "talkId": "6608405",
            "initDialog": "660840501",
            "dialogues": [
                {
                    "id": "660840501",
                    "speaker": "Player",
                    "text": "真能看到颜色吗？"
                },
                {
                    "id": "660840502",
                    "speaker": "伊蜜",
                    "text": "哼哼…不可以问这么不浪漫的问题哦？人的感受可是互通的，味道、颜色、温度，都差不多嘛。"
                },
                {
                    "id": "660840503",
                    "speaker": "伊蜜",
                    "text": "所以，每个人都有一种最适合自己的宝石，即使它在别人眼里只是弹珠，对你来说也可能是最特别的存在。"
                },
                {
                    "id": "660840504",
                    "speaker": "伊蜜",
                    "text": "夏温师父的宝石库是我见过的最——大——的，怎么样，要来找找看吗？"
                }
            ]
        }
    ]
}