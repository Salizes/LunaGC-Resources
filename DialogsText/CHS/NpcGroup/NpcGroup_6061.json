    },
    "talks": [
        {
            "talkId": "6606101",
            "initDialog": "660610101",
            "dialogues": [
                {
                    "id": "660610101",
                    "speaker": "瓦蕾",
                    "text": "失策…真是失策…"
                }
            ]
        },
        {
            "talkId": "6606102",
            "initDialog": "660610201",
            "dialogues": [
                {
                    "id": "660610201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "660610202",
                    "speaker": "瓦蕾",
                    "text": "在出发来纳塔旅游前，确实有人提醒过我，纳塔天气很热，要准备些舒适的衣服。"
                },
                {
                    "id": "660610203",
                    "speaker": "瓦蕾",
                    "text": "但没想到流泉之众这里竟然这么热，连布料最薄的裙子也不够凉快。"
                }
            ]
        },
        {
            "talkId": "6606103",
            "initDialog": "660610301",
            "dialogues": [
                {
                    "id": "660610301",
                    "speaker": "Player",
                    "text": "保重。"
                },
                {
                    "id": "660610302",
                    "speaker": "瓦蕾",
                    "text": "嗯？哦，没关系，问题已经差不多解决了。"
                }
            ]
        },
        {
            "talkId": "6606104",
            "initDialog": "660610401",
            "dialogues": [
                {
                    "id": "660610401",
                    "speaker": "Player",
                    "text": "不买些新的吗？"
                },
                {
                    "id": "660610402",
                    "speaker": "瓦蕾",
                    "text": "当然要买！还要买个痛快。"
                },
                {
                    "id": "660610403",
                    "speaker": "瓦蕾",
                    "text": "我已经量身定制了最新潮的泳装，还有好多设计师款的限量滑板。"
                },
                {
                    "id": "660610404",
                    "speaker": "瓦蕾",
                    "text": "就是制作需要一段时间，得等一阵才行。不过没关系，先在这里听听音乐也不错。"
                },
                {
                    "id": "660610405",
                    "speaker": "瓦蕾",
                    "text": "这里的人都悠闲自在，音乐也是如此，我觉得比流行摇滚更适合我。"
                }
            ]
        }
    ]
}