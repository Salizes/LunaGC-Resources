{
    "groupId": "6067",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "安切塔": 14
    },
    "talks": [
        {
            "talkId": "6606701",
            "initDialog": "660670101",
            "dialogues": [
                {
                    "id": "660670101",
                    "speaker": "安切塔",
                    "text": "欢迎光临，要试试乐器吗？"
                }
            ]
        },
        {
            "talkId": "6606702",
            "initDialog": "660670201",
            "dialogues": [
                {
                    "id": "660670201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "660670202",
                    "speaker": "安切塔",
                    "text": "我是「金贝乐棚」的老板，卖一些老乐器。"
                },
                {
                    "id": "660670203",
                    "speaker": "安切塔",
                    "text": "有不少在科隆切广场看完乐团表演的游客跑过来买乐器，我都会让他们先试一试，等第二天再来买。"
                },
                {
                    "id": "660670204",
                    "speaker": "安切塔",
                    "text": "好多年轻人啊，容易被氛围感染，一时冲动买了乐器回家，就再没弹过了。"
                },
                {
                    "id": "660670205",
                    "speaker": "安切塔",
                    "text": "这里的乐器我多少都有些感情，不想让它们被冷落啊。"
                },
                {
                    "id": "660670206",
                    "speaker": "安切塔",
                    "text": "所以我会给客人们一个冷静下来的机会。等想好了，再来买也不迟。"
                },
                {
                    "id": "660670207",
                    "speaker": "安切塔",
                    "text": "反正这家店一直在这里，哪也不会去；而且，单纯地享受音乐就已经很好了。"
                }
            ]
        },
        {
            "talkId": "6606703",
            "initDialog": "660670301",
            "dialogues": [
                {
                    "id": "660670301",
                    "speaker": "Player",
                    "text": "老家伙们是指…"
                },
                {
                    "id": "660670302",
                    "speaker": "安切塔",
                    "text": "哎呀，你听到了？让你见笑了，我说的是那些烟谜主的老伙计们。"
                },
                {
                    "id": "660670303",
                    "speaker": "安切塔",
                    "text": "他们部族办的一些活动上需要演奏和唱歌，我常被请去弹琴。"
                },
                {
                    "id": "660670304",
                    "speaker": "安切塔",
                    "text": "不过每次都是我千里迢迢赶去他们那里，他们也不说过来看看我！"
                },
                {
                    "id": "660670305",
                    "speaker": "安切塔",
                    "text": "唉，算了，那些老家伙们就是这样啦。"
                },
                {
                    "id": "660670306",
                    "speaker": "安切塔",
                    "text": "除非专门写信请他们出门，不然休想让他们挪动半步——我才不要呢！"
                }
            ]
        },
        {
            "talkId": "6606704",
            "initDialog": "660670401",
            "dialogues": [
                {
                    "id": "660670401",
                    "speaker": "Player",
                    "text": "先不用了。"
                },
                {
                    "id": "660670402",
                    "speaker": "安切塔",
                    "text": "哎，慢走。"
                }
            ]
        },
        {
            "talkId": "6606705",
            "initDialog": "660670501",
            "dialogues": [
                {
                    "id": "660670501",
                    "speaker": "Player",
                    "text": "有什么适合我的吗？"
                },
                {
                    "id": "660670502",
                    "speaker": "安切塔",
                    "text": "哈哈，那要看客人的天赋如何了。"
                }
            ]
        }
    ]
}