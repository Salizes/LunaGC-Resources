{
    "groupId": "4135",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "沙普尔": 12
    },
    "talks": [
        {
            "talkId": "6413501",
            "initDialog": "641350101",
            "dialogues": [
                {
                    "id": "641350101",
                    "speaker": "沙普尔",
                    "text": "醒醒…醒醒！在吗？"
                }
            ]
        },
        {
            "talkId": "6413502",
            "initDialog": "641350201",
            "dialogues": [
                {
                    "id": "641350201",
                    "speaker": "Player",
                    "text": "「醒醒」？"
                },
                {
                    "id": "641350202",
                    "speaker": "沙普尔",
                    "text": "噢，是客人吗？"
                },
                {
                    "id": "641350203",
                    "speaker": "沙普尔",
                    "text": "「醒醒」是我养的一只猫的名字，我正问它事呢。"
                },
                {
                    "id": "641350204",
                    "speaker": "沙普尔",
                    "text": "不过这家伙最近不知在闹什么脾气，怎么叫都不答应。"
                },
                {
                    "id": "641350205",
                    "speaker": "沙普尔",
                    "text": "算了，不管它，可能又跟欧欧一起鬼混去了。"
                },
                {
                    "id": "641350206",
                    "speaker": "沙普尔",
                    "text": "我还是先叫我女儿给你办入住吧。莎莉，莎莉——在吗？"
                }
            ]
        },
        {
            "talkId": "6413503",
            "initDialog": "641350301",
            "dialogues": [
                {
                    "id": "641350301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641350302",
                    "speaker": "沙普尔",
                    "text": "哎呦，你都到门口了，还看不出我是谁吗？"
                },
                {
                    "id": "641350303",
                    "speaker": "沙普尔",
                    "text": "我是旅店的老板，旅店的老板就是我。"
                },
                {
                    "id": "641350304",
                    "speaker": "沙普尔",
                    "text": "哎，醒醒你看，不是我说，最近的年轻人注意力就是不行。"
                },
                {
                    "id": "641350305",
                    "speaker": "沙普尔",
                    "text": "……"
                },
                {
                    "id": "641350306",
                    "speaker": "沙普尔",
                    "text": "醒醒？醒醒！哎这胖猫，又去哪了？"
                }
            ]
        },
        {
            "talkId": "6413504",
            "initDialog": "641350401",
            "dialogues": [
                {
                    "id": "641350401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641350402",
                    "speaker": "沙普尔",
                    "text": "算了叫不动，我还是问欧欧吧。"
                }
            ]
        }
    ]
}