    },
    "talks": [
        {
            "talkId": "4111545",
            "initDialog": "411154501",
            "dialogues": [
                {
                    "id": "411154501",
                    "speaker": "阿义",
                    "text": "咦，陌生人。你也没睡着呀，那就和我一起来听故事吧。"
                }
            ]
        },
        {
            "talkId": "6214901",
            "initDialog": "621490101",
            "dialogues": [
                {
                    "id": "621490101",
                    "speaker": "阿义",
                    "text": "你好，陌生人！你也是来听故事的吗？"
                }
            ]
        },
        {
            "talkId": "6214902",
            "initDialog": "621490201",
            "dialogues": [
                {
                    "id": "621490201",
                    "speaker": "Player",
                    "text": "故事？"
                },
                {
                    "id": "621490202",
                    "speaker": "阿义",
                    "text": "嗯！鬼伯伯的故事都很有意思、很吓人…而且很真实！",
                    "choices": [
                        {
                            "id": "621490203",
                            "text": "很真实…？",
                            "response": [
                                {
                                    "id": "621490204",
                                    "speaker": "阿义",
                                    "text": "嗯嗯！他讲的故事，有些是真的发生过的哦…"
                                },
                                {
                                    "id": "621490205",
                                    "speaker": "阿义",
                                    "text": "比如那个小冥！我真的见过她的，还说下次再来找我玩…"
                                },
                                {
                                    "id": "621490206",
                                    "speaker": "阿义",
                                    "text": "话说鬼的记性是不是不太好呢，怎么还没有来找我玩，明明每天晚上我都开着门睡觉的。"
                                }
                            ]
                        },
                        {
                            "id": "621490207",
                            "text": "好可怕…",
                            "response": [
                                {
                                    "id": "621490208",
                                    "speaker": "阿义",
                                    "text": "对吧对吧！虽然我也每次都被吓得不轻…"
                                },
                                {
                                    "id": "621490209",
                                    "speaker": "阿义",
                                    "text": "但后来真的见到了小冥，就不再怕了。鬼其实也不是那么吓人嘛！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6214903",
            "initDialog": "621490301",
            "dialogues": [
                {
                    "id": "621490301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621490302",
                    "speaker": "阿义",
                    "text": "再见！"
                }
            ]
        }
    ]
}