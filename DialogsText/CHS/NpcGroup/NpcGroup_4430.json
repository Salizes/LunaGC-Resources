    "talks": [
        {
            "talkId": "6443001",
            "initDialog": "644300101",
            "dialogues": [
                {
                    "id": "644300101",
                    "speaker": "奈拉",
                    "text": "赤王…唉…"
                }
            ]
        },
        {
            "talkId": "6443002",
            "initDialog": "644300201",
            "dialogues": [
                {
                    "id": "644300201",
                    "speaker": "Player",
                    "text": "…你还相信赤王吗？"
                },
                {
                    "id": "644300202",
                    "speaker": "奈拉",
                    "text": "…我仍然信仰赤王。我从小就在镀金旅团里，听着赤王的传说长大，信仰不会说变就变的。"
                },
                {
                    "id": "644300203",
                    "speaker": "奈拉",
                    "text": "但我不会再相信赤王会复活了。"
                },
                {
                    "id": "644300204",
                    "speaker": "奈拉",
                    "text": "看你的样子，应该就是老大说的那个新伙伴了吧。"
                },
                {
                    "id": "644300205",
                    "speaker": "奈拉",
                    "text": "我们镀金旅团欢迎同伴，但我也要提醒你，同伴也并不是永恒的哦。"
                },
                {
                    "id": "644300206",
                    "speaker": "奈拉",
                    "text": "至少我自己不能保证，我们今后的立场会永远相同。"
                }
            ]
        },
        {
            "talkId": "6443003",
            "initDialog": "644300301",
            "dialogues": [
                {
                    "id": "644300301",
                    "speaker": "Player",
                    "text": "赤王复活是个谎言。"
                },
                {
                    "id": "644300302",
                    "speaker": "奈拉",
                    "text": "…嗯，我明白的。"
                }
            ]
        }
    ]
}