{
    "groupId": "9120",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 16,
        "菲林斯": 53
    },
    "talks": [
        {
            "talkId": "6912001",
            "initDialog": "691200101",
            "dialogues": [
                {
                    "id": "691200101",
                    "speaker": "菲林斯",
                    "text": "你居所的环境舒适安逸，室内外的造景也极富格调，能感受到主人的品味。"
                },
                {
                    "id": "691200102",
                    "speaker": "菲林斯",
                    "text": "#{NICKNAME}，感谢你邀我来这里小住。"
                }
            ]
        },
        {
            "talkId": "6912002",
            "initDialog": "691200201",
            "dialogues": [
                {
                    "id": "691200201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691200202",
                    "speaker": "菲林斯",
                    "text": "你的关心令人感动，请放心，我感觉很好。"
                },
                {
                    "id": "691200203",
                    "speaker": "菲林斯",
                    "text": "这里的各种用度一应俱全，能从中感受到主人的体贴。",
                    "choices": [
                        {
                            "id": "691200204",
                            "text": "你太客气了。",
                            "response": [
                                {
                                    "id": "691200205",
                                    "speaker": "菲林斯",
                                    "text": "我空手前来，并未携带任何礼物。"
                                },
                                {
                                    "id": "691200206",
                                    "speaker": "菲林斯",
                                    "text": "你用自己准备的食物招待我，我提供真心的赞美，这是应有的礼节。"
                                },
                                {
                                    "id": "691200210",
                                    "speaker": "菲林斯",
                                    "text": "但除了这份好奇心催生而出的欲望，我其他的物质需求都已经被满足了。"
                                },
                                {
                                    "id": "691200211",
                                    "speaker": "Player",
                                    "text": "真别客气啊！"
                                },
                                {
                                    "id": "691200212",
                                    "speaker": "菲林斯",
                                    "text": "你实在太会照料我的感受了。非要吹毛求疵的话，我只能就住所的分配问题提出一些苛刻的意见了。"
                                },
                                {
                                    "id": "691200213",
                                    "speaker": "菲林斯",
                                    "text": "你方便的话，或许，可以给我划分一个更幽静遮光的角落吗？"
                                },
                                {
                                    "id": "691200214",
                                    "speaker": "菲林斯",
                                    "text": "对我这样一个长年住在墓园的人来说，晦暗的环境反而更令人自在。"
                                }
                            ]
                        },
                        {
                            "id": "691200207",
                            "text": "有缺的告诉我。",
                            "response": [
                                {
                                    "id": "691200208",
                                    "speaker": "菲林斯",
                                    "text": "你的屋子里有不少储藏空间，我毫不怀疑你作为周游四方的冒险家，储藏了不少好货。"
                                },
                                {
                                    "id": "691200209",
                                    "speaker": "菲林斯",
                                    "text": "等你有空之后，我很希望能一起看看这些珍藏。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912003",
            "initDialog": "691200301",
            "dialogues": [
                {
                    "id": "691200301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691200302",
                    "speaker": "菲林斯",
                    "text": "非常乐意。你有想要讨论的事吗？"
                },
                {
                    "id": "691200303",
                    "speaker": "Player",
                    "text": "一下子想不出话题…"
                },
                {
                    "id": "691200304",
                    "speaker": "菲林斯",
                    "text": "什么都可以，我们可以讨论死亡、自由、意义与独处，也可以聊一聊下一顿饭吃什么。"
                },
                {
                    "id": "691200305",
                    "speaker": "菲林斯",
                    "text": "不过，或许我可以理解这样的状态。"
                },
                {
                    "id": "691200306",
                    "speaker": "菲林斯",
                    "text": "当人们刻意地想要同彼此说话时，一切努力反而容易成为徒劳。"
                },
                {
                    "id": "691200307",
                    "speaker": "菲林斯",
                    "text": "如果我们想要交流，不应当犹豫，上一秒在心里盘桓的念头，下一秒就把它念出来。"
                },
                {
                    "id": "691200308",
                    "speaker": "菲林斯",
                    "text": "不管这些心思有多琐碎，我们可以随时把它们说出来。"
                },
                {
                    "id": "691200309",
                    "speaker": "菲林斯",
                    "text": "譬如今天出门的时候看到了一只虫子，譬如稍后打算去钓鱼。",
                    "choices": [
                        {
                            "id": "691200310",
                            "text": "想到话题了，想问菲林斯为什么留长发？",
                            "response": [
                                {
                                    "id": "691200311",
                                    "speaker": "菲林斯",
                                    "text": "我为什么不像同僚们那样，留更利落一些的短发？我为什么会选择这样的形象？"
                                },
                                {
                                    "id": "691200312",
                                    "speaker": "菲林斯",
                                    "text": "原来你对这件事感兴趣，哦，知道这一点也有利于增进我对你的了解。"
                                },
                                {
                                    "id": "691200313",
                                    "speaker": "菲林斯",
                                    "text": "我听说过一种说法，人的外在形象是对他内心以及过往经历的反映。"
                                },
                                {
                                    "id": "691200314",
                                    "speaker": "菲林斯",
                                    "text": "在某个时期，整洁柔滑的长发是身份的象征，我保留了那个时期的习惯。"
                                },
                                {
                                    "id": "691200315",
                                    "speaker": "菲林斯",
                                    "text": "我想，这足够回答你的问题了。"
                                }
                            ]
                        },
                        {
                            "id": "691200316",
                            "text": "想到话题了，想问菲林斯是否了解至冬堡？",
                            "response": [
                                {
                                    "id": "691200317",
                                    "speaker": "菲林斯",
                                    "text": "我记得你似乎打算日后拜访至冬堡，现在的确有必要搜寻一些有关信息。"
                                },
                                {
                                    "id": "691200318",
                                    "speaker": "菲林斯",
                                    "text": "我对至冬堡的记忆已经模糊了，但还隐约记得那是一座美丽的城市。"
                                },
                                {
                                    "id": "691200319",
                                    "speaker": "菲林斯",
                                    "text": "璀璨的夜空、永不停歇的风雪，现在的她似乎变成了工业发达的城市。"
                                },
                                {
                                    "id": "691200320",
                                    "speaker": "菲林斯",
                                    "text": "有些妖精至今依然居住在那里，或许是已经适应了极寒，再也无法在温暖的地方生活了吧。"
                                },
                                {
                                    "id": "691200321",
                                    "speaker": "菲林斯",
                                    "text": "不知道现在的至冬堡是什么样子…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912004",
            "initDialog": "691200401",
            "dialogues": [
                {
                    "id": "691200401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691200402",
                    "speaker": "菲林斯",
                    "text": "最近有些思念睡眠。"
                },
                {
                    "id": "691200403",
                    "speaker": "Player",
                    "text": "在这儿睡得不好吗？"
                },
                {
                    "id": "691200404",
                    "speaker": "菲林斯",
                    "text": "哦不，请别误会，我不是这个意思，这里的床铺很柔软，远胜我的需要。"
                },
                {
                    "id": "691200405",
                    "speaker": "菲林斯",
                    "text": "况且，对我这样一个自备居所的人来说，我还从未因为环境不适而产生睡眠不足的问题。"
                },
                {
                    "id": "691200406",
                    "speaker": "Player",
                    "text": "那是…？"
                },
                {
                    "id": "691200407",
                    "speaker": "菲林斯",
                    "text": "我正在怀念过去某个时期，我在绝对的黑暗中独自沉睡。"
                },
                {
                    "id": "691200408",
                    "speaker": "菲林斯",
                    "text": "那种睡眠里既没有梦也没有意识，感受不到欢乐，也感受不到痛苦。"
                },
                {
                    "id": "691200409",
                    "speaker": "菲林斯",
                    "text": "一种很奇妙的状态，绝对的安宁，绝对的空无。"
                },
                {
                    "id": "691200410",
                    "speaker": "菲林斯",
                    "text": "对一般人来说或许很难想象，但我曾经长期浸泡其中。"
                },
                {
                    "id": "691200411",
                    "speaker": "菲林斯",
                    "text": "和这样的睡眠相比，人们每夜所要经历的充满了梦的睡眠就显得过于喧闹了。"
                },
                {
                    "id": "691200412",
                    "speaker": "Player",
                    "text": "你该不会…？"
                },
                {
                    "id": "691200413",
                    "speaker": "菲林斯",
                    "text": "想要重新熄灭自己？当然不会。"
                },
                {
                    "id": "691200414",
                    "speaker": "菲林斯",
                    "text": "思索过去所经历的事情，是为了审视自己此刻的判断和现今所处的位置。"
                },
                {
                    "id": "691200415",
                    "speaker": "菲林斯",
                    "text": "怀念安宁与为了新的目标舍弃安宁，两者并不冲突。"
                },
                {
                    "id": "691200416",
                    "speaker": "菲林斯",
                    "text": "希望这些絮絮叨叨不会使你觉得无聊。",
                    "choices": [
                        {
                            "id": "691200417",
                            "text": "不会。",
                            "response": [
                                {
                                    "id": "691200418",
                                    "speaker": "菲林斯",
                                    "text": "太好了，能与你分享这些琐碎的思绪，这是我们友谊的证明。"
                                }
                            ]
                        },
                        {
                            "id": "691200419",
                            "text": "听不太明白。",
                            "response": [
                                {
                                    "id": "691200420",
                                    "speaker": "菲林斯",
                                    "text": "没有关系，任何两个个体之间都有不同，完完全全明白另一个个体的所思所想是很困难的。"
                                },
                                {
                                    "id": "691200421",
                                    "speaker": "菲林斯",
                                    "text": "但正因为我们的思维不同，互相对话才有意义。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912005",
            "initDialog": "691200501",
            "dialogues": [
                {
                    "id": "691200501",
                    "speaker": "Player",
                    "text": "早啊，菲林斯。"
                },
                {
                    "id": "691200502",
                    "speaker": "菲林斯",
                    "text": "早安，愿你所想的成真，愿你所行的顺利。"
                }
            ]
        },
        {
            "talkId": "6912006",
            "initDialog": "691200601",
            "dialogues": [
                {
                    "id": "691200601",
                    "speaker": "Player",
                    "text": "晚安，菲林斯。"
                },
                {
                    "id": "691200602",
                    "speaker": "菲林斯",
                    "text": "晚安，去享受甜美的睡眠吧。"
                },
                {
                    "id": "691200603",
                    "speaker": "菲林斯",
                    "text": "我习惯了在午夜活动，稍后或许会趁着月光，在你的庭院里散一会儿步。"
                }
            ]
        },
        {
            "talkId": "6912010",
            "initDialog": "691201001",
            "dialogues": [
                {
                    "id": "691201001",
                    "speaker": "菲林斯",
                    "text": "噢，你不仅具备足够的洞察力，得以捕捉这座灰褐堡垒的样貌，更彰显出令人钦佩的耐心…"
                },
                {
                    "id": "691201002",
                    "speaker": "菲林斯",
                    "text": "稍等，请容我抬头。这盏街灯不会恰好坏了吧？"
                },
                {
                    "id": "691201003",
                    "speaker": "菲林斯",
                    "text": "啊，太好了。得知它明亮如初，总算让我安下心来。若是这等细节都被逐一复原，我对你的钦佩可就要到心生畏惧的程度了。"
                }
            ]
        },
        {
            "talkId": "6912011",
            "initDialog": "691201101",
            "dialogues": [
                {
                    "id": "691201101",
                    "speaker": "菲林斯",
                    "text": "或许这称得上是一种相互影响。"
                },
                {
                    "id": "691201102",
                    "speaker": "菲林斯",
                    "text": "执灯士与这些沉默的桌椅为邻，学会变得冰冷、坚固、不易摧毁…同时不可避免地被岁月留下锈蚀与凿痕。"
                },
                {
                    "id": "691201103",
                    "speaker": "菲林斯",
                    "text": "让我们以简短的静默向前人致以敬意吧。"
                }
            ]
        }
    ]
}