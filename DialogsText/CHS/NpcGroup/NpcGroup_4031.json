{
    "groupId": "4031",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "拉菲克": 4,
        "绮珊": 12
    },
    "talks": [
        {
            "talkId": "6403101",
            "initDialog": "640310101",
            "dialogues": [
                {
                    "id": "640310101",
                    "speaker": "绮珊",
                    "text": "欢迎光临，祝你有美好的一天！"
                }
            ]
        },
        {
            "talkId": "6403102",
            "initDialog": "640310201",
            "dialogues": [
                {
                    "id": "640310201",
                    "speaker": "Player",
                    "text": "你好像不是本地人？"
                },
                {
                    "id": "640310202",
                    "speaker": "绮珊",
                    "text": "客人真是好眼力，我是从璃月来的，现在正一边打工一边备考。"
                },
                {
                    "id": "640310203",
                    "speaker": "绮珊",
                    "text": "从小我就喜欢在璃月港观察进出港口的船舶，看它们如何靠岸，如何装卸货物…"
                },
                {
                    "id": "640310204",
                    "speaker": "绮珊",
                    "text": "久而久之便对各式各样的船只产生了浓厚的兴趣，希望能来教令院进修相关的技术知识。"
                },
                {
                    "id": "640310205",
                    "speaker": "绮珊",
                    "text": "打工时间以外，我也会和打工时认识的学者、学生或者船工讨论关于船舶的问题。"
                },
                {
                    "id": "640310206",
                    "speaker": "绮珊",
                    "text": "我本来还担心在他们休息的时候打扰是不是不太好，没想到教令院的学生们都还挺喜欢和我聊天的呢！"
                },
                {
                    "id": "640310207",
                    "speaker": "绮珊",
                    "text": "璃月有句古话说得好，有志者事竟成。我一定要通过教令院的会考！"
                }
            ]
        },
        {
            "talkId": "6403103",
            "initDialog": "640310301",
            "dialogues": [
                {
                    "id": "640310301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640310302",
                    "speaker": "绮珊",
                    "text": "再见啦！"
                }
            ]
        },
        {
            "talkId": "6403104",
            "initDialog": "640310401",
            "dialogues": [
                {
                    "id": "640310401",
                    "speaker": "拉菲克",
                    "text": "要是能想办法扩大船舱的容量就好了…"
                },
                {
                    "id": "640310402",
                    "speaker": "绮珊",
                    "text": "以常识来讲，那样很难不影响船体的结构吧？"
                },
                {
                    "id": "640310403",
                    "speaker": "绮珊",
                    "text": "至少，仅靠更换材料是做不到的。"
                },
                {
                    "id": "640310404",
                    "speaker": "拉菲克",
                    "text": "但是，经过我的计算，如果这边的舱室能和隔壁打通的话…"
                },
                {
                    "id": "640310405",
                    "speaker": "拉菲克",
                    "text": "不过因为是你说行不通，所以也许真的不太可能…"
                },
                {
                    "id": "640310406",
                    "speaker": "拉菲克",
                    "text": "话说绮珊，是不是璃月人都像你一样懂船啊？"
                },
                {
                    "id": "640310407",
                    "speaker": "绮珊",
                    "text": "咳咳…你这话说得就有些绝对了。"
                },
                {
                    "id": "640310408",
                    "speaker": "绮珊",
                    "text": "也不是每个璃月人都懂得船只，毕竟我们也有各行各业的人啊。"
                }
            ]
        }
    ]
}