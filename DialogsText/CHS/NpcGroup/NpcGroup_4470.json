{
    "groupId": "4470",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "欧诺莉": 13
    },
    "talks": [
        {
            "talkId": "6447001",
            "initDialog": "644700101",
            "dialogues": [
                {
                    "id": "644700101",
                    "speaker": "欧诺莉",
                    "text": "真想赌一把啊！不然，我无论如何也不会甘心的。"
                }
            ]
        },
        {
            "talkId": "6447002",
            "initDialog": "644700201",
            "dialogues": [
                {
                    "id": "644700201",
                    "speaker": "Player",
                    "text": "赌什么？"
                },
                {
                    "id": "644700202",
                    "speaker": "欧诺莉",
                    "text": "赌上我的薪水和人身安全，雇佣一个镀金旅团，让他们带着我去沙漠…但是怎么想风险都很大啊！"
                }
            ]
        },
        {
            "talkId": "6447003",
            "initDialog": "644700301",
            "dialogues": [
                {
                    "id": "644700301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644700302",
                    "speaker": "欧诺莉",
                    "text": "再见。唉，所以要不要赌一把呢…"
                }
            ]
        },
        {
            "talkId": "6447004",
            "initDialog": "644700401",
            "dialogues": [
                {
                    "id": "644700401",
                    "speaker": "Player",
                    "text": "去沙漠？"
                },
                {
                    "id": "644700402",
                    "speaker": "欧诺莉",
                    "text": "一名正经的工程师，每天却在修理小发条机关，你说这是什么道理？"
                },
                {
                    "id": "644700403",
                    "speaker": "欧诺莉",
                    "text": "想到那些宏伟的坎瑞亚遗迹机关，我的心已经飞到了沙漠深处…"
                },
                {
                    "id": "644700404",
                    "speaker": "欧诺莉",
                    "text": "自己的退步固然难受，同僚的进步更加令人揪心。与此同时沃特蒙泰涅在璃月的研究说不定正在突飞猛进。"
                },
                {
                    "id": "644700405",
                    "speaker": "欧诺莉",
                    "text": "呜呜！我一定要去沙漠。"
                }
            ]
        },
        {
            "talkId": "6447005",
            "initDialog": "644700501",
            "dialogues": [
                {
                    "id": "644700501",
                    "speaker": "Player",
                    "text": "风险很大？"
                },
                {
                    "id": "644700502",
                    "speaker": "欧诺莉",
                    "text": "对啊，那可是镀金旅团啊！作为冒险家，你应该经常遇到被镀金旅团劫持的笨蛋吧！"
                },
                {
                    "id": "644700503",
                    "speaker": "欧诺莉",
                    "text": "我想去沙漠里参观坎瑞亚遗迹机关，可我不想成为那种被人嘲笑的笨蛋啊！"
                },
                {
                    "id": "644700504",
                    "speaker": "欧诺莉",
                    "text": "万一雇到了亡命之徒，还有比成为那种笨蛋更危险的后果。"
                },
                {
                    "id": "644700505",
                    "speaker": "欧诺莉",
                    "text": "呜呜！到底要怎么去沙漠呢…"
                }
            ]
        },
        {
            "talkId": "6447006",
            "initDialog": "644700601",
            "dialogues": [
                {
                    "id": "644700601",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "644700602",
                    "speaker": "欧诺莉",
                    "text": "叫我欧诺莉吧，我只是一个倒霉的枫丹工程师，参与的水道计划因为意外停工了，我也被「搁浅」在了这里。"
                },
                {
                    "id": "644700603",
                    "speaker": "欧诺莉",
                    "text": "如果你见到了一位叫沃特蒙泰涅的工程师，记得代我向她问好。"
                }
            ]
        }
    ]
}