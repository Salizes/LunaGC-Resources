{
    "groupId": "9046",
    "total_dialogue_lines": 55,
    "speaker_counts": {
        "Player": 16,
        "胡桃": 39
    },
    "talks": [
        {
            "talkId": "6904601",
            "initDialog": "690460101",
            "dialogues": [
                {
                    "id": "690460101",
                    "speaker": "胡桃",
                    "text": "#哟！{NICKNAME}。"
                },
                {
                    "id": "690460102",
                    "speaker": "胡桃",
                    "text": "突然来找我，怎么怎么？想我了吗？"
                }
            ]
        },
        {
            "talkId": "6904602",
            "initDialog": "690460201",
            "dialogues": [
                {
                    "id": "690460201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690460202",
                    "speaker": "胡桃",
                    "text": "你这里有山有水，有吃有玩，好得很。"
                },
                {
                    "id": "690460203",
                    "speaker": "胡桃",
                    "text": "唔~再说，你对我这么好，我可喜欢这儿了。",
                    "choices": [
                        {
                            "id": "690460204",
                            "text": "和胡桃一起很开心。",
                            "response": [
                                {
                                    "id": "690460205",
                                    "speaker": "胡桃",
                                    "text": "哦？是吗？速速附耳过来，本堂主要告诉你一个秘密。"
                                },
                                {
                                    "id": "690460206",
                                    "speaker": "胡桃",
                                    "text": "其实啊，我也是这么想的呢。"
                                }
                            ]
                        },
                        {
                            "id": "690460207",
                            "text": "堂主不招待招待我吗？",
                            "response": [
                                {
                                    "id": "690460208",
                                    "speaker": "胡桃",
                                    "text": "可以啊，你不忌讳去往生堂就行。"
                                },
                                {
                                    "id": "690460209",
                                    "speaker": "胡桃",
                                    "text": "只要我不忙，随时欢迎你来哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904603",
            "initDialog": "690460301",
            "dialogues": [
                {
                    "id": "690460301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690460302",
                    "speaker": "胡桃",
                    "text": "来得正好，我刚想找人闲聊，你就出现了，该不是有什么心灵感应吧？"
                },
                {
                    "id": "690460303",
                    "speaker": "胡桃",
                    "text": "哎呀哎呀，贴心温柔，莫过于你啦！"
                },
                {
                    "id": "690460304",
                    "speaker": "胡桃",
                    "text": "#那么，{NICKNAME}，你想聊些什么？",
                    "choices": [
                        {
                            "id": "690460305",
                            "text": "想听堂主讲解玄妙之事。",
                            "response": [
                                {
                                    "id": "690460306",
                                    "speaker": "胡桃",
                                    "text": "玄妙之事怎么能用说的？天下万物，眼见为实。"
                                },
                                {
                                    "id": "690460307",
                                    "speaker": "胡桃",
                                    "text": "只要胆子大，晚上跟本堂主去山里闲逛，包你开眼。"
                                },
                                {
                                    "id": "690460308",
                                    "speaker": "胡桃",
                                    "text": "心不心动？要不要来？嘻嘻，那就说定咯。"
                                }
                            ]
                        },
                        {
                            "id": "690460309",
                            "text": "想听听你的最新作品。",
                            "response": [
                                {
                                    "id": "690460310",
                                    "speaker": "胡桃",
                                    "text": "打油诗对吧？咳咳，许久未在人前大显身手，你等，洗耳恭听！"
                                },
                                {
                                    "id": "690460311",
                                    "speaker": "胡桃",
                                    "text": "「树上两只鸟儿，鸟爪逮着鼠儿，鼠儿吃了芽儿，芽儿拖着豆儿。」"
                                },
                                {
                                    "id": "690460312",
                                    "speaker": "胡桃",
                                    "text": "如何？给点反馈吧。"
                                },
                                {
                                    "id": "690460313",
                                    "speaker": "Player",
                                    "text": "文采斐然，不愧是你。"
                                },
                                {
                                    "id": "690460314",
                                    "speaker": "胡桃",
                                    "text": "对吧？就知道你是个有眼光的人，懂得欣赏本堂主的诗歌。"
                                },
                                {
                                    "id": "690460315",
                                    "speaker": "胡桃",
                                    "text": "你啊，真是个叫人开心的好朋友！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904604",
            "initDialog": "690460401",
            "dialogues": [
                {
                    "id": "690460401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690460402",
                    "speaker": "胡桃",
                    "text": "唔？想做的事…我每天都在做自己想做的事哦。"
                },
                {
                    "id": "690460403",
                    "speaker": "胡桃",
                    "text": "所以，今天就不干那些有的没的了，让我在你家呆着吧。"
                },
                {
                    "id": "690460404",
                    "speaker": "胡桃",
                    "text": "你家有山有水，有吃有玩，还有你陪我，多好啊。"
                },
                {
                    "id": "690460405",
                    "speaker": "Player",
                    "text": "胡桃很喜欢这里啊。"
                },
                {
                    "id": "690460406",
                    "speaker": "胡桃",
                    "text": "说什么傻话…院子亭子哪里没有？喜欢的怎么会是屋子呢。"
                },
                {
                    "id": "690460407",
                    "speaker": "胡桃",
                    "text": "还能为什么呀，当然是~当然是~你猜！"
                },
                {
                    "id": "690460408",
                    "speaker": "胡桃",
                    "text": "唉，瞧你这表情…不逗你了。"
                },
                {
                    "id": "690460409",
                    "speaker": "胡桃",
                    "text": "我呀，就是喜欢跟你一起玩。你要是不陪我，就是不拿我当朋友哦。",
                    "choices": [
                        {
                            "id": "690460410",
                            "text": "我猜也是这样。",
                            "response": [
                                {
                                    "id": "690460412",
                                    "speaker": "胡桃",
                                    "text": "哼哼，反正不管你说什么，我今天就要赖在这儿，谁也别想把我拉走。"
                                },
                                {
                                    "id": "690460413",
                                    "speaker": "胡桃",
                                    "text": "我们关系这么好，你肯定不会介意的吧？"
                                }
                            ]
                        },
                        {
                            "id": "690460411",
                            "text": "胡桃醉翁之意不在酒呢。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904605",
            "initDialog": "690460501",
            "dialogues": [
                {
                    "id": "690460501",
                    "speaker": "Player",
                    "text": "早啊，胡桃。"
                },
                {
                    "id": "690460502",
                    "speaker": "胡桃",
                    "text": "早——"
                },
                {
                    "id": "690460503",
                    "speaker": "胡桃",
                    "text": "瞧你精神这么好，昨晚应该睡得不错吧。"
                }
            ]
        },
        {
            "talkId": "6904606",
            "initDialog": "690460601",
            "dialogues": [
                {
                    "id": "690460601",
                    "speaker": "Player",
                    "text": "晚安，胡桃。"
                },
                {
                    "id": "690460602",
                    "speaker": "胡桃",
                    "text": "#嘿嘿，晚安，{NICKNAME}。"
                },
                {
                    "id": "690460603",
                    "speaker": "胡桃",
                    "text": "早点休息吧，不用害怕做噩梦啊鬼压床什么的。"
                },
                {
                    "id": "690460604",
                    "speaker": "胡桃",
                    "text": "要是有那种事，本堂主动动手指就解决喽！"
                }
            ]
        },
        {
            "talkId": "6904607",
            "initDialog": "690460701",
            "dialogues": [
                {
                    "id": "690460701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904608",
            "initDialog": "690460801",
            "dialogues": [
                {
                    "id": "690460801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904609",
            "initDialog": "690460901",
            "dialogues": [
                {
                    "id": "690460901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904650",
            "initDialog": "690465001",
            "dialogues": [
                {
                    "id": "690465001",
                    "speaker": "胡桃",
                    "text": "璃月古话说，床尾不宜正对门，对门会有鬼压床。"
                },
                {
                    "id": "690465002",
                    "speaker": "胡桃",
                    "text": "不过，有我胡桃陪着你，就不必担心啦。"
                },
                {
                    "id": "690465003",
                    "speaker": "胡桃",
                    "text": "哪怕真的有两只鬼找来，也可以叫上它们玩牌戏嘛，不如…趁早在房里添置一套桌椅？"
                }
            ]
        },
        {
            "talkId": "6904651",
            "initDialog": "690465101",
            "dialogues": [
                {
                    "id": "690465101",
                    "speaker": "胡桃",
                    "text": "村里的气氛还不错，我随便转转，就有了诗兴！"
                },
                {
                    "id": "690465102",
                    "speaker": "胡桃",
                    "text": "到了夜里，会不会碰上更好玩的事呢？比如…苏醒的石雕，沉入水中的鬼火…"
                },
                {
                    "id": "690465103",
                    "speaker": "胡桃",
                    "text": "嘿嘿…你会跟我来的吧！"
                }
            ]
        }
    ]
}