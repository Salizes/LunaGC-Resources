{
    "groupId": "5317",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "格蕾丝蒂": 12
    },
    "talks": [
        {
            "talkId": "6531701",
            "initDialog": "653170101",
            "dialogues": [
                {
                    "id": "653170101",
                    "speaker": "格蕾丝蒂",
                    "text": "…欸呀，真不知道它们喜欢吃什么，这次要拿什么东西作为饲料呢？"
                },
                {
                    "id": "653170102",
                    "speaker": "格蕾丝蒂",
                    "text": "啊！有段时间不见啦，要一起喝杯茶吗？"
                }
            ]
        },
        {
            "talkId": "6531702",
            "initDialog": "653170201",
            "dialogues": [
                {
                    "id": "653170201",
                    "speaker": "Player",
                    "text": "饲料？"
                },
                {
                    "id": "653170202",
                    "speaker": "格蕾丝蒂",
                    "text": "欸，刚才的自言自语被听到了呀…"
                },
                {
                    "id": "653170203",
                    "speaker": "格蕾丝蒂",
                    "text": "其实最近我呀，一直在尝试饲养隙境原体，正打算用吃的跟它们打好关系呢。"
                }
            ]
        },
        {
            "talkId": "6531703",
            "initDialog": "653170301",
            "dialogues": [
                {
                    "id": "653170301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "653170302",
                    "speaker": "格蕾丝蒂",
                    "text": "欸呀，那就不耽搁你了，不过，等有空的时候，请一定要记得来喝杯热茶哦。"
                }
            ]
        },
        {
            "talkId": "6531704",
            "initDialog": "653170401",
            "dialogues": [
                {
                    "id": "653170401",
                    "speaker": "Player",
                    "text": "隙境原体也是可以养的吗…"
                },
                {
                    "id": "653170402",
                    "speaker": "格蕾丝蒂",
                    "text": "毕竟它们是温顺可爱的小动物嘛，饲养隙境原体，就像是人类养宠物一样嘛。"
                },
                {
                    "id": "653170403",
                    "speaker": "格蕾丝蒂",
                    "text": "有的时候只是看它们走来走去，哎呀，心情就会稍微变得好一点呢。"
                }
            ]
        },
        {
            "talkId": "6531705",
            "initDialog": "653170501",
            "dialogues": [
                {
                    "id": "653170501",
                    "speaker": "Player",
                    "text": "需要帮忙准备饲料吗？"
                },
                {
                    "id": "653170502",
                    "speaker": "格蕾丝蒂",
                    "text": "谢谢你的好意，但是现在饲料还没用完，只是在想下次要用什么样的饲料好。"
                },
                {
                    "id": "653170503",
                    "speaker": "格蕾丝蒂",
                    "text": "长期只吃一种食物的话，很容易营养不均衡，所以得经常更换食谱才行呢…"
                },
                {
                    "id": "653170504",
                    "speaker": "格蕾丝蒂",
                    "text": "对了，汐藻的缘膜，苍晶螺的脏器，风干的幽光星星表皮，你觉得哪个作为饲料比较合适呢？"
                }
            ]
        },
        {
            "talkId": "6531706",
            "initDialog": "653170601",
            "dialogues": [
                {
                    "id": "653170601",
                    "speaker": "Player",
                    "text": "那些东西有营养吗…"
                },
                {
                    "id": "653170602",
                    "speaker": "格蕾丝蒂",
                    "text": "嗯…不太清楚呢，对它们来说是有营养的吧，毕竟那些孩子之前吃得倒是很开心。"
                },
                {
                    "id": "653170603",
                    "speaker": "格蕾丝蒂",
                    "text": "难道都不合适吗，那看来得找点其他的东西试试看了呢…"
                }
            ]
        }
    ]
}