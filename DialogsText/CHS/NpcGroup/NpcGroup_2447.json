{
    "groupId": "2447",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "翠儿": 7
    },
    "talks": [
        {
            "talkId": "6244701",
            "initDialog": "624470101",
            "dialogues": [
                {
                    "id": "624470101",
                    "speaker": "翠儿",
                    "text": "客官您好，恕我暂时不能接待…我在等人。"
                }
            ]
        },
        {
            "talkId": "6244702",
            "initDialog": "624470201",
            "dialogues": [
                {
                    "id": "624470201",
                    "speaker": "Player",
                    "text": "等人？"
                },
                {
                    "id": "624470202",
                    "speaker": "翠儿",
                    "text": "我在等我的恋人，他的名字叫做潮汐，是一位很厉害的水手。"
                },
                {
                    "id": "624470203",
                    "speaker": "翠儿",
                    "text": "潮先生每次来都会讲一些他的冒险故事，上次是他与冥海巨兽搏斗，上上次是单枪匹马剿灭海盗团…"
                },
                {
                    "id": "624470204",
                    "speaker": "翠儿",
                    "text": "他的故事真是太让人着迷了，真想和他一起经历这些波澜壮阔的事情啊…"
                },
                {
                    "id": "624470205",
                    "speaker": "翠儿",
                    "text": "总之我们已经约定好了，下次见面他就会接我离开这里…"
                },
                {
                    "id": "624470206",
                    "speaker": "翠儿",
                    "text": "尽管等待的这段时间很是煎熬，但我的心已经是他的了，所以我会始终如一地等他…"
                }
            ]
        },
        {
            "talkId": "6244703",
            "initDialog": "624470301",
            "dialogues": [
                {
                    "id": "624470301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624470302",
                    "speaker": "翠儿",
                    "text": "客官慢走，祝您玩得开心。"
                }
            ]
        }
    ]
}