    "talks": [
        {
            "talkId": "6950601",
            "initDialog": "695060101",
            "dialogues": [
                {
                    "id": "695060101",
                    "speaker": "安柏",
                    "text": "呜…我可不擅长这种复杂的游戏呀，刚才和人玩了几局，脑袋都有点晕晕的了…"
                }
            ]
        },
        {
            "talkId": "6950602",
            "initDialog": "695060201",
            "dialogues": [
                {
                    "id": "695060201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6950603",
            "initDialog": "695060301",
            "dialogues": [
                {
                    "id": "695060301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695060302",
                    "speaker": "安柏",
                    "text": "嗯！我等下也要去巡逻了，可不能耽误了正事。"
                }
            ]
        },
        {
            "talkId": "6950604",
            "initDialog": "695060401",
            "dialogues": [
                {
                    "id": "695060401",
                    "speaker": "安柏",
                    "text": "是我赢啦！哎，别灰心呀，我…我请你吃好吃的，蜜酱胡萝卜煎肉怎么样？"
                }
            ]
        },
        {
            "talkId": "6950605",
            "initDialog": "695060501",
            "dialogues": [
                {
                    "id": "695060501",
                    "speaker": "安柏",
                    "text": "唉，输掉了…凯亚说想要玩好七圣召唤，首先要把所有卡牌的效果都记住，这也太难了吧…"
                }
            ]
        },
        {
            "talkId": "6950606",
            "initDialog": "695060601",
            "dialogues": [
                {
                    "id": "695060601",
                    "speaker": "安柏",
                    "text": "好嘞！来分个胜负吧！"
                }
            ]
        },
        {
            "talkId": "6950608",
            "initDialog": "695060801",
            "dialogues": [
                {
                    "id": "695060801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6950609",
            "initDialog": "695060901",
            "dialogues": [
                {
                    "id": "695060901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6950610",
            "initDialog": "695061001",
            "dialogues": [
                {
                    "id": "695061001",
                    "speaker": "安柏",
                    "text": "胜负已分，是我赢啦！嘿嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6950611",
            "initDialog": "695061101",
            "dialogues": [
                {
                    "id": "695061101",
                    "speaker": "安柏",
                    "text": "你果然很厉害啊…下次教我几招吧？怎么样？"
                }
            ]
        },
        {
            "talkId": "6950612",
            "initDialog": "695061201",
            "dialogues": [
                {
                    "id": "695061201",
                    "speaker": "安柏",
                    "text": "没问题，我可不会放水。"
                }
            ]
        },
        {
            "talkId": "6950614",
            "initDialog": "695061401",
            "dialogues": [
                {
                    "id": "695061401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6950615",
            "initDialog": "695061501",
            "dialogues": [
                {
                    "id": "695061501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6950616",
            "initDialog": "695061601",
            "dialogues": [
                {
                    "id": "695061601",
                    "speaker": "安柏",
                    "text": "怎么样，我进步很大吧？那几招我可是专门研究过的。"
                }
            ]
        },
        {
            "talkId": "6950617",
            "initDialog": "695061701",
            "dialogues": [
                {
                    "id": "695061701",
                    "speaker": "安柏",
                    "text": "输了就是输了，我已经用尽全力啦，还是你比较厉害。"
                }
            ]
        },
        {
            "talkId": "6950618",
            "initDialog": "695061801",
            "dialogues": [
                {
                    "id": "695061801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}