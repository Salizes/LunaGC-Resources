{
    "groupId": "7509",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "萝茜金娜": 10
    },
    "talks": [
        {
            "talkId": "6750901",
            "initDialog": "675090101",
            "dialogues": [
                {
                    "id": "675090101",
                    "speaker": "萝茜金娜",
                    "text": "都到这个时间了，他怎么还不出现…"
                }
            ]
        },
        {
            "talkId": "6750902",
            "initDialog": "675090201",
            "dialogues": [
                {
                    "id": "675090201",
                    "speaker": "Player",
                    "text": "你在等谁？"
                },
                {
                    "id": "675090202",
                    "speaker": "萝茜金娜",
                    "text": "我的王子，我的命运，我的唯一，那个总是过于严肃过于认真的人…"
                },
                {
                    "id": "675090203",
                    "speaker": "萝茜金娜",
                    "text": "那个用工作太忙来考验我真心的…让我日夜思念、魂牵梦绕的不知名的爱侣…"
                },
                {
                    "id": "675090204",
                    "speaker": "萝茜金娜",
                    "text": "他每天下班，一定会走过这座桥。只要我每天买好票站在这里，总有一天，他会走向我的…"
                },
                {
                    "id": "675090205",
                    "speaker": "萝茜金娜",
                    "text": "就像过去那十七次一样，他总是低着头从我身边走过，假装没看见我…他真可爱。"
                }
            ]
        },
        {
            "talkId": "6750903",
            "initDialog": "675090301",
            "dialogues": [
                {
                    "id": "675090301",
                    "speaker": "Player",
                    "text": "打扰了…"
                },
                {
                    "id": "675090302",
                    "speaker": "萝茜金娜",
                    "text": "他会来的，他一定会来的，一定会的…"
                }
            ]
        },
        {
            "talkId": "6750904",
            "initDialog": "675090401",
            "dialogues": [
                {
                    "id": "675090401",
                    "speaker": "Player",
                    "text": "有没有可能他不在这里上班了？"
                },
                {
                    "id": "675090402",
                    "speaker": "萝茜金娜",
                    "text": "不在了？不，不会的。他怎么会躲着我呢？明明我是这么爱他…"
                },
                {
                    "id": "675090403",
                    "speaker": "萝茜金娜",
                    "text": "他亲口对我说过「改天再说」的！他答应过我的！这里是我们初次邂逅的地方，他绝不会骗我…"
                },
                {
                    "id": "675090404",
                    "speaker": "萝茜金娜",
                    "text": "…对，他只是在加班，他马上就会来的…"
                }
            ]
        },
        {
            "talkId": "6750905",
            "initDialog": "675090501",
            "dialogues": [
                {
                    "id": "675090501",
                    "speaker": "Player",
                    "text": "呃，祝你能早日见到他…"
                },
                {
                    "id": "675090502",
                    "speaker": "萝茜金娜",
                    "text": "呵呵，会的，我一定会再见到他的…就算等到剧院关门，就算等到明天、后天…就算要一直等下去…"
                }
            ]
        }
    ]
}