{
    "groupId": "7455",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "格雷戈里": 8
    },
    "talks": [
        {
            "talkId": "6745501",
            "initDialog": "674550101",
            "dialogues": [
                {
                    "id": "674550101",
                    "speaker": "格雷戈里",
                    "text": "来份报纸吗？至冬公民都关心的新闻，您想必不会愿意错过吧？"
                }
            ]
        },
        {
            "talkId": "6745502",
            "initDialog": "674550201",
            "dialogues": [
                {
                    "id": "674550201",
                    "speaker": "Player",
                    "text": "都有些什么样的新闻？"
                },
                {
                    "id": "674550202",
                    "speaker": "格雷戈里",
                    "text": "外交、财政、战争、大人物，还有评议会激烈争吵三小时，最终决定下周继续争吵。"
                },
                {
                    "id": "674550203",
                    "speaker": "格雷戈里",
                    "text": "——诸如此类，只需要一点摩拉，就能获悉至冬命运的动向。"
                },
                {
                    "id": "674550204",
                    "speaker": "格雷戈里",
                    "text": "来一份吧，我能看出您对时局有着最基本的关切。"
                }
            ]
        },
        {
            "talkId": "6745503",
            "initDialog": "674550301",
            "dialogues": [
                {
                    "id": "674550301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674550302",
                    "speaker": "格雷戈里",
                    "text": "再会。"
                }
            ]
        },
        {
            "talkId": "6745504",
            "initDialog": "674550401",
            "dialogues": [
                {
                    "id": "674550401",
                    "speaker": "Player",
                    "text": "我可能没有。"
                },
                {
                    "id": "674550402",
                    "speaker": "格雷戈里",
                    "text": "…您、您真谦逊。"
                },
                {
                    "id": "674550403",
                    "speaker": "格雷戈里",
                    "text": "好吧，如果您想知道谁在决定我们的命运，以及明天大家是否要挨饿，我都在这个位置等您。"
                }
            ]
        },
        {
            "talkId": "6745505",
            "initDialog": "674550501",
            "dialogues": [
                {
                    "id": "674550501",
                    "speaker": "Player",
                    "text": "先不用了。"
                },
                {
                    "id": "674550502",
                    "speaker": "格雷戈里",
                    "text": "真可惜，再会。"
                }
            ]
        }
    ]
}