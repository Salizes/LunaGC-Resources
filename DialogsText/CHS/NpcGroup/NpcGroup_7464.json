{
    "groupId": "7464",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "特罗菲莫娃": 13
    },
    "talks": [
        {
            "talkId": "6746401",
            "initDialog": "674640101",
            "dialogues": [
                {
                    "id": "674640101",
                    "speaker": "特罗菲莫娃",
                    "text": "进入军械宫前，请先出示证件…"
                }
            ]
        },
        {
            "talkId": "6746402",
            "initDialog": "674640201",
            "dialogues": [
                {
                    "id": "674640201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "674640202",
                    "speaker": "特罗菲莫娃",
                    "text": "是至冬最大最厉害的生产设计机构，也是我家…"
                },
                {
                    "id": "674640203",
                    "speaker": "特罗菲莫娃",
                    "text": "咳…我工作的地方。"
                },
                {
                    "id": "674640204",
                    "speaker": "特罗菲莫娃",
                    "text": "如果你有机会来这里工作的话，一定要时时刻刻挺起胸膛。"
                },
                {
                    "id": "674640205",
                    "speaker": "特罗菲莫娃",
                    "text": "因为，成为军械宫的一员，将是你这一辈子最值得骄傲的事之一，明白吗！"
                }
            ]
        },
        {
            "talkId": "6746403",
            "initDialog": "674640301",
            "dialogues": [
                {
                    "id": "674640301",
                    "speaker": "Player",
                    "text": "作为门卫，你没什么威慑力。"
                },
                {
                    "id": "674640302",
                    "speaker": "特罗菲莫娃",
                    "text": "说得好，我确实拦不住你，也不想当门卫。"
                },
                {
                    "id": "674640303",
                    "speaker": "特罗菲莫娃",
                    "text": "所以你把我打晕好了，这样我的长官就不会让我再干这种没意义的事。"
                },
                {
                    "id": "674640304",
                    "speaker": "特罗菲莫娃",
                    "text": "说到底，我只是每天干了十四个小时而已，就把我换过来站岗，说什么「调节状态，有助健康」…"
                },
                {
                    "id": "674640305",
                    "speaker": "特罗菲莫娃",
                    "text": "不觉得很无理吗？"
                },
                {
                    "id": "674640306",
                    "speaker": "特罗菲莫娃",
                    "text": "我只要陪着我心爱的巡陆艇们就足够了。"
                },
                {
                    "id": "674640307",
                    "speaker": "特罗菲莫娃",
                    "text": "只要修过的巡陆艇足够多，读过的手册和教材足够详细，工程的技术造诣就能不断进步。"
                },
                {
                    "id": "674640308",
                    "speaker": "特罗菲莫娃",
                    "text": "总有一天能追上卡尔采夫哥哥…"
                }
            ]
        },
        {
            "talkId": "6746404",
            "initDialog": "674640401",
            "dialogues": [
                {
                    "id": "674640401",
                    "speaker": "Player",
                    "text": "那我告辞了。"
                },
                {
                    "id": "674640402",
                    "speaker": "特罗菲莫娃",
                    "text": "慢走。"
                }
            ]
        }
    ]
}