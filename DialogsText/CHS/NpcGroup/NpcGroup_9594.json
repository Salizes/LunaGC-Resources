{
    "groupId": "9594",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "瓦雷莎": 10
    },
    "talks": [
        {
            "talkId": "6959401",
            "initDialog": "695940101",
            "dialogues": [
                {
                    "id": "695940101",
                    "speaker": "瓦雷莎",
                    "text": "好多人啊，他们都是来玩牌的么？嘿嘿，气氛这么热烈，弄得我也想玩几盘了。"
                }
            ]
        },
        {
            "talkId": "6959402",
            "initDialog": "695940201",
            "dialogues": [
                {
                    "id": "695940201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959403",
            "initDialog": "695940301",
            "dialogues": [
                {
                    "id": "695940301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695940302",
                    "speaker": "瓦雷莎",
                    "text": "啊！糟糕糟糕，我要回去继续训练了，过几天我还要参加健体比赛呢！"
                }
            ]
        },
        {
            "talkId": "6959404",
            "initDialog": "695940401",
            "dialogues": [
                {
                    "id": "695940401",
                    "speaker": "瓦雷莎",
                    "text": "赢啦！好，为了庆祝胜利，我们一起来吃几块小蛋糕吧，我偷偷买的…哎，你可别告诉伊安珊老师呀。"
                }
            ]
        },
        {
            "talkId": "6959405",
            "initDialog": "695940501",
            "dialogues": [
                {
                    "id": "695940501",
                    "speaker": "瓦雷莎",
                    "text": "唔…脑子晕晕的，难道是之前的热身动作做过量了？不对，我是按照伊安珊老师制订的运动量来的呀…"
                }
            ]
        },
        {
            "talkId": "6959406",
            "initDialog": "695940601",
            "dialogues": [
                {
                    "id": "695940601",
                    "speaker": "瓦雷莎",
                    "text": "打牌？好呀，虽然我平时都在锻炼，不怎么玩牌…但无论如何，我会努力的！"
                }
            ]
        },
        {
            "talkId": "6959408",
            "initDialog": "695940801",
            "dialogues": [
                {
                    "id": "695940801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959409",
            "initDialog": "695940901",
            "dialogues": [
                {
                    "id": "695940901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959410",
            "initDialog": "695941001",
            "dialogues": [
                {
                    "id": "695941001",
                    "speaker": "瓦雷莎",
                    "text": "赢啦赢啦，嘿嘿，刚才脑子动太多，肚子都饿了…一起去吃点东西吧。"
                }
            ]
        },
        {
            "talkId": "6959411",
            "initDialog": "695941101",
            "dialogues": [
                {
                    "id": "695941101",
                    "speaker": "瓦雷莎",
                    "text": "输掉了…唉，难道是刚才没有吃饱？我应该再多吃几份肉排的…"
                }
            ]
        },
        {
            "talkId": "6959412",
            "initDialog": "695941201",
            "dialogues": [
                {
                    "id": "695941201",
                    "speaker": "瓦雷莎",
                    "text": "伊安珊老师说，运动过后脑筋会转得更快！稍等一下喔，我先做几个俯卧撑…"
                }
            ]
        },
        {
            "talkId": "6959414",
            "initDialog": "695941401",
            "dialogues": [
                {
                    "id": "695941401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959415",
            "initDialog": "695941501",
            "dialogues": [
                {
                    "id": "695941501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959416",
            "initDialog": "695941601",
            "dialogues": [
                {
                    "id": "695941601",
                    "speaker": "瓦雷莎",
                    "text": "呼啊…赢得好惊险，还好我脑筋转得很快，肯定是刚才的俯卧撑起作用了！"
                }
            ]
        },
        {
            "talkId": "6959417",
            "initDialog": "695941701",
            "dialogues": [
                {
                    "id": "695941701",
                    "speaker": "瓦雷莎",
                    "text": "一个不留神就输掉了…再来一把怎么样，我不会再输给同一种战术第二次了。"
                }
            ]
        },
        {
            "talkId": "6959418",
            "initDialog": "695941801",
            "dialogues": [
                {
                    "id": "695941801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}