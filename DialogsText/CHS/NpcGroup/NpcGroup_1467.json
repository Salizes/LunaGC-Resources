{
    "groupId": "1467",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 7,
        "巴顿": 29
    },
    "talks": [
        {
            "talkId": "6146705",
            "initDialog": "614670501",
            "dialogues": [
                {
                    "id": "614670501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6146706",
            "initDialog": "614670601",
            "dialogues": [
                {
                    "id": "614670601",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6146707",
            "initDialog": "614670701",
            "dialogues": [
                {
                    "id": "614670701",
                    "speaker": "巴顿",
                    "text": "这，这个失误！怎么会？！可恶…"
                }
            ]
        },
        {
            "talkId": "6146708",
            "initDialog": "614670801",
            "dialogues": [
                {
                    "id": "614670801",
                    "speaker": "巴顿",
                    "text": "赢了！这次我可没有失误！"
                }
            ]
        },
        {
            "talkId": "6146709",
            "initDialog": "614670901",
            "dialogues": [
                {
                    "id": "614670901",
                    "speaker": "巴顿",
                    "text": "不可能啊！这和我想的不一样！"
                }
            ]
        },
        {
            "talkId": "6146710",
            "initDialog": "614671001",
            "dialogues": [
                {
                    "id": "614671001",
                    "speaker": "巴顿",
                    "text": "哈哈！拿下喽！"
                }
            ]
        },
        {
            "talkId": "7090501",
            "initDialog": "709050101",
            "dialogues": [
                {
                    "id": "709050101",
                    "speaker": "Player",
                    "text": "最近有什么优惠吗？"
                },
                {
                    "id": "709050102",
                    "speaker": "巴顿",
                    "text": "我们现在在为每位顾客提供免费的野菇鸡肉串，这可是上好的下酒菜啊！"
                },
                {
                    "id": "709050103",
                    "speaker": "巴顿",
                    "text": "来，您拿好，进来坐坐吧，保证您不会后悔的！"
                }
            ]
        },
        {
            "talkId": "6146701",
            "initDialog": "4015146701",
            "dialogues": [
                {
                    "id": "4015146701",
                    "speaker": "巴顿",
                    "text": "不进来坐坐吗？「天使的馈赠」酒馆优惠酬宾哦！"
                }
            ]
        },
        {
            "talkId": "6146702",
            "initDialog": "4015146702",
            "dialogues": [
                {
                    "id": "4015146702",
                    "speaker": "Player",
                    "text": "关于「天使的馈赠」。"
                },
                {
                    "id": "4015146706",
                    "speaker": "巴顿",
                    "text": "我记得是很早很早的时候…差不多晨曦酒庄刚刚建立的时候，酒庄老板投资开的。"
                },
                {
                    "id": "4015146707",
                    "speaker": "巴顿",
                    "text": "现在「天使的馈赠」也依然在酒庄这一代的老板迪卢克老爷手上，并且生意越做越好…"
                },
                {
                    "id": "4015146708",
                    "speaker": "巴顿",
                    "text": "说是蒙德第一应该当之无愧吧？"
                },
                {
                    "id": "4015146709",
                    "speaker": "巴顿",
                    "text": "心情好的时候迪卢克老爷也会自己来做当班酒保，给老伙计查尔斯放个假。"
                },
                {
                    "id": "4015146710",
                    "speaker": "巴顿",
                    "text": "你要是碰巧遇见他当班，可千万要客气点儿！毕竟他可是蒙德最有钱的大老板了…",
                    "choices": [
                        {
                            "id": "4015146703",
                            "text": "关于蒙德的酒业。",
                            "response": [
                                {
                                    "id": "4015146711",
                                    "speaker": "巴顿",
                                    "text": "蒙德的气候、水源和作物，对酿酒来说都是完美的条件…不得不说这就是风神的恩赐！"
                                },
                                {
                                    "id": "4015146712",
                                    "speaker": "巴顿",
                                    "text": "像什么苹果酒、樱桃酒，口味都非常不错，对了，尤其是蒲公英酒，那简直是人间美味！"
                                },
                                {
                                    "id": "4015146713",
                                    "speaker": "巴顿",
                                    "text": "通过出口到璃月的商会，蒙德的酒会销往整个大陆。"
                                },
                                {
                                    "id": "4015146714",
                                    "speaker": "巴顿",
                                    "text": "不论在哪儿都能卖个好价钱，甚至有「瓶装摩拉」的说法。"
                                },
                                {
                                    "id": "4015146715",
                                    "speaker": "巴顿",
                                    "text": "所以「晨曦酒庄」的老板才那么有钱吧…"
                                }
                            ]
                        },
                        {
                            "id": "4015146704",
                            "text": "关于你自己。",
                            "response": [
                                {
                                    "id": "4015146716",
                                    "speaker": "巴顿",
                                    "text": "给你一个忠告…这店里再不起眼的酒瓶也不要随便乱动…"
                                },
                                {
                                    "id": "4015146717",
                                    "speaker": "巴顿",
                                    "text": "我打碎的那一瓶碰巧是前老板珍藏的特酿葡萄酒…看见北面那座别墅了吗？"
                                },
                                {
                                    "id": "4015146718",
                                    "speaker": "巴顿",
                                    "text": "…我的意思是那瓶酒和那座别墅的价值差不多。"
                                },
                                {
                                    "id": "4015146719",
                                    "speaker": "巴顿",
                                    "text": "按这么算的话，我的打工赎身生涯差不多还剩下48年吧…当然，是不吃不喝不睡的前提下…"
                                },
                                {
                                    "id": "4015146720",
                                    "speaker": "巴顿",
                                    "text": "这么一看好像也不是彻底没有希望呢…"
                                },
                                {
                                    "id": "4015146721",
                                    "speaker": "巴顿",
                                    "text": "好了，先不和你聊了，我要向着自由努力工作了，哈哈哈哈…咳咳…呜…呜呜…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6146703",
            "initDialog": "4015146705",
            "dialogues": [
                {
                    "id": "4015146705",
                    "speaker": "巴顿",
                    "text": "不用了，谢谢。"
                },
                {
                    "id": "4015146722",
                    "speaker": "巴顿",
                    "text": "这就走了吗？要品尝蒙德的佳酿，可没有比这儿更好的去处了呀。"
                }
            ]
        },
        {
            "talkId": "6146704",
            "initDialog": "614670401",
            "dialogues": [
                {
                    "id": "614670401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614670402",
                    "speaker": "巴顿",
                    "text": "唉，老实说我真的被吓到了，也不知道风魔龙什么时候会再次来袭…可即便这种情况，我还是得站在这里宣传。"
                },
                {
                    "id": "614670403",
                    "speaker": "巴顿",
                    "text": "没办法，谁叫我欠迪卢克老爷钱呢，还得不吃不喝不睡地再工作48年呢，要是休息的话，工作时间就要延长了…"
                },
                {
                    "id": "614670404",
                    "speaker": "巴顿",
                    "text": "…也不知道迪卢克老爷能不能看在龙灾的份上，把我的债务给免了呢？"
                },
                {
                    "id": "614670405",
                    "speaker": "巴顿",
                    "text": "大概不行吧，哈哈哈…呜呜…"
                }
            ]
        }
    ]
}