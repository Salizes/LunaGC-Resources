{
    "groupId": "30083",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "咲耶": 12
    },
    "talks": [
        {
            "talkId": "7265802",
            "initDialog": "726580201",
            "dialogues": [
                {
                    "id": "726580201",
                    "speaker": "咲耶",
                    "text": "你好！想要试试亲手种一盆花吗？"
                }
            ]
        },
        {
            "talkId": "7265803",
            "initDialog": "726580301",
            "dialogues": [
                {
                    "id": "726580301",
                    "speaker": "Player",
                    "text": "关于花卉的事…"
                },
                {
                    "id": "726580302",
                    "speaker": "咲耶",
                    "text": "你是想要体验一下种花和插花的乐趣吗？没问题。"
                }
            ]
        },
        {
            "talkId": "7265804",
            "initDialog": "726580401",
            "dialogues": [
                {
                    "id": "726580401",
                    "speaker": "Player",
                    "text": "关于花卉的事…"
                },
                {
                    "id": "726580402",
                    "speaker": "咲耶",
                    "text": "你应该已经拿到种子了，先去种花吧。万事都要一步一步来，可不能心急啊。"
                }
            ]
        },
        {
            "talkId": "7265805",
            "initDialog": "726580501",
            "dialogues": [
                {
                    "id": "726580501",
                    "speaker": "Player",
                    "text": "关于花卉的事…"
                },
                {
                    "id": "726580502",
                    "speaker": "咲耶",
                    "text": "抱歉啊，这次的「梦里生花」已经结束了，我也得回去花田那边打理生意了。"
                },
                {
                    "id": "726580503",
                    "speaker": "咲耶",
                    "text": "下次我来城里办这种活动的时候，你再来细致地体验一下吧。"
                }
            ]
        },
        {
            "talkId": "7265806",
            "initDialog": "726580601",
            "dialogues": [
                {
                    "id": "726580601",
                    "speaker": "Player",
                    "text": "关于插花…"
                },
                {
                    "id": "726580602",
                    "speaker": "咲耶",
                    "text": "「插花」在稻妻可是一项很重要的事情喔。"
                },
                {
                    "id": "726580603",
                    "speaker": "咲耶",
                    "text": "虽然简单来说，「插花」就是将花卉和其他植物仔细裁剪处理后，以一个合适的方式摆放起来…"
                },
                {
                    "id": "726580604",
                    "speaker": "咲耶",
                    "text": "但在具体制作上…裁剪花卉和植物时，需要细细地把握植物的状态，细心地为植物修剪掉不体面的地方…"
                },
                {
                    "id": "726580605",
                    "speaker": "咲耶",
                    "text": "摆放时，又要根据具体的场景氛围来调整摆放的方式。有时候，甚至要细致到每一支花卉向外延伸的角度…"
                },
                {
                    "id": "726580606",
                    "speaker": "咲耶",
                    "text": "这些细节，每个都需要细心考究，实在是…繁琐到了极点。"
                },
                {
                    "id": "726580607",
                    "speaker": "咲耶",
                    "text": "就算是对我这个喜爱插花的人来说，这项工作也够让我疲惫的了…"
                }
            ]
        },
        {
            "talkId": "7265807",
            "initDialog": "726580701",
            "dialogues": [
                {
                    "id": "726580701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "726580702",
                    "speaker": "咲耶",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
}