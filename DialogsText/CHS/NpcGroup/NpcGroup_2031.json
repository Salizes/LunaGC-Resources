{
    "groupId": "2031",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 3,
        "小蒙": 9,
        "璐璐": 6,
        "阿飞": 6
    },
    "talks": [
        {
            "talkId": "6203102",
            "initDialog": "620310201",
            "dialogues": [
                {
                    "id": "620310201",
                    "speaker": "小蒙",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你好。"
                }
            ]
        },
        {
            "talkId": "6203103",
            "initDialog": "620310301",
            "dialogues": [
                {
                    "id": "620310301",
                    "speaker": "Player",
                    "text": "你在这做什么？"
                },
                {
                    "id": "620310302",
                    "speaker": "小蒙",
                    "text": "我正在这里读书呢。纪芳姐姐向我推荐了几本游记。"
                },
                {
                    "id": "620310303",
                    "speaker": "小蒙",
                    "text": "可惜…我看书的速度太慢了，到现在都没看多少。"
                }
            ]
        },
        {
            "talkId": "6203104",
            "initDialog": "620310401",
            "dialogues": [
                {
                    "id": "620310401",
                    "speaker": "Player",
                    "text": "不去和璐璐她们玩吗？"
                },
                {
                    "id": "620310402",
                    "speaker": "小蒙",
                    "text": "嗯…最近可能没什么时间了，我还要帮爸爸处理很多事。"
                },
                {
                    "id": "620310403",
                    "speaker": "小蒙",
                    "text": "但是在出发之前，我一定会和她们告别的。"
                }
            ]
        },
        {
            "talkId": "6203105",
            "initDialog": "620310501",
            "dialogues": [
                {
                    "id": "620310501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620310502",
                    "speaker": "小蒙",
                    "text": "#嗯，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}再见。"
                }
            ]
        },
        {
            "talkId": "6203101",
            "initDialog": "620740101",
            "dialogues": [
                {
                    "id": "620740101",
                    "speaker": "璐璐",
                    "text": "万里波涛号，扬帆起航！"
                },
                {
                    "id": "620740102",
                    "speaker": "小蒙",
                    "text": "风浪好大哇！我的货物和金子都要翻进海里啦！服务生，服务生！"
                },
                {
                    "id": "620740103",
                    "speaker": "璐璐",
                    "text": "服务生，服务生！快去帮忙，不然…不然我…就把你踢进海里去！"
                },
                {
                    "id": "620740104",
                    "speaker": "阿飞",
                    "text": "…"
                },
                {
                    "id": "620740105",
                    "speaker": "璐璐",
                    "text": "服务生，服务生！"
                },
                {
                    "id": "620740106",
                    "speaker": "阿飞",
                    "text": "…我不想玩了，每次都是我扮服务生…"
                },
                {
                    "id": "620740107",
                    "speaker": "璐璐",
                    "text": "那你要扮什么？"
                },
                {
                    "id": "620740108",
                    "speaker": "阿飞",
                    "text": "…我要扮北斗大人…"
                },
                {
                    "id": "620740109",
                    "speaker": "阿飞",
                    "text": "帅气的北斗大人每次都是璐璐扮，我也想扮一次！"
                },
                {
                    "id": "620740110",
                    "speaker": "璐璐",
                    "text": "那是因为我是女孩子，而且年纪最大！"
                },
                {
                    "id": "620740111",
                    "speaker": "阿飞",
                    "text": "我…我个子最高！而且不管男孩子女孩子…盖上一只眼不都一样！"
                },
                {
                    "id": "620740112",
                    "speaker": "小蒙",
                    "text": "哪里能一样啦，你都没有那个…气质！"
                },
                {
                    "id": "620740113",
                    "speaker": "阿飞",
                    "text": "呜呜…"
                },
                {
                    "id": "620740114",
                    "speaker": "小蒙",
                    "text": "哇，阿飞又哭鼻子了…"
                },
                {
                    "id": "620740115",
                    "speaker": "璐璐",
                    "text": "好啦好啦…就让你扮一次吧？"
                }
            ]
        }
    ]
}