{
    "groupId": "9602",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "米卡": 10
    },
    "talks": [
        {
            "talkId": "6960201",
            "initDialog": "696020101",
            "dialogues": [
                {
                    "id": "696020101",
                    "speaker": "米卡",
                    "text": "先通过侦察手段探清敌人的虚实，然后再进行针对性的打击…嗯，或许游击小队的战法也可以用在「七圣召唤」里…"
                }
            ]
        },
        {
            "talkId": "6960202",
            "initDialog": "696020201",
            "dialogues": [
                {
                    "id": "696020201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960203",
            "initDialog": "696020301",
            "dialogues": [
                {
                    "id": "696020301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696020302",
                    "speaker": "米卡",
                    "text": "前辈，你要走了吗？我过一会也要离开了，等一下要去骑士团看看，还有没有要送出去的信…"
                }
            ]
        },
        {
            "talkId": "6960204",
            "initDialog": "696020401",
            "dialogues": [
                {
                    "id": "696020401",
                    "speaker": "米卡",
                    "text": "太好了，看起来练习没有白费。这样的话，跟陌生人打交道的手段就又多了一种…"
                }
            ]
        },
        {
            "talkId": "6960205",
            "initDialog": "696020501",
            "dialogues": [
                {
                    "id": "696020501",
                    "speaker": "米卡",
                    "text": "输掉了…看起来我还是练习不足…荣誉骑士前辈，能请你教我一些「七圣召唤」的窍门吗？"
                }
            ]
        },
        {
            "talkId": "6960206",
            "initDialog": "696020601",
            "dialogues": [
                {
                    "id": "696020601",
                    "speaker": "米卡",
                    "text": "欸？荣誉骑士前辈想玩牌吗？我玩得不是很好，不过，我保证我会尽全力的！"
                }
            ]
        },
        {
            "talkId": "6960208",
            "initDialog": "696020801",
            "dialogues": [
                {
                    "id": "696020801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960209",
            "initDialog": "696020901",
            "dialogues": [
                {
                    "id": "696020901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960210",
            "initDialog": "696021001",
            "dialogues": [
                {
                    "id": "696021001",
                    "speaker": "米卡",
                    "text": "赢、赢了？呼——谢谢你的指导，荣誉骑士前辈！"
                }
            ]
        },
        {
            "talkId": "6960211",
            "initDialog": "696021101",
            "dialogues": [
                {
                    "id": "696021101",
                    "speaker": "米卡",
                    "text": "我输了。不愧是荣誉骑士前辈，果然很强…"
                }
            ]
        },
        {
            "talkId": "6960212",
            "initDialog": "696021201",
            "dialogues": [
                {
                    "id": "696021201",
                    "speaker": "米卡",
                    "text": "好的，荣誉骑士前辈，我最近好好练习过了，保证很有进步！"
                }
            ]
        },
        {
            "talkId": "6960214",
            "initDialog": "696021401",
            "dialogues": [
                {
                    "id": "696021401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960215",
            "initDialog": "696021501",
            "dialogues": [
                {
                    "id": "696021501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960216",
            "initDialog": "696021601",
            "dialogues": [
                {
                    "id": "696021601",
                    "speaker": "米卡",
                    "text": "赢了，嘿嘿好开心。那个，我们能再来一局吗？"
                }
            ]
        },
        {
            "talkId": "6960217",
            "initDialog": "696021701",
            "dialogues": [
                {
                    "id": "696021701",
                    "speaker": "米卡",
                    "text": "竟然还有这种思路吗？好厉害！看来我要学的东西还有好多…"
                }
            ]
        },
        {
            "talkId": "6960218",
            "initDialog": "696021801",
            "dialogues": [
                {
                    "id": "696021801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}