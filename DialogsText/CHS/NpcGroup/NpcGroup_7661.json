{
    "groupId": "7661",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "叶洛亚": 3,
        "弗莱库": 10
    },
    "talks": [
        {
            "talkId": "6766101",
            "initDialog": "676610101",
            "dialogues": [
                {
                    "id": "676610101",
                    "speaker": "弗莱库",
                    "text": "好，这次的情报也顺利传到了。一路上都没遇到什么阻碍，真幸运啊。"
                }
            ]
        },
        {
            "talkId": "6766102",
            "initDialog": "676610201",
            "dialogues": [
                {
                    "id": "676610201",
                    "speaker": "Player",
                    "text": "之前遇到过什么吗？"
                },
                {
                    "id": "676610202",
                    "speaker": "弗莱库",
                    "text": "那可就多了，拦路的盗匪、夜袭的魔物…白天倒还好说，到了晚上指不定路上会遇见什么。"
                },
                {
                    "id": "676610203",
                    "speaker": "弗莱库",
                    "text": "虽说像我这样经验丰富的情报员，当然也知道走哪条路线是最安全的…"
                },
                {
                    "id": "676610204",
                    "speaker": "弗莱库",
                    "text": "不过军情紧急，很多时候也顾不上这些，只能兵行险着…那就全凭运气了。"
                }
            ]
        },
        {
            "talkId": "6766103",
            "initDialog": "676610301",
            "dialogues": [
                {
                    "id": "676610301",
                    "speaker": "Player",
                    "text": "没有更高效的手段吗？"
                },
                {
                    "id": "676610302",
                    "speaker": "弗莱库",
                    "text": "最近倒是听说那群北边来的家伙发明了什么能远程传递消息的新技术。"
                },
                {
                    "id": "676610303",
                    "speaker": "弗莱库",
                    "text": "我们也从那夏镇的市场上搞到过一台，不过那东西的使用限制实在太多，适应不了复杂的战场环境。"
                },
                {
                    "id": "676610304",
                    "speaker": "弗莱库",
                    "text": "真到了战场上，什么精密的机关都是靠不住的，最可靠的还得是人啊。"
                }
            ]
        },
        {
            "talkId": "6766104",
            "initDialog": "676610401",
            "dialogues": [
                {
                    "id": "676610401",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>叶洛亚</color>似乎有话要说…？）"
                },
                {
                    "id": "676610402",
                    "speaker": "叶洛亚",
                    "text": "弗莱库，要交给本部的报告顺利送到了吗？"
                },
                {
                    "id": "676610403",
                    "speaker": "弗莱库",
                    "text": "当然，队长、我特意选了一条鲜为人知的捷径，只花了平时三分之一的时间就跑了个来回。"
                },
                {
                    "id": "676610404",
                    "speaker": "叶洛亚",
                    "text": "顺利就好，不过老爷子收到报告之后有什么指示吗？"
                },
                {
                    "id": "676610405",
                    "speaker": "弗莱库",
                    "text": "咳咳，他的原话是说…「你要是早点汇报给我，我就让人假扮成宝藏猎人，趁着黑把那群惹事愚人众的老巢掏了。」"
                },
                {
                    "id": "676610406",
                    "speaker": "叶洛亚",
                    "text": "果然…就是因为这样，我才会等事情都解决完之后再汇报啊。"
                }
            ]
        },
        {
            "talkId": "6766105",
            "initDialog": "676610501",
            "dialogues": [
                {
                    "id": "676610501",
                    "speaker": "Player",
                    "text": "我先走了。"
                },
                {
                    "id": "676610502",
                    "speaker": "弗莱库",
                    "text": "好的，一路小心。"
                }
            ]
        }
    ]
}