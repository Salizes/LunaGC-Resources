{
    "groupId": "7521",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "扎列茨基": 6
    },
    "talks": [
        {
            "talkId": "6752101",
            "initDialog": "675210101",
            "dialogues": [
                {
                    "id": "675210101",
                    "speaker": "扎列茨基",
                    "text": "「高桌」…帮派…要处理的事也太多了一些吧…"
                }
            ]
        },
        {
            "talkId": "6752102",
            "initDialog": "675210201",
            "dialogues": [
                {
                    "id": "675210201",
                    "speaker": "Player",
                    "text": "你在说些什么？"
                },
                {
                    "id": "675210202",
                    "speaker": "扎列茨基",
                    "text": "我？我说什么了吗…哈哈，恐怕是您听错了吧，唉，我只是在说…老会长留下来的一些麻烦。"
                },
                {
                    "id": "675210203",
                    "speaker": "扎列茨基",
                    "text": "老会长不久前去世得…比较突然，新任的代理会长还没能完全掌握她应该掌握的工作。"
                },
                {
                    "id": "675210204",
                    "speaker": "扎列茨基",
                    "text": "或许她也没法承担很多能源协会会长本应承担的责任…所以有些事就只能依靠我们这些下面的人来了…"
                }
            ]
        },
        {
            "talkId": "6752103",
            "initDialog": "675210301",
            "dialogues": [
                {
                    "id": "675210301",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "675210302",
                    "speaker": "扎列茨基",
                    "text": "感谢您，好心人，不过不是所有的工作都能找到别人代劳…不然这世上为工作苦恼的人一定会少上许多吧。"
                }
            ]
        },
        {
            "talkId": "6752104",
            "initDialog": "675210401",
            "dialogues": [
                {
                    "id": "675210401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "675210402",
                    "speaker": "扎列茨基",
                    "text": "再见，可爱的朋友。"
                }
            ]
        }
    ]
}