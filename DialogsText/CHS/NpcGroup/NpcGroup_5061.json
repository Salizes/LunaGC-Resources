{
    "groupId": "5061",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "夏琳": 9
    },
    "talks": [
        {
            "talkId": "6506101",
            "initDialog": "650610101",
            "dialogues": [
                {
                    "id": "650610101",
                    "speaker": "夏琳",
                    "text": "你好！有什么我可以帮你的吗？"
                }
            ]
        },
        {
            "talkId": "6506102",
            "initDialog": "650610201",
            "dialogues": [
                {
                    "id": "650610201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650610202",
                    "speaker": "夏琳",
                    "text": "我是一名新入职的警备队员，你可以直接叫我夏琳。"
                },
                {
                    "id": "650610203",
                    "speaker": "夏琳",
                    "text": "记不住名字也没有关系，用「喂」、「你」或者「那个新人」任意一种都可以代替，随时乐意为你效劳！"
                }
            ]
        },
        {
            "talkId": "6506103",
            "initDialog": "650610301",
            "dialogues": [
                {
                    "id": "650610301",
                    "speaker": "Player",
                    "text": "这不好吧…"
                },
                {
                    "id": "650610302",
                    "speaker": "夏琳",
                    "text": "有什么关系？关键的是事件内容，而不是对我的称呼。"
                },
                {
                    "id": "650610303",
                    "speaker": "夏琳",
                    "text": "而且在我们这行中，最成功的人生，就是被人叫不上名字的人生！"
                },
                {
                    "id": "650610304",
                    "speaker": "夏琳",
                    "text": "因为要是一个警备队员的名字出现在了《蒸汽鸟报》上，那一定是出了什么问题。"
                }
            ]
        },
        {
            "talkId": "6506104",
            "initDialog": "650610401",
            "dialogues": [
                {
                    "id": "650610401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650610402",
                    "speaker": "夏琳",
                    "text": "祝你一切顺利，希望不要在案发现场与你再会，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "7493101",
            "initDialog": "749310101",
            "dialogues": [
                {
                    "id": "749310101",
                    "speaker": "Player",
                    "text": "心情不错？"
                },
                {
                    "id": "749310102",
                    "speaker": "夏琳",
                    "text": "嗯哼，为什么不呢？反正该发生的事情总会发生，还没发生的事情也犯不上提前担心！"
                },
                {
                    "id": "749310103",
                    "speaker": "夏琳",
                    "text": "有道理吧？是不是很有深度的人生经验？"
                }
            ]
        }
    ]
}