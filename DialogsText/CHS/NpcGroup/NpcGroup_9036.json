{
    "groupId": "9036",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Player": 18,
        "重云": 50
    },
    "talks": [
        {
            "talkId": "6903601",
            "initDialog": "690360101",
            "dialogues": [
                {
                    "id": "690360101",
                    "speaker": "重云",
                    "text": "#{NICKNAME}，近来可好？"
                },
                {
                    "id": "690360102",
                    "speaker": "重云",
                    "text": "奇闻异事、妖邪传闻…探听到消息的话，可要记得分享给我。"
                }
            ]
        },
        {
            "talkId": "6903602",
            "initDialog": "690360201",
            "dialogues": [
                {
                    "id": "690360201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690360202",
                    "speaker": "重云",
                    "text": "嗯，对我来说是个适合久居的好地方。"
                },
                {
                    "id": "690360203",
                    "speaker": "重云",
                    "text": "洞天之内虽不比雪山凉爽，却也不用担心烈日暴晒、气温骤变。"
                },
                {
                    "id": "690360204",
                    "speaker": "重云",
                    "text": "不用顾忌「纯阳之体」的影响，就可以一直专心练功。",
                    "choices": [
                        {
                            "id": "690360205",
                            "text": "不去外面多走走吗？",
                            "response": [
                                {
                                    "id": "690360206",
                                    "speaker": "重云",
                                    "text": "走也走，不过得随身带伞，看着点太阳。"
                                },
                                {
                                    "id": "690360209",
                                    "speaker": "重云",
                                    "text": "话说回来，谢谢你邀请我来这样宜居的地方…"
                                },
                                {
                                    "id": "690360210",
                                    "speaker": "重云",
                                    "text": "有什么需要我做的，我一定全力相助。"
                                }
                            ]
                        },
                        {
                            "id": "690360207",
                            "text": "看来不用担心洞天内有妖邪了。",
                            "response": [
                                {
                                    "id": "690360208",
                                    "speaker": "重云",
                                    "text": "那是自然，我可以向你担保。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903603",
            "initDialog": "690360301",
            "dialogues": [
                {
                    "id": "690360301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690360302",
                    "speaker": "重云",
                    "text": "好。我恰巧遇到了一些愤慨之事…"
                },
                {
                    "id": "690360303",
                    "speaker": "重云",
                    "text": "是这样的。不久前我听人说起有一本书，叫做《恶鬼奇谭录》，就花了重金将其买下。"
                },
                {
                    "id": "690360304",
                    "speaker": "重云",
                    "text": "结果哪里想到，这本书通篇都是在描写一个丧尽天良的大恶人！"
                },
                {
                    "id": "690360305",
                    "speaker": "重云",
                    "text": "我实在是…难以克制心中的怒火！"
                },
                {
                    "id": "690360306",
                    "speaker": "重云",
                    "text": "花了半天功夫才把这股气血压制下去。",
                    "choices": [
                        {
                            "id": "690360307",
                            "text": "是啊，这不是文不对题嘛！",
                            "response": [
                                {
                                    "id": "690360308",
                                    "speaker": "重云",
                                    "text": "文不对题？…我不是在乎这个。"
                                },
                                {
                                    "id": "690360311",
                                    "speaker": "重云",
                                    "text": "让我生气的是…这天底下怎么会有这么无恶不作的人！"
                                },
                                {
                                    "id": "690360312",
                                    "speaker": "重云",
                                    "text": "如果让我遇到了，我一定会…"
                                },
                                {
                                    "id": "690360313",
                                    "speaker": "重云",
                                    "text": "呼…呼…冷静，冷静。"
                                },
                                {
                                    "id": "690360314",
                                    "speaker": "Player",
                                    "text": "书里的情节一般是作者编出来的…"
                                },
                                {
                                    "id": "690360315",
                                    "speaker": "重云",
                                    "text": "你的意思是…这不是真人真事？"
                                },
                                {
                                    "id": "690360316",
                                    "speaker": "重云",
                                    "text": "可是它的情节跌宕起伏，就好像发生在眼前一样！"
                                },
                                {
                                    "id": "690360317",
                                    "speaker": "重云",
                                    "text": "……"
                                },
                                {
                                    "id": "690360318",
                                    "speaker": "重云",
                                    "text": "难道说…是我错误地相信了…",
                                    "choices": [
                                        {
                                            "id": "690360319",
                                            "text": "没事的，说明作者写得好…",
                                            "response": [
                                                {
                                                    "id": "690360321",
                                                    "speaker": "重云",
                                                    "text": "对不起…让你看笑话了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690360320",
                                            "text": "这也是常有的事情。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690360309",
                            "text": "我去说清来由，帮你退货。",
                            "response": [
                                {
                                    "id": "690360310",
                                    "speaker": "重云",
                                    "text": "不是的。不是钱的问题…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903604",
            "initDialog": "690360401",
            "dialogues": [
                {
                    "id": "690360401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690360402",
                    "speaker": "重云",
                    "text": "嗯，我想邀请你…一起吃鸳鸯锅。"
                },
                {
                    "id": "690360403",
                    "speaker": "重云",
                    "text": "你知道，因为我体质的缘故，所有食物都要等到凉透之后才能下口。"
                },
                {
                    "id": "690360404",
                    "speaker": "重云",
                    "text": "没法和你在同一时间吃饭…对我来说一直是个遗憾。"
                },
                {
                    "id": "690360405",
                    "speaker": "重云",
                    "text": "我冥思苦想，终于想出了鸳鸯锅这种吃法。"
                },
                {
                    "id": "690360406",
                    "speaker": "重云",
                    "text": "在热气腾腾的璃月火锅基础上，用一块隔板将两边汤底隔开。"
                },
                {
                    "id": "690360407",
                    "speaker": "重云",
                    "text": "这样即使你想吃绝云椒椒做的汤底，我也可以尽情享用清淡的那一边。"
                },
                {
                    "id": "690360408",
                    "speaker": "重云",
                    "text": "而且，火锅食材通常都是薄片。吃之前只要在盛满冰水的碗中浸泡片刻，就能迅速降温了。",
                    "choices": [
                        {
                            "id": "690360409",
                            "text": "好啊，听上去会很开心。",
                            "response": [
                                {
                                    "id": "690360410",
                                    "speaker": "重云",
                                    "text": "你…你这就已经答应了。"
                                },
                                {
                                    "id": "690360411",
                                    "speaker": "重云",
                                    "text": "也…也就是说，马上就能实现了…"
                                },
                                {
                                    "id": "690360415",
                                    "speaker": "重云",
                                    "text": "唔…"
                                },
                                {
                                    "id": "690360416",
                                    "speaker": "Player",
                                    "text": "你脸好红…"
                                },
                                {
                                    "id": "690360417",
                                    "speaker": "重云",
                                    "text": "我…我没事。我只是…"
                                },
                                {
                                    "id": "690360418",
                                    "speaker": "重云",
                                    "text": "比我想象中还顺利。让我有点开心过头了…等一下就好了…"
                                }
                            ]
                        },
                        {
                            "id": "690360412",
                            "text": "我来陪重云吃清汤的也行。",
                            "response": [
                                {
                                    "id": "690360413",
                                    "speaker": "重云",
                                    "text": "欸…欸！"
                                },
                                {
                                    "id": "690360414",
                                    "speaker": "重云",
                                    "text": "同…同一个锅子里煮出来的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903605",
            "initDialog": "690360501",
            "dialogues": [
                {
                    "id": "690360501",
                    "speaker": "Player",
                    "text": "早啊，重云。"
                },
                {
                    "id": "690360502",
                    "speaker": "重云",
                    "text": "#{NICKNAME}，早。"
                },
                {
                    "id": "690360503",
                    "speaker": "重云",
                    "text": "不知道你今天有什么安排？"
                },
                {
                    "id": "690360504",
                    "speaker": "重云",
                    "text": "结伴练功或是寻访妖邪，我一定奉陪。"
                }
            ]
        },
        {
            "talkId": "6903606",
            "initDialog": "690360601",
            "dialogues": [
                {
                    "id": "690360601",
                    "speaker": "Player",
                    "text": "晚安，重云。"
                },
                {
                    "id": "690360602",
                    "speaker": "重云",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690360603",
                    "speaker": "重云",
                    "text": "你先去吧。放心，我再练一遍功，也就休息了。"
                },
                {
                    "id": "690360604",
                    "speaker": "重云",
                    "text": "呼…今日最后一遍…"
                }
            ]
        },
        {
            "talkId": "6903607",
            "initDialog": "690360701",
            "dialogues": [
                {
                    "id": "690360701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903608",
            "initDialog": "690360801",
            "dialogues": [
                {
                    "id": "690360801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903609",
            "initDialog": "690360901",
            "dialogues": [
                {
                    "id": "690360901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903650",
            "initDialog": "690365001",
            "dialogues": [
                {
                    "id": "690365001",
                    "speaker": "重云",
                    "text": "你怎么知道我正发愁找不到地方练功…"
                },
                {
                    "id": "690365002",
                    "speaker": "重云",
                    "text": "简单的帐篷、行囊…在这里修行正好。"
                },
                {
                    "id": "690365003",
                    "speaker": "重云",
                    "text": "居所附近这样布置一番真是好想法，你安排费心了，多谢。"
                }
            ]
        },
        {
            "talkId": "6903651",
            "initDialog": "690365101",
            "dialogues": [
                {
                    "id": "690365101",
                    "speaker": "重云",
                    "text": "旅行归来，在这里休整行装应该不错。"
                },
                {
                    "id": "690365102",
                    "speaker": "重云",
                    "text": "武器可以放在那里，符箓的话，放在枕头底下，嗯。"
                },
                {
                    "id": "690365103",
                    "speaker": "重云",
                    "text": "不过，伞放在哪里好呢…干脆，就放在进门的位置吧。"
                }
            ]
        }
    ]
}