{
    "groupId": "6246",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "托扬娜": 12
    },
    "talks": [
        {
            "talkId": "6624601",
            "initDialog": "662460101",
            "dialogues": [
                {
                    "id": "662460101",
                    "speaker": "托扬娜",
                    "text": "真难办，怎么才能让绒翼龙们自己平衡下两边的数量呢…"
                }
            ]
        },
        {
            "talkId": "6624602",
            "initDialog": "662460201",
            "dialogues": [
                {
                    "id": "662460201",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "662460202",
                    "speaker": "托扬娜",
                    "text": "哦，没事，不用的。不是什么大问题，或者说，根本不是什么问题，只是我自己的毛病罢了…"
                },
                {
                    "id": "662460203",
                    "speaker": "托扬娜",
                    "text": "我是负责指挥绒翼龙降落的工作人员。"
                },
                {
                    "id": "662460204",
                    "speaker": "托扬娜",
                    "text": "在龙少的时候，一般不成问题。但如果同时有大量的龙返回营地，就需要我用手势或者旗语稍加指挥了。"
                },
                {
                    "id": "662460205",
                    "speaker": "托扬娜",
                    "text": "有时会有好几只龙同时看上一片适合降落的平地，那场面可真是混乱啊。"
                }
            ]
        },
        {
            "talkId": "6624603",
            "initDialog": "662460301",
            "dialogues": [
                {
                    "id": "662460301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "662460302",
                    "speaker": "托扬娜",
                    "text": "没事，是我自己的问题…"
                }
            ]
        },
        {
            "talkId": "6624604",
            "initDialog": "662460401",
            "dialogues": [
                {
                    "id": "662460401",
                    "speaker": "Player",
                    "text": "那需要平衡的是…"
                },
                {
                    "id": "662460402",
                    "speaker": "托扬娜",
                    "text": "是我内心两侧的数量。"
                },
                {
                    "id": "662460403",
                    "speaker": "托扬娜",
                    "text": "…抱歉，抱歉，真是个不好笑的笑话！"
                },
                {
                    "id": "662460404",
                    "speaker": "托扬娜",
                    "text": "我的意思是，有时当我看到高台两侧降落的龙数量差距过大时，我的心里会稍微…有那么一点难受。"
                },
                {
                    "id": "662460405",
                    "speaker": "托扬娜",
                    "text": "但如果为了这点小事就去打扰休息的绒翼龙，让它们换地方，又感觉太小题大作了…"
                },
                {
                    "id": "662460406",
                    "speaker": "托扬娜",
                    "text": "唉，这样下去，会被龙讨厌的吧…"
                },
                {
                    "id": "662460407",
                    "speaker": "托扬娜",
                    "text": "看来，人只能自己克服内心的失衡了。"
                }
            ]
        }
    ]
}