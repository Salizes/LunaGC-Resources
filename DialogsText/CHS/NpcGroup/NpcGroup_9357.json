{
    "groupId": "9357",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "莱依拉": 9
    },
    "talks": [
        {
            "talkId": "6935701",
            "initDialog": "693570101",
            "dialogues": [
                {
                    "id": "693570101",
                    "speaker": "莱依拉",
                    "text": "现在是休息时间吗？但我还是睡不着…"
                },
                {
                    "id": "693570102",
                    "speaker": "莱依拉",
                    "text": "啊不对，等下还有很重要的事情吧？现在可不能睡着啊！"
                },
                {
                    "id": "693570103",
                    "speaker": "莱依拉",
                    "text": "但是，如果不好好休息的话，接下来肯定会出差错，到底要怎么办才好…"
                }
            ]
        },
        {
            "talkId": "6935702",
            "initDialog": "693570201",
            "dialogues": [
                {
                    "id": "693570201",
                    "speaker": "莱依拉",
                    "text": "综合手上已有的情报进行分析，更加高效的作战方法…帮她写在纸上吧。"
                },
                {
                    "id": "693570202",
                    "speaker": "莱依拉",
                    "text": "不知道她醒来后，会不会感到惊讶呢？"
                },
                {
                    "id": "693570203",
                    "speaker": "莱依拉",
                    "text": "梦游时间该结束了，接下去的挑战，你要好好陪着她哦。"
                }
            ]
        },
        {
            "talkId": "6935703",
            "initDialog": "693570301",
            "dialogues": [
                {
                    "id": "693570301",
                    "speaker": "莱依拉",
                    "text": "偶尔读一些轻松的故事书也不错，不会像研究学术典籍那样焦头烂额的。"
                },
                {
                    "id": "693570302",
                    "speaker": "莱依拉",
                    "text": "嗯…还是不行，现在就放松了的话，下一篇论文又会赶不上的。"
                },
                {
                    "id": "693570303",
                    "speaker": "莱依拉",
                    "text": "不能光指望「星空赐福」的恩惠，我自己也得更加努力呀！"
                }
            ]
        }
    ]
}