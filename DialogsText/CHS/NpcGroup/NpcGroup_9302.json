{
    "groupId": "9302",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "凯亚": 9
    },
    "talks": [
        {
            "talkId": "6930201",
            "initDialog": "693020101",
            "dialogues": [
                {
                    "id": "693020101",
                    "speaker": "凯亚",
                    "text": "#{NICKNAME}，你知道品尝烈酒的诀窍是什么吗？是「节奏感」。"
                },
                {
                    "id": "693020102",
                    "speaker": "凯亚",
                    "text": "小抿一口后，要让味蕾休息恰当的时间。等那猛烈的滋味弥散到唇齿之间，变成绵长的回味。直到呼吸清澈之后，再喝下一口。"
                },
                {
                    "id": "693020103",
                    "speaker": "凯亚",
                    "text": "掌握这种节奏，连「午后之死」也能被你驯服。对于战斗来说，也是这个道理。"
                }
            ]
        },
        {
            "talkId": "6930202",
            "initDialog": "693020201",
            "dialogues": [
                {
                    "id": "693020201",
                    "speaker": "凯亚",
                    "text": "主动向强大的存在挑战，听起来不够明智。"
                },
                {
                    "id": "693020202",
                    "speaker": "凯亚",
                    "text": "不过，观察这场挑战的结果，也算是一种有趣的体验。哦，差点忘了，这次我也是参与挑战的一员。"
                },
                {
                    "id": "693020203",
                    "speaker": "凯亚",
                    "text": "#不要担心，{NICKNAME}，我会认真起来的。"
                }
            ]
        },
        {
            "talkId": "6930203",
            "initDialog": "693020301",
            "dialogues": [
                {
                    "id": "693020301",
                    "speaker": "凯亚",
                    "text": "你肯定想前往秘境的最深处，把那些隐藏到最后的秘密也调查清楚吧？"
                },
                {
                    "id": "693020302",
                    "speaker": "凯亚",
                    "text": "不要误会。在我看来，无论在怎样的路途上前行，能坚持走到最后的人都是令人尊敬的。"
                },
                {
                    "id": "693020303",
                    "speaker": "凯亚",
                    "text": "只是，抵达终点的代价往往不同。命运的安排如此多样，令人慨叹。"
                }
            ]
        }
    ]
}