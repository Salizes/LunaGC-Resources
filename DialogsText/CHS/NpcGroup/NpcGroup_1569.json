{
    "groupId": "1569",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "阿瑟尔": 12
    },
    "talks": [
        {
            "talkId": "6156905",
            "initDialog": "615690501",
            "dialogues": [
                {
                    "id": "615690501",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6156906",
            "initDialog": "615690601",
            "dialogues": [
                {
                    "id": "615690601",
                    "speaker": "阿瑟尔",
                    "text": "我，我们再来一局！"
                }
            ]
        },
        {
            "talkId": "6156907",
            "initDialog": "615690701",
            "dialogues": [
                {
                    "id": "615690701",
                    "speaker": "阿瑟尔",
                    "text": "哼，可别小看我！"
                }
            ]
        },
        {
            "talkId": "6156901",
            "initDialog": "615690101",
            "dialogues": [
                {
                    "id": "615690101",
                    "speaker": "阿瑟尔",
                    "text": "你来干嘛？我不需要你帮忙。"
                }
            ]
        },
        {
            "talkId": "6156902",
            "initDialog": "615690201",
            "dialogues": [
                {
                    "id": "615690201",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "615690202",
                    "speaker": "阿瑟尔",
                    "text": "我要把这把剑拔出来，你可别打它的主意，它是我先发现的！"
                },
                {
                    "id": "615690203",
                    "speaker": "阿瑟尔",
                    "text": "只要能拔出它来，就能…"
                },
                {
                    "id": "615690204",
                    "speaker": "阿瑟尔",
                    "text": "…啊具体发生什么我也不知道，反正一定会发生很厉害的事！"
                },
                {
                    "id": "615690205",
                    "speaker": "阿瑟尔",
                    "text": "你看它上面的锈，插在地上的角度…都是那么完美，绝对是存在在什么传说中的剑，没错！"
                },
                {
                    "id": "615690206",
                    "speaker": "阿瑟尔",
                    "text": "有了它，我就能跟爸爸一起去冒险了吧，而且…还要加入冒险家协会！"
                }
            ]
        },
        {
            "talkId": "6156903",
            "initDialog": "615690301",
            "dialogues": [
                {
                    "id": "615690301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615690302",
                    "speaker": "阿瑟尔",
                    "text": "嗯，快走吧，不要告诉别人这把剑的事哦！"
                }
            ]
        },
        {
            "talkId": "6156904",
            "initDialog": "615690401",
            "dialogues": [
                {
                    "id": "615690401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "615690402",
                    "speaker": "阿瑟尔",
                    "text": "哼，真可惜啊，本来是我大显身手的好时机来着，没想到没等我把剑拔出来就结束了…"
                },
                {
                    "id": "615690403",
                    "speaker": "阿瑟尔",
                    "text": "只要我把这把剑拔出来就一定可以战胜风魔龙的，它一定是传说中的剑，而我就一定是…"
                },
                {
                    "id": "615690404",
                    "speaker": "阿瑟尔",
                    "text": "什么？我、我才没有害怕过呢，只是没把剑拔出来而已！"
                }
            ]
        }
    ]
}