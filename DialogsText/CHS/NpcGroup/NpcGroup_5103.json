{
    "groupId": "5103",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "艾菲": 16
    },
    "talks": [
        {
            "talkId": "6510301",
            "initDialog": "651030101",
            "dialogues": [
                {
                    "id": "651030101",
                    "speaker": "艾菲",
                    "text": "要不要猜猜看，下次庭审会由那维莱特大人主持吗？芙宁娜大人又会不会在场呢？"
                }
            ]
        },
        {
            "talkId": "6510302",
            "initDialog": "651030201",
            "dialogues": [
                {
                    "id": "651030201",
                    "speaker": "Player",
                    "text": "关于那维莱特…"
                },
                {
                    "id": "651030202",
                    "speaker": "艾菲",
                    "text": "嗯，就是那位带着我们美露莘来到枫丹廷生活的最高审判官大人那维莱特。"
                },
                {
                    "id": "651030203",
                    "speaker": "艾菲",
                    "text": "那维莱特大人工作很忙，只会主持一部分案件的审理，其余的则由他手下的「检律庭」处理。"
                },
                {
                    "id": "651030204",
                    "speaker": "艾菲",
                    "text": "不过即使工作越来越忙，他在看到我们时仍会停下来打招呼，几百年间一直如此呢。"
                }
            ]
        },
        {
            "talkId": "6510303",
            "initDialog": "651030301",
            "dialogues": [
                {
                    "id": "651030301",
                    "speaker": "Player",
                    "text": "关于芙宁娜…"
                },
                {
                    "id": "651030302",
                    "speaker": "艾菲",
                    "text": "芙宁娜大人十分可爱，就像阳光下的海水一样，泛着软乎乎的泡沫。"
                },
                {
                    "id": "651030303",
                    "speaker": "艾菲",
                    "text": "不过她的脾气…我琢磨不透。有时像汹涌的海浪，有时又像深潭里的死水。"
                },
                {
                    "id": "651030304",
                    "speaker": "艾菲",
                    "text": "原来神明的性格，要比人类激烈得多啊。"
                }
            ]
        },
        {
            "talkId": "6510304",
            "initDialog": "651030401",
            "dialogues": [
                {
                    "id": "651030401",
                    "speaker": "Player",
                    "text": "拭目以待。"
                },
                {
                    "id": "651030402",
                    "speaker": "艾菲",
                    "text": "嗯！"
                }
            ]
        },
        {
            "talkId": "6510305",
            "initDialog": "651030501",
            "dialogues": [
                {
                    "id": "651030501",
                    "speaker": "艾菲",
                    "text": "要不要猜猜看，下次庭审会由那维莱特大人主持吗？芙宁娜小姐又会不会出现在歌剧院呢？"
                }
            ]
        },
        {
            "talkId": "6510306",
            "initDialog": "651030601",
            "dialogues": [
                {
                    "id": "651030601",
                    "speaker": "Player",
                    "text": "关于芙宁娜…"
                },
                {
                    "id": "651030602",
                    "speaker": "艾菲",
                    "text": "芙宁娜小姐十分可爱，就像阳光下的海水一样，泛着软乎乎的泡沫。"
                },
                {
                    "id": "651030603",
                    "speaker": "艾菲",
                    "text": "但我以前总是琢磨不透她的脾气，有时像汹涌的海浪，有时又像深潭里的死水…"
                },
                {
                    "id": "651030604",
                    "speaker": "艾菲",
                    "text": "好像有阵时间没见到她了…决定了，下次再见的时候，用最热情的笑容和她打招呼吧！"
                }
            ]
        },
        {
            "talkId": "6510307",
            "initDialog": "651030701",
            "dialogues": [
                {
                    "id": "651030701",
                    "speaker": "Player",
                    "text": "关于芙宁娜…"
                },
                {
                    "id": "651030702",
                    "speaker": "艾菲",
                    "text": "芙宁娜小姐十分可爱，就像阳光下的海水一样，泛着软乎乎的泡沫。"
                },
                {
                    "id": "651030703",
                    "speaker": "艾菲",
                    "text": "但我以前总是琢磨不透她的脾气，有时像汹涌的海浪，有时又像深潭里的死水…"
                },
                {
                    "id": "651030704",
                    "speaker": "艾菲",
                    "text": "不过现在没有这种感觉了。"
                },
                {
                    "id": "651030705",
                    "speaker": "艾菲",
                    "text": "上次见面的时候，芙宁娜小姐看起来很高兴，说今后可能会有更多来歌剧院拜访的机会！嘿嘿，真期待啊。"
                }
            ]
        }
    ]
}