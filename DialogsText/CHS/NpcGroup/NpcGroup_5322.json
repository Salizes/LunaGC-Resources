{
    "groupId": "5322",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "芙佳": 15
    },
    "talks": [
        {
            "talkId": "6532201",
            "initDialog": "653220101",
            "dialogues": [
                {
                    "id": "653220101",
                    "speaker": "芙佳",
                    "text": "啊，怎么了，有什么想知道的关于矿石的事吗，不管是什么事都可以问我哦！"
                }
            ]
        },
        {
            "talkId": "6532202",
            "initDialog": "653220201",
            "dialogues": [
                {
                    "id": "653220201",
                    "speaker": "Player",
                    "text": "关于矿石…"
                },
                {
                    "id": "653220202",
                    "speaker": "芙佳",
                    "text": "嗯，芙佳这里有各种各样漂亮的石头。要是你有什么想要的，说不定这里就有！"
                },
                {
                    "id": "653220203",
                    "speaker": "芙佳",
                    "text": "虽然大多数只是些普通的矿石，不像是姐姐的宝石那样珍稀呢…"
                }
            ]
        },
        {
            "talkId": "6532203",
            "initDialog": "653220301",
            "dialogues": [
                {
                    "id": "653220301",
                    "speaker": "Player",
                    "text": "关于矿石的用途…"
                },
                {
                    "id": "653220302",
                    "speaker": "芙佳",
                    "text": "芙佳之前从来没有想过这些…我只是觉得好看才会收集各种各样的石头的…"
                },
                {
                    "id": "653220303",
                    "speaker": "芙佳",
                    "text": "外面的人居然会觉得这些石头有用，真是奇怪呢。"
                }
            ]
        },
        {
            "talkId": "6532204",
            "initDialog": "653220401",
            "dialogues": [
                {
                    "id": "653220401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653220402",
                    "speaker": "芙佳",
                    "text": "再见！要是捡到了漂亮的石头，记得一定要告诉芙佳喔！"
                }
            ]
        },
        {
            "talkId": "6532205",
            "initDialog": "653220501",
            "dialogues": [
                {
                    "id": "653220501",
                    "speaker": "Player",
                    "text": "关于矿石…"
                },
                {
                    "id": "653220502",
                    "speaker": "芙佳",
                    "text": "嗯，芙佳这里有各种各样漂亮的石头。要是你有什么想要的，说不定这里就有！"
                },
                {
                    "id": "653220503",
                    "speaker": "芙佳",
                    "text": "虽然大多数只是些普通的矿石，不过，就算是普通的矿石，说不定也有了不起的作用，对吧？"
                }
            ]
        },
        {
            "talkId": "6532206",
            "initDialog": "653220601",
            "dialogues": [
                {
                    "id": "653220601",
                    "speaker": "Player",
                    "text": "钟表的事情怎么样了？"
                },
                {
                    "id": "653220602",
                    "speaker": "芙佳",
                    "text": "按照切瑟尔先生的说法，很快就能制造出新的漂亮钟表。"
                },
                {
                    "id": "653220603",
                    "speaker": "芙佳",
                    "text": "切瑟尔先生还带我参观过他们的加工石头的地方，漂亮的石头被切得很小很小…"
                },
                {
                    "id": "653220604",
                    "speaker": "芙佳",
                    "text": "虽然芙佳也不是很明白，但切瑟尔先生说，那些石头变成了漂亮钟表的心…"
                },
                {
                    "id": "653220605",
                    "speaker": "芙佳",
                    "text": "他这么说的时候，芙佳也感到很高兴。"
                },
                {
                    "id": "653220606",
                    "speaker": "芙佳",
                    "text": "不过，最近切瑟尔先生说要用摩拉换更多的石头…"
                },
                {
                    "id": "653220607",
                    "speaker": "芙佳",
                    "text": "摩拉虽然亮晶晶的，但是都长得一样，芙佳才不要用石头换呢。"
                }
            ]
        },
        {
            "talkId": "6532207",
            "initDialog": "653220701",
            "dialogues": [
                {
                    "id": "653220701",
                    "speaker": "芙佳",
                    "text": "啊，怎么了，有什么想知道的关于矿石的事吗，不管是什么事都可以问我哦！"
                }
            ]
        }
    ]
}