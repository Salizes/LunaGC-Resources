{
    "groupId": "3081",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 9,
        "卡琵莉亚": 29
    },
    "talks": [
        {
            "talkId": "4006306",
            "initDialog": "400630601",
            "dialogues": [
                {
                    "id": "400630601",
                    "speaker": "卡琵莉亚",
                    "text": "这次容彩祭，我们远航之风也承担了一部分展会的物料准备工作。"
                },
                {
                    "id": "400630602",
                    "speaker": "卡琵莉亚",
                    "text": "不仅如此，我们还争取到了与轻小说《拜托了我的狐仙宫司》进行联动，每天限量出售限定联动饮品的机会！"
                },
                {
                    "id": "400630603",
                    "speaker": "卡琵莉亚",
                    "text": "饮品中添加了蒙德特产，口感独特，请一定要试一试。"
                }
            ]
        },
        {
            "talkId": "4006362",
            "initDialog": "400636201",
            "dialogues": [
                {
                    "id": "400636201",
                    "speaker": "卡琵莉亚",
                    "text": "这次容彩祭，我们远航之风也承担了一部分展会的物料准备工作。"
                },
                {
                    "id": "400636202",
                    "speaker": "卡琵莉亚",
                    "text": "不仅如此，我们还争取到了与轻小说《拜托了我的狐仙宫司》进行联动，开展之后就会开始售卖，请客人耐心等待哦。"
                }
            ]
        },
        {
            "talkId": "4006364",
            "initDialog": "400636401",
            "dialogues": [
                {
                    "id": "400636401",
                    "speaker": "Player",
                    "text": "现在在卖什么？"
                },
                {
                    "id": "400636402",
                    "speaker": "卡琵莉亚",
                    "text": "联动限定饮品仅在容彩祭期间提供，每位客人限购一杯哦。"
                }
            ]
        },
        {
            "talkId": "4006365",
            "initDialog": "630810201",
            "dialogues": [
                {
                    "id": "630810201",
                    "speaker": "Player",
                    "text": "关于这家店…"
                },
                {
                    "id": "630810202",
                    "speaker": "卡琵莉亚",
                    "text": "本店是蒙德特色酒品的专卖店哦。"
                },
                {
                    "id": "630810203",
                    "speaker": "卡琵莉亚",
                    "text": "本店的果酒全都是用最纯净的果酒湖水和最新鲜的蒙德果品酿制的，就算是远在稻妻，也能让顾客品尝到正宗纯正的蒙德佳酿！"
                },
                {
                    "id": "630810204",
                    "speaker": "卡琵莉亚",
                    "text": "所以想要品尝蒙德好酒的话，就请认准「远航之风」吧！"
                }
            ]
        },
        {
            "talkId": "4006366",
            "initDialog": "400636601",
            "dialogues": [
                {
                    "id": "400636601",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "400636602",
                    "speaker": "卡琵莉亚",
                    "text": "这几天的生意真的很好，甚至都有点忙不过来了。"
                },
                {
                    "id": "400636603",
                    "speaker": "卡琵莉亚",
                    "text": "因为最近来了许多蒙德的客人，他们每天都会到这里买酒，所以蒙德酒的销量也提升了。"
                }
            ]
        },
        {
            "talkId": "6308101",
            "initDialog": "630810101",
            "dialogues": [
                {
                    "id": "630810101",
                    "speaker": "卡琵莉亚",
                    "text": "嘿，要来尝尝蒙德的好酒吗？如假包换、童叟无欺！"
                }
            ]
        },
        {
            "talkId": "6308103",
            "initDialog": "630810301",
            "dialogues": [
                {
                    "id": "630810301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630810302",
                    "speaker": "卡琵莉亚",
                    "text": "再见！欢迎下次光临！"
                }
            ]
        },
        {
            "talkId": "6308104",
            "initDialog": "630810401",
            "dialogues": [
                {
                    "id": "630810401",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "630810402",
                    "speaker": "卡琵莉亚",
                    "text": "还不错，毕竟蒙德的酒在整个提瓦特都广受好评嘛。"
                },
                {
                    "id": "630810403",
                    "speaker": "卡琵莉亚",
                    "text": "只是「锁国令」让物资运输变得麻烦了不少，令人头疼…"
                },
                {
                    "id": "630810404",
                    "speaker": "卡琵莉亚",
                    "text": "不知道如果用稻妻本土的材料来酿酒的话，效果会怎么样，唔…"
                }
            ]
        },
        {
            "talkId": "6308105",
            "initDialog": "630810501",
            "dialogues": [
                {
                    "id": "630810501",
                    "speaker": "Player",
                    "text": "比晨曦酒庄的酒还好吗？"
                },
                {
                    "id": "630810502",
                    "speaker": "卡琵莉亚",
                    "text": "这个嘛，那当然还是我们…"
                },
                {
                    "id": "630810503",
                    "speaker": "卡琵莉亚",
                    "text": "唉，算了，作为一个酒客，在这件事上我没法说出违心的话。"
                },
                {
                    "id": "630810504",
                    "speaker": "卡琵莉亚",
                    "text": "不得不承认还是晨曦酒庄的酒比较好，连我自己都更爱喝他们的酒。"
                },
                {
                    "id": "630810505",
                    "speaker": "卡琵莉亚",
                    "text": "其实我们店就是因为和「天使的馈赠」竞争失败了才跑到这里来卖酒的…"
                },
                {
                    "id": "630810506",
                    "speaker": "卡琵莉亚",
                    "text": "不过晨曦酒庄名下的产业已经快要把蒙德的酒业垄断了，总觉得…不是什么好事。"
                }
            ]
        },
        {
            "talkId": "6308106",
            "initDialog": "630810601",
            "dialogues": [
                {
                    "id": "630810601",
                    "speaker": "Player",
                    "text": "只卖酒吗？"
                },
                {
                    "id": "630810602",
                    "speaker": "卡琵莉亚",
                    "text": "唔…客人是还不能喝酒吗？那么…嗯，倒是还有些其他的东西，比如蒙德知名的蒲公英酒…的酿酒原料！"
                },
                {
                    "id": "630810603",
                    "speaker": "卡琵莉亚",
                    "text": "这可是蒙德特产，本不在商品列表里的。但看在你也是外国人的份上，就特例出售给你吧。"
                }
            ]
        },
        {
            "talkId": "6308107",
            "initDialog": "630810701",
            "dialogues": [
                {
                    "id": "630810701",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "630810702",
                    "speaker": "卡琵莉亚",
                    "text": "还不错，毕竟蒙德的酒在整个提瓦特都广受好评嘛。"
                },
                {
                    "id": "630810703",
                    "speaker": "卡琵莉亚",
                    "text": "锁国令刚刚解除，就有好几位客人来我这里下了不少订单，其中蒲公英酒的需求量稳居第一。"
                },
                {
                    "id": "630810704",
                    "speaker": "卡琵莉亚",
                    "text": "既然稻妻周围已经没有了雷暴，那么货运的商船应该很快就能到了吧。到时候不仅是客户，就连我自己也能好好喝上一杯…"
                },
                {
                    "id": "630810705",
                    "speaker": "卡琵莉亚",
                    "text": "咳咳，当然我是说工作之后再喝啦！"
                }
            ]
        },
        {
            "talkId": "6308108",
            "initDialog": "630810801",
            "dialogues": [
                {
                    "id": "630810801",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6308109",
            "initDialog": "630810901",
            "dialogues": [
                {
                    "id": "630810901",
                    "speaker": "卡琵莉亚",
                    "text": "唔…怎么会这样，是在哪里失误了吗…"
                }
            ]
        },
        {
            "talkId": "6308110",
            "initDialog": "630811001",
            "dialogues": [
                {
                    "id": "630811001",
                    "speaker": "卡琵莉亚",
                    "text": "嘿嘿，又难倒了一个…啊我是说，这是很难的牌局，通不过才比较正常。"
                }
            ]
        }
    ]
}