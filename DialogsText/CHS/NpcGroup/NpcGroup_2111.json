    "talks": [
        {
            "talkId": "6211101",
            "initDialog": "621110101",
            "dialogues": [
                {
                    "id": "621110101",
                    "speaker": "乔姨",
                    "text": "年轻人，想歇就歇会儿吧，可别累着。"
                }
            ]
        },
        {
            "talkId": "6211102",
            "initDialog": "621110201",
            "dialogues": [
                {
                    "id": "621110201",
                    "speaker": "Player",
                    "text": "您在做什么？"
                },
                {
                    "id": "621110202",
                    "speaker": "乔姨",
                    "text": "阿婆我啊，只是在这儿帮忙看看摊位的。"
                },
                {
                    "id": "621110203",
                    "speaker": "乔姨",
                    "text": "这附近卖茶的、卖茶叶的、卖茶叶蛋的，我都熟得很。"
                },
                {
                    "id": "621110204",
                    "speaker": "乔姨",
                    "text": "他们有事的时候就让我来帮忙看看摊，他们都放心。"
                }
            ]
        },
        {
            "talkId": "6211103",
            "initDialog": "621110301",
            "dialogues": [
                {
                    "id": "621110301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621110302",
                    "speaker": "乔姨",
                    "text": "再见，年轻人。"
                }
            ]
        }
    ]
}