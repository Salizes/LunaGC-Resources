{
    "groupId": "4344",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "沙欣": 11
    },
    "talks": [
        {
            "talkId": "6434401",
            "initDialog": "643440101",
            "dialogues": [
                {
                    "id": "643440101",
                    "speaker": "沙欣",
                    "text": "这里的人都不怎么擅长聊天啊，有点没劲。"
                }
            ]
        },
        {
            "talkId": "6434402",
            "initDialog": "643440201",
            "dialogues": [
                {
                    "id": "643440201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "643440202",
                    "speaker": "沙欣",
                    "text": "哎，你好！能在这碰到主动与我搭话的人，可真少见啊。"
                },
                {
                    "id": "643440203",
                    "speaker": "沙欣",
                    "text": "这位英雄，你从哪来？来这何事？"
                },
                {
                    "id": "643440204",
                    "speaker": "沙欣",
                    "text": "我跟你说啊，这个大花园里的人都可无聊了，无论问什么都是「我不知道啊」、「我不清楚欸」、「你别乱打听了」。"
                },
                {
                    "id": "643440205",
                    "speaker": "沙欣",
                    "text": "本以为到城外工作会更有乐子，这么一看，还不如跟着「三十人团」在城里接活呢。"
                }
            ]
        },
        {
            "talkId": "6434403",
            "initDialog": "643440301",
            "dialogues": [
                {
                    "id": "643440301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643440302",
                    "speaker": "沙欣",
                    "text": "欸，你也不理我吗…"
                }
            ]
        },
        {
            "talkId": "6434404",
            "initDialog": "643440401",
            "dialogues": [
                {
                    "id": "643440401",
                    "speaker": "Player",
                    "text": "关于「三十人团」…"
                },
                {
                    "id": "643440402",
                    "speaker": "沙欣",
                    "text": "他们啊，大概是须弥最大的镀金旅团了吧，主要负责接须弥城里的活，连穿的衣服颜色也和我们不一样，看着气派多了。"
                },
                {
                    "id": "643440403",
                    "speaker": "沙欣",
                    "text": "我也不知道他们为什么叫「三十人团」，我看人数可远远不止。"
                },
                {
                    "id": "643440404",
                    "speaker": "沙欣",
                    "text": "可能因为他们和教令院合作得太多，也有点沾染上了那股子严肃劲儿，我不是很喜欢。"
                },
                {
                    "id": "643440405",
                    "speaker": "沙欣",
                    "text": "…哎，我说这有什么用呢，自己不是也在为教令院干活吗，哈哈。"
                },
                {
                    "id": "643440406",
                    "speaker": "沙欣",
                    "text": "只不过还好不在贤者们的眼皮子底下，多少更自在一些吧。"
                }
            ]
        }
    ]
}