{
    "groupId": "2484",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "黄三爷": 9
    },
    "talks": [
        {
            "talkId": "6248401",
            "initDialog": "624840101",
            "dialogues": [
                {
                    "id": "624840101",
                    "speaker": "黄三爷",
                    "text": "#有缘人，可对我古华派的重地有兴趣…啊呀！是{M#少侠}{F#女侠}！"
                }
            ]
        },
        {
            "talkId": "6248402",
            "initDialog": "624840201",
            "dialogues": [
                {
                    "id": "624840201",
                    "speaker": "Player",
                    "text": "遇见有缘人了吗？"
                },
                {
                    "id": "624840202",
                    "speaker": "黄三爷",
                    "text": "#托{M#少侠}{F#女侠}带来的运势，近来有不少游客随我参观了王山厅，还都很有诚意…"
                },
                {
                    "id": "624840203",
                    "speaker": "黄三爷",
                    "text": "虽说他们也没留下太多摩拉，但多少充实了修缮王山厅的资金。"
                },
                {
                    "id": "624840204",
                    "speaker": "黄三爷",
                    "text": "#{M#少侠}{F#女侠}若是有兴趣，可以再来王山厅转转！"
                }
            ]
        },
        {
            "talkId": "6248403",
            "initDialog": "624840301",
            "dialogues": [
                {
                    "id": "624840301",
                    "speaker": "Player",
                    "text": "还需要我给你做顿饭吗？"
                },
                {
                    "id": "624840302",
                    "speaker": "黄三爷",
                    "text": "#不劳{M#少侠}{F#女侠}了！心意早就到了！"
                },
                {
                    "id": "624840303",
                    "speaker": "黄三爷",
                    "text": "#相反，若是有机会，还得由我为{M#少侠}{F#女侠}做份好菜，或是直接下馆子。"
                },
                {
                    "id": "624840304",
                    "speaker": "黄三爷",
                    "text": "呃，慢着，我算算这几天的开销…"
                },
                {
                    "id": "624840305",
                    "speaker": "黄三爷",
                    "text": "#咳咳！改日一定请{M#少侠}{F#女侠}大快朵颐一顿！"
                }
            ]
        },
        {
            "talkId": "6248404",
            "initDialog": "624840401",
            "dialogues": [
                {
                    "id": "624840401",
                    "speaker": "Player",
                    "text": "您继续忙！"
                },
                {
                    "id": "624840402",
                    "speaker": "黄三爷",
                    "text": "#客气了，{M#少侠}{F#女侠}！有缘再相见！"
                }
            ]
        }
    ]
}