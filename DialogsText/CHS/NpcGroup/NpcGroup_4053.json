{
    "groupId": "4053",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "萨勒": 9
    },
    "talks": [
        {
            "talkId": "6405301",
            "initDialog": "640530101",
            "dialogues": [
                {
                    "id": "640530101",
                    "speaker": "萨勒",
                    "text": "好好工作，好好攒钱，生活一直在进步。"
                }
            ]
        },
        {
            "talkId": "6405302",
            "initDialog": "640530201",
            "dialogues": [
                {
                    "id": "640530201",
                    "speaker": "Player",
                    "text": "攒钱做什么？"
                },
                {
                    "id": "640530202",
                    "speaker": "萨勒",
                    "text": "我的梦想，就是能开一家属于自己的店铺，不用很大，营收够自用就行了。"
                },
                {
                    "id": "640530203",
                    "speaker": "萨勒",
                    "text": "我干惯了体力活，经商头脑一般，不指望能像小弟朱特那样有出息，只求过上安稳的生活。"
                },
                {
                    "id": "640530204",
                    "speaker": "萨勒",
                    "text": "最近往来须弥的货船不少，尤其是至冬来的商人，很舍得花钱请工人搬货。"
                },
                {
                    "id": "640530205",
                    "speaker": "萨勒",
                    "text": "如此一来，我离实现开店的愿望应该不远了。"
                }
            ]
        },
        {
            "talkId": "6405303",
            "initDialog": "640530301",
            "dialogues": [
                {
                    "id": "640530301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640530302",
                    "speaker": "萨勒",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "7393401",
            "initDialog": "739340101",
            "dialogues": [
                {
                    "id": "739340101",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "739340102",
                    "speaker": "萨勒",
                    "text": "谢谢啦。"
                },
                {
                    "id": "739340103",
                    "speaker": "萨勒",
                    "text": "我们干活的工人最不缺的就是干劲儿，脚踏实地，总能做出点什么的。"
                },
                {
                    "id": "739340104",
                    "speaker": "萨勒",
                    "text": "等我开了店，你来买东西的话，给你打个折扣。"
                }
            ]
        }
    ]
}