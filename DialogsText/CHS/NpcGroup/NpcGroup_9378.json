{
    "groupId": "9378",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "千织": 9
    },
    "talks": [
        {
            "talkId": "6937801",
            "initDialog": "693780101",
            "dialogues": [
                {
                    "id": "693780101",
                    "speaker": "千织",
                    "text": "需要枕头吗？我可以用布料给你搭一个。"
                },
                {
                    "id": "693780102",
                    "speaker": "千织",
                    "text": "想要盖点什么的话，我手边也有柔软程度合适的毯子。"
                },
                {
                    "id": "693780103",
                    "speaker": "千织",
                    "text": "没兴趣吗？那我先午休了。要走了叫我。"
                }
            ]
        },
        {
            "talkId": "6937802",
            "initDialog": "693780201",
            "dialogues": [
                {
                    "id": "693780201",
                    "speaker": "千织",
                    "text": "我见过不少人练习剑道是为了追求更加精湛的武艺。我没这种需要。"
                },
                {
                    "id": "693780202",
                    "speaker": "千织",
                    "text": "我只想捕捉光与刀影的美学，将从战斗中裁剪的灵感全部收纳进我的素材袋。"
                },
                {
                    "id": "693780203",
                    "speaker": "千织",
                    "text": "不用担心，就算我走神了，「袖」也会帮你忙的。"
                }
            ]
        },
        {
            "talkId": "6937803",
            "initDialog": "693780301",
            "dialogues": [
                {
                    "id": "693780301",
                    "speaker": "千织",
                    "text": "这里布置得还不错。看来偶尔尝试在不同风格的环境下工作，是件能改善心情的事。"
                },
                {
                    "id": "693780302",
                    "speaker": "千织",
                    "text": "不过，在我进入工作状态之后，就没那么多精力去注意外界变化了。"
                },
                {
                    "id": "693780303",
                    "speaker": "千织",
                    "text": "有什么事找我的话，凑近点说。明白吗？"
                }
            ]
        }
    ]
}