{
    "groupId": "6412",
    "total_dialogue_lines": 6,
    "speaker_counts": {
        "迷灰中的石碑·其一": 6
    },
    "talks": [
        {
            "talkId": "6641201",
            "initDialog": "664120101",
            "dialogues": [
                {
                    "id": "664120101",
                    "speaker": "迷灰中的石碑·其一",
                    "text": "（遭岁月磨损，字迹模糊的石碑，余留的文字断断续续写着…）"
                },
                {
                    "id": "664120102",
                    "speaker": "迷灰中的石碑·其一",
                    "text": "「…自圣火净化漆黑之大敌后，其余烬…仍如云飘荡。」"
                },
                {
                    "id": "664120103",
                    "speaker": "迷灰中的石碑·其一",
                    "text": "「奥奇卡纳塔…海面的峡谷，此后，流灰覆盖…」"
                },
                {
                    "id": "664120104",
                    "speaker": "迷灰中的石碑·其一",
                    "text": "「湮灭一切色彩，即便是流燃之火亦无法在此处点燃。」"
                },
                {
                    "id": "664120105",
                    "speaker": "迷灰中的石碑·其一",
                    "text": "「即便是『烟谜主』的大祭司亦无法应对失色之灾…」"
                }
            ]
        },
        {
            "talkId": "6641202",
            "initDialog": "664120201",
            "dialogues": [
                {
                    "id": "664120201",
                    "speaker": "迷灰中的石碑·其一",
                    "text": "在失色的领域中…似乎无法阅读上面的文字…"
                }
            ]
        }
    ]
}