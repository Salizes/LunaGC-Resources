{
    "groupId": "4419",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 2,
        "卡格姆尼": 10,
        "库尔苏姆": 7
    },
    "talks": [
        {
            "talkId": "6441801",
            "initDialog": "644180101",
            "dialogues": [
                {
                    "id": "644180101",
                    "speaker": "库尔苏姆",
                    "text": "知道错了吗？"
                },
                {
                    "id": "644180102",
                    "speaker": "卡格姆尼",
                    "text": "我…我知道了…"
                },
                {
                    "id": "644180103",
                    "speaker": "库尔苏姆",
                    "text": "错在哪了？"
                },
                {
                    "id": "644180104",
                    "speaker": "卡格姆尼",
                    "text": "我…我不该相信谣传…"
                },
                {
                    "id": "644180105",
                    "speaker": "库尔苏姆",
                    "text": "还有吗？"
                },
                {
                    "id": "644180106",
                    "speaker": "卡格姆尼",
                    "text": "还有？还有…还有…不该和您的孙子乱讲？"
                },
                {
                    "id": "644180107",
                    "speaker": "库尔苏姆",
                    "text": "虽然确实不对，但这个是重点吗？"
                },
                {
                    "id": "644180108",
                    "speaker": "库尔苏姆",
                    "text": "光知道错了有什么用，更重要的是行动！"
                },
                {
                    "id": "644180109",
                    "speaker": "库尔苏姆",
                    "text": "你就是因为整日无所事事，才会听信那些莫须有的传言！"
                },
                {
                    "id": "644180110",
                    "speaker": "库尔苏姆",
                    "text": "你这么年轻，现在正是学习知识的好时候，也该读点书了。看看人家塞塔蕾！"
                },
                {
                    "id": "644180111",
                    "speaker": "卡格姆尼",
                    "text": "您、您说的对…"
                }
            ]
        },
        {
            "talkId": "6441901",
            "initDialog": "644190101",
            "dialogues": [
                {
                    "id": "644190101",
                    "speaker": "卡格姆尼",
                    "text": "…怎么了，看什么看！"
                },
                {
                    "id": "644190102",
                    "speaker": "卡格姆尼",
                    "text": "瞅你这样子，难道是草神的走狗吗？"
                }
            ]
        },
        {
            "talkId": "6441902",
            "initDialog": "644190201",
            "dialogues": [
                {
                    "id": "644190201",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "644190202",
                    "speaker": "卡格姆尼",
                    "text": "身为沙漠的子民，就应当坚守对赤王的信仰！"
                },
                {
                    "id": "644190203",
                    "speaker": "卡格姆尼",
                    "text": "伟大的赤王终有一天会复活，带领我们这些百折不挠的信徒重现过去的繁荣与辉煌！"
                },
                {
                    "id": "644190204",
                    "speaker": "卡格姆尼",
                    "text": "到时候你们这些背弃了赤王的人，都会遭报应的！"
                }
            ]
        },
        {
            "talkId": "6441903",
            "initDialog": "644190301",
            "dialogues": [
                {
                    "id": "644190301",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "644190302",
                    "speaker": "卡格姆尼",
                    "text": "哼，我就知道！"
                }
            ]
        }
    ]
}