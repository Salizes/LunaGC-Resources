{
    "groupId": "4296",
    "total_dialogue_lines": 102,
    "speaker_counts": {
        "Player": 22,
        "婕德": 80
    },
    "talks": [
        {
            "talkId": "7322054",
            "initDialog": "732205401",
            "dialogues": [
                {
                    "id": "732205401",
                    "speaker": "婕德",
                    "text": "#啊，{NICKNAME}…原来是你，怎么了，有什么事吗？",
                    "choices": [
                        {
                            "id": "732205402",
                            "text": "关于「永恒绿洲」…",
                            "response": [
                                {
                                    "id": "732205403",
                                    "speaker": "婕德",
                                    "text": "这次去「永恒绿洲」，真是多亏有你，如果没有你的话，说不定根本没办法真的打开通往「永恒绿洲」的道路。"
                                },
                                {
                                    "id": "732205404",
                                    "speaker": "婕德",
                                    "text": "我都不知道应该如何感谢你…下次我们再一起点起篝火，坐在篝火边夜谈吧，就像…"
                                },
                                {
                                    "id": "732205405",
                                    "speaker": "婕德",
                                    "text": "就像上次和阿萨里格…啊…"
                                },
                                {
                                    "id": "732205406",
                                    "speaker": "婕德",
                                    "text": "…那个狗东西…"
                                },
                                {
                                    "id": "732205407",
                                    "speaker": "Player",
                                    "text": "抱歉…"
                                },
                                {
                                    "id": "732205408",
                                    "speaker": "婕德",
                                    "text": "没有什么可抱歉的…我没有在生你的气。"
                                },
                                {
                                    "id": "732205409",
                                    "speaker": "婕德",
                                    "text": "主母在我出发前就已经让我提高警惕了。我可能行事草率…噗，也许吧…但我并不傻。"
                                },
                                {
                                    "id": "732205410",
                                    "speaker": "婕德",
                                    "text": "那些古代机械的图纸…他从来没有给族人分享过——这是重罪，从意识到这点起，我就已经生疑了…"
                                },
                                {
                                    "id": "732205411",
                                    "speaker": "婕德",
                                    "text": "但我没想到，他在与我接触的这么长时间里，竟然怀着那样的算计…他自以为能掌控我…"
                                },
                                {
                                    "id": "732205412",
                                    "speaker": "婕德",
                                    "text": "一想到这个我就觉得恶心…"
                                },
                                {
                                    "id": "732205413",
                                    "speaker": "婕德",
                                    "text": "不过还好，还有芭别尔主母始终站在我这边，我相信她一定能让部族重新繁荣…"
                                },
                                {
                                    "id": "732205414",
                                    "speaker": "婕德",
                                    "text": "一定能…嗯。"
                                },
                                {
                                    "id": "732205415",
                                    "speaker": "婕德",
                                    "text": "对了，还有你！还有你是我这边的！",
                                    "choices": [
                                        {
                                            "id": "732205416",
                                            "text": "嗯，我也是婕德人！",
                                            "response": [
                                                {
                                                    "id": "732205417",
                                                    "speaker": "婕德",
                                                    "text": "婕德人是什么啦…好怪，听上去好像派蒙会取的外号哦。"
                                                },
                                                {
                                                    "id": "732205418",
                                                    "speaker": "婕德",
                                                    "text": "#不过，谢谢你，{NICKNAME}…真的很感谢！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732205419",
                                            "text": "如果我和主母起了冲突呢…",
                                            "response": [
                                                {
                                                    "id": "732205420",
                                                    "speaker": "婕德",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "732205421",
                                                    "speaker": "婕德",
                                                    "text": "哈哈，不许开这种玩笑啦，你是塔尼特的贵宾，又迎回了「镇灵之母」，找到了前往「永恒绿洲」的路…"
                                                },
                                                {
                                                    "id": "732205422",
                                                    "speaker": "婕德",
                                                    "text": "我想不到主母会和你起冲突的理由。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732205423",
                            "text": "没什么事…",
                            "response": [
                                {
                                    "id": "732205424",
                                    "speaker": "婕德",
                                    "text": "嗯…有什么需要我帮忙的，要及时和我说。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7322058",
            "initDialog": "732205801",
            "dialogues": [
                {
                    "id": "732205801",
                    "speaker": "婕德",
                    "text": "#…{NICKNAME}，是你啊，你从居尔城回来了？"
                },
                {
                    "id": "732205802",
                    "speaker": "婕德",
                    "text": "嗯…对了，你现在找我，是有什么事吗？呃，最近塔尼特的事情稍微有点多…",
                    "choices": [
                        {
                            "id": "732205803",
                            "text": "关于利露帕尔…",
                            "response": [
                                {
                                    "id": "732205804",
                                    "speaker": "婕德",
                                    "text": "嗯，我听说了，她离开了。回到那个被诅咒的地方去了。"
                                },
                                {
                                    "id": "732205805",
                                    "speaker": "婕德",
                                    "text": "那个家伙，整天一副高高在上的态度惹人不爽，现在可算是安静了…让我松了口气。"
                                },
                                {
                                    "id": "732205806",
                                    "speaker": "婕德",
                                    "text": "不过，她确实帮了我们很多…唔，你说，她在那里会找到什么呢？如果那里什么都没有的话…她也会像我们一样，感到孤独吗？"
                                },
                                {
                                    "id": "732205807",
                                    "speaker": "婕德",
                                    "text": "唉…真可惜没能跟你一起去…"
                                }
                            ]
                        },
                        {
                            "id": "732205808",
                            "text": "塔尼特的事？",
                            "response": [
                                {
                                    "id": "732205809",
                                    "speaker": "婕德",
                                    "text": "啊，不是什么大事，现在也没法跟你说…"
                                },
                                {
                                    "id": "732205810",
                                    "speaker": "婕德",
                                    "text": "大、大概是旅团里的一些事吧，嗯，也许和那群北方人有关，具体的情况我也不是很清楚…"
                                },
                                {
                                    "id": "732205811",
                                    "speaker": "婕德",
                                    "text": "不过…嗯…"
                                },
                                {
                                    "id": "732205812",
                                    "speaker": "婕德",
                                    "text": "不过…！"
                                },
                                {
                                    "id": "732205813",
                                    "speaker": "婕德",
                                    "text": "呃，对不起，我怎么一惊一乍的…我是说，之后假如我…"
                                },
                                {
                                    "id": "732205814",
                                    "speaker": "婕德",
                                    "text": "不，假如、假如你遇到了危险，请你一定相信我！我永远站在你这边。"
                                },
                                {
                                    "id": "732205815",
                                    "speaker": "婕德",
                                    "text": "假如遭遇危险的是我…我也相信，你一定会来帮我，对吧？",
                                    "choices": [
                                        {
                                            "id": "732205816",
                                            "text": "当然。",
                                            "response": [
                                                {
                                                    "id": "732205817",
                                                    "speaker": "婕德",
                                                    "text": "嗯…谢谢。你要…小心坏人。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732205818",
                                            "text": "当然，不过别忘了付账。",
                                            "response": [
                                                {
                                                    "id": "732205819",
                                                    "speaker": "婕德",
                                                    "text": "噗…少拿佣兵那套搪塞我了！"
                                                },
                                                {
                                                    "id": "732205820",
                                                    "speaker": "婕德",
                                                    "text": "不过…你要小心。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732205821",
                            "text": "关于奔奔…",
                            "response": [
                                {
                                    "id": "732205822",
                                    "speaker": "婕德",
                                    "text": "多亏你上次从那些北方人手里拿来的东西，奔奔现在逐渐恢复，看上去可精神了。"
                                },
                                {
                                    "id": "732205823",
                                    "speaker": "婕德",
                                    "text": "跟我们当初遇到它的时候一样…"
                                }
                            ]
                        },
                        {
                            "id": "732205824",
                            "text": "那就等你有空…",
                            "response": [
                                {
                                    "id": "732205825",
                                    "speaker": "婕德",
                                    "text": "嗯，等我稍微闲一点了，我们再聊…"
                                },
                                {
                                    "id": "732205826",
                                    "speaker": "婕德",
                                    "text": "呃，对了…！对了…"
                                },
                                {
                                    "id": "732205827",
                                    "speaker": "婕德",
                                    "text": "没什么…嗯，不管你遇到什么危险，我会站在你这边。所以…请小心。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
