{
    "groupId": "7032",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "卓霍米菈": 7
    },
    "talks": [
        {
            "talkId": "6703201",
            "initDialog": "670320101",
            "dialogues": [
                {
                    "id": "670320101",
                    "speaker": "卓霍米菈",
                    "text": "唉，我现在该怎么办呢？这么多摩拉的话，真是要到下辈子都还不完啦…"
                }
            ]
        },
        {
            "talkId": "6703202",
            "initDialog": "670320201",
            "dialogues": [
                {
                    "id": "670320201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "670320202",
                    "speaker": "卓霍米菈",
                    "text": "说出来不怕你笑话，看这催债单，我怎么不记得我借了那么多钱，一定是别人用我的身份胡乱借债，真不知道是谁干的缺德事！"
                },
                {
                    "id": "670320203",
                    "speaker": "卓霍米菈",
                    "text": "还款日又马上要到了，还不清，根本还不清。"
                },
                {
                    "id": "670320204",
                    "speaker": "卓霍米菈",
                    "text": "还这些莫名其妙的债…和找上门来的债务处理人，选哪个都是烂摊子！"
                }
            ]
        },
        {
            "talkId": "6703203",
            "initDialog": "670320301",
            "dialogues": [
                {
                    "id": "670320301",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "670320302",
                    "speaker": "卓霍米菈",
                    "text": "好的，唉，如果给我一点时间，让我好好做一做决定就好了…"
                }
            ]
        },
        {
            "talkId": "6703204",
            "initDialog": "670320401",
            "dialogues": [
                {
                    "id": "670320401",
                    "speaker": "Player",
                    "text": "要不还是先问清楚吧。"
                },
                {
                    "id": "670320402",
                    "speaker": "卓霍米菈",
                    "text": "嗯？嗯…这是个好办法，但是如果他们直接要我还钱…"
                }
            ]
        },
        {
            "talkId": "6703205",
            "initDialog": "670320501",
            "dialogues": [
                {
                    "id": "670320501",
                    "speaker": "Player",
                    "text": "是不是有什么误会？"
                },
                {
                    "id": "670320502",
                    "speaker": "卓霍米菈",
                    "text": "不可能吧…你看那边那个债务处理人，他好像已经盯着我很久了…"
                }
            ]
        }
    ]
}