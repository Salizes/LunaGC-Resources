{
    "groupId": "9367",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "琳妮特": 9
    },
    "talks": [
        {
            "talkId": "6936701",
            "initDialog": "693670101",
            "dialogues": [
                {
                    "id": "693670101",
                    "speaker": "琳妮特",
                    "text": "休息时间，来一杯茶，所有疲惫都可以烟消云散。"
                },
                {
                    "id": "693670102",
                    "speaker": "琳妮特",
                    "text": "我的茶杯，就藏在这张卡牌背后。"
                },
                {
                    "id": "693670103",
                    "speaker": "琳妮特",
                    "text": "你一直盯着我…是也想来一杯吗？"
                }
            ]
        },
        {
            "talkId": "6936702",
            "initDialog": "693670201",
            "dialogues": [
                {
                    "id": "693670201",
                    "speaker": "琳妮特",
                    "text": "看上去，要深入秘境是一项不小的挑战。"
                },
                {
                    "id": "693670202",
                    "speaker": "琳妮特",
                    "text": "作为助手，我擅长执行已经制定好的计划，尽量不犯错。"
                },
                {
                    "id": "693670203",
                    "speaker": "琳妮特",
                    "text": "#{NICKNAME}，你的演出计划制定好了吗？"
                }
            ]
        },
        {
            "talkId": "6936703",
            "initDialog": "693670301",
            "dialogues": [
                {
                    "id": "693670301",
                    "speaker": "琳妮特",
                    "text": "在这个地方，故事应该是一种很珍贵的东西吧？"
                },
                {
                    "id": "693670302",
                    "speaker": "琳妮特",
                    "text": "但在我的记忆里，大多数故事都是大人们编造而成的谎言。"
                },
                {
                    "id": "693670303",
                    "speaker": "琳妮特",
                    "text": "我总会认真听他们讲完。毕竟，过于敏锐的孩子并不讨喜呢。"
                }
            ]
        }
    ]
}