{
    "groupId": "1644",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "海伦": 16
    },
    "talks": [
        {
            "talkId": "6164401",
            "initDialog": "616440101",
            "dialogues": [
                {
                    "id": "616440101",
                    "speaker": "海伦",
                    "text": "嗯，咳咳…"
                },
                {
                    "id": "616440102",
                    "speaker": "海伦",
                    "text": "…嗯？你有事吗？我正想开始弹唱呢，可别耽误我守护蒙德。"
                }
            ]
        },
        {
            "talkId": "6164402",
            "initDialog": "616440201",
            "dialogues": [
                {
                    "id": "616440201",
                    "speaker": "Player",
                    "text": "在这么高的地方弹唱？"
                },
                {
                    "id": "616440202",
                    "speaker": "海伦",
                    "text": "对啊，站得越高，声音也就传得越远，这难道不是常识吗？"
                },
                {
                    "id": "616440203",
                    "speaker": "海伦",
                    "text": "所以只要我站在高处，那全城的人不都可以听到我的歌声了吗。"
                },
                {
                    "id": "616440204",
                    "speaker": "海伦",
                    "text": "…其实我本来想到巴巴托斯的神像上弹唱来着，不过被修女们制止了，还说要是再想这么干就把我抓到骑士团…"
                }
            ]
        },
        {
            "talkId": "6164403",
            "initDialog": "616440301",
            "dialogues": [
                {
                    "id": "616440301",
                    "speaker": "Player",
                    "text": "守护蒙德？"
                },
                {
                    "id": "616440302",
                    "speaker": "海伦",
                    "text": "那当然了！自从我在这里开始弹唱之后，蒙德可以说是风调雨顺，所以这难道不是我的功劳吗？"
                },
                {
                    "id": "616440303",
                    "speaker": "海伦",
                    "text": "说不定，我其实就是被巴巴托斯大人眷顾的吟游诗人呢，嘿嘿…"
                },
                {
                    "id": "616440304",
                    "speaker": "海伦",
                    "text": "…假如巴巴托斯大人也是吟游诗人的话，说不定我们的才能也是不相上下吧！"
                }
            ]
        },
        {
            "talkId": "6164404",
            "initDialog": "616440401",
            "dialogues": [
                {
                    "id": "616440401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616440402",
                    "speaker": "海伦",
                    "text": "愿蒙德的风…还有我的歌声护佑你！"
                }
            ]
        },
        {
            "talkId": "6164405",
            "initDialog": "616440501",
            "dialogues": [
                {
                    "id": "616440501",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "616440502",
                    "speaker": "海伦",
                    "text": "哦~是在找人呀，你突然这么问，我也没什么线索…"
                },
                {
                    "id": "616440503",
                    "speaker": "海伦",
                    "text": "不过你的模样我记住了，以后每次我在高处演奏的时候，都会帮你留意你要找的人的。"
                },
                {
                    "id": "616440504",
                    "speaker": "海伦",
                    "text": "站得高的另一个好处，就是看的远呀。"
                }
            ]
        },
        {
            "talkId": "6164406",
            "initDialog": "616440305",
            "dialogues": [
                {
                    "id": "616440305",
                    "speaker": "Player",
                    "text": "那风魔龙出现时你在哪里呢？"
                },
                {
                    "id": "616440306",
                    "speaker": "海伦",
                    "text": "呃…这个…那什么，风魔龙啊，我当时在…"
                },
                {
                    "id": "616440307",
                    "speaker": "海伦",
                    "text": "对了，我当时在家里不停地弹唱，没过多久风就停了。"
                },
                {
                    "id": "616440308",
                    "speaker": "海伦",
                    "text": "所以在我的歌声面前，风魔龙也就不过如此而已吧？"
                },
                {
                    "id": "616440309",
                    "speaker": "海伦",
                    "text": "…对了，我刚才要唱哪段来着？都怪你，我都忘词了…"
                }
            ]
        }
    ]
}