{
    "groupId": "1583",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "哈里": 18
    },
    "talks": [
        {
            "talkId": "7051604",
            "initDialog": "705160401",
            "dialogues": [
                {
                    "id": "705160401",
                    "speaker": "哈里",
                    "text": "你好！"
                },
                {
                    "id": "705160402",
                    "speaker": "哈里",
                    "text": "我是西风骑士团的哈里。奉骑士团的命令派驻到此地，负责劝导民众远离危险区域。"
                },
                {
                    "id": "705160403",
                    "speaker": "哈里",
                    "text": "骑士团接到报告，望风山地一带有危险的魔物出没。"
                },
                {
                    "id": "705160404",
                    "speaker": "哈里",
                    "text": "目前尚不确定魔物的行踪，骑士团正派人排查。"
                },
                {
                    "id": "705160405",
                    "speaker": "Player",
                    "text": "好像没有看见其他骑士…"
                },
                {
                    "id": "705160406",
                    "speaker": "哈里",
                    "text": "在没有确定魔物的位置前，大规模行动容易打草惊蛇。"
                },
                {
                    "id": "705160407",
                    "speaker": "哈里",
                    "text": "所以负责搜索的骑士会以小规模分队行动，低调隐蔽，远离路过的民众。"
                },
                {
                    "id": "705160408",
                    "speaker": "哈里",
                    "text": "无论如何，请你与望风山地保持距离，远离危险。"
                }
            ]
        },
        {
            "talkId": "7093301",
            "initDialog": "709330101",
            "dialogues": [
                {
                    "id": "709330101",
                    "speaker": "Player",
                    "text": "一般会怎么帮助？"
                },
                {
                    "id": "709330102",
                    "speaker": "哈里",
                    "text": "唔，如果是普通的蒙德市民的话，我会负责护送到蒙德城或清泉镇…"
                },
                {
                    "id": "709330103",
                    "speaker": "哈里",
                    "text": "如果是冒险家之类的有自保能力的人的话，我会提供一些武器来防身。"
                },
                {
                    "id": "709330104",
                    "speaker": "哈里",
                    "text": "看你的样子更像是后者啊，那就请收下这把剑吧，务必多加小心。"
                }
            ]
        },
        {
            "talkId": "6158301",
            "initDialog": "615830101",
            "dialogues": [
                {
                    "id": "615830101",
                    "speaker": "哈里",
                    "text": "哟！你好！"
                },
                {
                    "id": "615830102",
                    "speaker": "哈里",
                    "text": "有什么需要帮忙的吗？"
                }
            ]
        },
        {
            "talkId": "6158302",
            "initDialog": "615830201",
            "dialogues": [
                {
                    "id": "615830201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615830202",
                    "speaker": "哈里",
                    "text": "我是西风骑士团的哈里。"
                },
                {
                    "id": "615830203",
                    "speaker": "哈里",
                    "text": "奉骑士团的命令派驻到此地，负责帮助受到袭击的人。"
                }
            ]
        },
        {
            "talkId": "6158303",
            "initDialog": "615830301",
            "dialogues": [
                {
                    "id": "615830301",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "615830302",
                    "speaker": "哈里",
                    "text": "我在沿途收集路上怪物的分布情况，这也是为了保障商路的安全！"
                },
                {
                    "id": "615830303",
                    "speaker": "哈里",
                    "text": "如果情况严重，有了这些情报，也能说服代理团长对望风山地进行大清剿！"
                },
                {
                    "id": "615830304",
                    "speaker": "哈里",
                    "text": "唔…就跟当年大团长一样！"
                }
            ]
        },
        {
            "talkId": "6158304",
            "initDialog": "615830401",
            "dialogues": [
                {
                    "id": "615830401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615830402",
                    "speaker": "哈里",
                    "text": "哎？这就要走了吗？"
                }
            ]
        }
    ]
}