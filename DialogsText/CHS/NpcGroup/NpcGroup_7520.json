{
    "groupId": "7520",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "扎列切纳娅": 8
    },
    "talks": [
        {
            "talkId": "6752001",
            "initDialog": "675200101",
            "dialogues": [
                {
                    "id": "675200101",
                    "speaker": "扎列切纳娅",
                    "text": "奇怪的地方，文件倒是齐全，可是总觉得有什么不对…算了。"
                }
            ]
        },
        {
            "talkId": "6752002",
            "initDialog": "675200201",
            "dialogues": [
                {
                    "id": "675200201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "675200202",
                    "speaker": "扎列切纳娅",
                    "text": "我是「至冬皇家能源协会」的会长…不过只是至冬宫临时下派管理的代理会长…"
                },
                {
                    "id": "675200203",
                    "speaker": "扎列切纳娅",
                    "text": "据说老会长在不久前因急病去世，而能源协会又关系到整个至冬的民生，总不能让这个岗位空悬着，所以派了我来。"
                },
                {
                    "id": "675200204",
                    "speaker": "扎列切纳娅",
                    "text": "希望他们能快点找到个人来当这个能源协会的正式会长，这样我也好回宫中复命了。"
                }
            ]
        },
        {
            "talkId": "6752003",
            "initDialog": "675200301",
            "dialogues": [
                {
                    "id": "675200301",
                    "speaker": "Player",
                    "text": "有什么不对？"
                },
                {
                    "id": "675200302",
                    "speaker": "扎列切纳娅",
                    "text": "…可能是我的错觉吧，前任会长去世，我空降来了这个能源协会，交接文档也没有问题。"
                },
                {
                    "id": "675200303",
                    "speaker": "扎列切纳娅",
                    "text": "但总觉得能源协会的一些事被很巧妙地「藏」了起来…比如什么第二本账本或者贪污的证据…"
                },
                {
                    "id": "675200304",
                    "speaker": "扎列切纳娅",
                    "text": "哈哈，不过都是我瞎猜的，就算真的有也和我没什么关系，能源协会继续运作对我来说才比较有意义。"
                }
            ]
        },
        {
            "talkId": "6752004",
            "initDialog": "675200401",
            "dialogues": [
                {
                    "id": "675200401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675200402",
                    "speaker": "扎列切纳娅",
                    "text": "…再见！我看看…今天要看的文件在哪…"
                }
            ]
        }
    ]
}