{
    "groupId": "6427",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "奇皮茨": 11
    },
    "talks": [
        {
            "talkId": "6642701",
            "initDialog": "664270101",
            "dialogues": [
                {
                    "id": "664270101",
                    "speaker": "奇皮茨",
                    "text": "咳咳…下次一定要让她看到我帅气的样子！"
                }
            ]
        },
        {
            "talkId": "6642702",
            "initDialog": "664270201",
            "dialogues": [
                {
                    "id": "664270201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "664270202",
                    "speaker": "奇皮茨",
                    "text": "哼哼，我是奇皮茨！沃陆之邦未来最强的摔角手！当然现在也很强啦！"
                },
                {
                    "id": "664270203",
                    "speaker": "奇皮茨",
                    "text": "你有没有看到那边的小突角龙？它刚才想把我撞翻，但我抓住它的腿，咻一下子就把它撂倒啦！"
                },
                {
                    "id": "664270204",
                    "speaker": "奇皮茨",
                    "text": "没、没开玩笑！是真的！等我再长大一点，我就要像万杰鲁大人那样，和巨龙摔角！现在那些大块头的战士们，没人会是我的对手！"
                }
            ]
        },
        {
            "talkId": "6642703",
            "initDialog": "664270301",
            "dialogues": [
                {
                    "id": "664270301",
                    "speaker": "Player",
                    "text": "你不去参加训练吗？"
                },
                {
                    "id": "664270302",
                    "speaker": "奇皮茨",
                    "text": "训练？哼，那些也太无聊了！整天就是举重啊跑圈啊，谁要学那个！"
                },
                {
                    "id": "664270303",
                    "speaker": "奇皮茨",
                    "text": "真正厉害的战士，就是要依靠力量和技巧取胜！你看，我现在就能和突角龙…呃，小突角龙过招，说明我比那些只会跑圈的强多了！"
                },
                {
                    "id": "664270304",
                    "speaker": "奇皮茨",
                    "text": "再、再说了…娜帕也从来不去训练场，要是她遇到危险怎么办？作为未来最强的战士，我得保护好她才行！"
                }
            ]
        },
        {
            "talkId": "6642704",
            "initDialog": "664270401",
            "dialogues": [
                {
                    "id": "664270401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664270402",
                    "speaker": "奇皮茨",
                    "text": "喔，再见啦！下次见面的时候，我还会比现在更强的！"
                }
            ]
        },
        {
            "talkId": "6642705",
            "initDialog": "664270501",
            "dialogues": [
                {
                    "id": "664270501",
                    "speaker": "奇皮茨",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6642706",
            "initDialog": "664270601",
            "dialogues": [
                {
                    "id": "664270601",
                    "speaker": "奇皮茨",
                    "text": "哼哼，不愧是我！"
                }
            ]
        },
        {
            "talkId": "6642707",
            "initDialog": "664270701",
            "dialogues": [
                {
                    "id": "664270701",
                    "speaker": "奇皮茨",
                    "text": "我输了？可恶！我下次一定会更强的！"
                }
            ]
        }
    ]
}