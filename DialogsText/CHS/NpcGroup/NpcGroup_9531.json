    "talks": [
        {
            "talkId": "6953101",
            "initDialog": "695310101",
            "dialogues": [
                {
                    "id": "695310101",
                    "speaker": "神里绫人",
                    "text": "呵呵，注意到我了吗？没错，你没眼花。"
                }
            ]
        },
        {
            "talkId": "6953102",
            "initDialog": "695310201",
            "dialogues": [
                {
                    "id": "695310201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953103",
            "initDialog": "695310301",
            "dialogues": [
                {
                    "id": "695310301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695310302",
                    "speaker": "神里绫人",
                    "text": "那就再会吧。我也差不多该回去处理公务了，顺便还能欣赏一下家臣们着急的表情。"
                }
            ]
        },
        {
            "talkId": "6953104",
            "initDialog": "695310401",
            "dialogues": [
                {
                    "id": "695310401",
                    "speaker": "神里绫人",
                    "text": "我虽稍胜一筹，但你也不必灰心。想再来一局的话，随时和我说。"
                }
            ]
        },
        {
            "talkId": "6953105",
            "initDialog": "695310501",
            "dialogues": [
                {
                    "id": "695310501",
                    "speaker": "神里绫人",
                    "text": "看来在这牌局的算计上，还是你棋高一着。"
                }
            ]
        },
        {
            "talkId": "6953106",
            "initDialog": "695310601",
            "dialogues": [
                {
                    "id": "695310601",
                    "speaker": "神里绫人",
                    "text": "那就让我看看你的本领吧。"
                }
            ]
        },
        {
            "talkId": "6953108",
            "initDialog": "695310801",
            "dialogues": [
                {
                    "id": "695310801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953109",
            "initDialog": "695310901",
            "dialogues": [
                {
                    "id": "695310901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6953110",
            "initDialog": "695311001",
            "dialogues": [
                {
                    "id": "695311001",
                    "speaker": "神里绫人",
                    "text": "与你对局，比处理公务有趣多了。"
                }
            ]
        },
        {
            "talkId": "6953111",
            "initDialog": "695311101",
            "dialogues": [
                {
                    "id": "695311101",
                    "speaker": "神里绫人",
                    "text": "哎呀…在细微之处，略逊一筹了。"
                }
            ]
        },
        {
            "talkId": "6953112",
            "initDialog": "695311201",
            "dialogues": [
                {
                    "id": "695311201",
                    "speaker": "神里绫人",
                    "text": "「七圣召唤」我并不常玩，但你也不必手下留情。"
                }
            ]
        },
        {
            "talkId": "6953114",
            "initDialog": "695311401",
            "dialogues": [
                {
                    "id": "695311401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953115",
            "initDialog": "695311501",
            "dialogues": [
                {
                    "id": "695311501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6953116",
            "initDialog": "695311601",
            "dialogues": [
                {
                    "id": "695311601",
                    "speaker": "神里绫人",
                    "text": "嗯，这牌桌上的玩乐与时局博弈倒是有相通之处。"
                }
            ]
        },
        {
            "talkId": "6953117",
            "initDialog": "695311701",
            "dialogues": [
                {
                    "id": "695311701",
                    "speaker": "神里绫人",
                    "text": "哦？倒是没料到你有这么一手，但同时也证明我的眼光从未出错。"
                }
            ]
        },
        {
            "talkId": "6953118",
            "initDialog": "695311801",
            "dialogues": [
                {
                    "id": "695311801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}