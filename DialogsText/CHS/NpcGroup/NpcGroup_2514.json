{
    "groupId": "2514",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "泊溯": 12
    },
    "talks": [
        {
            "talkId": "6251401",
            "initDialog": "625140101",
            "dialogues": [
                {
                    "id": "625140101",
                    "speaker": "泊溯",
                    "text": "你好啊，游客，你是来搭船的？"
                }
            ]
        },
        {
            "talkId": "6251402",
            "initDialog": "625140201",
            "dialogues": [
                {
                    "id": "625140201",
                    "speaker": "Player",
                    "text": "你在念什么呢？"
                },
                {
                    "id": "625140202",
                    "speaker": "泊溯",
                    "text": "是沉玉谷民间的诗，每位船夫都会念几句…"
                },
                {
                    "id": "625140203",
                    "speaker": "泊溯",
                    "text": "这首简单易懂，还有一首更为风雅——"
                },
                {
                    "id": "625140204",
                    "speaker": "泊溯",
                    "text": "「…幽谷涟涟泉响圜，灵龛先出东北岸，幽峦岸峻藏西南…」"
                },
                {
                    "id": "625140205",
                    "speaker": "泊溯",
                    "text": "等你乘这竹筏去遗珑埠时，我且唱与你听。"
                }
            ]
        },
        {
            "talkId": "6251403",
            "initDialog": "625140301",
            "dialogues": [
                {
                    "id": "625140301",
                    "speaker": "Player",
                    "text": "这船很有特色。"
                },
                {
                    "id": "625140302",
                    "speaker": "泊溯",
                    "text": "你挺有眼光！"
                },
                {
                    "id": "625140303",
                    "speaker": "泊溯",
                    "text": "这沉玉谷水浅弯多，大船进来容易搁浅。"
                },
                {
                    "id": "625140304",
                    "speaker": "泊溯",
                    "text": "咱这小竹筏就不一样，重量轻吃水浅，不管什么急弯暗礁，都挡不住咱们。"
                },
                {
                    "id": "625140305",
                    "speaker": "泊溯",
                    "text": "当然，更重要的是，这沉玉谷的山水风光，就得乘着竹筏慢慢漂，细细赏…"
                }
            ]
        },
        {
            "talkId": "6251404",
            "initDialog": "625140401",
            "dialogues": [
                {
                    "id": "625140401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "625140402",
                    "speaker": "泊溯",
                    "text": "有缘再见，一路顺风！"
                }
            ]
        },
        {
            "talkId": "6251405",
            "initDialog": "625140501",
            "dialogues": [
                {
                    "id": "625140501",
                    "speaker": "泊溯",
                    "text": "#好嘞，咱们到岸咯！{M#小兄弟}{F#小姑娘}，一路顺风！"
                }
            ]
        },
        {
            "talkId": "7112302",
            "initDialog": "711230201",
            "dialogues": [
                {
                    "id": "711230201",
                    "speaker": "Player",
                    "text": "乘坐竹筏前往遗珑埠"
                },
                {
                    "id": "711230202",
                    "speaker": "泊溯",
                    "text": "好！还请坐好，咱们这就出发。"
                }
            ]
        }
    ]
}