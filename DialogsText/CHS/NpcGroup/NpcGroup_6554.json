{
    "groupId": "6554",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "乌哈纳": 13
    },
    "talks": [
        {
            "talkId": "1504380",
            "initDialog": "150438001",
            "dialogues": [
                {
                    "id": "150438001",
                    "speaker": "乌哈纳",
                    "text": "非常抱歉，尊敬的游客，目前提提岛的场地仍在施工阶段，暂不对外开放。"
                },
                {
                    "id": "150438002",
                    "speaker": "乌哈纳",
                    "text": "推荐您和您的同伴先去彩彩崖、刺梨岩或浪浪湾区域进行游玩。"
                },
                {
                    "id": "150438003",
                    "speaker": "乌哈纳",
                    "text": "请放心，提提岛竣工后，我们的工作人员一定会在第一时间通知到您…祝您度假愉快！"
                }
            ]
        },
        {
            "talkId": "6655401",
            "initDialog": "665540101",
            "dialogues": [
                {
                    "id": "665540101",
                    "speaker": "乌哈纳",
                    "text": "朋友！欢迎来到梦中的帕依提提！嗝…！",
                    "choices": [
                        {
                            "id": "665540102",
                            "text": "帕依提提是什么？",
                            "response": [
                                {
                                    "id": "665540103",
                                    "speaker": "乌哈纳",
                                    "text": "帕依提提就是提提岛，提提岛就是帕依提提！嗝…！"
                                },
                                {
                                    "id": "665540104",
                                    "speaker": "乌哈纳",
                                    "text": "所以说啊，提提岛上埋藏的宝藏，就是神秘黄金国帕依提提的宝藏啦…"
                                },
                                {
                                    "id": "665540105",
                                    "speaker": "乌哈纳",
                                    "text": "这件事我就告诉你了你一个哦！嗝…！"
                                },
                                {
                                    "id": "665540106",
                                    "speaker": "Player",
                                    "text": "岛上真的有宝藏吗？"
                                },
                                {
                                    "id": "665540107",
                                    "speaker": "乌哈纳",
                                    "text": "嘿嘿，我不会骗你的，真的有，因为其实是度假村官方埋的啦。"
                                },
                                {
                                    "id": "665540108",
                                    "speaker": "乌哈纳",
                                    "text": "虽说是为了吸引客人的噱头，但也是实实在在的宝藏哦，就看哪位幸运游客能找到了。"
                                },
                                {
                                    "id": "665540109",
                                    "speaker": "Player",
                                    "text": "能告诉我在哪里吗？"
                                },
                                {
                                    "id": "665540110",
                                    "speaker": "乌哈纳",
                                    "text": "哎呀，你干嘛这样看着我啦，真是的。"
                                },
                                {
                                    "id": "665540111",
                                    "speaker": "乌哈纳",
                                    "text": "好吧好吧，你这种小鹿一样的眼神我真是受不了，那我也就只告诉你一个哦！"
                                },
                                {
                                    "id": "665540112",
                                    "speaker": "乌哈纳",
                                    "text": "在提提岛的北边，总之你在北边找就对了。嗝…！"
                                }
                            ]
                        },
                        {
                            "id": "665540213",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "665540214",
                                    "speaker": "乌哈纳",
                                    "text": "再见。嗝…！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}