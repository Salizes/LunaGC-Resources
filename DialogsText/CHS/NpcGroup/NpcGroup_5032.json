{
    "groupId": "5032",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "诺莱特": 10
    },
    "talks": [
        {
            "talkId": "6503201",
            "initDialog": "650320101",
            "dialogues": [
                {
                    "id": "650320101",
                    "speaker": "诺莱特",
                    "text": "呼…呼…今天再走个几小时吧…"
                }
            ]
        },
        {
            "talkId": "6503202",
            "initDialog": "650320201",
            "dialogues": [
                {
                    "id": "650320201",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "650320202",
                    "speaker": "诺莱特",
                    "text": "帮忙？那哪像话？怎么说也得是我帮您的忙，我可是沫芒宫的警备队员，退休的队员…"
                },
                {
                    "id": "650320203",
                    "speaker": "诺莱特",
                    "text": "虽说退休，但我身体还好着呢，如果现在有个小偷从我面前跑过，我保准能追上他！"
                }
            ]
        },
        {
            "talkId": "6503203",
            "initDialog": "650320301",
            "dialogues": [
                {
                    "id": "650320301",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "650320302",
                    "speaker": "诺莱特",
                    "text": "好啊，当然好。前不久还帮忙破了个案子呢。这算是…宝刀未老？"
                }
            ]
        },
        {
            "talkId": "6503204",
            "initDialog": "650320401",
            "dialogues": [
                {
                    "id": "650320401",
                    "speaker": "Player",
                    "text": "你先好好休息。"
                },
                {
                    "id": "650320402",
                    "speaker": "诺莱特",
                    "text": "哼…再走十小时都不在话下…"
                }
            ]
        },
        {
            "talkId": "6503205",
            "initDialog": "650320501",
            "dialogues": [
                {
                    "id": "650320501",
                    "speaker": "Player",
                    "text": "什么样的案子？"
                },
                {
                    "id": "650320502",
                    "speaker": "诺莱特",
                    "text": "唉…其实前阵子我在广场上看到有摄影师在做生意，就去拍了一张画片。"
                },
                {
                    "id": "650320503",
                    "speaker": "诺莱特",
                    "text": "结果逛着逛着到了晚饭时间，准备买吃的时发现有人在摸我的钱包！但很可惜，那小子跑太快了，我、我没跟上…"
                },
                {
                    "id": "650320504",
                    "speaker": "诺莱特",
                    "text": "没想到第二天有个后辈找到我，说钱包追回来了，还因为里面的那张画片破了个大案！"
                },
                {
                    "id": "650320505",
                    "speaker": "诺莱特",
                    "text": "唉，真是惭愧，我其实没能帮上什么忙…要是我腿脚再快些，当时就追上他的话…"
                },
                {
                    "id": "650320506",
                    "speaker": "诺莱特",
                    "text": "咳咳，放心吧，我身子骨还硬朗着呢。下次一定能追上…"
                }
            ]
        }
    ]
}