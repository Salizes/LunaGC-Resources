{
    "groupId": "4064",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "阿兹拉": 9
    },
    "talks": [
        {
            "talkId": "6406401",
            "initDialog": "640640101",
            "dialogues": [
                {
                    "id": "640640101",
                    "speaker": "阿兹拉",
                    "text": "什么时候才能再看到妮露的演出呢？"
                }
            ]
        },
        {
            "talkId": "6406402",
            "initDialog": "640640201",
            "dialogues": [
                {
                    "id": "640640201",
                    "speaker": "Player",
                    "text": "关于妮露…"
                },
                {
                    "id": "640640202",
                    "speaker": "阿兹拉",
                    "text": "听我说，祖拜尔剧场的妮露小姐，是最棒的舞者。"
                },
                {
                    "id": "640640203",
                    "speaker": "阿兹拉",
                    "text": "也许很多人都能跳出动作美丽的舞蹈，但妮露小姐在舞蹈中融入的那种饱满的情绪，却是独一无二的。"
                },
                {
                    "id": "640640204",
                    "speaker": "阿兹拉",
                    "text": "看了她的舞蹈之后，我要很久很久之后才能从沉浸中脱离出来…那种感觉，真是…"
                }
            ]
        },
        {
            "talkId": "6406403",
            "initDialog": "640640301",
            "dialogues": [
                {
                    "id": "640640301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640640302",
                    "speaker": "阿兹拉",
                    "text": "唉，为什么教令院不喜欢剧场呢…"
                }
            ]
        },
        {
            "talkId": "6406404",
            "initDialog": "640640401",
            "dialogues": [
                {
                    "id": "640640401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640640402",
                    "speaker": "阿兹拉",
                    "text": "艺术禁令已经废除了，应该能看到更多演出了吧…"
                }
            ]
        },
        {
            "talkId": "7393801",
            "initDialog": "739380101",
            "dialogues": [
                {
                    "id": "739380101",
                    "speaker": "Player",
                    "text": "那种感觉？"
                },
                {
                    "id": "739380102",
                    "speaker": "阿兹拉",
                    "text": "就像…就像水一样！"
                },
                {
                    "id": "739380103",
                    "speaker": "阿兹拉",
                    "text": "澄净的水，可以被塑成各种的样子，可以沸腾，也可以冰冻…"
                },
                {
                    "id": "739380104",
                    "speaker": "阿兹拉",
                    "text": "唉，要不是我奉命在此守卫无法离开，真想每天都去观看她的表演啊。"
                }
            ]
        }
    ]
}