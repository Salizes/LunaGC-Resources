    "talks": [
        {
            "talkId": "6956901",
            "initDialog": "695690101",
            "dialogues": [
                {
                    "id": "695690101",
                    "speaker": "云堇",
                    "text": "这酒馆里好生热闹，就像是连演着大戏似的，唔…如果现在能有一碗茶润润喉嗓就更好了。"
                }
            ]
        },
        {
            "talkId": "6956902",
            "initDialog": "695690201",
            "dialogues": [
                {
                    "id": "695690201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956903",
            "initDialog": "695690301",
            "dialogues": [
                {
                    "id": "695690301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695690302",
                    "speaker": "云堇",
                    "text": "我还要再歇一歇，稍后再启程回去。"
                }
            ]
        },
        {
            "talkId": "6956904",
            "initDialog": "695690401",
            "dialogues": [
                {
                    "id": "695690401",
                    "speaker": "云堇",
                    "text": "我略胜了几手。但胜败皆是常事，再来一局，我也未尝能赢。"
                }
            ]
        },
        {
            "talkId": "6956905",
            "initDialog": "695690501",
            "dialogues": [
                {
                    "id": "695690501",
                    "speaker": "云堇",
                    "text": "这一局我败得心服口服…你对这牌戏真是理解颇深。"
                }
            ]
        },
        {
            "talkId": "6956906",
            "initDialog": "695690601",
            "dialogues": [
                {
                    "id": "695690601",
                    "speaker": "云堇",
                    "text": "刚好清闲，正巧与你切磋。"
                }
            ]
        },
        {
            "talkId": "6956908",
            "initDialog": "695690801",
            "dialogues": [
                {
                    "id": "695690801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956909",
            "initDialog": "695690901",
            "dialogues": [
                {
                    "id": "695690901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956910",
            "initDialog": "695691001",
            "dialogues": [
                {
                    "id": "695691001",
                    "speaker": "云堇",
                    "text": "虽是牌桌交锋，但气势却正如两军对垒，实在是一场好局。"
                }
            ]
        },
        {
            "talkId": "6956911",
            "initDialog": "695691101",
            "dialogues": [
                {
                    "id": "695691101",
                    "speaker": "云堇",
                    "text": "误走一步，整戏皆错…真是大意了。"
                }
            ]
        },
        {
            "talkId": "6956912",
            "initDialog": "695691201",
            "dialogues": [
                {
                    "id": "695691201",
                    "speaker": "云堇",
                    "text": "既是你邀请，那我怎么有不应之理？"
                }
            ]
        },
        {
            "talkId": "6956914",
            "initDialog": "695691401",
            "dialogues": [
                {
                    "id": "695691401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956915",
            "initDialog": "695691501",
            "dialogues": [
                {
                    "id": "695691501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956916",
            "initDialog": "695691601",
            "dialogues": [
                {
                    "id": "695691601",
                    "speaker": "云堇",
                    "text": "呼…这一局我赢得实在惊险。"
                }
            ]
        },
        {
            "talkId": "6956917",
            "initDialog": "695691701",
            "dialogues": [
                {
                    "id": "695691701",
                    "speaker": "云堇",
                    "text": "我果然还是少思虑了几重…输得应该。"
                }
            ]
        },
        {
            "talkId": "6956918",
            "initDialog": "695691801",
            "dialogues": [
                {
                    "id": "695691801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
