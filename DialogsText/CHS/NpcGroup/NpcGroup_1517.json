{
    "groupId": "1517",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Player": 13,
        "维克多": 46
    },
    "talks": [
        {
            "talkId": "6151706",
            "initDialog": "615170601",
            "dialogues": [
                {
                    "id": "615170601",
                    "speaker": "维克多",
                    "text": "唉，算了，就这么凑合过吧…"
                }
            ]
        },
        {
            "talkId": "6151707",
            "initDialog": "615170701",
            "dialogues": [
                {
                    "id": "615170701",
                    "speaker": "Player",
                    "text": "在须弥生活还习惯吗？"
                },
                {
                    "id": "615170702",
                    "speaker": "维克多",
                    "text": "不习惯也得学着习惯啊…毕竟我都被派来驻扎在这里了，抱怨不会解决任何问题。"
                },
                {
                    "id": "615170703",
                    "speaker": "维克多",
                    "text": "唉，真不知道弗谢沃洛德先生是怎么保持住工作热情的。"
                }
            ]
        },
        {
            "talkId": "6151708",
            "initDialog": "615170801",
            "dialogues": [
                {
                    "id": "615170801",
                    "speaker": "Player",
                    "text": "想回蒙德吗？"
                },
                {
                    "id": "615170802",
                    "speaker": "维克多",
                    "text": "别！我可不想回去！"
                },
                {
                    "id": "615170803",
                    "speaker": "维克多",
                    "text": "虽然我现在还没习惯须弥，但待在这里，总比待在那个教堂里一直吃修女的白眼好。"
                },
                {
                    "id": "615170804",
                    "speaker": "维克多",
                    "text": "不过，也不知道莉莉那孩子现在过得怎么样…"
                }
            ]
        },
        {
            "talkId": "6151709",
            "initDialog": "615170901",
            "dialogues": [
                {
                    "id": "615170901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615170902",
                    "speaker": "维克多",
                    "text": "你忙你的去吧，我也要去工作了。"
                },
                {
                    "id": "615170903",
                    "speaker": "维克多",
                    "text": "唉，我怎么就被派来这里了呢…"
                }
            ]
        },
        {
            "talkId": "6151710",
            "initDialog": "615171001",
            "dialogues": [
                {
                    "id": "615171001",
                    "speaker": "Player",
                    "text": "我帮你给她送个信？"
                },
                {
                    "id": "615171002",
                    "speaker": "维克多",
                    "text": "你愿意帮忙？呃…"
                },
                {
                    "id": "615171003",
                    "speaker": "维克多",
                    "text": "算了，不用了，不用了。"
                },
                {
                    "id": "615171004",
                    "speaker": "维克多",
                    "text": "我一个愚人众，还是别给那孩子寄信了，说不定又会惹出一些乱七八糟的麻烦…"
                }
            ]
        },
        {
            "talkId": "7081001",
            "initDialog": "708100101",
            "dialogues": [
                {
                    "id": "708100101",
                    "speaker": "维克多",
                    "text": "旅行者，又见面了，有空的话，来帮我个忙怎么样？报酬绝不会亏你的。",
                    "choices": [
                        {
                            "id": "708100102",
                            "text": "你们怎么还在蒙德城里？",
                            "response": [
                                {
                                    "id": "708100103",
                                    "speaker": "维克多",
                                    "text": "你这话说的，我又没有做什么，我在这里呆着怎么了？"
                                },
                                {
                                    "id": "708100104",
                                    "speaker": "维克多",
                                    "text": "啊？你说歌德大酒店里面的那些先生？那…我就不知道了，那不在我的职权范围内。"
                                },
                                {
                                    "id": "708100107",
                                    "speaker": "维克多",
                                    "text": "行了行了，说正事，你们蒙德的人就喜欢啰啰嗦嗦，做事也拖拖拉拉的…"
                                },
                                {
                                    "id": "708100108",
                                    "speaker": "维克多",
                                    "text": "上次我俩的交易你还记得吧？你帮我办事，我给你讲点你想要的情报。"
                                },
                                {
                                    "id": "708100109",
                                    "speaker": "维克多",
                                    "text": "这次也一样，你去帮我置办点蒙德城的特产回来，我再给你讲点「小故事」，怎么样？",
                                    "choices": [
                                        {
                                            "id": "708100110",
                                            "text": "什么样的「小故事」？",
                                            "response": [
                                                {
                                                    "id": "708100111",
                                                    "speaker": "维克多",
                                                    "text": "哼，你帮我去把东西置办好了，我再告诉你…反正不会让你吃亏的。"
                                                },
                                                {
                                                    "id": "708100112",
                                                    "speaker": "维克多",
                                                    "text": "你就放心吧，咱们愚人众说到做到。"
                                                },
                                                {
                                                    "id": "708100119",
                                                    "speaker": "维克多",
                                                    "text": "好了好了，这件事就拜托你了啊，快点去吧，我就在教堂里面等着你。"
                                                },
                                                {
                                                    "id": "708100120",
                                                    "speaker": "维克多",
                                                    "text": "唉，就想买点东西，搞得和我是要去犯罪一样，真是…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "708100113",
                                            "text": "你买特产干什么？",
                                            "response": [
                                                {
                                                    "id": "708100114",
                                                    "speaker": "维克多",
                                                    "text": "你能不能不要…不要这么警惕，我好不容易来蒙德城一趟，总得买点什么吧？"
                                                },
                                                {
                                                    "id": "708100115",
                                                    "speaker": "维克多",
                                                    "text": "而且，蒙德城对咱们愚人众的态度是越来越苛刻，说不定什么时候咱们就要回至冬国去了。"
                                                },
                                                {
                                                    "id": "708100116",
                                                    "speaker": "维克多",
                                                    "text": "提前买点特产备着，到时候也好带回去啊，这有什么问题？"
                                                },
                                                {
                                                    "id": "708100117",
                                                    "speaker": "维克多",
                                                    "text": "我是不熟蒙德城，也不知道什么特产好，你在蒙德城东奔西跑这么久，肯定比我了解，"
                                                },
                                                {
                                                    "id": "708100118",
                                                    "speaker": "维克多",
                                                    "text": "我这才想让你帮忙，买点特产而已，我又不是想去犯罪…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "708100105",
                            "text": "你又想要做什么？",
                            "response": [
                                {
                                    "id": "708100106",
                                    "speaker": "维克多",
                                    "text": "我说，你怎么对我这么大意见，我也没对你做什么吧？上次的交易，我俩不挺愉快的吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6151701",
            "initDialog": "615170101",
            "dialogues": [
                {
                    "id": "615170101",
                    "speaker": "维克多",
                    "text": "啊？干嘛？你有事吗？"
                }
            ]
        },
        {
            "talkId": "6151702",
            "initDialog": "615170201",
            "dialogues": [
                {
                    "id": "615170201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "615170202",
                    "speaker": "维克多",
                    "text": "咳！我可不是在打瞌睡消磨时间！"
                },
                {
                    "id": "615170203",
                    "speaker": "维克多",
                    "text": "本人可是愚人众的参赞大人……"
                },
                {
                    "id": "615170204",
                    "speaker": "维克多",
                    "text": "的随从——维克多！"
                },
                {
                    "id": "615170205",
                    "speaker": "维克多",
                    "text": "奉参赞大人的命令来巡视蒙德城的情况！"
                },
                {
                    "id": "615170206",
                    "speaker": "Player",
                    "text": "谈谈巡视的感受？"
                },
                {
                    "id": "615170207",
                    "speaker": "维克多",
                    "text": "这蒙德…真是太没劲了…呵欠…"
                },
                {
                    "id": "615170208",
                    "speaker": "维克多",
                    "text": "虽说是什么「自由之都」…"
                },
                {
                    "id": "615170209",
                    "speaker": "维克多",
                    "text": "可这种一点儿刺激都没有的生活，蒙德人都是怎么坚持下来的？"
                },
                {
                    "id": "615170210",
                    "speaker": "维克多",
                    "text": "还有这个巴巴托斯，啊？连个脸都不乐意露，有什么可崇拜的。"
                },
                {
                    "id": "615170211",
                    "speaker": "维克多",
                    "text": "不像我们至冬宫的女皇陛下…唉得了得了，那边的修女又开始瞪我了。"
                }
            ]
        },
        {
            "talkId": "6151703",
            "initDialog": "615170301",
            "dialogues": [
                {
                    "id": "615170301",
                    "speaker": "Player",
                    "text": "关于愚人众。"
                },
                {
                    "id": "615170302",
                    "speaker": "维克多",
                    "text": "愚人众的事情，可不是你们蒙德的普通市民能猜度的。"
                },
                {
                    "id": "615170303",
                    "speaker": "维克多",
                    "text": "咳咳…其实连我自己也不知道上头在想什么。"
                },
                {
                    "id": "615170304",
                    "speaker": "维克多",
                    "text": "反正，你们只需要知道，接受愚人众的庇护，是无上的荣耀就行了。"
                },
                {
                    "id": "615170305",
                    "speaker": "维克多",
                    "text": "至于神明…哼，只要「邪眼」在手，那些信仰、还有「神之眼」之类的，都是哄小孩的把戏，不过如此。"
                }
            ]
        },
        {
            "talkId": "6151704",
            "initDialog": "615170401",
            "dialogues": [
                {
                    "id": "615170401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615170402",
                    "speaker": "维克多",
                    "text": "要走了吗…也好。"
                },
                {
                    "id": "615170403",
                    "speaker": "维克多",
                    "text": "反正跟你们蒙德人…处不来…哈唔……"
                }
            ]
        },
        {
            "talkId": "6151705",
            "initDialog": "615170501",
            "dialogues": [
                {
                    "id": "615170501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "615170502",
                    "speaker": "维克多",
                    "text": "哼哼，要是说这个话题，那我就来精神了，我倒要看看西风骑士团最后会怎么应对风魔龙…"
                },
                {
                    "id": "615170503",
                    "speaker": "维克多",
                    "text": "另外声明一下啊，这次龙灾的发生和我们愚人众可没关系。"
                },
                {
                    "id": "615170504",
                    "speaker": "维克多",
                    "text": "…到时候可别往我们愚人众的身上泼脏水、损坏我们的名声！"
                }
            ]
        }
    ]
}