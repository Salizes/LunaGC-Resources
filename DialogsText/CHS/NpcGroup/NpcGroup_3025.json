    "talks": [
        {
            "talkId": "6302501",
            "initDialog": "630250101",
            "dialogues": [
                {
                    "id": "630250101",
                    "speaker": "井上",
                    "text": "这位行人，有何要事？无事禁止入内。"
                }
            ]
        },
        {
            "talkId": "6302502",
            "initDialog": "630250201",
            "dialogues": [
                {
                    "id": "630250201",
                    "speaker": "Player",
                    "text": "关于「天领奉行府」…"
                },
                {
                    "id": "630250202",
                    "speaker": "井上",
                    "text": "「天领奉行府」是幕府要地，管理全稻妻的治安，严格执行将军大人的一切决策。"
                },
                {
                    "id": "630250203",
                    "speaker": "井上",
                    "text": "因此我必须对进出人员严格审查。无法说明正当身份与来意的人，均不得入内。"
                }
            ]
        },
        {
            "talkId": "6302503",
            "initDialog": "630250301",
            "dialogues": [
                {
                    "id": "630250301",
                    "speaker": "Player",
                    "text": "见过和我长得很像的人吗？"
                },
                {
                    "id": "630250302",
                    "speaker": "井上",
                    "text": "嗯？异国人？没见过。这里外来人罕有，如果见过我会有印象。"
                },
                {
                    "id": "630250303",
                    "speaker": "井上",
                    "text": "走失报案请去花见坂的奉行所。"
                }
            ]
        },
        {
            "talkId": "6302504",
            "initDialog": "630250401",
            "dialogues": [
                {
                    "id": "630250401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630250402",
                    "speaker": "井上",
                    "text": "再见，常道恢弘，鸣神永恒。没什么事别过来这边了。"
                }
            ]
        },
        {
            "talkId": "6302505",
            "initDialog": "630250501",
            "dialogues": [
                {
                    "id": "630250501",
                    "speaker": "Player",
                    "text": "见过和我长得很像的人吗？"
                },
                {
                    "id": "630250502",
                    "speaker": "井上",
                    "text": "嗯？异国人？没见过。如果见过生面孔，我会有印象。"
                },
                {
                    "id": "630250503",
                    "speaker": "井上",
                    "text": "走失报案请去花见坂的奉行所。"
                }
            ]
        }
    ]
}