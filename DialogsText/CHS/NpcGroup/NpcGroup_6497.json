{
    "groupId": "6497",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "马萨特尔": 8
    },
    "talks": [
        {
            "talkId": "6649701",
            "initDialog": "664970101",
            "dialogues": [
                {
                    "id": "664970101",
                    "speaker": "马萨特尔",
                    "text": "悠悠夏天，悠悠纳塔！欢迎来到「膨胀胸甲」商店。小店售卖各种体育与水上用品。"
                },
                {
                    "id": "664970102",
                    "speaker": "马萨特尔",
                    "text": "如果客人接下来要去浪浪湾，可不要错过机会，要知道，一件合适的泳衣更能衬托身材。"
                }
            ]
        },
        {
            "talkId": "6649702",
            "initDialog": "664970201",
            "dialogues": [
                {
                    "id": "664970201",
                    "speaker": "Player",
                    "text": "可以把我衬托成你这种身材吗？"
                },
                {
                    "id": "664970202",
                    "speaker": "马萨特尔",
                    "text": "客人，你想拥有我这样的身材？"
                },
                {
                    "id": "664970203",
                    "speaker": "马萨特尔",
                    "text": "可能不是很可能，但可能也不是那么不可能。"
                },
                {
                    "id": "664970204",
                    "speaker": "Player",
                    "text": "究竟是可能还是不可能？"
                },
                {
                    "id": "664970205",
                    "speaker": "马萨特尔",
                    "text": "很可能可能，因为人穿上刺梨衣服就会变成刺梨人，那么穿上肌肉衣服就会变成肌肉人。"
                },
                {
                    "id": "664970206",
                    "speaker": "Player",
                    "text": "那让我看看你的肌肉服装。"
                },
                {
                    "id": "664970207",
                    "speaker": "马萨特尔",
                    "text": "咦？原来客人你要买啊，我以为我们只是在探讨一些可能呢。那这下不太可能了，因为小店没有肌肉衣服卖。"
                },
                {
                    "id": "664970208",
                    "speaker": "Player",
                    "text": "说了半天还是不可能啊。"
                },
                {
                    "id": "664970209",
                    "speaker": "马萨特尔",
                    "text": "就是这样。"
                }
            ]
        },
        {
            "talkId": "6649703",
            "initDialog": "664970301",
            "dialogues": [
                {
                    "id": "664970301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664970302",
                    "speaker": "马萨特尔",
                    "text": "再见。"
                }
            ]
        }
    ]
}