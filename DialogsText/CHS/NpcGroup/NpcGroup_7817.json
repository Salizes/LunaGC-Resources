{
    "groupId": "7817",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "斯索佳诺夫": 7
    },
    "talks": [
        {
            "talkId": "6781701",
            "initDialog": "678170101",
            "dialogues": [
                {
                    "id": "678170101",
                    "speaker": "斯索佳诺夫",
                    "text": "「噢，霜风啊霜风，别冻着我。别冻着我，和我的雪地犬」…"
                }
            ]
        },
        {
            "talkId": "6781702",
            "initDialog": "678170201",
            "dialogues": [
                {
                    "id": "678170201",
                    "speaker": "Player",
                    "text": "你一个人吗？"
                },
                {
                    "id": "678170202",
                    "speaker": "斯索佳诺夫",
                    "text": "是啊，难不成你在找雪地犬？哈，我可养不起那玩意儿。"
                },
                {
                    "id": "678170203",
                    "speaker": "斯索佳诺夫",
                    "text": "不过要是能养一只，下次去至冬堡就能和…一起滑雪了，哎，她肯定会喜欢的。"
                }
            ]
        },
        {
            "talkId": "6781703",
            "initDialog": "678170301",
            "dialogues": [
                {
                    "id": "678170301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "678170302",
                    "speaker": "斯索佳诺夫",
                    "text": "「噢，霜风啊霜风，别冻着我」…"
                }
            ]
        },
        {
            "talkId": "6781704",
            "initDialog": "678170401",
            "dialogues": [
                {
                    "id": "678170401",
                    "speaker": "Player",
                    "text": "吼吼，约会哦。"
                },
                {
                    "id": "678170402",
                    "speaker": "斯索佳诺夫",
                    "text": "才不是啦。是我妹妹，她在至冬堡念书，老师都夸她勤奋好学呢。哼，怎么样，很了不起吧。"
                },
                {
                    "id": "678170403",
                    "speaker": "斯索佳诺夫",
                    "text": "不过光是埋头苦读也不行啊，偶尔也得四处「逛逛」，就像我这样。"
                },
                {
                    "id": "678170404",
                    "speaker": "斯索佳诺夫",
                    "text": "我知道，她肯定是担心花销，不过那种事根本不用她考虑啊，交给我就好了…"
                }
            ]
        }
    ]
}