{
    "groupId": "6025",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "霍图鲁": 8
    },
    "talks": [
        {
            "talkId": "6602501",
            "initDialog": "660250101",
            "dialogues": [
                {
                    "id": "660250101",
                    "speaker": "霍图鲁",
                    "text": "真难过，除了游泳，我什么都不擅长…"
                }
            ]
        },
        {
            "talkId": "6602502",
            "initDialog": "660250201",
            "dialogues": [
                {
                    "id": "660250201",
                    "speaker": "Player",
                    "text": "有一项特长就很不错了。"
                },
                {
                    "id": "660250202",
                    "speaker": "霍图鲁",
                    "text": "哈哈…你说得很对，但生在流泉之众，不擅长游泳的没几个吧？"
                },
                {
                    "id": "660250203",
                    "speaker": "霍图鲁",
                    "text": "真是抱歉啊，我们部族的人似乎天生就没有什么作战天赋，甚至没什么上进心…"
                },
                {
                    "id": "660250204",
                    "speaker": "霍图鲁",
                    "text": "但一旦直面争斗，我们还是很认真的！…至少态度上是的！"
                },
                {
                    "id": "660250205",
                    "speaker": "霍图鲁",
                    "text": "总之，等我再去学一些使用武器的技巧…或者去沃陆之邦那边学一学格斗，应该就能比现在强点了吧！"
                }
            ]
        },
        {
            "talkId": "6602503",
            "initDialog": "660250301",
            "dialogues": [
                {
                    "id": "660250301",
                    "speaker": "Player",
                    "text": "加油哦。"
                },
                {
                    "id": "660250302",
                    "speaker": "霍图鲁",
                    "text": "…好吧，我会加油游泳的！"
                }
            ]
        },
        {
            "talkId": "7591301",
            "initDialog": "759130101",
            "dialogues": [
                {
                    "id": "759130101",
                    "speaker": "Player",
                    "text": "不要勉强自己哦。"
                },
                {
                    "id": "759130102",
                    "speaker": "霍图鲁",
                    "text": "不，不勉强！一想到是自己定下的目标，就应当拿出与之匹配的努力来。"
                },
                {
                    "id": "759130103",
                    "speaker": "霍图鲁",
                    "text": "就算没有结果，也无愧于心了。"
                }
            ]
        }
    ]
}