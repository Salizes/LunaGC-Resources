{
    "groupId": "6553",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "查帕莉": 16
    },
    "talks": [
        {
            "talkId": "6655301",
            "initDialog": "665530101",
            "dialogues": [
                {
                    "id": "665530101",
                    "speaker": "查帕莉",
                    "text": "埃兹莉那边不知道怎么样了，那家伙也太沉迷研发了…得关注一下她最近的状况。"
                },
                {
                    "id": "665530102",
                    "speaker": "查帕莉",
                    "text": "还有那个什么酒保，嗯，这件事也得关注一下。"
                },
                {
                    "id": "665530103",
                    "speaker": "查帕莉",
                    "text": "噢，这位冒险家，是你啊。上次多谢你帮我们解决醅幽花的问题。",
                    "choices": [
                        {
                            "id": "665530104",
                            "text": "埃兹莉…？",
                            "response": [
                                {
                                    "id": "665530105",
                                    "speaker": "查帕莉",
                                    "text": "好奇埃兹莉这家伙吗？她其实是我的妹妹，也是「醅蜜」的酿酒师。"
                                },
                                {
                                    "id": "665530106",
                                    "speaker": "查帕莉",
                                    "text": "她最近正躲在后山开发一款新饮品，据说过程不依赖蜜虫，最后喝下去还能让人看见神乎其神的东西。"
                                },
                                {
                                    "id": "665530107",
                                    "speaker": "查帕莉",
                                    "text": "我真是佩服她的钻研精神，你要是有兴趣，可以去后山转转，她应该就在那边。"
                                }
                            ]
                        },
                        {
                            "id": "665530201",
                            "text": "酒保…？",
                            "response": [
                                {
                                    "id": "665530202",
                                    "speaker": "查帕莉",
                                    "text": "是有客人来反映啦，最近有个戴着眼罩的家伙，站在提提岛入口冒充我们店的酒保。"
                                },
                                {
                                    "id": "665530203",
                                    "speaker": "查帕莉",
                                    "text": "说来也奇怪，虽说那家伙不是我们的人，但又在很认真地和客人推荐我们的饮品，而且也没有收费…这就是热爱吧？"
                                },
                                {
                                    "id": "665530204",
                                    "speaker": "查帕莉",
                                    "text": "总之，您不用担心，我会找这位热心的「酒保」了解情况的。"
                                }
                            ]
                        },
                        {
                            "id": "665530301",
                            "text": "有什么冒险家适合去的地方吗？",
                            "response": [
                                {
                                    "id": "665530302",
                                    "speaker": "查帕莉",
                                    "text": "哈哈，这位客人，你可能来迟了二十来年。"
                                },
                                {
                                    "id": "665530303",
                                    "speaker": "查帕莉",
                                    "text": "二十多年前，冒险家们无不向往的烬寂海突然消失，吸引了非常多的冒险团造访。"
                                },
                                {
                                    "id": "665530304",
                                    "speaker": "查帕莉",
                                    "text": "如果是那个时期，您应该能找到很多伙伴，也有很多地方可去探索。"
                                },
                                {
                                    "id": "665530305",
                                    "speaker": "Player",
                                    "text": "那些冒险团有发现什么吗？"
                                },
                                {
                                    "id": "665530306",
                                    "speaker": "查帕莉",
                                    "text": "听说那时候虽然没人发现烬寂海消失的秘密，但是却有冒险团闯入了疑似烬寂海的神秘区域。"
                                },
                                {
                                    "id": "665530307",
                                    "speaker": "查帕莉",
                                    "text": "而且那种地方还不止一处，后来人们把那些区域叫做倒影之海，就好像是烬寂海在我们的世界投下了影子一样。"
                                },
                                {
                                    "id": "665530308",
                                    "speaker": "查帕莉",
                                    "text": "不过到了最近这些年，就连倒影之海也没有人再发现过了…"
                                }
                            ]
                        },
                        {
                            "id": "665530401",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "665530402",
                                    "speaker": "查帕莉",
                                    "text": "再见，玩得愉快啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}