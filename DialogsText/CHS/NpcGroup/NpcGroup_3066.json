{
    "groupId": "3066",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "山上": 5,
        "德长": 5,
        "皮卡": 2
    },
    "talks": [
        {
            "talkId": "6303701",
            "initDialog": "630370101",
            "dialogues": [
                {
                    "id": "630370101",
                    "speaker": "山上",
                    "text": "演出一开始，你就说「德长，快，给大家来一个」！然后我立即登场，一个后空翻…"
                },
                {
                    "id": "630370102",
                    "speaker": "德长",
                    "text": "等等，会不会太夸张了啊？我觉得按照原来那样就可以了，你从后边吓我，我假装被吓一跳…"
                },
                {
                    "id": "630370103",
                    "speaker": "山上",
                    "text": "不行不行，太平淡了。我们的目标可是搞笑艺人出道！不拿出全力，怎么出人头地。"
                },
                {
                    "id": "630370104",
                    "speaker": "山上",
                    "text": "假装吓人这么老套的手法，狗看了都不会笑的。你说是不是，皮卡？"
                },
                {
                    "id": "630370105",
                    "speaker": "皮卡",
                    "text": "？"
                },
                {
                    "id": "630370106",
                    "speaker": "山上",
                    "text": "你看。"
                },
                {
                    "id": "630370107",
                    "speaker": "德长",
                    "text": "看什么…你过来吓我，我也可以演得很好笑啊。不信我演给你看！"
                },
                {
                    "id": "630370108",
                    "speaker": "德长",
                    "text": "啊啊啊啊啊啊啊啊——"
                },
                {
                    "id": "630370109",
                    "speaker": "山上",
                    "text": "……"
                },
                {
                    "id": "630370110",
                    "speaker": "德长",
                    "text": "是不是，挺好笑的吧…"
                },
                {
                    "id": "630370111",
                    "speaker": "德长",
                    "text": "那个…皮卡，你告诉他，好笑不好笑。"
                },
                {
                    "id": "630370112",
                    "speaker": "皮卡",
                    "text": "（摇尾巴）"
                }
            ]
        }
    ]
}