    "talks": [
        {
            "talkId": "6305801",
            "initDialog": "630580101",
            "dialogues": [
                {
                    "id": "630580101",
                    "speaker": "矢田幸喜",
                    "text": "你好，常道恢弘，鸣神…"
                },
                {
                    "id": "630580102",
                    "speaker": "矢田幸喜",
                    "text": "等等，你是谁，来做什么？"
                }
            ]
        },
        {
            "talkId": "6305802",
            "initDialog": "630580201",
            "dialogues": [
                {
                    "id": "630580201",
                    "speaker": "Player",
                    "text": "只是路过。"
                },
                {
                    "id": "630580202",
                    "speaker": "矢田幸喜",
                    "text": "真的吗？"
                },
                {
                    "id": "630580203",
                    "speaker": "矢田幸喜",
                    "text": "嗯…看你倒没有在做什么奇怪的事情，你走吧。"
                },
                {
                    "id": "630580204",
                    "speaker": "矢田幸喜",
                    "text": "这边出门，别乱逛。天领奉行府错综复杂，小心不要「迷路」。"
                }
            ]
        },
        {
            "talkId": "6305803",
            "initDialog": "630580301",
            "dialogues": [
                {
                    "id": "630580301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630580302",
                    "speaker": "矢田幸喜",
                    "text": "警告你，别有坏心思啊。"
                }
            ]
        }
    ]
}