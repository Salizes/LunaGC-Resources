            "dialogues": [
                {
                    "id": "60067401",
                    "speaker": "爱莱妲",
                    "text": "记得要小心力道…轻轻粘上去…"
                },
                {
                    "id": "60067402",
                    "speaker": "伊涅芙",
                    "text": "啊…又捏碎了…"
                },
                {
                    "id": "60067403",
                    "speaker": "Player",
                    "text": "你们在干什么？"
                },
                {
                    "id": "60067404",
                    "speaker": "伊涅芙",
                    "text": "#你好。{NICKNAME}，我正在学习制作「花型机关零件」。"
                },
                {
                    "id": "60067405",
                    "speaker": "伊涅芙",
                    "text": "我准备带一些「纪念品」回去，送给在等我回去的人们。"
                },
                {
                    "id": "60067406",
                    "speaker": "爱莱妲",
                    "text": "法尔伽大叔不清楚…不过爱诺肯定会很喜欢吧！"
                },
                {
                    "id": "60067407",
                    "speaker": "伊涅芙",
                    "text": "对了。请收下这个。"
                },
                {
                    "id": "60067408",
                    "speaker": "Player",
                    "text": "这是…？"
                },
                {
                    "id": "60067409",
                    "speaker": "伊涅芙",
                    "text": "是送给你的份，「纪念」我们的相遇。"
                },
                {
                    "id": "60067410",
                    "speaker": "伊涅芙",
                    "text": "#还有…「感谢」，{NICKNAME}。"
                }
            ]
        }
    ]
}