{
    "groupId": "4133",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "罗娅": 8
    },
    "talks": [
        {
            "talkId": "6413301",
            "initDialog": "641330101",
            "dialogues": [
                {
                    "id": "641330101",
                    "speaker": "罗娅",
                    "text": "新鲜蔬果，量大货优！"
                }
            ]
        },
        {
            "talkId": "6413302",
            "initDialog": "641330201",
            "dialogues": [
                {
                    "id": "641330201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641330202",
                    "speaker": "罗娅",
                    "text": "我是卖蔬菜水果的批发商。"
                },
                {
                    "id": "641330203",
                    "speaker": "罗娅",
                    "text": "如你所见，这里是商船密集的海港，为了满足船队远航的需要，我的货都是大批量售卖的。"
                },
                {
                    "id": "641330204",
                    "speaker": "罗娅",
                    "text": "卖惯了成箱的苹果桃子土豆番茄，你要是说只买几个的话，我还真不好算钱。"
                }
            ]
        },
        {
            "talkId": "6413303",
            "initDialog": "641330301",
            "dialogues": [
                {
                    "id": "641330301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641330302",
                    "speaker": "罗娅",
                    "text": "有大批量的生意可以介绍给我！"
                }
            ]
        },
        {
            "talkId": "7391201",
            "initDialog": "739120101",
            "dialogues": [
                {
                    "id": "739120101",
                    "speaker": "Player",
                    "text": "想买几个…"
                },
                {
                    "id": "739120102",
                    "speaker": "罗娅",
                    "text": "就几个吗？那干脆送你好了。"
                },
                {
                    "id": "739120103",
                    "speaker": "罗娅",
                    "text": "我倒也不赚这三瓜俩枣的钱，你拿去吧。"
                },
                {
                    "id": "739120104",
                    "speaker": "罗娅",
                    "text": "哦对了，既然买的不多，那最好就趁新鲜赶紧吃掉吧！"
                }
            ]
        }
    ]
}