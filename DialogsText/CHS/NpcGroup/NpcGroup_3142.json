    "talks": [
        {
            "talkId": "6314201",
            "initDialog": "631420101",
            "dialogues": [
                {
                    "id": "631420101",
                    "speaker": "柴田",
                    "text": "你好，来珊瑚宫有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6314202",
            "initDialog": "631420201",
            "dialogues": [
                {
                    "id": "631420201",
                    "speaker": "Player",
                    "text": "关于珊瑚宫…"
                },
                {
                    "id": "631420202",
                    "speaker": "柴田",
                    "text": "珊瑚宫是海祇岛的中心，由珊瑚宫大人掌管，供奉着我们海祇岛民的神明「海祇大御神」。"
                },
                {
                    "id": "631420203",
                    "speaker": "柴田",
                    "text": "说是供奉…但其实这里并不是「海祇大御神」的神体所在之处。"
                },
                {
                    "id": "631420204",
                    "speaker": "柴田",
                    "text": "不过宫殿外的这些大片珊瑚，倒的的确确是从「海祇大御神」身上取下来的…大概吧。"
                },
                {
                    "id": "631420205",
                    "speaker": "柴田",
                    "text": "哎具体的我也不太清楚，你要是想了解更多的话，不如去问问巫女吧。"
                },
                {
                    "id": "631420206",
                    "speaker": "柴田",
                    "text": "不过她好像已经被那边的学者搞得很头痛了…祝你好运。"
                }
            ]
        },
        {
            "talkId": "6314203",
            "initDialog": "631420301",
            "dialogues": [
                {
                    "id": "631420301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631420302",
                    "speaker": "柴田",
                    "text": "再见。"
                }
            ]
        }
    ]
}