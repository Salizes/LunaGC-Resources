{
    "groupId": "9411",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "莉奈娅": 9
    },
    "talks": [
        {
            "talkId": "6941101",
            "initDialog": "694110101",
            "dialogues": [
                {
                    "id": "694110101",
                    "speaker": "莉奈娅",
                    "text": "先休息一会儿？那我就恭敬不如从命啦。"
                },
                {
                    "id": "694110102",
                    "speaker": "莉奈娅",
                    "text": "作为冒险家，做好体力的分配也是很重要的。"
                },
                {
                    "id": "694110103",
                    "speaker": "莉奈娅",
                    "text": "要让露米给你捶捶肩吗？它会控制好力度的！嗯…应该会的！"
                }
            ]
        },
        {
            "talkId": "6941102",
            "initDialog": "694110201",
            "dialogues": [
                {
                    "id": "694110201",
                    "speaker": "莉奈娅",
                    "text": "新的挑战啊…真让人期待。"
                },
                {
                    "id": "694110202",
                    "speaker": "莉奈娅",
                    "text": "虽然在野外冒险时也有不少奇遇，但是没想到在书中的冒险也会这么有趣。"
                },
                {
                    "id": "694110203",
                    "speaker": "莉奈娅",
                    "text": "我早就准备好啦，出发的时候记得叫上我哦。"
                }
            ]
        },
        {
            "talkId": "6941103",
            "initDialog": "694110301",
            "dialogues": [
                {
                    "id": "694110301",
                    "speaker": "莉奈娅",
                    "text": "你和小狼聊过吗？我和他聊了聊，它说了好多有意思的事。"
                },
                {
                    "id": "694110302",
                    "speaker": "莉奈娅",
                    "text": "而且它摸起来毛茸茸的，跟露米的手感相比…"
                },
                {
                    "id": "694110303",
                    "speaker": "莉奈娅",
                    "text": "不对不对，不应该拿来比较的，它们各有各的好！"
                }
            ]
        }
    ]
}