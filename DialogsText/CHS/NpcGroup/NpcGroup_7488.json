{
    "groupId": "7488",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "伊利亚": 1,
        "基拉": 1,
        "热拉尔": 6,
        "阿琳娜": 1
    },
    "talks": [
        {
            "talkId": "6748702",
            "initDialog": "674870201",
            "dialogues": [
                {
                    "id": "674870201",
                    "speaker": "Player",
                    "text": "检查？"
                },
                {
                    "id": "674870202",
                    "speaker": "基拉",
                    "text": "按照新规定，我们有权力对任何具有潜在风险的人士进行抽检，包括但不限于行李检查与个人情况询问。"
                },
                {
                    "id": "674870203",
                    "speaker": "热拉尔",
                    "text": "如有任何问题，请向运输局反馈。"
                }
            ]
        },
        {
            "talkId": "6748801",
            "initDialog": "674880101",
            "dialogues": [
                {
                    "id": "674880101",
                    "speaker": "热拉尔",
                    "text": "这种事怎么会发生在我身上！真是太不公平了——"
                }
            ]
        },
        {
            "talkId": "6748802",
            "initDialog": "674880201",
            "dialogues": [
                {
                    "id": "674880201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "674880202",
                    "speaker": "热拉尔",
                    "text": "说起来你可能都不会相信，朋友——我，一个从枫丹来的游客，竟然被拦下来抽检了，理由是「为了至冬的安全」！"
                },
                {
                    "id": "674880203",
                    "speaker": "热拉尔",
                    "text": "于是我问他们：「我看起来有什么地方可能威胁到至冬的安全吗？」"
                },
                {
                    "id": "674880204",
                    "speaker": "热拉尔",
                    "text": "工作人员回答我：「您背了一个包。我们需要确认您的包里是否藏有武器、晶矿、外来生物，或一切其他可疑物品。」"
                },
                {
                    "id": "674880205",
                    "speaker": "阿琳娜",
                    "text": "于是我问她：「刚刚进去的那个至冬人，步履匆匆、神情警惕，最重要的是——背的包比我的大多了！你们为什么不抽检她？」"
                },
                {
                    "id": "674880206",
                    "speaker": "伊利亚",
                    "text": "工作人员回答我：「如果您对我们的判断标准有什么疑问，可以向运输局反馈。」"
                }
            ]
        },
        {
            "talkId": "6748803",
            "initDialog": "674880301",
            "dialogues": [
                {
                    "id": "674880301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674880302",
                    "speaker": "热拉尔",
                    "text": "再见，朋友！唉，希望你不要像我一样倒霉。"
                }
            ]
        }
    ]
}