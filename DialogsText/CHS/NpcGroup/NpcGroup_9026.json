{
    "groupId": "9026",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 18,
        "魈": 48
    },
    "talks": [
        {
            "talkId": "6902601",
            "initDialog": "690260101",
            "dialogues": [
                {
                    "id": "690260101",
                    "speaker": "魈",
                    "text": "#…是你，{NICKNAME}。"
                },
                {
                    "id": "690260102",
                    "speaker": "魈",
                    "text": "有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6902602",
            "initDialog": "690260201",
            "dialogues": [
                {
                    "id": "690260201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690260202",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "690260203",
                    "speaker": "魈",
                    "text": "这里没有不祥之物，是个清静的去处。"
                },
                {
                    "id": "690260204",
                    "speaker": "魈",
                    "text": "但是…",
                    "choices": [
                        {
                            "id": "690260205",
                            "text": "但是？",
                            "response": [
                                {
                                    "id": "690260206",
                                    "speaker": "魈",
                                    "text": "太过安逸了。"
                                },
                                {
                                    "id": "690260209",
                                    "speaker": "魈",
                                    "text": "我会为你守护这一隅乐土。"
                                },
                                {
                                    "id": "690260210",
                                    "speaker": "魈",
                                    "text": "但我自知与无忧无虑的生活无缘。"
                                },
                                {
                                    "id": "690260211",
                                    "speaker": "魈",
                                    "text": "…你的好意我领受了。"
                                }
                            ]
                        },
                        {
                            "id": "690260207",
                            "text": "还是不太习惯？",
                            "response": [
                                {
                                    "id": "690260208",
                                    "speaker": "魈",
                                    "text": "…嗯。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902603",
            "initDialog": "690260301",
            "dialogues": [
                {
                    "id": "690260301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690260302",
                    "speaker": "魈",
                    "text": "…闲聊吗？"
                },
                {
                    "id": "690260303",
                    "speaker": "魈",
                    "text": "…既然你想，我陪你便是。",
                    "choices": [
                        {
                            "id": "690260304",
                            "text": "我还以为你会拒绝呢。",
                            "response": [
                                {
                                    "id": "690260305",
                                    "speaker": "魈",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "690260306",
                                    "speaker": "魈",
                                    "text": "提出要求却做好了被拒绝的准备…"
                                },
                                {
                                    "id": "690260307",
                                    "speaker": "魈",
                                    "text": "人类的交往，真是麻烦。"
                                },
                                {
                                    "id": "690260311",
                                    "speaker": "魈",
                                    "text": "一般来说，我不会参与「聊天」这种活动。"
                                },
                                {
                                    "id": "690260312",
                                    "speaker": "魈",
                                    "text": "但对象是你的话…姑且可以一试。"
                                },
                                {
                                    "id": "690260313",
                                    "speaker": "Player",
                                    "text": "魈最近还好吗？"
                                },
                                {
                                    "id": "690260314",
                                    "speaker": "魈",
                                    "text": "你是在问…「业障」的影响吗？"
                                },
                                {
                                    "id": "690260315",
                                    "speaker": "魈",
                                    "text": "无碍。"
                                },
                                {
                                    "id": "690260316",
                                    "speaker": "魈",
                                    "text": "既然因我而起，我独自承受便是。"
                                },
                                {
                                    "id": "690260317",
                                    "speaker": "魈",
                                    "text": "…不知是否与你有关，最近，蚀骨之痛已不再难以忍受。"
                                },
                                {
                                    "id": "690260318",
                                    "speaker": "魈",
                                    "text": "比起以往，可谓轻松许多。"
                                },
                                {
                                    "id": "690260319",
                                    "speaker": "魈",
                                    "text": "多余的担心，嗯…还是留给你自己吧。"
                                }
                            ]
                        },
                        {
                            "id": "690260308",
                            "text": "魈看起来有些勉强？",
                            "response": [
                                {
                                    "id": "690260309",
                                    "speaker": "魈",
                                    "text": "并非如此。"
                                },
                                {
                                    "id": "690260310",
                                    "speaker": "魈",
                                    "text": "我没有想见你会提出这样的要求。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902604",
            "initDialog": "690260401",
            "dialogues": [
                {
                    "id": "690260401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690260402",
                    "speaker": "魈",
                    "text": "若你有空，可否一同前往璃月港内…"
                },
                {
                    "id": "690260403",
                    "speaker": "魈",
                    "text": "没空便作罢。",
                    "choices": [
                        {
                            "id": "690260404",
                            "text": "当然可以。",
                            "response": [
                                {
                                    "id": "690260405",
                                    "speaker": "魈",
                                    "text": "好。"
                                },
                                {
                                    "id": "690260408",
                                    "speaker": "魈",
                                    "text": "我无意接近凡人的生活。"
                                },
                                {
                                    "id": "690260409",
                                    "speaker": "魈",
                                    "text": "但我知道你经常出入城市，行走在人群之间。"
                                },
                                {
                                    "id": "690260410",
                                    "speaker": "魈",
                                    "text": "这期间的故事…或者乐趣，如果不亲自体会的话，恐怕就难以获悉你的心情。"
                                },
                                {
                                    "id": "690260411",
                                    "speaker": "Player",
                                    "text": "所以…魈是为了我？"
                                },
                                {
                                    "id": "690260412",
                                    "speaker": "魈",
                                    "text": "嗯，想要理解你。"
                                },
                                {
                                    "id": "690260413",
                                    "speaker": "魈",
                                    "text": "预感到会很困难…但有了这样的想法之后，无法坐视不管。"
                                },
                                {
                                    "id": "690260414",
                                    "speaker": "魈",
                                    "text": "在城内我会控制好自己。"
                                },
                                {
                                    "id": "690260415",
                                    "speaker": "魈",
                                    "text": "尽量…少说话吧。",
                                    "choices": [
                                        {
                                            "id": "690260416",
                                            "text": "嗯，我会陪着你。",
                                            "response": [
                                                {
                                                    "id": "690260418",
                                                    "speaker": "魈",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "690260419",
                                                    "speaker": "魈",
                                                    "text": "准备好出发了，就告诉我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690260417",
                                            "text": "说什么都没关系，我能帮你圆。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690260406",
                            "text": "魈终于想融入城市了？",
                            "response": [
                                {
                                    "id": "690260407",
                                    "speaker": "魈",
                                    "text": "咳咳…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902605",
            "initDialog": "690260501",
            "dialogues": [
                {
                    "id": "690260501",
                    "speaker": "Player",
                    "text": "早啊，魈。"
                },
                {
                    "id": "690260502",
                    "speaker": "魈",
                    "text": "…早。"
                },
                {
                    "id": "690260503",
                    "speaker": "魈",
                    "text": "若遇上棘手之事，不必拘泥，直呼我名便好。"
                }
            ]
        },
        {
            "talkId": "6902606",
            "initDialog": "690260601",
            "dialogues": [
                {
                    "id": "690260601",
                    "speaker": "Player",
                    "text": "晚安，魈。"
                },
                {
                    "id": "690260602",
                    "speaker": "魈",
                    "text": "今日…"
                },
                {
                    "id": "690260603",
                    "speaker": "魈",
                    "text": "算了，无事。晚安。"
                }
            ]
        },
        {
            "talkId": "6902607",
            "initDialog": "690260701",
            "dialogues": [
                {
                    "id": "690260701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902608",
            "initDialog": "690260801",
            "dialogues": [
                {
                    "id": "690260801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902609",
            "initDialog": "690260901",
            "dialogues": [
                {
                    "id": "690260901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902650",
            "initDialog": "690265001",
            "dialogues": [
                {
                    "id": "690265001",
                    "speaker": "魈",
                    "text": "稀疏的建筑，低矮的木屋…这般村落的住户不多，有时比城镇更易于守护。"
                },
                {
                    "id": "690265002",
                    "speaker": "魈",
                    "text": "我与妖邪厮杀时，只期望周遭的闲人退散，方可施展手脚，大开大合。"
                },
                {
                    "id": "690265003",
                    "speaker": "魈",
                    "text": "…原来往细里看，人间建筑会是如此。"
                }
            ]
        },
        {
            "talkId": "6902651",
            "initDialog": "690265101",
            "dialogues": [
                {
                    "id": "690265101",
                    "speaker": "魈",
                    "text": "这间庖屋的陈设，与望舒客栈别无二致。"
                },
                {
                    "id": "690265102",
                    "speaker": "魈",
                    "text": "凭手头的食材，你能烹调出我所熟悉的味道吗？"
                },
                {
                    "id": "690265103",
                    "speaker": "魈",
                    "text": "随口一说…我也没有在期待。"
                }
            ]
        }
    ]
}