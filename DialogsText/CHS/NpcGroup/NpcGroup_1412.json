{
    "groupId": "1412",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "斯坦利": 15
    },
    "talks": [
        {
            "talkId": "40158",
            "initDialog": "4015141201",
            "dialogues": [
                {
                    "id": "4015141201",
                    "speaker": "斯坦利",
                    "text": "斯坦利…斯坦利…你的名字…永远不该被遗忘…"
                }
            ]
        },
        {
            "talkId": "40227",
            "initDialog": "4015141202",
            "dialogues": [
                {
                    "id": "4015141202",
                    "speaker": "Player",
                    "text": "你为什么在念叨自己的名字？"
                },
                {
                    "id": "4015141205",
                    "speaker": "斯坦利",
                    "text": "居然被你听到了吗…没什么…"
                },
                {
                    "id": "4015141206",
                    "speaker": "斯坦利",
                    "text": "我只是在感慨自己的经历，还有怀念死去的朋友而已…"
                },
                {
                    "id": "4015141207",
                    "speaker": "斯坦利",
                    "text": "就是这样，我没说谎…"
                }
            ]
        },
        {
            "talkId": "40229",
            "initDialog": "4015141204",
            "dialogues": [
                {
                    "id": "4015141204",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "4015141215",
                    "speaker": "斯坦利",
                    "text": "让我一个人再静一会儿…"
                }
            ]
        },
        {
            "talkId": "40234",
            "initDialog": "4015141216",
            "dialogues": [
                {
                    "id": "4015141216",
                    "speaker": "斯坦利",
                    "text": "唉…斯坦利，好想再跟你喝一杯啊。"
                }
            ]
        },
        {
            "talkId": "40235",
            "initDialog": "4015141217",
            "dialogues": [
                {
                    "id": "4015141217",
                    "speaker": "Player",
                    "text": "你没关系吧。"
                },
                {
                    "id": "4015141218",
                    "speaker": "斯坦利",
                    "text": "是你啊…我没事，不用担心。"
                },
                {
                    "id": "4015141219",
                    "speaker": "斯坦利",
                    "text": "只是这样的夜晚，听着酒馆的喧闹声，不知不觉有些感伤而已。"
                },
                {
                    "id": "4015141220",
                    "speaker": "斯坦利",
                    "text": "想到我和斯坦利刚开始冒险的那些日子，出发的前夜都会在酒馆喝个烂醉…"
                },
                {
                    "id": "4015141221",
                    "speaker": "斯坦利",
                    "text": "唉…没关系，我会振作起来的，就算为了他也一定会的。"
                }
            ]
        },
        {
            "talkId": "40236",
            "initDialog": "4015141222",
            "dialogues": [
                {
                    "id": "4015141222",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "4015141223",
                    "speaker": "斯坦利",
                    "text": "没关系，让我一个人再静一会儿…"
                }
            ]
        },
        {
            "talkId": "6141101",
            "initDialog": "614110101",
            "dialogues": [
                {
                    "id": "614110101",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614110102",
                    "speaker": "斯坦利",
                    "text": "这种时候，要是那家伙还在就好了，斯坦利…"
                },
                {
                    "id": "614110103",
                    "speaker": "斯坦利",
                    "text": "…我是说，斯坦利…的助手。"
                },
                {
                    "id": "614110104",
                    "speaker": "斯坦利",
                    "text": "对，如果那个家伙也在的话，区区风魔龙，我们两个人就就足够了！"
                },
                {
                    "id": "614110105",
                    "speaker": "斯坦利",
                    "text": "真是怀念他啊，要是他还在就好了…"
                }
            ]
        }
    ]
}