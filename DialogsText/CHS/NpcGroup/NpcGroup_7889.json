{
    "groupId": "7889",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "莎戈娃": 8
    },
    "talks": [
        {
            "talkId": "6788901",
            "initDialog": "678890101",
            "dialogues": [
                {
                    "id": "678890101",
                    "speaker": "莎戈娃",
                    "text": "没关系，我相信机会是留给有准备的人的！"
                }
            ]
        },
        {
            "talkId": "6788902",
            "initDialog": "678890201",
            "dialogues": [
                {
                    "id": "678890201",
                    "speaker": "Player",
                    "text": "什么机会？"
                },
                {
                    "id": "678890202",
                    "speaker": "莎戈娃",
                    "text": "啊…被旅客听到了。真是不好意思…"
                },
                {
                    "id": "678890203",
                    "speaker": "莎戈娃",
                    "text": "我是凝露镇的列车员莎戈娃，这是我工作的第一年…"
                },
                {
                    "id": "678890204",
                    "speaker": "莎戈娃",
                    "text": "站长说，他觉得我很有潜力，只要肯努力，总有一天我会被调到至冬堡去…啊，这话说出来真是让大家见笑。"
                },
                {
                    "id": "678890205",
                    "speaker": "莎戈娃",
                    "text": "不过…我也下定决心了，今后要努力工作，争取多多表现！"
                },
                {
                    "id": "678890206",
                    "speaker": "莎戈娃",
                    "text": "嗯…虽然最近没什么人来凝露镇，车站冷冷清清的，我也没什么表现的机会…"
                },
                {
                    "id": "678890207",
                    "speaker": "莎戈娃",
                    "text": "但没关系，嗯！只要我把每一件小事做好，机会总是会来的，机会总是会留给有准备的人的！"
                }
            ]
        },
        {
            "talkId": "6788903",
            "initDialog": "678890301",
            "dialogues": [
                {
                    "id": "678890301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678890302",
                    "speaker": "莎戈娃",
                    "text": "啊…再见。"
                }
            ]
        }
    ]
}