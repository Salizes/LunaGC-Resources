{
    "groupId": "1443",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "奥特": 10
    },
    "talks": [
        {
            "talkId": "6144301",
            "initDialog": "614430101",
            "dialogues": [
                {
                    "id": "614430101",
                    "speaker": "奥特",
                    "text": "你好，旅行者，欢迎来到蒙德城。"
                }
            ]
        },
        {
            "talkId": "6144302",
            "initDialog": "614430201",
            "dialogues": [
                {
                    "id": "614430201",
                    "speaker": "Player",
                    "text": "您在这里干什么呢？"
                },
                {
                    "id": "614430202",
                    "speaker": "奥特",
                    "text": "正如您所见，我是蒙德城的卫兵。"
                },
                {
                    "id": "614430203",
                    "speaker": "奥特",
                    "text": "保护蒙德城的商贾，居民和旅客，就是我的使命。"
                }
            ]
        },
        {
            "talkId": "6144303",
            "initDialog": "614430301",
            "dialogues": [
                {
                    "id": "614430301",
                    "speaker": "Player",
                    "text": "蒙德城内有什么值得一看的吗？"
                },
                {
                    "id": "614430302",
                    "speaker": "奥特",
                    "text": "如果您是第一次来，我推荐您到蒙德城大教堂看一看。"
                },
                {
                    "id": "614430303",
                    "speaker": "奥特",
                    "text": "当您感觉疲劳的时候，不妨去「天使的馈赠」酒馆尝尝蒙德闻名的好酒。"
                }
            ]
        },
        {
            "talkId": "6144304",
            "initDialog": "614430401",
            "dialogues": [
                {
                    "id": "614430401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614430402",
                    "speaker": "奥特",
                    "text": "再见，旅行者。"
                },
                {
                    "id": "614430403",
                    "speaker": "奥特",
                    "text": "愿风神护佑您。"
                }
            ]
        },
        {
            "talkId": "6144305",
            "initDialog": "614430501",
            "dialogues": [
                {
                    "id": "614430501",
                    "speaker": "奥特",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6144306",
            "initDialog": "614430601",
            "dialogues": [
                {
                    "id": "614430601",
                    "speaker": "奥特",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6144307",
            "initDialog": "614430701",
            "dialogues": [
                {
                    "id": "614430701",
                    "speaker": "奥特",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        }
    ]
}