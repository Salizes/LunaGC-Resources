{
    "groupId": "6499",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "富尼耶": 7
    },
    "talks": [
        {
            "talkId": "6649901",
            "initDialog": "664990101",
            "dialogues": [
                {
                    "id": "664990101",
                    "speaker": "富尼耶",
                    "text": "悠悠枫丹，悠悠夏天！这里是来自枫丹的精致甜品，各种口味应有尽有！"
                }
            ]
        },
        {
            "talkId": "6649902",
            "initDialog": "664990201",
            "dialogues": [
                {
                    "id": "664990201",
                    "speaker": "Player",
                    "text": "让我看看你的货。"
                },
                {
                    "id": "664990202",
                    "speaker": "富尼耶",
                    "text": "请过目。"
                }
            ]
        },
        {
            "talkId": "6649903",
            "initDialog": "664990301",
            "dialogues": [
                {
                    "id": "664990301",
                    "speaker": "Player",
                    "text": "你是枫丹人？"
                },
                {
                    "id": "664990302",
                    "speaker": "富尼耶",
                    "text": "客人好眼力！您知道枫丹有个著名的德波大饭店吗？我原本是那的甜点师。"
                },
                {
                    "id": "664990303",
                    "speaker": "富尼耶",
                    "text": "前段时间有位纳塔的客人住店，我从他那得知了这个悠悠度假村试营业的消息。"
                },
                {
                    "id": "664990304",
                    "speaker": "富尼耶",
                    "text": "感觉这是一个推广枫丹甜点的好机会，所以就带着摊子到了这里。"
                },
                {
                    "id": "664990305",
                    "speaker": "富尼耶",
                    "text": "话说回来，那位纳塔客人叫做松潘特利，好像也在市集里开了店铺，客人有兴趣的话可以去看看。"
                }
            ]
        },
        {
            "talkId": "6649904",
            "initDialog": "664990401",
            "dialogues": [
                {
                    "id": "664990401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664990402",
                    "speaker": "富尼耶",
                    "text": "再见。"
                }
            ]
        }
    ]
}