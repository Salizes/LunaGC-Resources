    },
    "talks": [
        {
            "talkId": "6653601",
            "initDialog": "665360101",
            "dialogues": [
                {
                    "id": "665360101",
                    "speaker": "察尔瓦",
                    "text": "悠悠纳塔！悠悠夏天！这里是度假村限定闪闪礼蛋！每人每天可以免费领取一枚。这位客人，要不要来挑战一下自己的礼运？"
                }
            ]
        },
        {
            "talkId": "6653602",
            "initDialog": "665360201",
            "dialogues": [
                {
                    "id": "665360201",
                    "speaker": "Player",
                    "text": "闪闪礼蛋是什么？"
                },
                {
                    "id": "665360202",
                    "speaker": "察尔瓦",
                    "text": "嘿嘿，是您的运气试金蛋！"
                },
                {
                    "id": "665360203",
                    "speaker": "察尔瓦",
                    "text": "闪闪礼蛋里面装的是各种纳塔特色的甜点和料理，但是光凭外表，您是完全分辨不出内容的。"
                },
                {
                    "id": "665360204",
                    "speaker": "察尔瓦",
                    "text": "每位客人每天能够免费领取一枚闪闪礼蛋，最后能获得什么，全凭您的手气啦。"
                },
                {
                    "id": "665360205",
                    "speaker": "察尔瓦",
                    "text": "顺便一提，里面还有特别隐藏款哦。"
                }
            ]
        },
        {
            "talkId": "6653603",
            "initDialog": "665360301",
            "dialogues": [
                {
                    "id": "665360301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "665360302",
                    "speaker": "察尔瓦",
                    "text": "客人您慢走啊！"
                }
            ]
        }
    ]
}