{
    "groupId": "6220",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "阿马佐利": 11
    },
    "talks": [
        {
            "talkId": "6622001",
            "initDialog": "662200101",
            "dialogues": [
                {
                    "id": "662200101",
                    "speaker": "阿马佐利",
                    "text": "你好啊，欢迎光临「伊杜坎的秘藏」。"
                }
            ]
        },
        {
            "talkId": "6622002",
            "initDialog": "662200201",
            "dialogues": [
                {
                    "id": "662200201",
                    "speaker": "Player",
                    "text": "想要浏览商品…"
                },
                {
                    "id": "662200202",
                    "speaker": "阿马佐利",
                    "text": "各种饭菜吃多了才知道什么好吃，所以不管什么样式的书都应该多读读！"
                }
            ]
        },
        {
            "talkId": "6622003",
            "initDialog": "662200301",
            "dialogues": [
                {
                    "id": "662200301",
                    "speaker": "Player",
                    "text": "关于「伊杜坎的秘藏」…"
                },
                {
                    "id": "662200302",
                    "speaker": "阿马佐利",
                    "text": "「伊杜坎」…真是个好名字。"
                },
                {
                    "id": "662200303",
                    "speaker": "阿马佐利",
                    "text": "是我从某本神话书籍里读到的，具体什么内容有些记不得了…但印象中名字的主人是十分智慧的人物。"
                },
                {
                    "id": "662200305",
                    "speaker": "阿马佐利",
                    "text": "智慧有很多种形式，纸质的，布织的，甚至口口相传的语言，皆在其内。"
                },
                {
                    "id": "662200304",
                    "speaker": "阿马佐利",
                    "text": "这就是为什么我会给自己店起名叫「伊杜坎的秘藏」。"
                }
            ]
        },
        {
            "talkId": "6622004",
            "initDialog": "662200401",
            "dialogues": [
                {
                    "id": "662200401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662200402",
                    "speaker": "阿马佐利",
                    "text": "再见，愿智慧让你免入歧途。"
                }
            ]
        },
        {
            "talkId": "6622005",
            "initDialog": "662200501",
            "dialogues": [
                {
                    "id": "662200501",
                    "speaker": "Player",
                    "text": "名字的意义很重要。"
                },
                {
                    "id": "662200502",
                    "speaker": "阿马佐利",
                    "text": "对对，是这样的。"
                },
                {
                    "id": "662200503",
                    "speaker": "阿马佐利",
                    "text": "暝视龙大长老的全名意为「拥有烟雾色利爪的他」，我的名字「阿马佐利」意为「古老的书籍」。"
                },
                {
                    "id": "662200504",
                    "speaker": "阿马佐利",
                    "text": "所以你看，我现在就在这里，开着一家书店。"
                },
                {
                    "id": "662200505",
                    "speaker": "阿马佐利",
                    "text": "就像萨满们从梦中窥探命运的一角，一切都有迹可循。"
                }
            ]
        }
    ]
}