{
    "groupId": "7549",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "罗迪翁": 8
    },
    "talks": [
        {
            "talkId": "6754901",
            "initDialog": "675490101",
            "dialogues": [
                {
                    "id": "675490101",
                    "speaker": "罗迪翁",
                    "text": "只要仔细、专注、用心去感应，你就能知道它的存在——雪堆里可是深埋着女巫的「大奖」呐！"
                }
            ]
        },
        {
            "talkId": "6754902",
            "initDialog": "675490201",
            "dialogues": [
                {
                    "id": "675490201",
                    "speaker": "Player",
                    "text": "我也能拿到大奖吗？"
                },
                {
                    "id": "675490202",
                    "speaker": "罗迪翁",
                    "text": "当然，作为「女巫」的代理人，我会为你提供指引。不过，注意——你只有<color=#00E1FFFF>五次机会</color>来获得大奖…"
                }
            ]
        },
        {
            "talkId": "6754903",
            "initDialog": "675490301",
            "dialogues": [
                {
                    "id": "675490301",
                    "speaker": "Player",
                    "text": "哇，好多霜精围着你。"
                },
                {
                    "id": "675490302",
                    "speaker": "罗迪翁",
                    "text": "这些小家伙啊…以前我在大街上扫雪的时候，总是能遇到意外被困住的霜精。我帮了它们，所以那时候它们就总跟着我了。"
                },
                {
                    "id": "675490303",
                    "speaker": "罗迪翁",
                    "text": "现在我退休啦，不在大街上晃来晃去了，这些小家伙们也就来陪着我，围着我的摊子转。"
                }
            ]
        },
        {
            "talkId": "6754904",
            "initDialog": "675490401",
            "dialogues": [
                {
                    "id": "675490401",
                    "speaker": "Player",
                    "text": "现在暂时没空…"
                },
                {
                    "id": "675490402",
                    "speaker": "罗迪翁",
                    "text": "不急，先去忙你自己的事情吧。"
                }
            ]
        },
        {
            "talkId": "6754905",
            "initDialog": "675490501",
            "dialogues": [
                {
                    "id": "675490501",
                    "speaker": "Player",
                    "text": "它们不会捣乱吗？"
                },
                {
                    "id": "675490502",
                    "speaker": "罗迪翁",
                    "text": "哈哈，当然不会，从某种程度来说，它们也是「女巫」——"
                },
                {
                    "id": "675490503",
                    "speaker": "罗迪翁",
                    "text": "它们把雪堆堆成一样的大小，再把自己藏在其中一个雪堆中，每一轮寻宝结束之后，它们还要将被扫开的雪堆复原。"
                },
                {
                    "id": "675490504",
                    "speaker": "罗迪翁",
                    "text": "这些可爱的小家伙，真是省了我不少功夫呢…"
                }
            ]
        }
    ]
}