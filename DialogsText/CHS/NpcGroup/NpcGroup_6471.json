    "talks": [
        {
            "talkId": "6647101",
            "initDialog": "664710101",
            "dialogues": [
                {
                    "id": "664710101",
                    "speaker": "「库库尔坎」",
                    "text": "请问，有什么需要询问的吗？"
                }
            ]
        },
        {
            "talkId": "6647102",
            "initDialog": "664710201",
            "dialogues": [
                {
                    "id": "664710201",
                    "speaker": "「库库尔坎」",
                    "text": "你好，检测到新的数据回收类目。"
                },
                {
                    "id": "664710202",
                    "speaker": "「库库尔坎」",
                    "text": "…检测到了，您身上携带着最初的信息，已对所有的信息进行补全。"
                },
                {
                    "id": "664710203",
                    "speaker": "「库库尔坎」",
                    "text": "感谢，您的协助，我已…通过恢复的数据回想起了我的名字。"
                },
                {
                    "id": "664710204",
                    "speaker": "「库库尔坎」",
                    "text": "那是在制造我的主人，修库特尔大人记忆已出现模糊而扭曲的现象，而他最重视的那位族裔已与他有决裂之势…"
                },
                {
                    "id": "664710205",
                    "speaker": "「库库尔坎」",
                    "text": "或许是为了填补那自诞生就陪伴在修库特尔大人身侧的空白，在我被制造出来那日…"
                },
                {
                    "id": "664710206",
                    "speaker": "「库库尔坎」",
                    "text": "「那你就以『库库尔坎』为名吧，想来那家伙这个时候已经不在意这个名字了…」"
                },
                {
                    "id": "664710207",
                    "speaker": "「库库尔坎」",
                    "text": "所以，我并非无名的秘源龙仆…我的名字是…"
                },
                {
                    "id": "664710208",
                    "speaker": "「库库尔坎」",
                    "text": "「库库尔坎」。"
                }
            ]
        },
        {
            "talkId": "6647103",
            "initDialog": "664710301",
            "dialogues": [
                {
                    "id": "664710301",
                    "speaker": "Player",
                    "text": "访问已经恢复的数据…"
                },
                {
                    "id": "664710302",
                    "speaker": "「库库尔坎」",
                    "text": "正在为您读取相应的内容…请问您需要访问的记录是？"
                }
            ]
        },
        {
            "talkId": "6647104",
            "initDialog": "664710401",
            "dialogues": [
                {
                    "id": "664710401",
                    "speaker": "Player",
                    "text": "没什么要问的了…"
                },
                {
                    "id": "664710402",
                    "speaker": "「库库尔坎」",
                    "text": "好的。"
                }
            ]
        },
        {
            "talkId": "6647105",
            "initDialog": "664710501",
            "dialogues": [
                {
                    "id": "664710501",
                    "speaker": "Player",
                    "text": "关于「制作龙仆…」的记录…"
                },
                {
                    "id": "664710502",
                    "speaker": "「库库尔坎」",
                    "text": "好的，正在为您读取。"
                },
                {
                    "id": "664710503",
                    "speaker": "「库库尔坎」",
                    "text": "记录播放完毕。"
                }
            ]
        },
