{
    "groupId": "4375",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "加斯顿": 9
    },
    "talks": [
        {
            "talkId": "6437501",
            "initDialog": "643750101",
            "dialogues": [
                {
                    "id": "643750101",
                    "speaker": "加斯顿",
                    "text": "等他们说的那位「老爷」回来，我必须要问这些问题…"
                }
            ]
        },
        {
            "talkId": "6437502",
            "initDialog": "643750201",
            "dialogues": [
                {
                    "id": "643750201",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "643750202",
                    "speaker": "加斯顿",
                    "text": "我从枫丹千里迢迢来到这里，就是为了采访这幢豪宅的主人。"
                },
                {
                    "id": "643750203",
                    "speaker": "加斯顿",
                    "text": "我四处打听，所有人都在赞美这座建筑的设计者，却没有人知道主人是谁。"
                },
                {
                    "id": "643750204",
                    "speaker": "加斯顿",
                    "text": "这…难道不是明摆着的新闻话题嘛！"
                },
                {
                    "id": "643750205",
                    "speaker": "加斯顿",
                    "text": "虽然我只是《蒸汽鸟报》的见习记者，但也不能畏首畏尾。想写出吸引人的新闻，就要做第一个吃飘浮灵的人才行！"
                },
                {
                    "id": "643750206",
                    "speaker": "加斯顿",
                    "text": "所以无论多难，我也要见到这栋房子的主人！"
                }
            ]
        },
        {
            "talkId": "6437503",
            "initDialog": "643750301",
            "dialogues": [
                {
                    "id": "643750301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643750302",
                    "speaker": "加斯顿",
                    "text": "这就走了？那再见吧，我还要再待一阵。"
                }
            ]
        },
        {
            "talkId": "7396301",
            "initDialog": "739630101",
            "dialogues": [
                {
                    "id": "739630101",
                    "speaker": "Player",
                    "text": "贵在坚持！"
                },
                {
                    "id": "739630102",
                    "speaker": "加斯顿",
                    "text": "你说得对！"
                },
                {
                    "id": "739630103",
                    "speaker": "加斯顿",
                    "text": "我的前辈也是这样教导我的：记者也要有冒险家的精神，才能写出最劲爆的大新闻！"
                }
            ]
        }
    ]
}