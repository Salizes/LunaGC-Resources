{
    "groupId": "17041",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 2,
        "昂吉安妮": 10,
        "蒂蕾娜": 9
    },
    "talks": [
        {
            "talkId": "7668307",
            "initDialog": "766830701",
            "dialogues": [
                {
                    "id": "766830701",
                    "speaker": "蒂蕾娜",
                    "text": "真的不再打一场了吗，教官？"
                },
                {
                    "id": "766830702",
                    "speaker": "昂吉安妮",
                    "text": "我已经打出最佳成绩了，你也看到了嘛，我有点打不动了，在花哨的新推演面前，只能勉强及格…"
                },
                {
                    "id": "766830703",
                    "speaker": "蒂蕾娜",
                    "text": "但及格线是夏沃蕾队长的成绩的六成呀！除了你，大家全都不及格了呀，哪有什么打不动…",
                    "choices": [
                        {
                            "id": "766830704",
                            "text": "（继续听听…）",
                            "response": [
                                {
                                    "id": "766830705",
                                    "speaker": "蒂蕾娜",
                                    "text": "你现在不打的话，以后就再也看不到你拿铳枪的样子了。"
                                },
                                {
                                    "id": "766830706",
                                    "speaker": "蒂蕾娜",
                                    "text": "我都完全没感觉，时间过得这么快…"
                                },
                                {
                                    "id": "766830707",
                                    "speaker": "蒂蕾娜",
                                    "text": "呜…呜呜…"
                                },
                                {
                                    "id": "766830708",
                                    "speaker": "昂吉安妮",
                                    "text": "哎？你这小妞，哭什么？"
                                },
                                {
                                    "id": "766830709",
                                    "speaker": "昂吉安妮",
                                    "text": "只是退役了而已，又不是再也不见面了！"
                                },
                                {
                                    "id": "766830710",
                                    "speaker": "昂吉安妮",
                                    "text": "想见我还不容易，找个店，每周请我吃顿饭。"
                                },
                                {
                                    "id": "766830711",
                                    "speaker": "蒂蕾娜",
                                    "text": "好好好，不止黄油汐藻，你想吃德波大饭店都行！"
                                },
                                {
                                    "id": "766830712",
                                    "speaker": "蒂蕾娜",
                                    "text": "但…不能每周…每个月一次吧？"
                                },
                                {
                                    "id": "766830713",
                                    "speaker": "昂吉安妮",
                                    "text": "无所谓啦，你安排什么，我都能接受。"
                                },
                                {
                                    "id": "766830714",
                                    "speaker": "昂吉安妮",
                                    "text": "不过，说正经的…以后我们这一拨的新人，全都交给你了。"
                                },
                                {
                                    "id": "766830715",
                                    "speaker": "昂吉安妮",
                                    "text": "要好好看住玛因和萝克珊，防止她们工作得太忘我。"
                                },
                                {
                                    "id": "766830716",
                                    "speaker": "昂吉安妮",
                                    "text": "也别让新人输给当年的你自己啊，但凡他们有一点怠惰，就狠狠踢他们的屁股！"
                                },
                                {
                                    "id": "766830717",
                                    "speaker": "蒂蕾娜",
                                    "text": "我会的！狠狠踢他们的屁股！"
                                },
                                {
                                    "id": "766830718",
                                    "speaker": "昂吉安妮",
                                    "text": "那好哦，我的妹妹们叫我去纳塔度假，可能之后有那么两个月不在枫丹…"
                                },
                                {
                                    "id": "766830719",
                                    "speaker": "昂吉安妮",
                                    "text": "度假一回来，我就要来检查你的成果！"
                                },
                                {
                                    "id": "766830720",
                                    "speaker": "蒂蕾娜",
                                    "text": "一定不会让你失望的，教官！"
                                }
                            ]
                        },
                        {
                            "id": "766830721",
                            "text": "（还是让她们单独聊吧…）"
                        }
                    ]
                }
            ]
        }
    ]
}