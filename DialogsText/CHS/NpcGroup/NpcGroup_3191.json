{
    "groupId": "3191",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "山城健太": 16
    },
    "talks": [
        {
            "talkId": "6319101",
            "initDialog": "631910101",
            "dialogues": [
                {
                    "id": "631910101",
                    "speaker": "山城健太",
                    "text": "客人你好，欢迎光临！"
                },
                {
                    "id": "631910102",
                    "speaker": "山城健太",
                    "text": "目前店内正在进行有奖征集活动，怎么样，有兴趣参加不？"
                }
            ]
        },
        {
            "talkId": "6319102",
            "initDialog": "631910201",
            "dialogues": [
                {
                    "id": "631910201",
                    "speaker": "Player",
                    "text": "看看货？"
                },
                {
                    "id": "631910202",
                    "speaker": "山城健太",
                    "text": "没问题，都是我从海祇岛带来的特选商品，欢迎选购！"
                }
            ]
        },
        {
            "talkId": "6319103",
            "initDialog": "631910301",
            "dialogues": [
                {
                    "id": "631910301",
                    "speaker": "Player",
                    "text": "都卖些什么？"
                },
                {
                    "id": "631910302",
                    "speaker": "山城健太",
                    "text": "我是从海祇岛过来的，在离岛新开了这家店，招牌商品就是这些圆润又有光泽的「海祇真珠」，是送礼或者打造首饰的上好材料。"
                },
                {
                    "id": "631910303",
                    "speaker": "山城健太",
                    "text": "另外还有些海祇岛的渔民朋友在这里寄卖的鳗肉。毕竟我家祖上也是渔民，就当帮街坊邻居的忙了。"
                },
                {
                    "id": "631910304",
                    "speaker": "山城健太",
                    "text": "我家的鳗肉价格实惠，而且在离岛是罕见的海货，果然卖得不错，哈哈！薄利多销，生意才能做得长久嘛。"
                },
                {
                    "id": "631910305",
                    "speaker": "山城健太",
                    "text": "对了，此外我还带了一些祖上出海打渔时捞上来的古物。若您是识货的客人，也可以看看哦。"
                }
            ]
        },
        {
            "talkId": "6319104",
            "initDialog": "631910401",
            "dialogues": [
                {
                    "id": "631910401",
                    "speaker": "Player",
                    "text": "有奖征集？"
                },
                {
                    "id": "631910402",
                    "speaker": "山城健太",
                    "text": "对，是征集店名的有奖活动哦！"
                },
                {
                    "id": "631910403",
                    "speaker": "山城健太",
                    "text": "为了起个受欢迎的店名，也为了顺便宣传店铺，我就想了这么个法子。"
                },
                {
                    "id": "631910404",
                    "speaker": "山城健太",
                    "text": "这里的客人们可真热情啊，已经给我提供了不少点子。"
                },
                {
                    "id": "631910405",
                    "speaker": "山城健太",
                    "text": "只是大部分都是些…过于特别的名字，比如「海祇珠珠」、「摇摇鳗鳗」、「圆圆滚滚亮晶晶」之类的。"
                },
                {
                    "id": "631910406",
                    "speaker": "山城健太",
                    "text": "风格出众虽好，但我还是倾向于更受大众欢迎的版本，所以至今还没定下来。"
                },
                {
                    "id": "631910407",
                    "speaker": "山城健太",
                    "text": "客人若是想到了什么好主意，也请务必来参加活动啊！"
                }
            ]
        },
        {
            "talkId": "6319105",
            "initDialog": "631910501",
            "dialogues": [
                {
                    "id": "631910501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631910502",
                    "speaker": "山城健太",
                    "text": "慢走，欢迎再来哦！"
                }
            ]
        },
        {
            "talkId": "6319106",
            "initDialog": "631910601",
            "dialogues": [
                {
                    "id": "631910601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6319107",
            "initDialog": "631910701",
            "dialogues": [
                {
                    "id": "631910701",
                    "speaker": "山城健太",
                    "text": "好厉害啊，客人，居然用这样的破解之法！"
                }
            ]
        },
        {
            "talkId": "6319108",
            "initDialog": "631910801",
            "dialogues": [
                {
                    "id": "631910801",
                    "speaker": "山城健太",
                    "text": "啊…是不是难度设置得过高了…"
                }
            ]
        }
    ]
}