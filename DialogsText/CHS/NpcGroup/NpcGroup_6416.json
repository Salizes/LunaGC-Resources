{
    "groupId": "6416",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "穆托瓦": 10
    },
    "talks": [
        {
            "talkId": "6641601",
            "initDialog": "664160101",
            "dialogues": [
                {
                    "id": "664160101",
                    "speaker": "穆托瓦",
                    "text": "真奇怪，好像纳塔以外的地方全都看不到…"
                }
            ]
        },
        {
            "talkId": "6641602",
            "initDialog": "664160201",
            "dialogues": [
                {
                    "id": "664160201",
                    "speaker": "Player",
                    "text": "你是说…"
                },
                {
                    "id": "664160202",
                    "speaker": "穆托瓦",
                    "text": "啊，就是之前对战深渊的时候，天上显现出的不知名碎片。"
                },
                {
                    "id": "664160203",
                    "speaker": "穆托瓦",
                    "text": "一开始我们还以为是来自深渊的神秘武器，但那些碎片就只是挂在天上，完全没有要掉下来的样子…"
                },
                {
                    "id": "664160204",
                    "speaker": "穆托瓦",
                    "text": "后来又有人说，那些碎片很像纳塔西部山地中的某样古物。我去探查过一番，的确是很相似的物品。"
                },
                {
                    "id": "664160205",
                    "speaker": "穆托瓦",
                    "text": "哦抱歉，说了这么多却忘记自我介绍，我来自纳塔龙遗物研究协会，正带着任务进行野外考察，可不是在旅游哦。"
                }
            ]
        },
        {
            "talkId": "6641603",
            "initDialog": "664160301",
            "dialogues": [
                {
                    "id": "664160301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664160302",
                    "speaker": "穆托瓦",
                    "text": "慢走，比起天上，还是先看清脚下吧。"
                }
            ]
        },
        {
            "talkId": "6641604",
            "initDialog": "664160401",
            "dialogues": [
                {
                    "id": "664160401",
                    "speaker": "Player",
                    "text": "研究有什么进展吗？"
                },
                {
                    "id": "664160402",
                    "speaker": "穆托瓦",
                    "text": "很遗憾，不仅没有进展，反而增加了疑问：为什么一离开纳塔的领地，就看不到那些碎片了呢？"
                },
                {
                    "id": "664160403",
                    "speaker": "穆托瓦",
                    "text": "在来这里的路上，我沿途问了不少外国人，他们也都露出了疑惑的神情，仿佛从没听说过此事一般。"
                },
                {
                    "id": "664160404",
                    "speaker": "穆托瓦",
                    "text": "也是啊，如果路边有奇怪的异国游客突然说起天上有个你看不到的窟窿，是个人都会觉得可疑吧…"
                },
                {
                    "id": "664160405",
                    "speaker": "穆托瓦",
                    "text": "啊不，不是游客。我是研究员，游客只是比方，比方。"
                }
            ]
        }
    ]
}