{
    "groupId": "9059",
    "total_dialogue_lines": 75,
    "speaker_counts": {
        "Player": 17,
        "鹿野院平藏": 58
    },
    "talks": [
        {
            "talkId": "6905901",
            "initDialog": "690590101",
            "dialogues": [
                {
                    "id": "690590101",
                    "speaker": "鹿野院平藏",
                    "text": "哎呀呀，我的搭档。最近过得怎么样？"
                },
                {
                    "id": "690590102",
                    "speaker": "鹿野院平藏",
                    "text": "要是被卷入奇怪的案件里，要第一时间告诉我哦。"
                }
            ]
        },
        {
            "talkId": "6905902",
            "initDialog": "690590201",
            "dialogues": [
                {
                    "id": "690590201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690590202",
                    "speaker": "鹿野院平藏",
                    "text": "嘿嘿，你真体贴啊。"
                },
                {
                    "id": "690590203",
                    "speaker": "鹿野院平藏",
                    "text": "安心啦，这里宁静悠闲，是比海祇岛还适合度假的好地方呢。"
                },
                {
                    "id": "690590204",
                    "speaker": "鹿野院平藏",
                    "text": "只可惜没有案件，也缺少变数，有点不够刺激。",
                    "choices": [
                        {
                            "id": "690590205",
                            "text": "不好意思…",
                            "response": [
                                {
                                    "id": "690590206",
                                    "speaker": "鹿野院平藏",
                                    "text": "哎呀呀，是我不好，怎么能让你为难呢。"
                                },
                                {
                                    "id": "690590207",
                                    "speaker": "鹿野院平藏",
                                    "text": "这样吧，我有一个好主意。既能作为消遣，也能表达我的歉意。"
                                },
                                {
                                    "id": "690590210",
                                    "speaker": "鹿野院平藏",
                                    "text": "我们来做一个简单的游戏吧！"
                                },
                                {
                                    "id": "690590211",
                                    "speaker": "鹿野院平藏",
                                    "text": "每次你回来的时候，我都来猜猜，你这一天做了什么，吃过些什么，甚至见过哪些人。"
                                },
                                {
                                    "id": "690590212",
                                    "speaker": "鹿野院平藏",
                                    "text": "赢了的话，随便你怎么奖励我。输了的话，我请你吃最好吃的炸串，如何？"
                                }
                            ]
                        },
                        {
                            "id": "690590208",
                            "text": "有什么能为你做的吗？",
                            "response": [
                                {
                                    "id": "690590209",
                                    "speaker": "鹿野院平藏",
                                    "text": "哇，那我就接受你的好意喽。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905903",
            "initDialog": "690590301",
            "dialogues": [
                {
                    "id": "690590301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690590302",
                    "speaker": "鹿野院平藏",
                    "text": "好呀，当然好。我正期待着一展拳脚呢！",
                    "choices": [
                        {
                            "id": "690590303",
                            "text": "拳…什么？",
                            "response": [
                                {
                                    "id": "690590305",
                                    "speaker": "鹿野院平藏",
                                    "text": "哈哈，别误会。你看，我在这里晃悠了有些时间。"
                                },
                                {
                                    "id": "690590306",
                                    "speaker": "鹿野院平藏",
                                    "text": "大到布景风格、场地规划，小到陈列出来的摆件样式…已经从中掌握了不少你的信息哦。"
                                },
                                {
                                    "id": "690590307",
                                    "speaker": "鹿野院平藏",
                                    "text": "据我推断，某些地方的布置，也不一定都是出自你的喜好，很可能是为了来访的朋友专门打造的。"
                                },
                                {
                                    "id": "690590308",
                                    "speaker": "鹿野院平藏",
                                    "text": "证据，以及具体分析的话…",
                                    "choices": [
                                        {
                                            "id": "690590309",
                                            "text": "厉害！不愧是侦探！",
                                            "response": [
                                                {
                                                    "id": "690590310",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "哦？用表扬打断话题吗？"
                                                },
                                                {
                                                    "id": "690590313",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "看来你也有不想被我点破的小秘密呢。"
                                                },
                                                {
                                                    "id": "690590314",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "那就和你聊聊我自己吧。我想想…"
                                                },
                                                {
                                                    "id": "690590315",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "身份和社会关系，你早就听说过了。日常喜好嘛，我们都相处那么久了。"
                                                },
                                                {
                                                    "id": "690590316",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "至于我家里的情况，我猜你也没太大兴趣了解。"
                                                },
                                                {
                                                    "id": "690590317",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "这样吧！我把我的「弱点」告诉你。"
                                                },
                                                {
                                                    "id": "690590318",
                                                    "speaker": "Player",
                                                    "text": "平藏也有弱点吗？"
                                                },
                                                {
                                                    "id": "690590319",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "是啊。别看我平时做出的都是理性分析。但其实，我是个非常容易被「感性」打动的人哦。"
                                                },
                                                {
                                                    "id": "690590320",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "那些不断努力的人身上发出的光芒，会在我的记忆中留下烈焰花一样浓重的色彩。"
                                                },
                                                {
                                                    "id": "690590321",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "为此，我才要努力保护善意不被利用，祝福美丽的事物可以一直美丽下去。"
                                                },
                                                {
                                                    "id": "690590322",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "顺带一提，和你在一起的时候，我也有过很多次这种感觉，「噔」地一下被你打动了。"
                                                },
                                                {
                                                    "id": "690590323",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "嘘！因为是「弱点」，拜托你要好好保密哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690590311",
                                            "text": "我也想掌握你的信息！",
                                            "response": [
                                                {
                                                    "id": "690590312",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "哦？直接岔开话题吗？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690590304",
                            "text": "动嘴还是动手？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905904",
            "initDialog": "690590401",
            "dialogues": [
                {
                    "id": "690590401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690590402",
                    "speaker": "鹿野院平藏",
                    "text": "我正想出去一趟，要不要一起呀？我的搭档。"
                },
                {
                    "id": "690590403",
                    "speaker": "鹿野院平藏",
                    "text": "但行程会有点麻烦呢。得先去町街买点用得上的东西，再去趟城外，最后可能还得回奉行所…"
                },
                {
                    "id": "690590404",
                    "speaker": "Player",
                    "text": "是要去抓犯人吗？"
                },
                {
                    "id": "690590405",
                    "speaker": "鹿野院平藏",
                    "text": "问得好！那当然——不可能。抓捕犯人这种活就留给我专业的同僚们来做。"
                },
                {
                    "id": "690590406",
                    "speaker": "鹿野院平藏",
                    "text": "我是想去探望一些犯人的家属。有老人，也有小孩。"
                },
                {
                    "id": "690590407",
                    "speaker": "鹿野院平藏",
                    "text": "要不是我把决定性的证据抛出来，让他们的亲人入狱，还不至于像这样无依无靠…",
                    "choices": [
                        {
                            "id": "690590408",
                            "text": "不该觉得愧疚…",
                            "response": [
                                {
                                    "id": "690590409",
                                    "speaker": "鹿野院平藏",
                                    "text": "哈哈，你放心，我当然知道该愧疚的是犯人。"
                                },
                                {
                                    "id": "690590410",
                                    "speaker": "鹿野院平藏",
                                    "text": "抓出真凶，原本就是侦探平藏应该做的事。"
                                },
                                {
                                    "id": "690590411",
                                    "speaker": "鹿野院平藏",
                                    "text": "真要说遗憾，嗯…也只是没有更早终结悲剧，从源头上减少犯罪率。"
                                },
                                {
                                    "id": "690590412",
                                    "speaker": "鹿野院平藏",
                                    "text": "但事已至此，在犯人们服刑改正的期间，我就姑且帮忙照看一下他们的家属吧。"
                                },
                                {
                                    "id": "690590417",
                                    "speaker": "鹿野院平藏",
                                    "text": "毕竟扶危济困，与人为善，也是普通人平藏会坚守的原则嘛。",
                                    "choices": [
                                        {
                                            "id": "690590418",
                                            "text": "要带着东西上门探访吗？",
                                            "response": [
                                                {
                                                    "id": "690590419",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "哎呀呀，这可不行。家属们看到我这张脸，脾气不好一点的，说不好就直接打上来喽。"
                                                },
                                                {
                                                    "id": "690590420",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "你看，我的原意是想给他们一些关怀，还是不触碰伤疤为好。"
                                                },
                                                {
                                                    "id": "690590421",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "把东西和信件放门口就走吧。"
                                                },
                                                {
                                                    "id": "690590425",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "那么，等你准备好，我们就出发吧。"
                                                },
                                                {
                                                    "id": "690590426",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "我的直觉告诉我，这一路有你同行，一定会是最顺利、最愉快的一次。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690590422",
                                            "text": "要把东西放门口就走吗？",
                                            "response": [
                                                {
                                                    "id": "690590423",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "真不愧是我的搭档，在我解释之前，就把这一层也想到了。"
                                                },
                                                {
                                                    "id": "690590424",
                                                    "speaker": "鹿野院平藏",
                                                    "text": "你和我如此心有灵犀，再说什么都嫌多喽。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690590413",
                            "text": "原来你那么关心他们…",
                            "response": [
                                {
                                    "id": "690590414",
                                    "speaker": "鹿野院平藏",
                                    "text": "嗯…还原真相，是侦探平藏应该做的事。"
                                },
                                {
                                    "id": "690590415",
                                    "speaker": "鹿野院平藏",
                                    "text": "但在案件侦破之后，至少在舆论上，犯人这边的家人会遭受更多谩骂和歧视。"
                                },
                                {
                                    "id": "690590416",
                                    "speaker": "鹿野院平藏",
                                    "text": "我当然也盼望着他们可以早日摆脱事件的影响，继续好好生活…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905905",
            "initDialog": "690590501",
            "dialogues": [
                {
                    "id": "690590501",
                    "speaker": "Player",
                    "text": "早啊，平藏！"
                },
                {
                    "id": "690590502",
                    "speaker": "鹿野院平藏",
                    "text": "#早！{NICKNAME}。昨晚睡得好吗？做梦了吗，做了什么梦？"
                },
                {
                    "id": "690590503",
                    "speaker": "鹿野院平藏",
                    "text": "哈哈…有空的话，就和我分享分享吧。"
                }
            ]
        },
        {
            "talkId": "6905906",
            "initDialog": "690590601",
            "dialogues": [
                {
                    "id": "690590601",
                    "speaker": "Player",
                    "text": "晚安，平藏。"
                },
                {
                    "id": "690590602",
                    "speaker": "鹿野院平藏",
                    "text": "你看起来有点累啊，快去睡觉吧！疲劳的时候不好好休息，可是很危险的。"
                },
                {
                    "id": "690590603",
                    "speaker": "鹿野院平藏",
                    "text": "呵…糟糕，被传染了，我也觉得有点困了…"
                }
            ]
        },
        {
            "talkId": "6905907",
            "initDialog": "690590701",
            "dialogues": [
                {
                    "id": "690590701",
                    "speaker": "鹿野院平藏",
                    "text": "哦！这不是露天温泉嘛，这蒸腾的水汽，看起来温度就很合适。"
                },
                {
                    "id": "690590702",
                    "speaker": "鹿野院平藏",
                    "text": "泡温泉的时候，灵感也会像蒸汽一样「呼——」地往上升。"
                },
                {
                    "id": "690590703",
                    "speaker": "鹿野院平藏",
                    "text": "这可真是个好东西，看来你也很懂享受嘛。"
                }
            ]
        },
        {
            "talkId": "6905908",
            "initDialog": "690590801",
            "dialogues": [
                {
                    "id": "690590801",
                    "speaker": "鹿野院平藏",
                    "text": "哇…这个布置、这种结构，太棒了！只差一些光效了…"
                },
                {
                    "id": "690590802",
                    "speaker": "鹿野院平藏",
                    "text": "「啪」——灯突然熄灭，「哐哐」——衣柜开始摇晃。嘶哑的声音…隐约从床底的方向传来…"
                },
                {
                    "id": "690590803",
                    "speaker": "鹿野院平藏",
                    "text": "哈哈，是不是很有密室事件的感觉呢？"
                }
            ]
        }
    ]
}