{
    "groupId": "6087",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "塔莫蕾": 15
    },
    "talks": [
        {
            "talkId": "6608701",
            "initDialog": "660870101",
            "dialogues": [
                {
                    "id": "660870101",
                    "speaker": "塔莫蕾",
                    "text": "果然，不等他们是正确的选择。"
                }
            ]
        },
        {
            "talkId": "6608702",
            "initDialog": "660870201",
            "dialogues": [
                {
                    "id": "660870201",
                    "speaker": "Player",
                    "text": "「他们」是？"
                },
                {
                    "id": "660870202",
                    "speaker": "塔莫蕾",
                    "text": "一帮慢吞吞的家伙。我老早就给教令院写了信，叫学院组织考古团队过来。"
                },
                {
                    "id": "660870203",
                    "speaker": "塔莫蕾",
                    "text": "结果不出所料，果然进度缓慢，到现在连个影子都没见到。"
                },
                {
                    "id": "660870204",
                    "speaker": "塔莫蕾",
                    "text": "在纳塔这个三步一个龙遗物十步一个龙遗迹的地方，晚来一天都是莫大的损失！"
                }
            ]
        },
        {
            "talkId": "6608703",
            "initDialog": "660870301",
            "dialogues": [
                {
                    "id": "660870301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660870302",
                    "speaker": "塔莫蕾",
                    "text": "再见，时间不等人啊！"
                }
            ]
        },
        {
            "talkId": "6608704",
            "initDialog": "660870401",
            "dialogues": [
                {
                    "id": "660870401",
                    "speaker": "Player",
                    "text": "所以你擅自行动了？"
                },
                {
                    "id": "660870402",
                    "speaker": "塔莫蕾",
                    "text": "这个得叫「精准捕捉学术时机」。"
                },
                {
                    "id": "660870403",
                    "speaker": "塔莫蕾",
                    "text": "回声之子的人，还有他们的龙伙伴都很擅长挖掘，于是我雇了这位经验丰富的阿基约先生，做我的考古搭档。"
                },
                {
                    "id": "660870404",
                    "speaker": "塔莫蕾",
                    "text": "不是说大话，我们的收获已经够我接下来一年的学术课题参考了。"
                },
                {
                    "id": "660870405",
                    "speaker": "塔莫蕾",
                    "text": "不过还是得抓紧时间。纳塔人可能习惯了在遗迹上生活，常常随手拿起身边的古董就用作日常工具了。"
                },
                {
                    "id": "660870406",
                    "speaker": "塔莫蕾",
                    "text": "…为了阻止他们继续用珍贵的学术材料砌墙，我还是再给教令院写封信催一催吧。"
                }
            ]
        },
        {
            "talkId": "6608705",
            "initDialog": "660870501",
            "dialogues": [
                {
                    "id": "660870501",
                    "speaker": "Player",
                    "text": "所以你擅自行动了？"
                },
                {
                    "id": "660870502",
                    "speaker": "塔莫蕾",
                    "text": "这个得叫「精准捕捉学术时机」。"
                },
                {
                    "id": "660870503",
                    "speaker": "塔莫蕾",
                    "text": "回声之子的人，还有他们的龙伙伴都很擅长挖掘，于是我雇了经验丰富的阿基约先生，做我的考古搭档。"
                },
                {
                    "id": "660870504",
                    "speaker": "塔莫蕾",
                    "text": "…实不相瞒，我是想抓紧时间做研究的。纳塔人总是随手拿起古董就当成工具用起来了，看得人心惊胆战。"
                },
                {
                    "id": "660870505",
                    "speaker": "塔莫蕾",
                    "text": "但最近纳塔的状况你也知道，阿基约之前也带着他的龙去对抗魔物了，我不能因为自己的私事耽误他的任务。"
                },
                {
                    "id": "660870506",
                    "speaker": "塔莫蕾",
                    "text": "而且，似乎我的研究能在战场上帮上他的忙…那真是再好不过的事情了。"
                }
            ]
        }
    ]
}