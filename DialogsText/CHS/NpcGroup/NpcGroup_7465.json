{
    "groupId": "7465",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "吉洪": 6
    },
    "talks": [
        {
            "talkId": "6746501",
            "initDialog": "674650101",
            "dialogues": [
                {
                    "id": "674650101",
                    "speaker": "吉洪",
                    "text": "如果没有要事，请快速通过，不要逗留。"
                }
            ]
        },
        {
            "talkId": "6746502",
            "initDialog": "674650201",
            "dialogues": [
                {
                    "id": "674650201",
                    "speaker": "Player",
                    "text": "…然，然后呢？"
                },
                {
                    "id": "674650202",
                    "speaker": "吉洪",
                    "text": "但如果遇见了什么路面破损，滚石挡道，或是雨后泥泞之类的麻烦…"
                },
                {
                    "id": "674650203",
                    "speaker": "吉洪",
                    "text": "也请来告诉我，我会通知相关人员去修复，然后带着学员去围观的。"
                }
            ]
        },
        {
            "talkId": "6746503",
            "initDialog": "674650301",
            "dialogues": [
                {
                    "id": "674650301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "674650302",
                    "speaker": "吉洪",
                    "text": "感谢你的配合。"
                }
            ]
        },
        {
            "talkId": "6746504",
            "initDialog": "674650401",
            "dialogues": [
                {
                    "id": "674650401",
                    "speaker": "Player",
                    "text": "这也是你的工作吗？"
                },
                {
                    "id": "674650402",
                    "speaker": "吉洪",
                    "text": "不，只是我是工兵出身，对这方面比较在意。"
                },
                {
                    "id": "674650403",
                    "speaker": "吉洪",
                    "text": "谁知道万一打起来，会出什么样的岔子？路面情况得时刻留意才行。"
                }
            ]
        }
    ]
}