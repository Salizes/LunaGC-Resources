{
    "groupId": "4326",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 12,
        "优丹": 22
    },
    "talks": [
        {
            "talkId": "6432601",
            "initDialog": "643260101",
            "dialogues": [
                {
                    "id": "643260101",
                    "speaker": "优丹",
                    "text": "拉娜姐姐可喜欢吃星蕈了！要是能去森林里弄一些就好了…"
                }
            ]
        },
        {
            "talkId": "6432602",
            "initDialog": "643260201",
            "dialogues": [
                {
                    "id": "643260201",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643260202",
                    "speaker": "优丹",
                    "text": "拉娜姐姐可厉害了，我以后，也想跟拉娜姐姐一样，成为巡林官，在森林里到处冒险！"
                }
            ]
        },
        {
            "talkId": "6432603",
            "initDialog": "643260301",
            "dialogues": [
                {
                    "id": "643260301",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "643260302",
                    "speaker": "优丹",
                    "text": "我不知道啦…抱歉，但是真的不能说…"
                }
            ]
        },
        {
            "talkId": "6432604",
            "initDialog": "643260401",
            "dialogues": [
                {
                    "id": "643260401",
                    "speaker": "Player",
                    "text": "关于龙的故事…"
                },
                {
                    "id": "643260402",
                    "speaker": "优丹",
                    "text": "要怎么做，才能成为一条巨龙的朋友呀…如果能成为巨龙的朋友，那一定很了不起吧！"
                }
            ]
        },
        {
            "talkId": "6432605",
            "initDialog": "643260501",
            "dialogues": [
                {
                    "id": "643260501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643260502",
                    "speaker": "优丹",
                    "text": "#嗯，再见，金色的{M#大哥哥}{F#大姐姐}。"
                }
            ]
        },
        {
            "talkId": "6432606",
            "initDialog": "643260601",
            "dialogues": [
                {
                    "id": "643260601",
                    "speaker": "优丹",
                    "text": "我错了，我再也不往森林里乱跑了，拉娜姐姐…"
                }
            ]
        },
        {
            "talkId": "6432607",
            "initDialog": "643260701",
            "dialogues": [
                {
                    "id": "643260701",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643260702",
                    "speaker": "优丹",
                    "text": "拉娜姐姐都是因为我，才会变成现在的样子的…"
                }
            ]
        },
        {
            "talkId": "6432608",
            "initDialog": "643260801",
            "dialogues": [
                {
                    "id": "643260801",
                    "speaker": "Player",
                    "text": "我会尽力帮她的。"
                },
                {
                    "id": "643260802",
                    "speaker": "优丹",
                    "text": "#{M#大哥哥}{F#大姐姐}，拜托你了…"
                }
            ]
        },
        {
            "talkId": "6432609",
            "initDialog": "643260901",
            "dialogues": [
                {
                    "id": "643260901",
                    "speaker": "Player",
                    "text": "她会好起来的…"
                },
                {
                    "id": "643260902",
                    "speaker": "优丹",
                    "text": "真的吗…"
                },
                {
                    "id": "643260903",
                    "speaker": "优丹",
                    "text": "#对了，{M#大哥哥}{F#大姐姐}，能不能不要把拉娜姐姐的事告诉素达蓓和卡乌斯…我不想让他们也担心。"
                },
                {
                    "id": "643260904",
                    "speaker": "优丹",
                    "text": "要是被他们知道了，一定会去偷偷找拉娜姐姐的…可是，现在的森林很危险…"
                }
            ]
        },
        {
            "talkId": "6432610",
            "initDialog": "643261001",
            "dialogues": [
                {
                    "id": "643261001",
                    "speaker": "Player",
                    "text": "我答应你。"
                },
                {
                    "id": "643261002",
                    "speaker": "优丹",
                    "text": "#谢谢你…{M#大哥哥}{F#大姐姐}，求求你了，一定要救拉娜姐姐…呜呜…"
                }
            ]
        },
        {
            "talkId": "6432611",
            "initDialog": "643261101",
            "dialogues": [
                {
                    "id": "643261101",
                    "speaker": "优丹",
                    "text": "拉娜姐姐没事真是太好了，可是，为什么要突然去旅行呢，我也想要旅行…"
                }
            ]
        },
        {
            "talkId": "6432612",
            "initDialog": "643261201",
            "dialogues": [
                {
                    "id": "643261201",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643261202",
                    "speaker": "优丹",
                    "text": "#谢谢你，{M#大哥哥}{F#大姐姐}，都是因为你，拉娜姐姐才能重新醒过来…"
                },
                {
                    "id": "643261203",
                    "speaker": "优丹",
                    "text": "我以后一定会听奶奶、村长爷爷和拉娜姐姐的话，不再去森林里那些危险的地方了。"
                },
                {
                    "id": "643261204",
                    "speaker": "优丹",
                    "text": "然后，我以后一定要好好长大，然后去找拉娜姐姐、找兰拉娜！"
                }
            ]
        },
        {
            "talkId": "6432613",
            "initDialog": "643261301",
            "dialogues": [
                {
                    "id": "643261301",
                    "speaker": "Player",
                    "text": "关于艾方索…"
                },
                {
                    "id": "643261302",
                    "speaker": "优丹",
                    "text": "已经很久都没见过艾方索哥哥了…"
                },
                {
                    "id": "643261303",
                    "speaker": "优丹",
                    "text": "拉娜姐姐和艾方索哥哥，肯定都是有很重要的事要做才离开的。"
                },
                {
                    "id": "643261304",
                    "speaker": "优丹",
                    "text": "我以后一定要好好长大，然后就换我去找他们玩啦！"
                }
            ]
        },
        {
            "talkId": "6432614",
            "initDialog": "643261401",
            "dialogues": [
                {
                    "id": "643261401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643261402",
                    "speaker": "优丹",
                    "text": "#嗯，再见，金色的{M#大哥哥}{F#大姐姐}。"
                }
            ]
        },
        {
            "talkId": "7395001",
            "initDialog": "739500101",
            "dialogues": [
                {
                    "id": "739500101",
                    "speaker": "Player",
                    "text": "加油，优丹。"
                },
                {
                    "id": "739500102",
                    "speaker": "优丹",
                    "text": "#嗯，谢谢{M#大哥哥}{F#大姐姐}！我以后也要变成像{M#大哥哥}{F#大姐姐}这么厉害的人，然后以后我要像拉娜姐姐和{M#大哥哥}{F#大姐姐}来救我那样，去救要帮助的人！"
                },
                {
                    "id": "739500103",
                    "speaker": "优丹",
                    "text": "#对了，{M#大哥哥}{F#大姐姐}，这些星蕈给你吧。拉娜姐姐说，吃了我采的星蕈就会很有精神，{M#大哥哥}{F#大姐姐}也要有精神！"
                }
            ]
        }
    ]
}