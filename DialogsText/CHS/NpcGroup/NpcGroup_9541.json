        },
        {
            "talkId": "6954105",
            "initDialog": "695410501",
            "dialogues": [
                {
                    "id": "695410501",
                    "speaker": "烟绯",
                    "text": "我要把这次的对局作为典型案例记下来…下次，一定是我赢！"
