        },
        {
            "talkId": "6954106",
            "initDialog": "695410601",
            "dialogues": [
                {
                    "id": "695410601",
                    "speaker": "烟绯",
                    "text": "好呀，我刚把规则背得差不多了，来切磋一下吧。"
