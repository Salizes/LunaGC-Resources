        },
        {
            "talkId": "6954103",
            "initDialog": "695410301",
            "dialogues": [
                {
                    "id": "695410301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695410302",
                    "speaker": "烟绯",
                    "text": "你这就要走了吗？我还要再研究一下这卡牌游戏的规则书，这一条是讲什么的来着…"
