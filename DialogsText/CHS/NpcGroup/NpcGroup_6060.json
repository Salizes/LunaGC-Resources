{
    "groupId": "6060",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "夏萝·努伊": 9
    },
    "talks": [
        {
            "talkId": "6606001",
            "initDialog": "660600101",
            "dialogues": [
                {
                    "id": "660600101",
                    "speaker": "夏萝·努伊",
                    "text": "你好！果然伟大的音乐能够吸引伟大的听众！"
                }
            ]
        },
        {
            "talkId": "6606002",
            "initDialog": "660600201",
            "dialogues": [
                {
                    "id": "660600201",
                    "speaker": "Player",
                    "text": "是在夸我吗？"
                },
                {
                    "id": "660600202",
                    "speaker": "夏萝·努伊",
                    "text": "也可以！伟大的队伍很壮大，不介意多一个人加入。"
                },
                {
                    "id": "660600203",
                    "speaker": "夏萝·努伊",
                    "text": "你见过努伊家的人了吗？我也是其中一员哦！"
                },
                {
                    "id": "660600204",
                    "speaker": "夏萝·努伊",
                    "text": "如果还没见过的话，只能说明你是新来的，还不够了解我们部族的生活。"
                },
                {
                    "id": "660600205",
                    "speaker": "夏萝·努伊",
                    "text": "有什么需要帮忙的，来找我家的人！总有一个能帮到你。"
                }
            ]
        },
        {
            "talkId": "6606003",
            "initDialog": "660600301",
            "dialogues": [
                {
                    "id": "660600301",
                    "speaker": "Player",
                    "text": "是在自夸吗？"
                },
                {
                    "id": "660600302",
                    "speaker": "夏萝·努伊",
                    "text": "哦哦，很有眼光嘛。"
                },
                {
                    "id": "660600303",
                    "speaker": "夏萝·努伊",
                    "text": "看在你这么有天赋的份上，我来告诉你点好东西吧！"
                },
                {
                    "id": "660600304",
                    "speaker": "夏萝·努伊",
                    "text": "去找一个叫瓦凯·努伊的人，他会带你在这里玩个痛快的！"
                }
            ]
        },
        {
            "talkId": "6606004",
            "initDialog": "660600401",
            "dialogues": [
                {
                    "id": "660600401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660600402",
                    "speaker": "夏萝·努伊",
                    "text": "下次再见咯！"
                }
            ]
        }
    ]
}