            "dialogues": [
                {
                    "id": "632100101",
                    "speaker": "百日白白音",
                    "text": "有失远迎，非常抱歉！"
                }
            ]
        },
        {
            "talkId": "6321002",
            "initDialog": "632100201",
            "dialogues": [
                {
                    "id": "632100201",
                    "speaker": "Player",
                    "text": "可以预约你的诊疗服务吗？"
                },
                {
                    "id": "632100202",
                    "speaker": "百日白白音",
                    "text": "真的？那真是我的荣幸！"
                },
                {
                    "id": "632100203",
                    "speaker": "百日白白音",
                    "text": "可是，我还要帮这批客人完成登记…如果是瑞希姐姐的话，会怎么做呢？"
                },
                {
                    "id": "632100204",
                    "speaker": "百日白白音",
                    "text": "只能请您先去里面坐一下了，应该会很快的，我加把劲！"
                }
            ]
        },
        {
            "talkId": "6321003",
            "initDialog": "632100301",
            "dialogues": [
                {
                    "id": "632100301",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "632100302",
                    "speaker": "百日白白音",
                    "text": "欸？这怎么可以…"
                },
                {
                    "id": "632100303",
                    "speaker": "百日白白音",
                    "text": "难道是您排队太久，等烦了？非常抱歉！"
                },
                {
                    "id": "632100304",
                    "speaker": "百日白白音",
                    "text": "您可以先找个座位休息一下，我会准备一些糕点。"
                }
            ]
        },
        {
            "talkId": "6321004",
            "initDialog": "632100401",
            "dialogues": [
                {
                    "id": "632100401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "632100402",
                    "speaker": "百日白白音",
                    "text": "欢迎再次光临！"
                }
            ]
        }
    ]
