{
    "groupId": "9041",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Player": 22,
        "莫娜": 48
    },
    "talks": [
        {
            "talkId": "6904101",
            "initDialog": "690410101",
            "dialogues": [
                {
                    "id": "690410101",
                    "speaker": "莫娜",
                    "text": "#欸，{NICKNAME}？居然会在这种时候找我…在我的意料之外啊。"
                },
                {
                    "id": "690410102",
                    "speaker": "莫娜",
                    "text": "咳咳…那么，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6904102",
            "initDialog": "690410201",
            "dialogues": [
                {
                    "id": "690410201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690410202",
                    "speaker": "莫娜",
                    "text": "当然！条件和设施都是一流的，我住得很舒服。"
                },
                {
                    "id": "690410203",
                    "speaker": "莫娜",
                    "text": "甚至…住得太舒服了，有点担心回去之后反而会产生落差…",
                    "choices": [
                        {
                            "id": "690410204",
                            "text": "那莫娜要不要早点回去？",
                            "response": [
                                {
                                    "id": "690410205",
                                    "speaker": "莫娜",
                                    "text": "欸，欸？不要啊——你是认真的吗？"
                                },
                                {
                                    "id": "690410210",
                                    "speaker": "莫娜",
                                    "text": "呃！"
                                },
                                {
                                    "id": "690410211",
                                    "speaker": "莫娜",
                                    "text": "可、可恶！看在你让我白住的份上，我就不跟你斤斤计较了。"
                                },
                                {
                                    "id": "690410212",
                                    "speaker": "莫娜",
                                    "text": "那…之后我也想想办法，随便给你提供点好处吧。"
                                },
                                {
                                    "id": "690410213",
                                    "speaker": "莫娜",
                                    "text": "这样我们就两不相欠了。"
                                }
                            ]
                        },
                        {
                            "id": "690410206",
                            "text": "莫娜可以一直住在这边。",
                            "response": [
                                {
                                    "id": "690410207",
                                    "speaker": "莫娜",
                                    "text": "真，真的吗？"
                                },
                                {
                                    "id": "690410208",
                                    "speaker": "莫娜",
                                    "text": "那么好的地方，不用付房租，还可以一直住下去…我是在做梦吗？"
                                }
                            ]
                        },
                        {
                            "id": "690410209",
                            "text": "「伟大占星术士」的高傲感不见了…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904103",
            "initDialog": "690410301",
            "dialogues": [
                {
                    "id": "690410301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690410302",
                    "speaker": "莫娜",
                    "text": "好呀，现在我心情不错。有什么想要请教我的吗？"
                },
                {
                    "id": "690410303",
                    "speaker": "Player",
                    "text": "想听莫娜分享知识！"
                },
                {
                    "id": "690410304",
                    "speaker": "莫娜",
                    "text": "哦，很好学嘛。"
                },
                {
                    "id": "690410305",
                    "speaker": "莫娜",
                    "text": "我可是很博学的，上知天文下知地理。"
                },
                {
                    "id": "690410306",
                    "speaker": "莫娜",
                    "text": "…不过占星方面的知识，系统性地讲解会费不少时间。"
                },
                {
                    "id": "690410307",
                    "speaker": "莫娜",
                    "text": "干脆，就告诉你一些生活上会用到的实用知识吧！",
                    "choices": [
                        {
                            "id": "690410308",
                            "text": "哦？都有什么呢。",
                            "response": [
                                {
                                    "id": "690410311",
                                    "speaker": "莫娜",
                                    "text": "嗯…比如，临近保质期的食材，只要采用合适的烹饪方式加工熟透，就能吃到性价比很高的一餐。"
                                },
                                {
                                    "id": "690410312",
                                    "speaker": "莫娜",
                                    "text": "很多店每个月都会有打折的时候。找准时机囤些粗粮干货，之后作为主食吃，饱腹感很强。"
                                },
                                {
                                    "id": "690410313",
                                    "speaker": "莫娜",
                                    "text": "还有…自己加工制成肉制品，会比直接买现成的要便宜很多…",
                                    "choices": [
                                        {
                                            "id": "690410314",
                                            "text": "都是省钱方面的知识呢…",
                                            "response": [
                                                {
                                                    "id": "690410315",
                                                    "speaker": "莫娜",
                                                    "text": "呃…呃…"
                                                },
                                                {
                                                    "id": "690410316",
                                                    "speaker": "莫娜",
                                                    "text": "你这样的归纳是很失礼的！"
                                                },
                                                {
                                                    "id": "690410317",
                                                    "speaker": "莫娜",
                                                    "text": "这些都是人生修行中重要的一部分。是对客观世界规律的提炼和总结。"
                                                },
                                                {
                                                    "id": "690410318",
                                                    "speaker": "莫娜",
                                                    "text": "总，总之…我会对你更严格一些。要理解世界之理，你还需要更多修行！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690410319",
                                            "text": "我记下了！",
                                            "response": [
                                                {
                                                    "id": "690410320",
                                                    "speaker": "莫娜",
                                                    "text": "哼哼，你试试就知道，肯定会很有用的。"
                                                },
                                                {
                                                    "id": "690410321",
                                                    "speaker": "莫娜",
                                                    "text": "等你学成之后，我就把更多蕴藏在世界深处的奥秘分享给你吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690410309",
                            "text": "莫娜好像很懂生活的样子…",
                            "response": [
                                {
                                    "id": "690410310",
                                    "speaker": "莫娜",
                                    "text": "那是当然的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904104",
            "initDialog": "690410401",
            "dialogues": [
                {
                    "id": "690410401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690410402",
                    "speaker": "莫娜",
                    "text": "嗯，我想约个你方便的时间，我们一起出去度假吧。"
                },
                {
                    "id": "690410403",
                    "speaker": "Player",
                    "text": "度…度假？"
                },
                {
                    "id": "690410404",
                    "speaker": "莫娜",
                    "text": "不管是无人的海岛还是寂静的雨林，总之，放下工作，享受轻松的时光。",
                    "choices": [
                        {
                            "id": "690410405",
                            "text": "不太像莫娜的作风呢…",
                            "response": [
                                {
                                    "id": "690410406",
                                    "speaker": "莫娜",
                                    "text": "是…是吗。欸，不对，你该不会把我当作死脑筋的研究狂了吧。"
                                },
                                {
                                    "id": "690410407",
                                    "speaker": "莫娜",
                                    "text": "我所做的事情是体察世界的真实，度假…也算是一种实现的方式。"
                                },
                                {
                                    "id": "690410410",
                                    "speaker": "莫娜",
                                    "text": "很久之前，我就开始筹备这个计划。"
                                },
                                {
                                    "id": "690410411",
                                    "speaker": "莫娜",
                                    "text": "攒钱不太容易，所以我专门准备了一个储蓄罐，每次发下稿酬都投些进去。"
                                },
                                {
                                    "id": "690410412",
                                    "speaker": "莫娜",
                                    "text": "期间也忍住了不去买精装版的研究手稿…陆陆续续，终于攒够了。",
                                    "choices": [
                                        {
                                            "id": "690410413",
                                            "text": "真不容易…",
                                            "response": [
                                                {
                                                    "id": "690410414",
                                                    "speaker": "莫娜",
                                                    "text": "没关系，是值得的！"
                                                },
                                                {
                                                    "id": "690410419",
                                                    "speaker": "莫娜",
                                                    "text": "嗯！等着你的消息哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690410415",
                                            "text": "我不能用莫娜的钱。",
                                            "response": [
                                                {
                                                    "id": "690410416",
                                                    "speaker": "莫娜",
                                                    "text": "欸…你的意思是？"
                                                },
                                                {
                                                    "id": "690410417",
                                                    "speaker": "莫娜",
                                                    "text": "谢谢你体谅我！不过，这是我想做的事情，所以没关系。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690410418",
                                            "text": "那我去安排一下时间。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690410408",
                            "text": "莫娜有「经费」吗？…",
                            "response": [
                                {
                                    "id": "690410409",
                                    "speaker": "莫娜",
                                    "text": "哼哼，当然准备好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904105",
            "initDialog": "690410501",
            "dialogues": [
                {
                    "id": "690410501",
                    "speaker": "Player",
                    "text": "早啊，莫娜。"
                },
                {
                    "id": "690410502",
                    "speaker": "莫娜",
                    "text": "哦，早啊。"
                },
                {
                    "id": "690410503",
                    "speaker": "莫娜",
                    "text": "有什么需要的话，我会为你腾出时间。解决不了的事情叫我就好。"
                }
            ]
        },
        {
            "talkId": "6904106",
            "initDialog": "690410601",
            "dialogues": [
                {
                    "id": "690410601",
                    "speaker": "Player",
                    "text": "晚安，莫娜。"
                },
                {
                    "id": "690410602",
                    "speaker": "莫娜",
                    "text": "已经到你休息的时间了吗？唉，对我来说时间总是不够用啊。"
                },
                {
                    "id": "690410603",
                    "speaker": "莫娜",
                    "text": "#晚安了，{NICKNAME}。嗯，你就好好养足精力吧。"
                }
            ]
        },
        {
            "talkId": "6904107",
            "initDialog": "690410701",
            "dialogues": [
                {
                    "id": "690410701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904108",
            "initDialog": "690410801",
            "dialogues": [
                {
                    "id": "690410801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904109",
            "initDialog": "690410901",
            "dialogues": [
                {
                    "id": "690410901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904150",
            "initDialog": "690415001",
            "dialogues": [
                {
                    "id": "690415001",
                    "speaker": "莫娜",
                    "text": "很气派的书房嘛。我也可以使用这里吗？"
                },
                {
                    "id": "690415002",
                    "speaker": "莫娜",
                    "text": "那，买来的星图都可以堆在这里了。"
                },
                {
                    "id": "690415003",
                    "speaker": "莫娜",
                    "text": "嗯…还有一些打折时候买来的杂物。想要充分利用空间的话，值得再好好规划一下。"
                }
            ]
        },
        {
            "talkId": "6904151",
            "initDialog": "690415101",
            "dialogues": [
                {
                    "id": "690415101",
                    "speaker": "莫娜",
                    "text": "让我赶快来研究一下厨房里的这些食材。"
                },
                {
                    "id": "690415102",
                    "speaker": "莫娜",
                    "text": "毕竟，如何在材料有限时烹饪出保证一整天不会饿的食物，可是非常需要智慧的。"
                },
                {
                    "id": "690415103",
                    "speaker": "莫娜",
                    "text": "对了，谢谢你准备这些！不嫌弃的话，你也可以来尝一点。"
                }
            ]
        }
    ]
}