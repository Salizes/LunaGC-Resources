{
    "groupId": "1405",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 4,
        "安娜": 25
    },
    "talks": [
        {
            "talkId": "40153",
            "initDialog": "4015140501",
            "dialogues": [
                {
                    "id": "4015140501",
                    "speaker": "安娜",
                    "text": "你好，请问…咳咳…找我有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "41715",
            "initDialog": "4015140502",
            "dialogues": [
                {
                    "id": "4015140502",
                    "speaker": "安娜",
                    "text": "你在干什么？"
                },
                {
                    "id": "4015140506",
                    "speaker": "安娜",
                    "text": "我在…咳咳…许愿。"
                },
                {
                    "id": "4015140507",
                    "speaker": "安娜",
                    "text": "像这样把硬币投进水池里，然后默念心愿…"
                },
                {
                    "id": "4015140508",
                    "speaker": "安娜",
                    "text": "据说…要有诚心，坚持每天许愿，泉水精灵才会听到…咳…"
                },
                {
                    "id": "4015140509",
                    "speaker": "安娜",
                    "text": "对不起，那个…一直在咳嗽…"
                },
                {
                    "id": "4015140503",
                    "speaker": "安娜",
                    "text": "你的愿望是？"
                },
                {
                    "id": "4015140510",
                    "speaker": "安娜",
                    "text": "啊…我的身体一直不太好。"
                },
                {
                    "id": "4015140511",
                    "speaker": "安娜",
                    "text": "我想要泉水精灵保佑我快点好起来。"
                },
                {
                    "id": "4015140512",
                    "speaker": "安娜",
                    "text": "这样，就不会再给爸爸妈妈，还有安东尼哥哥添麻烦了…"
                }
            ]
        },
        {
            "talkId": "41716",
            "initDialog": "4015140505",
            "dialogues": [
                {
                    "id": "4015140505",
                    "speaker": "安娜",
                    "text": "打扰了。"
                },
                {
                    "id": "4015140517",
                    "speaker": "安娜",
                    "text": "没有的事。"
                },
                {
                    "id": "4015140518",
                    "speaker": "安娜",
                    "text": "旅行者，希望你的愿望…咳咳…也能早日实现。"
                }
            ]
        },
        {
            "talkId": "6140501",
            "initDialog": "614050101",
            "dialogues": [
                {
                    "id": "614050101",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614050102",
                    "speaker": "安娜",
                    "text": "咳咳…其实在龙灾来临时我偷偷对泉水精灵许愿，希望泉水精灵能保佑蒙德平安。"
                },
                {
                    "id": "614050103",
                    "speaker": "安娜",
                    "text": "现在龙灾结束，蒙德城也安全了，是不是意味着泉水精灵是真的存在的呢？"
                },
                {
                    "id": "614050104",
                    "speaker": "安娜",
                    "text": "希望泉水精灵能早日让我健康起来，这样我也能减轻一些家人们的负担，咳咳…"
                }
            ]
        },
        {
            "talkId": "6140502",
            "initDialog": "614050201",
            "dialogues": [
                {
                    "id": "614050201",
                    "speaker": "安娜",
                    "text": "多亏了安东尼哥哥，还有泉水精灵的祝福，我的身体才能好转…"
                }
            ]
        },
        {
            "talkId": "6140503",
            "initDialog": "614050301",
            "dialogues": [
                {
                    "id": "614050301",
                    "speaker": "Player",
                    "text": "还没完全痊愈吗…"
                },
                {
                    "id": "614050302",
                    "speaker": "安娜",
                    "text": "是啊，还没有完全痊愈，偶尔还是会咳嗽，但是比之前还是好多啦。"
                },
                {
                    "id": "614050303",
                    "speaker": "安娜",
                    "text": "真希望我的病能快点完全痊愈…这样就不会再给安东尼哥哥他们添麻烦了。"
                },
                {
                    "id": "614050304",
                    "speaker": "安娜",
                    "text": "然后，我也能去做一些自己想做的事…"
                }
            ]
        },
        {
            "talkId": "6140504",
            "initDialog": "614050401",
            "dialogues": [
                {
                    "id": "614050401",
                    "speaker": "Player",
                    "text": "泉水精灵？"
                },
                {
                    "id": "614050402",
                    "speaker": "安娜",
                    "text": "嗯，听安东尼哥哥说，他是从璃月港拿到的那副药方。"
                },
                {
                    "id": "614050403",
                    "speaker": "安娜",
                    "text": "能在那么远的地方顺利拿到药方…我想，说不定是泉水精灵听到了我的愿望…"
                },
                {
                    "id": "614050404",
                    "speaker": "安娜",
                    "text": "是她悄悄地护佑着安东尼哥哥，让他顺利地取到了药方呢。"
                },
                {
                    "id": "614050405",
                    "speaker": "安娜",
                    "text": "等我的病完全痊愈之后，一定要先去一趟清泉镇才行…"
                }
            ]
        },
        {
            "talkId": "6140505",
            "initDialog": "614050501",
            "dialogues": [
                {
                    "id": "614050501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614050502",
                    "speaker": "安娜",
                    "text": "再见。我的愿望已经快实现了，希望你的愿望也能早日实现。"
                }
            ]
        }
    ]
}