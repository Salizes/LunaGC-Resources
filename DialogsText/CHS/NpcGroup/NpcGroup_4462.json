{
    "groupId": "4462",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 7,
        "格蕾欣": 16
    },
    "talks": [
        {
            "talkId": "6446201",
            "initDialog": "644620101",
            "dialogues": [
                {
                    "id": "644620101",
                    "speaker": "格蕾欣",
                    "text": "欸呀，欢迎到这里来稍作休憩…这里是琉形蜃境中的餐厅，我是格蕾欣，算是这里的负责人。"
                }
            ]
        },
        {
            "talkId": "6446202",
            "initDialog": "644620201",
            "dialogues": [
                {
                    "id": "644620201",
                    "speaker": "Player",
                    "text": "你好。原来这里是餐厅…"
                },
                {
                    "id": "644620202",
                    "speaker": "格蕾欣",
                    "text": "对，如果可以的话，就在这儿好好休息一会儿吧。"
                },
                {
                    "id": "644620203",
                    "speaker": "格蕾欣",
                    "text": "在湖边的餐厅，坐在这里的时候还能看到周围湖水的景色，当时在进行选址的时候费了我很大的心思。"
                },
                {
                    "id": "644620204",
                    "speaker": "格蕾欣",
                    "text": "这桌子摆放的角度，椅子的材质和高度，都进行过精心的调整。"
                },
                {
                    "id": "644620205",
                    "speaker": "格蕾欣",
                    "text": "这样也能使用餐的人心情愉悦。"
                }
            ]
        },
        {
            "talkId": "6446203",
            "initDialog": "644620301",
            "dialogues": [
                {
                    "id": "644620301",
                    "speaker": "Player",
                    "text": "嗯，之后我一定会来坐坐！"
                },
                {
                    "id": "644620302",
                    "speaker": "格蕾欣",
                    "text": "那就恭候客人您的光临啦！"
                }
            ]
        },
        {
            "talkId": "6446204",
            "initDialog": "644620401",
            "dialogues": [
                {
                    "id": "644620401",
                    "speaker": "Player",
                    "text": "啊，这里有什么吃的吗…"
                },
                {
                    "id": "644620402",
                    "speaker": "格蕾欣",
                    "text": "那我推荐一下我们最特色的料理吧，不过…用餐的过程有些繁琐，是只属于本餐厅的特殊用餐礼仪。"
                },
                {
                    "id": "644620403",
                    "speaker": "格蕾欣",
                    "text": "首先，得麻烦客人您取来水…"
                }
            ]
        },
        {
            "talkId": "6446205",
            "initDialog": "644620501",
            "dialogues": [
                {
                    "id": "644620501",
                    "speaker": "Player",
                    "text": "说到用餐…"
                },
                {
                    "id": "644620502",
                    "speaker": "格蕾欣",
                    "text": "那我推荐一下我们最特色的料理吧，不过…用餐的过程有些繁琐，是只属于本餐厅的特殊用餐礼仪。"
                },
                {
                    "id": "644620503",
                    "speaker": "格蕾欣",
                    "text": "首先，得麻烦客人您取来水…"
                }
            ]
        },
        {
            "talkId": "6446206",
            "initDialog": "644620601",
            "dialogues": [
                {
                    "id": "644620601",
                    "speaker": "Player",
                    "text": "要用来洗手吗？"
                },
                {
                    "id": "644620602",
                    "speaker": "格蕾欣",
                    "text": "不，是要放入锅中。然后请客人往锅里加自己喜欢的食材…"
                },
                {
                    "id": "644620603",
                    "speaker": "格蕾欣",
                    "text": "最重要的过程是等待，闭上眼等待香味从锅中飘出以后，本餐厅的特色料理就完成了。"
                }
            ]
        },
        {
            "talkId": "6446207",
            "initDialog": "644620701",
            "dialogues": [
                {
                    "id": "644620701",
                    "speaker": "Player",
                    "text": "清洁确实很重要。"
                },
                {
                    "id": "644620702",
                    "speaker": "格蕾欣",
                    "text": "不，是要放入锅中。然后请客人往锅里加自己喜欢的食材…"
                },
                {
                    "id": "644620703",
                    "speaker": "格蕾欣",
                    "text": "最重要的过程是等待，闭上眼等待香味从锅中飘出以后，本餐厅的特色料理就完成了。"
                }
            ]
        },
        {
            "talkId": "6446208",
            "initDialog": "644620801",
            "dialogues": [
                {
                    "id": "644620801",
                    "speaker": "Player",
                    "text": "咦，这不就是我自己做？"
                },
                {
                    "id": "644620802",
                    "speaker": "格蕾欣",
                    "text": "欸呀…果然还是瞒不住吗？"
                },
                {
                    "id": "644620803",
                    "speaker": "格蕾欣",
                    "text": "嘿嘿，本来是想要成为厨师的，但是实在是没有这个天赋…就算在餐厅的布置上精益求精，果然餐厅没有吃的还是不行啊。"
                }
            ]
        }
    ]
}