{
    "groupId": "30254",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Player": 9,
        "撒比特": 27,
        "派蒙": 11
    },
    "talks": [
        {
            "talkId": "4008121",
            "initDialog": "400812101",
            "dialogues": [
                {
                    "id": "400812101",
                    "speaker": "撒比特",
                    "text": "世事无常，世事无常啊…",
                    "choices": [
                        {
                            "id": "400812102",
                            "text": "你是…",
                            "response": [
                                {
                                    "id": "400812103",
                                    "speaker": "撒比特",
                                    "text": "无足轻重的小人物罢了，像我这样的「镀金旅团」成员，你去城外采一株须弥蔷薇的功夫，大概就能碰见好几个吧。"
                                },
                                {
                                    "id": "400812104",
                                    "speaker": "撒比特",
                                    "text": "海妮耶大概也忘了，她当年还帮过我这么一号人物。"
                                },
                                {
                                    "id": "400812105",
                                    "speaker": "派蒙",
                                    "text": "咦，你也认识海妮耶吗？"
                                },
                                {
                                    "id": "400812106",
                                    "speaker": "撒比特",
                                    "text": "准确来说，我认识她，她不认识我。她救过我的命，我还无以回报。"
                                },
                                {
                                    "id": "400812107",
                                    "speaker": "派蒙",
                                    "text": "可海妮耶说，自己只是个普通的驯兽师，难道她本来也很能打吗？"
                                },
                                {
                                    "id": "400812108",
                                    "speaker": "撒比特",
                                    "text": "不，正是她那卓越的驯兽技巧救了我一命。"
                                },
                                {
                                    "id": "400812109",
                                    "speaker": "撒比特",
                                    "text": "当年，我曾负责接收敌对团体的驮兽，那些驮兽只认原来的主人，将我视为死敌，差点把我全身的骨头都撞碎。"
                                },
                                {
                                    "id": "400812110",
                                    "speaker": "撒比特",
                                    "text": "好在海妮耶及时到场，用特别的技巧安抚了暴躁的驮兽，我才捡回一条命。当时她连我的谢礼都没收，只说这是她分内的工作。"
                                },
                                {
                                    "id": "400812111",
                                    "speaker": "派蒙",
                                    "text": "居，居然还有这种事…"
                                },
                                {
                                    "id": "400812112",
                                    "speaker": "Player",
                                    "text": "真好心！"
                                },
                                {
                                    "id": "400812113",
                                    "speaker": "撒比特",
                                    "text": "嗯，不仅如此，有些驮兽也曾被丘丘人蛊惑，敌视普通人类。如果吃下的饲料里混入了奇怪的蘑菇，驮兽也有可能莫名其妙地生气。"
                                },
                                {
                                    "id": "400812114",
                                    "speaker": "撒比特",
                                    "text": "这种时候，就要让海妮耶上场了。她总有办法让驮兽们不敌视她，一般只需要半天，被她训练后的驮兽就会变得温顺了。"
                                },
                                {
                                    "id": "400812115",
                                    "speaker": "派蒙",
                                    "text": "原来海妮耶随口带过的工作，居然有这么大的力量…真的好厉害！"
                                },
                                {
                                    "id": "400812116",
                                    "speaker": "撒比特",
                                    "text": "温顺的驮兽无论在「镀金旅团」还是在普通的商人那里，都能开出很不错的价格，但海妮耶的佣金却很低廉。"
                                },
                                {
                                    "id": "400812117",
                                    "speaker": "撒比特",
                                    "text": "她似乎很喜欢和动物们沟通，对「驯兽」这门事业的热爱大过钱财。正是因此，我才不知道该怎么报答海妮耶…"
                                },
                                {
                                    "id": "400812118",
                                    "speaker": "Player",
                                    "text": "我们也很好奇。"
                                },
                                {
                                    "id": "400812119",
                                    "speaker": "派蒙",
                                    "text": "对哦，海妮耶也帮过我们呢，我们想给她回礼！"
                                },
                                {
                                    "id": "400812120",
                                    "speaker": "撒比特",
                                    "text": "哈，那我们就一起努力吧，争取更了解这位令人尊敬的驯兽师。"
                                },
                                {
                                    "id": "400812121",
                                    "speaker": "撒比特",
                                    "text": "不过，一段时间不见，海妮耶的性格似乎发生了一点变化，不知道她是不是还像以前那样好说话。"
                                }
                            ]
                        },
                        {
                            "id": "400812122",
                            "text": "请别太难过…",
                            "response": [
                                {
                                    "id": "400812123",
                                    "speaker": "派蒙",
                                    "text": "唔，你碰见了什么不如意的事吗？不要太伤心哦，坏事总会过去的，你一定会有走运的时候！"
                                },
                                {
                                    "id": "400812124",
                                    "speaker": "撒比特",
                                    "text": "哦，两位大人物，没想到我居然能引起你们的注意。"
                                },
                                {
                                    "id": "400812125",
                                    "speaker": "撒比特",
                                    "text": "我并没有难过，只是有点感慨罢了。这样的变化未必是坏事…"
                                },
                                {
                                    "id": "400812126",
                                    "speaker": "撒比特",
                                    "text": "对于海妮耶而言，适当拿出强硬的气场，确实对她的职业生涯更有利。"
                                },
                                {
                                    "id": "400812127",
                                    "speaker": "派蒙",
                                    "text": "海妮耶？强硬的气场？…"
                                },
                                {
                                    "id": "400812128",
                                    "speaker": "撒比特",
                                    "text": "简单来说，对于才华卓越的驯兽师而言，有时需要一些「威严」，让某些人对她心怀畏惧，防止被他们算计。"
                                },
                                {
                                    "id": "400812129",
                                    "speaker": "撒比特",
                                    "text": "以前的海妮耶是个开朗、活泼，心情都写在脸上的人。这也让人担心，她会不会被抱着坏心思的人读懂后利用。"
                                },
                                {
                                    "id": "400812130",
                                    "speaker": "撒比特",
                                    "text": "现在看来，海妮耶似乎经历了某些事情，至少会把自己的想法隐藏起来了，让人稍微放心了一点。"
                                },
                                {
                                    "id": "400812131",
                                    "speaker": "派蒙",
                                    "text": "我听不太懂…但又好像明白了你的意思。",
                                    "choices": [
                                        {
                                            "id": "400812132",
                                            "text": "我也没懂。",
                                            "response": [
                                                {
                                                    "id": "400812134",
                                                    "speaker": "撒比特",
                                                    "text": "不好意思，一下子说太多了。你们就当是…一个没用的老大哥在为有恩于自己的年轻人瞎操心吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400812133",
                                            "text": "有点道理。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400812135",
                            "text": "你也是选手吗？",
                            "response": [
                                {
                                    "id": "400812136",
                                    "speaker": "撒比特",
                                    "text": "那倒不是，请把我当成一个利益相关的看客吧。"
                                },
                                {
                                    "id": "400812137",
                                    "speaker": "派蒙",
                                    "text": "利益相关？这个词听起来好严重！"
                                },
                                {
                                    "id": "400812138",
                                    "speaker": "撒比特",
                                    "text": "确实，毕竟这场比赛有可能让我丢了饭碗。"
                                },
                                {
                                    "id": "400812139",
                                    "speaker": "撒比特",
                                    "text": "你们应该听说了吧，那个叫考特里亚的家伙，想要让受过训练的蕈兽取代一部分佣兵，去保护重要的区域，或执行危险的工作。"
                                },
                                {
                                    "id": "400812140",
                                    "speaker": "撒比特",
                                    "text": "但佣兵面对的环境相当复杂，需要大量经验和临场判断，且不说蕈兽能不能胜任这份工作，万一被不法之徒给利用了呢？"
                                },
                                {
                                    "id": "400812141",
                                    "speaker": "派蒙",
                                    "text": "真有这回事吗？我们完全没听说过呢。"
                                },
                                {
                                    "id": "400812142",
                                    "speaker": "派蒙",
                                    "text": "但是，好不容易熟悉的蕈兽伙伴，确实不应该被派去和其他魔物打架吧，那个考特里亚到底是怎么想的…"
                                },
                                {
                                    "id": "400812143",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "400812144",
                                    "speaker": "撒比特",
                                    "text": "要不是听说了这件事，我就能抱着轻松的心态看戏了。"
                                },
                                {
                                    "id": "400812145",
                                    "speaker": "撒比特",
                                    "text": "希望那个赞助比赛的富商能明事理吧。我看他举手投足间有一股淡淡的杀气，想必也经历过大风大浪。"
                                },
                                {
                                    "id": "400812146",
                                    "speaker": "撒比特",
                                    "text": "他应该能明白，关键时刻，最可靠的永远是人，而不是被训练过的野兽或魔物。"
                                }
                            ]
                        },
                        {
                            "id": "400812147",
                            "text": "还是不要打扰他了吧…"
                        }
                    ]
                }
            ]
        }
    ]
}