    "talks": [
        {
            "talkId": "6755501",
            "initDialog": "675550101",
            "dialogues": [
                {
                    "id": "675550101",
                    "speaker": "沙塔洛夫",
                    "text": "我跟你说，要、要不是我…在关键的时刻…拽、拽住了网绳…"
                },
                {
                    "id": "675550102",
                    "speaker": "沙塔洛夫",
                    "text": "那条大章鱼…肯定会把、把「海沙皇号」整个掀翻…"
                },
                {
                    "id": "675550103",
                    "speaker": "戈尔恰科夫",
                    "text": "厉害啊…兄、兄弟，早知道这次我也…嗝…我也和你们一起出海啦。"
                },
                {
                    "id": "675550104",
                    "speaker": "戈尔恰科夫",
                    "text": "要不是…要不是家里的鱼没晒，被老妈子催得紧，我也、我也一起去。"
                },
                {
                    "id": "675550105",
                    "speaker": "沙塔洛夫",
                    "text": "哎呀，下次总有机会的嘛…"
                },
                {
                    "id": "675550106",
                    "speaker": "戈尔恰科夫",
                    "text": "说得对，下次我也找…瓦洁丝卡娅…不说了，来来、再干一杯！"
                },
                {
                    "id": "675550107",
                    "speaker": "沙塔洛夫",
                    "text": "干杯！"
                }
            ]
        }
    ]
}