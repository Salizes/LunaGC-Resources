{
    "groupId": "9328",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "魈": 9
    },
    "talks": [
        {
            "talkId": "6932801",
            "initDialog": "693280101",
            "dialogues": [
                {
                    "id": "693280101",
                    "speaker": "魈",
                    "text": "我已习惯与魔物缠斗。"
                },
                {
                    "id": "693280102",
                    "speaker": "魈",
                    "text": "若是要说的话…这激战间隙的片刻清闲，倒让我有些许陌生。"
                },
                {
                    "id": "693280103",
                    "speaker": "魈",
                    "text": "无妨。若你需要，陪你歇息片刻便是。"
                }
            ]
        },
        {
            "talkId": "6932802",
            "initDialog": "693280201",
            "dialogues": [
                {
                    "id": "693280201",
                    "speaker": "魈",
                    "text": "魔物的气息愈发浓重…"
                },
                {
                    "id": "693280202",
                    "speaker": "魈",
                    "text": "接下来的战斗，我一个人应付就行。即使我这么说，你恐怕也不会同意吧。"
                },
                {
                    "id": "693280203",
                    "speaker": "魈",
                    "text": "那便答应我，万万不可松懈。"
                }
            ]
        },
        {
            "talkId": "6932803",
            "initDialog": "693280301",
            "dialogues": [
                {
                    "id": "693280301",
                    "speaker": "魈",
                    "text": "夜叉的事迹被记录成册…但对我和我那些已故的同僚而言，这并非安慰。"
                },
                {
                    "id": "693280302",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "693280303",
                    "speaker": "魈",
                    "text": "倒是海灯节时，看着那些升起的霄灯，我心中才能得以平静。"
                }
            ]
        }
    ]
}