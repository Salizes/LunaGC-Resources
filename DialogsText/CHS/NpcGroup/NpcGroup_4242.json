{
    "groupId": "4242",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "兰纳迦": 11
    },
    "talks": [
        {
            "talkId": "6424201",
            "initDialog": "642420101",
            "dialogues": [
                {
                    "id": "642420101",
                    "speaker": "兰纳迦",
                    "text": "带来了流动的，看不见、摸不到的，「希望」，新的觉王树。"
                }
            ]
        },
        {
            "talkId": "6424202",
            "initDialog": "642420201",
            "dialogues": [
                {
                    "id": "642420201",
                    "speaker": "Player",
                    "text": "你好…"
                },
                {
                    "id": "642420202",
                    "speaker": "兰纳迦",
                    "text": "#你好，那菈{NICKNAME}。"
                },
                {
                    "id": "642420203",
                    "speaker": "兰纳迦",
                    "text": "你们阻止了「无留陀」，让开始枯萎的森林重新茂盛，谢谢你，还有…软蓬蓬白蘑菇飞飞。"
                }
            ]
        },
        {
            "talkId": "6424203",
            "initDialog": "642420301",
            "dialogues": [
                {
                    "id": "642420301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "642420302",
                    "speaker": "兰纳迦",
                    "text": "#再见…那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6424204",
            "initDialog": "642420401",
            "dialogues": [
                {
                    "id": "642420401",
                    "speaker": "兰纳迦",
                    "text": "谢落的记忆，促生的新的朋友，像是「耶然草」一样，兰纳迦觉得。"
                }
            ]
        },
        {
            "talkId": "6424205",
            "initDialog": "642420501",
            "dialogues": [
                {
                    "id": "642420501",
                    "speaker": "Player",
                    "text": "关于「耶然草」…"
                },
                {
                    "id": "642420502",
                    "speaker": "兰纳迦",
                    "text": "已经成为风中的尘灰，「耶然草」，那菈大概是这样看的。"
                },
                {
                    "id": "642420503",
                    "speaker": "兰纳迦",
                    "text": "但是…又都会从森林草木中重新焕发，那些已经飘飞的、深埋的、没有痕迹的绿叶的记忆…每当新的「耶然草」长出新芽。"
                },
                {
                    "id": "642420504",
                    "speaker": "兰纳迦",
                    "text": "#那菈{NICKNAME}和白飞飞也一样，是新朋友，也是老朋友，因为谢落了，又重生了。"
                }
            ]
        },
        {
            "talkId": "6424206",
            "initDialog": "642420601",
            "dialogues": [
                {
                    "id": "642420601",
                    "speaker": "Player",
                    "text": "关于「无郁夷摩」…"
                },
                {
                    "id": "642420602",
                    "speaker": "兰纳迦",
                    "text": "没有了「无留陀」的侵扰，「无郁夷摩」又会重新覆满花与树…在月亮的升起与落下之后。"
                },
                {
                    "id": "642420603",
                    "speaker": "兰纳迦",
                    "text": "#要对那菈{NICKNAME}还有白飞飞道谢，兰纳迦。"
                }
            ]
        },
        {
            "talkId": "6424207",
            "initDialog": "642420701",
            "dialogues": [
                {
                    "id": "642420701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642420702",
                    "speaker": "兰纳迦",
                    "text": "再见，新的朋友。"
                }
            ]
        }
    ]
}