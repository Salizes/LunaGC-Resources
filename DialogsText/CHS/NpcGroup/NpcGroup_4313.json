{
    "groupId": "4313",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "帕纳": 15
    },
    "talks": [
        {
            "talkId": "6431301",
            "initDialog": "643130101",
            "dialogues": [
                {
                    "id": "643130101",
                    "speaker": "帕纳",
                    "text": "你好，欢迎来到须弥城！"
                },
                {
                    "id": "643130102",
                    "speaker": "帕纳",
                    "text": "初次进城的朋友，可以在我这里领取虚空终端。"
                }
            ]
        },
        {
            "talkId": "6431302",
            "initDialog": "643130201",
            "dialogues": [
                {
                    "id": "643130201",
                    "speaker": "Player",
                    "text": "关于虚空终端…"
                },
                {
                    "id": "643130202",
                    "speaker": "帕纳",
                    "text": "虚空是大慈树王大人留给我们的智慧宝库。"
                },
                {
                    "id": "643130203",
                    "speaker": "帕纳",
                    "text": "贤者大人们利用虚空的力量，开发出了虚空终端。大家只要将它佩戴好，就能借助草神大人的智慧，获取自己所需的知识。"
                },
                {
                    "id": "643130204",
                    "speaker": "帕纳",
                    "text": "以前教令院只对须弥人和长期留在须弥的外国人发放「虚空终端」。"
                },
                {
                    "id": "643130205",
                    "speaker": "帕纳",
                    "text": "最近决定对全体旅客发放，希望大家都能感受到树王大人普世的慈爱。"
                }
            ]
        },
        {
            "talkId": "6431303",
            "initDialog": "643130301",
            "dialogues": [
                {
                    "id": "643130301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643130302",
                    "speaker": "帕纳",
                    "text": "祝你在须弥的旅途一路顺风。"
                }
            ]
        },
        {
            "talkId": "6431304",
            "initDialog": "643130401",
            "dialogues": [
                {
                    "id": "643130401",
                    "speaker": "帕纳",
                    "text": "你好！递交申请的话，请给我就好。"
                }
            ]
        },
        {
            "talkId": "6431305",
            "initDialog": "643130501",
            "dialogues": [
                {
                    "id": "643130501",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643130502",
                    "speaker": "帕纳",
                    "text": "啊哈哈，你可能看我有点面熟吧？"
                },
                {
                    "id": "643130503",
                    "speaker": "帕纳",
                    "text": "之前我在须弥城门附近发放虚空终端，所以很多人都认得我，但我不可能记得住每一个人…"
                },
                {
                    "id": "643130504",
                    "speaker": "帕纳",
                    "text": "最近几经调换，我被派到这里来，协助现有的两位贤者和书记官大人的工作了。"
                },
                {
                    "id": "643130505",
                    "speaker": "帕纳",
                    "text": "你也知道，在小吉祥草王大人接管教令院后，这里发生了不少变动，每天要处理来自学者们的各种申请…"
                },
                {
                    "id": "643130506",
                    "speaker": "帕纳",
                    "text": "…顺便还要对付时不时过来打听消息的人。"
                },
                {
                    "id": "643130507",
                    "speaker": "帕纳",
                    "text": "说实话，我还没能完全适应新的工作节奏，只能尽力而为了。"
                }
            ]
        },
        {
            "talkId": "6431306",
            "initDialog": "643130601",
            "dialogues": [
                {
                    "id": "643130601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643130602",
                    "speaker": "帕纳",
                    "text": "祝你一切顺利。"
                }
            ]
        }
    ]
}