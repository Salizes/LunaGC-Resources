{
    "groupId": "2118",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "蒙蒙": 11
    },
    "talks": [
        {
            "talkId": "7194601",
            "initDialog": "719460101",
            "dialogues": [
                {
                    "id": "719460101",
                    "speaker": "Player",
                    "text": "采这么多花会不会不太好…"
                },
                {
                    "id": "719460102",
                    "speaker": "蒙蒙",
                    "text": "啊，蒙蒙做错了，对不起…"
                },
                {
                    "id": "719460103",
                    "speaker": "蒙蒙",
                    "text": "都怪蒙蒙手太笨了…好多花的茎都断了，没法用来编花环了…"
                },
                {
                    "id": "719460104",
                    "speaker": "蒙蒙",
                    "text": "…要不，这些花就送给你吧！"
                },
                {
                    "id": "719460105",
                    "speaker": "蒙蒙",
                    "text": "这样，这些花也有了自己的归宿了。"
                }
            ]
        },
        {
            "talkId": "6211801",
            "initDialog": "621180101",
            "dialogues": [
                {
                    "id": "621180101",
                    "speaker": "蒙蒙",
                    "text": "还差八朵、九朵、十朵…"
                },
                {
                    "id": "621180102",
                    "speaker": "蒙蒙",
                    "text": "…哎呀，十之后手指不够了，怎么办呀？"
                }
            ]
        },
        {
            "talkId": "6211802",
            "initDialog": "621180201",
            "dialogues": [
                {
                    "id": "621180201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "621180202",
                    "speaker": "蒙蒙",
                    "text": "蒙蒙在采花呢！"
                },
                {
                    "id": "621180203",
                    "speaker": "蒙蒙",
                    "text": "蒙蒙想要编一个花环，送给小羽。我们本来说好要一起玩的，但是他爸爸生病了，所以要看茶摊…"
                },
                {
                    "id": "621180204",
                    "speaker": "蒙蒙",
                    "text": "不过蒙蒙老是编坏，所以只好再来采花了。"
                }
            ]
        },
        {
            "talkId": "6211803",
            "initDialog": "621180301",
            "dialogues": [
                {
                    "id": "621180301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621180302",
                    "speaker": "蒙蒙",
                    "text": "再见…"
                },
                {
                    "id": "621180303",
                    "speaker": "蒙蒙",
                    "text": "蒙蒙也该去其他地方采花了，不然这里要被采光了！"
                }
            ]
        }
    ]
}