{
    "groupId": "3189",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Player": 15,
        "「寝子」": 36,
        "派蒙": 8
    },
    "talks": [
        {
            "talkId": "2205001",
            "initDialog": "220500101",
            "dialogues": [
                {
                    "id": "220500101",
                    "speaker": "「寝子」",
                    "text": "喔？是汝等啊，来得正好。"
                },
                {
                    "id": "220500102",
                    "speaker": "「寝子」",
                    "text": "汝等，知道哪里长着一棵大大的，颜色粉粉的，而且还很高很高的树吗？"
                },
                {
                    "id": "220500103",
                    "speaker": "Player",
                    "text": "什、什么？"
                },
                {
                    "id": "220500104",
                    "speaker": "「寝子」",
                    "text": "就是和神社旁边那种花瓣粉粉的树一样，但是长得很高很高的树啊。"
                },
                {
                    "id": "220500105",
                    "speaker": "「寝子」",
                    "text": "那棵树周围，还有很多酥酥麻麻，能让毛变成毛球的东西。"
                },
                {
                    "id": "220500106",
                    "speaker": "派蒙",
                    "text": "酥酥麻麻，能让毛变成毛球的东西…应该是雷元素…"
                },
                {
                    "id": "220500107",
                    "speaker": "Player",
                    "text": "树应该就是樱树了…"
                },
                {
                    "id": "220500108",
                    "speaker": "派蒙",
                    "text": "雷元素和樱树，在稻妻感觉随处可见啊…",
                    "choices": [
                        {
                            "id": "220500109",
                            "text": "那棵树旁边还有什么吗？",
                            "response": [
                                {
                                    "id": "220500111",
                                    "speaker": "「寝子」",
                                    "text": "阿响说那棵树的形状像狐狸。然后，那棵树旁边，还有一座很大很大的「神社」。"
                                },
                                {
                                    "id": "220500112",
                                    "speaker": "「寝子」",
                                    "text": "和那棵树一样，都在很高的地方，神社的下面就是那种酥酥麻麻，能让毛变成毛球的东西。"
                                },
                                {
                                    "id": "220500113",
                                    "speaker": "派蒙",
                                    "text": "很高的樱树和神社，还有雷元素…"
                                },
                                {
                                    "id": "220500114",
                                    "speaker": "派蒙",
                                    "text": "呃！难、难道寝子说的是…"
                                },
                                {
                                    "id": "220500115",
                                    "speaker": "Player",
                                    "text": "鸣神大社的那棵「神樱」。"
                                },
                                {
                                    "id": "220500116",
                                    "speaker": "派蒙",
                                    "text": "嗯，感觉符合这三点的地方，全稻妻也就那么一个地方了呢。但是…"
                                },
                                {
                                    "id": "220500117",
                                    "speaker": "Player",
                                    "text": "为什么要找那棵树？"
                                },
                                {
                                    "id": "220500118",
                                    "speaker": "「寝子」",
                                    "text": "怎么，知道那棵树在哪吗？不愧是奴家相中的人。"
                                },
                                {
                                    "id": "220500119",
                                    "speaker": "「寝子」",
                                    "text": "这是阿响提过的地方。阿响说，她曾经在那附近待过一段时间。"
                                },
                                {
                                    "id": "220500120",
                                    "speaker": "「寝子」",
                                    "text": "而且，她还很喜欢那棵很大很大的树飘下来的花瓣。"
                                },
                                {
                                    "id": "220500121",
                                    "speaker": "「寝子」",
                                    "text": "……"
                                },
                                {
                                    "id": "220500122",
                                    "speaker": "「寝子」",
                                    "text": "奴家想，阿响之所以到现在还没回来，会不会是因为她正在什么地方办事呢？"
                                },
                                {
                                    "id": "220500123",
                                    "speaker": "「寝子」",
                                    "text": "既然阿响暂时不回来，那奴家就过去找她好了。"
                                },
                                {
                                    "id": "220500124",
                                    "speaker": "「寝子」",
                                    "text": "汝等知道那棵树在哪里。请带奴家去看看。"
                                },
                                {
                                    "id": "220500125",
                                    "speaker": "派蒙",
                                    "text": "欸？！那、那神社怎么办？"
                                },
                                {
                                    "id": "220500126",
                                    "speaker": "「寝子」",
                                    "text": "石头人类会代替奴家照料神社的。毋须担心。",
                                    "choices": [
                                        {
                                            "id": "220500127",
                                            "text": "拜托大岛先生了。",
                                            "response": [
                                                {
                                                    "id": "220500129",
                                                    "speaker": "派蒙",
                                                    "text": "#想不到{NICKNAME}也有说出这句话的一天呢…"
                                                },
                                                {
                                                    "id": "220500130",
                                                    "speaker": "派蒙",
                                                    "text": "大岛先生可真是辛苦了啊。那我们就出发吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220500128",
                                            "text": "那就交给他了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220500110",
                            "text": "那棵树有什么特征吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6318901",
            "initDialog": "631890101",
            "dialogues": [
                {
                    "id": "631890101",
                    "speaker": "「寝子」",
                    "text": "哈唔…是人类的气味，真令奴家怀念…"
                },
                {
                    "id": "631890102",
                    "speaker": "「寝子」",
                    "text": "什么嘛，原来不是阿响啊。"
                }
            ]
        },
        {
            "talkId": "6318902",
            "initDialog": "631890201",
            "dialogues": [
                {
                    "id": "631890201",
                    "speaker": "Player",
                    "text": "会说话的猫？"
                },
                {
                    "id": "631890202",
                    "speaker": "「寝子」",
                    "text": "哈唔…真是大惊小怪的人类啊。"
                },
                {
                    "id": "631890203",
                    "speaker": "「寝子」",
                    "text": "猫当然会说话了，只是人类的耳朵立不起来，所以听不懂罢了。"
                }
            ]
        },
        {
            "talkId": "6318903",
            "initDialog": "631890301",
            "dialogues": [
                {
                    "id": "631890301",
                    "speaker": "Player",
                    "text": "阿响是谁？"
                },
                {
                    "id": "631890302",
                    "speaker": "「寝子」",
                    "text": "阿响就是阿响，以前从这个神社里出来的。"
                },
                {
                    "id": "631890303",
                    "speaker": "「寝子」",
                    "text": "自从很久…很久很久之前，打过一场大雷后，阿响就再没回来过了，也就没有人给奴家梳毛了。"
                },
                {
                    "id": "631890304",
                    "speaker": "「寝子」",
                    "text": "在阿响回来之前，奴家会好好打理神社，也会自己好好梳毛的，喵喵。"
                }
            ]
        },
        {
            "talkId": "6318904",
            "initDialog": "631890401",
            "dialogues": [
                {
                    "id": "631890401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "631890402",
                    "speaker": "「寝子」",
                    "text": "喵喵…好久没说人类的话了，奴家有点累…"
                }
            ]
        },
        {
            "talkId": "6318905",
            "initDialog": "631890501",
            "dialogues": [
                {
                    "id": "631890501",
                    "speaker": "「寝子」",
                    "text": "神社看起来比以前好多了，奴家的毛毛也变柔顺了，喵喵。"
                }
            ]
        },
        {
            "talkId": "6318906",
            "initDialog": "631890601",
            "dialogues": [
                {
                    "id": "631890601",
                    "speaker": "Player",
                    "text": "关于神社…"
                },
                {
                    "id": "631890602",
                    "speaker": "「寝子」",
                    "text": "多亏了你们帮忙，神社现在已经很有样子了，阿响回来以后，一定会很高兴。"
                },
                {
                    "id": "631890603",
                    "speaker": "「寝子」",
                    "text": "不过，倒是有件事，奴家觉得很奇怪…"
                },
                {
                    "id": "631890604",
                    "speaker": "「寝子」",
                    "text": "奴家之前出去逛了逛，周围的村子里都没有人了…"
                },
                {
                    "id": "631890605",
                    "speaker": "「寝子」",
                    "text": "喵喵…真奇怪，那些人类都去哪里了呢…"
                }
            ]
        },
        {
            "talkId": "6318907",
            "initDialog": "631890701",
            "dialogues": [
                {
                    "id": "631890701",
                    "speaker": "Player",
                    "text": "关于神社里的人…"
                },
                {
                    "id": "631890702",
                    "speaker": "「寝子」",
                    "text": "奴家能看出来，那些人类都是好人。他们给「塞钱箱」塞了好多好多钱。"
                },
                {
                    "id": "631890703",
                    "speaker": "「寝子」",
                    "text": "那个绿色的人类一直皱着眉毛，念叨个不停，好像是一直在担心着自己让…什么什么协会失望…"
                },
                {
                    "id": "631890704",
                    "speaker": "「寝子」",
                    "text": "那个绿色的、又比较高的人类嘛…唔唔，是个可怕的人类。对猫的弱点，可是了如指掌哪，喵喵…"
                },
                {
                    "id": "631890705",
                    "speaker": "「寝子」",
                    "text": "那个会叮叮当当的人类，虽然很在意工钱…但他对奴家似乎很虔诚，而且他好像还在用木头做猫呢。"
                },
                {
                    "id": "631890706",
                    "speaker": "「寝子」",
                    "text": "都是很好的人哪。等阿响回来，她一定能和他们变成朋友的。喵喵…"
                }
            ]
        },
        {
            "talkId": "6318908",
            "initDialog": "631890801",
            "dialogues": [
                {
                    "id": "631890801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631890802",
                    "speaker": "「寝子」",
                    "text": "再见，喵喵。"
                }
            ]
        },
        {
            "talkId": "6318909",
            "initDialog": "631890901",
            "dialogues": [
                {
                    "id": "631890901",
                    "speaker": "Player",
                    "text": "「镇石」已经封印好了。"
                },
                {
                    "id": "631890902",
                    "speaker": "「寝子」",
                    "text": "喔，汝等，动作很快嘛。"
                },
                {
                    "id": "631890903",
                    "speaker": "「寝子」",
                    "text": "这样子，奴家出去的时候，身上的毛也不会竖起来，或者变成毛球了。"
                },
                {
                    "id": "631890904",
                    "speaker": "「寝子」",
                    "text": "不错，不错，喵喵。"
                }
            ]
        }
    ]
}