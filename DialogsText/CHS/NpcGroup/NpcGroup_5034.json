{
    "groupId": "5034",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "薇塔": 9
    },
    "talks": [
        {
            "talkId": "6503401",
            "initDialog": "650340101",
            "dialogues": [
                {
                    "id": "650340101",
                    "speaker": "薇塔",
                    "text": "要和我一起玩游戏吗？"
                }
            ]
        },
        {
            "talkId": "6503402",
            "initDialog": "650340201",
            "dialogues": [
                {
                    "id": "650340201",
                    "speaker": "Player",
                    "text": "什么游戏？"
                },
                {
                    "id": "650340202",
                    "speaker": "薇塔",
                    "text": "猜存款的游戏。"
                },
                {
                    "id": "650340203",
                    "speaker": "薇塔",
                    "text": "薇塔会说一个数字，你告诉薇塔是高还是低。薇塔一定会在三次以内猜对的。"
                }
            ]
        },
        {
            "talkId": "6503403",
            "initDialog": "650340301",
            "dialogues": [
                {
                    "id": "650340301",
                    "speaker": "Player",
                    "text": "你怎么在这里玩？"
                },
                {
                    "id": "650340302",
                    "speaker": "薇塔",
                    "text": "我的爸爸是来北国银行出差的至冬使节，他不许我跑得太远。"
                },
                {
                    "id": "650340303",
                    "speaker": "薇塔",
                    "text": "喏，北国银行就是发条工坊和钟表店之间的这个地方，很气派吧。"
                },
                {
                    "id": "650340304",
                    "speaker": "薇塔",
                    "text": "爸爸经常教我分辨好人和坏人，所以放心吧，薇塔不会跟着坏人走的。"
                }
            ]
        },
        {
            "talkId": "6503404",
            "initDialog": "650340401",
            "dialogues": [
                {
                    "id": "650340401",
                    "speaker": "Player",
                    "text": "下次吧。"
                },
                {
                    "id": "650340402",
                    "speaker": "薇塔",
                    "text": "好吧，我找其他人玩去。"
                }
            ]
        },
        {
            "talkId": "6503405",
            "initDialog": "650340501",
            "dialogues": [
                {
                    "id": "650340501",
                    "speaker": "Player",
                    "text": "这游戏涉及隐私…"
                },
                {
                    "id": "650340502",
                    "speaker": "薇塔",
                    "text": "咦？你是不相信薇塔吗？薇塔不会把答案说给其他人听的。"
                },
                {
                    "id": "650340503",
                    "speaker": "薇塔",
                    "text": "薇塔只是想知道自己看人准不准嘛。"
                }
            ]
        }
    ]
}