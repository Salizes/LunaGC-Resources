    "talks": [
        {
            "talkId": "6610401",
            "initDialog": "661040109",
            "dialogues": [
                {
                    "id": "661040109",
                    "speaker": "洛娅",
                    "text": "这次你的热身运动做得很到位，值得夸奖。"
                },
                {
                    "id": "661040110",
                    "speaker": "赫伯德",
                    "text": "…但是…？"
                },
                {
                    "id": "661040111",
                    "speaker": "洛娅",
                    "text": "但是，攀岩时发力的身体部位还是很有问题。"
                },
                {
                    "id": "661040101",
                    "speaker": "赫伯德",
                    "text": "啊哈哈，我就知道…"
                },
                {
                    "id": "661040102",
                    "speaker": "洛娅",
                    "text": "先不要忙着泄气，听我讲完。"
                },
                {
                    "id": "661040103",
                    "speaker": "洛娅",
                    "text": "不能因为腿部不协调，就只用手臂发力。怎么能把压力放到本来就有所欠缺的地方上呢。"
                },
                {
                    "id": "661040104",
                    "speaker": "洛娅",
                    "text": "接下来，我们要着重训练手臂，明白了吗？"
                },
                {
                    "id": "661040105",
                    "speaker": "赫伯德",
                    "text": "好的…明白！"
                },
                {
                    "id": "661040106",
                    "speaker": "赫伯德",
                    "text": "…不对，我不是来旅游的吗？怎么突然开始健身了？"
                },
                {
                    "id": "661040107",
                    "speaker": "洛娅",
                    "text": "纳塔这边的旅游项目都是这样的，等你习惯了就好了。"
                },
                {
                    "id": "661040108",
                    "speaker": "赫伯德",
                    "text": "这样啊…真的吗？"
                }
            ]
        }
    ]
}