{
    "groupId": "7573",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "茹拉廖夫": 14
    },
    "talks": [
        {
            "talkId": "6757301",
            "initDialog": "675730101",
            "dialogues": [
                {
                    "id": "675730101",
                    "speaker": "茹拉廖夫",
                    "text": "呼啊——总算是活过来了…"
                }
            ]
        },
        {
            "talkId": "6757302",
            "initDialog": "675730201",
            "dialogues": [
                {
                    "id": "675730201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "675730202",
                    "speaker": "茹拉廖夫",
                    "text": "说实话，好多了。刚才真是多亏了你，我冷得连路都走不动了。要是没你帮忙，我这会儿估计已经冻成一桩冰雕了。"
                },
                {
                    "id": "675730203",
                    "speaker": "茹拉廖夫",
                    "text": "对了，这几颗「冰星果」是我家里刚寄来的特产，新鲜着呢！就当是救命的谢礼了。"
                },
                {
                    "id": "675730204",
                    "speaker": "茹拉廖夫",
                    "text": "嘿嘿，我这粗人也拿不出什么贵重东西，朋友你可千万别嫌弃啊！"
                }
            ]
        },
        {
            "talkId": "6757303",
            "initDialog": "675730301",
            "dialogues": [
                {
                    "id": "675730301",
                    "speaker": "Player",
                    "text": "没事，你先保重身体。"
                },
                {
                    "id": "675730302",
                    "speaker": "茹拉廖夫",
                    "text": "会的会的，多谢关心！"
                }
            ]
        },
        {
            "talkId": "6757304",
            "initDialog": "675730401",
            "dialogues": [
                {
                    "id": "675730401",
                    "speaker": "茹拉廖夫",
                    "text": "真是奇怪，我怎么这点冻都扛不住了…"
                }
            ]
        },
        {
            "talkId": "6757305",
            "initDialog": "675730501",
            "dialogues": [
                {
                    "id": "675730501",
                    "speaker": "Player",
                    "text": "身体恢复得怎么样了？"
                },
                {
                    "id": "675730502",
                    "speaker": "茹拉廖夫",
                    "text": "恢复得差不多了，我感觉再歇一会，就可以重新下去干活了。"
                },
                {
                    "id": "675730503",
                    "speaker": "茹拉廖夫",
                    "text": "不过也真是奇了怪了，我都在这儿干了好几年采冰了，一直以来都没事，今天怎么突然就扛不住冻了？"
                }
            ]
        },
        {
            "talkId": "6757306",
            "initDialog": "675730601",
            "dialogues": [
                {
                    "id": "675730601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675730602",
                    "speaker": "茹拉廖夫",
                    "text": "慢走啊朋友！之前多谢你了！"
                }
            ]
        },
        {
            "talkId": "6757307",
            "initDialog": "675730701",
            "dialogues": [
                {
                    "id": "675730701",
                    "speaker": "Player",
                    "text": "会不会是「冰星果」的原因…"
                },
                {
                    "id": "675730702",
                    "speaker": "茹拉廖夫",
                    "text": "哎！你别说，还真有可能！肯定是饿着肚子干活，身体虚了才怕冷！唉，早知道我就该早点把它吃进肚子里的…"
                },
                {
                    "id": "675730703",
                    "speaker": "茹拉廖夫",
                    "text": "好，决定了！为了防寒，下次出门我一定要在兜里多揣几颗冰星果才行！"
                }
            ]
        },
        {
            "talkId": "6757308",
            "initDialog": "675730801",
            "dialogues": [
                {
                    "id": "675730801",
                    "speaker": "Player",
                    "text": "呃，会不会是因为「冰星果」太凉了？"
                },
                {
                    "id": "675730802",
                    "speaker": "茹拉廖夫",
                    "text": "哦，你是说这个啊。唉，那也是没办法的事嘛。你想啊，就下面那个温度，随身带什么吃的，最后不都得冻成一颗大冰球？"
                },
                {
                    "id": "675730803",
                    "speaker": "茹拉廖夫",
                    "text": "这点来看，嚼「冰星果」可比啃那些冻得跟石头一样的列巴好入口多了！脆脆的，就像吃冰淇淋一样，而且还更有营养！"
                },
                {
                    "id": "675730804",
                    "speaker": "茹拉廖夫",
                    "text": "当然啦，主要还是因为我自己好这口！哈哈，朋友，有机会你一定也要尝尝啊！"
                }
            ]
        }
    ]
}