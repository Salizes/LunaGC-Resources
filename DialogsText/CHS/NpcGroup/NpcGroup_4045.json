    "talks": [
        {
            "talkId": "6404501",
            "initDialog": "640450101",
            "dialogues": [
                {
                    "id": "640450101",
                    "speaker": "哈立德",
                    "text": "你好，欢迎光临鄙店。"
                }
            ]
        },
        {
            "talkId": "6404502",
            "initDialog": "640450201",
            "dialogues": [
                {
                    "id": "640450201",
                    "speaker": "Player",
                    "text": "有什么在卖？"
                },
                {
                    "id": "640450202",
                    "speaker": "哈立德",
                    "text": "目前在售的珠宝都已经被预定走了。"
                },
                {
                    "id": "640450203",
                    "speaker": "哈立德",
                    "text": "你说店中的那些？很多都是我自己的收藏，仅做展示罢了。"
                }
            ]
        },
        {
            "talkId": "6404503",
            "initDialog": "640450301",
            "dialogues": [
                {
                    "id": "640450301",
                    "speaker": "Player",
                    "text": "有什么在卖？"
                },
                {
                    "id": "640450302",
                    "speaker": "哈立德",
                    "text": "这里偶尔也兼顾一些珠宝之外的生意，客人请便吧。"
                }
            ]
        },
        {
            "talkId": "6404504",
            "initDialog": "640450401",
            "dialogues": [
                {
                    "id": "640450401",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "640450402",
                    "speaker": "哈立德",
                    "text": "我是古董收藏家，偶尔也做些珠宝生意。"
                },
                {
                    "id": "640450403",
                    "speaker": "哈立德",
                    "text": "珍贵的古董都值得珍藏，价格也不是普通人能承受得起的，所以我并不在乎是不是能做成买卖。"
                },
                {
                    "id": "640450404",
                    "speaker": "哈立德",
                    "text": "我更在乎的，是能不能有更多像桑歌玛哈巴依老爷那样眼光犀利的供货商，为我提供最具价值的收藏品。"
                },
                {
                    "id": "640450405",
                    "speaker": "哈立德",
                    "text": "…这样说来，做生意似乎只是我的副业了。"
                },
                {
                    "id": "640450406",
                    "speaker": "哈立德",
                    "text": "至于主业…大概是把我的儿子培养成和我一样有眼光的收藏家吧。"
                },
                {
                    "id": "640450407",
                    "speaker": "哈立德",
                    "text": "费雷斯特是个很有天赋的孩子，他一定可以成为比我还有名的古董鉴赏专家。"
                }
            ]
        },
        {
            "talkId": "6404505",
            "initDialog": "640450501",
            "dialogues": [
                {
                    "id": "640450501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640450502",
                    "speaker": "哈立德",
                    "text": "请慢走。"
                }
            ]
        }
    ]
}