{
    "groupId": "4153",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "西格": 9
    },
    "talks": [
        {
            "talkId": "6415301",
            "initDialog": "641530101",
            "dialogues": [
                {
                    "id": "641530101",
                    "speaker": "西格",
                    "text": "赔钱…就知道赔钱！"
                },
                {
                    "id": "641530102",
                    "speaker": "西格",
                    "text": "这是赔钱能解决的事情吗？"
                }
            ]
        },
        {
            "talkId": "6415302",
            "initDialog": "641530201",
            "dialogues": [
                {
                    "id": "641530201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "641530202",
                    "speaker": "西格",
                    "text": "我啊，千里迢迢从枫丹过来，就是为了和学者们就我收藏的珍贵古籍进行认真严谨的学术交流与研讨。"
                },
                {
                    "id": "641530203",
                    "speaker": "西格",
                    "text": "结果刚上岸，就被一拥而上的学者把古书翻了个稀巴烂。"
                },
                {
                    "id": "641530204",
                    "speaker": "西格",
                    "text": "他们嘴上说是因为热爱知识，但我看这些人全都是港务工作人员的样子，根本就没有认真看书！"
                },
                {
                    "id": "641530205",
                    "speaker": "西格",
                    "text": "他们一边狠翻我的书，一边嘴上还念叨着什么「就凭这应该不用劳烦风纪官大人」…"
                },
                {
                    "id": "641530206",
                    "speaker": "西格",
                    "text": "我的书可都是罕见的古籍，什么叫「就凭这」啊？真是岂有此理！"
                },
                {
                    "id": "641530207",
                    "speaker": "西格",
                    "text": "现在我的古书大大贬值，他们也只是赔钱了事，你说我能不生气吗！"
                }
            ]
        },
        {
            "talkId": "6415303",
            "initDialog": "641530301",
            "dialogues": [
                {
                    "id": "641530301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "641530302",
                    "speaker": "西格",
                    "text": "唉，气死我了！"
                }
            ]
        }
    ]
}