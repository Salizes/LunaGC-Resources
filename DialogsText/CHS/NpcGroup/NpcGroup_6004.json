{
    "groupId": "6004",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 11,
        "凯瑟琳": 26
    },
    "talks": [
        {
            "talkId": "6600401",
            "initDialog": "660040101",
            "dialogues": [
                {
                    "id": "660040101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6600402",
            "initDialog": "660040201",
            "dialogues": [
                {
                    "id": "660040201",
                    "speaker": "Player",
                    "text": "你好，凯瑟琳。"
                },
                {
                    "id": "660040202",
                    "speaker": "凯瑟琳",
                    "text": "很高兴见到你。"
                },
                {
                    "id": "660040203",
                    "speaker": "凯瑟琳",
                    "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "660040204",
                    "speaker": "凯瑟琳",
                    "text": "纳塔是一个充满机遇的国度，请抓住机会。"
                }
            ]
        },
        {
            "talkId": "6600403",
            "initDialog": "660040301",
            "dialogues": [
                {
                    "id": "660040301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660040302",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6600404",
            "initDialog": "660040401",
            "dialogues": [
                {
                    "id": "660040401",
                    "speaker": "Player",
                    "text": "此话怎讲？"
                },
                {
                    "id": "660040402",
                    "speaker": "凯瑟琳",
                    "text": "有争斗的地方就会有机遇，而在时刻做好准备的人面前，这就是一份全年无休的邀请函。"
                },
                {
                    "id": "660040403",
                    "speaker": "凯瑟琳",
                    "text": "当然，用更直白的话来讲，纳塔的土地遍布遗迹，战士时刻与深渊抗争，没有冒险家会不为此兴奋的吧。"
                }
            ]
        },
        {
            "talkId": "6600405",
            "initDialog": "660040501",
            "dialogues": [
                {
                    "id": "660040501",
                    "speaker": "Player",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6600406",
            "initDialog": "660040601",
            "dialogues": [
                {
                    "id": "660040601",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6600407",
            "initDialog": "660040701",
            "dialogues": [
                {
                    "id": "660040701",
                    "speaker": "Player",
                    "text": "此话怎讲？"
                },
                {
                    "id": "660040702",
                    "speaker": "凯瑟琳",
                    "text": "有争斗的地方就会有机遇，而在时刻做好准备的人面前，这就是一份全年无休的邀请函。"
                },
                {
                    "id": "660040703",
                    "speaker": "凯瑟琳",
                    "text": "当然，用更直白的话来讲，纳塔的土地遍布遗迹，战士们仍在追求竞技的极限，没有冒险家会不为此兴奋的吧。"
                }
            ]
        },
        {
            "talkId": "6600408",
            "initDialog": "660040801",
            "dialogues": [
                {
                    "id": "660040801",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6600409",
            "initDialog": "660040901",
            "dialogues": [
                {
                    "id": "660040901",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6600410",
            "initDialog": "660041001",
            "dialogues": [
                {
                    "id": "660041001",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6600411",
            "initDialog": "660041101",
            "dialogues": [
                {
                    "id": "660041101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660041102",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "7068806",
            "initDialog": "706880601",
            "dialogues": [
                {
                    "id": "706880601",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880602",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880603",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880604",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880607",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880608",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880609",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880605",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880606",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        }
    ]
}