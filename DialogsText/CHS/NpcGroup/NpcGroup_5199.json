{
    "groupId": "5199",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "德巴内": 14
    },
    "talks": [
        {
            "talkId": "6519901",
            "initDialog": "651990101",
            "dialogues": [
                {
                    "id": "651990101",
                    "speaker": "德巴内",
                    "text": "总算工作结束了…布雷克那个傻瓜，好好工作不行吗…"
                }
            ]
        },
        {
            "talkId": "6519902",
            "initDialog": "651990201",
            "dialogues": [
                {
                    "id": "651990201",
                    "speaker": "Player",
                    "text": "布雷克怎么了？"
                },
                {
                    "id": "651990202",
                    "speaker": "德巴内",
                    "text": "他啊，成天不想好好工作，只想从一些歪门邪道上抠钱。"
                },
                {
                    "id": "651990203",
                    "speaker": "德巴内",
                    "text": "上次他被人骗去倒卖泡泡桔干，结果桔干没卖出去，反而欠了一大笔账。那些债主每天都在找他麻烦。"
                },
                {
                    "id": "651990204",
                    "speaker": "德巴内",
                    "text": "事情都到这地步了，他也不想着好好工作把钱还了，反而又想做一笔「大生意」，赚一大笔钱把债还了。"
                },
                {
                    "id": "651990205",
                    "speaker": "德巴内",
                    "text": "这世界上哪有借钱做生意还债的说法…他还想要拉我入伙，我可不是傻瓜。"
                }
            ]
        },
        {
            "talkId": "6519903",
            "initDialog": "651990301",
            "dialogues": [
                {
                    "id": "651990301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651990302",
                    "speaker": "德巴内",
                    "text": "再见。要好好工作，做正经生意啊。"
                }
            ]
        },
        {
            "talkId": "6519904",
            "initDialog": "651990401",
            "dialogues": [
                {
                    "id": "651990401",
                    "speaker": "Player",
                    "text": "那你拒绝他了？"
                },
                {
                    "id": "651990402",
                    "speaker": "德巴内",
                    "text": "那当然，我有自己的生意要做。"
                },
                {
                    "id": "651990403",
                    "speaker": "德巴内",
                    "text": "哼，我做的可是正当生意…你知道「枫达」吗？我认识了几个人，他们准备自己仿制「枫达」，做出另外一种特色饮品。"
                },
                {
                    "id": "651990404",
                    "speaker": "德巴内",
                    "text": "等他们做好了之后，就由我牵线搭桥，把饮品先放在港口供人试喝，然后向外推广。"
                }
            ]
        },
        {
            "talkId": "6519905",
            "initDialog": "651990501",
            "dialogues": [
                {
                    "id": "651990501",
                    "speaker": "Player",
                    "text": "为什么要先放在港口里？"
                },
                {
                    "id": "651990502",
                    "speaker": "德巴内",
                    "text": "柔灯港每天都有不少人出入，里面也有不少第一次来枫丹的人。我要让这种饮料，成为他们对枫丹饮品的第一印象！"
                },
                {
                    "id": "651990503",
                    "speaker": "德巴内",
                    "text": "等到足够多的人知道了我们的仿制饮品…枫达？哼，我们做的饮品才是枫丹第一！"
                }
            ]
        },
        {
            "talkId": "7494801",
            "initDialog": "749480101",
            "dialogues": [
                {
                    "id": "749480101",
                    "speaker": "Player",
                    "text": "你这生意…"
                },
                {
                    "id": "749480102",
                    "speaker": "德巴内",
                    "text": "干什么？我这可是正经生意，不偷不抢，不骗不诈，全靠努力和汗水。"
                },
                {
                    "id": "749480103",
                    "speaker": "德巴内",
                    "text": "现在这年头，像我这样努力工作的老实人已经不多啦。"
                },
                {
                    "id": "749480104",
                    "speaker": "德巴内",
                    "text": "要是枫丹廷里的人人都像我这样，那整个枫丹廷的生意场，该有多么公平，多么正义啊！"
                }
            ]
        }
    ]
}