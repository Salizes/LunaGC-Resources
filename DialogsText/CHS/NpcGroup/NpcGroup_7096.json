{
    "groupId": "7096",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "索妮齐娅": 9
    },
    "talks": [
        {
            "talkId": "6709601",
            "initDialog": "670960101",
            "dialogues": [
                {
                    "id": "670960101",
                    "speaker": "索妮齐娅",
                    "text": "你好呀，远道而来的旅人！欢迎来到「霜月之子」，愿月神大人的祝福照临你的前路！"
                }
            ]
        },
        {
            "talkId": "6709602",
            "initDialog": "670960201",
            "dialogues": [
                {
                    "id": "670960201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "670960202",
                    "speaker": "索妮齐娅",
                    "text": "我是索妮齐娅，霜月的仆从，谦卑的侍祭。我的职责就是在这里引导来访的旅人，并分享库塔{RUBY#[S]月之少女}尔大人的恩典。"
                },
                {
                    "id": "670960203",
                    "speaker": "索妮齐娅",
                    "text": "要是想见「咏月使」大人，可以先找安洛丝姐姐；要是想谈生意，可以找科罗德叔叔；如果只是想祈祷，维娜琴卡姐姐应该也在…"
                },
                {
                    "id": "670960204",
                    "speaker": "索妮齐娅",
                    "text": "总之，如果有什么需要帮助的，或者想找个地方歇歇脚，请尽管告诉我！"
                }
            ]
        },
        {
            "talkId": "6709603",
            "initDialog": "670960301",
            "dialogues": [
                {
                    "id": "670960301",
                    "speaker": "Player",
                    "text": "关于「霜月之子」…"
                },
                {
                    "id": "670960302",
                    "speaker": "索妮齐娅",
                    "text": "我们是库塔{RUBY#[S]月之少女}尔大人忠诚的侍仆。库塔{RUBY#[S]月之少女}尔大人是仁慈又温柔的守护者，是黑暗中唯一的明光，总是慷慨地回应我们的愿望…"
                },
                {
                    "id": "670960303",
                    "speaker": "索妮齐娅",
                    "text": "尤其是在这片荒芜阴恶的土地上，唯有月光才能为我们带来平和与安宁。"
                }
            ]
        },
        {
            "talkId": "6709604",
            "initDialog": "670960401",
            "dialogues": [
                {
                    "id": "670960401",
                    "speaker": "Player",
                    "text": "关于「霜月之子」…"
                },
                {
                    "id": "670960402",
                    "speaker": "索妮齐娅",
                    "text": "我们是库塔{RUBY#[S]月之少女}尔大人忠诚的侍仆。无论库塔{RUBY#[S]月之少女}尔大人如何选择，无论她是否回应我们的歌声，她都是我们追随的神明。"
                },
                {
                    "id": "670960403",
                    "speaker": "索妮齐娅",
                    "text": "尤其是在这片荒芜阴恶的土地上，唯有月光才能为我们带来平和与安宁。"
                }
            ]
        },
        {
            "talkId": "6709605",
            "initDialog": "670960501",
            "dialogues": [
                {
                    "id": "670960501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670960502",
                    "speaker": "索妮齐娅",
                    "text": "嗯，愿月光继续照亮你的旅途！"
                }
            ]
        }
    ]
}