{
    "groupId": "2140",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 7,
        "百晓": 19
    },
    "talks": [
        {
            "talkId": "6214006",
            "initDialog": "621400601",
            "dialogues": [
                {
                    "id": "621400601",
                    "speaker": "百晓",
                    "text": "您好，旅行者，欢迎登门。请问有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6214007",
            "initDialog": "621400701",
            "dialogues": [
                {
                    "id": "621400701",
                    "speaker": "Player",
                    "text": "关于群玉阁…"
                },
                {
                    "id": "621400702",
                    "speaker": "百晓",
                    "text": "群玉阁是由凝光大人坐镇的情报决策机关。"
                },
                {
                    "id": "621400703",
                    "speaker": "百晓",
                    "text": "此处悉察整个璃月的大小事务。各路信息无论巨细，逃不过我们的耳目。"
                },
                {
                    "id": "621400704",
                    "speaker": "百晓",
                    "text": "虽然在群玉阁重新修缮升起之前的这些时日，我们这些秘书仍旧事无巨细地为凝光大人工作，但还是重归此地更有氛围…"
                },
                {
                    "id": "621400705",
                    "speaker": "百晓",
                    "text": "不过虽然您是凝光大人的贵客，但汇集在群玉阁中的各项情报无可奉告，还请见谅。"
                }
            ]
        },
        {
            "talkId": "6214008",
            "initDialog": "621400801",
            "dialogues": [
                {
                    "id": "621400801",
                    "speaker": "Player",
                    "text": "关于凝光。"
                },
                {
                    "id": "621400802",
                    "speaker": "百晓",
                    "text": "凝光大人乃是七星之一，总览璃月，遍察工商…"
                },
                {
                    "id": "621400803",
                    "speaker": "百晓",
                    "text": "除此之外，恕我不便透露太多信息。"
                },
                {
                    "id": "621400804",
                    "speaker": "百晓",
                    "text": "不过以您和凝光大人的交情…有什么疑问的话，可以尝试去问她本人。"
                }
            ]
        },
        {
            "talkId": "7194901",
            "initDialog": "719490101",
            "dialogues": [
                {
                    "id": "719490101",
                    "speaker": "Player",
                    "text": "我很崇拜凝光大人。"
                },
                {
                    "id": "719490102",
                    "speaker": "百晓",
                    "text": "嗯…你倒和那些油嘴滑舌想要套情报的商人们不一样，难得的真诚和坦荡…"
                },
                {
                    "id": "719490103",
                    "speaker": "百晓",
                    "text": "发财的道理其实很简单，我常年在凝光大人身边，潜移默化地感悟到了一些…奥妙。"
                },
                {
                    "id": "719490104",
                    "speaker": "百晓",
                    "text": "这样吧，不以凝光大人的名义，而是以我的名义…指引你「黄金」的意义，祝财运亨通。"
                }
            ]
        },
        {
            "talkId": "6214001",
            "initDialog": "621400101",
            "dialogues": [
                {
                    "id": "621400101",
                    "speaker": "百晓",
                    "text": "欢迎登门，请问您有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6214002",
            "initDialog": "621400201",
            "dialogues": [
                {
                    "id": "621400201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "621400202",
                    "speaker": "百晓",
                    "text": "欢迎，我是凝光大人的秘书，客人请叫我百晓就好。"
                }
            ]
        },
        {
            "talkId": "6214003",
            "initDialog": "621400301",
            "dialogues": [
                {
                    "id": "621400301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621400302",
                    "speaker": "百晓",
                    "text": "再见，望您一路平安。"
                }
            ]
        },
        {
            "talkId": "6214004",
            "initDialog": "621400203",
            "dialogues": [
                {
