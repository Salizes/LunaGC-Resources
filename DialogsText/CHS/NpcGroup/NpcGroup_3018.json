{
    "groupId": "3018",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "松本": 17
    },
    "talks": [
        {
            "talkId": "6301801",
            "initDialog": "630180101",
            "dialogues": [
                {
                    "id": "630180101",
                    "speaker": "松本",
                    "text": "哦，你好啊。"
                },
                {
                    "id": "630180102",
                    "speaker": "松本",
                    "text": "又是来叫我品鉴料理的吗？可别再让我失望了哦。"
                }
            ]
        },
        {
            "talkId": "6301802",
            "initDialog": "630180201",
            "dialogues": [
                {
                    "id": "630180201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630180202",
                    "speaker": "松本",
                    "text": "我是游历四方的美食评论家松本，最近陷入了无菜可试的地步。"
                },
                {
                    "id": "630180203",
                    "speaker": "松本",
                    "text": "这条街上的料理店已经被我吃遍啦，无论是乌有亭，还是木南料亭，都没有什么新鲜东西了。"
                },
                {
                    "id": "630180204",
                    "speaker": "松本",
                    "text": "以我作为美食评论家多年的经验，对这些店的评价便是——不过如此。"
                },
                {
                    "id": "630180205",
                    "speaker": "松本",
                    "text": "千奇百味都尝遍之后，越来越觉得平平淡淡才是真。"
                },
                {
                    "id": "630180206",
                    "speaker": "松本",
                    "text": "若是问我现在觉得最美味的东西…应该是木南料亭无限续杯的柠檬水吧。"
                }
            ]
        },
        {
            "talkId": "6301803",
            "initDialog": "630180301",
            "dialogues": [
                {
                    "id": "630180301",
                    "speaker": "Player",
                    "text": "品鉴料理？"
                },
                {
                    "id": "630180302",
                    "speaker": "松本",
                    "text": "对，身为经验老到的美食评论家，我会对你呈上的料理做出最公正的评价。"
                },
                {
                    "id": "630180303",
                    "speaker": "松本",
                    "text": "那么，你想要我尝什么？麻烦拿来给我。"
                }
            ]
        },
        {
            "talkId": "6301804",
            "initDialog": "630180401",
            "dialogues": [
                {
                    "id": "630180401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630180402",
                    "speaker": "松本",
                    "text": "再见。唉，今天也只能喝些柠檬水了吗。"
                }
            ]
        },
        {
            "talkId": "6301805",
            "initDialog": "630180501",
            "dialogues": [
                {
                    "id": "630180501",
                    "speaker": "Player",
                    "text": "拿来给你…？"
                },
                {
                    "id": "630180502",
                    "speaker": "松本",
                    "text": "对啊，怎么了？"
                },
                {
                    "id": "630180503",
                    "speaker": "松本",
                    "text": "你委托我尝菜，当然是你付钱去买，或者做好给我咯。"
                },
                {
                    "id": "630180504",
                    "speaker": "松本",
                    "text": "我若是花钱购买的话，岂不是太功利了。菜肴的价格会影响评判结果的。"
                },
                {
                    "id": "630180505",
                    "speaker": "松本",
                    "text": "就是因为没有金钱的交易，评价才更公正。"
                }
            ]
        },
        {
            "talkId": "7291201",
            "initDialog": "729120101",
            "dialogues": [
                {
                    "id": "729120101",
                    "speaker": "Player",
                    "text": "要什么样的料理呢？"
                },
                {
                    "id": "729120102",
                    "speaker": "松本",
                    "text": "越是质朴的料理，越是能体现主厨手艺的精湛。"
                },
                {
                    "id": "729120103",
                    "speaker": "松本",
                    "text": "比如这些木南料亭家的鸟蛋烧，至少要做到这个程度，才有资格拿来给我品评。"
                },
                {
                    "id": "729120104",
                    "speaker": "松本",
                    "text": "不如这个的就都免了吧，不然纯粹是浪费我的时间。"
                }
            ]
        }
    ]
}