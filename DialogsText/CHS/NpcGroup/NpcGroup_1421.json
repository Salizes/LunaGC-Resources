{
    "groupId": "1421",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 6,
        "米歇尔": 22
    },
    "talks": [
        {
            "talkId": "7091101",
            "initDialog": "709110101",
            "dialogues": [
                {
                    "id": "709110101",
                    "speaker": "Player",
                    "text": "你有什么烦恼吗？"
                },
                {
                    "id": "709110102",
                    "speaker": "米歇尔",
                    "text": "确实有，不过也不是什么大事…你知道慕风蘑菇吗？"
                },
                {
                    "id": "709110103",
                    "speaker": "米歇尔",
                    "text": "这种蘑菇总是一不注意就长满了整个风车，我已经清理了一部分了，可还是多得不行。"
                },
                {
                    "id": "709110104",
                    "speaker": "米歇尔",
                    "text": "我正头疼怎么处理呢，如果你能拿走一些的话就再好不过了。"
                }
            ]
        },
        {
            "talkId": "40164",
            "initDialog": "4015142101",
            "dialogues": [
                {
                    "id": "4015142101",
                    "speaker": "米歇尔",
                    "text": "即使是巴巴托斯大人也偶尔需要休憩…"
                },
                {
                    "id": "4015142102",
                    "speaker": "米歇尔",
                    "text": "但是只有勤劳的工作之后的休憩才是休憩，否则就是单纯地偷懒而已。"
                }
            ]
        },
        {
            "talkId": "41723",
            "initDialog": "4015142104",
            "dialogues": [
                {
                    "id": "4015142104",
                    "speaker": "Player",
                    "text": "关于风车。"
                },
                {
                    "id": "4015142109",
                    "speaker": "米歇尔",
                    "text": "风车是为蒙德城抽取水源的重要设施。"
                },
                {
                    "id": "4015142110",
                    "speaker": "米歇尔",
                    "text": "我家族的祖辈们都和风车为伴，对于这一点我再清楚不过了。"
                },
                {
                    "id": "4015142111",
                    "speaker": "米歇尔",
                    "text": "厌倦？完全不会，只要在巴巴托斯大人的风的鼓励下，我就有无限的干劲。"
                }
            ]
        },
        {
            "talkId": "41724",
            "initDialog": "4015142105",
            "dialogues": [
                {
                    "id": "4015142105",
                    "speaker": "Player",
                    "text": "关于巴巴托斯。"
                },
                {
                    "id": "4015142112",
                    "speaker": "米歇尔",
                    "text": "巴巴托斯大人是一位既勤劳又仁慈的神。"
                },
                {
                    "id": "4015142113",
                    "speaker": "米歇尔",
                    "text": "如果你有烦恼的话，就对着风，向巴巴托斯大人倾诉吧。"
                },
                {
                    "id": "4015142114",
                    "speaker": "米歇尔",
                    "text": "但是如果只是一味指望着巴巴托斯大人的帮助，反而不会得到回应。"
                },
                {
                    "id": "4015142115",
                    "speaker": "米歇尔",
                    "text": "毕竟自己的烦恼只有自己能够解决，对吧？"
                }
            ]
        },
        {
            "talkId": "6142101",
            "initDialog": "4015142103",
            "dialogues": [
                {
                    "id": "4015142103",
                    "speaker": "Player",
                    "text": "在做什么？"
                },
                {
                    "id": "4015142107",
                    "speaker": "米歇尔",
                    "text": "嘘…我正在感受巴巴托斯大人的神意。"
                }
            ]
        },
        {
            "talkId": "6142102",
            "initDialog": "4015142106",
            "dialogues": [
                {
                    "id": "4015142106",
                    "speaker": "米歇尔",
                    "text": "再见。"
                },
                {
                    "id": "4015142116",
                    "speaker": "米歇尔",
                    "text": "记得对风车保持敬畏，巴巴托斯大人的风无处不在。"
                }
            ]
        },
        {
            "talkId": "6142103",
            "initDialog": "614210301",
            "dialogues": [
                {
                    "id": "614210301",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614210302",
                    "speaker": "米歇尔",
                    "text": "比起我个人的安危，我更希望我家祖祖辈辈守护的这些风车能够平安无事…"
                },
                {
                    "id": "614210303",
                    "speaker": "米歇尔",
                    "text": "…唉，上一次风魔龙袭来时造成的风灾实在是太强了，也不知道风车有没有受损。"
                },
                {
                    "id": "614210304",
                    "speaker": "米歇尔",
                    "text": "虽然很想上去检查一下，不过骑士团的人把我给拦下来了…"
                },
                {
                    "id": "614210305",
                    "speaker": "米歇尔",
                    "text": "还说风魔龙随时都可能再次来袭，实在是太危险了…"
                }
            ]
        },
        {
            "talkId": "6142104",
            "initDialog": "614210401",
            "dialogues": [
                {
                    "id": "614210401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614210402",
                    "speaker": "米歇尔",
                    "text": "看到风车平安无事，我也可以放心了…"
                },
                {
                    "id": "614210403",
                    "speaker": "米歇尔",
                    "text": "风灾来临时，风车转动的声响真是吓到我了，简直就像风发出的悲鸣一样。"
                },
                {
                    "id": "614210404",
                    "speaker": "米歇尔",
                    "text": "现在风车又恢复了平静，果然巴巴托斯大人依旧庇护着我们，真是太好了。"
                }
            ]
        }
    ]
}