{
    "groupId": "2411",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "岳川": 14
    },
    "talks": [
        {
            "talkId": "7193701",
            "initDialog": "719370101",
            "dialogues": [
                {
                    "id": "719370101",
                    "speaker": "Player",
                    "text": "你找到信物了吗？"
                },
                {
                    "id": "719370102",
                    "speaker": "岳川",
                    "text": "唔，还没有，目前只找到了这些螃蟹…"
                },
                {
                    "id": "719370103",
                    "speaker": "岳川",
                    "text": "嘶，螃蟹夹手指还挺疼的，而且就算把它们扔到岸上，没一会儿就又会爬回来。"
                },
                {
                    "id": "719370104",
                    "speaker": "岳川",
                    "text": "…我正头疼怎么处理这些螃蟹呢，要不你拿走吧，小心别被夹到。"
                }
            ]
        },
        {
            "talkId": "6241101",
            "initDialog": "624110101",
            "dialogues": [
                {
                    "id": "624110101",
                    "speaker": "岳川",
                    "text": "有什么事情吗？我正忙着呢！"
                }
            ]
        },
        {
            "talkId": "6241102",
            "initDialog": "624110201",
            "dialogues": [
                {
                    "id": "624110201",
                    "speaker": "Player",
                    "text": "你在忙什么？"
                },
                {
                    "id": "624110202",
                    "speaker": "岳川",
                    "text": "没看见我在找东西吗！"
                },
                {
                    "id": "624110203",
                    "speaker": "岳川",
                    "text": "唔，对了…你有看见一个女孩子吗？"
                },
                {
                    "id": "624110204",
                    "speaker": "岳川",
                    "text": "她经常穿着很漂亮的衣服来这里晃荡，一看就是大户人家的小姐。"
                }
            ]
        },
        {
            "talkId": "6241103",
            "initDialog": "624110301",
            "dialogues": [
                {
                    "id": "624110301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "624110302",
                    "speaker": "岳川",
                    "text": "再见！"
                },
                {
                    "id": "624110303",
                    "speaker": "岳川",
                    "text": "嗯…那个发亮的是什么东西？"
                }
            ]
        },
        {
            "talkId": "6241104",
            "initDialog": "624110205",
            "dialogues": [
                {
                    "id": "624110205",
                    "speaker": "Player",
                    "text": "没见过。"
                },
                {
                    "id": "624110206",
                    "speaker": "岳川",
                    "text": "这样啊…她是我的好朋友，不过最近很久没有来海边了。"
                },
                {
                    "id": "624110207",
                    "speaker": "岳川",
                    "text": "我觉得她一定很想我，肯定在沙滩留了信物给我吧！"
                }
            ]
        },
        {
            "talkId": "6241105",
            "initDialog": "624110208",
            "dialogues": [
                {
                    "id": "624110208",
                    "speaker": "Player",
                    "text": "你就这么确定？"
                },
                {
                    "id": "624110209",
                    "speaker": "岳川",
                    "text": "当然！我的判断怎么会有错！"
                },
                {
                    "id": "624110210",
                    "speaker": "岳川",
                    "text": "别看我穷，但我和那位大小姐可是心意相通的！"
                },
                {
                    "id": "624110211",
                    "speaker": "岳川",
                    "text": "我每天都会来海边，看看她给我留下了什么信息或礼物，我的努力一定不会落空的！"
                }
            ]
        }
    ]
}