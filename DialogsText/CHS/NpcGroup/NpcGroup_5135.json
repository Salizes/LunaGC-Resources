{
    "groupId": "5135",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "薇娜": 13
    },
    "talks": [
        {
            "talkId": "6513501",
            "initDialog": "651350101",
            "dialogues": [
                {
                    "id": "651350101",
                    "speaker": "薇娜",
                    "text": "机械让工作变得方便，但有些无聊呢。"
                }
            ]
        },
        {
            "talkId": "6513502",
            "initDialog": "651350201",
            "dialogues": [
                {
                    "id": "651350201",
                    "speaker": "Player",
                    "text": "想要聊天吗？"
                },
                {
                    "id": "651350202",
                    "speaker": "薇娜",
                    "text": "好呀，不过从哪聊起呢…"
                },
                {
                    "id": "651350203",
                    "speaker": "薇娜",
                    "text": "我刚刚在想，等到了休息日，应当约上朋友去歌剧院，无论是戏剧演出还是案件审理，我都来者不拒。"
                },
                {
                    "id": "651350204",
                    "speaker": "薇娜",
                    "text": "最近一直在港口值班，每天就是例行检查机械，没什么特别的。"
                },
                {
                    "id": "651350205",
                    "speaker": "薇娜",
                    "text": "不过转念一想…无聊的工作虽然没意思，但至少是安全的。"
                },
                {
                    "id": "651350206",
                    "speaker": "薇娜",
                    "text": "如果我现在还在被外派到枫丹科学院进修机械知识的话，现在可能已经不在陆地上了。"
                }
            ]
        },
        {
            "talkId": "6513503",
            "initDialog": "651350301",
            "dialogues": [
                {
                    "id": "651350301",
                    "speaker": "Player",
                    "text": "如果想要坐船去枫丹廷…"
                },
                {
                    "id": "651350302",
                    "speaker": "薇娜",
                    "text": "啊，你是指枫丹水道的「巡轨船」吧。"
                },
                {
                    "id": "651350303",
                    "speaker": "薇娜",
                    "text": "这里是克莱门汀线从海露港通往枫丹廷的起点。"
                },
                {
                    "id": "651350304",
                    "speaker": "薇娜",
                    "text": "想乘船去枫丹廷的话，请在附近的长椅上就坐，稍候片刻就会有船来的。"
                },
                {
                    "id": "651350305",
                    "speaker": "薇娜",
                    "text": "船上会有美露莘导游为你介绍一些…嗯…小知识，敬请期待吧。"
                }
            ]
        },
        {
            "talkId": "6513504",
            "initDialog": "651350401",
            "dialogues": [
                {
                    "id": "651350401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651350402",
                    "speaker": "薇娜",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6513505",
            "initDialog": "651350501",
            "dialogues": [
                {
                    "id": "651350501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6513506",
            "initDialog": "651350601",
            "dialogues": [
                {
                    "id": "651350601",
                    "speaker": "薇娜",
                    "text": "有趣的对局，你很会玩牌呢！"
                }
            ]
        },
        {
            "talkId": "6513507",
            "initDialog": "651350701",
            "dialogues": [
                {
                    "id": "651350701",
                    "speaker": "薇娜",
                    "text": "啊呀，早知道我就拿出更厉害的打法了…"
                }
            ]
        }
    ]
}