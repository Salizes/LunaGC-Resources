{
    "groupId": "9414",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "洛恩": 9
    },
    "talks": [
        {
            "talkId": "6941401",
            "initDialog": "694140101",
            "dialogues": [
                {
                    "id": "694140101",
                    "speaker": "洛恩",
                    "text": "合理地分配时间，就是要将自己的精力全部留到战场厮杀上，除非是不得不休息…"
                },
                {
                    "id": "694140102",
                    "speaker": "洛恩",
                    "text": "而分配时间的时候，既不能被情绪影响，也不能自作聪明。"
                },
                {
                    "id": "694140103",
                    "speaker": "洛恩",
                    "text": "现在，我不得不执行原地休息的指令了，出发之前记得叫我。"
                }
            ]
        },
        {
            "talkId": "6941402",
            "initDialog": "694140201",
            "dialogues": [
                {
                    "id": "694140201",
                    "speaker": "洛恩",
                    "text": "要出发了？行啊，我来打头阵吧，不知道能遇见什么新鲜的敌人。"
                },
                {
                    "id": "694140202",
                    "speaker": "洛恩",
                    "text": "不过，这次冒险你是队长，我的位置由你安排，你说了算。"
                },
                {
                    "id": "694140203",
                    "speaker": "洛恩",
                    "text": "只要别让我走中间就行，那样太没意思了。"
                }
            ]
        },
        {
            "talkId": "6941403",
            "initDialog": "694140301",
            "dialogues": [
                {
                    "id": "694140301",
                    "speaker": "洛恩",
                    "text": "童话…童话…童话…还是童话…"
                },
                {
                    "id": "694140302",
                    "speaker": "洛恩",
                    "text": "太薄…太厚…封面太硬…没有封面…"
                },
                {
                    "id": "694140303",
                    "speaker": "洛恩",
                    "text": "唉，这么多童话书，居然找不到一本适合用来垫脑袋的，看来各位作者还是写得太少啊。"
                }
            ]
        }
    ]
}