{
    "groupId": "6389",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "约卡": 14
    },
    "talks": [
        {
            "talkId": "6638901",
            "initDialog": "663890101",
            "dialogues": [
                {
                    "id": "663890101",
                    "speaker": "约卡",
                    "text": "啊啊，没拦住，还是让它跑掉了！果然还是欠缺锻炼…下次归火圣夜巡礼的时候，可要表现得比这更好才行！"
                }
            ]
        },
        {
            "talkId": "6638902",
            "initDialog": "663890201",
            "dialogues": [
                {
                    "id": "663890201",
                    "speaker": "约卡",
                    "text": "啊啊，没拦住，还是让它跑掉了！果然还是欠缺锻炼…下次要是遇到深渊来的怪物，可要表现得比这更好才行！"
                }
            ]
        },
        {
            "talkId": "6638903",
            "initDialog": "663890301",
            "dialogues": [
                {
                    "id": "663890301",
                    "speaker": "Player",
                    "text": "跑掉了？"
                },
                {
                    "id": "663890302",
                    "speaker": "约卡",
                    "text": "是啊，我本打算去锻炼，不料半路突然偶遇暴走的突角龙，拼尽全力未能拦住…"
                },
                {
                    "id": "663890303",
                    "speaker": "约卡",
                    "text": "你看，这边的围栏也被撞坏了，那家伙也朝着山上冲过去了…果然还是我锻炼得不够！"
                }
            ]
        },
        {
            "talkId": "6638904",
            "initDialog": "663890401",
            "dialogues": [
                {
                    "id": "663890401",
                    "speaker": "Player",
                    "text": "归火圣夜巡礼？"
                },
                {
                    "id": "663890402",
                    "speaker": "约卡",
                    "text": "哦？你是从外乡来的朋友吧？"
                },
                {
                    "id": "663890403",
                    "speaker": "约卡",
                    "text": "归火圣夜巡礼在我们纳塔是象征着至高荣耀的赛事，只有最强大的战士才能取得最后的胜利！"
                },
                {
                    "id": "663890404",
                    "speaker": "约卡",
                    "text": "哈哈，说来惭愧，我之前虽然也报名参加了归火圣夜巡礼，可没想到对手会是伊安珊教练。"
                },
                {
                    "id": "663890405",
                    "speaker": "约卡",
                    "text": "就连我们队伍里最强的摔角手瓦雷莎小姐，也被轻松击败了——那可是那位「力量」的伊安珊教练啊，你明白的吧？"
                },
                {
                    "id": "663890406",
                    "speaker": "约卡",
                    "text": "不过，为了不输给伊安珊教练以外的其他人，我还是得加把劲锻炼才行！"
                }
            ]
        },
        {
            "talkId": "6638905",
            "initDialog": "663890501",
            "dialogues": [
                {
                    "id": "663890501",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "663890502",
                    "speaker": "约卡",
                    "text": "谢谢你的鼓励，朋友！也祝你的旅途旗开得胜！"
                }
            ]
        },
        {
            "talkId": "6638906",
            "initDialog": "663890601",
            "dialogues": [
                {
                    "id": "663890601",
                    "speaker": "Player",
                    "text": "关于之前的战斗…"
                },
                {
                    "id": "663890602",
                    "speaker": "约卡",
                    "text": "沃陆之邦不是深渊这次的主要进攻方向，受灾情况也相对最轻。"
                },
                {
                    "id": "663890603",
                    "speaker": "约卡",
                    "text": "不过…还是有战士去往了夜的安宁。"
                },
                {
                    "id": "663890604",
                    "speaker": "约卡",
                    "text": "他们用力量捍卫了自己的荣耀，也捍卫了人们的自由。没有比这更好的结局了。"
                }
            ]
        },
        {
            "talkId": "6638907",
            "initDialog": "663890701",
            "dialogues": [
                {
                    "id": "663890701",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "663890702",
                    "speaker": "约卡",
                    "text": "谢谢你的鼓励，朋友。也祝你的旅途旗开得胜。"
                }
            ]
        }
    ]
}