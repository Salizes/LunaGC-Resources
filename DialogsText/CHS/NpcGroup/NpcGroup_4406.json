{
    "groupId": "4406",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "阿扎莱": 19
    },
    "talks": [
        {
            "talkId": "6440601",
            "initDialog": "644060101",
            "dialogues": [
                {
                    "id": "644060101",
                    "speaker": "阿扎莱",
                    "text": "你好，有什么需要的？"
                }
            ]
        },
        {
            "talkId": "6440602",
            "initDialog": "644060201",
            "dialogues": [
                {
                    "id": "644060201",
                    "speaker": "Player",
                    "text": "有什么卖的？"
                },
                {
                    "id": "644060202",
                    "speaker": "阿扎莱",
                    "text": "请随意挑选。不过提前说下，用摩拉支付的话，价格会比城里高一些哦。"
                }
            ]
        },
        {
            "talkId": "6440603",
            "initDialog": "644060301",
            "dialogues": [
                {
                    "id": "644060301",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "644060302",
                    "speaker": "阿扎莱",
                    "text": "如你所见，是卖食物和香料的地方。"
                },
                {
                    "id": "644060303",
                    "speaker": "阿扎莱",
                    "text": "阿如村的土地种不出什么作物，大部分的物资只能靠外部提供。"
                },
                {
                    "id": "644060304",
                    "speaker": "阿扎莱",
                    "text": "总是等人送东西进来太被动了，所以我就摆了这么个铺子。"
                },
                {
                    "id": "644060305",
                    "speaker": "阿扎莱",
                    "text": "哦对了，明人不说暗话，我先提醒下，这里东西的售价会比城里高一些哦。"
                },
                {
                    "id": "644060306",
                    "speaker": "阿扎莱",
                    "text": "没办法，只能单程运货，运输成本太高了，我已经尽力压低价格了。"
                },
                {
                    "id": "644060307",
                    "speaker": "阿扎莱",
                    "text": "不过不一定非要付摩拉，大家来我这里以物易物也是可以的。"
                }
            ]
        },
        {
            "talkId": "6440604",
            "initDialog": "644060401",
            "dialogues": [
                {
                    "id": "644060401",
                    "speaker": "Player",
                    "text": "暂时没有。"
                },
                {
                    "id": "644060402",
                    "speaker": "阿扎莱",
                    "text": "慢走，下次再来哦！"
                }
            ]
        },
        {
            "talkId": "6440605",
            "initDialog": "644060501",
            "dialogues": [
                {
                    "id": "644060501",
                    "speaker": "Player",
                    "text": "是个好办法。"
                },
                {
                    "id": "644060502",
                    "speaker": "阿扎莱",
                    "text": "在小地方生活就要靠大家互帮互助嘛。"
                },
                {
                    "id": "644060503",
                    "speaker": "阿扎莱",
                    "text": "有时还会有村民把不用的东西寄放在我这，等需要的人来把它们拿走。"
                },
                {
                    "id": "644060504",
                    "speaker": "阿扎莱",
                    "text": "而且这对我的生意也有帮助。毕竟很少有人能路过摊位而不看上两眼的，对吧？"
                }
            ]
        },
        {
            "talkId": "6440606",
            "initDialog": "644060601",
            "dialogues": [
                {
                    "id": "644060601",
                    "speaker": "Player",
                    "text": "运输成本？"
                },
                {
                    "id": "644060602",
                    "speaker": "阿扎莱",
                    "text": "是呀，这附近除了沙子还是沙子，根本没什么东西可以拉到城里去卖的，所以也没什么利润可言。"
                },
                {
                    "id": "644060603",
                    "speaker": "阿扎莱",
                    "text": "说来，之前我有一次进货时遇到沙暴迷了路，在沙漠深处的土地上遇到了一些学者打扮的人。"
                },
                {
                    "id": "644060604",
                    "speaker": "阿扎莱",
                    "text": "他们分给了我一些食物，又告诉了我怎么回阿如村，但是却不愿意向我透露他们的身份。"
                },
                {
                    "id": "644060605",
                    "speaker": "阿扎莱",
                    "text": "要不要再进沙漠一次，找一找那些人呢？我听说学者都比较富裕，如果能赚到他们的钱就好了…"
                },
                {
                    "id": "644060606",
                    "speaker": "阿扎莱",
                    "text": "这样一来，货物的售价也能降下一些，村里人的日子也会好过一点吧。"
                }
            ]
        },
        {
            "talkId": "6440607",
            "initDialog": "644060701",
            "dialogues": [
                {
                    "id": "644060701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6440608",
            "initDialog": "644060801",
            "dialogues": [
                {
                    "id": "644060801",
                    "speaker": "阿扎莱",
                    "text": "多谢赏脸！有兴趣再来一场吗！"
                }
            ]
        },
        {
            "talkId": "6440609",
            "initDialog": "644060901",
            "dialogues": [
                {
                    "id": "644060901",
                    "speaker": "阿扎莱",
                    "text": "惊人的牌技！没想到这么一位「七圣召唤」的强者不声不响造访了阿如村！"
                }
            ]
        }
    ]
}