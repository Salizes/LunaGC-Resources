{
    "groupId": "2230",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "《古华手记》": 16
    },
    "talks": [
        {
            "talkId": "6223001",
            "initDialog": "711080301",
            "dialogues": [
                {
                    "id": "711080301",
                    "speaker": "《古华手记》",
                    "text": "「…修习刺明之法。木人不慎尽毁…无钱资…自思一良策，何不束草为人…」"
                },
                {
                    "id": "711080302",
                    "speaker": "《古华手记》",
                    "text": "「收揽稻草。」"
                },
                {
                    "id": "711080303",
                    "speaker": "《古华手记》",
                    "text": "「束草。甚疲。」"
                },
                {
                    "id": "711080304",
                    "speaker": "《古华手记》",
                    "text": "「…修习刺明之法。草人不慎尽毁…不妨先习剑。」",
                    "choices": [
                        {
                            "id": "711080305",
                            "text": "继续阅读。",
                            "response": [
                                {
                                    "id": "711080307",
                                    "speaker": "《古华手记》",
                                    "text": "「…无事。闲坐庭前观雨，腹中稍饥…思悟前日所见，忽得启感，若以剑…（模糊不清）自名『裁雨』，改日当试。」"
                                },
                                {
                                    "id": "711080308",
                                    "speaker": "《古华手记》",
                                    "text": "「…修习裁雨之法，不慎跌坠，所幸伤不甚重…自思一良策，不妨凿地浚池于桩下，既可使不复跌伤，又可养鱼以为食…」"
                                },
                                {
                                    "id": "711080309",
                                    "speaker": "《古华手记》",
                                    "text": "「…往见渔者，市数十鱼…试烹之，甚肥美，众鱼莫可与比…」"
                                },
                                {
                                    "id": "711080310",
                                    "speaker": "《古华手记》",
                                    "text": "（此后十余页均为鱼肉的各种烹饪方法，记载无比详细，有些甚至还搭配了插图。）"
                                },
                                {
                                    "id": "711080311",
                                    "speaker": "《古华手记》",
                                    "text": "「…修习裁雨之法，不慎跌坠。」"
                                },
                                {
                                    "id": "711080312",
                                    "speaker": "《古华手记》",
                                    "text": "「…成。」",
                                    "choices": [
                                        {
                                            "id": "711080313",
                                            "text": "继续阅读。",
                                            "response": [
                                                {
                                                    "id": "711080315",
                                                    "speaker": "《古华手记》",
                                                    "text": "「…使枪剑当如使（模糊不清，旁有第三代掌门批注：当如使指）…所止，即是妙理之相…然彼无…何以予之？何以告之？」"
                                                },
                                                {
                                                    "id": "711080316",
                                                    "speaker": "《古华手记》",
                                                    "text": "「…改修藏书阁。设…于内，待…」"
                                                },
                                                {
                                                    "id": "711080317",
                                                    "speaker": "《古华手记》",
                                                    "text": "「…以<color=#00E1FFFF>目</color>视之，使<color=#00E1FFFF>四方之卷</color>合于<color=#00E1FFFF>四方之阁</color>，便可…」"
                                                },
                                                {
                                                    "id": "711080318",
                                                    "speaker": "《古华手记》",
                                                    "text": "（此后数页均被涂抹，无法阅读。旁有第三代掌门批注：此为劝诫后世之人博览四方书卷。）",
                                                    "choices": [
                                                        {
                                                            "id": "711080319",
                                                            "text": "继续阅读。",
                                                            "response": [
                                                                {
                                                                    "id": "711080321",
                                                                    "speaker": "《古华手记》",
                                                                    "text": "「…伤愈。白小三烹羊脍鲤来见。肥美无膻。遂问其术…传以生克之法…于此记之。」"
                                                                },
                                                                {
                                                                    "id": "711080322",
                                                                    "speaker": "《古华手记》",
                                                                    "text": "（此后数页详细记录了羊肉的各种烹饪方法。）"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711080320",
                                                            "text": "不读了，涂得乱七八糟的…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711080314",
                                            "text": "不读了，完全没写练习过程…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711080306",
                            "text": "不读了，什么乱七八糟的…"
                        }
                    ]
                }
            ]
        }
    ]
}