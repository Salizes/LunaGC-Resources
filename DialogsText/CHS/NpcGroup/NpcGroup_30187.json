{
    "groupId": "30187",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "伯特兰": 12
    },
    "talks": [
        {
            "talkId": "7269406",
            "initDialog": "726940601",
            "dialogues": [
                {
                    "id": "726940601",
                    "speaker": "伯特兰",
                    "text": "如果卖出一个就能赚这些摩拉，那还上我欠的钱，只要卖出两万个就行了！"
                },
                {
                    "id": "726940602",
                    "speaker": "伯特兰",
                    "text": "#怎么了，{NICKNAME}，有什么问题吗？"
                }
            ]
        },
        {
            "talkId": "7269407",
            "initDialog": "726940701",
            "dialogues": [
                {
                    "id": "726940701",
                    "speaker": "Player",
                    "text": "关于制造的流程…"
                },
                {
                    "id": "726940702",
                    "speaker": "伯特兰",
                    "text": "哦哦，那我们就再确认一下流程吧。"
                },
                {
                    "id": "726940703",
                    "speaker": "伯特兰",
                    "text": "要制造一个玩具，就必须在身上携带着「素材收集器」的时候，收集以下三个工序所需要的材料，听好了啊。"
                },
                {
                    "id": "726940704",
                    "speaker": "伯特兰",
                    "text": "第一步是「原材收集」，就是我们需要收集一些素材，矿石啊、果实啊、花啊之类的，作为基础的原材料。"
                },
                {
                    "id": "726940705",
                    "speaker": "伯特兰",
                    "text": "第二步是「元素充能」，得持续处在被元素影响的状态中一段时间，才能完成。"
                },
                {
                    "id": "726940706",
                    "speaker": "伯特兰",
                    "text": "最后是「核心激活」，需要击败一些元素生物来取得激活核心的动力。"
                },
                {
                    "id": "726940707",
                    "speaker": "伯特兰",
                    "text": "之后，素材收集器就收集完所有素材了，放入「大工机」进行制作就好。"
                },
                {
                    "id": "726940708",
                    "speaker": "伯特兰",
                    "text": "要是有问题就再来找我吧。"
                }
            ]
        },
        {
            "talkId": "7269408",
            "initDialog": "726940801",
            "dialogues": [
                {
                    "id": "726940801",
                    "speaker": "Player",
                    "text": "查看商品目录…"
                }
            ]
        },
        {
            "talkId": "7269409",
            "initDialog": "726940901",
            "dialogues": [
                {
                    "id": "726940901",
                    "speaker": "Player",
                    "text": "关于要留下的玩具…"
                },
                {
                    "id": "726940902",
                    "speaker": "伯特兰",
                    "text": "哦，有想要兑换的玩具款式吗？用兑换券换就行了，不过之前说好了，最多只能换四个哦…"
                }
            ]
        },
        {
            "talkId": "7269410",
            "initDialog": "726941001",
            "dialogues": [
                {
                    "id": "726941001",
                    "speaker": "Player",
                    "text": "不，没什么事…"
                },
                {
                    "id": "726941002",
                    "speaker": "伯特兰",
                    "text": "嗯嗯，那就继续制造吧，我很期待你带来的素材还能做出什么样的玩具呢！"
                }
            ]
        },
        {
            "talkId": "7269412",
            "initDialog": "726941201",
            "dialogues": [
                {
                    "id": "726941201",
                    "speaker": "Player",
                    "text": "进行试作商品制造…"
                },
                {
                    "id": "726941202",
                    "speaker": "伯特兰",
                    "text": "哦哦，又收集完素材了吗，我这就帮你启动「大工机」！"
                }
            ]
        }
    ]
}