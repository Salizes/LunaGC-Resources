{
    "groupId": "2126",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "悬帆": 8
    },
    "talks": [
        {
            "talkId": "6212601",
            "initDialog": "621260101",
            "dialogues": [
                {
                    "id": "621260101",
                    "speaker": "悬帆",
                    "text": "你敢相信吗，我居然被那位北斗大人看到了！"
                }
            ]
        },
        {
            "talkId": "6212602",
            "initDialog": "621260201",
            "dialogues": [
                {
                    "id": "621260201",
                    "speaker": "Player",
                    "text": "北斗大人？"
                },
                {
                    "id": "621260202",
                    "speaker": "悬帆",
                    "text": "没错，当时我正因为船队没有收获而倍感失落，萌生了退意想退出船队…"
                },
                {
                    "id": "621260203",
                    "speaker": "悬帆",
                    "text": "就在这个时候，我们的船正好和「南十字船队」的「死兆星号」交错而过，我看到了北斗大人站在船首之上…"
                },
                {
                    "id": "621260204",
                    "speaker": "悬帆",
                    "text": "…那一瞬间，我和北斗大人的眼神对上了。"
                },
                {
                    "id": "621260205",
                    "speaker": "悬帆",
                    "text": "我正好在她的左手边，她那征服了大海的勇气，都随着这一瞥传入了我的心中…"
                },
                {
                    "id": "621260206",
                    "speaker": "Player",
                    "text": "左边不是她戴眼罩的那一边吗？"
                },
                {
                    "id": "621260207",
                    "speaker": "悬帆",
                    "text": "…的确如此，但这种细节并不重要！"
                },
                {
                    "id": "621260208",
                    "speaker": "悬帆",
                    "text": "她实在是太伟大了！仅仅只是这一眼，她就挽救了一个水手颓废的灵魂…"
                }
            ]
        },
        {
            "talkId": "6212603",
            "initDialog": "621260301",
            "dialogues": [
                {
                    "id": "621260301",
                    "speaker": "Player",
                    "text": "恭喜你。"
                },
                {
                    "id": "621260302",
                    "speaker": "悬帆",
                    "text": "谢谢！我感谢北斗大人，让我水手的灵魂重新燃烧了起来！"
                }
            ]
        }
    ]
}