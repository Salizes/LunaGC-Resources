{
    "groupId": "3195",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "久美": 15
    },
    "talks": [
        {
            "talkId": "6319501",
            "initDialog": "631950101",
            "dialogues": [
                {
                    "id": "631950101",
                    "speaker": "久美",
                    "text": "啊，是你们。欢迎你们来到这里。"
                }
            ]
        },
        {
            "talkId": "6319502",
            "initDialog": "631950201",
            "dialogues": [
                {
                    "id": "631950201",
                    "speaker": "Player",
                    "text": "近来如何？"
                },
                {
                    "id": "631950202",
                    "speaker": "久美",
                    "text": "谢谢你们的关心，我在这里过得很好。"
                },
                {
                    "id": "631950203",
                    "speaker": "久美",
                    "text": "其实此前一个人回到这里，原本只是想要向「昆谛罗」…和自己的一些心事道别。"
                },
                {
                    "id": "631950204",
                    "speaker": "久美",
                    "text": "但现在我愈发觉得，这座岛屿比起鸣神岛更像是家…相比回忆，能触及更新鲜的快乐。"
                },
                {
                    "id": "631950205",
                    "speaker": "久美",
                    "text": "或许留在这里继续生活也不错。"
                }
            ]
        },
        {
            "talkId": "6319503",
            "initDialog": "631950301",
            "dialogues": [
                {
                    "id": "631950301",
                    "speaker": "Player",
                    "text": "关于阿妮萨…"
                },
                {
                    "id": "631950302",
                    "speaker": "久美",
                    "text": "她呀，还是一副冒冒失失的样子…"
                },
                {
                    "id": "631950303",
                    "speaker": "久美",
                    "text": "一点都没有自己身为外国人的自觉，天天跑去各种奇奇怪怪的危险地方…"
                },
                {
                    "id": "631950304",
                    "speaker": "久美",
                    "text": "一埋头就是一整天，耗在那些我听不懂的研究上…"
                },
                {
                    "id": "631950305",
                    "speaker": "久美",
                    "text": "她这样乱跑，总让人担惊受怕的。"
                },
                {
                    "id": "631950306",
                    "speaker": "久美",
                    "text": "不过她有时也挺体贴，而且说话的语调很好听。我能容忍就是了…"
                },
                {
                    "id": "631950307",
                    "speaker": "久美",
                    "text": "唔…请不要误会。她人还是很好的，我并不讨厌她。"
                }
            ]
        },
        {
            "talkId": "6319504",
            "initDialog": "631950401",
            "dialogues": [
                {
                    "id": "631950401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631950402",
                    "speaker": "久美",
                    "text": "再见，希望你一切顺利。"
                }
            ]
        },
        {
            "talkId": "7294501",
            "initDialog": "729450101",
            "dialogues": [
                {
                    "id": "729450101",
                    "speaker": "Player",
                    "text": "很高兴又见到你。"
                },
                {
                    "id": "729450102",
                    "speaker": "久美",
                    "text": "我也是，感谢你之前对我的帮助。"
                },
                {
                    "id": "729450103",
                    "speaker": "久美",
                    "text": "啊，顺便…阿妮萨也在努力适应这里的生活呢，最近她正在向我学习制作这边的料理。"
                },
                {
                    "id": "729450104",
                    "speaker": "久美",
                    "text": "只不过，她按照须弥的口味做了些许创新，唉…希望你不会嫌弃。"
                }
            ]
        }
    ]
}