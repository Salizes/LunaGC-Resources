{
    "groupId": "4224",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 8,
        "兰伽卢": 21
    },
    "talks": [
        {
            "talkId": "6422401",
            "initDialog": "642240101",
            "dialogues": [
                {
                    "id": "642240101",
                    "speaker": "兰伽卢",
                    "text": "维摩庄的小那菈们不知道怎么种地…可是那菈们又看不见兰那罗…"
                }
            ]
        },
        {
            "talkId": "6422402",
            "initDialog": "642240201",
            "dialogues": [
                {
                    "id": "642240201",
                    "speaker": "Player",
                    "text": "你有什么苦恼吗？"
                },
                {
                    "id": "642240202",
                    "speaker": "兰伽卢",
                    "text": "#啊，是那菈{NICKNAME}，你好。"
                },
                {
                    "id": "642240203",
                    "speaker": "兰伽卢",
                    "text": "兰伽卢想知道，那菈的种地方式。他们不会夸赞花，也不会唱歌给果树听。"
                },
                {
                    "id": "642240204",
                    "speaker": "兰伽卢",
                    "text": "但是却也能让树木高兴起来。"
                },
                {
                    "id": "642240205",
                    "speaker": "兰伽卢",
                    "text": "#那菈{NICKNAME}知道他们是怎么做到的吗？"
                }
            ]
        },
        {
            "talkId": "6422403",
            "initDialog": "642240301",
            "dialogues": [
                {
                    "id": "642240301",
                    "speaker": "Player",
                    "text": "关于毗波耶…"
                },
                {
                    "id": "642240302",
                    "speaker": "兰伽卢",
                    "text": "毗波耶们很高兴，比听到任何一首兰伽卢和兰那库拉唱的歌都要高兴。"
                },
                {
                    "id": "642240303",
                    "speaker": "兰伽卢",
                    "text": "是因为遇见了金色的那菈吗？"
                }
            ]
        },
        {
            "talkId": "6422404",
            "initDialog": "642240401",
            "dialogues": [
                {
                    "id": "642240401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642240402",
                    "speaker": "兰伽卢",
                    "text": "#谢谢你帮助兰伽卢，那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6422405",
            "initDialog": "642240501",
            "dialogues": [
                {
                    "id": "642240501",
                    "speaker": "Player",
                    "text": "施肥浇水？"
                },
                {
                    "id": "642240502",
                    "speaker": "兰伽卢",
                    "text": "浇水，兰伽卢明白，树木喜欢喝水，就像兰伽卢喜欢种地那样。"
                },
                {
                    "id": "642240503",
                    "speaker": "兰伽卢",
                    "text": "「试飞」…是什么？"
                },
                {
                    "id": "642240504",
                    "speaker": "兰伽卢",
                    "text": "飞起来给果树看吗…"
                }
            ]
        },
        {
            "talkId": "6422406",
            "initDialog": "642240601",
            "dialogues": [
                {
                    "id": "642240601",
                    "speaker": "兰伽卢",
                    "text": "无留陀被战胜了，桓那有更多的地方可以用来种地了，可是巴螺迦还是不行…"
                }
            ]
        },
        {
            "talkId": "6422407",
            "initDialog": "642240701",
            "dialogues": [
                {
                    "id": "642240701",
                    "speaker": "Player",
                    "text": "关于无留陀…"
                },
                {
                    "id": "642240702",
                    "speaker": "兰伽卢",
                    "text": "#多亏了那菈{NICKNAME}，无留陀在桓那不再有痕迹。"
                },
                {
                    "id": "642240703",
                    "speaker": "兰伽卢",
                    "text": "曾经被无留陀污染的土地，也能够听到毗波耶的笑声。"
                },
                {
                    "id": "642240704",
                    "speaker": "兰伽卢",
                    "text": "#等到那菈{NICKNAME}再次来到桓那的时候，一定会看到比现在更加绿的绿色。"
                }
            ]
        },
        {
            "talkId": "6422408",
            "initDialog": "642240801",
            "dialogues": [
                {
                    "id": "642240801",
                    "speaker": "Player",
                    "text": "关于巴螺迦…"
                },
                {
                    "id": "642240802",
                    "speaker": "兰伽卢",
                    "text": "巴螺迦与桓那不同，所有的泥土都变成了金色的尸骨。"
                },
                {
                    "id": "642240803",
                    "speaker": "兰伽卢",
                    "text": "没有兰那罗去过那里，就连那位兰帝裟也没有去过。"
                },
                {
                    "id": "642240804",
                    "speaker": "兰伽卢",
                    "text": "但是据说有那菈在巴螺迦种地。所以兰伽卢想知道，巴螺迦的那菈是怎么让那里的花高兴起来的。"
                },
                {
                    "id": "642240805",
                    "speaker": "兰伽卢",
                    "text": "#如果哪一天，那菈{NICKNAME}踏入了巴螺迦，可不可以帮兰伽卢问一问那里的那菈。"
                }
            ]
        },
        {
            "talkId": "6422409",
            "initDialog": "642240901",
            "dialogues": [
                {
                    "id": "642240901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642240902",
                    "speaker": "兰伽卢",
                    "text": "再见，如果去巴螺迦的话，要小心。"
                }
            ]
        },
        {
            "talkId": "6422410",
            "initDialog": "642241001",
            "dialogues": [
                {
                    "id": "642241001",
                    "speaker": "Player",
                    "text": "好的。"
                },
                {
                    "id": "642241002",
                    "speaker": "兰伽卢",
                    "text": "#谢谢那菈{NICKNAME}，希望有一天，巴螺迦的土地上也能开出毗波耶的花。"
                }
            ]
        }
    ]
}