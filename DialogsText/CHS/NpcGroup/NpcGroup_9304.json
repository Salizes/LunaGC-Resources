{
    "groupId": "9304",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "芭芭拉": 9
    },
    "talks": [
        {
            "talkId": "6930401",
            "initDialog": "693040101",
            "dialogues": [
                {
                    "id": "693040101",
                    "speaker": "芭芭拉",
                    "text": "你有没有受伤？不如在这里休息一会儿，让我给你做个检查。"
                },
                {
                    "id": "693040102",
                    "speaker": "芭芭拉",
                    "text": "没有大碍？不行不行！即便是再细小的伤口，也不能忽视。"
                },
                {
                    "id": "693040103",
                    "speaker": "芭芭拉",
                    "text": "不会耽误你多少时间的，我向你保证。"
                }
            ]
        },
        {
            "talkId": "6930402",
            "initDialog": "693040201",
            "dialogues": [
                {
                    "id": "693040201",
                    "speaker": "芭芭拉",
                    "text": "我不希望身边的人受伤。看着大家忍痛的样子，我心里也会跟着不好受…"
                },
                {
                    "id": "693040202",
                    "speaker": "芭芭拉",
                    "text": "但战斗难以避免。我力所能及的事是祈祷，还有在后方援助大家，为伤员治疗…"
                },
                {
                    "id": "693040203",
                    "speaker": "芭芭拉",
                    "text": "为了给同伴打起精神，我要保持笑容才行。"
                }
            ]
        },
        {
            "talkId": "6930403",
            "initDialog": "693040301",
            "dialogues": [
                {
                    "id": "693040301",
                    "speaker": "芭芭拉",
                    "text": "松鼠、红狐，小猫咪…"
                },
                {
                    "id": "693040302",
                    "speaker": "芭芭拉",
                    "text": "如果以「童话」为主题，要怎样才能写出一首令人温暖的歌谣呢？"
                },
                {
                    "id": "693040303",
                    "speaker": "芭芭拉",
                    "text": "我还是再从故事里找找灵感吧！"
                }
            ]
        }
    ]
}