{
    "groupId": "6238",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "坎内克": 8
    },
    "talks": [
        {
            "talkId": "6623801",
            "initDialog": "662380101",
            "dialogues": [
                {
                    "id": "662380101",
                    "speaker": "坎内克",
                    "text": "花羽会的人，不会天生都是诗人吧…"
                }
            ]
        },
        {
            "talkId": "6623802",
            "initDialog": "662380201",
            "dialogues": [
                {
                    "id": "662380201",
                    "speaker": "Player",
                    "text": "何出此言？"
                },
                {
                    "id": "662380202",
                    "speaker": "坎内克",
                    "text": "不知道是不是一个人骑龙飞行太寂寞，这边的骑士们其实都很会唱歌哦。"
                },
                {
                    "id": "662380203",
                    "speaker": "坎内克",
                    "text": "他们写信也是如此，有时很难分清写的到底是歌词还是情书。"
                },
                {
                    "id": "662380204",
                    "speaker": "坎内克",
                    "text": "唯一不会搞混的信件就是战报啦。"
                },
                {
                    "id": "662380205",
                    "speaker": "坎内克",
                    "text": "这边一直有定期巡逻的骑士。如果你看到有人从烬城那边飞回来，那说明我马上就要送信去话事处啦。"
                }
            ]
        },
        {
            "talkId": "6623803",
            "initDialog": "662380301",
            "dialogues": [
                {
                    "id": "662380301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662380302",
                    "speaker": "坎内克",
                    "text": "再见，需要送信的话可以来找我。"
                }
            ]
        },
        {
            "talkId": "7593801",
            "initDialog": "759380101",
            "dialogues": [
                {
                    "id": "759380101",
                    "speaker": "Player",
                    "text": "一定是很重要的情报。"
                },
                {
                    "id": "759380102",
                    "speaker": "坎内克",
                    "text": "的确。哪怕只是和往常一样的报平安，也算是重要的讯息了。"
                },
                {
                    "id": "759380103",
                    "speaker": "坎内克",
                    "text": "在一切顺利的日子里，骑士们会顺路带些物资或者纪念品回来。也算是值得期待的部分了。"
                }
            ]
        }
    ]
}