{
    "groupId": "6021",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "提莉乌娅": 9
    },
    "talks": [
        {
            "talkId": "6602101",
            "initDialog": "660210101",
            "dialogues": [
                {
                    "id": "660210101",
                    "speaker": "提莉乌娅",
                    "text": "当我为武器加上不败的祝福，那它就能祝福我不败…"
                }
            ]
        },
        {
            "talkId": "6602102",
            "initDialog": "660210201",
            "dialogues": [
                {
                    "id": "660210201",
                    "speaker": "Player",
                    "text": "这是…祝福的永动机？"
                },
                {
                    "id": "660210202",
                    "speaker": "提莉乌娅",
                    "text": "嗯？…呃，不算是吧…"
                },
                {
                    "id": "660210203",
                    "speaker": "提莉乌娅",
                    "text": "永动机听上去像是不存在的东西，那样的话就不灵了。"
                }
            ]
        },
        {
            "talkId": "6602103",
            "initDialog": "660210301",
            "dialogues": [
                {
                    "id": "660210301",
                    "speaker": "Player",
                    "text": "祝福你。"
                },
                {
                    "id": "660210302",
                    "speaker": "提莉乌娅",
                    "text": "谢谢！"
                }
            ]
        },
        {
            "talkId": "6602104",
            "initDialog": "660210401",
            "dialogues": [
                {
                    "id": "660210401",
                    "speaker": "Player",
                    "text": "原来真能实现不败吗？"
                },
                {
                    "id": "660210402",
                    "speaker": "提莉乌娅",
                    "text": "只要心中相信，那就总有实现的一天。"
                },
                {
                    "id": "660210403",
                    "speaker": "提莉乌娅",
                    "text": "…当然，重点还是得看施加祝福的人是否可靠。"
                },
                {
                    "id": "660210404",
                    "speaker": "提莉乌娅",
                    "text": "一般来讲，得去拜托德高望重的烟谜主朋友，帮忙在新买的武器上画点什么。"
                },
                {
                    "id": "660210405",
                    "speaker": "提莉乌娅",
                    "text": "不过如你所见，我是个摔跤手。摔跤手能用什么武器呢？"
                },
                {
                    "id": "660210406",
                    "speaker": "提莉乌娅",
                    "text": "所以我买的多数是护具。在护具上画满好看的图案，总归能让人安心一些。"
                }
            ]
        }
    ]
}