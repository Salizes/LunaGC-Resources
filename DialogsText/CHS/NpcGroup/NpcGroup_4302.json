{
    "groupId": "4302",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "娜丝琳": 16
    },
    "talks": [
        {
            "talkId": "6430201",
            "initDialog": "643020101",
            "dialogues": [
                {
                    "id": "643020101",
                    "speaker": "娜丝琳",
                    "text": "找…什…事吗？…讲。"
                }
            ]
        },
        {
            "talkId": "6430202",
            "initDialog": "643020201",
            "dialogues": [
                {
                    "id": "643020201",
                    "speaker": "Player",
                    "text": "呃…你好？"
                },
                {
                    "id": "643020202",
                    "speaker": "娜丝琳",
                    "text": "啊，抱歉…是不是我说话声音太小，你听不清啊？"
                },
                {
                    "id": "643020203",
                    "speaker": "娜丝琳",
                    "text": "咳咳。"
                },
                {
                    "id": "643020204",
                    "speaker": "娜丝琳",
                    "text": "我是想说：找我有什么事吗？请讲。"
                }
            ]
        },
        {
            "talkId": "6430203",
            "initDialog": "643020301",
            "dialogues": [
                {
                    "id": "643020301",
                    "speaker": "Player",
                    "text": "再…见？"
                },
                {
                    "id": "643020302",
                    "speaker": "娜丝琳",
                    "text": "…见。"
                }
            ]
        },
        {
            "talkId": "6430204",
            "initDialog": "643020401",
            "dialogues": [
                {
                    "id": "643020401",
                    "speaker": "Player",
                    "text": "是不是打扰你了？"
                },
                {
                    "id": "643020402",
                    "speaker": "娜丝琳",
                    "text": "不是你的问题，是我的老毛病啦。"
                },
                {
                    "id": "643020403",
                    "speaker": "娜丝琳",
                    "text": "我因为常常去野外打猎，而且偶尔会遇见在林中修行的学者，所以习惯了轻声细语，一时改不过来。"
                },
                {
                    "id": "643020404",
                    "speaker": "娜丝琳",
                    "text": "有很多人因为这个，误以为我性格内向，和我说话时都小心翼翼的。"
                },
                {
                    "id": "643020405",
                    "speaker": "娜丝琳",
                    "text": "其实没必要，请和我正常讲话就好。"
                }
            ]
        },
        {
            "talkId": "6430205",
            "initDialog": "643020501",
            "dialogues": [
                {
                    "id": "643020501",
                    "speaker": "Player",
                    "text": "关于修行的学者…"
                },
                {
                    "id": "643020502",
                    "speaker": "娜丝琳",
                    "text": "这个啊，虽然他们人数不多，而且地点隐蔽，但你如果常年混迹道成林的话，总能遇见的。"
                },
                {
                    "id": "643020503",
                    "speaker": "娜丝琳",
                    "text": "说实话，具体原理我也不是特别清楚。"
                },
                {
                    "id": "643020504",
                    "speaker": "娜丝琳",
                    "text": "只知道这种情况叫什么林中…什么什么语期？是学者们修行的特殊环节，不可以去贸然打扰。"
                },
                {
                    "id": "643020505",
                    "speaker": "娜丝琳",
                    "text": "所以我有时挺担心那个没经验的见习巡林员可能会不懂规矩，打扰到教令院的学者们。"
                },
                {
                    "id": "643020506",
                    "speaker": "娜丝琳",
                    "text": "嗯…不过既然她是跟着巡林官的，应该不至于像没读过《雨林生存指南》的那些人一样莽撞吧。"
                }
            ]
        },
        {
            "talkId": "6430206",
            "initDialog": "643020601",
            "dialogues": [
                {
                    "id": "643020601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6430207",
            "initDialog": "643020701",
            "dialogues": [
                {
                    "id": "643020701",
                    "speaker": "娜丝琳",
                    "text": "难道还是不够复杂吗…"
                }
            ]
        },
        {
            "talkId": "6430208",
            "initDialog": "643020801",
            "dialogues": [
                {
                    "id": "643020801",
                    "speaker": "娜丝琳",
                    "text": "感觉你需要再认真读读「七圣召唤」的规则书啊…"
                }
            ]
        }
    ]
}