    "talks": [
        {
            "talkId": "6953301",
            "initDialog": "695330101",
            "dialogues": [
                {
                    "id": "695330101",
                    "speaker": "八重神子",
                    "text": "这卡牌游戏居然还真的这么热门，唔…那《召唤王》也该再多出几部…"
                }
            ]
        },
        {
            "talkId": "6953302",
            "initDialog": "695330201",
            "dialogues": [
                {
                    "id": "695330201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953303",
            "initDialog": "695330301",
            "dialogues": [
                {
                    "id": "695330301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695330302",
                    "speaker": "八重神子",
                    "text": "这就要走了？我还想再和你切磋几局呢。"
                }
            ]
        },
        {
            "talkId": "6953304",
            "initDialog": "695330401",
            "dialogues": [
                {
                    "id": "695330401",
                    "speaker": "八重神子",
                    "text": "看来是我比较厉害嘛。趁热再来一局吧，这游戏还挺有意思的。"
                }
            ]
        },
        {
            "talkId": "6953305",
            "initDialog": "695330501",
            "dialogues": [
                {
                    "id": "695330501",
                    "speaker": "八重神子",
                    "text": "你赢啦，太好了，恭喜你呀。快快，让我听听你的获胜感言。"
                }
            ]
        },
        {
            "talkId": "6953306",
            "initDialog": "695330601",
            "dialogues": [
                {
                    "id": "695330601",
                    "speaker": "八重神子",
                    "text": "好呀，既然你都邀请我了…"
                }
            ]
        },
        {
            "talkId": "6953308",
            "initDialog": "695330801",
            "dialogues": [
                {
                    "id": "695330801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953309",
            "initDialog": "695330901",
            "dialogues": [
                {
                    "id": "695330901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6953310",
            "initDialog": "695331001",
            "dialogues": [
                {
                    "id": "695331001",
                    "speaker": "八重神子",
                    "text": "唔…别丧气嘛，一场游戏，尽兴就好。"
                }
            ]
        },
        {
            "talkId": "6953311",
            "initDialog": "695331101",
            "dialogues": [
                {
                    "id": "695331101",
                    "speaker": "八重神子",
                    "text": "行，是我输啦，你可以开始得意咯。"
                }
            ]
        },
        {
            "talkId": "6953312",
            "initDialog": "695331201",
            "dialogues": [
                {
                    "id": "695331201",
                    "speaker": "八重神子",
                    "text": "哎呀，这次你可要打得更有意思点呀。"
                }
            ]
        },
        {
            "talkId": "6953314",
            "initDialog": "695331401",
            "dialogues": [
                {
                    "id": "695331401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953315",
            "initDialog": "695331501",
            "dialogues": [
                {
                    "id": "695331501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6953316",
            "initDialog": "695331601",
            "dialogues": [
                {
                    "id": "695331601",
                    "speaker": "八重神子",
                    "text": "小家伙，看来你琢磨得还不够啊。"
                }
            ]
        },
        {
            "talkId": "6953317",
            "initDialog": "695331701",
            "dialogues": [
                {
                    "id": "695331701",
                    "speaker": "八重神子",
                    "text": "不错不错，你藏的那几手，可算是展示出来啦。"
                }
            ]
        },
        {
            "talkId": "6953318",
            "initDialog": "695331801",
            "dialogues": [
                {
                    "id": "695331801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
