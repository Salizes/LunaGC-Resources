{
    "groupId": "9047",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 18,
        "枫原万叶": 51
    },
    "talks": [
        {
            "talkId": "6904701",
            "initDialog": "690470101",
            "dialogues": [
                {
                    "id": "690470101",
                    "speaker": "枫原万叶",
                    "text": "#{NICKNAME}，你好啊。"
                },
                {
                    "id": "690470102",
                    "speaker": "枫原万叶",
                    "text": "风中有熟悉的气息，我就猜是你来了。"
                }
            ]
        },
        {
            "talkId": "6904702",
            "initDialog": "690470201",
            "dialogues": [
                {
                    "id": "690470201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690470202",
                    "speaker": "枫原万叶",
                    "text": "嗯。能有一个让我暂时安身的地方，我很开心。"
                },
                {
                    "id": "690470203",
                    "speaker": "枫原万叶",
                    "text": "我时常会独自欣赏窗外的景致。"
                },
                {
                    "id": "690470204",
                    "speaker": "枫原万叶",
                    "text": "四下无人，内心也会自然而然地平静下来。"
                },
                {
                    "id": "690470205",
                    "speaker": "枫原万叶",
                    "text": "明日之事不可知，但至少现在我拥有此刻的安稳。"
                },
                {
                    "id": "690470206",
                    "speaker": "枫原万叶",
                    "text": "只可惜我不能久居于此，不然我的刀就变钝了。",
                    "choices": [
                        {
                            "id": "690470207",
                            "text": "可以偶尔来休息一下。",
                            "response": [
                                {
                                    "id": "690470209",
                                    "speaker": "枫原万叶",
                                    "text": "那真是太感谢了。"
                                },
                                {
                                    "id": "690470210",
                                    "speaker": "枫原万叶",
                                    "text": "一年之中，总有酷暑与严冬。最热或最冷的那几天，对我来说也很难熬。"
                                },
                                {
                                    "id": "690470211",
                                    "speaker": "枫原万叶",
                                    "text": "这里的气候总是很舒适…"
                                },
                                {
                                    "id": "690470212",
                                    "speaker": "枫原万叶",
                                    "text": "能在这里悠闲地打发掉那段时光，真是一件幸福的事。"
                                }
                            ]
                        },
                        {
                            "id": "690470208",
                            "text": "这里随时欢迎你来。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904703",
            "initDialog": "690470301",
            "dialogues": [
                {
                    "id": "690470301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690470302",
                    "speaker": "枫原万叶",
                    "text": "可以啊，不过聊点什么好呢…我想想。"
                },
                {
                    "id": "690470303",
                    "speaker": "枫原万叶",
                    "text": "最近到雨季了吧，有什么关于雨的话题吗？",
                    "choices": [
                        {
                            "id": "690470304",
                            "text": "经常在野外遇见暴雨…",
                            "response": [
                                {
                                    "id": "690470305",
                                    "speaker": "枫原万叶",
                                    "text": "嗯，如果雨势很大，一般会找个地方躲雨吧。"
                                },
                                {
                                    "id": "690470308",
                                    "speaker": "枫原万叶",
                                    "text": "首选是山洞，不过如果山洞里有野兽，就需要先和它较量一番。"
                                },
                                {
                                    "id": "690470309",
                                    "speaker": "枫原万叶",
                                    "text": "其次的话会选择废弃的寺庙，不过那里通常四面漏风，还带着一股散不掉的霉味。"
                                },
                                {
                                    "id": "690470310",
                                    "speaker": "枫原万叶",
                                    "text": "如果实在没什么条件，也会在树底下躲雨。"
                                },
                                {
                                    "id": "690470311",
                                    "speaker": "枫原万叶",
                                    "text": "但是有雷暴的时候就不敢这么做了，会很危险。"
                                },
                                {
                                    "id": "690470312",
                                    "speaker": "枫原万叶",
                                    "text": "最后会试着去亮灯的人家碰碰运气…当然运气不好就算了。"
                                },
                                {
                                    "id": "690470313",
                                    "speaker": "Player",
                                    "text": "为什么最后才去试着借宿？"
                                },
                                {
                                    "id": "690470314",
                                    "speaker": "枫原万叶",
                                    "text": "雨夜有人带刀来访，一般人都会下意识地警惕吧。"
                                },
                                {
                                    "id": "690470315",
                                    "speaker": "枫原万叶",
                                    "text": "知道了这个道理，就没必要去打扰他们了。反正天地广阔，总有地方可去。"
                                },
                                {
                                    "id": "690470316",
                                    "speaker": "枫原万叶",
                                    "text": "别担心，野外不会一直下雨，人生也不会一直阴云密布。"
                                },
                                {
                                    "id": "690470317",
                                    "speaker": "枫原万叶",
                                    "text": "在晴朗的夜晚抬起头，自然会见到漫天星河。"
                                }
                            ]
                        },
                        {
                            "id": "690470306",
                            "text": "有什么躲雨的推荐吗？",
                            "response": [
                                {
                                    "id": "690470307",
                                    "speaker": "枫原万叶",
                                    "text": "嗯…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904704",
            "initDialog": "690470401",
            "dialogues": [
                {
                    "id": "690470401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690470402",
                    "speaker": "枫原万叶",
                    "text": "嗯，请收下这个。"
                },
                {
                    "id": "690470403",
                    "speaker": "枫原万叶",
                    "text": "听说故乡的枫叶已经染上了红色，很想回去看看。不过路途遥远，暂时回不去了…"
                },
                {
                    "id": "690470404",
                    "speaker": "枫原万叶",
                    "text": "前几天在集市上闲逛，见到了保存良好的枫叶标本，就买了几枚。"
                },
                {
                    "id": "690470405",
                    "speaker": "枫原万叶",
                    "text": "虽然不确定是否为故乡所产，但也能稍稍抚平思乡之苦。",
                    "choices": [
                        {
                            "id": "690470406",
                            "text": "万叶很喜欢枫叶吗？",
                            "response": [
                                {
                                    "id": "690470407",
                                    "speaker": "枫原万叶",
                                    "text": "是啊。"
                                },
                                {
                                    "id": "690470408",
                                    "speaker": "枫原万叶",
                                    "text": "以前我也会在秋风起时收集一些枫叶，带在身上。"
                                },
                                {
                                    "id": "690470409",
                                    "speaker": "枫原万叶",
                                    "text": "在船上的时候，我也曾把枫叶撒落在海水中，看着它们漂向遥远的地方。"
                                },
                                {
                                    "id": "690470410",
                                    "speaker": "枫原万叶",
                                    "text": "也许，也会有一个像我一样思念故乡的人，捡到其中的某一片吧…"
                                },
                                {
                                    "id": "690470416",
                                    "speaker": "Player",
                                    "text": "我也想去万叶的故乡看看。"
                                },
                                {
                                    "id": "690470417",
                                    "speaker": "枫原万叶",
                                    "text": "啊…失礼了。"
                                },
                                {
                                    "id": "690470418",
                                    "speaker": "枫原万叶",
                                    "text": "本该是由我主动邀请…我却独自沉浸在思乡的情绪之中。",
                                    "choices": [
                                        {
                                            "id": "690470419",
                                            "text": "没关系的。",
                                            "response": [
                                                {
                                                    "id": "690470421",
                                                    "speaker": "枫原万叶",
                                                    "text": "…谢谢。"
                                                },
                                                {
                                                    "id": "690470422",
                                                    "speaker": "枫原万叶",
                                                    "text": "那便以这枫叶为信物，与你就此约定了。"
                                                },
                                                {
                                                    "id": "690470423",
                                                    "speaker": "枫原万叶",
                                                    "text": "等下次枫叶红时，共赴故乡。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690470420",
                                            "text": "我能够理解万叶的心情。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690470411",
                            "text": "看上去确实很漂亮。",
                            "response": [
                                {
                                    "id": "690470412",
                                    "speaker": "枫原万叶",
                                    "text": "是吧…单纯从观赏的角度来看，染红的枫叶也有着别样的美感。"
                                },
                                {
                                    "id": "690470413",
                                    "speaker": "枫原万叶",
                                    "text": "在我的故乡，人们每年都会观赏红叶飘落的盛景。"
                                },
                                {
                                    "id": "690470414",
                                    "speaker": "枫原万叶",
                                    "text": "树上的枫叶犹如红色的火烧云，落下的便是红色的雨。"
                                },
                                {
                                    "id": "690470415",
                                    "speaker": "枫原万叶",
                                    "text": "落叶在地上积满厚厚的一层，秋虫鸣叫，野鸟徘徊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904705",
            "initDialog": "690470501",
            "dialogues": [
                {
                    "id": "690470501",
                    "speaker": "Player",
                    "text": "早啊，万叶。"
                },
                {
                    "id": "690470502",
                    "speaker": "枫原万叶",
                    "text": "早…总觉得你今天和平时有些不太一样。"
                },
                {
                    "id": "690470503",
                    "speaker": "枫原万叶",
                    "text": "有什么事可以跟我说，别的不敢保证，「听」我还是很擅长的。"
                }
            ]
        },
        {
            "talkId": "6904706",
            "initDialog": "690470601",
            "dialogues": [
                {
                    "id": "690470601",
                    "speaker": "Player",
                    "text": "晚安，万叶。"
                },
                {
                    "id": "690470602",
                    "speaker": "枫原万叶",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690470603",
                    "speaker": "枫原万叶",
                    "text": "今晚的风很温和，大概会吹来很多美好的梦。"
                }
            ]
        },
        {
            "talkId": "6904707",
            "initDialog": "690470701",
            "dialogues": [
                {
                    "id": "690470701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904708",
            "initDialog": "690470801",
            "dialogues": [
                {
                    "id": "690470801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904709",
            "initDialog": "690470901",
            "dialogues": [
                {
                    "id": "690470901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904710",
            "initDialog": "690471001",
            "dialogues": [
                {
                    "id": "690471001",
                    "speaker": "枫原万叶",
                    "text": "做工细致的装潢，静谧的茶室，缭绕的茶香…"
                },
                {
                    "id": "690471002",
                    "speaker": "枫原万叶",
                    "text": "嗯，这里的氛围，我很中意。"
                },
                {
                    "id": "690471003",
                    "speaker": "枫原万叶",
                    "text": "有空之时，不妨与我一同在此品茶，聊聊你欣赏的诗句？"
                }
            ]
        },
        {
            "talkId": "6904711",
            "initDialog": "690471101",
            "dialogues": [
                {
                    "id": "690471101",
                    "speaker": "枫原万叶",
                    "text": "恬美的景致，令人心情舒畅。"
                },
                {
                    "id": "690471102",
                    "speaker": "枫原万叶",
                    "text": "看似平平无奇的山野，其实蕴含着悠远的诗意。"
                },
                {
                    "id": "690471103",
                    "speaker": "枫原万叶",
                    "text": "倾注心神时，一花一木，自然万物，都会在你耳边低语。"
                }
            ]
        }
    ]
}