{
    "groupId": "4354",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "玛亚姆": 9
    },
    "talks": [
        {
            "talkId": "6435401",
            "initDialog": "643540101",
            "dialogues": [
                {
                    "id": "643540101",
                    "speaker": "玛亚姆",
                    "text": "亲爱的客人，需要歇脚的地方吗？"
                }
            ]
        },
        {
            "talkId": "6435402",
            "initDialog": "643540201",
            "dialogues": [
                {
                    "id": "643540201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "643540202",
                    "speaker": "玛亚姆",
                    "text": "这里是「金砂之旅」，我呢，就是这间旅店的老板啦。"
                },
                {
                    "id": "643540203",
                    "speaker": "玛亚姆",
                    "text": "不用担心，我不会因为自己开着喀万驿唯一的旅店就漫天要价，所以客人可以放心入住。"
                },
                {
                    "id": "643540204",
                    "speaker": "玛亚姆",
                    "text": "当然，如果你愿意找附近的居民或者游学者的住所借住，也是可以的。"
                },
                {
                    "id": "643540205",
                    "speaker": "玛亚姆",
                    "text": "不过因为这里是驿站，来往的人…鱼龙混杂，所以客人在选取住所时，可要睁大双眼啊。"
                }
            ]
        },
        {
            "talkId": "6435403",
            "initDialog": "643540301",
            "dialogues": [
                {
                    "id": "643540301",
                    "speaker": "Player",
                    "text": "暂时不用。"
                },
                {
                    "id": "643540302",
                    "speaker": "玛亚姆",
                    "text": "那就欢迎再来咯。"
                }
            ]
        },
        {
            "talkId": "7395701",
            "initDialog": "739570101",
            "dialogues": [
                {
                    "id": "739570101",
                    "speaker": "Player",
                    "text": "多谢提醒。"
                },
                {
                    "id": "739570102",
                    "speaker": "玛亚姆",
                    "text": "举手之劳，不必客气。"
                },
                {
                    "id": "739570103",
                    "speaker": "玛亚姆",
                    "text": "旅途劳累，最重要的就是充足的食物和安全的住处。"
                },
                {
                    "id": "739570104",
                    "speaker": "玛亚姆",
                    "text": "而这两点，便是小店能够提供给大家的了。"
                }
            ]
        }
    ]
}