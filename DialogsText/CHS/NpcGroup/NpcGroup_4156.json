{
    "groupId": "4156",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "普里亚": 6
    },
    "talks": [
        {
            "talkId": "6415601",
            "initDialog": "641560101",
            "dialogues": [
                {
                    "id": "641560101",
                    "speaker": "普里亚",
                    "text": "没有什么比为新人打造成对的首饰更令人开心的了。"
                }
            ]
        },
        {
            "talkId": "6415602",
            "initDialog": "641560201",
            "dialogues": [
                {
                    "id": "641560201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641560202",
                    "speaker": "普里亚",
                    "text": "我是住在集市附近的居民，也是打造金器的手工匠。"
                },
                {
                    "id": "641560203",
                    "speaker": "普里亚",
                    "text": "这活做了一辈子啦，大大小小、值钱不值钱的金器都摸了个够，但还是最喜欢为新人们做首饰。"
                },
                {
                    "id": "641560204",
                    "speaker": "普里亚",
                    "text": "小情侣们拿着新做好的金器，脸上绽放出比金子还灿烂的光芒，我这老头子看了也觉得开心啊。"
                },
                {
                    "id": "641560205",
                    "speaker": "普里亚",
                    "text": "唉，就是最近有点老花眼咯，低头画图纸时总是看不清…你说，我是不是该琢磨着收个徒弟了啊？"
                }
            ]
        },
        {
            "talkId": "6415603",
            "initDialog": "641560301",
            "dialogues": [
                {
                    "id": "641560301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641560302",
                    "speaker": "普里亚",
                    "text": "慢点走，年轻真好啊。"
                }
            ]
        }
    ]
}