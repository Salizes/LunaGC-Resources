{
    "groupId": "4178",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "雅丝敏": 11
    },
    "talks": [
        {
            "talkId": "6417801",
            "initDialog": "641780101",
            "dialogues": [
                {
                    "id": "641780101",
                    "speaker": "雅丝敏",
                    "text": "唔，还好…圣树的根系一切正常。"
                }
            ]
        },
        {
            "talkId": "6417802",
            "initDialog": "641780201",
            "dialogues": [
                {
                    "id": "641780201",
                    "speaker": "Player",
                    "text": "关于那种药水…"
                },
                {
                    "id": "641780202",
                    "speaker": "雅丝敏",
                    "text": "你是说上次我们一起播撒的那种药水吧？"
                },
                {
                    "id": "641780203",
                    "speaker": "雅丝敏",
                    "text": "唔…拉德普和法尔希还在改进它呢。"
                },
                {
                    "id": "641780204",
                    "speaker": "雅丝敏",
                    "text": "虽然效果确实不错，但拉德普加入的那种「生理催吐剂」实在是让其他人不太好受。"
                },
                {
                    "id": "641780205",
                    "speaker": "雅丝敏",
                    "text": "而且不知道为什么，这种药水还会吸引蕈兽。"
                },
                {
                    "id": "641780206",
                    "speaker": "雅丝敏",
                    "text": "希望拉德普能快点想出改良的办法来…"
                }
            ]
        },
        {
            "talkId": "6417803",
            "initDialog": "641780301",
            "dialogues": [
                {
                    "id": "641780301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641780302",
                    "speaker": "雅丝敏",
                    "text": "嗯，再见。"
                },
                {
                    "id": "641780303",
                    "speaker": "雅丝敏",
                    "text": "下次我播撒药水的时候，说不定还要请你帮忙，到时候就拜托啦。"
                }
            ]
        },
        {
            "talkId": "6417804",
            "initDialog": "641780401",
            "dialogues": [
                {
                    "id": "641780401",
                    "speaker": "Player",
                    "text": "他们俩还好吗？"
                },
                {
                    "id": "641780402",
                    "speaker": "雅丝敏",
                    "text": "从学业角度来说，他们俩现在可开心啦。既有了研究成果，又搜集到了实证数据。"
                },
                {
                    "id": "641780403",
                    "speaker": "雅丝敏",
                    "text": "但从生活角度来说，他们已经连饭都顾不上吃了，作息也已经完全混乱…"
                },
                {
                    "id": "641780404",
                    "speaker": "雅丝敏",
                    "text": "用他们的话说，这就是做研究的代价吧。"
                }
            ]
        }
    ]
}