{
    "groupId": "6022",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "延塔莎": 12
    },
    "talks": [
        {
            "talkId": "6602201",
            "initDialog": "660220101",
            "dialogues": [
                {
                    "id": "660220101",
                    "speaker": "延塔莎",
                    "text": "欢迎光临卡考苦饮铺！准备迎接最奇幻的味蕾体验吧！"
                }
            ]
        },
        {
            "talkId": "6602202",
            "initDialog": "660220201",
            "dialogues": [
                {
                    "id": "660220201",
                    "speaker": "Player",
                    "text": "奇幻？"
                },
                {
                    "id": "660220202",
                    "speaker": "延塔莎",
                    "text": "用最美妙的果实鲜榨，用最神秘的香料佐味，为你带来最丰富的口感！"
                },
                {
                    "id": "660220203",
                    "speaker": "延塔莎",
                    "text": "喝过之后的感觉，就像被大灵送上了世间所有的祝福，如绒翼龙的羽毛一样飞上云端…"
                }
            ]
        },
        {
            "talkId": "6602203",
            "initDialog": "660220301",
            "dialogues": [
                {
                    "id": "660220301",
                    "speaker": "Player",
                    "text": "以后再说吧。"
                },
                {
                    "id": "660220302",
                    "speaker": "延塔莎",
                    "text": "那要记得再来哦！"
                }
            ]
        },
        {
            "talkId": "6602204",
            "initDialog": "660220401",
            "dialogues": [
                {
                    "id": "660220401",
                    "speaker": "Player",
                    "text": "听起来怪怪的…"
                },
                {
                    "id": "660220402",
                    "speaker": "延塔莎",
                    "text": "那是因为，奇怪就是本店的卖点嘛！其他地方的游客我不清楚，我们纳塔人还挺吃这一套的。"
                },
                {
                    "id": "660220403",
                    "speaker": "延塔莎",
                    "text": "可能因为大灵的祝福之类的东西，听起来就很吉利吧！"
                },
                {
                    "id": "660220404",
                    "speaker": "延塔莎",
                    "text": "所以其实…说实话，这些饮料没什么特别的，但是能给大家带来丰富的精神支持哦。"
                },
                {
                    "id": "660220405",
                    "speaker": "延塔莎",
                    "text": "不过饮料本身不是什么坏东西啦，材料扎实，十分健康。"
                }
            ]
        },
        {
            "talkId": "7591201",
            "initDialog": "759120101",
            "dialogues": [
                {
                    "id": "759120101",
                    "speaker": "Player",
                    "text": "那有没有普通一点的？"
                },
                {
                    "id": "759120102",
                    "speaker": "延塔莎",
                    "text": "……"
                },
                {
                    "id": "759120103",
                    "speaker": "延塔莎",
                    "text": "……"
                },
                {
                    "id": "759120104",
                    "speaker": "延塔莎",
                    "text": "抱歉，我是不是沉默了很久。因为实在想不出普通的饮料是什么样的。"
                },
                {
                    "id": "759120105",
                    "speaker": "延塔莎",
                    "text": "汤…汤算饮料吗？这个是我按照普通食谱做的，应该没什么问题吧？"
                }
            ]
        }
    ]
}