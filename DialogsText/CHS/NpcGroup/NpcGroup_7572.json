{
    "groupId": "7572",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "索博列夫": 14
    },
    "talks": [
        {
            "talkId": "6757201",
            "initDialog": "675720101",
            "dialogues": [
                {
                    "id": "675720101",
                    "speaker": "索博列夫",
                    "text": "现在各种事情已经够焦头烂额的了。女皇保佑，这个时候千万不要再下雪了…"
                }
            ]
        },
        {
            "talkId": "6757202",
            "initDialog": "675720201",
            "dialogues": [
                {
                    "id": "675720201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "675720202",
                    "speaker": "索博列夫",
                    "text": "我？索博列夫，是这里的工程主管。凡是跟采冰沾边的事，都归我头疼。当然，说是主管，其实也就是个高级点的苦力罢了…"
                },
                {
                    "id": "675720203",
                    "speaker": "索博列夫",
                    "text": "看你的打扮，应该是外来的旅人吧？如果需要帮忙，你可以去镇上找涅克拉索夫，接待答疑是他的活儿。"
                },
                {
                    "id": "675720204",
                    "speaker": "索博列夫",
                    "text": "呵，不过那家伙愿意帮的忙估计也有限。真遇上麻烦，你就只能自求多福了…"
                }
            ]
        },
        {
            "talkId": "6757203",
            "initDialog": "675720301",
            "dialogues": [
                {
                    "id": "675720301",
                    "speaker": "Player",
                    "text": "下雪会有什么影响吗？"
                },
                {
                    "id": "675720302",
                    "speaker": "索博列夫",
                    "text": "那麻烦可就大了去了。最要命的就是降温，不仅采冰的设备容易罢工，工人们的身体也吃不消。"
                },
                {
                    "id": "675720303",
                    "speaker": "索博列夫",
                    "text": "更何况，万一大雪封路，列车就得停运。到时候别说把货物按期交上去，恐怕连镇上急需的补给和零件都送不进来。"
                },
                {
                    "id": "675720304",
                    "speaker": "索博列夫",
                    "text": "只不过，该做的准备，我们都已经提前做到了。接下来能做的…恐怕也只有祈祷了。"
                }
            ]
        },
        {
            "talkId": "6757204",
            "initDialog": "675720401",
            "dialogues": [
                {
                    "id": "675720401",
                    "speaker": "Player",
                    "text": "有什么需要帮忙的吗？"
                },
                {
                    "id": "675720402",
                    "speaker": "索博列夫",
                    "text": "巧了，还真有。我这儿等会有一批货物要装车发往至冬堡。结果负责押车的队伍里，有三个人到现在还没见着人影。"
                },
                {
                    "id": "675720403",
                    "speaker": "索博列夫",
                    "text": "虽说少他们三个也能凑合发车，但路上万一出点什么岔子，临时缺人手，那可就是大麻烦了。"
                },
                {
                    "id": "675720404",
                    "speaker": "索博列夫",
                    "text": "我估计这几个糊涂蛋是把日子记错了，这会儿多半还在底下闷头干活呢。就麻烦你跑一趟，去他们的工作区找找人吧…"
                }
            ]
        },
        {
            "talkId": "6757205",
            "initDialog": "675720501",
            "dialogues": [
                {
                    "id": "675720501",
                    "speaker": "索博列夫",
                    "text": "嗯，看样子这三个蠢货是赶上车了。还好还好…只要没耽误事儿，我也懒得跟他们计较了。"
                },
                {
                    "id": "675720502",
                    "speaker": "索博列夫",
                    "text": "辛苦你跑这一趟了。唉，今天总算是有那么一件事儿是被顺利解决的了…对了，这是给你的报酬，多谢你帮忙了。"
                }
            ]
        },
        {
            "talkId": "6757206",
            "initDialog": "675720601",
            "dialogues": [
                {
                    "id": "675720601",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "675720602",
                    "speaker": "索博列夫",
                    "text": "嗯，多谢。"
                }
            ]
        },
        {
            "talkId": "6757207",
            "initDialog": "675720701",
            "dialogues": [
                {
                    "id": "675720701",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "6757208",
            "initDialog": "675720801",
            "dialogues": [
                {
                    "id": "675720801",
                    "speaker": "索博列夫",
                    "text": "没有…唉，值得留意的恐怕就是我乱成一团糟的工作了…"
                }
            ]
        }
    ]
}