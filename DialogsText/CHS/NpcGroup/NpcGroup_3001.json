{
    "groupId": "3001",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "弥生七月": 10
    },
    "talks": [
        {
            "talkId": "6300101",
            "initDialog": "630010101",
            "dialogues": [
                {
                    "id": "630010101",
                    "speaker": "弥生七月",
                    "text": "极上品质，尽在「弥生漆器」。"
                }
            ]
        },
        {
            "talkId": "6300102",
            "initDialog": "630010201",
            "dialogues": [
                {
                    "id": "630010201",
                    "speaker": "Player",
                    "text": "关于「弥生漆器」…"
                },
                {
                    "id": "630010202",
                    "speaker": "弥生七月",
                    "text": "如果想寻得全稻妻最好的漆器，那就只有在「弥生漆器」了。"
                },
                {
                    "id": "630010203",
                    "speaker": "弥生七月",
                    "text": "极上品质，独此一家，就连幕府的大人物们都会前来定制。"
                },
                {
                    "id": "630010204",
                    "speaker": "弥生七月",
                    "text": "我家是经营多年的老工坊，到我手上已是第四代，追求极致的祖训也传承至今。"
                },
                {
                    "id": "630010205",
                    "speaker": "弥生七月",
                    "text": "再加上我从须弥学到的合成秘法，一定可以锦上添花。"
                }
            ]
        },
        {
            "talkId": "6300103",
            "initDialog": "630010301",
            "dialogues": [
                {
                    "id": "630010301",
                    "speaker": "Player",
                    "text": "可以借用合成台吗？"
                },
                {
                    "id": "630010302",
                    "speaker": "弥生七月",
                    "text": "请便，只要不影响我的研究工作就好。注意安全。"
                }
            ]
        },
        {
            "talkId": "6300104",
            "initDialog": "630010401",
            "dialogues": [
                {
                    "id": "630010401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630010402",
                    "speaker": "弥生七月",
                    "text": "再见，相信下次见面就能看到我的新作品了。"
                }
            ]
        },
        {
            "talkId": "6300105",
            "initDialog": "630010501",
            "dialogues": [
                {
                    "id": "630010501",
                    "speaker": "Player",
                    "text": "须弥？"
                },
                {
                    "id": "630010502",
                    "speaker": "弥生七月",
                    "text": "我曾去往须弥教令院游学，在那里学到的合成秘法可以让我制出世上独一无二的涂料。"
                },
                {
                    "id": "630010503",
                    "speaker": "弥生七月",
                    "text": "漆器的技艺令人着迷，我的追求便是精通一技，融会贯通。"
                },
                {
                    "id": "630010504",
                    "speaker": "弥生七月",
                    "text": "如果最终能抵达极致的境界，那么漆器之中也会蕴含真理的纹样吧…"
                }
            ]
        }
    ]
}