{
    "groupId": "2093",
    "total_dialogue_lines": 58,
    "speaker_counts": {
        "Player": 12,
        "萍姥姥": 46
    },
    "talks": [
        {
            "talkId": "2070401",
            "initDialog": "207040101",
            "dialogues": [
                {
                    "id": "207040101",
                    "speaker": "萍姥姥",
                    "text": "(test)害，最近不知道是谁经常会把这附近的花给摘走，弄得我想赏花都没得赏了"
                },
                {
                    "id": "207040102",
                    "speaker": "萍姥姥",
                    "text": "#(test) {NICKNAME}, 我这里有一些种子，能不能帮我在这附近合适的地方种一下呀？"
                }
            ]
        },
        {
            "talkId": "4003745",
            "initDialog": "400374501",
            "dialogues": [
                {
                    "id": "400374501",
                    "speaker": "萍姥姥",
                    "text": "嗯？是你啊，孩子。"
                },
                {
                    "id": "400374502",
                    "speaker": "萍姥姥",
                    "text": "花开花谢，人去人归，但璃月的海灯节总会如期举办。"
                },
                {
                    "id": "400374503",
                    "speaker": "萍姥姥",
                    "text": "不过今年的海灯节和以往的不太一样，孩子你可以多转转，多看看，慢慢享受璃月港的景色，呵呵。"
                }
            ]
        },
        {
            "talkId": "6209307",
            "initDialog": "620930701",
            "dialogues": [
                {
                    "id": "620930701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6209308",
            "initDialog": "620930801",
            "dialogues": [
                {
                    "id": "620930801",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6209309",
            "initDialog": "620930901",
            "dialogues": [
                {
                    "id": "620930901",
                    "speaker": "萍姥姥",
                    "text": "了不起，这可是我想了很久的局呀…"
                }
            ]
        },
        {
            "talkId": "6209310",
            "initDialog": "620931001",
            "dialogues": [
                {
                    "id": "620931001",
                    "speaker": "萍姥姥",
                    "text": "可别小看我了哦…"
                }
            ]
        },
        {
            "talkId": "6209311",
            "initDialog": "620931101",
            "dialogues": [
                {
                    "id": "620931101",
                    "speaker": "萍姥姥",
                    "text": "嗯，是我输啦，年轻人，论起打牌，还是你技高一筹啊。"
                }
            ]
        },
        {
            "talkId": "6209312",
            "initDialog": "620931201",
            "dialogues": [
                {
                    "id": "620931201",
                    "speaker": "萍姥姥",
                    "text": "呵呵，年轻人，可别是看我年纪大了，故意让我吧？"
                }
            ]
        },
        {
            "talkId": "7180001",
            "initDialog": "718000101",
            "dialogues": [
                {
                    "id": "718000101",
                    "speaker": "萍姥姥",
                    "text": "奇怪了…"
                },
                {
                    "id": "718000102",
                    "speaker": "Player",
                    "text": "婆婆，您怎么了？"
                },
                {
                    "id": "718000104",
                    "speaker": "萍姥姥",
                    "text": "是你们啊，我正在打理我的壶呢。"
                },
                {
                    "id": "718000106",
                    "speaker": "萍姥姥",
                    "text": "自从你们上次帮我打扫了一次我的壶之后，我就想着，要把壶彻底给打扫干净。"
                },
                {
                    "id": "718000107",
                    "speaker": "萍姥姥",
                    "text": "这样以后拿出这盏壶请客喝茶的时候，也好拿得出手。"
                },
                {
                    "id": "718000108",
                    "speaker": "萍姥姥",
                    "text": "我就去碧水河边，拿水把这壶给里里外外洗了一遍，但我这壶啊，实在是难洗干净。"
                },
                {
                    "id": "718000109",
                    "speaker": "萍姥姥",
                    "text": "孩子们，你们愿意帮我老婆子一把，再去打扫打扫壶里吗？"
                }
            ]
        },
        {
            "talkId": "7180005",
            "initDialog": "718000103",
            "dialogues": [
                {
                    "id": "718000103",
                    "speaker": "Player",
                    "text": "交给我们吧。"
                },
                {
                    "id": "718000105",
                    "speaker": "萍姥姥",
                    "text": "好，那就麻烦你们啦，孩子们。"
                }
            ]
        },
        {
            "talkId": "7180006",
            "initDialog": "718000110",
            "dialogues": [
                {
                    "id": "718000110",
                    "speaker": "Player",
                    "text": "还有别的事…"
                },
                {
                    "id": "718000111",
                    "speaker": "萍姥姥",
                    "text": "没关系，你们先忙你们的去，我老婆子的这么点琐事，不着急。"
                }
            ]
        },
        {
            "talkId": "7191801",
            "initDialog": "719180101",
            "dialogues": [
                {
                    "id": "719180101",
                    "speaker": "Player",
                    "text": "这花真是漂亮。"
                },
                {
                    "id": "719180102",
                    "speaker": "萍姥姥",
                    "text": "呵呵，应该说多亏了如今的太平盛世。"
                },
                {
                    "id": "719180103",
                    "speaker": "萍姥姥",
                    "text": "其实我一直希望，有朝一日这花能再次遍布璃月大地，希望它们不会再次销声匿迹…"
                },
                {
                    "id": "719180104",
                    "speaker": "萍姥姥",
                    "text": "不过在此之前，希望你能带上一些这玉京台的花儿，让它们先见见外面的世界吧。"
                }
            ]
        },
        {
            "talkId": "6209301",
            "initDialog": "620930101",
            "dialogues": [
                {
                    "id": "620930101",
                    "speaker": "萍姥姥",
                    "text": "…这年头，愿意沉下心赏花的年轻人可不算多呢。"
                }
            ]
        },
        {
            "talkId": "6209302",
            "initDialog": "620930201",
            "dialogues": [
                {
                    "id": "620930201",
                    "speaker": "Player",
                    "text": "您是在赏花？"
                },
                {
                    "id": "620930202",
                    "speaker": "萍姥姥",
                    "text": "是啊，这花一代又一代，花谢又花开，生生不息，就和璃月一样。"
                },
                {
                    "id": "620930203",
                    "speaker": "萍姥姥",
                    "text": "你看这边，还有这边，又新开了好几朵花…看来今年是个好年，一定会有好事发生的。"
                }
            ]
        },
        {
            "talkId": "6209303",
            "initDialog": "620930301",
            "dialogues": [
                {
                    "id": "620930301",
                    "speaker": "Player",
                    "text": "这是什么花？"
                },
                {
                    "id": "620930302",
                    "speaker": "萍姥姥",
                    "text": "这是「琉璃百合」，璃月港最后的琉璃百合应该都在这里了。"
                },
                {
                    "id": "620930303",
                    "speaker": "萍姥姥",
                    "text": "人们说这种花能聆听人们的歌声，美丽的音乐对于它有如养分一般…"
                },
                {
                    "id": "620930304",
                    "speaker": "萍姥姥",
                    "text": "而厮杀、诅咒与破坏的声音对它们而言则如鸩毒，会腐蚀它们的根系。"
                },
                {
                    "id": "620930305",
                    "speaker": "萍姥姥",
                    "text": "所以…在千年前的纷争之中，它们在璃月大地上销声匿迹了…"
                }
            ]
        },
        {
            "talkId": "6209304",
            "initDialog": "620930401",
            "dialogues": [
                {
                    "id": "620930401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620930402",
                    "speaker": "萍姥姥",
                    "text": "再见，年轻人。如果你恰好路过绝云间的话，请代我向老朋友们问候一声。"
                },
                {
                    "id": "620930403",
                    "speaker": "萍姥姥",
                    "text": "有缘你自会见到他们。"
                }
            ]
        },
        {
            "talkId": "6209305",
            "initDialog": "620930501",
            "dialogues": [
                {
                    "id": "620930501",
                    "speaker": "萍姥姥",
                    "text": "嗯？是你啊，孩子。"
                },
                {
                    "id": "620930502",
                    "speaker": "萍姥姥",
                    "text": "花开花谢，人去人归，我就知道你会回来看我的，呵呵。"
                }
            ]
        },
        {
            "talkId": "6209306",
            "initDialog": "620930601",
            "dialogues": [
                {
                    "id": "620930601",
                    "speaker": "Player",
                    "text": "关于过去。"
                },
                {
                    "id": "620930602",
                    "speaker": "萍姥姥",
                    "text": "呵呵，你是在暗示我老朽不堪了吗？"
                },
                {
                    "id": "620930603",
                    "speaker": "萍姥姥",
                    "text": "不用道歉，我只是说笑而已…"
                },
                {
                    "id": "620930604",
                    "speaker": "萍姥姥",
                    "text": "年纪大了，闲时多了，过往的事情也便越来越历历在目了…也不知山里的老朋友们，如今过得如何了…"
                },
                {
                    "id": "620930605",
                    "speaker": "萍姥姥",
                    "text": "看着璃月港当今的繁华，会不会也想来凡人的烟火世界体验一下呢…？"
                },
                {
                    "id": "620930606",
                    "speaker": "萍姥姥",
                    "text": "不好意思，自言自语了一些莫名其妙的话。关于我的过去…还是有缘再讲吧。"
                }
            ]
        },
        {
            "talkId": "7209301",
            "initDialog": "720930101",
            "dialogues": [
                {
                    "id": "720930101",
                    "speaker": "萍姥姥",
                    "text": "今年「明霄灯」的造型是纪念「移霄导天真君」啊，那个喜欢逞威风的家伙应该会高兴的吧…"
                }
            ]
        },
        {
            "talkId": "7209302",
            "initDialog": "720930201",
            "dialogues": [
                {
                    "id": "720930201",
                    "speaker": "Player",
                    "text": "关于「移霄导天真君」…"
                },
                {
                    "id": "720930202",
                    "speaker": "萍姥姥",
                    "text": "今年海灯节在建造的「明霄灯」，就是「移霄导天真君」的形象。"
                },
                {
                    "id": "720930203",
                    "speaker": "萍姥姥",
                    "text": "希望他们会把鹿角修得大一些，毕竟头上的角可是那位仙人最引以为傲的。"
                },
                {
                    "id": "720930204",
                    "speaker": "萍姥姥",
                    "text": "据说，他的角吸收了岩王帝君岩之力的神髓，曾是整个璃月最坚硬的东西。"
                },
                {
                    "id": "720930205",
                    "speaker": "萍姥姥",
                    "text": "可就在「那场决战」中，劲力迸出，山岳倾倒，他为了不波及到山脚的村庄，主动让朋友将他的鹿角砍下…"
                },
                {
                    "id": "720930206",
                    "speaker": "萍姥姥",
                    "text": "他将那鲜血淋漓的鹿角作为支点，撑起了整个山岳。而他自己也坚持战斗到自己流尽最后一滴血…"
                },
                {
                    "id": "720930207",
                    "speaker": "萍姥姥",
                    "text": "如今，曾被他撑起的「天衡山」依旧巍然屹立，他死战之中流出的鲜血则汇聚而成「碧水河」。"
                },
                {
                    "id": "720930208",
                    "speaker": "萍姥姥",
                    "text": "呵呵…不论你是否相信我讲的，能有人愿意听听这些陈年旧事，就已经是很大的安慰了。"
                },
                {
                    "id": "720930209",
                    "speaker": "萍姥姥",
                    "text": "海灯节之所以存在，也是因为那些「老朋友们」不甘寂寞吧。"
                }
            ]
        },
        {
            "talkId": "7209303",
            "initDialog": "720930301",
            "dialogues": [
                {
                    "id": "720930301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "720930302",
                    "speaker": "萍姥姥",
                    "text": "再见。愿薪火相传，美德不灭。"
                }
            ]
        }
    ]
}