    "talks": [
        {
            "talkId": "6321101",
            "initDialog": "632110101",
            "dialogues": [
                {
                    "id": "632110101",
                    "speaker": "柴葉紫",
                    "text": "怎么跑这里来了，接待处在那边。"
                }
            ]
        },
        {
            "talkId": "6321102",
            "initDialog": "632110201",
            "dialogues": [
                {
                    "id": "632110201",
                    "speaker": "Player",
                    "text": "你是在这里摸鱼吗？"
                },
                {
                    "id": "632110202",
                    "speaker": "柴葉紫",
                    "text": "这算什么话？我只是不喜欢人多的地方…"
                },
                {
                    "id": "632110203",
                    "speaker": "柴葉紫",
                    "text": "白音那边我也盯着呢，万一那个傻瓜遇到闹事的家伙，我得帮她摆平。"
                }
            ]
        },
        {
            "talkId": "6321103",
            "initDialog": "632110301",
            "dialogues": [
                {
                    "id": "632110301",
                    "speaker": "Player",
                    "text": "可以预约你的诊疗服务吗？"
                },
                {
                    "id": "632110302",
                    "speaker": "柴葉紫",
                    "text": "唉…还是躲不过吗？"
                },
                {
                    "id": "632110303",
                    "speaker": "柴葉紫",
                    "text": "首先提醒下，我的顾客评分可是垫底的。"
                },
                {
                    "id": "632110304",
                    "speaker": "柴葉紫",
                    "text": "请好好考虑下再做打算吧。"
                }
            ]
        },
        {
            "talkId": "6321104",
            "initDialog": "632110401",
            "dialogues": [
                {
                    "id": "632110401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "632110402",
                    "speaker": "柴葉紫",
                    "text": "再见，唔，又困了…"
                }
            ]
        }
    ]
}