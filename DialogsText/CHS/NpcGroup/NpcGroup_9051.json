{
    "groupId": "9051",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 19,
        "优菈": 45
    },
    "talks": [
        {
            "talkId": "6905101",
            "initDialog": "690510101",
            "dialogues": [
                {
                    "id": "690510101",
                    "speaker": "优菈",
                    "text": "#{NICKNAME}，是你？怎么了吗。"
                }
            ]
        },
        {
            "talkId": "6905102",
            "initDialog": "690510201",
            "dialogues": [
                {
                    "id": "690510201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690510202",
                    "speaker": "优菈",
                    "text": "哼…这算是什么问题？"
                },
                {
                    "id": "690510203",
                    "speaker": "优菈",
                    "text": "我可不擅长说什么夸奖的话啊。"
                },
                {
                    "id": "690510204",
                    "speaker": "Player",
                    "text": "我只是关心优菈的感受…"
                },
                {
                    "id": "690510205",
                    "speaker": "优菈",
                    "text": "…多此一举。你以为我是很纤细的人吗。"
                },
                {
                    "id": "690510206",
                    "speaker": "优菈",
                    "text": "不好不坏，你要听的话就是这样。",
                    "choices": [
                        {
                            "id": "690510207",
                            "text": "真的是这样吗？",
                            "response": [
                                {
                                    "id": "690510209",
                                    "speaker": "优菈",
                                    "text": "喂，你这家伙还暗中观察我？"
                                },
                                {
                                    "id": "690510210",
                                    "speaker": "优菈",
                                    "text": "（该死…是我没发现吗？）"
                                },
                                {
                                    "id": "690510211",
                                    "speaker": "优菈",
                                    "text": "总之…这仇…我记下了。"
                                }
                            ]
                        },
                        {
                            "id": "690510208",
                            "text": "我之前看你明明露出了很温柔的表情…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905103",
            "initDialog": "690510301",
            "dialogues": [
                {
                    "id": "690510301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690510302",
                    "speaker": "优菈",
                    "text": "没想到你会有无聊的时候…行，你说吧。"
                },
                {
                    "id": "690510303",
                    "speaker": "Player",
                    "text": "最近有什么让你记仇的事情吗？"
                },
                {
                    "id": "690510304",
                    "speaker": "优菈",
                    "text": "嗯…我想想。"
                },
                {
                    "id": "690510305",
                    "speaker": "优菈",
                    "text": "不久前接到了一起整治附近盗宝团的任务。"
                },
                {
                    "id": "690510306",
                    "speaker": "优菈",
                    "text": "回来路上，顺手救了一个被魔物袭击的清泉镇猎人。"
                },
                {
                    "id": "690510307",
                    "speaker": "优菈",
                    "text": "…没想到对方第二天居然送来了肉和酒。"
                },
                {
                    "id": "690510308",
                    "speaker": "优菈",
                    "text": "明知道我是蒙德罪人后裔还敢来送东西…这仇当然得记。",
                    "choices": [
                        {
                            "id": "690510309",
                            "text": "是很值得记的仇。",
                            "response": [
                                {
                                    "id": "690510310",
                                    "speaker": "优菈",
                                    "text": "不仅如此。"
                                },
                                {
                                    "id": "690510311",
                                    "speaker": "优菈",
                                    "text": "因为肉很好吃，吃多了有点胀肚，还影响了喝酒的兴致…"
                                },
                                {
                                    "id": "690510315",
                                    "speaker": "Player",
                                    "text": "这仇得再加一点。"
                                },
                                {
                                    "id": "690510316",
                                    "speaker": "优菈",
                                    "text": "哈哈，我很认同你的看法。"
                                },
                                {
                                    "id": "690510319",
                                    "speaker": "优菈",
                                    "text": "……"
                                },
                                {
                                    "id": "690510320",
                                    "speaker": "优菈",
                                    "text": "只是这样跟你聊聊，心情却好了不少…"
                                },
                                {
                                    "id": "690510321",
                                    "speaker": "优菈",
                                    "text": "咳咳…谢谢你。"
                                }
                            ]
                        },
                        {
                            "id": "690510312",
                            "text": "优菈没有受伤吧？",
                            "response": [
                                {
                                    "id": "690510313",
                                    "speaker": "优菈",
                                    "text": "哈，区区魔物怎么可能伤到我…"
                                },
                                {
                                    "id": "690510314",
                                    "speaker": "优菈",
                                    "text": "倒是因为肉很好吃，吃多了有点胀肚，还影响了喝酒的兴致…"
                                },
                                {
                                    "id": "690510317",
                                    "speaker": "Player",
                                    "text": "那么好吃吗？我也想吃…"
                                },
                                {
                                    "id": "690510318",
                                    "speaker": "优菈",
                                    "text": "哈哈哈，别了吧。你真要想的话…我给你做「骇浪派」吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905104",
            "initDialog": "690510401",
            "dialogues": [
                {
                    "id": "690510401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690510402",
                    "speaker": "优菈",
                    "text": "想做的？为什么会这么问？"
                },
                {
                    "id": "690510403",
                    "speaker": "Player",
                    "text": "因为想要陪优菈。"
                },
                {
                    "id": "690510404",
                    "speaker": "优菈",
                    "text": "……"
                },
                {
                    "id": "690510405",
                    "speaker": "优菈",
                    "text": "奇怪的说法。"
                },
                {
                    "id": "690510406",
                    "speaker": "优菈",
                    "text": "既然如此，我来教你跳舞吧，属于我的「祭礼之舞」。"
                },
                {
                    "id": "690510407",
                    "speaker": "优菈",
                    "text": "我告诉过你，我在自己的剑技中融入了舞蹈。想学习我的剑术，得过舞蹈这关。"
                },
                {
                    "id": "690510408",
                    "speaker": "优菈",
                    "text": "其实，它作为艺术消遣本身，也是我所钟爱的…"
                },
                {
                    "id": "690510409",
                    "speaker": "优菈",
                    "text": "现在是时候教给你了。",
                    "choices": [
                        {
                            "id": "690510410",
                            "text": "有双人舞吗？",
                            "response": [
                                {
                                    "id": "690510411",
                                    "speaker": "优菈",
                                    "text": "先等你把基础舞步都练会再说。"
                                },
                                {
                                    "id": "690510412",
                                    "speaker": "优菈",
                                    "text": "那么贪心，理应给你记上最深最重的仇——"
                                },
                                {
                                    "id": "690510415",
                                    "speaker": "优菈",
                                    "text": "但是，我想过了。都已经到这个份上了，这些仇不计较也罢。"
                                },
                                {
                                    "id": "690510416",
                                    "speaker": "优菈",
                                    "text": "毕竟和你「仇」到深处…早就难解难分了。"
                                }
                            ]
                        },
                        {
                            "id": "690510413",
                            "text": "如果踩到优菈脚的话…",
                            "response": [
                                {
                                    "id": "690510414",
                                    "speaker": "优菈",
                                    "text": "那理应给你记上最深最重的仇——"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905105",
            "initDialog": "690510501",
            "dialogues": [
                {
                    "id": "690510501",
                    "speaker": "Player",
                    "text": "早啊，优菈。"
                },
                {
                    "id": "690510502",
                    "speaker": "优菈",
                    "text": "嗯…早啊。"
                },
                {
                    "id": "690510503",
                    "speaker": "优菈",
                    "text": "#记住了，{NICKNAME}，我们之间的「仇」还没清算…务必完完整整的回来。"
                }
            ]
        },
        {
            "talkId": "6905106",
            "initDialog": "690510601",
            "dialogues": [
                {
                    "id": "690510601",
                    "speaker": "Player",
                    "text": "晚安，优菈。"
                },
                {
                    "id": "690510602",
                    "speaker": "优菈",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690510603",
                    "speaker": "优菈",
                    "text": "像你这样心如明镜的家伙，应该会睡得比谁都香吧…"
                }
            ]
        },
        {
            "talkId": "6905107",
            "initDialog": "690510701",
            "dialogues": [
                {
                    "id": "690510701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6905108",
            "initDialog": "690510801",
            "dialogues": [
                {
                    "id": "690510801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6905109",
            "initDialog": "690510901",
            "dialogues": [
                {
                    "id": "690510901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6905150",
            "initDialog": "690515001",
            "dialogues": [
                {
                    "id": "690515001",
                    "speaker": "优菈",
                    "text": "家具齐全，位置合理，留意了光照方向…嗯，这间卧室还算合格。"
                },
                {
                    "id": "690515002",
                    "speaker": "优菈",
                    "text": "有些贵族只求奢华美观，把房间布置得极其别扭，我讨厌他们的规矩。"
                },
                {
                    "id": "690515003",
                    "speaker": "优菈",
                    "text": "还是这里…能让我放松下来。"
                }
            ]
        },
        {
            "talkId": "6905151",
            "initDialog": "690515101",
            "dialogues": [
                {
                    "id": "690515101",
                    "speaker": "优菈",
                    "text": "这间书房…让我记起了一些事。"
                },
                {
                    "id": "690515102",
                    "speaker": "优菈",
                    "text": "小时候，我想过各种方法，逃避教授贵族礼仪的书籍，但都失败了，只能学着强记硬背。"
                },
                {
                    "id": "690515103",
                    "speaker": "优菈",
                    "text": "罢了，都过去了。我也得换换心情，面对新的生活了。"
                }
            ]
        }
    ]
}