{
    "groupId": "7048",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "茜涅特": 8
    },
    "talks": [
        {
            "talkId": "6704801",
            "initDialog": "670480101",
            "dialogues": [
                {
                    "id": "670480101",
                    "speaker": "茜涅特",
                    "text": "这里的稀奇玩意儿真不少，不虚此行啊。"
                }
            ]
        },
        {
            "talkId": "6704802",
            "initDialog": "670480201",
            "dialogues": [
                {
                    "id": "670480201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "670480202",
                    "speaker": "茜涅特",
                    "text": "你好，我是枫丹科学院的工程师茜涅特。"
                },
                {
                    "id": "670480203",
                    "speaker": "茜涅特",
                    "text": "听说这里正在大规模开发一种被称作「月矩力」的新型机械能源，因此我才特意从枫丹过来考察。"
                }
            ]
        },
        {
            "talkId": "6704803",
            "initDialog": "670480301",
            "dialogues": [
                {
                    "id": "670480301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670480302",
                    "speaker": "茜涅特",
                    "text": "好的，我还要再逛一会。"
                }
            ]
        },
        {
            "talkId": "6704804",
            "initDialog": "670480401",
            "dialogues": [
                {
                    "id": "670480401",
                    "speaker": "Player",
                    "text": "枫丹人也想用「月矩力」吗？"
                },
                {
                    "id": "670480402",
                    "speaker": "茜涅特",
                    "text": "正好，让我考考你，你知道「月矩力」和「始基力」在应用上最大的区别是什么吗？"
                }
            ]
        },
        {
            "talkId": "6704805",
            "initDialog": "670480501",
            "dialogues": [
                {
                    "id": "670480501",
                    "speaker": "Player",
                    "text": "你是一个人来的吗？"
                },
                {
                    "id": "670480502",
                    "speaker": "茜涅特",
                    "text": "哦，还有个叫弗尔杰的研究员，我们是一起来的。不过那家伙的脑筋太死板，一下船就抱着研究设备不知道跑去哪了。"
                },
                {
                    "id": "670480503",
                    "speaker": "茜涅特",
                    "text": "他不明白就算我们把考察报告带回去，也不会有人给我们多批一摩拉的研究经费的。"
                }
            ]
        },
        {
            "talkId": "6704806",
            "initDialog": "670480601",
            "dialogues": [
                {
                    "id": "670480601",
                    "speaker": "Player",
                    "text": "不知道。"
                },
                {
                    "id": "670480602",
                    "speaker": "茜涅特",
                    "text": "当然是「月矩力」的开发不会有名字一长串的什么高阶技官躲在后面高高在上地指手画脚啦，哈哈！"
                }
            ]
        }
    ]
}