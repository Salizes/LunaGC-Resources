{
    "groupId": "5316",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "希露艾": 20
    },
    "talks": [
        {
            "talkId": "6531601",
            "initDialog": "653160101",
            "dialogues": [
                {
                    "id": "653160101",
                    "speaker": "希露艾",
                    "text": "之前订购的材料，为什么还没送到呢…"
                },
                {
                    "id": "653160102",
                    "speaker": "希露艾",
                    "text": "嗯？你身上的饰品，造型看上去有些奇特啊…"
                }
            ]
        },
        {
            "talkId": "6531602",
            "initDialog": "653160201",
            "dialogues": [
                {
                    "id": "653160201",
                    "speaker": "Player",
                    "text": "饰品？"
                },
                {
                    "id": "653160202",
                    "speaker": "希露艾",
                    "text": "啊，抱歉，毕竟我也是一名工匠，看到从前没见过的饰品，就会忍不住在心里揣摩打造的方法。"
                },
                {
                    "id": "653160203",
                    "speaker": "希露艾",
                    "text": "啊，这样美丽的装饰，造型简洁却富有韵味，真不错啊。"
                }
            ]
        },
        {
            "talkId": "6531603",
            "initDialog": "653160301",
            "dialogues": [
                {
                    "id": "653160301",
                    "speaker": "Player",
                    "text": "订购的材料？"
                },
                {
                    "id": "653160302",
                    "speaker": "希露艾",
                    "text": "嗯，是从枫丹的商人那里订购的宝石。"
                },
                {
                    "id": "653160303",
                    "speaker": "希露艾",
                    "text": "我会将宝石制作成各种各样的饰品。显而易见，没有材料的话，也就没有办法开工了。"
                },
                {
                    "id": "653160304",
                    "speaker": "希露艾",
                    "text": "唉，那些货要是能早点送到就好了…"
                }
            ]
        },
        {
            "talkId": "6531604",
            "initDialog": "653160401",
            "dialogues": [
                {
                    "id": "653160401",
                    "speaker": "Player",
                    "text": "我还有别的事…"
                },
                {
                    "id": "653160402",
                    "speaker": "希露艾",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6531605",
            "initDialog": "653160501",
            "dialogues": [
                {
                    "id": "653160501",
                    "speaker": "希露艾",
                    "text": "之前订购的材料，为什么还没送到呢…"
                },
                {
                    "id": "653160502",
                    "speaker": "希露艾",
                    "text": "啊，又见面了，怎么样，有什么想要的饰品吗？"
                }
            ]
        },
        {
            "talkId": "6531606",
            "initDialog": "653160601",
            "dialogues": [
                {
                    "id": "653160601",
                    "speaker": "Player",
                    "text": "颜料制作顺利吗？"
                },
                {
                    "id": "653160602",
                    "speaker": "希露艾",
                    "text": "嗯，颜料现在还处于最后的调整阶段，应该很快就能够完成！"
                },
                {
                    "id": "653160603",
                    "speaker": "希露艾",
                    "text": "不过，花的时间比想象中要长…嗯，但就像是加工宝石那样，必须拿出最完美的颜料来才行。"
                },
                {
                    "id": "653160604",
                    "speaker": "希露艾",
                    "text": "不是完美之物，也就没有意义了。唉，要是芙佳也能早点明白这个道理…"
                }
            ]
        },
        {
            "talkId": "6531607",
            "initDialog": "653160701",
            "dialogues": [
                {
                    "id": "653160701",
                    "speaker": "Player",
                    "text": "订购的材料？"
                },
                {
                    "id": "653160702",
                    "speaker": "希露艾",
                    "text": "嗯，是从枫丹的商人那里订购的宝石…"
                },
                {
                    "id": "653160703",
                    "speaker": "希露艾",
                    "text": "就像之前您向我展示过的用来制作颜料的素材那样…"
                },
                {
                    "id": "653160704",
                    "speaker": "希露艾",
                    "text": "毕竟我是宝石工匠，有很多工作得有了素材和原料才能开始。"
                },
                {
                    "id": "653160705",
                    "speaker": "希露艾",
                    "text": "呜，那些货要是能早点送到就好了…"
                }
            ]
        },
        {
            "talkId": "6531608",
            "initDialog": "653160801",
            "dialogues": [
                {
                    "id": "653160801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653160802",
                    "speaker": "希露艾",
                    "text": "嗯嗯，再见！"
                }
            ]
        },
        {
            "talkId": "6531609",
            "initDialog": "653160901",
            "dialogues": [
                {
                    "id": "653160901",
                    "speaker": "Player",
                    "text": "关于刚才的地震…"
                },
                {
                    "id": "653160902",
                    "speaker": "希露艾",
                    "text": "真是的，这种时候，芙佳跑到哪里去了…"
                },
                {
                    "id": "653160903",
                    "speaker": "希露艾",
                    "text": "算了…既然有朋友跟着，应该也不会出太大的问题吧？"
                }
            ]
        }
    ]
}