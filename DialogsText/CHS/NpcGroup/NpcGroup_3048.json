{
    "groupId": "3048",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 8,
        "黑泽京之介": 21
    },
    "talks": [
        {
            "talkId": "6304801",
            "initDialog": "630480101",
            "dialogues": [
                {
                    "id": "630480101",
                    "speaker": "黑泽京之介",
                    "text": "……"
                },
                {
                    "id": "630480102",
                    "speaker": "黑泽京之介",
                    "text": "……"
                },
                {
                    "id": "630480103",
                    "speaker": "黑泽京之介",
                    "text": "什么，原来是找我的吗。"
                }
            ]
        },
        {
            "talkId": "6304802",
            "initDialog": "630480201",
            "dialogues": [
                {
                    "id": "630480201",
                    "speaker": "Player",
                    "text": "你好…？"
                },
                {
                    "id": "630480202",
                    "speaker": "黑泽京之介",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6304803",
            "initDialog": "630480301",
            "dialogues": [
                {
                    "id": "630480301",
                    "speaker": "Player",
                    "text": "你看起来…"
                },
                {
                    "id": "630480302",
                    "speaker": "黑泽京之介",
                    "text": "看起来…如何？"
                },
                {
                    "id": "630480303",
                    "speaker": "黑泽京之介",
                    "text": "消极吗…嗯，那你应该没看错吧。"
                },
                {
                    "id": "630480304",
                    "speaker": "黑泽京之介",
                    "text": "自从没有了神之眼，这世上大部分事情都和我关系不大了…"
                }
            ]
        },
        {
            "talkId": "6304804",
            "initDialog": "630480401",
            "dialogues": [
                {
                    "id": "630480401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630480402",
                    "speaker": "黑泽京之介",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6304805",
            "initDialog": "630480501",
            "dialogues": [
                {
                    "id": "630480501",
                    "speaker": "黑泽京之介",
                    "text": "是你们啊，好久不见。"
                }
            ]
        },
        {
            "talkId": "6304806",
            "initDialog": "630480601",
            "dialogues": [
                {
                    "id": "630480601",
                    "speaker": "Player",
                    "text": "好久不见，你还好吗？"
                },
                {
                    "id": "630480602",
                    "speaker": "黑泽京之介",
                    "text": "我…唉，说不清。"
                },
                {
                    "id": "630480603",
                    "speaker": "黑泽京之介",
                    "text": "失去的记忆大概永远回不来了。但我每每握住老爹留给我的刀，都能隐约感觉到过去的愿望曾经存在过的痕迹…"
                },
                {
                    "id": "630480604",
                    "speaker": "黑泽京之介",
                    "text": "「仁义」之路，我还能重新走下去吗…"
                }
            ]
        },
        {
            "talkId": "6304807",
            "initDialog": "630480701",
            "dialogues": [
                {
                    "id": "630480701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630480702",
                    "speaker": "黑泽京之介",
                    "text": "再见，一路顺风。"
                }
            ]
        },
        {
            "talkId": "6304808",
            "initDialog": "630480801",
            "dialogues": [
                {
                    "id": "630480801",
                    "speaker": "Player",
                    "text": "你的神之眼…"
                },
                {
                    "id": "630480802",
                    "speaker": "黑泽京之介",
                    "text": "因为「眼狩令」而被收缴了，没什么特别的，就和其他的人一样。"
                },
                {
                    "id": "630480803",
                    "speaker": "黑泽京之介",
                    "text": "对「眼狩令」的看法…现在么，没什么看法了。"
                },
                {
                    "id": "630480804",
                    "speaker": "黑泽京之介",
                    "text": "当初有人上报我对「眼狩令」心存不满，执行公务的时候消极怠工…结果你也看到了。"
                },
                {
                    "id": "630480805",
                    "speaker": "黑泽京之介",
                    "text": "以前的看法，我记不清了…而现在的我，也已经不再关心这件事了。"
                }
            ]
        },
        {
            "talkId": "6304809",
            "initDialog": "630480901",
            "dialogues": [
                {
                    "id": "630480901",
                    "speaker": "Player",
                    "text": "好久不见，你还好吗？"
                },
                {
                    "id": "630480902",
                    "speaker": "黑泽京之介",
                    "text": "眼狩令废除后，神之眼也回来了。我每每握住老爹留给我的刀，都能隐约感觉到过去的愿望在逐渐重燃…"
                },
                {
                    "id": "630480903",
                    "speaker": "黑泽京之介",
                    "text": "「仁义」之路，果然还是要继续走下去…"
                }
            ]
        },
        {
            "talkId": "7292101",
            "initDialog": "729210101",
            "dialogues": [
                {
                    "id": "729210101",
                    "speaker": "Player",
                    "text": "一定可以的。"
                },
                {
                    "id": "729210102",
                    "speaker": "黑泽京之介",
                    "text": "既然你这么说，那…我会尽力。"
                },
                {
                    "id": "729210103",
                    "speaker": "黑泽京之介",
                    "text": "老爹交给我的东西，我并没有全然忘记。这些为人之道，你我共勉。"
                }
            ]
        }
    ]
}