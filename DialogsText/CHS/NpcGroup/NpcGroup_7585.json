{
    "groupId": "7585",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "别尔斯基": 7
    },
    "talks": [
        {
            "talkId": "6758501",
            "initDialog": "675850101",
            "dialogues": [
                {
                    "id": "675850101",
                    "speaker": "别尔斯基",
                    "text": "要让雪橇追上火车，最少需要几条猎犬呢？"
                }
            ]
        },
        {
            "talkId": "6758502",
            "initDialog": "675850201",
            "dialogues": [
                {
                    "id": "675850201",
                    "speaker": "Player",
                    "text": "你想玩雪橇吗？"
                },
                {
                    "id": "675850202",
                    "speaker": "别尔斯基",
                    "text": "当然了！不过，最好不要告诉我爸，他总说这东西非常非常危险。"
                }
            ]
        },
        {
            "talkId": "6758503",
            "initDialog": "675850301",
            "dialogues": [
                {
                    "id": "675850301",
                    "speaker": "Player",
                    "text": "你家长呢？"
                },
                {
                    "id": "675850302",
                    "speaker": "别尔斯基",
                    "text": "就在那边咯，他平时会帮阿罗夏哥哥维护工作台。"
                },
                {
                    "id": "675850303",
                    "speaker": "别尔斯基",
                    "text": "话说回来，我之前就想用阿罗夏哥哥的工作台制作一把猎枪，但老爸他立刻拒绝了，明明阿罗夏哥哥已经答应了…"
                },
                {
                    "id": "675850304",
                    "speaker": "别尔斯基",
                    "text": "有机会的话，还是借阿罗夏哥哥的猎枪玩吧…"
                }
            ]
        },
        {
            "talkId": "6758504",
            "initDialog": "675850401",
            "dialogues": [
                {
                    "id": "675850401",
                    "speaker": "Player",
                    "text": "雪橇也没那么危险吧？"
                },
                {
                    "id": "675850402",
                    "speaker": "别尔斯基",
                    "text": "对啊，我一直想做一件事，就是改造出一架能追上火车的雪橇！"
                },
                {
                    "id": "675850403",
                    "speaker": "别尔斯基",
                    "text": "但老爸听说之后就再也不让我碰雪橇了，然后一直跟我说这东西非常非常危险…"
                }
            ]
        }
    ]
}