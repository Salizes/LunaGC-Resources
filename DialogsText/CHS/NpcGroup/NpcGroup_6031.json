{
    "groupId": "6031",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "因娜": 11
    },
    "talks": [
        {
            "talkId": "6603101",
            "initDialog": "660310101",
            "dialogues": [
                {
                    "id": "660310101",
                    "speaker": "因娜",
                    "text": "嘿嘿，真开心，莫乌交上新朋友了呢。"
                }
            ]
        },
        {
            "talkId": "6603102",
            "initDialog": "660310201",
            "dialogues": [
                {
                    "id": "660310201",
                    "speaker": "Player",
                    "text": "莫乌是谁？"
                },
                {
                    "id": "660310202",
                    "speaker": "因娜",
                    "text": "是我们部族里的小龙哦。"
                },
                {
                    "id": "660310203",
                    "speaker": "因娜",
                    "text": "哎呀，它不在这附近，应该正在家里和新朋友玩吧。"
                },
                {
                    "id": "660310204",
                    "speaker": "因娜",
                    "text": "好像是从枫丹来的小朋友呢，个子小小的，鼻子也长得很可爱…"
                },
                {
                    "id": "660310205",
                    "speaker": "因娜",
                    "text": "嘿嘿，虽然她不是人类、也听不懂莫乌的语言，但好像和莫乌相处得还不错呢。"
                },
                {
                    "id": "660310206",
                    "speaker": "因娜",
                    "text": "希望她能待久一点，让莫乌变得开朗一些…"
                }
            ]
        },
        {
            "talkId": "6603103",
            "initDialog": "660310301",
            "dialogues": [
                {
                    "id": "660310301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660310302",
                    "speaker": "因娜",
                    "text": "嘿嘿…祝你也能和龙交上朋友哦。"
                }
            ]
        },
        {
            "talkId": "6603104",
            "initDialog": "660310401",
            "dialogues": [
                {
                    "id": "660310401",
                    "speaker": "Player",
                    "text": "你很关心它。"
                },
                {
                    "id": "660310402",
                    "speaker": "因娜",
                    "text": "是啊，毕竟是和我们一起生活、战斗的伙伴，我们也不能只关心人的健康，对吧？"
                },
                {
                    "id": "660310403",
                    "speaker": "因娜",
                    "text": "啊，忘了自我介绍，我算是比较熟悉龙类行为的研究员吧。"
                },
                {
                    "id": "660310404",
                    "speaker": "因娜",
                    "text": "有人会叫我「龙语者」，但我其实并不会龙的语言，只是能通过观察龙的动作细节来判断它们是不是身体不适或者心情不好。"
                },
                {
                    "id": "660310405",
                    "speaker": "因娜",
                    "text": "如果你遇见行为不太平常的龙，可以来找我哦，我会尽力帮你们发现问题、解决问题的。"
                }
            ]
        }
    ]
}