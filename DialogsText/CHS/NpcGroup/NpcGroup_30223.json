{
    "groupId": "30223",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 2,
        "残存的记录·二": 6,
        "派蒙": 6
    },
    "talks": [
        {
            "talkId": "7051703",
            "initDialog": "705170301",
            "dialogues": [
                {
                    "id": "705170301",
                    "speaker": "残存的记录·二",
                    "text": "上头的警告真是在理。"
                },
                {
                    "id": "705170302",
                    "speaker": "残存的记录·二",
                    "text": "那台设备还能从我的记忆里提取信息，生成糅杂的片段。"
                },
                {
                    "id": "705170303",
                    "speaker": "残存的记录·二",
                    "text": "单看现象的确有趣，可我不想再受一遍训练的苦了。"
                },
                {
                    "id": "705170304",
                    "speaker": "残存的记录·二",
                    "text": "再观察三天吧，状况不妙就先撤走。"
                },
                {
                    "id": "705170305",
                    "speaker": "残存的记录·二",
                    "text": "不知道其他人来到这里后，会看见什么东西…"
                },
                {
                    "id": "705170306",
                    "speaker": "残存的记录·二",
                    "text": "……"
                },
                {
                    "id": "705170307",
                    "speaker": "派蒙",
                    "text": "原来是这样吗？"
                },
                {
                    "id": "705170308",
                    "speaker": "派蒙",
                    "text": "我们看到的机关，还有触发机关后的挑战，都是那台设备根据我们的记忆生成的？"
                },
                {
                    "id": "705170309",
                    "speaker": "派蒙",
                    "text": "说起来，我们确实面对过各种挑战和谜题。那台设备好像还挺了解我们的嘛。",
                    "choices": [
                        {
                            "id": "705170310",
                            "text": "毕竟完成挑战可以让自己变强。",
                            "response": [
                                {
                                    "id": "705170312",
                                    "speaker": "派蒙",
                                    "text": "对哦对哦！"
                                },
                                {
                                    "id": "705170313",
                                    "speaker": "派蒙",
                                    "text": "这次的挑战比较新奇，我也有点兴趣了！"
                                },
                                {
                                    "id": "705170314",
                                    "speaker": "派蒙",
                                    "text": "倒是这个愚人众士兵，最后去哪了呢？"
                                }
                            ]
                        },
                        {
                            "id": "705170311",
                            "text": "毕竟解开谜题有可能获得宝箱。"
                        }
                    ]
                }
            ]
        }
    ]
}