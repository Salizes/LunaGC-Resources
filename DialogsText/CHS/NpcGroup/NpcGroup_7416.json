{
    "groupId": "7416",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "布柳什科": 7
    },
    "talks": [
        {
            "talkId": "6741601",
            "initDialog": "674160101",
            "dialogues": [
                {
                    "id": "674160101",
                    "speaker": "布柳什科",
                    "text": "如果有什么需要的，还请进店详谈…不过恕我提前警告，要是碰坏了东西可得照价赔偿。"
                }
            ]
        },
        {
            "talkId": "6741602",
            "initDialog": "674160201",
            "dialogues": [
                {
                    "id": "674160201",
                    "speaker": "Player",
                    "text": "让我看看你这里有什么…"
                },
                {
                    "id": "674160202",
                    "speaker": "布柳什科",
                    "text": "抱歉，我们还在清点刚到的货物，还需要重新整理一下货架上的物品，还请您过段时间再来。"
                }
            ]
        },
        {
            "talkId": "6741603",
            "initDialog": "674160301",
            "dialogues": [
                {
                    "id": "674160301",
                    "speaker": "Player",
                    "text": "这些东西很贵吗？"
                },
                {
                    "id": "674160302",
                    "speaker": "布柳什科",
                    "text": "大多数都不是很贵…不过就像沙子逐渐堆积也可成就高塔，这些小的损失累叠起来也会成为破产的先兆。"
                },
                {
                    "id": "674160303",
                    "speaker": "布柳什科",
                    "text": "而且工艺品大多比较脆弱，美好，但是脆弱。如果对这份美好有敬畏心的话，就请小心一些吧。"
                }
            ]
        },
        {
            "talkId": "6741604",
            "initDialog": "674160401",
            "dialogues": [
                {
                    "id": "674160401",
                    "speaker": "Player",
                    "text": "没有故意做得脆弱的商品吧…"
                },
                {
                    "id": "674160402",
                    "speaker": "布柳什科",
                    "text": "这里可是正经的老店，「萨多夫·阿尔巴特」在整个至冬也算是赫赫有名，就连宫中也会有专人来此订购商品。"
                },
                {
                    "id": "674160403",
                    "speaker": "布柳什科",
                    "text": "我可不像那些帮派的喽啰，会做这种跟诈骗一样的事！"
                }
            ]
        },
        {
            "talkId": "6741605",
            "initDialog": "674160501",
            "dialogues": [
                {
                    "id": "674160501",
                    "speaker": "Player",
                    "text": "那就不打扰了…"
                },
                {
                    "id": "674160502",
                    "speaker": "布柳什科",
                    "text": "期待你的下次光临…如果还有下次的话。"
                }
            ]
        }
    ]
}