{
    "groupId": "6218",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "拉斯塔恩": 9
    },
    "talks": [
        {
            "talkId": "6621801",
            "initDialog": "662180101",
            "dialogues": [
                {
                    "id": "662180101",
                    "speaker": "拉斯塔恩",
                    "text": "早知道就拜托有经验的前辈来这边了…"
                }
            ]
        },
        {
            "talkId": "6621802",
            "initDialog": "662180201",
            "dialogues": [
                {
                    "id": "662180201",
                    "speaker": "Player",
                    "text": "遇到麻烦了？"
                },
                {
                    "id": "662180202",
                    "speaker": "拉斯塔恩",
                    "text": "嗯，算是吧…"
                },
                {
                    "id": "662180203",
                    "speaker": "拉斯塔恩",
                    "text": "有封很难送的信，收件人是行医，得抓准他在部族里的时候送到。"
                },
                {
                    "id": "662180204",
                    "speaker": "拉斯塔恩",
                    "text": "不知怎么的，这封信就像受了诅咒一样，总是阴差阳错地送不到他手上…"
                },
                {
                    "id": "662180205",
                    "speaker": "拉斯塔恩",
                    "text": "我是刚上任的讯使，前辈们都说新手往往更幸运，就怂恿我试一试，还下了赌注…"
                },
                {
                    "id": "662180206",
                    "speaker": "拉斯塔恩",
                    "text": "…哎，你说他们，是不是在拿我开玩笑呀？"
                }
            ]
        },
        {
            "talkId": "6621803",
            "initDialog": "662180301",
            "dialogues": [
                {
                    "id": "662180301",
                    "speaker": "Player",
                    "text": "保重。"
                },
                {
                    "id": "662180302",
                    "speaker": "拉斯塔恩",
                    "text": "我自己无所谓啦，希望信能顺利送到吧！"
                }
            ]
        },
        {
            "talkId": "7594401",
            "initDialog": "759440101",
            "dialogues": [
                {
                    "id": "759440101",
                    "speaker": "Player",
                    "text": "也可能是真的没别的办法。"
                },
                {
                    "id": "759440102",
                    "speaker": "拉斯塔恩",
                    "text": "你说的也是，他们也都自己来送过的，结果你也看到了。"
                },
                {
                    "id": "759440103",
                    "speaker": "拉斯塔恩",
                    "text": "真要命，我才刚入职啊，靠我的这点本事，真的能送到吗？"
                }
            ]
        }
    ]
}