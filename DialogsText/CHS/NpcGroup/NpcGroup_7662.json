{
    "groupId": "7662",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "瓦蒂什": 7
    },
    "talks": [
        {
            "talkId": "6766201",
            "initDialog": "676620101",
            "dialogues": [
                {
                    "id": "676620101",
                    "speaker": "瓦蒂什",
                    "text": "要对付狂猎，准备工作可得先做足！"
                }
            ]
        },
        {
            "talkId": "6766202",
            "initDialog": "676620201",
            "dialogues": [
                {
                    "id": "676620201",
                    "speaker": "Player",
                    "text": "都准备了些什么？"
                },
                {
                    "id": "676620202",
                    "speaker": "瓦蒂什",
                    "text": "这个嘛，让我看看…用来吸引曼陀草的特制香氛，可以引导獭懒羊行动的钩钩果…"
                },
                {
                    "id": "676620203",
                    "speaker": "瓦蒂什",
                    "text": "哎呀，怎么忘记带上我精心处理过的锋萼花标本了，幸好你提醒了我。"
                }
            ]
        },
        {
            "talkId": "6766203",
            "initDialog": "676620301",
            "dialogues": [
                {
                    "id": "676620301",
                    "speaker": "Player",
                    "text": "你准备着，我先走了…"
                },
                {
                    "id": "676620302",
                    "speaker": "瓦蒂什",
                    "text": "嗯…总感觉忘带了什么，到底是什么呢…"
                }
            ]
        },
        {
            "talkId": "6766204",
            "initDialog": "676620401",
            "dialogues": [
                {
                    "id": "676620401",
                    "speaker": "Player",
                    "text": "呃，这些跟对付狂猎有什么关系？"
                },
                {
                    "id": "676620402",
                    "speaker": "瓦蒂什",
                    "text": "这你就不懂了吧！这些都是我准备的小妙招。对付狂猎嘛，可不能硬来。"
                },
                {
                    "id": "676620403",
                    "speaker": "瓦蒂什",
                    "text": "要是你仔细观察过本地的动植物生态，就会发现它们因为受到月矩力的影响，都有各自对付深渊污染的绝技。"
                },
                {
                    "id": "676620404",
                    "speaker": "瓦蒂什",
                    "text": "只要善加利用，在营地周围设置一圈陷阱。就算起不到什么大作用，至少也能让企图偷袭的魔物吃点苦头。"
                }
            ]
        }
    ]
}