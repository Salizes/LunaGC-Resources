{
    "groupId": "5024",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "卡隆": 10
    },
    "talks": [
        {
            "talkId": "6502401",
            "initDialog": "650240101",
            "dialogues": [
                {
                    "id": "650240101",
                    "speaker": "卡隆",
                    "text": "钟表是时光这首歌谣的乐谱，而我又能为它做些什么呢…"
                }
            ]
        },
        {
            "talkId": "6502402",
            "initDialog": "650240201",
            "dialogues": [
                {
                    "id": "650240201",
                    "speaker": "Player",
                    "text": "想要借用合成台…"
                },
                {
                    "id": "650240202",
                    "speaker": "卡隆",
                    "text": "请随意使用。"
                }
            ]
        },
        {
            "talkId": "6502403",
            "initDialog": "650240301",
            "dialogues": [
                {
                    "id": "650240301",
                    "speaker": "Player",
                    "text": "关于钟表…"
                },
                {
                    "id": "650240302",
                    "speaker": "卡隆",
                    "text": "钟表——确切地说，以发条驱动的精密钟表——是我们家族的传家手艺，闻名枫丹。"
                },
                {
                    "id": "650240303",
                    "speaker": "卡隆",
                    "text": "你是否听说过「湖女之泪」？"
                },
                {
                    "id": "650240304",
                    "speaker": "卡隆",
                    "text": "「湖女之泪」，正是芙宁娜大人为我的作品赐予的名字。"
                },
                {
                    "id": "650240305",
                    "speaker": "卡隆",
                    "text": "真美啊…这个名字…就像凝结了悲伤的歌谣。"
                }
            ]
        },
        {
            "talkId": "6502404",
            "initDialog": "650240401",
            "dialogues": [
                {
                    "id": "650240401",
                    "speaker": "Player",
                    "text": "关于诗歌…"
                },
                {
                    "id": "650240402",
                    "speaker": "卡隆",
                    "text": "啊，让你见笑了。我不讨厌钟表这门手艺，但我也向往音乐与诗歌。"
                },
                {
                    "id": "650240403",
                    "speaker": "卡隆",
                    "text": "家里的大哥已经自己讨生活去了，于是我继承了家业。"
                },
                {
                    "id": "650240404",
                    "speaker": "卡隆",
                    "text": "虽然很没有冒险精神，也没有什么浪漫情怀，但不能让这门手艺就此失传。"
                }
            ]
        },
        {
            "talkId": "6502405",
            "initDialog": "650240501",
            "dialogues": [
                {
                    "id": "650240501",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "650240502",
                    "speaker": "卡隆",
                    "text": "没事，愿时光的歌谣记住你。"
                }
            ]
        }
    ]
}