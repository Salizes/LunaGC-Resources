    "talks": [
        {
            "talkId": "6960901",
            "initDialog": "696090101",
            "dialogues": [
                {
                    "id": "696090101",
                    "speaker": "雅珂达",
                    "text": "哟，要一起玩吗？嘿嘿，我现在可是「七圣召唤」高手，怎么样，要不要我教你两招？没事啦没事，谁让我们是朋友呢。"
                }
            ]
        },
        {
            "talkId": "6960902",
            "initDialog": "696090201",
            "dialogues": [
                {
                    "id": "696090201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960903",
            "initDialog": "696090301",
            "dialogues": [
                {
                    "id": "696090301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696090302",
                    "speaker": "雅珂达",
                    "text": "要走了？那我再…等一下，怎么都这么晚了！糟糕，委托还没…完了完了，这下又要被奈姐训了…"
                }
            ]
        },
        {
            "talkId": "6960904",
            "initDialog": "696090401",
            "dialogues": [
                {
                    "id": "696090401",
                    "speaker": "雅珂达",
                    "text": "哎呀，别灰心，输给我这样的「七圣召唤」高手也是很正常的啦。"
                }
            ]
        },
        {
            "talkId": "6960905",
            "initDialog": "696090501",
            "dialogues": [
                {
                    "id": "696090501",
                    "speaker": "雅珂达",
                    "text": "…输了？你这么厉害的吗…呃，挺好的！现在你和我一样，也是「七圣召唤」高手啦！"
                }
            ]
        },
        {
            "talkId": "6960906",
            "initDialog": "696090601",
            "dialogues": [
                {
                    "id": "696090601",
                    "speaker": "雅珂达",
                    "text": "想玩牌？没问题，不过事先告诉你，我可是很强的哦。"
                }
            ]
        },
        {
            "talkId": "6960908",
            "initDialog": "696090801",
            "dialogues": [
                {
                    "id": "696090801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960909",
            "initDialog": "696090901",
            "dialogues": [
                {
                    "id": "696090901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960910",
            "initDialog": "696091001",
            "dialogues": [
                {
                    "id": "696091001",
                    "speaker": "雅珂达",
                    "text": "怎么样，我厉害吧？等下我教你两招，保证让你大杀四方，嘿嘿嘿——"
                }
            ]
        },
        {
            "talkId": "6960911",
            "initDialog": "696091101",
            "dialogues": [
                {
                    "id": "696091101",
                    "speaker": "雅珂达",
                    "text": "这么厉害？看来我下次要更认真一点了。"
                }
            ]
        },
        {
            "talkId": "6960912",
            "initDialog": "696091201",
            "dialogues": [
                {
                    "id": "696091201",
                    "speaker": "雅珂达",
                    "text": "想见识我的全力？好啊，那你输了可不许耍赖哦。"
                }
            ]
        },
        {
            "talkId": "6960914",
            "initDialog": "696091401",
            "dialogues": [
                {
                    "id": "696091401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960915",
            "initDialog": "696091501",
            "dialogues": [
                {
                    "id": "696091501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960916",
            "initDialog": "696091601",
            "dialogues": [
                {
                    "id": "696091601",
                    "speaker": "雅珂达",
                    "text": "哈哈哈！赢了赢了，果然这么打没错——"
                }
            ]
        },
        {
            "talkId": "6960917",
            "initDialog": "696091701",
            "dialogues": [
                {
                    "id": "696091701",
                    "speaker": "雅珂达",
                    "text": "输了？可恶，这把不算，再来再来！"
                }
            ]
        },
        {
            "talkId": "6960918",
