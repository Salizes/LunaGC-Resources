{
    "groupId": "20620",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 6,
        "藏镜仕女": 1,
        "阿加菲娅": 5
    },
    "talks": [
        {
            "talkId": "7902224",
            "initDialog": "790222401",
            "dialogues": [
                {
                    "id": "790222401",
                    "speaker": "阿加菲娅",
                    "text": "怎么了，还有什么事吗，我可已经把我知道的告诉你了…",
                    "choices": [
                        {
                            "id": "790222402",
                            "text": "关于信号测试…",
                            "response": [
                                {
                                    "id": "790222403",
                                    "speaker": "阿加菲娅",
                                    "text": "不是都说了，我也不是很清楚嘛…可能只是一些简单的测试工作吧，只不过需要跑到各个岛上去，还挺累人的。"
                                }
                            ]
                        },
                        {
                            "id": "790222404",
                            "text": "关于扎哈尔…",
                            "response": [
                                {
                                    "id": "790222405",
                                    "speaker": "阿加菲娅",
                                    "text": "扎哈尔是孤儿，很久以前父母就生病去世啦，据说过了很长一段苦日子，听说愚人众管伙食就加入愚人众了…"
                                }
                            ]
                        },
                        {
                            "id": "790222406",
                            "text": "关于合照…",
                            "response": [
                                {
                                    "id": "790222407",
                                    "speaker": "阿加菲娅",
                                    "text": "好吧，合照里的是我的两个哥哥，他们都曾经为至冬国做出过贡献…我一直，以他们为荣。"
                                }
                            ]
                        },
                        {
                            "id": "790222408",
                            "text": "再见…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902230",
            "initDialog": "790223001",
            "dialogues": [
                {
                    "id": "790223001",
                    "speaker": "藏镜仕女",
                    "text": "…要赶快回去…要赶快回去，他还在…可是，哥哥们不见了，哥哥们的照片…",
                    "choices": [
                        {
                            "id": "790223002",
                            "text": "（没法沟通…）"
                        },
                        {
                            "id": "790223003",
                            "text": "（还是先别管她了…）"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902427",
            "initDialog": "790242701",
            "dialogues": [
                {
                    "id": "790242701",
                    "speaker": "阿加菲娅",
                    "text": "大部队已经撤离了，我们稍作准备也要离开了…"
                }
            ]
        }
    ]
}