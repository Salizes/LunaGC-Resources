    "talks": [
        {
            "talkId": "6758401",
            "initDialog": "675840101",
            "dialogues": [
                {
                    "id": "675840101",
                    "speaker": "捷丘娜",
                    "text": "狗狗们在聊什么呢？"
                }
            ]
        },
        {
            "talkId": "6758402",
            "initDialog": "675840201",
            "dialogues": [
                {
                    "id": "675840201",
                    "speaker": "Player",
                    "text": "在观察什么？"
                },
                {
                    "id": "675840202",
                    "speaker": "捷丘娜",
                    "text": "嘘…我在看狗狗们聊天呢。"
                },
                {
                    "id": "675840203",
                    "speaker": "捷丘娜",
                    "text": "我听阿罗夏哥哥说，狗狗其实特别聪明，我觉得它们会有自己的语言。"
                },
                {
                    "id": "675840204",
                    "speaker": "捷丘娜",
                    "text": "我也想学会它们的语言，这样就能和狗狗们聊天了。"
                }
            ]
        },
        {
            "talkId": "6758403",
            "initDialog": "675840301",
            "dialogues": [
                {
                    "id": "675840301",
                    "speaker": "Player",
                    "text": "你家长呢？"
                },
                {
                    "id": "675840302",
                    "speaker": "捷丘娜",
                    "text": "我爸爸就在那边…估计又喝多了吧。要是他能少喝一点，妈妈或许就不会走了。"
                },
                {
                    "id": "675840303",
                    "speaker": "捷丘娜",
                    "text": "所以我很想拥有自己的猎犬，这样就能像阿罗夏哥哥那样打猎养家了，爸爸他是指望不上的。"
                },
                {
                    "id": "675840304",
                    "speaker": "捷丘娜",
                    "text": "等我攒的摩拉足够多了，就请医生帮他戒酒。"
                }
            ]
        },
