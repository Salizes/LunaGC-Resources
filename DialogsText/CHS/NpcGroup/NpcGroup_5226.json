    "talks": [
        {
            "talkId": "6522601",
            "initDialog": "652260101",
            "dialogues": [
                {
                    "id": "652260101",
                    "speaker": "艾古伊",
                    "text": "那些麻烦的检修工作既然有人帮忙，何必要自己费那么大劲…"
                }
            ]
        },
        {
            "talkId": "6522602",
            "initDialog": "652260201",
            "dialogues": [
                {
                    "id": "652260201",
                    "speaker": "Player",
                    "text": "关于这个码头…"
                },
                {
                    "id": "652260202",
                    "speaker": "艾古伊",
                    "text": "梅洛彼得堡那么多管道，总得有人维护吧？我们就是干这个的。"
                },
                {
                    "id": "652260203",
                    "speaker": "艾古伊",
                    "text": "不过大部分时候都只是些小修小补罢了，毕竟真要出了大问题，靠我又有什么用？"
                },
                {
                    "id": "652260204",
                    "speaker": "艾古伊",
                    "text": "还是做些自己力所能及的事吧，比如趁休假时帮人捎些信去城里…"
                }
            ]
        },
        {
            "talkId": "6522603",
            "initDialog": "652260301",
            "dialogues": [
                {
                    "id": "652260301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "652260302",
                    "speaker": "艾古伊",
                    "text": "反正我闲得很，哪有什么打扰不打扰的。"
                }
            ]
        }
    ]
}