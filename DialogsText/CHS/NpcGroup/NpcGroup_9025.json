{
    "groupId": "9025",
    "total_dialogue_lines": 61,
    "speaker_counts": {
        "Player": 21,
        "行秋": 40
    },
    "talks": [
        {
            "talkId": "6902501",
            "initDialog": "690250101",
            "dialogues": [
                {
                    "id": "690250101",
                    "speaker": "行秋",
                    "text": "#{NICKNAME}，你来得正好。"
                },
                {
                    "id": "690250102",
                    "speaker": "行秋",
                    "text": "我正盘算着你会不会出现呢。"
                }
            ]
        },
        {
            "talkId": "6902502",
            "initDialog": "690250201",
            "dialogues": [
                {
                    "id": "690250201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690250202",
                    "speaker": "行秋",
                    "text": "这般壶中天地，即使是放进小说里，也是能让人钦羡不已的。"
                },
                {
                    "id": "690250203",
                    "speaker": "行秋",
                    "text": "更何况我现在是亲临其中，亲自体验。"
                },
                {
                    "id": "690250204",
                    "speaker": "行秋",
                    "text": "那自然是再满意不过了。"
                },
                {
                    "id": "690250205",
                    "speaker": "行秋",
                    "text": "而且…"
                },
                {
                    "id": "690250206",
                    "speaker": "Player",
                    "text": "而且…"
                },
                {
                    "id": "690250207",
                    "speaker": "行秋",
                    "text": "在这边看书没有俗事来打搅，躲清闲正好。",
                    "choices": [
                        {
                            "id": "690250208",
                            "text": "行侠仗义的事要怎么办？",
                            "response": [
                                {
                                    "id": "690250210",
                                    "speaker": "行秋",
                                    "text": "小、小点声…"
                                },
                                {
                                    "id": "690250211",
                                    "speaker": "行秋",
                                    "text": "你说的那些我当然也不会落下的！"
                                },
                                {
                                    "id": "690250212",
                                    "speaker": "行秋",
                                    "text": "只是…你别说顺了嘴，让别人听去。"
                                },
                                {
                                    "id": "690250213",
                                    "speaker": "行秋",
                                    "text": "那家父和兄长的唠叨，又要够我好受的了。"
                                }
                            ]
                        },
                        {
                            "id": "690250209",
                            "text": "武艺不会退步吧？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902503",
            "initDialog": "690250301",
            "dialogues": [
                {
                    "id": "690250301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690250302",
                    "speaker": "行秋",
                    "text": "自然可以。和你聊天是件畅快的事。"
                },
                {
                    "id": "690250303",
                    "speaker": "行秋",
                    "text": "你先来说说吧，最近在忙些什么吗？",
                    "choices": [
                        {
                            "id": "690250304",
                            "text": "运送货物、教训作恶的匪徒之类的…",
                            "response": [
                                {
                                    "id": "690250306",
                                    "speaker": "行秋",
                                    "text": "好！都是「行侠仗义」的大好事。"
                                },
                                {
                                    "id": "690250307",
                                    "speaker": "行秋",
                                    "text": "啊…真想和你二人仗剑走遍天涯。",
                                    "choices": [
                                        {
                                            "id": "690250308",
                                            "text": "行秋也有身不由己之处吧…",
                                            "response": [
                                                {
                                                    "id": "690250309",
                                                    "speaker": "行秋",
                                                    "text": "不说这些，我刚刚倒是想到了一个好点子。"
                                                },
                                                {
                                                    "id": "690250312",
                                                    "speaker": "行秋",
                                                    "text": "不如我们就来进行一场比试吧，看谁先行得一百桩善事。"
                                                },
                                                {
                                                    "id": "690250313",
                                                    "speaker": "行秋",
                                                    "text": "种类不限，对象不限。但须记录在案。完成之时交由对方确认。"
                                                },
                                                {
                                                    "id": "690250314",
                                                    "speaker": "Player",
                                                    "text": "那我还是很有信心的。"
                                                },
                                                {
                                                    "id": "690250315",
                                                    "speaker": "行秋",
                                                    "text": "哼哼…"
                                                },
                                                {
                                                    "id": "690250316",
                                                    "speaker": "行秋",
                                                    "text": "唔，没什么…真的没什么。"
                                                },
                                                {
                                                    "id": "690250317",
                                                    "speaker": "行秋",
                                                    "text": "那你可要好好努力啊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690250310",
                                            "text": "我也正有此意。",
                                            "response": [
                                                {
                                                    "id": "690250311",
                                                    "speaker": "行秋",
                                                    "text": "嘿嘿…只可惜那是未来的梦想。要近些的话，有了…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690250305",
                            "text": "驱赶怪物、解救被困之人什么的…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902504",
            "initDialog": "690250401",
            "dialogues": [
                {
                    "id": "690250401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690250402",
                    "speaker": "行秋",
                    "text": "嗯，我想请你评点评点…我写的短篇小说。",
                    "choices": [
                        {
                            "id": "690250403",
                            "text": "是我们的那些故事吗？",
                            "response": [
                                {
                                    "id": "690250404",
                                    "speaker": "行秋",
                                    "text": "看来你变机灵了不少，的确受益于我的熏陶啊。"
                                },
                                {
                                    "id": "690250409",
                                    "speaker": "行秋",
                                    "text": "咳咳…古语有云：「士别三日，当刮目相待。」"
                                },
                                {
                                    "id": "690250410",
                                    "speaker": "行秋",
                                    "text": "我…我也不跟你多费什么口舌。你慢慢看便是了。"
                                },
                                {
                                    "id": "690250411",
                                    "speaker": "Player",
                                    "text": "看得出行秋很用心。"
                                },
                                {
                                    "id": "690250412",
                                    "speaker": "Player",
                                    "text": "我会把它带在身边的。"
                                },
                                {
                                    "id": "690250413",
                                    "speaker": "行秋",
                                    "text": "好啦，我们俩都什么关系了，别说这种肉麻话了。"
                                },
                                {
                                    "id": "690250414",
                                    "speaker": "行秋",
                                    "text": "记得发表感想。有了你的意见，之后的续作应该也会更加精彩吧。"
                                }
                            ]
                        },
                        {
                            "id": "690250405",
                            "text": "之前你不还支支吾吾的么…",
                            "response": [
                                {
                                    "id": "690250406",
                                    "speaker": "行秋",
                                    "text": "之前是之前…现在是现在…"
                                },
                                {
                                    "id": "690250407",
                                    "speaker": "行秋",
                                    "text": "毕竟这个故事有你的一份。"
                                },
                                {
                                    "id": "690250408",
                                    "speaker": "Player",
                                    "text": "乍一看字倒是进步了不少…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902505",
            "initDialog": "690250501",
            "dialogues": [
                {
                    "id": "690250501",
                    "speaker": "Player",
                    "text": "早啊，行秋。"
                },
                {
                    "id": "690250502",
                    "speaker": "行秋",
                    "text": "#早，{NICKNAME}。"
                },
                {
                    "id": "690250503",
                    "speaker": "行秋",
                    "text": "喂…别忘了我们的约定哦。路见不平，记得叫我。"
                }
            ]
        },
        {
            "talkId": "6902506",
            "initDialog": "690250601",
            "dialogues": [
                {
                    "id": "690250601",
                    "speaker": "Player",
                    "text": "晚安，行秋。"
                },
                {
                    "id": "690250602",
                    "speaker": "行秋",
                    "text": "晚安，好好歇息。"
                },
                {
                    "id": "690250603",
                    "speaker": "行秋",
                    "text": "如果看到了精彩的段落，我会替你做好标记，改日与你分享。"
                }
            ]
        },
        {
            "talkId": "6902507",
            "initDialog": "690250701",
            "dialogues": [
                {
                    "id": "690250701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902508",
            "initDialog": "690250801",
            "dialogues": [
                {
                    "id": "690250801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902509",
            "initDialog": "690250901",
            "dialogues": [
                {
                    "id": "690250901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902550",
            "initDialog": "690255001",
            "dialogues": [
                {
                    "id": "690255001",
                    "speaker": "行秋",
                    "text": "阁下的书斋…不简单。"
                },
                {
                    "id": "690255002",
                    "speaker": "行秋",
                    "text": "许多卷藏，是我在万文集舍，乃至璃月全城都很少得见的。"
                },
                {
                    "id": "690255003",
                    "speaker": "行秋",
                    "text": "咳咳…你平时都从哪搜集这些读物的，可否透露一二？"
                }
            ]
        },
        {
            "talkId": "6902551",
            "initDialog": "690255101",
            "dialogues": [
                {
                    "id": "690255101",
                    "speaker": "行秋",
                    "text": "烟火之气足矣，却不必被市井的吵闹烦扰。"
                },
                {
                    "id": "690255102",
                    "speaker": "行秋",
                    "text": "你所布置的街道，着实奇妙。"
                },
                {
                    "id": "690255103",
                    "speaker": "行秋",
                    "text": "踱步其中，想必能寻获不少行文的灵感！"
                }
            ]
        }
    ]
}