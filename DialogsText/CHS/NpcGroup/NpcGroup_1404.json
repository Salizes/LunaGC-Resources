    },
    "talks": [
        {
            "talkId": "40152",
            "initDialog": "4015140401",
            "dialogues": [
                {
                    "id": "4015140401",
                    "speaker": "昆恩",
                    "text": "一摩拉就想买仨苹果…"
                },
                {
                    "id": "4015140402",
                    "speaker": "昆恩",
                    "text": "想什么呢，那个家伙…嗝…",
                    "choices": [
                        {
                            "id": "4015140403",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "4015140407",
                                    "speaker": "昆恩",
                                    "text": "嗝，是你啊…"
                                },
                                {
                                    "id": "4015140408",
                                    "speaker": "昆恩",
                                    "text": "没错没错，我是卖水果的昆恩，摊子在…"
                                },
                                {
                                    "id": "4015140409",
                                    "speaker": "昆恩",
                                    "text": "新鲜水果尽在…昆恩水果…"
                                },
                                {
                                    "id": "4015140410",
                                    "speaker": "昆恩",
                                    "text": "…嗯，等等，我们见过吗？"
                                },
                                {
                                    "id": "4015140411",
                                    "speaker": "昆恩",
                                    "text": "(脑袋晕晕乎乎的啊…)"
                                },
                                {
                                    "id": "4015140405",
                                    "speaker": "Player",
                                    "text": "苹果…"
                                },
                                {
                                    "id": "4015140417",
                                    "speaker": "昆恩",
                                    "text": "嗝，晚上…不卖水果…也不打折…"
                                },
                                {
                                    "id": "4015140418",
                                    "speaker": "昆恩",
                                    "text": "嗝…多谢惠顾…"
                                }
                            ]
                        },
                        {
                            "id": "4015140404",
                            "text": "那个家伙？",
                            "response": [
                                {
                                    "id": "4015140412",
                                    "speaker": "昆恩",
                                    "text": "哦，你问贝雅啊。"
                                },
                                {
                                    "id": "4015140413",
                                    "speaker": "昆恩",
                                    "text": "不知道她到底在想什么。"
                                },
                                {
                                    "id": "4015140414",
                                    "speaker": "昆恩",
                                    "text": "每天都要来讨价还价…就算是青梅竹马…"
                                },
                                {
                                    "id": "4015140415",
                                    "speaker": "昆恩",
                                    "text": "就一摩拉，也不能卖给她仨苹果啊…"
                                },
                                {
                                    "id": "4015140416",
                                    "speaker": "昆恩",
                                    "text": "你说对吧，嗝…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}