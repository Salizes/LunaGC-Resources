{
    "groupId": "9039",
    "total_dialogue_lines": 55,
    "speaker_counts": {
        "Player": 15,
        "迪奥娜": 40
    },
    "talks": [
        {
            "talkId": "6903901",
            "initDialog": "690390101",
            "dialogues": [
                {
                    "id": "690390101",
                    "speaker": "迪奥娜",
                    "text": "#咦？{NICKNAME}，是你。"
                },
                {
                    "id": "690390102",
                    "speaker": "迪奥娜",
                    "text": "嗯…嗯！看来你身上没有酒味。"
                }
            ]
        },
        {
            "talkId": "6903902",
            "initDialog": "690390201",
            "dialogues": [
                {
                    "id": "690390201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690390202",
                    "speaker": "迪奥娜",
                    "text": "哼，勉勉强强吧。",
                    "choices": [
                        {
                            "id": "690390203",
                            "text": "只是勉勉强强吗？",
                            "response": [
                                {
                                    "id": "690390205",
                                    "speaker": "迪奥娜",
                                    "text": "这里的草地没我经常午睡的那片软。"
                                },
                                {
                                    "id": "690390206",
                                    "speaker": "迪奥娜",
                                    "text": "这里的蝴蝶没我经常去的那片花田多。"
                                },
                                {
                                    "id": "690390207",
                                    "speaker": "迪奥娜",
                                    "text": "这里也不能像在野外一样自由自在地狩猎…"
                                },
                                {
                                    "id": "690390208",
                                    "speaker": "Player",
                                    "text": "我…我会改进的。"
                                },
                                {
                                    "id": "690390209",
                                    "speaker": "迪奥娜",
                                    "text": "但…但是这里没有我讨厌的烂醉如泥的味道…"
                                },
                                {
                                    "id": "690390210",
                                    "speaker": "迪奥娜",
                                    "text": "也没有喝醉的酒鬼大吵大闹。"
                                },
                                {
                                    "id": "690390211",
                                    "speaker": "迪奥娜",
                                    "text": "所…所以，只需要维持现在这样就好…"
                                }
                            ]
                        },
                        {
                            "id": "690390204",
                            "text": "迪奥娜有什么好建议吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903903",
            "initDialog": "690390301",
            "dialogues": [
                {
                    "id": "690390301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690390302",
                    "speaker": "迪奥娜",
                    "text": "我可是很忙的！"
                },
                {
                    "id": "690390303",
                    "speaker": "迪奥娜",
                    "text": "…不过，稍微陪你聊聊也不是不可以。"
                },
                {
                    "id": "690390304",
                    "speaker": "迪奥娜",
                    "text": "说吧，我可是知道很多话题的哦！",
                    "choices": [
                        {
                            "id": "690390305",
                            "text": "迪奥娜平时也会和别人聊天吗？",
                            "response": [
                                {
                                    "id": "690390306",
                                    "speaker": "迪奥娜",
                                    "text": "唔…那些喝醉了的大叔经常来找我聊天。"
                                },
                                {
                                    "id": "690390307",
                                    "speaker": "迪奥娜",
                                    "text": "虽然我一句话也不回他们，但他们却会自顾自地一直说下去！"
                                },
                                {
                                    "id": "690390312",
                                    "speaker": "迪奥娜",
                                    "text": "每到这种时候，我就会调一杯我认为最最难喝的酒给他喝！"
                                },
                                {
                                    "id": "690390313",
                                    "speaker": "迪奥娜",
                                    "text": "但他们喝了之后，反倒都说要再来一杯！就连话也变得比之前多了起来！"
                                },
                                {
                                    "id": "690390314",
                                    "speaker": "迪奥娜",
                                    "text": "呜呜呜…到底为什么会这样嘛……"
                                }
                            ]
                        },
                        {
                            "id": "690390308",
                            "text": "迪奥娜平时都会聊些什么话题呢？",
                            "response": [
                                {
                                    "id": "690390309",
                                    "speaker": "迪奥娜",
                                    "text": "我喜欢和别人分享打猎的心得，但是…"
                                },
                                {
                                    "id": "690390310",
                                    "speaker": "迪奥娜",
                                    "text": "但是酒馆里大家都在聊庄稼的收成啦、喜欢的女性啦、打牌的技巧啦什么的…"
                                },
                                {
                                    "id": "690390311",
                                    "speaker": "迪奥娜",
                                    "text": "可恶，明明我不想听，却经常有人在我面前说个不停。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903904",
            "initDialog": "690390401",
            "dialogues": [
                {
                    "id": "690390401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690390402",
                    "speaker": "迪奥娜",
                    "text": "唔…"
                },
                {
                    "id": "690390403",
                    "speaker": "迪奥娜",
                    "text": "#其…其实，有件事，我想请{NICKNAME}你来帮忙。"
                },
                {
                    "id": "690390404",
                    "speaker": "迪奥娜",
                    "text": "平时因为需要调酒和打猎，我都会把头发像这样束起来。"
                },
                {
                    "id": "690390405",
                    "speaker": "迪奥娜",
                    "text": "但是在这里，没有任务，很放松，也不会被别人看到…"
                },
                {
                    "id": "690390406",
                    "speaker": "迪奥娜",
                    "text": "我就想…是不是把头发放下来会更、更好一点…",
                    "choices": [
                        {
                            "id": "690390407",
                            "text": "迪奥娜按自己喜欢的来就好。",
                            "response": [
                                {
                                    "id": "690390409",
                                    "speaker": "迪奥娜",
                                    "text": "真…真的吗？！"
                                },
                                {
                                    "id": "690390410",
                                    "speaker": "迪奥娜",
                                    "text": "那…那能请你来帮我打理一下吗？"
                                },
                                {
                                    "id": "690390411",
                                    "speaker": "迪奥娜",
                                    "text": "先，先说好！才不是因为我觉得梳毛很舒服才拜托你的！"
                                },
                                {
                                    "id": "690390412",
                                    "speaker": "迪奥娜",
                                    "text": "而且你要是弄疼了我，我可是会咬人的！"
                                }
                            ]
                        },
                        {
                            "id": "690390408",
                            "text": "放下来也一定很可爱。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903905",
            "initDialog": "690390501",
            "dialogues": [
                {
                    "id": "690390501",
                    "speaker": "Player",
                    "text": "早啊，迪奥娜。"
                },
                {
                    "id": "690390502",
                    "speaker": "迪奥娜",
                    "text": "#早啊，{NICKNAME}。"
                },
                {
                    "id": "690390503",
                    "speaker": "迪奥娜",
                    "text": "要出门晒太阳的话，让我跟上来…也不是不行哦。"
                }
            ]
        },
        {
            "talkId": "6903906",
            "initDialog": "690390601",
            "dialogues": [
                {
                    "id": "690390601",
                    "speaker": "Player",
                    "text": "晚安，迪奥娜。"
                },
                {
                    "id": "690390602",
                    "speaker": "迪奥娜",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690390603",
                    "speaker": "迪奥娜",
                    "text": "哎，真希望那些酒馆的大人们晚上也能像你一样老老实实在家休息。"
                },
                {
                    "id": "690390604",
                    "speaker": "迪奥娜",
                    "text": "这样我就不用去值班了。"
                }
            ]
        },
        {
            "talkId": "6903907",
            "initDialog": "690390701",
            "dialogues": [
                {
                    "id": "690390701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903908",
            "initDialog": "690390801",
            "dialogues": [
                {
                    "id": "690390801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903909",
            "initDialog": "690390901",
            "dialogues": [
                {
                    "id": "690390901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903950",
            "initDialog": "690395001",
            "dialogues": [
                {
                    "id": "690395001",
                    "speaker": "迪奥娜",
                    "text": "打猎可不简单哦，技巧和武器都很重要。"
                },
                {
                    "id": "690395002",
                    "speaker": "迪奥娜",
                    "text": "可靠的猎人每周都要到城里去维护武器，有时会花掉不少钱。"
                },
                {
                    "id": "690395003",
                    "speaker": "迪奥娜",
                    "text": "有了这个铁匠铺，我就能自己动手了。"
                }
            ]
        },
        {
            "talkId": "6903951",
            "initDialog": "690395101",
            "dialogues": [
                {
                    "id": "690395101",
                    "speaker": "迪奥娜",
                    "text": "真眼熟啊…这里很像我家的小镇。"
                },
                {
                    "id": "690395102",
                    "speaker": "迪奥娜",
                    "text": "但这里既没有酒馆，也没有酒鬼，对吧？"
                },
                {
                    "id": "690395103",
                    "speaker": "迪奥娜",
                    "text": "好！那我也要找一间房子住下！"
                }
            ]
        }
    ]
}