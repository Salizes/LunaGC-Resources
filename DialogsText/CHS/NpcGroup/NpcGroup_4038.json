    "talks": [
        {
            "talkId": "6403801",
            "initDialog": "640380101",
            "dialogues": [
                {
                    "id": "640380101",
                    "speaker": "珀姆",
                    "text": "客人买些鲜鱼吧？能做不少下酒好菜呢！"
                }
            ]
        },
        {
            "talkId": "6403802",
            "initDialog": "640380201",
            "dialogues": [
                {
                    "id": "640380201",
                    "speaker": "Player",
                    "text": "这里卖什么？"
                },
                {
                    "id": "640380202",
                    "speaker": "珀姆",
                    "text": "都是每日现捕的新鲜海货，请放心选购。"
                }
            ]
        },
        {
            "talkId": "6403803",
            "initDialog": "640380301",
            "dialogues": [
                {
                    "id": "640380301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640380302",
                    "speaker": "珀姆",
                    "text": "我是卖鱼的个体户，小本生意，薄利多销。"
                },
                {
                    "id": "640380303",
                    "speaker": "珀姆",
                    "text": "所谓靠山吃山，靠海吃海，就是这个道理吧。"
                },
                {
                    "id": "640380304",
                    "speaker": "珀姆",
                    "text": "每天从大海里获得新鲜的鱼虾和海草，不仅可以填饱自己的肚子，还能拿来卖钱养家。"
                },
                {
                    "id": "640380305",
                    "speaker": "珀姆",
                    "text": "我能过上自在的生活，都是靠着大海的恩惠啊。"
                }
            ]
        },
        {
            "talkId": "6403804",
            "initDialog": "640380401",
            "dialogues": [
                {
                    "id": "640380401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640380402",
                    "speaker": "珀姆",
                    "text": "客人慢走，想买新鲜鱼虾记得再来找我啊！"
                }
            ]
        }
    ]
}