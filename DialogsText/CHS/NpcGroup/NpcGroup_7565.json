    "talks": [
        {
            "talkId": "6756501",
            "initDialog": "675650101",
            "dialogues": [
                {
                    "id": "675650101",
                    "speaker": "柯尔萨科夫",
                    "text": "再近些，不然就拍不到那个大家伙了…那可是这次采访的重中之重！"
                }
            ]
        },
        {
            "talkId": "6756502",
            "initDialog": "675650201",
            "dialogues": [
                {
                    "id": "675650201",
                    "speaker": "Player",
                    "text": "在拍画片哦…"
                },
                {
                    "id": "675650202",
                    "speaker": "柯尔萨科夫",
                    "text": "不仅是画片，更是一整篇纪实报导…我已经说服了主编给我一整个版面来讲述海屑镇渔夫们的传奇故事…"
                },
                {
                    "id": "675650203",
                    "speaker": "柯尔萨科夫",
                    "text": "再联系一下一度从这里走出的「公子」大人，一篇能够描述至冬人坚韧精神的佳作即将诞生！"
                },
                {
                    "id": "675650204",
                    "speaker": "柯尔萨科夫",
                    "text": "海屑镇真是我的福地啊，上次写烧烤摊的文章也大受欢迎…"
                }
            ]
        },
        {
            "talkId": "6756503",
            "initDialog": "675650301",
            "dialogues": [
                {
                    "id": "675650301",
                    "speaker": "Player",
                    "text": "那我稍微让让…"
                },
                {
                    "id": "675650302",
                    "speaker": "柯尔萨科夫",
                    "text": "哈哈没事，虽然确实挡到了一些光，不过没关系，构图…内容构图才是重要的…"
                }
            ]
        }
    ]
}