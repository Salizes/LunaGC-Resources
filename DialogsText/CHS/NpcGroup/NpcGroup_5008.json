{
    "groupId": "5008",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "安蒂拉": 15
    },
    "talks": [
        {
            "talkId": "6500801",
            "initDialog": "650080101",
            "dialogues": [
                {
                    "id": "650080101",
                    "speaker": "安蒂拉",
                    "text": "唉，明明有更重要的事情…"
                }
            ]
        },
        {
            "talkId": "6500802",
            "initDialog": "650080201",
            "dialogues": [
                {
                    "id": "650080201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650080202",
                    "speaker": "安蒂拉",
                    "text": "我是蒸汽鸟报社的摄影师，陪瓦莱来采访的。"
                },
                {
                    "id": "650080203",
                    "speaker": "安蒂拉",
                    "text": "但其实这案子的看点只有「巧合」，如果无法采访那个通缉犯，是没什么可写的。"
                },
                {
                    "id": "650080204",
                    "speaker": "安蒂拉",
                    "text": "那位勋爵也真是好脾气，一直陪着他胡闹。"
                }
            ]
        },
        {
            "talkId": "6500803",
            "initDialog": "650080301",
            "dialogues": [
                {
                    "id": "650080301",
                    "speaker": "Player",
                    "text": "通缉犯？"
                },
                {
                    "id": "650080302",
                    "speaker": "安蒂拉",
                    "text": "简单来讲，案子是这样的。"
                },
                {
                    "id": "650080303",
                    "speaker": "安蒂拉",
                    "text": "那位先生用撬棍绊倒了一位小偷，小偷偷了个钱包。"
                },
                {
                    "id": "650080304",
                    "speaker": "安蒂拉",
                    "text": "钱包里有失主拍摄的画片，画片的背景里偏巧拍到了一位在逃通缉犯。"
                },
                {
                    "id": "650080305",
                    "speaker": "安蒂拉",
                    "text": "…就是这样，一个从天而降的证据，让执律庭抓到了一个逃犯。"
                },
                {
                    "id": "650080306",
                    "speaker": "安蒂拉",
                    "text": "犯人已经被送进梅洛彼得堡，不是随便就能采访到的对象。而表面上的故事，实在没什么可深挖的地方。"
                },
                {
                    "id": "650080307",
                    "speaker": "安蒂拉",
                    "text": "我想瓦莱其实心里也清楚，只是不甘心这个月的「加印」名额又被夏洛蒂抢了吧。"
                }
            ]
        },
        {
            "talkId": "6500804",
            "initDialog": "650080401",
            "dialogues": [
                {
                    "id": "650080401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650080402",
                    "speaker": "安蒂拉",
                    "text": "再见。要不是工作，我也想离开了。"
                }
            ]
        },
        {
            "talkId": "6500805",
            "initDialog": "650080501",
            "dialogues": [
                {
                    "id": "650080501",
                    "speaker": "Player",
                    "text": "关于「勋爵」？"
                },
                {
                    "id": "650080502",
                    "speaker": "安蒂拉",
                    "text": "很在意这个称呼？这是枫丹为优秀公民颁发的荣誉市民称号。"
                },
                {
                    "id": "650080503",
                    "speaker": "安蒂拉",
                    "text": "像那位勋爵先生，就是因为见义勇为加上协助调查，为维护枫丹和平做出巨大贡献而获得的。"
                },
                {
                    "id": "650080504",
                    "speaker": "安蒂拉",
                    "text": "我一直记不清这些爵位之间的顺序，只记得最高的一级应该是「公爵」吧？"
                },
                {
                    "id": "650080505",
                    "speaker": "安蒂拉",
                    "text": "那种地位的人，大概是瓦莱做梦都采访不到的。"
                }
            ]
        }
    ]
}