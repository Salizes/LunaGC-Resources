{
    "groupId": "2045",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 7,
        "卯师傅": 28
    },
    "talks": [
        {
            "talkId": "6204508",
            "initDialog": "620450801",
            "dialogues": [
                {
                    "id": "620450801",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6204509",
            "initDialog": "620450901",
            "dialogues": [
                {
                    "id": "620450901",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6204510",
            "initDialog": "620451001",
            "dialogues": [
                {
                    "id": "620451001",
                    "speaker": "卯师傅",
                    "text": "唉，难道真的这么简单吗，我再寻思一下…"
                }
            ]
        },
        {
            "talkId": "6204511",
            "initDialog": "620451101",
            "dialogues": [
                {
                    "id": "620451101",
                    "speaker": "卯师傅",
                    "text": "没关系，下次再来，事儿哪有那么多一次就成的。"
                }
            ]
        },
        {
            "talkId": "6204512",
            "initDialog": "620451201",
            "dialogues": [
                {
                    "id": "620451201",
                    "speaker": "卯师傅",
                    "text": "真是厉害，嗯，下次我做点小菜，我们边吃边玩。"
                }
            ]
        },
        {
            "talkId": "6204513",
            "initDialog": "620451301",
            "dialogues": [
                {
                    "id": "620451301",
                    "speaker": "卯师傅",
                    "text": "我可是经常和来「万民堂」的常客打上几局的，椒还是老的辣吧，哈哈哈。"
                }
            ]
        },
        {
            "talkId": "7190701",
            "initDialog": "719070101",
            "dialogues": [
                {
                    "id": "719070101",
                    "speaker": "Player",
                    "text": "有什么推荐菜吗？"
                },
                {
                    "id": "719070102",
                    "speaker": "卯师傅",
                    "text": "这「水煮黑背鲈」可是我们的招牌菜，虽说别的地方可能也能吃到，不过味道肯定比不上我们就是了。"
                },
                {
                    "id": "719070103",
                    "speaker": "卯师傅",
                    "text": "这鱼肉紧实饱满，用加入了绝云椒椒和琉璃袋的特制辣油烫过之后更是香辣、滑嫩，吃过的没有一个说不好的！"
                },
                {
                    "id": "719070104",
                    "speaker": "卯师傅",
                    "text": "…就是这菜有些辣，也不是谁都能吃得惯的。"
                },
                {
                    "id": "719070105",
                    "speaker": "卯师傅",
                    "text": "不如你先尝尝吧，如果觉得好吃再来买便是了。"
                }
            ]
        },
        {
            "talkId": "6204501",
            "initDialog": "620450101",
            "dialogues": [
                {
                    "id": "620450101",
                    "speaker": "卯师傅",
                    "text": "来尝尝「万民堂」的手艺？在吃虎岩的人都应该听说过我卯师傅的名号。"
                }
            ]
        },
        {
            "talkId": "6204502",
            "initDialog": "620450201",
            "dialogues": [
                {
                    "id": "620450201",
                    "speaker": "Player",
                    "text": "我想打包带走。"
                },
                {
                    "id": "620450202",
                    "speaker": "卯师傅",
                    "text": "没问题，看看今天想吃点儿啥？"
                }
            ]
        },
        {
            "talkId": "6204503",
            "initDialog": "620450301",
            "dialogues": [
                {
                    "id": "620450301",
                    "speaker": "Player",
                    "text": "关于万民堂…"
                },
                {
                    "id": "620450302",
                    "speaker": "卯师傅",
                    "text": "我是「万民堂」的卯师傅，手艺虽说比起我闺女稍逊一筹，可对付那些「老字号」还是绰绰有余！"
                }
            ]
        },
        {
            "talkId": "6204504",
            "initDialog": "620450401",
            "dialogues": [
                {
                    "id": "620450401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620450402",
                    "speaker": "卯师傅",
                    "text": "慢走，肚子饿了再来找我。"
                }
            ]
        },
        {
            "talkId": "6204505",
            "initDialog": "620450501",
            "dialogues": [
                {
                    "id": "620450501",
                    "speaker": "卯师傅",
                    "text": "您这边是什么菜系？"
                },
                {
                    "id": "620450502",
                    "speaker": "卯师傅",
                    "text": "菜系？我们「万民堂」可没有那么多弯弯绕绕。"
                },
                {
                    "id": "620450503",
                    "speaker": "卯师傅",
                    "text": "不管是璃菜系还是月菜系，在「万民堂系」面前全都是中原杂碎。"
                },
                {
                    "id": "620450504",
                    "speaker": "卯师傅",
                    "text": "我们就是用最大众的食材，最普适的口味，最精湛的手艺，做出最最好吃的料理。"
                },
                {
                    "id": "620450505",
                    "speaker": "卯师傅",
                    "text": "料理本身就是为所有饿着肚子的人准备的而已，定下那些条条框框的人都是看不清料理本质的庸才。"
                }
            ]
        },
        {
            "talkId": "6204506",
            "initDialog": "620450601",
            "dialogues": [
                {
                    "id": "620450601",
                    "speaker": "卯师傅",
                    "text": "闺女？"
                },
                {
                    "id": "620450602",
                    "speaker": "卯师傅",
                    "text": "香菱，我闺女，也是我最得意的门徒！"
                },
                {
                    "id": "620450603",
                    "speaker": "卯师傅",
                    "text": "我让香菱学厨，只是想让她继承「万民堂」而已，可没想到这小妮的天分远远在我之上啊。"
                },
                {
                    "id": "620450604",
                    "speaker": "卯师傅",
                    "text": "而且，她的天分主要都在料理的创新上。这对一直崇尚那些「老字号」的璃月料理界更是难能可贵。"
                },
                {
                    "id": "620450605",
                    "speaker": "卯师傅",
                    "text": "现在，我担心「万民堂」对香菱会是一种束缚，所以就放她去「料理修行」了。"
                },
                {
                    "id": "620450606",
                    "speaker": "卯师傅",
                    "text": "能够颠覆璃月料理界的人，在未来一定就是她吧，哈哈。"
                }
            ]
        },
        {
            "talkId": "6204507",
            "initDialog": "620450701",
            "dialogues": [
                {
                    "id": "620450701",
                    "speaker": "Player",
                    "text": "您这边生意如何？"
                },
                {
                    "id": "620450702",
                    "speaker": "卯师傅",
                    "text": "这话说的，我们「万民堂」的生意怎么可能会差？"
                },
                {
                    "id": "620450703",
                    "speaker": "卯师傅",
                    "text": "只要尝过了我们的手艺，大部分客人都会成为这里的常客。"
                },
                {
                    "id": "620450704",
                    "speaker": "卯师傅",
                    "text": "…说起常客，最近有一位戴着奇怪头饰的小姑娘倒是经常来，店里的素菜菜色好像还挺合她的口味的。"
                },
                {
                    "id": "620450705",
                    "speaker": "卯师傅",
                    "text": "不过最让我在意的是，她每次都只点素菜，而且量也非常少。"
                },
                {
                    "id": "620450706",
                    "speaker": "卯师傅",
                    "text": "我看她吃的少就好心给她加了些，结果她还挺不乐意的…是为了保持身材吗？现在的小姑娘可真够拼的啊…"
                }
            ]
        }
    ]
}