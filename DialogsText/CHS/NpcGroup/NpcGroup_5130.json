    },
    "talks": [
        {
            "talkId": "6513001",
            "initDialog": "651300101",
            "dialogues": [
                {
                    "id": "651300101",
                    "speaker": "艾琪诺",
                    "text": "你好。"
                },
                {
                    "id": "651300102",
                    "speaker": "艾琪诺",
                    "text": "我是刺玫会雇佣的潜水员，一般不接帮会外的委托，还请见谅。"
                }
            ]
        },
        {
            "talkId": "6513002",
            "initDialog": "651300201",
            "dialogues": [
                {
                    "id": "651300201",
                    "speaker": "Player",
                    "text": "关于潜水…"
                },
                {
                    "id": "651300202",
                    "speaker": "艾琪诺",
                    "text": "没有神之眼的人想要潜水的话，一定要经过专门训练，第一次下水时也务必请专业的潜水员陪同哦。"
                },
                {
                    "id": "651300203",
                    "speaker": "艾琪诺",
                    "text": "水下的世界虽然美丽，但也不能忽视了潜在的危险。"
                },
                {
                    "id": "651300204",
                    "speaker": "艾琪诺",
                    "text": "举个例子，很多人只关注潜水器材是否完好，却忽视了自己的身体状况。"
                },
                {
                    "id": "651300205",
                    "speaker": "艾琪诺",
                    "text": "要是不提前在潜水前活动身体，或是无法及时适应水压的话，可是很容易出现抽筋、耳鸣等症状的。"
                }
            ]
        },
        {
            "talkId": "6513003",
            "initDialog": "651300301",
            "dialogues": [
                {
                    "id": "651300301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "651300302",
                    "speaker": "艾琪诺",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6513004",
            "initDialog": "651300401",
            "dialogues": [
                {
                    "id": "651300401",
                    "speaker": "艾琪诺",
                    "text": "你好。"
                },
                {
                    "id": "651300402",
                    "speaker": "艾琪诺",
                    "text": "我是刺玫会雇佣的潜水员，现在除了镇上的委托以外，不接其他工作，还请见谅。"
                }
            ]
        },
        {
            "talkId": "6513005",
            "initDialog": "651300501",
            "dialogues": [
                {
                    "id": "651300501",
                    "speaker": "Player",
                    "text": "是为了重建白淞镇吧。"
                },
                {
                    "id": "651300502",
                    "speaker": "艾琪诺",
                    "text": "嗯…一半一半吧。"
                },
                {
                    "id": "651300503",
                    "speaker": "艾琪诺",
                    "text": "一部分是为了清理水中杂物和那些需要下水的重建工作。还有一部分，是为了追回大家的财物。"
                },
                {
                    "id": "651300504",
                    "speaker": "艾琪诺",
                    "text": "有很多镇上居民的重要物品都被冲进了水里，值钱或者不值钱的，都有不同的意义。"
                },
                {
                    "id": "651300505",
                    "speaker": "艾琪诺",
                    "text": "如果可以的话，我会尽量帮忙找回。"
                }
            ]
        },
        {
            "talkId": "6513006",
            "initDialog": "651300601",
            "dialogues": [
                {
                    "id": "651300601",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "651300602",
                    "speaker": "艾琪诺",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
