{
    "groupId": "6215",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "阿特琪": 13
    },
    "talks": [
        {
            "talkId": "6621501",
            "initDialog": "662150101",
            "dialogues": [
                {
                    "id": "662150101",
                    "speaker": "阿特琪",
                    "text": "爸爸没时间陪我玩，我只能去找小龙们…"
                }
            ]
        },
        {
            "talkId": "6621502",
            "initDialog": "662150201",
            "dialogues": [
                {
                    "id": "662150201",
                    "speaker": "Player",
                    "text": "爸爸很忙？"
                },
                {
                    "id": "662150202",
                    "speaker": "阿特琪",
                    "text": "根本不忙！他就是每天昂首挺胸，在营地里走来走去嘛。"
                },
                {
                    "id": "662150203",
                    "speaker": "阿特琪",
                    "text": "而且还警告我不能在龙附近太闹腾，哼，我看他就是想让我每天都在家里做功课，这样他就省心了。"
                },
                {
                    "id": "662150204",
                    "speaker": "阿特琪",
                    "text": "欸嘿，不可能让他如愿的！我这就去找小龙捉迷藏！"
                },
                {
                    "id": "662150205",
                    "speaker": "阿特琪",
                    "text": "不过，和暝视龙玩捉迷藏好难赢哦…要是附近有嵴锋龙就好了。"
                }
            ]
        },
        {
            "talkId": "6621503",
            "initDialog": "662150301",
            "dialogues": [
                {
                    "id": "662150301",
                    "speaker": "Player",
                    "text": "注意安全。"
                },
                {
                    "id": "662150302",
                    "speaker": "阿特琪",
                    "text": "嗯，我会的。"
                }
            ]
        },
        {
            "talkId": "6621504",
            "initDialog": "662150401",
            "dialogues": [
                {
                    "id": "662150401",
                    "speaker": "Player",
                    "text": "妈妈呢？"
                },
                {
                    "id": "662150402",
                    "speaker": "阿特琪",
                    "text": "妈妈是医生，是大忙人！她经常出门工作，还会带好吃的回家。"
                },
                {
                    "id": "662150403",
                    "speaker": "阿特琪",
                    "text": "不过…她不出远门的时候，就会带我去找「黑曜石奶奶」…"
                },
                {
                    "id": "662150404",
                    "speaker": "阿特琪",
                    "text": "妈妈会给茜特菈莉奶奶带些卷心菜、颗粒果或者药草之类的东西，之后就会让奶奶给我上课、留作业…"
                },
                {
                    "id": "662150405",
                    "speaker": "阿特琪",
                    "text": "奶奶留的作业都好难哦…这么一想，大人们还是都忙一点比较好！"
                }
            ]
        },
        {
            "talkId": "6621505",
            "initDialog": "662150501",
            "dialogues": [
                {
                    "id": "662150501",
                    "speaker": "阿特琪",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6621506",
            "initDialog": "662150601",
            "dialogues": [
                {
                    "id": "662150601",
                    "speaker": "阿特琪",
                    "text": "打牌好好玩！再来再来！"
                }
            ]
        },
        {
            "talkId": "6621507",
            "initDialog": "662150701",
            "dialogues": [
                {
                    "id": "662150701",
                    "speaker": "阿特琪",
                    "text": "呜，打牌好难，比捉迷藏还难…"
                }
            ]
        }
    ]
}