{
    "groupId": "5028",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "魏小保": 9
    },
    "talks": [
        {
            "talkId": "6502801",
            "initDialog": "650280101",
            "dialogues": [
                {
                    "id": "650280101",
                    "speaker": "魏小保",
                    "text": "我好像买太多了…"
                }
            ]
        },
        {
            "talkId": "6502802",
            "initDialog": "650280201",
            "dialogues": [
                {
                    "id": "650280201",
                    "speaker": "Player",
                    "text": "冲动消费了？"
                },
                {
                    "id": "650280202",
                    "speaker": "魏小保",
                    "text": "嗐，可不是嘛。"
                },
                {
                    "id": "650280203",
                    "speaker": "魏小保",
                    "text": "想着好不容易出国旅行一趟，就放松了警惕，看见什么都想买。"
                },
                {
                    "id": "650280204",
                    "speaker": "魏小保",
                    "text": "你说别的东西也就算了，我买几十瓶香水要拿来做什么呢，就算送人也送不出这么多啊。"
                },
                {
                    "id": "650280205",
                    "speaker": "魏小保",
                    "text": "不过转念一想，就当是进了一批样品吧！"
                },
                {
                    "id": "650280206",
                    "speaker": "魏小保",
                    "text": "反正我的假期还长，之后把它们再带去其他地方，没准还能开拓新市场呢。"
                }
            ]
        },
        {
            "talkId": "6502803",
            "initDialog": "650280301",
            "dialogues": [
                {
                    "id": "650280301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650280302",
                    "speaker": "魏小保",
                    "text": "算了，就当是进了一批样品吧。"
                }
            ]
        },
        {
            "talkId": "7492601",
            "initDialog": "749260101",
            "dialogues": [
                {
                    "id": "749260101",
                    "speaker": "Player",
                    "text": "很有商业头脑。"
                },
                {
                    "id": "749260102",
                    "speaker": "魏小保",
                    "text": "过奖了，我的商业头脑还算朴实，和那位卡嘉妮的「口才」相比还是差了点。"
                },
                {
                    "id": "749260103",
                    "speaker": "魏小保",
                    "text": "她的说辞就像她随香水附赠给我的这些花一样，怪唬人的。"
                }
            ]
        }
    ]
}