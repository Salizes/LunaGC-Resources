    "talks": [
        {
            "talkId": "6954401",
            "initDialog": "695440101",
            "dialogues": [
                {
                    "id": "695440101",
                    "speaker": "七七",
                    "text": "好多人，好热，我不喜欢…但这种卡牌很有趣，你可以，陪我玩一局吗？"
                }
            ]
        },
        {
            "talkId": "6954402",
            "initDialog": "695440201",
            "dialogues": [
                {
                    "id": "695440201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954403",
            "initDialog": "695440301",
            "dialogues": [
                {
                    "id": "695440301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695440302",
                    "speaker": "七七",
                    "text": "我等一下也要回去，不能让白先生，担心。"
                }
            ]
        },
        {
            "talkId": "6954404",
            "initDialog": "695440401",
            "dialogues": [
                {
                    "id": "695440401",
                    "speaker": "七七",
                    "text": "你的牌，我要记下来…用得上。"
                }
            ]
        },
        {
            "talkId": "6954405",
            "initDialog": "695440501",
            "dialogues": [
                {
                    "id": "695440501",
                    "speaker": "七七",
                    "text": "输掉的对局，也要记下来吗？唔…"
                }
            ]
        },
        {
            "talkId": "6954406",
            "initDialog": "695440601",
            "dialogues": [
                {
                    "id": "695440601",
                    "speaker": "七七",
                    "text": "好。我先看看笔记，出牌方式，在上面。"
                }
            ]
        },
        {
            "talkId": "6954408",
            "initDialog": "695440801",
            "dialogues": [
                {
                    "id": "695440801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954409",
            "initDialog": "695440901",
            "dialogues": [
                {
                    "id": "695440901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954410",
            "initDialog": "695441001",
            "dialogues": [
                {
                    "id": "695441001",
                    "speaker": "七七",
                    "text": "没有忘记步骤，还好…"
                }
            ]
        },
        {
            "talkId": "6954411",
            "initDialog": "695441101",
            "dialogues": [
                {
                    "id": "695441101",
                    "speaker": "七七",
                    "text": "…是哪一步，被我漏掉了吗？"
                }
            ]
        },
        {
            "talkId": "6954412",
            "initDialog": "695441201",
            "dialogues": [
                {
                    "id": "695441201",
                    "speaker": "七七",
                    "text": "记了好多厉害的出牌方式，所以，不会输。"
                }
            ]
        },
        {
            "talkId": "6954414",
            "initDialog": "695441401",
            "dialogues": [
                {
                    "id": "695441401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954415",
            "initDialog": "695441501",
            "dialogues": [
                {
                    "id": "695441501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
