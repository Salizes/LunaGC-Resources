    },
    "talks": [
        {
            "talkId": "6763501",
            "initDialog": "676350101",
            "dialogues": [
                {
                    "id": "676350101",
                    "speaker": "赫尔妲",
                    "text": "要打造什么？需要特别定制的话也可以哦！"
                }
            ]
        },
        {
            "talkId": "6763502",
            "initDialog": "676350201",
            "dialogues": [
                {
                    "id": "676350201",
                    "speaker": "Player",
                    "text": "只是随便看看。"
                },
                {
                    "id": "676350202",
                    "speaker": "赫尔妲",
                    "text": "嗯，不用急，可以慢慢挑，看见合眼缘的也可以上手试试看称不称手。"
                },
                {
                    "id": "676350203",
                    "speaker": "赫尔妲",
                    "text": "武器就是伙伴，结交之前总得仔细甄别。有的武器或许素质不坏，可就是不匹配，这种事也很常见。"
                },
                {
                    "id": "676350204",
                    "speaker": "赫尔妲",
                    "text": "相信我，好的武器就像好的伙伴，一定会在你最需要的时候拉你一把的。"
                }
            ]
        },
        {
            "talkId": "6763503",
            "initDialog": "676350301",
            "dialogues": [
                {
                    "id": "676350301",
                    "speaker": "Player",
                    "text": "没什么需要的，再见。"
                },
                {
                    "id": "676350302",
                    "speaker": "赫尔妲",
                    "text": "再见！"
                }
            ]
        },
        {
            "talkId": "6763504",
            "initDialog": "676350401",
            "dialogues": [
                {
                    "id": "676350401",
                    "speaker": "Player",
                    "text": "你说得很有道理。"
                },
                {
                    "id": "676350402",
                    "speaker": "赫尔妲",
                    "text": "是吧？所以你可以多花点时间慢慢挑…对了！如果有什么特别的需求，定制也是可以的哦。"
                }
            ]
        },
        {
            "talkId": "6763505",
            "initDialog": "676350501",
            "dialogues": [
                {
                    "id": "676350501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "6763514",
            "initDialog": "676351401",
            "dialogues": [
                {
                    "id": "676351401",
                    "speaker": "赫尔妲",
                    "text": "嗯？这附近吗？要留意的应该只有狂猎啦。哪怕是在灯火下，也要时刻提防怪物们来袭哦。"
                }
            ]
        }
    ]
}