{
    "groupId": "7553",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "兹纳缅斯基": 10
    },
    "talks": [
        {
            "talkId": "6755301",
            "initDialog": "675530101",
            "dialogues": [
                {
                    "id": "675530101",
                    "speaker": "兹纳缅斯基",
                    "text": "欢迎来到海屑镇！如果有什么需要，请及时和我说…"
                }
            ]
        },
        {
            "talkId": "6755302",
            "initDialog": "675530201",
            "dialogues": [
                {
                    "id": "675530201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "675530202",
                    "speaker": "兹纳缅斯基",
                    "text": "我是至冬列车海屑镇一站的负责人，如果有对于经过海屑镇的车次不太了解的地方，都可以问我。"
                },
                {
                    "id": "675530203",
                    "speaker": "兹纳缅斯基",
                    "text": "实不相瞒，没人比我更熟悉这里的事务，我已经在这里供职快十年啦。"
                }
            ]
        },
        {
            "talkId": "6755303",
            "initDialog": "675530301",
            "dialogues": [
                {
                    "id": "675530301",
                    "speaker": "Player",
                    "text": "有什么推荐吗？"
                },
                {
                    "id": "675530302",
                    "speaker": "兹纳缅斯基",
                    "text": "在海屑镇能干的事还是挺多的，您可以去海钓，或是试试雪橇，也可以去拉祖莫夫斯基的摊子吃烧烤！"
                },
                {
                    "id": "675530303",
                    "speaker": "兹纳缅斯基",
                    "text": "恕我直言，他调的烧烤酱味道一般，不过胜在鱼和肉都很新鲜。"
                }
            ]
        },
        {
            "talkId": "6755304",
            "initDialog": "675530401",
            "dialogues": [
                {
                    "id": "675530401",
                    "speaker": "Player",
                    "text": "没什么想问的了…"
                },
                {
                    "id": "675530402",
                    "speaker": "兹纳缅斯基",
                    "text": "好的，还祝您旅途愉快。"
                }
            ]
        },
        {
            "talkId": "6755305",
            "initDialog": "675530501",
            "dialogues": [
                {
                    "id": "675530501",
                    "speaker": "Player",
                    "text": "运输局工作那么稳定吗？"
                },
                {
                    "id": "675530502",
                    "speaker": "兹纳缅斯基",
                    "text": "与其说是稳定，不如说…我只能在这边工作…"
                },
                {
                    "id": "675530503",
                    "speaker": "兹纳缅斯基",
                    "text": "年轻的时候在至冬堡的列车总站，由于调度疏忽导致过很严重的事故，那之后就被下派到海屑镇…"
                },
                {
                    "id": "675530504",
                    "speaker": "兹纳缅斯基",
                    "text": "也曾消沉过一段时间，不过现在已经想明白了，在哪干活都得干出样子来啊。"
                }
            ]
        },
        {
            "talkId": "6755306",
            "initDialog": "675530601",
            "dialogues": [
                {
                    "id": "675530601",
                    "speaker": "Player",
                    "text": "原来是老员工了！"
                },
                {
                    "id": "675530602",
                    "speaker": "兹纳缅斯基",
                    "text": "是的，所以有什么想了解的就尽管来找我吧。"
                }
            ]
        }
    ]
}