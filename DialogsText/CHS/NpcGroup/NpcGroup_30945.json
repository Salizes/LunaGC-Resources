{
    "groupId": "30945",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 1,
        "凯亚": 7,
        "派蒙": 3,
        "迪卢克": 8
    },
    "talks": [
        {
            "talkId": "4023160",
            "initDialog": "402316001",
            "dialogues": [
                {
                    "id": "402316001",
                    "speaker": "派蒙",
                    "text": "这个帐篷怎么在这里？"
                },
                {
                    "id": "402316002",
                    "speaker": "派蒙",
                    "text": "好像还…挺怀念的。"
                },
                {
                    "id": "402316003",
                    "speaker": "迪卢克",
                    "text": "因为我还是拒绝了那位魔女，不允许她把我的房子当成游乐场。"
                },
                {
                    "id": "402316004",
                    "speaker": "迪卢克",
                    "text": "所以需要额外准备一个休息处，用来补充能量和水分。"
                },
                {
                    "id": "402316005",
                    "speaker": "凯亚",
                    "text": "此外，也可以利用这个设备和魔女取得联系，获取帮助或提示…和那个时候很相似。"
                },
                {
                    "id": "402316006",
                    "speaker": "迪卢克",
                    "text": "仔细想好像确实差不多，我都快忘了。"
                },
                {
                    "id": "402316007",
                    "speaker": "凯亚",
                    "text": "骑士团的假日，夏天与大海，一艘小小的浪船，我的印象很深刻呢。"
                },
                {
                    "id": "402316008",
                    "speaker": "迪卢克",
                    "text": "我只对我们两个流落荒岛，打算渡海却举步维艰的事印象深刻。"
                },
                {
                    "id": "402316009",
                    "speaker": "凯亚",
                    "text": "这我也赞同，毕竟我不是添乱的那一个。"
                },
                {
                    "id": "402316010",
                    "speaker": "派蒙",
                    "text": "啊哈哈…所、所以这个是魔女特别准备的东西吧，我们要留个影，回去确认一下。"
                },
                {
                    "id": "402316011",
                    "speaker": "迪卢克",
                    "text": "请便。"
                },
                {
                    "id": "402316012",
                    "speaker": "凯亚",
                    "text": "挪德卡莱的远征队即将回归，按照大团长法尔伽的性子，我觉得可能又会有出游的机会。"
                },
                {
                    "id": "402316013",
                    "speaker": "凯亚",
                    "text": "别误会，我只是提一下有这个可能性。"
                },
                {
                    "id": "402316014",
                    "speaker": "Player",
                    "text": "我应该能去吧。"
                },
                {
                    "id": "402316015",
                    "speaker": "凯亚",
                    "text": "当然欢迎，骑士团的任何活动，肯定都有荣誉骑士的位置。"
                },
                {
                    "id": "402316016",
                    "speaker": "迪卢克",
                    "text": "等有正式的邀请到我这里再说吧，我手上还有其他很多事。"
                },
                {
                    "id": "402316017",
                    "speaker": "迪卢克",
                    "text": "我这里的情报，能看到未来的一百种可能性，其中唯独不存在「假日」。"
                }
            ]
        },
        {
            "talkId": "4023177",
            "initDialog": "402317701",
            "dialogues": [
                {
                    "id": "402317701",
                    "speaker": "凯亚",
                    "text": "真遗憾啊，清闲日子怎么都过不够。还想再去一趟金苹果群岛呢。"
                },
                {
                    "id": "402317702",
                    "speaker": "迪卢克",
                    "text": "…这我倒是有同感。"
                }
            ]
        }
    ]
}