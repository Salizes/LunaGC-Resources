    "talks": [
        {
            "talkId": "6390001",
            "initDialog": "639000101",
            "dialogues": [
                {
                    "id": "639000101",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）我这双眼睛真是白长了…要是没接这个委托就好了…$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390002",
            "initDialog": "639000201",
            "dialogues": [
                {
                    "id": "639000201",
                    "speaker": "Player",
                    "text": "（test）你在发愁什么？"
                },
                {
                    "id": "639000202",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）我在说我前段时间接到的那个委托呢。$UNRELEASED"
                },
                {
                    "id": "639000203",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）当时我一看是低级委托，又看到发布人是我仰慕已久的砂…咳咳，是某位炼金术士小姐…$UNRELEASED"
                },
                {
                    "id": "639000204",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）…那时我光顾着想委托完成之后，说不定能发展成长期合作的关系什么的…$UNRELEASED"
                },
                {
                    "id": "639000205",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）结果我回过神才发现，这里面问题太大了！$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390003",
            "initDialog": "639000301",
            "dialogues": [
                {
                    "id": "639000301",
                    "speaker": "Player",
                    "text": "（test）委托很难吗？"
                },
                {
                    "id": "639000302",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）难倒是不难，任务只需要收集一些炼金材料，但是…我当时没留意到地点是龙脊雪山啊！$UNRELEASED"
                },
                {
                    "id": "639000303",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）要是考虑到委托的地点，这绝对应该算面向顶级冒险家的高难度委托啊！$UNRELEASED"
                },
                {
                    "id": "639000304",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）协会的委托难度评估绝对不正常啊…不过也怪我接委托时没仔细看，唉…$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390004",
            "initDialog": "639000401",
            "dialogues": [
                {
                    "id": "639000401",
                    "speaker": "Player",
                    "text": "（test）再见，祝你顺利。"
                },
                {
                    "id": "639000402",
                    "speaker": "（test）Override成男$UNRELEASED",
                    "text": "（test）谢谢，也祝你旅途顺利。$UNRELEASED"
                }
            ]
        }
    ]
}