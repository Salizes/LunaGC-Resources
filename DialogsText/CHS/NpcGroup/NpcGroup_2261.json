    "talks": [
        {
            "talkId": "6226101",
            "initDialog": "622610101",
            "dialogues": [
                {
                    "id": "622610101",
                    "speaker": "贾尔库坦",
                    "text": "温度和水分的因素排除了，看起来还是土壤的问题…"
                }
            ]
        },
        {
            "talkId": "6226102",
            "initDialog": "622610201",
            "dialogues": [
                {
                    "id": "622610201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "622610202",
                    "speaker": "贾尔库坦",
                    "text": "我是生论派学者贾尔库坦，来这里做关于茶树的研究。"
                }
            ]
        },
        {
            "talkId": "6226103",
            "initDialog": "622610301",
            "dialogues": [
                {
                    "id": "622610301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622610302",
                    "speaker": "贾尔库坦",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6226104",
            "initDialog": "622610401",
            "dialogues": [
                {
                    "id": "622610401",
                    "speaker": "Player",
                    "text": "你们的课题真是广泛。"
                },
                {
                    "id": "622610402",
                    "speaker": "贾尔库坦",
                    "text": "唉，这还不是没办法吗？越偏门的课题就越好发论文。"
                },
                {
                    "id": "622610403",
                    "speaker": "贾尔库坦",
                    "text": "像茶树移栽这种课题，教令院内几乎没有人关注，所以就没什么竞争对手。"
                },
                {
                    "id": "622610404",
                    "speaker": "贾尔库坦",
                    "text": "只不过…"
                }
            ]
        },
        {
            "talkId": "6226105",
            "initDialog": "622610501",
            "dialogues": [
                {
                    "id": "622610501",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "622610502",
                    "speaker": "贾尔库坦",
                    "text": "不知道为什么，我们引种到须弥的茶树总是不成活。"
                },
                {
                    "id": "622610503",
                    "speaker": "贾尔库坦",
                    "text": "我思来想去，总觉得是土壤的问题。可惜地质和水文这两门课，我上学的时候就没学明白，现如今再从头开始，难啊…"
                }
            ]
        }
    ]
}