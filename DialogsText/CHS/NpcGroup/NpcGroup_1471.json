{
    "groupId": "1471",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "维多利亚": 18
    },
    "talks": [
        {
            "talkId": "7090801",
            "initDialog": "709080101",
            "dialogues": [
                {
                    "id": "709080101",
                    "speaker": "Player",
                    "text": "我怎么觉得没那么简单…"
                },
                {
                    "id": "709080102",
                    "speaker": "维多利亚",
                    "text": "哼，敏锐的人总是不讨人喜欢啊。"
                },
                {
                    "id": "709080103",
                    "speaker": "维多利亚",
                    "text": "有些人出生在阳光之下，便觉得那些光明和温暖都是理所应当。"
                },
                {
                    "id": "709080104",
                    "speaker": "维多利亚",
                    "text": "然而爱、虔诚与神圣，一切的美好都是构筑在罪人的血泪之上的…"
                },
                {
                    "id": "709080105",
                    "speaker": "维多利亚",
                    "text": "你们究竟是看不到，还是说故意不想去看到呢？"
                },
                {
                    "id": "709080106",
                    "speaker": "维多利亚",
                    "text": "既然如此，便不要多问，不要多想，罪孽找上门时，审判自然也会接踵而至。"
                },
                {
                    "id": "709080107",
                    "speaker": "维多利亚",
                    "text": "我说的这些，你就当做是一个忠告吧。还有这个东西你也可以收下，愿它能够一直警示你。"
                }
            ]
        },
        {
            "talkId": "6147101",
            "initDialog": "614710101",
            "dialogues": [
                {
                    "id": "614710101",
                    "speaker": "维多利亚",
                    "text": "有什么事，是需要来忏悔的吗？"
                }
            ]
        },
        {
            "talkId": "6147102",
            "initDialog": "614710201",
            "dialogues": [
                {
                    "id": "614710201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "614710202",
                    "speaker": "维多利亚",
                    "text": "我是维多利亚，教会的人。"
                },
                {
                    "id": "614710203",
                    "speaker": "维多利亚",
                    "text": "我聆听人们的忏悔，并在必要的时候加以引导。"
                },
                {
                    "id": "614710204",
                    "speaker": "维多利亚",
                    "text": "各种各样的，有益于灵魂的…引导。"
                }
            ]
        },
        {
            "talkId": "6147103",
            "initDialog": "614710301",
            "dialogues": [
                {
                    "id": "614710301",
                    "speaker": "Player",
                    "text": "蒙德有什么好地方吗？"
                },
                {
                    "id": "614710302",
                    "speaker": "维多利亚",
                    "text": "你身上罪孽的气息也有些重了啊…现在对你来说最好的地方可能是忏悔室吧。"
                },
                {
                    "id": "614710303",
                    "speaker": "维多利亚",
                    "text": "…呵呵，我随口说说的，玩笑而已。"
                },
                {
                    "id": "614710304",
                    "speaker": "维多利亚",
                    "text": "麻烦下次不要问我这种无聊的问题。"
                }
            ]
        },
        {
            "talkId": "6147104",
            "initDialog": "614710401",
            "dialogues": [
                {
                    "id": "614710401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614710402",
                    "speaker": "维多利亚",
                    "text": "再见。"
                },
                {
                    "id": "614710403",
                    "speaker": "维多利亚",
                    "text": "需要忏悔的时候可以再来找我。"
                }
            ]
        },
        {
            "talkId": "6147105",
            "initDialog": "614710501",
            "dialogues": [
                {
                    "id": "614710501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614710502",
                    "speaker": "维多利亚",
                    "text": "自从风魔龙出现之后，来忏悔的人倒是变多了不少，真没想到会有这样的意外收获。"
                },
                {
                    "id": "614710503",
                    "speaker": "维多利亚",
                    "text": "不过没关系，就算没有风魔龙，我也有的是办法来让他们「主动」忏悔的…"
                },
                {
                    "id": "614710504",
                    "speaker": "维多利亚",
                    "text": "…别放在心上，随口说说罢了，呵呵。"
                }
            ]
        }
    ]
}