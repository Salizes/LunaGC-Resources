{
    "groupId": "9083",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Player": 15,
        "琳妮特": 44
    },
    "talks": [
        {
            "talkId": "6908301",
            "initDialog": "690830101",
            "dialogues": [
                {
                    "id": "690830101",
                    "speaker": "琳妮特",
                    "text": "……"
                },
                {
                    "id": "690830102",
                    "speaker": "琳妮特",
                    "text": "…待机模式结束。抱歉，响应需要一点时间，并非不想理你。"
                }
            ]
        },
        {
            "talkId": "6908302",
            "initDialog": "690830201",
            "dialogues": [
                {
                    "id": "690830201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690830202",
                    "speaker": "琳妮特",
                    "text": "只要把自己的意识放空，在哪里都一样。"
                },
                {
                    "id": "690830203",
                    "speaker": "琳妮特",
                    "text": "…不过，以正常标准而言，这里的环境确实很不错。",
                    "choices": [
                        {
                            "id": "690830204",
                            "text": "以正常标准而言？",
                            "response": [
                                {
                                    "id": "690830205",
                                    "speaker": "琳妮特",
                                    "text": "清洁的空气，温暖的床榻，广阔的空间…"
                                },
                                {
                                    "id": "690830206",
                                    "speaker": "琳妮特",
                                    "text": "要是我们以前能在这种环境下长大，林尼也不用总操心这操心那了吧。"
                                },
                                {
                                    "id": "690830207",
                                    "speaker": "琳妮特",
                                    "text": "…好像掺进了一点主观要素，请不要在意。总之是一个好地方。"
                                }
                            ]
                        },
                        {
                            "id": "690830208",
                            "text": "以你的标准呢？",
                            "response": [
                                {
                                    "id": "690830209",
                                    "speaker": "琳妮特",
                                    "text": "很适合发呆。充能速率比平时高了百分之五。"
                                },
                                {
                                    "id": "690830210",
                                    "speaker": "Player",
                                    "text": "好微妙的评价…"
                                },
                                {
                                    "id": "690830211",
                                    "speaker": "琳妮特",
                                    "text": "…以琳妮特标准，这已经是最高评价了哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908303",
            "initDialog": "690830301",
            "dialogues": [
                {
                    "id": "690830301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690830302",
                    "speaker": "琳妮特",
                    "text": "……"
                },
                {
                    "id": "690830303",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "690830304",
                    "speaker": "琳妮特",
                    "text": "…真罕见，很少会有人想让我先开启一个话题。"
                },
                {
                    "id": "690830305",
                    "speaker": "琳妮特",
                    "text": "毕竟大部分情况下，都会像这样陷入沉默。",
                    "choices": [
                        {
                            "id": "690830306",
                            "text": "你不喜欢聊天吗？",
                            "response": [
                                {
                                    "id": "690830307",
                                    "speaker": "琳妮特",
                                    "text": "不会哦，我经常和女孩子们聊天。"
                                },
                                {
                                    "id": "690830308",
                                    "speaker": "琳妮特",
                                    "text": "不管是讨论新的小说情节，还是谁跟谁互相暗恋…"
                                },
                                {
                                    "id": "690830309",
                                    "speaker": "琳妮特",
                                    "text": "只要在恰当的时机接一句「原来如此」、「竟然是这样」、「然后呢」…就可以顺利推进对话。"
                                },
                                {
                                    "id": "690830310",
                                    "speaker": "琳妮特",
                                    "text": "…省力节能，我很推荐。"
                                }
                            ]
                        },
                        {
                            "id": "690830311",
                            "text": "毕竟不太说话呢…",
                            "response": [
                                {
                                    "id": "690830312",
                                    "speaker": "琳妮特",
                                    "text": "要想说出一句话，得先倾听，再分析，构思完毕，最后讲出口。"
                                },
                                {
                                    "id": "690830313",
                                    "speaker": "琳妮特",
                                    "text": "如果想你一句我一句地聊起天的话，就得高效处理这些情报…唔，有点费力。"
                                },
                                {
                                    "id": "690830314",
                                    "speaker": "琳妮特",
                                    "text": "…不过也有一些人，本就希望聊天的对象多听、少说吧。"
                                },
                                {
                                    "id": "690830315",
                                    "speaker": "琳妮特",
                                    "text": "如果你有什么想倾诉的事，可以来找我。在帮忙平复心情方面，我还是有点经验的。"
                                },
                                {
                                    "id": "690830316",
                                    "speaker": "琳妮特",
                                    "text": "而且，完全不用担心我会到处乱说。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908304",
            "initDialog": "690830401",
            "dialogues": [
                {
                    "id": "690830401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690830402",
                    "speaker": "琳妮特",
                    "text": "……"
                },
                {
                    "id": "690830403",
                    "speaker": "Player",
                    "text": "…除了发呆？"
                },
                {
                    "id": "690830404",
                    "speaker": "琳妮特",
                    "text": "…排除这个选项，一下子还真想不到能做什么。"
                },
                {
                    "id": "690830405",
                    "speaker": "琳妮特",
                    "text": "要来一杯茶吗？我去给你泡。"
                },
                {
                    "id": "690830406",
                    "speaker": "Player",
                    "text": "主人怎么能麻烦客人泡茶呢。"
                },
                {
                    "id": "690830407",
                    "speaker": "琳妮特",
                    "text": "不麻烦的，对我来说，泡茶是件让人心情愉悦的事。"
                },
                {
                    "id": "690830408",
                    "speaker": "琳妮特",
                    "text": "每次有客人上门找林尼会谈，都是由我来泡茶招待。"
                },
                {
                    "id": "690830409",
                    "speaker": "琳妮特",
                    "text": "甄选茶叶，触量水温，观察气旋…我很喜欢这个过程。为了一杯完美的茶，投入百分百的精神。"
                },
                {
                    "id": "690830410",
                    "speaker": "Player",
                    "text": "居然有这么多门道…"
                },
                {
                    "id": "690830411",
                    "speaker": "琳妮特",
                    "text": "…在泡茶的时候，不会有人把我拉去问话。"
                },
                {
                    "id": "690830412",
                    "speaker": "琳妮特",
                    "text": "泡完之后，只要举着杯子坐在一边，也可以制造出正在喝茶、没空说话的氛围。"
                },
                {
                    "id": "690830413",
                    "speaker": "Player",
                    "text": "结果还是为了发呆吗！"
                },
                {
                    "id": "690830414",
                    "speaker": "琳妮特",
                    "text": "玩笑而已——很意外吗？我也是会开玩笑的，只是平时没有必要。"
                },
                {
                    "id": "690830415",
                    "speaker": "琳妮特",
                    "text": "泡茶的确是我少有的爱好之一，品茶也是。即使只有细微味道的不同，我也能加以区分。"
                },
                {
                    "id": "690830416",
                    "speaker": "琳妮特",
                    "text": "你见多识广，应该尝过不少地方的茶吧？"
                },
                {
                    "id": "690830417",
                    "speaker": "琳妮特",
                    "text": "有空的话，要来尝一下我的手艺吗？我也想听听你的评价。"
                }
            ]
        },
        {
            "talkId": "6908305",
            "initDialog": "690830501",
            "dialogues": [
                {
                    "id": "690830501",
                    "speaker": "Player",
                    "text": "早啊，琳妮特。"
                },
                {
                    "id": "690830502",
                    "speaker": "琳妮特",
                    "text": "#早上好，{NICKNAME}。"
                },
                {
                    "id": "690830503",
                    "speaker": "琳妮特",
                    "text": "早上很好，新的一天刚开始，有充足的时间，可以用来休息。"
                },
                {
                    "id": "690830504",
                    "speaker": "琳妮特",
                    "text": "…你要一起来吗？"
                }
            ]
        },
        {
            "talkId": "6908306",
            "initDialog": "690830601",
            "dialogues": [
                {
                    "id": "690830601",
                    "speaker": "Player",
                    "text": "晚安，琳妮特。"
                },
                {
                    "id": "690830602",
                    "speaker": "琳妮特",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690830603",
                    "speaker": "琳妮特",
                    "text": "…进入待机模式…呼，呼…"
                }
            ]
        },
        {
            "talkId": "6908310",
            "initDialog": "690831001",
            "dialogues": [
                {
                    "id": "690831001",
                    "speaker": "琳妮特",
                    "text": "哥哥带我外出表演时，经常能够看到这样的街景。"
                },
                {
                    "id": "690831002",
                    "speaker": "琳妮特",
                    "text": "有遮阳伞提供的舒适，但没有哥哥产出的喧闹，预计充能效率可以翻倍。"
                },
                {
                    "id": "690831003",
                    "speaker": "琳妮特",
                    "text": "要坐下来喝杯茶吗？我记得你喜欢的甜度。"
                }
            ]
        },
        {
            "talkId": "6908311",
            "initDialog": "690831101",
            "dialogues": [
                {
                    "id": "690831101",
                    "speaker": "琳妮特",
                    "text": "你的视线看向我，但眼角余光在关注舞台，这说明你在期待一场表演…"
                },
                {
                    "id": "690831102",
                    "speaker": "琳妮特",
                    "text": "咻咻——"
                },
                {
                    "id": "690831103",
                    "speaker": "琳妮特",
                    "text": "进入待机模式，等待林尼完成前置演出流程。稍后舞台见。"
                }
            ]
        }
    ]
}