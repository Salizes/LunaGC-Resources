{
    "groupId": "7146",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "托库沃": 9
    },
    "talks": [
        {
            "talkId": "6714601",
            "initDialog": "671460101",
            "dialogues": [
                {
                    "id": "671460101",
                    "speaker": "托库沃",
                    "text": "老伙计，再坚持一段时间…回港就给你换上机油。"
                }
            ]
        },
        {
            "talkId": "6714602",
            "initDialog": "671460201",
            "dialogues": [
                {
                    "id": "671460201",
                    "speaker": "Player",
                    "text": "这艘船看上去已经很老旧了…"
                },
                {
                    "id": "671460202",
                    "speaker": "托库沃",
                    "text": "是啊，「不掉漆号」已经跟了我大半辈子了，本来去年我们俩打算一起退休的。这年纪了还出来跑单，真不是为了别的——"
                },
                {
                    "id": "671460203",
                    "speaker": "托库沃",
                    "text": "我女儿要结婚啦！为了给她筹办一个体面的婚礼，只能再勉强勉强这把老骨头喽！"
                }
            ]
        },
        {
            "talkId": "6714603",
            "initDialog": "671460301",
            "dialogues": [
                {
                    "id": "671460301",
                    "speaker": "Player",
                    "text": "需要帮忙吗？我可以去问问。"
                },
                {
                    "id": "671460302",
                    "speaker": "托库沃",
                    "text": "啊，不用不用，千万不要！这里是愚人众的驻地，他们的修理耗材卖得很贵的，一瓶机油是外面的好几倍。我还是省省吧…"
                },
                {
                    "id": "671460303",
                    "speaker": "托库沃",
                    "text": "毕竟跑单就是为了赚钱，再跑个十几次来回，女儿结婚的钱应该就够了吧？唉，为了控制成本，不得不为难我的老伙计了！"
                },
                {
                    "id": "671460304",
                    "speaker": "托库沃",
                    "text": "多谢你，好心的年轻人。放心吧，我和「不掉漆号」是老搭档了，我知道她扛得住的。"
                }
            ]
        },
        {
            "talkId": "6714604",
            "initDialog": "671460401",
            "dialogues": [
                {
                    "id": "671460401",
                    "speaker": "Player",
                    "text": "请注意安全！"
                },
                {
                    "id": "671460402",
                    "speaker": "托库沃",
                    "text": "多谢！如果你知道什么好生意，请一定要介绍给我，我们不挑单！"
                }
            ]
        },
        {
            "talkId": "6714605",
            "initDialog": "671460501",
            "dialogues": [
                {
                    "id": "671460501",
                    "speaker": "Player",
                    "text": "这片海域还是很危险的…"
                },
                {
                    "id": "671460502",
                    "speaker": "托库沃",
                    "text": "我知道，不过我还知道，我的老伙计坚持得住。虽然冷却系统有些不中用了，但反正我们是在挪德卡莱嘛！"
                },
                {
                    "id": "671460503",
                    "speaker": "托库沃",
                    "text": "唉，都怪我，年轻时候过得太悠哉了。现在年纪大了，愈发觉得日子不等人。这次无论如何，都想给女儿一个像样的开始。"
                }
            ]
        }
    ]
}