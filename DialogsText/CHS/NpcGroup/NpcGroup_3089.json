{
    "groupId": "3089",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 7,
        "百合华": 25
    },
    "talks": [
        {
            "talkId": "4006310",
            "initDialog": "400631001",
            "dialogues": [
                {
                    "id": "400631001",
                    "speaker": "百合华",
                    "text": "客人你好，欢迎来到远国监司。"
                },
                {
                    "id": "400631002",
                    "speaker": "百合华",
                    "text": "这里可以登记「光华容彩祭」的同人作品摊位申请，也可以为嘉宾开通同行家属的证明，以便安排食宿。"
                },
                {
                    "id": "400631003",
                    "speaker": "百合华",
                    "text": "当然，平时的商店进驻许可证也仍在正常开放办理。"
                },
                {
                    "id": "400631004",
                    "speaker": "百合华",
                    "text": "还有就是…不要忘记「手续费」哦。"
                }
            ]
        },
        {
            "talkId": "6308901",
            "initDialog": "630890101",
            "dialogues": [
                {
                    "id": "630890101",
                    "speaker": "百合华",
                    "text": "你好，异国的来客，稻妻欢迎你，请在这边办理驻留许可证。"
                },
                {
                    "id": "630890102",
                    "speaker": "百合华",
                    "text": "还有就是…不要忘记「手续费」哦。"
                }
            ]
        },
        {
            "talkId": "6308902",
            "initDialog": "630890201",
            "dialogues": [
                {
                    "id": "630890201",
                    "speaker": "Player",
                    "text": "驻留许可证？"
                },
                {
                    "id": "630890202",
                    "speaker": "百合华",
                    "text": "根据稻妻现行的锁国令，异国的来客如果想要在离岛长期停留的话，需要办理驻留许可哦。"
                },
                {
                    "id": "630890203",
                    "speaker": "百合华",
                    "text": "在办理驻留手续之前，请事先准备好登岛许可证…以及其他所需的「材料」。"
                }
            ]
        },
        {
            "talkId": "6308903",
            "initDialog": "630890301",
            "dialogues": [
                {
                    "id": "630890301",
                    "speaker": "Player",
                    "text": "「手续费」？"
                },
                {
                    "id": "630890302",
                    "speaker": "百合华",
                    "text": "对哦，要办理业务的话，「手续费」是必不可少的。"
                },
                {
                    "id": "630890303",
                    "speaker": "百合华",
                    "text": "至于费用几何…那就得看阁下来稻妻的目的了。"
                },
                {
                    "id": "630890304",
                    "speaker": "百合华",
                    "text": "事情越重要、越紧急，我们「远国监司」自然就越上心，需要收取的费用也就要与之相匹配才对，不是吗。"
                }
            ]
        },
        {
            "talkId": "6308904",
            "initDialog": "630890401",
            "dialogues": [
                {
                    "id": "630890401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630890402",
                    "speaker": "百合华",
                    "text": "阁下慢走，请准备好所需的「材料」再来吧。"
                }
            ]
        },
        {
            "talkId": "6308905",
            "initDialog": "630890501",
            "dialogues": [
                {
                    "id": "630890501",
                    "speaker": "Player",
                    "text": "「手续费」？"
                },
                {
                    "id": "630890502",
                    "speaker": "百合华",
                    "text": "对哦，要办理业务的话，「手续费」是必不可少的。"
                },
                {
                    "id": "630890503",
                    "speaker": "百合华",
                    "text": "每位来客500摩拉。"
                },
                {
                    "id": "630890504",
                    "speaker": "百合华",
                    "text": "欸，很少吗？…呵呵，我还是第一次见到抱怨价格太低的人呢。"
                },
                {
                    "id": "630890505",
                    "speaker": "百合华",
                    "text": "但这的确是官方规定的费用哦。不信的话，烦请查阅勘定奉行颁布的最新规定。"
                }
            ]
        },
        {
            "talkId": "6308906",
            "initDialog": "630890601",
            "dialogues": [
                {
                    "id": "630890601",
                    "speaker": "百合华",
                    "text": "你好，异国的来客，稻妻欢迎你，请在这边办理进驻许可证。"
                },
                {
                    "id": "630890602",
                    "speaker": "百合华",
                    "text": "还有就是…不要忘记「手续费」哦。"
                }
            ]
        },
        {
            "talkId": "6308907",
            "initDialog": "630890701",
            "dialogues": [
                {
                    "id": "630890701",
                    "speaker": "Player",
                    "text": "进驻许可证？"
                },
                {
                    "id": "630890702",
                    "speaker": "百合华",
                    "text": "根据稻妻现行的规定，异国的商人如果想在离岛长期开店售货，需要办理进驻许可哦。"
                },
                {
                    "id": "630890703",
                    "speaker": "百合华",
                    "text": "在办理这类手续之前，请事先准备好身份登记证明…以及其他所需的「材料」。"
                }
            ]
        },
        {
            "talkId": "6308908",
            "initDialog": "630890801",
            "dialogues": [
                {
                    "id": "630890801",
                    "speaker": "Player",
                    "text": "「手续费」？"
                },
                {
                    "id": "630890802",
