{
    "groupId": "5102",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "维缪尔": 14
    },
    "talks": [
        {
            "talkId": "6510201",
            "initDialog": "651020101",
            "dialogues": [
                {
                    "id": "651020101",
                    "speaker": "维缪尔",
                    "text": "你好，有什么事吗？除了和演出有关的，我都可以帮忙。"
                }
            ]
        },
        {
            "talkId": "6510202",
            "initDialog": "651020201",
            "dialogues": [
                {
                    "id": "651020201",
                    "speaker": "Player",
                    "text": "演出有什么问题吗？"
                },
                {
                    "id": "651020202",
                    "speaker": "维缪尔",
                    "text": "不，没什么，只是我个人对歌剧、话剧、魔术之类的表演不感兴趣。"
                },
                {
                    "id": "651020203",
                    "speaker": "维缪尔",
                    "text": "说起来，我就是因为在被上级问到「喜欢看戏剧吗」时回答了「不喜欢」才被派来这里的。"
                },
                {
                    "id": "651020204",
                    "speaker": "维缪尔",
                    "text": "大概是不希望警备队员被那些演出和形似演出的审判分心吧，毕竟还是要专注于本职工作。"
                }
            ]
        },
        {
            "talkId": "6510203",
            "initDialog": "651020301",
            "dialogues": [
                {
                    "id": "651020301",
                    "speaker": "Player",
                    "text": "暂时不需要。"
                },
                {
                    "id": "651020302",
                    "speaker": "维缪尔",
                    "text": "好，再见。"
                }
            ]
        },
        {
            "talkId": "6510204",
            "initDialog": "651020401",
            "dialogues": [
                {
                    "id": "651020401",
                    "speaker": "Player",
                    "text": "演出有什么问题吗？"
                },
                {
                    "id": "651020402",
                    "speaker": "维缪尔",
                    "text": "不，没什么，只是我个人对歌剧、话剧、魔术之类的表演不感兴趣。"
                },
                {
                    "id": "651020403",
                    "speaker": "维缪尔",
                    "text": "说起来，我就是因为在被上级问到「喜欢看戏剧吗」时回答了「不喜欢」才被派来这里的。"
                },
                {
                    "id": "651020404",
                    "speaker": "维缪尔",
                    "text": "大概是不希望警备队员被那些演出和形似演出的审判分心吧，毕竟还是要专注于本职工作。"
                },
                {
                    "id": "651020405",
                    "speaker": "维缪尔",
                    "text": "不过现在这里对演出和庭审的宣传口吻变了不少，似乎是不想让大家再把它们混为一谈了。是好事吧，至少对我来说。"
                }
            ]
        },
        {
            "talkId": "7490001",
            "initDialog": "749000101",
            "dialogues": [
                {
                    "id": "749000101",
                    "speaker": "Player",
                    "text": "形似演出的审判？"
                },
                {
                    "id": "749000102",
                    "speaker": "维缪尔",
                    "text": "只是个比方。因为有水神大人在，审判过程中常常会插入一些像是会出现在戏剧中的说辞。"
                },
                {
                    "id": "749000103",
                    "speaker": "维缪尔",
                    "text": "但审判本身是没有问题的。依靠最高审判官大人和谕示机的公正裁决，每一场审判都会圆满完成。"
                }
            ]
        },
        {
            "talkId": "7490002",
            "initDialog": "749000201",
            "dialogues": [
                {
                    "id": "749000201",
                    "speaker": "Player",
                    "text": "这样啊…"
                },
                {
                    "id": "749000202",
                    "speaker": "维缪尔",
                    "text": "嗯，应该是因为芙宁娜大人离开了沫芒宫，也不再参与庭审了吧。"
                },
                {
                    "id": "749000203",
                    "speaker": "维缪尔",
                    "text": "啊，不小心又按照原来的习惯称呼芙宁娜大人了…唔，没什么所谓吧，芙宁娜大人确实为枫丹认真工作了几百年呢。"
                },
                {
                    "id": "749000204",
                    "speaker": "维缪尔",
                    "text": "不过即便她不在场，审判也不会有问题的，要相信审判官们的公正裁决啊。"
                }
            ]
        }
    ]
}