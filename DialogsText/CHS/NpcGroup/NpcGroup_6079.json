{
    "groupId": "6079",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "尼南": 7
    },
    "talks": [
        {
            "talkId": "6607901",
            "initDialog": "660790101",
            "dialogues": [
                {
                    "id": "660790101",
                    "speaker": "尼南",
                    "text": "「久疏问候」…「展信佳」…原来璃月人是这么写信的啊…"
                }
            ]
        },
        {
            "talkId": "6607902",
            "initDialog": "660790201",
            "dialogues": [
                {
                    "id": "660790201",
                    "speaker": "Player",
                    "text": "在学外语吗？"
                },
                {
                    "id": "660790202",
                    "speaker": "尼南",
                    "text": "哈哈，不算正式学习，只是为了满足好奇心。"
                },
                {
                    "id": "660790203",
                    "speaker": "尼南",
                    "text": "请别误会，我没有偷看客户的信件哦。我可都是正大光明地向他们咨询语言知识的。"
                },
                {
                    "id": "660790204",
                    "speaker": "尼南",
                    "text": "经常有来这里旅游的外国人，我自己又不太会离开纳塔，自然是要抓住机会，多向他们请教咯。"
                },
                {
                    "id": "660790205",
                    "speaker": "尼南",
                    "text": "作为回报，我也会教他们一些纳塔当地的语言习惯。"
                },
                {
                    "id": "660790206",
                    "speaker": "尼南",
                    "text": "用我们的语言帮外国人写下他们喜欢的祝福语，这种体验还挺奇妙的呢。"
                }
            ]
        },
        {
            "talkId": "6607903",
            "initDialog": "660790301",
            "dialogues": [
                {
                    "id": "660790301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "660790302",
                    "speaker": "尼南",
                    "text": "没关系，要寄信的话就来找我吧！也提供代写服务哦。"
                }
            ]
        }
    ]
}