{
    "groupId": "7011",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "克鲁切": 10
    },
    "talks": [
        {
            "talkId": "6701101",
            "initDialog": "670110101",
            "dialogues": [
                {
                    "id": "670110101",
                    "speaker": "克鲁切",
                    "text": "应招的人？先填写表格吧。"
                }
            ]
        },
        {
            "talkId": "6701102",
            "initDialog": "670110201",
            "dialogues": [
                {
                    "id": "670110201",
                    "speaker": "Player",
                    "text": "你们在招什么人？"
                },
                {
                    "id": "670110202",
                    "speaker": "克鲁切",
                    "text": "…能够完成我们委托的人，你要来试试吗？"
                }
            ]
        },
        {
            "talkId": "6701103",
            "initDialog": "670110301",
            "dialogues": [
                {
                    "id": "670110301",
                    "speaker": "Player",
                    "text": "不了，再见。"
                },
                {
                    "id": "670110302",
                    "speaker": "克鲁切",
                    "text": "再见，如果你有兴趣，随时来找我。"
                }
            ]
        },
        {
            "talkId": "6701104",
            "initDialog": "670110401",
            "dialogues": [
                {
                    "id": "670110401",
                    "speaker": "Player",
                    "text": "关于应招条件…"
                },
                {
                    "id": "670110402",
                    "speaker": "克鲁切",
                    "text": "我们招聘「能完成委托的人」，只要你能完成委托，就能拿到报酬…"
                },
                {
                    "id": "670110403",
                    "speaker": "克鲁切",
                    "text": "至于完成委托的方式，没有任何限制。"
                }
            ]
        },
        {
            "talkId": "6701105",
            "initDialog": "670110501",
            "dialogues": [
                {
                    "id": "670110501",
                    "speaker": "克鲁切",
                    "text": "关于酬劳保障…"
                },
                {
                    "id": "670110502",
                    "speaker": "克鲁切",
                    "text": "…暂时没有相关的通知有提到这一点。"
                },
                {
                    "id": "670110503",
                    "speaker": "克鲁切",
                    "text": "不过最终每个完成委托的人都得到了他应有的酬劳…只要他们能完成委托并活着回来。"
                }
            ]
        },
        {
            "talkId": "6701106",
            "initDialog": "670110601",
            "dialogues": [
                {
                    "id": "670110601",
                    "speaker": "Player",
                    "text": "关于委托方…"
                },
                {
                    "id": "670110602",
                    "speaker": "克鲁切",
                    "text": "我代表愚人众一方来与你签订短期的合同，期间所有的事务都由我与你对接。"
                },
                {
                    "id": "670110603",
                    "speaker": "克鲁切",
                    "text": "合同效力对于双方的约束仅在委托存续期内有效，并且不会影响你除此委托以外的其他事务。"
                }
            ]
        }
    ]
}