{
    "groupId": "2121",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "振翔": 12
    },
    "talks": [
        {
            "talkId": "6212101",
            "initDialog": "621210101",
            "dialogues": [
                {
                    "id": "621210101",
                    "speaker": "振翔",
                    "text": "您好，请接受检查。"
                }
            ]
        },
        {
            "talkId": "6212102",
            "initDialog": "621210201",
            "dialogues": [
                {
                    "id": "621210201",
                    "speaker": "Player",
                    "text": "检查？"
                },
                {
                    "id": "621210202",
                    "speaker": "振翔",
                    "text": "接到「七星」的直属命令，要求我们在此盘查有没有可疑人士。"
                },
                {
                    "id": "621210203",
                    "speaker": "振翔",
                    "text": "如果没有问题的话，我和我的千岩军同伴自然是不会为难你们的。",
                    "choices": [
                        {
                            "id": "621210204",
                            "text": "你的同伴为什么在偷懒？",
                            "response": [
                                {
                                    "id": "621210205",
                                    "speaker": "振翔",
                                    "text": "他并不是在偷懒，他是在休养生息。"
                                },
                                {
                                    "id": "621210206",
                                    "speaker": "振翔",
                                    "text": "因为他比我厉害多了，他会看相，能一眼看出谁是坏人，而我只能挨个盘问。"
                                },
                                {
                                    "id": "621210207",
                                    "speaker": "振翔",
                                    "text": "不过多亏他的本事，最近安定了不少。"
                                },
                                {
                                    "id": "621210208",
                                    "speaker": "振翔",
                                    "text": "我要是有他那样的本事就好了…"
                                }
                            ]
                        },
                        {
                            "id": "621210209",
                            "text": "为什么只有你在工作？",
                            "response": [
                                {
                                    "id": "621210210",
                                    "speaker": "振翔",
                                    "text": "我的同伴他会看相之术，而且准得很。"
                                },
                                {
                                    "id": "621210211",
                                    "speaker": "振翔",
                                    "text": "他上次帮我看，说只要我认真工作，并且积极帮助同伴，事业就一定会蒸蒸日上的。"
                                },
                                {
                                    "id": "621210212",
                                    "speaker": "振翔",
                                    "text": "所以我替他站岗也算帮助同伴了对吧？这么认真工作的我一定会有好报的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6212103",
            "initDialog": "621210301",
            "dialogues": [
                {
                    "id": "621210301",
                    "speaker": "Player",
                    "text": "我可以走了吗？"
                },
                {
                    "id": "621210302",
                    "speaker": "振翔",
                    "text": "唔…确实不在缉拿名单里。"
                },
                {
                    "id": "621210303",
                    "speaker": "振翔",
                    "text": "千岩牢固，重嶂不移。感谢您的配合。"
                }
            ]
        }
    ]
}