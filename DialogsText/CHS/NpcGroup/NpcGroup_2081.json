{
    "groupId": "2081",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 1,
        "苏二娘": 21
    },
    "talks": [
        {
            "talkId": "7190601",
            "initDialog": "719060101",
            "dialogues": [
                {
                    "id": "719060101",
                    "speaker": "Player",
                    "text": "内脏…？"
                },
                {
                    "id": "719060102",
                    "speaker": "苏二娘",
                    "text": "放心吧，都是经过处理的，干净得很！"
                },
                {
                    "id": "719060103",
                    "speaker": "苏二娘",
                    "text": "有些顾客啊，以前从来不吃内脏之类的，自从尝了一口之后就喜欢上了这个味道！"
                },
                {
                    "id": "719060104",
                    "speaker": "苏二娘",
                    "text": "要不你尝尝吧，不要钱的，觉得好吃就再来买些呀！"
                }
            ]
        },
        {
            "talkId": "6208101",
            "initDialog": "620810101",
            "dialogues": [
                {
                    "id": "620810101",
                    "speaker": "苏二娘",
                    "text": "刚出炉的中原杂碎，好吃得很！"
                },
                {
                    "id": "620810102",
                    "speaker": "苏二娘",
                    "text": "除了某个呆子外，没人说不好吃！"
                }
            ]
        },
        {
            "talkId": "6208102",
            "initDialog": "620810201",
            "dialogues": [
                {
                    "id": "620810201",
                    "speaker": "苏二娘",
                    "text": "我想买些小吃。"
                },
                {
                    "id": "620810202",
                    "speaker": "苏二娘",
                    "text": "来，都是刚出炉的，热乎得很！"
                }
            ]
        },
        {
            "talkId": "6208103",
            "initDialog": "620810301",
            "dialogues": [
                {
                    "id": "620810301",
                    "speaker": "苏二娘",
                    "text": "杂碎…？"
                },
                {
                    "id": "620810302",
                    "speaker": "苏二娘",
                    "text": "您可别误会了，大姐我可不是在骂人呀！"
                },
                {
                    "id": "620810303",
                    "speaker": "苏二娘",
                    "text": "这「中原杂碎」是我们吃虎岩的特色小吃。"
                },
                {
                    "id": "620810304",
                    "speaker": "苏二娘",
                    "text": "实际就是用动物内脏下水弄成肉泥，再加入吃虎鱼的鱼胶还有淀粉以及几种辅料做成的肉丸子。"
                },
                {
                    "id": "620810305",
                    "speaker": "苏二娘",
                    "text": "油炸一下之后可好吃了，一点腥味儿都没有，香得很！"
                },
                {
                    "id": "620810306",
                    "speaker": "苏二娘",
                    "text": "不过总要跟外来人解释这个名字不是在骂人，麻烦得很！"
                }
            ]
        },
        {
            "talkId": "6208104",
            "initDialog": "620810401",
            "dialogues": [
                {
                    "id": "620810401",
                    "speaker": "苏二娘",
                    "text": "呆子？"
                },
                {
                    "id": "620810402",
                    "speaker": "苏二娘",
                    "text": "还能是谁，就是那个仓库管理员狗三儿呗！"
                },
                {
                    "id": "620810403",
                    "speaker": "苏二娘",
                    "text": "大姐我早上辛辛苦苦做好了料理，看他一个人看仓库挺累的就给他分了点…"
                },
                {
                    "id": "620810404",
                    "speaker": "苏二娘",
                    "text": "他吃完，我问他好吃不好吃，结果他说食物只要有咸味和辣味就行了！"
                },
                {
                    "id": "620810405",
                    "speaker": "苏二娘",
                    "text": "客官，你听听这是人话吗！亏大姐我好心给他吃的！"
                },
                {
                    "id": "620810406",
                    "speaker": "苏二娘",
                    "text": "不行！越想越气，我一定要好好调教一下他的料理观！"
                }
            ]
        },
        {
            "talkId": "6208105",
            "initDialog": "620810501",
            "dialogues": [
                {
                    "id": "620810501",
                    "speaker": "苏二娘",
                    "text": "再见。"
                },
                {
                    "id": "620810502",
                    "speaker": "苏二娘",
                    "text": "下次喊上朋友再来呀，大姐给你优惠呀！"
                }
            ]
        }
    ]
}