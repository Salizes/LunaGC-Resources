{
    "groupId": "7025",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "哈沃": 10
    },
    "talks": [
        {
            "talkId": "6702501",
            "initDialog": "670250101",
            "dialogues": [
                {
                    "id": "670250101",
                    "speaker": "哈沃",
                    "text": "什么狗屁海螺帮，我才不稀罕呢，哼…"
                }
            ]
        },
        {
            "talkId": "6702502",
            "initDialog": "670250201",
            "dialogues": [
                {
                    "id": "670250201",
                    "speaker": "Player",
                    "text": "我就是海螺帮的成员，羡慕吗？"
                },
                {
                    "id": "670250202",
                    "speaker": "哈沃",
                    "text": "哈？怎、怎么可能！少骗人了，海螺帮才不是那么容易加入的…不对，我是说，你跟我说这个干什么！"
                },
                {
                    "id": "670250203",
                    "speaker": "哈沃",
                    "text": "海螺帮什么的，关我什么事…"
                }
            ]
        },
        {
            "talkId": "6702503",
            "initDialog": "670250301",
            "dialogues": [
                {
                    "id": "670250301",
                    "speaker": "Player",
                    "text": "你跟他们有矛盾吗？"
                },
                {
                    "id": "670250302",
                    "speaker": "哈沃",
                    "text": "矛盾？什么是矛盾？"
                },
                {
                    "id": "670250303",
                    "speaker": "哈沃",
                    "text": "…哦，如果是说打架，那是打过的。不过就是这点小事，至于搞得那么认真吗？力气大又不是我的错，是他们太软弱了！"
                },
                {
                    "id": "670250304",
                    "speaker": "哈沃",
                    "text": "都是因为他们还不知道我有多厉害，等他们知道了…我也不会那么简单原谅他们的，谁让他们有错在先，哼。"
                }
            ]
        },
        {
            "talkId": "6702504",
            "initDialog": "670250401",
            "dialogues": [
                {
                    "id": "670250401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "670250402",
                    "speaker": "哈沃",
                    "text": "哦。"
                }
            ]
        },
        {
            "talkId": "6702505",
            "initDialog": "670250501",
            "dialogues": [
                {
                    "id": "670250501",
                    "speaker": "哈沃",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6702506",
            "initDialog": "670250601",
            "dialogues": [
                {
                    "id": "670250601",
                    "speaker": "哈沃",
                    "text": "哈哈，我赢了！不愧是我！"
                }
            ]
        },
        {
            "talkId": "6702507",
            "initDialog": "670250701",
            "dialogues": [
                {
                    "id": "670250701",
                    "speaker": "哈沃",
                    "text": "怎、怎么可能！可恶，一定是你耍赖了！再来一把！"
                }
            ]
        }
    ]
}