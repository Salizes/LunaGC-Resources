{
    "groupId": "9048",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 19,
        "烟绯": 45
    },
    "talks": [
        {
            "talkId": "6904801",
            "initDialog": "690480101",
            "dialogues": [
                {
                    "id": "690480101",
                    "speaker": "烟绯",
                    "text": "#{NICKNAME}，哎呀，稀客呀，你好你好。"
                },
                {
                    "id": "690480102",
                    "speaker": "烟绯",
                    "text": "一看你的表情就没遇上什么糟心事，好吧，没摩拉赚了。"
                }
            ]
        },
        {
            "talkId": "6904802",
            "initDialog": "690480201",
            "dialogues": [
                {
                    "id": "690480201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690480202",
                    "speaker": "烟绯",
                    "text": "习惯习惯。好得很。"
                },
                {
                    "id": "690480203",
                    "speaker": "烟绯",
                    "text": "你是不是忘了，我对这种「外景」之能早有耳闻。",
                    "choices": [
                        {
                            "id": "690480204",
                            "text": "那烟绯也能创造一个自己的家园吗。",
                            "response": [
                                {
                                    "id": "690480205",
                                    "speaker": "烟绯",
                                    "text": "这个…稍微有一点…"
                                },
                                {
                                    "id": "690480206",
                                    "speaker": "烟绯",
                                    "text": "不属于我的强项！"
                                },
                                {
                                    "id": "690480207",
                                    "speaker": "烟绯",
                                    "text": "而且我已经住在这里了，就不需要考虑多余的了。"
                                },
                                {
                                    "id": "690480211",
                                    "speaker": "烟绯",
                                    "text": "与其操心我，还不如多操心操心你自己哦。"
                                }
                            ]
                        },
                        {
                            "id": "690480208",
                            "text": "那烟绯大仙有什么指教吗？",
                            "response": [
                                {
                                    "id": "690480209",
                                    "speaker": "烟绯",
                                    "text": "嗯，嗯。依我之见，应该开辟专门的几间屋子用于存放法典。"
                                },
                                {
                                    "id": "690480210",
                                    "speaker": "烟绯",
                                    "text": "不过你的家，「规则」是应该由你来定的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904803",
            "initDialog": "690480301",
            "dialogues": [
                {
                    "id": "690480301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690480302",
                    "speaker": "烟绯",
                    "text": "好啊，聊天聊天！不过我一旦打开了话匣子那话就要收不住了。"
                },
                {
                    "id": "690480303",
                    "speaker": "烟绯",
                    "text": "你不是话一直比较少嘛。对你来说不会太「闹腾」了吗？",
                    "choices": [
                        {
                            "id": "690480304",
                            "text": "不会…",
                            "response": [
                                {
                                    "id": "690480305",
                                    "speaker": "烟绯",
                                    "text": "唔…不会就好。"
                                },
                                {
                                    "id": "690480306",
                                    "speaker": "烟绯",
                                    "text": "不知道为什么，听到你这样说，心里还挺开心的。"
                                },
                                {
                                    "id": "690480307",
                                    "speaker": "烟绯",
                                    "text": "既然这样，你来选择话题吧。"
                                },
                                {
                                    "id": "690480312",
                                    "speaker": "Player",
                                    "text": "那么…聊聊难对付的客户吧。"
                                },
                                {
                                    "id": "690480313",
                                    "speaker": "烟绯",
                                    "text": "欸，我有那么多有趣的事情，你偏偏要问扫兴的话题。",
                                    "choices": [
                                        {
                                            "id": "690480314",
                                            "text": "因为大多数情况烟绯都应付得来。",
                                            "response": [
                                                {
                                                    "id": "690480316",
                                                    "speaker": "烟绯",
                                                    "text": "原，原来你是这样想的。"
                                                },
                                                {
                                                    "id": "690480317",
                                                    "speaker": "烟绯",
                                                    "text": "谢谢你…"
                                                },
                                                {
                                                    "id": "690480318",
                                                    "speaker": "烟绯",
                                                    "text": "咳咳，那我就跟你说说，上次那个来咨询民事案件的客户…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690480315",
                                            "text": "问这个才能帮烟绯解决问题。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690480308",
                            "text": "我听就好。",
                            "response": [
                                {
                                    "id": "690480309",
                                    "speaker": "烟绯",
                                    "text": "欸——只是听啊。"
                                },
                                {
                                    "id": "690480310",
                                    "speaker": "烟绯",
                                    "text": "聊天聊天，一来一往才叫聊天。"
                                },
                                {
                                    "id": "690480311",
                                    "speaker": "烟绯",
                                    "text": "我又不是说书人。我已经选到了我最喜欢的工作，这辈子也不会成为说书人了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904804",
            "initDialog": "690480401",
            "dialogues": [
                {
                    "id": "690480401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690480402",
                    "speaker": "烟绯",
                    "text": "我想想…要不要一起去钓鱼。"
                },
                {
                    "id": "690480403",
                    "speaker": "烟绯",
                    "text": "我和你，不带其他人，连那个小家伙都不带。"
                },
                {
                    "id": "690480404",
                    "speaker": "烟绯",
                    "text": "理由嘛…你肯定要问我理由对不对。"
                },
                {
                    "id": "690480405",
                    "speaker": "烟绯",
                    "text": "一个人钓鱼很没劲。鱼钓得再多，最多也就回去跟姥姥分分。"
                },
                {
                    "id": "690480406",
                    "speaker": "烟绯",
                    "text": "和客户、朋友去的话，你知道的，我不能发挥自己的真正实力。"
                },
                {
                    "id": "690480407",
                    "speaker": "烟绯",
                    "text": "怎么想，都只有你才是合适的人选。",
                    "choices": [
                        {
                            "id": "690480408",
                            "text": "有种被挑剩下来的感觉…",
                            "response": [
                                {
                                    "id": "690480410",
                                    "speaker": "烟绯",
                                    "text": "不，不是的！"
                                },
                                {
                                    "id": "690480411",
                                    "speaker": "烟绯",
                                    "text": "哎呀，我就是想和你两个人出去嘛。"
                                },
                                {
                                    "id": "690480412",
                                    "speaker": "烟绯",
                                    "text": "安安静静、不被打扰的，享受两个人的时光…"
                                },
                                {
                                    "id": "690480413",
                                    "speaker": "烟绯",
                                    "text": "也让你看看我本职工作以外厉害的一面…",
                                    "choices": [
                                        {
                                            "id": "690480414",
                                            "text": "我一直都认可着烟绯。",
                                            "response": [
                                                {
                                                    "id": "690480415",
                                                    "speaker": "烟绯",
                                                    "text": "什么嘛…"
                                                },
                                                {
                                                    "id": "690480418",
                                                    "speaker": "烟绯",
                                                    "text": "那我们就说好了！这是我和你之间的…重要的「契约」哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690480416",
                                            "text": "但钓鱼我也是很在行的。",
                                            "response": [
                                                {
                                                    "id": "690480417",
                                                    "speaker": "烟绯",
                                                    "text": "哦？你这样说的话…我可是更来劲了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690480409",
                            "text": "感觉是现编的…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904805",
            "initDialog": "690480501",
            "dialogues": [
                {
                    "id": "690480501",
                    "speaker": "Player",
                    "text": "早啊，烟绯。"
                },
                {
                    "id": "690480502",
                    "speaker": "烟绯",
                    "text": "嗯——早——"
                },
                {
                    "id": "690480503",
                    "speaker": "烟绯",
                    "text": "你要像我一样快快活活哦，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6904806",
            "initDialog": "690480601",
            "dialogues": [
                {
                    "id": "690480601",
                    "speaker": "Player",
                    "text": "晚安，烟绯。"
                },
                {
                    "id": "690480602",
                    "speaker": "烟绯",
                    "text": "#晚安啦晚安啦，{NICKNAME}。"
                },
                {
                    "id": "690480603",
                    "speaker": "烟绯",
                    "text": "要是晚上做梦梦见了律法的漏洞，记得要来告诉我！"
                }
            ]
        },
        {
            "talkId": "6904807",
            "initDialog": "690480701",
            "dialogues": [
                {
                    "id": "690480701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904808",
            "initDialog": "690480801",
            "dialogues": [
                {
                    "id": "690480801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904809",
            "initDialog": "690480901",
            "dialogues": [
                {
                    "id": "690480901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904850",
            "initDialog": "690485001",
            "dialogues": [
                {
                    "id": "690485001",
                    "speaker": "烟绯",
                    "text": "没想到你对家居装潢也有造诣，这间卧室相当得体。"
                },
                {
                    "id": "690485002",
                    "speaker": "烟绯",
                    "text": "说起来，各式器物的价格，都有货比三家吗？雇佣工匠的费用，确认是公道的市场价吗？"
                },
                {
                    "id": "690485003",
                    "speaker": "烟绯",
                    "text": "下次选购家具时记得叫上我，我会帮你严格把关的，防止你在意想不到的地方吃亏。"
                }
            ]
        },
        {
            "talkId": "6904851",
            "initDialog": "690485101",
            "dialogues": [
                {
                    "id": "690485101",
                    "speaker": "烟绯",
                    "text": "这片商业街坊，哪怕接受节庆时候的客流，也不会出现运转的差池。"
                },
                {
                    "id": "690485102",
                    "speaker": "烟绯",
                    "text": "看得出来，你下了不少功夫。"
                },
                {
                    "id": "690485103",
                    "speaker": "烟绯",
                    "text": "你有引入更多商铺的打算吗？我可以给你律法支援哦。"
                }
            ]
        }
    ]
}