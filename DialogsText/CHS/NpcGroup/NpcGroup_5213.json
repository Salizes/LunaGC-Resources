{
    "groupId": "5213",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 6,
        "嘉维娜": 9
    },
    "talks": [
        {
            "talkId": "6521301",
            "initDialog": "652130101",
            "dialogues": [
                {
                    "id": "652130101",
                    "speaker": "嘉维娜",
                    "text": "嗯？遇到麻烦了吗？"
                }
            ]
        },
        {
            "talkId": "6521302",
            "initDialog": "652130201",
            "dialogues": [
                {
                    "id": "652130201",
                    "speaker": "Player",
                    "text": "关于海蚀裂隙…"
                },
                {
                    "id": "652130202",
                    "speaker": "嘉维娜",
                    "text": "唔，的确是个安全隐患，从各方面来说。你也觉得那边彻底封上比较安全吧？"
                }
            ]
        },
        {
            "talkId": "6521303",
            "initDialog": "652130301",
            "dialogues": [
                {
                    "id": "652130301",
                    "speaker": "Player",
                    "text": "关于探照灯…"
                },
                {
                    "id": "652130302",
                    "speaker": "嘉维娜",
                    "text": "也许是储能装置安装在探照灯内部的缘故，感觉探照灯的故障率也挺高的。"
                },
                {
                    "id": "652130303",
                    "speaker": "嘉维娜",
                    "text": "还是说，是大家没有按照规范使用探照灯，所以故障率才这么高呢？"
                }
            ]
        },
        {
            "talkId": "6521304",
            "initDialog": "652130401",
            "dialogues": [
                {
                    "id": "652130401",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "652130402",
                    "speaker": "嘉维娜",
                    "text": "没事就好。再见。"
                }
            ]
        },
        {
            "talkId": "6521305",
            "initDialog": "652130501",
            "dialogues": [
                {
                    "id": "652130501",
                    "speaker": "Player",
                    "text": "我没这么说。"
                },
                {
                    "id": "652130502",
                    "speaker": "嘉维娜",
                    "text": "嗯，说起来也是一块不小的空间，如果能利用起来就好了…"
                }
            ]
        },
        {
            "talkId": "6521306",
            "initDialog": "652130601",
            "dialogues": [
                {
                    "id": "652130601",
                    "speaker": "Player",
                    "text": "我支持把所有出入口全都封死。"
                },
                {
                    "id": "652130602",
                    "speaker": "嘉维娜",
                    "text": "所有出入口全都封死？这、这也太激进了吧…没想到你会提出这样的主张，真是人不可貌相…"
                }
            ]
        },
        {
            "talkId": "7493801",
            "initDialog": "749380101",
            "dialogues": [
                {
                    "id": "749380101",
                    "speaker": "Player",
                    "text": "和你长得一样的人…"
                },
                {
                    "id": "749380102",
                    "speaker": "嘉维娜",
                    "text": "你见过嘉维娅啦？她是我妹妹，我们是双胞胎。咳，年纪也不小了，还老是「姐姐」、「姐姐」挂在嘴边，真不害臊…"
                },
                {
                    "id": "749380103",
                    "speaker": "嘉维娜",
                    "text": "啊，别误会，我不是讨厌她，只是…这里是工作的地方，在工作时间，还是要严肃一点！"
                }
            ]
        }
    ]
}