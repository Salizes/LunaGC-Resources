{
    "groupId": "4087",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "法伽尼": 14
    },
    "talks": [
        {
            "talkId": "6408701",
            "initDialog": "640870101",
            "dialogues": [
                {
                    "id": "640870101",
                    "speaker": "法伽尼",
                    "text": "为什么每次计算到这里，都会出现无可避免的误差呢…"
                }
            ]
        },
        {
            "talkId": "6408702",
            "initDialog": "640870201",
            "dialogues": [
                {
                    "id": "640870201",
                    "speaker": "Player",
                    "text": "你在计算什么？"
                },
                {
                    "id": "640870202",
                    "speaker": "法伽尼",
                    "text": "在回答你的问题之前，我想让你先思考另一个问题：你认为，提瓦特大陆是什么样的？"
                },
                {
                    "id": "640870203",
                    "speaker": "法伽尼",
                    "text": "不用回答我，只需思考即可。"
                },
                {
                    "id": "640870204",
                    "speaker": "法伽尼",
                    "text": "我啊，可是有一种全新的观点——如果提瓦特大陆是球形的，是不是就可以解释很多问题了呢？"
                },
                {
                    "id": "640870205",
                    "speaker": "法伽尼",
                    "text": "为何海洋会有流向？为何日月会交替升起？为何气温会发生变化？"
                },
                {
                    "id": "640870206",
                    "speaker": "法伽尼",
                    "text": "这些，都可以用球体大陆来完美解释！"
                }
            ]
        },
        {
            "talkId": "6408703",
            "initDialog": "640870301",
            "dialogues": [
                {
                    "id": "640870301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640870302",
                    "speaker": "法伽尼",
                    "text": "究竟是哪里出了问题呢…"
                }
            ]
        },
        {
            "talkId": "6408704",
            "initDialog": "640870401",
            "dialogues": [
                {
                    "id": "640870401",
                    "speaker": "Player",
                    "text": "那误差是？"
                },
                {
                    "id": "640870402",
                    "speaker": "法伽尼",
                    "text": "唉，这就是问题所在了。"
                },
                {
                    "id": "640870403",
                    "speaker": "法伽尼",
                    "text": "我的理论明明是完美的，但一计算球体表面的横纵线，就会有对不上的数据…"
                },
                {
                    "id": "640870404",
                    "speaker": "法伽尼",
                    "text": "该死，我以前学基础课时要是不逃掉那些数学课就好了！都怪维克拉姆！"
                }
            ]
        },
        {
            "talkId": "6408705",
            "initDialog": "640870501",
            "dialogues": [
                {
                    "id": "640870501",
                    "speaker": "Player",
                    "text": "为什么怪他？"
                },
                {
                    "id": "640870502",
                    "speaker": "法伽尼",
                    "text": "那当然是因为是他约我一起逃课的呀，碰到无聊的课，就跑到下城区喝咖啡。"
                },
                {
                    "id": "640870503",
                    "speaker": "法伽尼",
                    "text": "结果那家伙的基础课成绩却还出奇的好，我都怀疑他是故意拉我逃课，自己在夜里看书。"
                },
                {
                    "id": "640870504",
                    "speaker": "法伽尼",
                    "text": "唉，时间过得真快，没想到他现在都是大掌书的候选人了。"
                },
                {
                    "id": "640870505",
                    "speaker": "法伽尼",
                    "text": "希望他能够当选，这样我就能和人讲，当年我和大掌书一起逃过课。"
                }
            ]
        }
    ]
}