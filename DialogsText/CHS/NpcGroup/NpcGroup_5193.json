{
    "groupId": "5193",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "阿芙颂": 8
    },
    "talks": [
        {
            "talkId": "6519301",
            "initDialog": "651930101",
            "dialogues": [
                {
                    "id": "651930101",
                    "speaker": "阿芙颂",
                    "text": "这人到底讲不讲理？入港出港花那么长时间，我们就得干等着？"
                }
            ]
        },
        {
            "talkId": "6519302",
            "initDialog": "651930201",
            "dialogues": [
                {
                    "id": "651930201",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "651930202",
                    "speaker": "阿芙颂",
                    "text": "别提了，我真是受不了那个船长了。每次入港卸货和出港的时候，都要花上比别人多几倍的时间。"
                },
                {
                    "id": "651930203",
                    "speaker": "阿芙颂",
                    "text": "他还非说什么，茶叶是特殊货物，必须轻拿轻放，多花点时间也是没办法的事…"
                },
                {
                    "id": "651930204",
                    "speaker": "阿芙颂",
                    "text": "如果这件事真的是那么正当，那他怎么偷偷摸摸地在给港口的工作人员塞茶叶呢？哼…"
                },
                {
                    "id": "651930205",
                    "speaker": "阿芙颂",
                    "text": "下一次，我非要给他点颜色看看不可！"
                }
            ]
        },
        {
            "talkId": "6519303",
            "initDialog": "651930301",
            "dialogues": [
                {
                    "id": "651930301",
                    "speaker": "Player",
                    "text": "再、再见！"
                },
                {
                    "id": "651930302",
                    "speaker": "阿芙颂",
                    "text": "真是烦死我了，这个不讲理的家伙。"
                }
            ]
        },
        {
            "talkId": "6519304",
            "initDialog": "651930401",
            "dialogues": [
                {
                    "id": "651930401",
                    "speaker": "Player",
                    "text": "你要怎么给他颜色看？"
                },
                {
                    "id": "651930402",
                    "speaker": "阿芙颂",
                    "text": "我…呃…我要多载点香料过来卖！"
                },
                {
                    "id": "651930403",
                    "speaker": "阿芙颂",
                    "text": "他说我不懂茶叶，我还说他不懂香料呢，到时候看看，到底是他的茶叶卖得好，还是我的香料更受欢迎。"
                }
            ]
        }
    ]
}