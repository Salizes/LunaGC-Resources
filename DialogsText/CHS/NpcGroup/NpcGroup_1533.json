{
    "groupId": "1533",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "特纳": 11
    },
    "talks": [
        {
            "talkId": "6153301",
            "initDialog": "615330101",
            "dialogues": [
                {
                    "id": "615330101",
                    "speaker": "特纳",
                    "text": "你好，客人。我儿子有没有从你那儿带来什么口信儿？"
                }
            ]
        },
        {
            "talkId": "6153304",
            "initDialog": "615330401",
            "dialogues": [
                {
                    "id": "615330401",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615330402",
                    "speaker": "特纳",
                    "text": "我啊？酒庄里的伙计们都叫我老特纳，是这晨曦酒庄的农夫。"
                },
                {
                    "id": "615330403",
                    "speaker": "特纳",
                    "text": "我们家祖祖辈辈都在耕这块地，如果你在这儿尝到过什么好葡萄酒，我敢说十有八九是这地里的葡萄酿的。"
                },
                {
                    "id": "615330404",
                    "speaker": "特纳",
                    "text": "所以这酒庄历代的大老板，总是待我们家不薄，少不了吃的穿的。"
                },
                {
                    "id": "615330405",
                    "speaker": "特纳",
                    "text": "可想到子子孙孙也都要这么种一辈子田，好像也不是什么好事…"
                }
            ]
        },
        {
            "talkId": "6153305",
            "initDialog": "615330501",
            "dialogues": [
                {
                    "id": "615330501",
                    "speaker": "Player",
                    "text": "你的儿子？"
                },
                {
                    "id": "615330502",
                    "speaker": "特纳",
                    "text": "盖伊！他叫盖伊，我的宝贝儿子！"
                },
                {
                    "id": "615330503",
                    "speaker": "特纳",
                    "text": "什么？你没听说过这名字？哈哈，没关系，你迟早会知道他的，全蒙德都会知道他的…"
                },
                {
                    "id": "615330504",
                    "speaker": "特纳",
                    "text": "他会成为全蒙德最优秀的西风骑士，他就是这么跟我说的，我当然相信自己的儿子。"
                },
                {
                    "id": "615330505",
                    "speaker": "特纳",
                    "text": "唉，想想他小时候，为了不让他也像我这样种一辈子田，我可把全部心血都花在他身上啦。"
                },
                {
                    "id": "615330506",
                    "speaker": "特纳",
                    "text": "不过这小子果然很争气，十六岁就当上了见习骑士，我们家就要靠他翻身了…"
                }
            ]
        },
        {
            "talkId": "6153306",
            "initDialog": "615330601",
            "dialogues": [
                {
                    "id": "615330601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615330602",
                    "speaker": "特纳",
                    "text": "再见，如果见到我儿子盖伊，帮我跟他说，让他有空回来看看~！"
                }
            ]
        }
    ]
}