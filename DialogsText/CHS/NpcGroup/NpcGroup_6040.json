{
    "groupId": "6040",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "西帕克": 8
    },
    "talks": [
        {
            "talkId": "6604001",
            "initDialog": "660400101",
            "dialogues": [
                {
                    "id": "660400101",
                    "speaker": "西帕克",
                    "text": "你好你好，要不要吃点什么？可以边逛集市边吃，也可以拿着去看比赛，很方便的哦。"
                }
            ]
        },
        {
            "talkId": "6604002",
            "initDialog": "660400201",
            "dialogues": [
                {
                    "id": "660400201",
                    "speaker": "Player",
                    "text": "确实有点饿了。"
                },
                {
                    "id": "660400202",
                    "speaker": "西帕克",
                    "text": "嘿嘿，这里是菜单。"
                }
            ]
        },
        {
            "talkId": "6604003",
            "initDialog": "660400301",
            "dialogues": [
                {
                    "id": "660400301",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "660400302",
                    "speaker": "西帕克",
                    "text": "不错，但还不是最好的。"
                },
                {
                    "id": "660400303",
                    "speaker": "西帕克",
                    "text": "毕竟现在没有比赛嘛。归火圣夜巡礼时才是最热闹的，每个人都往竞技场跑，手里拿着小吃或者冷饮。"
                },
                {
                    "id": "660400304",
                    "speaker": "西帕克",
                    "text": "你要是看比赛时饿了，就去找那个叫阿格莫的小伙子。"
                },
                {
                    "id": "660400305",
                    "speaker": "西帕克",
                    "text": "他是悬木人部族的，大概这么高…唉，说起来他到底跑哪去了？"
                },
                {
                    "id": "660400306",
                    "speaker": "西帕克",
                    "text": "反正，他动作很快。一定能趁热，或者趁冷把东西送到你手上，绝不丢失半点风味！"
                }
            ]
        },
        {
            "talkId": "6604004",
            "initDialog": "660400401",
            "dialogues": [
                {
                    "id": "660400401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660400402",
                    "speaker": "西帕克",
                    "text": "下次再来啊！"
                }
            ]
        }
    ]
}