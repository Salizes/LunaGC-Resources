{
    "groupId": "4071",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "扎卡里亚": 6
    },
    "talks": [
        {
            "talkId": "6407101",
            "initDialog": "640710101",
            "dialogues": [
                {
                    "id": "640710101",
                    "speaker": "扎卡里亚",
                    "text": "你好，请问有什么需要帮助的吗？"
                }
            ]
        },
        {
            "talkId": "6407102",
            "initDialog": "640710201",
            "dialogues": [
                {
                    "id": "640710201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "640710202",
                    "speaker": "扎卡里亚",
                    "text": "「健康之家」是教令院向民众提供免费医疗的地方，医师们也都是从属于教令院的学者或学生。"
                },
                {
                    "id": "640710203",
                    "speaker": "扎卡里亚",
                    "text": "无论身份如何，所有人都可以在这里沐浴「治愈之术」的光芒。"
                },
                {
                    "id": "640710204",
                    "speaker": "扎卡里亚",
                    "text": "「治愈之术」是贤者大人们在神的指引下干涉生命枯荣循环之理的结果。"
                },
                {
                    "id": "640710205",
                    "speaker": "扎卡里亚",
                    "text": "——至少，我们的医师手册上是这么写的。"
                }
            ]
        },
        {
            "talkId": "6407103",
            "initDialog": "640710301",
            "dialogues": [
                {
                    "id": "640710301",
                    "speaker": "Player",
                    "text": "暂时不用。"
                },
                {
                    "id": "640710302",
                    "speaker": "扎卡里亚",
                    "text": "祝你身体健康。"
                }
            ]
        }
    ]
}