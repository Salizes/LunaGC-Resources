{
    "groupId": "5014",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "帕班": 16
    },
    "talks": [
        {
            "talkId": "6501401",
            "initDialog": "650140101",
            "dialogues": [
                {
                    "id": "650140101",
                    "speaker": "帕班",
                    "text": "听者落泪的爱恨情仇，层层反转的精彩审判，今天的《蒸汽鸟报》又有大新闻！"
                }
            ]
        },
        {
            "talkId": "6501402",
            "initDialog": "650140201",
            "dialogues": [
                {
                    "id": "650140201",
                    "speaker": "Player",
                    "text": "有什么新闻？"
                },
                {
                    "id": "650140202",
                    "speaker": "帕班",
                    "text": "对劲爆新闻感兴趣？请买一份报纸吧！"
                },
                {
                    "id": "650140203",
                    "speaker": "帕班",
                    "text": "当然，您若是懒得阅读文字，也可以去找报社门口的亚瑟先生，它会为您口述最新消息的。"
                },
                {
                    "id": "650140204",
                    "speaker": "帕班",
                    "text": "但不在报纸上登出的新闻，您想知道就难咯。"
                }
            ]
        },
        {
            "talkId": "6501403",
            "initDialog": "650140301",
            "dialogues": [
                {
                    "id": "650140301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650140302",
                    "speaker": "帕班",
                    "text": "欢迎再来！"
                }
            ]
        },
        {
            "talkId": "6501404",
            "initDialog": "650140401",
            "dialogues": [
                {
                    "id": "650140401",
                    "speaker": "Player",
                    "text": "比如呢？"
                },
                {
                    "id": "650140402",
                    "speaker": "帕班",
                    "text": "比如…呃，光这么说我也不知道客人您想知道什么。"
                },
                {
                    "id": "650140403",
                    "speaker": "帕班",
                    "text": "不如客人您先告诉我您从哪儿来的，做些什么营生？"
                },
                {
                    "id": "650140404",
                    "speaker": "帕班",
                    "text": "这样，我才能够更为精准地提供您想要知道的新闻嘛。"
                }
            ]
        },
        {
            "talkId": "6501405",
            "initDialog": "650140501",
            "dialogues": [
                {
                    "id": "650140501",
                    "speaker": "Player",
                    "text": "亚瑟先生是哪位？"
                },
                {
                    "id": "650140502",
                    "speaker": "帕班",
                    "text": "您看，这就是您不知道的事情了。"
                },
                {
                    "id": "650140503",
                    "speaker": "帕班",
                    "text": "不过这个信息我可以免费赠送，就当是给新客人的福利咯。"
                },
                {
                    "id": "650140504",
                    "speaker": "帕班",
                    "text": "亚瑟先生就是所谓「蒸汽鸟报」中的「蒸汽鸟」啦。"
                },
                {
                    "id": "650140505",
                    "speaker": "帕班",
                    "text": "——一位没有生命，但是很会说话的鸟先生。"
                }
            ]
        },
        {
            "talkId": "6501406",
            "initDialog": "650140601",
            "dialogues": [
                {
                    "id": "650140601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6501407",
            "initDialog": "650140701",
            "dialogues": [
                {
                    "id": "650140701",
                    "speaker": "帕班",
                    "text": "我赢了！等我规划完了分销报纸的大生意，你就要帮我卖报纸挣钱哦！"
                }
            ]
        },
        {
            "talkId": "6501408",
            "initDialog": "650140801",
            "dialogues": [
                {
                    "id": "650140801",
                    "speaker": "帕班",
                    "text": "呜啊…打牌比卖报纸难多了…"
                }
            ]
        },
        {
            "talkId": "7492201",
            "initDialog": "749220101",
            "dialogues": [
                {
                    "id": "749220101",
                    "speaker": "Player",
                    "text": "怎么感觉不对劲…"
                },
                {
                    "id": "749220102",
                    "speaker": "帕班",
                    "text": "没什么不对劲吧？"
                },
                {
                    "id": "749220103",
                    "speaker": "帕班",
                    "text": "只有您让我知道您知道什么，我才能知道您想知道哪些您不知道的新闻。"
                }
            ]
        }
    ]
}