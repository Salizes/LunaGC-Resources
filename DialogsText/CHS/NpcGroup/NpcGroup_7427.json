{
    "groupId": "7427",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "希菲尔德": 7
    },
    "talks": [
        {
            "talkId": "6742701",
            "initDialog": "674270101",
            "dialogues": [
                {
                    "id": "674270101",
                    "speaker": "希菲尔德",
                    "text": "呃…头好晕，怎么回事…这火水…"
                }
            ]
        },
        {
            "talkId": "6742702",
            "initDialog": "674270201",
            "dialogues": [
                {
                    "id": "674270201",
                    "speaker": "Player",
                    "text": "你这是怎么了？"
                },
                {
                    "id": "674270202",
                    "speaker": "希菲尔德",
                    "text": "我…我喝了太多的火水…呃，我本来以为，可以喝点酒，说不定能够写出了不起的诗…"
                },
                {
                    "id": "674270203",
                    "speaker": "希菲尔德",
                    "text": "吟游诗人不就是这样吗，越喝越兴奋，在恍惚中得到佳句…"
                },
                {
                    "id": "674270204",
                    "speaker": "希菲尔德",
                    "text": "但是…呃…可是相较于啤酒，火水是不是太过了…现在只觉得头有点痛…呼…"
                }
            ]
        },
        {
            "talkId": "6742703",
            "initDialog": "674270301",
            "dialogues": [
                {
                    "id": "674270301",
                    "speaker": "Player",
                    "text": "需要帮助吗？"
                },
                {
                    "id": "674270302",
                    "speaker": "希菲尔德",
                    "text": "没事，我只是…我只是火水喝得太猛了…"
                },
                {
                    "id": "674270303",
                    "speaker": "希菲尔德",
                    "text": "相信我，我可是蒙德人，我得信任我的蒙德人血统…想必再过一会儿就能适应火水了…"
                }
            ]
        },
        {
            "talkId": "6742704",
            "initDialog": "674270401",
            "dialogues": [
                {
                    "id": "674270401",
                    "speaker": "Player",
                    "text": "看来您得少喝点。"
                },
                {
                    "id": "674270402",
                    "speaker": "希菲尔德",
                    "text": "也许吧…唉，可是都到了至冬，谁能忍住不尝尝当地的火水呢。"
                }
            ]
        }
    ]
}