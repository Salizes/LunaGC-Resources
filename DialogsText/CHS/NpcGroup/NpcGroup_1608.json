{
    "groupId": "1608",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "佩佩": 10
    },
    "talks": [
        {
            "talkId": "4111534",
            "initDialog": "411153401",
            "dialogues": [
                {
                    "id": "411153401",
                    "speaker": "佩佩",
                    "text": "你知道吗，我认识的一个叔叔最近变成了懒虫！每天睡大觉…"
                }
            ]
        },
        {
            "talkId": "6160801",
            "initDialog": "616080101",
            "dialogues": [
                {
                    "id": "616080101",
                    "speaker": "佩佩",
                    "text": "哈哈，我是不是很擅长模仿杜拉夫叔叔讲话？"
                }
            ]
        },
        {
            "talkId": "6160802",
            "initDialog": "616080201",
            "dialogues": [
                {
                    "id": "616080201",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "616080202",
                    "speaker": "佩佩",
                    "text": "在练习跑步！"
                },
                {
                    "id": "616080203",
                    "speaker": "佩佩",
                    "text": "杜拉夫叔叔说，想要当猎人，首先要能用脚追上猎物，我已经能够追上附近的小猫啦！"
                },
                {
                    "id": "616080204",
                    "speaker": "佩佩",
                    "text": "可还是和爸爸差得很远，他跑步可快了，无论是什么猎物都能追上。"
                }
            ]
        },
        {
            "talkId": "6160803",
            "initDialog": "616080301",
            "dialogues": [
                {
                    "id": "616080301",
                    "speaker": "Player",
                    "text": "你爸爸呢？"
                },
                {
                    "id": "616080302",
                    "speaker": "佩佩",
                    "text": "我爸爸去追猎一只很大很大的野猪了，要很久很久才能回来。"
                },
                {
                    "id": "616080303",
                    "speaker": "佩佩",
                    "text": "我说我想去帮爸爸，杜拉夫叔叔说，我还小，没有力气，也不是猎人，去了也是给爸爸添乱。"
                },
                {
                    "id": "616080304",
                    "speaker": "佩佩",
                    "text": "所以我要快点长大，成了猎人，就可以去帮爸爸了！"
                }
            ]
        },
        {
            "talkId": "6160804",
            "initDialog": "616080401",
            "dialogues": [
                {
                    "id": "616080401",
                    "speaker": "Player",
                    "text": "再见，要加油啊！"
                },
                {
                    "id": "616080402",
                    "speaker": "佩佩",
                    "text": "嗯，我一定会成为一个厉害的猎人的。"
                },
                {
                    "id": "616080403",
                    "speaker": "佩佩",
                    "text": "然后去帮爸爸，把那只野猪抓住！"
                }
            ]
        }
    ]
}