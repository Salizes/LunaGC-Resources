{
    "groupId": "9330",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "罗莎莉亚": 9
    },
    "talks": [
        {
            "talkId": "6933001",
            "initDialog": "693300101",
            "dialogues": [
                {
                    "id": "693300101",
                    "speaker": "罗莎莉亚",
                    "text": "真可惜，又是个不能喝酒的地方。"
                },
                {
                    "id": "693300102",
                    "speaker": "罗莎莉亚",
                    "text": "不过，没有成天担心这担心那的修女找过来，也算是个好去处。"
                },
                {
                    "id": "693300103",
                    "speaker": "罗莎莉亚",
                    "text": "你不急着把这里的事办完吧？那不如听我的建议，一起偷个懒。"
                }
            ]
        },
        {
            "talkId": "6933002",
            "initDialog": "693300201",
            "dialogues": [
                {
                    "id": "693300201",
                    "speaker": "罗莎莉亚",
                    "text": "你组建小队的目的，是想去击败秘境中遇到的所有敌人，没错吧？"
                },
                {
                    "id": "693300202",
                    "speaker": "罗莎莉亚",
                    "text": "这确实是我擅长的事，我加入了。"
                },
                {
                    "id": "693300203",
                    "speaker": "罗莎莉亚",
                    "text": "现在不走吗？别拖到下班时间，我可是劝过了。"
                }
            ]
        },
        {
            "talkId": "6933003",
            "initDialog": "693300301",
            "dialogues": [
                {
                    "id": "693300301",
                    "speaker": "罗莎莉亚",
                    "text": "今晚如果还有其他工作安排的话，请容我拒绝。"
                },
                {
                    "id": "693300302",
                    "speaker": "罗莎莉亚",
                    "text": "我才做完某些脏活，至少想给自己留出一些空闲。"
                },
                {
                    "id": "693300303",
                    "speaker": "罗莎莉亚",
                    "text": "工作内容？我不会透露的。这不是什么愉快的事，知道了也没好处。"
                }
            ]
        }
    ]
}