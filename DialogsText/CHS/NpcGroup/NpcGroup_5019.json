{
    "groupId": "5019",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "诗黛": 9
    },
    "talks": [
        {
            "talkId": "6501901",
            "initDialog": "650190101",
            "dialogues": [
                {
                    "id": "650190101",
                    "speaker": "诗黛",
                    "text": "…那姣好的面容被雨点打湿，她笑笑，觉得自己很幸运。"
                },
                {
                    "id": "650190102",
                    "speaker": "诗黛",
                    "text": "因为这样他就不会知道，自己是在哭了…"
                }
            ]
        },
        {
            "talkId": "6501902",
            "initDialog": "650190201",
            "dialogues": [
                {
                    "id": "650190201",
                    "speaker": "Player",
                    "text": "你在说什么？"
                },
                {
                    "id": "650190202",
                    "speaker": "诗黛",
                    "text": "哦…我在构思小说的情节。编辑已经催了我两天，不能再拖下去了…"
                }
            ]
        },
        {
            "talkId": "6501903",
            "initDialog": "650190301",
            "dialogues": [
                {
                    "id": "650190301",
                    "speaker": "Player",
                    "text": "你看起来很累…"
                },
                {
                    "id": "650190302",
                    "speaker": "诗黛",
                    "text": "哎，连载小说真难写…"
                },
                {
                    "id": "650190303",
                    "speaker": "诗黛",
                    "text": "我原本只是闲着没事，想打发打发时间，就写了一本恋爱小说，没想到大家都很喜欢。"
                },
                {
                    "id": "650190304",
                    "speaker": "诗黛",
                    "text": "我当时也不懂，糊里糊涂签了个连载的合同。这下好了…每天都得熬夜写稿赶进度…"
                },
                {
                    "id": "650190305",
                    "speaker": "诗黛",
                    "text": "哎，连载完这篇就不写了，我又不缺钱…"
                }
            ]
        },
        {
            "talkId": "6501904",
            "initDialog": "650190401",
            "dialogues": [
                {
                    "id": "650190401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650190402",
                    "speaker": "诗黛",
                    "text": "「再见。」——她对他说。"
                },
                {
                    "id": "650190403",
                    "speaker": "诗黛",
                    "text": "但她心里知道，他们恐怕再不会相见了。"
                }
            ]
        }
    ]
}