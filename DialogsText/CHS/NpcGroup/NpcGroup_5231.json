{
    "groupId": "5231",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 8,
        "弗里曼": 23
    },
    "talks": [
        {
            "talkId": "6523101",
            "initDialog": "652310101",
            "dialogues": [
                {
                    "id": "652310101",
                    "speaker": "弗里曼",
                    "text": "…我对你没有安排，我的孩子，自由地追求你想要的吧。"
                }
            ]
        },
        {
            "talkId": "6523102",
            "initDialog": "652310201",
            "dialogues": [
                {
                    "id": "652310201",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "652310202",
                    "speaker": "弗里曼",
                    "text": "我？一个无名小卒，何必在乎，来喝酒吧。"
                },
                {
                    "id": "652310203",
                    "speaker": "弗里曼",
                    "text": "不管是什么把你带到这里，既然我们能在这艘「船」上相会，难道不值得喝一杯庆祝吗？"
                },
                {
                    "id": "652310204",
                    "speaker": "弗里曼",
                    "text": "庆祝我们每天都能看见天空，看见海洋！"
                }
            ]
        },
        {
            "talkId": "6523103",
            "initDialog": "652310301",
            "dialogues": [
                {
                    "id": "652310301",
                    "speaker": "Player",
                    "text": "关于佩妮…"
                },
                {
                    "id": "652310302",
                    "speaker": "弗里曼",
                    "text": "哦，小佩妮！既然她愿意把那些动物朋友们介绍给你，她应该相当相信你。"
                },
                {
                    "id": "652310303",
                    "speaker": "弗里曼",
                    "text": "它们叫什么来着？"
                }
            ]
        },
        {
            "talkId": "6523104",
            "initDialog": "652310401",
            "dialogues": [
                {
                    "id": "652310401",
                    "speaker": "Player",
                    "text": "关于秋…"
                },
                {
                    "id": "652310402",
                    "speaker": "弗里曼",
                    "text": "可怜的姑娘，可惜你们第一次见面是在那种场合。"
                },
                {
                    "id": "652310403",
                    "speaker": "弗里曼",
                    "text": "其实她心眼儿很好，我希望她能快乐。"
                }
            ]
        },
        {
            "talkId": "6523105",
            "initDialog": "652310501",
            "dialogues": [
                {
                    "id": "652310501",
                    "speaker": "Player",
                    "text": "关于鲁热…"
                },
                {
                    "id": "652310502",
                    "speaker": "弗里曼",
                    "text": "「要看见真正美妙的东西，别用眼睛看，得用脑袋看。」"
                },
                {
                    "id": "652310503",
                    "speaker": "弗里曼",
                    "text": "你猜这件事是谁告诉我的？"
                },
                {
                    "id": "652310504",
                    "speaker": "弗里曼",
                    "text": "哈哈，他是个有趣的人，一个好朋友。"
                }
            ]
        },
        {
            "talkId": "6523106",
            "initDialog": "652310601",
            "dialogues": [
                {
                    "id": "652310601",
                    "speaker": "Player",
                    "text": "再会。"
                },
                {
                    "id": "652310602",
                    "speaker": "弗里曼",
                    "text": "再会，我的孩子。"
                },
                {
                    "id": "652310603",
                    "speaker": "弗里曼",
                    "text": "真理永远在前进，没有任何东西能阻挡它，干杯！"
                }
            ]
        },
        {
            "talkId": "6523107",
            "initDialog": "652310701",
            "dialogues": [
                {
                    "id": "652310701",
                    "speaker": "Player",
                    "text": "你能看见？"
                },
                {
                    "id": "652310702",
                    "speaker": "弗里曼",
                    "text": "要看见真正美妙的东西，别用眼睛看，得用脑袋看。"
                },
                {
                    "id": "652310703",
                    "speaker": "弗里曼",
                    "text": "…酒后真谈，我的孩子。"
                },
                {
                    "id": "652310704",
                    "speaker": "弗里曼",
                    "text": "相信我，你试着用这样的角度去看看，会发现不一样的东西。"
                }
            ]
        },
        {
            "talkId": "6523108",
            "initDialog": "652310801",
            "dialogues": [
                {
                    "id": "652310801",
                    "speaker": "Player",
                    "text": "唐·西哈诺。"
                },
                {
                    "id": "652310802",
                    "speaker": "弗里曼",
                    "text": "哦对，充满了鲁热品味的名字，像个剑客似的。"
                },
                {
                    "id": "652310803",
                    "speaker": "弗里曼",
                    "text": "那只虎纹猫真是好样的，啊，我们以前被仇家一路追到白淞镇的时候…"
                },
                {
                    "id": "652310804",
                    "speaker": "弗里曼",
                    "text": "它像个了不起的英雄一样跳出去抓花了他们的脸哈哈，它是只忠诚勇敢的好猫。"
                }
            ]
        },
        {
            "talkId": "6523109",
            "initDialog": "652310901",
            "dialogues": [
                {
                    "id": "652310901",
                    "speaker": "Player",
                    "text": "娜娜。"
                },
                {
                    "id": "652310902",
                    "speaker": "弗里曼",
                    "text": "哦对，我记得秋的狗是叫这个名字。"
                },
                {
                    "id": "652310903",
                    "speaker": "弗里曼",
                    "text": "这狗太娇气，毕竟是在城里长大的，过不惯野日子。"
                },
                {
                    "id": "652310904",
                    "speaker": "弗里曼",
                    "text": "我第一次听秋说她小时候喜欢给这条狗搭配衣服和项链的时候，吓了一大跳。"
                },
                {
                    "id": "652310905",
                    "speaker": "弗里曼",
                    "text": "真是有钱哪，连条狗都要戴项链。"
                }
            ]
        }
    ]
}