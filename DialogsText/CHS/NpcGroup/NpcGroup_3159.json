{
    "groupId": "3159",
    "total_dialogue_lines": 46,
    "speaker_counts": {
        "Player": 8,
        "五百藏": 38
    },
    "talks": [
        {
            "talkId": "7210818",
            "initDialog": "721081801",
            "dialogues": [
                {
                    "id": "721081801",
                    "speaker": "五百藏",
                    "text": "吾辈以前可是名震天下的妖狸五百藏。总有一天吾辈要用八叠大的…"
                },
                {
                    "id": "721081802",
                    "speaker": "五百藏",
                    "text": "咳咳。是你啊，小辈。看你与吾等缘分不浅，有什么想问的就尽管问吧。",
                    "choices": [
                        {
                            "id": "721081803",
                            "text": "关于镇守之森…",
                            "response": [
                                {
                                    "id": "721081804",
                                    "speaker": "五百藏",
                                    "text": "别看现在成了石像，以前吾辈也是大御所大人封的官，是人称「隐神保生司正五百藏」的大人物。"
                                },
                                {
                                    "id": "721081805",
                                    "speaker": "五百藏",
                                    "text": "吾辈的职责就是保护镇守之森。保护这里的水土、灵脉。你看，在吾辈的关照下，守护之森多好。",
                                    "choices": [
                                        {
                                            "id": "721081806",
                                            "text": "开始你还被丘丘人…",
                                            "response": [
                                                {
                                                    "id": "721081807",
                                                    "speaker": "五百藏",
                                                    "text": "呶？你误会了。丘丘人对吾辈没什么害处。因为变成了石头，没办法到处找人玩，所以都是丘丘人陪着我。"
                                                },
                                                {
                                                    "id": "721081808",
                                                    "speaker": "五百藏",
                                                    "text": "一开始吾辈看你是人，还以为你也是来害我的，所以就叫它们帮忙对付你了。你没事就好。"
                                                },
                                                {
                                                    "id": "721081809",
                                                    "speaker": "五百藏",
                                                    "text": "虽然语言不通，头脑又笨，但变成石头的这些岁月里，它们多少也算是成了吾辈的伙伴吧。"
                                                },
                                                {
                                                    "id": "721081810",
                                                    "speaker": "五百藏",
                                                    "text": "说来也怪，以前稻妻是没多少丘丘人的。从哪天开始，就到处都是了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721081811",
                                            "text": "「保生司正」？",
                                            "response": [
                                                {
                                                    "id": "721081812",
                                                    "speaker": "五百藏",
                                                    "text": "吾辈一开始也是个自由自在的妖狸。虽然名气不大，但自由自在得很哪。经常和那个臭狐狸比赛斗法。"
                                                },
                                                {
                                                    "id": "721081813",
                                                    "speaker": "五百藏",
                                                    "text": "有一天，那个臭狐狸跟我打赌，说吾辈不能偷到将军御苑里长的鸣草。吾辈当然接受挑战，结果害得我差点被将军一刀削了去，变得跟八酝岛似的。"
                                                },
                                                {
                                                    "id": "721081814",
                                                    "speaker": "五百藏",
                                                    "text": "最后…"
                                                },
                                                {
                                                    "id": "721081815",
                                                    "speaker": "五百藏",
                                                    "text": "最后还是那个臭狐狸帮我说情，将军才网开一面。不但放吾辈一条生路，还赐我「保生司正」之职。"
                                                },
                                                {
                                                    "id": "721081816",
                                                    "speaker": "五百藏",
                                                    "text": "这种事情，吾辈怎么会忘记呢。吾辈可是欠了那个臭狐狸一条命呶…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721081817",
                            "text": "关于你自己…",
                            "response": [
                                {
                                    "id": "721081818",
                                    "speaker": "五百藏",
                                    "text": "吾等妖狸一族自古就在鸣神的土地上活跃。有什么问题吗？",
                                    "choices": [
                                        {
                                            "id": "721081819",
                                            "text": "你怎么被封印的？",
                                            "response": [
                                                {
                                                    "id": "721081820",
                                                    "speaker": "五百藏",
                                                    "text": "呶，吾辈怎么知道——"
                                                },
                                                {
                                                    "id": "721081821",
                                                    "speaker": "五百藏",
                                                    "text": "不对，应该就是因为偷了那把梳子吧。"
                                                },
                                                {
                                                    "id": "721081822",
                                                    "speaker": "五百藏",
                                                    "text": "谁知道这把梳子是用来做「神樱大福」的嘛！"
                                                },
                                                {
                                                    "id": "721081823",
                                                    "speaker": "五百藏",
                                                    "text": "那个臭狐狸从挑战吾辈捉迷藏的那天开始，就再也没现身过了。"
                                                },
                                                {
                                                    "id": "721081824",
                                                    "speaker": "五百藏",
                                                    "text": "为了把那家伙引出来，吾辈想尽各种办法。因为那家伙过去喜欢跟吾辈斗法，所以吾辈就到处捣乱。"
                                                },
                                                {
                                                    "id": "721081825",
                                                    "speaker": "五百藏",
                                                    "text": "把绀田村的菫瓜变成土豆、把日落果变成老虎。以前，一般这时候，臭狐狸就会冲过来找吾辈麻烦了。但这次不一样。"
                                                },
                                                {
                                                    "id": "721081826",
                                                    "speaker": "五百藏",
                                                    "text": "后来，吾辈就觉得，「好生气！」干脆把那家伙眷属的雕像破坏掉。这时候吾辈就发现了里面的梳子。"
                                                },
                                                {
                                                    "id": "721081827",
                                                    "speaker": "五百藏",
                                                    "text": "「只要把这个偷走，那个臭狐狸肯定会着急。那就会现身了吧。呶。」吾辈这么想，就把梳子偷走了。"
                                                },
                                                {
                                                    "id": "721081828",
                                                    "speaker": "五百藏",
                                                    "text": "结果，臭狐狸没有出现，却来了个人类小辈，我记得以前是和影向天狗学法术的三人组之一。"
                                                },
                                                {
                                                    "id": "721081829",
                                                    "speaker": "五百藏",
                                                    "text": "不知怎么力量这么强，居然把吾辈和孩子们一并封印在石像里了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721081830",
                                            "text": "关于「胜负」…",
                                            "response": [
                                                {
                                                    "id": "721081831",
                                                    "speaker": "五百藏",
                                                    "text": "呶，很过分吧？那时候臭狐狸居然敢用捉迷藏挑战吾辈。"
                                                },
                                                {
                                                    "id": "721081832",
                                                    "speaker": "五百藏",
                                                    "text": "说什么「绝对不要现身」、「如果发生了什么事，那就是我在用法术挑拨你」之类的，口气很奇怪得很呶。"
                                                },
                                                {
                                                    "id": "721081833",
                                                    "speaker": "五百藏",
                                                    "text": "但吾辈可是妖狸，又是将军大人亲自封的「保生司正」，在镇守之森用捉迷藏挑战吾辈，那自然接受。得好好教训教训那家伙。"
                                                },
                                                {
                                                    "id": "721081834",
                                                    "speaker": "五百藏",
                                                    "text": "吾辈找了个好地方，变成了一只鬼兜虫，想看那家伙在林子里着急地到处乱找的丑态！"
                                                },
                                                {
                                                    "id": "721081835",
                                                    "speaker": "五百藏",
                                                    "text": "结果，那臭狐狸一直没来。这个胜负，到现在还没有分出来。"
                                                },
                                                {
                                                    "id": "721081836",
                                                    "speaker": "五百藏",
                                                    "text": "吾辈会一直等下去，等那个臭狐狸回来，然后，对吾辈道歉。呶，那家伙要道歉的东西太多了，吾辈天天都在算这笔账呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721081837",
                                            "text": "关于小妖狸…",
                                            "response": [
                                                {
                                                    "id": "721081838",
                                                    "speaker": "五百藏",
                                                    "text": "呶，镇守之森原本是吾辈「隐神保生司正五百藏」与同族的土地，直到吾等被那个人类小姓变成石像。"
                                                },
                                                {
                                                    "id": "721081839",
                                                    "speaker": "五百藏",
                                                    "text": "如果你看到了狸子石像，那多半也是被封印的妖狸。"
                                                },
                                                {
                                                    "id": "721081840",
                                                    "speaker": "五百藏",
                                                    "text": "不过这些时日，有些封印已经松动了。比如「吉法师」他们，已经恢复了原状，所以吾等还是有希望的。"
                                                },
                                                {
                                                    "id": "721081841",
                                                    "speaker": "五百藏",
                                                    "text": "呶，小辈哟，答应吾辈一件事。"
                                                },
                                                {
                                                    "id": "721081842",
                                                    "speaker": "五百藏",
                                                    "text": "如果在外头看到了吾辈同族的小狸子，要对他们好一点。"
                                                },
                                                {
                                                    "id": "721081843",
                                                    "speaker": "五百藏",
                                                    "text": "他们都陪吾辈被封印了…不知道多久岁月，现在就想看看外面的世界。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721081844",
                            "text": "再见，五百藏。",
                            "response": [
                                {
                                    "id": "721081845",
                                    "speaker": "五百藏",
                                    "text": "再见了，小辈。如果是那家伙的话，这时候就会念个难懂的诗吧。"
                                },
                                {
                                    "id": "721081846",
                                    "speaker": "五百藏",
                                    "text": "有时间要来找吾辈玩。毕竟，吾辈现在可是石头，时间可是多得很呶。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}