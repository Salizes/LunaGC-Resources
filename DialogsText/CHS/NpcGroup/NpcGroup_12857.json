    "talks": [
        {
            "talkId": "4008215",
            "initDialog": "400821501",
            "dialogues": [
                {
                    "id": "400821501",
                    "speaker": "考特里亚",
                    "text": "什么人！"
                },
                {
                    "id": "400821502",
                    "speaker": "考特里亚",
                    "text": "居然是你们…呃咳！原来是两位夺冠的大热门啊。"
                },
                {
                    "id": "400821503",
                    "speaker": "考特里亚",
                    "text": "你们有什么事？是来向我反馈「意智宝珠」的问题的吗？"
                },
                {
                    "id": "400821504",
                    "speaker": "派蒙",
                    "text": "怎么感觉你的语气有点不耐烦…"
                },
                {
                    "id": "400821505",
                    "speaker": "考特里亚",
                    "text": "哈！话可不能这么说，我可是很忙的，如果你们不能提供有价值的信息，就专心去比你们的赛吧！"
                },
                {
                    "id": "400821506",
                    "speaker": "考特里亚",
                    "text": "我还要忙着收集数据，提高「意智宝珠」的效能和产能呢！"
                },
                {
                    "id": "400821507",
                    "speaker": "Player",
                    "text": "态度好差…"
                },
                {
                    "id": "400821508",
                    "speaker": "派蒙",
                    "text": "那我们也没空理你了，科研狂人！你就一个人在这荒郊野岭和蘑菇说话去吧！"
                }
            ]
        }
    ]
}