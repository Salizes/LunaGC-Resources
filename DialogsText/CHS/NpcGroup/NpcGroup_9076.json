{
    "groupId": "9076",
    "total_dialogue_lines": 74,
    "speaker_counts": {
        "Player": 17,
        "珐露珊": 57
    },
    "talks": [
        {
            "talkId": "6907601",
            "initDialog": "690760101",
            "dialogues": [
                {
                    "id": "690760101",
                    "speaker": "珐露珊",
                    "text": "是你呀，学习遇到困难了？说吧，前辈亲自辅导你…"
                },
                {
                    "id": "690760102",
                    "speaker": "珐露珊",
                    "text": "当然了，要是有什么人生难题，也欢迎你向我请教。"
                }
            ]
        },
        {
            "talkId": "6907602",
            "initDialog": "690760201",
            "dialogues": [
                {
                    "id": "690760201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690760202",
                    "speaker": "珐露珊",
                    "text": "放心好了，我又不是那种讨人嫌的挑剔老学者…平时也不难相处…"
                },
                {
                    "id": "690760203",
                    "speaker": "珐露珊",
                    "text": "嗯？你那是什么信不过我的表情？"
                },
                {
                    "id": "690760204",
                    "speaker": "珐露珊",
                    "text": "我偶尔挑三拣四，也是针对教令院的离谱规矩，或是某些不讲礼貌的学生。"
                },
                {
                    "id": "690760205",
                    "speaker": "珐露珊",
                    "text": "你为人又好，这里环境也不错，我怎么会有不满呢？",
                    "choices": [
                        {
                            "id": "690760206",
                            "text": "喜欢就好。",
                            "response": [
                                {
                                    "id": "690760207",
                                    "speaker": "珐露珊",
                                    "text": "哈哈，像你这样细心周到的后辈，现在已经很少见啦。"
                                },
                                {
                                    "id": "690760208",
                                    "speaker": "珐露珊",
                                    "text": "那假如住一段时间之后，我发现了设计不合理的地方，我也会如实照说，没问题吧？"
                                },
                                {
                                    "id": "690760214",
                                    "speaker": "Player",
                                    "text": "好！没问题。"
                                },
                                {
                                    "id": "690760215",
                                    "speaker": "珐露珊",
                                    "text": "很好。看来，我可以安心在这研究我感兴趣的东西了。"
                                },
                                {
                                    "id": "690760216",
                                    "speaker": "珐露珊",
                                    "text": "即使再住上一百年…呵呵，我也非常乐意。"
                                }
                            ]
                        },
                        {
                            "id": "690760209",
                            "text": "还有什么需要吗？",
                            "response": [
                                {
                                    "id": "690760210",
                                    "speaker": "珐露珊",
                                    "text": "好。能帮我多备些纸笔吗？"
                                },
                                {
                                    "id": "690760211",
                                    "speaker": "珐露珊",
                                    "text": "来的时候，没想到这个地方的构造如此独特。"
                                },
                                {
                                    "id": "690760212",
                                    "speaker": "珐露珊",
                                    "text": "到底是什么样的机关才能把这一切收纳成一方净土，我得再研究一下…"
                                },
                                {
                                    "id": "690760213",
                                    "speaker": "珐露珊",
                                    "text": "要是又写得满地都是，可不太对得起你啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907603",
            "initDialog": "690760301",
            "dialogues": [
                {
                    "id": "690760301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690760302",
                    "speaker": "珐露珊",
                    "text": "说起聊天…我曾经思考过「聊天」这个词。"
                },
                {
                    "id": "690760303",
                    "speaker": "珐露珊",
                    "text": "同样是传递信息的行为，但人们不会称之为「传话」或「辩论」，知道是为什么吗？"
                },
                {
                    "id": "690760304",
                    "speaker": "Player",
                    "text": "聊天的目的是了解对方？"
                },
                {
                    "id": "690760305",
                    "speaker": "珐露珊",
                    "text": "嗯，没错。"
                },
                {
                    "id": "690760306",
                    "speaker": "珐露珊",
                    "text": "想知道对方的喜恶、心情、看法…分享有趣的见闻、分担最近的烦恼…"
                },
                {
                    "id": "690760307",
                    "speaker": "珐露珊",
                    "text": "只要能多了解对方一点，聊什么都不重要。"
                },
                {
                    "id": "690760308",
                    "speaker": "珐露珊",
                    "text": "又可以说聊什么都很重要。再小的话题，在那些在乎你的人心里，都是值得被关注的事。"
                },
                {
                    "id": "690760309",
                    "speaker": "珐露珊",
                    "text": "唉。惭愧地说，以前的我可没空想什么「聊天」的意义。"
                },
                {
                    "id": "690760310",
                    "speaker": "珐露珊",
                    "text": "总把自己关在房间里做研究…在外游学给家人朋友的信件又总是删繁就简，报喜不报忧。"
                },
                {
                    "id": "690760311",
                    "speaker": "珐露珊",
                    "text": "我敢说自己无愧于学者这个头衔…可我并不是一个合格的女儿、学生、朋友…"
                },
                {
                    "id": "690760312",
                    "speaker": "Player",
                    "text": "不要难过，珐露珊前辈…"
                },
                {
                    "id": "690760313",
                    "speaker": "珐露珊",
                    "text": "嗯，谢谢你。"
                },
                {
                    "id": "690760314",
                    "speaker": "珐露珊",
                    "text": "呼…不过你放心，你知道我的为人，我不会沉湎过去…"
                },
                {
                    "id": "690760315",
                    "speaker": "珐露珊",
                    "text": "我说这些，恰恰是要提醒自己——"
                },
                {
                    "id": "690760316",
                    "speaker": "珐露珊",
                    "text": "珍惜眼前的一切，重视和关心身边的人。",
                    "choices": [
                        {
                            "id": "690760317",
                            "text": "说得很对！",
                            "response": [
                                {
                                    "id": "690760319",
                                    "speaker": "珐露珊",
                                    "text": "好了，这个时候就别拍马屁了。既然你也赞同，不妨配合下我的实践？"
                                },
                                {
                                    "id": "690760320",
                                    "speaker": "珐露珊",
                                    "text": "作为我重视的人，你也许会时常收到我的关心，形式不限于写信或者聊天。"
                                },
                                {
                                    "id": "690760321",
                                    "speaker": "珐露珊",
                                    "text": "…不要嫌我这个前辈唠叨就好。"
                                }
                            ]
                        },
                        {
                            "id": "690760318",
                            "text": "不愧是珐露珊前辈！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907604",
            "initDialog": "690760401",
            "dialogues": [
                {
                    "id": "690760401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690760402",
                    "speaker": "珐露珊",
                    "text": "唔…我正头疼住在沙漠的小朋友会喜欢些什么…零食还是玩具呢…"
                },
                {
                    "id": "690760403",
                    "speaker": "珐露珊",
                    "text": "有空吗？给我点建议？"
                },
                {
                    "id": "690760404",
                    "speaker": "Player",
                    "text": "前辈要去沙漠？"
                },
                {
                    "id": "690760405",
                    "speaker": "珐露珊",
                    "text": "嗯。有位同僚前阵子离开了教令院，回到了沙漠任教，最近我收到她的来信。"
                },
                {
                    "id": "690760406",
                    "speaker": "珐露珊",
                    "text": "她问我有没有兴趣去那边转一转，顺便给孩子们上几节识字课…"
                },
                {
                    "id": "690760407",
                    "speaker": "Player",
                    "text": "好事，可以招新学生！"
                },
                {
                    "id": "690760408",
                    "speaker": "珐露珊",
                    "text": "哈哈，你还替我记着这事呢？"
                },
                {
                    "id": "690760409",
                    "speaker": "珐露珊",
                    "text": "此行的目的，只是给他们科普一些简单和常用的字符知识。"
                },
                {
                    "id": "690760410",
                    "speaker": "珐露珊",
                    "text": "让他们能够更轻松地阅读，帮助自己挖掘更多感兴趣的东西…"
                },
                {
                    "id": "690760411",
                    "speaker": "珐露珊",
                    "text": "现在播撒的种子，也许会在未来生根发芽，长成参天大树。这就够了。"
                },
                {
                    "id": "690760412",
                    "speaker": "珐露珊",
                    "text": "至于他们以后有没有选择我的研究方向…那就得看他们的悟性了，对吧？",
                    "choices": [
                        {
                            "id": "690760413",
                            "text": "其实还是会期待的吧？",
                            "response": [
                                {
                                    "id": "690760414",
                                    "speaker": "珐露珊",
                                    "text": "哼，这就敢揣摩前辈心理了，胆子大起来了嘛？"
                                },
                                {
                                    "id": "690760417",
                                    "speaker": "珐露珊",
                                    "text": "但前辈我今天不跟你计较，还有准备工作没做完呢。"
                                },
                                {
                                    "id": "690760418",
                                    "speaker": "珐露珊",
                                    "text": "准备工作…啊！糟了！"
                                },
                                {
                                    "id": "690760419",
                                    "speaker": "Player",
                                    "text": "怎么了？！"
                                },
                                {
                                    "id": "690760420",
                                    "speaker": "珐露珊",
                                    "text": "突然想起前不久教令院针对「外出开课」出台了新规则，要填一大堆申请材料呢。"
                                },
                                {
                                    "id": "690760421",
                                    "speaker": "珐露珊",
                                    "text": "啧…真麻烦。"
                                },
                                {
                                    "id": "690760422",
                                    "speaker": "珐露珊",
                                    "text": "算了，不管了，等他们发现后我就说我记性差忘记了，反正他们也拿我没办法。"
                                },
                                {
                                    "id": "690760423",
                                    "speaker": "珐露珊",
                                    "text": "还是干正事要紧，走吧，陪我买礼物去？零食和玩具…就全买上好了。"
                                }
                            ]
                        },
                        {
                            "id": "690760415",
                            "text": "总不会那时候还没学生吧？",
                            "response": [
                                {
                                    "id": "690760416",
                                    "speaker": "珐露珊",
                                    "text": "哼，这就敢嘲笑前辈了，胆子大起来了嘛？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907605",
            "initDialog": "690760501",
            "dialogues": [
                {
                    "id": "690760501",
                    "speaker": "Player",
                    "text": "早啊，珐露珊前辈！"
                },
                {
                    "id": "690760502",
                    "speaker": "珐露珊",
                    "text": "#{NICKNAME}，早上好。"
                },
                {
                    "id": "690760503",
                    "speaker": "珐露珊",
                    "text": "跟你打个招呼，今天一整天的精神都要变好了。哈哈…"
                }
            ]
        },
        {
            "talkId": "6907606",
            "initDialog": "690760601",
            "dialogues": [
                {
                    "id": "690760601",
                    "speaker": "Player",
                    "text": "晚安，珐露珊前辈。"
                },
                {
                    "id": "690760602",
                    "speaker": "珐露珊",
                    "text": "怎么？眼睛都要睁不开了吗？"
                },
                {
                    "id": "690760603",
                    "speaker": "珐露珊",
                    "text": "那说明今天的你已经很努力了，未尽之事就留给明天吧，好好休息！"
                }
            ]
        },
        {
            "talkId": "6907607",
            "initDialog": "690760701",
            "dialogues": [
                {
                    "id": "690760701",
                    "speaker": "珐露珊",
                    "text": "噢！好多书…还有我此前从未阅读过的古籍！翻个几页就被吊起了胃口…"
                },
                {
                    "id": "690760702",
                    "speaker": "珐露珊",
                    "text": "来，伸手，给你糖。不管你想问什么问题，或者是有别的事情要找我，都晚点再说了。"
                },
                {
                    "id": "690760703",
                    "speaker": "珐露珊",
                    "text": "让我在宝库里多待一会儿…"
                }
            ]
        },
        {
            "talkId": "6907608",
            "initDialog": "690760801",
            "dialogues": [
                {
                    "id": "690760801",
                    "speaker": "珐露珊",
                    "text": "我可以在这里支个小摊吗？受理业务的话…翻译古文、解析机关，再卖点微缩机关模型…"
                },
                {
                    "id": "690760802",
                    "speaker": "珐露珊",
                    "text": "嗯…堪称理想的退休生活…才怪咧！"
                },
                {
                    "id": "690760803",
                    "speaker": "珐露珊",
                    "text": "我现在的状态好得很，距离退休年龄还远着呢！"
                }
            ]
        }
    ]
}