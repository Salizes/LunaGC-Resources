{
    "groupId": "7567",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "斯米尔诺娃": 10
    },
    "talks": [
        {
            "talkId": "6756701",
            "initDialog": "675670101",
            "dialogues": [
                {
                    "id": "675670101",
                    "speaker": "斯米尔诺娃",
                    "text": "啊，抱歉，我刚刚走神了…请问有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6756702",
            "initDialog": "675670201",
            "dialogues": [
                {
                    "id": "675670201",
                    "speaker": "Player",
                    "text": "你看起来好像有些疲惫…"
                },
                {
                    "id": "675670202",
                    "speaker": "斯米尔诺娃",
                    "text": "谢谢关心…我现在其实已经好多了。"
                },
                {
                    "id": "675670203",
                    "speaker": "斯米尔诺娃",
                    "text": "前阵子，我在挪德卡莱执行驻扎任务的时候…发生了一些意外。长官们特批我回乡休养一段时间。"
                },
                {
                    "id": "675670204",
                    "speaker": "斯米尔诺娃",
                    "text": "我只是…稍微有些担心沃尔科夫队长他们。"
                }
            ]
        },
        {
            "talkId": "6756703",
            "initDialog": "675670301",
            "dialogues": [
                {
                    "id": "675670301",
                    "speaker": "Player",
                    "text": "好好休息吧。"
                },
                {
                    "id": "675670302",
                    "speaker": "斯米尔诺娃",
                    "text": "谢谢您。愿陛下的荣光同样庇佑您。"
                }
            ]
        },
        {
            "talkId": "6756704",
            "initDialog": "675670401",
            "dialogues": [
                {
                    "id": "675670401",
                    "speaker": "Player",
                    "text": "关于你说的意外…"
                },
                {
                    "id": "675670402",
                    "speaker": "斯米尔诺娃",
                    "text": "嗯…应该可以说吧？您看上去也是很好的人…"
                },
                {
                    "id": "675670403",
                    "speaker": "斯米尔诺娃",
                    "text": "我是愚人众驻挪德卡莱第六连队的列兵，先前被派去护卫设计局两位教授进行的月矩力实验。"
                },
                {
                    "id": "675670404",
                    "speaker": "斯米尔诺娃",
                    "text": "但那里发生了…很严重的事故。沃尔科夫队长和奥尔洛夫他们为了掩护我出来求援，留在了那里。"
                },
                {
                    "id": "675670405",
                    "speaker": "斯米尔诺娃",
                    "text": "军械宫的长官们后来告诉我，他们已经接管了那片区域。队长他们应该都还活着，只是需要时间搜救…"
                },
                {
                    "id": "675670406",
                    "speaker": "斯米尔诺娃",
                    "text": "我得快点好起来才行。等他们平安回来…"
                }
            ]
        }
    ]
}