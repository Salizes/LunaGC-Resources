{
    "groupId": "9599",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "欧洛伦": 10
    },
    "talks": [
        {
            "talkId": "6959901",
            "initDialog": "695990101",
            "dialogues": [
                {
                    "id": "695990101",
                    "speaker": "欧洛伦",
                    "text": "其他人的牌都是自己选的吗？唔，我总是左右为难，什么都想要，就只好找小动物们给建议了。"
                }
            ]
        },
        {
            "talkId": "6959902",
            "initDialog": "695990201",
            "dialogues": [
                {
                    "id": "695990201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959903",
            "initDialog": "695990301",
            "dialogues": [
                {
                    "id": "695990301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695990302",
                    "speaker": "欧洛伦",
                    "text": "再见，想见见那些帮我选牌的飞鼯吗？它们很厉害。"
                }
            ]
        },
        {
            "talkId": "6959904",
            "initDialog": "695990401",
            "dialogues": [
                {
                    "id": "695990401",
                    "speaker": "欧洛伦",
                    "text": "得回去好好谢谢帮我选牌的小动物们。这样做很奇怪吗？抱歉，我们烟谜主就是靠运气办事的。"
                }
            ]
        },
        {
            "talkId": "6959905",
            "initDialog": "695990501",
            "dialogues": [
                {
                    "id": "695990501",
                    "speaker": "欧洛伦",
                    "text": "奶奶老说我这是「好菜牌组」。奶奶果然总是对的。"
                }
            ]
        },
        {
            "talkId": "6959906",
            "initDialog": "695990601",
            "dialogues": [
                {
                    "id": "695990601",
                    "speaker": "欧洛伦",
                    "text": "打牌？嗯，等我收拾一下。之前好看的牌被绒翼龙叼走了几张，得想办法凑够数量…"
                }
            ]
        },
        {
            "talkId": "6959908",
            "initDialog": "695990801",
            "dialogues": [
                {
                    "id": "695990801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959909",
            "initDialog": "695990901",
            "dialogues": [
                {
                    "id": "695990901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959910",
            "initDialog": "695991001",
            "dialogues": [
                {
                    "id": "695991001",
                    "speaker": "欧洛伦",
                    "text": "#这样都能赢吗？{M#爷爷}{F#奶奶}不会是在哄我吧。"
                }
            ]
        },
        {
            "talkId": "6959911",
            "initDialog": "695991101",
            "dialogues": [
                {
                    "id": "695991101",
                    "speaker": "欧洛伦",
                    "text": "唉，咔库库不喜欢这张牌来着，我应该换掉它的。对不起，咔库库。"
                }
            ]
        },
        {
            "talkId": "6959912",
            "initDialog": "695991201",
            "dialogues": [
                {
                    "id": "695991201",
                    "speaker": "欧洛伦",
                    "text": "好的，我有时会陪暝视龙长老打牌，基本上都是它赢，因为它会藏牌。"
                }
            ]
        },
        {
            "talkId": "6959914",
            "initDialog": "695991401",
            "dialogues": [
                {
                    "id": "695991401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959915",
            "initDialog": "695991501",
            "dialogues": [
                {
                    "id": "695991501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959916",
            "initDialog": "695991601",
            "dialogues": [
                {
                    "id": "695991601",
                    "speaker": "欧洛伦",
                    "text": "谢谢你让我赢了一局，我很高兴。"
                }
            ]
        },
        {
            "talkId": "6959917",
            "initDialog": "695991701",
            "dialogues": [
                {
                    "id": "695991701",
                    "speaker": "欧洛伦",
                    "text": "你打牌和奶奶一样厉害，而且不会悔牌，这样就更厉害了。"
                }
            ]
        },
        {
            "talkId": "6959918",
            "initDialog": "695991801",
            "dialogues": [
                {
                    "id": "695991801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}