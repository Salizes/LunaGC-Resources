{
    "groupId": "30064",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 11,
        "驹形": 28
    },
    "talks": [
        {
            "talkId": "7265602",
            "initDialog": "726560201",
            "dialogues": [
                {
                    "id": "726560201",
                    "speaker": "驹形",
                    "text": "来、来试试「机关棋谭」吧！",
                    "choices": [
                        {
                            "id": "726560202",
                            "text": "游玩「机关棋谭」。",
                            "response": [
                                {
                                    "id": "726560203",
                                    "speaker": "驹形",
                                    "text": "没问题，好好玩吧，这可是全新的「机关棋谭」，绝不会让你失望的！"
                                }
                            ]
                        },
                        {
                            "id": "726560204",
                            "text": "「机关棋谭」是什么？",
                            "response": [
                                {
                                    "id": "726560205",
                                    "speaker": "驹形",
                                    "text": "简单来说，就是一种能在桌子上玩的「游戏」啦。最开始是由璃月的瑞锦小姐发明的。"
                                },
                                {
                                    "id": "726560206",
                                    "speaker": "驹形",
                                    "text": "我…怎么说呢，按照瑞锦小姐的说法，我是这套「机关棋谭」在稻妻区域的「海外代理」啦。"
                                },
                                {
                                    "id": "726560207",
                                    "speaker": "驹形",
                                    "text": "在获得…呃…「代理权」之后，瑞锦小姐就把整套的「机关棋谭」，还有相关的营业建议寄了过来。"
                                },
                                {
                                    "id": "726560208",
                                    "speaker": "驹形",
                                    "text": "据瑞锦小姐说，她的「海外代理」还不止我一个。真不知道她到底赚了多少「代理费」…"
                                },
                                {
                                    "id": "726560209",
                                    "speaker": "驹形",
                                    "text": "不过，我这边可是有全新玩法的，说不定会比瑞锦小姐的原版「机关棋谭」更…咳…"
                                },
                                {
                                    "id": "726560210",
                                    "speaker": "驹形",
                                    "text": "唉，但瑞锦小姐的商业头脑可真好，要是我也能像她一样就好了…",
                                    "choices": [
                                        {
                                            "id": "726560202",
                                            "text": "游玩「机关棋谭」。"
                                        },
                                        {
                                            "id": "726560211",
                                            "text": "还有别的事…",
                                            "response": [
                                                {
                                                    "id": "726560212",
                                                    "speaker": "驹形",
                                                    "text": "嗯，等你有空了再来玩吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726560211",
                            "text": "还有别的事…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7268502",
            "initDialog": "726850201",
            "dialogues": [
                {
                    "id": "726850201",
                    "speaker": "驹形",
                    "text": "来试试全新版本的「机关棋谭」吧！",
                    "choices": [
                        {
                            "id": "726850202",
                            "text": "游玩「机关棋谭」。",
                            "response": [
                                {
                                    "id": "726850203",
                                    "speaker": "驹形",
                                    "text": "「机关棋谭·巧策之局」一定不会让你失望的！"
                                }
                            ]
                        },
                        {
                            "id": "726850204",
                            "text": "「机关棋谭」是什么?",
                            "response": [
                                {
                                    "id": "726850205",
                                    "speaker": "驹形",
                                    "text": "是一种来自璃月的桌上「游戏」，很有意思哦！"
                                },
                                {
                                    "id": "726850206",
                                    "speaker": "驹形",
                                    "text": "「机关棋谭」的发明者是瑞锦小姐，她给了我「海外代理」的资格，让我在稻妻推广这款「游戏」。"
                                },
                                {
                                    "id": "726850207",
                                    "speaker": "驹形",
                                    "text": "最初，瑞锦小姐的「海外代理」有好几个人。不过我似乎是其中经营最稳定的一位。"
                                },
                                {
                                    "id": "726850208",
                                    "speaker": "驹形",
                                    "text": "我已经很久没有听到过其他「海外代理」的消息了，可能是赚不到多少钱的缘故，他们都放弃了吧。"
                                },
                                {
                                    "id": "726850209",
                                    "speaker": "驹形",
                                    "text": "而且，我比较关注「机关棋谭」的玩法，以前还尝试独创过新玩法。"
                                },
                                {
                                    "id": "726850210",
                                    "speaker": "驹形",
                                    "text": "虽然后来得知，我的设计与瑞锦小姐计划推出的新玩法不谋而合了，但这反而让瑞锦小姐更欣赏我了。"
                                },
                                {
                                    "id": "726850211",
                                    "speaker": "驹形",
                                    "text": "总之，现在我会和瑞锦小姐保持书信来往，一起改进「机关棋谭」，不断为客人们推出新内容！"
                                },
                                {
                                    "id": "726850212",
                                    "speaker": "Player",
                                    "text": "你真是个称职的代理人。"
                                },
                                {
                                    "id": "726850213",
                                    "speaker": "驹形",
                                    "text": "感谢你的认可！"
                                },
                                {
                                    "id": "726850214",
                                    "speaker": "驹形",
                                    "text": "以后要多多来玩哦。"
                                }
                            ]
                        },
                        {
                            "id": "726850215",
                            "text": "关于容彩祭的大人物…",
                            "response": [
                                {
                                    "id": "726850216",
                                    "speaker": "驹形",
                                    "text": "你的消息好像比较灵通，没准你也见过那位大人物！"
                                },
                                {
                                    "id": "726850217",
                                    "speaker": "驹形",
                                    "text": "事情是这样的…瑞锦小姐早早就向璃月的「飞云商会」拉过投资，可惜当时对方并不感兴趣。"
                                },
                                {
                                    "id": "726850218",
                                    "speaker": "驹形",
                                    "text": "好在他们的二少爷眼光独到，商业头脑很棒，想要考察「机关棋谭」的投资价值。"
                                },
                                {
                                    "id": "726850219",
                                    "speaker": "驹形",
                                    "text": "当时，瑞锦小姐还没准备好新的活动，短时间内不会在璃月开启「机关棋谭」。"
                                },
                                {
                                    "id": "726850220",
                                    "speaker": "驹形",
                                    "text": "那位二少爷从瑞锦小姐那里听说，我会在容彩祭上推广「机关棋谭」，居然直接安排了行程，要来现场考察。"
                                },
                                {
                                    "id": "726850221",
                                    "speaker": "驹形",
                                    "text": "啊呀，如果二少爷对「机关棋谭」感到满意，我们说不定能拿到一大笔钱作为发展资金呢…"
                                },
                                {
                                    "id": "726850222",
                                    "speaker": "Player",
                                    "text": "他其实另有来意…"
                                },
                                {
                                    "id": "726850223",
                                    "speaker": "驹形",
                                    "text": "我已经下定决心了，这次一定要好好表现，争取让「机关棋谭」一战成名。"
                                },
                                {
                                    "id": "726850224",
                                    "speaker": "驹形",
                                    "text": "何况还有你这位出色的棋手在场，我们一定会成功的，没错吧！"
                                },
                                {
                                    "id": "726850225",
                                    "speaker": "Player",
                                    "text": "祝…祝你好运…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}