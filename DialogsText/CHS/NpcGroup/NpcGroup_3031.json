{
    "groupId": "3031",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "菜菜子": 14
    },
    "talks": [
        {
            "talkId": "6303101",
            "initDialog": "630310101",
            "dialogues": [
                {
                    "id": "630310101",
                    "speaker": "菜菜子",
                    "text": "咦，你是谁？不会也是来看我师父笑话的吧…"
                }
            ]
        },
        {
            "talkId": "6303102",
            "initDialog": "630310201",
            "dialogues": [
                {
                    "id": "630310201",
                    "speaker": "Player",
                    "text": "你的师父？"
                },
                {
                    "id": "630310202",
                    "speaker": "菜菜子",
                    "text": "我是剑术流派「明镜止水流」的学徒，师从我的师父土门。"
                },
                {
                    "id": "630310203",
                    "speaker": "菜菜子",
                    "text": "师父曾经是拥有神之眼的厉害剑客，终有一天能成为天下第一的！"
                },
                {
                    "id": "630310204",
                    "speaker": "菜菜子",
                    "text": "结果因为眼狩令，师父失去神之眼之后一直疯疯癫癫的，这可怎么办才好…"
                },
                {
                    "id": "630310205",
                    "speaker": "菜菜子",
                    "text": "我小时候父母被海贼杀害，自己也命悬一线。若不是师父出手相救，我早已命丧黄泉。"
                },
                {
                    "id": "630310206",
                    "speaker": "菜菜子",
                    "text": "师父的救命之恩我永生难报，现在师父深陷困境，我也要想办法帮他才是…"
                }
            ]
        },
        {
            "talkId": "6303103",
            "initDialog": "630310301",
            "dialogues": [
                {
                    "id": "630310301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630310302",
                    "speaker": "菜菜子",
                    "text": "不行，我不能放弃，要努力想想办法…"
                }
            ]
        },
        {
            "talkId": "6303104",
            "initDialog": "630310401",
            "dialogues": [
                {
                    "id": "630310401",
                    "speaker": "菜菜子",
                    "text": "是你啊，旅行者，好久不见！"
                }
            ]
        },
        {
            "talkId": "6303105",
            "initDialog": "630310501",
            "dialogues": [
                {
                    "id": "630310501",
                    "speaker": "Player",
                    "text": "最近怎么样？"
                },
                {
                    "id": "630310502",
                    "speaker": "菜菜子",
                    "text": "多谢你们和八重宫司大人，师父终于恢复正常了。他现在每天指导我们习武练剑，生活也算有了新的指望。"
                },
                {
                    "id": "630310503",
                    "speaker": "菜菜子",
                    "text": "我们这些弟子，为了「不停磨练剑道，成为天下第一」的愿望，也要努力啦。"
                }
            ]
        },
        {
            "talkId": "6303106",
            "initDialog": "630310601",
            "dialogues": [
                {
                    "id": "630310601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630310602",
                    "speaker": "菜菜子",
                    "text": "再见，我也该去练剑了。"
                }
            ]
        },
        {
            "talkId": "7292401",
            "initDialog": "729240101",
            "dialogues": [
                {
                    "id": "729240101",
                    "speaker": "Player",
                    "text": "要加油哦。"
                },
                {
                    "id": "729240102",
                    "speaker": "菜菜子",
                    "text": "嗯！有了你的鼓励，我一定会变强的！"
                },
                {
                    "id": "729240103",
                    "speaker": "菜菜子",
                    "text": "说起来，最近在整理道场的时候，发现了一件异国的武器呢，没准是师父以前用来研究剑道的参考…？"
                },
                {
                    "id": "729240104",
                    "speaker": "菜菜子",
                    "text": "可惜这把剑留在这里也很少有人会用，不如送给你吧。你来自他乡，想必更能发挥出这把剑的实力。"
                }
            ]
        }
    ]
}