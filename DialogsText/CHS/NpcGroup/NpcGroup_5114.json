{
    "groupId": "5114",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "维莱妲": 8
    },
    "talks": [
        {
            "talkId": "6511401",
            "initDialog": "651140101",
            "dialogues": [
                {
                    "id": "651140101",
                    "speaker": "维莱妲",
                    "text": "你好，可爱的人。刚刚正在思考问题，差点没注意到你。"
                }
            ]
        },
        {
            "talkId": "6511402",
            "initDialog": "651140201",
            "dialogues": [
                {
                    "id": "651140201",
                    "speaker": "Player",
                    "text": "可以问问是什么问题吗？"
                },
                {
                    "id": "651140202",
                    "speaker": "维莱妲",
                    "text": "当然可以。我在思考，人类究竟是如何诞生的呢？"
                },
                {
                    "id": "651140203",
                    "speaker": "维莱妲",
                    "text": "我们美露莘是在厄里那斯诞生的。我时常在想，世界上的第一个人类是如何出现的呢？"
                },
                {
                    "id": "651140204",
                    "speaker": "维莱妲",
                    "text": "是和我们一样诞生于血肉，还是由别的方式创造的呢？"
                }
            ]
        },
        {
            "talkId": "6511403",
            "initDialog": "651140301",
            "dialogues": [
                {
                    "id": "651140301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651140302",
                    "speaker": "维莱妲",
                    "text": "再见啦。"
                }
            ]
        },
        {
            "talkId": "7490301",
            "initDialog": "749030101",
            "dialogues": [
                {
                    "id": "749030101",
                    "speaker": "Player",
                    "text": "我不是提瓦特人，不太清楚…"
                },
                {
                    "id": "749030102",
                    "speaker": "维莱妲",
                    "text": "欸，这样吗？"
                },
                {
                    "id": "749030103",
                    "speaker": "维莱妲",
                    "text": "没关系，反正我只是随便想想。这个世界上有很多美露莘看不清也想不明白的问题，已经习惯啦。"
                },
                {
                    "id": "749030104",
                    "speaker": "维莱妲",
                    "text": "不过还是谢谢你！这个小小的纪念品，请收下吧。"
                }
            ]
        }
    ]
}