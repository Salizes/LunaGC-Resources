    },
    "talks": [
        {
            "talkId": "6741001",
            "initDialog": "674100101",
            "dialogues": [
                {
                    "id": "674100101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！\\n欢迎来到冒险家协会总部。"
                }
            ]
        },
        {
            "talkId": "6741002",
            "initDialog": "674100201",
            "dialogues": [
                {
                    "id": "674100201",
                    "speaker": "Player",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6741003",
            "initDialog": "674100301",
            "dialogues": [
                {
                    "id": "674100301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6741004",
            "initDialog": "674100401",
            "dialogues": [
                {
                    "id": "674100401",
                    "speaker": "Player",
                    "text": "你好，凯瑟琳。"
                },
                {
                    "id": "674100402",
                    "speaker": "凯瑟琳",
                    "text": "很高兴见到你。"
                },
                {
                    "id": "674100403",
                    "speaker": "凯瑟琳",
                    "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "674100404",
                    "speaker": "凯瑟琳",
                    "text": "这里是冒险家协会总部，如果您在其他国家与地区遇到什么当地冒险家协会没法解决的问题，可以来总部进行咨询。"
                }
            ]
        },
        {
            "talkId": "6741005",
            "initDialog": "674100501",
            "dialogues": [
                {
                    "id": "674100501",
                    "speaker": "Player",
                    "text": "关于至冬…"
                },
                {
                    "id": "674100502",
                    "speaker": "凯瑟琳",
                    "text": "对各位冒险家来说，至冬幅员辽阔，想必是个能够大展拳脚的好地方…"
                },
                {
                    "id": "674100503",
                    "speaker": "凯瑟琳",
                    "text": "只不过，要小心冻原上的严寒和影域产生的灾害，一定要注意探索与冒险时自身的安全。"
                }
            ]
        },
        {
            "talkId": "6741006",
            "initDialog": "674100601",
            "dialogues": [
                {
                    "id": "674100601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674100602",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6741007",
            "initDialog": "674100701",
            "dialogues": [
                {
                    "id": "674100701",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6741008",
            "initDialog": "674100801",
            "dialogues": [
                {
                    "id": "674100801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674100802",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "6741009",
            "initDialog": "674100902",
            "dialogues": [
                {
                    "id": "674100902",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6741010",
            "initDialog": "674101002",
            "dialogues": [
                {
                    "id": "674101002",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "7068808",
            "initDialog": "706880801",
            "dialogues": [
                {
                    "id": "706880801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880802",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880803",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880804",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880807",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880808",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880809",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880805",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880806",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
