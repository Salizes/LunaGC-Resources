                {
                    "id": "675770101",
                    "speaker": "伊格纳特",
                    "text": "一万、两万…"
                }
            ]
        },
        {
            "talkId": "6757702",
            "initDialog": "675770201",
            "dialogues": [
                {
                    "id": "675770201",
                    "speaker": "Player",
                    "text": "在数什么呢？"
                },
                {
                    "id": "675770202",
                    "speaker": "伊格纳特",
                    "text": "…摩拉…白班能有一万多…夜班更多…一年能攒下不少…"
                },
                {
                    "id": "675770203",
                    "speaker": "伊格纳特",
                    "text": "再攒上一段时间，就够了…"
                }
            ]
        },
        {
            "talkId": "6757703",
            "initDialog": "675770301",
            "dialogues": [
                {
                    "id": "675770301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675770302",
                    "speaker": "伊格纳特",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6757704",
            "initDialog": "675770401",
            "dialogues": [
                {
                    "id": "675770401",
                    "speaker": "Player",
                    "text": "够干什么？"
                },
                {
                    "id": "675770402",
                    "speaker": "伊格纳特",
                    "text": "在至冬堡弄个小房子…有大暖炉的那种…我家柳芭乌什卡她，怕冷…"
                },
                {
                    "id": "675770403",
                    "speaker": "伊格纳特",
                    "text": "我想让她，过得好点…彩冰镇太冷了，她住不习惯的…"
                }
            ]
        }
    ]
}