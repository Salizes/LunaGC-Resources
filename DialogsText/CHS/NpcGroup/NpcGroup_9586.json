{
    "groupId": "9586",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "希诺宁": 10
    },
    "talks": [
        {
            "talkId": "6958601",
            "initDialog": "695860101",
            "dialogues": [
                {
                    "id": "695860101",
                    "speaker": "希诺宁",
                    "text": "等等，我把工坊的门锁住了么？窗户好像也…不对不对，我好像…关了…？"
                }
            ]
        },
        {
            "talkId": "6958602",
            "initDialog": "695860201",
            "dialogues": [
                {
                    "id": "695860201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958603",
            "initDialog": "695860301",
            "dialogues": [
                {
                    "id": "695860301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695860302",
                    "speaker": "希诺宁",
                    "text": "你要走了？我还要在这里待一会，工坊里那么多单子…还是再偷会懒吧…"
                }
            ]
        },
        {
            "talkId": "6958604",
            "initDialog": "695860401",
            "dialogues": [
                {
                    "id": "695860401",
                    "speaker": "希诺宁",
                    "text": "赢了，玩这种卡牌游戏果然很吃熟练度啊…欸？我经常玩吗？呃…不经常，就是工作结束的时候稍微玩玩…"
                }
            ]
        },
        {
            "talkId": "6958605",
            "initDialog": "695860501",
            "dialogues": [
                {
                    "id": "695860501",
                    "speaker": "希诺宁",
                    "text": "输了输了，刚才出牌的时候突然想起了一单委托，脑子一下子乱了…"
                }
            ]
        },
        {
            "talkId": "6958606",
            "initDialog": "695860601",
            "dialogues": [
                {
                    "id": "695860601",
                    "speaker": "希诺宁",
                    "text": "要玩牌？来吧，我平时和部族里的人也玩过几局。"
                }
            ]
        },
        {
            "talkId": "6958608",
            "initDialog": "695860801",
            "dialogues": [
                {
                    "id": "695860801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958609",
            "initDialog": "695860901",
            "dialogues": [
                {
                    "id": "695860901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958610",
            "initDialog": "695861001",
            "dialogues": [
                {
                    "id": "695861001",
                    "speaker": "希诺宁",
                    "text": "赢了，看来平时那些牌局我也不算白玩啊。"
                }
            ]
        },
        {
            "talkId": "6958611",
            "initDialog": "695861101",
            "dialogues": [
                {
                    "id": "695861101",
                    "speaker": "希诺宁",
                    "text": "是你赢了，唔…看来你平时也没少玩牌啊。"
                }
            ]
        },
        {
            "talkId": "6958612",
            "initDialog": "695861201",
            "dialogues": [
                {
                    "id": "695861201",
                    "speaker": "希诺宁",
                    "text": "行，正好我也闲着。呼啊…休息的感觉就是好啊…"
                }
            ]
        },
        {
            "talkId": "6958614",
            "initDialog": "695861401",
            "dialogues": [
                {
                    "id": "695861401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958615",
            "initDialog": "695861501",
            "dialogues": [
                {
                    "id": "695861501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958616",
            "initDialog": "695861601",
            "dialogues": [
                {
                    "id": "695861601",
                    "speaker": "希诺宁",
                    "text": "这种牌玩起来还挺有趣的，用来打发时间再合适不过了，再来一局？"
                }
            ]
        },
        {
            "talkId": "6958617",
            "initDialog": "695861701",
            "dialogues": [
                {
                    "id": "695861701",
                    "speaker": "希诺宁",
                    "text": "唉，是我输了。总觉得脑子有点不清醒，难道是今天起床太早的原因么…"
                }
            ]
        },
        {
            "talkId": "6958618",
            "initDialog": "695861801",
            "dialogues": [
                {
                    "id": "695861801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}