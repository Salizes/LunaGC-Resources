{
    "groupId": "7031",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "卡缅科": 9
    },
    "talks": [
        {
            "talkId": "6703101",
            "initDialog": "670310101",
            "dialogues": [
                {
                    "id": "670310101",
                    "speaker": "卡缅科",
                    "text": "朋友！伙计！内部消息，至冬即将大规模推进月矩力生态，买下这些认购券就是投资未来。"
                }
            ]
        },
        {
            "talkId": "6703102",
            "initDialog": "670310201",
            "dialogues": [
                {
                    "id": "670310201",
                    "speaker": "Player",
                    "text": "认购券是什么？"
                },
                {
                    "id": "670310202",
                    "speaker": "卡缅科",
                    "text": "当然是「月矩力概念投资认购券」，投资圈的最新产品！"
                },
                {
                    "id": "670310203",
                    "speaker": "卡缅科",
                    "text": "只需五十万摩拉，就能买下这份「月矩力概念投资认购券」，现在入场还能吃到蓝海红利。"
                },
                {
                    "id": "670310204",
                    "speaker": "卡缅科",
                    "text": "别犹豫了，这是你离财富自由最近的距离！"
                }
            ]
        },
        {
            "talkId": "6703103",
            "initDialog": "670310301",
            "dialogues": [
                {
                    "id": "670310301",
                    "speaker": "Player",
                    "text": "不买，不买…"
                },
                {
                    "id": "670310302",
                    "speaker": "卡缅科",
                    "text": "哎，你可别后悔。错过了这次认知变现的机会，就没有下次了！"
                }
            ]
        },
        {
            "talkId": "6703104",
            "initDialog": "670310401",
            "dialogues": [
                {
                    "id": "670310401",
                    "speaker": "Player",
                    "text": "你看上去也不像赚钱了…"
                },
                {
                    "id": "670310402",
                    "speaker": "卡缅科",
                    "text": "这…这只是阶段性调整，市场情绪的波动是暂时的…"
                },
                {
                    "id": "670310403",
                    "speaker": "卡缅科",
                    "text": "越是这种时候越不能怀疑，你懂不懂。相信我，像我一样全仓买入！"
                },
                {
                    "id": "670310404",
                    "speaker": "卡缅科",
                    "text": "只要再拉到十个接…咳，十位像您一样睿智的战略投资者，马上就能回到高位！"
                }
            ]
        },
        {
            "talkId": "6703105",
            "initDialog": "670310501",
            "dialogues": [
                {
                    "id": "670310501",
                    "speaker": "Player",
                    "text": "还是算了吧。"
                },
                {
                    "id": "670310502",
                    "speaker": "卡缅科",
                    "text": "你要不再考虑考虑？机不可失啊，你如果对认购券还有顾虑，我这还有三十万的至冬国债券…"
                }
            ]
        }
    ]
}