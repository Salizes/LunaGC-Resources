{
    "groupId": "5238",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "勒克莱德": 10
    },
    "talks": [
        {
            "talkId": "6523801",
            "initDialog": "652380101",
            "dialogues": [
                {
                    "id": "652380101",
                    "speaker": "勒克莱德",
                    "text": "年轻人，听我说，离那些黄绿黄绿的石头越远越好！"
                }
            ]
        },
        {
            "talkId": "6523802",
            "initDialog": "652380201",
            "dialogues": [
                {
                    "id": "652380201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "652380202",
                    "speaker": "勒克莱德",
                    "text": "我只是个无关紧要的老头…"
                }
            ]
        },
        {
            "talkId": "6523803",
            "initDialog": "652380301",
            "dialogues": [
                {
                    "id": "652380301",
                    "speaker": "Player",
                    "text": "关于黄绿黄绿的石头…"
                },
                {
                    "id": "652380302",
                    "speaker": "勒克莱德",
                    "text": "那是很邪恶的石头！会给贪婪的人带去灾祸，让无知的人陷入不幸…"
                }
            ]
        },
        {
            "talkId": "6523804",
            "initDialog": "652380401",
            "dialogues": [
                {
                    "id": "652380401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652380402",
                    "speaker": "勒克莱德",
                    "text": "听我的，离它们越远越好！"
                }
            ]
        },
        {
            "talkId": "6523805",
            "initDialog": "652380501",
            "dialogues": [
                {
                    "id": "652380501",
                    "speaker": "勒克莱德",
                    "text": "健康这东西，就是失去之后才知道它的宝贵…"
                }
            ]
        },
        {
            "talkId": "6523806",
            "initDialog": "652380601",
            "dialogues": [
                {
                    "id": "652380601",
                    "speaker": "Player",
                    "text": "最近还好吗？"
                },
                {
                    "id": "652380602",
                    "speaker": "勒克莱德",
                    "text": "阿德纳医生的药剂非常有效，我的头痛治好了，现在头脑非常清醒，甚至让我想起过去还能救死扶伤的日子…"
                },
                {
                    "id": "652380603",
                    "speaker": "勒克莱德",
                    "text": "唉，都是我的错。你要多关心自己，任何小的征兆都不要忽视…"
                }
            ]
        },
        {
            "talkId": "6523807",
            "initDialog": "652380701",
            "dialogues": [
                {
                    "id": "652380701",
                    "speaker": "Player",
                    "text": "关于黄绿黄绿的石头…"
                },
                {
                    "id": "652380702",
                    "speaker": "勒克莱德",
                    "text": "肯定大有问题！"
                },
                {
                    "id": "652380703",
                    "speaker": "勒克莱德",
                    "text": "光是封锁通路根本不够，应该把它们全都销毁掉…它们就不该存在于这个世界上。"
                }
            ]
        },
        {
            "talkId": "6523808",
            "initDialog": "652380801",
            "dialogues": [
                {
                    "id": "652380801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652380802",
                    "speaker": "勒克莱德",
                    "text": "再见，记得离那些黄绿黄绿的石头越远越好！"
                }
            ]
        }
    ]
}