    "talks": [
        {
            "talkId": "6444501",
            "initDialog": "644450101",
            "dialogues": [
                {
                    "id": "644450101",
                    "speaker": "贾尔贾",
                    "text": "啊啦啦~啊啦啦~更难更远更有趣，让斯露莎大人也满意~"
                }
            ]
        },
        {
            "talkId": "6444502",
            "initDialog": "644450201",
            "dialogues": [
                {
                    "id": "644450201",
                    "speaker": "Player",
                    "text": "关于浮光鸣召…"
                },
                {
                    "id": "644450202",
                    "speaker": "贾尔贾",
                    "text": "哦？斯露莎大人的「谒颂主」，你来啦！"
                },
                {
                    "id": "644450203",
                    "speaker": "贾尔贾",
                    "text": "我还在思考怎么做出更有意思的赛道，请别心急。"
                },
                {
                    "id": "644450204",
                    "speaker": "贾尔贾",
                    "text": "以后还有机会，让你和斯露莎大人都玩个痛快！"
                }
            ]
        },
        {
            "talkId": "6444503",
            "initDialog": "644450301",
            "dialogues": [
                {
                    "id": "644450301",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "644450302",
                    "speaker": "贾尔贾",
                    "text": "既然斯露莎大人说过，时机得当的话，会来试试新的「浮光鸣召」…"
                },
                {
                    "id": "644450303",
                    "speaker": "贾尔贾",
                    "text": "那我一定要把以后的试炼规划得恰到好处才行。"
                },
                {
                    "id": "644450304",
                    "speaker": "贾尔贾",
                    "text": "既不能让斯露莎大人觉得无聊，也不能让她觉得麻烦！"
                }
            ]
        },
        {
            "talkId": "6444504",
            "initDialog": "644450401",
            "dialogues": [
                {
                    "id": "644450401",
                    "speaker": "Player",
                    "text": "你先忙！"
                },
                {
                    "id": "644450402",
                    "speaker": "贾尔贾",
                    "text": "不忙不忙！如果想和我聊天，随时都可以来找我啦。"
                }
            ]
        }
    ]
}