    "talks": [
        {
            "talkId": "6210901",
            "initDialog": "621090101",
            "dialogues": [
                {
                    "id": "621090101",
                    "speaker": "大迷糊",
                    "text": "啊，千岩牢固，重嶂不移！"
                },
                {
                    "id": "621090102",
                    "speaker": "大迷糊",
                    "text": "等等，咱们又不熟，你怎么随便向我搭话？真没礼貌！"
                }
            ]
        },
        {
            "talkId": "6210902",
            "initDialog": "621090201",
            "dialogues": [
                {
                    "id": "621090201",
                    "speaker": "Player",
                    "text": "没、没礼貌？"
                },
                {
                    "id": "621090202",
                    "speaker": "大迷糊",
                    "text": "没见我在站岗吗？要向我搭话的话，至少提前打声招呼啊？"
                },
                {
                    "id": "621090203",
                    "speaker": "大迷糊",
                    "text": "打招呼不也需要搭话吗…"
                },
                {
                    "id": "621090204",
                    "speaker": "大迷糊",
                    "text": "那你打招呼之前，提前跟我说一声不就好了…真是的…"
                }
            ]
        },
        {
            "talkId": "6210903",
            "initDialog": "621090301",
            "dialogues": [
                {
                    "id": "621090301",
                    "speaker": "Player",
                    "text": "不好意思，打扰了。"
                },
                {
                    "id": "621090302",
                    "speaker": "大迷糊",
                    "text": "这才像话，路上小心。"
                }
            ]
        }
    ]
}