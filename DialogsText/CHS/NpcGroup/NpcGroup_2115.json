{
    "groupId": "2115",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "青莲": 11
    },
    "talks": [
        {
            "talkId": "7194301",
            "initDialog": "719430101",
            "dialogues": [
                {
                    "id": "719430101",
                    "speaker": "Player",
                    "text": "你们还真是辛苦啊…"
                },
                {
                    "id": "719430102",
                    "speaker": "青莲",
                    "text": "对了，我的身体如今已经不需要这么多药草了…我现在需要的只是丈夫的陪伴而已。"
                },
                {
                    "id": "719430103",
                    "speaker": "青莲",
                    "text": "感谢你的倾听，若是不嫌弃就请收下这些吧。"
                }
            ]
        },
        {
            "talkId": "6211501",
            "initDialog": "621150101",
            "dialogues": [
                {
                    "id": "621150101",
                    "speaker": "青莲",
                    "text": "咳咳，旅行者你好…咳咳，不好意思，我得了重病，有些止不住咳嗽…"
                }
            ]
        },
        {
            "talkId": "6211502",
            "initDialog": "621150201",
            "dialogues": [
                {
                    "id": "621150201",
                    "speaker": "Player",
                    "text": "感觉你的气色还不错…"
                },
                {
                    "id": "621150202",
                    "speaker": "青莲",
                    "text": "啊，真的吗…这么容易被看穿的话就糟糕了…"
                },
                {
                    "id": "621150203",
                    "speaker": "青莲",
                    "text": "嗯…我告诉你实情吧，你可千万别和我丈夫说。"
                },
                {
                    "id": "621150204",
                    "speaker": "青莲",
                    "text": "我丈夫是位水手，常年在海上漂泊难以相见…"
                },
                {
                    "id": "621150205",
                    "speaker": "青莲",
                    "text": "可自从我生病之后，我的丈夫便辞去了水手的工作专心照顾我，甚至亲自来山里采药。"
                },
                {
                    "id": "621150206",
                    "speaker": "青莲",
                    "text": "这样的日子虽然清贫，却也快乐。可想到一旦我痊愈的话，就会失去这种生活…"
                },
                {
                    "id": "621150207",
                    "speaker": "青莲",
                    "text": "我不能接受，至少还没有勇气去面对，所以一直瞒着他我已经痊愈了的事。"
                },
                {
                    "id": "621150208",
                    "speaker": "青莲",
                    "text": "唉，我还真是个自私的女人…"
                }
            ]
        },
        {
            "talkId": "6211503",
            "initDialog": "621150301",
            "dialogues": [
                {
                    "id": "621150301",
                    "speaker": "Player",
                    "text": "祝你健康。"
                },
                {
                    "id": "621150302",
                    "speaker": "青莲",
                    "text": "嗯，谢谢你的祝福，咳咳。"
                }
            ]
        }
    ]
}