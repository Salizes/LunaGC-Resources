{
    "groupId": "9032",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 17,
        "班尼特": 47
    },
    "talks": [
        {
            "talkId": "6903201",
            "initDialog": "690320101",
            "dialogues": [
                {
                    "id": "690320101",
                    "speaker": "班尼特",
                    "text": "#{NICKNAME}！嘿嘿…你好啊。"
                },
                {
                    "id": "690320102",
                    "speaker": "班尼特",
                    "text": "看来今天我的运气很不错嘛。"
                }
            ]
        },
        {
            "talkId": "6903202",
            "initDialog": "690320201",
            "dialogues": [
                {
                    "id": "690320201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690320202",
                    "speaker": "班尼特",
                    "text": "嗯！这里非常棒！"
                },
                {
                    "id": "690320203",
                    "speaker": "班尼特",
                    "text": "比我在冒险时候露宿的地方，好上太多了！"
                },
                {
                    "id": "690320204",
                    "speaker": "班尼特",
                    "text": "不用躲在树洞里休息，也不用担心魔物的突袭。"
                },
                {
                    "id": "690320205",
                    "speaker": "班尼特",
                    "text": "还有天上砸下来的石头…地里突然蹦出来的骗骗花…",
                    "choices": [
                        {
                            "id": "690320206",
                            "text": "那冒险之余，多来坐坐吧。",
                            "response": [
                                {
                                    "id": "690320207",
                                    "speaker": "班尼特",
                                    "text": "可、可以吗！太棒了！"
                                },
                                {
                                    "id": "690320208",
                                    "speaker": "班尼特",
                                    "text": "我是多幸运啊，能够认识你这样好心的搭档！"
                                },
                                {
                                    "id": "690320212",
                                    "speaker": "班尼特",
                                    "text": "嘿嘿…今后，也要给你添麻烦啦。"
                                }
                            ]
                        },
                        {
                            "id": "690320209",
                            "text": "这也太…辛苦了。",
                            "response": [
                                {
                                    "id": "690320210",
                                    "speaker": "班尼特",
                                    "text": "没有没有…冒险嘛，都这样。"
                                },
                                {
                                    "id": "690320211",
                                    "speaker": "班尼特",
                                    "text": "有你的关怀，我已经什么伤口都不觉得疼了！真的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903203",
            "initDialog": "690320301",
            "dialogues": [
                {
                    "id": "690320301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690320302",
                    "speaker": "班尼特",
                    "text": "好呀，和你说说我冒险的见闻吧！"
                },
                {
                    "id": "690320303",
                    "speaker": "班尼特",
                    "text": "嗯…前几天，我在冒险途中发现了一种颜色奇怪的树莓。"
                },
                {
                    "id": "690320304",
                    "speaker": "班尼特",
                    "text": "甜倒是很甜，就是…"
                },
                {
                    "id": "690320305",
                    "speaker": "Player",
                    "text": "难道拉肚子了？"
                },
                {
                    "id": "690320306",
                    "speaker": "班尼特",
                    "text": "啊，拉肚子什么的，我倒是习惯了啦。"
                },
                {
                    "id": "690320307",
                    "speaker": "班尼特",
                    "text": "一开始是有色彩斑斓的光点，后面变成了小人手拉手在脑袋里跳舞。"
                },
                {
                    "id": "690320308",
                    "speaker": "班尼特",
                    "text": "我人倒是好得也快，就是遗憾也没放点在包里…"
                },
                {
                    "id": "690320309",
                    "speaker": "班尼特",
                    "text": "告诉大家，这种树莓不能吃。",
                    "choices": [
                        {
                            "id": "690320310",
                            "text": "班尼特真的很考虑别人呢…",
                            "response": [
                                {
                                    "id": "690320311",
                                    "speaker": "班尼特",
                                    "text": "哎呀…这也是应该的。"
                                },
                                {
                                    "id": "690320312",
                                    "speaker": "班尼特",
                                    "text": "我受到那么多人的照顾，当然也要回报大家！"
                                },
                                {
                                    "id": "690320315",
                                    "speaker": "班尼特",
                                    "text": "哦，对了！下次有冒险记得叫上我哦，有我在的话，我能帮你避开这些危险！"
                                }
                            ]
                        },
                        {
                            "id": "690320313",
                            "text": "班尼特也要更小心自己…",
                            "response": [
                                {
                                    "id": "690320314",
                                    "speaker": "班尼特",
                                    "text": "谢谢你…不过，有时候我小心了也没用。还不如提醒提醒别人。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903204",
            "initDialog": "690320401",
            "dialogues": [
                {
                    "id": "690320401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690320402",
                    "speaker": "班尼特",
                    "text": "对于冒险家来说，想做的事情，果然还是冒险吧！"
                },
                {
                    "id": "690320403",
                    "speaker": "班尼特",
                    "text": "为了终点的宝藏，踏上未知的旅途…"
                },
                {
                    "id": "690320404",
                    "speaker": "班尼特",
                    "text": "不对不对…我想说的是，想成为你的助力！"
                },
                {
                    "id": "690320405",
                    "speaker": "班尼特",
                    "text": "你看…我虽然没有什么体格上的特长，但我不怕疼痛，可以适应持久的战斗！"
                },
                {
                    "id": "690320406",
                    "speaker": "班尼特",
                    "text": "虽然经常因为意外受伤，但包扎伤口的手法非常熟练！",
                    "choices": [
                        {
                            "id": "690320407",
                            "text": "这些我都明白…",
                            "response": [
                                {
                                    "id": "690320408",
                                    "speaker": "班尼特",
                                    "text": "对，对哦…我们一起行动那么久了…"
                                },
                                {
                                    "id": "690320411",
                                    "speaker": "班尼特",
                                    "text": "…关于这个问题，我其实也思考过很多次了。"
                                },
                                {
                                    "id": "690320412",
                                    "speaker": "班尼特",
                                    "text": "我当然也会坚持我的使命。但使命之外的追求，也算是我的私心吧。"
                                },
                                {
                                    "id": "690320413",
                                    "speaker": "班尼特",
                                    "text": "我想要成为能让你信任、能让你依靠的人。"
                                },
                                {
                                    "id": "690320414",
                                    "speaker": "班尼特",
                                    "text": "患难与共的伙伴，来之不易的幸运…"
                                },
                                {
                                    "id": "690320415",
                                    "speaker": "班尼特",
                                    "text": "这一次，我想成为你的力量！",
                                    "choices": [
                                        {
                                            "id": "690320416",
                                            "text": "你一直都是我重要的同伴。",
                                            "response": [
                                                {
                                                    "id": "690320418",
                                                    "speaker": "班尼特",
                                                    "text": "...谢、谢谢你。"
                                                },
                                                {
                                                    "id": "690320419",
                                                    "speaker": "班尼特",
                                                    "text": "呜…我这是…怎么了。明明是那么开心的事情。"
                                                },
                                                {
                                                    "id": "690320420",
                                                    "speaker": "班尼特",
                                                    "text": "谢谢你…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690320417",
                                            "text": "我也会把我的好运分给你。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690320409",
                            "text": "为什么会想要成为我的助力呢？",
                            "response": [
                                {
                                    "id": "690320410",
                                    "speaker": "班尼特",
                                    "text": "那还用说！你可是我最崇拜的冒险家！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903205",
            "initDialog": "690320501",
            "dialogues": [
                {
                    "id": "690320501",
                    "speaker": "Player",
                    "text": "早啊，班尼特。"
                },
                {
                    "id": "690320502",
                    "speaker": "班尼特",
                    "text": "#早！{NICKNAME}！"
                },
                {
                    "id": "690320503",
                    "speaker": "班尼特",
                    "text": "新的一天，我们也一起踏上新的冒险吧！"
                }
            ]
        },
        {
            "talkId": "6903206",
            "initDialog": "690320601",
            "dialogues": [
                {
                    "id": "690320601",
                    "speaker": "Player",
                    "text": "晚安，班尼特。"
                },
                {
                    "id": "690320602",
                    "speaker": "班尼特",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690320603",
                    "speaker": "班尼特",
                    "text": "充分的休息对第二天的冒险非常重要！千万记得别熬夜哦。"
                }
            ]
        },
        {
            "talkId": "6903207",
            "initDialog": "690320701",
            "dialogues": [
                {
                    "id": "690320701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903208",
            "initDialog": "690320801",
            "dialogues": [
                {
                    "id": "690320801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903209",
            "initDialog": "690320901",
            "dialogues": [
                {
                    "id": "690320901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903250",
            "initDialog": "690325001",
            "dialogues": [
                {
                    "id": "690325001",
                    "speaker": "班尼特",
                    "text": "这顶帐篷的质量真不错！还有放在地上的行囊，是要好多摩拉才能买到的限定款！"
                },
                {
                    "id": "690325002",
                    "speaker": "班尼特",
                    "text": "要是「班尼冒险团」能给每个人配发这样的装备，哪还用为招募成员这种事发愁…"
                },
                {
                    "id": "690325003",
                    "speaker": "班尼特",
                    "text": "没什么！哈哈哈…让你费心了。"
                }
            ]
        },
        {
            "talkId": "6903251",
            "initDialog": "690325101",
            "dialogues": [
                {
                    "id": "690325101",
                    "speaker": "班尼特",
                    "text": "成色上好的矿石…完善的工具台…还有大尺寸的铁砧和熔炉！"
                },
                {
                    "id": "690325102",
                    "speaker": "班尼特",
                    "text": "太棒了，完全不比瓦格纳先生的铁匠铺差嘛！无论什么装备都能修好！"
                },
                {
                    "id": "690325103",
                    "speaker": "班尼特",
                    "text": "拜托了，请让我租用这里吧！"
                }
            ]
        }
    ]
}