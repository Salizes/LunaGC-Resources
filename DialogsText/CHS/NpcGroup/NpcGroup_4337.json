{
    "groupId": "4337",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "齐米娅": 9
    },
    "talks": [
        {
            "talkId": "6433701",
            "initDialog": "643370101",
            "dialogues": [
                {
                    "id": "643370101",
                    "speaker": "齐米娅",
                    "text": "每天推荐这么多份档案上来，结果一个能用的都没有，又有什么意义呢。"
                }
            ]
        },
        {
            "talkId": "6433702",
            "initDialog": "643370201",
            "dialogues": [
                {
                    "id": "643370201",
                    "speaker": "Player",
                    "text": "你是指…"
                },
                {
                    "id": "643370202",
                    "speaker": "齐米娅",
                    "text": "教令院欢迎各界有识之士加入，毕竟人才永远是稀缺资源。"
                },
                {
                    "id": "643370203",
                    "speaker": "齐米娅",
                    "text": "但有些同事操之过急，什么人都敢推荐过来。他们只求数量却忽视了品质，导致我的书案上堆积了过多的人事档案。"
                },
                {
                    "id": "643370204",
                    "speaker": "齐米娅",
                    "text": "恕我直言，这里面的大部分…基本都是可燃垃圾罢了。"
                },
                {
                    "id": "643370205",
                    "speaker": "齐米娅",
                    "text": "哼，推荐这些进来的人也不好好想想，加入的笨蛋越多，我们每天就要为处理更多的傻事而费心，效率反而会降低的。"
                }
            ]
        },
        {
            "talkId": "6433703",
            "initDialog": "643370301",
            "dialogues": [
                {
                    "id": "643370301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643370302",
                    "speaker": "齐米娅",
                    "text": "再见，希望能有更多真正优秀的人才加入教令院。"
                }
            ]
        },
        {
            "talkId": "6433704",
            "initDialog": "643370401",
            "dialogues": [
                {
                    "id": "643370401",
                    "speaker": "Player",
                    "text": "一个能用的都没有吗？"
                },
                {
                    "id": "643370402",
                    "speaker": "齐米娅",
                    "text": "本着严谨的态度，我话不说绝对——但的确可用之人少之又少。"
                },
                {
                    "id": "643370403",
                    "speaker": "齐米娅",
                    "text": "反而是本学院毕业的学生，虽然没有工作经验，但在多年的学习中养成了良好的研究习惯和做事态度。"
                },
                {
                    "id": "643370404",
                    "speaker": "齐米娅",
                    "text": "与其招募那些仅有虚名却不甚靠谱的外人，还不如多给我们自己的学生一些机会吧。"
                }
            ]
        }
    ]
}