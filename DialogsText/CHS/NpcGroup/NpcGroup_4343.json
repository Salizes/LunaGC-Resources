{
    "groupId": "4343",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "伊萨米": 12
    },
    "talks": [
        {
            "talkId": "6434301",
            "initDialog": "643430101",
            "dialogues": [
                {
                    "id": "643430101",
                    "speaker": "伊萨米",
                    "text": "那个雇佣兵…应该不是什么坏人吧？毕竟这里多是草木，也没什么值得他惦记的东西。"
                }
            ]
        },
        {
            "talkId": "6434302",
            "initDialog": "643430201",
            "dialogues": [
                {
                    "id": "643430201",
                    "speaker": "Player",
                    "text": "雇佣兵是？"
                },
                {
                    "id": "643430202",
                    "speaker": "伊萨米",
                    "text": "啊，我说的是那位在附近看守的沙欣先生。"
                },
                {
                    "id": "643430203",
                    "speaker": "伊萨米",
                    "text": "像他这么爱问问题的镀金旅团成员，我还是第一次见到。"
                },
                {
                    "id": "643430204",
                    "speaker": "伊萨米",
                    "text": "我曾以为镀金旅团里尽是些寡言少语的硬派家伙，真是大错特错了。"
                },
                {
                    "id": "643430205",
                    "speaker": "伊萨米",
                    "text": "我不讨厌热情的人，但他总是问这里是做什么的、那里都放着些什么东西…让我有些吃不消。"
                },
                {
                    "id": "643430206",
                    "speaker": "伊萨米",
                    "text": "主要是，看他那个好奇的样子，确实不像是图谋不轨。我也不至于因为他口头的几个问题，就劳动风纪官出马…"
                },
                {
                    "id": "643430207",
                    "speaker": "伊萨米",
                    "text": "所以，也只好尽量敷衍他了。"
                }
            ]
        },
        {
            "talkId": "6434303",
            "initDialog": "643430301",
            "dialogues": [
                {
                    "id": "643430301",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "643430302",
                    "speaker": "伊萨米",
                    "text": "这里名为禅那园，是隶属于教令院生论派的研究场所。你在这里可以见到研究植物、蕈类，甚至昆虫等课题的人员。"
                },
                {
                    "id": "643430303",
                    "speaker": "伊萨米",
                    "text": "大部分都是来自教令院的学者或学生，也有一些是与禅那园有着紧密关联的合作者。"
                },
                {
                    "id": "643430304",
                    "speaker": "伊萨米",
                    "text": "比如化城郭有一位巡林官，他以前上学时就整天泡在这里，现在即便离开了教令院，也经常回来做研究。"
                },
                {
                    "id": "643430305",
                    "speaker": "伊萨米",
                    "text": "他的研究成果都很宝贵，所以禅那园这边也愿意为巡林员们的工作提供协助。算是一种互惠互利的良好合作吧。"
                }
            ]
        },
        {
            "talkId": "6434304",
            "initDialog": "643430401",
            "dialogues": [
                {
                    "id": "643430401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643430402",
                    "speaker": "伊萨米",
                    "text": "再见。"
                }
            ]
        }
    ]
}