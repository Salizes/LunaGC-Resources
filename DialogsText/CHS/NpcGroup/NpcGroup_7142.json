{
    "groupId": "7142",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 2,
        "菲林斯": 21
    },
    "talks": [
        {
            "talkId": "7665502",
            "initDialog": "766550201",
            "dialogues": [
                {
                    "id": "766550201",
                    "speaker": "菲林斯",
                    "text": "在不同的地方，宝石会折射出不同的光芒。"
                },
                {
                    "id": "766550202",
                    "speaker": "菲林斯",
                    "text": "烛光下的宝石和火焰一样闪烁，月光下的宝石就像流泪的眼睛。"
                },
                {
                    "id": "766550203",
                    "speaker": "菲林斯",
                    "text": "美有一千种形式，宝石被切割出许多面，优雅隽永的东西总是复杂的。"
                },
                {
                    "id": "766550204",
                    "speaker": "菲林斯",
                    "text": "这些旧宝石是我的收藏，它们中的有些甚至来自异国，我随时欢迎你来观赏。"
                },
                {
                    "id": "766550205",
                    "speaker": "菲林斯",
                    "text": "因为是些旧物件，光芒有些浑浊，到底不如刚刚打磨切割好的宝石亮眼。"
                },
                {
                    "id": "766550206",
                    "speaker": "菲林斯",
                    "text": "触碰的时候也请小心，为了不破坏它们，多数宝石都还嵌在它们原来所在的地方。"
                }
            ]
        },
        {
            "talkId": "7665503",
            "initDialog": "766550301",
            "dialogues": [
                {
                    "id": "766550301",
                    "speaker": "菲林斯",
                    "text": "又写完三份报告，我需要出来喘口气。"
                },
                {
                    "id": "766550302",
                    "speaker": "菲林斯",
                    "text": "#{NICKNAME}…你在冒险家协会需要写报告吗？",
                    "choices": [
                        {
                            "id": "766550303",
                            "text": "不常写。",
                            "response": [
                                {
                                    "id": "766550304",
                                    "speaker": "菲林斯",
                                    "text": "这是一种幸运，请务必珍惜。"
                                },
                                {
                                    "id": "766550307",
                                    "speaker": "菲林斯",
                                    "text": "直到今天我也没法适应永远写不完的报告，从前的挪德卡莱没有报告这种东西。"
                                },
                                {
                                    "id": "766550308",
                                    "speaker": "菲林斯",
                                    "text": "我能理解报告的必要性，但是一遍又一遍详细描述那些一句话就能概括的事，实在是耗神。"
                                },
                                {
                                    "id": "766550309",
                                    "speaker": "菲林斯",
                                    "text": "一想到还有好几份报告等着我回去写完…"
                                },
                                {
                                    "id": "766550310",
                                    "speaker": "菲林斯",
                                    "text": "不，想一想报告的必要性，执灯士总是要写报告的。"
                                },
                                {
                                    "id": "766550311",
                                    "speaker": "菲林斯",
                                    "text": "我就在这里待一会儿，就一会儿。"
                                }
                            ]
                        },
                        {
                            "id": "766550305",
                            "text": "每天写。",
                            "response": [
                                {
                                    "id": "766550306",
                                    "speaker": "菲林斯",
                                    "text": "看来你的运气也不太好，就和我一样。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7665504",
            "initDialog": "766550401",
            "dialogues": [
                {
                    "id": "766550401",
                    "speaker": "菲林斯",
                    "text": "嘘，请把脚步放轻一点。"
                },
                {
                    "id": "766550402",
                    "speaker": "菲林斯",
                    "text": "这里的鱼习惯了安静的环境，对外界的声音很敏感。"
                },
                {
                    "id": "766550403",
                    "speaker": "菲林斯",
                    "text": "我们说话的时候，最好也把声音压低些。"
                },
                {
                    "id": "766550404",
                    "speaker": "菲林斯",
                    "text": "之前，有两个鬼魂在我钓鱼的时候一直在旁边说话，那天我一条鱼也没有钓上。"
                },
                {
                    "id": "766550405",
                    "speaker": "菲林斯",
                    "text": "从那天之后，我在钓鱼前都会和周遭的鬼魂打好招呼，请他们去别处聊天。"
                },
                {
                    "id": "766550406",
                    "speaker": "菲林斯",
                    "text": "今晚，我希望餐桌上能出现鱼肉，绝对不能空手而归。"
                }
            ]
        }
    ]
}