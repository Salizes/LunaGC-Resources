    "talks": [
        {
            "talkId": "6183901",
            "initDialog": "618390101",
            "dialogues": [
                {
                    "id": "618390101",
                    "speaker": "卡斯蒂廖内",
                    "text": "传模移写，气韵生动…不错，这才是极致的构图啊！"
                }
            ]
        },
        {
            "talkId": "6183902",
            "initDialog": "618390201",
            "dialogues": [
                {
                    "id": "618390201",
                    "speaker": "Player",
                    "text": "你也是璃月人吗？"
                },
                {
                    "id": "618390202",
                    "speaker": "卡斯蒂廖内",
                    "text": "不是不是，您误会了，我是来自佩特莉可镇的枫丹人。"
                },
                {
                    "id": "618390203",
                    "speaker": "卡斯蒂廖内",
                    "text": "只不过，既然来到了这如同仙境的宝地，自然要换上璃月雅士的衣冠，方能对得起这满眼的如画江山。"
                }
            ]
        },
        {
            "talkId": "6183903",
            "initDialog": "618390301",
            "dialogues": [
                {
                    "id": "618390301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "618390302",
                    "speaker": "卡斯蒂廖内",
                    "text": "嗯。您要是见了莫基，麻烦和他说一声，他那个错视技法实在是太烂了。"
                }
            ]
        }
    ]
}