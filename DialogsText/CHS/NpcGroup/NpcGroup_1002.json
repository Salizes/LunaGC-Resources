{
    "groupId": "1002",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "乔尔": 3,
        "优菈": 2,
        "安柏": 10
    },
    "talks": [
        {
            "talkId": "4002812",
            "initDialog": "400281201",
            "dialogues": [
                {
                    "id": "400281201",
                    "speaker": "安柏",
                    "text": "哈哈哈，好久没有像这样堆雪人了，真好玩！就是有点冷…呜…手指麻麻的…"
                },
                {
                    "id": "400281202",
                    "speaker": "优菈",
                    "text": "安柏，觉得冷可以回营地喝口热汤，休息一会儿。不必勉强自己。"
                },
                {
                    "id": "400281203",
                    "speaker": "乔尔",
                    "text": "原来安柏姐姐会怕冷啊…优菈姐姐看起来完全没问题呢。"
                },
                {
                    "id": "400281204",
                    "speaker": "优菈",
                    "text": "也许因为我们有着不同的能力吧。元素力…咳，抱歉，不是什么该跟你提的话题。总之，这就是能力上的区分了。"
                },
                {
                    "id": "400281205",
                    "speaker": "安柏",
                    "text": "是啊，抗寒能力也是一种能力嘛。优菈很耐寒，有时候夏天站在她身边也会觉得凉爽呢！"
                },
                {
                    "id": "400281206",
                    "speaker": "乔尔",
                    "text": "唔…能力？这些我不太明白…不过没关系，我也喜欢雪人哦。"
                },
                {
                    "id": "400281207",
                    "speaker": "乔尔",
                    "text": "我…我真希望爸爸能看到这些雪人呀…"
                }
            ]
        },
        {
            "talkId": "30603",
            "initDialog": "3060301",
            "dialogues": [
                {
                    "id": "3060301",
                    "speaker": "安柏",
                    "text": "要和我组队吗？事先声明，我可不会特意配合新手放慢步调喔。",
                    "choices": [
                        {
                            "id": "3060302",
                            "text": "琴团长看起来很可靠呢。",
                            "response": [
                                {
                                    "id": "3060303",
                                    "speaker": "安柏",
                                    "text": "有琴在，我们就安心了——虽然很想这么说…"
                                },
                                {
                                    "id": "3060304",
                                    "speaker": "安柏",
                                    "text": "但实在不能总把这句话挂在嘴边。"
                                },
                                {
                                    "id": "3060305",
                                    "speaker": "安柏",
                                    "text": "她总是冲在最前面，我们也希望她能好好休息。"
                                },
                                {
                                    "id": "3060306",
                                    "speaker": "安柏",
                                    "text": "希望有一天可以认真地告诉琴，有我们在，你就可以安心了…"
                                }
                            ]
                        },
                        {
                            "id": "3060307",
                            "text": "关于风之翼。",
                            "response": [
                                {
                                    "id": "3060308",
                                    "speaker": "安柏",
                                    "text": "身为西风骑士团的新人，对「风」的领会是不可或缺的品质。"
                                },
                                {
                                    "id": "3060309",
                                    "speaker": "安柏",
                                    "text": "那么，风之翼的深入培训就交给我吧~！"
                                }
                            ]
                        },
                        {
                            "id": "3060310",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "3060311",
                                    "speaker": "安柏",
                                    "text": "嗯，风魔龙的事，一起加把劲吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}