{
    "groupId": "3026",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "真田": 10
    },
    "talks": [
        {
            "talkId": "6302601",
            "initDialog": "630260101",
            "dialogues": [
                {
                    "id": "630260101",
                    "speaker": "真田",
                    "text": "唉，怎么又只剩我一个人了…你好，有事吗？"
                }
            ]
        },
        {
            "talkId": "6302602",
            "initDialog": "630260201",
            "dialogues": [
                {
                    "id": "630260201",
                    "speaker": "Player",
                    "text": "只剩你一个？"
                },
                {
                    "id": "630260202",
                    "speaker": "真田",
                    "text": "最近和我一起站岗的同事，总是擅离职守。一不留神，就只有我一个当班的了。"
                },
                {
                    "id": "630260203",
                    "speaker": "真田",
                    "text": "我在犹豫要不要向上级报告此事…"
                }
            ]
        },
        {
            "talkId": "6302603",
            "initDialog": "630260301",
            "dialogues": [
                {
                    "id": "630260301",
                    "speaker": "Player",
                    "text": "见过和我长得很像的人吗？"
                },
                {
                    "id": "630260302",
                    "speaker": "真田",
                    "text": "真不好说。花见坂往来的人太多了，又经常只有我一个人当班，如何记得清。"
                },
                {
                    "id": "630260303",
                    "speaker": "真田",
                    "text": "真是的，有些人就不能好好工作吗…"
                }
            ]
        },
        {
            "talkId": "6302604",
            "initDialog": "630260401",
            "dialogues": [
                {
                    "id": "630260401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630260402",
                    "speaker": "真田",
                    "text": "常道恢弘，鸣神永恒。我得再想想…"
                }
            ]
        },
        {
            "talkId": "6302605",
            "initDialog": "630260501",
            "dialogues": [
                {
                    "id": "630260501",
                    "speaker": "Player",
                    "text": "必须告发。"
                },
                {
                    "id": "630260502",
                    "speaker": "真田",
                    "text": "可如果传出去，他们说我是会打小报告的小人，以后在职场上排挤我怎么办呢？"
                },
                {
                    "id": "630260503",
                    "speaker": "真田",
                    "text": "我可不想在奉行所里落下坏名声，对升职会有影响的…"
                }
            ]
        },
        {
            "talkId": "6302606",
            "initDialog": "630260601",
            "dialogues": [
                {
                    "id": "630260601",
                    "speaker": "Player",
                    "text": "不要多事…"
                },
                {
                    "id": "630260602",
                    "speaker": "真田",
                    "text": "话虽如此，可万一出了什么麻烦事，我一个人怎么顾得过来啊。"
                },
                {
                    "id": "630260603",
                    "speaker": "真田",
                    "text": "这一带都要我来巡逻，也太难为人了。唉，好痛苦…"
                }
            ]
        }
    ]
}