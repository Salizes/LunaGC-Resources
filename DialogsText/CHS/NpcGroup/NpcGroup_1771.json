            "dialogues": [
                {
                    "id": "617710101",
                    "speaker": "列兹伯格",
                    "text": "嗯，待会得记得再买点胡萝卜，回家可以做蜜酱煎肉吃…"
                }
            ]
        },
        {
            "talkId": "6177102",
            "initDialog": "617710201",
            "dialogues": [
                {
                    "id": "617710201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "617710202",
                    "speaker": "列兹伯格",
                    "text": "哦哦，你好！是要买什么东西吗？"
                },
                {
                    "id": "617710203",
                    "speaker": "列兹伯格",
                    "text": "我只是路过想买点胡萝卜，好回家做胡萝卜蜜酱煎肉，可是老板突然有事，反而拜托我看一下摊子…"
                },
                {
                    "id": "617710204",
                    "speaker": "列兹伯格",
                    "text": "于是我只好先帮帮忙啦，希望他能早点回来。"
                }
            ]
        },
        {
            "talkId": "6177103",
            "initDialog": "617710301",
            "dialogues": [
                {
                    "id": "617710301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617710302",
                    "speaker": "列兹伯格",
                    "text": "嗯，慢走。"
                }
            ]
        }
    ]
