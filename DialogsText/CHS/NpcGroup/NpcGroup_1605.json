{
    "groupId": "1605",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 8,
        "艾琳": 25
    },
    "talks": [
        {
            "talkId": "6160507",
            "initDialog": "616050701",
            "dialogues": [
                {
                    "id": "616050701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6160508",
            "initDialog": "616050801",
            "dialogues": [
                {
                    "id": "616050801",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6160509",
            "initDialog": "616050901",
            "dialogues": [
                {
                    "id": "616050901",
                    "speaker": "艾琳",
                    "text": "原，原来还可以用这种方式获胜吗…呜…"
                }
            ]
        },
        {
            "talkId": "6160510",
            "initDialog": "616051001",
            "dialogues": [
                {
                    "id": "616051001",
                    "speaker": "艾琳",
                    "text": "这一局就由我拿下啦！"
                }
            ]
        },
        {
            "talkId": "6160511",
            "initDialog": "616051101",
            "dialogues": [
                {
                    "id": "616051101",
                    "speaker": "艾琳",
                    "text": "到底要怎么样才能看穿别人的战术…"
                }
            ]
        },
        {
            "talkId": "6160512",
            "initDialog": "616051201",
            "dialogues": [
                {
                    "id": "616051201",
                    "speaker": "艾琳",
                    "text": "太棒了！谢谢你陪我打牌！"
                }
            ]
        },
        {
            "talkId": "7091301",
            "initDialog": "709130101",
            "dialogues": [
                {
                    "id": "709130101",
                    "speaker": "Player",
                    "text": "祝你成功。"
                },
                {
                    "id": "709130102",
                    "speaker": "艾琳",
                    "text": "谢谢，我一定会成功的，就像《侍从骑士之歌》的那位「晨曦骑士」一样…"
                },
                {
                    "id": "709130103",
                    "speaker": "艾琳",
                    "text": "你看过这本书了吗？我可是看了很多遍的！如果有空的话，请一定要看看。"
                }
            ]
        },
        {
            "talkId": "6160501",
            "initDialog": "616050101",
            "dialogues": [
                {
                    "id": "616050101",
                    "speaker": "艾琳",
                    "text": "有什么事吗？不好意思，我出了不少汗。"
                }
            ]
        },
        {
            "talkId": "6160502",
            "initDialog": "616050201",
            "dialogues": [
                {
                    "id": "616050201",
                    "speaker": "Player",
                    "text": "你的剑法…"
                },
                {
                    "id": "616050202",
                    "speaker": "艾琳",
                    "text": "呼…我在模仿琴大人挥剑的方式。"
                },
                {
                    "id": "616050203",
                    "speaker": "艾琳",
                    "text": "每一次挥击都会感觉——真不愧是琴大人啊！"
                },
                {
                    "id": "616050204",
                    "speaker": "艾琳",
                    "text": "那种剑法，一定是精神无比强大的人才能用得出的吧？"
                },
                {
                    "id": "616050205",
                    "speaker": "艾琳",
                    "text": "看来不能一味练习力量，精神的修行也要准备开始了！"
                }
            ]
        },
        {
            "talkId": "6160503",
            "initDialog": "616050301",
            "dialogues": [
                {
                    "id": "616050301",
                    "speaker": "Player",
                    "text": "关于骑士团…"
                },
                {
                    "id": "616050302",
                    "speaker": "艾琳",
                    "text": "是吗？觉得我像骑士团的人吗？真的吗！？"
                },
                {
                    "id": "616050303",
                    "speaker": "艾琳",
                    "text": "啊哈哈哈哈，这就是修炼的成果吧？"
                },
                {
                    "id": "616050304",
                    "speaker": "艾琳",
                    "text": "虽然我现在还不是，但我一定会通过骑士选拔的。"
                },
                {
                    "id": "616050305",
                    "speaker": "艾琳",
                    "text": "然后晋升队长，再被提拔为琴大人的副手，等琴大人年迈退休的那天，她会握着我的手说…"
                },
                {
                    "id": "616050306",
                    "speaker": "艾琳",
                    "text": "啊，好像说得太远了，总之等着瞧吧，我会比我那没用的老爸强的！"
                }
            ]
        },
        {
            "talkId": "6160504",
            "initDialog": "616050401",
            "dialogues": [
                {
                    "id": "616050401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "616050402",
                    "speaker": "艾琳",
                    "text": "哈，没事，那我接着练剑了，你可稍微离远点哦。"
                }
            ]
        },
        {
            "talkId": "6160505",
            "initDialog": "616050501",
            "dialogues": [
                {
                    "id": "616050501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "616050502",
                    "speaker": "艾琳",
                    "text": "虽然很可怕，但其实我并不太担心…"
                },
                {
                    "id": "616050503",
                    "speaker": "艾琳",
                    "text": "因为我相信琴大人一定会保护我们、保护这个蒙德城的！"
                },
                {
                    "id": "616050504",
                    "speaker": "艾琳",
                    "text": "唉，如果我也是骑士团的一员就好了，好希望能和琴大人一起并肩作战啊…"
                }
            ]
        },
        {
            "talkId": "6160506",
            "initDialog": "616050601",
            "dialogues": [
                {
                    "id": "616050601",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "616050602",
                    "speaker": "艾琳",
                    "text": "果然和我想的一样，即便是风魔龙，在琴大人的面前也不过如此嘛！"
                },
                {
                    "id": "616050603",
                    "speaker": "艾琳",
                    "text": "虽然琴大人说那位旅行者帮了大忙，但我相信这只是琴大人谦虚，最大的功劳肯定是她的！"
                },
                {
                    "id": "616050604",
                    "speaker": "艾琳",
                    "text": "如果我要是能和琴大人一起去的话，我们会一起合力击败风魔龙，然后在授勋仪式那天，她会含笑看着我…"
                },
                {
                    "id": "616050605",
                    "speaker": "艾琳",
                    "text": "只是想一想就如此让人心潮澎湃…"
                },
                {
                    "id": "616050606",
                    "speaker": "艾琳",
                    "text": "在下一次危机来临前，我要好好练剑了，争取把握下一次机会，嗯…"
                }
            ]
        }
    ]
}