{
    "groupId": "1559",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "洛伽": 16
    },
    "talks": [
        {
            "talkId": "7093401",
            "initDialog": "709340101",
            "dialogues": [
                {
                    "id": "709340101",
                    "speaker": "Player",
                    "text": "情况如何？"
                },
                {
                    "id": "709340102",
                    "speaker": "洛伽",
                    "text": "还是不容乐观，近期丘丘人的活动也越发频繁了起来，真是有些头疼…"
                },
                {
                    "id": "709340103",
                    "speaker": "洛伽",
                    "text": "我能做的，也就只有在这附近提醒年轻的冒险者和旅行者要当心了。"
                },
                {
                    "id": "709340104",
                    "speaker": "洛伽",
                    "text": "这是我写的一些笔记，希望能帮到你，请注意安全。"
                }
            ]
        },
        {
            "talkId": "6155901",
            "initDialog": "615590101",
            "dialogues": [
                {
                    "id": "615590101",
                    "speaker": "洛伽",
                    "text": "喂！那边的旅行者！"
                },
                {
                    "id": "615590102",
                    "speaker": "洛伽",
                    "text": "前面很危险！不要向前走了！"
                }
            ]
        },
        {
            "talkId": "6155902",
            "initDialog": "615590201",
            "dialogues": [
                {
                    "id": "615590201",
                    "speaker": "洛伽",
                    "text": "前面是危险地带…欸？你难道是…"
                }
            ]
        },
        {
            "talkId": "6155903",
            "initDialog": "615590301",
            "dialogues": [
                {
                    "id": "615590301",
                    "speaker": "Player",
                    "text": "…有什么事吗？"
                },
                {
                    "id": "615590302",
                    "speaker": "洛伽",
                    "text": "前方十分危险，已经有运输队在山道上被强大的怪物袭击了。"
                },
                {
                    "id": "615590303",
                    "speaker": "洛伽",
                    "text": "如果没什么事的话，还是赶紧离开比较好。"
                }
            ]
        },
        {
            "talkId": "6155904",
            "initDialog": "615590401",
            "dialogues": [
                {
                    "id": "615590401",
                    "speaker": "Player",
                    "text": "…有什么事吗？"
                },
                {
                    "id": "615590402",
                    "speaker": "洛伽",
                    "text": "这个装束…难道你就是他们说的那个的旅行者？！"
                },
                {
                    "id": "615590403",
                    "speaker": "洛伽",
                    "text": "哎？你不知道？你的事情已经在蒙德传开了呢，听说就是你破除了蒙德的风灾。"
                },
                {
                    "id": "615590404",
                    "speaker": "洛伽",
                    "text": "虽说你应该有能力应付这前面的怪物了，不过还是要说一句，请注意安全哦。"
                }
            ]
        },
        {
            "talkId": "6155905",
            "initDialog": "615590501",
            "dialogues": [
                {
                    "id": "615590501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615590502",
                    "speaker": "洛伽",
                    "text": "嗯，路上小心。"
                }
            ]
        },
        {
            "talkId": "6155906",
            "initDialog": "615590601",
            "dialogues": [
                {
                    "id": "615590601",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "615590602",
                    "speaker": "洛伽",
                    "text": "很像的人？确实有见过…"
                },
                {
                    "id": "615590603",
                    "speaker": "洛伽",
                    "text": "经常会有像你这样来望风山地冒险的年轻冒险家，大部分都被我劝回去了，毕竟前面还是很危险的…"
                },
                {
                    "id": "615590604",
                    "speaker": "洛伽",
                    "text": "…哦？原来你是在找家人吗？不好意思，是我误会了。"
                },
                {
                    "id": "615590605",
                    "speaker": "洛伽",
                    "text": "你要找的人应该没来过望风山地，你去其他地方找找吧。"
                }
            ]
        }
    ]
}