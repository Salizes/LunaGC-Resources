{
    "groupId": "6477",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "恩波索": 12
    },
    "talks": [
        {
            "talkId": "6647701",
            "initDialog": "664770101",
            "dialogues": [
                {
                    "id": "664770101",
                    "speaker": "恩波索",
                    "text": "唉，没想到研究了这么多年…咳咳，还真是「无所事事的恩波索」啊…"
                },
                {
                    "id": "664770102",
                    "speaker": "恩波索",
                    "text": "怎么了，火山之行还顺利吗？"
                }
            ]
        },
        {
            "talkId": "6647702",
            "initDialog": "664770201",
            "dialogues": [
                {
                    "id": "664770201",
                    "speaker": "Player",
                    "text": "你为什么要研究这些遗迹…"
                },
                {
                    "id": "664770202",
                    "speaker": "恩波索",
                    "text": "因为我想知道为什么，为什么有些龙生来就和别人不一样，它们的命运最终会到哪里去…"
                },
                {
                    "id": "664770203",
                    "speaker": "恩波索",
                    "text": "咳咳…也许，也许它们和其他龙除了角上有印记以外，其实没什么区别呢？"
                },
                {
                    "id": "664770204",
                    "speaker": "恩波索",
                    "text": "我想知道这一切。"
                }
            ]
        },
        {
            "talkId": "6647703",
            "initDialog": "664770301",
            "dialogues": [
                {
                    "id": "664770301",
                    "speaker": "Player",
                    "text": "角上有印记的龙很多吗…"
                },
                {
                    "id": "664770302",
                    "speaker": "恩波索",
                    "text": "不多，十几年，或者几十年有一只，但是往往不会被记载下来…"
                },
                {
                    "id": "664770303",
                    "speaker": "恩波索",
                    "text": "这些龙或者被部族自己「藏」了起来，或者走入了火山，只有传说中的寥寥几只存活了下来…"
                },
                {
                    "id": "664770304",
                    "speaker": "恩波索",
                    "text": "但状况都咳咳…不太好，很多都因为过度狂暴，被猎龙人猎杀了…"
                },
                {
                    "id": "664770305",
                    "speaker": "恩波索",
                    "text": "不过，咳咳…似乎在深渊影响更剧烈的年岁，角上有「焰主之祝」的龙出现得更多一些…"
                }
            ]
        },
        {
            "talkId": "6647704",
            "initDialog": "664770401",
            "dialogues": [
                {
                    "id": "664770401",
                    "speaker": "Player",
                    "text": "关于「图兰大火山」…"
                },
                {
                    "id": "664770402",
                    "speaker": "恩波索",
                    "text": "它是圣山，据说咳咳…以前的龙曾掏空这整座火山，建造城市，以供奉最初的源火…"
                },
                {
                    "id": "664770403",
                    "speaker": "恩波索",
                    "text": "但是我们进去的时候，里面只是漆黑一片，探索遇到了很大的阻碍，很快我们就咳咳…不得不打道回府…"
                }
            ]
        },
        {
            "talkId": "6647705",
            "initDialog": "664770501",
            "dialogues": [
                {
                    "id": "664770501",
                    "speaker": "Player",
                    "text": "一切都还比较顺利。"
                },
                {
                    "id": "664770502",
                    "speaker": "恩波索",
                    "text": "咳咳…是嘛…"
                }
            ]
        }
    ]
}