    },
    "talks": [
        {
            "talkId": "6741101",
            "initDialog": "674110101",
            "dialogues": [
                {
                    "id": "674110101",
                    "speaker": "库兹米切夫",
                    "text": "嗯…得精准控制炉温才行啊…"
                }
            ]
        },
        {
            "talkId": "6741102",
            "initDialog": "674110201",
            "dialogues": [
                {
                    "id": "674110201",
                    "speaker": "Player",
                    "text": "想买些武器。"
                },
                {
                    "id": "674110202",
                    "speaker": "库兹米切夫",
                    "text": "哈哈，那就尽管看看吧，客人，我保证都是些好宝贝！"
                }
            ]
        },
        {
            "talkId": "6741103",
            "initDialog": "674110301",
            "dialogues": [
                {
                    "id": "674110301",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "674110302",
                    "speaker": "库兹米切夫",
                    "text": "好，跟我说说看，你想要什么？"
                }
            ]
        },
        {
            "talkId": "6741104",
            "initDialog": "674110401",
            "dialogues": [
                {
                    "id": "674110401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33>委托锻造…</color>"
                },
                {
                    "id": "674110402",
                    "speaker": "库兹米切夫",
                    "text": "看看吧。不是我自夸，整个至冬堡，我的手艺是最好的！要来点别的吗？"
                }
            ]
        },
        {
            "talkId": "6741105",
            "initDialog": "674110501",
            "dialogues": [
                {
                    "id": "674110501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "674110502",
                    "speaker": "库兹米切夫",
                    "text": "我在看炉火的火候，得很仔细才行…细微的温度差别就会影响到锻材的强度。"
                },
                {
                    "id": "674110503",
                    "speaker": "库兹米切夫",
                    "text": "而一把武器最后成败与否，就在这些细节上呀。"
                }
            ]
        },
        {
            "talkId": "6741106",
            "initDialog": "674110601",
            "dialogues": [
                {
                    "id": "674110601",
                    "speaker": "Player",
                    "text": "有臻冰了，还需要打造武器？"
                },
                {
                    "id": "674110602",
                    "speaker": "库兹米切夫",
                    "text": "哈哈，上次也有人跟我说这个，争论了半天，我拿起手边的铲子轻轻拍了他的脸…"
                },
                {
                    "id": "674110603",
                    "speaker": "库兹米切夫",
                    "text": "可他呢？慌乱之下，半点臻冰都凝造不出来，最后闭上嘴灰溜溜滚了。"
                },
                {
                    "id": "674110604",
                    "speaker": "库兹米切夫",
                    "text": "…客人，要我说，防身的家伙，能立刻握在手里的才比较妥当啊。"
                }
            ]
        },
        {
            "talkId": "6741107",
            "initDialog": "674110701",
            "dialogues": [
                {
                    "id": "674110701",
                    "speaker": "Player",
                    "text": "不打扰了，再见。"
                },
                {
                    "id": "674110702",
                    "speaker": "库兹米切夫",
                    "text": "再见，有需要就来找我！"
                }
            ]
        },
        {
            "talkId": "6741108",
            "initDialog": "674110801",
            "dialogues": [
                {
                    "id": "674110801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33>想买些武器。</color>"
                },
                {
                    "id": "674110802",
                    "speaker": "库兹米切夫",
                    "text": "哈哈，那就尽管看看吧，客人，我保证都是些好宝贝！"
                }
            ]
        },
        {
            "talkId": "6741109",
            "initDialog": "674110901",
            "dialogues": [
                {
                    "id": "674110901",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
