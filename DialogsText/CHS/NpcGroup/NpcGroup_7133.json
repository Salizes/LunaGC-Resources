{
    "groupId": "7133",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 1,
        "伊涅芙": 7,
        "派蒙": 3,
        "爱诺": 17,
        "阿莎莎·郎勃罗": 4
    },
    "talks": [
        {
            "talkId": "6713301",
            "initDialog": "671330101",
            "dialogues": [
                {
                    "id": "671330101",
                    "speaker": "爱诺",
                    "text": "阿莎莎，最近你总能从垃圾堆里挑出有用的宝贝，是不是变聪明了？"
                },
                {
                    "id": "671330102",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "哼，我比你聪明一万倍。"
                },
                {
                    "id": "671330103",
                    "speaker": "爱诺",
                    "text": "哎呀，比聪明更膨胀的原来是嚣张。再这样我就要把你的花花摘掉，它开始让你认不清自己啦。"
                },
                {
                    "id": "671330104",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "不许摘！那不是花花。"
                },
                {
                    "id": "671330105",
                    "speaker": "爱诺",
                    "text": "明明就是我上次给你戴的花花。"
                },
                {
                    "id": "671330106",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "总之不许摘！"
                },
                {
                    "id": "671330107",
                    "speaker": "爱诺",
                    "text": "为什么？"
                },
                {
                    "id": "671330108",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "因为那是我的聪明草。"
                }
            ]
        },
        {
            "talkId": "6713302",
            "initDialog": "671330201",
            "dialogues": [
                {
                    "id": "671330201",
                    "speaker": "派蒙",
                    "text": "是爱诺！嘿嘿，你在这里干什么呀？"
                },
                {
                    "id": "671330202",
                    "speaker": "爱诺",
                    "text": "是你们呀，你们来的正好，我在玩呢，嘿嘿，要一起吗？"
                },
                {
                    "id": "671330203",
                    "speaker": "Player",
                    "text": "伊涅芙没有和你一起玩吗？"
                },
                {
                    "id": "671330204",
                    "speaker": "爱诺",
                    "text": "当然有呀，她最喜欢和我一起玩了。"
                },
                {
                    "id": "671330205",
                    "speaker": "派蒙",
                    "text": "欸？她在哪里呀？"
                },
                {
                    "id": "671330206",
                    "speaker": "爱诺",
                    "text": "喏。"
                },
                {
                    "id": "671330207",
                    "speaker": "伊涅芙",
                    "text": "救——命——啊——"
                },
                {
                    "id": "671330208",
                    "speaker": "爱诺",
                    "text": "这就是伊涅芙最喜欢玩的「叮铃哐啷爱诺翱翔」，她说这样既能开拓视野，又能活动筋骨。"
                },
                {
                    "id": "671330209",
                    "speaker": "派蒙",
                    "text": "可是她在喊救命欸！"
                },
                {
                    "id": "671330210",
                    "speaker": "爱诺",
                    "text": "那是为了娱乐效果啦，不信你们看。"
                },
                {
                    "id": "671330211",
                    "speaker": "爱诺",
                    "text": "伊涅芙，该回家啦！"
                },
                {
                    "id": "671330212",
                    "speaker": "伊涅芙",
                    "text": "不——要——！还——没——玩——够——"
                }
            ]
        },
        {
            "talkId": "6713303",
            "initDialog": "671330301",
            "dialogues": [
                {
                    "id": "671330301",
                    "speaker": "爱诺",
                    "text": "伊涅芙，让我考考你吧，家鸭和野鸭的区别是什么？"
                },
                {
                    "id": "671330302",
                    "speaker": "伊涅芙",
                    "text": "家鸭是家鸭，野鸭是野鸭。"
                },
                {
                    "id": "671330303",
                    "speaker": "爱诺",
                    "text": "没错，就是这样。"
                },
                {
                    "id": "671330304",
                    "speaker": "爱诺",
                    "text": "我再考考你，它们和重拳出击鸭的区别是什么呢？"
                },
                {
                    "id": "671330305",
                    "speaker": "伊涅芙",
                    "text": "重拳出击鸭是重拳出击鸭。"
                },
                {
                    "id": "671330306",
                    "speaker": "爱诺",
                    "text": "错误！家鸭和野鸭都是鸭，但是重拳出击鸭不是鸭。"
                },
                {
                    "id": "671330307",
                    "speaker": "伊涅芙",
                    "text": "原来如此，那…机器人是人吗？"
                },
                {
                    "id": "671330308",
                    "speaker": "爱诺",
                    "text": "当然不是。"
                },
                {
                    "id": "671330309",
                    "speaker": "伊涅芙",
                    "text": "所以，我不是人。"
                },
                {
                    "id": "671330310",
                    "speaker": "爱诺",
                    "text": "你是伊涅芙，独一无二的伊涅芙，爱诺的伊涅芙。"
                },
                {
                    "id": "671330311",
                    "speaker": "爱诺",
                    "text": "就像我是爱诺，独一无二的爱诺，伊涅芙的爱诺那样。"
                },
                {
                    "id": "671330312",
                    "speaker": "伊涅芙",
                    "text": "明白了。"
                }
            ]
        }
    ]
}