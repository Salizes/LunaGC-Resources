{
    "groupId": "4468",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 8,
        "博言": 25
    },
    "talks": [
        {
            "talkId": "6446801",
            "initDialog": "644680101",
            "dialogues": [
                {
                    "id": "644680101",
                    "speaker": "博言",
                    "text": "最近的行情不太妙啊，以防万一，我还是先把货囤起来…"
                }
            ]
        },
        {
            "talkId": "6446802",
            "initDialog": "644680201",
            "dialogues": [
                {
                    "id": "644680201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "644680202",
                    "speaker": "博言",
                    "text": "见面三分缘，有缘皆是客！我叫博言，从璃月过来跑商的。"
                },
                {
                    "id": "644680203",
                    "speaker": "博言",
                    "text": "把璃月的东西运到枫丹，再把枫丹的东西运到须弥，赚的就是这中间的差价，大家都稀罕没见过的东西嘛！"
                },
                {
                    "id": "644680204",
                    "speaker": "博言",
                    "text": "做生意得眼观六路，耳听八方，听说最近的茶叶行情不大妙，真让人烦心啊…"
                }
            ]
        },
        {
            "talkId": "6446803",
            "initDialog": "644680301",
            "dialogues": [
                {
                    "id": "644680301",
                    "speaker": "Player",
                    "text": "货？"
                },
                {
                    "id": "644680302",
                    "speaker": "博言",
                    "text": "客人要是爱喝茶，应该知道，沉玉谷出产的茶叶「沉玉仙茗」品质最佳。"
                },
                {
                    "id": "644680303",
                    "speaker": "博言",
                    "text": "可如今沉玉谷的水土出了问题，茶叶的品质也大不如前了！"
                },
                {
                    "id": "644680304",
                    "speaker": "博言",
                    "text": "我日愁夜愁，想来想去，只有一个办法…"
                }
            ]
        },
        {
            "talkId": "6446804",
            "initDialog": "644680401",
            "dialogues": [
                {
                    "id": "644680401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "644680402",
                    "speaker": "博言",
                    "text": "唉！不能愁眉苦脸了，把客人都吓跑了…"
                }
            ]
        },
        {
            "talkId": "6446805",
            "initDialog": "644680501",
            "dialogues": [
                {
                    "id": "644680501",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "644680502",
                    "speaker": "博言",
                    "text": "见面三分缘，有缘皆是客！我叫博言，从璃月过来跑商的。"
                },
                {
                    "id": "644680503",
                    "speaker": "博言",
                    "text": "干我们这行，辛苦不说，风险也是常有的事，为了茶叶，我是好几天没睡过安稳觉了，直到现在这颗心才放下来。"
                },
                {
                    "id": "644680504",
                    "speaker": "博言",
                    "text": "什么时候我也能坐在茶室里，泡上一杯「沉玉仙茗」，享受享受啊！"
                }
            ]
        },
        {
            "talkId": "6446806",
            "initDialog": "644680601",
            "dialogues": [
                {
                    "id": "644680601",
                    "speaker": "Player",
                    "text": "货源问题？"
                },
                {
                    "id": "644680602",
                    "speaker": "博言",
                    "text": "做生意的人，一怕商路不通，二怕客流被抢，最怕货源中断啊！"
                },
                {
                    "id": "644680603",
                    "speaker": "博言",
                    "text": "我在各国跑商这么多年，全靠稳定优质的货源才有了信誉。"
                },
                {
                    "id": "644680604",
                    "speaker": "博言",
                    "text": "直到前些日子，一个富有的老爷找我预订了十车「沉玉仙茗」。"
                },
                {
                    "id": "644680605",
                    "speaker": "博言",
                    "text": "不巧那段时间沉玉谷的水土出了问题，加上我提前囤的那批好货，也凑不够十车啊！"
                },
                {
                    "id": "644680606",
                    "speaker": "博言",
                    "text": "要是以次充好，我的信誉就毁了，可要是到了时间交不出货…"
                }
            ]
        },
        {
            "talkId": "6446807",
            "initDialog": "644680701",
            "dialogues": [
                {
                    "id": "644680701",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "644680702",
                    "speaker": "博言",
                    "text": "嘿！人逢喜事精神爽，有时间再来一叙！"
                }
            ]
        },
        {
            "talkId": "6446808",
            "initDialog": "644680801",
            "dialogues": [
                {
                    "id": "644680801",
                    "speaker": "Player",
                    "text": "什么办法？"
                },
                {
                    "id": "644680802",
                    "speaker": "博言",
                    "text": "当然是先把好货囤起来，再往外放出「沉玉谷一切如常」的消息。"
                },
                {
                    "id": "644680803",
                    "speaker": "博言",
                    "text": "等大家都买不到好茶叶的时候…嘿嘿…"
                },
                {
                    "id": "644680804",
                    "speaker": "博言",
                    "text": "糟糕，一不小心说太多了。"
                },
                {
                    "id": "644680805",
                    "speaker": "博言",
                    "text": "还请替我保守秘密，不要声张！"
                }
            ]
        },
        {
            "talkId": "6446809",
            "initDialog": "644680901",
            "dialogues": [
                {
                    "id": "644680901",
                    "speaker": "Player",
                    "text": "那你现在应该不用担心了。"
                },
                {
                    "id": "644680902",
                    "speaker": "博言",
                    "text": "哦？客人的消息有够灵通的！"
                },
                {
                    "id": "644680903",
                    "speaker": "博言",
                    "text": "听说啊，是托了一个锦鲤仙人的福…"
                },
                {
                    "id": "644680904",
                    "speaker": "博言",
                    "text": "咱也不懂这些，只知道，生意总算是又能做了。"
                }
            ]
        },
        {
            "talkId": "6446810",
            "initDialog": "644681001",
            "dialogues": [
                {
                    "id": "644681001",
                    "speaker": "博言",
                    "text": "差点把招牌砸了，幸亏货源问题解决了，又能睡个安心觉了…"
                }
            ]
        }
    ]
}