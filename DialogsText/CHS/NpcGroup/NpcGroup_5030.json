{
    "groupId": "5030",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "梅琪妮": 14
    },
    "talks": [
        {
            "talkId": "6503001",
            "initDialog": "650300101",
            "dialogues": [
                {
                    "id": "650300101",
                    "speaker": "梅琪妮",
                    "text": "欢迎光临「白棠珍奇屋」。"
                }
            ]
        },
        {
            "talkId": "6503002",
            "initDialog": "650300201",
            "dialogues": [
                {
                    "id": "650300201",
                    "speaker": "Player",
                    "text": "有什么在售？"
                },
                {
                    "id": "650300202",
                    "speaker": "梅琪妮",
                    "text": "很遗憾，最近没遇到什么合我眼缘的收藏，客人请过些时日再来吧。"
                }
            ]
        },
        {
            "talkId": "6503003",
            "initDialog": "650300301",
            "dialogues": [
                {
                    "id": "650300301",
                    "speaker": "Player",
                    "text": "你的职业是收藏家？"
                },
                {
                    "id": "650300302",
                    "speaker": "梅琪妮",
                    "text": "这倒没有，我的本职是个服装设计师。"
                },
                {
                    "id": "650300303",
                    "speaker": "梅琪妮",
                    "text": "你若去询问枫丹哪位裁缝衣服做得好，那多半会提到我的名字。"
                },
                {
                    "id": "650300304",
                    "speaker": "梅琪妮",
                    "text": "咳咳…还有「千织」的名字…"
                }
            ]
        },
        {
            "talkId": "6503004",
            "initDialog": "650300401",
            "dialogues": [
                {
                    "id": "650300401",
                    "speaker": "Player",
                    "text": "先不看了。"
                },
                {
                    "id": "650300402",
                    "speaker": "梅琪妮",
                    "text": "嗯，下次再来。"
                }
            ]
        },
        {
            "talkId": "6503005",
            "initDialog": "650300501",
            "dialogues": [
                {
                    "id": "650300501",
                    "speaker": "Player",
                    "text": "千织？"
                },
                {
                    "id": "650300502",
                    "speaker": "梅琪妮",
                    "text": "嗯…「千织屋」的千织。一位从稻妻来的服装设计师。"
                },
                {
                    "id": "650300503",
                    "speaker": "梅琪妮",
                    "text": "她的品味…倒也不错，就是理念上和我有些出入。而且，她还挺挑剔，连对自己的作品都毫不客气…"
                },
                {
                    "id": "650300504",
                    "speaker": "梅琪妮",
                    "text": "上次我提了个她设计中的瑕疵之处，她不但不生气，反倒比我还狠地挑出了更多的刺，听得我都不敢接话…"
                }
            ]
        },
        {
            "talkId": "6503006",
            "initDialog": "650300601",
            "dialogues": [
                {
                    "id": "650300601",
                    "speaker": "Player",
                    "text": "有什么在售？"
                },
                {
                    "id": "650300602",
                    "speaker": "梅琪妮",
                    "text": "请随意挑选，希望能对上你的眼缘。"
                }
            ]
        },
        {
            "talkId": "6503007",
            "initDialog": "650300701",
            "dialogues": [
                {
                    "id": "650300701",
                    "speaker": "Player",
                    "text": "需要些使人灵感迸发的…"
                },
                {
                    "id": "650300702",
                    "speaker": "梅琪妮",
                    "text": "呵呵，这就取决于藏品在客人眼中的样子了。希望于你有用。"
                }
            ]
        },
        {
            "talkId": "7492501",
            "initDialog": "749250101",
            "dialogues": [
                {
                    "id": "749250101",
                    "speaker": "Player",
                    "text": "收藏是你的爱好？"
                },
                {
                    "id": "749250102",
                    "speaker": "梅琪妮",
                    "text": "没错，这也是我寻找设计灵感的一种方式。"
                },
                {
                    "id": "749250103",
                    "speaker": "梅琪妮",
                    "text": "我相信「唯有那些被彻底遗忘之物，才是崭新之物」。"
                },
                {
                    "id": "749250104",
                    "speaker": "梅琪妮",
                    "text": "时尚就是不断游离于「遗忘」与「复兴」之间。你要是感兴趣，就送你这个体会体会吧。它对我已经无用了。"
                }
            ]
        }
    ]
}