    "talks": [
        {
            "talkId": "6953801",
            "initDialog": "695380101",
            "dialogues": [
                {
                    "id": "695380101",
                    "speaker": "申鹤",
                    "text": "和你对局就好多了。和别人较量的时候，我总是难以放松心情…"
                }
            ]
        },
        {
            "talkId": "6953802",
            "initDialog": "695380201",
            "dialogues": [
                {
                    "id": "695380201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953803",
            "initDialog": "695380301",
            "dialogues": [
                {
                    "id": "695380301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695380302",
                    "speaker": "申鹤",
                    "text": "嗯，稍后我和你一同离开吧。"
                }
            ]
        },
        {
            "talkId": "6953804",
            "initDialog": "695380401",
            "dialogues": [
                {
                    "id": "695380401",
                    "speaker": "申鹤",
                    "text": "我决胜的那一手是向你学的，这局应该不计数。"
                }
            ]
        },
        {
            "talkId": "6953805",
            "initDialog": "695380501",
            "dialogues": [
                {
                    "id": "695380501",
                    "speaker": "申鹤",
                    "text": "是我输了…要再来一局吗？"
                }
            ]
        },
        {
            "talkId": "6953806",
            "initDialog": "695380601",
            "dialogues": [
                {
                    "id": "695380601",
                    "speaker": "申鹤",
                    "text": "我不擅长这种凡间游艺…但如果是你邀请…"
                }
            ]
        },
        {
            "talkId": "6953808",
            "initDialog": "695380801",
            "dialogues": [
                {
                    "id": "695380801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953809",
            "initDialog": "695380901",
            "dialogues": [
                {
                    "id": "695380901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6953810",
            "initDialog": "695381001",
            "dialogues": [
                {
                    "id": "695381001",
                    "speaker": "申鹤",
                    "text": "我这算是…赢了吗？"
                }
            ]
        },
        {
            "talkId": "6953811",
            "initDialog": "695381101",
            "dialogues": [
                {
                    "id": "695381101",
                    "speaker": "申鹤",
                    "text": "就连学…我也学不明白这游艺…"
                }
            ]
        },
        {
            "talkId": "6953812",
            "initDialog": "695381201",
            "dialogues": [
                {
                    "id": "695381201",
                    "speaker": "申鹤",
                    "text": "与你对局，很是有趣。"
                }
            ]
        },
        {
            "talkId": "6953814",
            "initDialog": "695381401",
            "dialogues": [
                {
                    "id": "695381401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6953815",
            "initDialog": "695381501",
            "dialogues": [
                {
                    "id": "695381501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
