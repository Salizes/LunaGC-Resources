{
    "groupId": "7430",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "洛浦希娜": 3,
        "齐索斯琳娜": 5
    },
    "talks": [
        {
            "talkId": "6743001",
            "initDialog": "674300101",
            "dialogues": [
                {
                    "id": "674300101",
                    "speaker": "齐索斯琳娜",
                    "text": "看到没有，这件东西可复杂了，主体结构融合了不同时期的文物碎片，又悄然将他们结合成了一整个物件。"
                },
                {
                    "id": "674300102",
                    "speaker": "洛浦希娜",
                    "text": "真的吗…"
                },
                {
                    "id": "674300103",
                    "speaker": "齐索斯琳娜",
                    "text": "你看，这个柄的造型粗犷，显然是穆斯季斯莱沃时期的造型，而瓶身则干净雅致，已经是苍星王廷时期的设计…"
                },
                {
                    "id": "674300104",
                    "speaker": "齐索斯琳娜",
                    "text": "而作为点睛之笔的，将两者融为一体的这些雪花雕饰，毫无疑问是至冬时期的人类工匠手笔。"
                },
                {
                    "id": "674300105",
                    "speaker": "洛浦希娜",
                    "text": "确实，仔细看确实能看得出不同的风格…"
                },
                {
                    "id": "674300106",
                    "speaker": "齐索斯琳娜",
                    "text": "待会儿…待会儿你就说这是现代仿品，压低价格…"
                },
                {
                    "id": "674300107",
                    "speaker": "洛浦希娜",
                    "text": "为什么你不自己去…"
                },
                {
                    "id": "674300108",
                    "speaker": "齐索斯琳娜",
                    "text": "布柳什科认得我啦，要是我表示想要买这个，他非得把价格翻个倍才愿意出手！"
                }
            ]
        }
    ]
}