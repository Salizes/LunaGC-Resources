{
    "groupId": "9073",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Player": 18,
        "纳西妲": 50
    },
    "talks": [
        {
            "talkId": "6907301",
            "initDialog": "690730101",
            "dialogues": [
                {
                    "id": "690730101",
                    "speaker": "纳西妲",
                    "text": "#{NICKNAME}，我在这里。"
                },
                {
                    "id": "690730102",
                    "speaker": "纳西妲",
                    "text": "你带来新的故事了吗？我用我亲手做的枣椰蜜糖和你交换。"
                }
            ]
        },
        {
            "talkId": "6907302",
            "initDialog": "690730201",
            "dialogues": [
                {
                    "id": "690730201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690730202",
                    "speaker": "纳西妲",
                    "text": "这问题的答案显而易见。"
                },
                {
                    "id": "690730203",
                    "speaker": "纳西妲",
                    "text": "就好像你总能透过清澈的湖水，一眼就看出来里面游着的是什么品种的鱼儿一样。"
                },
                {
                    "id": "690730204",
                    "speaker": "纳西妲",
                    "text": "这里氛围安逸，连风吹在脚尖的触感都轻盈柔软，我当然住得习惯。"
                },
                {
                    "id": "690730205",
                    "speaker": "Player",
                    "text": "那就好。"
                },
                {
                    "id": "690730206",
                    "speaker": "纳西妲",
                    "text": "对小鸟来说，她就算再怎么向往森林和群山，每天都想要啄啄不同果子的味道…"
                },
                {
                    "id": "690730207",
                    "speaker": "纳西妲",
                    "text": "飞得久了，累了，总还是要有一个地方栖身的。"
                },
                {
                    "id": "690730208",
                    "speaker": "纳西妲",
                    "text": "我很高兴，能到你的巢里小憩片刻。"
                },
                {
                    "id": "690730209",
                    "speaker": "纳西妲",
                    "text": "尽管都是住的地方，这可比鸟笼宽敞多了。"
                },
                {
                    "id": "690730210",
                    "speaker": "Player",
                    "text": "纳西妲就放心住吧。"
                },
                {
                    "id": "690730211",
                    "speaker": "纳西妲",
                    "text": "谢谢你，我能明白你的好心肠，所以，我不会和你客气的。"
                }
            ]
        },
        {
            "talkId": "6907303",
            "initDialog": "690730301",
            "dialogues": [
                {
                    "id": "690730301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690730302",
                    "speaker": "纳西妲",
                    "text": "好啊。不过，比起讲故事，今天还是先来解决你的烦恼吧。"
                },
                {
                    "id": "690730303",
                    "speaker": "纳西妲",
                    "text": "你的眼神像在问我，我是怎么会知道的？"
                },
                {
                    "id": "690730304",
                    "speaker": "纳西妲",
                    "text": "那当然是从你的脸上看出来的，因为我总是在观察着你嘛。"
                },
                {
                    "id": "690730305",
                    "speaker": "纳西妲",
                    "text": "现在的你，哭丧得像是被雷劈过的堇瓜一样。"
                },
                {
                    "id": "690730306",
                    "speaker": "Player",
                    "text": "感觉最近有点倒霉…"
                },
                {
                    "id": "690730307",
                    "speaker": "纳西妲",
                    "text": "别灰心。你还不能确定是你倒霉，还是只是你遇上了倒霉的事。",
                    "choices": [
                        {
                            "id": "690730308",
                            "text": "有什么区别吗？",
                            "response": [
                                {
                                    "id": "690730309",
                                    "speaker": "纳西妲",
                                    "text": "打比方的话…就像一只吞掉了小狐狸的长鬓虎拉肚子了。"
                                },
                                {
                                    "id": "690730312",
                                    "speaker": "纳西妲",
                                    "text": "可你不知道是因为小狐狸的问题还是小狐狸肚子里的东西的问题，这样说你能明白吗？",
                                    "choices": [
                                        {
                                            "id": "690730313",
                                            "text": "马马虎虎。",
                                            "response": [
                                                {
                                                    "id": "690730315",
                                                    "speaker": "纳西妲",
                                                    "text": "要是因为拉肚子就不敢再去吃小狐狸，那长鬓虎早就灭绝了吧。"
                                                },
                                                {
                                                    "id": "690730316",
                                                    "speaker": "纳西妲",
                                                    "text": "只要长鬓虎还在吃小狐狸，只要我们还在一天天生活下去，总会遇到各种各样的事情。"
                                                },
                                                {
                                                    "id": "690730317",
                                                    "speaker": "纳西妲",
                                                    "text": "你已经做得很好了，摸摸头。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690730314",
                                            "text": "我完全明白了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690730310",
                            "text": "麻烦纳西妲打个比方？",
                            "response": [
                                {
                                    "id": "690730311",
                                    "speaker": "纳西妲",
                                    "text": "嗯…就像一只吞掉了小狐狸的长鬓虎拉肚子了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907304",
            "initDialog": "690730401",
            "dialogues": [
                {
                    "id": "690730401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690730402",
                    "speaker": "纳西妲",
                    "text": "#我可以先问一个问题吗，{NICKNAME}，你很喜欢收集材料吗？"
                },
                {
                    "id": "690730403",
                    "speaker": "纳西妲",
                    "text": "我看你就像牦牦驮兽一样，一边旅行，一边背着满满当当的货物和补给。"
                },
                {
                    "id": "690730404",
                    "speaker": "纳西妲",
                    "text": "有些东西，明明可能这辈子都吃不完、用不上，我很好奇，为什么你还要一直带着它们…"
                },
                {
                    "id": "690730405",
                    "speaker": "纳西妲",
                    "text": "同时还在沿途收集更多呢？",
                    "choices": [
                        {
                            "id": "690730406",
                            "text": "嗯，我喜欢收集。",
                            "response": [
                                {
                                    "id": "690730407",
                                    "speaker": "纳西妲",
                                    "text": "嗯，和我想得一样，那我就能够理解了。"
                                },
                                {
                                    "id": "690730408",
                                    "speaker": "纳西妲",
                                    "text": "人会出于兴趣去做不符合理性的事。"
                                },
                                {
                                    "id": "690730409",
                                    "speaker": "纳西妲",
                                    "text": "就像一只爱上了蕈类的野林猪，为了维系对方的存续，甚至改变了自己的模样。"
                                },
                                {
                                    "id": "690730410",
                                    "speaker": "纳西妲",
                                    "text": "最后它们被一起吃掉了…但我想说的不是这个。"
                                },
                                {
                                    "id": "690730411",
                                    "speaker": "纳西妲",
                                    "text": "我虽然对「收集」这个行为本身没有什么感觉，但既然是你喜欢的事，我想要和你一起尝试。"
                                },
                                {
                                    "id": "690730421",
                                    "speaker": "纳西妲",
                                    "text": "没错，我想做的事情，正是和你一起在这片大陆上漫步，去体验那些你喜欢做、你常做的事情。"
                                },
                                {
                                    "id": "690730422",
                                    "speaker": "纳西妲",
                                    "text": "你能够满足我的这份好奇…与请求吗？",
                                    "choices": [
                                        {
                                            "id": "690730423",
                                            "text": "当然。",
                                            "response": [
                                                {
                                                    "id": "690730425",
                                                    "speaker": "纳西妲",
                                                    "text": "那我们就迎着朝阳，一起采下视野所及之处的第一株薄荷吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690730424",
                                            "text": "我和你约好了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690730412",
                            "text": "更多还是养成习惯了。",
                            "response": [
                                {
                                    "id": "690730413",
                                    "speaker": "纳西妲",
                                    "text": "习惯吗？原来如此。"
                                },
                                {
                                    "id": "690730414",
                                    "speaker": "纳西妲",
                                    "text": "那你铸造武器、制作菜肴、浓缩树脂…同样也是因为这些行为能为你带来正向的帮助，所以变成了「习惯」？"
                                },
                                {
                                    "id": "690730415",
                                    "speaker": "Player",
                                    "text": "差不多是这样。"
                                },
                                {
                                    "id": "690730416",
                                    "speaker": "纳西妲",
                                    "text": "那你广结良友，积极地解决着伙伴们的难题，偶尔看着寄来的信发呆，这些也是「习惯」？"
                                },
                                {
                                    "id": "690730417",
                                    "speaker": "Player",
                                    "text": "这倒不完全…"
                                },
                                {
                                    "id": "690730418",
                                    "speaker": "纳西妲",
                                    "text": "放心吧，我不是在窥探你的隐私，也不会对你进行冒昧的评价。"
                                },
                                {
                                    "id": "690730419",
                                    "speaker": "纳西妲",
                                    "text": "你的行为一定基于某种理由，我这样问只是出于好奇心。"
                                },
                                {
                                    "id": "690730420",
                                    "speaker": "纳西妲",
                                    "text": "既然你也会被「心情」所驱使，那我此刻的想法，或许也能被你所理解了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907305",
            "initDialog": "690730501",
            "dialogues": [
                {
                    "id": "690730501",
                    "speaker": "Player",
                    "text": "早啊，纳西妲。"
                },
                {
                    "id": "690730502",
                    "speaker": "纳西妲",
                    "text": "#{NICKNAME}，今早晨光的颜色，就和暝彩鸟胸前的羽毛一样艳丽。"
                },
                {
                    "id": "690730503",
                    "speaker": "纳西妲",
                    "text": "我很好奇你今天的第一件事，会做什么呢？"
                }
            ]
        },
        {
            "talkId": "6907306",
            "initDialog": "690730601",
            "dialogues": [
                {
                    "id": "690730601",
                    "speaker": "Player",
                    "text": "晚安，纳西妲。"
                },
                {
                    "id": "690730602",
                    "speaker": "纳西妲",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690730603",
                    "speaker": "纳西妲",
                    "text": "睡觉之前，要不要再去上一次厕所呢？"
                },
                {
                    "id": "690730604",
                    "speaker": "纳西妲",
                    "text": "这是对提高睡眠质量很有帮助的建议。你会采纳的吧？"
                }
            ]
        },
        {
            "talkId": "6907307",
            "initDialog": "690730701",
            "dialogues": [
                {
                    "id": "690730701",
                    "speaker": "纳西妲",
                    "text": "这里好安静，就像有一片叶子稳稳地飘在池塘中央…"
                },
                {
                    "id": "690730702",
                    "speaker": "纳西妲",
                    "text": "就让我变成一只在叶片上歇脚的小萤火虫吧。当夜幕降临的时候，漫天星辰都装点起了梦境。"
                },
                {
                    "id": "690730703",
                    "speaker": "纳西妲",
                    "text": "今晚，愿你也有个好梦。"
                }
            ]
        },
        {
            "talkId": "6907308",
            "initDialog": "690730801",
            "dialogues": [
                {
                    "id": "690730801",
                    "speaker": "纳西妲",
                    "text": "原来如此，你将见过的景物进行了这样的组合。"
                },
                {
                    "id": "690730802",
                    "speaker": "纳西妲",
                    "text": "像是从一堆糖果中挑选出自己喜欢的口味，搭成一栋风味融洽的糖果小屋。"
                },
                {
                    "id": "690730803",
                    "speaker": "纳西妲",
                    "text": "打扰啦？我要从烟囱进来看看喽。"
                }
            ]
        }
    ]
}