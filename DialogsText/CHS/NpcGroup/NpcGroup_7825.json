{
    "groupId": "7825",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "季霍米罗夫": 8
    },
    "talks": [
        {
            "talkId": "6782501",
            "initDialog": "678250101",
            "dialogues": [
                {
                    "id": "678250101",
                    "speaker": "季霍米罗夫",
                    "text": "怪了，小孩子喜欢的，明明都加上了啊…"
                }
            ]
        },
        {
            "talkId": "6782502",
            "initDialog": "678250201",
            "dialogues": [
                {
                    "id": "678250201",
                    "speaker": "Player",
                    "text": "小孩子喜欢的？"
                },
                {
                    "id": "678250202",
                    "speaker": "季霍米罗夫",
                    "text": "我是说玩具，小孩子肯定都喜欢吧，能自己拼装的，会变形的，可以飞的。"
                }
            ]
        },
        {
            "talkId": "6782503",
            "initDialog": "678250301",
            "dialogues": [
                {
                    "id": "678250301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678250302",
                    "speaker": "季霍米罗夫",
                    "text": "哦，再见。"
                }
            ]
        },
        {
            "talkId": "6782504",
            "initDialog": "678250401",
            "dialogues": [
                {
                    "id": "678250401",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "678250402",
                    "speaker": "季霍米罗夫",
                    "text": "您也这么认为？唉，但我煞费苦心研发的新型玩具怎么就没销路呢。"
                },
                {
                    "id": "678250403",
                    "speaker": "季霍米罗夫",
                    "text": "「可拼装变形和喷射飞行的套娃」，我明明已经把小孩子会喜欢的功能都加上了啊。"
                }
            ]
        },
        {
            "talkId": "6782505",
            "initDialog": "678250501",
            "dialogues": [
                {
                    "id": "678250501",
                    "speaker": "Player",
                    "text": "也未必吧。"
                },
                {
                    "id": "678250502",
                    "speaker": "季霍米罗夫",
                    "text": "啊？还要新加功能吗？这是否有些勉强…"
                },
                {
                    "id": "678250503",
                    "speaker": "季霍米罗夫",
                    "text": "「可拼装变形和喷射飞行的套娃」，我评估下来，功能已经足够丰富了。不过怎么就没销路呢…"
                }
            ]
        },
        {
            "talkId": "6782506",
            "initDialog": "678250601",
            "dialogues": [
                {
                    "id": "678250601",
                    "speaker": "Player",
                    "text": "有没有可能问题出在套娃上…"
                },
                {
                    "id": "678250602",
                    "speaker": "季霍米罗夫",
                    "text": "怎么会！套娃是不会有问题的，不可能有问题的…"
                }
            ]
        }
    ]
}