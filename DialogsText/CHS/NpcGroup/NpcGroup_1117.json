    "talks": [
        {
            "talkId": "40901",
            "initDialog": "4090101",
            "dialogues": [
                {
                    "id": "4090101",
                    "speaker": "Player",
                    "text": "对不起，我还有事…"
                }
            ]
        },
        {
            "talkId": "40902",
            "initDialog": "4090201",
            "dialogues": [
                {
                    "id": "4090201",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "我养了三只史莱姆，它们很喜欢被举高高，尤其特别喜欢在空中钻圈圈。$UNRELEASED"
                },
                {
                    "id": "4090202",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "琴团长的<color=#00E1FFFF>风压剑</color>应该可以把它们吹起来吧。\\n限时内成功钻圈圈10次！这样它们就会非常开心。怎么样，想试试吗？$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "40903",
            "initDialog": "4090301",
            "dialogues": [
                {
                    "id": "4090301",
                    "speaker": "Player",
                    "text": "好啊。"
                },
                {
                    "id": "4090302",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "谢谢！那么就请<color=#00E1FFFF>琴团长</color>来…$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "40904",
            "initDialog": "4090401",
            "dialogues": [
                {
                    "id": "4090401",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "抓紧用<color=#00E1FFFF>风压剑</color>让史莱姆钻圈圈吧！时间要来不及啦。$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "40905",
            "initDialog": "4090501",
            "dialogues": [
                {
                    "id": "4090501",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "很遗憾，没能在规定时间内完成挑战，没想到就连风压剑也…$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "40906",
            "initDialog": "4090601",
            "dialogues": [
                {
                    "id": "4090601",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "恭喜完成挑战！非常感谢，我的史莱姆们今天玩得很开心。$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "40907",
            "initDialog": "4090701",
            "dialogues": [
                {
                    "id": "4090701",
                    "speaker": "Player",
                    "text": "琴团长已经准备好了。"
                },
                {
                    "id": "4090702",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "挑战！限时10次的圈圈大冒险！准备——开始！$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "40908",
            "initDialog": "4090801",
            "dialogues": [
                {
                    "id": "4090801",
                    "speaker": "Player",
                    "text": "她好像不在…"
                },
                {
                    "id": "4090802",
                    "speaker": "(test)史莱姆饲养员$UNRELEASED",
                    "text": "咦？琴团长不在吗？那就没办法了，只能等她下次路过吧。$UNRELEASED"
                }
            ]
        }
    ]
}