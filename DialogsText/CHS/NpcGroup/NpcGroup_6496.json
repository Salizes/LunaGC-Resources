{
    "groupId": "6496",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "松潘特利": 11
    },
    "talks": [
        {
            "talkId": "6649601",
            "initDialog": "664960101",
            "dialogues": [
                {
                    "id": "664960101",
                    "speaker": "松潘特利",
                    "text": "悠悠纳塔，悠悠夏天！欢迎来到「灰河街斗士」乐器店。"
                }
            ]
        },
        {
            "talkId": "6649602",
            "initDialog": "664960201",
            "dialogues": [
                {
                    "id": "664960201",
                    "speaker": "Player",
                    "text": "「灰河街斗士」是什么？"
                },
                {
                    "id": "664960202",
                    "speaker": "松潘特利",
                    "text": "那是一首我最喜欢的枫丹摇滚乐。在我们与深渊的战争结束之后，我有幸去了一次枫丹，在那里接触到了名叫摇滚乐的音乐。"
                },
                {
                    "id": "664960203",
                    "speaker": "松潘特利",
                    "text": "当我听到「摇摆在水中」、「灰河街斗士」、「一觉睡到千灵节」这种令人振奋的音乐时我就明白——"
                },
                {
                    "id": "664960204",
                    "speaker": "松潘特利",
                    "text": "那就是我一直在寻找的，能够超越「回声之子」音乐的音乐。"
                }
            ]
        },
        {
            "talkId": "6649603",
            "initDialog": "664960301",
            "dialogues": [
                {
                    "id": "664960301",
                    "speaker": "Player",
                    "text": "为什么要超越「回声之子」的音乐？"
                },
                {
                    "id": "664960302",
                    "speaker": "松潘特利",
                    "text": "朋友，如果说我能给你什么建议的话，那就是不要听「回声之子」的音乐。"
                },
                {
                    "id": "664960303",
                    "speaker": "松潘特利",
                    "text": "我来自「回声之子」，我敢说「回声之子」的音乐很好，但拒绝它的理由也很充分，因为那会耽误你听摇滚乐。"
                }
            ]
        },
        {
            "talkId": "6649604",
            "initDialog": "664960401",
            "dialogues": [
                {
                    "id": "664960401",
                    "speaker": "Player",
                    "text": "你这属于偏见。"
                },
                {
                    "id": "664960402",
                    "speaker": "松潘特利",
                    "text": "真遗憾，看来我们不是同道中人。"
                }
            ]
        },
        {
            "talkId": "6649605",
            "initDialog": "664960501",
            "dialogues": [
                {
                    "id": "664960501",
                    "speaker": "Player",
                    "text": "嗯，充分的理由。"
                },
                {
                    "id": "664960502",
                    "speaker": "松潘特利",
                    "text": "太好了，我就猜到我们是同道中人。"
                },
                {
                    "id": "664960503",
                    "speaker": "松潘特利",
                    "text": "你天生就应该是我们「灰河街斗士」的荣誉会员，我可以帮你申请优惠价来办手续，只要五万摩拉，就可以…"
                },
                {
                    "id": "664960504",
                    "speaker": "Player",
                    "text": "算了，下次吧。"
                },
                {
                    "id": "664960505",
                    "speaker": "松潘特利",
                    "text": "欸？这就走了？"
                }
            ]
        },
        {
            "talkId": "6649606",
            "initDialog": "664960601",
            "dialogues": [
                {
                    "id": "664960601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664960602",
                    "speaker": "松潘特利",
                    "text": "慢走。"
                }
            ]
        }
    ]
}