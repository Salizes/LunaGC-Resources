{
    "groupId": "1537",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 13,
        "杜拉夫": 40
    },
    "talks": [
        {
            "talkId": "4111530",
            "initDialog": "411153001",
            "dialogues": [
                {
                    "id": "411153001",
                    "speaker": "杜拉夫",
                    "text": "不能再损失人力了，自从陨石的事开始以后，「猎鹿人」餐馆的肉类订单完成得越来越吃力…"
                },
                {
                    "id": "411153002",
                    "speaker": "杜拉夫",
                    "text": "希望这帮年轻猎人能收收他们无聊的好奇心，唉…"
                }
            ]
        },
        {
            "talkId": "4111531",
            "initDialog": "411153101",
            "dialogues": [
                {
                    "id": "411153101",
                    "speaker": "杜拉夫",
                    "text": "哟，是旅行者啊！现在是休猎时间，不喝个尽兴怎么行？"
                },
                {
                    "id": "411153102",
                    "speaker": "杜拉夫",
                    "text": "你说那些陨石的事…嗨，不就是些石头吗！现在没有任何事情能让我分心，来来，专心喝酒！"
                }
            ]
        },
        {
            "talkId": "7091901",
            "initDialog": "709190101",
            "dialogues": [
                {
                    "id": "709190101",
                    "speaker": "Player",
                    "text": "收获如何？"
                },
                {
                    "id": "709190102",
                    "speaker": "杜拉夫",
                    "text": "怎么？眼馋啦？正巧我现在高兴，白天送完货还有些剩下的肉，拿去拿去！"
                },
                {
                    "id": "709190103",
                    "speaker": "杜拉夫",
                    "text": "别客气，这可是蒙德最好的肉，记得要搭配最好的酒！"
                }
            ]
        },
        {
            "talkId": "6153701",
            "initDialog": "615370101",
            "dialogues": [
                {
                    "id": "615370101",
                    "speaker": "杜拉夫",
                    "text": "旅行者？找我有什么事？"
                }
            ]
        },
        {
            "talkId": "6153702",
            "initDialog": "615370201",
            "dialogues": [
                {
                    "id": "615370201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615370202",
                    "speaker": "杜拉夫",
                    "text": "我是杜拉夫，算是猎人们的领头人，镇上最好的猎手。"
                },
                {
                    "id": "615370203",
                    "speaker": "杜拉夫",
                    "text": "我们猎来的肉，一般直接供应给城里的「猎鹿人」餐馆。"
                },
                {
                    "id": "615370204",
                    "speaker": "杜拉夫",
                    "text": "如果你也是来订购大批生肉的话，我们可没有闲工夫照顾。"
                }
            ]
        },
        {
            "talkId": "6153703",
            "initDialog": "615370301",
            "dialogues": [
                {
                    "id": "615370301",
                    "speaker": "Player",
                    "text": "关于家人。"
                },
                {
                    "id": "615370302",
                    "speaker": "杜拉夫",
                    "text": "你最好别打我女儿迪奥娜的主意。"
                },
                {
                    "id": "615370303",
                    "speaker": "杜拉夫",
                    "text": "她会继承我的狩猎手艺，继续领导这个镇子。"
                },
                {
                    "id": "615370304",
                    "speaker": "杜拉夫",
                    "text": "只是现在刚好到了叛逆期而已，去城里做了什么酒保…"
                },
                {
                    "id": "615370305",
                    "speaker": "杜拉夫",
                    "text": "算了，先等等吧。毕竟是我女儿，决心去做的事很难回头吧。"
                }
            ]
        },
        {
            "talkId": "6153704",
            "initDialog": "615370401",
            "dialogues": [
                {
                    "id": "615370401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615370402",
                    "speaker": "杜拉夫",
                    "text": "嗯，慢走。"
                }
            ]
        },
        {
            "talkId": "6153705",
            "initDialog": "615370501",
            "dialogues": [
                {
                    "id": "615370501",
                    "speaker": "杜拉夫",
                    "text": "哟，是旅行者啊！"
                },
                {
                    "id": "615370502",
                    "speaker": "杜拉夫",
                    "text": "现在是休猎时间，不喝个尽兴怎么行？来来来……"
                }
            ]
        },
        {
            "talkId": "6153706",
            "initDialog": "615370601",
            "dialogues": [
                {
                    "id": "615370601",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615370602",
                    "speaker": "杜拉夫",
                    "text": "但凡你在城里吃到的肉，都是出自我们清泉镇的猎人之手。"
                },
                {
                    "id": "615370603",
                    "speaker": "杜拉夫",
                    "text": "而我，就是这群猎人的头头！"
                },
                {
                    "id": "615370604",
                    "speaker": "杜拉夫",
                    "text": "换句话说，我就是养活着整个镇子的男人，哈哈！"
                }
            ]
        },
        {
            "talkId": "6153707",
            "initDialog": "615370701",
            "dialogues": [
                {
                    "id": "615370701",
                    "speaker": "Player",
                    "text": "你喝了很多酒…"
                },
                {
                    "id": "615370702",
                    "speaker": "杜拉夫",
                    "text": "痛快地狩猎之后，当然要痛快地饮酒！"
                },
                {
                    "id": "615370703",
                    "speaker": "杜拉夫",
                    "text": "况且，我的女儿迪奥娜，可是蒙德数一数二的调酒师呐…"
                },
                {
                    "id": "615370704",
                    "speaker": "杜拉夫",
                    "text": "那小家伙，明明还整天叫唤着讨厌酒，讨厌酒的，哈哈哈…"
                },
                {
                    "id": "615370801",
                    "speaker": "Player",
                    "text": "会休猎到什么时候？"
                },
                {
                    "id": "615370802",
                    "speaker": "杜拉夫",
                    "text": "当然是到下一次狩猎开始的时候啊，这不是明摆着的事情吗？"
                }
            ]
        },
        {
            "talkId": "6153709",
            "initDialog": "615370901",
            "dialogues": [
                {
                    "id": "615370901",
                    "speaker": "Player",
                    "text": "再、再见。"
                },
                {
                    "id": "615370902",
                    "speaker": "杜拉夫",
                    "text": "再见！下次来早一点，我也许能给你留几杯酒呢，哈哈哈！"
                }
            ]
        },
        {
            "talkId": "6153710",
            "initDialog": "615371001",
            "dialogues": [
                {
                    "id": "615371001",
                    "speaker": "Player",
                    "text": "可以卖一些猎物给我吗？"
                },
                {
                    "id": "615371002",
                    "speaker": "杜拉夫",
                    "text": "如果是少量的话…好吧，可以匀出一部分卖给你。毕竟猎人手里直销，比所有店家都要新鲜。"
                }
            ]
        },
        {
            "talkId": "6153711",
            "initDialog": "615371101",
            "dialogues": [
                {
                    "id": "615371101",
                    "speaker": "杜拉夫",
                    "text": "是旅行者啊，我记得你。又有功夫来这镇上转转了吗？"
                }
            ]
        },
        {
            "talkId": "6153712",
            "initDialog": "615371201",
            "dialogues": [
                {
                    "id": "615371201",
                    "speaker": "Player",
                    "text": "最近如何？"
                },
                {
                    "id": "615371202",
                    "speaker": "杜拉夫",
                    "text": "嗯，上次在清泉镇办的厨艺大会，被蒙德家家户户津津乐道，肉类的销量也随着话题度一起高了不少。"
                },
                {
                    "id": "615371203",
                    "speaker": "杜拉夫",
                    "text": "作为镇上这帮猎人的头儿，我的头脑看来还是靠得住的，哈哈。"
                },
                {
                    "id": "615371204",
                    "speaker": "杜拉夫",
                    "text": "至于我那位「老祖宗」奥拉夫，其实也怪可怜的，亲故都被时间给带走了，唉…"
                },
                {
                    "id": "615371205",
                    "speaker": "杜拉夫",
                    "text": "等休猎时间，我也应该多陪他喝喝酒，尽尽孝心了…唔，这么说总觉得还是怪怪的…"
                }
            ]
        },
        {
            "talkId": "6153713",
            "initDialog": "615371301",
            "dialogues": [
                {
                    "id": "615371301",
                    "speaker": "杜拉夫",
                    "text": "哟，是旅行者啊！"
                },
                {
                    "id": "615371302",
                    "speaker": "杜拉夫",
                    "text": "现在是休猎时间，不喝个尽兴怎么行？来来来……"
                }
            ]
        },
        {
            "talkId": "6153714",
            "initDialog": "615371401",
            "dialogues": [
                {
                    "id": "615371401",
                    "speaker": "Player",
                    "text": "你很开心嘛。"
                },
                {
                    "id": "615371402",
                    "speaker": "杜拉夫",
                    "text": "当然！但凡你在城里吃到的肉，都是出自我们清泉镇的猎人之手。"
                },
                {
                    "id": "615371403",
                    "speaker": "杜拉夫",
                    "text": "而我，就是这群猎人的头头！"
                },
                {
                    "id": "615371404",
                    "speaker": "杜拉夫",
                    "text": "换句话说，我就是养活着整个镇子的男人，哈哈！"
                },
                {
                    "id": "615371405",
                    "speaker": "杜拉夫",
                    "text": "欸，我那位「老祖宗」呢？喝多了感觉有点眼花…唔…"
                }
            ]
        },
        {
            "talkId": "8153701",
            "initDialog": "815370101",
            "dialogues": [
                {
                    "id": "815370101",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "8153702",
            "initDialog": "815370201",
            "dialogues": [
                {
                    "id": "815370201",
                    "speaker": "杜拉夫",
                    "text": "对猎人来说，没有什么是比猎物更值得留意的。猎物之外的东西，我没印象了。"
                }
            ]
        },
        {
            "talkId": "8153705",
            "initDialog": "815370501",
            "dialogues": [
                {
                    "id": "815370501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                },
                {
                    "id": "815370502",
                    "speaker": "杜拉夫",
                    "text": "美酒就在我眼前，我才懒得管附近有什么…"
                },
                {
                    "id": "815370503",
                    "speaker": "杜拉夫",
                    "text": "嗝…你也别那么严肃啦，不如陪我再来两杯？"
                }
            ]
        }
    ]
}