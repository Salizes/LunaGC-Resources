{
    "groupId": "1658",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "戴维": 12
    },
    "talks": [
        {
            "talkId": "6165801",
            "initDialog": "616580101",
            "dialogues": [
                {
                    "id": "616580101",
                    "speaker": "戴维",
                    "text": "还是野外清净啊，灵感也是源源不断…"
                },
                {
                    "id": "616580102",
                    "speaker": "戴维",
                    "text": "我的作品，肯定会比那个女人的要好得多！"
                }
            ]
        },
        {
            "talkId": "6165802",
            "initDialog": "616580201",
            "dialogues": [
                {
                    "id": "616580201",
                    "speaker": "Player",
                    "text": "那个女人…？"
                },
                {
                    "id": "616580202",
                    "speaker": "戴维",
                    "text": "如果你要是去清泉镇的话估计能碰到她…就是我的前妻梅薇丝，和我一样也是个吟游诗人。"
                },
                {
                    "id": "616580203",
                    "speaker": "戴维",
                    "text": "…我以前一定是被风魔龙把脑袋给撞坏了，才会看上那个女人！"
                },
                {
                    "id": "616580204",
                    "speaker": "戴维",
                    "text": "我们以前居然还被称作「最美好的吟游诗人夫妇」？现在想一想我都感觉恶心！"
                },
                {
                    "id": "616580205",
                    "speaker": "戴维",
                    "text": "最可气的还是她的作品…"
                },
                {
                    "id": "616580206",
                    "speaker": "Player",
                    "text": "关于她的作品…"
                },
                {
                    "id": "616580207",
                    "speaker": "戴维",
                    "text": "呵，自从我们离婚后，她就用她的作品在搬弄是非…呸，她写的那些东西根本不配叫作品！"
                },
                {
                    "id": "616580208",
                    "speaker": "戴维",
                    "text": "那个女人根本就是在找各种角度污蔑我，分明她才是最不责任、 不顾家的那个！"
                },
                {
                    "id": "616580209",
                    "speaker": "戴维",
                    "text": "就比如我们明明说好了轮流做饭、做家务的，可每次我演出结束回到家她都不在，于是三餐和家务都得我来干！"
                },
                {
                    "id": "616580210",
                    "speaker": "戴维",
                    "text": "我算是明白了，什么狗屁爱情，全都是假的！"
                }
            ]
        },
        {
            "talkId": "6165803",
            "initDialog": "616580301",
            "dialogues": [
                {
                    "id": "616580301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616580302",
                    "speaker": "戴维",
                    "text": "再见，等我的新作《婚姻就是戴着镣铐生活》面世了，一定要过来听啊！"
                }
            ]
        },
        {
            "talkId": "8165801",
            "initDialog": "816580101",
            "dialogues": [
                {
                    "id": "816580101",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "8165802",
            "initDialog": "816580201",
            "dialogues": [
                {
                    "id": "816580201",
                    "speaker": "戴维",
                    "text": "最近的话，好像除了我的歌声之外，附近没什么特别值得旅人留意的东西。"
                }
            ]
        }
    ]
}