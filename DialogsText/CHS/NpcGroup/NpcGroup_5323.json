{
    "groupId": "5323",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "托皮娅": 9
    },
    "talks": [
        {
            "talkId": "6532301",
            "initDialog": "653230101",
            "dialogues": [
                {
                    "id": "653230101",
                    "speaker": "托皮娅",
                    "text": "啊，你好，我最近还在继续练习《维斯塔之歌》哦…"
                }
            ]
        },
        {
            "talkId": "6532302",
            "initDialog": "653230201",
            "dialogues": [
                {
                    "id": "653230201",
                    "speaker": "Player",
                    "text": "弹给玛梅赫听了吗？"
                },
                {
                    "id": "653230202",
                    "speaker": "托皮娅",
                    "text": "还、还没有，她经常离开村子，然后大家都找不到她！"
                },
                {
                    "id": "653230203",
                    "speaker": "托皮娅",
                    "text": "但是她在的时候，我又有点不好意思…总觉得作为礼物的曲子，得再多练习几次…"
                },
                {
                    "id": "653230204",
                    "speaker": "托皮娅",
                    "text": "不过我一定能找到机会，弹给她听的！"
                }
            ]
        },
        {
            "talkId": "6532303",
            "initDialog": "653230301",
            "dialogues": [
                {
                    "id": "653230301",
                    "speaker": "Player",
                    "text": "有别的事…"
                },
                {
                    "id": "653230302",
                    "speaker": "托皮娅",
                    "text": "嗯，那你先去做自己的事吧。"
                }
            ]
        },
        {
            "talkId": "6532304",
            "initDialog": "653230401",
            "dialogues": [
                {
                    "id": "653230401",
                    "speaker": "Player",
                    "text": "关于要弹给玛梅赫听的曲子…"
                },
                {
                    "id": "653230402",
                    "speaker": "托皮娅",
                    "text": "嗯！在玛梅赫离开村子旅行前，终于作为饯别的礼物弹给她听了！"
                },
                {
                    "id": "653230403",
                    "speaker": "托皮娅",
                    "text": "她说听到琴声的时候，仿佛能看到高高的塔楼和漂亮的航船…"
                },
                {
                    "id": "653230404",
                    "speaker": "托皮娅",
                    "text": "还说说不定能以这首曲子为主题创作出不得了的画作呢，果然不愧是她！"
                },
                {
                    "id": "653230405",
                    "speaker": "托皮娅",
                    "text": "总之也要谢谢你们啦！多亏了你们帮忙，我才能留下这样宝贵的回忆！"
                }
            ]
        }
    ]
}