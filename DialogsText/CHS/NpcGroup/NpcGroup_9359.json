{
    "groupId": "9359",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Wanderer": 9
    },
    "talks": [
        {
            "talkId": "6935901",
            "initDialog": "693590101",
            "dialogues": [
                {
                    "id": "693590101",
                    "speaker": "Wanderer",
                    "text": "这就不行了？你平日的旅途还真是安逸。"
                },
                {
                    "id": "693590102",
                    "speaker": "Wanderer",
                    "text": "不就是干掉一帮挡路的家伙吗？何必这么磨磨蹭蹭？"
                },
                {
                    "id": "693590103",
                    "speaker": "Wanderer",
                    "text": "…算了，别让我等太久。"
                }
            ]
        },
        {
            "talkId": "6935902",
            "initDialog": "693590201",
            "dialogues": [
                {
                    "id": "693590201",
                    "speaker": "Wanderer",
                    "text": "你管踩碎这些蝼蚁的行为叫「挑战」？"
                },
                {
                    "id": "693590202",
                    "speaker": "Wanderer",
                    "text": "这种小打小闹我早腻了，没想到还有人乐在其中。"
                },
                {
                    "id": "693590203",
                    "speaker": "Wanderer",
                    "text": "要我帮忙就别被甩下，我可不想一整天都耗在这里。"
                }
            ]
        },
        {
            "talkId": "6935903",
            "initDialog": "693590301",
            "dialogues": [
                {
                    "id": "693590301",
                    "speaker": "Wanderer",
                    "text": "我没什么其他想聊的。"
                },
                {
                    "id": "693590302",
                    "speaker": "Wanderer",
                    "text": "你那是什么表情？又不是第一天认识我。"
                },
                {
                    "id": "693590303",
                    "speaker": "Wanderer",
                    "text": "…啧。要是你有什么想聊的，我坐旁边听，没意见了吧？"
                }
            ]
        }
    ]
}