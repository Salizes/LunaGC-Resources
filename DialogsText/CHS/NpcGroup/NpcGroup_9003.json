{
    "groupId": "9003",
    "total_dialogue_lines": 67,
    "speaker_counts": {
        "Player": 18,
        "琴": 49
    },
    "talks": [
        {
            "talkId": "6900301",
            "initDialog": "690030101",
            "dialogues": [
                {
                    "id": "690030101",
                    "speaker": "琴",
                    "text": "#听凭风引，{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6900302",
            "initDialog": "690030201",
            "dialogues": [
                {
                    "id": "690030201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690030701",
                    "speaker": "琴",
                    "text": "嗯，这里十分舒适。"
                },
                {
                    "id": "690030702",
                    "speaker": "琴",
                    "text": "空气很清新，环境也让人放松。"
                },
                {
                    "id": "690030703",
                    "speaker": "琴",
                    "text": "而且非常安静，能够沉下心来办公。",
                    "choices": [
                        {
                            "id": "690030704",
                            "text": "为什么琴还是在办公…",
                            "response": [
                                {
                                    "id": "690030705",
                                    "speaker": "琴",
                                    "text": "欸？这样不好吗？"
                                },
                                {
                                    "id": "690030706",
                                    "speaker": "Player",
                                    "text": "希望琴能够多享受一下这里…"
                                },
                                {
                                    "id": "690030708",
                                    "speaker": "琴",
                                    "text": "谢谢你…"
                                },
                                {
                                    "id": "690030709",
                                    "speaker": "琴",
                                    "text": "我会把你的建议铭刻于心。"
                                }
                            ]
                        },
                        {
                            "id": "690030707",
                            "text": "希望琴能够享受这里。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900303",
            "initDialog": "690030301",
            "dialogues": [
                {
                    "id": "690030301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690030801",
                    "speaker": "琴",
                    "text": "好的，非常愿意奉陪。"
                },
                {
                    "id": "690030802",
                    "speaker": "琴",
                    "text": "想聊怎样的话题呢？",
                    "choices": [
                        {
                            "id": "690030803",
                            "text": "只要不是工作，都可以。",
                            "response": [
                                {
                                    "id": "690030804",
                                    "speaker": "琴",
                                    "text": "抱歉…一定是我平时总是说着工作的事情，才会让你有这样的困扰。"
                                },
                                {
                                    "id": "690030805",
                                    "speaker": "琴",
                                    "text": "我会好好反思自己。"
                                },
                                {
                                    "id": "690030806",
                                    "speaker": "Player",
                                    "text": "琴又认真起来啦…"
                                },
                                {
                                    "id": "690030807",
                                    "speaker": "琴",
                                    "text": "抱歉，我…"
                                },
                                {
                                    "id": "690030808",
                                    "speaker": "琴",
                                    "text": "我明白了，你的意思是我们应该更轻松一点地相处。"
                                },
                                {
                                    "id": "690030816",
                                    "speaker": "琴",
                                    "text": "嗯…我…"
                                },
                                {
                                    "id": "690030817",
                                    "speaker": "琴",
                                    "text": "我会努力的…"
                                }
                            ]
                        },
                        {
                            "id": "690030809",
                            "text": "听说琴唱歌很好听？",
                            "response": [
                                {
                                    "id": "690030810",
                                    "speaker": "琴",
                                    "text": "只是能简单的唱几句而已。"
                                },
                                {
                                    "id": "690030811",
                                    "speaker": "琴",
                                    "text": "并…并不是什么值得夸耀的事情。"
                                },
                                {
                                    "id": "690030812",
                                    "speaker": "Player",
                                    "text": "想听琴唱歌。"
                                },
                                {
                                    "id": "690030813",
                                    "speaker": "琴",
                                    "text": "欸…可是我现在一点准备都没有。"
                                },
                                {
                                    "id": "690030814",
                                    "speaker": "琴",
                                    "text": "至少也要等我练习过后才行。"
                                }
                            ]
                        },
                        {
                            "id": "690030815",
                            "text": "嗯，说好了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900304",
            "initDialog": "690030401",
            "dialogues": [
                {
                    "id": "690030401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690030901",
                    "speaker": "琴",
                    "text": "嗯，可以陪我散散步吗？"
                },
                {
                    "id": "690030902",
                    "speaker": "琴",
                    "text": "我之前按你说的，试着对自己的生活做出一些改变。"
                },
                {
                    "id": "690030903",
                    "speaker": "琴",
                    "text": "虽然在处理公务的时候，还是会尽自己所能去完成。"
                },
                {
                    "id": "690030904",
                    "speaker": "琴",
                    "text": "但在你身边的时候，我已经能够让自己从心态上放松下来。",
                    "choices": [
                        {
                            "id": "690030905",
                            "text": "那已经很有进步了。",
                            "response": [
                                {
                                    "id": "690030907",
                                    "speaker": "琴",
                                    "text": "这些都是你的功劳…"
                                },
                                {
                                    "id": "690030908",
                                    "speaker": "琴",
                                    "text": "一直以来，你像这样陪伴着我，考虑着我的事情。"
                                },
                                {
                                    "id": "690030909",
                                    "speaker": "琴",
                                    "text": "如果我连这份付出都看不到的话，那就太无地自容了。"
                                },
                                {
                                    "id": "690030910",
                                    "speaker": "琴",
                                    "text": "真的很感谢你。"
                                },
                                {
                                    "id": "690030911",
                                    "speaker": "Player",
                                    "text": "琴笑起来的样子很好看。"
                                },
                                {
                                    "id": "690030912",
                                    "speaker": "Player",
                                    "text": "我也要感谢琴才对。"
                                },
                                {
                                    "id": "690030913",
                                    "speaker": "琴",
                                    "text": "……"
                                },
                                {
                                    "id": "690030914",
                                    "speaker": "琴",
                                    "text": "我们，边走边说吧。"
                                },
                                {
                                    "id": "690030915",
                                    "speaker": "琴",
                                    "text": "我还有很多话，想要对你说。"
                                }
                            ]
                        },
                        {
                            "id": "690030906",
                            "text": "我很开心听到这些。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900305",
            "initDialog": "690030501",
            "dialogues": [
                {
                    "id": "690030501",
                    "speaker": "Player",
                    "text": "早啊，琴。"
                },
                {
                    "id": "690031001",
                    "speaker": "琴",
                    "text": "#{NICKNAME}早。"
                },
                {
                    "id": "690031002",
                    "speaker": "琴",
                    "text": "祝你的旅途一切顺利。"
                },
                {
                    "id": "690031003",
                    "speaker": "琴",
                    "text": "有我能帮上忙的地方，还请不要客气。"
                }
            ]
        },
        {
            "talkId": "6900306",
            "initDialog": "690030601",
            "dialogues": [
                {
                    "id": "690030601",
                    "speaker": "Player",
                    "text": "晚安，琴。"
                },
                {
                    "id": "690031101",
                    "speaker": "琴",
                    "text": "晚安，记得早些休息。"
                },
                {
                    "id": "690031102",
                    "speaker": "琴",
                    "text": "就像你所提醒我的那样…"
                }
            ]
        },
        {
            "talkId": "6900312",
            "initDialog": "690031201",
            "dialogues": [
                {
                    "id": "690031201",
                    "speaker": "琴",
                    "text": "没想到会在骑士团总部之外，见到这样完善的书房。"
                },
                {
                    "id": "690031202",
                    "speaker": "琴",
                    "text": "无论阅读还是办公，都能沉下心来。"
                },
                {
                    "id": "690031203",
                    "speaker": "琴",
                    "text": "辛苦你了，荣誉骑士。我对这里十分满意。"
                }
            ]
        },
        {
            "talkId": "6900313",
            "initDialog": "690031301",
            "dialogues": [
                {
                    "id": "690031301",
                    "speaker": "琴",
                    "text": "每次在蒙德城内散步，看着大家自由玩乐的样子，我都深受鼓舞。"
                },
                {
                    "id": "690031302",
                    "speaker": "琴",
                    "text": "骑士团的付出，正是为了市民们能无忧无虑地生活。"
                },
                {
                    "id": "690031303",
                    "speaker": "琴",
                    "text": "这处公园的氛围很好，多谢你了…"
                }
            ]
        },
        {
            "talkId": "6900314",
            "initDialog": "690031401",
            "dialogues": [
                {
                    "id": "690031401",
                    "speaker": "琴",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
