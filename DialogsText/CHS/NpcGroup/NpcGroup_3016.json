{
    "groupId": "3016",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "新之丞": 18
    },
    "talks": [
        {
            "talkId": "4006316",
            "initDialog": "400631601",
            "dialogues": [
                {
                    "id": "400631601",
                    "speaker": "新之丞",
                    "text": "翻了翻我最近写的日记，怎么尽是伤感的内容…和以前那种积极向上的感觉不一样，看了真让人振奋不起来。"
                },
                {
                    "id": "400631602",
                    "speaker": "新之丞",
                    "text": "不过这种转折…放进小说里会不会受欢迎啊？"
                },
                {
                    "id": "400631603",
                    "speaker": "新之丞",
                    "text": "穷小子竭尽全力也没能赢得富家千金的心…之类的故事，哈哈…"
                },
                {
                    "id": "400631604",
                    "speaker": "新之丞",
                    "text": "如果我把这些年自己的心路历程整理成小说的话，是不是也能有出版的机会呢…"
                }
            ]
        },
        {
            "talkId": "6301601",
            "initDialog": "630160101",
            "dialogues": [
                {
                    "id": "630160101",
                    "speaker": "新之丞",
                    "text": "旅行者，你好！今天是找勘定奉行有什么事吗？还是…来找千里小姐的？"
                }
            ]
        },
        {
            "talkId": "6301602",
            "initDialog": "630160201",
            "dialogues": [
                {
                    "id": "630160201",
                    "speaker": "Player",
                    "text": "你看起来很有精神。"
                },
                {
                    "id": "630160202",
                    "speaker": "新之丞",
                    "text": "哈哈，那当然了，因为从现在开始，我要认真地对待每一天，不断努力进步。"
                },
                {
                    "id": "630160203",
                    "speaker": "新之丞",
                    "text": "上次护送小姐的事情，让我知道了自己的能力和身手都还差得远。若想保护好小姐，只有这点本事怎么行呢。"
                },
                {
                    "id": "630160204",
                    "speaker": "新之丞",
                    "text": "…你、你别误会啊，我对小姐已经没有什么非分之想了。小姐不仅身份尊贵，而且毕竟也已有心上人…"
                },
                {
                    "id": "630160205",
                    "speaker": "新之丞",
                    "text": "呜…总之，我现在最大的目标就是尽自己所能，完成职责，为勘定奉行，也为柊大小姐，贡献自己的一份力量。"
                }
            ]
        },
        {
            "talkId": "6301603",
            "initDialog": "630160301",
            "dialogues": [
                {
                    "id": "630160301",
                    "speaker": "Player",
                    "text": "要加油哦。"
                },
                {
                    "id": "630160302",
                    "speaker": "新之丞",
                    "text": "我会的，再见。"
                }
            ]
        },
        {
            "talkId": "6301604",
            "initDialog": "630160401",
            "dialogues": [
                {
                    "id": "630160401",
                    "speaker": "新之丞",
                    "text": "你好，旅行者，我们又见面了。"
                }
            ]
        },
        {
            "talkId": "6301605",
            "initDialog": "630160501",
            "dialogues": [
                {
                    "id": "630160501",
                    "speaker": "Player",
                    "text": "感觉你不是太好。"
                },
                {
                    "id": "630160502",
                    "speaker": "新之丞",
                    "text": "怎么会呢？不用担心，我好得很呢。有种大石头终于落地的感觉吧。"
                },
                {
                    "id": "630160503",
                    "speaker": "新之丞",
                    "text": "而且，现在大小姐的状态特别好，看着她这么有精神我也很放心。"
                },
                {
                    "id": "630160504",
                    "speaker": "新之丞",
                    "text": "只是…嗯，不好意思，没什么。"
                }
            ]
        },
        {
            "talkId": "6301606",
            "initDialog": "630160601",
            "dialogues": [
                {
                    "id": "630160601",
                    "speaker": "Player",
                    "text": "只是？"
                },
                {
                    "id": "630160602",
                    "speaker": "新之丞",
                    "text": "本来我只是热血上头，冲到她面前去阻止她，现在想来很自以为是…"
                },
                {
                    "id": "630160603",
                    "speaker": "新之丞",
                    "text": "但大小姐她真的是很温柔的人，那件事结束之后，还专门来和我道谢。"
                },
                {
                    "id": "630160604",
                    "speaker": "新之丞",
                    "text": "唉，我已经没有遗憾了。只是因为投入了太多时间，要从这种情感里脱身，并不是很容易…"
                }
            ]
        },
        {
            "talkId": "6301607",
            "initDialog": "630160701",
            "dialogues": [
                {
                    "id": "630160701",
                    "speaker": "Player",
                    "text": "要加油哦。"
                },
                {
                    "id": "630160702",
                    "speaker": "新之丞",
                    "text": "谢谢，我会尽快振作的。"
                }
            ]
        }
    ]
}