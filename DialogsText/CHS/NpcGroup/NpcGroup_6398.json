{
    "groupId": "6398",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "西杜阿": 9
    },
    "talks": [
        {
            "talkId": "6639801",
            "initDialog": "663980101",
            "dialogues": [
                {
                    "id": "663980101",
                    "speaker": "西杜阿",
                    "text": "不、不行了…教练…让我先缓一缓…"
                }
            ]
        },
        {
            "talkId": "6639802",
            "initDialog": "663980201",
            "dialogues": [
                {
                    "id": "663980201",
                    "speaker": "Player",
                    "text": "你没事吧…"
                },
                {
                    "id": "663980202",
                    "speaker": "西杜阿",
                    "text": "没…没事！就是稍微有点喘不上气…商人嘛，哪里受过这些…"
                },
                {
                    "id": "663980203",
                    "speaker": "西杜阿",
                    "text": "话说回来，这地方的健身课程，还真是比我想象中更狠啊…"
                },
                {
                    "id": "663980204",
                    "speaker": "西杜阿",
                    "text": "我一开始还以为只是普通的减肥课，你看，就是那种简单的运动和饮食调理什么的，没想到居然会是这种高强度训练…"
                },
                {
                    "id": "663980205",
                    "speaker": "西杜阿",
                    "text": "不过，既然已经花钱报了名，还办了特别贵宾卡，怎么也得坚持练完才行…唉，早知如此，就和妹妹一起去烟谜主了…"
                }
            ]
        },
        {
            "talkId": "6639803",
            "initDialog": "663980301",
            "dialogues": [
                {
                    "id": "663980301",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "663980302",
                    "speaker": "西杜阿",
                    "text": "好，谢谢你的鼓励！再怎么说我也已经花钱办了贵宾卡，我是绝对不会放弃的！"
                }
            ]
        },
        {
            "talkId": "6639804",
            "initDialog": "663980401",
            "dialogues": [
                {
                    "id": "663980401",
                    "speaker": "Player",
                    "text": "妹妹？"
                },
                {
                    "id": "663980402",
                    "speaker": "西杜阿",
                    "text": "是啊，我和妹妹是从枫丹来的商人，打算在纳塔做些投资。"
                },
                {
                    "id": "663980403",
                    "speaker": "西杜阿",
                    "text": "她抛下我一个人去了烟谜主，说是在那里遇到了一位什么奇科梅大师，得到了许多投资建议，赚了不少钱。"
                },
                {
                    "id": "663980404",
                    "speaker": "西杜阿",
                    "text": "虽然我完全不懂她是怎么做到的，那边那位来自烟谜主的夏贝瓦祭司也说他们从来不做投资建议，但…结果好就行了吧？"
                }
            ]
        }
    ]
}