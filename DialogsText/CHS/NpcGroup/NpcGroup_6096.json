{
    "groupId": "6096",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "巴茨": 8
    },
    "talks": [
        {
            "talkId": "6609601",
            "initDialog": "660960101",
            "dialogues": [
                {
                    "id": "660960101",
                    "speaker": "巴茨",
                    "text": "朋友，来点音乐？"
                }
            ]
        },
        {
            "talkId": "6609602",
            "initDialog": "660960201",
            "dialogues": [
                {
                    "id": "660960201",
                    "speaker": "Player",
                    "text": "好，我可会唱歌了。"
                },
                {
                    "id": "660960202",
                    "speaker": "巴茨",
                    "text": "那可真是有缘分！我收藏了好多唱片，如果哪天开音乐会，我一定请你来。"
                },
                {
                    "id": "660960203",
                    "speaker": "巴茨",
                    "text": "说起来，流泉之众的人也挺喜欢音乐的。不过他们的音乐听起来比较舒适，就像温泉水一样。"
                },
                {
                    "id": "660960204",
                    "speaker": "巴茨",
                    "text": "我们的音乐就有节奏感多了，甚至可以跟着节奏干活。这边最出名的铭刻师希诺宁，就来找我借过几次唱片呢。"
                }
            ]
        },
        {
            "talkId": "6609603",
            "initDialog": "660960301",
            "dialogues": [
                {
                    "id": "660960301",
                    "speaker": "Player",
                    "text": "算了，我五音不全。"
                },
                {
                    "id": "660960302",
                    "speaker": "巴茨",
                    "text": "没关系，不懂音乐并不代表不能听音乐。"
                },
                {
                    "id": "660960303",
                    "speaker": "巴茨",
                    "text": "我也不是专业的音乐家，只是一个负责照顾嵴锋龙的保育员，但这不影响我和我的龙朋友们享受音乐。"
                },
                {
                    "id": "660960304",
                    "speaker": "巴茨",
                    "text": "打个比方的话…就像有人喜欢一边唱歌一边做家务。这样的人很多吧？"
                }
            ]
        },
        {
            "talkId": "6609604",
            "initDialog": "660960401",
            "dialogues": [
                {
                    "id": "660960401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "660960402",
                    "speaker": "巴茨",
                    "text": "真遗憾，那以后再说吧。"
                }
            ]
        }
    ]
}