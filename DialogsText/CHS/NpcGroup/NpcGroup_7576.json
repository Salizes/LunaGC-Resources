{
    "groupId": "7576",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "韦坚斯基": 9
    },
    "talks": [
        {
            "talkId": "6757601",
            "initDialog": "675760101",
            "dialogues": [
                {
                    "id": "675760101",
                    "speaker": "韦坚斯基",
                    "text": "哎呦嗬，哎呦嗬，一凿一凿又一凿。"
                }
            ]
        },
        {
            "talkId": "6757602",
            "initDialog": "675760201",
            "dialogues": [
                {
                    "id": "675760201",
                    "speaker": "Player",
                    "text": "心情不错？"
                },
                {
                    "id": "675760202",
                    "speaker": "韦坚斯基",
                    "text": "哈哈，这么明显吗？没办法，为人父母嘛，没什么是比看着自家小鬼活蹦乱跳更开心的了！"
                },
                {
                    "id": "675760203",
                    "speaker": "韦坚斯基",
                    "text": "每次我干活干得没劲儿了，我就停下来往我家住的方向望两眼。想想小家伙的样子，我就一下子又有力气起来了。"
                },
                {
                    "id": "675760204",
                    "speaker": "韦坚斯基",
                    "text": "你知道吗，自从我跟我的小克利姆奇卡说：「爸爸能在下面看到你哦。」"
                },
                {
                    "id": "675760205",
                    "speaker": "韦坚斯基",
                    "text": "你都不知道他有多兴奋！听他妈妈说，每天他都在底下变着法儿地表现自己，真是可爱啊，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6757603",
            "initDialog": "675760301",
            "dialogues": [
                {
                    "id": "675760301",
                    "speaker": "Player",
                    "text": "唱得很好听。"
                },
                {
                    "id": "675760302",
                    "speaker": "韦坚斯基",
                    "text": "嘿嘿，过奖了，不过就是瞎唱两句劳动号子，给自己提提劲儿罢了。"
                },
                {
                    "id": "675760303",
                    "speaker": "韦坚斯基",
                    "text": "你要是真喜欢听曲子，还得去至冬堡的歌剧院。跟我这种粗嗓门比，那才叫真正的艺术。"
                },
                {
                    "id": "675760304",
                    "speaker": "韦坚斯基",
                    "text": "不瞒你说，我现在哼的这几句，还是我年轻的时候，一位路过的知名歌唱家随口指点我的呢。"
                }
            ]
        },
        {
            "talkId": "6757604",
            "initDialog": "675760401",
            "dialogues": [
                {
                    "id": "675760401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675760402",
                    "speaker": "韦坚斯基",
                    "text": "回见！——哎嗒嗒哎嗒，哎嗒嗒哎嗒！挥起镐头把冰凿！"
                }
            ]
        }
    ]
}