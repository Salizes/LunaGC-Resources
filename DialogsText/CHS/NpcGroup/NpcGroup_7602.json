{
    "groupId": "7602",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "洛朗": 6
    },
    "talks": [
        {
            "talkId": "6760201",
            "initDialog": "676020101",
            "dialogues": [
                {
                    "id": "676020101",
                    "speaker": "洛朗",
                    "text": "要是能早日回到故乡…"
                }
            ]
        },
        {
            "talkId": "6760202",
            "initDialog": "676020201",
            "dialogues": [
                {
                    "id": "676020201",
                    "speaker": "Player",
                    "text": "你很想家吗？"
                },
                {
                    "id": "676020202",
                    "speaker": "洛朗",
                    "text": "啊，向你致意，荣誉骑士！我只是在自言自语，让你见笑了。"
                },
                {
                    "id": "676020203",
                    "speaker": "洛朗",
                    "text": "要说不想家，那当然是在说谎。猎鹿人的香气，清泉镇的午后，果酒湖的微风，漫飞的蒲公英…我又怎么能不怀念呢。"
                },
                {
                    "id": "676020204",
                    "speaker": "洛朗",
                    "text": "和纳尼娜姐姐不一样，我要软弱得多。不过请不必担心，荣誉骑士，无论多么思念故乡，我都会履行好属于我的职责。"
                },
                {
                    "id": "676020205",
                    "speaker": "洛朗",
                    "text": "毕竟，我们的远征就是为了守护我们身后的蒙德…我们的蒙德。"
                }
            ]
        },
        {
            "talkId": "6760203",
            "initDialog": "676020301",
            "dialogues": [
                {
                    "id": "676020301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676020302",
                    "speaker": "洛朗",
                    "text": "再见，荣誉骑士。愿西风指引你的归途。"
                }
            ]
        }
    ]
}