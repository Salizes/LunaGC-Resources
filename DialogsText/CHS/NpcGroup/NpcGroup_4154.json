{
    "groupId": "4154",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "拉玛": 12
    },
    "talks": [
        {
            "talkId": "6415401",
            "initDialog": "641540101",
            "dialogues": [
                {
                    "id": "641540101",
                    "speaker": "拉玛",
                    "text": "同样的食材，只要加上香料，就马上变得不一样了！"
                }
            ]
        },
        {
            "talkId": "6415402",
            "initDialog": "641540201",
            "dialogues": [
                {
                    "id": "641540201",
                    "speaker": "Player",
                    "text": "有什么卖的？"
                },
                {
                    "id": "641540202",
                    "speaker": "拉玛",
                    "text": "都是家家户户做菜会用的调料，我最推荐香辛料哦！"
                }
            ]
        },
        {
            "talkId": "6415403",
            "initDialog": "641540301",
            "dialogues": [
                {
                    "id": "641540301",
                    "speaker": "Player",
                    "text": "关于香料…"
                },
                {
                    "id": "641540302",
                    "speaker": "拉玛",
                    "text": "香料可是我们须弥人做饭必不可少的东西！"
                },
                {
                    "id": "641540303",
                    "speaker": "拉玛",
                    "text": "我作为卖日用调料的商贩，对这个再清楚不过了。"
                },
                {
                    "id": "641540304",
                    "speaker": "拉玛",
                    "text": "大家从我这买走的香辛料数量，比其他所有调料加起来还要多！"
                },
                {
                    "id": "641540305",
                    "speaker": "拉玛",
                    "text": "哪怕再普通的食谱，只要加上须弥独特的香辛料，就一定能获得新生！"
                }
            ]
        },
        {
            "talkId": "6415404",
            "initDialog": "641540401",
            "dialogues": [
                {
                    "id": "641540401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641540402",
                    "speaker": "拉玛",
                    "text": "一定要试试用香辛料做菜啊！"
                }
            ]
        },
        {
            "talkId": "6415405",
            "initDialog": "641540501",
            "dialogues": [
                {
                    "id": "641540501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6415406",
            "initDialog": "641540601",
            "dialogues": [
                {
                    "id": "641540601",
                    "speaker": "拉玛",
                    "text": "唔，以前听说过用香味作弊的手段…哈哈放心，我是不会用的。"
                }
            ]
        },
        {
            "talkId": "6415407",
            "initDialog": "641540701",
            "dialogues": [
                {
                    "id": "641540701",
                    "speaker": "拉玛",
                    "text": "哈哈哈，赢了！啊，因为不太擅长这个，所以偶尔能赢还挺开心的。"
                }
            ]
        },
        {
            "talkId": "7391301",
            "initDialog": "739130101",
            "dialogues": [
                {
                    "id": "739130101",
                    "speaker": "Player",
                    "text": "这么厉害？"
                },
                {
                    "id": "739130102",
                    "speaker": "拉玛",
                    "text": "那当然！"
                },
                {
                    "id": "739130103",
                    "speaker": "拉玛",
                    "text": "哎，口说无凭，你亲自尝尝便知。"
                },
                {
                    "id": "739130104",
                    "speaker": "拉玛",
                    "text": "试试看，是不是比普通的奶酪更加香气四溢？"
                }
            ]
        }
    ]
}