{
    "groupId": "7418",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "捷列布佐夫": 9
    },
    "talks": [
        {
            "talkId": "6741801",
            "initDialog": "674180101",
            "dialogues": [
                {
                    "id": "674180101",
                    "speaker": "捷列布佐夫",
                    "text": "要专心啊…垂钓和人生都是一个道理，有的时候只是疏忽一下，就满盘皆输了…"
                }
            ]
        },
        {
            "talkId": "6741802",
            "initDialog": "674180201",
            "dialogues": [
                {
                    "id": "674180201",
                    "speaker": "Player",
                    "text": "我需要一些钓鱼用品…"
                },
                {
                    "id": "674180202",
                    "speaker": "捷列布佐夫",
                    "text": "没问题，钓鱼，做好准备很重要…人生也是这样…呵呵…"
                }
            ]
        },
        {
            "talkId": "6741803",
            "initDialog": "674180301",
            "dialogues": [
                {
                    "id": "674180301",
                    "speaker": "Player",
                    "text": "那今天赢了吗？"
                },
                {
                    "id": "674180302",
                    "speaker": "捷列布佐夫",
                    "text": "…如果只想着赢的话，是没有办法赢的，衡量人生的标准又岂能如此狭隘呢。"
                },
                {
                    "id": "674180303",
                    "speaker": "捷列布佐夫",
                    "text": "就像我…虽然失去了正经的工作和妻子的体贴，但在垂钓时获得的平静也值回了一切…"
                }
            ]
        },
        {
            "talkId": "6741804",
            "initDialog": "674180401",
            "dialogues": [
                {
                    "id": "674180401",
                    "speaker": "Player",
                    "text": "不打扰你钓鱼了。"
                },
                {
                    "id": "674180402",
                    "speaker": "捷列布佐夫",
                    "text": "没关系，反正大概也钓不上几条…"
                }
            ]
        },
        {
            "talkId": "6741805",
            "initDialog": "674180501",
            "dialogues": [
                {
                    "id": "674180501",
                    "speaker": "Player",
                    "text": "不如找份工作如何？"
                },
                {
                    "id": "674180502",
                    "speaker": "捷列布佐夫",
                    "text": "呵呵…现在工作哪那么好找，更何况，要是我去工作了，谁在这儿卖钓鱼用具给你啊…"
                },
                {
                    "id": "674180503",
                    "speaker": "捷列布佐夫",
                    "text": "又不是不能活，且过着吧，钓鱼在于钓而不在于鱼，人生在于人而不在于生…"
                },
                {
                    "id": "674180504",
                    "speaker": "捷列布佐夫",
                    "text": "呃我是说…鱼和人都还是熟点好。"
                }
            ]
        },
        {
            "talkId": "6741806",
            "initDialog": "674180601",
            "dialogues": [
                {
                    "id": "674180601",
                    "speaker": "Player",
                    "text": "是、是吗？"
                },
                {
                    "id": "674180602",
                    "speaker": "捷列布佐夫",
                    "text": "正是如此啊…不过要是真的能钓上一条就好了。"
                }
            ]
        }
    ]
}