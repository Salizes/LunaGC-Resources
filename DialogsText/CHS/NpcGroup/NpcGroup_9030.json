{
    "groupId": "9030",
    "total_dialogue_lines": 52,
    "speaker_counts": {
        "Player": 16,
        "钟离": 36
    },
    "talks": [
        {
            "talkId": "6903001",
            "initDialog": "690300101",
            "dialogues": [
                {
                    "id": "690300101",
                    "speaker": "钟离",
                    "text": "#好久不见，{NICKNAME}。"
                },
                {
                    "id": "690300102",
                    "speaker": "钟离",
                    "text": "最近过得如何？"
                }
            ]
        },
        {
            "talkId": "6903002",
            "initDialog": "690300201",
            "dialogues": [
                {
                    "id": "690300201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690300202",
                    "speaker": "钟离",
                    "text": "氛围宜人，很合我意。",
                    "choices": [
                        {
                            "id": "690300203",
                            "text": "能让你满意就好。",
                            "response": [
                                {
                                    "id": "690300204",
                                    "speaker": "钟离",
                                    "text": "相识至今，我对你的行事原则和为人处世算是略知一二。"
                                },
                                {
                                    "id": "690300205",
                                    "speaker": "钟离",
                                    "text": "你的选择值得信赖。"
                                }
                            ]
                        },
                        {
                            "id": "690300206",
                            "text": "我怕这些对你来说太过幼稚。",
                            "response": [
                                {
                                    "id": "690300207",
                                    "speaker": "钟离",
                                    "text": "万事万物大都是从无到有，从小到大，循序渐进。"
                                },
                                {
                                    "id": "690300208",
                                    "speaker": "钟离",
                                    "text": "我只是年长些，不意味着古板到无法欣赏年轻人的优秀。"
                                },
                                {
                                    "id": "690300209",
                                    "speaker": "钟离",
                                    "text": "你的品位，向来令人安心。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903003",
            "initDialog": "690300301",
            "dialogues": [
                {
                    "id": "690300301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690300302",
                    "speaker": "钟离",
                    "text": "乐意奉陪。想聊些什么？"
                },
                {
                    "id": "690300303",
                    "speaker": "Player",
                    "text": "想听你说些从前的事。"
                },
                {
                    "id": "690300304",
                    "speaker": "钟离",
                    "text": "从前的事啊…那就得找个闲暇日子慢慢说了。"
                },
                {
                    "id": "690300305",
                    "speaker": "钟离",
                    "text": "千年的故事，一时半会儿可说不完。"
                },
                {
                    "id": "690300306",
                    "speaker": "钟离",
                    "text": "想听得舒服，还需要一壶好茶、两把好椅子、一处好庭院。"
                },
                {
                    "id": "690300307",
                    "speaker": "Player",
                    "text": "居然还要准备院子吗？"
                },
                {
                    "id": "690300308",
                    "speaker": "钟离",
                    "text": "哈哈，怎么会呢？这里就好，我们坐下慢慢聊。"
                }
            ]
        },
        {
            "talkId": "6903004",
            "initDialog": "690300401",
            "dialogues": [
                {
                    "id": "690300401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690300402",
                    "speaker": "钟离",
                    "text": "最近几日，我在考虑家宅布置的事。"
                },
                {
                    "id": "690300403",
                    "speaker": "钟离",
                    "text": "你这住处景色别致，陈设典雅，我很是中意。"
                },
                {
                    "id": "690300404",
                    "speaker": "钟离",
                    "text": "我经常出入此地，多有叨扰。"
                },
                {
                    "id": "690300405",
                    "speaker": "钟离",
                    "text": "如此说来，也该为这处「洞天」出几份力才是…"
                },
                {
                    "id": "690300406",
                    "speaker": "钟离",
                    "text": "而且…"
                },
                {
                    "id": "690300407",
                    "speaker": "钟离",
                    "text": "要是你不嫌弃，我还想再寻些礼物给你。"
                },
                {
                    "id": "690300408",
                    "speaker": "钟离",
                    "text": "可惜…俗话说得好，宝剑赠英雄。配得上你的礼物，着实有些少了。"
                },
                {
                    "id": "690300409",
                    "speaker": "钟离",
                    "text": "幸好我们来日方长，不必急于一时决定。",
                    "choices": [
                        {
                            "id": "690300410",
                            "text": "钟离不必客气。",
                            "response": [
                                {
                                    "id": "690300412",
                                    "speaker": "钟离",
                                    "text": "虽说我已不是岩神，但怎么说也是个老派璃月人。"
                                },
                                {
                                    "id": "690300413",
                                    "speaker": "钟离",
                                    "text": "我有我的礼数，到时，你放心收下便是。",
                                    "choices": [
                                        {
                                            "id": "690300414",
                                            "text": "不愧是钟离，真讲究啊！",
                                            "response": [
                                                {
                                                    "id": "690300416",
                                                    "speaker": "钟离",
                                                    "text": "嗯…你答应就好。"
                                                },
                                                {
                                                    "id": "690300417",
                                                    "speaker": "钟离",
                                                    "text": "我从你身上看到了许多。时光永无止境…人生自在，靠的还是一颗坚定又澄澈的心。"
                                                },
                                                {
                                                    "id": "690300418",
                                                    "speaker": "钟离",
                                                    "text": "像这样与你相处，实在是热闹又快活的事。"
                                                },
                                                {
                                                    "id": "690300419",
                                                    "speaker": "钟离",
                                                    "text": "感谢你，朋友。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690300415",
                                            "text": "钟离的审美我当然认可。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690300411",
                            "text": "有这份心就足够了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903005",
            "initDialog": "690300501",
            "dialogues": [
                {
                    "id": "690300501",
                    "speaker": "Player",
                    "text": "早啊，钟离。"
                },
                {
                    "id": "690300502",
                    "speaker": "钟离",
                    "text": "早。旅行虽好，也不能过于劳累了。"
                }
            ]
        },
        {
            "talkId": "6903006",
            "initDialog": "690300601",
            "dialogues": [
                {
                    "id": "690300601",
                    "speaker": "Player",
                    "text": "晚安，钟离。"
                },
                {
                    "id": "690300602",
                    "speaker": "钟离",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690300603",
                    "speaker": "钟离",
                    "text": "夜色已深，你趁早休息吧。做个好梦。"
                }
            ]
        },
        {
            "talkId": "6903007",
            "initDialog": "690300701",
            "dialogues": [
                {
                    "id": "690300701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903008",
            "initDialog": "690300801",
            "dialogues": [
                {
                    "id": "690300801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903009",
            "initDialog": "690300901",
            "dialogues": [
                {
                    "id": "690300901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903050",
            "initDialog": "690305001",
            "dialogues": [
                {
                    "id": "690305001",
                    "speaker": "钟离",
                    "text": "璃月人在布设书斋器物时，有着林林总总的规矩，大致可统括为三大派系，九种讲究。"
                },
                {
                    "id": "690305002",
                    "speaker": "钟离",
                    "text": "你未曾听我讲解其中的门道，却避开了所有忌讳。"
                },
                {
                    "id": "690305003",
                    "speaker": "钟离",
                    "text": "也许与你同行时，某种默契，在你我之间已然生根了。"
                }
            ]
        },
        {
            "talkId": "6903051",
            "initDialog": "690305101",
            "dialogues": [
                {
                    "id": "690305101",
                    "speaker": "钟离",
                    "text": "繁华的璃月，也是从商铺寥寥的街道发展而来。"
                },
                {
                    "id": "690305102",
                    "speaker": "钟离",
                    "text": "你有包容万象的才华，挥斥八极。"
                },
                {
                    "id": "690305103",
                    "speaker": "钟离",
                    "text": "与你同行的日子，于我而言，亦是「黄金」。"
                }
            ]
        }
    ]
}