    "talks": [
        {
            "talkId": "6972201",
            "initDialog": "697220101",
            "dialogues": [
                {
                    "id": "697220101",
                    "speaker": "欧仁妮",
                    "text": "嗯，这次进口水果的生意谈得很顺利，再来几盘酣畅的七圣召唤，蒙德之行就完美了！"
                },
                {
                    "id": "697220102",
                    "speaker": "欧仁妮",
                    "text": "我正在找牌友，要不要来切磋一下？"
                }
            ]
        },
        {
            "talkId": "6972202",
            "initDialog": "697220201",
            "dialogues": [
                {
                    "id": "697220201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6972203",
            "initDialog": "697220301",
            "dialogues": [
                {
                    "id": "697220301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697220302",
                    "speaker": "欧仁妮",
                    "text": "好哦！如果你去了枫丹廷，记得光顾我的水果摊哦！"
                }
            ]
        },
        {
            "talkId": "6972204",
            "initDialog": "697220401",
            "dialogues": [
                {
                    "id": "697220401",
                    "speaker": "欧仁妮",
                    "text": "新鲜的牌组，比落落莓还酸甜，让你惊讶了吧！"
                }
            ]
        },
        {
            "talkId": "6972205",
            "initDialog": "697220501",
            "dialogues": [
                {
                    "id": "697220501",
                    "speaker": "欧仁妮",
                    "text": "不行不行！你的打法就像堇瓜…让人把握不好处理的火候！"
                }
            ]
        }
    ]
}