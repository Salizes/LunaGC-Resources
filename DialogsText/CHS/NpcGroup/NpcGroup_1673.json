{
    "groupId": "1673",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "楠塔克": 13
    },
    "talks": [
        {
            "talkId": "6167301",
            "initDialog": "616730101",
            "dialogues": [
                {
                    "id": "616730101",
                    "speaker": "楠塔克",
                    "text": "外海深处的漆黑巨鲸，这种题材一定能够大卖！"
                }
            ]
        },
        {
            "talkId": "6167302",
            "initDialog": "616730201",
            "dialogues": [
                {
                    "id": "616730201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "616730202",
                    "speaker": "楠塔克",
                    "text": "我是楠塔克，蒙德钓鱼协会的负责人之一。"
                },
                {
                    "id": "616730203",
                    "speaker": "楠塔克",
                    "text": "嗯？看你的样子，是不是一眼就认出我的另一个身份了，果然是人怕出名啊，哈哈！"
                },
                {
                    "id": "616730204",
                    "speaker": "楠塔克",
                    "text": "那我也就不装模作样了，没错！著名海洋作家楠塔克，正是鄙人。"
                },
                {
                    "id": "616730205",
                    "speaker": "楠塔克",
                    "text": "欸？你说没有见到过我的书？那是因为还没发售。放心！很快就能在市面上见到我的大作了，我保证。"
                },
                {
                    "id": "616730206",
                    "speaker": "楠塔克",
                    "text": "嗯…如果你想的话，签售会的时候我可以优先给你签名。"
                }
            ]
        },
        {
            "talkId": "6167303",
            "initDialog": "616730301",
            "dialogues": [
                {
                    "id": "616730301",
                    "speaker": "Player",
                    "text": "什么漆黑巨鲸？"
                },
                {
                    "id": "616730302",
                    "speaker": "楠塔克",
                    "text": "嘘！小点声，这是我正在构思的另一本巨著！"
                },
                {
                    "id": "616730303",
                    "speaker": "楠塔克",
                    "text": "看你这么有兴趣，我就稍微透露一点。"
                },
                {
                    "id": "616730304",
                    "speaker": "楠塔克",
                    "text": "那将会是一个豪迈的渔夫与惊涛骇浪为伍，追寻外海中的漆黑巨鲸的史诗故事，一定能够大卖！"
                },
                {
                    "id": "616730305",
                    "speaker": "楠塔克",
                    "text": "不过你可别告诉其他人，半个字都不要提。"
                },
                {
                    "id": "616730306",
                    "speaker": "楠塔克",
                    "text": "这种绝妙的灵感，要是给人抄了去，那可不得了。"
                }
            ]
        },
        {
            "talkId": "6167304",
            "initDialog": "616730401",
            "dialogues": [
                {
                    "id": "616730401",
                    "speaker": "Player",
                    "text": "我需要一些钓鱼用品。"
                },
                {
                    "id": "616730402",
                    "speaker": "楠塔克",
                    "text": "恰好我这里有一些协会的存货，你瞧瞧有没有合适的。"
                }
            ]
        },
        {
            "talkId": "6167305",
            "initDialog": "616730501",
            "dialogues": [
                {
                    "id": "616730501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616730502",
                    "speaker": "楠塔克",
                    "text": "再见，这次的选题一定会受欢迎的！"
                }
            ]
        }
    ]
}