    "talks": [
        {
            "talkId": "6741901",
            "initDialog": "674190101",
            "dialogues": [
                {
                    "id": "674190101",
                    "speaker": "叶里谢耶夫",
                    "text": "要来点什么吗…请往里走…呼啊…"
                }
            ]
        },
        {
            "talkId": "6741902",
            "initDialog": "674190201",
            "dialogues": [
                {
                    "id": "674190201",
                    "speaker": "Player",
                    "text": "你看上去很困。"
                },
                {
                    "id": "674190202",
                    "speaker": "叶里谢耶夫",
                    "text": "是有一点，但是…哈…兽怪有的时候就是会这样…"
                },
                {
                    "id": "674190203",
                    "speaker": "叶里谢耶夫",
                    "text": "不过我向您保证，一定不会…呼，一定不会影响我的工作。"
                }
            ]
        },
        {
            "talkId": "6741903",
            "initDialog": "674190301",
            "dialogues": [
                {
                    "id": "674190301",
                    "speaker": "Player",
                    "text": "不如去休息一会儿？"
                },
                {
                    "id": "674190302",
                    "speaker": "叶里谢耶夫",
                    "text": "哦…客人，休息可…解决不了这问题。"
                },
                {
                    "id": "674190303",
                    "speaker": "叶里谢耶夫",
                    "text": "天气变化的时候，不同兽怪的身体也会…有些不同反应…和人类不一样…"
                },
                {
                    "id": "674190304",
                    "speaker": "叶里谢耶夫",
                    "text": "我、我就是比平时更容易困…"
                }
            ]
        },
        {
            "talkId": "6741904",
            "initDialog": "674190401",
            "dialogues": [
                {
                    "id": "674190401",
                    "speaker": "Player",
                    "text": "没什么想吃的。"
                },
                {
                    "id": "674190402",
                    "speaker": "叶里谢耶夫",
                    "text": "好…哈，好的…"
                }
            ]
        }
    ]
}