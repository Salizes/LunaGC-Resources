{
    "groupId": "5052",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "安洁莉可": 12
    },
    "talks": [
        {
            "talkId": "6505201",
            "initDialog": "650520101",
            "dialogues": [
                {
                    "id": "650520101",
                    "speaker": "安洁莉可",
                    "text": "怎么还没有新的侦探小说…"
                }
            ]
        },
        {
            "talkId": "6505202",
            "initDialog": "650520201",
            "dialogues": [
                {
                    "id": "650520201",
                    "speaker": "Player",
                    "text": "侦探小说？"
                },
                {
                    "id": "650520202",
                    "speaker": "安洁莉可",
                    "text": "《大侦探赫尔洛克》、《奥西兹小姐事件簿》…枫丹有名的推理作品那么多，就算没读过，你至少也听说过它们的名字吧？"
                },
                {
                    "id": "650520203",
                    "speaker": "安洁莉可",
                    "text": "我对这种悬疑类的题材基本来者不拒。只可惜，作者连载的速度永远没我看的速度快…每次都要等好久…"
                }
            ]
        },
        {
            "talkId": "6505203",
            "initDialog": "650520301",
            "dialogues": [
                {
                    "id": "650520301",
                    "speaker": "Player",
                    "text": "你很爱看书？"
                },
                {
                    "id": "650520302",
                    "speaker": "安洁莉可",
                    "text": "那是当然的。我对书的好坏有一套自己的评价标准。"
                },
                {
                    "id": "650520303",
                    "speaker": "安洁莉可",
                    "text": "比如我更喜欢枫丹本地的创作风格，同样是侦探推理作品，稻妻那边的轻小说，总有种说不上来的伤春悲秋…"
                },
                {
                    "id": "650520304",
                    "speaker": "安洁莉可",
                    "text": "探案已经足够好看了，为什么非得加超多情情爱爱？我是来看完整清晰的逻辑链条的，又不是来读什么爱情小说的…"
                }
            ]
        },
        {
            "talkId": "6505204",
            "initDialog": "650520401",
            "dialogues": [
                {
                    "id": "650520401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650520402",
                    "speaker": "安洁莉可",
                    "text": "再见，我该把旧书翻出来再看几遍了。"
                }
            ]
        },
        {
            "talkId": "6505205",
            "initDialog": "650520501",
            "dialogues": [
                {
                    "id": "650520501",
                    "speaker": "Player",
                    "text": "听着好像有点道理。"
                },
                {
                    "id": "650520502",
                    "speaker": "安洁莉可",
                    "text": "呵，看来我们也挺聊得上来啊。"
                },
                {
                    "id": "650520503",
                    "speaker": "安洁莉可",
                    "text": "实不相瞒，我最近结识了一位笔友，我俩很聊得来，对方暗示了想要在德波大饭店见面，我正犹豫着要不要答应他…"
                },
                {
                    "id": "650520504",
                    "speaker": "安洁莉可",
                    "text": "做笔友自然安全，可要是真见了面，一来二去聊出了感情，从今往后，我还要怎么标榜自己「理性至上」呢？"
                }
            ]
        },
        {
            "talkId": "6505206",
            "initDialog": "650520601",
            "dialogues": [
                {
                    "id": "650520601",
                    "speaker": "Player",
                    "text": "我持保留意见。"
                },
                {
                    "id": "650520602",
                    "speaker": "安洁莉可",
                    "text": "哟，看来我是遇到意见相左的人了。"
                },
                {
                    "id": "650520603",
                    "speaker": "安洁莉可",
                    "text": "没关系，审美是主观的，在这一点上我无意说服你。让我们在这片大陆上获取各自想要的食粮。"
                }
            ]
        }
    ]
}