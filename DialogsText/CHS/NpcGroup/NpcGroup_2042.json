{
    "groupId": "2042",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "向明": 13
    },
    "talks": [
        {
            "talkId": "6204201",
            "initDialog": "620420101",
            "dialogues": [
                {
                    "id": "620420101",
                    "speaker": "向明",
                    "text": "嗯？我是在执行任务的千岩军，请小声点…"
                },
                {
                    "id": "620420102",
                    "speaker": "向明",
                    "text": "另外，请不要发出「嘘」之类的声音，拜托了。"
                }
            ]
        },
        {
            "talkId": "6204202",
            "initDialog": "620420201",
            "dialogues": [
                {
                    "id": "620420201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "620420202",
                    "speaker": "向明",
                    "text": "小声点！声音太大可能会惊动到监视目标！"
                },
                {
                    "id": "620420203",
                    "speaker": "向明",
                    "text": "啊，都怪你…不知不觉我也大声了起来…"
                },
                {
                    "id": "620420204",
                    "speaker": "向明",
                    "text": "…我是负责看守钱庄的千岩军，我观察那个人很久了，就是那个在钱庄门口徘徊的家伙。"
                },
                {
                    "id": "620420205",
                    "speaker": "向明",
                    "text": "他既不取钱，也不存钱，每次一站就是一天，实在是太可疑了。"
                },
                {
                    "id": "620420206",
                    "speaker": "向明",
                    "text": "所以我得盯好了他，以防他给盗宝团留下什么记号之类的，只是…"
                },
                {
                    "id": "620420207",
                    "speaker": "Player",
                    "text": "只是什么？"
                },
                {
                    "id": "620420208",
                    "speaker": "向明",
                    "text": "只是…他每次一站就是一天！"
                },
                {
                    "id": "620420209",
                    "speaker": "向明",
                    "text": "我顶得住，可是我的…我的那里顶不住啊！已经一天没去厕所了…"
                },
                {
                    "id": "620420210",
                    "speaker": "向明",
                    "text": "为什么，为什么他还不走啊…"
                },
                {
                    "id": "620420211",
                    "speaker": "向明",
                    "text": "真的快撑不住了…"
                }
            ]
        },
        {
            "talkId": "6204203",
            "initDialog": "620420301",
            "dialogues": [
                {
                    "id": "620420301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620420302",
                    "speaker": "向明",
                    "text": "再见，快走吧。"
                },
                {
                    "id": "620420303",
                    "speaker": "向明",
                    "text": "…啊，可恶，千岩军可不能临阵脱逃啊…"
                }
            ]
        }
    ]
}