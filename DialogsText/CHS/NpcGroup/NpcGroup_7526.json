{
    "groupId": "7526",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "因诺肯季": 6
    },
    "talks": [
        {
            "talkId": "6752601",
            "initDialog": "675260101",
            "dialogues": [
                {
                    "id": "675260101",
                    "speaker": "因诺肯季",
                    "text": "看在女皇陛下的份上…这到底是什么意思？"
                }
            ]
        },
        {
            "talkId": "6752602",
            "initDialog": "675260201",
            "dialogues": [
                {
                    "id": "675260201",
                    "speaker": "Player",
                    "text": "你在看什么？"
                },
                {
                    "id": "675260202",
                    "speaker": "因诺肯季",
                    "text": "新基捷那边寄来的公函。您瞧，我是至冬宫的文官，主要负责处理与那边相关的行政事务。"
                },
                {
                    "id": "675260203",
                    "speaker": "因诺肯季",
                    "text": "只不过——您看这些妖精语！为了彰显自己血脉古老，那些矮灵贵族现在还在坚持用古老生僻的本族方言来书写公文！"
                },
                {
                    "id": "675260204",
                    "speaker": "因诺肯季",
                    "text": "我刚才还专门去问了博学的奥维先尼科夫先生，结果您猜怎么着，他看了半天，说他也看不懂！"
                },
                {
                    "id": "675260205",
                    "speaker": "因诺肯季",
                    "text": "女皇在上啊，他一个矮灵都看不懂，我又能怎么办？"
                }
            ]
        },
        {
            "talkId": "6752603",
            "initDialog": "675260301",
            "dialogues": [
                {
                    "id": "675260301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675260302",
                    "speaker": "因诺肯季",
                    "text": "行吧，希望在下班前，我能靠瞎猜把这份公函的意思给凑出来…"
                }
            ]
        }
    ]
}