{
    "groupId": "5190",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "尚贝兰": 12
    },
    "talks": [
        {
            "talkId": "6519001",
            "initDialog": "651900101",
            "dialogues": [
                {
                    "id": "651900101",
                    "speaker": "尚贝兰",
                    "text": "老板，要领航吗？雇我吧！雇我准没错！"
                }
            ]
        },
        {
            "talkId": "6519002",
            "initDialog": "651900201",
            "dialogues": [
                {
                    "id": "651900201",
                    "speaker": "Player",
                    "text": "你在这里负责领航？"
                },
                {
                    "id": "651900202",
                    "speaker": "尚贝兰",
                    "text": "没错！我是…曾经是，柔灯港里最好的领航员，对这周围的水文环境了如指掌。"
                },
                {
                    "id": "651900203",
                    "speaker": "尚贝兰",
                    "text": "就算是您想开一艘小筏子进港。我也能保证让您的筏子安安稳稳地入港，一点颠簸都不会有。"
                }
            ]
        },
        {
            "talkId": "6519003",
            "initDialog": "651900301",
            "dialogues": [
                {
                    "id": "651900301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651900302",
                    "speaker": "尚贝兰",
                    "text": "再见！老板，您要是想雇我的话，就直接过来找我吧！"
                }
            ]
        },
        {
            "talkId": "6519004",
            "initDialog": "651900401",
            "dialogues": [
                {
                    "id": "651900401",
                    "speaker": "Player",
                    "text": "曾经是？"
                },
                {
                    "id": "651900402",
                    "speaker": "尚贝兰",
                    "text": "呃…咳！柔灯港里没有什么好混的，没前途，没意思，钱还开得少，不如出来自己干。"
                },
                {
                    "id": "651900403",
                    "speaker": "尚贝兰",
                    "text": "老板，如果您雇我的话，我…我还可以帮牵线搭桥，我认识肖西韦尔老大，有他罩着，没人敢动您的货物！"
                },
                {
                    "id": "651900404",
                    "speaker": "尚贝兰",
                    "text": "怎么样？考虑一下吧，要是想雇我的话，就过来找我。"
                }
            ]
        },
        {
            "talkId": "6519005",
            "initDialog": "651900501",
            "dialogues": [
                {
                    "id": "651900501",
                    "speaker": "Player",
                    "text": "曾经是？"
                },
                {
                    "id": "651900502",
                    "speaker": "尚贝兰",
                    "text": "呃…咳！柔灯港里没有什么好混的，没前途，没意思，钱还开得少，不如出来自己干。"
                },
                {
                    "id": "651900503",
                    "speaker": "尚贝兰",
                    "text": "老板，如果您雇我的话，我…我还可以帮牵线搭桥，我认识…"
                },
                {
                    "id": "651900504",
                    "speaker": "尚贝兰",
                    "text": "您、您是…！哎呀！久仰啊，我听肖西韦尔老大提起过您，您真是身手不凡啊！"
                },
                {
                    "id": "651900505",
                    "speaker": "尚贝兰",
                    "text": "这样，您要是雇我干活的话，我给您打…八折！"
                },
                {
                    "id": "651900506",
                    "speaker": "尚贝兰",
                    "text": "怎么样？考虑一下吧，要是想雇我的话，就过来找我。"
                }
            ]
        }
    ]
}