{
    "groupId": "2255",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "木李": 8
    },
    "talks": [
        {
            "talkId": "6225501",
            "initDialog": "622550101",
            "dialogues": [
                {
                    "id": "622550101",
                    "speaker": "木李",
                    "text": "你好呀，高高的客人，你会钓鱼吗？"
                }
            ]
        },
        {
            "talkId": "6225502",
            "initDialog": "622550201",
            "dialogues": [
                {
                    "id": "622550201",
                    "speaker": "Player",
                    "text": "没怎么钓过…"
                },
                {
                    "id": "622550202",
                    "speaker": "木李",
                    "text": "那我们一起来钓鱼吧！钓鱼是世界上最有意思的事情！"
                }
            ]
        },
        {
            "talkId": "6225503",
            "initDialog": "622550301",
            "dialogues": [
                {
                    "id": "622550301",
                    "speaker": "Player",
                    "text": "我可是钓鱼大师！"
                },
                {
                    "id": "622550302",
                    "speaker": "木李",
                    "text": "真的吗？那你说…钓鱼能钓到玉器吗？"
                }
            ]
        },
        {
            "talkId": "6225504",
            "initDialog": "622550401",
            "dialogues": [
                {
                    "id": "622550401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622550402",
                    "speaker": "木李",
                    "text": "再见，我要继续想钓鱼的事了！"
                }
            ]
        },
        {
            "talkId": "6225505",
            "initDialog": "622550501",
            "dialogues": [
                {
                    "id": "622550501",
                    "speaker": "Player",
                    "text": "你为什么会有这种想法…"
                },
                {
                    "id": "622550502",
                    "speaker": "木李",
                    "text": "我最喜欢钓鱼了，特别是跟琼玖在一起钓鱼！"
                },
                {
                    "id": "622550503",
                    "speaker": "木李",
                    "text": "可我爸爸说，「家里的玉器行当总要有人来继承」…"
                },
                {
                    "id": "622550504",
                    "speaker": "木李",
                    "text": "如果能在钓鱼的时候能钓到玉器就完美了，对不对！"
                },
                {
                    "id": "622550505",
                    "speaker": "木李",
                    "text": "或者，我让小茂哥哥来学做玉器，我和琼玖去钓鱼，这样也不错！"
                }
            ]
        }
    ]
}