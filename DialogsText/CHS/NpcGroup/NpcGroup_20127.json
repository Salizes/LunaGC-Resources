{
    "groupId": "20127",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "亨利莫顿": 7
    },
    "talks": [
        {
            "talkId": "7101260",
            "initDialog": "710126001",
            "dialogues": [
                {
                    "id": "710126001",
                    "speaker": "亨利莫顿",
                    "text": "这岛这么远，我可怎么过去啊…"
                }
            ]
        },
        {
            "talkId": "7101261",
            "initDialog": "710126101",
            "dialogues": [
                {
                    "id": "710126101",
                    "speaker": "Player",
                    "text": "用风之翼吧。"
                },
                {
                    "id": "710126102",
                    "speaker": "亨利莫顿",
                    "text": "算了吧，我去了教令院之后，就一年到头呆在屋内，基本上不去室外活动。"
                },
                {
                    "id": "710126103",
                    "speaker": "亨利莫顿",
                    "text": "而且在教令院也基本用不上风之翼，我那些风之翼的操作已经全还给考官了…"
                },
                {
                    "id": "710126104",
                    "speaker": "亨利莫顿",
                    "text": "要我用风之翼飞过去，飞一半我就要掉水里…"
                }
            ]
        },
        {
            "talkId": "7101262",
            "initDialog": "710126201",
            "dialogues": [
                {
                    "id": "710126201",
                    "speaker": "Player",
                    "text": "雇船吧。"
                },
                {
                    "id": "710126202",
                    "speaker": "亨利莫顿",
                    "text": "我也这么想，我记得荆夫港那里可以雇到船，但是那里也太远了。"
                },
                {
                    "id": "710126203",
                    "speaker": "亨利莫顿",
                    "text": "这一来一去也不知道要花多少时间…"
                },
                {
                    "id": "710126204",
                    "speaker": "亨利莫顿",
                    "text": "但是我总不能自己造一艘吧，这教令院里也没教过啊…"
                }
            ]
        }
    ]
}