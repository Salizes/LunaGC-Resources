{
    "groupId": "6063",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "佩蕾·努伊": 10
    },
    "talks": [
        {
            "talkId": "6606301",
            "initDialog": "660630101",
            "dialogues": [
                {
                    "id": "660630101",
                    "speaker": "佩蕾·努伊",
                    "text": "该整理画片了…对了，还得再买些底片。"
                }
            ]
        },
        {
            "talkId": "6606302",
            "initDialog": "660630201",
            "dialogues": [
                {
                    "id": "660630201",
                    "speaker": "Player",
                    "text": "你喜欢摄影吗？"
                },
                {
                    "id": "660630202",
                    "speaker": "佩蕾·努伊",
                    "text": "很喜欢，但我不怎么拍风景，更爱拍人物。"
                },
                {
                    "id": "660630203",
                    "speaker": "佩蕾·努伊",
                    "text": "我拍了好多家族合影，存了几大本相册呢。小侄女夏萝最配合，相册里出镜最多的就是她。"
                },
                {
                    "id": "660630204",
                    "speaker": "佩蕾·努伊",
                    "text": "我还喜欢收集「名人」合照。凡是来这里泡过温泉的英雄战士们，我都会拉着他们拍一张。"
                }
            ]
        },
        {
            "talkId": "6606303",
            "initDialog": "660630301",
            "dialogues": [
                {
                    "id": "660630301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660630302",
                    "speaker": "佩蕾·努伊",
                    "text": "再见了。"
                }
            ]
        },
        {
            "talkId": "6606304",
            "initDialog": "660630401",
            "dialogues": [
                {
                    "id": "660630401",
                    "speaker": "Player",
                    "text": "那你应该认识阿伽娅吧？"
                },
                {
                    "id": "660630402",
                    "speaker": "佩蕾·努伊",
                    "text": "阿伽娅…哎呀，我没认错的话，你是玛拉妮带来的那个朋友吧？"
                },
                {
                    "id": "660630403",
                    "speaker": "佩蕾·努伊",
                    "text": "阿伽娅和我提起过，谢谢你给流泉之众提供的帮助，谢谢你。"
                },
                {
                    "id": "660630404",
                    "speaker": "佩蕾·努伊",
                    "text": "唉，阿伽娅…她说过这一天总会到来的，还让我们不要太难过…"
                },
                {
                    "id": "660630405",
                    "speaker": "佩蕾·努伊",
                    "text": "对了，我记得我有一张阿伽娅和火神大人一起的画片，可帅气了！"
                },
                {
                    "id": "660630406",
                    "speaker": "佩蕾·努伊",
                    "text": "可惜没带在身边，以后找出来给大伙看看吧。"
                }
            ]
        }
    ]
}