{
    "groupId": "6213",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "马塔拉": 13
    },
    "talks": [
        {
            "talkId": "6621301",
            "initDialog": "662130101",
            "dialogues": [
                {
                    "id": "662130101",
                    "speaker": "马塔拉",
                    "text": "抱歉，在出诊之前，我先得清理一些精神垃圾。"
                }
            ]
        },
        {
            "talkId": "6621302",
            "initDialog": "662130201",
            "dialogues": [
                {
                    "id": "662130201",
                    "speaker": "Player",
                    "text": "精神垃圾…？"
                },
                {
                    "id": "662130202",
                    "speaker": "马塔拉",
                    "text": "用词太直白了吗？那换个说法，「精神负担」，应该更好理解了吧。"
                },
                {
                    "id": "662130203",
                    "speaker": "马塔拉",
                    "text": "很多人通过冥想获得了更强的自我认知，或者更深层次的知识。"
                },
                {
                    "id": "662130204",
                    "speaker": "马塔拉",
                    "text": "我不需要这么厉害的效果，只要能获得内心的宁静就可以了。"
                }
            ]
        },
        {
            "talkId": "6621303",
            "initDialog": "662130301",
            "dialogues": [
                {
                    "id": "662130301",
                    "speaker": "Player",
                    "text": "保重。"
                },
                {
                    "id": "662130302",
                    "speaker": "马塔拉",
                    "text": "多谢。"
                }
            ]
        },
        {
            "talkId": "6621304",
            "initDialog": "662130401",
            "dialogues": [
                {
                    "id": "662130401",
                    "speaker": "Player",
                    "text": "有什么烦恼吗？"
                },
                {
                    "id": "662130402",
                    "speaker": "马塔拉",
                    "text": "你要知道，有时帮人看病，就跟加入了他们的生活没什么两样。"
                },
                {
                    "id": "662130403",
                    "speaker": "马塔拉",
                    "text": "尤其是慢性病患者，比如受到过深渊侵蚀的那些。"
                },
                {
                    "id": "662130404",
                    "speaker": "马塔拉",
                    "text": "我会定期整理他们的病例，记录患者状况，难免会时不时想起这些。"
                },
                {
                    "id": "662130405",
                    "speaker": "马塔拉",
                    "text": "这对我来说，其实也是一种不健康的状态。"
                },
                {
                    "id": "662130406",
                    "speaker": "马塔拉",
                    "text": "但医者难以自医，只能希望我在冥想的时候，能短暂脱离这些困扰吧。"
                }
            ]
        },
        {
            "talkId": "6621305",
            "initDialog": "662130501",
            "dialogues": [
                {
                    "id": "662130501",
                    "speaker": "马塔拉",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6621306",
            "initDialog": "662130601",
            "dialogues": [
                {
                    "id": "662130601",
                    "speaker": "马塔拉",
                    "text": "赢…赢了？哦，多谢…"
                }
            ]
        },
        {
            "talkId": "6621307",
            "initDialog": "662130701",
            "dialogues": [
                {
                    "id": "662130701",
                    "speaker": "马塔拉",
                    "text": "…欸，奇怪？刚刚我为什么要这么出牌来着？"
                }
            ]
        }
    ]
}