{
    "groupId": "2262",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "琼玖": 8
    },
    "talks": [
        {
            "talkId": "6226201",
            "initDialog": "622620101",
            "dialogues": [
                {
                    "id": "622620101",
                    "speaker": "琼玖",
                    "text": "以前好像没见过你…你是从遗珑埠来的吗？会做玉器吗？"
                }
            ]
        },
        {
            "talkId": "6226202",
            "initDialog": "622620201",
            "dialogues": [
                {
                    "id": "622620201",
                    "speaker": "Player",
                    "text": "还真不会…"
                },
                {
                    "id": "622620202",
                    "speaker": "琼玖",
                    "text": "啊…那好可惜哦。做玉器可是世界上最有趣的事情了。"
                },
                {
                    "id": "622620203",
                    "speaker": "琼玖",
                    "text": "唉，要是钓鱼能钓上来玉器的话就好了…"
                }
            ]
        },
        {
            "talkId": "6226203",
            "initDialog": "622620301",
            "dialogues": [
                {
                    "id": "622620301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622620302",
                    "speaker": "琼玖",
                    "text": "嗯，那就再见啦。"
                }
            ]
        },
        {
            "talkId": "6226204",
            "initDialog": "622620401",
            "dialogues": [
                {
                    "id": "622620401",
                    "speaker": "Player",
                    "text": "你为什么会有这种想法…"
                },
                {
                    "id": "622620402",
                    "speaker": "琼玖",
                    "text": "如果钓鱼能钓上来玉器的话，我就可以天天跟木李一起玩了…"
                },
                {
                    "id": "622620403",
                    "speaker": "琼玖",
                    "text": "虽然钓鱼也很好玩，但还是制作玉器更有意思。"
                },
                {
                    "id": "622620404",
                    "speaker": "琼玖",
                    "text": "只不过，如果不按照家里的要求练好钓鱼的话，爸爸妈妈的手艺就要失传了。"
                },
                {
                    "id": "622620405",
                    "speaker": "琼玖",
                    "text": "要是小茂愿意学钓鱼就好了…"
                }
            ]
        }
    ]
}