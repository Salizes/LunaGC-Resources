{
    "groupId": "2479",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "小旷": 13
    },
    "talks": [
        {
            "talkId": "6247901",
            "initDialog": "624790101",
            "dialogues": [
                {
                    "id": "624790101",
                    "speaker": "小旷",
                    "text": "沉玉谷居然还有这种事，真有意思！和璃月港那边不一样！"
                }
            ]
        },
        {
            "talkId": "6247902",
            "initDialog": "624790201",
            "dialogues": [
                {
                    "id": "624790201",
                    "speaker": "Player",
                    "text": "你遇见什么好玩的事了？"
                },
                {
                    "id": "624790202",
                    "speaker": "小旷",
                    "text": "可多可多了！"
                },
                {
                    "id": "624790203",
                    "speaker": "小旷",
                    "text": "比如南边的村子里，有好大好大的山羊，比画册上的羊要大十倍！"
                },
                {
                    "id": "624790204",
                    "speaker": "小旷",
                    "text": "坐着竹筏漂流过来的时候，我还看见了山一样大的玉…玉环？玉佩？玉什么来着…"
                },
                {
                    "id": "624790205",
                    "speaker": "小旷",
                    "text": "算了不管了，以后的我会懂的。"
                },
                {
                    "id": "624790206",
                    "speaker": "小旷",
                    "text": "瀑布下有个钓鱼的姐姐还说，沉玉谷有一种鲤鱼，遇见鲤鱼就有好运，我要找找鲤鱼！"
                },
                {
                    "id": "624790207",
                    "speaker": "小旷",
                    "text": "最有意思的还是迭跃哥哥和其他大哥一起玩的舞兽戏！大花脸猫上上下下，特别灵活！"
                },
                {
                    "id": "624790208",
                    "speaker": "小旷",
                    "text": "反正…这个地方很新鲜！有很多我没见过的东西，没听过的好事！"
                }
            ]
        },
        {
            "talkId": "6247903",
            "initDialog": "624790301",
            "dialogues": [
                {
                    "id": "624790301",
                    "speaker": "Player",
                    "text": "出去玩要注意安全哦！"
                },
                {
                    "id": "624790302",
                    "speaker": "小旷",
                    "text": "没关系的！沉玉谷那么大，能玩的地方可多了。"
                },
                {
                    "id": "624790303",
                    "speaker": "小旷",
                    "text": "以前住璃月港里，爸爸妈妈不让我出城，我只能在正门和码头玩…"
                },
                {
                    "id": "624790304",
                    "speaker": "小旷",
                    "text": "两个地方的人都太多了，随便跑跑就会撞到人，有的时候，码头还有很多人搬东西，有可能被砸到。"
                },
                {
                    "id": "624790305",
                    "speaker": "小旷",
                    "text": "还是「咦龙不」这个地方好，虽然不是很大，但人不多不少，随我怎么玩都没事！"
                }
            ]
        },
        {
            "talkId": "6247904",
            "initDialog": "624790401",
            "dialogues": [
                {
                    "id": "624790401",
                    "speaker": "Player",
                    "text": "再见，你去玩吧！"
                },
                {
                    "id": "624790402",
                    "speaker": "小旷",
                    "text": "嘿嘿，晚点就去找迭跃哥哥，听他讲嘉明哥哥的厉害故事！"
                }
            ]
        }
    ]
}