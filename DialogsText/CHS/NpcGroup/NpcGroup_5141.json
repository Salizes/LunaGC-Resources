{
    "groupId": "5141",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "达尼奥": 15
    },
    "talks": [
        {
            "talkId": "6514101",
            "initDialog": "651410101",
            "dialogues": [
                {
                    "id": "651410101",
                    "speaker": "达尼奥",
                    "text": "在学会钓鱼之前，真没想到能从水里钓出这么多稀奇古怪的玩意呢。"
                }
            ]
        },
        {
            "talkId": "6514102",
            "initDialog": "651410201",
            "dialogues": [
                {
                    "id": "651410201",
                    "speaker": "Player",
                    "text": "关于钓鱼…"
                },
                {
                    "id": "651410202",
                    "speaker": "达尼奥",
                    "text": "是朋友介绍给我的业余爱好。一开始我觉得，钓鱼嘛，考验耐心的活动，应该挺枯燥的。"
                },
                {
                    "id": "651410203",
                    "speaker": "达尼奥",
                    "text": "但朋友神秘兮兮地摆着手说，不不，钓鱼这个行为的本身可不是钓鱼这项爱好的全部。"
                },
                {
                    "id": "651410204",
                    "speaker": "达尼奥",
                    "text": "就像你去读一本书，除了书的内容本身以外，还有机会获得其他的体验。"
                },
                {
                    "id": "651410205",
                    "speaker": "达尼奥",
                    "text": "比如思考和分析故事背景，听取其他读者的评论，观看其衍生出的其他类型的作品，等等。"
                },
                {
                    "id": "651410206",
                    "speaker": "达尼奥",
                    "text": "事实证明，他说的确实有道理。光是期待自己下次提竿能钓上什么东西来，对我来说就已经很有趣味了。"
                }
            ]
        },
        {
            "talkId": "6514103",
            "initDialog": "651410301",
            "dialogues": [
                {
                    "id": "651410301",
                    "speaker": "Player",
                    "text": "关于古怪的玩意…"
                },
                {
                    "id": "651410302",
                    "speaker": "达尼奥",
                    "text": "不是有句流传在钓鱼爱好者中的说法嘛：「钓鱼佬除了鱼什么都钓得上来。」"
                },
                {
                    "id": "651410303",
                    "speaker": "达尼奥",
                    "text": "我本以为这只是说笑，谁知须弥那真的有个人，无论怎么调换水域、钓饵、器具，钓上来的都不是鱼呢。"
                },
                {
                    "id": "651410304",
                    "speaker": "达尼奥",
                    "text": "真羡慕啊！我还以为在枫丹的水里能钓出发条鱼来就已经很厉害了！"
                },
                {
                    "id": "651410305",
                    "speaker": "达尼奥",
                    "text": "如果说钓上来的东西能构成钓鱼爱好者的世界，那他的世界可真是多姿多彩。"
                },
                {
                    "id": "651410306",
                    "speaker": "达尼奥",
                    "text": "哎，不多说了，我也得加油了！"
                }
            ]
        },
        {
            "talkId": "6514104",
            "initDialog": "651410401",
            "dialogues": [
                {
                    "id": "651410401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651410402",
                    "speaker": "达尼奥",
                    "text": "再见，真期待今天的收获啊。"
                }
            ]
        },
        {
            "talkId": "7491101",
            "initDialog": "749110101",
            "dialogues": [
                {
                    "id": "749110101",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "749110102",
                    "speaker": "达尼奥",
                    "text": "借您吉言咯！我现在还是新手，只能钓到一些花花草草。"
                },
                {
                    "id": "749110103",
                    "speaker": "达尼奥",
                    "text": "呃…不过也有人指正我说，藻类其实不算植物…"
                },
                {
                    "id": "749110104",
                    "speaker": "达尼奥",
                    "text": "这方面我不太懂啦，总之这些对我来说没什么用处，您不嫌弃的话就请拿去吧。"
                }
            ]
        }
    ]
}