{
    "groupId": "4363",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "马苏迪": 8
    },
    "talks": [
        {
            "talkId": "5900094",
            "initDialog": "590009401",
            "dialogues": [
                {
                    "id": "590009401",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900095",
            "initDialog": "590009501",
            "dialogues": [
                {
                    "id": "590009501",
                    "speaker": "马苏迪",
                    "text": "抱歉，最近忙着为研究经费的问题发愁，没怎么注意身边的事情…"
                }
            ]
        },
        {
            "talkId": "6436301",
            "initDialog": "643630101",
            "dialogues": [
                {
                    "id": "643630101",
                    "speaker": "马苏迪",
                    "text": "要为下次的考察联系新的佣兵了…又是一笔开销。"
                }
            ]
        },
        {
            "talkId": "6436302",
            "initDialog": "643630201",
            "dialogues": [
                {
                    "id": "643630201",
                    "speaker": "Player",
                    "text": "囊中羞涩？"
                },
                {
                    "id": "643630202",
                    "speaker": "马苏迪",
                    "text": "有点吧。与其说是我的钱不够，不如说是上面批下来的经费总是在拖延。"
                },
                {
                    "id": "643630203",
                    "speaker": "马苏迪",
                    "text": "我因为要常常进入沙漠考察遗迹机关，为了节省来回的经费，已经居住在喀万驿了。"
                },
                {
                    "id": "643630204",
                    "speaker": "马苏迪",
                    "text": "结果就算这样，也还是需要自掏腰包垫付。"
                },
                {
                    "id": "643630205",
                    "speaker": "马苏迪",
                    "text": "…难道说，这是学院在告诫我们不要深入沙漠吗？"
                },
                {
                    "id": "643630206",
                    "speaker": "马苏迪",
                    "text": "唉，也许是我想多了，只是学院太穷罢了。早知如此，还不如转去做防沙工程了。"
                }
            ]
        },
        {
            "talkId": "6436303",
            "initDialog": "643630301",
            "dialogues": [
                {
                    "id": "643630301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643630302",
                    "speaker": "马苏迪",
                    "text": "再见，希望新的经费能顺利批下来啊。"
                }
            ]
        }
    ]
}