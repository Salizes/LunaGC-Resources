{
    "groupId": "4128",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "贝鲁兹": 9
    },
    "talks": [
        {
            "talkId": "6412801",
            "initDialog": "641280101",
            "dialogues": [
                {
                    "id": "641280101",
                    "speaker": "贝鲁兹",
                    "text": "海怪和海乱鬼…都是棘手的问题啊。"
                }
            ]
        },
        {
            "talkId": "6412802",
            "initDialog": "641280201",
            "dialogues": [
                {
                    "id": "641280201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641280202",
                    "speaker": "贝鲁兹",
                    "text": "我是附近商船的船主，主要做进出口生意。"
                },
                {
                    "id": "641280203",
                    "speaker": "贝鲁兹",
                    "text": "你要是有好的货源或者渠道，欢迎介绍给我，分成都好说。"
                },
                {
                    "id": "641280204",
                    "speaker": "贝鲁兹",
                    "text": "要是能有璃月宝石、丝绸，甚至枫丹船艇之类的优质商品，那就更好了。"
                }
            ]
        },
        {
            "talkId": "6412803",
            "initDialog": "641280301",
            "dialogues": [
                {
                    "id": "641280301",
                    "speaker": "Player",
                    "text": "棘手的问题？"
                },
                {
                    "id": "641280302",
                    "speaker": "贝鲁兹",
                    "text": "你应该也知道，我们这些做跨国贸易的商人，最怕的就是海上出问题。"
                },
                {
                    "id": "641280303",
                    "speaker": "贝鲁兹",
                    "text": "虽然我已经算是很有应对经验的老船主了，但还是会因为海怪袭击而头疼啊。"
                },
                {
                    "id": "641280304",
                    "speaker": "贝鲁兹",
                    "text": "更不要说还有那些穷凶极恶的海乱鬼，他们要是想谋财害命，可不是闹着玩的。"
                },
                {
                    "id": "641280305",
                    "speaker": "贝鲁兹",
                    "text": "这种事能躲就躲，我要想想接下来的航船班次了…"
                }
            ]
        },
        {
            "talkId": "6412804",
            "initDialog": "641280401",
            "dialogues": [
                {
                    "id": "641280401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641280402",
                    "speaker": "贝鲁兹",
                    "text": "再见，要注意出海安全啊。"
                }
            ]
        }
    ]
}