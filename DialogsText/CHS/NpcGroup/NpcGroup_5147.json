            "dialogues": [
                {
                    "id": "651470101",
                    "speaker": "扎德拉",
                    "text": "逛完这个地方只需要一个小时，那么空出的时间可以…"
                }
            ]
        },
        {
            "talkId": "6514702",
            "initDialog": "651470201",
            "dialogues": [
                {
                    "id": "651470201",
                    "speaker": "Player",
                    "text": "你是在…"
                },
                {
                    "id": "651470202",
                    "speaker": "扎德拉",
                    "text": "哦，你好，我正在规划接下来的旅游行程。"
                },
                {
                    "id": "651470203",
                    "speaker": "扎德拉",
                    "text": "在到枫丹之前，我就大致定了一份计划，刚刚和好心的谢里埃先生聊了下，发现需要做一些调整。"
                },
                {
                    "id": "651470204",
                    "speaker": "扎德拉",
                    "text": "你看，制定游玩行程也挺像搞研究的呢，既要有突破和创新，又要严谨规划，同时也要根据实际情况灵活调整。"
                },
                {
                    "id": "651470205",
                    "speaker": "扎德拉",
                    "text": "这么想着，就连做表格都变得好玩起来了…"
                }
            ]
        },
        {
            "talkId": "6514703",
            "initDialog": "651470301",
            "dialogues": [
                {
                    "id": "651470301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "651470302",
                    "speaker": "扎德拉",
                    "text": "没关系，我只是在研究旅游计划，不必在意。"
                }
            ]
        }
    ]
}