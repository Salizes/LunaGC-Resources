{
    "groupId": "3104",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "平冢": 16
    },
    "talks": [
        {
            "talkId": "4006323",
            "initDialog": "400632301",
            "dialogues": [
                {
                    "id": "400632301",
                    "speaker": "平冢",
                    "text": "你好，你也是来社奉行工作的人吗？"
                },
                {
                    "id": "400632302",
                    "speaker": "平冢",
                    "text": "如果是关于光华容彩祭的事务，烦请咨询离岛活动现场的工作人员吧。"
                }
            ]
        },
        {
            "talkId": "6310401",
            "initDialog": "631040101",
            "dialogues": [
                {
                    "id": "631040101",
                    "speaker": "平冢",
                    "text": "你好，你也是来社奉行工作的人吗？"
                }
            ]
        },
        {
            "talkId": "6310402",
            "initDialog": "631040201",
            "dialogues": [
                {
                    "id": "631040201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "631040202",
                    "speaker": "平冢",
                    "text": "我是「八重堂」出版社的工作人员，今天来社奉行汇报预算事宜。"
                },
                {
                    "id": "631040203",
                    "speaker": "平冢",
                    "text": "不知是不是因为其他的行业不景气，近来给「八重堂」投稿的新人作者越来越多了…"
                },
                {
                    "id": "631040204",
                    "speaker": "平冢",
                    "text": "哎呀，虽然出版行业繁荣是件好事，但我的工作可是变重了。"
                },
                {
                    "id": "631040205",
                    "speaker": "平冢",
                    "text": "再这样下去，以后可就没有时间来神里家和人闲聊了…"
                }
            ]
        },
        {
            "talkId": "6310403",
            "initDialog": "631040301",
            "dialogues": [
                {
                    "id": "631040301",
                    "speaker": "Player",
                    "text": "你的工作是？"
                },
                {
                    "id": "631040302",
                    "speaker": "平冢",
                    "text": "工作内容的话…大概就是关注下每个月新出的书籍内容与销量吧。"
                },
                {
                    "id": "631040303",
                    "speaker": "平冢",
                    "text": "可千万不要以为这是什么轻松的工作哦。我需要整理各项数据，为「八重堂」今后的出版规划提供一些经营建议…"
                },
                {
                    "id": "631040304",
                    "speaker": "平冢",
                    "text": "不过老板似乎不是很在乎这些，无论收益如何，老板都只会按照自己的想法去做…"
                },
                {
                    "id": "631040305",
                    "speaker": "平冢",
                    "text": "难道说，这就是身为宫司大人的底气吗…"
                }
            ]
        },
        {
            "talkId": "6310404",
            "initDialog": "631040401",
            "dialogues": [
                {
                    "id": "631040401",
                    "speaker": "Player",
                    "text": "闲聊？"
                },
                {
                    "id": "631040402",
                    "speaker": "平冢",
                    "text": "唔，我来神里家等人或者工作的时候，会抽空和大家聊聊天哦。毕竟能积累些人脉也是好的嘛。"
                },
                {
                    "id": "631040403",
                    "speaker": "平冢",
                    "text": "所以偶尔也会听说一些神里家的逸闻。"
                },
                {
                    "id": "631040404",
                    "speaker": "平冢",
                    "text": "据说托马一见到奉行大人就会紧张，是因为奉行大人经常逮住他喂他吃奇怪的料理…"
                },
                {
                    "id": "631040405",
                    "speaker": "平冢",
                    "text": "真没想到，做事雷厉风行的奉行大人，还有这样的一面呢…"
                }
            ]
        },
        {
            "talkId": "6310405",
            "initDialog": "631040501",
            "dialogues": [
                {
                    "id": "631040501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631040502",
                    "speaker": "平冢",
                    "text": "嗯，我也该继续工作了…"
                }
            ]
        }
    ]
}