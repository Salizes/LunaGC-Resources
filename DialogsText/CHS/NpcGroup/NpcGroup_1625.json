{
    "groupId": "1625",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 10,
        "纪芳": 29
    },
    "talks": [
        {
            "talkId": "6162506",
            "initDialog": "616250601",
            "dialogues": [
                {
                    "id": "616250601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6162507",
            "initDialog": "616250701",
            "dialogues": [
                {
                    "id": "616250701",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6162508",
            "initDialog": "616250801",
            "dialogues": [
                {
                    "id": "616250801",
                    "speaker": "纪芳",
                    "text": "怎么还有这样的情况…"
                }
            ]
        },
        {
            "talkId": "6162509",
            "initDialog": "616250901",
            "dialogues": [
                {
                    "id": "616250901",
                    "speaker": "纪芳",
                    "text": "哼，没人来买书的时候我都在琢磨这个呢，你别想轻松过关。"
                }
            ]
        },
        {
            "talkId": "6162510",
            "initDialog": "616251001",
            "dialogues": [
                {
                    "id": "616251001",
                    "speaker": "纪芳",
                    "text": "…所以你到底买不买书啊。"
                }
            ]
        },
        {
            "talkId": "6162511",
            "initDialog": "616251101",
            "dialogues": [
                {
                    "id": "616251101",
                    "speaker": "纪芳",
                    "text": "就你这水平，还是多打打吧！"
                }
            ]
        },
        {
            "talkId": "7180501",
            "initDialog": "718050101",
            "dialogues": [
                {
                    "id": "718050101",
                    "speaker": "纪芳",
                    "text": "现在大家开始对历史感兴趣了么…"
                },
                {
                    "id": "718050102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718050103",
                    "speaker": "纪芳",
                    "text": "最近，很多人突然开始关心起了璃月的历史，到我这里来买书的客人也越来越多…"
                },
                {
                    "id": "718050104",
                    "speaker": "纪芳",
                    "text": "之前我进过几本《护法仙众夜叉录》，大半年才卖完，后来我就不爱进这种专讲生僻历史的书了。"
                },
                {
                    "id": "718050105",
                    "speaker": "纪芳",
                    "text": "最近璃月港的那件大事刚刚过去不久，城里的人却一个个忙不迭地来我这儿买历史书看了…"
                },
                {
                    "id": "718050106",
                    "speaker": "纪芳",
                    "text": "这几天来的顾客，还都指名要买讲帝君故事的书。"
                },
                {
                    "id": "718050107",
                    "speaker": "纪芳",
                    "text": "唉，他们到底是真喜欢看书，还是就想和人聊天的时候能多点谈资呢…"
                },
                {
                    "id": "718050108",
                    "speaker": "纪芳",
                    "text": "因为来买书的人太多，一些老客人的特别订单我几乎没时间准备。"
                },
                {
                    "id": "718050109",
                    "speaker": "纪芳",
                    "text": "我这刚想了点办法备齐了两位老客人要的书，不过现在书店太忙我人走不开。"
                },
                {
                    "id": "718050110",
                    "speaker": "纪芳",
                    "text": "你能帮我把这本《玑衡经》带给天叔，把这本《帝君尘游记·四》带给德安公吗？"
                }
            ]
        },
        {
            "talkId": "7180502",
            "initDialog": "718050201",
            "dialogues": [
                {
                    "id": "718050201",
                    "speaker": "Player",
                    "text": "可以。"
                },
                {
                    "id": "718050202",
                    "speaker": "纪芳",
                    "text": "那就拜托你了，这两位客人的订单已经在店里下了很久，但我现在才备齐书，他们一定等得都不耐烦了…"
                },
                {
                    "id": "718050203",
                    "speaker": "纪芳",
                    "text": "唉，突然来了那么多客人，我都不知道怎么应付了…"
                }
            ]
        },
        {
            "talkId": "7180503",
            "initDialog": "718050301",
            "dialogues": [
                {
                    "id": "718050301",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "718050302",
                    "speaker": "纪芳",
                    "text": "好吧，那我再去找其他人帮忙。"
                }
            ]
        },
        {
            "talkId": "7191101",
            "initDialog": "719110101",
            "dialogues": [
                {
                    "id": "719110101",
                    "speaker": "Player",
                    "text": "《绝云记闻》？"
                },
                {
                    "id": "719110102",
                    "speaker": "纪芳",
                    "text": "看样子，你胆子还挺大的嘛，那你可以看看这本《绝云记闻·石兽》。"
                },
                {
                    "id": "719110103",
                    "speaker": "纪芳",
                    "text": "你要是想看就拿走吧，哪天看腻了再还给我就行了。"
                },
                {
                    "id": "719110104",
                    "speaker": "纪芳",
                    "text": "…反正我已经见多了有借无还的顾客了。"
                }
            ]
        },
        {
            "talkId": "6162501",
            "initDialog": "616250101",
            "dialogues": [
                {
                    "id": "616250101",
                    "speaker": "纪芳",
                    "text": "看上哪本了么，这边结账。"
                }
            ]
        },
        {
            "talkId": "6162502",
            "initDialog": "616250201",
            "dialogues": [
                {
                    "id": "616250201",
                    "speaker": "Player",
                    "text": "关于「万文集舍」…"
                },
                {
                    "id": "616250202",
                    "speaker": "纪芳",
                    "text": "你是来看书的还是看店的啊？"
                },
                {
                    "id": "616250203",
                    "speaker": "纪芳",
                    "text": "好吧，其实是我老公他有收集旧书的癖好，可自己又不赚钱…"
                },
                {
                    "id": "616250204",
                    "speaker": "纪芳",
                    "text": "所以我就开了这么个店，没办法，要生活的嘛。"
                }
            ]
        },
        {
            "talkId": "6162503",
            "initDialog": "616250301",
            "dialogues": [
                {
                    "id": "616250301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616250302",
                    "speaker": "纪芳",
                    "text": "不买就算了，我早习惯你们这些蹭书看的人了。"
                }
            ]
        },
        {
            "talkId": "6162504",
            "initDialog": "616250401",
            "dialogues": [
                {
                    "id": "616250401",
                    "speaker": "Player",
                    "text": "我想买些书。"
                },
                {
                    "id": "616250402",
                    "speaker": "纪芳",
                    "text": "自己挑吧，看上哪本在这边结账。"
                }
            ]
        },
        {
            "talkId": "6162505",
            "initDialog": "616250501",
            "dialogues": [
                {
                    "id": "616250501",
                    "speaker": "Player",
                    "text": "有推荐的书吗？"
                },
                {
                    "id": "616250502",
                    "speaker": "纪芳",
                    "text": "推荐啊，读诗的话《天衡绝倒集》卖的还不错，比较符合大众口味。"
                },
                {
                    "id": "616250503",
                    "speaker": "纪芳",
                    "text": "外来人的话看看《绝云记闻》吧？如果你胆子不是太小的话。"
                }
            ]
        },
        {
            "talkId": "7162501",
            "initDialog": "716250101",
            "dialogues": [
                {
                    "id": "716250101",
                    "speaker": "纪芳",
                    "text": "我只是来随便逛逛的，有空记得光顾我的「万文集舍」。"
                },
                {
                    "id": "716250102",
                    "speaker": "纪芳",
                    "text": "店里有不少卖不出去的老书，我在想要不要作为纸材捐去建造「明霄灯」算了…"
                }
            ]
        }
    ]
}