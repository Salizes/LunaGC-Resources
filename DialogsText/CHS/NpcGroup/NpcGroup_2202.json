{
    "groupId": "2202",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 8,
        "淮安": 23
    },
    "talks": [
        {
            "talkId": "4111535",
            "initDialog": "411153501",
            "dialogues": [
                {
                    "id": "411153501",
                    "speaker": "淮安",
                    "text": "我是掌柜淮安，您好您好。客官若是没有要紧事，还是在本店住上些时日为好…"
                },
                {
                    "id": "411153502",
                    "speaker": "淮安",
                    "text": "最近落下的那些陨石恐怕是不祥之兆，能避还是避一避吧。"
                }
            ]
        },
        {
            "talkId": "6220205",
            "initDialog": "622020501",
            "dialogues": [
                {
                    "id": "622020501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6220206",
            "initDialog": "622020601",
            "dialogues": [
                {
                    "id": "622020601",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6220207",
            "initDialog": "622020701",
            "dialogues": [
                {
                    "id": "622020701",
                    "speaker": "淮安",
                    "text": "真是绝妙的办法啊…您的牌技真是精湛。"
                }
            ]
        },
        {
            "talkId": "6220208",
            "initDialog": "622020801",
            "dialogues": [
                {
                    "id": "622020801",
                    "speaker": "淮安",
                    "text": "承让了，下次要是有空，再来试试吧。"
                }
            ]
        },
        {
            "talkId": "6220209",
            "initDialog": "622020901",
            "dialogues": [
                {
                    "id": "622020901",
                    "speaker": "淮安",
                    "text": "这牌局之中，居然有好几手妙手，这次真是受教了。"
                }
            ]
        },
        {
            "talkId": "6220210",
            "initDialog": "622021001",
            "dialogues": [
                {
                    "id": "622021001",
                    "speaker": "淮安",
                    "text": "这赢得可真不容易，看来您也是个中高手啊…"
                }
            ]
        },
        {
            "talkId": "6220211",
            "initDialog": "622021101",
            "dialogues": [
                {
                    "id": "622021101",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6220212",
            "initDialog": "622021201",
            "dialogues": [
                {
                    "id": "622021201",
                    "speaker": "淮安",
                    "text": "呼…我只是险胜，下次我就未必有这么走运了！"
                }
            ]
        },
        {
            "talkId": "6220213",
            "initDialog": "622021301",
            "dialogues": [
                {
                    "id": "622021301",
                    "speaker": "淮安",
                    "text": "真不错！你的牌技和你的身手一样了得！"
                }
            ]
        },
        {
            "talkId": "6220201",
            "initDialog": "622020101",
            "dialogues": [
                {
                    "id": "622020101",
                    "speaker": "淮安",
                    "text": "您好您好。我是望舒客栈掌柜淮安。吃饭还是住店啊？"
                }
            ]
        },
        {
            "talkId": "6220202",
            "initDialog": "622020201",
            "dialogues": [
                {
                    "id": "622020201",
                    "speaker": "Player",
                    "text": "最近生意如何？"
                },
                {
                    "id": "622020202",
                    "speaker": "淮安",
                    "text": "托您关照，生意一直都还行。日子过得去。"
                },
                {
                    "id": "622020203",
                    "speaker": "淮安",
                    "text": "哈哈哈。又到了该活络起来的时候了。",
                    "choices": [
                        {
                            "id": "622020306",
                            "text": "关于传闻…",
                            "response": [
                                {
                                    "id": "622020307",
                                    "speaker": "淮安",
                                    "text": "传闻，什么传闻？"
                                },
                                {
                                    "id": "622020308",
                                    "speaker": "淮安",
                                    "text": "如果是关于我们望舒客栈的诽谤谣言，那全部都不可信。"
                                },
                                {
                                    "id": "622020309",
                                    "speaker": "淮安",
                                    "text": "如果是说有什么有趣的事情。"
                                },
                                {
                                    "id": "622020310",
                                    "speaker": "淮安",
                                    "text": "最近璃月港的愚人众变多了。山雨欲来啊。"
                                },
                                {
                                    "id": "622020311",
                                    "speaker": "淮安",
                                    "text": "您倒是有什么有意思的事情能和我分享分享的？"
                                }
                            ]
                        },
                        {
                            "id": "622020312",
                            "text": "关于这狗…",
                            "response": [
                                {
                                    "id": "622020313",
                                    "speaker": "淮安",
                                    "text": "狗，狗当然叫旺财了。"
                                },
                                {
                                    "id": "622020314",
                                    "speaker": "淮安",
                                    "text": "它挺懂事的，又爱干净，不会给客人添麻烦的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220203",
            "initDialog": "622020301",
            "dialogues": [
                {
                    "id": "622020301",
                    "speaker": "Player",
                    "text": "那边不是璃月人的那位是？"
                },
                {
                    "id": "622020302",
                    "speaker": "淮安",
                    "text": "啊，那位啊。那是我的内人。是蒙德嫁过来的。"
                },
                {
                    "id": "622020303",
                    "speaker": "淮安",
                    "text": "古代童谣道，「一半嫁作酒乡妇，一半到海不复归。」"
                },
                {
                    "id": "622020304",
                    "speaker": "淮安",
                    "text": "我是不是帮璃月扳回了一城？哈哈哈。"
                },
                {
                    "id": "622020305",
                    "speaker": "淮安",
                    "text": "戈黛特她很厉害的。分析一些小细节就能猜出人的来历。"
                }
            ]
        },
        {
            "talkId": "6220204",
            "initDialog": "622020401",
            "dialogues": [
                {
                    "id": "622020401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "622020402",
                    "speaker": "淮安",
                    "text": "没事没事，多来打扰啊。望舒客栈永远欢迎您。"
                }
            ]
        }
    ]
}