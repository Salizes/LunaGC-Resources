{
    "groupId": "4417",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 3,
        "库尔苏姆": 7,
        "拉米兹": 14
    },
    "talks": [
        {
            "talkId": "6441701",
            "initDialog": "644170101",
            "dialogues": [
                {
                    "id": "644170101",
                    "speaker": "拉米兹",
                    "text": "奶奶，可以问你一个问题吗？我和纳瓦兹都搞不明白。"
                },
                {
                    "id": "644170102",
                    "speaker": "库尔苏姆",
                    "text": "当然可以啦。"
                },
                {
                    "id": "644170103",
                    "speaker": "拉米兹",
                    "text": "您说…嗯…赤王真的会复活吗…"
                },
                {
                    "id": "644170104",
                    "speaker": "库尔苏姆",
                    "text": "……！"
                },
                {
                    "id": "644170105",
                    "speaker": "拉米兹",
                    "text": "奶奶？"
                },
                {
                    "id": "644170106",
                    "speaker": "库尔苏姆",
                    "text": "这帮狂热的信徒，竟然连小孩子都不放过吗！"
                },
                {
                    "id": "644170107",
                    "speaker": "库尔苏姆",
                    "text": "孩子，你听好，神明虽然强大，但也是会消失的。"
                },
                {
                    "id": "644170108",
                    "speaker": "库尔苏姆",
                    "text": "而对消失的东西抱有执念，是不切实际的疯狂行为。"
                },
                {
                    "id": "644170109",
                    "speaker": "库尔苏姆",
                    "text": "…唉，要是我们沙漠的孩子们也能多学些知识，应该也不至于被这种谎言欺骗了吧。"
                },
                {
                    "id": "644170110",
                    "speaker": "库尔苏姆",
                    "text": "孩子，虽然很难…但你一定要尽力学习，争取像塞塔蕾姐姐一样有出息哦。"
                },
                {
                    "id": "644170111",
                    "speaker": "拉米兹",
                    "text": "我…我明白了。"
                }
            ]
        },
        {
            "talkId": "6441702",
            "initDialog": "644170201",
            "dialogues": [
                {
                    "id": "644170201",
                    "speaker": "拉米兹",
                    "text": "你知道吗？雨林里竟然有长着蘑菇的小猪！还有头上长叶子的小精灵！"
                }
            ]
        },
        {
            "talkId": "6441703",
            "initDialog": "644170301",
            "dialogues": [
                {
                    "id": "644170301",
                    "speaker": "Player",
                    "text": "略有耳闻。"
                },
                {
                    "id": "644170302",
                    "speaker": "拉米兹",
                    "text": "哇，你一定也看过「兰那罗」系列的童话绘本对吧？"
                },
                {
                    "id": "644170303",
                    "speaker": "拉米兹",
                    "text": "塞塔蕾姐姐之前给我带了好多，让我边读边学习识字。"
                },
                {
                    "id": "644170304",
                    "speaker": "拉米兹",
                    "text": "本来还以为是很难懂的书籍，结果内容非常有趣！"
                },
                {
                    "id": "644170305",
                    "speaker": "拉米兹",
                    "text": "就是有的时候因为太想知道结局，中间看得太快，所以好多不认识的字都没有仔细记下来…"
                },
                {
                    "id": "644170306",
                    "speaker": "拉米兹",
                    "text": "等下次见到塞塔蕾姐姐，再找她问问看吧！"
                }
            ]
        },
        {
            "talkId": "6441704",
            "initDialog": "644170401",
            "dialogues": [
                {
                    "id": "644170401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644170402",
                    "speaker": "拉米兹",
                    "text": "再见！"
                }
            ]
        },
        {
            "talkId": "6441705",
            "initDialog": "644170501",
            "dialogues": [
                {
                    "id": "644170501",
                    "speaker": "Player",
                    "text": "关于塞塔蕾姐姐…"
                },
                {
                    "id": "644170502",
                    "speaker": "拉米兹",
                    "text": "塞塔蕾姐姐最近经常在阿如村，不过她总是看起来很忙的样子，不能一直陪我读书…"
                },
                {
                    "id": "644170503",
                    "speaker": "拉米兹",
                    "text": "我明白的，塞塔蕾姐姐一定是有重要的事情要办，听奶奶说是能帮助村子变好的好事情呢！"
                },
                {
                    "id": "644170504",
                    "speaker": "拉米兹",
                    "text": "如果我能快点学到知识，应该就能帮到姐姐了吧！"
                }
            ]
        }
    ]
}