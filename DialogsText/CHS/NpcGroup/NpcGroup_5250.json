{
    "groupId": "5250",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 3,
        "阿德纳": 5
    },
    "talks": [
        {
            "talkId": "6525001",
            "initDialog": "652500101",
            "dialogues": [
                {
                    "id": "652500101",
                    "speaker": "阿德纳",
                    "text": "身体健康才能更好地工作，对吧？"
                }
            ]
        },
        {
            "talkId": "6525002",
            "initDialog": "652500201",
            "dialogues": [
                {
                    "id": "652500201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "652500202",
                    "speaker": "阿德纳",
                    "text": "我是医生。小病小伤找我就对了，大病大伤…我尽量想办法，但不能做承诺。"
                },
                {
                    "id": "652500203",
                    "speaker": "阿德纳",
                    "text": "如果工作太累了想休息一下，可以去医务室坐一坐。在那儿至少听不到扩音机的声音，对精神健康是有益的。"
                }
            ]
        },
        {
            "talkId": "6525003",
            "initDialog": "652500301",
            "dialogues": [
                {
                    "id": "652500301",
                    "speaker": "Player",
                    "text": "关于保持健康的秘诀…"
                },
                {
                    "id": "652500302",
                    "speaker": "阿德纳",
                    "text": "早睡早起，健康饮食，适度运动，及时调整心态。可惜梅洛彼得堡少了一些日光…"
                }
            ]
        },
        {
            "talkId": "6525004",
            "initDialog": "652500401",
            "dialogues": [
                {
                    "id": "652500401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "652500402",
                    "speaker": "阿德纳",
                    "text": "保重身体。"
                }
            ]
        }
    ]
}