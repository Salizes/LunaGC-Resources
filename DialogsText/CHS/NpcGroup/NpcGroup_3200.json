{
    "groupId": "3200",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "鲸井椛": 14
    },
    "talks": [
        {
            "talkId": "6320001",
            "initDialog": "632000101",
            "dialogues": [
                {
                    "id": "632000101",
                    "speaker": "鲸井椛",
                    "text": "你们好！是想来加入「鲸井会」的吗？"
                }
            ]
        },
        {
            "talkId": "6320002",
            "initDialog": "632000201",
            "dialogues": [
                {
                    "id": "632000201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "632000202",
                    "speaker": "鲸井椛",
                    "text": "啊，我还以为你们是来入会的呢，原来你们不认识我。"
                },
                {
                    "id": "632000203",
                    "speaker": "鲸井椛",
                    "text": "自我介绍下，我是「鲸井流钓鱼法」的继承人，「鲸井会」的创办者，大海之子鲸井椛——"
                },
                {
                    "id": "632000204",
                    "speaker": "鲸井椛",
                    "text": "欸，不要这么看着我啦。"
                },
                {
                    "id": "632000205",
                    "speaker": "鲸井椛",
                    "text": "身为渔师的我，生于海边，长于海边，未来有一天也会回归大海。"
                },
                {
                    "id": "632000206",
                    "speaker": "鲸井椛",
                    "text": "所以自称一句大海之子，没什么问题吧？"
                }
            ]
        },
        {
            "talkId": "6320003",
            "initDialog": "632000301",
            "dialogues": [
                {
                    "id": "632000301",
                    "speaker": "Player",
                    "text": "「鲸井会」是什么？"
                },
                {
                    "id": "632000302",
                    "speaker": "鲸井椛",
                    "text": "是大海之子们的协会——"
                },
                {
                    "id": "632000303",
                    "speaker": "鲸井椛",
                    "text": "咳咳…不好理解？那我换一种说法。"
                },
                {
                    "id": "632000304",
                    "speaker": "鲸井椛",
                    "text": "「鲸井会」是本人创办的，以「鲸井流钓鱼法」为核心技艺的钓鱼协会。"
                },
                {
                    "id": "632000305",
                    "speaker": "鲸井椛",
                    "text": "虽然现在规模不大，但所有成员都是百里挑一的优秀渔师。"
                },
                {
                    "id": "632000306",
                    "speaker": "鲸井椛",
                    "text": "而且我相信，有我祖传的「鲸井流钓鱼法」做支撑，总有一天，「鲸井会」将开枝散叶，门徒遍布大陆各地。"
                },
                {
                    "id": "632000307",
                    "speaker": "鲸井椛",
                    "text": "怎么样？现在加入你就是元老成员！"
                }
            ]
        },
        {
            "talkId": "6320004",
            "initDialog": "632000401",
            "dialogues": [
                {
                    "id": "632000401",
                    "speaker": "Player",
                    "text": "我需要一些钓鱼用品。"
                },
                {
                    "id": "632000402",
                    "speaker": "鲸井椛",
                    "text": "嗯！工欲善其事，必先利其器，你很有大海之子的潜质。来，尽情挑选吧。"
                }
            ]
        },
        {
            "talkId": "6320005",
            "initDialog": "632000501",
            "dialogues": [
                {
                    "id": "632000501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "632000502",
                    "speaker": "鲸井椛",
                    "text": "再见，如果想加入「鲸井会」，欢迎回来找我。"
                }
            ]
        }
    ]
}