    "talks": [
        {
            "talkId": "6437001",
            "initDialog": "643700101",
            "dialogues": [
                {
                    "id": "643700101",
                    "speaker": "曼达娜",
                    "text": "按照手册中的指导操作，花果然开得很好。"
                }
            ]
        },
        {
            "talkId": "6437002",
            "initDialog": "643700201",
            "dialogues": [
                {
                    "id": "643700201",
                    "speaker": "Player",
                    "text": "手册？"
                },
                {
                    "id": "643700202",
                    "speaker": "曼达娜",
                    "text": "嗯，是老爷交给我的关于观赏植物的保育手册，听说得到了某位巡林官大人的亲自修订。"
                },
                {
                    "id": "643700203",
                    "speaker": "曼达娜",
                    "text": "只要按照手册中的指导，就能保证这里一年四季都有漂亮的花开。"
                }
            ]
        },
        {
            "talkId": "6437003",
            "initDialog": "643700301",
            "dialogues": [
                {
                    "id": "643700301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643700302",
                    "speaker": "曼达娜",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "7396101",
            "initDialog": "739610101",
            "dialogues": [
                {
                    "id": "739610101",
                    "speaker": "Player",
                    "text": "很好看。"
                },
                {
                    "id": "739610102",
                    "speaker": "曼达娜",
                    "text": "谢谢，我就当作是在夸奖我把花园照顾得好啦。"
                },
                {
                    "id": "739610103",
                    "speaker": "曼达娜",
                    "text": "将新鲜的花连着枝叶剪下，插入有水的花瓶，就是很棒的室内装饰。"
                },
                {
                    "id": "739610104",
                    "speaker": "曼达娜",
                    "text": "这些送给您，好看的花会为您带来好运。"
                }
            ]
        }
    ]
}