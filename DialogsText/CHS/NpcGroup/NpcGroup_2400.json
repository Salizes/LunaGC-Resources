{
    "groupId": "2400",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 6,
        "孙宇": 22
    },
    "talks": [
        {
            "talkId": "6240001",
            "initDialog": "624000101",
            "dialogues": [
                {
                    "id": "624000101",
                    "speaker": "孙宇",
                    "text": "怎么？有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6240002",
            "initDialog": "624000201",
            "dialogues": [
                {
                    "id": "624000201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624000202",
                    "speaker": "孙宇",
                    "text": "在下古华派弟子孙宇，特来此处…修炼功法。"
                },
                {
                    "id": "624000203",
                    "speaker": "孙宇",
                    "text": "你有什么事情吗？没事请不要打扰我。",
                    "choices": [
                        {
                            "id": "624000204",
                            "text": "古华派？",
                            "response": [
                                {
                                    "id": "624000205",
                                    "speaker": "孙宇",
                                    "text": "你没听说过大名鼎鼎的古华派？"
                                },
                                {
                                    "id": "624000206",
                                    "speaker": "孙宇",
                                    "text": "唉…也罢。"
                                },
                                {
                                    "id": "624000207",
                                    "speaker": "孙宇",
                                    "text": "当年「古华团」行走天下，难逢敌手。"
                                },
                                {
                                    "id": "624000208",
                                    "speaker": "孙宇",
                                    "text": "「枪剑双绝」的名声在江湖之上无人不知，无人不晓。"
                                },
                                {
                                    "id": "624000209",
                                    "speaker": "孙宇",
                                    "text": "可惜天下无不散之筵席…数百年来，物是人非…"
                                },
                                {
                                    "id": "624000210",
                                    "speaker": "孙宇",
                                    "text": "先是人去楼空，「古华团」凋零成了区区百人的「古华堂」，再后，如今的「古华派」已是门可罗雀。"
                                },
                                {
                                    "id": "624000211",
                                    "speaker": "孙宇",
                                    "text": "唉…"
                                },
                                {
                                    "id": "624000501",
                                    "speaker": "Player",
                                    "text": "古华派只剩下你们两个了吗？"
                                },
                                {
                                    "id": "624000502",
                                    "speaker": "孙宇",
                                    "text": "虽说我派人少了些，不过也不至于这么少…只是我派弟子分散在璃月各地罢了。"
                                },
                                {
                                    "id": "624000503",
                                    "speaker": "孙宇",
                                    "text": "旅行者，你可曾听过行秋这个名字？"
                                },
                                {
                                    "id": "624000504",
                                    "speaker": "孙宇",
                                    "text": "他是我的小师弟，却也是我派第一位领悟了「武理」概念的人。"
                                },
                                {
                                    "id": "624000505",
                                    "speaker": "孙宇",
                                    "text": "他曾写过一篇歌诀，彻底改变了我们古华派的武功传承…"
                                },
                                {
                                    "id": "624000506",
                                    "speaker": "孙宇",
                                    "text": "也不知道他现在怎么样了，应该还在四处云游、行侠仗义吧，哈哈哈…"
                                }
                            ]
                        },
                        {
                            "id": "624000212",
                            "text": "修炼功法？",
                            "response": [
                                {
                                    "id": "624000213",
                                    "speaker": "孙宇",
                                    "text": "…反正你一个外人，我也没什么好瞒的。"
                                },
                                {
                                    "id": "624000214",
                                    "speaker": "孙宇",
                                    "text": "我此来是为了求仙访道，求教古华派振兴之法。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6240003",
            "initDialog": "624000301",
            "dialogues": [
                {
                    "id": "624000301",
                    "speaker": "Player",
                    "text": "你们感情很好的样子。"
                },
                {
                    "id": "624000302",
                    "speaker": "孙宇",
                    "text": "我一直把她当做亲妹妹…"
                },
                {
                    "id": "624000303",
                    "speaker": "孙宇",
                    "text": "平时习武练功，形影不离。师妹的武艺与侠胆皆不在我之下。"
                },
                {
                    "id": "624000304",
                    "speaker": "孙宇",
                    "text": "所以此次特地带她一起寻仙，共同复兴古华派。"
                },
                {
                    "id": "624000305",
                    "speaker": "孙宇",
                    "text": "可她脾气古怪，性情聒噪…但对待我又完全是另一番态度…这也让我很是头疼。"
                }
            ]
        },
        {
            "talkId": "6240004",
            "initDialog": "624000401",
            "dialogues": [
                {
                    "id": "624000401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624000402",
                    "speaker": "孙宇",
                    "text": "保重。"
                }
            ]
        }
    ]
}