            "initDialog": "740605401",
            "dialogues": [
                {
                    "id": "740605401",
                    "speaker": "公告板",
                    "text": "「拳力斗技」娱乐赛结果速报：恭喜研究员与助手获得了本次娱乐赛的胜利！也恭喜教练！"
                },
                {
                    "id": "740605402",
                    "speaker": "留言",
                    "text": "「临时加赛的规则应该明文记入比赛细则。」"
                },
                {
                    "id": "740605403",
                    "speaker": "另一人的留言",
                    "text": "「这比赛真没劲，有没有更刺激的场次。」"
                },
                {
                    "id": "740605404",
                    "speaker": "又一人的留言",
                    "text": "「你可以自己上场亲自体验！报名参赛请联系罗西莫夫。」"
                }
            ]
        }
