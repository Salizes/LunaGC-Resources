{
    "groupId": "10232",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 7,
        "钟离": 21
    },
    "talks": [
        {
            "talkId": "101217",
            "initDialog": "10121701",
            "dialogues": [
                {
                    "id": "10121701",
                    "speaker": "钟离",
                    "text": "不好意思，这一次，我就不陪你们去了。"
                },
                {
                    "id": "10121702",
                    "speaker": "钟离",
                    "text": "拿到「涤尘铃」的话，我们在<color=#00E1FFFF>玉京台</color>再见吧。"
                }
            ]
        },
        {
            "talkId": "102553",
            "initDialog": "10252001",
            "dialogues": [
                {
                    "id": "10252001",
                    "speaker": "钟离",
                    "text": "好了，还想知道些别的什么事吗？",
                    "choices": [
                        {
                            "id": "10252002",
                            "text": "关于「渡劫」…",
                            "response": [
                                {
                                    "id": "10252003",
                                    "speaker": "钟离",
                                    "text": "哈哈…亏他们想得出来，渡劫失败？怎么找了个这样的理由。"
                                },
                                {
                                    "id": "10252004",
                                    "speaker": "钟离",
                                    "text": "不过，七星急于了结此事、不再追查凶手，确实是因为他们暗中得知了「帝君未死」的消息。"
                                },
                                {
                                    "id": "10252005",
                                    "speaker": "钟离",
                                    "text": "嗯，不止七星，诸位仙人那里，我也都已经暗示过了。"
                                },
                                {
                                    "id": "10252006",
                                    "speaker": "钟离",
                                    "text": "你问联系他们的方法…？唔…你有没有听说过，一种叫做「托梦」的便利仙术…"
                                }
                            ]
                        },
                        {
                            "id": "10252007",
                            "text": "关于「公子」…",
                            "response": [
                                {
                                    "id": "10252008",
                                    "speaker": "派蒙",
                                    "text": "说起来，在七星发出公告之前，我们听到好多路人的谈论，把最近一连串事件里所有的黑锅，全都甩给了「公子」呢。"
                                },
                                {
                                    "id": "10252009",
                                    "speaker": "钟离",
                                    "text": "但即使这些「不实指控」确认为假，「公子」派人登上群玉阁、试图阻挠众仙与七星对抗魔神，仍是不争的事实。"
                                },
                                {
                                    "id": "10252010",
                                    "speaker": "钟离",
                                    "text": "听说凝光正在外交的战场上死死咬住这件事不放，把愚人众的使节们杀得焦头烂额…"
                                },
                                {
                                    "id": "10252011",
                                    "speaker": "钟离",
                                    "text": "那些可怜的至冬外交官，要不是因为「执行官」地位崇高，一定会更想把所有黑锅都甩在「公子」头上、宣布把他开除吧。"
                                }
                            ]
                        },
                        {
                            "id": "10252012",
                            "text": "关于璃月七星…",
                            "response": [
                                {
                                    "id": "10252013",
                                    "speaker": "钟离",
                                    "text": "「『仙人』的时代已经过去了，如果连『璃月七星』都不敢正视这一点，那璃月的未来要怎么办啊？」"
                                },
                                {
                                    "id": "10252014",
                                    "speaker": "钟离",
                                    "text": "——刻晴的这句话，说得不错。"
                                },
                                {
                                    "id": "10252015",
                                    "speaker": "钟离",
                                    "text": "虽然我夸赞过凝光的权力欲，认为那是好事，并且想当然地认为，七星从神手中接管璃月权力的计划，是由凝光主导…"
                                },
                                {
                                    "id": "10252016",
                                    "speaker": "钟离",
                                    "text": "但现在回想起来，最初提出「夺权」的，该不会是…嗯？"
                                }
                            ]
                        },
                        {
                            "id": "10252019",
                            "text": "关于摩拉…",
                            "response": [
                                {
                                    "id": "10252020",
                                    "speaker": "派蒙",
                                    "text": "对了，钟离，现在你没有「神之心」了，那提瓦特的摩拉要怎么办呢？"
                                },
                                {
                                    "id": "10252021",
                                    "speaker": "派蒙",
                                    "text": "摩拉克斯「死」了以后，它们会消失吗？"
                                },
                                {
                                    "id": "10252022",
                                    "speaker": "派蒙",
                                    "text": "还有，黄金屋是全大陆唯一的铸币厂，以后它还能继续运作吗？"
                                },
                                {
                                    "id": "10252023",
                                    "speaker": "钟离",
                                    "text": "现存的摩拉，不会消失。但黄金屋确实会停产很长一段时间，因为制造摩拉时，必须借助「岩之神」的力量。"
                                },
                                {
                                    "id": "10252024",
                                    "speaker": "派蒙",
                                    "text": "哇！好可怕，我们都要没钱用了！这个世界要毁灭了！"
                                },
                                {
                                    "id": "10252025",
                                    "speaker": "钟离",
                                    "text": "的确，此事意义重大。从金融角度来说…"
                                },
                                {
                                    "id": "10252026",
                                    "speaker": "钟离",
                                    "text": "唔，算了。这种令人烦恼的话题，还是更适合让璃月七星去谈论。"
                                },
                                {
                                    "id": "10252027",
                                    "speaker": "派蒙",
                                    "text": "那么，那么…你有自己留一些私房钱吗？"
                                },
                                {
                                    "id": "10252028",
                                    "speaker": "钟离",
                                    "text": "哦？私房钱？嗯…以普遍理性而论，真是个好建议。"
                                },
                                {
                                    "id": "10252029",
                                    "speaker": "钟离",
                                    "text": "可惜…"
                                },
                                {
                                    "id": "10252030",
                                    "speaker": "派蒙",
                                    "text": "可惜什么？"
                                },
                                {
                                    "id": "10252031",
                                    "speaker": "钟离",
                                    "text": "可惜忘了。"
                                }
                            ]
                        },
                        {
                            "id": "10252017",
                            "text": "没别的事了…",
                            "response": [
                                {
                                    "id": "10252018",
                                    "speaker": "钟离",
                                    "text": "那么，就想办法找出突破「锁国」的方法吧。别着急，这或许还需要一些机缘…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}