    },
    "talks": [
        {
            "talkId": "6506501",
            "initDialog": "650650101",
            "dialogues": [
                {
                    "id": "650650101",
                    "speaker": "法斯捷",
                    "text": "真这么难以置信吗…"
                }
            ]
        },
        {
            "talkId": "6506502",
            "initDialog": "650650201",
            "dialogues": [
                {
                    "id": "650650201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "650650202",
                    "speaker": "法斯捷",
                    "text": "是我啊，法斯捷！"
                },
                {
                    "id": "650650203",
                    "speaker": "法斯捷",
                    "text": "咦？对不起我认错人了，只是太多人问我这个问题，我以为又是老熟人。"
                }
            ]
        },
        {
            "talkId": "6506504",
            "initDialog": "650650401",
            "dialogues": [
                {
                    "id": "650650401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650650402",
                    "speaker": "法斯捷",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6506505",
            "initDialog": "650650501",
            "dialogues": [
                {
                    "id": "650650501",
                    "speaker": "Player",
                    "text": "老熟人认不出你？"
                },
                {
                    "id": "650650502",
                    "speaker": "法斯捷",
                    "text": "哦，是这样，我进梅洛彼得堡待过一阵，小偷小摸嘛…"
                },
                {
                    "id": "650650503",
                    "speaker": "法斯捷",
                    "text": "结果回来之后谁也不认识我了，说我变化太大。"
                },
                {
                    "id": "650650504",
                    "speaker": "法斯捷",
                    "text": "我承认以前瘦了点，搬椅子都费劲。但至于连认都认不出来吗？我现在也就是壮了一点啊。"
                }
            ]
        },
        {
            "talkId": "6506506",
            "initDialog": "650650601",
            "dialogues": [
                {
                    "id": "650650601",
                    "speaker": "Player",
                    "text": "也能理解。"
                },
                {
                    "id": "650650602",
                    "speaker": "法斯捷",
                    "text": "真的吗？我变化这么大吗？"
                },
                {
                    "id": "650650603",
                    "speaker": "法斯捷",
                    "text": "那可得感谢「拳力斗技场」了。"
                },
                {
                    "id": "650650604",
                    "speaker": "法斯捷",
                    "text": "第一次观看拳赛时，我忍不住想，要是有了足够的力量，还何必去偷东西呢？"
                },
                {
                    "id": "650650605",
                    "speaker": "法斯捷",
                    "text": "这不，我服刑结束后被招募进了刺玫会，做起了正儿八经的体力活。也算是…走上正道了吧？"
                }
            ]
        }
    ]
}