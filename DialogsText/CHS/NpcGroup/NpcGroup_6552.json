{
    "groupId": "6552",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "「维拉庇」": 6
    },
    "talks": [
        {
            "talkId": "6655201",
            "initDialog": "665520101",
            "dialogues": [
                {
                    "id": "665520101",
                    "speaker": "「维拉庇」",
                    "text": "悠悠纳塔，悠悠夏天！欢迎来到刺梨镇，我是这里的守卫，诸位的安全由我来守护。",
                    "choices": [
                        {
                            "id": "665520102",
                            "text": "这里有危险吗？",
                            "response": [
                                {
                                    "id": "665520103",
                                    "speaker": "「维拉庇」",
                                    "text": "世界的真相就是安久必危，危久必安，刺梨镇已经安全了很久，想必最近就会出现危险的贼人。"
                                },
                                {
                                    "id": "665520104",
                                    "speaker": "「维拉庇」",
                                    "text": "但是请放心，作为特诺奇兹托克的最强守卫，我「维拉庇」会守护诸位的安全。"
                                },
                                {
                                    "id": "665520105",
                                    "speaker": "「维拉庇」",
                                    "text": "若有凶杀，「维拉庇」替您挨刀；若有盗抢，「维拉庇」献出财物；若有绑架，「维拉庇」来当人质！"
                                },
                                {
                                    "id": "665520106",
                                    "speaker": "「维拉庇」",
                                    "text": "这就是我「维拉庇」全天候全方位的无死角守护法。"
                                }
                            ]
                        },
                        {
                            "id": "665520201",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "665520202",
                                    "speaker": "「维拉庇」",
                                    "text": "如果遇到危险随时来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}