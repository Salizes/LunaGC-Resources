{
    "groupId": "2516",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "舒山": 16
    },
    "talks": [
        {
            "talkId": "5900180",
            "initDialog": "590018001",
            "dialogues": [
                {
                    "id": "590018001",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900181",
            "initDialog": "590018101",
            "dialogues": [
                {
                    "id": "590018101",
                    "speaker": "舒山",
                    "text": "值得留意？附近的山水风光挺不错，若是你有雅兴，可以慢慢欣赏…"
                }
            ]
        },
        {
            "talkId": "6251601",
            "initDialog": "625160101",
            "dialogues": [
                {
                    "id": "625160101",
                    "speaker": "舒山",
                    "text": "得想想办法，再找些年轻人来认真学学石匠的手艺啊…"
                }
            ]
        },
        {
            "talkId": "6251602",
            "initDialog": "625160201",
            "dialogues": [
                {
                    "id": "625160201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "625160202",
                    "speaker": "舒山",
                    "text": "嗯？是个面相聪颖的年轻人啊。"
                },
                {
                    "id": "625160203",
                    "speaker": "舒山",
                    "text": "老婆子我叫舒山，从我祖上到我，家族世世代代都是沉玉谷最值得仰赖的石匠。"
                },
                {
                    "id": "625160204",
                    "speaker": "舒山",
                    "text": "本地不少石制建筑，都出自我们家族之手。"
                },
                {
                    "id": "625160205",
                    "speaker": "舒山",
                    "text": "如今我已经退休了，但还没找到合格的徒弟，把石匠的本领传承下去…"
                }
            ]
        },
        {
            "talkId": "6251603",
            "initDialog": "625160301",
            "dialogues": [
                {
                    "id": "625160301",
                    "speaker": "Player",
                    "text": "手艺？"
                },
                {
                    "id": "625160302",
                    "speaker": "舒山",
                    "text": "切石运石的工艺，石面雕花的手法…如此百八十种学问，都属于石匠的手艺。"
                },
                {
                    "id": "625160303",
                    "speaker": "舒山",
                    "text": "沉玉谷里不止玉石，还有不少品质绝佳的石材，用来修路筑屋都是上选。"
                },
                {
                    "id": "625160304",
                    "speaker": "舒山",
                    "text": "虽说本地的石匠不止我一家，但谁都希望世代流传之物继续发光发热下去。"
                },
                {
                    "id": "625160305",
                    "speaker": "舒山",
                    "text": "你说，是这个理没错吧？"
                }
            ]
        },
        {
            "talkId": "6251604",
            "initDialog": "625160401",
            "dialogues": [
                {
                    "id": "625160401",
                    "speaker": "Player",
                    "text": "年轻人？"
                },
                {
                    "id": "625160402",
                    "speaker": "舒山",
                    "text": "加工石材不止是手艺活，还是体力活，不从年轻时练起，身子很难受得住。"
                },
                {
                    "id": "625160403",
                    "speaker": "舒山",
                    "text": "不过，也有些年轻人急于求成，走了歪路…"
                },
                {
                    "id": "625160404",
                    "speaker": "舒山",
                    "text": "他们从别处学了花哨的本领，选了洁白的石材，雕花抛光后做成纪念品，然后卖给外人…"
                },
                {
                    "id": "625160405",
                    "speaker": "舒山",
                    "text": "若是价格不高，可以留个纪念，权当一乐。太贵的话，可就不值当了。"
                },
                {
                    "id": "625160406",
                    "speaker": "舒山",
                    "text": "普通石材终究不比美玉，就应当被用来制成寻常的房屋、道路和桥梁。"
                }
            ]
        },
        {
            "talkId": "6251605",
            "initDialog": "625160501",
            "dialogues": [
                {
                    "id": "625160501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "625160502",
                    "speaker": "舒山",
                    "text": "慢走。"
                }
            ]
        }
    ]
}