        {
            "talkId": "7504706",
            "initDialog": "750470601",
            "dialogues": [
                {
                    "id": "750470601",
                    "speaker": "Player",
                    "text": "关于金色的花纹…"
                },
                {
                    "id": "750470602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀…"
                },
                {
                    "id": "750470603",
                    "speaker": "派蒙",
                    "text": "嗯…你们说的金色花纹就是「镌光铭印」吧…"
                },
                {
                    "id": "750470604",
                    "speaker": "派蒙",
                    "text": "但是有的时候你们说有金色花纹的地方，我看不到呢…"
                },
                {
                    "id": "750470605",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "波嗯？呜呜？"
                },
                {
                    "id": "750470606",
                    "speaker": "派蒙",
                    "text": "才不呜呜呢，有些东西看到了也不是什么好事…"
                },
                {
                    "id": "750470607",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}和{NICKNAME}也要多多注意哦。"
                }
            ]
        },
        {
            "talkId": "7504707",
            "initDialog": "750470701",
            "dialogues": [
                {
                    "id": "750470701",
                    "speaker": "Player",
                    "text": "今天心情怎么样？"
                },
                {
                    "id": "750470702",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "750470703",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}看上去心情很好嘛。"
                }
            ]
        },
        {
            "talkId": "7504708",
            "initDialog": "750470801",
            "dialogues": [
                {
                    "id": "750470801",
                    "speaker": "Player",
                    "text": "（抚摸龙伙伴的角…）"
                },
                {
                    "id": "750470802",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔！"
                },
                {
                    "id": "750470803",
                    "speaker": "派蒙",
                    "text": "让我也摸摸，嘿嘿，不要顶啦，顶得手心痒痒的…"
                }
            ]
        }
    ]
}