{
    "groupId": "4113",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "比塔": 10
    },
    "talks": [
        {
            "talkId": "6411301",
            "initDialog": "641130101",
            "dialogues": [
                {
                    "id": "641130101",
                    "speaker": "比塔",
                    "text": "怎么，你也是「只问问，不买货」的人吗？"
                }
            ]
        },
        {
            "talkId": "6411302",
            "initDialog": "641130201",
            "dialogues": [
                {
                    "id": "641130201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641130202",
                    "speaker": "比塔",
                    "text": "我只是一个平平无奇的码头工人，并不重要。"
                },
                {
                    "id": "641130203",
                    "speaker": "比塔",
                    "text": "重要的…是我手上的货。"
                },
                {
                    "id": "641130204",
                    "speaker": "比塔",
                    "text": "你看，这附近是哪？"
                },
                {
                    "id": "641130205",
                    "speaker": "比塔",
                    "text": "是奥摩斯港！"
                },
                {
                    "id": "641130206",
                    "speaker": "比塔",
                    "text": "港口的货，你还不明白吗？"
                },
                {
                    "id": "641130207",
                    "speaker": "比塔",
                    "text": "如何，要看看不？"
                }
            ]
        },
        {
            "talkId": "6411303",
            "initDialog": "641130301",
            "dialogues": [
                {
                    "id": "641130301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641130302",
                    "speaker": "比塔",
                    "text": "不买就别问。"
                }
            ]
        },
        {
            "talkId": "6411304",
            "initDialog": "641130401",
            "dialogues": [
                {
                    "id": "641130401",
                    "speaker": "Player",
                    "text": "我只问问…"
                },
                {
                    "id": "641130402",
                    "speaker": "比塔",
                    "text": "嘿！怎么又来一个！"
                },
                {
                    "id": "641130403",
                    "speaker": "比塔",
                    "text": "真是的，你这样的人，就算是给老爷打白工，我们老爷也不会收的，哼！"
                }
            ]
        }
    ]
}