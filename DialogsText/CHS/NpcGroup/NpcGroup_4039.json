{
    "groupId": "4039",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "伊拉杰": 10
    },
    "talks": [
        {
            "talkId": "6403901",
            "initDialog": "640390101",
            "dialogues": [
                {
                    "id": "640390101",
                    "speaker": "伊拉杰",
                    "text": "你说，在哪能找到一把优雅又好用的大剑呢？"
                }
            ]
        },
        {
            "talkId": "6403902",
            "initDialog": "640390201",
            "dialogues": [
                {
                    "id": "640390201",
                    "speaker": "Player",
                    "text": "你喜欢用双手剑？"
                },
                {
                    "id": "640390202",
                    "speaker": "伊拉杰",
                    "text": "啊哈哈…我没那么厉害，只会耍弯刀啦。"
                },
                {
                    "id": "640390203",
                    "speaker": "伊拉杰",
                    "text": "所以我不是在给自己准备，而是想为同在镀金旅团的「炽鬃之狮」寻一把趁手的武器。"
                },
                {
                    "id": "640390204",
                    "speaker": "伊拉杰",
                    "text": "她是我们这边大剑用得最好的人。每次见到她挥剑的身影都觉得心旷神怡…"
                },
                {
                    "id": "640390205",
                    "speaker": "伊拉杰",
                    "text": "如果能找到全须弥最好用的大剑，我一定要为她拿到手！只希望她到时候不要拒绝就好了…"
                }
            ]
        },
        {
            "talkId": "6403903",
            "initDialog": "640390301",
            "dialogues": [
                {
                    "id": "640390301",
                    "speaker": "Player",
                    "text": "去铁匠铺问问？"
                },
                {
                    "id": "640390302",
                    "speaker": "伊拉杰",
                    "text": "铁匠铺啊…还是算了吧。"
                },
                {
                    "id": "640390303",
                    "speaker": "伊拉杰",
                    "text": "那里的老板是我的养父，经常话里话外想让我们回去继承打铁的家业。"
                },
                {
                    "id": "640390304",
                    "speaker": "伊拉杰",
                    "text": "他对我们这些养子养女都很好，所以我们每次拒绝他心里都很过意不去…"
                },
                {
                    "id": "640390305",
                    "speaker": "伊拉杰",
                    "text": "所以关于武器的事情，还是不要去麻烦他老人家啦。"
                }
            ]
        },
        {
            "talkId": "6403904",
            "initDialog": "640390401",
            "dialogues": [
                {
                    "id": "640390401",
                    "speaker": "Player",
                    "text": "抱歉…"
                },
                {
                    "id": "640390402",
                    "speaker": "伊拉杰",
                    "text": "你也不知道吗…好吧。"
                }
            ]
        }
    ]
}