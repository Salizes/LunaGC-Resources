    },
    "talks": [
        {
            "talkId": "6245901",
            "initDialog": "624590101",
            "dialogues": [
                {
                    "id": "624590101",
                    "speaker": "泽轩",
                    "text": "真不知道什么时候才能复工…"
                }
            ]
        },
        {
            "talkId": "6245902",
            "initDialog": "624590201",
            "dialogues": [
                {
                    "id": "624590201",
                    "speaker": "Player",
                    "text": "你不是正在工作吗？"
                },
                {
                    "id": "624590202",
                    "speaker": "泽轩",
                    "text": "啊我说的复工不是指我，指的是「黄金屋」…"
                },
                {
                    "id": "624590203",
                    "speaker": "泽轩",
                    "text": "「黄金屋」的摩拉已经停产一段时间了，虽然屋内还堆放着如山的摩拉，但再也听不到那哗啦啦的清脆响声了。"
                },
                {
                    "id": "624590204",
                    "speaker": "泽轩",
                    "text": "我原本就是为了来听钱币悦耳的响声，才申请调职到这里的…没想到这么不走运。"
                },
                {
                    "id": "624590205",
                    "speaker": "泽轩",
                    "text": "嗯？这理由很奇怪吗？就算那些钱不是我的，但只要听着，就会有一股来自灵魂深处的满足感涌出…你不会有这样的感觉吗？"
                }
            ]
        },
        {
            "talkId": "6245903",
            "initDialog": "624590301",
            "dialogues": [
                {
                    "id": "624590301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624590302",
                    "speaker": "泽轩",
                    "text": "千岩牢固，重嶂不移。诸事小心。"
                }
            ]
        }
    ]
}