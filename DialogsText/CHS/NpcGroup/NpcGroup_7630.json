{
    "groupId": "7630",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "伊瓦尔": 6,
        "叶洛亚": 3
    },
    "talks": [
        {
            "talkId": "6763001",
            "initDialog": "676300101",
            "dialogues": [
                {
                    "id": "676300101",
                    "speaker": "伊瓦尔",
                    "text": "哪怕是小伤也应该严肃对待，千万不要讳疾忌医。"
                }
            ]
        },
        {
            "talkId": "6763002",
            "initDialog": "676300201",
            "dialogues": [
                {
                    "id": "676300201",
                    "speaker": "Player",
                    "text": "会不会太小题大做了？"
                },
                {
                    "id": "676300202",
                    "speaker": "伊瓦尔",
                    "text": "怎么会呢，管理好自己的状态对我们…特别是对需要执行任务的战士们来说是非常必要的。"
                },
                {
                    "id": "676300203",
                    "speaker": "伊瓦尔",
                    "text": "小的伤病也有可能发展成致命的隐患，早发现早应对才是上策。"
                }
            ]
        },
        {
            "talkId": "6763003",
            "initDialog": "676300301",
            "dialogues": [
                {
                    "id": "676300301",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>叶洛亚</color>似乎有话要说…？）"
                },
                {
                    "id": "676300302",
                    "speaker": "叶洛亚",
                    "text": "最近怎么样？"
                },
                {
                    "id": "676300303",
                    "speaker": "伊瓦尔",
                    "text": "托大家的福，还不错。你呢？任务会不会太重了？罗洛有没有给你添麻烦？"
                },
                {
                    "id": "676300304",
                    "speaker": "叶洛亚",
                    "text": "都是分内的事，我应付得来。罗洛…别说添麻烦了，反倒是我经常受他照顾呢。"
                },
                {
                    "id": "676300305",
                    "speaker": "伊瓦尔",
                    "text": "那就好，说起来，这也是他的分内之事。你们都辛苦了，要是有什么小伤小病，不要疏忽，记得及时处理。"
                },
                {
                    "id": "676300306",
                    "speaker": "叶洛亚",
                    "text": "嗯，记住了。伊瓦尔也要保重身体。"
                }
            ]
        },
        {
            "talkId": "6763004",
            "initDialog": "676300401",
            "dialogues": [
                {
                    "id": "676300401",
                    "speaker": "Player",
                    "text": "多谢提醒，不过先告辞了。"
                },
                {
                    "id": "676300402",
                    "speaker": "伊瓦尔",
                    "text": "多保重。"
                }
            ]
        }
    ]
}