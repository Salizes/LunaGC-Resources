{
    "groupId": "9113",
    "total_dialogue_lines": 76,
    "speaker_counts": {
        "Player": 22,
        "伊法": 54
    },
    "talks": [
        {
            "talkId": "6911301",
            "initDialog": "691130101",
            "dialogues": [
                {
                    "id": "691130101",
                    "speaker": "伊法",
                    "text": "你一个人住这么好的地方？"
                },
                {
                    "id": "691130102",
                    "speaker": "伊法",
                    "text": "不错，这里能养十头龙了。"
                }
            ]
        },
        {
            "talkId": "6911302",
            "initDialog": "691130201",
            "dialogues": [
                {
                    "id": "691130201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691130202",
                    "speaker": "伊法",
                    "text": "挺不错的。"
                },
                {
                    "id": "691130203",
                    "speaker": "伊法",
                    "text": "空气清新，场地宽敞，人在这里舒服，宠物或龙过来也没问题。"
                },
                {
                    "id": "691130204",
                    "speaker": "Player",
                    "text": "不愧是兽医，总想着动物。"
                },
                {
                    "id": "691130205",
                    "speaker": "伊法",
                    "text": "每个人都有自己必须关注的事，就像你们冒险家也会对冒险的事格外有心得。"
                },
                {
                    "id": "691130206",
                    "speaker": "伊法",
                    "text": "又或者，你对拯救各个地方更有心得？"
                },
                {
                    "id": "691130207",
                    "speaker": "Player",
                    "text": "听起来像在夸我。"
                },
                {
                    "id": "691130208",
                    "speaker": "伊法",
                    "text": "当然。对于那些帮助了纳塔的伙伴，我没必要吝惜赞美。"
                },
                {
                    "id": "691130209",
                    "speaker": "伊法",
                    "text": "据我观察，你是一个对野外生活很有心得，也很热爱生活的人。"
                },
                {
                    "id": "691130210",
                    "speaker": "伊法",
                    "text": "这种类型的人适合做朋友。"
                },
                {
                    "id": "691130211",
                    "speaker": "Player",
                    "text": "为什么呢？"
                },
                {
                    "id": "691130212",
                    "speaker": "伊法",
                    "text": "热爱生活的人往往愿意主动收拾屋子，也不会把一切搞得乱七八糟。"
                },
                {
                    "id": "691130213",
                    "speaker": "伊法",
                    "text": "这样你的负担就会小得多。"
                },
                {
                    "id": "691130214",
                    "speaker": "Player",
                    "text": "听上去你对你的朋友颇有微词。"
                },
                {
                    "id": "691130215",
                    "speaker": "伊法",
                    "text": "嗯？能听出来吗？好吧。"
                },
                {
                    "id": "691130216",
                    "speaker": "Player",
                    "text": "是指欧洛伦吗？"
                },
                {
                    "id": "691130217",
                    "speaker": "伊法",
                    "text": "那倒不是。他的生活习惯还是很良好的。要知道，做事乱七八糟的人根本种不好菜。"
                },
                {
                    "id": "691130218",
                    "speaker": "伊法",
                    "text": "我说的是那些龙伙伴。既然是伙伴，也可以算朋友。"
                },
                {
                    "id": "691130219",
                    "speaker": "伊法",
                    "text": "龙发起脾气来比人厉害多了，会像狂风一样袭击你家。"
                },
                {
                    "id": "691130220",
                    "speaker": "伊法",
                    "text": "这种时候你得想办法安抚它们。至于算账嘛…都是后话了。"
                }
            ]
        },
        {
            "talkId": "6911303",
            "initDialog": "691130301",
            "dialogues": [
                {
                    "id": "691130301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691130302",
                    "speaker": "伊法",
                    "text": "没问题。"
                },
                {
                    "id": "691130303",
                    "speaker": "伊法",
                    "text": "我这里有零食，正好，来点吗？",
                    "choices": [
                        {
                            "id": "691130304",
                            "text": "是用来喂龙的吗？",
                            "response": [
                                {
                                    "id": "691130306",
                                    "speaker": "伊法",
                                    "text": "自己吃也行，喂龙也行，多带点食物不会错。"
                                },
                                {
                                    "id": "691130307",
                                    "speaker": "伊法",
                                    "text": "这些是我自己烤的肉干，尝尝吧，很好吃的。",
                                    "choices": [
                                        {
                                            "id": "691130308",
                                            "text": "好脆，好好吃！",
                                            "response": [
                                                {
                                                    "id": "691130309",
                                                    "speaker": "伊法",
                                                    "text": "是吗？那就好。还有撒了其他调料的，下次带给你。"
                                                },
                                                {
                                                    "id": "691130315",
                                                    "speaker": "伊法",
                                                    "text": "对了，这袋肉干给你，拿去喂龙可以跟它们搞好关系。"
                                                },
                                                {
                                                    "id": "691130316",
                                                    "speaker": "伊法",
                                                    "text": "不确定你是否有这种需要，先拿着吧。"
                                                },
                                                {
                                                    "id": "691130317",
                                                    "speaker": "Player",
                                                    "text": "伊法做事好周到啊，谢谢你。"
                                                },
                                                {
                                                    "id": "691130318",
                                                    "speaker": "伊法",
                                                    "text": "你能这么想，我很高兴。"
                                                },
                                                {
                                                    "id": "691130319",
                                                    "speaker": "伊法",
                                                    "text": "不过不瞒你说，我小时候也很丢三落四，当了医生以后才好起来。"
                                                },
                                                {
                                                    "id": "691130327",
                                                    "speaker": "伊法",
                                                    "text": "糟糕事难免有，但总会过去的。"
                                                },
                                                {
                                                    "id": "691130328",
                                                    "speaker": "伊法",
                                                    "text": "也祝你无论遇到什么困难都能越过去。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691130310",
                                            "text": "谢谢，不过…很难嚼呢…",
                                            "response": [
                                                {
                                                    "id": "691130311",
                                                    "speaker": "伊法",
                                                    "text": "糟糕，默认你的牙口和龙一样好了…"
                                                },
                                                {
                                                    "id": "691130312",
                                                    "speaker": "伊法",
                                                    "text": "不好意思，那换些别的吧，还有烤好的小饼干…"
                                                },
                                                {
                                                    "id": "691130313",
                                                    "speaker": "Player",
                                                    "text": "这个脆多了呢。"
                                                },
                                                {
                                                    "id": "691130314",
                                                    "speaker": "伊法",
                                                    "text": "嚼得动就好。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691130305",
                            "text": "是应急的干粮吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911304",
            "initDialog": "691130401",
            "dialogues": [
                {
                    "id": "691130401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691130402",
                    "speaker": "伊法",
                    "text": "想在你这里四处看看，参考学习一下布置手法。"
                },
                {
                    "id": "691130403",
                    "speaker": "伊法",
                    "text": "有些摆设放得很有趣，还很实用。正好我也想调整一下自家的院子。",
                    "choices": [
                        {
                            "id": "691130404",
                            "text": "请尽情学习吧！",
                            "response": [
                                {
                                    "id": "691130405",
                                    "speaker": "伊法",
                                    "text": "哈哈，不收我学费吧？"
                                },
                                {
                                    "id": "691130408",
                                    "speaker": "Player",
                                    "text": "伊法也教我点什么吧。"
                                },
                                {
                                    "id": "691130409",
                                    "speaker": "伊法",
                                    "text": "教你啊，唔，我想想…"
                                },
                                {
                                    "id": "691130410",
                                    "speaker": "伊法",
                                    "text": "像你这种成熟独立的冒险家，会的东西已经很多了。"
                                },
                                {
                                    "id": "691130411",
                                    "speaker": "伊法",
                                    "text": "非要学点什么的话…来，学习一下这个手势。"
                                },
                                {
                                    "id": "691130412",
                                    "speaker": "Player",
                                    "text": "勾勾手？"
                                },
                                {
                                    "id": "691130413",
                                    "speaker": "伊法",
                                    "text": "对，只是看着简单。角度和频率都很重要。"
                                },
                                {
                                    "id": "691130414",
                                    "speaker": "伊法",
                                    "text": "不紧不慢，温和一点。勾手的频率也别太低，这样它们就能感觉到你很有活力。"
                                },
                                {
                                    "id": "691130415",
                                    "speaker": "伊法",
                                    "text": "做得好的话，猫狗和龙都会主动跑来跟你打招呼。对它们来说这是友好的信号。"
                                },
                                {
                                    "id": "691130416",
                                    "speaker": "Player",
                                    "text": "学到了！"
                                },
                                {
                                    "id": "691130417",
                                    "speaker": "伊法",
                                    "text": "很实用吧。"
                                },
                                {
                                    "id": "691130418",
                                    "speaker": "Player",
                                    "text": "对了，能吹口哨吗？"
                                },
                                {
                                    "id": "691130419",
                                    "speaker": "伊法",
                                    "text": "这个我不推荐。对小动物可能还好，对龙吹口哨，有可能激怒它们。"
                                },
                                {
                                    "id": "691130420",
                                    "speaker": "伊法",
                                    "text": "纳塔有些龙自尊心很强，甚至还很聪明。不要试图糊弄那群家伙。"
                                },
                                {
                                    "id": "691130421",
                                    "speaker": "伊法",
                                    "text": "跟龙相处，本质上和跟人交往差不多。真心换真心才行。"
                                }
                            ]
                        },
                        {
                            "id": "691130406",
                            "text": "这是大师我的匠心之作。",
                            "response": [
                                {
                                    "id": "691130407",
                                    "speaker": "伊法",
                                    "text": "让我偷师一下。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911305",
            "initDialog": "691130501",
            "dialogues": [
                {
                    "id": "691130501",
                    "speaker": "Player",
                    "text": "早啊，伊法。"
                },
                {
                    "id": "691130502",
                    "speaker": "伊法",
                    "text": "早啊，起得挺早的嘛。"
                },
                {
                    "id": "691130503",
                    "speaker": "伊法",
                    "text": "保持良好作息，你会获得健康。"
                }
            ]
        },
        {
            "talkId": "6911306",
            "initDialog": "691130601",
            "dialogues": [
                {
                    "id": "691130601",
                    "speaker": "Player",
                    "text": "晚安，伊法。"
                },
                {
                    "id": "691130602",
                    "speaker": "伊法",
                    "text": "晚安。早点休息，能睡就多睡一会儿。"
                },
                {
                    "id": "691130603",
                    "speaker": "伊法",
                    "text": "我还要给病患们写个病历，晚点再睡。"
                }
            ]
        },
        {
            "talkId": "6911310",
            "initDialog": "691131001",
            "dialogues": [
                {
                    "id": "691131001",
                    "speaker": "伊法",
                    "text": "这是花羽会的特色建筑。我家的房子也是这种风格，我挺喜欢的。"
                },
                {
                    "id": "691131002",
                    "speaker": "伊法",
                    "text": "别看这类建筑线条很圆，内部空间比看起来大不少。"
                },
                {
                    "id": "691131003",
                    "speaker": "伊法",
                    "text": "嗯？你说像洋葱？会吗？"
                }
            ]
        },
        {
            "talkId": "6911311",
            "initDialog": "691131101",
            "dialogues": [
                {
                    "id": "691131101",
                    "speaker": "伊法",
                    "text": "都是实用家具。买一套吧，养龙人的首选，不会错。"
                },
                {
                    "id": "691131102",
                    "speaker": "伊法",
                    "text": "如果不养龙，呃…养派蒙大概也行吧？"
                },
                {
                    "id": "691131103",
                    "speaker": "伊法",
                    "text": "话说回来，派蒙算什么生物？唔…"
                }
            ]
        }
    ]
}