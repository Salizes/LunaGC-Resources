{
    "groupId": "7636",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "劳乌里": 11
    },
    "talks": [
        {
            "talkId": "6763601",
            "initDialog": "676360101",
            "dialogues": [
                {
                    "id": "676360101",
                    "speaker": "劳乌里",
                    "text": "啊，劳驾，能稍微陪我说说话吗…我总觉得有些害怕。"
                }
            ]
        },
        {
            "talkId": "6763602",
            "initDialog": "676360201",
            "dialogues": [
                {
                    "id": "676360201",
                    "speaker": "Player",
                    "text": "怎么了，有什么需要吗？"
                },
                {
                    "id": "676360202",
                    "speaker": "劳乌里",
                    "text": "我需要…好吧，我只是需要有人跟我说句话，虽然拉杜什劳说我运气好，捡了一命，但我现在还觉得我的身子是冷的。"
                },
                {
                    "id": "676360203",
                    "speaker": "劳乌里",
                    "text": "从前，执灯人里的老人告诉我，「就是这么回事，身子越来越冷，越来越冷，然后你发现再没人和你说话…」"
                },
                {
                    "id": "676360204",
                    "speaker": "劳乌里",
                    "text": "「人都是这样离开的，一点都不会痛，所以别害怕。」…唉，这可不是能让人从中得到宽慰的话啊。"
                },
                {
                    "id": "676360205",
                    "speaker": "劳乌里",
                    "text": "所以您现在还能和我说说话，说明我还在这里…我还在这里，这就够了，感谢您。"
                }
            ]
        },
        {
            "talkId": "6763603",
            "initDialog": "676360301",
            "dialogues": [
                {
                    "id": "676360301",
                    "speaker": "Player",
                    "text": "受了很重的伤？"
                },
                {
                    "id": "676360302",
                    "speaker": "劳乌里",
                    "text": "毕竟行动很危险，到处是魔物…好在我们医生的医术不错。"
                },
                {
                    "id": "676360303",
                    "speaker": "劳乌里",
                    "text": "唔…现在那些伤口还在隐隐作痛，胸口的，背后的，唉…会伤成这样。不过，总要有人挺身而出…我觉得这次该是我了。"
                },
                {
                    "id": "676360304",
                    "speaker": "劳乌里",
                    "text": "从前我都是躲在最后面的那个，撤退的时候也是第一个转身，但是这次不一样，至少…我觉得这次可以不一样。"
                },
                {
                    "id": "676360305",
                    "speaker": "劳乌里",
                    "text": "…但差点连命都丢了，玛柳莎说得对，我是个蠢货，不该在战场上做不习惯的事。"
                }
            ]
        },
        {
            "talkId": "6763604",
            "initDialog": "676360401",
            "dialogues": [
                {
                    "id": "676360401",
                    "speaker": "Player",
                    "text": "抱歉，暂时没有时间。"
                },
                {
                    "id": "676360402",
                    "speaker": "劳乌里",
                    "text": "没事…其实就这样一句都行，感谢您。"
                }
            ]
        },
        {
            "talkId": "6763605",
            "initDialog": "676360501",
            "dialogues": [
                {
                    "id": "676360501",
                    "speaker": "Player",
                    "text": "先好好休息吧，先生。"
                },
                {
                    "id": "676360502",
                    "speaker": "劳乌里",
                    "text": "…唔，您说得对，但我还是不敢就这样闭上眼。"
                }
            ]
        }
    ]
}