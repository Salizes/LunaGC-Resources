{
    "groupId": "7106",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "莱赫妲尔": 10
    },
    "talks": [
        {
            "talkId": "6710601",
            "initDialog": "671060101",
            "dialogues": [
                {
                    "id": "671060101",
                    "speaker": "莱赫妲尔",
                    "text": "像那种莫名其妙的故事，就不该让孩子们读到…"
                }
            ]
        },
        {
            "talkId": "6710602",
            "initDialog": "671060201",
            "dialogues": [
                {
                    "id": "671060201",
                    "speaker": "Player",
                    "text": "莫名其妙的故事？"
                },
                {
                    "id": "671060202",
                    "speaker": "莱赫妲尔",
                    "text": "就是那些啊…什么情情爱爱的，打打杀杀的，尤其是什么大盗雷德·米勒的故事，纯粹就是在教坏小孩子。"
                },
                {
                    "id": "671060203",
                    "speaker": "莱赫妲尔",
                    "text": "幸亏我家卡夏是个听话懂事的好孩子，从来不会看那种奇怪的东西。不过，要是让其他孩子看到的话，坏影响简直不可估量…"
                }
            ]
        },
        {
            "talkId": "6710603",
            "initDialog": "671060301",
            "dialogues": [
                {
                    "id": "671060301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "671060302",
                    "speaker": "莱赫妲尔",
                    "text": "嗯，愿月光照临你的前路。"
                }
            ]
        },
        {
            "talkId": "6710604",
            "initDialog": "671060401",
            "dialogues": [
                {
                    "id": "671060401",
                    "speaker": "Player",
                    "text": "关于雷德·米勒…"
                },
                {
                    "id": "671060402",
                    "speaker": "莱赫妲尔",
                    "text": "哼，几百年前一个到处惹是生非的小贼罢了，不知道为什么这种人也能成为小说的主角。"
                },
                {
                    "id": "671060403",
                    "speaker": "莱赫妲尔",
                    "text": "又是什么月下洗劫总督宫，又是什么和妖精总督的养女一见钟情，甚至还胡编乱造说「霜月之子」的圣女也爱上了他…"
                }
            ]
        },
        {
            "talkId": "7690601",
            "initDialog": "769060101",
            "dialogues": [
                {
                    "id": "769060101",
                    "speaker": "Player",
                    "text": "你好像挺熟悉的…"
                },
                {
                    "id": "769060102",
                    "speaker": "莱赫妲尔",
                    "text": "熟、熟悉？！我、我怎么可能熟悉这种荒唐的东西！"
                },
                {
                    "id": "769060103",
                    "speaker": "莱赫妲尔",
                    "text": "「陌生的小姐，霜月之子所有的秘宝，都胜不过您的心意与美貌」之类的，「那些不义之财，现在就请你悉数奉还」之类的…"
                },
                {
                    "id": "769060104",
                    "speaker": "莱赫妲尔",
                    "text": "像这样的胡言乱语，我可是听都没听说过！"
                },
                {
                    "id": "769060105",
                    "speaker": "莱赫妲尔",
                    "text": "总…总之，我家卡夏绝对不能接触这些！比起那个，孩子们应该把精力用在提升自己的品德上，要像月光一样无垢才行！"
                }
            ]
        }
    ]
}