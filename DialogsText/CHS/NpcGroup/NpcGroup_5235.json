{
    "groupId": "5235",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "伊洛丝": 7
    },
    "talks": [
        {
            "talkId": "6523501",
            "initDialog": "652350101",
            "dialogues": [
                {
                    "id": "652350101",
                    "speaker": "伊洛丝",
                    "text": "没想到会在这里遇到你。你犯啥事了？"
                }
            ]
        },
        {
            "talkId": "6523502",
            "initDialog": "652350201",
            "dialogues": [
                {
                    "id": "652350201",
                    "speaker": "Player",
                    "text": "我没犯事…"
                },
                {
                    "id": "652350202",
                    "speaker": "伊洛丝",
                    "text": "那还真可惜。"
                }
            ]
        },
        {
            "talkId": "6523503",
            "initDialog": "652350301",
            "dialogues": [
                {
                    "id": "652350301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652350302",
                    "speaker": "伊洛丝",
                    "text": "保重！毕竟，在这种地方说「再见」感觉还挺奇怪的。"
                }
            ]
        },
        {
            "talkId": "6523504",
            "initDialog": "652350401",
            "dialogues": [
                {
                    "id": "652350401",
                    "speaker": "Player",
                    "text": "可惜？"
                },
                {
                    "id": "652350402",
                    "speaker": "伊洛丝",
                    "text": "啊，我没什么别的意思！我是说，这里还蛮不错的…"
                },
                {
                    "id": "652350403",
                    "speaker": "伊洛丝",
                    "text": "看守都挺和善。而且你瞧，只要工作就能拿到特许券，每天还有饭吃，这可比当佣兵混生活安稳多了！"
                }
            ]
        },
        {
            "talkId": "6523505",
            "initDialog": "652350501",
            "dialogues": [
                {
                    "id": "652350501",
                    "speaker": "Player",
                    "text": "你的同伴呢？"
                },
                {
                    "id": "652350502",
                    "speaker": "伊洛丝",
                    "text": "凯伊卡和凯库巴德吗？他们算是「从犯」，所以交了笔罚款就没事了。"
                },
                {
                    "id": "652350503",
                    "speaker": "伊洛丝",
                    "text": "希望他们能找到更可靠的雇主，干点更光明磊落的活计…"
                }
            ]
        }
    ]
}