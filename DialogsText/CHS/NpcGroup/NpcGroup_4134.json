    },
    "talks": [
        {
            "talkId": "6413401",
            "initDialog": "641340101",
            "dialogues": [
                {
                    "id": "641340101",
                    "speaker": "舍万",
                    "text": "这位客人，想看点新鲜玩意儿吗？"
                }
            ]
        },
        {
            "talkId": "6413402",
            "initDialog": "641340201",
            "dialogues": [
                {
                    "id": "641340201",
                    "speaker": "Player",
                    "text": "又来了吗…"
                },
                {
                    "id": "641340202",
                    "speaker": "舍万",
                    "text": "嗯？什么叫「又来」？"
                },
                {
                    "id": "641340203",
                    "speaker": "舍万",
                    "text": "我这的新鲜东西，包你见都没见过！"
                },
                {
                    "id": "641340204",
                    "speaker": "舍万",
                    "text": "你看这个，能捏成各种形状，还能黏到墙上的「史莱姆糊糊」。"
                },
                {
                    "id": "641340205",
                    "speaker": "舍万",
                    "text": "还有这个，只要放在两手之间搓一搓，就能升到空中的「飞高高」！"
                },
                {
                    "id": "641340206",
                    "speaker": "舍万",
                    "text": "怎么样，好玩吧？自己玩，或者买回家送给小朋友，都很不错！"
                },
                {
                    "id": "641340207",
                    "speaker": "舍万",
                    "text": "欸，你，你，别走啊…"
                }
            ]
        },
        {
            "talkId": "6413403",
            "initDialog": "641340301",
            "dialogues": [
                {
                    "id": "641340301",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "641340302",
                    "speaker": "舍万",
                    "text": "别，别走啊，好歹让我给你介绍一下！"
                }
            ]
        }
    ]
}