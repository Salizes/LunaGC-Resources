{
    "groupId": "5057",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "路易": 10
    },
    "talks": [
        {
            "talkId": "6505701",
            "initDialog": "650570101",
            "dialogues": [
                {
                    "id": "650570101",
                    "speaker": "路易",
                    "text": "世上最美味的东西！亲爱的，要来一点吗？"
                }
            ]
        },
        {
            "talkId": "6505702",
            "initDialog": "650570201",
            "dialogues": [
                {
                    "id": "650570201",
                    "speaker": "Player",
                    "text": "有菜单吗？"
                },
                {
                    "id": "650570202",
                    "speaker": "路易",
                    "text": "这边，亲爱的，请慢慢看，想吃什么就和我说。"
                }
            ]
        },
        {
            "talkId": "6505703",
            "initDialog": "650570301",
            "dialogues": [
                {
                    "id": "650570301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650570302",
                    "speaker": "路易",
                    "text": "我是街头美食的代言，亲爱的。"
                },
                {
                    "id": "650570303",
                    "speaker": "路易",
                    "text": "如果我像大人物那样拥有称号，我想管自己叫做…「卖炸鱼薯条的路易」。简单好记，不是吗？"
                }
            ]
        },
        {
            "talkId": "6505704",
            "initDialog": "650570401",
            "dialogues": [
                {
                    "id": "650570401",
                    "speaker": "Player",
                    "text": "推荐菜…"
                },
                {
                    "id": "650570402",
                    "speaker": "路易",
                    "text": "亲爱的，你可问对人了。这世界上最好吃的东西非炸鱼薯条莫属！"
                },
                {
                    "id": "650570403",
                    "speaker": "路易",
                    "text": "早餐来点炸鱼薯条，提供一上午所需的能量；下午点心来点炸鱼薯条，每个孩子都会喜欢…"
                },
                {
                    "id": "650570404",
                    "speaker": "路易",
                    "text": "逛街散步也能来点炸鱼薯条，酥松香脆，特巡队队长和海鸥都喜欢得不得了！"
                },
                {
                    "id": "650570405",
                    "speaker": "路易",
                    "text": "我都想象不出离了炸鱼薯条的枫丹会变成什么样子！"
                }
            ]
        },
        {
            "talkId": "6505705",
            "initDialog": "650570501",
            "dialogues": [
                {
                    "id": "650570501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650570502",
                    "speaker": "路易",
                    "text": "想吃炸鱼薯条了就来找我，亲爱的，我们下次见。"
                }
            ]
        },
        {
            "talkId": "7493001",
            "initDialog": "749300101",
            "dialogues": [
                {
                    "id": "749300101",
                    "speaker": "Player",
                    "text": "真有那么好吃？"
                },
                {
                    "id": "749300102",
                    "speaker": "路易",
                    "text": "嘿，亲爱的，这份炸鱼薯条我给你包好，你尝尝就知道了。"
                }
            ]
        }
    ]
}