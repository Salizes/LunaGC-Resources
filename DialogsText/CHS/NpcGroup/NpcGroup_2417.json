{
    "groupId": "2417",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "老刘伯": 10
    },
    "talks": [
        {
            "talkId": "6241701",
            "initDialog": "624170101",
            "dialogues": [
                {
                    "id": "624170101",
                    "speaker": "老刘伯",
                    "text": "哦，年轻人，找老朽有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6241702",
            "initDialog": "624170201",
            "dialogues": [
                {
                    "id": "624170201",
                    "speaker": "Player",
                    "text": "您在做什么？"
                },
                {
                    "id": "624170202",
                    "speaker": "老刘伯",
                    "text": "老朽只是在回想些过去的事，等你到了我这个年纪就会发现，比起展望未来还是过去的回忆更美好一些。"
                },
                {
                    "id": "624170203",
                    "speaker": "老刘伯",
                    "text": "就比如我最近常常想起，住在隔壁的姐姐淑之年轻时候的样子…"
                },
                {
                    "id": "624170204",
                    "speaker": "老刘伯",
                    "text": "我总趴在窗边偷看她，有时候她发现我了，还会对我微微一笑。"
                },
                {
                    "id": "624170205",
                    "speaker": "老刘伯",
                    "text": "我永远都不会忘记她笑起来时脸颊上那对深深酒窝，饱含笑意的眼眸中仿佛只剩下了我…"
                },
                {
                    "id": "624170206",
                    "speaker": "Player",
                    "text": "后来呢？"
                },
                {
                    "id": "624170207",
                    "speaker": "老刘伯",
                    "text": "后来？什么后来？"
                },
                {
                    "id": "624170208",
                    "speaker": "老刘伯",
                    "text": "…难道你是指告、告白？"
                },
                {
                    "id": "624170209",
                    "speaker": "老刘伯",
                    "text": "你、你在说什么呢，告白那种事，哪儿有你说的那么简单啊！"
                },
                {
                    "id": "624170210",
                    "speaker": "老刘伯",
                    "text": "嘿呀，现在的年轻人啊…羞耻心都不知道去哪儿了…"
                }
            ]
        },
        {
            "talkId": "6241703",
            "initDialog": "624170301",
            "dialogues": [
                {
                    "id": "624170301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624170302",
                    "speaker": "老刘伯",
                    "text": "有道是「人无再少年」，到头来别像我一样，除了回忆什么也不剩下…"
                }
            ]
        }
    ]
}