{
    "groupId": "12861",
    "total_dialogue_lines": 81,
    "speaker_counts": {
        "Player": 18,
        "派蒙": 27,
        "铁骨双刀": 36
    },
    "talks": [
        {
            "talkId": "4008137",
            "initDialog": "400813701",
            "dialogues": [
                {
                    "id": "400813701",
                    "speaker": "铁骨双刀",
                    "text": "……"
                },
                {
                    "id": "400813702",
                    "speaker": "派蒙",
                    "text": "这个人的神情好严肃，看起来凶凶的…我们还是不要和他搭话了吧…"
                }
            ]
        },
        {
            "talkId": "4008142",
            "initDialog": "400814201",
            "dialogues": [
                {
                    "id": "400814201",
                    "speaker": "铁骨双刀",
                    "text": "怎么是你们两个？哼！",
                    "choices": [
                        {
                            "id": "400814202",
                            "text": "我们怎么了？",
                            "response": [
                                {
                                    "id": "400814203",
                                    "speaker": "铁骨双刀",
                                    "text": "没什么，你们迟早会明白的。"
                                },
                                {
                                    "id": "400814204",
                                    "speaker": "派蒙",
                                    "text": "这个人怎么跑到训练的场地来了？听他的口气，难道他也是参赛选手吗？",
                                    "choices": [
                                        {
                                            "id": "400814205",
                                            "text": "派蒙不要怕。",
                                            "response": [
                                                {
                                                    "id": "400814207",
                                                    "speaker": "派蒙",
                                                    "text": "好像也对哦，那么多凶巴巴的家伙都被我们打败了，这个人也没什么特别的。"
                                                },
                                                {
                                                    "id": "400814208",
                                                    "speaker": "派蒙",
                                                    "text": "而且我相信「咚咚小圆帽」和蕈兽伙伴们！脾气这么坏的人，肯定也和蕈兽们搞不好关系！"
                                                },
                                                {
                                                    "id": "400814209",
                                                    "speaker": "铁骨双刀",
                                                    "text": "你们的声音没压住，我都听见了。"
                                                },
                                                {
                                                    "id": "400814210",
                                                    "speaker": "派蒙",
                                                    "text": "噫！"
                                                },
                                                {
                                                    "id": "400814211",
                                                    "speaker": "铁骨双刀",
                                                    "text": "我不想和你们浪费口舌，所有事情都会在赛场上见分晓。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400814206",
                                            "text": "对付他还不是轻轻松松。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400814212",
                            "text": "哼！",
                            "response": [
                                {
                                    "id": "400814213",
                                    "speaker": "铁骨双刀",
                                    "text": "你！你倒还挺嚣张啊？"
                                },
                                {
                                    "id": "400814214",
                                    "speaker": "派蒙",
                                    "text": "呜哇，你不要和他对着干啦！"
                                },
                                {
                                    "id": "400814215",
                                    "speaker": "Player",
                                    "text": "他凶凶，我气气。"
                                },
                                {
                                    "id": "400814216",
                                    "speaker": "派蒙",
                                    "text": "可是，万一惹恼了他，打起来了该怎么办…"
                                },
                                {
                                    "id": "400814217",
                                    "speaker": "派蒙",
                                    "text": "唔，不对哦！要是打起来了，要提心吊胆的应该是他！那…到时候你可得注意下手的力道啊！"
                                },
                                {
                                    "id": "400814218",
                                    "speaker": "派蒙",
                                    "text": "#总之，这位佣兵，为了你的安全着想，还是不要和{NICKNAME}争起来比较好哦。"
                                },
                                {
                                    "id": "400814219",
                                    "speaker": "铁骨双刀",
                                    "text": "我可是要成为知名驯兽师的人！使用个人武力进行赛场外的斗争，对我而言完全没有意义。"
                                },
                                {
                                    "id": "400814220",
                                    "speaker": "铁骨双刀",
                                    "text": "别浪费时间和我斗嘴了，该干什么就干什么去吧！"
                                }
                            ]
                        },
                        {
                            "id": "400814221",
                            "text": "告辞！",
                            "response": [
                                {
                                    "id": "400814222",
                                    "speaker": "铁骨双刀",
                                    "text": "快走吧你！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008145",
            "initDialog": "400814501",
            "dialogues": [
                {
                    "id": "400814501",
                    "speaker": "铁骨双刀",
                    "text": "实在太丢脸了…",
                    "choices": [
                        {
                            "id": "400814502",
                            "text": "鼠辈来啦！",
                            "response": [
                                {
                                    "id": "400814503",
                                    "speaker": "派蒙",
                                    "text": "见识浅薄的派蒙来啦！"
                                },
                                {
                                    "id": "400814504",
                                    "speaker": "铁骨双刀",
                                    "text": "你们！你们是想气死我吗！"
                                },
                                {
                                    "id": "400814505",
                                    "speaker": "铁骨双刀",
                                    "text": "行，没问题！输了就是输了，我为之前不妥的言论道歉！"
                                },
                                {
                                    "id": "400814506",
                                    "speaker": "铁骨双刀",
                                    "text": "对不起！你们尽管嘲笑我吧！"
                                },
                                {
                                    "id": "400814507",
                                    "speaker": "铁骨双刀",
                                    "text": "不过，海妮耶大人还是会战胜你们的。虽然她赢了任何人都和我无关，但至少证明，我的信念没有错！"
                                },
                                {
                                    "id": "400814508",
                                    "speaker": "派蒙",
                                    "text": "你为什么这么相信海妮耶呢？难道说，海妮耶以前帮过你，救过你的命吗？"
                                },
                                {
                                    "id": "400814509",
                                    "speaker": "铁骨双刀",
                                    "text": "这就说来话长了…"
                                },
                                {
                                    "id": "400814510",
                                    "speaker": "铁骨双刀",
                                    "text": "当年，有几个盗宝团的家伙，不知道用什么方法激怒了一大群驮兽，想用这些驮兽冲散一支商队，以便盗宝团打劫财物…"
                                },
                                {
                                    "id": "400814511",
                                    "speaker": "铁骨双刀",
                                    "text": "但海妮耶大人不知用什么方法，察觉到了这群驮兽的异样，提前将它们安抚下来，阻止了一场灾难。"
                                },
                                {
                                    "id": "400814512",
                                    "speaker": "派蒙",
                                    "text": "难道说，你担任了那支商队的护卫？海妮耶保住了你的雇主的财产，也因此保住了你的摩拉…甚至是性命！"
                                },
                                {
                                    "id": "400814513",
                                    "speaker": "铁骨双刀",
                                    "text": "不，我是路过看戏的。"
                                },
                                {
                                    "id": "400814514",
                                    "speaker": "铁骨双刀",
                                    "text": "凭我十多年佣兵生涯的经验，我敢确定，要是我被卷入了那样的事件，必定凶多吉少了。"
                                },
                                {
                                    "id": "400814515",
                                    "speaker": "铁骨双刀",
                                    "text": "海妮耶大人驯兽的本领远比我手里的武器强大，为此，我才封存了我心爱的双刀，退出了镀金旅团，开始钻研驯兽之法。"
                                },
                                {
                                    "id": "400814516",
                                    "speaker": "铁骨双刀",
                                    "text": "现在你们明白了吗？海妮耶大人让我走上了一条更有潜力的道路，是可敬的前辈！"
                                },
                                {
                                    "id": "400814517",
                                    "speaker": "Player",
                                    "text": "明，明白了…"
                                },
                                {
                                    "id": "400814518",
                                    "speaker": "派蒙",
                                    "text": "唔呃…逻辑有点奇怪，但好像也有点道理呢…"
                                }
                            ]
                        },
                        {
                            "id": "400814519",
                            "text": "你继续丢脸，不打扰了。",
                            "response": [
                                {
                                    "id": "400814520",
                                    "speaker": "铁骨双刀",
                                    "text": "你！你们快走吧！现在我也不知道该和你说什么！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008150",
            "initDialog": "400815001",
            "dialogues": [
                {
                    "id": "400815001",
                    "speaker": "铁骨双刀",
                    "text": "你们…马上就要和海妮耶大人交锋了吧？",
                    "choices": [
                        {
                            "id": "400815002",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "400815003",
                                    "speaker": "派蒙",
                                    "text": "关于海妮耶的事情，我们的心情也有点沉重，你不要乱说话哦，不然我们会生气的…"
                                },
                                {
                                    "id": "400815004",
                                    "speaker": "铁骨双刀",
                                    "text": "不，现在的我没资格对你们任何一边妄加评论，只不过，我看了海妮耶大人和那位…「玲珑油豆腐」女士的比赛。"
                                },
                                {
                                    "id": "400815005",
                                    "speaker": "铁骨双刀",
                                    "text": "海妮耶大人好像动摇了，我还是第一次看见她这幅模样，感觉…很震撼。"
                                },
                                {
                                    "id": "400815006",
                                    "speaker": "派蒙",
                                    "text": "哼！我早就想说了，你到底把海妮耶当成什么铁石心肠的人了啦，这样一点也不尊重她！"
                                },
                                {
                                    "id": "400815007",
                                    "speaker": "派蒙",
                                    "text": "你都没和她说过几句话，根本不了解她吧！我也不了解你，现在我模仿你，只凭你的外表，就猜测你以前是个…"
                                },
                                {
                                    "id": "400815008",
                                    "speaker": "派蒙",
                                    "text": "喝醉了酒以后，嘴上叼着烤焦的蘑菇串，拿着双刀在篝火边跳舞，自己绊倒自己，脸朝下摔个一脸泥巴的笨蛋！"
                                },
                                {
                                    "id": "400815009",
                                    "speaker": "派蒙",
                                    "text": "而且我还到处去和别人说，怎么样？你知道这件事后，难道不会生气吗？"
                                },
                                {
                                    "id": "400815010",
                                    "speaker": "铁骨双刀",
                                    "text": "「白银伴星」！你竟然…竟然猜中了？"
                                },
                                {
                                    "id": "400815011",
                                    "speaker": "派蒙",
                                    "text": "？"
                                },
                                {
                                    "id": "400815012",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "400815013",
                                    "speaker": "铁骨双刀",
                                    "text": "不过，你说的确实有道理…我确实不知道海妮耶大人本来是什么样的人，也许给她凭空增添了不少麻烦…"
                                },
                                {
                                    "id": "400815014",
                                    "speaker": "铁骨双刀",
                                    "text": "我错了，我不该对海妮耶大人妄加评论，我再次向您道歉！",
                                    "choices": [
                                        {
                                            "id": "400815015",
                                            "text": "居然震慑了这个大块头！",
                                            "response": [
                                                {
                                                    "id": "400815017",
                                                    "speaker": "派蒙",
                                                    "text": "喂喂，也不用这么夸张啦…我这一套说法都是向神子和莱依拉学的啦！"
                                                },
                                                {
                                                    "id": "400815018",
                                                    "speaker": "派蒙",
                                                    "text": "反正，你知道自己错了就好，以后千万别再这样了哦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400815016",
                                            "text": "派蒙的气势好强！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400815019",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "400815020",
                                    "speaker": "铁骨双刀",
                                    "text": "再见…我还要好好反省一下…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008156",
            "initDialog": "400815601",
            "dialogues": [
                {
                    "id": "400815601",
                    "speaker": "铁骨双刀",
                    "text": "白白白白白…「白银伴星」大人，请收我为徒吧！",
                    "choices": [
                        {
                            "id": "400815602",
                            "text": "你冷静点！",
                            "response": [
                                {
                                    "id": "400815603",
                                    "speaker": "派蒙",
                                    "text": "对对对，冷静点！你是不是没睡醒，突然说什么怪话啦？"
                                },
                                {
                                    "id": "400815604",
                                    "speaker": "铁骨双刀",
                                    "text": "我是认真的！"
                                },
                                {
                                    "id": "400815605",
                                    "speaker": "铁骨双刀",
                                    "text": "听说你们击败海妮耶大人后，我很震惊，斗胆拜访了海妮耶小姐，得知了你们之间的故事…"
                                },
                                {
                                    "id": "400815606",
                                    "speaker": "铁骨双刀",
                                    "text": "原来我之前错的那么离谱！我一定要悔改！还请「白银伴星」大人为我指引正确的道路！"
                                },
                                {
                                    "id": "400815607",
                                    "speaker": "派蒙",
                                    "text": "#为什么是我啦！明明很多事情都是{NICKNAME}决定的！"
                                },
                                {
                                    "id": "400815608",
                                    "speaker": "铁骨双刀",
                                    "text": "虽然我知道，你们两位一直同心协力，观点也绝对是一致的"
                                },
                                {
                                    "id": "400815609",
                                    "speaker": "铁骨双刀",
                                    "text": "但「黄金流星」大人平常很少发言，高深莫测。就算接受「黄金流星」大人的教导，愚钝的我也未必能理解其中的深意。"
                                },
                                {
                                    "id": "400815610",
                                    "speaker": "铁骨双刀",
                                    "text": "而「白银伴星」大人的发言简单明了，很好懂！所以我想跟着「白银伴星」大人好好学习一番！"
                                },
                                {
                                    "id": "400815611",
                                    "speaker": "派蒙",
                                    "text": "#怎么办，{NICKNAME}？从没见过这样的人，之前还凶巴巴的，现在突然这么激动，根本不知道该怎么应付他。"
                                },
                                {
                                    "id": "400815612",
                                    "speaker": "派蒙",
                                    "text": "我觉得，与其让他学这个学那个， 不如放他自己去思考一会儿。知道自己错了以后，他应该会变得稳重一点！",
                                    "choices": [
                                        {
                                            "id": "400815613",
                                            "text": "那就只有一个办法了…",
                                            "response": [
                                                {
                                                    "id": "400815615",
                                                    "speaker": "派蒙",
                                                    "text": "对喔，我们赶快离这个怪人远一点！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400815614",
                                            "text": "快逃！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400815616",
                            "text": "派蒙，我们快逃！",
                            "response": [
                                {
                                    "id": "400815617",
                                    "speaker": "派蒙",
                                    "text": "不知道发生了什么…但以前从没见过这种场面，我们快逃吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}