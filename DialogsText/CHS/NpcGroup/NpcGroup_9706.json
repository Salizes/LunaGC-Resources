        },
        {
            "talkId": "6970602",
            "initDialog": "697060201",
            "dialogues": [
                {
                    "id": "697060201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6970603",
            "initDialog": "697060301",
            "dialogues": [
                {
                    "id": "697060301",
