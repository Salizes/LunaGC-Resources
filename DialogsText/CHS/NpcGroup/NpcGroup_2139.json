{
    "groupId": "2139",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "阿芷": 7
    },
    "talks": [
        {
            "talkId": "6213901",
            "initDialog": "621390101",
            "dialogues": [
                {
                    "id": "621390101",
                    "speaker": "阿芷",
                    "text": "你好，有什么可以帮到你吗？"
                }
            ]
        },
        {
            "talkId": "6213902",
            "initDialog": "621390201",
            "dialogues": [
                {
                    "id": "621390201",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "621390202",
                    "speaker": "阿芷",
                    "text": "啊，我在背药名。"
                },
                {
                    "id": "621390203",
                    "speaker": "阿芷",
                    "text": "你说上山采药的时候，如果说不上来自己采的是什么药，岂不是闹笑话吗？嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6213903",
            "initDialog": "621390301",
            "dialogues": [
                {
                    "id": "621390301",
                    "speaker": "Player",
                    "text": "你住在这边吗？"
                },
                {
                    "id": "621390302",
                    "speaker": "阿芷",
                    "text": "是啊，别的同龄人大多去璃月港工作或安家了，不过我还是决定留下来。"
                },
                {
                    "id": "621390303",
                    "speaker": "阿芷",
                    "text": "大概因为我长着山民的鼻子吧，习惯不了滨海城市的海风和气味…"
                },
                {
                    "id": "621390304",
                    "speaker": "阿芷",
                    "text": "而且庄里的老人们腿脚不利索了，我总要帮他们采药才行。"
                }
            ]
        },
        {
            "talkId": "6213904",
            "initDialog": "621390401",
            "dialogues": [
                {
                    "id": "621390401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621390402",
                    "speaker": "阿芷",
                    "text": "再见，小心脚下！"
                }
            ]
        }
    ]
}