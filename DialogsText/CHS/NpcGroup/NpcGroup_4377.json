{
    "groupId": "4377",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "拉贾维": 7
    },
    "talks": [
        {
            "talkId": "6437701",
            "initDialog": "643770101",
            "dialogues": [
                {
                    "id": "643770101",
                    "speaker": "拉贾维",
                    "text": "什么时候才能等到呢…那个管家，难道是在敷衍我吗？"
                }
            ]
        },
        {
            "talkId": "6437702",
            "initDialog": "643770201",
            "dialogues": [
                {
                    "id": "643770201",
                    "speaker": "Player",
                    "text": "你在等谁？"
                },
                {
                    "id": "643770202",
                    "speaker": "拉贾维",
                    "text": "我听说这里住着一位富商，便登门拜访。"
                },
                {
                    "id": "643770203",
                    "speaker": "拉贾维",
                    "text": "本想着大家都是成功的生意人，一起互通有无，一定能赚到更多摩拉。"
                },
                {
                    "id": "643770204",
                    "speaker": "拉贾维",
                    "text": "但门口的那个管家啊，无论说什么，都不肯透露他家老爷究竟姓甚名谁，人在哪里。"
                },
                {
                    "id": "643770205",
                    "speaker": "拉贾维",
                    "text": "我每次过去都被他一通绕，然后稀里糊涂地劝回来。"
                },
                {
                    "id": "643770206",
                    "speaker": "拉贾维",
                    "text": "唉…下次，下次一定不能再被他带偏了！"
                }
            ]
        },
        {
            "talkId": "6437703",
            "initDialog": "643770301",
            "dialogues": [
                {
                    "id": "643770301",
                    "speaker": "Player",
                    "text": "说不定是。"
                },
                {
                    "id": "643770302",
                    "speaker": "拉贾维",
                    "text": "可恶，我就知道！"
                }
            ]
        }
    ]
}