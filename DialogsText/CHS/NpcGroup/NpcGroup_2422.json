{
    "groupId": "2422",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "小漫": 12
    },
    "talks": [
        {
            "talkId": "7193601",
            "initDialog": "719360101",
            "dialogues": [
                {
                    "id": "719360101",
                    "speaker": "Player",
                    "text": "这个很辣吗？"
                },
                {
                    "id": "719360102",
                    "speaker": "小漫",
                    "text": "其实很多人都问过这个问题呢！"
                },
                {
                    "id": "719360103",
                    "speaker": "小漫",
                    "text": "我的看法是，百闻…阿嚏——不如一尝！"
                },
                {
                    "id": "719360104",
                    "speaker": "小漫",
                    "text": "所以如果你想试试的话，不如拿去做料理尝尝。"
                }
            ]
        },
        {
            "talkId": "6242201",
            "initDialog": "624220101",
            "dialogues": [
                {
                    "id": "624220101",
                    "speaker": "小漫",
                    "text": "你好，旅行者，来点新摘的绝云椒椒吗？"
                }
            ]
        },
        {
            "talkId": "6242202",
            "initDialog": "624220201",
            "dialogues": [
                {
                    "id": "624220201",
                    "speaker": "Player",
                    "text": "绝云椒椒？"
                },
                {
                    "id": "624220202",
                    "speaker": "小漫",
                    "text": "嗯，绝云间特产的「绝云椒椒」！"
                },
                {
                    "id": "624220203",
                    "speaker": "小漫",
                    "text": "阿…阿…阿嚏——！"
                }
            ]
        },
        {
            "talkId": "6242203",
            "initDialog": "624220301",
            "dialogues": [
                {
                    "id": "624220301",
                    "speaker": "Player",
                    "text": "阿…阿嚏——！"
                },
                {
                    "id": "624220302",
                    "speaker": "小漫",
                    "text": "哈哈哈，还不习惯「绝云椒椒」的辣味吧？"
                },
                {
                    "id": "624220303",
                    "speaker": "小漫",
                    "text": "辣中透鲜，又不上火，这可是资深璃菜大厨的最爱。"
                },
                {
                    "id": "624220304",
                    "speaker": "小漫",
                    "text": "回去再买些胡椒、弄点禽肉，就可以做「香嫩椒椒鸡」给孩子们吃了。"
                },
                {
                    "id": "624220305",
                    "speaker": "Player",
                    "text": "香嫩椒椒鸡？"
                },
                {
                    "id": "624220306",
                    "speaker": "小漫",
                    "text": "嗯，就是把禽肉、胡椒、绝云椒椒等食材一起凉拌的菜，方便又美味。"
                },
                {
                    "id": "624220307",
                    "speaker": "小漫",
                    "text": "绝云椒椒可是其中的精华，缺了辣味，香嫩椒椒鸡可就一点都不香了。"
                }
            ]
        },
        {
            "talkId": "6242204",
            "initDialog": "624220401",
            "dialogues": [
                {
                    "id": "624220401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624220402",
                    "speaker": "小漫",
                    "text": "再见，不带些走吗？"
                }
            ]
        }
    ]
}