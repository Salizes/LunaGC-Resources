    "talks": [
        {
            "talkId": "6244601",
            "initDialog": "624460101",
            "dialogues": [
                {
                    "id": "624460101",
                    "speaker": "李九郎",
                    "text": "这酒甚好，一杯入喉，思如泉涌，诗意大发！"
                }
            ]
        },
        {
            "talkId": "6244602",
            "initDialog": "624460201",
            "dialogues": [
                {
                    "id": "624460201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624460202",
                    "speaker": "李九郎",
                    "text": "在下…李九郎，是个诗人。"
                },
                {
                    "id": "624460203",
                    "speaker": "李九郎",
                    "text": "世人皆说「珠钿舫」上美食好…殊不知，这酒才是一绝啊！"
                },
                {
                    "id": "624460204",
                    "speaker": "李九郎",
                    "text": "纵然品过千杯，依旧意犹未尽，每一杯都是不同的滋味…好酒，好酒啊！"
                }
            ]
        },
        {
            "talkId": "6244603",
            "initDialog": "624460301",
            "dialogues": [
                {
                    "id": "624460301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624460302",
                    "speaker": "李九郎",
                    "text": "得此好酒，夫复何求…"
                }
            ]
        }
    ]
}