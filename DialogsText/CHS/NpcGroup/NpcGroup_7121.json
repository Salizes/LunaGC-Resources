    "talks": [
        {
            "talkId": "6712101",
            "initDialog": "671210101",
            "dialogues": [
                {
                    "id": "671210101",
                    "speaker": "伊卡莱宁",
                    "text": "我得一直盯着传送带，不能分心…"
                }
            ]
        },
        {
            "talkId": "6712102",
            "initDialog": "671210201",
            "dialogues": [
                {
                    "id": "671210201",
                    "speaker": "Player",
                    "text": "关于传送带…"
                },
                {
                    "id": "671210202",
                    "speaker": "伊卡莱宁",
                    "text": "可以说传送带是那夏镇的命脉也不为过！"
                },
                {
                    "id": "671210203",
                    "speaker": "伊卡莱宁",
                    "text": "它从港口一路延伸进来，围绕了这个镇子整整一圈。几乎所有的物资、交易、甚至居民的日常，都离不开它。"
                },
                {
                    "id": "671210204",
                    "speaker": "伊卡莱宁",
                    "text": "最近入港的传送带出了故障，很多货物都堆积在那儿了，甚至不得不靠人力运输，真是辛苦…"
                }
            ]
        },
        {
            "talkId": "6712103",
            "initDialog": "671210301",
            "dialogues": [
                {
                    "id": "671210301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "671210302",
                    "speaker": "伊卡莱宁",
                    "text": "唔，刚才那个货物一晃眼就过去了…是不是有件该卸下来的？"
                }
            ]
        }
    ]
}