{
    "groupId": "9577",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "希格雯": 10
    },
    "talks": [
        {
            "talkId": "6957701",
            "initDialog": "695770101",
            "dialogues": [
                {
                    "id": "695770101",
                    "speaker": "希格雯",
                    "text": "大家玩牌的时候，面部肌肉一会儿紧绷，一会儿松弛…变化的过程很有趣哟。"
                }
            ]
        },
        {
            "talkId": "6957702",
            "initDialog": "695770201",
            "dialogues": [
                {
                    "id": "695770201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957703",
            "initDialog": "695770301",
            "dialogues": [
                {
                    "id": "695770301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695770302",
                    "speaker": "希格雯",
                    "text": "再见，我稍后也会回去。不过…我有点担心一直在这里玩牌的人，他们需不需要一点镇定类的药物呢？"
                }
            ]
        },
        {
            "talkId": "6957704",
            "initDialog": "695770401",
            "dialogues": [
                {
                    "id": "695770401",
                    "speaker": "希格雯",
                    "text": "这一局是我赢啦。好了，别再回忆自己的出牌方式了，上一局游戏结束啦，如果你愿意的话，我可以陪你再来一局喔。"
                }
            ]
        },
        {
            "talkId": "6957705",
            "initDialog": "695770501",
            "dialogues": [
                {
                    "id": "695770501",
                    "speaker": "希格雯",
                    "text": "很不错，思路很清晰，判断也很准确…想要再来一局？好吧，但你也不能一直玩牌喔，也要注意休息才行。"
                }
            ]
        },
        {
            "talkId": "6957706",
            "initDialog": "695770601",
            "dialogues": [
                {
                    "id": "695770601",
                    "speaker": "希格雯",
                    "text": "要和我玩一局牌？好呀，但玩的时候可要放平心态，不要给自己太大压力喔。"
                }
            ]
        },
        {
            "talkId": "6957708",
            "initDialog": "695770801",
            "dialogues": [
                {
                    "id": "695770801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957709",
            "initDialog": "695770901",
            "dialogues": [
                {
                    "id": "695770901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957710",
            "initDialog": "695771001",
            "dialogues": [
                {
                    "id": "695771001",
                    "speaker": "希格雯",
                    "text": "呼…我的心都怦怦跳了，还好赢下来了，真不容易啊。"
                }
            ]
        },
        {
            "talkId": "6957711",
            "initDialog": "695771101",
            "dialogues": [
                {
                    "id": "695771101",
                    "speaker": "希格雯",
                    "text": "是你赢啦。现在就不用控制笑肌啦，你笑起来很好看的。"
                }
            ]
        },
        {
            "talkId": "6957712",
            "initDialog": "695771201",
            "dialogues": [
                {
                    "id": "695771201",
                    "speaker": "希格雯",
                    "text": "那就再来一局吧。开始之前，先跟着我一起…吸气…放松，不要太紧张哟。"
                }
            ]
        },
        {
            "talkId": "6957714",
            "initDialog": "695771401",
            "dialogues": [
                {
                    "id": "695771401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957715",
            "initDialog": "695771501",
            "dialogues": [
                {
                    "id": "695771501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957716",
            "initDialog": "695771601",
            "dialogues": [
                {
                    "id": "695771601",
                    "speaker": "希格雯",
                    "text": "别这么沮丧呀，心情放轻松，这只是一场游戏…如果你愿意的话，我们就再来玩一局吧。"
                }
            ]
        },
        {
            "talkId": "6957717",
            "initDialog": "695771701",
            "dialogues": [
                {
                    "id": "695771701",
                    "speaker": "希格雯",
                    "text": "哎呀！小心点，再开心也不能这样跳起来呀，膝盖磕得痛吗？让我看看…"
                }
            ]
        },
        {
            "talkId": "6957718",
            "initDialog": "695771801",
            "dialogues": [
                {
                    "id": "695771801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}