{
    "groupId": "4208",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "兰梨娄": 7,
        "兰难世": 12
    },
    "talks": [
        {
            "talkId": "6420901",
            "initDialog": "642090101",
            "dialogues": [
                {
                    "id": "642090101",
                    "speaker": "兰难世",
                    "text": "兰梨娄！下一次比试，我要像雨水藏在河流里一样。"
                },
                {
                    "id": "642090102",
                    "speaker": "兰难世",
                    "text": "兰梨娄没有办法从河流里找到雨水，一定会输！"
                },
                {
                    "id": "642090103",
                    "speaker": "兰梨娄",
                    "text": "兰难世是笨蛋，雨水不一定都会落到河流，还会被树叶拦下，被花朵拦下。"
                },
                {
                    "id": "642090104",
                    "speaker": "兰梨娄",
                    "text": "兰难世会是落在树叶上的雨水一样，兰梨娄一下就能看见。"
                },
                {
                    "id": "642090105",
                    "speaker": "兰难世",
                    "text": "那…那我就要像土壤里的种子。"
                },
                {
                    "id": "642090106",
                    "speaker": "兰梨娄",
                    "text": "唔…兰梨娄要想想怎么找，但是兰难世一定会输！"
                }
            ]
        },
        {
            "talkId": "6420902",
            "initDialog": "642090201",
            "dialogues": [
                {
                    "id": "642090201",
                    "speaker": "兰难世",
                    "text": "输给了金色那菈，可是很快乐。"
                },
                {
                    "id": "642090202",
                    "speaker": "兰难世",
                    "text": "可是不想一直输，所以想去找小那菈锻炼兰迦拉梨…这样就不会被找到了。"
                },
                {
                    "id": "642090203",
                    "speaker": "兰梨娄",
                    "text": "兰难世弱，小那菈肯定不愿意和兰难世一起玩。"
                },
                {
                    "id": "642090204",
                    "speaker": "兰难世",
                    "text": "兰梨娄输给了金色那菈，兰梨娄也一样弱。"
                },
                {
                    "id": "642090205",
                    "speaker": "兰难世",
                    "text": "可是金色那菈和弱弱的兰梨娄一起玩还是很开心。"
                },
                {
                    "id": "642090206",
                    "speaker": "兰难世",
                    "text": "小那菈也一定会愿意和兰难世和兰梨娄一起玩游戏的。"
                },
                {
                    "id": "642090207",
                    "speaker": "兰梨娄",
                    "text": "唔…兰难世没有错，那么，一起去找小那菈。"
                },
                {
                    "id": "642090208",
                    "speaker": "兰难世",
                    "text": "好，一起去。"
                }
            ]
        },
        {
            "talkId": "6420903",
            "initDialog": "642090301",
            "dialogues": [
                {
                    "id": "642090301",
                    "speaker": "兰难世",
                    "text": "兰梨娄最后输了几次？是不是兰难世赢了？"
                },
                {
                    "id": "642090302",
                    "speaker": "兰梨娄",
                    "text": "比试了好多次，谁输谁赢，不知道了！"
                },
                {
                    "id": "642090303",
                    "speaker": "兰难世",
                    "text": "嗯？算了！无忧节过得开心，比输赢重要。"
                },
                {
                    "id": "642090304",
                    "speaker": "兰梨娄",
                    "text": "兰难世…说得有道理！"
                },
                {
                    "id": "642090305",
                    "speaker": "兰难世",
                    "text": "兰难世和兰梨娄都赢，赢两次。所有兰那罗，还有兰那罗的朋友，都赢了，赢很多次！"
                }
            ]
        }
    ]
}