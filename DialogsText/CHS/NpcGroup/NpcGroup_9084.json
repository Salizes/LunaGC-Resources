{
    "groupId": "9084",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 18,
        "林尼": 48
    },
    "talks": [
        {
            "talkId": "6908401",
            "initDialog": "690840101",
            "dialogues": [
                {
                    "id": "690840101",
                    "speaker": "林尼",
                    "text": "#嘿，{NICKNAME}。"
                },
                {
                    "id": "690840102",
                    "speaker": "林尼",
                    "text": "我就知道你会在这个时候出现！"
                }
            ]
        },
        {
            "talkId": "6908402",
            "initDialog": "690840201",
            "dialogues": [
                {
                    "id": "690840201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690840202",
                    "speaker": "林尼",
                    "text": "你的家真厉害！即使是我这样的大魔术师，都可以说闻所未闻，见所未见！"
                },
                {
                    "id": "690840203",
                    "speaker": "林尼",
                    "text": "但要是我说，我已经完全适应了…你会不会觉得我在撒谎？",
                    "choices": [
                        {
                            "id": "690840204",
                            "text": "不像真的。",
                            "response": [
                                {
                                    "id": "690840205",
                                    "speaker": "林尼",
                                    "text": "这回答可真让人伤心啊——"
                                },
                                {
                                    "id": "690840206",
                                    "speaker": "林尼",
                                    "text": "不过，确实是真话哦。"
                                },
                                {
                                    "id": "690840207",
                                    "speaker": "林尼",
                                    "text": "看来，我要在这里多待上一段时间了！毕竟，只有通过时间才能让你重新相信我嘛。"
                                },
                                {
                                    "id": "690840208",
                                    "speaker": "林尼",
                                    "text": "可别赶我走哦？"
                                }
                            ]
                        },
                        {
                            "id": "690840209",
                            "text": "我相信你。",
                            "response": [
                                {
                                    "id": "690840210",
                                    "speaker": "林尼",
                                    "text": "嘿嘿，很荣幸能获得你的信任。"
                                },
                                {
                                    "id": "690840211",
                                    "speaker": "林尼",
                                    "text": "面对你，我总是没法编出谎话…可能是不想看到你受伤的表情吧。"
                                },
                                {
                                    "id": "690840212",
                                    "speaker": "林尼",
                                    "text": "咳咳，言归正传！既然你这么关心我，一定希望我再多待会儿吧？"
                                },
                                {
                                    "id": "690840213",
                                    "speaker": "林尼",
                                    "text": "那就请你好好招待我了哦？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908403",
            "initDialog": "690840301",
            "dialogues": [
                {
                    "id": "690840301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690840302",
                    "speaker": "林尼",
                    "text": "好呀，那你先来看看我的帽子，注意到了吗，它与平时有什么不同？"
                },
                {
                    "id": "690840303",
                    "speaker": "Player",
                    "text": "好像没什么区别。"
                },
                {
                    "id": "690840304",
                    "speaker": "林尼",
                    "text": "观察得不够仔细，再看看？靠近点看看。"
                },
                {
                    "id": "690840305",
                    "speaker": "Player",
                    "text": "好吧。"
                },
                {
                    "id": "690840306",
                    "speaker": "林尼",
                    "text": "有结论了吗？花纹还是颜色？你应该见过它不少次了吧。",
                    "choices": [
                        {
                            "id": "690840307",
                            "text": "还是没看出来。",
                            "response": [
                                {
                                    "id": "690840308",
                                    "speaker": "林尼",
                                    "text": "哎呀，真可惜…但结论没错。"
                                },
                                {
                                    "id": "690840311",
                                    "speaker": "林尼",
                                    "text": "我刚刚玩了一个小小的把戏，偷走了你的一件东西，又将一张卡牌放进了你的包里。"
                                },
                                {
                                    "id": "690840312",
                                    "speaker": "林尼",
                                    "text": "要来猜猜看我偷走的是什么东西吗？",
                                    "choices": [
                                        {
                                            "id": "690840313",
                                            "text": "钱包？",
                                            "response": [
                                                {
                                                    "id": "690840314",
                                                    "speaker": "林尼",
                                                    "text": "哈哈，我可真是个见钱眼开的小偷，难怪能弄来很多钱呢！"
                                                },
                                                {
                                                    "id": "690840315",
                                                    "speaker": "林尼",
                                                    "text": "但正确答案是「注意力」，比钱更有价值！"
                                                },
                                                {
                                                    "id": "690840321",
                                                    "speaker": "林尼",
                                                    "text": "了解并熟练掌握这一点，勤加练习手法，你也能成为优秀的魔术师哦！"
                                                },
                                                {
                                                    "id": "690840322",
                                                    "speaker": "林尼",
                                                    "text": "…好了，现在把卡牌还给我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690840316",
                                            "text": "心？",
                                            "response": [
                                                {
                                                    "id": "690840317",
                                                    "speaker": "林尼",
                                                    "text": "真是个意想不到的回答，我的心跳都要跟着加速了呢。"
                                                },
                                                {
                                                    "id": "690840318",
                                                    "speaker": "林尼",
                                                    "text": "但正确答案是「注意力」，虽然没有「心」那么有价值，但对魔术师来说很重要！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690840319",
                                            "text": "注意力？",
                                            "response": [
                                                {
                                                    "id": "690840320",
                                                    "speaker": "林尼",
                                                    "text": "敏捷的思维，真厉害，回答正确！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690840309",
                            "text": "是大小吗？",
                            "response": [
                                {
                                    "id": "690840310",
                                    "speaker": "林尼",
                                    "text": "很遗憾，我故意误导了你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908404",
            "initDialog": "690840401",
            "dialogues": [
                {
                    "id": "690840401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690840402",
                    "speaker": "林尼",
                    "text": "有一件事情，我想征询你这位主人的意见。"
                },
                {
                    "id": "690840403",
                    "speaker": "Player",
                    "text": "怎么了？那么正式…"
                },
                {
                    "id": "690840404",
                    "speaker": "林尼",
                    "text": "我看这里环境舒适惬意，安全性也无可挑剔，似乎很适合饲养动物。",
                    "choices": [
                        {
                            "id": "690840405",
                            "text": "嗯，我养了一些。",
                            "response": [
                                {
                                    "id": "690840406",
                                    "speaker": "林尼",
                                    "text": "不瞒你说，我已经和它们礼貌地打过招呼了。"
                                },
                                {
                                    "id": "690840407",
                                    "speaker": "林尼",
                                    "text": "当然…既没有直接触碰，也没有投喂我自带的食物，这些还是得到你许可后再说比较好。"
                                },
                                {
                                    "id": "690840411",
                                    "speaker": "Player",
                                    "text": "总觉得你今天特别真诚啊…"
                                },
                                {
                                    "id": "690840412",
                                    "speaker": "林尼",
                                    "text": "哈哈，难道是我平时的作风太张扬，给你留下了片面的印象？"
                                },
                                {
                                    "id": "690840413",
                                    "speaker": "林尼",
                                    "text": "那我可得好好反思自己啦。"
                                },
                                {
                                    "id": "690840414",
                                    "speaker": "林尼",
                                    "text": "总之…我想给我的动物助手们找到个温馨、自由而又和平的家。"
                                },
                                {
                                    "id": "690840415",
                                    "speaker": "林尼",
                                    "text": "衣食无忧…还能够享受关爱，得到良好的照顾…"
                                },
                                {
                                    "id": "690840416",
                                    "speaker": "林尼",
                                    "text": "坦白说，这里是我能想到的最佳选择。但我不想因此而给你压力，或是用一些花言巧语的手段达成目的…"
                                },
                                {
                                    "id": "690840417",
                                    "speaker": "林尼",
                                    "text": "要是你发自内心地愿意收留它们的话，那就再好不过了。"
                                }
                            ]
                        },
                        {
                            "id": "690840408",
                            "text": "我没有什么饲养经验…",
                            "response": [
                                {
                                    "id": "690840409",
                                    "speaker": "林尼",
                                    "text": "没关系。只要你对这件事不反感，我愿意和你分享所有我了解的知识。"
                                },
                                {
                                    "id": "690840410",
                                    "speaker": "林尼",
                                    "text": "如果你有所顾虑，我自然也会尊重你的想法。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908405",
            "initDialog": "690840501",
            "dialogues": [
                {
                    "id": "690840501",
                    "speaker": "Player",
                    "text": "早啊，林尼。"
                },
                {
                    "id": "690840502",
                    "speaker": "林尼",
                    "text": "#你好，{NICKNAME}。"
                },
                {
                    "id": "690840503",
                    "speaker": "林尼",
                    "text": "真希望每天早上都能看见你。"
                }
            ]
        },
        {
            "talkId": "6908406",
            "initDialog": "690840601",
            "dialogues": [
                {
                    "id": "690840601",
                    "speaker": "Player",
                    "text": "晚安，林尼。"
                },
                {
                    "id": "690840602",
                    "speaker": "林尼",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690840603",
                    "speaker": "林尼",
                    "text": "万一睡不着的话，我可以陪你数猫。"
                }
            ]
        },
        {
            "talkId": "6908410",
            "initDialog": "690841001",
            "dialogues": [
                {
                    "id": "690841001",
                    "speaker": "林尼",
                    "text": "你竟然专门收集了这种样式的桌椅！我很喜欢哦。纹路和色调，真让人怀念。"
                },
                {
                    "id": "690841002",
                    "speaker": "林尼",
                    "text": "它让我想起了小时候和琳妮特一起在街头表演的日子——就像这样，摸摸你的口袋。"
                },
                {
                    "id": "690841003",
                    "speaker": "林尼",
                    "text": "哈哈，看你的眼神，果然已经猜出来了呢——就是趁你的注意力被转移到桌椅上时动的手脚哦。"
                }
            ]
        },
        {
            "talkId": "6908411",
            "initDialog": "690841101",
            "dialogues": [
                {
                    "id": "690841101",
                    "speaker": "林尼",
                    "text": "专门进行了如此精致的舞台布置，看来你期待着一场精彩的表演呢。"
                },
                {
                    "id": "690841102",
                    "speaker": "林尼",
                    "text": "让我们猜一猜，全提瓦特最棒的大魔术师该不会正好有档期吧？"
                },
                {
                    "id": "690841103",
                    "speaker": "林尼",
                    "text": "不要担心，哪怕只有你一个观众，演出也将如期举行哦。"
                }
            ]
        }
    ]
}