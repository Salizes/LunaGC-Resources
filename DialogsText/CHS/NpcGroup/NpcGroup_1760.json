{
    "groupId": "1760",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "莱纳斯": 14
    },
    "talks": [
        {
            "talkId": "6176001",
            "initDialog": "617600101",
            "dialogues": [
                {
                    "id": "617600101",
                    "speaker": "莱纳斯",
                    "text": "孤独的帆儿闪着白光…"
                }
            ]
        },
        {
            "talkId": "6176002",
            "initDialog": "617600201",
            "dialogues": [
                {
                    "id": "617600201",
                    "speaker": "莱纳斯",
                    "text": "您的香氛…真是特别呢。每种香气的平衡，把握得堪称绝妙，就像是美妙的协奏曲…"
                }
            ]
        },
        {
            "talkId": "6176003",
            "initDialog": "617600301",
            "dialogues": [
                {
                    "id": "617600301",
                    "speaker": "Player",
                    "text": "你是吟游诗人？"
                },
                {
                    "id": "617600302",
                    "speaker": "莱纳斯",
                    "text": "呵呵，没错。不知道您有什么想听的曲子呢？"
                }
            ]
        },
        {
            "talkId": "6176004",
            "initDialog": "617600401",
            "dialogues": [
                {
                    "id": "617600401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617600402",
                    "speaker": "莱纳斯",
                    "text": "愿风指引您的道路。"
                }
            ]
        },
        {
            "talkId": "6176005",
            "initDialog": "617600501",
            "dialogues": [
                {
                    "id": "617600501",
                    "speaker": "Player",
                    "text": "有没有关于花的曲子？"
                },
                {
                    "id": "617600502",
                    "speaker": "莱纳斯",
                    "text": "无论是早春荒地的丁香、轻眠在冻土中的希望，还是夏日绽放的繁花、暖风中的欢歌，都是经久不衰的诗题。让我选一首…"
                },
                {
                    "id": "617600503",
                    "speaker": "莱纳斯",
                    "text": "「…五月天，无吝悭，赐欢颜，以此祛忧烦。春光复归，原野间，信可见，花争艳…」"
                },
                {
                    "id": "617600504",
                    "speaker": "莱纳斯",
                    "text": "「…蛰虫始振，百鸟争鸣，林峦尽欢声。唯我忆暮冬之寒，歌阒然…」"
                }
            ]
        },
        {
            "talkId": "6176006",
            "initDialog": "617600601",
            "dialogues": [
                {
                    "id": "617600601",
                    "speaker": "Player",
                    "text": "有没有关于春天的曲子？"
                },
                {
                    "id": "617600602",
                    "speaker": "莱纳斯",
                    "text": "春天的曲子有很多。毕竟，冬日的旅人总会等来心中恋慕的马车，载着春天摇摇晃晃。让我选一首…"
                },
                {
                    "id": "617600603",
                    "speaker": "莱纳斯",
                    "text": "「…羊群离开草地，唯余一片青绿。可百花很快又会盛开，春景又会如乐园美丽…」"
                },
                {
                    "id": "617600604",
                    "speaker": "莱纳斯",
                    "text": "「…绽放的水仙花，已在园中列成一排。好心的人儿也许知晓，它们列队等待谁来…」"
                }
            ]
        },
        {
            "talkId": "6176007",
            "initDialog": "617600701",
            "dialogues": [
                {
                    "id": "617600701",
                    "speaker": "Player",
                    "text": "唱首你最喜欢的曲子吧。"
                },
                {
                    "id": "617600702",
                    "speaker": "莱纳斯",
                    "text": "我最喜欢的…嗯，是关于爱情的诗歌吧。日落与诗集，还有仲夏时盐与柠檬的香气…"
                },
                {
                    "id": "617600703",
                    "speaker": "莱纳斯",
                    "text": "只可惜，埃尔西小姐连这样的比喻都听不懂呢。"
                },
                {
                    "id": "617600704",
                    "speaker": "莱纳斯",
                    "text": "「…我将不再按她的方式歌唱，若我能得到我所祈求的安宁，若有人能予我慰藉…」"
                },
                {
                    "id": "617600705",
                    "speaker": "莱纳斯",
                    "text": "「…这就是我的哀叹，日复一日，我却缄默不言。请让我留在你那目光的幻影里吧！爱的一瞥，便能令我迷失狂乱…」"
                }
            ]
        }
    ]
}