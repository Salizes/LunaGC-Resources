{
    "groupId": "7070",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "朗格马克": 9
    },
    "talks": [
        {
            "talkId": "6707001",
            "initDialog": "670700101",
            "dialogues": [
                {
                    "id": "670700101",
                    "speaker": "朗格马克",
                    "text": "这台升降机，可是参考了海露港的那台设计的！"
                }
            ]
        },
        {
            "talkId": "6707002",
            "initDialog": "670700201",
            "dialogues": [
                {
                    "id": "670700201",
                    "speaker": "Player",
                    "text": "关于升降机…"
                },
                {
                    "id": "670700202",
                    "speaker": "朗格马克",
                    "text": "不知道您有没有去过枫丹？无论是海露港还是柔灯港，都安装了足以运输超重型舰船的大升降机。"
                },
                {
                    "id": "670700203",
                    "speaker": "朗格马克",
                    "text": "那可谓是工程学的奇迹…我这台小家伙当然没法和它们相比，无论是规模还是精密程度都差远了。"
                },
                {
                    "id": "670700204",
                    "speaker": "朗格马克",
                    "text": "不过嘛，能在那夏镇也造出这些能稳定运行的升降机，也够我吹嘘一阵子了。毕竟不是人人都有吉约丹那样的才能啊。"
                },
                {
                    "id": "670700205",
                    "speaker": "朗格马克",
                    "text": "只是像这样模仿一点皮毛，就几乎耗尽了我的全部知识和积蓄。但那也值得…那也值得呀！"
                }
            ]
        },
        {
            "talkId": "6707003",
            "initDialog": "670700301",
            "dialogues": [
                {
                    "id": "670700301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "670700302",
                    "speaker": "朗格马克",
                    "text": "嗯，好的。需要搭乘升降机的话随时都可以。"
                }
            ]
        },
        {
            "talkId": "6707004",
            "initDialog": "670700401",
            "dialogues": [
                {
                    "id": "670700401",
                    "speaker": "Player",
                    "text": "吉约丹？"
                },
                {
                    "id": "670700402",
                    "speaker": "朗格马克",
                    "text": "您没听过阿兰·吉约丹的名字吗？他是几百年前的大工程师，也是枫丹科学院的创始人，那些升降机就是根据他的图纸建造的。"
                },
                {
                    "id": "670700403",
                    "speaker": "朗格马克",
                    "text": "只可惜呀，像那样的天才，既没有孩子，也没有亲近的朋友，据说有些重要的研究成果还在他去世后失窃了。"
                },
                {
                    "id": "670700404",
                    "speaker": "朗格马克",
                    "text": "唉，到底是什么样的人才会去偷研究手稿呢…"
                }
            ]
        }
    ]
}