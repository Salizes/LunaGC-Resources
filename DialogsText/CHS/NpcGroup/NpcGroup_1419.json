{
    "groupId": "1419",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "莎拉": 18
    },
    "talks": [
        {
            "talkId": "7090301",
            "initDialog": "709030101",
            "dialogues": [
                {
                    "id": "709030101",
                    "speaker": "Player",
                    "text": "最近有什么活动吗？"
                },
                {
                    "id": "709030102",
                    "speaker": "莎拉",
                    "text": "最近正好有沙拉的试吃活动呢。"
                },
                {
                    "id": "709030103",
                    "speaker": "莎拉",
                    "text": "请拿好，如果喜欢的话欢迎再来哦。"
                }
            ]
        },
        {
            "talkId": "40163",
            "initDialog": "4015141901",
            "dialogues": [
                {
                    "id": "4015141901",
                    "speaker": "莎拉",
                    "text": "欢迎光临「猎鹿人」餐馆，您好您好，请问几位？"
                }
            ]
        },
        {
            "talkId": "41701",
            "initDialog": "4015141902",
            "dialogues": [
                {
                    "id": "4015141902",
                    "speaker": "莎拉",
                    "text": "吃的可以打包吗？"
                },
                {
                    "id": "4015141906",
                    "speaker": "莎拉",
                    "text": "没问题，请先看看菜单！"
                }
            ]
        },
        {
            "talkId": "41702",
            "initDialog": "4015141916",
            "dialogues": [
                {
                    "id": "4015141916",
                    "speaker": "Player",
                    "text": "想了解些事情。"
                },
                {
                    "id": "4015141917",
                    "speaker": "莎拉",
                    "text": "哦？有什么可以帮您的呢？"
                }
            ]
        },
        {
            "talkId": "41703",
            "initDialog": "4015141905",
            "dialogues": [
                {
                    "id": "4015141905",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "4015141915",
                    "speaker": "莎拉",
                    "text": "您客气了，请记得「猎鹿人」招牌，欢迎您下次光临。"
                }
            ]
        },
        {
            "talkId": "41717",
            "initDialog": "4015141903",
            "dialogues": [
                {
                    "id": "4015141903",
                    "speaker": "Player",
                    "text": "「猎鹿人」是…"
                },
                {
                    "id": "4015141907",
                    "speaker": "莎拉",
                    "text": "这儿是全蒙德最地道的餐馆——猎鹿人！主打菜肴是「七分熟鹿排」和「满足沙拉」。"
                },
                {
                    "id": "4015141908",
                    "speaker": "莎拉",
                    "text": "我们跟清泉镇的猎户是有长期食材供应关系的。"
                },
                {
                    "id": "4015141909",
                    "speaker": "莎拉",
                    "text": "所有食材都是当日运输，确保绝对新鲜！"
                },
                {
                    "id": "4015141910",
                    "speaker": "莎拉",
                    "text": "要不客人您先看看菜单，我再给您详细推荐一下？"
                }
            ]
        },
        {
            "talkId": "41718",
            "initDialog": "4015141904",
            "dialogues": [
                {
                    "id": "4015141904",
                    "speaker": "Player",
                    "text": "说说蒙德城吧？"
                },
                {
                    "id": "4015141911",
                    "speaker": "莎拉",
                    "text": "看您的面孔，应该是旅行者吧？"
                },
                {
                    "id": "4015141912",
                    "speaker": "莎拉",
                    "text": "蒙德的确是一个很适合旅游的城市。"
                },
                {
                    "id": "4015141913",
                    "speaker": "莎拉",
                    "text": "这里气候宜人，水质上佳，孕育了全提瓦特出了名好吃的苹果。"
                },
                {
                    "id": "4015141914",
                    "speaker": "莎拉",
                    "text": "啊…我们店的「满足沙拉」用的就是纯正的蒙德苹果哦，您要来尝尝看吗？"
                }
            ]
        },
        {
            "talkId": "6141901",
            "initDialog": "614190101",
            "dialogues": [
                {
                    "id": "614190101",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614190102",
                    "speaker": "莎拉",
                    "text": "唉，自从风魔龙出现后，大家都没心情吃饭了，生意比以前差了很多。"
                },
                {
                    "id": "614190103",
                    "speaker": "莎拉",
                    "text": "即便是来用餐的客人，也总是唉声叹气的…"
                },
                {
                    "id": "614190104",
                    "speaker": "莎拉",
                    "text": "…不过这也很正常吧，只能希望龙灾尽快结束了。"
                }
            ]
        }
    ]
}