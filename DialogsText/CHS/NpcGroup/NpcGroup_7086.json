{
    "groupId": "7086",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 7,
        "海德薇卡": 16,
        "雅珂达": 5
    },
    "talks": [
        {
            "talkId": "6708601",
            "initDialog": "670860101",
            "dialogues": [
                {
                    "id": "670860101",
                    "speaker": "海德薇卡",
                    "text": "等等，刚才的进展到哪了？好像是…"
                }
            ]
        },
        {
            "talkId": "6708602",
            "initDialog": "670860201",
            "dialogues": [
                {
                    "id": "670860201",
                    "speaker": "Player",
                    "text": "我需要一些钓鱼用品。"
                },
                {
                    "id": "670860202",
                    "speaker": "海德薇卡",
                    "text": "哦哦好的，请随意看看吧。"
                }
            ]
        },
        {
            "talkId": "6708603",
            "initDialog": "670860301",
            "dialogues": [
                {
                    "id": "670860301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "670860302",
                    "speaker": "海德薇卡",
                    "text": "钓鱼爱好者之一罢了，最多算狂热喜欢的那一批吧。"
                }
            ]
        },
        {
            "talkId": "6708604",
            "initDialog": "670860401",
            "dialogues": [
                {
                    "id": "670860401",
                    "speaker": "Player",
                    "text": "什么进展？"
                },
                {
                    "id": "670860402",
                    "speaker": "海德薇卡",
                    "text": "咳咳，没什么，只是在钓鱼时的大部分时间都会有点儿无聊，所以我会花点时间想些好玩的…"
                },
                {
                    "id": "670860403",
                    "speaker": "海德薇卡",
                    "text": "啊，就是刚好想到了——是水池里的鱼开心，还是海里游着的鱼开心？"
                },
                {
                    "id": "670860404",
                    "speaker": "海德薇卡",
                    "text": "你说呢？水池小但相对更安全，大海辽阔但危机四伏…"
                }
            ]
        },
        {
            "talkId": "6708605",
            "initDialog": "670860501",
            "dialogues": [
                {
                    "id": "670860501",
                    "speaker": "Player",
                    "text": "再见，你慢慢想吧。"
                },
                {
                    "id": "670860502",
                    "speaker": "海德薇卡",
                    "text": "好的，唉，下次真是该带个小本子记下，这样就不用再从头想起了…"
                }
            ]
        },
        {
            "talkId": "6708606",
            "initDialog": "670860601",
            "dialogues": [
                {
                    "id": "670860601",
                    "speaker": "Player",
                    "text": "这怕是要当事鱼才能知道吧…"
                },
                {
                    "id": "670860602",
                    "speaker": "海德薇卡",
                    "text": "啊…确实，可惜我不懂鱼语，不然采访一下它们就能知道啦。"
                }
            ]
        },
        {
            "talkId": "6708607",
            "initDialog": "670860701",
            "dialogues": [
                {
                    "id": "670860701",
                    "speaker": "Player",
                    "text": "不同的鱼有不同的想法。"
                },
                {
                    "id": "670860702",
                    "speaker": "海德薇卡",
                    "text": "是我狭隘了，唉，或许它们都不快乐呢？"
                }
            ]
        },
        {
            "talkId": "6708608",
            "initDialog": "670860801",
            "dialogues": [
                {
                    "id": "670860801",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>雅珂达</color>似乎有所思考…）"
                },
                {
                    "id": "670860802",
                    "speaker": "雅珂达",
                    "text": "海德薇卡小姐，上次你拜托我们采购的鱼竿，用着还好么？"
                },
                {
                    "id": "670860803",
                    "speaker": "海德薇卡",
                    "text": "哎呀，雅珂达小姐，上次真是多谢你们了，这鱼竿用着很好，我钓上来好多鱼！"
                },
                {
                    "id": "670860804",
                    "speaker": "海德薇卡",
                    "text": "你想试试吗？我刚调好了一盒很棒的鱼饵，肯定能轻松诱到大鱼。"
                },
                {
                    "id": "670860805",
                    "speaker": "雅珂达",
                    "text": "真的？嘿嘿，那我来试试，正好我也想学习一下钓鱼。"
                },
                {
                    "id": "670860806",
                    "speaker": "海德薇卡",
                    "text": "没问题，稍等一下，我去拿点资料给你…"
                },
                {
                    "id": "670860807",
                    "speaker": "雅珂达",
                    "text": "对了，海德薇卡小姐，钓一条鱼，大概要花多长时间？"
                },
                {
                    "id": "670860808",
                    "speaker": "海德薇卡",
                    "text": "我没有注意过欸…有时候钓着钓着，一下午就过去了。"
                },
                {
                    "id": "670860809",
                    "speaker": "雅珂达",
                    "text": "啊？那鱼上钩的时候，你总会留意吧？"
                },
                {
                    "id": "670860810",
                    "speaker": "海德薇卡",
                    "text": "没有啊，一下午都没有鱼上钩也很正常。"
                },
                {
                    "id": "670860811",
                    "speaker": "海德薇卡",
                    "text": "比起「把鱼钓上来」，我更享受「钓鱼的过程」…"
                },
                {
                    "id": "670860812",
                    "speaker": "海德薇卡",
                    "text": "欸！雅珂达小姐，你别走呀，我刚找到资料了。"
                },
                {
                    "id": "670860813",
                    "speaker": "雅珂达",
                    "text": "那个…我、我突然想到有事要办，先走了——"
                }
            ]
        }
    ]
}