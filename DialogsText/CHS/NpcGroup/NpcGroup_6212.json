{
    "groupId": "6212",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "赫瓦特莉": 9
    },
    "talks": [
        {
            "talkId": "6621201",
            "initDialog": "662120101",
            "dialogues": [
                {
                    "id": "662120101",
                    "speaker": "赫瓦特莉",
                    "text": "你好，呃…现在是什么时候？中午？还是晚上？"
                }
            ]
        },
        {
            "talkId": "6621202",
            "initDialog": "662120201",
            "dialogues": [
                {
                    "id": "662120201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "662120202",
                    "speaker": "赫瓦特莉",
                    "text": "抱歉抱歉，让我先看看周围…哦哦，原来都这个时间了啊。"
                },
                {
                    "id": "662120203",
                    "speaker": "赫瓦特莉",
                    "text": "咳咳，不用担心，我已经完全清醒了！刚刚，刚刚只是在冥想而已！"
                },
                {
                    "id": "662120204",
                    "speaker": "赫瓦特莉",
                    "text": "我喜欢天空。太阳，月亮，以及群星的位置，可不像汤里的颗粒果那么散漫。"
                },
                {
                    "id": "662120205",
                    "speaker": "赫瓦特莉",
                    "text": "当然，我也听说过有人喜欢用喝完的茶叶或者咖啡渣占卜，呵呵…听起来像小孩的玩具呢。"
                }
            ]
        },
        {
            "talkId": "6621203",
            "initDialog": "662120301",
            "dialogues": [
                {
                    "id": "662120301",
                    "speaker": "Player",
                    "text": "看看天上。"
                },
                {
                    "id": "662120302",
                    "speaker": "赫瓦特莉",
                    "text": "对，当然，天空会告诉我们一切。"
                }
            ]
        },
        {
            "talkId": "6621204",
            "initDialog": "662120401",
            "dialogues": [
                {
                    "id": "662120401",
                    "speaker": "Player",
                    "text": "至少茶和咖啡应该挺好喝吧。"
                },
                {
                    "id": "662120402",
                    "speaker": "赫瓦特莉",
                    "text": "哦，这个当然，我也喜欢，而且还提神。"
                },
                {
                    "id": "662120403",
                    "speaker": "赫瓦特莉",
                    "text": "啊…哈欠…哎哟，说到这个，我好像又困了…"
                },
                {
                    "id": "662120404",
                    "speaker": "赫瓦特莉",
                    "text": "哦不，我是说，我又该冥想了。有机会再聊吧，再见！"
                }
            ]
        }
    ]
}