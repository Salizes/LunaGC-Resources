{
    "groupId": "4096",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Player": 12,
        "希忒": 37
    },
    "talks": [
        {
            "talkId": "6409601",
            "initDialog": "640960101",
            "dialogues": [
                {
                    "id": "640960101",
                    "speaker": "希忒",
                    "text": "欢迎来到教令院。"
                }
            ]
        },
        {
            "talkId": "6409602",
            "initDialog": "640960201",
            "dialogues": [
                {
                    "id": "640960201",
                    "speaker": "Player",
                    "text": "关于教令院…"
                },
                {
                    "id": "640960202",
                    "speaker": "希忒",
                    "text": "教令院中包含六大学派，分别依托于六大学院，在教令院拥有永久教席。"
                },
                {
                    "id": "640960203",
                    "speaker": "希忒",
                    "text": "想了解生论派请选一，明论派请选二，素论派请选三…以此类推。人工服务请选零。"
                }
            ]
        },
        {
            "talkId": "6409603",
            "initDialog": "640960301",
            "dialogues": [
                {
                    "id": "640960301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640960302",
                    "speaker": "希忒",
                    "text": "感谢您对教令院的厚爱与支持，再见。"
                }
            ]
        },
        {
            "talkId": "6409604",
            "initDialog": "640960401",
            "dialogues": [
                {
                    "id": "640960401",
                    "speaker": "Player",
                    "text": "一（生论派）。"
                },
                {
                    "id": "640960402",
                    "speaker": "希忒",
                    "text": "生论派从属阿弥利多学院，是教令院最古老的学派。"
                },
                {
                    "id": "640960403",
                    "speaker": "希忒",
                    "text": "最初由跟随大慈树王大人共同培育雨林的学者组成，至今也依然最为庞大。"
                },
                {
                    "id": "640960404",
                    "speaker": "希忒",
                    "text": "代表色为绿色，包含生物学、生态学、医学等细分学科。"
                },
                {
                    "id": "640960405",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在种田，就是在畜牧。"
                }
            ]
        },
        {
            "talkId": "6409605",
            "initDialog": "640960501",
            "dialogues": [
                {
                    "id": "640960501",
                    "speaker": "Player",
                    "text": "二（明论派）。"
                },
                {
                    "id": "640960502",
                    "speaker": "希忒",
                    "text": "明论派依托于梨多梵谛学院，以星空为其研究中心，认为天空映照真理，刻写命运。"
                },
                {
                    "id": "640960503",
                    "speaker": "希忒",
                    "text": "其标志为蓝色，包含天文学、占星术等学科。"
                },
                {
                    "id": "640960504",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在看天，就是在苦算。"
                }
            ]
        },
        {
            "talkId": "6409606",
            "initDialog": "640960601",
            "dialogues": [
                {
                    "id": "640960601",
                    "speaker": "Player",
                    "text": "三（素论派）。"
                },
                {
                    "id": "640960602",
                    "speaker": "希忒",
                    "text": "素论派依托于悉般多摩学院，是以元素作为其理论核心的学派，专注于对元素反应变化的研究。"
                },
                {
                    "id": "640960603",
                    "speaker": "希忒",
                    "text": "因为要考察各处地脉，素论派有着相较其他学派更多的游学者「帝利耶悉」。"
                },
                {
                    "id": "640960604",
                    "speaker": "希忒",
                    "text": "其标志为红色，包含炼金术、元素学、地脉学等学科。"
                },
                {
                    "id": "640960605",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在搞反应实验，就是在野外出差。"
                }
            ]
        },
        {
            "talkId": "6409607",
            "initDialog": "640960701",
            "dialogues": [
                {
                    "id": "640960701",
                    "speaker": "Player",
                    "text": "（更多…）"
                },
                {
                    "id": "640960702",
                    "speaker": "希忒",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6409608",
            "initDialog": "640960801",
            "dialogues": [
                {
                    "id": "640960801",
                    "speaker": "Player",
                    "text": "四（知论派）。"
                },
                {
                    "id": "640960802",
                    "speaker": "希忒",
                    "text": "知论派依托于室罗婆耽学院，是将语言、文字视为世界的核心与本质的学派。"
                },
                {
                    "id": "640960803",
                    "speaker": "希忒",
                    "text": "其标志为黑色，包含语言学、符文学等学科。"
                },
                {
                    "id": "640960804",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在解读古文，就是在创造新字。"
                }
            ]
        },
        {
            "talkId": "6409609",
            "initDialog": "640960901",
            "dialogues": [
                {
                    "id": "640960901",
                    "speaker": "Player",
                    "text": "五（因论派）。"
                },
                {
                    "id": "640960902",
                    "speaker": "希忒",
                    "text": "因论派依托于伐护末那学院，力图探究知识的来源、构成及其本质。"
                },
                {
                    "id": "640960903",
                    "speaker": "希忒",
                    "text": "最初起源于对于赤王残留理论的破斥与反思，后来从中诞生了各种社会科学。"
                },
                {
                    "id": "640960904",
                    "speaker": "希忒",
                    "text": "其标志为黄色，包含历史学、社会学等学科。"
                },
                {
                    "id": "640960905",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在背书，就是在辟谣。"
                }
            ]
        },
        {
            "talkId": "6409610",
            "initDialog": "640961001",
            "dialogues": [
                {
                    "id": "640961001",
                    "speaker": "Player",
                    "text": "六（妙论派）。"
                },
                {
                    "id": "640961002",
                    "speaker": "希忒",
                    "text": "妙论派依托于刹诃伐罗学院，因为研究与制造驱动机关而产生。"
                },
                {
                    "id": "640961003",
                    "speaker": "希忒",
                    "text": "由于制作机关要涉及到各方面的知识，所以是个相当综合的学派。"
                },
                {
                    "id": "640961004",
                    "speaker": "希忒",
                    "text": "其标志为白色，包含建筑学、机关术等学科。"
                },
                {
                    "id": "640961005",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在盖屋，就是在解谜。"
                }
            ]
        },
        {
            "talkId": "6409611",
            "initDialog": "640961101",
            "dialogues": [
                {
                    "id": "640961101",
                    "speaker": "Player",
                    "text": "零…你是人偶吗？"
                },
                {
                    "id": "640961102",
                    "speaker": "希忒",
                    "text": "呵呵，是人偶的话，没准反而更好。只要按照程序办事即可，被人打断说话也不会生气。"
                },
                {
                    "id": "640961103",
                    "speaker": "希忒",
                    "text": "…现在好像也差不多了。"
                },
                {
                    "id": "640961104",
                    "speaker": "希忒",
                    "text": "在做了几年教令院的接待之后，我已经把那些招生简章上的文字背得滚瓜烂熟，可以自动诵读了。"
                },
                {
                    "id": "640961105",
                    "speaker": "希忒",
                    "text": "前来求学的人源源不绝，只要教令院还存在，我就永远也无法结束工作。"
                },
                {
                    "id": "640961106",
                    "speaker": "希忒",
                    "text": "呼…好久没跟人正常讲话了，多谢。"
                }
            ]
        },
        {
            "talkId": "6409612",
            "initDialog": "640961201",
            "dialogues": [
                {
                    "id": "640961201",
                    "speaker": "Player",
                    "text": "（返回。）"
                },
                {
                    "id": "640961202",
                    "speaker": "希忒",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6409613",
            "initDialog": "640961301",
            "dialogues": [
                {
                    "id": "640961301",
                    "speaker": "Player",
                    "text": "一（生论派）。"
                },
                {
                    "id": "640961302",
                    "speaker": "希忒",
                    "text": "生论派从属阿弥利多学院，是教令院最古老的学派。"
                },
                {
                    "id": "640961303",
                    "speaker": "希忒",
                    "text": "最初由跟随草神大人共同培育雨林的学者组成，至今也依然最为庞大。"
                },
                {
                    "id": "640961304",
                    "speaker": "希忒",
                    "text": "代表色为绿色，包含生物学、生态学、医学等细分学科。"
                },
                {
                    "id": "640961305",
                    "speaker": "希忒",
                    "text": "…简而言之，不是在种田，就是在畜牧。"
                }
            ]
        }
    ]
}