{
    "groupId": "7548",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "佩拉格娅": 7
    },
    "talks": [
        {
            "talkId": "6754801",
            "initDialog": "675480101",
            "dialogues": [
                {
                    "id": "675480101",
                    "speaker": "佩拉格娅",
                    "text": "摇呀摇，看呀看，打开娃娃分两半，跑出伙伴排一串…有没有人想来猜猜这里面到底有几层套娃呀…"
                }
            ]
        },
        {
            "talkId": "6754802",
            "initDialog": "675480201",
            "dialogues": [
                {
                    "id": "675480201",
                    "speaker": "Player",
                    "text": "我快听不清你的声音了。"
                },
                {
                    "id": "675480202",
                    "speaker": "佩拉格娅",
                    "text": "啊？爸爸妈妈也这么说…这样的音量够了吗？"
                }
            ]
        },
        {
            "talkId": "6754803",
            "initDialog": "675480301",
            "dialogues": [
                {
                    "id": "675480301",
                    "speaker": "Player",
                    "text": "下次再来猜猜看。"
                },
                {
                    "id": "675480302",
                    "speaker": "佩拉格娅",
                    "text": "…嗯，我知道啦，再见。"
                }
            ]
        },
        {
            "talkId": "6754804",
            "initDialog": "675480401",
            "dialogues": [
                {
                    "id": "675480401",
                    "speaker": "Player",
                    "text": "勉强能够听清了。"
                },
                {
                    "id": "675480402",
                    "speaker": "佩拉格娅",
                    "text": "呼…那就好，爸爸妈妈觉得我胆子太小啦，所以搭了个摊子，让我锻炼锻炼，至少不要再害怕和陌生人说话。"
                },
                {
                    "id": "675480403",
                    "speaker": "佩拉格娅",
                    "text": "不过，我好像已经进步了一点点…第一次有人找上门来的时候，我连摊子都没顾上，直接跑了。"
                },
                {
                    "id": "675480404",
                    "speaker": "佩拉格娅",
                    "text": "…谢谢，也多亏有你找我说会话，不然我一个人总是傻傻地站在这里，多尴尬呀。"
                },
                {
                    "id": "675480405",
                    "speaker": "佩拉格娅",
                    "text": "之后，我还要好好学习一下怎么主动和陌生人说话…唉，真难啊…"
                }
            ]
        }
    ]
}