{
    "groupId": "7469",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "索契科夫": 6
    },
    "talks": [
        {
            "talkId": "6746901",
            "initDialog": "674690101",
            "dialogues": [
                {
                    "id": "674690101",
                    "speaker": "索契科夫",
                    "text": "请注意安全…唉，今天乘客那么多，不知道下班还来不来得及…"
                }
            ]
        },
        {
            "talkId": "6746902",
            "initDialog": "674690201",
            "dialogues": [
                {
                    "id": "674690201",
                    "speaker": "Player",
                    "text": "来不来得及…什么？"
                },
                {
                    "id": "674690202",
                    "speaker": "索契科夫",
                    "text": "来不来得及去科洛列夫茨基看最新的剧…我好不容易托了关系才拿到了两张票…"
                },
                {
                    "id": "674690203",
                    "speaker": "索契科夫",
                    "text": "还想约伊莉雅娜一起去，唉，要是下班晚了，估计很难赶上开场演出了。"
                }
            ]
        },
        {
            "talkId": "6746903",
            "initDialog": "674690301",
            "dialogues": [
                {
                    "id": "674690301",
                    "speaker": "Player",
                    "text": "乘客多你们也会晚下班吗？"
                },
                {
                    "id": "674690302",
                    "speaker": "索契科夫",
                    "text": "乘客多，就意味着可能会出现问题也会增多，为了处理这些问题，列车说不定也会稍微晚点才会出发。"
                },
                {
                    "id": "674690303",
                    "speaker": "索契科夫",
                    "text": "列车晚点，就代表我们这些安全员下班时间也会相较之下晚上一些啦。"
                }
            ]
        },
        {
            "talkId": "6746904",
            "initDialog": "674690401",
            "dialogues": [
                {
                    "id": "674690401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674690402",
                    "speaker": "索契科夫",
                    "text": "再见，请注意安全。"
                }
            ]
        }
    ]
}