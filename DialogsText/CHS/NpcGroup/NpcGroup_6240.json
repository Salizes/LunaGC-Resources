{
    "groupId": "6240",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "梅兹莉": 8
    },
    "talks": [
        {
            "talkId": "6624001",
            "initDialog": "662400101",
            "dialogues": [
                {
                    "id": "662400101",
                    "speaker": "梅兹莉",
                    "text": "你好，你也是来看这些孩子们的吗？"
                }
            ]
        },
        {
            "talkId": "6624002",
            "initDialog": "662400201",
            "dialogues": [
                {
                    "id": "662400201",
                    "speaker": "Player",
                    "text": "孩子们？"
                },
                {
                    "id": "662400202",
                    "speaker": "梅兹莉",
                    "text": "很可爱吧，这些圆滚滚的小家伙们。"
                },
                {
                    "id": "662400203",
                    "speaker": "梅兹莉",
                    "text": "一跟它们说起话来，声音就控制不住地变软了…呵呵，在旁人看来，可能有些奇怪吧。"
                }
            ]
        },
        {
            "talkId": "6624003",
            "initDialog": "662400301",
            "dialogues": [
                {
                    "id": "662400301",
                    "speaker": "Player",
                    "text": "顺路看看。"
                },
                {
                    "id": "662400302",
                    "speaker": "梅兹莉",
                    "text": "欢迎，不过得注意不要惊扰到它们哟。"
                }
            ]
        },
        {
            "talkId": "6624004",
            "initDialog": "662400401",
            "dialogues": [
                {
                    "id": "662400401",
                    "speaker": "Player",
                    "text": "完全能理解。"
                },
                {
                    "id": "662400402",
                    "speaker": "梅兹莉",
                    "text": "是啊，就像有人看到小猫就会喵喵叫，我看到幼龙就会忍不住嘬嘬地招呼它们。"
                },
                {
                    "id": "662400403",
                    "speaker": "梅兹莉",
                    "text": "等它们长大一些，我就能骑上大龙带它们一起飞翔了。"
                },
                {
                    "id": "662400404",
                    "speaker": "梅兹莉",
                    "text": "再长大些的龙就要开始有自己的性格，选择自己认同的骑士了。"
                },
                {
                    "id": "662400405",
                    "speaker": "梅兹莉",
                    "text": "所以，要格外珍惜这段小龙们会天真地跟着你的时间哦。"
                }
            ]
        }
    ]
}