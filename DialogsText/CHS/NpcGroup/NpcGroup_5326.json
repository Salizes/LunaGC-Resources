{
    "groupId": "5326",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "埃斯特": 11
    },
    "talks": [
        {
            "talkId": "6532601",
            "initDialog": "653260101",
            "dialogues": [
                {
                    "id": "653260101",
                    "speaker": "埃斯特",
                    "text": "那就拜托你们了，唉，怎么会发生这种事…"
                },
                {
                    "id": "653260102",
                    "speaker": "埃斯特",
                    "text": "如果不是没法抛下镇上的大家不管，我也想要再去遗迹调查…不过幸好遇到了你们。"
                },
                {
                    "id": "653260103",
                    "speaker": "埃斯特",
                    "text": "你们要多加小心啊。"
                }
            ]
        },
        {
            "talkId": "6532602",
            "initDialog": "653260201",
            "dialogues": [
                {
                    "id": "653260201",
                    "speaker": "埃斯特",
                    "text": "你好，我们又见面了。看见你总感觉我还在做梦…"
                }
            ]
        },
        {
            "talkId": "6532603",
            "initDialog": "653260301",
            "dialogues": [
                {
                    "id": "653260301",
                    "speaker": "Player",
                    "text": "最近在忙些什么？"
                },
                {
                    "id": "653260302",
                    "speaker": "埃斯特",
                    "text": "自从上次的事情之后，我发现催眠术确实是个很有前景的研究方向。"
                },
                {
                    "id": "653260303",
                    "speaker": "埃斯特",
                    "text": "你想想，如果是在梦中的话，不管是什么样的空想都能轻松实现，对吧？"
                },
                {
                    "id": "653260304",
                    "speaker": "埃斯特",
                    "text": "为此我读完了格里斯潘留下来的笔记，虽然不一定能取得更高的成就，但添砖加瓦还是能做到的。"
                },
                {
                    "id": "653260305",
                    "speaker": "埃斯特",
                    "text": "等那家伙回来，一定会对我刮目相看的！"
                }
            ]
        },
        {
            "talkId": "6532604",
            "initDialog": "653260401",
            "dialogues": [
                {
                    "id": "653260401",
                    "speaker": "Player",
                    "text": "小呜斯还好吗？"
                },
                {
                    "id": "653260402",
                    "speaker": "埃斯特",
                    "text": "当然，虽然是只年纪很小的猫咪，不过小呜斯意外的胆子很大啊。"
                },
                {
                    "id": "653260403",
                    "speaker": "埃斯特",
                    "text": "他一点也不怕生人的样子，用不了多久就能和镇上的大家都熟络起来吧。"
                }
            ]
        },
        {
            "talkId": "6532605",
            "initDialog": "653260501",
            "dialogues": [
                {
                    "id": "653260501",
                    "speaker": "Player",
                    "text": "下次再见吧！"
                },
                {
                    "id": "653260502",
                    "speaker": "埃斯特",
                    "text": "再见，要多回来看看小呜斯啊，他一定会很想念你的。"
                }
            ]
        }
    ]
}