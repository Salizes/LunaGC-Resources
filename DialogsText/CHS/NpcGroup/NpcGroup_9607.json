{
    "groupId": "9607",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "奈芙尔": 10
    },
    "talks": [
        {
            "talkId": "6960701",
            "initDialog": "696070101",
            "dialogues": [
                {
                    "id": "696070101",
                    "speaker": "奈芙尔",
                    "text": "跟「旗舰」一样人声鼎沸呢，是个打听消息的好地方。啊，不然下次让雅珂达来这里转一转吧，看看她能搜集到多少有用的情报。"
                }
            ]
        },
        {
            "talkId": "6960702",
            "initDialog": "696070201",
            "dialogues": [
                {
                    "id": "696070201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960703",
            "initDialog": "696070301",
            "dialogues": [
                {
                    "id": "696070301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696070302",
                    "speaker": "奈芙尔",
                    "text": "哦？你要去休息了？呵…去吧。正好天色已晚，也到了我该出门工作的时候了。"
                }
            ]
        },
        {
            "talkId": "6960704",
            "initDialog": "696070401",
            "dialogues": [
                {
                    "id": "696070401",
                    "speaker": "奈芙尔",
                    "text": "哎呀，差一点就让你得手了。可惜，你的表情暴露了自己的意图。什么表情？嗯…虽然想笑，但不得不硬压着嘴角的表情吧。"
                }
            ]
        },
        {
            "talkId": "6960705",
            "initDialog": "696070501",
            "dialogues": [
                {
                    "id": "696070501",
                    "speaker": "奈芙尔",
                    "text": "…是你赢了。这局你打得不错，我愿赌服输，等会再多请你两杯饮料，喝完了之后，我们继续。"
                }
            ]
        },
        {
            "talkId": "6960706",
            "initDialog": "696070601",
            "dialogues": [
                {
                    "id": "696070601",
                    "speaker": "奈芙尔",
                    "text": "打牌？行，就当做是打发时间了，希望我们都能玩得尽兴。"
                }
            ]
        },
        {
            "talkId": "6960708",
            "initDialog": "696070801",
            "dialogues": [
                {
                    "id": "696070801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960709",
            "initDialog": "696070901",
            "dialogues": [
                {
                    "id": "696070901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960710",
            "initDialog": "696071001",
            "dialogues": [
                {
                    "id": "696071001",
                    "speaker": "奈芙尔",
                    "text": "我赢了，下一局你需要更努力一点了。"
                }
            ]
        },
        {
            "talkId": "6960711",
            "initDialog": "696071101",
            "dialogues": [
                {
                    "id": "696071101",
                    "speaker": "奈芙尔",
                    "text": "不错的消遣，要再来一局吗？"
                }
            ]
        },
        {
            "talkId": "6960712",
            "initDialog": "696071201",
            "dialogues": [
                {
                    "id": "696071201",
                    "speaker": "奈芙尔",
                    "text": "想要和我认真玩一局？好啊，那我就…不保留实力喽？"
                }
            ]
        },
        {
            "talkId": "6960714",
            "initDialog": "696071401",
            "dialogues": [
                {
                    "id": "696071401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960715",
            "initDialog": "696071501",
            "dialogues": [
                {
                    "id": "696071501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960716",
            "initDialog": "696071601",
            "dialogues": [
                {
                    "id": "696071601",
                    "speaker": "奈芙尔",
                    "text": "打牌和分析情报一样，只盯着自己手里的牌面可是大忌。别怪我没提醒你…"
                }
            ]
        },
        {
            "talkId": "6960717",
            "initDialog": "696071701",
            "dialogues": [
                {
                    "id": "696071701",
                    "speaker": "奈芙尔",
                    "text": "输了呀…想瞒过你的眼睛，难度果然比我想象的还要高呢。"
                }
            ]
        },
        {
            "talkId": "6960718",
            "initDialog": "696071801",
            "dialogues": [
                {
                    "id": "696071801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}