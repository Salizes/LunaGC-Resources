{
    "groupId": "3021",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 10,
        "长谷川": 25
    },
    "talks": [
        {
            "talkId": "6302101",
            "initDialog": "630210101",
            "dialogues": [
                {
                    "id": "630210101",
                    "speaker": "长谷川",
                    "text": "真少见啊，今时今日还能在路上遇到异乡人。"
                }
            ]
        },
        {
            "talkId": "6302102",
            "initDialog": "630210201",
            "dialogues": [
                {
                    "id": "630210201",
                    "speaker": "Player",
                    "text": "关于将军大人…"
                },
                {
                    "id": "630210202",
                    "speaker": "长谷川",
                    "text": "身为稻妻人，我肯定是和大家一样，一直追随将军大人。"
                },
                {
                    "id": "630210203",
                    "speaker": "长谷川",
                    "text": "只是最近将军大人推行的政策，也太不近人情了…"
                }
            ]
        },
        {
            "talkId": "6302103",
            "initDialog": "630210301",
            "dialogues": [
                {
                    "id": "630210301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630210302",
                    "speaker": "长谷川",
                    "text": "再见，希望以后能好起来啊。"
                }
            ]
        },
        {
            "talkId": "6302104",
            "initDialog": "630210401",
            "dialogues": [
                {
                    "id": "630210401",
                    "speaker": "Player",
                    "text": "你是说锁国令？"
                },
                {
                    "id": "630210402",
                    "speaker": "长谷川",
                    "text": "可不是吗！不许外国的货船通行之后，很多只靠进口的高档货都没有了。"
                },
                {
                    "id": "630210403",
                    "speaker": "长谷川",
                    "text": "我仿佛已经很久没有喝过蒙德的蒲公英酒，也很久没有定做过璃月丝绸制作的着物了…"
                },
                {
                    "id": "630210404",
                    "speaker": "长谷川",
                    "text": "买不到的话，就算有再多钱又有什么用呢，你说是吧。"
                }
            ]
        },
        {
            "talkId": "6302105",
            "initDialog": "630210501",
            "dialogues": [
                {
                    "id": "630210501",
                    "speaker": "Player",
                    "text": "你是说眼狩令？"
                },
                {
                    "id": "630210502",
                    "speaker": "长谷川",
                    "text": "眼狩令吗…这个我倒是无所谓。"
                },
                {
                    "id": "630210503",
                    "speaker": "长谷川",
                    "text": "毕竟有神之眼的人也没几个，对我没什么影响。"
                },
                {
                    "id": "630210504",
                    "speaker": "长谷川",
                    "text": "你说他们失去神之眼之后的生活…呃，这个我不太清楚，和我有什么关系吗？"
                }
            ]
        },
        {
            "talkId": "6302106",
            "initDialog": "630210601",
            "dialogues": [
                {
                    "id": "630210601",
                    "speaker": "长谷川",
                    "text": "你好呀，是最近来稻妻城观光的游客吗？"
                }
            ]
        },
        {
            "talkId": "6302107",
            "initDialog": "630210701",
            "dialogues": [
                {
                    "id": "630210701",
                    "speaker": "Player",
                    "text": "关于将军大人…"
                },
                {
                    "id": "630210702",
                    "speaker": "长谷川",
                    "text": "身为稻妻人，我肯定是和大家一样，一直追随将军大人。"
                },
                {
                    "id": "630210703",
                    "speaker": "长谷川",
                    "text": "感谢将军大人的开明之举，最近的生活开心多了。"
                }
            ]
        },
        {
            "talkId": "6302108",
            "initDialog": "630210801",
            "dialogues": [
                {
                    "id": "630210801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630210802",
                    "speaker": "长谷川",
                    "text": "再见，生活会越来越好的！"
                }
            ]
        },
        {
            "talkId": "6302109",
            "initDialog": "630210901",
            "dialogues": [
                {
                    "id": "630210901",
                    "speaker": "Player",
                    "text": "你是说锁国令解除？"
                },
                {
                    "id": "630210902",
                    "speaker": "长谷川",
                    "text": "可不是吗！锁国令期间不许外国的货船通行，很多只靠进口的高档货都没有了。"
                },
                {
                    "id": "630210903",
                    "speaker": "长谷川",
                    "text": "现在嘛，终于又能喝到蒙德的蒲公英酒，定做璃月丝绸制作的着物了…"
                },
                {
                    "id": "630210904",
                    "speaker": "长谷川",
                    "text": "这才是美好的人生啊。"
                }
            ]
        },
        {
            "talkId": "6302110",
            "initDialog": "630211001",
            "dialogues": [
                {
                    "id": "630211001",
                    "speaker": "Player",
                    "text": "你是说眼狩令废除？"
                },
                {
                    "id": "630211002",
                    "speaker": "长谷川",
                    "text": "眼狩令吗…这个我倒是无所谓。"
                },
                {
                    "id": "630211003",
                    "speaker": "长谷川",
                    "text": "毕竟有神之眼的人也没几个，对我没什么影响。"
                },
                {
                    "id": "630211004",
                    "speaker": "长谷川",
                    "text": "你说他们曾经失去神之眼的经历…呃，这个我不太清楚，和我有什么关系吗？"
                }
            ]
        },
        {
            "talkId": "7291301",
            "initDialog": "729130101",
            "dialogues": [
                {
                    "id": "729130101",
                    "speaker": "Player",
                    "text": "看起来你见多识广啊。"
                },
                {
                    "id": "729130102",
                    "speaker": "长谷川",
                    "text": "呵，以我的家底，想出国旅游还不是件简单的事情。"
                },
                {
                    "id": "729130103",
                    "speaker": "长谷川",
                    "text": "以前我可没少出门，自然见得多了。只可惜现在…"
                },
                {
                    "id": "729130104",
                    "speaker": "长谷川",
                    "text": "唉，如今回忆起当年的我四处游玩，真是怀念啊…这些游历的经验，也分享给你吧。"
                }
            ]
        },
        {
            "talkId": "7291302",
            "initDialog": "729130201",
            "dialogues": [
                {
                    "id": "729130201",
                    "speaker": "Player",
                    "text": "看起来你见多识广啊。"
                },
                {
                    "id": "729130202",
                    "speaker": "长谷川",
                    "text": "呵，以我的家底，想出国旅游还不是件简单的事情。"
                },
                {
                    "id": "729130203",
                    "speaker": "长谷川",
                    "text": "我可没少出过门，自然见得多了。这些游历的经验，也分享给你吧。"
                }
            ]
        }
    ]
}