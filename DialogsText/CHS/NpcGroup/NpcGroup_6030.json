{
    "groupId": "6030",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "恩琳": 11
    },
    "talks": [
        {
            "talkId": "6603001",
            "initDialog": "660300101",
            "dialogues": [
                {
                    "id": "660300101",
                    "speaker": "恩琳",
                    "text": "你，稍等。"
                },
                {
                    "id": "660300102",
                    "speaker": "恩琳",
                    "text": "请速答，你上次体检是什么时候？"
                }
            ]
        },
        {
            "talkId": "6603002",
            "initDialog": "660300201",
            "dialogues": [
                {
                    "id": "660300201",
                    "speaker": "Player",
                    "text": "大概是…"
                },
                {
                    "id": "660300202",
                    "speaker": "恩琳",
                    "text": "呵，你犹豫了。"
                },
                {
                    "id": "660300203",
                    "speaker": "恩琳",
                    "text": "不要多说，赶快找时间、找医生去体检。"
                },
                {
                    "id": "660300204",
                    "speaker": "恩琳",
                    "text": "你可能觉得我在危言耸听，但你不知道的是，有很多参赛选手在上竞技场的前一秒，在体检中查出了问题。"
                },
                {
                    "id": "660300205",
                    "speaker": "恩琳",
                    "text": "就因为一些被忽视的小毛病，让长期的努力训练打了水漂，实在是不值得。"
                },
                {
                    "id": "660300206",
                    "speaker": "恩琳",
                    "text": "而且即便不是战士，也得去定期体检！"
                },
                {
                    "id": "660300207",
                    "speaker": "恩琳",
                    "text": "要知道，没了健康的人，就跟没了人的部族一样，没区别。"
                }
            ]
        },
        {
            "talkId": "6603003",
            "initDialog": "660300301",
            "dialogues": [
                {
                    "id": "660300301",
                    "speaker": "Player",
                    "text": "…我这就去！"
                },
                {
                    "id": "660300302",
                    "speaker": "恩琳",
                    "text": "一言为定哦！"
                }
            ]
        },
        {
            "talkId": "7591601",
            "initDialog": "759160101",
            "dialogues": [
                {
                    "id": "759160101",
                    "speaker": "Player",
                    "text": "我、我明白了。"
                },
                {
                    "id": "759160102",
                    "speaker": "恩琳",
                    "text": "好，能多劝一个人是一个人。"
                },
                {
                    "id": "759160103",
                    "speaker": "恩琳",
                    "text": "不要等到来不及挽回的时候自食其果。"
                }
            ]
        }
    ]
}