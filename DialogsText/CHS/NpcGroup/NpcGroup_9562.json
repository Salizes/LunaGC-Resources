            ]
        },
        {
            "talkId": "6956208",
            "initDialog": "695620801",
            "dialogues": [
                {
                    "id": "695620801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956209",
            "initDialog": "695620901",
            "dialogues": [
                {
                    "id": "695620901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956210",
            "initDialog": "695621001",
            "dialogues": [
                {
                    "id": "695621001",
                    "speaker": "那维莱特",
                    "text": "让人印象深刻的对局。无论胜败如何，这场牌局本身的价值应被认可。"
                }
            ]
        },
        {
            "talkId": "6956211",
            "initDialog": "695621101",
            "dialogues": [
                {
                    "id": "695621101",
                    "speaker": "那维莱特",
                    "text": "这场属于你的胜利无可辩驳，恭喜。"
                }
            ]
        },
        {
            "talkId": "6956212",
            "initDialog": "695621201",
            "dialogues": [
                {
                    "id": "695621201",
                    "speaker": "那维莱特",
                    "text": "十分乐意。需要请第三方人员重洗牌堆吗？"
                }
            ]
        },
        {
            "talkId": "6956214",
            "initDialog": "695621401",
            "dialogues": [
                {
                    "id": "695621401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956215",
            "initDialog": "695621501",
            "dialogues": [
                {
                    "id": "695621501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956216",
            "initDialog": "695621601",
            "dialogues": [
                {
                    "id": "695621601",
                    "speaker": "那维莱特",
                    "text": "很愉快的对局。说实话，见你能如此坦然地面对自己的失利，让我松了一口气。"
                }
            ]
        },
        {
            "talkId": "6956217",
            "initDialog": "695621701",
            "dialogues": [
                {
                    "id": "695621701",
                    "speaker": "那维莱特",
                    "text": "你获得这场胜利的方式无可置疑，我很钦佩你所展现的精彩牌技。"
                }
            ]
        },
        {
            "talkId": "6956218",
            "initDialog": "695621801",
            "dialogues": [
                {
                    "id": "695621801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
