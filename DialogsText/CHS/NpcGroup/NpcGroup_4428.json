{
    "groupId": "4428",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "拉赫曼": 15
    },
    "talks": [
        {
            "talkId": "6442801",
            "initDialog": "644280101",
            "dialogues": [
                {
                    "id": "644280101",
                    "speaker": "拉赫曼",
                    "text": "哟，这不是我们的新同伴吗。"
                },
                {
                    "id": "644280102",
                    "speaker": "拉赫曼",
                    "text": "怎么样，心情如何？一切顺利吗？"
                }
            ]
        },
        {
            "talkId": "6442802",
            "initDialog": "644280201",
            "dialogues": [
                {
                    "id": "644280201",
                    "speaker": "Player",
                    "text": "还好。你呢？"
                },
                {
                    "id": "644280202",
                    "speaker": "拉赫曼",
                    "text": "说实话吗？转变来得比较突然，多少还有点恍惚。"
                },
                {
                    "id": "644280203",
                    "speaker": "拉赫曼",
                    "text": "但是，事实就是事实。"
                },
                {
                    "id": "644280204",
                    "speaker": "拉赫曼",
                    "text": "虽然我仍然不喜欢防沙壁另一边的人，但我脑子还算清醒，不会再对赤王复活抱有不切实际的妄想了。"
                },
                {
                    "id": "644280205",
                    "speaker": "拉赫曼",
                    "text": "我们现在是利害相关的同伴了，那当你需要帮助时，我自然不会坐视不理。"
                },
                {
                    "id": "644280206",
                    "speaker": "拉赫曼",
                    "text": "另外多说一句，你们要对付的可是那个高高在上的教令院，行动时一定要小心谨慎。"
                }
            ]
        },
        {
            "talkId": "6442803",
            "initDialog": "644280301",
            "dialogues": [
                {
                    "id": "644280301",
                    "speaker": "Player",
                    "text": "老样子。"
                },
                {
                    "id": "644280302",
                    "speaker": "拉赫曼",
                    "text": "这样吗？那也挺好，就这么保持坚定吧。"
                }
            ]
        },
        {
            "talkId": "6442804",
            "initDialog": "644280401",
            "dialogues": [
                {
                    "id": "644280401",
                    "speaker": "拉赫曼",
                    "text": "又见面了。你最近怎么样？应该稳定下来了吧？"
                }
            ]
        },
        {
            "talkId": "6442805",
            "initDialog": "644280501",
            "dialogues": [
                {
                    "id": "644280501",
                    "speaker": "Player",
                    "text": "稍微轻松些了。你怎么样？"
                },
                {
                    "id": "644280502",
                    "speaker": "拉赫曼",
                    "text": "我最近倒是忙起来了，除了完成赛诺分配给我们这边的必要工作之外，还要负责担任小姐的保镖。"
                },
                {
                    "id": "644280503",
                    "speaker": "拉赫曼",
                    "text": "你应该认得，就是塞塔蕾小姐。最近她得到批准，离开教令院了。"
                },
                {
                    "id": "644280504",
                    "speaker": "拉赫曼",
                    "text": "她说要把自己所学的东西推行到沙漠中。小吉祥草王和赛诺很支持这一计划，帮了不少忙。"
                },
                {
                    "id": "644280505",
                    "speaker": "拉赫曼",
                    "text": "这是千载难逢的好事。如今机会重新降临在我们赤王子民身上…必须把握住。"
                }
            ]
        },
        {
            "talkId": "6442806",
            "initDialog": "644280601",
            "dialogues": [
                {
                    "id": "644280601",
                    "speaker": "Player",
                    "text": "跟以前一样。"
                },
                {
                    "id": "644280602",
                    "speaker": "拉赫曼",
                    "text": "是吗。出门在外，多注意安全。"
                },
                {
                    "id": "644280603",
                    "speaker": "拉赫曼",
                    "text": "如果有需要帮忙的事，可以来这里找我。最近我都会在这一带活动。"
                }
            ]
        }
    ]
}