{
    "groupId": "4442",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "拉沙鲁": 13
    },
    "talks": [
        {
            "talkId": "6444201",
            "initDialog": "644420101",
            "dialogues": [
                {
                    "id": "644420101",
                    "speaker": "拉沙鲁",
                    "text": "甘露花海很好，但是跋尔松也很好…"
                }
            ]
        },
        {
            "talkId": "6444202",
            "initDialog": "644420201",
            "dialogues": [
                {
                    "id": "644420201",
                    "speaker": "Player",
                    "text": "关于跋尔松…"
                },
                {
                    "id": "644420202",
                    "speaker": "拉沙鲁",
                    "text": "是平静的地方，适合睡觉。"
                },
                {
                    "id": "644420203",
                    "speaker": "拉沙鲁",
                    "text": "…花灵的睡觉和人类的睡觉不一样。"
                },
                {
                    "id": "644420204",
                    "speaker": "拉沙鲁",
                    "text": "睡觉可以更专注，唔…感知到根系和枝杈的话语。"
                }
            ]
        },
        {
            "talkId": "6444203",
            "initDialog": "644420301",
            "dialogues": [
                {
                    "id": "644420301",
                    "speaker": "Player",
                    "text": "关于俱利鼓…"
                },
                {
                    "id": "644420302",
                    "speaker": "拉沙鲁",
                    "text": "人类的乐器，很吵。"
                }
            ]
        },
        {
            "talkId": "6444204",
            "initDialog": "644420401",
            "dialogues": [
                {
                    "id": "644420401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "644420402",
                    "speaker": "拉沙鲁",
                    "text": "呼…"
                }
            ]
        },
        {
            "talkId": "6444205",
            "initDialog": "644420501",
            "dialogues": [
                {
                    "id": "644420501",
                    "speaker": "拉沙鲁",
                    "text": "呼…呼…唔？是跟斯露莎一起的…"
                }
            ]
        },
        {
            "talkId": "6444206",
            "initDialog": "644420601",
            "dialogues": [
                {
                    "id": "644420601",
                    "speaker": "Player",
                    "text": "你在休息吗？"
                },
                {
                    "id": "644420602",
                    "speaker": "拉沙鲁",
                    "text": "休息也是工作…"
                },
                {
                    "id": "644420603",
                    "speaker": "拉沙鲁",
                    "text": "甘露花海是很好的地方，之前很久很久没有回来，不过一切都很熟悉。"
                }
            ]
        },
        {
            "talkId": "6444207",
            "initDialog": "644420701",
            "dialogues": [
                {
                    "id": "644420701",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "644420702",
                    "speaker": "拉沙鲁",
                    "text": "为了重要的事才把我叫醒，已经原谅她了。"
                },
                {
                    "id": "644420703",
                    "speaker": "拉沙鲁",
                    "text": "「焚真之天象」熄灭了，是斯露莎…和大家的功劳。"
                },
                {
                    "id": "644420704",
                    "speaker": "拉沙鲁",
                    "text": "虽然应该和她自己预想的情况不同，但一定是现在这样更好。"
                }
            ]
        },
        {
            "talkId": "6444208",
            "initDialog": "644420801",
            "dialogues": [
                {
                    "id": "644420801",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "644420802",
                    "speaker": "拉沙鲁",
                    "text": "呼…"
                }
            ]
        }
    ]
}