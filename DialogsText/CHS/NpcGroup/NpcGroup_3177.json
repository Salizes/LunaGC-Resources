    "talks": [
        {
            "talkId": "6317701",
            "initDialog": "631770101",
            "dialogues": [
                {
                    "id": "631770101",
                    "speaker": "松川宗全",
                    "text": "唉…你好，找我有何事？"
                }
            ]
        },
        {
            "talkId": "6317702",
            "initDialog": "631770201",
            "dialogues": [
                {
                    "id": "631770201",
                    "speaker": "Player",
                    "text": "你好像很忧愁。"
                },
                {
                    "id": "631770202",
                    "speaker": "松川宗全",
                    "text": "身为政所执事，我理应为稻妻时局操心。"
                },
                {
                    "id": "631770203",
                    "speaker": "松川宗全",
                    "text": "唉…一想到幕府与叛军的战争久久不停，我就寝食难安。"
                },
                {
                    "id": "631770204",
                    "speaker": "松川宗全",
                    "text": "如此下去的话，稻妻的财务状况只会与日俱下，拖垮民生只是时间问题…"
                },
                {
                    "id": "631770205",
                    "speaker": "松川宗全",
                    "text": "真希望大御所大人能亲自出手，从根本上解决这些问题啊…"
                }
            ]
        },
        {
            "talkId": "6317703",
            "initDialog": "631770301",
            "dialogues": [
                {
                    "id": "631770301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631770302",
                    "speaker": "松川宗全",
                    "text": "唉…再见。"
                }
            ]
        },
        {
            "talkId": "6317704",
            "initDialog": "631770401",
            "dialogues": [
                {
                    "id": "631770401",
                    "speaker": "Player",
                    "text": "你好像很忧愁。"
                },
                {
                    "id": "631770402",
                    "speaker": "松川宗全",
                    "text": "稻妻经历了一系列的变动，终于要迎来新的局面了。"
                },
                {
                    "id": "631770403",
                    "speaker": "松川宗全",
                    "text": "说实话，虽然我现在因为需要处理很多遗留问题而忙得不可开交，但我并不觉得这些都是坏事。"
                },
                {
                    "id": "631770404",
                    "speaker": "松川宗全",
                    "text": "最近大御所大人的心境似乎也有些变化，希望…"
                },
                {
                    "id": "631770405",
                    "speaker": "松川宗全",
                    "text": "哎先不说了，最近正在清算财务，工作比以前更加繁忙了，有机会以后再聊吧。"
                }
            ]
        },
        {
            "talkId": "6317705",
            "initDialog": "631770501",
            "dialogues": [
                {
                    "id": "631770501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631770502",
                    "speaker": "松川宗全",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
}