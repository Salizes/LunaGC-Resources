    "talks": [
        {
            "talkId": "6754001",
            "initDialog": "675400101",
            "dialogues": [
                {
                    "id": "675400101",
                    "speaker": "列斯诺娃",
                    "text": "哎呀，怎么又错过了…这个月已经是第三回啦！"
                }
            ]
        },
        {
            "talkId": "6754002",
            "initDialog": "675400201",
            "dialogues": [
                {
                    "id": "675400201",
                    "speaker": "Player",
                    "text": "错过什么了？"
                },
                {
                    "id": "675400202",
                    "speaker": "列斯诺娃",
                    "text": "当然是约定好的集合时间啊，结果我不小心又睡过了…"
                },
                {
                    "id": "675400203",
                    "speaker": "列斯诺娃",
                    "text": "上一次是因为我把委托的时间记错了，最后委托人直接找上门来了我才发现…"
                },
                {
                    "id": "675400204",
                    "speaker": "列斯诺娃",
                    "text": "这次时间倒是没记错，但是因为昨晚通宵整理装备和补给，一觉睡醒就发现集合时间已经过了。"
                },
                {
                    "id": "675400205",
                    "speaker": "列斯诺娃",
                    "text": "我的性格是不是真的不适合当冒险家啊…"
                }
            ]
        },
        {
            "talkId": "6754003",
            "initDialog": "675400301",
            "dialogues": [
                {
                    "id": "675400301",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "675400302",
                    "speaker": "列斯诺娃",
                    "text": "哎，怎么办呀…"
                }
            ]
        }
    ]
}