    "talks": [
        {
            "talkId": "4111540",
            "initDialog": "411154001",
            "dialogues": [
                {
                    "id": "411154001",
                    "speaker": "丹迪",
                    "text": "你好啊，听说协会把调查陨石的委托安排给你了呢。"
                },
                {
                    "id": "411154002",
                    "speaker": "丹迪",
                    "text": "真好啊，我也想有朝一日能感受到这种被认可的感觉。可惜现在的我就算有这样的机会，也还不敢抓住吧…"
                }
            ]
        },
        {
            "talkId": "6221001",
            "initDialog": "622100101",
            "dialogues": [
                {
                    "id": "622100101",
                    "speaker": "丹迪",
                    "text": "你好啊，旅行者！"
                }
            ]
        },
        {
            "talkId": "6221002",
            "initDialog": "622100201",
            "dialogues": [
                {
                    "id": "622100201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "622100202",
                    "speaker": "丹迪",
                    "text": "我是冒险家丹迪。主要活动范围是高山和险境。"
                },
                {
                    "id": "622100203",
                    "speaker": "丹迪",
                    "text": "地下世界不适合我啦，我战斗力不太行，那里又不太好爬。"
                }
            ]
        },
        {
            "talkId": "6221003",
            "initDialog": "622100301",
            "dialogues": [
                {
                    "id": "622100301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622100302",
                    "speaker": "丹迪",
                    "text": "再见！祝你拥有战胜困难的勇气！"
                }
            ]
        }
    ]
}