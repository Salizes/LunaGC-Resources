{
    "groupId": "4345",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "伊扎德": 8
    },
    "talks": [
        {
            "talkId": "5900080",
            "initDialog": "590008001",
            "dialogues": [
                {
                    "id": "590008001",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900081",
            "initDialog": "590008101",
            "dialogues": [
                {
                    "id": "590008101",
                    "speaker": "伊扎德",
                    "text": "如果你喜欢花草，那可观赏的东西就多了。"
                },
                {
                    "id": "590008102",
                    "speaker": "伊扎德",
                    "text": "不过我可能叫不上每种植物的名字…嘿嘿，这种问题还是去问巡林官吧。"
                }
            ]
        },
        {
            "talkId": "6434501",
            "initDialog": "643450101",
            "dialogues": [
                {
                    "id": "643450101",
                    "speaker": "伊扎德",
                    "text": "空气中飘散着不一样的花香…好想在这多待一会儿啊。"
                }
            ]
        },
        {
            "talkId": "6434502",
            "initDialog": "643450201",
            "dialogues": [
                {
                    "id": "643450201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643450202",
                    "speaker": "伊扎德",
                    "text": "我是道成林的巡林员，负责代表巡林队与禅那园联络消息。"
                },
                {
                    "id": "643450203",
                    "speaker": "伊扎德",
                    "text": "我们会定期向禅那园汇报道成林的生态情况，禅那园也会为我们提供各种帮助。"
                },
                {
                    "id": "643450204",
                    "speaker": "伊扎德",
                    "text": "比如最近，我们就收到了不少禅那园免费提供的种子和养料。"
                },
                {
                    "id": "643450205",
                    "speaker": "伊扎德",
                    "text": "巡林员们会负责选择合适的种植位置，或者将种子分发给附近的村民，大家一起为雨林增添更多的绿色。"
                }
            ]
        },
        {
            "talkId": "6434503",
            "initDialog": "643450301",
            "dialogues": [
                {
                    "id": "643450301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643450302",
                    "speaker": "伊扎德",
                    "text": "走慢一些吧，多看看这里的花草。"
                }
            ]
        }
    ]
}