{
    "groupId": "1624",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 10,
        "常九爷": 28
    },
    "talks": [
        {
            "talkId": "7195201",
            "initDialog": "719520101",
            "dialogues": [
                {
                    "id": "719520101",
                    "speaker": "Player",
                    "text": "祝你一切顺利。"
                },
                {
                    "id": "719520102",
                    "speaker": "常九爷",
                    "text": "嘿，那我就借你吉言了！"
                },
                {
                    "id": "719520103",
                    "speaker": "常九爷",
                    "text": "上次你帮了我这么大忙，我也得谢谢你才是。"
                },
                {
                    "id": "719520104",
                    "speaker": "常九爷",
                    "text": "这些夜泊石你们也收下吧，虽然说不上贵重，不过权当做上次的纪念。"
                }
            ]
        },
        {
            "talkId": "6162401",
            "initDialog": "616240101",
            "dialogues": [
                {
                    "id": "616240101",
                    "speaker": "常九爷",
                    "text": "嗯？来笑话我的吗？我常九爷可不吃这套。"
                }
            ]
        },
        {
            "talkId": "6162402",
            "initDialog": "616240201",
            "dialogues": [
                {
                    "id": "616240201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "616240202",
                    "speaker": "常九爷",
                    "text": "说出来怕吓到你，我就是当年在绯云坡大名鼎鼎的常九爷！"
                },
                {
                    "id": "616240203",
                    "speaker": "常九爷",
                    "text": "想当年我还在璃月港的时候，每天经手的摩拉数都数不过来，做生意的所有人都得看我的脸色！"
                },
                {
                    "id": "616240204",
                    "speaker": "常九爷",
                    "text": "什么璃月七星，哼，只要我想，就得给我让个位子！",
                    "choices": [
                        {
                            "id": "616240205",
                            "text": "那为什么来这里住…",
                            "response": [
                                {
                                    "id": "616240206",
                                    "speaker": "常九爷",
                                    "text": "稍微…有点意外，生意上不是很顺利，干脆就卖了老宅到这清净的地方隐居了。"
                                },
                                {
                                    "id": "616240207",
                                    "speaker": "常九爷",
                                    "text": "古人云「未曾清贫难成人」，虽然现在只有一屋子藏书陪着我，但属于我的机会肯定会再出现的。"
                                },
                                {
                                    "id": "616240208",
                                    "speaker": "常九爷",
                                    "text": "比如矿石什么的…算了，凭什么泄露商机给你，嘿嘿。"
                                },
                                {
                                    "id": "616240209",
                                    "speaker": "常九爷",
                                    "text": "到时候，整个璃月港都会知道「那个常九爷他回来了」！"
                                }
                            ]
                        },
                        {
                            "id": "616240210",
                            "text": "关于邻居…",
                            "response": [
                                {
                                    "id": "616240211",
                                    "speaker": "常九爷",
                                    "text": "你说那群种地的穷鬼？哼…真是晦气。"
                                },
                                {
                                    "id": "616240212",
                                    "speaker": "常九爷",
                                    "text": "我常九爷只是暂时不得不与他们当邻居，等我重振了家业，他们就连我脚后跟都摸不着了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6162403",
            "initDialog": "616240301",
            "dialogues": [
                {
                    "id": "616240301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616240302",
                    "speaker": "常九爷",
                    "text": "哼，没事就别跟我搭话。"
                }
            ]
        },
        {
            "talkId": "6162405",
            "initDialog": "616240501",
            "dialogues": [
                {
                    "id": "616240501",
                    "speaker": "常九爷",
                    "text": "什么风把你吹来了？快请进，快请进。"
                }
            ]
        },
        {
            "talkId": "6162406",
            "initDialog": "616240601",
            "dialogues": [
                {
                    "id": "616240601",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "616240602",
                    "speaker": "常九爷",
                    "text": "不记得我了？是我啊，常九爷！之前你来我这里买了好多石珀的！"
                },
                {
                    "id": "616240603",
                    "speaker": "常九爷",
                    "text": "可能是你见过的人太多，记不得我了也正常…"
                },
                {
                    "id": "616240604",
                    "speaker": "常九爷",
                    "text": "想当年我还在绯云坡做生意的时候，谁听到我的大名都要抖一抖，唉，哪像现在…"
                }
            ]
        },
        {
            "talkId": "6162407",
            "initDialog": "616240701",
            "dialogues": [
                {
                    "id": "616240701",
                    "speaker": "Player",
                    "text": "那以后怎么样了？"
                },
                {
                    "id": "616240702",
                    "speaker": "常九爷",
                    "text": "多亏了你，那批石珀能卖出不错的价钱，简直救了命了。"
                },
                {
                    "id": "616240703",
                    "speaker": "常九爷",
                    "text": "我就知道我的眼光不会错的，虽然做生意有很多波折，但能赚钱的东西它就是能赚钱。"
                },
                {
                    "id": "616240704",
                    "speaker": "常九爷",
                    "text": "你看，我用那笔钱买来了更多的矿石，等我矿石的生意周转起来，我就能从这个鬼地方搬走了。"
                },
                {
                    "id": "616240705",
                    "speaker": "常九爷",
                    "text": "到时候，整个璃月港都会知道「那个常九爷他回来了」！"
                }
            ]
        },
        {
            "talkId": "6162408",
            "initDialog": "616240801",
            "dialogues": [
                {
                    "id": "616240801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616240802",
                    "speaker": "常九爷",
                    "text": "慢走啊。再过不久，我们就会在璃月港再见了。"
                }
            ]
        },
        {
            "talkId": "6162409",
            "initDialog": "616240706",
            "dialogues": [
                {
                    "id": "616240706",
                    "speaker": "Player",
                    "text": "关于行秋…"
                },
                {
                    "id": "616240707",
                    "speaker": "常九爷",
                    "text": "古华派的那小子，自那以后我就没见过他了，现在八成也在做些莫名其妙的事吧。"
                },
                {
                    "id": "616240708",
                    "speaker": "常九爷",
                    "text": "不过我总觉得有点古怪，他的身份可能没那么简单…"
                },
                {
                    "id": "616240709",
                    "speaker": "常九爷",
                    "text": "算了，和我也没什么关系。"
                }
            ]
        },
        {
            "talkId": "6162410",
            "initDialog": "616240710",
            "dialogues": [
                {
                    "id": "616240710",
                    "speaker": "Player",
                    "text": "关于邻居…"
                },
                {
                    "id": "616240711",
                    "speaker": "常九爷",
                    "text": "你说那群种地的穷鬼？哼…真是晦气。"
                },
                {
                    "id": "616240712",
                    "speaker": "常九爷",
                    "text": "我常九爷只是暂时不得不与他们当邻居，等我重振了家业，他们就连我脚后跟都摸不着了！"
                }
            ]
        }
    ]
}