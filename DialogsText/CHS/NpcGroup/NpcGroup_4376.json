    "talks": [
        {
            "talkId": "6437601",
            "initDialog": "643760101",
            "dialogues": [
                {
                    "id": "643760101",
                    "speaker": "莎莎妮",
                    "text": "这就是…学长的杰作…"
                }
            ]
        },
        {
            "talkId": "6437602",
            "initDialog": "643760201",
            "dialogues": [
                {
                    "id": "643760201",
                    "speaker": "Player",
                    "text": "「学长」？"
                },
                {
                    "id": "643760202",
                    "speaker": "莎莎妮",
                    "text": "没错，设计出此等杰作的人，便是我的学长。"
                },
                {
                    "id": "643760203",
                    "speaker": "莎莎妮",
                    "text": "…虽说是学长，但非常遗憾，在我入学的时候，卡维先生早已毕业了。"
                },
                {
                    "id": "643760204",
                    "speaker": "莎莎妮",
                    "text": "所以我并没有亲自与他交谈的荣幸，甚至都没能听他讲过一次建筑选修课。"
                },
                {
                    "id": "643760205",
                    "speaker": "莎莎妮",
                    "text": "唔…卡维先生这么厉害，现在一定名利双收，在哪里高就了吧…"
                }
            ]
        },
        {
            "talkId": "6437603",
            "initDialog": "643760301",
            "dialogues": [
                {
                    "id": "643760301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643760302",
                    "speaker": "莎莎妮",
                    "text": "什么时候…我才能…"
                }
            ]
        }
    ]
}