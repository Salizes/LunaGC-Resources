{
    "groupId": "6088",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 4,
        "阿基约": 20
    },
    "talks": [
        {
            "talkId": "6608801",
            "initDialog": "660880101",
            "dialogues": [
                {
                    "id": "660880101",
                    "speaker": "阿基约",
                    "text": "虽然不知道是怎么办到的，但好像还挺成功的！"
                }
            ]
        },
        {
            "talkId": "6608802",
            "initDialog": "660880201",
            "dialogues": [
                {
                    "id": "660880201",
                    "speaker": "Player",
                    "text": "你是说…"
                },
                {
                    "id": "660880202",
                    "speaker": "阿基约",
                    "text": "哦哦，我是说「古人的智慧」！"
                },
                {
                    "id": "660880203",
                    "speaker": "阿基约",
                    "text": "自从和这位须弥的小姐结伴挖掘遗迹，我挖到了不少宝贝，能用的工具可是越来越多了。"
                },
                {
                    "id": "660880204",
                    "speaker": "阿基约",
                    "text": "你见过能够三倍压缩燃素的储存器吗？有了它，我的龙跑得可快了！"
                },
                {
                    "id": "660880205",
                    "speaker": "阿基约",
                    "text": "虽然不知道是怎么个原理，但感觉真挺不错的。塔莫蕾小姐说不用深究，有时科学就是如此。"
                },
                {
                    "id": "660880206",
                    "speaker": "阿基约",
                    "text": "你说，照这样下去，我是不是也能报名「归火圣夜巡礼」了？"
                },
                {
                    "id": "660880207",
                    "speaker": "阿基约",
                    "text": "不过契约优先，我还是先完成塔莫蕾小姐交给我的任务吧。"
                }
            ]
        },
        {
            "talkId": "6608803",
            "initDialog": "660880301",
            "dialogues": [
                {
                    "id": "660880301",
                    "speaker": "Player",
                    "text": "恭喜。"
                },
                {
                    "id": "660880302",
                    "speaker": "阿基约",
                    "text": "多谢，多谢，虽然还是摸不着头脑，哈哈…"
                }
            ]
        },
        {
            "talkId": "6608804",
            "initDialog": "660880401",
            "dialogues": [
                {
                    "id": "660880401",
                    "speaker": "Player",
                    "text": "你是说…"
                },
                {
                    "id": "660880402",
                    "speaker": "阿基约",
                    "text": "哦哦，我是说「古人的智慧」！"
                },
                {
                    "id": "660880403",
                    "speaker": "阿基约",
                    "text": "自从和这位须弥的小姐结伴挖掘遗迹，我挖到了不少宝贝，能用的工具可是越来越多了。"
                },
                {
                    "id": "660880404",
                    "speaker": "阿基约",
                    "text": "你见过能够三倍压缩燃素的储存器吗？有了它，我的龙跑得可快了，追魔物和搬材料都不在话下！"
                },
                {
                    "id": "660880405",
                    "speaker": "阿基约",
                    "text": "虽然不知道是怎么个原理，但感觉真挺不错的。塔莫蕾小姐说不用深究，有时科学就是如此。"
                },
                {
                    "id": "660880406",
                    "speaker": "阿基约",
                    "text": "后来我和我的龙还去其他部族送过几次物资，经常不在这里…哎，多谢塔莫蕾小姐的帮助，希望不会太耽误她的研究进度。"
                }
            ]
        },
        {
            "talkId": "6608805",
            "initDialog": "660880501",
            "dialogues": [
                {
                    "id": "660880501",
                    "speaker": "阿基约",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6608806",
            "initDialog": "660880601",
            "dialogues": [
                {
                    "id": "660880601",
                    "speaker": "阿基约",
                    "text": "欸？我竟然赢了吗？虽然我也不知道是怎么做到的，哈哈…"
                }
            ]
        },
        {
            "talkId": "6608807",
            "initDialog": "660880701",
            "dialogues": [
                {
                    "id": "660880701",
                    "speaker": "阿基约",
                    "text": "唔——输了吗。唉，这也是预料之中的事情。"
                }
            ]
        },
        {
            "talkId": "7590101",
            "initDialog": "759010101",
            "dialogues": [
                {
                    "id": "759010101",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "759010102",
                    "speaker": "阿基约",
                    "text": "多谢，多谢！"
                },
                {
                    "id": "759010103",
                    "speaker": "阿基约",
                    "text": "虽然我也希望能找到更多有用的宝藏，不过光目前的成果就够我研究一阵了。"
                },
                {
                    "id": "759010104",
                    "speaker": "阿基约",
                    "text": "哦对了，塔莫蕾小姐说等教令院的人来了我们最好先不要张扬，因为是擅自提前出发的。"
                },
                {
                    "id": "759010105",
                    "speaker": "阿基约",
                    "text": "看来科研和比赛也有共同点，机会都留给了时刻准备出发的人。"
                }
            ]
        }
    ]
}