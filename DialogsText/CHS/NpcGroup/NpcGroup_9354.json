{
    "groupId": "9354",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "赛诺": 9
    },
    "talks": [
        {
            "talkId": "6935401",
            "initDialog": "693540101",
            "dialogues": [
                {
                    "id": "693540101",
                    "speaker": "赛诺",
                    "text": "这里能看的故事还挺多，不过，要记得看完之后放回书架，千万别放在桌上的盘子里。"
                },
                {
                    "id": "693540102",
                    "speaker": "赛诺",
                    "text": "嗯？你问为什么？"
                },
                {
                    "id": "693540103",
                    "speaker": "赛诺",
                    "text": "很简单，因为那样的话，可能会「满盘皆输{RUBY#[D]书}」！"
                }
            ]
        },
        {
            "talkId": "6935402",
            "initDialog": "693540201",
            "dialogues": [
                {
                    "id": "693540201",
                    "speaker": "赛诺",
                    "text": "我作为大风纪官，必须展示教令的威严，面对任何敌人我都会全力以赴。"
                },
                {
                    "id": "693540202",
                    "speaker": "赛诺",
                    "text": "对战就如同审判，代表正义的必须是胜者，每一场战斗都要审慎处理。"
                },
                {
                    "id": "693540203",
                    "speaker": "赛诺",
                    "text": "有此维护规则的觉悟，自可战无不胜。"
                }
            ]
        },
        {
            "talkId": "6935403",
            "initDialog": "693540301",
            "dialogues": [
                {
                    "id": "693540301",
                    "speaker": "赛诺",
                    "text": "我一直认为，书籍是一项伟大的发明。"
                },
                {
                    "id": "693540302",
                    "speaker": "赛诺",
                    "text": "任何律法，一旦写进书里，编撰为法典，便不只存在于立法者的口述中，而成为独立的存在。由此，才有执行「审判」的可能。"
                },
                {
                    "id": "693540303",
                    "speaker": "赛诺",
                    "text": "因为「审判」必须能够平等地降临到每个人身上，包括立法者本身。"
                }
            ]
        }
    ]
}