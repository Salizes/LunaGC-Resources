            "dialogues": [
                {
                    "id": "653180101",
                    "speaker": "嘉莱娜",
                    "text": "啊，趁着瑟琪前辈这次回村度假，我一定要向前辈讨教通过考核，加入「逐影庭」的方法！"
                }
            ]
        },
        {
            "talkId": "6531802",
            "initDialog": "653180201",
            "dialogues": [
                {
                    "id": "653180201",
                    "speaker": "Player",
                    "text": "原来还要考核哦…"
                },
                {
                    "id": "653180202",
                    "speaker": "嘉莱娜",
                    "text": "那当然啦！你以为「逐影庭」是谁都能去的地方吗？"
                },
                {
                    "id": "653180203",
                    "speaker": "嘉莱娜",
                    "text": "正是因为考核的严格，所以能通过考核才了不起，哼，必须得抓住瑟琪前辈度假的机会，好好问清楚！"
                },
                {
                    "id": "653180204",
                    "speaker": "嘉莱娜",
                    "text": "嘿嘿，等我通过考核，一定要向薇尔妲好好炫耀一番！"
                }
            ]
        },
        {
            "talkId": "6531803",
            "initDialog": "653180301",
            "dialogues": [
                {
                    "id": "653180301",
                    "speaker": "Player",
                    "text": "希望你成功！"
                },
                {
                    "id": "653180302",
                    "speaker": "嘉莱娜",
                    "text": "哼，谢谢！不过不需要你希望我也会成功的啦！"
                }
            ]
        }
