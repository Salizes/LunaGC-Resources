{
    "groupId": "6391",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "加莫莉": 8
    },
    "talks": [
        {
            "talkId": "6639101",
            "initDialog": "663910101",
            "dialogues": [
                {
                    "id": "663910101",
                    "speaker": "加莫莉",
                    "text": "嗯…今天的营养餐该怎么搭配才好呢？"
                }
            ]
        },
        {
            "talkId": "6639102",
            "initDialog": "663910201",
            "dialogues": [
                {
                    "id": "663910201",
                    "speaker": "Player",
                    "text": "营养餐？"
                },
                {
                    "id": "663910202",
                    "speaker": "加莫莉",
                    "text": "是呀。真是的，不要露出那种表情嘛。「营养餐」又不一定是很难吃的东西。"
                },
                {
                    "id": "663910203",
                    "speaker": "加莫莉",
                    "text": "只要是根据身体的需要来搭配，什么食物都能被称作营养餐喔。毕竟，不同人需要的营养本来也不一样。"
                },
                {
                    "id": "663910204",
                    "speaker": "加莫莉",
                    "text": "倒不如说，如果真的做得很难吃的话，也不能算是「健康营养」吧？"
                },
                {
                    "id": "663910205",
                    "speaker": "加莫莉",
                    "text": "总之，我现在就在思考，今天究竟是吃薄荷酱烤鱼搭配粒果片片呢，还是选择火山焖饭加炖肉呢…"
                }
            ]
        },
        {
            "talkId": "6639103",
            "initDialog": "663910301",
            "dialogues": [
                {
                    "id": "663910301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "663910302",
                    "speaker": "加莫莉",
                    "text": "嗯，再见。祝你今天也过得愉快。"
                }
            ]
        },
        {
            "talkId": "7595001",
            "initDialog": "759500101",
            "dialogues": [
                {
                    "id": "759500101",
                    "speaker": "Player",
                    "text": "有什么推荐的餐点吗？"
                },
                {
                    "id": "759500102",
                    "speaker": "加莫莉",
                    "text": "推荐的餐点啊…嗯，你应该还不是很饿吧。这样的话，要不要来尝尝我们的「粒果膨膨棒」？"
                },
                {
                    "id": "759500103",
                    "speaker": "加莫莉",
                    "text": "既健康又美味，而且做起来也相当方便！这一顿就算是我请啦，「营养餐」才不是什么可怕的东西！"
                }
            ]
        }
    ]
}