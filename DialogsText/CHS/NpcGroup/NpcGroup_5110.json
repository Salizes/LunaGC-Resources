    },
    "talks": [
        {
            "talkId": "6511001",
            "initDialog": "651100101",
            "dialogues": [
                {
                    "id": "651100101",
                    "speaker": "露泽妮",
                    "text": "欢迎来到欧庇克莱歌剧院，这个可以给您带来丰富体验的圣地。"
                }
            ]
        },
        {
            "talkId": "6511002",
            "initDialog": "651100201",
            "dialogues": [
                {
                    "id": "651100201",
                    "speaker": "Player",
                    "text": "「丰富体验」？"
                },
                {
                    "id": "651100202",
                    "speaker": "露泽妮",
                    "text": "平淡、荒谬、惊喜与悲伤…只要您造访的次数足够多，这些都是您能在欧庇克莱歌剧院体验到的经历。"
                },
                {
                    "id": "651100203",
                    "speaker": "露泽妮",
                    "text": "有人热衷于观看真实案件中的人情冷暖，有人更喜欢戏剧创作中的演绎与传颂。"
                },
                {
                    "id": "651100204",
                    "speaker": "露泽妮",
                    "text": "而这二者都被水之神芙卡洛斯认可，得以在歌剧院中上演。"
                }
            ]
        },
        {
            "talkId": "6511003",
            "initDialog": "651100301",
            "dialogues": [
                {
                    "id": "651100301",
                    "speaker": "Player",
                    "text": "「圣地」？"
                },
                {
                    "id": "651100302",
                    "speaker": "露泽妮",
                    "text": "欧庇克莱歌剧院的创立者即为水之神，也就是人们口中的芙宁娜大人。"
                },
                {
                    "id": "651100303",
                    "speaker": "露泽妮",
                    "text": "神明建立的地方，难道不应被称作圣地吗？"
                }
            ]
        },
        {
            "talkId": "6511004",
            "initDialog": "651100401",
            "dialogues": [
                {
                    "id": "651100401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651100402",
                    "speaker": "露泽妮",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6511005",
            "initDialog": "651100501",
            "dialogues": [
                {
                    "id": "651100501",
                    "speaker": "Player",
                    "text": "「丰富体验」？"
                },
                {
                    "id": "651100502",
                    "speaker": "露泽妮",
                    "text": "欧庇克莱歌剧院是戏剧与庭审的并存之地，二者都被歌剧院的创立者芙卡洛斯认可，得以在歌剧院中上演。"
                },
                {
                    "id": "651100503",
                    "speaker": "露泽妮",
                    "text": "平淡、荒谬、惊喜与悲伤…只要您造访的次数足够多，这些都是您能在欧庇克莱歌剧院体验到的经历。"
                },
                {
                    "id": "651100504",
                    "speaker": "露泽妮",
                    "text": "有人热衷于观看真实案件中的人情冷暖，有人更喜欢戏剧创作中的演绎与传颂。"
                },
                {
                    "id": "651100505",
                    "speaker": "露泽妮",
                    "text": "不过当案件获得判决、戏剧得以谢幕之后，还请大家回到现实，冷静评判其中的对错吧。"
                }
            ]
        },
        {
            "talkId": "6511006",
            "initDialog": "651100601",
            "dialogues": [
                {
                    "id": "651100601",
                    "speaker": "Player",
                    "text": "「圣地」？"
                },
                {
                    "id": "651100602",
                    "speaker": "露泽妮",
                    "text": "欧庇克莱歌剧院的创立者即为水之神，也就是现在人们口中的芙宁娜女士。"
                },
                {
                    "id": "651100603",
                    "speaker": "露泽妮",
                    "text": "神明建立的地方，难道不应被称作圣地吗？"
                },
                {
                    "id": "651100604",
                    "speaker": "露泽妮",
                    "text": "虽然芙宁娜女士已经为枫丹所需的能源耗尽了神力，我们也应当谨记她的付出。"
                }
            ]
        }
    ]
}