{
    "groupId": "2304",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "东东": 13
    },
    "talks": [
        {
            "talkId": "6230404",
            "initDialog": "623040401",
            "dialogues": [
                {
                    "id": "623040401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6230405",
            "initDialog": "623040501",
            "dialogues": [
                {
                    "id": "623040501",
                    "speaker": "东东",
                    "text": "我打赢了庄外的人！爸爸要是知道了，一定会夸我厉害的！"
                }
            ]
        },
        {
            "talkId": "6230406",
            "initDialog": "623040601",
            "dialogues": [
                {
                    "id": "623040601",
                    "speaker": "东东",
                    "text": "好厉害，根本打不过你…请你别把打赢我的事告诉别人啊，尤其是南十字船队的船员！"
                }
            ]
        },
        {
            "talkId": "7192501",
            "initDialog": "719250101",
            "dialogues": [
                {
                    "id": "719250101",
                    "speaker": "Player",
                    "text": "加油，祝你成功。"
                },
                {
                    "id": "719250102",
                    "speaker": "东东",
                    "text": "谢谢！你是庄里为数不多会鼓励我的人呢！"
                },
                {
                    "id": "719250103",
                    "speaker": "东东",
                    "text": "庄里的大人说我一定不会成为爸爸那样的大英雄的，因为我不爱喝牛奶…"
                },
                {
                    "id": "719250104",
                    "speaker": "东东",
                    "text": "…谁说成为大英雄就一定要喝牛奶的…那个味道实在是太奇怪了。"
                },
                {
                    "id": "719250105",
                    "speaker": "东东",
                    "text": "可是全倒掉的话又有些可惜…要不然，你拿走吧？"
                },
                {
                    "id": "719250106",
                    "speaker": "东东",
                    "text": "嘘，不要和别人说啊！"
                }
            ]
        },
        {
            "talkId": "6230401",
            "initDialog": "623040101",
            "dialogues": [
                {
                    "id": "623040101",
                    "speaker": "东东",
                    "text": "哇，看你的样子是旅行者对吧？！"
                }
            ]
        },
        {
            "talkId": "6230402",
            "initDialog": "623040201",
            "dialogues": [
                {
                    "id": "623040201",
                    "speaker": "Player",
                    "text": "是的。"
                },
                {
                    "id": "623040202",
                    "speaker": "东东",
                    "text": "呜哇，好厉害！那你肯定去过很多地方，见识过很多了不起的事情吧！"
                },
                {
                    "id": "623040203",
                    "speaker": "东东",
                    "text": "我爸爸他是南十字船队的船员，和伙伴一起游历各国，每天都在冒险，是个大英雄！"
                },
                {
                    "id": "623040204",
                    "speaker": "东东",
                    "text": "虽然他很少回家，但他每次都会写信把路上最刺激的事告诉我，嘿嘿。"
                },
                {
                    "id": "623040205",
                    "speaker": "东东",
                    "text": "再过几年，我也要去南十字船队，到时候就能亲眼见识那些厉害的东西啦！"
                }
            ]
        },
        {
            "talkId": "6230403",
            "initDialog": "623040301",
            "dialogues": [
                {
                    "id": "623040301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "623040302",
                    "speaker": "东东",
                    "text": "再见，祝你也能像我爸爸那么厉害，嘿嘿。"
                }
            ]
        }
    ]
}