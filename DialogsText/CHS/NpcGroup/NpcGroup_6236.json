    "talks": [
        {
            "talkId": "6623601",
            "initDialog": "662360101",
            "dialogues": [
                {
                    "id": "662360101",
                    "speaker": "卡帕可",
                    "text": "哈！嘿！"
                },
                {
                    "id": "662360102",
                    "speaker": "卡帕可",
                    "text": "我说，你有没有在帮我数数呀？"
                },
                {
                    "id": "662360103",
                    "speaker": "娅特兰",
                    "text": "当然！我家可是做生意的，怎么可能连数都数不清？"
                },
                {
                    "id": "662360104",
                    "speaker": "娅特兰",
                    "text": "加油，还差三分之一就能完成训练任务咯。"
                },
                {
                    "id": "662360105",
                    "speaker": "卡帕可",
                    "text": "三分之一是…多少来着？"
                },
                {
                    "id": "662360106",
                    "speaker": "娅特兰",
                    "text": "…哎呀，别算了，我帮你记着呢，你就只管锻炼好了。"
                },
                {
                    "id": "662360107",
                    "speaker": "娅特兰",
                    "text": "抓紧时间！完成后就能一起去吃火山蛋糕了！"
                },
                {
                    "id": "662360108",
                    "speaker": "卡帕可",
                    "text": "嗯！训练结束的火山蛋糕是最好吃的！"
                },
                {
                    "id": "662360109",
                    "speaker": "娅特兰",
                    "text": "错啦！火山蛋糕，明明任何时候都很好吃！"
                }
            ]
        }
    ]
}