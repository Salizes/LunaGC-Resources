    "talks": [
        {
            "talkId": "6506801",
            "initDialog": "650680101",
            "dialogues": [
                {
                    "id": "650680101",
                    "speaker": "莉塞特",
                    "text": "接下来去哪里冒险呢？"
                }
            ]
        },
        {
            "talkId": "6506802",
            "initDialog": "650680201",
            "dialogues": [
                {
                    "id": "650680201",
                    "speaker": "Player",
                    "text": "冒险？"
                },
                {
                    "id": "650680202",
                    "speaker": "莉塞特",
                    "text": "嗯！这里的冒险好开心，大家都对我很好，特别是刺玫会的哥哥姐姐们。"
                }
            ]
        },
        {
            "talkId": "6506803",
            "initDialog": "650680301",
            "dialogues": [
                {
                    "id": "650680301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650680302",
                    "speaker": "莉塞特",
                    "text": "嗯，再见！"
                }
            ]
        },
        {
            "talkId": "6506804",
            "initDialog": "650680401",
            "dialogues": [
                {
                    "id": "650680401",
                    "speaker": "Player",
                    "text": "你原本不是这里的人？"
                },
                {
                    "id": "650680402",
                    "speaker": "莉塞特",
                    "text": "呃…我，我不记得了。"
                },
                {
                    "id": "650680403",
                    "speaker": "莉塞特",
                    "text": "有一天醒来的时候，我就已经在这里了。可能…是被爸爸妈妈抛弃了吧。"
                }
            ]
        },
        {
            "talkId": "6506805",
            "initDialog": "650680501",
            "dialogues": [
                {
                    "id": "650680501",
                    "speaker": "Player",
                    "text": "不是你的错。"
                },
                {
                    "id": "650680502",
                    "speaker": "莉塞特",
                    "text": "我知道，因为这里的哥哥姐姐们也是这么告诉我的。"
                },
                {
                    "id": "650680503",
                    "speaker": "莉塞特",
                    "text": "大家都很友善，我生活得很开心，就算不回去…我是说不离开这里也行！"
                }
            ]
        }
    ]
}