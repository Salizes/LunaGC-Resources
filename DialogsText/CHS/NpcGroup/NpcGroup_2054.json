{
    "groupId": "2054",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "石头": 26
    },
    "talks": [
        {
            "talkId": "6205407",
            "initDialog": "620540701",
            "dialogues": [
                {
                    "id": "620540701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6205408",
            "initDialog": "620540801",
            "dialogues": [
                {
                    "id": "620540801",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6205409",
            "initDialog": "620540901",
            "dialogues": [
                {
                    "id": "620540901",
                    "speaker": "石头",
                    "text": "可以啊，客官，没想到被您给轻松挑过了，了不得。"
                }
            ]
        },
        {
            "talkId": "6205410",
            "initDialog": "620541001",
            "dialogues": [
                {
                    "id": "620541001",
                    "speaker": "石头",
                    "text": "嘿嘿，看来客官您还要多试试，下次再来啊！"
                }
            ]
        },
        {
            "talkId": "6205411",
            "initDialog": "620541101",
            "dialogues": [
                {
                    "id": "620541101",
                    "speaker": "石头",
                    "text": "客官您运气不错啊，今天一定能走大运，玩完牌顺便买块璞石吧！"
                }
            ]
        },
        {
            "talkId": "6205412",
            "initDialog": "620541201",
            "dialogues": [
                {
                    "id": "620541201",
                    "speaker": "石头",
                    "text": "客官，看来您今天的运气不在玩牌上，哎，就得在刚输的时候开璞石，不如来一块？"
                }
            ]
        },
        {
            "talkId": "7191201",
            "initDialog": "719120101",
            "dialogues": [
                {
                    "id": "719120101",
                    "speaker": "Player",
                    "text": "开出来的概率大吗？"
                },
                {
                    "id": "719120102",
                    "speaker": "石头",
                    "text": "哎哟，客官您这话问的，我要是能说准了，那大家还玩什么啊？"
                },
                {
                    "id": "719120103",
                    "speaker": "石头",
                    "text": "…而且就算开不出玉石，也能开出点别的东西不是吗？"
                },
                {
                    "id": "719120104",
                    "speaker": "石头",
                    "text": "这不，前两天刚有个大老板从里面开出了几块矿石，看都不看就扔给我了，可这些搁我这儿也是占地儿啊…"
                },
                {
                    "id": "719120105",
                    "speaker": "石头",
                    "text": "要不，您有用就拿去？以后多来光顾我的生意就行了，哈哈哈…"
                }
            ]
        },
        {
            "talkId": "6205401",
            "initDialog": "620540101",
            "dialogues": [
                {
                    "id": "620540101",
                    "speaker": "石头",
                    "text": "客官，看你满面红光，今天一定要走大运！"
                },
                {
                    "id": "620540102",
                    "speaker": "石头",
                    "text": "怎么样，买块璞石试试手气？"
                }
            ]
        },
        {
            "talkId": "6205402",
            "initDialog": "620540201",
            "dialogues": [
                {
                    "id": "620540201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "620540202",
                    "speaker": "石头",
                    "text": "怎么，客官第一次来「解翠行」？"
                },
                {
                    "id": "620540203",
                    "speaker": "石头",
                    "text": "我们这儿几代以来都经营珠宝玉器，在璃月，招牌也打得很响亮。"
                },
                {
                    "id": "620540204",
                    "speaker": "石头",
                    "text": "可是最近行业不景气啊，总务司把原料产地的「层岩巨渊」给封锁了。"
                },
                {
                    "id": "620540205",
                    "speaker": "石头",
                    "text": "所以现在原料反而快比产品值钱了…我就想不如直接把璞石拿来卖，刺激、好玩、又说不准能赚钱…"
                },
                {
                    "id": "620540206",
                    "speaker": "石头",
                    "text": "现在我那群经常一起打牌的朋友都会来店里买璞石，生意也比同行「明星斋」要好得多了哈哈…"
                }
            ]
        },
        {
            "talkId": "6205403",
            "initDialog": "620540301",
            "dialogues": [
                {
                    "id": "620540301",
                    "speaker": "Player",
                    "text": "关于璞石…"
                },
                {
                    "id": "620540302",
                    "speaker": "石头",
                    "text": "客官看来是没玩过啊，真稀罕呢。"
                },
                {
                    "id": "620540303",
                    "speaker": "石头",
                    "text": "这些璞石都是「层岩巨渊」出产的存货，上等的玉石原料，您随便挑着买一块。"
                },
                {
                    "id": "620540304",
                    "speaker": "石头",
                    "text": "「孰知石中玉有无，一刀切开知赢输。」"
                },
                {
                    "id": "620540305",
                    "speaker": "石头",
                    "text": "您也别怕钱打了水漂，这业内还有一句话——"
                },
                {
                    "id": "620540306",
                    "speaker": "石头",
                    "text": "「今天不来明天来，总有一天好运来！」"
                }
            ]
        },
        {
            "talkId": "6205404",
            "initDialog": "620540401",
            "dialogues": [
                {
                    "id": "620540401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620540402",
                    "speaker": "石头",
                    "text": "这就走了吗客官，别与好运擦肩而过哦。"
                }
            ]
        },
        {
            "talkId": "6205405",
            "initDialog": "620540501",
            "dialogues": [
                {
                    "id": "620540501",
                    "speaker": "Player",
                    "text": "你这里除了璞石还卖什么吗？"
                },
                {
                    "id": "620540502",
                    "speaker": "石头",
                    "text": "来，您请便！这些都是从璞石里开出来的，虽然不是翡翠，但说不定能入了您的眼呢！"
                }
            ]
        },
        {
            "talkId": "6205406",
            "initDialog": "620540601",
            "dialogues": [
                {
                    "id": "620540601",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620540602",
                    "speaker": "石头",
                    "text": "唉，岩王爷一路走好了…"
                },
                {
                    "id": "620540603",
                    "speaker": "石头",
                    "text": "不过伤心归伤心，我们也得好好活着不是？"
                },
                {
                    "id": "620540604",
                    "speaker": "石头",
                    "text": "我在考虑要不要把在送仙典仪上用到的那种夜泊石改个名，以此来纪念岩王爷。"
                },
                {
                    "id": "620540605",
                    "speaker": "石头",
                    "text": "你说是叫「送仙石」好，还是叫「别神石」好呢？好像两个都不错啊…"
                }
            ]
        }
    ]
}