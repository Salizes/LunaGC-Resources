{
    "groupId": "9351",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "提纳里": 9
    },
    "talks": [
        {
            "talkId": "6935101",
            "initDialog": "693510101",
            "dialogues": [
                {
                    "id": "693510101",
                    "speaker": "提纳里",
                    "text": "这里的气味…十分混杂，看来接待过不少需要休息的人呢。"
                },
                {
                    "id": "693510102",
                    "speaker": "提纳里",
                    "text": "你说你闻到了花草的气息？"
                },
                {
                    "id": "693510103",
                    "speaker": "提纳里",
                    "text": "这个嘛，应该是我刚刚用过的植物精油吧。怎么样，想不想感受下我新鲜打理后的尾巴？"
                }
            ]
        },
        {
            "talkId": "6935102",
            "initDialog": "693510201",
            "dialogues": [
                {
                    "id": "693510201",
                    "speaker": "提纳里",
                    "text": "就像很多知识要通过尝试来获取，很多胜利也要通过挑战来达成。"
                },
                {
                    "id": "693510202",
                    "speaker": "提纳里",
                    "text": "挑战秘境，大概也是求知求真的一种形式吧。"
                },
                {
                    "id": "693510203",
                    "speaker": "提纳里",
                    "text": "当然，专业的事情我还是推荐专业的人来做就是了。"
                }
            ]
        },
        {
            "talkId": "6935103",
            "initDialog": "693510301",
            "dialogues": [
                {
                    "id": "693510301",
                    "speaker": "提纳里",
                    "text": "可能大家会觉得，学术是严肃和严谨的，所以学者们多半不喜欢故事书。"
                },
                {
                    "id": "693510302",
                    "speaker": "提纳里",
                    "text": "但实际上，思维不活跃的人很容易陷入研究的瓶颈。"
                },
                {
                    "id": "693510303",
                    "speaker": "提纳里",
                    "text": "故事虽然是杜撰的，但没准能提供研究上的灵感呢？"
                }
            ]
        }
    ]
}