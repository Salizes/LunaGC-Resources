{
    "groupId": "20392",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 1,
        "鲸井小弟": 15
    },
    "talks": [
        {
            "talkId": "7218710",
            "initDialog": "721871001",
            "dialogues": [
                {
                    "id": "721871001",
                    "speaker": "鲸井小弟",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}真厉害，连我们鲸井兄弟的「鲸井御殿流手鞠术」都被破解了。",
                    "choices": [
                        {
                            "id": "721871002",
                            "text": "关于手鞠的玩法…",
                            "response": [
                                {
                                    "id": "721871003",
                                    "speaker": "鲸井小弟",
                                    "text": "找手鞠的话，需要在限定时间内找到别人藏的手鞠就赢了。"
                                },
                                {
                                    "id": "721871004",
                                    "speaker": "鲸井小弟",
                                    "text": "要藏手鞠的话，也要在同样的限定时间内，把手鞠藏起来。这样对找的人才公平嘛。冒险家大姐姐说过，游戏公平很重要！"
                                }
                            ]
                        },
                        {
                            "id": "721871005",
                            "text": "关于你自己…",
                            "response": [
                                {
                                    "id": "721871006",
                                    "speaker": "鲸井小弟",
                                    "text": "嗯，怎么了吗？",
                                    "choices": [
                                        {
                                            "id": "721871007",
                                            "text": "「鲸井御殿流手鞠术」？",
                                            "response": [
                                                {
                                                    "id": "721871008",
                                                    "speaker": "鲸井小弟",
                                                    "text": "啊，是我们在涉川爷爷的提点下，自创的流派。目的是用手鞠开发出无敌的武术。"
                                                },
                                                {
                                                    "id": "721871009",
                                                    "speaker": "鲸井小弟",
                                                    "text": "如果能用各种办法把会爆炸的手鞠送到敌人身边，那我们就能不战而胜！"
                                                },
                                                {
                                                    "id": "721871010",
                                                    "speaker": "派蒙",
                                                    "text": "我很确信手鞠不是这么玩的…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721871011",
                                            "text": "鲸井家到底有多少人？",
                                            "response": [
                                                {
                                                    "id": "721871012",
                                                    "speaker": "鲸井小弟",
                                                    "text": "唔…我想想…"
                                                },
                                                {
                                                    "id": "721871013",
                                                    "speaker": "鲸井小弟",
                                                    "text": "除了爸爸妈妈以外，我们最上面有一个姐姐，叫椛。以前她经常陪我们玩。"
                                                },
                                                {
                                                    "id": "721871014",
                                                    "speaker": "鲸井小弟",
                                                    "text": "但自从她迷上钓鱼以后，就不愿意陪我们玩了。还说我们会把鱼吓跑！"
                                                },
                                                {
                                                    "id": "721871015",
                                                    "speaker": "鲸井小弟",
                                                    "text": "然后…我们几兄弟到底有多少人呢？说实话我也分不清楚…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721871016",
                                            "text": "之前说的冒险家…",
                                            "response": [
                                                {
                                                    "id": "721871017",
                                                    "speaker": "鲸井小弟",
                                                    "text": "是个很厉害的冒险家姐姐！"
                                                },
                                                {
                                                    "id": "721871018",
                                                    "speaker": "鲸井小弟",
                                                    "text": "她教我们怎么玩手鞠、怎么唱手鞠歌，还教我们用手鞠把坏人「轰」地炸飞！"
                                                },
                                                {
                                                    "id": "721871019",
                                                    "speaker": "鲸井小弟",
                                                    "text": "最后她走的时候说，自己要去好远好远的地方，做很重要的事情。"
                                                },
                                                {
                                                    "id": "721871020",
                                                    "speaker": "鲸井小弟",
                                                    "text": "所以我们要研究「手鞠术」，以后给她帮忙！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721871021",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "721871022",
                                    "speaker": "鲸井小弟",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}再见！如果遇到我的兄弟和姐姐，帮我打个招呼噢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}