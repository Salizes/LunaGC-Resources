{
    "groupId": "7663",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "叶洛亚": 2,
        "罗洛": 8
    },
    "talks": [
        {
            "talkId": "6766301",
            "initDialog": "676630101",
            "dialogues": [
                {
                    "id": "676630101",
                    "speaker": "罗洛",
                    "text": "保持专注。狂猎随时可能卷土重来。"
                }
            ]
        },
        {
            "talkId": "6766302",
            "initDialog": "676630201",
            "dialogues": [
                {
                    "id": "676630201",
                    "speaker": "Player",
                    "text": "关于狂猎…"
                },
                {
                    "id": "676630202",
                    "speaker": "罗洛",
                    "text": "这里的狂猎和别处不同，非常危险，一旦放松警惕，它们就会趁虚而入。"
                },
                {
                    "id": "676630203",
                    "speaker": "罗洛",
                    "text": "即便我们现在已经知道它们的能力，也还是有可能中招，实在是防不胜防。"
                },
                {
                    "id": "676630204",
                    "speaker": "罗洛",
                    "text": "三年前，我的哥哥在调查任务中毫无防备地遭遇了它们的袭击，多亏队友相救才留下了性命…"
                },
                {
                    "id": "676630205",
                    "speaker": "罗洛",
                    "text": "总之，要对付它们，必须时刻保持专注。"
                }
            ]
        },
        {
            "talkId": "6766303",
            "initDialog": "676630301",
            "dialogues": [
                {
                    "id": "676630301",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>叶洛亚</color>似乎有话要说…？）"
                },
                {
                    "id": "676630302",
                    "speaker": "叶洛亚",
                    "text": "辛苦了，有什么需要我注意的吗？"
                },
                {
                    "id": "676630303",
                    "speaker": "罗洛",
                    "text": "队长，暂时没什么需要你操心的，这里交给我们就好。"
                },
                {
                    "id": "676630304",
                    "speaker": "叶洛亚",
                    "text": "那就有劳了。"
                },
                {
                    "id": "676630305",
                    "speaker": "罗洛",
                    "text": "哪里的话，这都是我的分内之事。"
                }
            ]
        },
        {
            "talkId": "6766304",
            "initDialog": "676630401",
            "dialogues": [
                {
                    "id": "676630401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676630402",
                    "speaker": "罗洛",
                    "text": "路上小心。"
                }
            ]
        }
    ]
}