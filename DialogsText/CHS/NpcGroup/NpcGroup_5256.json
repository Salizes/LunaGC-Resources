{
    "groupId": "5256",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "沙尔梅": 9
    },
    "talks": [
        {
            "talkId": "6525601",
            "initDialog": "652560101",
            "dialogues": [
                {
                    "id": "652560101",
                    "speaker": "沙尔梅",
                    "text": "呼…又整理完一批资料，进度还算不错。"
                }
            ]
        },
        {
            "talkId": "6525602",
            "initDialog": "652560201",
            "dialogues": [
                {
                    "id": "652560201",
                    "speaker": "Player",
                    "text": "你在这里做什么呢？"
                },
                {
                    "id": "652560202",
                    "speaker": "沙尔梅",
                    "text": "荣誉高级研究员，很高兴见到你，我正按照雷蒙多先生的指示，在这里整理资料和卷宗呢。"
                },
                {
                    "id": "652560203",
                    "speaker": "沙尔梅",
                    "text": "这一处资料院受到爆炸的影响相对较小，建筑的内部结构几乎没有受到损伤，所以资料保存得也很完整。"
                },
                {
                    "id": "652560204",
                    "speaker": "沙尔梅",
                    "text": "虽然不知道这些资料有什么用…但先归档整理好总是没错的。"
                }
            ]
        },
        {
            "talkId": "6525603",
            "initDialog": "652560301",
            "dialogues": [
                {
                    "id": "652560301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652560302",
                    "speaker": "沙尔梅",
                    "text": "嗯，我接着整理资料去啦。"
                }
            ]
        },
        {
            "talkId": "6525604",
            "initDialog": "652560401",
            "dialogues": [
                {
                    "id": "652560401",
                    "speaker": "Player",
                    "text": "找到什么有价值的资料了吗？"
                },
                {
                    "id": "652560402",
                    "speaker": "沙尔梅",
                    "text": "大部分是一些过时的报告、通讯、项目进展通报之类的老旧文件。"
                },
                {
                    "id": "652560403",
                    "speaker": "沙尔梅",
                    "text": "但我也找到一些被临时中止的项目所留下的数据汇总集，甚至是项目研究详述。"
                },
                {
                    "id": "652560404",
                    "speaker": "沙尔梅",
                    "text": "现在的科学院正好在筹备重启研究工作的事，也许这些文件能够帮上忙。"
                },
                {
                    "id": "652560405",
                    "speaker": "沙尔梅",
                    "text": "总的来说，事情都在往好的方向发展，真是可喜可贺啊。"
                }
            ]
        }
    ]
}