{
    "groupId": "6003",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "娜玛卡": 7
    },
    "talks": [
        {
            "talkId": "6600301",
            "initDialog": "660030101",
            "dialogues": [
                {
                    "id": "660030101",
                    "speaker": "娜玛卡",
                    "text": "你好。这里是专门为鳍游龙设置的水池，所以对人来说水温可能有些高哦。"
                }
            ]
        },
        {
            "talkId": "6600302",
            "initDialog": "660030201",
            "dialogues": [
                {
                    "id": "660030201",
                    "speaker": "Player",
                    "text": "多谢提醒。"
                },
                {
                    "id": "660030202",
                    "speaker": "娜玛卡",
                    "text": "不用客气哦。"
                },
                {
                    "id": "660030203",
                    "speaker": "娜玛卡",
                    "text": "其实也不是完全不能让人泡啦，毕竟还是人工温泉，不像天然的那样「霸道」。"
                },
                {
                    "id": "660030204",
                    "speaker": "娜玛卡",
                    "text": "但如你所见，这附近空间有限，在远离天然水域的地方增设温泉又有些麻烦。"
                },
                {
                    "id": "660030205",
                    "speaker": "娜玛卡",
                    "text": "所以大家都不约而同地把地方让给这些龙啦。它们也喜欢在里面打滚休息，不会乱跑乱斗。"
                },
                {
                    "id": "660030206",
                    "speaker": "娜玛卡",
                    "text": "你想和它们玩玩吗？是可以的哦，但是不推荐打水仗，也不能影响边上的其他人。"
                }
            ]
        },
        {
            "talkId": "6600303",
            "initDialog": "660030301",
            "dialogues": [
                {
                    "id": "660030301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660030302",
                    "speaker": "娜玛卡",
                    "text": "嗯，小心地滑。"
                }
            ]
        }
    ]
}