{
    "groupId": "1798",
    "total_dialogue_lines": 43,
    "speaker_counts": {
        "Player": 14,
        "赫斯塔尔": 29
    },
    "talks": [
        {
            "talkId": "6179801",
            "initDialog": "617980101",
            "dialogues": [
                {
                    "id": "617980101",
                    "speaker": "赫斯塔尔",
                    "text": "再急也没用，喝杯茶再说吧。慢慢练技术，慢慢思考解法，总有一天会顿悟，找到灵感~"
                }
            ]
        },
        {
            "talkId": "6179802",
            "initDialog": "617980201",
            "dialogues": [
                {
                    "id": "617980201",
                    "speaker": "Player",
                    "text": "我还要练技术！"
                },
                {
                    "id": "617980202",
                    "speaker": "赫斯塔尔",
                    "text": "哇呀，你这是找到射击的乐趣了…"
                },
                {
                    "id": "617980203",
                    "speaker": "赫斯塔尔",
                    "text": "普通的演习大概已经满足不了你了，我去请一位好手来和你切磋切磋，如何？"
                }
            ]
        },
        {
            "talkId": "6179803",
            "initDialog": "617980301",
            "dialogues": [
                {
                    "id": "617980301",
                    "speaker": "Player",
                    "text": "好啊好啊！"
                },
                {
                    "id": "617980302",
                    "speaker": "赫斯塔尔",
                    "text": "那就这样办了，我马上去找乌苏拉！"
                }
            ]
        },
        {
            "talkId": "6179804",
            "initDialog": "617980401",
            "dialogues": [
                {
                    "id": "617980401",
                    "speaker": "Player",
                    "text": "现在还有事…"
                },
                {
                    "id": "617980402",
                    "speaker": "赫斯塔尔",
                    "text": "那就下次再说啦。"
                }
            ]
        },
        {
            "talkId": "6179805",
            "initDialog": "617980501",
            "dialogues": [
                {
                    "id": "617980501",
                    "speaker": "Player",
                    "text": "练技术！"
                },
                {
                    "id": "617980502",
                    "speaker": "赫斯塔尔",
                    "text": "啊呀，看来你随便试试，就找到了不错的射击手感，真是令人羡慕的天分啊…"
                },
                {
                    "id": "617980503",
                    "speaker": "赫斯塔尔",
                    "text": "要再来一轮射击演习吗？"
                }
            ]
        },
        {
            "talkId": "6179806",
            "initDialog": "617980601",
            "dialogues": [
                {
                    "id": "617980601",
                    "speaker": "Player",
                    "text": "没问题！"
                },
                {
                    "id": "617980602",
                    "speaker": "赫斯塔尔",
                    "text": "真干脆！那请你稍作等候，我马上就布置好…"
                }
            ]
        },
        {
            "talkId": "6179807",
            "initDialog": "617980701",
            "dialogues": [
                {
                    "id": "617980701",
                    "speaker": "Player",
                    "text": "现在还有事…"
                },
                {
                    "id": "617980702",
                    "speaker": "赫斯塔尔",
                    "text": "那就下次再说啦。"
                }
            ]
        },
        {
            "talkId": "6179808",
            "initDialog": "617980801",
            "dialogues": [
                {
                    "id": "617980801",
                    "speaker": "Player",
                    "text": "练技术？"
                },
                {
                    "id": "617980802",
                    "speaker": "赫斯塔尔",
                    "text": "嗯…对于你这样看起来像是战斗人员的例子而言，就是练习射术了。"
                },
                {
                    "id": "617980803",
                    "speaker": "赫斯塔尔",
                    "text": "优秀的射手都是子弹喂出来的，一天不练，枪法不进则退。"
                },
                {
                    "id": "617980804",
                    "speaker": "赫斯塔尔",
                    "text": "怎么，要不练上一轮，试试手感？"
                }
            ]
        },
        {
            "talkId": "6179809",
            "initDialog": "617980901",
            "dialogues": [
                {
                    "id": "617980901",
                    "speaker": "Player",
                    "text": "可以的。"
                },
                {
                    "id": "617980902",
                    "speaker": "赫斯塔尔",
                    "text": "那稍等片刻，我准备好训练弹和靶标…"
                }
            ]
        },
        {
            "talkId": "6179810",
            "initDialog": "617981001",
            "dialogues": [
                {
                    "id": "617981001",
                    "speaker": "Player",
                    "text": "现在还有事…"
                },
                {
                    "id": "617981002",
                    "speaker": "赫斯塔尔",
                    "text": "那就下次再说啦。"
                }
            ]
        },
        {
            "talkId": "6179811",
            "initDialog": "617981101",
            "dialogues": [
                {
                    "id": "617981101",
                    "speaker": "Player",
                    "text": "悠悠哉哉的态度，挺好！"
                },
                {
                    "id": "617981102",
                    "speaker": "赫斯塔尔",
                    "text": "多谢夸奖，这是从丽莎长官那里学来的人生哲学。"
                },
                {
                    "id": "617981103",
                    "speaker": "赫斯塔尔",
                    "text": "虽说她早就离开了第八小队…但我对她的尊敬，不会因为工作等因素改变。"
                },
                {
                    "id": "617981104",
                    "speaker": "赫斯塔尔",
                    "text": "哪怕是我的好友乌苏拉，现在也不会满脑子都是工作了。"
                },
                {
                    "id": "617981105",
                    "speaker": "赫斯塔尔",
                    "text": "不过，刚入队集训时的舍友赫得蔚格，就根本不听劝，每天都把自己逼得很紧。"
                },
                {
                    "id": "617981106",
                    "speaker": "赫斯塔尔",
                    "text": "哎，日子要一天一天慢慢过，总是心急，对自己不好嘛…"
                }
            ]
        },
        {
            "talkId": "6179812",
            "initDialog": "617981201",
            "dialogues": [
                {
                    "id": "617981201",
                    "speaker": "Player",
                    "text": "找到什么灵感？"
                },
                {
                    "id": "617981202",
                    "speaker": "赫斯塔尔",
                    "text": "啊，我是个「枪匠」。对我来说，最重要的灵感，或许就是…提升铳枪效能的方案吧？"
                },
                {
                    "id": "617981203",
                    "speaker": "赫斯塔尔",
                    "text": "铳枪啊，是个严谨的系统，所有改进都需要考虑全局。"
                },
                {
                    "id": "617981204",
                    "speaker": "赫斯塔尔",
                    "text": "如果只是看到一个新专利，就想要移植到已有的平台上来，衍生出来的问题可能比想象中多得多哦。"
                },
                {
                    "id": "617981205",
                    "speaker": "赫斯塔尔",
                    "text": "骑士团最近列装的铳枪形制，的确经过了至冬和枫丹的大量战例考验，可靠而实惠…"
                },
                {
                    "id": "617981206",
                    "speaker": "赫斯塔尔",
                    "text": "但它远远做不到让骑士们轻松、无伤地击退所有潜在的敌人，还需不断改良。"
                },
                {
                    "id": "617981207",
                    "speaker": "赫斯塔尔",
                    "text": "当改进受制于铳枪本身时，就该考虑放弃原有的框架了。"
                },
                {
                    "id": "617981208",
                    "speaker": "赫斯塔尔",
                    "text": "直接设计一个全新的平台，是不是反而更有潜力呢？",
                    "choices": [
                        {
                            "id": "617981209",
                            "text": "成本会很高吧？",
                            "response": [
                                {
                                    "id": "617981211",
                                    "speaker": "赫斯塔尔",
                                    "text": "嘛…金钱和时间都不是最大的阻碍，最大的阻碍是不思进取却又急于求成的…矛盾的心。"
                                },
                                {
                                    "id": "617981212",
                                    "speaker": "赫斯塔尔",
                                    "text": "我会慢慢写信和队长，甚至是团长申请经费的。然后，还要多招几个帮手…"
                                }
                            ]
                        },
                        {
                            "id": "617981210",
                            "text": "需要很多时间吧？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6179813",
            "initDialog": "617981301",
            "dialogues": [
                {
                    "id": "617981301",
                    "speaker": "Player",
                    "text": "那我也去喝茶了。"
                },
                {
                    "id": "617981302",
                    "speaker": "赫斯塔尔",
                    "text": "慢走~"
                }
            ]
        }
    ]
}