            "dialogues": [
                {
                    "id": "706765401",
                    "speaker": "派蒙",
                    "text": "#哇，{NICKNAME}快看，是宝箱！"
                },
                {
                    "id": "706765402",
                    "speaker": "派蒙",
                    "text": "装饰这么华丽，还摆在这么显眼的地方，简直就像是故意引诱我们打开一样！",
                    "choices": [
                        {
                            "id": "706765403",
                            "text": "说不定钥匙就在附近？",
                            "response": [
                                {
                                    "id": "706765404",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，我们四处找找看吧，说不定就能找到钥匙啦。不知道里面藏着什么样的宝藏呢？"
                                }
                            ]
                        },
                        {
                            "id": "706765405",
                            "text": "还是不要乱动比较好。",
                            "response": [
                                {
                                    "id": "706765406",
                                    "speaker": "派蒙",
                                    "text": "也、也是喔，未经许可的情况下，随便闯进别人的房间，再把锁起来的宝箱打开，取走里面的财宝，怎么想都不太合适…嗯？"
                                },
                                {
                                    "id": "706765407",
                                    "speaker": "派蒙",
                                    "text": "不管怎么说，还是应该先和琴说一声，对吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}