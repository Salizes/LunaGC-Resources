{
    "groupId": "4003",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "玛达赫": 8
    },
    "talks": [
        {
            "talkId": "6400301",
            "initDialog": "640030101",
            "dialogues": [
                {
                    "id": "640030101",
                    "speaker": "玛达赫",
                    "text": "怎么才能让大家继续喜欢我讲的故事呢…"
                }
            ]
        },
        {
            "talkId": "6400302",
            "initDialog": "640030201",
            "dialogues": [
                {
                    "id": "640030201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "640030202",
                    "speaker": "玛达赫",
                    "text": "刚刚喝了店长…啊不，是代理店长送的咖啡，所以身体状态还行，但精神状态堪忧。"
                },
                {
                    "id": "640030203",
                    "speaker": "玛达赫",
                    "text": "明明大家一开始都很喜欢我讲的英雄故事，为什么渐渐都不来听了呢？"
                },
                {
                    "id": "640030204",
                    "speaker": "玛达赫",
                    "text": "难道这类文武双全的大英雄已经不流行了吗？"
                }
            ]
        },
        {
            "talkId": "6400303",
            "initDialog": "640030301",
            "dialogues": [
                {
                    "id": "640030301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640030302",
                    "speaker": "玛达赫",
                    "text": "唉，真愁人…"
                }
            ]
        },
        {
            "talkId": "6400304",
            "initDialog": "640030401",
            "dialogues": [
                {
                    "id": "640030401",
                    "speaker": "Player",
                    "text": "大概不是这个问题…"
                },
                {
                    "id": "640030402",
                    "speaker": "玛达赫",
                    "text": "真的吗？那为什么只要我说个开头，大家就都离开了呢？"
                },
                {
                    "id": "640030403",
                    "speaker": "玛达赫",
                    "text": "还有国外的客人说，不如璃月那边的古代战场天降神兵、女仆骑士大战机械巨兽之类的故事新鲜…"
                },
                {
                    "id": "640030404",
                    "speaker": "玛达赫",
                    "text": "但那听上去实在是太离谱了，没有让人身临其境的真实感，我实在难以赞同。"
                }
            ]
        }
    ]
}