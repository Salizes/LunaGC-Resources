{
    "groupId": "30940",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 2,
        "「小水珠」": 1,
        "埃斯诺尔": 1,
        "派蒙": 3,
        "罗泽尔": 2,
        "诺艾尔": 5,
        "阿诺德": 1
    },
    "talks": [
        {
            "talkId": "4023158",
            "initDialog": "402315801",
            "dialogues": [
                {
                    "id": "402315801",
                    "speaker": "阿诺德",
                    "text": "这里到处都充盈着葡萄的香气，嗯，宛若天堂。要是我的嘴可以动的话，一定已经大快朵颐了。"
                },
                {
                    "id": "402315802",
                    "speaker": "「小水珠」",
                    "text": "太棒了，太棒了——"
                },
                {
                    "id": "402315803",
                    "speaker": "罗泽尔",
                    "text": "住在这里的肯定是大户人家吧，就算在希穆兰卡那样的故事世界里，我们也住不起这么大的房子。"
                },
                {
                    "id": "402315804",
                    "speaker": "埃斯诺尔",
                    "text": "这里不也是故事世界吗？呃…怎么了？"
                },
                {
                    "id": "402315805",
                    "speaker": "诺艾尔",
                    "text": "抱歉，晨曦酒庄内部本次活动暂不开放。我会引导各位去其他地方参观。"
                },
                {
                    "id": "402315806",
                    "speaker": "罗泽尔",
                    "text": "好吧，哎，稍微有点可惜。"
                },
                {
                    "id": "402315807",
                    "speaker": "派蒙",
                    "text": "是诺艾尔欸。"
                },
                {
                    "id": "402315808",
                    "speaker": "诺艾尔",
                    "text": "啊，是荣誉骑士和派蒙，你们好。"
                },
                {
                    "id": "402315809",
                    "speaker": "Player",
                    "text": "为什么你会在这里？"
                },
                {
                    "id": "402315810",
                    "speaker": "诺艾尔",
                    "text": "艾莉丝女士好像预见到了这里的事务会比较繁杂，于是让我来处理，她说她觉得我很可靠，一定能胜任。"
                },
                {
                    "id": "402315811",
                    "speaker": "派蒙",
                    "text": "这…这好像是在用花言巧语啊？把不属于骑士团的工作安排给骑士团的人。"
                },
                {
                    "id": "402315812",
                    "speaker": "诺艾尔",
                    "text": "哦，不要误会，迪卢克先生也来了，他很感谢我能在这里引导这些从不同世界来的旅游团。"
                },
                {
                    "id": "402315813",
                    "speaker": "派蒙",
                    "text": "旅游团？对哦…金苹果群岛，琉形蜃境，希穆兰卡，它们全都来了。"
                },
                {
                    "id": "402315814",
                    "speaker": "Player",
                    "text": "辛苦你了。"
                },
                {
                    "id": "402315815",
                    "speaker": "诺艾尔",
                    "text": "没关系，能多做些事情我很高兴，请尽管交给我！"
                }
            ]
        }
    ]
}