            "dialogues": [
                {
                    "id": "766770801",
                    "speaker": "Player",
                    "text": "（催他回去！）"
                },
                {
                    "id": "766770802",
                    "speaker": "派蒙",
                    "text": "法尔伽——该回去上班啦！"
                },
                {
                    "id": "766770803",
                    "speaker": "法尔伽",
                    "text": "…你们难道没听过「不要叫醒装睡的人」吗？",
                    "choices": [
                        {
                            "id": "766770804",
                            "text": "是「不要叫醒梦游的人」吧？",
                            "response": [
                                {
                                    "id": "766770806",
                                    "speaker": "法尔伽",
                                    "text": "好吧，怎么处理被抓到的猎物，都是猎手说了算…不过下回，我会藏得更好些的！"
                                }
                            ]
                        },
                        {
                            "id": "766770805",
                            "text": "是「叫不醒装睡的人」吧？"
                        }
                    ]
                }
            ]
        },
