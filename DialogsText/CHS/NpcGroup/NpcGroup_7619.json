        {
            "talkId": "7667725",
            "initDialog": "766772501",
            "dialogues": [
                {
                    "id": "766772501",
                    "speaker": "Player",
                    "text": "我来试试！"
                },
                {
                    "id": "766772502",
                    "speaker": "法尔伽",
                    "text": "好——都听到了吗，这可是在荣誉骑士面前，都打起点精神来！"
                },
                {
                    "id": "766772701",
                    "speaker": "法尔伽",
                    "text": "预备——开始！"
                }
            ]
        },
        {
            "talkId": "7667726",
            "initDialog": "766772601",
            "dialogues": [
                {
                    "id": "766772601",
                    "speaker": "Player",
                    "text": "我有点事…"
                },
                {
                    "id": "766772602",
                    "speaker": "法尔伽",
                    "text": "好吧，他们估计还得醉上好一阵子，你如果有空了，随时可以回来。"
                }
            ]
        },
        {
            "talkId": "7667732",
            "initDialog": "766773201",
            "dialogues": [
                {
                    "id": "766773201",
                    "speaker": "法尔伽",
                    "text": "——稍息！"
                },
                {
                    "id": "766773301",
                    "speaker": "法尔伽",
                    "text": "怎么样？荣誉骑士，你觉得这里面谁醉得最厉害？"
                }
            ]
        },
        {
            "talkId": "7667734",
            "initDialog": "766773401",
            "dialogues": [
                {
                    "id": "766773401",
                    "speaker": "Player",
                    "text": "左边的那一位…"
                }
            ]
        },
        {
            "talkId": "7667735",
            "initDialog": "766773501",
            "dialogues": [
                {
                    "id": "766773501",
                    "speaker": "Player",
                    "text": "中间的那一位…"
                }
            ]
        },
        {
            "talkId": "7667736",
            "initDialog": "766773601",
            "dialogues": [
                {
                    "id": "766773601",
                    "speaker": "Player",
                    "text": "右边的那一位…"
                }
            ]
        },
        {
            "talkId": "7667737",
            "initDialog": "766773701",
            "dialogues": [
                {
                    "id": "766773701",
                    "speaker": "温弗里德",
                    "text": "没…我…我没醉！就是…那个…有点头晕…"
                },
                {
                    "id": "766773702",
                    "speaker": "法尔伽",
                    "text": "比喝醉了更丢脸的事，就是喝醉了还不承认——二十圈，一个都别落！"
                }
            ]
        },
        {
            "talkId": "7667738",
            "initDialog": "766773801",
            "dialogues": [
                {
                    "id": "766773801",
                    "speaker": "艾克贝特",
                    "text": "没…我…我没醉！就是…那个…有点头晕…"
                },
                {
                    "id": "766773802",
                    "speaker": "法尔伽",
                    "text": "比喝醉了更丢脸的事，就是喝醉了还不承认——二十圈，一个都别落！"
                }
            ]
        },
