    "talks": [
        {
            "talkId": "6245001",
            "initDialog": "624500101",
            "dialogues": [
                {
                    "id": "624500101",
                    "speaker": "平海",
                    "text": "嗯？想出海或者钓鱼什么的就找别的船夫吧，我这船可是专门给「珠钿舫」接客的。"
                }
            ]
        },
        {
            "talkId": "6245002",
            "initDialog": "624500201",
            "dialogues": [
                {
                    "id": "624500201",
                    "speaker": "Player",
                    "text": "我想去珠钿舫。"
                },
                {
                    "id": "624500202",
                    "speaker": "平海",
                    "text": "啊，小的有眼无珠，原来真是去「珠钿舫」的老爷。来来，快请登船。"
                }
            ]
        },
        {
            "talkId": "6245003",
            "initDialog": "624500301",
            "dialogues": [
                {
                    "id": "624500301",
                    "speaker": "Player",
                    "text": "珠钿舫？"
                },
                {
                    "id": "624500302",
                    "speaker": "平海",
                    "text": "嗯…你不知道也很正常。"
                },
                {
                    "id": "624500303",
                    "speaker": "平海",
                    "text": "那里是璃月港的有钱老爷们消遣的地方，可不是一般平头老百姓可以进出的。"
                },
                {
                    "id": "624500304",
                    "speaker": "平海",
                    "text": "而且如果不是「贵客」，普通人就算过去了也就只能看个热闹…"
                },
                {
                    "id": "624500305",
                    "speaker": "平海",
                    "text": "…就说这么多，没事就别浪费我的时间了。"
                }
            ]
        },
        {
            "talkId": "6245004",
            "initDialog": "624500401",
            "dialogues": [
                {
                    "id": "624500401",
                    "speaker": "Player",
                    "text": "没什么事。"
                },
                {
                    "id": "624500402",
                    "speaker": "平海",
                    "text": "没事儿就快走，真没劲…"
                }
            ]
        }
    ]
}