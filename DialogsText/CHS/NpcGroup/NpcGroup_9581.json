{
    "groupId": "9581",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "阿蕾奇诺": 10
    },
    "talks": [
        {
            "talkId": "6958101",
            "initDialog": "695810101",
            "dialogues": [
                {
                    "id": "695810101",
                    "speaker": "阿蕾奇诺",
                    "text": "这里出售卡牌吗？如果能买一些带给孩子们，或许他们会开心的。"
                }
            ]
        },
        {
            "talkId": "6958102",
            "initDialog": "695810201",
            "dialogues": [
                {
                    "id": "695810201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958103",
            "initDialog": "695810301",
            "dialogues": [
                {
                    "id": "695810301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695810302",
                    "speaker": "阿蕾奇诺",
                    "text": "我也要离开了，休息时间结束了。"
                }
            ]
        },
        {
            "talkId": "6958104",
            "initDialog": "695810401",
            "dialogues": [
                {
                    "id": "695810401",
                    "speaker": "阿蕾奇诺",
                    "text": "下次对局时，记得要藏好自己所有的心思和计划。就像编织一张蛛网，在整张网完成之前，要保证它一直处在无人发觉的暗处。"
                }
            ]
        },
        {
            "talkId": "6958105",
            "initDialog": "695810501",
            "dialogues": [
                {
                    "id": "695810501",
                    "speaker": "阿蕾奇诺",
                    "text": "不错，看来你已经学会如何编织一张合格的网了。"
                }
            ]
        },
        {
            "talkId": "6958106",
            "initDialog": "695810601",
            "dialogues": [
                {
                    "id": "695810601",
                    "speaker": "阿蕾奇诺",
                    "text": "我见过孩子们玩这种游戏，算是知道规则，你想玩么？那陪你。"
                }
            ]
        },
        {
            "talkId": "6958108",
            "initDialog": "695810801",
            "dialogues": [
                {
                    "id": "695810801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958109",
            "initDialog": "695810901",
            "dialogues": [
                {
                    "id": "695810901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958110",
            "initDialog": "695811001",
            "dialogues": [
                {
                    "id": "695811001",
                    "speaker": "阿蕾奇诺",
                    "text": "你盯着我的眼睛，是想要捕捉我的情绪，以此来判断我手中牌的优劣么？想法很好，但失败了。"
                }
            ]
        },
        {
            "talkId": "6958111",
            "initDialog": "695811101",
            "dialogues": [
                {
                    "id": "695811101",
                    "speaker": "阿蕾奇诺",
                    "text": "下次有空，你可以来家里陪孩子们玩玩这游戏，他们一定会很高兴的。"
                }
            ]
        },
        {
            "talkId": "6958112",
            "initDialog": "695811201",
            "dialogues": [
                {
                    "id": "695811201",
                    "speaker": "阿蕾奇诺",
                    "text": "想要再来一局？好，我正巧没什么要事处理。"
                }
            ]
        },
        {
            "talkId": "6958114",
            "initDialog": "695811401",
            "dialogues": [
                {
                    "id": "695811401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958115",
            "initDialog": "695811501",
            "dialogues": [
                {
                    "id": "695811501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958116",
            "initDialog": "695811601",
            "dialogues": [
                {
                    "id": "695811601",
                    "speaker": "阿蕾奇诺",
                    "text": "你在出牌时，情绪的波动太过明显，暴露了你的战术倾向。"
                }
            ]
        },
        {
            "talkId": "6958117",
            "initDialog": "695811701",
            "dialogues": [
                {
                    "id": "695811701",
                    "speaker": "阿蕾奇诺",
                    "text": "不错。你的牌技，比家里的孩子们都要好。"
                }
            ]
        },
        {
            "talkId": "6958118",
            "initDialog": "695811801",
            "dialogues": [
                {
                    "id": "695811801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}