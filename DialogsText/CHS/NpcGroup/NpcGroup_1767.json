{
    "groupId": "1767",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "盖纳": 11
    },
    "talks": [
        {
            "talkId": "6176701",
            "initDialog": "617670101",
            "dialogues": [
                {
                    "id": "617670101",
                    "speaker": "盖纳",
                    "text": "她会喜欢什么呢…好难选啊。"
                }
            ]
        },
        {
            "talkId": "6176703",
            "initDialog": "617670301",
            "dialogues": [
                {
                    "id": "617670301",
                    "speaker": "Player",
                    "text": "你在烦恼什么？"
                },
                {
                    "id": "617670302",
                    "speaker": "盖纳",
                    "text": "啊…是这样的，我的外出执勤任务马上就要结束了，而我的结婚纪念日也快要到了。"
                },
                {
                    "id": "617670303",
                    "speaker": "盖纳",
                    "text": "可我还没有选好给妻子的礼物。我害怕她会不喜欢我的礼物，却又要挤出满意的笑容。"
                },
                {
                    "id": "617670304",
                    "speaker": "盖纳",
                    "text": "我也害怕她会不喜欢我的礼物，冷着脸收下，然后认为我并不在意她的喜好。"
                },
                {
                    "id": "617670305",
                    "speaker": "盖纳",
                    "text": "因此，我需要在选择礼物这件事上慎之又慎。以确保她一定会喜欢。"
                }
            ]
        },
        {
            "talkId": "6176704",
            "initDialog": "617670401",
            "dialogues": [
                {
                    "id": "617670401",
                    "speaker": "盖纳",
                    "text": "抱歉…打扰一下，请问您用的香氛，是久雨莲吗？"
                }
            ]
        },
        {
            "talkId": "6176705",
            "initDialog": "617670501",
            "dialogues": [
                {
                    "id": "617670501",
                    "speaker": "Player",
                    "text": "久雨莲？"
                },
                {
                    "id": "617670502",
                    "speaker": "盖纳",
                    "text": "啊…是这样的，我的外出执勤任务马上就要结束了，而我的结婚纪念日也快要到了。"
                },
                {
                    "id": "617670503",
                    "speaker": "盖纳",
                    "text": "可我还没有选好给妻子的礼物…她是枫丹人，所以我在想，也许应该送些与枫丹有关的东西。"
                },
                {
                    "id": "617670504",
                    "speaker": "盖纳",
                    "text": "我记得，枫丹有位叫科培琉司的剧作家说过，「嗅觉是记忆的本能，芬芳是爱情的音乐」…"
                },
                {
                    "id": "617670505",
                    "speaker": "盖纳",
                    "text": "闻到您的香氛后…我觉得我已经有主意了。"
                }
            ]
        },
        {
            "talkId": "6176706",
            "initDialog": "617670601",
            "dialogues": [
                {
                    "id": "617670601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617670602",
                    "speaker": "盖纳",
                    "text": "再见。我要再好好想想。"
                }
            ]
        }
    ]
}