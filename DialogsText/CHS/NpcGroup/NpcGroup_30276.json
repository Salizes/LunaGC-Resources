    "talks": [
        {
            "talkId": "7368402",
            "initDialog": "736840201",
            "dialogues": [
                {
                    "id": "736840201",
                    "speaker": "温克尔",
                    "text": "您好，前辈！请问有什么事吗？"
                }
            ]
        },
        {
            "talkId": "7368403",
            "initDialog": "736840301",
            "dialogues": [
                {
                    "id": "736840301",
                    "speaker": "Player",
                    "text": "想要了解「跨野寻踪」…"
                },
                {
                    "id": "736840302",
                    "speaker": "温克尔",
                    "text": "「跨野寻踪」是由冒险家协会举办，旨在检验冒险家们各项实力的趣味活动喔！"
                },
                {
                    "id": "736840303",
                    "speaker": "温克尔",
                    "text": "在活动中，冒险家们需要根据提示找到「野踪气球」，并且沿着这些气球的分布轨迹前进。"
                },
                {
                    "id": "736840304",
                    "speaker": "温克尔",
                    "text": "在限定时间内搜集到越多的「野踪气球」，就能获得越高的评价，奖励也会更加丰厚喔。"
                }
            ]
        },
        {
            "talkId": "7368405",
            "initDialog": "736840501",
            "dialogues": [
                {
                    "id": "736840501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "736840502",
                    "speaker": "温克尔",
                    "text": "好的，前辈！请您务必来参加这次活动啊！"
                }
            ]
        }
    ]
}