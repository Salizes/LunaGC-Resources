{
    "groupId": "12858",
    "total_dialogue_lines": 103,
    "speaker_counts": {
        "Player": 21,
        "派蒙": 33,
        "风速枣椰": 49
    },
    "talks": [
        {
            "talkId": "4008120",
            "initDialog": "400812001",
            "dialogues": [
                {
                    "id": "400812001",
                    "speaker": "风速枣椰",
                    "text": "啊哈！这次通过训练的速度更快了，好极了好极了！",
                    "choices": [
                        {
                            "id": "400812002",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "400812003",
                                    "speaker": "风速枣椰",
                                    "text": "你们也是参加月莲杯大赛的选手？居然还不认识本小姐…"
                                },
                                {
                                    "id": "400812004",
                                    "speaker": "风速枣椰",
                                    "text": "呆头呆脑的外乡人，还有一只飞行白蘑菇…噗嗤…看起来好弱！"
                                },
                                {
                                    "id": "400812005",
                                    "speaker": "风速枣椰",
                                    "text": "等等，好像也不是蘑菇啊…不过没什么差别啦。"
                                },
                                {
                                    "id": "400812006",
                                    "speaker": "Player",
                                    "text": "派蒙也变成蘑菇伙伴了。"
                                },
                                {
                                    "id": "400812007",
                                    "speaker": "派蒙",
                                    "text": "重点不在这里啦，这个家伙好狂啊！"
                                },
                                {
                                    "id": "400812008",
                                    "speaker": "风速枣椰",
                                    "text": "什么叫狂？明明是强者的气势！"
                                },
                                {
                                    "id": "400812009",
                                    "speaker": "风速枣椰",
                                    "text": "我「风速枣椰」可是「枣椰帮」第一个成为大人的大姐头！小弟们可是一直很崇拜我的！"
                                },
                                {
                                    "id": "400812010",
                                    "speaker": "风速枣椰",
                                    "text": "干活挣钱最快，念书最快，跑得最快，大家全都跟在我后面…"
                                },
                                {
                                    "id": "400812011",
                                    "speaker": "Player",
                                    "text": "吃枣椰也最快吗？"
                                },
                                {
                                    "id": "400812012",
                                    "speaker": "风速枣椰",
                                    "text": "没错！小弟们都说我吃枣椰的速度就像雨林里的风！如果有什么「吃枣椰大胃王比赛」，我喝两缸水再上都能拿冠军！"
                                },
                                {
                                    "id": "400812013",
                                    "speaker": "派蒙",
                                    "text": "哈哈，真是个好懂的称号，我看呆头呆脑的是你才对！"
                                },
                                {
                                    "id": "400812014",
                                    "speaker": "风速枣椰",
                                    "text": "你！我记住你了，飞行白蘑菇！要是被我哗哗两下就打败了，可不要哭哦！"
                                },
                                {
                                    "id": "400812015",
                                    "speaker": "风速枣椰",
                                    "text": "不过，说不定到时候我已经把你们忘了呢，毕竟有那么多人参加比赛，你们实在太不起眼了！"
                                },
                                {
                                    "id": "400812016",
                                    "speaker": "风速枣椰",
                                    "text": "还是祈祷不要碰上我「风速枣椰」吧，不然可是会被我的蕈兽们打得满地找牙的哦。"
                                },
                                {
                                    "id": "400812017",
                                    "speaker": "派蒙",
                                    "text": "好生气！果然我们应该报上那两个响亮的称号来的！"
                                }
                            ]
                        },
                        {
                            "id": "400812018",
                            "text": "速度？",
                            "response": [
                                {
                                    "id": "400812019",
                                    "speaker": "风速枣椰",
                                    "text": "没错，我已经和蕈兽们找到了一套绝对无敌的速攻打法！"
                                },
                                {
                                    "id": "400812020",
                                    "speaker": "风速枣椰",
                                    "text": "只要命令蕈兽们呼啦一下攻上去，对手就招架不住的！"
                                },
                                {
                                    "id": "400812021",
                                    "speaker": "派蒙",
                                    "text": "唔，感觉是完全不经思考的打法呢。"
                                },
                                {
                                    "id": "400812022",
                                    "speaker": "派蒙",
                                    "text": "那要是两边的实力相差很多，不就会被一下子都打败了吗？"
                                },
                                {
                                    "id": "400812023",
                                    "speaker": "风速枣椰",
                                    "text": "你，你胡说什么！大家的蕈兽都是差不多强的，肯定是谁更快谁就赢！"
                                },
                                {
                                    "id": "400812024",
                                    "speaker": "风速枣椰",
                                    "text": "一下子打败和自己差不多的四个对手，这种事只可能出现在哄小孩的故事里！"
                                },
                                {
                                    "id": "400812025",
                                    "speaker": "风速枣椰",
                                    "text": "飞行白蘑菇，你不信的话，下次就尽管试试看吧。"
                                },
                                {
                                    "id": "400812026",
                                    "speaker": "风速枣椰",
                                    "text": "反正你们都会变成我成为冠军路上的…经验书！"
                                },
                                {
                                    "id": "400812027",
                                    "speaker": "派蒙",
                                    "text": "参赛选手有那么多，我们也不一定记得住你！"
                                },
                                {
                                    "id": "400812028",
                                    "speaker": "派蒙",
                                    "text": "而且打败你又没有什么好处…完全提不起干劲…"
                                },
                                {
                                    "id": "400812029",
                                    "speaker": "风速枣椰",
                                    "text": "呵！虽然只是假设，如果你们真的打败了我，我也会认可你们，给你一份帮里最好吃的枣椰蜜糖！"
                                },
                                {
                                    "id": "400812030",
                                    "speaker": "派蒙",
                                    "text": "欸？最好吃的枣椰蜜糖？会是什么味道的呢…"
                                }
                            ]
                        },
                        {
                            "id": "400812031",
                            "text": "注意安全…",
                            "response": [
                                {
                                    "id": "400812032",
                                    "speaker": "风速枣椰",
                                    "text": "哼，你们才是，小心别受伤哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008132",
            "initDialog": "400813201",
            "dialogues": [
                {
                    "id": "400813201",
                    "speaker": "风速枣椰",
                    "text": "怎么回事，到底怎么回事！凭什么一下子就把我的所有蕈兽都打败了！这下我要怎么和小弟们交差啊…",
                    "choices": [
                        {
                            "id": "400813202",
                            "text": "你还好吗？",
                            "response": [
                                {
                                    "id": "400813203",
                                    "speaker": "风速枣椰",
                                    "text": "啊？你们两个来干什么？想要嘲笑我吗！"
                                },
                                {
                                    "id": "400813204",
                                    "speaker": "风速枣椰",
                                    "text": "不要太得意了！等到下次比赛，我还会赢回来的！"
                                },
                                {
                                    "id": "400813205",
                                    "speaker": "派蒙",
                                    "text": "咦？还有下次比赛吗？预赛不是只有一次机会吗？",
                                    "choices": [
                                        {
                                            "id": "400813206",
                                            "text": "也许她想说下一届比赛。",
                                            "response": [
                                                {
                                                    "id": "400813208",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，这也是好事，不要因为一次失败太受挫折！"
                                                },
                                                {
                                                    "id": "400813209",
                                                    "speaker": "派蒙",
                                                    "text": "总之，枣椰怪怪人，下次较量的时候，希望你变得更强！"
                                                },
                                                {
                                                    "id": "400813210",
                                                    "speaker": "风速枣椰",
                                                    "text": "那还用说吗！到时候就是我来安慰你们了！"
                                                },
                                                {
                                                    "id": "400813211",
                                                    "speaker": "风速枣椰",
                                                    "text": "如果你们的态度不错，我也可以考虑给你们几颗秘制枣椰蜜糖安慰一下你们哦。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400813207",
                                            "text": "她还抱有很强的斗志。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400813212",
                            "text": "哈哈，是我们赢啦！",
                            "response": [
                                {
                                    "id": "400813213",
                                    "speaker": "派蒙",
                                    "text": "对哦，是我们「黄金流星」和「白银伴星」赢啦！"
                                },
                                {
                                    "id": "400813214",
                                    "speaker": "风速枣椰",
                                    "text": "呃…蕈兽们的招式能够互相反应，我只不过是没有考虑到这一点。"
                                },
                                {
                                    "id": "400813215",
                                    "speaker": "风速枣椰",
                                    "text": "贸然冲上去的确有危险，以后我会注意的！"
                                },
                                {
                                    "id": "400813216",
                                    "speaker": "风速枣椰",
                                    "text": "不管怎么样，我还会和伙伴们调整策略的，下次绝不输给你们！"
                                },
                                {
                                    "id": "400813217",
                                    "speaker": "派蒙",
                                    "text": "咦，这话说得好像之后还会再见面一样…"
                                },
                                {
                                    "id": "400813218",
                                    "speaker": "Player",
                                    "text": "比赛也不会只办一届吧。"
                                },
                                {
                                    "id": "400813219",
                                    "speaker": "派蒙",
                                    "text": "确实呢，希望下一届比赛，她还这么有热情吧！"
                                }
                            ]
                        },
                        {
                            "id": "400813220",
                            "text": "别太沮丧了…",
                            "response": [
                                {
                                    "id": "400813221",
                                    "speaker": "风速枣椰",
                                    "text": "我！我才不沮丧！走着瞧吧，我还会赢回来的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008147",
            "initDialog": "400814701",
            "dialogues": [
                {
                    "id": "400814701",
                    "speaker": "风速枣椰",
                    "text": "怎么只给一次机会，太不公平了！",
                    "choices": [
                        {
                            "id": "400814702",
                            "text": "什么机会？",
                            "response": [
                                {
                                    "id": "400814703",
                                    "speaker": "风速枣椰",
                                    "text": "比赛啊！为什么我只是输了第一场，就不让我继续参赛了！"
                                },
                                {
                                    "id": "400814704",
                                    "speaker": "风速枣椰",
                                    "text": "我还想好好表现呢！大家还等着和我带回家的蕈兽一起玩呢！"
                                },
                                {
                                    "id": "400814705",
                                    "speaker": "派蒙",
                                    "text": "原来你不知道吗…预赛都没通过的话，就没有机会了哦。"
                                },
                                {
                                    "id": "400814706",
                                    "speaker": "派蒙",
                                    "text": "感觉你好像只凭一股热情就参加比赛了，完全没有好好读过比赛规则呢…"
                                },
                                {
                                    "id": "400814707",
                                    "speaker": "Player",
                                    "text": "为你们感到遗憾。"
                                },
                                {
                                    "id": "400814708",
                                    "speaker": "派蒙",
                                    "text": "不管怎么样，你已经尽力了啦，现在后悔也没什么用，还不如和蕈兽们开开心心地放松一下呢。"
                                },
                                {
                                    "id": "400814709",
                                    "speaker": "派蒙",
                                    "text": "你不是还有一些小弟吗？你可以和让小弟们和你的蕈兽也交朋友，一起去野餐，去探险…"
                                },
                                {
                                    "id": "400814710",
                                    "speaker": "派蒙",
                                    "text": "唔，探险还是算了，对你们来说不太安全。"
                                },
                                {
                                    "id": "400814711",
                                    "speaker": "风速枣椰",
                                    "text": "对，对哦！还没来得及让小弟们认识一下我的蕈兽！"
                                },
                                {
                                    "id": "400814712",
                                    "speaker": "风速枣椰",
                                    "text": "有两个胆大包天的小弟，居然还模仿参赛选手，偷偷去找什么「传说中最乖巧最听话的蕈兽」…还好没出什么事！"
                                },
                                {
                                    "id": "400814713",
                                    "speaker": "风速枣椰",
                                    "text": "明明和我的蕈兽一起玩就行了啊！"
                                },
                                {
                                    "id": "400814714",
                                    "speaker": "Player",
                                    "text": "这事怎么有点耳熟…"
                                },
                                {
                                    "id": "400814715",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，这样才对嘛，你就不要有心理负担啦！"
                                }
                            ]
                        },
                        {
                            "id": "400814716",
                            "text": "小弟们不会责怪你的。",
                            "response": [
                                {
                                    "id": "400814717",
                                    "speaker": "风速枣椰",
                                    "text": "可是…我明明是大姐头，是唯一拿到比赛资格的人，是全帮的希望啊！"
                                },
                                {
                                    "id": "400814718",
                                    "speaker": "风速枣椰",
                                    "text": "大家以前都要绕着蕈兽走，明明觉得很多蕈兽很可爱，但却不敢接近它们，都指望着我训练几只蕈兽，作为我们的镇帮之宝…"
                                },
                                {
                                    "id": "400814719",
                                    "speaker": "风速枣椰",
                                    "text": "结果我失败了，完全没希望了…"
                                },
                                {
                                    "id": "400814720",
                                    "speaker": "派蒙",
                                    "text": "那你不是更应该抓紧时间，让小弟们和你的蕈兽多玩一会儿了吗？"
                                },
                                {
                                    "id": "400814721",
                                    "speaker": "派蒙",
                                    "text": "虽然只有八强选手能把蕈兽一直留在身边，可现在比赛还没结束嘛，不会马上把你的宝珠和伙伴们收走的！"
                                },
                                {
                                    "id": "400814722",
                                    "speaker": "派蒙",
                                    "text": "既然这一次输掉了，就吸取教训，下次比赛再兑现承诺嘛！"
                                },
                                {
                                    "id": "400814723",
                                    "speaker": "风速枣椰",
                                    "text": "等等，你好像说得没错喔！"
                                },
                                {
                                    "id": "400814724",
                                    "speaker": "风速枣椰",
                                    "text": "没想到你这个白色飞蘑菇还挺机灵！谢…"
                                },
                                {
                                    "id": "400814725",
                                    "speaker": "Player",
                                    "text": "不用谢。"
                                },
                                {
                                    "id": "400814726",
                                    "speaker": "派蒙",
                                    "text": "不用谢哦！"
                                },
                                {
                                    "id": "400814727",
                                    "speaker": "风速枣椰",
                                    "text": "呃…果然还是说不出口！"
                                },
                                {
                                    "id": "400814728",
                                    "speaker": "风速枣椰",
                                    "text": "你们两个，我就先放过你们一次！你们一定要拿到冠军啊！"
                                },
                                {
                                    "id": "400814729",
                                    "speaker": "风速枣椰",
                                    "text": "这样一来，等到下次比赛，我一打败你们，就会成为最亮眼的选手！"
                                },
                                {
                                    "id": "400814730",
                                    "speaker": "派蒙",
                                    "text": "这是什么话，又好笑又好气…"
                                },
                                {
                                    "id": "400814731",
                                    "speaker": "派蒙",
                                    "text": "算了，我们大人有大量，就先答应你好了！下次一定要变强，然后和我们再较量一番哦！"
                                }
                            ]
                        },
                        {
                            "id": "400814732",
                            "text": "再见…",
                            "response": [
                                {
                                    "id": "400814733",
                                    "speaker": "风速枣椰",
                                    "text": "唉，垂头丧气也不是个事，还是要打起精神去面对小弟们啊…再见吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008154",
            "initDialog": "400815401",
            "dialogues": [
                {
                    "id": "400815401",
                    "speaker": "风速枣椰",
                    "text": "奖金…我的奖金…明明是参赛选手，为什么没有奖金！亏我还高兴了好一阵子…结果根本白来了！",
                    "choices": [
                        {
                            "id": "400815402",
                            "text": "奖金？",
                            "response": [
                                {
                                    "id": "400815403",
                                    "speaker": "风速枣椰",
                                    "text": "对啊！我明明参加了比赛，居然一摩拉的奖金都没有，这合理吗！"
                                },
                                {
                                    "id": "400815404",
                                    "speaker": "派蒙",
                                    "text": "呃…获得奖金的规则，好像留言板上也有写吧？虽然规则确实很多很复杂，根本看不过来啦，但只进入了预赛，肯定是不够的嘛…"
                                },
                                {
                                    "id": "400815405",
                                    "speaker": "Player",
                                    "text": "我的奖金分你一点？"
                                },
                                {
                                    "id": "400815406",
                                    "speaker": "派蒙",
                                    "text": "啊？真的要这样吗？可我们自己不是也没拿多少奖金吗？"
                                },
                                {
                                    "id": "400815407",
                                    "speaker": "派蒙",
                                    "text": "好吧，看在枣椰怪怪人什么都不懂就被我们打败了，安慰一下她也不是不行…"
                                },
                                {
                                    "id": "400815408",
                                    "speaker": "风速枣椰",
                                    "text": "我我我…我就不用了！"
                                },
                                {
                                    "id": "400815409",
                                    "speaker": "风速枣椰",
                                    "text": "凭别人的好意拿到的奖金，还算得上奖金吗！小弟们听说了这种事，一定会笑话我的！"
                                },
                                {
                                    "id": "400815410",
                                    "speaker": "派蒙",
                                    "text": "为了大姐头的威严…居然能抵挡住摩拉的诱惑？"
                                },
                                {
                                    "id": "400815411",
                                    "speaker": "派蒙",
                                    "text": "有点了不起，我对你刮目相看了哦！"
                                }
                            ]
                        },
                        {
                            "id": "400815412",
                            "text": "接受现实吧，少女！",
                            "response": [
                                {
                                    "id": "400815413",
                                    "speaker": "派蒙",
                                    "text": "没错，以后你要小心一点啦，至少在做事之前把规则看清楚！不然，总是迷迷糊糊就吃了亏，怎么能行呢！"
                                },
                                {
                                    "id": "400815414",
                                    "speaker": "风速枣椰",
                                    "text": "我已经接受了啦，又不会胡闹，只是有点丧气罢了。"
                                },
                                {
                                    "id": "400815415",
