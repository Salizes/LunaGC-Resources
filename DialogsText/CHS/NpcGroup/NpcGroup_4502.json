            "dialogues": [
                {
                    "id": "645010101",
                    "speaker": "派蒙",
                    "text": "「百雷遮罗」和「转转悠悠兽」，好久不见啦！"
                },
                {
                    "id": "645010102",
                    "speaker": "转转悠悠兽",
                    "text": "♩~"
                },
                {
                    "id": "645010103",
                    "speaker": "百雷遮罗",
                    "text": "♬~"
                },
                {
                    "id": "645010104",
                    "speaker": "派蒙",
                    "text": "感觉你们也胖了…嗯，健壮了一点哦！说明有好好听海妮耶和左右加的话，按时吃饭睡觉。"
                },
                {
                    "id": "645010105",
                    "speaker": "派蒙",
                    "text": "大家都是乖孩子~"
                }
            ]
        },
        {
            "talkId": "6450102",
            "initDialog": "645010201",
            "dialogues": [
                {
                    "id": "645010201",
                    "speaker": "Player",
                    "text": "旁边桌上这是…"
                },
                {
                    "id": "645010202",
                    "speaker": "派蒙",
                    "text": "哦？是神子和莱依拉的信件吗？"
                }
            ]
        },
        {
            "talkId": "6450103",
            "initDialog": "645010301",
            "dialogues": [
                {
                    "id": "645010301",
                    "speaker": "Player",
                    "text": "下次带你们去见以前的搭档！"
                },
                {
                    "id": "645010302",
                    "speaker": "派蒙",
                    "text": "对呀对呀，想办法搞定各种手续后，我们可以带着你们去找神子和莱依拉玩！"
                }
            ]
        }
    ]
}