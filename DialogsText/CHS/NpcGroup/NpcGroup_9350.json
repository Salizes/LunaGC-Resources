{
    "groupId": "9350",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "柯莱": 9
    },
    "talks": [
        {
            "talkId": "6935001",
            "initDialog": "693500101",
            "dialogues": [
                {
                    "id": "693500101",
                    "speaker": "柯莱",
                    "text": "你携带的补给品还够吗？休息时间，要记得补充能量和水分。"
                },
                {
                    "id": "693500102",
                    "speaker": "柯莱",
                    "text": "虽然这里比起野外的环境要好很多，设施也算齐备，但因此就掉以轻心，不去关注自身状态的话，是会吃亏的。"
                },
                {
                    "id": "693500103",
                    "speaker": "柯莱",
                    "text": "我怎么会知道？欸…欸，你真的要问这个问题吗？"
                }
            ]
        },
        {
            "talkId": "6935002",
            "initDialog": "693500201",
            "dialogues": [
                {
                    "id": "693500201",
                    "speaker": "柯莱",
                    "text": "说实话，我确实有些紧张。这里的战斗并不轻松，要是我拖累大家就不好了…"
                },
                {
                    "id": "693500202",
                    "speaker": "柯莱",
                    "text": "但…我不能只是憧憬着要成为和大家一样勇敢的人，却什么也不做…"
                },
                {
                    "id": "693500203",
                    "speaker": "柯莱",
                    "text": "我不会逃避的，不会。见习巡林员柯莱，已经准备好迎接战斗了！"
                }
            ]
        },
        {
            "talkId": "6935003",
            "initDialog": "693500301",
            "dialogues": [
                {
                    "id": "693500301",
                    "speaker": "柯莱",
                    "text": "这里的书，不算很晦涩，我基本都能流畅地阅读下来…！"
                },
                {
                    "id": "693500302",
                    "speaker": "柯莱",
                    "text": "回去之后，我要好好感谢提纳里师父的识字课。"
                },
                {
                    "id": "693500303",
                    "speaker": "柯莱",
                    "text": "为了看懂更多更复杂的书，今后，我要更努力一些才行。"
                }
            ]
        }
    ]
}