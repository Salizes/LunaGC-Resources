{
    "groupId": "9077",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 15,
        "瑶瑶": 54
    },
    "talks": [
        {
            "talkId": "6907701",
            "initDialog": "690770101",
            "dialogues": [
                {
                    "id": "690770101",
                    "speaker": "瑶瑶",
                    "text": "#{NICKNAME}，你来啦。"
                },
                {
                    "id": "690770102",
                    "speaker": "瑶瑶",
                    "text": "有什么需要帮忙吗？最近过得好不好？和我仔细说说吧。"
                }
            ]
        },
        {
            "talkId": "6907702",
            "initDialog": "690770201",
            "dialogues": [
                {
                    "id": "690770201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690770202",
                    "speaker": "瑶瑶",
                    "text": "嘿嘿，这里比我家中热闹多啦，但又不像码头一样熙熙攘攘。",
                    "choices": [
                        {
                            "id": "690770203",
                            "text": "是喜欢的意思？",
                            "response": [
                                {
                                    "id": "690770204",
                                    "speaker": "瑶瑶",
                                    "text": "当然啦。哎呀，你不用为我操心。"
                                },
                                {
                                    "id": "690770205",
                                    "speaker": "瑶瑶",
                                    "text": "师父教过我要「入乡随俗」，欸…等等…这时候是不是应该用「客随主便」更好？"
                                },
                                {
                                    "id": "690770206",
                                    "speaker": "瑶瑶",
                                    "text": "总之，我很喜欢这里！"
                                },
                                {
                                    "id": "690770207",
                                    "speaker": "瑶瑶",
                                    "text": "要是让你觉得在意…我反倒要不好意思啦。"
                                },
                                {
                                    "id": "690770212",
                                    "speaker": "瑶瑶",
                                    "text": "就让我在这里多待会儿吧。"
                                },
                                {
                                    "id": "690770213",
                                    "speaker": "瑶瑶",
                                    "text": "也…让我多陪你一会儿吧。"
                                }
                            ]
                        },
                        {
                            "id": "690770208",
                            "text": "是不够热闹的意思？",
                            "response": [
                                {
                                    "id": "690770209",
                                    "speaker": "瑶瑶",
                                    "text": "不是啦。"
                                },
                                {
                                    "id": "690770210",
                                    "speaker": "瑶瑶",
                                    "text": "这里让我感到亲切又自在，就好像来到了仙府洞天一样。"
                                },
                                {
                                    "id": "690770211",
                                    "speaker": "瑶瑶",
                                    "text": "能被你邀请来这里玩，是瑶瑶的荣幸。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907703",
            "initDialog": "690770301",
            "dialogues": [
                {
                    "id": "690770301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690770302",
                    "speaker": "瑶瑶",
                    "text": "好呀，我可喜欢聊天啦。"
                },
                {
                    "id": "690770303",
                    "speaker": "瑶瑶",
                    "text": "不管对象是谁，我们总能聊得很开心哦！"
                },
                {
                    "id": "690770304",
                    "speaker": "Player",
                    "text": "比如说呢？"
                },
                {
                    "id": "690770305",
                    "speaker": "瑶瑶",
                    "text": "比如说——鹤！"
                },
                {
                    "id": "690770306",
                    "speaker": "瑶瑶",
                    "text": "之前有一次我在溪边洗萝卜，看到一只特别漂亮的鹤停在我身边。"
                },
                {
                    "id": "690770307",
                    "speaker": "瑶瑶",
                    "text": "羽毛的色彩尤其丰富，让人看见了就很喜欢。"
                },
                {
                    "id": "690770308",
                    "speaker": "瑶瑶",
                    "text": "我打了声招呼，没想到那只鹤居然会说人话！",
                    "choices": [
                        {
                            "id": "690770309",
                            "text": "难道是理水叠山真君？",
                            "response": [
                                {
                                    "id": "690770310",
                                    "speaker": "瑶瑶",
                                    "text": "嘿嘿，我再给你一些提示吧！"
                                },
                                {
                                    "id": "690770311",
                                    "speaker": "瑶瑶",
                                    "text": "我们俩相谈甚欢，一起吃了我做的凉拌萝卜丝…对方又和我讲了很多身边的趣事。"
                                },
                                {
                                    "id": "690770312",
                                    "speaker": "瑶瑶",
                                    "text": "最后，还说和我一见如故，送了我可爱的「月桂」呢！"
                                },
                                {
                                    "id": "690770313",
                                    "speaker": "瑶瑶",
                                    "text": "你知道吗？月桂是通过机关术运作的！"
                                },
                                {
                                    "id": "690770314",
                                    "speaker": "Player",
                                    "text": "是留云借风真君吗？"
                                },
                                {
                                    "id": "690770315",
                                    "speaker": "瑶瑶",
                                    "text": "哇，恭喜恭喜，被你猜出来啦！"
                                },
                                {
                                    "id": "690770322",
                                    "speaker": "瑶瑶",
                                    "text": "仙法、机关术…又厉害又实用，瑶瑶对留云阿姨非常钦佩。"
                                },
                                {
                                    "id": "690770323",
                                    "speaker": "瑶瑶",
                                    "text": "有机会的话，我们一起去找她聊天吧！"
                                }
                            ]
                        },
                        {
                            "id": "690770316",
                            "text": "难道是留云借风真君？",
                            "response": [
                                {
                                    "id": "690770317",
                                    "speaker": "瑶瑶",
                                    "text": "哇哇，我还没给提示呢，你怎么一下子就猜出来了！"
                                },
                                {
                                    "id": "690770318",
                                    "speaker": "瑶瑶",
                                    "text": "「才思敏捷」这个词，应该就是用来形容你的吧！恭喜恭喜。"
                                },
                                {
                                    "id": "690770319",
                                    "speaker": "瑶瑶",
                                    "text": "我和留云阿姨相谈甚欢，我们一起吃了我做的凉拌萝卜丝…她又和我讲了很多身边的趣事。"
                                },
                                {
                                    "id": "690770320",
                                    "speaker": "瑶瑶",
                                    "text": "最后，还说和我一见如故，送了我可爱的「月桂」呢！"
                                },
                                {
                                    "id": "690770321",
                                    "speaker": "瑶瑶",
                                    "text": "你知道吗？月桂是通过机关术运作的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907704",
            "initDialog": "690770401",
            "dialogues": [
                {
                    "id": "690770401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690770402",
                    "speaker": "瑶瑶",
                    "text": "你对小团雀感兴趣吗？它们唱歌很好听哦。"
                },
                {
                    "id": "690770403",
                    "speaker": "瑶瑶",
                    "text": "我也会，嘿嘿！"
                },
                {
                    "id": "690770404",
                    "speaker": "Player",
                    "text": "瑶瑶怎么会这个？"
                },
                {
                    "id": "690770405",
                    "speaker": "瑶瑶",
                    "text": "以前家父家母忙于种草药，我时常一个人跑去山林里面玩…"
                },
                {
                    "id": "690770406",
                    "speaker": "瑶瑶",
                    "text": "有一次，碰巧遇到过那种情况哦！大团雀教小团雀唱歌。"
                },
                {
                    "id": "690770407",
                    "speaker": "瑶瑶",
                    "text": "大团雀叫一句，小团雀学一句，瑶瑶也跟一句。啾啾啾~♪",
                    "choices": [
                        {
                            "id": "690770408",
                            "text": "以后可以多来这边玩。",
                            "response": [
                                {
                                    "id": "690770409",
                                    "speaker": "瑶瑶",
                                    "text": "好呀，那我就恭敬不如从命啦！"
                                },
                                {
                                    "id": "690770410",
                                    "speaker": "瑶瑶",
                                    "text": "为了感谢你的「收留之恩」，就让瑶瑶教你小团雀的歌吧。"
                                },
                                {
                                    "id": "690770414",
                                    "speaker": "瑶瑶",
                                    "text": "你放心你放心，这可比练枪简单多啦！"
                                },
                                {
                                    "id": "690770415",
                                    "speaker": "Player",
                                    "text": "但我用的是单手剑…"
                                },
                                {
                                    "id": "690770416",
                                    "speaker": "瑶瑶",
                                    "text": "不用紧张，师父教过我一个词…「触类旁通」！"
                                },
                                {
                                    "id": "690770417",
                                    "speaker": "瑶瑶",
                                    "text": "比起熟练掌握，我更希望你像我一样享受这个放松的过程。"
                                },
                                {
                                    "id": "690770418",
                                    "speaker": "瑶瑶",
                                    "text": "所以，只需要跟着我就好啦，我一句，你跟一句。"
                                },
                                {
                                    "id": "690770419",
                                    "speaker": "瑶瑶",
                                    "text": "其他事情不用操心，瑶瑶都会准备好的！"
                                }
                            ]
                        },
                        {
                            "id": "690770411",
                            "text": "好有意思…",
                            "response": [
                                {
                                    "id": "690770412",
                                    "speaker": "瑶瑶",
                                    "text": "对吧！这就是所谓的…嗯，唔…噢噢…「妙趣横生」！"
                                },
                                {
                                    "id": "690770413",
                                    "speaker": "瑶瑶",
                                    "text": "我想把这份「妙趣」也分享给你！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907705",
            "initDialog": "690770501",
            "dialogues": [
                {
                    "id": "690770501",
                    "speaker": "Player",
                    "text": "早啊，瑶瑶。"
                },
                {
                    "id": "690770502",
                    "speaker": "瑶瑶",
                    "text": "早上好哦，一起来吃早饭吧。"
                },
                {
                    "id": "690770503",
                    "speaker": "瑶瑶",
                    "text": "今天天气很好，等下可以把你的被子拿出来晒晒…"
                }
            ]
        },
        {
            "talkId": "6907706",
            "initDialog": "690770601",
            "dialogues": [
                {
                    "id": "690770601",
                    "speaker": "Player",
                    "text": "晚安，瑶瑶。"
                },
                {
                    "id": "690770602",
                    "speaker": "瑶瑶",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690770603",
                    "speaker": "瑶瑶",
                    "text": "要记得盖好被子，不要着凉了哦。"
                }
            ]
        },
        {
            "talkId": "6907707",
            "initDialog": "690770701",
            "dialogues": [
                {
                    "id": "690770701",
                    "speaker": "瑶瑶",
                    "text": "哇，厨具这么齐全的话，就能做很多好吃的呢！"
                },
                {
                    "id": "690770702",
                    "speaker": "瑶瑶",
                    "text": "嘿嘿，你不用担心哦。我跟师姐学过两手，连师父都吃得津津有味！"
                },
                {
                    "id": "690770703",
                    "speaker": "瑶瑶",
                    "text": "你有什么想吃的呀？瑶瑶这就去给你做。"
                }
            ]
        },
        {
            "talkId": "6907708",
            "initDialog": "690770801",
            "dialogues": [
                {
                    "id": "690770801",
                    "speaker": "瑶瑶",
                    "text": "哇，布置得这么「井然有序」，已经没有需要我来整理的地方了。"
                },
                {
                    "id": "690770802",
                    "speaker": "瑶瑶",
                    "text": "对了，要不我来带你玩吧！"
                },
                {
                    "id": "690770803",
                    "speaker": "瑶瑶",
                    "text": "我让月桂找地方躲起来，你想办法找到它！嘿嘿，我经常跟朋友这样玩哦！"
                }
            ]
        }
    ]
}