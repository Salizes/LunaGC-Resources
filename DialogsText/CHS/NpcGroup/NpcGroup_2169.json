    "talks": [
        {
            "talkId": "6216901",
            "initDialog": "621690101",
            "dialogues": [
                {
                    "id": "621690101",
                    "speaker": "彦博",
                    "text": "你好！"
                }
            ]
        },
        {
            "talkId": "6216902",
            "initDialog": "621690201",
            "dialogues": [
                {
                    "id": "621690201",
                    "speaker": "Player",
                    "text": "最近如何？"
                },
                {
                    "id": "621690202",
                    "speaker": "彦博",
                    "text": "还好，这次收获多多，层岩巨渊应该会安生许多了。"
                }
            ]
        },
        {
            "talkId": "6216903",
            "initDialog": "621690301",
            "dialogues": [
                {
                    "id": "621690301",
                    "speaker": "Player",
                    "text": "有何收获？"
                },
                {
                    "id": "621690302",
                    "speaker": "彦博",
                    "text": "收获嘛…哼，我们只找到了许多矿产原料和…食物、生活物品什么的，这些大多是从璃月港低价采购来的。"
                },
                {
                    "id": "621690303",
                    "speaker": "彦博",
                    "text": "我们原以为食物和生活用品只是掩护，他们在交易其他危险的违禁品…但审讯和排查都没有更多收获。"
                },
                {
                    "id": "621690304",
                    "speaker": "彦博",
                    "text": "看起来他们真的在卖给愚人众食物，真是奇怪……"
                }
            ]
        },
        {
            "talkId": "6216904",
            "initDialog": "621690401",
            "dialogues": [
                {
                    "id": "621690401",
                    "speaker": "Player",
                    "text": "或许愚人众真的需要食物？"
                },
                {
                    "id": "621690402",
                    "speaker": "彦博",
                    "text": "唔…不太可能。除非……"
                }
            ]
        },
        {
            "talkId": "6216905",
            "initDialog": "621690501",
            "dialogues": [
                {
                    "id": "621690501",
                    "speaker": "Player",
                    "text": "除非…？"
                },
                {
                    "id": "621690502",
                    "speaker": "彦博",
                    "text": "没什么，愚人众不太可能为了食物这么大费周章。你也和他们做过对手，一定知道他们不是头脑简单的人…这些诡计多端的家伙一定还有其他目的。"
                },
                {
                    "id": "621690503",
                    "speaker": "彦博",
                    "text": "但无论如何，看起来我们挫败了他们的计划。再次感谢你们的帮助，千岩军是不会忘记你们的功劳的。"
                }
            ]
        }
    ]
}