{
    "groupId": "2618",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 2,
        "海迪夫": 21
    },
    "talks": [
        {
            "talkId": "6261801",
            "initDialog": "626180101",
            "dialogues": [
                {
                    "id": "626180101",
                    "speaker": "海迪夫",
                    "text": "#哦？我还以为你已经离开了呢。你好，{NICKNAME}。"
                },
                {
                    "id": "626180102",
                    "speaker": "海迪夫",
                    "text": "能量读数稳定了许多…谢谢你的努力，等我回去会在论文中提起你的。"
                },
                {
                    "id": "626180103",
                    "speaker": "海迪夫",
                    "text": "不过作为名义上的勘探队雇主，我还需要长期留驻观察影响。"
                }
            ]
        },
        {
            "talkId": "6261802",
            "initDialog": "626180201",
            "dialogues": [
                {
                    "id": "626180201",
                    "speaker": "Player",
                    "text": "我该走了。"
                },
                {
                    "id": "626180202",
                    "speaker": "海迪夫",
                    "text": "我就不强留你了，不过勘探队永远欢迎你到来。"
                }
            ]
        },
        {
            "talkId": "6261803",
            "initDialog": "626180301",
            "dialogues": [
                {
                    "id": "626180301",
                    "speaker": "Player",
                    "text": "关于你的研究课题…"
                },
                {
                    "id": "626180302",
                    "speaker": "海迪夫",
                    "text": "既然你已经帮了我们这么多，为你透露一点大概也没什么问题…"
                },
                {
                    "id": "626180303",
                    "speaker": "海迪夫",
                    "text": "我们来到这里是为了监控深渊之中不断渗出的怪异能量，对于层岩巨渊的影响…"
                },
                {
                    "id": "626180304",
                    "speaker": "海迪夫",
                    "text": "但显然，我们所面临的情况比预想的要复杂不少。"
                },
                {
                    "id": "626180305",
                    "speaker": "海迪夫",
                    "text": "如果不是你们的蛮勇之举，恐怕我们很难取得这么多可用的数据…"
                }
            ]
        },
        {
            "talkId": "7103817",
            "initDialog": "710381705",
            "dialogues": [
                {
                    "id": "710381705",
                    "speaker": "海迪夫",
                    "text": "关于志琼…"
                },
                {
                    "id": "710381701",
                    "speaker": "海迪夫",
                    "text": "志琼的情况又在恶化。这个孩子是在倔强什么呢…"
                },
                {
                    "id": "710381702",
                    "speaker": "海迪夫",
                    "text": "我帮她开了些药，至少能缓和那些比较激烈的症状。现在她的情况稳定下来了…"
                },
                {
                    "id": "710381703",
                    "speaker": "海迪夫",
                    "text": "我不是什么冒险家，不懂他们的那些奇怪的执着，但我也不想眼睁睁看着别人这样自我折磨…"
                },
                {
                    "id": "710381704",
                    "speaker": "海迪夫",
                    "text": "唉…算了，她可能更愿意听你讲道理吧。"
                }
            ]
        },
        {
            "talkId": "7104114",
            "initDialog": "710411401",
            "dialogues": [
                {
                    "id": "710411401",
                    "speaker": "海迪夫",
                    "text": "#你好，{NICKNAME}！在这里遇见你真高兴。",
                    "choices": [
                        {
                            "id": "710411402",
                            "text": "你在这里做什么？",
                            "response": [
                                {
                                    "id": "710411403",
                                    "speaker": "海迪夫",
                                    "text": "实地考察，记录与研究古代生物，以及它们的孑遗。嗯…还有就是，观察地质层的异变情况。"
                                },
                                {
                                    "id": "710411404",
                                    "speaker": "派蒙",
                                    "text": "你不亲自下去考察吗？"
                                },
                                {
                                    "id": "710411405",
                                    "speaker": "海迪夫",
                                    "text": "我不亲自下去考察吗？当然不。"
                                },
                                {
                                    "id": "710411406",
                                    "speaker": "海迪夫",
                                    "text": "你看，这支勘探队是我花钱组建的。我花钱，你们办事；我完成研究，你们有摩拉拿；我开心，你们开心。"
                                },
                                {
                                    "id": "710411407",
                                    "speaker": "海迪夫",
                                    "text": "道理就是这样。"
                                },
                                {
                                    "id": "710411408",
                                    "speaker": "派蒙",
                                    "text": "呜哇…这个家伙，怎么这么招人讨厌！"
                                }
                            ]
                        },
                        {
                            "id": "710411409",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "710411410",
                                    "speaker": "海迪夫",
                                    "text": "别让我耽搁了你的时间。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7105010",
            "initDialog": "710501001",
            "dialogues": [
                {
                    "id": "710501001",
                    "speaker": "海迪夫",
                    "text": "这里的地质环境还真是有趣，这样一来，完成教令院今年的研究指标根本就是绰绰有余。"
                },
                {
                    "id": "710501002",
                    "speaker": "海迪夫",
                    "text": "哦，旅行者，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "7105015",
            "initDialog": "710501003",
            "dialogues": [
                {
                    "id": "710501003",
                    "speaker": "Player",
                    "text": "没事…"
                }
            ]
        }
    ]
}