        "玛蕾蒂": 8
    },
    "talks": [
        {
            "talkId": "6527101",
            "initDialog": "652710101",
            "dialogues": [
                {
                    "id": "652710101",
                    "speaker": "玛蕾蒂",
                    "text": "嗯…啊！你好。找我有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6527102",
            "initDialog": "652710201",
            "dialogues": [
                {
                    "id": "652710201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "652710202",
                    "speaker": "玛蕾蒂",
                    "text": "这里是犯人的登记处…之一。"
                },
                {
                    "id": "652710203",
                    "speaker": "玛蕾蒂",
                    "text": "我这里似乎没有收到新犯人要来的通知…如果你是走错了的话，还请原路返回，或者向附近的看守求助吧。"
                }
            ]
        },
        {
            "talkId": "6527103",
            "initDialog": "652710301",
            "dialogues": [
                {
                    "id": "652710301",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "652710302",
                    "speaker": "玛蕾蒂",
                    "text": "哦，是你啊。我记得你，还有你的小伙伴，是由最高审判官大人点名叫人护送过来的，这可是很少见的呢。"
                },
                {
                    "id": "652710303",
                    "speaker": "玛蕾蒂",
                    "text": "嗯…你的登记信息一切正常，请继续在水下平稳地生活下去，保持这样直到刑期结束吧，嗯。"
                }
            ]
        },
        {
            "talkId": "6527104",
            "initDialog": "652710401",
            "dialogues": [
                {
                    "id": "652710401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "652710402",
                    "speaker": "玛蕾蒂",
                    "text": "慢…哈欠…慢走…"
                }
            ]
        },
        {
            "talkId": "6527105",
            "initDialog": "652710501",
            "dialogues": [
                {
                    "id": "652710501",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "652710502",
                    "speaker": "玛蕾蒂",
                    "text": "哦，是你啊。我记得你，还有你的小伙伴，是由最高审判官大人点名叫人护送过来的，这可是很少见的呢。"
                },
                {
                    "id": "652710503",
                    "speaker": "玛蕾蒂",
                    "text": "嗯…你的文件已经更新过了，恭喜刑期结束！接下来就请回到阳光灿烂的地方好好生活吧。"
                }
            ]
        }
    ]
}