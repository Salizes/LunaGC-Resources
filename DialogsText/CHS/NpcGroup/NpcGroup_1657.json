{
    "groupId": "1657",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "克罗丽丝": 14
    },
    "talks": [
        {
            "talkId": "6165701",
            "initDialog": "616570101",
            "dialogues": [
                {
                    "id": "616570101",
                    "speaker": "克罗丽丝",
                    "text": "哇！好久没有动物跟我搭话了！"
                }
            ]
        },
        {
            "talkId": "6165702",
            "initDialog": "616570201",
            "dialogues": [
                {
                    "id": "616570201",
                    "speaker": "克罗丽丝",
                    "text": "动、动物？"
                },
                {
                    "id": "616570202",
                    "speaker": "克罗丽丝",
                    "text": "我叫克罗丽丝！是蒙德独一无二的植物学家！"
                },
                {
                    "id": "616570203",
                    "speaker": "克罗丽丝",
                    "text": "每天都在野外跟植物作伴，确实少了些动物的陪伴呢。"
                },
                {
                    "id": "616570204",
                    "speaker": "克罗丽丝",
                    "text": "没事儿的话，多跟我说说话吧，拜托~！"
                },
                {
                    "id": "616570205",
                    "speaker": "克罗丽丝",
                    "text": "那…关于你的家人？"
                },
                {
                    "id": "616570206",
                    "speaker": "克罗丽丝",
                    "text": "家人呀，你认识我的妹妹芙萝拉吗？"
                },
                {
                    "id": "616570207",
                    "speaker": "克罗丽丝",
                    "text": "那个只喜欢花的小丫头，在蒙德开了花店呢。"
                },
                {
                    "id": "616570208",
                    "speaker": "克罗丽丝",
                    "text": "比起她，我就博爱得多啦，凡是植物我都很感兴趣，越新奇越好！"
                },
                {
                    "id": "616570209",
                    "speaker": "克罗丽丝",
                    "text": "这么一看，果然我是姐姐呢，唉…那个不争气的妹妹…"
                }
            ]
        },
        {
            "talkId": "6165703",
            "initDialog": "616570301",
            "dialogues": [
                {
                    "id": "616570301",
                    "speaker": "克罗丽丝",
                    "text": "再见。"
                },
                {
                    "id": "616570302",
                    "speaker": "克罗丽丝",
                    "text": "唔……你、你这就走啦？"
                }
            ]
        },
        {
            "talkId": "6165704",
            "initDialog": "616570401",
            "dialogues": [
                {
                    "id": "616570401",
                    "speaker": "克罗丽丝",
                    "text": "可以卖给我一些植物吗？"
                },
                {
                    "id": "616570402",
                    "speaker": "克罗丽丝",
                    "text": "可以哦，我这边和芙萝拉的花店不同，什么植物都有哦！"
                }
            ]
        }
    ]
}