    "talks": [
        {
            "talkId": "6781501",
            "initDialog": "678150101",
            "dialogues": [
                {
                    "id": "678150101",
                    "speaker": "鲁萨诺夫",
                    "text": "没想到「老阁下」就这么走了，唉…"
                }
            ]
        },
        {
            "talkId": "6781502",
            "initDialog": "678150201",
            "dialogues": [
                {
                    "id": "678150201",
                    "speaker": "Player",
                    "text": "「老阁下」？"
                },
                {
                    "id": "678150202",
                    "speaker": "鲁萨诺夫",
                    "text": "是啊，说是患了急病，但谁也没想到他走得那么快。听帮派里的弟兄们说，这其中搞不好有什么阴谋。"
                },
                {
                    "id": "678150203",
                    "speaker": "鲁萨诺夫",
                    "text": "这阵子下面的小帮派都活跃起来了，还有传闻说「高桌」说不定也会有变化…"
                },
                {
                    "id": "678150204",
                    "speaker": "鲁萨诺夫",
                    "text": "不过嘛，和我这种最底层的小人物是没什么关系了。总不至于过阵子连我这来回的车票也得自己负担了不是？"
                }
            ]
        },
        {
            "talkId": "6781503",
            "initDialog": "678150301",
            "dialogues": [
                {
                    "id": "678150301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "678150302",
                    "speaker": "鲁萨诺夫",
                    "text": "哦。"
                }
            ]
        }
    ]
}