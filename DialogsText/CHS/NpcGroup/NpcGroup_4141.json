{
    "groupId": "4141",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "法拉纳兹": 15
    },
    "talks": [
        {
            "talkId": "6414101",
            "initDialog": "641410101",
            "dialogues": [
                {
                    "id": "641410101",
                    "speaker": "法拉纳兹",
                    "text": "…「联盟」就此覆灭，真是可惜啊…"
                }
            ]
        },
        {
            "talkId": "6414102",
            "initDialog": "641410201",
            "dialogues": [
                {
                    "id": "641410201",
                    "speaker": "Player",
                    "text": "「联盟」？"
                },
                {
                    "id": "641410202",
                    "speaker": "法拉纳兹",
                    "text": "欸，你没听见我刚才讲的故事吗？"
                },
                {
                    "id": "641410203",
                    "speaker": "法拉纳兹",
                    "text": "没关系，我再给你说一遍！"
                },
                {
                    "id": "641410204",
                    "speaker": "法拉纳兹",
                    "text": "说当年，在奥摩斯港不那么太平的时候，「二十九海洋代伊联盟」成立了。"
                },
                {
                    "id": "641410205",
                    "speaker": "法拉纳兹",
                    "text": "加入其中的各大海盗首领审时度势，成立了公平划分权力的「联盟」。"
                },
                {
                    "id": "641410206",
                    "speaker": "法拉纳兹",
                    "text": "每位「盟主」，也就是「代伊」，都立誓和平共处，共赴繁荣。"
                },
                {
                    "id": "641410207",
                    "speaker": "法拉纳兹",
                    "text": "只是没想到…"
                }
            ]
        },
        {
            "talkId": "6414103",
            "initDialog": "641410301",
            "dialogues": [
                {
                    "id": "641410301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641410302",
                    "speaker": "法拉纳兹",
                    "text": "在大海的怒吼平息之后，一切都成了废墟…"
                }
            ]
        },
        {
            "talkId": "6414104",
            "initDialog": "641410401",
            "dialogues": [
                {
                    "id": "641410401",
                    "speaker": "Player",
                    "text": "有内鬼？"
                },
                {
                    "id": "641410402",
                    "speaker": "法拉纳兹",
                    "text": "唉，的确有这部分原因。毕竟都是唯利是图的海盗啊，友好共处可不是他们的作风。"
                },
                {
                    "id": "641410403",
                    "speaker": "法拉纳兹",
                    "text": "但我觉得，如果有纷争，那就一定会有胜利者，所以不至于连最后一个「代伊」也没能剩下吧？"
                },
                {
                    "id": "641410404",
                    "speaker": "法拉纳兹",
                    "text": "但在海兽的侵袭面前，人人平等。"
                },
                {
                    "id": "641410405",
                    "speaker": "法拉纳兹",
                    "text": "有民间传说称，曾有前所未见的巨大海兽卷起滔天的巨浪，将「联盟」一夜之间全部瓦解…"
                },
                {
                    "id": "641410406",
                    "speaker": "法拉纳兹",
                    "text": "哎，真是个好故事啊，只写进论文里就太可惜了。"
                }
            ]
        },
        {
            "talkId": "6414105",
            "initDialog": "641410501",
            "dialogues": [
                {
                    "id": "641410501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6414106",
            "initDialog": "641410601",
            "dialogues": [
                {
                    "id": "641410601",
                    "speaker": "法拉纳兹",
                    "text": "看到牌组里一个个角色被击倒，心情真是复杂啊…"
                }
            ]
        },
        {
            "talkId": "6414107",
            "initDialog": "641410701",
            "dialogues": [
                {
                    "id": "641410701",
                    "speaker": "法拉纳兹",
                    "text": "哈哈，将不同的牌放进一个牌组里，很有「联盟」的感觉呢…"
                }
            ]
        }
    ]
}