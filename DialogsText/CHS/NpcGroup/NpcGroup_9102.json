{
    "groupId": "9102",
    "total_dialogue_lines": 88,
    "speaker_counts": {
        "Player": 22,
        "玛拉妮": 66
    },
    "talks": [
        {
            "talkId": "6910201",
            "initDialog": "691020101",
            "dialogues": [
                {
                    "id": "691020101",
                    "speaker": "玛拉妮",
                    "text": "旅途的最终目的地，是家。"
                },
                {
                    "id": "691020102",
                    "speaker": "玛拉妮",
                    "text": "哼哼，我就知道在这里能等到你的！"
                }
            ]
        },
        {
            "talkId": "6910202",
            "initDialog": "691020201",
            "dialogues": [
                {
                    "id": "691020201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691020202",
                    "speaker": "玛拉妮",
                    "text": "嘻嘻，从小到大我既不怕生又不认床，在这里真的没有一点不习惯哎。"
                },
                {
                    "id": "691020203",
                    "speaker": "玛拉妮",
                    "text": "你知道吗？在纳塔，大多数龙伙伴都很有领地意识，只有它们接纳的人才会被允许进入自己的地盘。"
                },
                {
                    "id": "691020204",
                    "speaker": "玛拉妮",
                    "text": "你能邀请我来这里，说明是把我当好朋友了。我真的很开心，嘴角这一整天都压不下来！",
                    "choices": [
                        {
                            "id": "691020205",
                            "text": "没错，我就是这样的龙。",
                            "response": [
                                {
                                    "id": "691020206",
                                    "speaker": "玛拉妮",
                                    "text": "哈哈…那你的领地真的很漂亮哦！"
                                },
                                {
                                    "id": "691020207",
                                    "speaker": "玛拉妮",
                                    "text": "在纳塔人的观念里，龙是伙伴、是家人、是不可或缺的一份子。"
                                },
                                {
                                    "id": "691020208",
                                    "speaker": "玛拉妮",
                                    "text": "你也是我人生中重要的朋友，所以我才会这样比喻。"
                                },
                                {
                                    "id": "691020212",
                                    "speaker": "Player",
                                    "text": "「咿——」"
                                },
                                {
                                    "id": "691020213",
                                    "speaker": "玛拉妮",
                                    "text": "…欸？"
                                },
                                {
                                    "id": "691020214",
                                    "speaker": "Player",
                                    "text": "像不像鳍游龙开心的叫声？"
                                },
                                {
                                    "id": "691020215",
                                    "speaker": "玛拉妮",
                                    "text": "哈哈哈，听出来了听出来了！"
                                },
                                {
                                    "id": "691020216",
                                    "speaker": "玛拉妮",
                                    "text": "「咿——」！「咿——」！「咿——」！"
                                }
                            ]
                        },
                        {
                            "id": "691020209",
                            "text": "龙伙伴有表达开心的叫声吗？",
                            "response": [
                                {
                                    "id": "691020210",
                                    "speaker": "玛拉妮",
                                    "text": "哈？哈哈哈，还真问倒我了…要不，我们自创一个？"
                                },
                                {
                                    "id": "691020211",
                                    "speaker": "玛拉妮",
                                    "text": "作为我们两个人的「叫声暗号」，用来表示愉快啊、打招呼啊、好笑啊之类正面的信号！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910203",
            "initDialog": "691020301",
            "dialogues": [
                {
                    "id": "691020301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691020302",
                    "speaker": "玛拉妮",
                    "text": "时机掐的真准啊，我已经把周围都逛过一圈，还跟阿圆聊过一轮了，正打算找你聊聊天呢。"
                },
                {
                    "id": "691020303",
                    "speaker": "Player",
                    "text": "融入得很快嘛！"
                },
                {
                    "id": "691020304",
                    "speaker": "玛拉妮",
                    "text": "毕竟这里对我来说还算新地方嘛，我喜欢多逛逛走走，多跟当地居民聊一聊什么的…"
                },
                {
                    "id": "691020305",
                    "speaker": "玛拉妮",
                    "text": "说起来，我也很好奇，你每到一个新的地方时，会用怎样的方式融入那里呢？",
                    "choices": [
                        {
                            "id": "691020306",
                            "text": "提前做好详细的旅行计划。",
                            "response": [
                                {
                                    "id": "691020307",
                                    "speaker": "玛拉妮",
                                    "text": "噢…像你这样细心严谨的人，果然不会错过任何精彩的风景和活动吧？"
                                },
                                {
                                    "id": "691020308",
                                    "speaker": "玛拉妮",
                                    "text": "大街小巷钻个遍，村野林间也尽情探索，美食美景统统都能体验到…"
                                },
                                {
                                    "id": "691020309",
                                    "speaker": "玛拉妮",
                                    "text": "我想象得出来…有你做旅伴，旅途一定会超级充实！"
                                },
                                {
                                    "id": "691020314",
                                    "speaker": "玛拉妮",
                                    "text": "嗯！我记住你的偏好了，下次一起旅行时就那么办吧！"
                                },
                                {
                                    "id": "691020315",
                                    "speaker": "玛拉妮",
                                    "text": "好期待呀…未知的旅行，真想早点出发！"
                                },
                                {
                                    "id": "691020316",
                                    "speaker": "Player",
                                    "text": "去过的地方，还会期待吗？"
                                },
                                {
                                    "id": "691020317",
                                    "speaker": "玛拉妮",
                                    "text": "当然啦！"
                                },
                                {
                                    "id": "691020318",
                                    "speaker": "玛拉妮",
                                    "text": "来「流泉之众」度假的旅人一般只会选择几条热门的游玩路线，每一条我都走过无数遍了。"
                                },
                                {
                                    "id": "691020319",
                                    "speaker": "玛拉妮",
                                    "text": "毫不夸张地说，闭着眼我都能认路，哈哈。"
                                },
                                {
                                    "id": "691020320",
                                    "speaker": "玛拉妮",
                                    "text": "不过，我才舍不得闭上眼，因为对于我来说，每一次出发，都是全新的旅途。"
                                },
                                {
                                    "id": "691020321",
                                    "speaker": "玛拉妮",
                                    "text": "说变就变的天气、路边新开的野花、突然蹿出来吓我一跳的小动物…就连天上的云都是不一样的呢！"
                                },
                                {
                                    "id": "691020322",
                                    "speaker": "玛拉妮",
                                    "text": "更别说有的旅客会临时改变主意，放着笔直好走的大路不走，非要钻进弯弯曲曲的小道上…呃…"
                                },
                                {
                                    "id": "691020323",
                                    "speaker": "Player",
                                    "text": "真是让人头疼的旅客呀！"
                                },
                                {
                                    "id": "691020324",
                                    "speaker": "玛拉妮",
                                    "text": "欸？我没有在抱怨啦，也不这么认为。"
                                },
                                {
                                    "id": "691020325",
                                    "speaker": "玛拉妮",
                                    "text": "恰恰相反，多走很多弯路不就是意味着多看了很多不同的风景吗？怎么算都不亏，嘻嘻…"
                                },
                                {
                                    "id": "691020326",
                                    "speaker": "Player",
                                    "text": "不愧是你，那我们也多走弯路吧！"
                                },
                                {
                                    "id": "691020327",
                                    "speaker": "玛拉妮",
                                    "text": "不愧是你…也、也行？"
                                },
                                {
                                    "id": "691020328",
                                    "speaker": "玛拉妮",
                                    "text": "总之，你想走什么路我都奉陪！可是，万一哪天不想走的话——"
                                },
                                {
                                    "id": "691020329",
                                    "speaker": "玛拉妮",
                                    "text": "就踩着我的冲浪板前进吧！"
                                }
                            ]
                        },
                        {
                            "id": "691020310",
                            "text": "随遇而安，轻松最重要。",
                            "response": [
                                {
                                    "id": "691020311",
                                    "speaker": "玛拉妮",
                                    "text": "我举双手双脚同意！"
                                },
                                {
                                    "id": "691020312",
                                    "speaker": "玛拉妮",
                                    "text": "你难道也跟我一样，是很难早起的人吗？哈哈哈…"
                                },
                                {
                                    "id": "691020313",
                                    "speaker": "玛拉妮",
                                    "text": "没有一定要完成的目标，而是享受每一次偶遇。虽然不知道是惊是喜，但这大概也是旅行的魅力之一吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910204",
            "initDialog": "691020401",
            "dialogues": [
                {
                    "id": "691020401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691020402",
                    "speaker": "玛拉妮",
                    "text": "派对！我们办一个派对吧！"
                },
                {
                    "id": "691020403",
                    "speaker": "玛拉妮",
                    "text": "你看啊，这里场地这么大，而且你还有这么多朋友…"
                },
                {
                    "id": "691020404",
                    "speaker": "玛拉妮",
                    "text": "哇…光是想想这种热闹非凡的场景…就已经开始兴奋了！",
                    "choices": [
                        {
                            "id": "691020405",
                            "text": "好耶，泳池派对怎么样？",
                            "response": [
                                {
                                    "id": "691020406",
                                    "speaker": "玛拉妮",
                                    "text": "好耶！是我最喜欢的泳池派对！"
                                },
                                {
                                    "id": "691020407",
                                    "speaker": "玛拉妮",
                                    "text": "既然办派对的主意是我提出的，就请让我来布置场地吧。"
                                },
                                {
                                    "id": "691020408",
                                    "speaker": "玛拉妮",
                                    "text": "唔…首先要确认派对的规模，如果朋友们全都到齐，那就需要一个超级巨大的泳池…好像有点难办…"
                                },
                                {
                                    "id": "691020409",
                                    "speaker": "玛拉妮",
                                    "text": "有了！我可以把卡齐娜的冲天转转借过来，泳池不够，我挖着来凑！"
                                },
                                {
                                    "id": "691020413",
                                    "speaker": "玛拉妮",
                                    "text": "哦对了，所有水上用品和客人们的泳衣都由我的店来赞助吧，我去多进些货。"
                                },
                                {
                                    "id": "691020414",
                                    "speaker": "Player",
                                    "text": "玛拉妮果然很有钱！"
                                },
                                {
                                    "id": "691020415",
                                    "speaker": "玛拉妮",
                                    "text": "你就别抬举我啦，只要朋友们玩得开心，这些花费就很划算啊。"
                                },
                                {
                                    "id": "691020416",
                                    "speaker": "玛拉妮",
                                    "text": "大不了派对结束后我加倍努力工作好啦！玩的时候尽兴最重要。"
                                },
                                {
                                    "id": "691020417",
                                    "speaker": "玛拉妮",
                                    "text": "那就这么定喽？"
                                },
                                {
                                    "id": "691020418",
                                    "speaker": "玛拉妮",
                                    "text": "呼，已经开始紧张了，这么大型的派对我也是第一次筹备…"
                                },
                                {
                                    "id": "691020419",
                                    "speaker": "Player",
                                    "text": "果然人太多连你也会害怕吧。"
                                },
                                {
                                    "id": "691020420",
                                    "speaker": "玛拉妮",
                                    "text": "不是哦，我其实在担心太普通的登场方式不能引起大家的注意。"
                                },
                                {
                                    "id": "691020421",
                                    "speaker": "Player",
                                    "text": "还是我多虑了！"
                                },
                                {
                                    "id": "691020422",
                                    "speaker": "玛拉妮",
                                    "text": "哎呀，我是人越多我干劲越足的类型嘛，你是知道的。"
                                },
                                {
                                    "id": "691020423",
                                    "speaker": "玛拉妮",
                                    "text": "快给我些建议好不好？你点子多，拜托啦拜托啦。",
                                    "choices": [
                                        {
                                            "id": "691020424",
                                            "text": "唱着歌进场？",
                                            "response": [
                                                {
                                                    "id": "691020425",
                                                    "speaker": "玛拉妮",
                                                    "text": "嘿，我怎么没想过？还能先去「花羽会」偷偷师，他们的嗓音都很好听。"
                                                },
                                                {
                                                    "id": "691020428",
                                                    "speaker": "玛拉妮",
                                                    "text": "谢谢你的建议，嘿嘿，我一定不会辜负你。"
                                                },
                                                {
                                                    "id": "691020429",
                                                    "speaker": "玛拉妮",
                                                    "text": "就请等着我的闪亮登场吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691020426",
                                            "text": "跳着舞进场？",
                                            "response": [
                                                {
                                                    "id": "691020427",
                                                    "speaker": "玛拉妮",
                                                    "text": "采纳！我这就去「回声之子」紧急训练一番，他们擅长的舞蹈绝对抓人眼球！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691020410",
                            "text": "温泉派对是个好主意！",
                            "response": [
                                {
                                    "id": "691020411",
                                    "speaker": "玛拉妮",
                                    "text": "哇，真的吗？这可是我们「流泉之众」最擅长的领域，交给我吧。"
                                },
                                {
                                    "id": "691020412",
                                    "speaker": "玛拉妮",
                                    "text": "考虑到大家的口味不同，点心和饮料得多准备几个种类…龙龙饼干还是多备一些吧，纳塔特色嘛…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910205",
            "initDialog": "691020501",
            "dialogues": [
                {
                    "id": "691020501",
                    "speaker": "Player",
                    "text": "早啊，玛拉妮。"
                },
                {
                    "id": "691020502",
                    "speaker": "玛拉妮",
                    "text": "早呀！刚刚起床的时候差点又昏睡过去了…"
                },
                {
                    "id": "691020503",
                    "speaker": "玛拉妮",
                    "text": "但一想到醒了就能见到你，我马上就不困了，弹射起床——嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6910206",
            "initDialog": "691020601",
            "dialogues": [
                {
                    "id": "691020601",
                    "speaker": "Player",
                    "text": "晚安，玛拉妮。"
                },
                {
                    "id": "691020602",
                    "speaker": "玛拉妮",
                    "text": "#嗯，晚安，{NICKNAME}。"
                },
                {
                    "id": "691020603",
                    "speaker": "玛拉妮",
                    "text": "好好休息哦，我们明天见！"
                }
            ]
        },
        {
            "talkId": "6910210",
            "initDialog": "691021001",
            "dialogues": [
                {
                    "id": "691021001",
                    "speaker": "玛拉妮",
                    "text": "我没眼花吧？你该不会把我家都搬来了吧？哈哈哈哈，惊喜中的惊喜！"
                },
                {
                    "id": "691021002",
                    "speaker": "玛拉妮",
                    "text": "这种感觉就像，拿着「再来一瓶」的瓶盖去兑奖，开盖一看，还是「再来一瓶」，走大运喽~"
                },
                {
                    "id": "691021003",
                    "speaker": "玛拉妮",
                    "text": "我要把这样的好运气传递下去，首先就得传给你，听着：大好人，你出门一定会捡到摩拉！"
                }
            ]
        },
        {
            "talkId": "6910211",
            "initDialog": "691021101",
            "dialogues": [
                {
                    "id": "691021101",
                    "speaker": "玛拉妮",
                    "text": "厉害…好多宽敞又漂亮的摊位！随便我布置？真的假的？！我想想…"
                },
                {
                    "id": "691021102",
                    "speaker": "玛拉妮",
                    "text": "龙龙大水床放这里，那边用来展示夜晚专用的墨镜，哦，差点忘了「友情金三角冲浪板」，三个人同时踩着才能动，很刺激！"
                },
                {
                    "id": "691021103",
                    "speaker": "玛拉妮",
                    "text": "全都是我新进的货，有眼光吧？随便挑，喜欢哪件我送你！"
                }
            ]
        }
    ]
}