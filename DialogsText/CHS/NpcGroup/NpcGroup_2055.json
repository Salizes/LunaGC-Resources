{
    "groupId": "2055",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 6,
        "大脚": 21
    },
    "talks": [
        {
            "talkId": "6205501",
            "initDialog": "620550101",
            "dialogues": [
                {
                    "id": "620550101",
                    "speaker": "大脚",
                    "text": "啊，我是大脚，来办手续的，你也是吗？"
                }
            ]
        },
        {
            "talkId": "6205502",
            "initDialog": "620550201",
            "dialogues": [
                {
                    "id": "620550201",
                    "speaker": "Player",
                    "text": "你办什么手续？"
                },
                {
                    "id": "620550202",
                    "speaker": "大脚",
                    "text": "我是个抬花轿的，刚换了个新的轿子，想要申请「花轿木牌」，不然在路上会被千岩军拦住的…"
                },
                {
                    "id": "620550203",
                    "speaker": "大脚",
                    "text": "可我刚一开口，就被塞了一个「花轿资格证」的申请表格，我说资格证我早就有了，是来申请木牌…"
                },
                {
                    "id": "620550204",
                    "speaker": "大脚",
                    "text": "话还没说完，她又把表格收回去了，来了句「填完了就回家等通知」。"
                },
                {
                    "id": "620550205",
                    "speaker": "大脚",
                    "text": "这不完全没在听人说话吗，唉…"
                }
            ]
        },
        {
            "talkId": "6205503",
            "initDialog": "620550301",
            "dialogues": [
                {
                    "id": "620550301",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620550302",
                    "speaker": "大脚",
                    "text": "岩王爷的死啊，我反正是不信的。"
                },
                {
                    "id": "620550303",
                    "speaker": "大脚",
                    "text": "岩王爷活了上千年了，凭啥刚好让我这辈人赶上这种事，"
                },
                {
                    "id": "620550304",
                    "speaker": "大脚",
                    "text": "要我说，肯定是七星在搞什么名堂。"
                },
                {
                    "id": "620550305",
                    "speaker": "大脚",
                    "text": "你看总务司这些家伙的态度，一定没安好心…"
                },
                {
                    "id": "620550306",
                    "speaker": "大脚",
                    "text": "啊，我就是想到哪儿说到哪儿，随口说说，你可别说给千岩军听啊，行行好…"
                }
            ]
        },
        {
            "talkId": "6205504",
            "initDialog": "620550401",
            "dialogues": [
                {
                    "id": "620550401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620550402",
                    "speaker": "大脚",
                    "text": "哦，我可是先来的，你记得别插我队啊。"
                }
            ]
        },
        {
            "talkId": "6205505",
            "initDialog": "620550501",
            "dialogues": [
                {
                    "id": "620550501",
                    "speaker": "大脚",
                    "text": "好像吃太多了，钱包又被清空了，唉…"
                }
            ]
        },
        {
            "talkId": "6205506",
            "initDialog": "620550601",
            "dialogues": [
                {
                    "id": "620550601",
                    "speaker": "Player",
                    "text": "吃了什么？"
                },
                {
                    "id": "620550602",
                    "speaker": "大脚",
                    "text": "吃虎鱼和中原杂碎，吃了多少就记不清了…"
                },
                {
                    "id": "620550603",
                    "speaker": "大脚",
                    "text": "我一开吃就没完，毕竟是干体力活儿的人，胃口大。"
                },
                {
                    "id": "620550604",
                    "speaker": "大脚",
                    "text": "话说你知不知道，「吃虎鱼」的「吃」字其实不这么写，以前我花轿上一位客人告诉过我，应该是…"
                },
                {
                    "id": "620550605",
                    "speaker": "大脚",
                    "text": "欸，应该怎么写来着…"
                },
                {
                    "id": "620550606",
                    "speaker": "大脚",
                    "text": "…不对啊，我不是不识字么…"
                }
            ]
        },
        {
            "talkId": "6205507",
            "initDialog": "620550701",
            "dialogues": [
                {
                    "id": "620550701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620550702",
                    "speaker": "大脚",
                    "text": "再见，别饿着自己。"
                }
            ]
        },
        {
            "talkId": "6205508",
            "initDialog": "620550801",
            "dialogues": [
                {
                    "id": "620550801",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620550802",
                    "speaker": "大脚",
                    "text": "嘿，虽说这「送仙典仪」也办了，但我还是不信岩王爷死了。"
                },
                {
                    "id": "620550803",
                    "speaker": "大脚",
                    "text": "要我说，这肯定是七星的计划，他们指不定在背地里谋划着什么呢…"
                },
                {
                    "id": "620550804",
                    "speaker": "大脚",
                    "text": "…啊，我就这么一说，你就那么一听，可别跟别人乱说啊。"
                }
            ]
        }
    ]
}