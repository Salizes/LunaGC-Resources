{
    "groupId": "1563",
    "total_dialogue_lines": 131,
    "speaker_counts": {
        "Player": 30,
        "利文斯通博士": 98,
        "派蒙": 3
    },
    "talks": [
        {
            "talkId": "7065501",
            "initDialog": "706550101",
            "dialogues": [
                {
                    "id": "706550101",
                    "speaker": "利文斯通博士",
                    "text": "又见面了，旅行者。"
                },
                {
                    "id": "706550102",
                    "speaker": "派蒙",
                    "text": "利文斯通小姐的情绪还挺高涨的，最近是发生了什么好事吗？"
                },
                {
                    "id": "706550103",
                    "speaker": "利文斯通博士",
                    "text": "是一件乍看很麻烦，其实很有意思的事情。"
                },
                {
                    "id": "706550104",
                    "speaker": "利文斯通博士",
                    "text": "像你这样充满进取心和智慧，又不乏力量的冒险家，一定也会感兴趣的。",
                    "choices": [
                        {
                            "id": "706550105",
                            "text": "是什么事情呢？",
                            "response": [
                                {
                                    "id": "706550107",
                                    "speaker": "利文斯通博士",
                                    "text": "你还记得之前的<color=#00E1FFFF>好肉族擂台</color>吧？最近好像达达乌帕在围绕着好肉族擂台举行什么无限制战斗的大赛哦。"
                                },
                                {
                                    "id": "706550108",
                                    "speaker": "利文斯通博士",
                                    "text": "之前我不是说过，还要留下来继续研究来着嘛。这个活动弄得整个山谷异常热闹，只要一天还在举办，我的研究就一天没办法有进展。"
                                },
                                {
                                    "id": "706550109",
                                    "speaker": "利文斯通博士",
                                    "text": "不过无限制的强者战斗欸，这不是超级有意思的吗？"
                                },
                                {
                                    "id": "706550110",
                                    "speaker": "派蒙",
                                    "text": "有、有意思？"
                                },
                                {
                                    "id": "706550111",
                                    "speaker": "利文斯通博士",
                                    "text": "诞生在这个大陆上，任谁都曾做过「提瓦特最强」的梦吧？丘丘人它们居然也不例外。"
                                },
                                {
                                    "id": "706550112",
                                    "speaker": "利文斯通博士",
                                    "text": "达达乌帕谷作为丘丘人的圣山之一，全大陆的强者都在前往这里的路上。"
                                },
                                {
                                    "id": "706550113",
                                    "speaker": "Player",
                                    "text": "不至于不至于…"
                                },
                                {
                                    "id": "706550114",
                                    "speaker": "利文斯通博士",
                                    "text": "总之，我觉得你作为征服过<color=#00E1FFFF>好肉族擂台</color>的人，不如再去试试吧？"
                                },
                                {
                                    "id": "706550115",
                                    "speaker": "利文斯通博士",
                                    "text": "如果你能迅速席卷比赛，我的研究就能尽快恢复常态。这不是两全其美吗？"
                                },
                                {
                                    "id": "706550116",
                                    "speaker": "Player",
                                    "text": "我考虑考虑。"
                                },
                                {
                                    "id": "706550117",
                                    "speaker": "利文斯通博士",
                                    "text": "我也会尽我可能为你提供帮助的。向着星辰与深渊。"
                                }
                            ]
                        },
                        {
                            "id": "706550106",
                            "text": "听听也无妨。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7065502",
            "initDialog": "706550201",
            "dialogues": [
                {
                    "id": "706550201",
                    "speaker": "利文斯通博士",
                    "text": "唉，真是头疼。果然这个东西不处理不行啊。"
                },
                {
                    "id": "706550202",
                    "speaker": "派蒙",
                    "text": "怎么了？"
                },
                {
                    "id": "706550203",
                    "speaker": "利文斯通博士",
                    "text": "达达乌帕谷的这三道<color=#00E1FFFF>封印</color>虽说本来的目的是为了守护逝者的尊严。不过如今可能有些过时了。"
                },
                {
                    "id": "706550204",
                    "speaker": "利文斯通博士",
                    "text": "对于达达乌帕谷的秘密研究，以及对于遗物的妥善安置——还有后续的一系列冒险活动，如果不解开<color=#00E1FFFF>封印</color>就无法进行。"
                },
                {
                    "id": "4180260",
                    "speaker": "利文斯通博士",
                    "text": "我利文斯通，已经根据元素力量的流向，算出了维持结界的封印位置！"
                },
                {
                    "id": "4180261",
                    "speaker": "利文斯通博士",
                    "text": "<color=#00E1FFFF>三个封印结界</color>所对应的<color=#00E1FFFF>三个机关</color>，分别在附近的<color=#00E1FFFF>三个丘丘人部落中</color>…"
                },
                {
                    "id": "4180262",
                    "speaker": "利文斯通博士",
                    "text": "<color=#00E1FFFF>北方</color>的丘丘人部落符合大学者艾伦对「好肉族」的记载。基本上，就是喜欢肌肉、喜欢吃肉的部落。根本没有冒险家追求智慧的精神！"
                },
                {
                    "id": "4180263",
                    "speaker": "利文斯通博士",
                    "text": "机关在好肉族营地比试力量的<color=#00E1FFFF>大擂台</color>上。当时我摸进营地，正准备对机关下手。谁知一旦踏上擂台，就等于接受了他们的挑战，马上冲进来一大群…"
                },
                {
                    "id": "4180264",
                    "speaker": "利文斯通博士",
                    "text": "呜…"
                },
                {
                    "id": "4180265",
                    "speaker": "利文斯通博士",
                    "text": "如果能把它们教训得心服口服，就有机会解除封印结界了吧…"
                },
                {
                    "id": "4180268",
                    "speaker": "Player",
                    "text": "其他机关…"
                },
                {
                    "id": "4180270",
                    "speaker": "利文斯通博士",
                    "text": "另一个封印机关在<color=#00E1FFFF>南方</color>的「好睡族」部落中。是<color=#00E1FFFF>入夜以后，就会呼呼大睡</color>的丘丘人部落。根本没有冒险家不分昼夜的勤奋精神！"
                },
                {
                    "id": "4180271",
                    "speaker": "利文斯通博士",
                    "text": "机关就在营地的<color=#00E1FFFF>水池</color>里。当时我趁着夜色摸进营地，结果水池边竟然守着个拿着大盾的大块头…"
                },
                {
                    "id": "4180272",
                    "speaker": "利文斯通博士",
                    "text": "<color=#00E1FFFF>向东顺着谷地上坡</color>能找到「黑日族」的营地。根据记载，是崇尚萨满传统的部落。根本没有冒险家打破循规蹈矩的冒险精神！"
                },
                {
                    "id": "4180273",
                    "speaker": "利文斯通博士",
                    "text": "机关在<color=#00E1FFFF>营地的中心</color>。但机关周围不但有黑日族的丘丘萨满，甚至还有深渊法师…"
                },
                {
                    "id": "4180274",
                    "speaker": "利文斯通博士",
                    "text": "呜…我利文斯通作为冒险家，拥有不输给群星的智慧，胸怀穷尽一切废都的勇气，却没有蛮干的力量！"
                },
                {
                    "id": "4180275",
                    "speaker": "Player",
                    "text": "真遗憾…"
                },
                {
                    "id": "4180280",
                    "speaker": "利文斯通博士",
                    "text": "你也觉得很可惜吧？对吧？"
                },
                {
                    "id": "4180281",
                    "speaker": "利文斯通博士",
                    "text": "错了！我等冒险家的词典里，没有「可惜」一词！"
                },
                {
                    "id": "4180282",
                    "speaker": "利文斯通博士",
                    "text": "只有「不够努力」！为了不留下遗憾，就要用尽全力去做才对！星空和深渊都在等着我们，年轻的冒险家！"
                },
                {
                    "id": "4180283",
                    "speaker": "利文斯通博士",
                    "text": "可气啊！有的事情就算再努力也是我利文斯通做不到的…"
                },
                {
                    "id": "4180284",
                    "speaker": "利文斯通博士",
                    "text": "<color=#00E1FFFF>击败三个部落的丘丘人，解除三个封印机关</color>…这种事情就算再有冒险精神，没有蛮力也不够嘛！"
                },
                {
                    "id": "4180285",
                    "speaker": "利文斯通博士",
                    "text": "真想知道封印结界当中守护着什么样的<color=#00E1FFFF>宝物</color>！好在意！在意得不得了！"
                },
                {
                    "id": "4180286",
                    "speaker": "利文斯通博士",
                    "text": "如果你也是货真价实的冒险家，自信拥有不输给任何人的智慧与勇气，那就去挑战吧！"
                },
                {
                    "id": "4180287",
                    "speaker": "利文斯通博士",
                    "text": "但是，我的冒险家同伴哟！一定要注意安全。"
                },
                {
                    "id": "4180288",
                    "speaker": "利文斯通博士",
                    "text": "大地上还有无限的秘密，可不要轻易沦为废墟中的枯骨。"
                }
            ]
        },
        {
            "talkId": "7093701",
            "initDialog": "709370101",
            "dialogues": [
                {
                    "id": "709370101",
                    "speaker": "Player",
                    "text": "你是冒险家吗？"
                },
                {
                    "id": "709370102",
                    "speaker": "利文斯通博士",
                    "text": "对呀，在别人看来我更像学者一些吧…不过我的主业确实是冒险家。"
                },
                {
                    "id": "709370103",
                    "speaker": "利文斯通博士",
                    "text": "这是近期我研究剑冢的一些笔记，希望能对你有所帮助。"
                },
                {
                    "id": "709370104",
                    "speaker": "利文斯通博士",
                    "text": "冒险家就是要互相帮助嘛，向着星辰与深渊！"
                }
            ]
        },
        {
            "talkId": "41802",
            "initDialog": "4180201",
            "dialogues": [
                {
                    "id": "4180201",
                    "speaker": "利文斯通博士",
                    "text": "该怎么办呢…虽然明白了<color=#00E1FFFF>解除封印结界</color>的原理，但这么多魔物果然还是…"
                },
                {
                    "id": "4180210",
                    "speaker": "Player",
                    "text": "怎么回事？"
                },
                {
                    "id": "4180220",
                    "speaker": "利文斯通博士",
                    "text": "嗯？想得出神了，不好意思。我是利文斯通，是一个职业冒险家。"
                },
                {
                    "id": "4180221",
                    "speaker": "利文斯通博士",
                    "text": "在这魔物丛生的凶险谷地中，竟然能见到魔物以外的身影，听见魔物的喧嚣以外的声音…"
                },
                {
                    "id": "4180222",
                    "speaker": "利文斯通博士",
                    "text": "想必你也与我一样，是充满进取与探索精神的同行冒险家！"
                },
                {
                    "id": "4180223",
                    "speaker": "利文斯通博士",
                    "text": "心里向着未知的星空，步履迈向幽暗的深渊，这就是我等冒险家的灵魂！"
                },
                {
                    "id": "4180224",
                    "speaker": "利文斯通博士",
                    "text": "这里是古老的战场，幸存者运用元素之力，布设了<color=#00E1FFFF>三重封印结界</color>，让战友的剑冢不被魔物染指。"
                },
                {
                    "id": "4180225",
                    "speaker": "利文斯通博士",
                    "text": "但是…怎么办呢…"
                },
                {
                    "id": "4180226",
                    "speaker": "利文斯通博士",
                    "text": "…"
                },
                {
                    "id": "4180227",
                    "speaker": "利文斯通博士",
                    "text": "唔？想得出神了，不好意思。刚刚说到哪来着？",
                    "choices": [
                        {
                            "id": "4180230",
                            "text": "「染指」。",
                            "response": [
                                {
                                    "id": "4180240",
                                    "speaker": "利文斯通博士",
                                    "text": "唔？这些剑和…其中的<color=#00E1FFFF>宝物</color>，应该是当年的战士留下的遗物吧。怎么能让附近的<color=#00E1FFFF>三个丘丘人部落</color>染指呢！"
                                },
                                {
                                    "id": "4180241",
                                    "speaker": "利文斯通博士",
                                    "text": "我们不是丘丘人，所以称不上「染指」。我们是运用智慧，征服世界一切秘密的冒险家！"
                                },
                                {
                                    "id": "4180242",
                                    "speaker": "利文斯通博士",
                                    "text": "话虽如此，可是<color=#00E1FFFF>封印</color>…"
                                },
                                {
                                    "id": "4180243",
                                    "speaker": "利文斯通博士",
                                    "text": "怎么办呢…",
                                    "choices": [
                                        {
                                            "id": "4180250",
                                            "text": "封印？"
                                        },
                                        {
                                            "id": "4180251",
                                            "text": "丘丘人部落？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4180231",
                            "text": "封印？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "41803",
            "initDialog": "4180301",
            "dialogues": [
                {
                    "id": "4180301",
                    "speaker": "利文斯通博士",
                    "text": "这座剑冢可真让人伤脑筋啊…",
                    "choices": [
                        {
                            "id": "4180302",
                            "text": "关于剑冢…",
                            "response": [
                                {
                                    "id": "4180303",
                                    "speaker": "利文斯通博士",
                                    "text": "这座剑冢很久以前就在这里了，大概是过去讨伐魔物的战士们留下的遗物…"
                                },
                                {
                                    "id": "4180304",
                                    "speaker": "利文斯通博士",
                                    "text": "古代的勇者为了防止周围的丘丘人玷污剑冢，特意布下了三层封印。只有分别击败三个丘丘人部落，触发部落中的机关，才能解开。",
                                    "choices": [
                                        {
                                            "id": "4180305",
                                            "text": "关于丘丘人部落…",
                                            "response": [
                                                {
                                                    "id": "4180306",
                                                    "speaker": "利文斯通博士",
                                                    "text": "剑冢周围一共有三个丘丘人部落，分别是北方的「好肉族」、南方的「好睡族」和东边谷地中的「黑日族」。",
                                                    "choices": [
                                                        {
                                                            "id": "4180318",
                                                            "text": "好肉族？",
                                                            "response": [
                                                                {
                                                                    "id": "4180319",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "就是北边的部族啦。"
                                                                },
                                                                {
                                                                    "id": "4180320",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "顾名思义，「好肉族」喜欢吃肉，痴迷肌肉，"
                                                                },
                                                                {
                                                                    "id": "4180321",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "所以个个肌肉发达，头脑简单"
                                                                },
                                                                {
                                                                    "id": "4180322",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "不巧的是，封印的机关恰恰在大擂台中央。"
                                                                },
                                                                {
                                                                    "id": "4180323",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "一旦闯进去，就会被当成挑战者，和他们来一场大群殴。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "4180324",
                                                            "text": "好睡族？",
                                                            "response": [
                                                                {
                                                                    "id": "4180325",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "「好睡族」在剑冢的南边。"
                                                                },
                                                                {
                                                                    "id": "4180326",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "它们整天嗜睡，但却非常狡猾，诡计多端。"
                                                                },
                                                                {
                                                                    "id": "4180327",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "所以不要被它们懒洋洋的模样骗了，它们一点也不好对付！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "4180328",
                                                            "text": "黑日族？",
                                                            "response": [
                                                                {
                                                                    "id": "4180329",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "「黑日族」在东边的谷地中，是三个部族中最危险的，它们崇尚萨满传统，每天都神神叨叨的…"
                                                                },
                                                                {
                                                                    "id": "4180330",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "那里的萨满虽然不信七神，却也能够驱使自然元素的力量。"
                                                                },
                                                                {
                                                                    "id": "4180331",
                                                                    "speaker": "利文斯通博士",
                                                                    "text": "另外那里还有深渊法师出没…若不是亲眼见到，我还以为那只是古籍中的传说…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4180307",
                                            "text": "为什么机关会在丘丘人部落里？",
                                            "response": [
                                                {
                                                    "id": "4180308",
                                                    "speaker": "利文斯通博士",
                                                    "text": "这…是个好问题。以丘丘人的智力，它们是不会制造和处理机关的…所以…或许机关本身也是古代的英雄们留在此地的遗迹吧？"
                                                },
                                                {
                                                    "id": "4180309",
                                                    "speaker": "利文斯通博士",
                                                    "text": "一方面机关降下了保护剑冢的封印，另一方面此地的丘丘人又恰好为剑冢充当了卫士的工作，"
                                                },
                                                {
                                                    "id": "4180310",
                                                    "speaker": "利文斯通博士",
                                                    "text": "既发挥了人类的智力，也利用了丘丘人的愚蠢…或许这就是古代人的智慧吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4180332",
                                            "text": "听起来很危险呢。",
                                            "response": [
                                                {
                                                    "id": "4180333",
                                                    "speaker": "利文斯通博士",
                                                    "text": "话是这样说的，但是对于我们冒险家而言，「危险」也只是家常便饭而已啦！"
                                                },
                                                {
                                                    "id": "4180334",
                                                    "speaker": "利文斯通博士",
                                                    "text": "我们冒险家都是为征服星空与深渊而生的人，为了区区危险而停下探索步伐，这样的人也太无聊了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4180335",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "4180336",
                                    "speaker": "利文斯通博士",
                                    "text": "嗯，注意安全啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6156301",
            "initDialog": "615630101",
            "dialogues": [
                {
                    "id": "615630101",
                    "speaker": "利文斯通博士",
                    "text": "嗯？不好意思，自顾自想得有点出神了。"
                }
            ]
        },
        {
            "talkId": "6156302",
            "initDialog": "615630201",
            "dialogues": [
                {
                    "id": "615630201",
                    "speaker": "Player",
                    "text": "关于剑冢…"
                },
                {
                    "id": "615630202",
                    "speaker": "利文斯通博士",
                    "text": "看样子，你是外地来的旅行者吧？这座剑冢很久以前就在这里了，大概是过去讨伐魔物的战士们留下的遗物…"
                },
                {
                    "id": "615630203",
                    "speaker": "利文斯通博士",
                    "text": "古代的勇者为了防止周围的丘丘人玷污剑冢，特意布下了三层封印。只有分别击败三个丘丘人部落，触发部落中的机关，才能解开。",
                    "choices": [
                        {
                            "id": "615630204",
                            "text": "关于丘丘人部落…",
                            "response": [
                                {
                                    "id": "615630205",
                                    "speaker": "利文斯通博士",
                                    "text": "剑冢周围一共有三个丘丘人部落，分别是北方的「好肉族」、南方的「好睡族」和东边谷地中的「黑日族」。",
                                    "choices": [
                                        {
                                            "id": "615630218",
                                            "text": "好肉族？",
                                            "response": [
                                                {
                                                    "id": "615630219",
                                                    "speaker": "利文斯通博士",
                                                    "text": "就是北边的部族啦。"
                                                },
                                                {
                                                    "id": "615630220",
                                                    "speaker": "利文斯通博士",
                                                    "text": "顾名思义，「好肉族」喜欢吃肉，痴迷肌肉，"
                                                },
                                                {
                                                    "id": "615630221",
                                                    "speaker": "利文斯通博士",
                                                    "text": "所以个个肌肉发达，头脑简单"
                                                },
                                                {
                                                    "id": "615630222",
                                                    "speaker": "利文斯通博士",
                                                    "text": "不巧的是，封印的机关恰恰在大擂台中央。"
                                                },
                                                {
                                                    "id": "615630223",
                                                    "speaker": "利文斯通博士",
                                                    "text": "一旦闯进去，就会被当成挑战者，和他们来一场大群殴。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "615630224",
                                            "text": "好睡族？",
                                            "response": [
                                                {
                                                    "id": "615630225",
                                                    "speaker": "利文斯通博士",
                                                    "text": "「好睡族」在剑冢的南边。"
                                                },
                                                {
                                                    "id": "615630226",
                                                    "speaker": "利文斯通博士",
                                                    "text": "它们整天嗜睡，但却非常狡猾，诡计多端。"
                                                },
                                                {
                                                    "id": "615630227",
                                                    "speaker": "利文斯通博士",
                                                    "text": "所以不要被它们懒洋洋的模样骗了，它们一点也不好对付！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "615630228",
                                            "text": "黑日族？",
                                            "response": [
                                                {
                                                    "id": "615630229",
                                                    "speaker": "利文斯通博士",
                                                    "text": "「黑日族」在东边的谷地中，是三个部族中最危险的，它们崇尚萨满传统，每天都神神叨叨的…"
                                                },
                                                {
                                                    "id": "615630230",
                                                    "speaker": "利文斯通博士",
                                                    "text": "那里的萨满虽然不信七神，却也能够驱使自然元素的力量。"
                                                },
                                                {
                                                    "id": "615630231",
                                                    "speaker": "利文斯通博士",
                                                    "text": "另外那里还有深渊法师出没…若不是亲眼见到，我还以为那只是古籍中的传说…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "615630206",
                            "text": "为什么机关会在丘丘人部落里？",
                            "response": [
                                {
                                    "id": "615630207",
                                    "speaker": "利文斯通博士",
                                    "text": "这…是个好问题。以丘丘人的智力，它们是不会制造和处理机关的…所以…或许机关本身也是古代的英雄们留在此地的遗迹吧？"
                                },
                                {
                                    "id": "615630208",
                                    "speaker": "利文斯通博士",
                                    "text": "一方面机关降下了保护剑冢的封印，另一方面此地的丘丘人又恰好为剑冢充当了卫士的工作，"
                                },
                                {
                                    "id": "615630209",
                                    "speaker": "利文斯通博士",
                                    "text": "既发挥了人类的智力，也利用了丘丘人的愚蠢…或许这就是古代人的智慧吧。"
                                }
                            ]
                        },
                        {
                            "id": "615630232",
                            "text": "听起来很危险呢。",
                            "response": [
                                {
                                    "id": "615630233",
                                    "speaker": "利文斯通博士",
                                    "text": "话是这样说的，但是对于我们冒险家而言，「危险」也只是家常便饭而已啦！"
                                },
                                {
                                    "id": "615630234",
                                    "speaker": "利文斯通博士",
                                    "text": "我们冒险家都是为征服星空与深渊而生的人，为了区区危险而停下探索步伐，这样的人也太无聊了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6156303",
            "initDialog": "615630301",
            "dialogues": [
                {
                    "id": "615630301",
                    "speaker": "Player",
                    "text": "关于剑冢…"
                },
                {
                    "id": "615630302",
                    "speaker": "利文斯通博士",
                    "text": "什么…你已经解开剑冢的封印了？！"
                },
                {
                    "id": "615630303",
                    "speaker": "利文斯通博士",
                    "text": "那些丘丘人部落…也都被你解决了吗？"
                },
                {
                    "id": "615630304",
                    "speaker": "Player",
                    "text": "没错。"
                },
                {
                    "id": "615630305",
                    "speaker": "利文斯通博士",
                    "text": "想不到你也是这样充满进取心和智慧，尤其不乏力量的冒险家！"
                },
                {
                    "id": "615630306",
                    "speaker": "利文斯通博士",
                    "text": "感谢你达成了我没有做到的成就，但我还会留在这里。"
                },
                {
                    "id": "615630307",
                    "speaker": "利文斯通博士",
                    "text": "这座剑冢还有太多的谜团等待被揭开，"
                },
                {
                    "id": "615630308",
                    "speaker": "利文斯通博士",
                    "text": "我想，解开久远的谜题，是我作为冒险家与学者的义务，所以我还会在这里继续研究的！"
                }
            ]
        },
        {
            "talkId": "6156304",
            "initDialog": "615630401",
            "dialogues": [
                {
                    "id": "615630401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615630402",
                    "speaker": "利文斯通博士",
                    "text": "注意安全哦！"
                }
            ]
        }
    ]
}