{
    "groupId": "2305",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "阿佐": 15
    },
    "talks": [
        {
            "talkId": "4003748",
            "initDialog": "400374801",
            "dialogues": [
                {
                    "id": "400374801",
                    "speaker": "阿佐",
                    "text": "那两个奇怪的大哥哥又来了…"
                },
                {
                    "id": "400374802",
                    "speaker": "阿佐",
                    "text": "以前就经常见他俩来这边读书，没想到海灯节也能遇到他们。"
                },
                {
                    "id": "400374803",
                    "speaker": "阿佐",
                    "text": "只是他俩好像在聊什么妖魔之类的东西，难道是在编故事吗？"
                }
            ]
        },
        {
            "talkId": "7192601",
            "initDialog": "719260101",
            "dialogues": [
                {
                    "id": "719260101",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "719260102",
                    "speaker": "阿佐",
                    "text": "谢谢你！可是青蛙实在是太难抓了…"
                },
                {
                    "id": "719260103",
                    "speaker": "阿佐",
                    "text": "…到现在为止我只抓住了几只蜥蜴，还只抓到了它们的尾巴。"
                },
                {
                    "id": "719260104",
                    "speaker": "阿佐",
                    "text": "那个，不嫌弃的话，就请你收下吧，我还得继续抓青蛙呢，这些拿在手上有些不方便。"
                }
            ]
        },
        {
            "talkId": "6230501",
            "initDialog": "623050101",
            "dialogues": [
                {
                    "id": "623050101",
                    "speaker": "阿佐",
                    "text": "不好意思，你看到青蛙了吗？"
                }
            ]
        },
        {
            "talkId": "6230502",
            "initDialog": "623050201",
            "dialogues": [
                {
                    "id": "623050201",
                    "speaker": "Player",
                    "text": "青蛙？"
                },
                {
                    "id": "623050202",
                    "speaker": "阿佐",
                    "text": "我刚刚在抓一只青蛙，它的背很滑，不小心让它跳走了。"
                },
                {
                    "id": "623050203",
                    "speaker": "阿佐",
                    "text": "难得遇上这么精神的青蛙，能抓到就好了…"
                }
            ]
        },
        {
            "talkId": "6230503",
            "initDialog": "623050301",
            "dialogues": [
                {
                    "id": "623050301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "623050302",
                    "speaker": "阿佐",
                    "text": "再见~！"
                }
            ]
        },
        {
            "talkId": "6230504",
            "initDialog": "623050204",
            "dialogues": [
                {
                    "id": "623050204",
                    "speaker": "Player",
                    "text": "拿青蛙做什么？"
                },
                {
                    "id": "623050205",
                    "speaker": "阿佐",
                    "text": "我抓青蛙是为了送给妹妹玩的。"
                },
                {
                    "id": "623050206",
                    "speaker": "阿佐",
                    "text": "那边的小女孩就是我的妹妹，她总是在追自己的影子，明明是不可能抓得到的，不知道她在想什么…"
                },
                {
                    "id": "623050207",
                    "speaker": "阿佐",
                    "text": "可能她也很无聊吧，抓一只青蛙让她去追，也总好过追影子。"
                },
                {
                    "id": "623050208",
                    "speaker": "Player",
                    "text": "为什么你不陪她玩？"
                },
                {
                    "id": "623050209",
                    "speaker": "阿佐",
                    "text": "我觉得她不喜欢我，无论说什么她都不听我的，更别说陪她玩了。"
                },
                {
                    "id": "623050210",
                    "speaker": "阿佐",
                    "text": "明明她想要的东西我都想办法送给她了，是都不合她的心意吗…？"
                }
            ]
        }
    ]
}