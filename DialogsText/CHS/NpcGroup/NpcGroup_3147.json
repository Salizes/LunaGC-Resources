{
    "groupId": "3147",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "和泉那希": 8
    },
    "talks": [
        {
            "talkId": "6314701",
            "initDialog": "631470101",
            "dialogues": [
                {
                    "id": "631470101",
                    "speaker": "和泉那希",
                    "text": "愿今年的海祇岛依旧风调雨顺…"
                }
            ]
        },
        {
            "talkId": "6314702",
            "initDialog": "631470201",
            "dialogues": [
                {
                    "id": "631470201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "631470202",
                    "speaker": "和泉那希",
                    "text": "我是珊瑚宫的巫女，听从「现人神巫女」大人的吩咐。"
                }
            ]
        },
        {
            "talkId": "6314703",
            "initDialog": "631470301",
            "dialogues": [
                {
                    "id": "631470301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631470302",
                    "speaker": "和泉那希",
                    "text": "再见，「海祇大御神」保佑你。"
                }
            ]
        },
        {
            "talkId": "6314704",
            "initDialog": "631470401",
            "dialogues": [
                {
                    "id": "631470401",
                    "speaker": "Player",
                    "text": "关于「现人神巫女」大人…"
                },
                {
                    "id": "631470402",
                    "speaker": "和泉那希",
                    "text": "「现人神巫女」大人即是珊瑚宫心海大人，也就是海祇岛的最高统领。"
                },
                {
                    "id": "631470403",
                    "speaker": "和泉那希",
                    "text": "珊瑚宫大人血统特殊，是海祇岛的唯一继承人，珊瑚宫的人员自然全部听从她的调遣。"
                },
                {
                    "id": "631470404",
                    "speaker": "和泉那希",
                    "text": "「现人神巫女」大人德才兼备，熟悉各个领域的事务，是海祇岛名副其实的领袖。"
                },
                {
                    "id": "631470405",
                    "speaker": "和泉那希",
                    "text": "…只是大人需要处理的事情太多了，难免需要一个安静的思考环境。"
                },
                {
                    "id": "631470406",
                    "speaker": "和泉那希",
                    "text": "因此我建议如无要事，还是不要总去打扰大人比较好哦。"
                }
            ]
        }
    ]
}