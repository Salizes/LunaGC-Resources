{
    "groupId": "2011",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Player": 12,
        "范二爷": 37
    },
    "talks": [
        {
            "talkId": "4003737",
            "initDialog": "400373701",
            "dialogues": [
                {
                    "id": "400373701",
                    "speaker": "范二爷",
                    "text": "您来捧场啦？来，坐这儿吧，别客气。"
                },
                {
                    "id": "400373702",
                    "speaker": "范二爷",
                    "text": "不知您是不是听过云先生的新戏了？哎，没的说，云先生真不愧是我们璃月的名角儿啊！"
                },
                {
                    "id": "400373703",
                    "speaker": "范二爷",
                    "text": "只不过每每听到云先生的戏，我就会想起那些过去的故事，唏嘘啊…"
                }
            ]
        },
        {
            "talkId": "6201110",
            "initDialog": "620111001",
            "dialogues": [
                {
                    "id": "620111001",
                    "speaker": "Player",
                    "text": "关于星燕…"
                },
                {
                    "id": "620111002",
                    "speaker": "范二爷",
                    "text": "星燕？什么星燕？哪位？"
                }
            ]
        },
        {
            "talkId": "6201111",
            "initDialog": "620111101",
            "dialogues": [
                {
                    "id": "620111101",
                    "speaker": "Player",
                    "text": "云堇的朋友…"
                },
                {
                    "id": "620111102",
                    "speaker": "范二爷",
                    "text": "哦…对对，哎呀人年纪大了，记性就越来越差了哈哈。"
                },
                {
                    "id": "620111103",
                    "speaker": "范二爷",
                    "text": "这大晚上的，我家星燕也要休息了，你找她有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6201112",
            "initDialog": "620111201",
            "dialogues": [
                {
                    "id": "620111201",
                    "speaker": "Player",
                    "text": "你的养女…"
                },
                {
                    "id": "620111202",
                    "speaker": "范二爷",
                    "text": "哦…对对，哎呀人年纪大了，记性就越来越差了哈哈。"
                },
                {
                    "id": "620111203",
                    "speaker": "范二爷",
                    "text": "这大晚上的，我家星燕也要休息了，你找她有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6201113",
            "initDialog": "620111301",
            "dialogues": [
                {
                    "id": "620111301",
                    "speaker": "Player",
                    "text": "想看摇滚演出。"
                },
                {
                    "id": "620111302",
                    "speaker": "范二爷",
                    "text": "…是云老板叫你来的吗？"
                },
                {
                    "id": "620111303",
                    "speaker": "范二爷",
                    "text": "这个云老板哟，每次想听个摇滚演出都得找借口，就怕他们戏社的老几位知道。"
                },
                {
                    "id": "620111304",
                    "speaker": "范二爷",
                    "text": "我多大年纪的人了，还得跟她一起扯谎，每次都要对口供，跟秘密行动似的…"
                },
                {
                    "id": "620111305",
                    "speaker": "范二爷",
                    "text": "嘿，想想还有点带劲。"
                }
            ]
        },
        {
            "talkId": "6201101",
            "initDialog": "620110101",
            "dialogues": [
                {
                    "id": "620110101",
                    "speaker": "范二爷",
                    "text": "好，好！真过瘾！"
                }
            ]
        },
        {
            "talkId": "6201102",
            "initDialog": "620110201",
            "dialogues": [
                {
                    "id": "620110201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "620110202",
                    "speaker": "范二爷",
                    "text": "嗬，您听听！过瘾！"
                },
                {
                    "id": "620110203",
                    "speaker": "Player",
                    "text": "你好？"
                },
                {
                    "id": "620110204",
                    "speaker": "范二爷",
                    "text": "欸哟！您说这个…多急人！讲故事也不给讲完了！"
                }
            ]
        },
        {
            "talkId": "6201103",
            "initDialog": "620110301",
            "dialogues": [
                {
                    "id": "620110301",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620110302",
                    "speaker": "范二爷",
                    "text": "去去去，还管那么多，天塌下来也没有听完这段儿戏重要！"
                },
                {
                    "id": "620110303",
                    "speaker": "范二爷",
                    "text": "等等…你刚才是说岩王爷的事儿？"
                },
                {
                    "id": "620110304",
                    "speaker": "范二爷",
                    "text": "那确实跟天塌下来差不多…"
                },
                {
                    "id": "620110305",
                    "speaker": "范二爷",
                    "text": "你居然也知道这种消息？"
                }
            ]
        },
        {
            "talkId": "6201104",
            "initDialog": "620110401",
            "dialogues": [
                {
                    "id": "620110401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "620110402",
                    "speaker": "范二爷",
                    "text": "好！！再来一段！"
                }
            ]
        },
        {
            "talkId": "6201105",
            "initDialog": "620110501",
            "dialogues": [
                {
                    "id": "620110501",
                    "speaker": "范二爷",
                    "text": "您来捧场啦？来，坐这儿吧，别客气。"
                }
            ]
        },
        {
            "talkId": "6201106",
            "initDialog": "620110601",
            "dialogues": [
                {
                    "id": "620110601",
                    "speaker": "Player",
                    "text": "您贵姓？"
                },
                {
                    "id": "620110602",
                    "speaker": "范二爷",
                    "text": "嘿嘿，免贵姓范，叫我一声二爷就行，这儿的晚辈都这么叫我。"
                },
                {
                    "id": "620110603",
                    "speaker": "范二爷",
                    "text": "我就是这个茶馆的老板，怎么样，您还满意吧？"
                }
            ]
        },
        {
            "talkId": "6201107",
            "initDialog": "620110701",
            "dialogues": [
                {
                    "id": "620110701",
                    "speaker": "Player",
                    "text": "关于茶馆…"
                },
                {
                    "id": "620110702",
                    "speaker": "范二爷",
                    "text": "嗯，这个茶馆怎么样？这个戏台、这些桌子椅子，楼上的雅间，戏班子和厨子们…"
                },
                {
                    "id": "620110703",
                    "speaker": "范二爷",
                    "text": "都是我一手翻新的，年轻时候我也吃了不少苦啊…那个戏台，曾经的我和若心在上面唱了一出又一出。"
                },
                {
                    "id": "620110704",
                    "speaker": "范二爷",
                    "text": "后来我也出了点小名，熬出头了…就把店面盘下来自己经营了。"
                },
                {
                    "id": "620110705",
                    "speaker": "范二爷",
                    "text": "您问若心是谁？嘿嘿，你们年轻人这一代是没见识咯，这么说吧…放在四十年前，她可是丝毫不逊于云堇的名角儿！"
                },
                {
                    "id": "620110706",
                    "speaker": "范二爷",
                    "text": "可惜她被那个绿衣服的什么冒险家给骗了，一生无依无靠，唏嘘啊…"
                },
                {
                    "id": "620110707",
                    "speaker": "范二爷",
                    "text": "如果我能再早点跟她讲出来我的心意…唉，不提了不提了，几十年的事儿了都。"
                }
            ]
        },
        {
            "talkId": "6201108",
            "initDialog": "620110801",
            "dialogues": [
                {
                    "id": "620110801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620110802",
                    "speaker": "范二爷",
                    "text": "不多坐会儿了吗？那您慢走！"
                }
            ]
        },
        {
            "talkId": "6201109",
            "initDialog": "620110901",
            "dialogues": [
                {
                    "id": "620110901",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620110902",
                    "speaker": "范二爷",
                    "text": "去去去，还管那么多，天塌下来也没有听完这段儿戏重要！"
                },
                {
                    "id": "620110903",
                    "speaker": "范二爷",
                    "text": "等等…你刚才是说岩王爷的事儿？"
                },
                {
                    "id": "620110904",
                    "speaker": "范二爷",
                    "text": "那确实跟天塌下来差不多…"
                }
            ]
        },
        {
            "talkId": "7201101",
            "initDialog": "720110101",
            "dialogues": [
                {
                    "id": "720110101",
                    "speaker": "范二爷",
                    "text": "欸，干什么，别打岔！"
                },
                {
                    "id": "720110102",
                    "speaker": "范二爷",
                    "text": "淮安先生现在讲的这段，可是经典中的经典，叫「碧水河」！"
                },
                {
                    "id": "720110103",
                    "speaker": "范二爷",
                    "text": "今年「明霄灯」的造型就是纪念这段书里的主角「移霄导天真君」。"
                },
                {
                    "id": "720110104",
                    "speaker": "范二爷",
                    "text": "快听听吧，今年海灯节听这段，再合适不过了！"
                }
            ]
        }
    ]
}