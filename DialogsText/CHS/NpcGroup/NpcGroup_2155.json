{
    "groupId": "2155",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 10,
        "赞玛兰": 20
    },
    "talks": [
        {
            "talkId": "1503208",
            "initDialog": "150320801",
            "dialogues": [
                {
                    "id": "150320801",
                    "speaker": "赞玛兰",
                    "text": "……",
                    "choices": [
                        {
                            "id": "150320802",
                            "text": "关于「蕈之贤主」…",
                            "response": [
                                {
                                    "id": "150320803",
                                    "speaker": "赞玛兰",
                                    "text": "…有智慧者提到了久远之名，它是元祖，空有力量，却无智慧，连四脚的也比不上。"
                                },
                                {
                                    "id": "150320804",
                                    "speaker": "赞玛兰",
                                    "text": "用两脚的话说，它是「笨蛋父亲」。"
                                },
                                {
                                    "id": "150320805",
                                    "speaker": "派蒙",
                                    "text": "真是简单易懂的评价啊。"
                                },
                                {
                                    "id": "150320806",
                                    "speaker": "赞玛兰",
                                    "text": "它与我早无关联，我都快忘了这个名字，说不出更多有趣的事。但你们来看我，很有趣。"
                                },
                                {
                                    "id": "150320807",
                                    "speaker": "赞玛兰",
                                    "text": "嗯…它还好吗？"
                                },
                                {
                                    "id": "150320808",
                                    "speaker": "派蒙",
                                    "text": "比你差远了。"
                                },
                                {
                                    "id": "150320809",
                                    "speaker": "赞玛兰",
                                    "text": "那就好。"
                                }
                            ]
                        },
                        {
                            "id": "150320810",
                            "text": "静静聆听…",
                            "response": [
                                {
                                    "id": "150320811",
                                    "speaker": "赞玛兰",
                                    "text": "…愚痴未尝不是福气，有智也可招来祸灾…"
                                },
                                {
                                    "id": "150320812",
                                    "speaker": "赞玛兰",
                                    "text": "…经智慧的灵浆浇灌过的生命才能如此茁壮…"
                                },
                                {
                                    "id": "150320813",
                                    "speaker": "赞玛兰",
                                    "text": "…唯漂泊的冒险者无惧旷野的荒凉…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7106101",
            "initDialog": "710610101",
            "dialogues": [
                {
                    "id": "710610101",
                    "speaker": "赞玛兰",
                    "text": "两脚但不用脚的小东西太过多疑。"
                },
                {
                    "id": "710610102",
                    "speaker": "派蒙",
                    "text": "我不叫什么「两脚但不用脚的小东西」！我叫派蒙！气死我了，一定要找机会给你取一个难听的绰号。"
                },
                {
                    "id": "710610103",
                    "speaker": "派蒙",
                    "text": "对了，就叫你「大蘑头」好了！"
                },
                {
                    "id": "710610104",
                    "speaker": "派蒙",
                    "text": "周围好像飘着一些发光的粉尘，看起来像是蘑菇的孢子，不知道我们能听到蘑菇的声音是不是和它们有关系。"
                },
                {
                    "id": "710610105",
                    "speaker": "赞玛兰",
                    "text": "赞玛兰知道许多有脚但不用脚的，不知道派蒙。"
                },
                {
                    "id": "710610106",
                    "speaker": "派蒙",
                    "text": "哼哼，那是因为我是特别的呀。"
                },
                {
                    "id": "710610107",
                    "speaker": "赞玛兰",
                    "text": "赞玛兰知道两脚的，怪哉怪哉，有熟悉的气息。"
                },
                {
                    "id": "710610108",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你认识大蘑头吗？",
                    "choices": [
                        {
                            "id": "710610109",
                            "text": "不认识。",
                            "response": [
                                {
                                    "id": "710610111",
                                    "speaker": "赞玛兰",
                                    "text": "是镀金的热砂与幽邃的雨林的气息，是故乡的气息。"
                                },
                                {
                                    "id": "710610112",
                                    "speaker": "派蒙",
                                    "text": "热砂和雨林，是说须弥吗？我们的确在营地和从须弥来的学者接触过…"
                                },
                                {
                                    "id": "710610113",
                                    "speaker": "赞玛兰",
                                    "text": "赞玛兰虽然已经离开故乡有些时日，但绝不会错认。"
                                },
                                {
                                    "id": "710610114",
                                    "speaker": "赞玛兰",
                                    "text": "#两脚的{NICKNAME}，有缘之人，赞玛兰有事相求。"
                                },
                                {
                                    "id": "710610115",
                                    "speaker": "赞玛兰",
                                    "text": "赞玛兰在此处安住已久，原本此地是处惬意的居所…"
                                },
                                {
                                    "id": "710610116",
                                    "speaker": "赞玛兰",
                                    "text": "但近来邪气愈来愈盛，为抵御邪气，赞玛兰耗尽了气力，落得如此模样，不得已而向两脚的求救。"
                                },
                                {
                                    "id": "710610117",
                                    "speaker": "派蒙",
                                    "text": "仔细看看，大蘑头确实很没精神呢，好像生病了一样。"
                                },
                                {
                                    "id": "710610118",
                                    "speaker": "派蒙",
                                    "text": "#唔，对了，{NICKNAME}，要不要把「触媒」的能量分给大蘑头？也许这样它就能打起精神来了。"
                                }
                            ]
                        },
                        {
                            "id": "710610110",
                            "text": "也许认识，但是不记得了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7106107",
            "initDialog": "710610701",
            "dialogues": [
                {
                    "id": "710610701",
                    "speaker": "赞玛兰",
                    "text": "…愚痴未尝不是福气，有智也可招来祸灾…"
                },
                {
                    "id": "710610702",
                    "speaker": "赞玛兰",
                    "text": "…经智慧的灵浆浇灌过的生命才能如此茁壮…"
                },
                {
                    "id": "710610703",
                    "speaker": "赞玛兰",
                    "text": "…唯漂泊的冒险者无惧旷野的荒凉…"
                }
            ]
        }
    ]
}