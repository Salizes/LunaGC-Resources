{
    "groupId": "5142",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "伊维斯": 11
    },
    "talks": [
        {
            "talkId": "6514201",
            "initDialog": "651420101",
            "dialogues": [
                {
                    "id": "651420101",
                    "speaker": "伊维斯",
                    "text": "一辈子靠租来的潜水服干活也不是个办法…唉。"
                }
            ]
        },
        {
            "talkId": "6514202",
            "initDialog": "651420201",
            "dialogues": [
                {
                    "id": "651420201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "651420202",
                    "speaker": "伊维斯",
                    "text": "您好，您好。让您看到我在发牢骚的样子了，真是抱歉。"
                },
                {
                    "id": "651420203",
                    "speaker": "伊维斯",
                    "text": "如您所见，我是一名潜水员，平常除了为老板干活以外，有空时也会接些别的委托。"
                },
                {
                    "id": "651420204",
                    "speaker": "伊维斯",
                    "text": "所以如果您需要打捞什么东西，可以来找我，委托费好商量。"
                },
                {
                    "id": "651420205",
                    "speaker": "伊维斯",
                    "text": "…只要潜水设备不出问题，老板的任务能顺利完成的话，我尽力提供帮助。"
                }
            ]
        },
        {
            "talkId": "6514203",
            "initDialog": "651420301",
            "dialogues": [
                {
                    "id": "651420301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "651420302",
                    "speaker": "伊维斯",
                    "text": "没关系。需要打捞服务的话可以来找我。"
                }
            ]
        },
        {
            "talkId": "6514204",
            "initDialog": "651420401",
            "dialogues": [
                {
                    "id": "651420401",
                    "speaker": "Player",
                    "text": "听上去似乎你更需要帮助。"
                },
                {
                    "id": "651420402",
                    "speaker": "伊维斯",
                    "text": "老实说，我大概已经接受了工作永远也做不完的现实。"
                },
                {
                    "id": "651420403",
                    "speaker": "伊维斯",
                    "text": "毕竟戈尔德曼——啊，也就是我的老板，是那样一位…「精打细算」的人。"
                },
                {
                    "id": "651420404",
                    "speaker": "伊维斯",
                    "text": "所以我平时一般都在这附近，忙着应对可能出问题的潜水服…"
                },
                {
                    "id": "651420405",
                    "speaker": "伊维斯",
                    "text": "还有深埋海底的打捞物，和那些嫌我生活太顺利的海草和垃圾…"
                },
                {
                    "id": "651420406",
                    "speaker": "伊维斯",
                    "text": "抱歉抱歉，我又忍不住唠叨起来了，希望您不要放在心上。无论如何，感谢您的关心。"
                }
            ]
        }
    ]
}