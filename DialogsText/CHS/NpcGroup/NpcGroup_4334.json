{
    "groupId": "4334",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "库拉什": 10
    },
    "talks": [
        {
            "talkId": "6433401",
            "initDialog": "643340101",
            "dialogues": [
                {
                    "id": "643340101",
                    "speaker": "库拉什",
                    "text": "呦，看样子，你是来这的游客吗？"
                }
            ]
        },
        {
            "talkId": "6433402",
            "initDialog": "643340201",
            "dialogues": [
                {
                    "id": "643340201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "643340202",
                    "speaker": "库拉什",
                    "text": "我叫库拉什，也是从外面来到这里的。"
                },
                {
                    "id": "643340203",
                    "speaker": "库拉什",
                    "text": "以前我在沙漠里，为了生活学了不少能耐，还曾经想过要不要加入镀金旅团…"
                },
                {
                    "id": "643340204",
                    "speaker": "库拉什",
                    "text": "不过一想到要为了那些雇主奔波，实在是头大…还不如找个村子，过充实又悠闲的生活呢。"
                },
                {
                    "id": "643340205",
                    "speaker": "库拉什",
                    "text": "你看，就连婕叶婆婆也选择在这养老呢！"
                }
            ]
        },
        {
            "talkId": "6433403",
            "initDialog": "643340301",
            "dialogues": [
                {
                    "id": "643340301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643340302",
                    "speaker": "库拉什",
                    "text": "再见，希望你也能在这度过一段悠闲的时光。"
                }
            ]
        },
        {
            "talkId": "6433404",
            "initDialog": "643340401",
            "dialogues": [
                {
                    "id": "643340401",
                    "speaker": "Player",
                    "text": "婕叶婆婆…"
                },
                {
                    "id": "643340402",
                    "speaker": "库拉什",
                    "text": "说起来，第一次见到她的时候我还吓了一跳！"
                },
                {
                    "id": "643340403",
                    "speaker": "库拉什",
                    "text": "虽然时隔太久人的容貌总会有些变化，但是婕叶婆婆一定就是传说中的「雌狮」没错！"
                },
                {
                    "id": "643340404",
                    "speaker": "库拉什",
                    "text": "真没想她现在住在这里…而且还收养了一个小男孩。"
                },
                {
                    "id": "643340405",
                    "speaker": "库拉什",
                    "text": "真是让人难以置信，她可是那个「雌狮」欸…"
                }
            ]
        }
    ]
}