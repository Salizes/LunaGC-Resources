{
    "groupId": "5234",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "「勇猛落落莓」": 7
    },
    "talks": [
        {
            "talkId": "6523401",
            "initDialog": "652340101",
            "dialogues": [
                {
                    "id": "652340101",
                    "speaker": "「勇猛落落莓」",
                    "text": "哦…哦？老子没眼花吧？居然能在这里看见你，你也犯事了？"
                }
            ]
        },
        {
            "talkId": "6523402",
            "initDialog": "652340201",
            "dialogues": [
                {
                    "id": "652340201",
                    "speaker": "Player",
                    "text": "我没犯事。"
                },
                {
                    "id": "652340202",
                    "speaker": "「勇猛落落莓」",
                    "text": "哈！没犯事…老子知道你这个年纪的人都爱面子。"
                },
                {
                    "id": "652340203",
                    "speaker": "「勇猛落落莓」",
                    "text": "算了，老子不问了，你跟老子好歹也算有点缘分，要是有人欺负你就跟老子说，老子会帮你出头的。"
                }
            ]
        },
        {
            "talkId": "6523403",
            "initDialog": "652340301",
            "dialogues": [
                {
                    "id": "652340301",
                    "speaker": "Player",
                    "text": "梅洛彼得堡的生活怎么样？"
                },
                {
                    "id": "652340302",
                    "speaker": "「勇猛落落莓」",
                    "text": "这种事还能问出来吗？你再过两天不就知道了？"
                }
            ]
        },
        {
            "talkId": "6523404",
            "initDialog": "652340401",
            "dialogues": [
                {
                    "id": "652340401",
                    "speaker": "Player",
                    "text": "什么橙色的桔子？"
                },
                {
                    "id": "652340402",
                    "speaker": "「勇猛落落莓」",
                    "text": "老子以前一个兄弟，很喜欢泡泡桔。老子最近在公告板上看到有人画了个泡泡桔，突然就有点想他。"
                },
                {
                    "id": "652340403",
                    "speaker": "「勇猛落落莓」",
                    "text": "算了，那家伙应该已经不在人世了。不说了。你也要好好珍惜身边人啊。"
                }
            ]
        },
        {
            "talkId": "6523405",
            "initDialog": "652340501",
            "dialogues": [
                {
                    "id": "652340501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652340502",
                    "speaker": "「勇猛落落莓」",
                    "text": "在这里别像外面那么嚣张啊，这是老子的忠告。"
                }
            ]
        }
    ]
}