{
    "groupId": "30534",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 6,
        "弗雷瑞斯": 2,
        "谢妮": 18
    },
    "talks": [
        {
            "talkId": "7468705",
            "initDialog": "746870501",
            "dialogues": [
                {
                    "id": "746870501",
                    "speaker": "谢妮",
                    "text": "准领队，你想和我聊聊重炮的事呢，还是前辈的事？",
                    "choices": [
                        {
                            "id": "746870502",
                            "text": "你对重炮其实没什么兴趣吧？",
                            "response": [
                                {
                                    "id": "746870503",
                                    "speaker": "谢妮",
                                    "text": "还是被你看穿了…"
                                },
                                {
                                    "id": "746870504",
                                    "speaker": "谢妮",
                                    "text": "说实话，我有点后悔，之前一直配合前辈「扮演天才」的努力了。"
                                },
                                {
                                    "id": "746870505",
                                    "speaker": "谢妮",
                                    "text": "他的动力好像愈发旺盛了，不仅做出了炮台的正式军用版，还不怕危险，带着它第一时间赶来危险地带。"
                                },
                                {
                                    "id": "746870506",
                                    "speaker": "谢妮",
                                    "text": "要不是玛因小姐本来就守在这里，只凭他一人，可能真的会出现意外。",
                                    "choices": [
                                        {
                                            "id": "746870507",
                                            "text": "但你也在保护他吧。",
                                            "response": [
                                                {
                                                    "id": "746870509",
                                                    "speaker": "谢妮",
                                                    "text": "嗯，我在重炮后方布置了只会被魔物触发的雷场，就算重炮没能杀死魔物，它们也逃不出遗迹。"
                                                },
                                                {
                                                    "id": "746870510",
                                                    "speaker": "谢妮",
                                                    "text": "就算真有什么意外情况，我也会第一时间握好铳枪，干掉走运或狡猾的家伙。"
                                                },
                                                {
                                                    "id": "746870511",
                                                    "speaker": "谢妮",
                                                    "text": "自从那次被救过以后，我就一直在好好训练。现在我的射术，应该不输蒂蕾娜之类的杰出代表了。"
                                                },
                                                {
                                                    "id": "746870512",
                                                    "speaker": "谢妮",
                                                    "text": "好在，至少到目前为止，前辈的重炮还没有失误过。"
                                                },
                                                {
                                                    "id": "746870513",
                                                    "speaker": "谢妮",
                                                    "text": "应该说，自从上次那座试验性炮台得到了不错的反响后，前辈还一直没有遭遇过惨痛的失败。",
                                                    "choices": [
                                                        {
                                                            "id": "746870514",
                                                            "text": "那要是真的遭遇了惨败呢？",
                                                            "response": [
                                                                {
                                                                    "id": "746870516",
                                                                    "speaker": "谢妮",
                                                                    "text": "我想过哦，他再次让所有人失去兴致，被所有人忽视的那天，我该怎么面对他…"
                                                                },
                                                                {
                                                                    "id": "746870517",
                                                                    "speaker": "谢妮",
                                                                    "text": "「不要紧的，就算不是什么天才，也没关系。」"
                                                                },
                                                                {
                                                                    "id": "746870518",
                                                                    "speaker": "谢妮",
                                                                    "text": "我要这样安慰他吗？有点残忍。"
                                                                },
                                                                {
                                                                    "id": "746870519",
                                                                    "speaker": "谢妮",
                                                                    "text": "人的自尊很重要，我不想让任何人伤害他的自尊，所以我得帮他继续演下去。"
                                                                },
                                                                {
                                                                    "id": "746870520",
                                                                    "speaker": "谢妮",
                                                                    "text": "如果他吸引过来的那几位工程师也放弃他了，我就雇几位一直想邀请我，但被我拒绝的专家，来配合他演戏吧。"
                                                                },
                                                                {
                                                                    "id": "746870521",
                                                                    "speaker": "谢妮",
                                                                    "text": "有趣与否已经是次要了，最重要的是，这场戏可不能草草收场。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746870515",
                                                            "text": "如果哪天他真的倒霉了呢？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746870508",
                                            "text": "你好像也不怕魔物。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746870522",
                            "text": "要不，待会儿再聊？",
                            "response": [
                                {
                                    "id": "746870523",
                                    "speaker": "谢妮",
                                    "text": "好，那你先忙，我继续在这里陪着前辈，随时都在。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7468803",
            "initDialog": "746880301",
            "dialogues": [
                {
                    "id": "746880301",
                    "speaker": "弗雷瑞斯",
                    "text": "不止追加「重炮护卫机关」，还有负责保持重炮状态的「维护机关」，以及搬运后备弹药零件的「后勤机关」。"
                },
                {
                    "id": "746880302",
                    "speaker": "弗雷瑞斯",
                    "text": "这么一算，需要设计的东西太多了，光是画图纸就要大半年吧！"
                },
                {
                    "id": "746880303",
                    "speaker": "谢妮",
                    "text": "不急不急，慢慢来，也不用熬夜赶工，反正我们的时间多得是…"
                }
            ]
        }
    ]
}