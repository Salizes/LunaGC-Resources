{
    "groupId": "9092",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 16,
        "嘉明": 55
    },
    "talks": [
        {
            "talkId": "6909201",
            "initDialog": "690920101",
            "dialogues": [
                {
                    "id": "690920101",
                    "speaker": "嘉明",
                    "text": "你好啊老友，又见面了喔。"
                },
                {
                    "id": "690920102",
                    "speaker": "嘉明",
                    "text": "这里好大好靓啊…"
                }
            ]
        },
        {
            "talkId": "6909202",
            "initDialog": "690920201",
            "dialogues": [
                {
                    "id": "690920201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690920202",
                    "speaker": "嘉明",
                    "text": "不是吧你？这种问题还用问的？"
                },
                {
                    "id": "690920203",
                    "speaker": "嘉明",
                    "text": "看我的样子就知道我喜欢得不得了啦！唔唔…自己落手落脚打理的地方就是不一样的喔！"
                },
                {
                    "id": "690920204",
                    "speaker": "嘉明",
                    "text": "总体来讲咧，十二个字：睡得安心，玩得开心，住得舒心！"
                },
                {
                    "id": "690920205",
                    "speaker": "Player",
                    "text": "有没有那么夸张啊你？"
                },
                {
                    "id": "690920206",
                    "speaker": "嘉明",
                    "text": "哈哈哈，怎么又学我讲话啊你？"
                },
                {
                    "id": "690920207",
                    "speaker": "嘉明",
                    "text": "嗱嗱嗱，事先声明，人情呢是人情，数目要分明的。"
                },
                {
                    "id": "690920208",
                    "speaker": "嘉明",
                    "text": "我知道你肯定不肯收我住宿费的，那你也不要拦住我给你打扫卫生、养护花花草草那样…"
                },
                {
                    "id": "690920209",
                    "speaker": "Player",
                    "text": "哪有让客人做这些的…"
                },
                {
                    "id": "690920210",
                    "speaker": "嘉明",
                    "text": "我就知道你会这么说的咯，这也太见外了吧？"
                },
                {
                    "id": "690920211",
                    "speaker": "嘉明",
                    "text": "我们是不是自己人先？"
                },
                {
                    "id": "690920212",
                    "speaker": "Player",
                    "text": "那当然！"
                },
                {
                    "id": "690920213",
                    "speaker": "嘉明",
                    "text": "那自己人打理自己的屋子有什么问题？"
                },
                {
                    "id": "690920214",
                    "speaker": "嘉明",
                    "text": "数到三不说话就是没问题——三！好！没问题！那就这么愉快地决定咯。"
                }
            ]
        },
        {
            "talkId": "6909203",
            "initDialog": "690920301",
            "dialogues": [
                {
                    "id": "690920301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690920302",
                    "speaker": "嘉明",
                    "text": "好啊好啊！主人公都这么讲了，我肯定奉陪的咯。"
                },
                {
                    "id": "690920303",
                    "speaker": "嘉明",
                    "text": "不过干聊没什么意思吧…你等一下先，我去泡杯茶来…",
                    "choices": [
                        {
                            "id": "690920304",
                            "text": "嘉明讲话用词就挺有意思的！",
                            "response": [
                                {
                                    "id": "690920305",
                                    "speaker": "嘉明",
                                    "text": "啊？哦、哈哈…对不住啊对不住，我讲话用词是不是有点让人听不懂啊？"
                                },
                                {
                                    "id": "690920306",
                                    "speaker": "嘉明",
                                    "text": "我从小就跟着我老妈，很多生活习惯都是从她那里学过来的，讲话也是，哈哈。"
                                },
                                {
                                    "id": "690920307",
                                    "speaker": "嘉明",
                                    "text": "如果我讲了什么让你误会或者听不明白的话，随时截断我就好啦，我换种说法换个词嘛。"
                                },
                                {
                                    "id": "690920308",
                                    "speaker": "嘉明",
                                    "text": "哎呀小意思，我们饮多几次茶聊多几次天，自然什么都听得懂了！"
                                },
                                {
                                    "id": "690920313",
                                    "speaker": "嘉明",
                                    "text": "哦，讲起饮茶，那怎么少得了点心！"
                                },
                                {
                                    "id": "690920314",
                                    "speaker": "嘉明",
                                    "text": "好在我还带了很多冬蓉酥来，全部都打包好了，分点给你…还有住这里的客人…"
                                },
                                {
                                    "id": "690920315",
                                    "speaker": "嘉明",
                                    "text": "哦！差点数漏了那位！门口圆碌碌很可爱的那位！"
                                },
                                {
                                    "id": "690920316",
                                    "speaker": "Player",
                                    "text": "…「圆碌碌」？"
                                },
                                {
                                    "id": "690920317",
                                    "speaker": "嘉明",
                                    "text": "哦哦，就是圆滚滚的意思，没猜错的话那位应该是这里的前辈吧！"
                                },
                                {
                                    "id": "690920318",
                                    "speaker": "Player",
                                    "text": "那是阿圆，确实是前辈。"
                                },
                                {
                                    "id": "690920319",
                                    "speaker": "嘉明",
                                    "text": "原来是阿圆前辈！失敬失敬。"
                                },
                                {
                                    "id": "690920320",
                                    "speaker": "嘉明",
                                    "text": "呼…不愧是你啊，人面真广，什么能人异士都认识。"
                                },
                                {
                                    "id": "690920321",
                                    "speaker": "嘉明",
                                    "text": "合理合理，你心地又好能力又强，人见人爱花见花开。"
                                },
                                {
                                    "id": "690920322",
                                    "speaker": "嘉明",
                                    "text": "我也是？哈哈哈，那就承你贵言咯！"
                                }
                            ]
                        },
                        {
                            "id": "690920309",
                            "text": "不会是传说中的凉茶吧？",
                            "response": [
                                {
                                    "id": "690920310",
                                    "speaker": "嘉明",
                                    "text": "哦？那就要让你失望了喔，我只带了老家的「游韵单丛」来…"
                                },
                                {
                                    "id": "690920311",
                                    "speaker": "嘉明",
                                    "text": "不过嘛，你想喝的话，等我留意一下周围有哪些药草药材，采回来备齐料先。"
                                },
                                {
                                    "id": "690920312",
                                    "speaker": "嘉明",
                                    "text": "到时候我就煲一大壶，人人有份，永不落空。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909204",
            "initDialog": "690920401",
            "dialogues": [
                {
                    "id": "690920401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690920402",
                    "speaker": "嘉明",
                    "text": "好久没上桩舞兽了，有点坐不住了！准备去找些木头回来打磨一下，自己做些简易的梅花桩。"
                },
                {
                    "id": "690920403",
                    "speaker": "嘉明",
                    "text": "想在周围找找，但问一下你先，你这里有没有种着什么发财树和富贵竹之类的植物呀？"
                },
                {
                    "id": "690920404",
                    "speaker": "嘉明",
                    "text": "有的话我标记下位置，避开一点，不然不小心刮花它们就无谓啦…",
                    "choices": [
                        {
                            "id": "690920405",
                            "text": "发财树和富贵竹长什么样？",
                            "response": [
                                {
                                    "id": "690920406",
                                    "speaker": "嘉明",
                                    "text": "不知道喔。虽然我帮不少做生意的老板运过，但品种好像都不是同一个。"
                                },
                                {
                                    "id": "690920407",
                                    "speaker": "嘉明",
                                    "text": "哇，你都不知道啊，要将那棵树从山里运到城里，山长水远的，中途不能随意修剪啦、不能随便淋水啦…"
                                },
                                {
                                    "id": "690920408",
                                    "speaker": "嘉明",
                                    "text": "好多讲究的，跑那一趟真是累死我了，比跟十个贼打架还累…"
                                },
                                {
                                    "id": "690920413",
                                    "speaker": "嘉明",
                                    "text": "好啦，玩笑话这里讲完这里散，我不是做生意的料啦，但就算我不理解还是会做好我的本职工作的！"
                                },
                                {
                                    "id": "690920414",
                                    "speaker": "嘉明",
                                    "text": "说几点钟淋水我就不会晚一分钟让它们淋到，说晒多久太阳我就不会让它们少晒一秒。"
                                },
                                {
                                    "id": "690920415",
                                    "speaker": "Player",
                                    "text": "这明明挺会做生意嘛。"
                                },
                                {
                                    "id": "690920416",
                                    "speaker": "嘉明",
                                    "text": "哈哈，别跟我讲笑啦，哪里是做生意，这是做人做事的基本而已。"
                                },
                                {
                                    "id": "690920417",
                                    "speaker": "嘉明",
                                    "text": "尊重别人，答应别人的事就要做到。你明明也是这样的喔，说到做到，牙齿当金使。"
                                },
                                {
                                    "id": "690920418",
                                    "speaker": "嘉明",
                                    "text": "更何况这是工作，丢了这个饭碗我就没钱继续研究舞兽戏咯。"
                                },
                                {
                                    "id": "690920419",
                                    "speaker": "嘉明",
                                    "text": "所以能邀请你陪我一齐去采点木桩子回来吗？报酬是舞一段「瑞兽大战发财树」给你看？"
                                },
                                {
                                    "id": "690920420",
                                    "speaker": "Player",
                                    "text": "早讲嘛！快点快点我想看！"
                                }
                            ]
                        },
                        {
                            "id": "690920409",
                            "text": "嘉明相信这些能招财吗？",
                            "response": [
                                {
                                    "id": "690920410",
                                    "speaker": "嘉明",
                                    "text": "你问我吗？听说这些树很贵一棵的，还没发财前就要破一次财先，我肯定舍不得啦！"
                                },
                                {
                                    "id": "690920411",
                                    "speaker": "嘉明",
                                    "text": "记得我家也养了一棵发财树，我老爸天天早上起来都要去看看它的。"
                                },
                                {
                                    "id": "690920412",
                                    "speaker": "嘉明",
                                    "text": "我倒觉得靠它们发财还不如靠发梦快…呃，这句话被我老爸听到肯定要请我吃「藤条焖猪肉」了哈哈！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909205",
            "initDialog": "690920501",
            "dialogues": [
                {
                    "id": "690920501",
                    "speaker": "Player",
                    "text": "早啊，嘉明。"
                },
                {
                    "id": "690920502",
                    "speaker": "嘉明",
                    "text": "早晨好早晨好！我已经跑完步扎完马踢完腿咯。"
                },
                {
                    "id": "690920503",
                    "speaker": "嘉明",
                    "text": "你有事去忙先？等我再练完剩下的动作我们在茶楼见？"
                }
            ]
        },
        {
            "talkId": "6909206",
            "initDialog": "690920601",
            "dialogues": [
                {
                    "id": "690920601",
                    "speaker": "Player",
                    "text": "晚安，嘉明。"
                },
                {
                    "id": "690920602",
                    "speaker": "嘉明",
                    "text": "哦哦晚安！盖好被子啊尤其要记得盖住肚子。"
                },
                {
                    "id": "690920603",
                    "speaker": "嘉明",
                    "text": "睡不着就随时找我咯，有心事也好熬夜工作也好，我都陪你！"
                },
                {
                    "id": "690920604",
                    "speaker": "嘉明",
                    "text": "没睡好的话我明天就煲凉茶给你喝，哎呀听我的，睡不着也是热气，要喝凉茶啊。"
                }
            ]
        },
        {
            "talkId": "6909207",
            "initDialog": "690920701",
            "dialogues": [
                {
                    "id": "690920701",
                    "speaker": "嘉明",
                    "text": "英雄不问出处，美食也是一样道理。"
                },
                {
                    "id": "690920702",
                    "speaker": "嘉明",
                    "text": "街边小摊有连大酒楼大饭店都没办法做出来的人情味和烟火气，还能吃到不同老板的手艺。"
                },
                {
                    "id": "690920703",
                    "speaker": "嘉明",
                    "text": "让我看看先，从哪一家吃起咧？有没有推荐啊你？"
                }
            ]
        },
        {
            "talkId": "6909208",
            "initDialog": "690920801",
            "dialogues": [
                {
                    "id": "690920801",
                    "speaker": "嘉明",
                    "text": "最近手头紧，不运镖的时候会去帮一些老板坐夜，看家护院，虽然是轮流的，但也没几个完整觉能睡。"
                },
                {
                    "id": "690920802",
                    "speaker": "嘉明",
                    "text": "走镖的时候更加不用讲了，我都是坐着睡的，就怕有什么风吹草动，我可以第一时间跳起来…"
                },
                {
                    "id": "690920803",
                    "speaker": "嘉明",
                    "text": "现在好咯，哈…终于可以安安乐乐睡个大觉了。"
                }
            ]
        }
    ]
}