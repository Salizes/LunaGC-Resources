{
    "groupId": "5211",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "德尼谢尔": 15
    },
    "talks": [
        {
            "talkId": "6521101",
            "initDialog": "652110101",
            "dialogues": [
                {
                    "id": "652110101",
                    "speaker": "德尼谢尔",
                    "text": "看来只能从内部结构开始修理了…"
                }
            ]
        },
        {
            "talkId": "6521102",
            "initDialog": "652110201",
            "dialogues": [
                {
                    "id": "652110201",
                    "speaker": "Player",
                    "text": "你要修什么？"
                },
                {
                    "id": "652110202",
                    "speaker": "德尼谢尔",
                    "text": "这台警卫机关。安里说它是「机动自律型枫达专卖机」的保镖，还试图在它内部安装录音装置…"
                },
                {
                    "id": "652110203",
                    "speaker": "德尼谢尔",
                    "text": "唉，但这家伙只会做枫达，具体的维修工作只能由我来了。"
                }
            ]
        },
        {
            "talkId": "6521103",
            "initDialog": "652110301",
            "dialogues": [
                {
                    "id": "652110301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652110302",
                    "speaker": "德尼谢尔",
                    "text": "嗯，再见。我得想想怎么修好这家伙了…"
                }
            ]
        },
        {
            "talkId": "6521104",
            "initDialog": "652110401",
            "dialogues": [
                {
                    "id": "652110401",
                    "speaker": "Player",
                    "text": "你认识安里？"
                },
                {
                    "id": "652110402",
                    "speaker": "德尼谢尔",
                    "text": "是的，我们原本就在一个研究组里开发枫达。"
                },
                {
                    "id": "652110403",
                    "speaker": "德尼谢尔",
                    "text": "当时我们的项目并不受院内重视，既没有资源倾斜，也没有技术支援…但胜在清闲，工作也十分轻松。"
                },
                {
                    "id": "652110404",
                    "speaker": "德尼谢尔",
                    "text": "直到枫达在商业上取得了重大成功后，院里才不再忽视我们。"
                },
                {
                    "id": "652110405",
                    "speaker": "德尼谢尔",
                    "text": "再后来，我们就在科学院的支持下，创办了一家专营枫达的公司…不过实际上，我们还是受到科学院的管理。"
                },
                {
                    "id": "652110406",
                    "speaker": "德尼谢尔",
                    "text": "安里那家伙…满脑子都是枫达，不会在意这件事了。"
                },
                {
                    "id": "652110407",
                    "speaker": "德尼谢尔",
                    "text": "但我对这件事…咳，算了，先别说这话题了。"
                }
            ]
        },
        {
            "talkId": "7494101",
            "initDialog": "749410101",
            "dialogues": [
                {
                    "id": "749410101",
                    "speaker": "Player",
                    "text": "你会维修机关？"
                },
                {
                    "id": "749410102",
                    "speaker": "德尼谢尔",
                    "text": "我之前就在一个制造机关的项目组工作，不过…那个项目组总是频繁更换领头的人。"
                },
                {
                    "id": "749410103",
                    "speaker": "德尼谢尔",
                    "text": "而且每一位新领头人上任时，都要把之前做过的工作全部重新做一遍。"
                },
                {
                    "id": "749410104",
                    "speaker": "德尼谢尔",
                    "text": "我实在受不了这种折磨，就和安里商量了一下，在折腾了一段时间后，转去了他所在的枫达项目组。"
                },
                {
                    "id": "749410105",
                    "speaker": "德尼谢尔",
                    "text": "不过，没想到过了这么长时间，我又得修机关了…"
                },
                {
                    "id": "749410106",
                    "speaker": "德尼谢尔",
                    "text": "喔，我准备材料时买多了一些零件，我用不上它们，你拿着吧，也许能派上用场。"
                }
            ]
        }
    ]
}