{
    "groupId": "2033",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "张顺": 17
    },
    "talks": [
        {
            "talkId": "4003721",
            "initDialog": "400372101",
            "dialogues": [
                {
                    "id": "400372101",
                    "speaker": "张顺",
                    "text": "最近听说北斗大姐接到了打捞工作，不知道会不会捞出什么宝贝来呢…"
                },
                {
                    "id": "400372102",
                    "speaker": "张顺",
                    "text": "但既然是七星委派的工作，那就算发现了宝物也没我什么事吧。"
                },
                {
                    "id": "400372103",
                    "speaker": "张顺",
                    "text": "不过我这里还是有不少陆地上少见的商品的，朋友来看看吗？"
                }
            ]
        },
        {
            "talkId": "7190201",
            "initDialog": "719020101",
            "dialogues": [
                {
                    "id": "719020101",
                    "speaker": "Player",
                    "text": "关于战利品…"
                },
                {
                    "id": "719020102",
                    "speaker": "张顺",
                    "text": "所有战利品里最让我难忘的，可能就是这个杯子了，它总会让我回想起以前大口喝酒的日子。"
                },
                {
                    "id": "719020103",
                    "speaker": "张顺",
                    "text": "…不过如今我已经决定要过平静生活了，这个东西留在我这里也只会让我感到遗憾和不甘而已。"
                },
                {
                    "id": "719020104",
                    "speaker": "张顺",
                    "text": "感谢你能听我说这么多，这个就送给你吧，希望能对你的冒险有所帮助。"
                }
            ]
        },
        {
            "talkId": "6203301",
            "initDialog": "620330101",
            "dialogues": [
                {
                    "id": "620330101",
                    "speaker": "张顺",
                    "text": "怎么样，看看货吗朋友，平时在陆地上可是很少见的。"
                }
            ]
        },
        {
            "talkId": "6203302",
            "initDialog": "620330201",
            "dialogues": [
                {
                    "id": "620330201",
                    "speaker": "Player",
                    "text": "这些商品的来源…"
                },
                {
                    "id": "620330202",
                    "speaker": "张顺",
                    "text": "什么？难道你以为是赃物？"
                },
                {
                    "id": "620330203",
                    "speaker": "张顺",
                    "text": "不会不会…我原本是南十字船队的水手，这些都是几年来我积累下来的战利品。"
                },
                {
                    "id": "620330204",
                    "speaker": "张顺",
                    "text": "可惜在跟妖魔「海山」那场战斗中，我受了伤，多亏北斗大姐头才捡回一条命。"
                },
                {
                    "id": "620330205",
                    "speaker": "张顺",
                    "text": "那以后我便识趣地退出船队了，不能带着旧伤复发的隐患拖船队大家的后腿啊…"
                },
                {
                    "id": "620330206",
                    "speaker": "张顺",
                    "text": "至少这些年积攒的东西还是够我过上平淡日子了。"
                }
            ]
        },
        {
            "talkId": "6203303",
            "initDialog": "620330301",
            "dialogues": [
                {
                    "id": "620330301",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620330302",
                    "speaker": "张顺",
                    "text": "唉…在海上漂泊了几年，就算北斗大姐头也经常津津乐道岩王爷的各种伟绩。"
                },
                {
                    "id": "620330303",
                    "speaker": "张顺",
                    "text": "如果说北斗大姐像是天空中指引我前行的星斗，那岩王爷就是撑起整片天空的人吧。"
                },
                {
                    "id": "620330304",
                    "speaker": "张顺",
                    "text": "本来说回到陆地上，一定要去参加一次请仙典仪，可没想到居然…"
                }
            ]
        },
        {
            "talkId": "6203304",
            "initDialog": "620330401",
            "dialogues": [
                {
                    "id": "620330401",
                    "speaker": "Player",
                    "text": "不用了。"
                },
                {
                    "id": "620330402",
                    "speaker": "张顺",
                    "text": "没兴趣吗，真可惜啊。"
                }
            ]
        },
        {
            "talkId": "6203305",
            "initDialog": "620330501",
            "dialogues": [
                {
                    "id": "620330501",
                    "speaker": "Player",
                    "text": "有什么好东西吗？"
                },
                {
                    "id": "620330502",
                    "speaker": "张顺",
                    "text": "这些都是以前出海时得到的，货真价实！"
                }
            ]
        }
    ]
}