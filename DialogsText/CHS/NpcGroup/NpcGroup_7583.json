{
    "groupId": "7583",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "阿克萨科夫": 8
    },
    "talks": [
        {
            "talkId": "6758301",
            "initDialog": "675830101",
            "dialogues": [
                {
                    "id": "675830101",
                    "speaker": "阿克萨科夫",
                    "text": "别管我，反正都是快死的人了。"
                }
            ]
        },
        {
            "talkId": "6758302",
            "initDialog": "675830201",
            "dialogues": [
                {
                    "id": "675830201",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "675830202",
                    "speaker": "阿克萨科夫",
                    "text": "没必要让你知道，让我一个人待会儿吧。"
                }
            ]
        },
        {
            "talkId": "6758303",
            "initDialog": "675830301",
            "dialogues": [
                {
                    "id": "675830301",
                    "speaker": "Player",
                    "text": "有人照顾你吗？"
                },
                {
                    "id": "675830302",
                    "speaker": "阿克萨科夫",
                    "text": "别管了，谁愿意让一个老头子唠叨他呢？又不是亲生儿子…"
                },
                {
                    "id": "675830303",
                    "speaker": "阿克萨科夫",
                    "text": "唉，干嘛要跑那么远去打猎呢？少了那一顿肉，我又不会怎么样…"
                }
            ]
        },
        {
            "talkId": "6758304",
            "initDialog": "675830401",
            "dialogues": [
                {
                    "id": "675830401",
                    "speaker": "Player",
                    "text": "可是你看上去不太好…"
                },
                {
                    "id": "675830402",
                    "speaker": "阿克萨科夫",
                    "text": "本来就是快死的人了，好不好有什么区别？非得带我来这种地方…"
                },
                {
                    "id": "675830403",
                    "speaker": "阿克萨科夫",
                    "text": "让我守着旧房子冻死好了，都不用准备棺材。那座旧房子就是我的棺材，反正也不用留给谁。"
                }
            ]
        },
        {
            "talkId": "6758305",
            "initDialog": "675830501",
            "dialogues": [
                {
                    "id": "675830501",
                    "speaker": "Player",
                    "text": "要不我把阿罗夏喊过来？"
                },
                {
                    "id": "675830502",
                    "speaker": "阿克萨科夫",
                    "text": "别别！可别把那个小祖宗喊过来，你见过有谁会用捕猎的网绑架老人吗？"
                },
                {
                    "id": "675830503",
                    "speaker": "阿克萨科夫",
                    "text": "非得拐我来这里，说是能多活几天就多活几天…"
                }
            ]
        }
    ]
}