    "talks": [
        {
            "talkId": "34706",
            "initDialog": "3470601",
            "dialogues": [
                {
                    "id": "3470601",
                    "speaker": "告示牌",
                    "text": "「蘑菇是很好的东西。」"
                },
                {
                    "id": "3470602",
                    "speaker": "告示牌",
                    "text": "「无论是烤蘑菇披萨，还是黄油松茸，还是野菇鸡肉串，蘑菇都是其中的灵魂…」"
                },
                {
                    "id": "3470603",
                    "speaker": "告示牌",
                    "text": "「更不用说，其中含有的各种营养成分了！简直是鲜香美味的黄金！」"
                },
                {
                    "id": "3470604",
                    "speaker": "告示牌",
                    "text": "「为了让正在读着这个标识牌的你能明白蘑菇的妙处，我在标识牌边放了一朵蘑菇，请自取。」"
                },
                {
                    "id": "3470605",
                    "speaker": "告示牌",
                    "text": "「希望你也喜欢蘑菇。」"
                }
            ]
        }
    ]
}