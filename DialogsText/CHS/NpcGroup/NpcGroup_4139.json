{
    "groupId": "4139",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "汝英": 12
    },
    "talks": [
        {
            "talkId": "6413901",
            "initDialog": "641390101",
            "dialogues": [
                {
                    "id": "641390101",
                    "speaker": "汝英",
                    "text": "呵——欠——"
                },
                {
                    "id": "641390102",
                    "speaker": "汝英",
                    "text": "要是早几天来就好啦…"
                }
            ]
        },
        {
            "talkId": "6413902",
            "initDialog": "641390201",
            "dialogues": [
                {
                    "id": "641390201",
                    "speaker": "Player",
                    "text": "没睡好吗？"
                },
                {
                    "id": "641390202",
                    "speaker": "汝英",
                    "text": "唉，是啦。"
                },
                {
                    "id": "641390203",
                    "speaker": "汝英",
                    "text": "这家旅店哪都好，掌柜亲切，服务周到，我们这些外国商人最喜欢住这。"
                },
                {
                    "id": "641390204",
                    "speaker": "汝英",
                    "text": "但就是有一点问题——隔音太差了。"
                },
                {
                    "id": "641390205",
                    "speaker": "汝英",
                    "text": "晚上躺在床上，总是能听到隔壁巴拉巴拉的讲话声。"
                },
                {
                    "id": "641390206",
                    "speaker": "汝英",
                    "text": "而且也不知道住我旁边的那对男女说的是方言还是什么，我能听懂词，但就是连不上意思。"
                }
            ]
        },
        {
            "talkId": "6413903",
            "initDialog": "641390301",
            "dialogues": [
                {
                    "id": "641390301",
                    "speaker": "Player",
                    "text": "好好休息。"
                },
                {
                    "id": "641390302",
                    "speaker": "汝英",
                    "text": "哎，谢了。"
                }
            ]
        },
        {
            "talkId": "6413904",
            "initDialog": "641390401",
            "dialogues": [
                {
                    "id": "641390401",
                    "speaker": "Player",
                    "text": "早几天来？"
                },
                {
                    "id": "641390402",
                    "speaker": "汝英",
                    "text": "是啊。"
                },
                {
                    "id": "641390403",
                    "speaker": "汝英",
                    "text": "掌柜的有说，本来在我隔壁的是一个什么学者，整天都写论文什么的。"
                },
                {
                    "id": "641390404",
                    "speaker": "汝英",
                    "text": "可惜他好像前几天不见了，房间也空了出来，住进去的是一对话说不停的夫妻。"
                },
                {
                    "id": "641390405",
                    "speaker": "汝英",
                    "text": "我要是早来几天，现在都做完生意走人了，又何至于被吵到整晚整晚睡不着…"
                }
            ]
        }
    ]
}