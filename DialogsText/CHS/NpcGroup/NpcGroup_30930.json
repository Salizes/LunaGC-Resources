{
    "groupId": "30930",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 6,
        "雷泽": 6
    },
    "talks": [
        {
            "talkId": "4023151",
            "initDialog": "402315101",
            "dialogues": [
                {
                    "id": "402315101",
                    "speaker": "派蒙",
                    "text": "咦，雷泽怎么在这里，而且这东西不应该是在奔狼领吗？"
                },
                {
                    "id": "402315102",
                    "speaker": "雷泽",
                    "text": "烫烫的，女人，要拿走，卢皮卡。不可以。"
                },
                {
                    "id": "402315103",
                    "speaker": "Player",
                    "text": "你阻止了她？"
                },
                {
                    "id": "402315104",
                    "speaker": "雷泽",
                    "text": "嗯，她答应，说，我也不错。"
                },
                {
                    "id": "402315105",
                    "speaker": "雷泽",
                    "text": "这把剑，暂时，留在这里。我，守护它。"
                },
                {
                    "id": "402315106",
                    "speaker": "派蒙",
                    "text": "我懂了，艾莉丝本来想直接把北风狼带到这里来，被雷泽阻止了。"
                },
                {
                    "id": "402315107",
                    "speaker": "派蒙",
                    "text": "于是艾莉丝拿走了那把剑的幻影，让雷泽在这里当看守。"
                },
                {
                    "id": "402315108",
                    "speaker": "派蒙",
                    "text": "那北风狼的试炼，不就变成雷泽的试炼了吗！"
                },
                {
                    "id": "402315109",
                    "speaker": "Player",
                    "text": "如果有人想动这把剑该怎么办？"
                },
                {
                    "id": "402315110",
                    "speaker": "雷泽",
                    "text": "战斗。守护，卢皮卡。"
                },
                {
                    "id": "402315111",
                    "speaker": "派蒙",
                    "text": "还真是这样…不用担心哦，雷泽，不会有人打这把剑的主意，它是假的。"
                },
                {
                    "id": "402315112",
                    "speaker": "雷泽",
                    "text": "假的？"
                },
                {
                    "id": "402315113",
                    "speaker": "Player",
                    "text": "还是让尼可来解决吧。"
                },
                {
                    "id": "402315114",
                    "speaker": "派蒙",
                    "text": "嗯，艾莉丝真是的。我们留影结束之后把雷泽送回去吧。"
                }
            ]
        },
        {
            "talkId": "4023170",
            "initDialog": "402317001",
            "dialogues": [
                {
                    "id": "402317001",
                    "speaker": "雷泽",
                    "text": "不明白。假的，真的…"
                }
            ]
        }
    ]
}