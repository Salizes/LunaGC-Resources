{
    "groupId": "1463",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "优律": 11
    },
    "talks": [
        {
            "talkId": "6146301",
            "initDialog": "614630101",
            "dialogues": [
                {
                    "id": "614630101",
                    "speaker": "优律",
                    "text": "你好呀，你也是来买东西的吗？"
                }
            ]
        },
        {
            "talkId": "6146302",
            "initDialog": "614630201",
            "dialogues": [
                {
                    "id": "614630201",
                    "speaker": "Player",
                    "text": "没有…我就是看看。"
                },
                {
                    "id": "614630202",
                    "speaker": "优律",
                    "text": "真羡慕能忍住购买欲的人啊…"
                },
                {
                    "id": "614630203",
                    "speaker": "优律",
                    "text": "我只要看到「大特价」的牌子，就忍不住要买到钱袋里一个摩拉也不剩…"
                },
                {
                    "id": "614630204",
                    "speaker": "优律",
                    "text": "欸，话说你见到我那个酒鬼丈夫了吗？该不会又偷偷去买酒了吧…"
                }
            ]
        },
        {
            "talkId": "6146303",
            "initDialog": "614630301",
            "dialogues": [
                {
                    "id": "614630301",
                    "speaker": "Player",
                    "text": "购物有什么收获？"
                },
                {
                    "id": "614630302",
                    "speaker": "优律",
                    "text": "刚才，一枚漂亮的宝石戒指吸引了我。"
                },
                {
                    "id": "614630303",
                    "speaker": "优律",
                    "text": "我失手拿起了它。这真是一个巨大的错误啊…"
                },
                {
                    "id": "614630304",
                    "speaker": "优律",
                    "text": "我早该想到，那价格根本不是我娇嫩的眼睛能够承受的…"
                }
            ]
        },
        {
            "talkId": "6146304",
            "initDialog": "614630401",
            "dialogues": [
                {
                    "id": "614630401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614630402",
                    "speaker": "优律",
                    "text": "嗯，再见！希望你在蒙德过的开心！"
                }
            ]
        },
        {
            "talkId": "6146305",
            "initDialog": "614630501",
            "dialogues": [
                {
                    "id": "614630501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614630502",
                    "speaker": "优律",
                    "text": "唉，经历过这次龙灾我才发现，以前那种有空去逛逛街，跟店主议价的日子才是真正的和平啊。"
                },
                {
                    "id": "614630503",
                    "speaker": "优律",
                    "text": "我本来还在计划着让我的丈夫宁禄戒酒来着…"
                },
                {
                    "id": "614630504",
                    "speaker": "优律",
                    "text": "…不过为了庆祝这来之不易的和平，就暂缓这个计划好了。"
                }
            ]
        }
    ]
}