{
    "groupId": "2092",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "阿山婆": 14
    },
    "talks": [
        {
            "talkId": "6209201",
            "initDialog": "620920101",
            "dialogues": [
                {
                    "id": "620920101",
                    "speaker": "阿山婆",
                    "text": "要笑口常开啊，年轻人，看看这里的玩具如何？"
                }
            ]
        },
        {
            "talkId": "6209202",
            "initDialog": "620920201",
            "dialogues": [
                {
                    "id": "620920201",
                    "speaker": "Player",
                    "text": "关于玩具…"
                },
                {
                    "id": "620920202",
                    "speaker": "阿山婆",
                    "text": "孩子们都会喜欢的，是一些新奇有趣的精巧东西。"
                },
                {
                    "id": "620920203",
                    "speaker": "阿山婆",
                    "text": "…还有一些，是大人的玩具。"
                },
                {
                    "id": "620920204",
                    "speaker": "Player",
                    "text": "大人的…玩具？"
                },
                {
                    "id": "620920205",
                    "speaker": "阿山婆",
                    "text": "啊，我没说全，是需要大人带着孩子一起玩的玩具，比如风筝啊之类的。"
                },
                {
                    "id": "620920206",
                    "speaker": "阿山婆",
                    "text": "不管是战乱年代、饥荒年代还是如今富饶的时代，快乐都该是永远不变的追求，你说是吧年轻人。"
                }
            ]
        },
        {
            "talkId": "6209203",
            "initDialog": "620920301",
            "dialogues": [
                {
                    "id": "620920301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620920302",
                    "speaker": "阿山婆",
                    "text": "再见，慢慢走啊。"
                }
            ]
        },
        {
            "talkId": "6209204",
            "initDialog": "620920401",
            "dialogues": [
                {
                    "id": "620920401",
                    "speaker": "Player",
                    "text": "关于岩王帝君…"
                },
                {
                    "id": "620920402",
                    "speaker": "阿山婆",
                    "text": "岩王爷啊，明白明白。你们家的宝贝也喜欢有关岩王爷的玩具？"
                },
                {
                    "id": "620920403",
                    "speaker": "阿山婆",
                    "text": "瞧瞧，龙角陀螺，岩块儿骰子，龙须木剑，岩王爷脸谱风筝…想要哪个？"
                },
                {
                    "id": "620920404",
                    "speaker": "阿山婆",
                    "text": "哦…只是问问啊，原来如此。因为岩王爷相关的玩具都很受小孩子们欢迎，我自然而然地就…"
                }
            ]
        },
        {
            "talkId": "6209205",
            "initDialog": "620920501",
            "dialogues": [
                {
                    "id": "620920501",
                    "speaker": "Player",
                    "text": "您这里卖什么？"
                },
                {
                    "id": "620920502",
                    "speaker": "阿山婆",
                    "text": "都在这里了，挑挑看吧，没准有你喜欢的。"
                }
            ]
        },
        {
            "talkId": "7209201",
            "initDialog": "720920101",
            "dialogues": [
                {
                    "id": "720920101",
                    "speaker": "阿山婆",
                    "text": "买点东西给孩子们吧。"
                },
                {
                    "id": "720920102",
                    "speaker": "阿山婆",
                    "text": "不求卖货可以赚多少钱，只是过来沾沾喜气，婆婆我就满足了。"
                }
            ]
        },
        {
            "talkId": "7209202",
            "initDialog": "720920201",
            "dialogues": [
                {
                    "id": "720920201",
                    "speaker": "Player",
                    "text": "有什么卖的？"
                },
                {
                    "id": "720920202",
                    "speaker": "阿山婆",
                    "text": "来，随便看看吧。"
                }
            ]
        },
        {
            "talkId": "7209203",
            "initDialog": "720920301",
            "dialogues": [
                {
                    "id": "720920301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "720920302",
                    "speaker": "阿山婆",
                    "text": "愿薪火相传，美德不灭。"
                }
            ]
        }
    ]
}