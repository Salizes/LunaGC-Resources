{
    "groupId": "2006",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "狗三儿": 11
    },
    "talks": [
        {
            "talkId": "6200601",
            "initDialog": "620060101",
            "dialogues": [
                {
                    "id": "620060101",
                    "speaker": "狗三儿",
                    "text": "说你呢，鬼鬼祟祟的，干什么呢？"
                }
            ]
        },
        {
            "talkId": "6200602",
            "initDialog": "620060201",
            "dialogues": [
                {
                    "id": "620060201",
                    "speaker": "Player",
                    "text": "只是路过。"
                },
                {
                    "id": "620060202",
                    "speaker": "狗三儿",
                    "text": "哦，路过啊…"
                },
                {
                    "id": "620060203",
                    "speaker": "狗三儿",
                    "text": "我告诉你，你别打这仓库的主意，我可是一直看着你呢。"
                }
            ]
        },
        {
            "talkId": "6200603",
            "initDialog": "620060301",
            "dialogues": [
                {
                    "id": "620060301",
                    "speaker": "Player",
                    "text": "这座仓库很重要吗？"
                },
                {
                    "id": "620060302",
                    "speaker": "狗三儿",
                    "text": "看见码头上的船了吗？不论大小，不论开进开出，船上货物饮水都要这座仓库经手。"
                },
                {
                    "id": "620060303",
                    "speaker": "狗三儿",
                    "text": "有我在这儿，璃月的仓库就是全世界最安全的仓库！"
                },
                {
                    "id": "620060304",
                    "speaker": "狗三儿",
                    "text": "我们建造仓库的岩石，风吹不动，火烧不进，绝对安全！你是旅行者，你见的世面多，你到过须弥吗？"
                },
                {
                    "id": "620060305",
                    "speaker": "狗三儿",
                    "text": "我听说那个国家的仓库是用草搭的棚子…你说那能安全吗？有四个我守着的话，那还差不多…"
                }
            ]
        },
        {
            "talkId": "6200604",
            "initDialog": "620060401",
            "dialogues": [
                {
                    "id": "620060401",
                    "speaker": "Player",
                    "text": "不好意思。"
                },
                {
                    "id": "620060402",
                    "speaker": "狗三儿",
                    "text": "没打什么主意就行…你这么说我都不好意思了。"
                }
            ]
        },
        {
            "talkId": "7200601",
            "initDialog": "720060101",
            "dialogues": [
                {
                    "id": "720060101",
                    "speaker": "狗三儿",
                    "text": "仓库管理是我的老本行，「明霄灯」的建造我会一直在这儿盯着！"
                },
                {
                    "id": "720060102",
                    "speaker": "狗三儿",
                    "text": "大家捐献的纸张、灯绒、还有石材，我都会让它们派上用场的…"
                },
                {
                    "id": "720060103",
                    "speaker": "狗三儿",
                    "text": "喂，等等，那边的！裤带是做不了灯绒的，别往仓库里放了！"
                }
            ]
        }
    ]
}