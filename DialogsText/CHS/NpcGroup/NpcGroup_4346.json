    },
    "talks": [
        {
            "talkId": "6434601",
            "initDialog": "643460101",
            "dialogues": [
                {
                    "id": "643460101",
                    "speaker": "富拉特",
                    "text": "看这的环境这么好，我都想留下来上个学了。"
                }
            ]
        },
        {
            "talkId": "6434602",
            "initDialog": "643460201",
            "dialogues": [
                {
                    "id": "643460201",
                    "speaker": "Player",
                    "text": "读书是好事。"
                },
                {
                    "id": "643460202",
                    "speaker": "富拉特",
                    "text": "嗯…要我说，一半一半吧。"
                },
                {
                    "id": "643460203",
                    "speaker": "富拉特",
                    "text": "如果书读得好，自然就不用为生计奔波了。但书读得太好，听说也有疯掉的风险哦？"
                },
                {
                    "id": "643460204",
                    "speaker": "富拉特",
                    "text": "所以像我这种脑筋一般的人，还是找个适合自己的工作吧。"
                },
                {
                    "id": "643460205",
                    "speaker": "富拉特",
                    "text": "哦对了，忘记自我介绍。我是一位供应商，主要为禅那园提供一些基础物资。"
                },
                {
                    "id": "643460206",
                    "speaker": "富拉特",
                    "text": "你如果需要购买什么生活用品的话，也可以联系我哦。"
                }
            ]
        },
        {
            "talkId": "6434603",
            "initDialog": "643460301",
            "dialogues": [
                {
                    "id": "643460301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643460302",
                    "speaker": "富拉特",
                    "text": "再见！"
                }
            ]
        },
        {
            "talkId": "7395601",
            "initDialog": "739560101",
            "dialogues": [
                {
                    "id": "739560101",
                    "speaker": "Player",
                    "text": "我记下了。"
                },
                {
                    "id": "739560102",
                    "speaker": "富拉特",
                    "text": "好！那么期待你的联络。"
                },
                {
                    "id": "739560103",
                    "speaker": "富拉特",
                    "text": "就算不做生意，交个朋友也是好的。送你这个作为见面礼吧，总有用上的时候。"
                }
            ]
        }
    ]
}