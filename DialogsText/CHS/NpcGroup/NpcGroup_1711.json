    },
    "talks": [
        {
            "talkId": "6171101",
            "initDialog": "617110101",
            "dialogues": [
                {
                    "id": "617110101",
                    "speaker": "七夜由美",
                    "text": "「七圣召唤」，其中有些牌上的画很好看吧，我在收集好看的牌。"
                },
                {
                    "id": "617110102",
                    "speaker": "七夜由美",
                    "text": "美丽，也是另外一种胜利呢！怎么样，要来一局「七圣召唤」吗？"
                }
            ]
        },
        {
            "talkId": "6171102",
            "initDialog": "617110201",
            "dialogues": [
                {
                    "id": "617110201",
                    "speaker": "Player",
                    "text": "恭敬不如从命。"
                }
            ]
        },
        {
            "talkId": "6171103",
            "initDialog": "617110301",
            "dialogues": [
                {
                    "id": "617110301",
                    "speaker": "七夜由美",
                    "text": "用好看的牌收获漂亮的胜利，这就是我的目标！"
                }
            ]
        },
        {
            "talkId": "6171104",
            "initDialog": "617110401",
            "dialogues": [
                {
                    "id": "617110401",
                    "speaker": "七夜由美",
                    "text": "只顾着牌面漂亮，有的时候就会非常难用…不过我是不会因此改变我的信念的，下次再打牌吧。"
                }
            ]
        },
        {
            "talkId": "6171105",
            "initDialog": "617110501",
            "dialogues": [
                {
                    "id": "617110501",
                    "speaker": "Player",
                    "text": "之后再说吧…"
                },
                {
                    "id": "617110502",
                    "speaker": "七夜由美",
                    "text": "好吧，不过你要找到什么牌面好看的牌，记得来找我哦。"
                }
            ]
        }
    ]
}