{
    "groupId": "31005",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 6,
        "埃洛雯": 21
    },
    "talks": [
        {
            "talkId": "7055804",
            "initDialog": "705580401",
            "dialogues": [
                {
                    "id": "705580401",
                    "speaker": "埃洛雯",
                    "text": "你好啊，荣誉骑士…呼…埃洛雯，你很棒，你一点都不紧张…呼，调整呼吸，想想接下来要说什么…",
                    "choices": [
                        {
                            "id": "705580402",
                            "text": "不如来说说你自己吧？",
                            "response": [
                                {
                                    "id": "705580403",
                                    "speaker": "埃洛雯",
                                    "text": "我，我吗？我只是一名平平无奇的骑士，擅长…好像没有什么特别擅长的，但有特别不擅长的。"
                                },
                                {
                                    "id": "705580404",
                                    "speaker": "埃洛雯",
                                    "text": "就像那复杂的铳枪，我就怎么都维护不好，呃啊…那么多工序，也就科赫记得住！对了，科赫就是那个荆夫港里的那个「枪匠」…"
                                },
                                {
                                    "id": "705580405",
                                    "speaker": "埃洛雯",
                                    "text": "所以，比起铳枪，我还是更喜欢一些传统武器吧…不仅使用起来更加趁手，保养起来也更容易啊…"
                                }
                            ]
                        },
                        {
                            "id": "705580406",
                            "text": "聊聊特雷斯？",
                            "response": [
                                {
                                    "id": "705580407",
                                    "speaker": "埃洛雯",
                                    "text": "特雷斯？相当的好人啊…各方面都是，工作能力很强，学东西也快，就连性格也很棒。"
                                },
                                {
                                    "id": "705580408",
                                    "speaker": "埃洛雯",
                                    "text": "无论是作为同事、上级还是下属，都是很好的选择呢。"
                                },
                                {
                                    "id": "705580409",
                                    "speaker": "埃洛雯",
                                    "text": "只是…有时候，他还不那么自信，就和米卡一样——但明明在今年的战斗考核里，他还拿了很好的成绩。"
                                },
                                {
                                    "id": "705580410",
                                    "speaker": "埃洛雯",
                                    "text": "…呃啊，不像我，还有一项「初级机关拆解」不及格了呢…虽然大部分时候只对遗迹机关有用…但是还是让人有点着急。"
                                },
                                {
                                    "id": "705580411",
                                    "speaker": "埃洛雯",
                                    "text": "只能指望，明年的考核里，我能运气稍微好一点点，只要能擦着边过，我也很满意了！"
                                }
                            ]
                        },
                        {
                            "id": "705580412",
                            "text": "说说你们平时在做什么？",
                            "response": [
                                {
                                    "id": "705580413",
                                    "speaker": "埃洛雯",
                                    "text": "…如果说比起荣誉骑士前辈您的经历，那我们平时做的事情讲起来都会有点平淡吧…"
                                },
                                {
                                    "id": "705580414",
                                    "speaker": "埃洛雯",
                                    "text": "大部分时间都是在巡逻、观察，偶尔会爆发一场激烈的战斗…对于我来说，最头疼的事，就是做饭了…"
                                },
                                {
                                    "id": "705580415",
                                    "speaker": "埃洛雯",
                                    "text": "明明是通过扔骰子来决定的随机事件，但我十次会有八次中招…唉，如果有一天我能在别的地方这么幸运就好了…"
                                },
                                {
                                    "id": "705580416",
                                    "speaker": "埃洛雯",
                                    "text": "前段时间，后勤小队提供了装着五个罐头和九个纸包的「标准战地配给」，大家都说它咸的要命…"
                                },
                                {
                                    "id": "705580417",
                                    "speaker": "埃洛雯",
                                    "text": "但我还挺喜欢的——至少，吃起来很方便。"
                                }
                            ]
                        },
                        {
                            "id": "705580418",
                            "text": "你慢慢想噢，不着急…",
                            "response": [
                                {
                                    "id": "705580419",
                                    "speaker": "埃洛雯",
                                    "text": "…好，好…呜呜…这个容易紧张的毛病，什么时候才能改掉啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7055903",
            "initDialog": "705590301",
            "dialogues": [
                {
                    "id": "705590301",
                    "speaker": "埃洛雯",
                    "text": "欸？是还想体验一遍「测绘寻物」吗？",
                    "choices": [
                        {
                            "id": "705590302",
                            "text": "是有些意犹未尽呢…",
                            "response": [
                                {
                                    "id": "705590307",
                                    "speaker": "埃洛雯",
                                    "text": "是啊…只可惜这次准备的时间太少，我只草草做了几个标定物。"
                                },
                                {
                                    "id": "705590303",
                                    "speaker": "埃洛雯",
                                    "text": "如果下次有机会能够再组织上一场「测绘寻物」，我一定再多多设计几个，每个著名骑士的形象都要有…"
                                }
                            ]
                        },
                        {
                            "id": "705590304",
                            "text": "已经在期待下一次…",
                            "response": [
                                {
                                    "id": "705590308",
                                    "speaker": "埃洛雯",
                                    "text": "下一次？没错，虽然大家还没相处几天，但是好像已经是拥有不俗默契的战友了！"
                                },
                                {
                                    "id": "705590305",
                                    "speaker": "埃洛雯",
                                    "text": "如果下一次还能有这样共同学习进步的机会，我一定不会错过。"
                                },
                                {
                                    "id": "705590306",
                                    "speaker": "埃洛雯",
                                    "text": "唔…下次我还要准备更多的食材，让大家尝上真正的「战地大餐」…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}