{
    "groupId": "7778",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "莎茨卡娅": 10
    },
    "talks": [
        {
            "talkId": "6777801",
            "initDialog": "677780101",
            "dialogues": [
                {
                    "id": "677780101",
                    "speaker": "莎茨卡娅",
                    "text": "团雀最可爱啦，嘿嘿…"
                }
            ]
        },
        {
            "talkId": "6777802",
            "initDialog": "677780201",
            "dialogues": [
                {
                    "id": "677780201",
                    "speaker": "Player",
                    "text": "团雀最可爱！"
                },
                {
                    "id": "677780202",
                    "speaker": "莎茨卡娅",
                    "text": "团雀最可爱！嘿嘿，你也这么想吗？"
                },
                {
                    "id": "677780203",
                    "speaker": "莎茨卡娅",
                    "text": "那等一下，你可要去迈斯卡娅姐姐那边玩玩喔，「哐哐当当雀雀球」可好玩了！"
                },
                {
                    "id": "677780204",
                    "speaker": "莎茨卡娅",
                    "text": "你可不要怕迈斯卡娅姐姐喔，她看起来很可怕，但其实是一个超级好的人。"
                },
                {
                    "id": "677780205",
                    "speaker": "莎茨卡娅",
                    "text": "我第一次去玩的时候，也被她的表情吓到了，还以为我做错了什么，或者是把东西放错了地方…"
                },
                {
                    "id": "677780206",
                    "speaker": "莎茨卡娅",
                    "text": "然后，迈斯卡娅姐姐走过来，面无表情地对我说：「你刚才玩得很好，这是给你的奖励。」"
                },
                {
                    "id": "677780207",
                    "speaker": "莎茨卡娅",
                    "text": "说完之后，她就从口袋里掏出了好多雀雀球玩偶，让我挑一个喜欢的…"
                }
            ]
        },
        {
            "talkId": "6777803",
            "initDialog": "677780301",
            "dialogues": [
                {
                    "id": "677780301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "677780302",
                    "speaker": "莎茨卡娅",
                    "text": "再见！唔…要不要去玩一下雀雀球呢…"
                }
            ]
        },
        {
            "talkId": "6777804",
            "initDialog": "677780401",
            "dialogues": [
                {
                    "id": "677780401",
                    "speaker": "Player",
                    "text": "确实是一个很好的人呢…"
                },
                {
                    "id": "677780402",
                    "speaker": "莎茨卡娅",
                    "text": "是呀！我挑好玩偶之后，对迈斯卡娅姐姐很认真地说了谢谢呢。"
                },
                {
                    "id": "677780403",
                    "speaker": "莎茨卡娅",
                    "text": "你去玩的时候，也要对迈斯卡娅姐姐说谢谢喔，她会很高兴的。"
                }
            ]
        }
    ]
}