{
    "groupId": "3090",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "佐佐木": 18
    },
    "talks": [
        {
            "talkId": "4006311",
            "initDialog": "400631101",
            "dialogues": [
                {
                    "id": "400631101",
                    "speaker": "佐佐木",
                    "text": "这个什么光…「光彩照人祭」？到底是干嘛的啊？"
                },
                {
                    "id": "400631102",
                    "speaker": "佐佐木",
                    "text": "竟然有这么多人参加，完全搞不明白！"
                },
                {
                    "id": "400631103",
                    "speaker": "佐佐木",
                    "text": "不过难得见养尊处优的大小姐认真工作，应该不是什么坏事吧。"
                }
            ]
        },
        {
            "talkId": "6309001",
            "initDialog": "630900101",
            "dialogues": [
                {
                    "id": "630900101",
                    "speaker": "佐佐木",
                    "text": "…什么事？"
                }
            ]
        },
        {
            "talkId": "6309002",
            "initDialog": "630900201",
            "dialogues": [
                {
                    "id": "630900201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630900202",
                    "speaker": "佐佐木",
                    "text": "在下佐佐木，是勘定奉行大人的属下。"
                },
                {
                    "id": "630900203",
                    "speaker": "佐佐木",
                    "text": "…事先提醒一句，你若是对大小姐有任何僭越的想法，可要小心我手里的刀。"
                }
            ]
        },
        {
            "talkId": "6309003",
            "initDialog": "630900301",
            "dialogues": [
                {
                    "id": "630900301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630900302",
                    "speaker": "佐佐木",
                    "text": "不送。"
                }
            ]
        },
        {
            "talkId": "6309005",
            "initDialog": "630900501",
            "dialogues": [
                {
                    "id": "630900501",
                    "speaker": "Player",
                    "text": "大小姐？"
                },
                {
                    "id": "630900502",
                    "speaker": "佐佐木",
                    "text": "勘定奉行大人老来得女，因此极为疼爱柊大小姐，甚至让在下这个武士头领来担任大小姐的护卫。"
                },
                {
                    "id": "630900503",
                    "speaker": "佐佐木",
                    "text": "呵…要我说，真是小题大做。"
                },
                {
                    "id": "630900504",
                    "speaker": "佐佐木",
                    "text": "不过，既然是奉行大人的命令，在下便会全力以赴。"
                },
                {
                    "id": "630900505",
                    "speaker": "佐佐木",
                    "text": "哼，听闻奉行所内部也有不少毛头小子对大小姐心存非分之想…"
                },
                {
                    "id": "630900506",
                    "speaker": "佐佐木",
                    "text": "…无论是谁，只要做出任何出格的举动，我佐佐木都不会刀下留情。"
                }
            ]
        },
        {
            "talkId": "6309006",
            "initDialog": "630900601",
            "dialogues": [
                {
                    "id": "630900601",
                    "speaker": "佐佐木",
                    "text": "…怎么了？"
                }
            ]
        },
        {
            "talkId": "6309007",
            "initDialog": "630900701",
            "dialogues": [
                {
                    "id": "630900701",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630900702",
                    "speaker": "佐佐木",
                    "text": "在下佐佐木，是勘定奉行大人的属下，正奉命保护大小姐的安全。"
                },
                {
                    "id": "630900703",
                    "speaker": "佐佐木",
                    "text": "如今她是勘定奉行之中非常重要的人，我绝不会有所怠慢。"
                }
            ]
        },
        {
            "talkId": "6309008",
            "initDialog": "630900801",
            "dialogues": [
                {
                    "id": "630900801",
                    "speaker": "Player",
                    "text": "柊千里近来如何？"
                },
                {
                    "id": "630900802",
                    "speaker": "佐佐木",
                    "text": "那场骚动之后，大小姐就像变了一个人，开始很认真地处理家族事务。"
                },
                {
                    "id": "630900803",
                    "speaker": "佐佐木",
                    "text": "原本勘定奉行大人应做的事，她现在都接了过去，并且完成得有模有样。"
                },
                {
                    "id": "630900804",
                    "speaker": "佐佐木",
                    "text": "我能看出她的天分，虽然这之后还有很长的路要走，但…迈出了这一步，总归是好事。"
                }
            ]
        }
    ]
}