{
    "groupId": "9006",
    "total_dialogue_lines": 67,
    "speaker_counts": {
        "Player": 18,
        "丽莎": 49
    },
    "talks": [
        {
            "talkId": "6900601",
            "initDialog": "690060101",
            "dialogues": [
                {
                    "id": "690060101",
                    "speaker": "丽莎",
                    "text": "#{NICKNAME}，你是什么时候来的？"
                },
                {
                    "id": "690060102",
                    "speaker": "丽莎",
                    "text": "我刚才…走了一会儿神。"
                }
            ]
        },
        {
            "talkId": "6900602",
            "initDialog": "690060201",
            "dialogues": [
                {
                    "id": "690060201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690060701",
                    "speaker": "丽莎",
                    "text": "哦？你这是在关心我吗，小可爱。"
                },
                {
                    "id": "690060702",
                    "speaker": "丽莎",
                    "text": "真让人感到温暖呢。"
                },
                {
                    "id": "690060703",
                    "speaker": "丽莎",
                    "text": "放心，我很喜欢这里。",
                    "choices": [
                        {
                            "id": "690060704",
                            "text": "丽莎会想要「改建」一部分吗？",
                            "response": [
                                {
                                    "id": "690060706",
                                    "speaker": "丽莎",
                                    "text": "没有哦。"
                                },
                                {
                                    "id": "690060707",
                                    "speaker": "丽莎",
                                    "text": "我觉得它之所以特别，是因为这是小可爱你亲自搭建的。"
                                },
                                {
                                    "id": "690060708",
                                    "speaker": "丽莎",
                                    "text": "如果我在旁指指点点，那就会削弱你的创意与韵味。"
                                },
                                {
                                    "id": "690060709",
                                    "speaker": "丽莎",
                                    "text": "我可不想见到这种局面。"
                                }
                            ]
                        },
                        {
                            "id": "690060705",
                            "text": "丽莎有什么改进的建议吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900603",
            "initDialog": "690060301",
            "dialogues": [
                {
                    "id": "690060301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690060801",
                    "speaker": "丽莎",
                    "text": "为什么不呢？"
                },
                {
                    "id": "690060802",
                    "speaker": "丽莎",
                    "text": "要是没有图书登记或者别的药剂配置工作，真想天天就这样和你悠闲地聊聊天度过。",
                    "choices": [
                        {
                            "id": "690060803",
                            "text": "最近来图书馆借书的人还多吗？",
                            "response": [
                                {
                                    "id": "690060804",
                                    "speaker": "丽莎",
                                    "text": "和以前差不多吧。借书不还的人倒是少了一些。"
                                },
                                {
                                    "id": "690060805",
                                    "speaker": "丽莎",
                                    "text": "「自由」之都的人们时间意识变得强烈起来，我还是挺欣慰的。"
                                },
                                {
                                    "id": "690060806",
                                    "speaker": "丽莎",
                                    "text": "当然，我也不会期待每个人都和小可爱你一样懂事。"
                                },
                                {
                                    "id": "690060814",
                                    "speaker": "丽莎",
                                    "text": "呵呵…"
                                },
                                {
                                    "id": "690060815",
                                    "speaker": "丽莎",
                                    "text": "#{NICKNAME}你脸红的样子…真的很可爱呢。"
                                }
                            ]
                        },
                        {
                            "id": "690060807",
                            "text": "有调制出什么特别的药剂吗？",
                            "response": [
                                {
                                    "id": "690060808",
                                    "speaker": "丽莎",
                                    "text": "特别的药剂…"
                                },
                                {
                                    "id": "690060809",
                                    "speaker": "丽莎",
                                    "text": "啊，我做出了一种能让纺织品摸起来更柔软的药剂。"
                                },
                                {
                                    "id": "690060810",
                                    "speaker": "丽莎",
                                    "text": "还有一支能够让空气保持甜香的清新剂。我还挺喜欢的。"
                                },
                                {
                                    "id": "690060811",
                                    "speaker": "丽莎",
                                    "text": "不过，这些就不是骑士团的需要。而是出自我的个人兴趣。"
                                },
                                {
                                    "id": "690060812",
                                    "speaker": "丽莎",
                                    "text": "嗯…难道是跟你认识了之后，爱好也向居家的方向转变了吗。"
                                }
                            ]
                        },
                        {
                            "id": "690060813",
                            "text": "丽莎又在说让人害羞的话了…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900604",
            "initDialog": "690060401",
            "dialogues": [
                {
                    "id": "690060401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690060901",
                    "speaker": "丽莎",
                    "text": "嗯，我想邀请你一起喝下午茶。"
                },
                {
                    "id": "690060902",
                    "speaker": "丽莎",
                    "text": "日落果茶或者玫瑰花茶，点心呢，喜欢哪种口味的蛋糕？",
                    "choices": [
                        {
                            "id": "690060903",
                            "text": "难道丽莎是要亲自做？",
                            "response": [
                                {
                                    "id": "690060904",
                                    "speaker": "丽莎",
                                    "text": "哈哈，被你猜对了。"
                                },
                                {
                                    "id": "690060908",
                                    "speaker": "丽莎",
                                    "text": "只要我想做的，没有什么是做不出来的。"
                                },
                                {
                                    "id": "690060909",
                                    "speaker": "丽莎",
                                    "text": "只是…只是…"
                                },
                                {
                                    "id": "690060910",
                                    "speaker": "丽莎",
                                    "text": "多数时间，我会觉得这类事情不值得我多耗费精力而已。"
                                },
                                {
                                    "id": "690060911",
                                    "speaker": "丽莎",
                                    "text": "但你对我而言意义不同。在你身上耗费精力，不需要思考这些。"
                                },
                                {
                                    "id": "690060912",
                                    "speaker": "丽莎",
                                    "text": "唔，还是说，我不应该先问你的喜好…"
                                },
                                {
                                    "id": "690060913",
                                    "speaker": "丽莎",
                                    "text": "而是把它们都做出来，当做一个惊喜？"
                                },
                                {
                                    "id": "690060914",
                                    "speaker": "Player",
                                    "text": "丽莎的心意对我来说已经是一个惊喜了。"
                                },
                                {
                                    "id": "690060915",
                                    "speaker": "丽莎",
                                    "text": "你变得越来越甜了，小可爱。"
                                },
                                {
                                    "id": "690060916",
                                    "speaker": "丽莎",
                                    "text": "那我可要好好准备一下…"
                                },
                                {
                                    "id": "690060917",
                                    "speaker": "丽莎",
                                    "text": "不能被你小瞧了啊…"
                                }
                            ]
                        },
                        {
                            "id": "690060905",
                            "text": "我都可以。",
                            "response": [
                                {
                                    "id": "690060906",
                                    "speaker": "丽莎",
                                    "text": "和不挑剔的你相处，我很轻松呢。"
                                },
                                {
                                    "id": "690060907",
                                    "speaker": "丽莎",
                                    "text": "不过这次…我是想亲手来做。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900605",
            "initDialog": "690060501",
            "dialogues": [
                {
                    "id": "690060501",
                    "speaker": "Player",
                    "text": "早啊，丽莎。"
                },
                {
                    "id": "690061001",
                    "speaker": "丽莎",
                    "text": "早哦，小可爱。"
                },
                {
                    "id": "690061002",
                    "speaker": "丽莎",
                    "text": "我相信你能应付这些事情的。"
                },
                {
                    "id": "690061003",
                    "speaker": "丽莎",
                    "text": "当然，真遇到了应付不来的情况，就叫姐姐我吧。"
                }
            ]
        },
        {
            "talkId": "6900606",
            "initDialog": "690060601",
            "dialogues": [
                {
                    "id": "690060601",
                    "speaker": "Player",
                    "text": "晚安，丽莎。"
                },
                {
                    "id": "690061101",
                    "speaker": "丽莎",
                    "text": "晚安啦，小可爱。"
                },
                {
                    "id": "690061102",
                    "speaker": "丽莎",
                    "text": "我已经…很困了。真羡慕你到了晚上还能这么生龙活虎的…"
                },
                {
                    "id": "690061103",
                    "speaker": "丽莎",
                    "text": "要睡个好觉哦…"
                }
            ]
        },
        {
            "talkId": "6900612",
            "initDialog": "690061201",
            "dialogues": [
                {
                    "id": "690061201",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6900613",
            "initDialog": "690061301",
            "dialogues": [
                {
                    "id": "690061301",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6900614",
            "initDialog": "690061401",
            "dialogues": [
                {
                    "id": "690061401",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6900650",
            "initDialog": "690065001",
            "dialogues": [
                {
                    "id": "690065001",
                    "speaker": "丽莎",
                    "text": "你对书房的品味不错。"
                },
                {
                    "id": "690065002",
                    "speaker": "丽莎",
                    "text": "大型书柜和壁炉，在这里休息会很惬意吧。"
                },
                {
                    "id": "690065003",
                    "speaker": "丽莎",
                    "text": "把这里安排得这么舒适，值得好好奖励哟。"
                }
            ]
        },
        {
            "talkId": "6900651",
            "initDialog": "690065101",
            "dialogues": [
                {
                    "id": "690065101",
                    "speaker": "丽莎",
                    "text": "哦？是个适合安静研究的地方。"
                },
                {
                    "id": "690065102",
                    "speaker": "丽莎",
                    "text": "既方便查阅资料，又能随时开始试验，真是魔导师的理想工坊。"
                },
                {
                    "id": "690065103",
                    "speaker": "丽莎",
                    "text": "姐姐我…感受到你的贴心了呢。"
                }
            ]
        },
        {
            "talkId": "3",
            "initDialog": "301",
            "dialogues": [
                {
                    "id": "301",
                    "speaker": "丽莎",
                    "text": "这里是——【不用编辑器】配的【简单】对话！"
                },
                {
                    "id": "302",
                    "speaker": "Player",
                    "text": "哦哦，原来如此。"
                },
                {
                    "id": "303",
                    "speaker": "Player",
                    "text": "嗯，我现在完全搞懂了！"
                },
                {
                    "id": "304",
                    "speaker": "丽莎",
                    "text": "感觉你完全没搞懂……"
                }
            ]
        }
    ]
}