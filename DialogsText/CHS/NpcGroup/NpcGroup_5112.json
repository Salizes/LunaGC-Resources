{
    "groupId": "5112",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "纳瓦伊": 13
    },
    "talks": [
        {
            "talkId": "6511201",
            "initDialog": "651120101",
            "dialogues": [
                {
                    "id": "651120101",
                    "speaker": "纳瓦伊",
                    "text": "我猜，下一场应该是…庭审？"
                }
            ]
        },
        {
            "talkId": "6511202",
            "initDialog": "651120201",
            "dialogues": [
                {
                    "id": "651120201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "651120202",
                    "speaker": "纳瓦伊",
                    "text": "啊，你好。我是来自须弥的游学者，不是本地人，还请多关照。"
                },
                {
                    "id": "651120203",
                    "speaker": "纳瓦伊",
                    "text": "不知道你对枫丹了解多少，我反正还在试图理解它的路上。"
                },
                {
                    "id": "651120204",
                    "speaker": "纳瓦伊",
                    "text": "你看，须弥是由学者主导的国家，而枫丹是由司法人员主导的国家，社会形态完全不同。"
                },
                {
                    "id": "651120205",
                    "speaker": "纳瓦伊",
                    "text": "是个很好的研究方向，对吧？"
                }
            ]
        },
        {
            "talkId": "6511203",
            "initDialog": "651120301",
            "dialogues": [
                {
                    "id": "651120301",
                    "speaker": "Player",
                    "text": "抱歉，我也不清楚。"
                },
                {
                    "id": "651120302",
                    "speaker": "纳瓦伊",
                    "text": "没关系，我也不是在提问，只是猜想而已。"
                }
            ]
        },
        {
            "talkId": "6511204",
            "initDialog": "651120401",
            "dialogues": [
                {
                    "id": "651120401",
                    "speaker": "Player",
                    "text": "值得深究。"
                },
                {
                    "id": "651120402",
                    "speaker": "纳瓦伊",
                    "text": "我也是这么觉得，而且至今也如此相信。"
                },
                {
                    "id": "651120403",
                    "speaker": "纳瓦伊",
                    "text": "不过这座歌剧院里发生的一切还是给了我当头一棒。谁能想到庭审竟然和艺术演出共用同一个场所呢？"
                },
                {
                    "id": "651120404",
                    "speaker": "纳瓦伊",
                    "text": "这在须弥，可是很难想象的事情。"
                },
                {
                    "id": "651120405",
                    "speaker": "纳瓦伊",
                    "text": "哦，但是转念一想，这种情况的成因，也是一个很好的课题呢…"
                }
            ]
        },
        {
            "talkId": "7490201",
            "initDialog": "749020101",
            "dialogues": [
                {
                    "id": "749020101",
                    "speaker": "Player",
                    "text": "不打扰你的思考了…"
                },
                {
                    "id": "749020102",
                    "speaker": "纳瓦伊",
                    "text": "没有关系，人的想法就是要在交流中碰撞，不是吗？"
                },
                {
                    "id": "749020103",
                    "speaker": "纳瓦伊",
                    "text": "所以谢谢你愿意和我搭话。"
                },
                {
                    "id": "749020104",
                    "speaker": "纳瓦伊",
                    "text": "我看看…身边只有些从枫丹廷带过来的食物，不介意的话就当是和你结识的见面礼，请收下吧。"
                }
            ]
        }
    ]
}