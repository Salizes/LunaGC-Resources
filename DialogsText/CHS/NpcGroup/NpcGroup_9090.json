{
    "groupId": "9090",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 16,
        "夏沃蕾": 55
    },
    "talks": [
        {
            "talkId": "6909001",
            "initDialog": "690900101",
            "dialogues": [
                {
                    "id": "690900101",
                    "speaker": "夏沃蕾",
                    "text": "一盏茶壶中居然有这么大的空间，真是难以置信…"
                },
                {
                    "id": "690900102",
                    "speaker": "夏沃蕾",
                    "text": "#感谢你的邀请，{NICKNAME}，我算是开眼界了。"
                }
            ]
        },
        {
            "talkId": "6909002",
            "initDialog": "690900201",
            "dialogues": [
                {
                    "id": "690900201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690900202",
                    "speaker": "夏沃蕾",
                    "text": "对我来说，这里的环境已经算是上佳了。"
                },
                {
                    "id": "690900203",
                    "speaker": "夏沃蕾",
                    "text": "我工作一整年，都未必能在这种舒适的环境中待上两个月。"
                },
                {
                    "id": "690900204",
                    "speaker": "Player",
                    "text": "你的工作环境究竟有多艰苦！？"
                },
                {
                    "id": "690900205",
                    "speaker": "夏沃蕾",
                    "text": "举例子的话，比如…为了接近走私船只，在冬天的冰水里武装潜泳。"
                },
                {
                    "id": "690900206",
                    "speaker": "夏沃蕾",
                    "text": "为了抓捕潜逃犯，连续几天通宵地毯式搜查…还好我们的鞋子底部都加厚过，十分耐磨。"
                },
                {
                    "id": "690900207",
                    "speaker": "夏沃蕾",
                    "text": "当然，还有在大夏天埋伏在河边灌木丛里，等待嫌疑人露面。"
                },
                {
                    "id": "690900208",
                    "speaker": "夏沃蕾",
                    "text": "夏季河边有许多毒虫，被咬的话也许会染病，但大部分防虫药的气味都十分刺鼻，很可能会暴露我们的位置…"
                },
                {
                    "id": "690900209",
                    "speaker": "夏沃蕾",
                    "text": "所以，我不得不要求所有人把皮肤都裹起来，就这么硬生生地捂着，直到嫌疑人拿出赃物和现金开始交易。"
                },
                {
                    "id": "690900210",
                    "speaker": "夏沃蕾",
                    "text": "最后，我们确实将嫌疑人抓了个人赃并获，但…也有几个队员因为中暑倒下，休养了很久。",
                    "choices": [
                        {
                            "id": "690900211",
                            "text": "光是想想就开始难受了…",
                            "response": [
                                {
                                    "id": "690900212",
                                    "speaker": "夏沃蕾",
                                    "text": "难受是肯定的。但我和我的队员们都已经习惯了，毕竟…这也是为了维护枫丹廷市民们的安宁。"
                                },
                                {
                                    "id": "690900215",
                                    "speaker": "夏沃蕾",
                                    "text": "不过…唉，我们队内因为执行任务而受伤的队员越来越多…"
                                },
                                {
                                    "id": "690900216",
                                    "speaker": "夏沃蕾",
                                    "text": "我也该向执律庭提交一份报告，要求提高我们的伤病补贴了。"
                                }
                            ]
                        },
                        {
                            "id": "690900213",
                            "text": "夏沃蕾当时没事吗？",
                            "response": [
                                {
                                    "id": "690900214",
                                    "speaker": "夏沃蕾",
                                    "text": "我可是队长，是最专业的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909003",
            "initDialog": "690900301",
            "dialogues": [
                {
                    "id": "690900301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690900302",
                    "speaker": "夏沃蕾",
                    "text": "好。鉴于保密原则，我不能向你分享什么具体的案件详情…"
                },
                {
                    "id": "690900303",
                    "speaker": "夏沃蕾",
                    "text": "但我可以给你讲一件和特巡队有关的故事。"
                },
                {
                    "id": "690900304",
                    "speaker": "夏沃蕾",
                    "text": "当时，我们特巡队刚刚失去一位战友…他是在执行重要任务时牺牲的。"
                },
                {
                    "id": "690900305",
                    "speaker": "夏沃蕾",
                    "text": "我们为他举办了葬礼，并将所有遗物都移交给了他的家属。"
                },
                {
                    "id": "690900306",
                    "speaker": "夏沃蕾",
                    "text": "按照传统，我们将他的帽子保存在队内…如果未来他的孩子来到特巡队，我们会将这顶帽子授予对方。"
                },
                {
                    "id": "690900307",
                    "speaker": "夏沃蕾",
                    "text": "我将一切都打理好了之后，突然有天看见门口聚集了许多人，我还以为是谁来闹事了，马上去查看情况。"
                },
                {
                    "id": "690900308",
                    "speaker": "Player",
                    "text": "那名孩子？"
                },
                {
                    "id": "690900309",
                    "speaker": "夏沃蕾",
                    "text": "正是。他抓着一位队员的袖子说：「请问，你看见我爸爸了吗？」"
                },
                {
                    "id": "690900310",
                    "speaker": "夏沃蕾",
                    "text": "他描述不出他父亲的长相，只知道父亲「又高又大」，他一遍遍地重复父亲的名字，而队员们都在低头沉默。"
                },
                {
                    "id": "690900311",
                    "speaker": "夏沃蕾",
                    "text": "大家知道，那位战友长期执行隐秘任务，在孩子刚出生的那段时间都没机会回家。"
                },
                {
                    "id": "690900312",
                    "speaker": "夏沃蕾",
                    "text": "但当时我们还不知道，为了保密，他在家里连一张画片都没有留下。"
                },
                {
                    "id": "690900313",
                    "speaker": "夏沃蕾",
                    "text": "孩子从母亲口中得知，自己的父亲是一名「荣誉的特巡队队员」。"
                },
                {
                    "id": "690900314",
                    "speaker": "夏沃蕾",
                    "text": "但他无法理解什么叫「荣誉」，更无法理解什么叫「再也回不来」。"
                },
                {
                    "id": "690900315",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "690900316",
                    "speaker": "夏沃蕾",
                    "text": "最后，我们将孩子送回了他的家，队员们还各自为他留下了一件礼物。"
                },
                {
                    "id": "690900317",
                    "speaker": "夏沃蕾",
                    "text": "有的留下了自己的怀表，有的留下了一支笔，有的留下了一枚徽章。"
                },
                {
                    "id": "690900318",
                    "speaker": "Player",
                    "text": "你呢？"
                },
                {
                    "id": "690900319",
                    "speaker": "夏沃蕾",
                    "text": "我把我最喜欢的那本小说送给了他。"
                },
                {
                    "id": "690900320",
                    "speaker": "夏沃蕾",
                    "text": "我希望他能像书中的主人公那样，有朝一日，以自己的意志做出自己的人生选择。"
                },
                {
                    "id": "690900321",
                    "speaker": "夏沃蕾",
                    "text": "无论是选择继承这顶帽子，或是远离特巡队…"
                },
                {
                    "id": "690900322",
                    "speaker": "夏沃蕾",
                    "text": "至少那时，我祝愿他能为他的父亲感到自豪。"
                }
            ]
        },
        {
            "talkId": "6909004",
            "initDialog": "690900401",
            "dialogues": [
                {
                    "id": "690900401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690900402",
                    "speaker": "夏沃蕾",
                    "text": "能偶尔在这里放松一下，对我来说就很难得了。"
                },
                {
                    "id": "690900403",
                    "speaker": "夏沃蕾",
                    "text": "另外…我最近在想，是不是能请你协助执行一些任务。有了你帮忙，想必那些凶徒只能乖乖伏法了。",
                    "choices": [
                        {
                            "id": "690900404",
                            "text": "上哪打架？",
                            "response": [
                                {
                                    "id": "690900405",
                                    "speaker": "夏沃蕾",
                                    "text": "虽然的确可能产生冲突，但你的回答如此果断，莫非平时习惯使用暴力？"
                                },
                                {
                                    "id": "690900406",
                                    "speaker": "夏沃蕾",
                                    "text": "别紧张，我不是在指责你。"
                                },
                                {
                                    "id": "690900407",
                                    "speaker": "夏沃蕾",
                                    "text": "有些时候，这也是对方唯一能听懂的「语言」。我对此深有感触。"
                                },
                                {
                                    "id": "690900411",
                                    "speaker": "夏沃蕾",
                                    "text": "那我们谈妥了？"
                                },
                                {
                                    "id": "690900412",
                                    "speaker": "Player",
                                    "text": "具体要怎么配合呢？"
                                },
                                {
                                    "id": "690900413",
                                    "speaker": "夏沃蕾",
                                    "text": "我原本设想过，在执行需要潜入和监视的任务时，靠这茶壶隐蔽。"
                                },
                                {
                                    "id": "690900414",
                                    "speaker": "夏沃蕾",
                                    "text": "但现在看来，出入这盏茶壶并不方便。不如换个角度。我带着壶执行任务，你做援兵。"
                                },
                                {
                                    "id": "690900415",
                                    "speaker": "Player",
                                    "text": "…什么？"
                                },
                                {
                                    "id": "690900416",
                                    "speaker": "夏沃蕾",
                                    "text": "只要我一敲茶壶，你就从壶里跳出去，帮我打倒那些武装嫌犯。"
                                },
                                {
                                    "id": "690900417",
                                    "speaker": "夏沃蕾",
                                    "text": "「带着神奇茶壶的特巡队队长」，这称号还挺有童话的感觉。就这么定了。"
                                },
                                {
                                    "id": "690900418",
                                    "speaker": "Player",
                                    "text": "但茶壶我没法给你…"
                                },
                                {
                                    "id": "690900419",
                                    "speaker": "夏沃蕾",
                                    "text": "…这样。好吧。"
                                },
                                {
                                    "id": "690900420",
                                    "speaker": "夏沃蕾",
                                    "text": "那我要给你制定加训方案了。希望你不要喊苦喊累。"
                                }
                            ]
                        },
                        {
                            "id": "690900408",
                            "text": "多少报酬？",
                            "response": [
                                {
                                    "id": "690900409",
                                    "speaker": "夏沃蕾",
                                    "text": "我出手从不小气。朋友一场，更是不会少你好处。"
                                },
                                {
                                    "id": "690900410",
                                    "speaker": "夏沃蕾",
                                    "text": "顺带一提，庆功宴上的菜肴如果你吃不习惯，我可以和你共同分享某些罪恶的食物。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909005",
            "initDialog": "690900501",
            "dialogues": [
                {
                    "id": "690900501",
                    "speaker": "Player",
                    "text": "早啊，夏沃蕾。"
                },
                {
                    "id": "690900502",
                    "speaker": "夏沃蕾",
                    "text": "早上好，周遭十分安全，我刚才已经巡查过了。"
                },
                {
                    "id": "690900503",
                    "speaker": "夏沃蕾",
                    "text": "不过，这里没什么锻炼器材，看来今早的力量锻炼要暂停了…"
                }
            ]
        },
        {
            "talkId": "6909006",
            "initDialog": "690900601",
            "dialogues": [
                {
                    "id": "690900601",
                    "speaker": "Player",
                    "text": "晚安，夏沃蕾。"
                },
                {
                    "id": "690900602",
                    "speaker": "夏沃蕾",
                    "text": "晚安，好好休息。我会再去巡逻几圈，消化刚刚被我吞噬的罪恶。"
                }
            ]
        },
        {
            "talkId": "6909007",
            "initDialog": "690900701",
            "dialogues": [
                {
                    "id": "690900701",
                    "speaker": "夏沃蕾",
                    "text": "这里给我的感觉，像是回到了特巡队队舍啊。"
                },
                {
                    "id": "690900702",
                    "speaker": "夏沃蕾",
                    "text": "但还少了几件搭在椅子背上的衣服，几杯喝剩下的咖啡…"
                },
                {
                    "id": "690900703",
                    "speaker": "夏沃蕾",
                    "text": "当然，也缺了一群累得东倒西歪的特巡队队员。"
                }
            ]
        },
        {
            "talkId": "6909008",
            "initDialog": "690900801",
            "dialogues": [
                {
                    "id": "690900801",
                    "speaker": "夏沃蕾",
                    "text": "这么想来，我也亲手送了不少人进梅洛彼得堡。"
                },
                {
                    "id": "690900802",
                    "speaker": "夏沃蕾",
                    "text": "既然他们有了一次新的机会，那我希望…他们能够好好把握，赎清自己的罪孽。"
                },
                {
                    "id": "690900803",
                    "speaker": "夏沃蕾",
                    "text": "最重要的是，认清是非，不要再犯。"
                }
            ]
        }
    ]
}