{
    "groupId": "7515",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "马特维": 7
    },
    "talks": [
        {
            "talkId": "6751501",
            "initDialog": "675150101",
            "dialogues": [
                {
                    "id": "675150101",
                    "speaker": "马特维",
                    "text": "好想来上一口…等会一定要去好好喝上一杯！"
                }
            ]
        },
        {
            "talkId": "6751502",
            "initDialog": "675150201",
            "dialogues": [
                {
                    "id": "675150201",
                    "speaker": "Player",
                    "text": "喝上一杯什么？"
                },
                {
                    "id": "675150202",
                    "speaker": "马特维",
                    "text": "酒！当然是来上一大杯烈酒啊！我每天如此辛勤工作，就是为了有钱天天去买酒喝…不然，谁想要工作啊！"
                },
                {
                    "id": "675150203",
                    "speaker": "马特维",
                    "text": "好了，不跟您多说了，我要抓紧搬完这一趟，接着又可以休息好几天了。"
                }
            ]
        },
        {
            "talkId": "6751503",
            "initDialog": "675150301",
            "dialogues": [
                {
                    "id": "675150301",
                    "speaker": "Player",
                    "text": "你看起来很累…"
                },
                {
                    "id": "675150302",
                    "speaker": "马特维",
                    "text": "还好吧，在工作的时候，我一般就是这样的状态——只有喝酒的时候，我会快活一点。"
                },
                {
                    "id": "675150303",
                    "speaker": "马特维",
                    "text": "但这并不是什么好事，你知道，酒精，给你带来快乐，又给你带来痛苦。"
                },
                {
                    "id": "675150304",
                    "speaker": "马特维",
                    "text": "如果下辈子再给我一次机会的话，我一定滴酒不沾！但这辈子嘛…"
                }
            ]
        },
        {
            "talkId": "6751504",
            "initDialog": "675150401",
            "dialogues": [
                {
                    "id": "675150401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675150402",
                    "speaker": "马特维",
                    "text": "如果您有什么货物需要搬运，也可以来找我。"
                }
            ]
        }
    ]
}