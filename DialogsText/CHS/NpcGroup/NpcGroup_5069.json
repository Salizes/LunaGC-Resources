            "initDialog": "650690101",
            "dialogues": [
                {
                    "id": "650690101",
                    "speaker": "克洛莎",
                    "text": "是地震了？还是我又晕船了…"
                }
            ]
        },
        {
            "talkId": "6506902",
            "initDialog": "650690201",
            "dialogues": [
                {
                    "id": "650690201",
                    "speaker": "Player",
                    "text": "这里卖什么？"
                },
                {
                    "id": "650690202",
                    "speaker": "克洛莎",
                    "text": "您随意选。"
                }
            ]
        },
        {
            "talkId": "6506903",
            "initDialog": "650690301",
            "dialogues": [
                {
                    "id": "650690301",
                    "speaker": "Player",
                    "text": "我没什么感觉。"
                },
                {
                    "id": "650690302",
                    "speaker": "克洛莎",
                    "text": "唉…那就是我的老毛病又犯了。"
                },
                {
                    "id": "650690303",
                    "speaker": "克洛莎",
                    "text": "我以前是水手，在一次事故中头受了伤，自那以后总觉得周围在晃…"
                },
                {
                    "id": "650690304",
                    "speaker": "克洛莎",
                    "text": "现在水手肯定是做不成了，只能帮老朋友卖点海里捞上来的东西赚口饭吃。"
                }
            ]
        },
        {
            "talkId": "6506904",
            "initDialog": "650690401",
            "dialogues": [
                {
                    "id": "650690401",
                    "speaker": "Player",
                    "text": "你多保重。"
                },
                {
                    "id": "650690402",
                    "speaker": "克洛莎",
                    "text": "嗯…我先缓缓。"
                }
            ]
        }
    ]
}