{
    "groupId": "9368",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "林尼": 9
    },
    "talks": [
        {
            "talkId": "6936801",
            "initDialog": "693680101",
            "dialogues": [
                {
                    "id": "693680101",
                    "speaker": "林尼",
                    "text": "有时间的话，要不要看我表演个魔术？"
                },
                {
                    "id": "693680102",
                    "speaker": "林尼",
                    "text": "就当是在后台练手了，也可以算作调整调整心情。"
                },
                {
                    "id": "693680103",
                    "speaker": "林尼",
                    "text": "现在这种场合，嗯，就选这副魔术牌吧！"
                }
            ]
        },
        {
            "talkId": "6936802",
            "initDialog": "693680201",
            "dialogues": [
                {
                    "id": "693680201",
                    "speaker": "林尼",
                    "text": "接下来的战斗好像难度不低呢，看着我的眼睛…你会担心吗？"
                },
                {
                    "id": "693680202",
                    "speaker": "林尼",
                    "text": "魔术的精髓之一，就是把看似不可能的事情展现在人们面前。而最棒的魔术师，并不是只有在舞台上演出才能绽放光彩的哦？"
                },
                {
                    "id": "693680203",
                    "speaker": "林尼",
                    "text": "所以，要不要试试和我这个大魔术师携手，一起见证奇迹？"
                }
            ]
        },
        {
            "talkId": "6936803",
            "initDialog": "693680301",
            "dialogues": [
                {
                    "id": "693680301",
                    "speaker": "林尼",
                    "text": "要是菲米尼看到这里的藏书，一定会非常高兴吧。他是那么相信童话故事，相信书中的世界真实存在。"
                },
                {
                    "id": "693680302",
                    "speaker": "林尼",
                    "text": "我能够理解他的心情。不过…"
                },
                {
                    "id": "693680303",
                    "speaker": "林尼",
                    "text": "对我来说，童年已经是非常遥远的记忆了。"
                }
            ]
        }
    ]
}