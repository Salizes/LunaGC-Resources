{
    "groupId": "15437",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 10,
        "齐勇": 22
    },
    "talks": [
        {
            "talkId": "7167003",
            "initDialog": "716700301",
            "dialogues": [
                {
                    "id": "716700301",
                    "speaker": "齐勇",
                    "text": "那座秘境中的敌人绝不能以常理考量，还请保持十二万分的警惕，切勿看漏了它们的任何一招！"
                }
            ]
        },
        {
            "talkId": "7167005",
            "initDialog": "716700501",
            "dialogues": [
                {
                    "id": "716700501",
                    "speaker": "齐勇",
                    "text": "#原来是您，侠士{NICKNAME}，有新指示吗？",
                    "choices": [
                        {
                            "id": "716700502",
                            "text": "侠士？",
                            "response": [
                                {
                                    "id": "716700503",
                                    "speaker": "齐勇",
                                    "text": "方谨长官说，你得知此地的险情后，毅然前来助阵…"
                                },
                                {
                                    "id": "716700504",
                                    "speaker": "齐勇",
                                    "text": "即便了解到紊乱秘境中的凶险，也丝毫不曾感到畏惧，而是锐不可当地攻入敌营…"
                                },
                                {
                                    "id": "716700505",
                                    "speaker": "齐勇",
                                    "text": "这股侠义之气实在令人钦佩！",
                                    "choices": [
                                        {
                                            "id": "716700506",
                                            "text": "我只是喜欢帮助好人！",
                                            "response": [
                                                {
                                                    "id": "716700508",
                                                    "speaker": "齐勇",
                                                    "text": "您过谦了！我还想向您请教用剑的武艺，还望您不嫌麻烦…"
                                                },
                                                {
                                                    "id": "716700509",
                                                    "speaker": "齐勇",
                                                    "text": "不过眼下的任务是保持戒备，随时做好迎敌的准备，只能等个合适的时机了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716700507",
                                            "text": "还有很多真正的侠士！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716700510",
                            "text": "指示？",
                            "response": [
                                {
                                    "id": "716700511",
                                    "speaker": "齐勇",
                                    "text": "方谨长官确认了，您与我部达成了长期合作，必要时，我部会全力协助您作战。"
                                },
                                {
                                    "id": "716700512",
                                    "speaker": "齐勇",
                                    "text": "当然，即使当前的阵线已相当稳固，我部也不能擅离职守，若是您想去附近清剿其他魔物，请恕我部难以配合。",
                                    "choices": [
                                        {
                                            "id": "716700513",
                                            "text": "不会不会，守好这里最重要！",
                                            "response": [
                                                {
                                                    "id": "716700515",
                                                    "speaker": "齐勇",
                                                    "text": "没错，我们都相信，即便是面对各种情况都游刃有余的您，也会一丝不苟，专注于应对眼前的威胁。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716700514",
                                            "text": "防住地脉紊乱点才是核心任务！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716700516",
                            "text": "不干扰你了，请保持专注。",
                            "response": [
                                {
                                    "id": "716700517",
                                    "speaker": "齐勇",
                                    "text": "竟如此体谅友军…真有大将风范！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7167007",
            "initDialog": "716700701",
            "dialogues": [
                {
                    "id": "716700701",
                    "speaker": "齐勇",
                    "text": "新一轮的战斗来了啊，实在令人兴奋！"
                },
                {
                    "id": "716700702",
                    "speaker": "齐勇",
                    "text": "不知道这次，我们能在秘境中支撑多久…",
                    "choices": [
                        {
                            "id": "716700703",
                            "text": "不是在外边防御作战吗？",
                            "response": [
                                {
                                    "id": "716700704",
                                    "speaker": "齐勇",
                                    "text": "攻势防御也是一种对抗敌军的手段，有时甚至能起到极为关键的作用。"
                                },
                                {
                                    "id": "716700705",
                                    "speaker": "齐勇",
                                    "text": "地脉紊乱点活跃的初期，我们组织过精锐的斥候部队，攻入其中，探查到了不少有效情报。"
                                },
                                {
                                    "id": "716700706",
                                    "speaker": "齐勇",
                                    "text": "这种磨砺自己的战局可不多，换成我原本所在的队伍，每个战友都会抢着上前！"
                                }
                            ]
                        },
                        {
                            "id": "716700707",
                            "text": "要注意保存自身的力量…",
                            "response": [
                                {
                                    "id": "716700708",
                                    "speaker": "齐勇",
                                    "text": "请放心，我们都知道把握分寸。"
                                },
                                {
                                    "id": "716700709",
                                    "speaker": "齐勇",
                                    "text": "准确评估敌我战力差距，是战士必不可少的本领。"
                                },
                                {
                                    "id": "716700710",
                                    "speaker": "齐勇",
                                    "text": "在抵达极限前，绝不表现出半分怯懦，保持最为稳定的进攻节奏。"
                                },
                                {
                                    "id": "716700711",
                                    "speaker": "齐勇",
                                    "text": "在面对绝无可能战胜的强敌时，绝不莽撞应战，而是互相照应，有序脱离接触，等待援军或更为合适的战机。"
                                },
                                {
                                    "id": "716700712",
                                    "speaker": "齐勇",
                                    "text": "总之，我们会将战斗的主动权牢牢掌握在自己手中！"
                                }
                            ]
                        },
                        {
                            "id": "716700713",
                            "text": "我也摩拳擦掌！",
                            "response": [
                                {
                                    "id": "716700714",
                                    "speaker": "齐勇",
                                    "text": "能和您并肩作战实在荣幸，我的斗志正在燃烧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}