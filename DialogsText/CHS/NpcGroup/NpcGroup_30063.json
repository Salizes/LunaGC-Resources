            "dialogues": [
                {
                    "id": "400122701",
                    "speaker": "可莉",
                    "text": "#啊！荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！",
                    "choices": [
                        {
                            "id": "400122702",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400122703",
                                    "speaker": "可莉",
                                    "text": "嗯，要！",
                                    "choices": [
                                        {
                                            "id": "400122704",
                                            "text": "关于嘟嘟大魔王…",
                                            "response": [
                                                {
                                                    "id": "400122705",
                                                    "speaker": "可莉",
                                                    "text": "#那个家伙，一定很坏！荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}也要小心他哦。"
                                                },
                                                {
                                                    "id": "400122706",
                                                    "speaker": "可莉",
                                                    "text": "虽然还没见到他，但可莉一定会保护好嘟嘟可，不让嘟嘟可被他抢走。"
                                                },
                                                {
                                                    "id": "400122707",
                                                    "speaker": "可莉",
                                                    "text": "哪怕他是嘟嘟可的…嘟嘟可的…呃，爷爷、哥哥之类的…"
                                                },
                                                {
                                                    "id": "400122708",
                                                    "speaker": "可莉",
                                                    "text": "不管他是嘟嘟可的什么人，可莉都不会认输！",
                                                    "choices": [
                                                        {
                                                            "id": "400122704",
                                                            "text": "关于嘟嘟大魔王…"
                                                        },
                                                        {
                                                            "id": "400122709",
                                                            "text": "关于海岛…",
                                                            "response": [
                                                                {
                                                                    "id": "400122710",
                                                                    "speaker": "可莉",
                                                                    "text": "可莉很喜欢这里！"
                                                                },
                                                                {
                                                                    "id": "400122711",
                                                                    "speaker": "可莉",
                                                                    "text": "有沙滩、大海…"
                                                                },
                                                                {
                                                                    "id": "400122712",
                                                                    "speaker": "可莉",
                                                                    "text": "还有芭芭拉姐姐给的羽球，还有各种奇妙的东西…而且大家都在这里，超——级热闹！"
                                                                },
                                                                {
                                                                    "id": "400122713",
                                                                    "speaker": "可莉",
                                                                    "text": "可莉很开心！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400122704",
                                                                            "text": "关于嘟嘟大魔王…"
                                                                        },
                                                                        {
                                                                            "id": "400122709",
                                                                            "text": "关于海岛…"
                                                                        },
                                                                        {
                                                                            "id": "400122714",
                                                                            "text": "关于可莉自己…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400122715",
                                                                                    "speaker": "可莉",
                                                                                    "text": "其实，可莉有点害怕…"
                                                                                },
                                                                                {
                                                                                    "id": "400122716",
                                                                                    "speaker": "可莉",
                                                                                    "text": "万一可莉失败的话，嘟嘟可就会离开可莉…"
                                                                                },
                                                                                {
                                                                                    "id": "400122717",
                                                                                    "speaker": "可莉",
                                                                                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你会保护嘟嘟可吗？"
                                                                                },
                                                                                {
                                                                                    "id": "400122718",
                                                                                    "speaker": "Player",
                                                                                    "text": "会。"
                                                                                },
                                                                                {
                                                                                    "id": "400122719",
                                                                                    "speaker": "可莉",
                                                                                    "text": "真的吗？有你在，可莉和嘟嘟可就安全啦。嘿嘿…谢谢你！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400122704",
                                                                                            "text": "关于嘟嘟大魔王…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122709",
                                                                                            "text": "关于海岛…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122714",
                                                                                            "text": "关于可莉自己…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122720",
                                                                                            "text": "关于今天发生的事…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122721",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "唔…可莉还有些不明白…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122722",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "但大家都来了，阿贝多哥哥和雷泽也来了，真好呀。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122723",
                                                                                                    "speaker": "可莉",
                                                                                                    "text": "嘿嘿…能玩的游戏也变多了。可莉喜欢跟大家一起的感觉！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "400122704",
                                                                                                            "text": "关于嘟嘟大魔王…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122709",
                                                                                                            "text": "关于海岛…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122714",
                                                                                                            "text": "关于可莉自己…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122720",
                                                                                                            "text": "关于今天发生的事…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122724",
                                                                                                            "text": "先不打扰你了。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "400122725",
                                                                                                                    "speaker": "可莉",
                                                                                                                    "text": "好~想炸鱼的时候，记得来找可莉哦！"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
