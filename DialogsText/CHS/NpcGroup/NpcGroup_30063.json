            "dialogues": [
                {
                    "id": "400131101",
                    "speaker": "可莉",
                    "text": "妈妈是世界上最厉害的人哦，阿贝多哥哥可以作证！"
                },
                {
                    "id": "400131102",
                    "speaker": "可莉",
                    "text": "#妈妈认识大家，一定也认识荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。"
                },
                {
                    "id": "400131103",
                    "speaker": "可莉",
                    "text": "因为，妈妈是万能的嘛！"
                },
                {
                    "id": "400131104",
                    "speaker": "可莉",
                    "text": "#等下次妈妈回来，我们一起去找她吧。妈妈是很好很好的人，荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}绝对会喜欢她的！"
