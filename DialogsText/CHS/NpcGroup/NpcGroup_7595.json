{
    "groupId": "7595",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "季米亚科夫": 10
    },
    "talks": [
        {
            "talkId": "6759501",
            "initDialog": "675950101",
            "dialogues": [
                {
                    "id": "675950101",
                    "speaker": "季米亚科夫",
                    "text": "不要准点不要准点不要准点，拜托拜托——"
                }
            ]
        },
        {
            "talkId": "6759502",
            "initDialog": "675950201",
            "dialogues": [
                {
                    "id": "675950201",
                    "speaker": "Player",
                    "text": "你是说列车不要准点吗？"
                },
                {
                    "id": "675950202",
                    "speaker": "季米亚科夫",
                    "text": "是啊！如果列车准点到达，我就一定会准点开始工作，然后准点处理那个麻烦得要命的事务。"
                },
                {
                    "id": "675950203",
                    "speaker": "季米亚科夫",
                    "text": "天哪！我根本不想看那一堆文件，也不想见那些难打交道的人，饶了我吧——"
                }
            ]
        },
        {
            "talkId": "6759503",
            "initDialog": "675950301",
            "dialogues": [
                {
                    "id": "675950301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "675950302",
                    "speaker": "季米亚科夫",
                    "text": "唉，我还是去喝点吧，冷静冷静…"
                }
            ]
        },
        {
            "talkId": "6759504",
            "initDialog": "675950401",
            "dialogues": [
                {
                    "id": "675950401",
                    "speaker": "Player",
                    "text": "如果列车不准点的话，你就能…"
                },
                {
                    "id": "675950402",
                    "speaker": "季米亚科夫",
                    "text": "也不能。天哪！我知道，就算列车不准点来，我也必须准点开始工作，然后准点处理那个麻烦得要命的事务。"
                },
                {
                    "id": "675950403",
                    "speaker": "季米亚科夫",
                    "text": "但…我，就是…噢！我真不想面对，无论看着谁的份上，我根本不想开始工作！"
                },
                {
                    "id": "675950404",
                    "speaker": "季米亚科夫",
                    "text": "但列车一定会准时来！我也会准点开始工作，然后准点处理那个麻烦得要命的事务！"
                },
                {
                    "id": "675950405",
                    "speaker": "季米亚科夫",
                    "text": "一切都会准时，我的人生也一样会准时结束，每个人都一样——"
                }
            ]
        },
        {
            "talkId": "6759505",
            "initDialog": "675950501",
            "dialogues": [
                {
                    "id": "675950501",
                    "speaker": "Player",
                    "text": "你、你冷静点…"
                },
                {
                    "id": "675950502",
                    "speaker": "季米亚科夫",
                    "text": "抱歉。我一定是被气疯了…"
                },
                {
                    "id": "675950503",
                    "speaker": "季米亚科夫",
                    "text": "唉，我还是去喝点吧，冷静冷静…"
                }
            ]
        }
    ]
}