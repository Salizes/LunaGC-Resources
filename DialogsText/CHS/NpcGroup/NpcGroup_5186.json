{
    "groupId": "5186",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "坎佩尔": 8
    },
    "talks": [
        {
            "talkId": "6518601",
            "initDialog": "651860101",
            "dialogues": [
                {
                    "id": "651860101",
                    "speaker": "坎佩尔",
                    "text": "柔灯港怎么成了现在这样…太糟糕了，太糟糕了…"
                }
            ]
        },
        {
            "talkId": "6518602",
            "initDialog": "651860201",
            "dialogues": [
                {
                    "id": "651860201",
                    "speaker": "Player",
                    "text": "柔灯港怎么糟糕了？"
                },
                {
                    "id": "651860202",
                    "speaker": "坎佩尔",
                    "text": "你瞧瞧底下的那些船，到底是枫丹的船多，还是外国的船多？"
                },
                {
                    "id": "651860203",
                    "speaker": "坎佩尔",
                    "text": "之前柔灯港港口里的船，还是枫丹的船最多…但不知道从什么时候起，柔灯港里的船，就是外国的船更多啦。"
                },
                {
                    "id": "651860204",
                    "speaker": "坎佩尔",
                    "text": "这么下去，这个港口还能称得上是枫丹的港口吗？"
                }
            ]
        },
        {
            "talkId": "6518603",
            "initDialog": "651860301",
            "dialogues": [
                {
                    "id": "651860301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651860302",
                    "speaker": "坎佩尔",
                    "text": "再见。这建言信该如何开头呢…"
                }
            ]
        },
        {
            "talkId": "6518604",
            "initDialog": "651860401",
            "dialogues": [
                {
                    "id": "651860401",
                    "speaker": "Player",
                    "text": "枫丹并不只有柔灯港一个港口啦…"
                },
                {
                    "id": "651860402",
                    "speaker": "坎佩尔",
                    "text": "唉，我知道，我知道。但我们柔灯港可是一个很重要的港口，很多和外国相关的大宗生意都会经过这里。"
                },
                {
                    "id": "651860403",
                    "speaker": "坎佩尔",
                    "text": "但最近，连那种大货船都没怎么入过港了…"
                },
                {
                    "id": "651860404",
                    "speaker": "坎佩尔",
                    "text": "先不和你说了，我还要继续写建言信给卡茜涅尔小姐，她是个有能力的人，一定能改变柔灯港的现状。"
                }
            ]
        }
    ]
}