{
    "groupId": "9605",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "菲林斯": 10
    },
    "talks": [
        {
            "talkId": "6960501",
            "initDialog": "696050101",
            "dialogues": [
                {
                    "id": "696050101",
                    "speaker": "菲林斯",
                    "text": "…正如您所知，我的执灯士同僚们偶尔会聚在一起，以牌类游戏为消遣，并借此增进感情。啊，我的意思是，这场「七圣召唤」对局，我早已期待许久…"
                }
            ]
        },
        {
            "talkId": "6960502",
            "initDialog": "696050201",
            "dialogues": [
                {
                    "id": "696050201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960503",
            "initDialog": "696050301",
            "dialogues": [
                {
                    "id": "696050301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696050302",
                    "speaker": "菲林斯",
                    "text": "要离开了？想不到时间竟流逝得如此迅速。这种情况真是稀有…"
                }
            ]
        },
        {
            "talkId": "6960504",
            "initDialog": "696050401",
            "dialogues": [
                {
                    "id": "696050401",
                    "speaker": "菲林斯",
                    "text": "承让。这场对局令我十分愉快，不过若我猜测无误，您似乎在有意识地照顾我这个新手。对此，我衷心感谢您的体贴。但若能见识您全力以赴的技艺，将是我最大的荣幸。"
                }
            ]
        },
        {
            "talkId": "6960505",
            "initDialog": "696050501",
            "dialogues": [
                {
                    "id": "696050501",
                    "speaker": "菲林斯",
                    "text": "精彩。常言道，玩牌的方法即是战术的体现。容我冒昧妄言，您的牌艺与您战斗时的英姿同样令人心折。"
                }
            ]
        },
        {
            "talkId": "6960506",
            "initDialog": "696050601",
            "dialogues": [
                {
                    "id": "696050601",
                    "speaker": "菲林斯",
                    "text": "承蒙您的盛情相请。虽然我对「七圣召唤」的规则不甚精通，但若您不介意，我将很乐意与您在牌桌上切磋一番，权当消遣。"
                }
            ]
        },
        {
            "talkId": "6960508",
            "initDialog": "696050801",
            "dialogues": [
                {
                    "id": "696050801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960509",
            "initDialog": "696050901",
            "dialogues": [
                {
                    "id": "696050901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960510",
            "initDialog": "696051001",
            "dialogues": [
                {
                    "id": "696051001",
                    "speaker": "菲林斯",
                    "text": "看来这次是我运气比较好。"
                }
            ]
        },
        {
            "talkId": "6960511",
            "initDialog": "696051101",
            "dialogues": [
                {
                    "id": "696051101",
                    "speaker": "菲林斯",
                    "text": "我输得心服口服。"
                }
            ]
        },
        {
            "talkId": "6960512",
            "initDialog": "696051201",
            "dialogues": [
                {
                    "id": "696051201",
                    "speaker": "菲林斯",
                    "text": "感谢您的再次邀请，我深感荣幸。得益于近来同僚们的帮助，我在「七圣召唤」的技巧上已有所精进。希望这次能让您尽兴。"
                }
            ]
        },
        {
            "talkId": "6960514",
            "initDialog": "696051401",
            "dialogues": [
                {
                    "id": "696051401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960515",
            "initDialog": "696051501",
            "dialogues": [
                {
                    "id": "696051501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960516",
            "initDialog": "696051601",
            "dialogues": [
                {
                    "id": "696051601",
                    "speaker": "菲林斯",
                    "text": "不好意思，是我略胜一筹。"
                }
            ]
        },
        {
            "talkId": "6960517",
            "initDialog": "696051701",
            "dialogues": [
                {
                    "id": "696051701",
                    "speaker": "菲林斯",
                    "text": "很巧妙的出牌思路，不愧是您。"
                }
            ]
        },
        {
            "talkId": "6960518",
            "initDialog": "696051801",
            "dialogues": [
                {
                    "id": "696051801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}