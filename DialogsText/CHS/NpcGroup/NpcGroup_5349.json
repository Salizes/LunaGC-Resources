{
    "groupId": "5349",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "韦尼尔": 7
    },
    "talks": [
        {
            "talkId": "6534901",
            "initDialog": "653490101",
            "dialogues": [
                {
                    "id": "653490101",
                    "speaker": "韦尼尔",
                    "text": "一百三十六…好，再来十四次，就可以休息了！"
                }
            ]
        },
        {
            "talkId": "6534902",
            "initDialog": "653490201",
            "dialogues": [
                {
                    "id": "653490201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "653490202",
                    "speaker": "韦尼尔",
                    "text": "哈哈，当然是锻炼了！只有不断锻炼自己的体魄，才能保护好这座城市，消灭那些可恶的蛮族侵略者。"
                },
                {
                    "id": "653490203",
                    "speaker": "韦尼尔",
                    "text": "同时也能向至尊证明，我也有被擢升的资格！"
                }
            ]
        },
        {
            "talkId": "6534903",
            "initDialog": "653490301",
            "dialogues": [
                {
                    "id": "653490301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653490302",
                    "speaker": "韦尼尔",
                    "text": "再见，一路小心！"
                }
            ]
        },
        {
            "talkId": "6534904",
            "initDialog": "653490401",
            "dialogues": [
                {
                    "id": "653490401",
                    "speaker": "Player",
                    "text": "擢升的资格？"
                },
                {
                    "id": "653490402",
                    "speaker": "韦尼尔",
                    "text": "是啊！要想获得被擢升的殊荣，要么得有非凡的音乐才能，要么得有非凡的功绩和忠诚。"
                },
                {
                    "id": "653490403",
                    "speaker": "韦尼尔",
                    "text": "我这辈子恐怕是没有什么音乐才能了。要想被擢升，就只能依靠不懈的锻炼了！"
                }
            ]
        },
        {
            "talkId": "6534905",
            "initDialog": "653490501",
            "dialogues": [
                {
                    "id": "653490501",
                    "speaker": "Player",
                    "text": "祝你早日成功！"
                },
                {
                    "id": "653490502",
                    "speaker": "韦尼尔",
                    "text": "哈哈，谢谢你的鼓励，朋友！也祝你能早日蒙受至尊的拣选，被擢升成不朽之人！"
                }
            ]
        }
    ]
}