    "talks": [
        {
            "talkId": "6531301",
            "initDialog": "653130101",
            "dialogues": [
                {
                    "id": "653130101",
                    "speaker": "瑟琳",
                    "text": "唔，今天要做的事情还有很多呢…"
                }
            ]
        },
        {
            "talkId": "6531302",
            "initDialog": "653130201",
            "dialogues": [
                {
                    "id": "653130201",
                    "speaker": "Player",
                    "text": "关于海沫村…"
                },
                {
                    "id": "653130202",
                    "speaker": "瑟琳",
                    "text": "嗯？是第一次来到海沫村吗？欢迎欢迎！"
                },
                {
                    "id": "653130203",
                    "speaker": "瑟琳",
                    "text": "这里是美露莘们的家，只不过…如你所见，由于位置的缘故，平时一般不会有什么人类来。"
                },
                {
                    "id": "653130204",
                    "speaker": "瑟琳",
                    "text": "如果在村子里遇到了什么困难，或者需要什么的话，记得一定要告诉我喔。"
                }
            ]
        },
        {
            "talkId": "6531303",
            "initDialog": "653130301",
            "dialogues": [
                {
                    "id": "653130301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653130302",
                    "speaker": "瑟琳",
                    "text": "嗯嗯，再见啦！如果有什么需要，请一定要告诉我喔！"
                }
            ]
        },
        {
            "talkId": "6531304",
            "initDialog": "653130401",
            "dialogues": [
                {
                    "id": "653130401",
                    "speaker": "Player",
                    "text": "你是这里的村长吗？"
                },
                {
                    "id": "653130402",
                    "speaker": "瑟琳",
                    "text": "村长…是说负责管理大家的人吗？"
                },
                {
                    "id": "653130403",
                    "speaker": "瑟琳",
                    "text": "感觉不是呢，我只是比其他孩子都要年长一些，作为大家的姐姐，有义务帮助大家解决日常生活中的烦恼。"
                },
                {
                    "id": "653130404",
                    "speaker": "瑟琳",
                    "text": "嗯，一定要尽到照顾大家的义务才行。"
                }
            ]
        },
        {
            "talkId": "6531305",
            "initDialog": "653130501",
            "dialogues": [
                {
                    "id": "653130501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653130502",
                    "speaker": "瑟琳",
                    "text": "嗯嗯，再见啦！如果有需要帮忙的地方，请一定要告诉我喔！"
                }
            ]
        },
        {
            "talkId": "6531306",
            "initDialog": "653130601",
            "dialogues": [
                {
                    "id": "653130601",
                    "speaker": "瑟琳",
                    "text": "唔，今天要做的事情还有很多呢…"
                },
                {
                    "id": "653130602",
                    "speaker": "瑟琳",
                    "text": "啊，你好！有什么需要帮助的吗？"
                }
            ]
        },
        {
            "talkId": "6531307",
            "initDialog": "653130701",
            "dialogues": [
                {
                    "id": "653130701",
                    "speaker": "Player",
                    "text": "关于海沫村…"
                },
                {
                    "id": "653130702",
                    "speaker": "瑟琳",
                    "text": "这里是美露莘们的家，只不过…如你所见，由于位置的缘故，平时一般不会有什么人类来。"
                },
                {
                    "id": "653130703",
                    "speaker": "瑟琳",
                    "text": "如果在村子里遇到了什么困难，或者需要什么的话，记得一定要告诉我喔。"
                }
            ]
        },
        {
            "talkId": "6531308",
            "initDialog": "653130801",
            "dialogues": [
                {
                    "id": "653130801",
                    "speaker": "瑟琳",
                    "text": "唔，今天要做的事情还有很多呢…"
                },
                {
                    "id": "653130802",
                    "speaker": "瑟琳",
                    "text": "啊，你好！之前的事…真是多谢你们的帮助了！"
                }
            ]
        },
        {
            "talkId": "6531309",
            "initDialog": "653130901",
            "dialogues": [
                {
                    "id": "653130901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653130902",
                    "speaker": "瑟琳",
                    "text": "嗯嗯，再见啦！如果有什么需要帮助的事情，请一定要告诉我喔！"
                }
            ]
        },
        {
            "talkId": "6531310",
            "initDialog": "653131001",
            "dialogues": [
                {
                    "id": "653131001",
                    "speaker": "Player",
                    "text": "附近有需要帮助的美露莘吗？"
                }
            ]
        },
        {
            "talkId": "6531311",
            "initDialog": "653131101",
            "dialogues": [
                {
                    "id": "653131101",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫伊雅蕾的孩子，似乎在为了钓鱼的事情发愁…"
                }
            ]
        },
        {
            "talkId": "6531312",
            "initDialog": "653131201",
            "dialogues": [
                {
                    "id": "653131201",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫伊雅蕾的孩子，似乎在为了钓鱼的事情发愁…"
                }
            ]
        },
        {
            "talkId": "6531313",
            "initDialog": "653131301",
            "dialogues": [
                {
                    "id": "653131301",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫薇蕾娜妲的孩子，很认真，也很努力，一直在跟着卡莉珀丝学习，说是想要成为能够帮助大家的人…"
                },
                {
                    "id": "653131302",
                    "speaker": "瑟琳",
                    "text": "最近似乎在为新药的事情发愁呢。具体的事情我也不是很清楚…唉，要是卡莉珀丝能再认真一点的话…"
                }
            ]
        },
        {
            "talkId": "6531314",
            "initDialog": "653131401",
            "dialogues": [
                {
                    "id": "653131401",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫艾伊丝的孩子，最近一直在说什么「艾伊丝看到了梦中的船」…"
                },
                {
                    "id": "653131402",
                    "speaker": "瑟琳",
                    "text": "总觉得在向着玛梅赫的方向发展，有什么事情也不愿意和大家说，很让人担心…"
                }
            ]
        },
        {
            "talkId": "6531315",
            "initDialog": "653131501",
            "dialogues": [
                {
                    "id": "653131501",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫艾伊丝的孩子，最近一直在说什么「艾伊丝看到了梦中的船」…"
                },
                {
                    "id": "653131502",
                    "speaker": "瑟琳",
                    "text": "具体的事情我也不太清楚，所以觉得有些担心…"
                }
            ]
        },
        {
            "talkId": "6531316",
            "initDialog": "653131601",
            "dialogues": [
                {
                    "id": "653131601",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫柯莎的孩子，一直在为种不出花的事情苦恼…"
                },
                {
                    "id": "653131602",
                    "speaker": "瑟琳",
                    "text": "种花的事情我也不是太懂，虽然也去帮过她，但还是不行呢…"
                },
                {
                    "id": "653131603",
                    "speaker": "瑟琳",
                    "text": "你对种花有什么了解吗？"
                }
            ]
        },
        {
            "talkId": "6531317",
            "initDialog": "653131701",
            "dialogues": [
                {
                    "id": "653131701",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，有个叫夏诺蒂拉的孩子，一直在为一本书的事情苦恼…"
                },
                {
                    "id": "653131703",
                    "speaker": "瑟琳",
                    "text": "你看，她还在那边的瀑布下独自苦思冥想呢。"
                },
                {
                    "id": "653131702",
                    "speaker": "瑟琳",
                    "text": "说是看不懂书上的内容…我也看不懂，但如果是见多识广的冒险家，说不定能帮到她吧？"
                }
            ]
        },
        {
            "talkId": "6531318",
            "initDialog": "653131801",
            "dialogues": [
                {
                    "id": "653131801",
                    "speaker": "瑟琳",
                    "text": "嗯…我想想，芙佳之前说，自己的「信物」找不到了…"
                },
                {
                    "id": "653131802",
                    "speaker": "瑟琳",
                    "text": "对我们来说，「信物」是非常非常重要的东西…呜，我明明应该立刻去帮她一起找的，但现在实在是有些走不开…"
                }
            ]
        },
        {
            "talkId": "6531319",
            "initDialog": "653131901",
            "dialogues": [
                {
                    "id": "653131901",
                    "speaker": "Player",
                    "text": "钓鱼？"
                },
                {
                    "id": "653131902",
                    "speaker": "瑟琳",
                    "text": "是呀，她说自己遇到了一位名叫德拉萝诗的钓鱼大师，并向她学习了钓鱼的技艺，但怎么都钓不上来，最近一直很苦恼的样子…"
                }
            ]
        },
        {
            "talkId": "6531320",
            "initDialog": "653132001",
            "dialogues": [
                {
                    "id": "653132001",
                    "speaker": "Player",
                    "text": "钓鱼？"
                },
                {
                    "id": "653132002",
                    "speaker": "瑟琳",
                    "text": "是呀，她说自己遇到了一位名叫德拉萝诗的钓鱼大师，并向她学习了钓鱼的技艺，但怎么都钓不上来，最近一直很苦恼的样子…"
                },
                {
                    "id": "653132003",
                    "speaker": "瑟琳",
                    "text": "唉…我也不清楚要怎么样才能帮到她。我都想过，实在不行的话，我就自己去扮演鱼…"
                },
                {
                    "id": "653132004",
                    "speaker": "瑟琳",
                    "text": "不过那不是什么好办法…唔，能拜托你去帮帮她吗？"
                }
            ]
        },
        {
            "talkId": "6531321",
            "initDialog": "653132101",
            "dialogues": [
                {
                    "id": "653132101",
                    "speaker": "Player",
                    "text": "我能帮上什么忙吗？"
                },
                {
                    "id": "653132102",
                    "speaker": "瑟琳",
                    "text": "具体的我也不是很清楚…好像和研制出的药的效果有关。"
                },
                {
                    "id": "653132103",
                    "speaker": "瑟琳",
                    "text": "不过，如果你能去帮助她，我想她会很高兴…嗯，我也会很高兴的！"
                }
            ]
        },
        {
            "talkId": "6531322",
            "initDialog": "653132201",
            "dialogues": [
                {
                    "id": "653132201",
                    "speaker": "Player",
                    "text": "玛梅赫是什么比较单位吗！"
                },
                {
                    "id": "653132202",
                    "speaker": "瑟琳",
                    "text": "总之，虽然玛梅赫最近稍微开朗一点了，结果，艾伊丝又变成那样…"
                },
                {
                    "id": "653132203",
                    "speaker": "瑟琳",
                    "text": "如果可以的话，能拜托你去帮忙看看吗？"
                }
            ]
        },
        {
            "talkId": "6531323",
            "initDialog": "653132301",
            "dialogues": [
                {
                    "id": "653132301",
                    "speaker": "Player",
                    "text": "听上去似乎有些不妙？"
                },
                {
                    "id": "653132302",
                    "speaker": "瑟琳",
                    "text": "总之，虽然玛梅赫最近稍微开朗一点了，结果，艾伊丝又变成那样…"
                },
                {
                    "id": "653132303",
                    "speaker": "瑟琳",
                    "text": "如果可以的话，能拜托你去村子北面<color=#00E1FFFF>「有很多船的地方」</color>帮忙看看吗？"
                }
            ]
        },
        {
            "talkId": "6531324",
            "initDialog": "653132401",
            "dialogues": [
                {
                    "id": "653132401",
                    "speaker": "Player",
                    "text": "听上去似乎有些不妙？"
                },
                {
                    "id": "653132402",
                    "speaker": "瑟琳",
                    "text": "总之，如果可以的话，能拜托你去村子北面<color=#00E1FFFF>「有很多船的地方」</color>帮忙看看吗？"
                }
            ]
        },
        {
            "talkId": "6531325",
            "initDialog": "653132501",
            "dialogues": [
                {
                    "id": "653132501",
                    "speaker": "Player",
                    "text": "只要我唱歌就会有花出现…"
                },
                {
                    "id": "653132502",
                    "speaker": "瑟琳",
                    "text": "是这样吗，听上去是很美丽的场景啊…如果是这样的话，真希望你能为柯莎的花圃献上一曲。"
                },
                {
                    "id": "653132503",
                    "speaker": "瑟琳",
                    "text": "如果可以的话，我也希望自己能帮上忙，不过，总之似乎需要很多相当艰深的知识呢…"
                },
                {
                    "id": "653132504",
                    "speaker": "瑟琳",
                    "text": "你愿意去<color=#00E1FFFF>村子入口的地方</color>看一下她的花圃吗？如果能够给她提一点建议的话…"
                }
            ]
        },
        {
            "talkId": "6531326",
            "initDialog": "653132601",
            "dialogues": [
                {
                    "id": "653132601",
                    "speaker": "Player",
                    "text": "有所了解吧。"
                },
                {
                    "id": "653132602",
                    "speaker": "瑟琳",
                    "text": "那真是太好了，像我就对种花一无所知…如果是这样的话，真希望你能去看看柯莎的花圃。"
                },
                {
                    "id": "653132603",
                    "speaker": "瑟琳",
                    "text": "如果可以的话，我也希望自己能帮上忙，不过，总之似乎需要很多相当艰深的知识呢…"
                },
                {
                    "id": "653132604",
                    "speaker": "瑟琳",
                    "text": "你愿意去看一下她的花圃吗，如果能够给她提一点建议的话…"
                }
            ]
        },
        {
            "talkId": "6531327",
            "initDialog": "653132701",
            "dialogues": [
                {
                    "id": "653132701",
                    "speaker": "Player",
                    "text": "我去试试吧。"
                },
                {
                    "id": "653132702",
                    "speaker": "瑟琳",
                    "text": "嗯，希望夏诺蒂拉能够解开她的疑惑…"
                }
            ]
        },
        {
            "talkId": "6531328",
            "initDialog": "653132801",
            "dialogues": [
                {
                    "id": "653132801",
                    "speaker": "Player",
                    "text": "就交给我吧！"
                },
                {
                    "id": "653132802",
                    "speaker": "瑟琳",
                    "text": "谢谢你！那…芙佳的事情，就拜托你了！"
                }
            ]
        },
        {
            "talkId": "6531329",
            "initDialog": "653132901",
            "dialogues": [
                {
                    "id": "653132901",
                    "speaker": "Player",
                    "text": "德拉萝诗？"
                },
                {
                    "id": "653132902",
                    "speaker": "瑟琳",
                    "text": "是、是这样吗？"
                },
                {
                    "id": "653132903",
                    "speaker": "瑟琳",
                    "text": "唉…我也不清楚要怎么样才能帮到她。我都想过，实在不行的话，我就自己去扮演鱼…"
                },
                {
                    "id": "653132904",
                    "speaker": "瑟琳",
                    "text": "不过那不是什么好办法…唔，能拜托你去帮帮她吗？"
                }
            ]
        },
        {
            "talkId": "6531330",
            "initDialog": "653133001",
            "dialogues": [
                {
                    "id": "653133001",
                    "speaker": "Player",
                    "text": "大概是找错了老师吧…"
                },
                {
                    "id": "653133002",
                    "speaker": "瑟琳",
                    "text": "是、是这样吗？"
                },
                {
                    "id": "653133003",
                    "speaker": "瑟琳",
                    "text": "唉…我也不清楚要怎么样才能帮到她。我都想过，实在不行的话，我就自己去扮演鱼…"
                },
                {
                    "id": "653133004",
                    "speaker": "瑟琳",
                    "text": "不过那不是什么好办法…唔，能拜托你去帮帮她吗？"
                }
            ]
        },
        {
            "talkId": "6531331",
            "initDialog": "653133101",
            "dialogues": [
                {
                    "id": "653133101",
                    "speaker": "Player",
                    "text": "没问题！"
                },
                {
                    "id": "653133102",
                    "speaker": "瑟琳",
                    "text": "#那真是太好了！那孩子现在应该还在<color=#00E1FFFF>村子南边</color>尝试钓鱼…就拜托你教教她了，{NICKNAME}！"
                }
            ]
        },
        {
            "talkId": "6531332",
            "initDialog": "653133201",
            "dialogues": [
                {
                    "id": "653133201",
