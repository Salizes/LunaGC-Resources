            "dialogues": [
                {
                    "id": "622260101",
                    "speaker": "唐无仇",
                    "text": "#总有一天，我一定能在这里培养出一片琉璃百合大花园的！嗯？{NICKNAME}，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6222602",
            "initDialog": "622260201",
            "dialogues": [
                {
                    "id": "622260201",
                    "speaker": "Player",
                    "text": "没什么事…"
                },
                {
                    "id": "622260202",
                    "speaker": "唐无仇",
                    "text": "原来只是想来这看看呀，那您随意您随意，我继续我的花园大业了！"
                }
            ]
        },
        {
            "talkId": "6222603",
            "initDialog": "622260301",
            "dialogues": [
                {
                    "id": "622260301",
                    "speaker": "Player",
                    "text": "这些都是清心啊…"
                },
                {
                    "id": "622260302",
                    "speaker": "唐无仇",
                    "text": "啊，这倒没什么关系，我先在这里培育清心，熟练园艺技巧。"
                },
                {
                    "id": "622260303",
                    "speaker": "唐无仇",
                    "text": "等到哪天技巧精进之后，就会移植一批琉璃百合过来啦！"
                }
            ]
        }
    ]
