{
    "groupId": "7632",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "泽纳娜": 12
    },
    "talks": [
        {
            "talkId": "6763201",
            "initDialog": "676320101",
            "dialogues": [
                {
                    "id": "676320101",
                    "speaker": "泽纳娜",
                    "text": "这里不是那夏镇吗…明明是照着地图走的来着…"
                }
            ]
        },
        {
            "talkId": "6763202",
            "initDialog": "676320201",
            "dialogues": [
                {
                    "id": "676320201",
                    "speaker": "Player",
                    "text": "这里是皮拉米达城…"
                },
                {
                    "id": "676320202",
                    "speaker": "泽纳娜",
                    "text": "皮拉米达城，我知道…唉，从踏上挪德卡莱之后就走错了路…但至少这次我走到了挪德卡莱，也是种进步。"
                },
                {
                    "id": "676320203",
                    "speaker": "泽纳娜",
                    "text": "好在这里能够当课题的东西似乎也不少。"
                },
                {
                    "id": "676320204",
                    "speaker": "泽纳娜",
                    "text": "反正来都来了，先在这儿待段时间补给一下，再出发去那夏镇吧！"
                }
            ]
        },
        {
            "talkId": "6763203",
            "initDialog": "676320301",
            "dialogues": [
                {
                    "id": "676320301",
                    "speaker": "Player",
                    "text": "教令院的学者？"
                },
                {
                    "id": "676320302",
                    "speaker": "泽纳娜",
                    "text": "是的，本人就是教令院妙论派学者，「走得很快的泽纳娜」。"
                },
                {
                    "id": "676320303",
                    "speaker": "泽纳娜",
                    "text": "虽然大家这样叫我大多是因为调侃，不过我还挺喜欢这个绰号的…"
                },
                {
                    "id": "676320304",
                    "speaker": "泽纳娜",
                    "text": "做研究，当然也要多多出行开阔眼界才行嘛，这次也是听说挪德卡莱的那夏镇有很新颖的机关，立刻就决定来看看了！"
                },
                {
                    "id": "676320305",
                    "speaker": "泽纳娜",
                    "text": "不过…迷路到了这里。哈哈，就跟我导师说的一样：「泽纳娜，下次先看好方向再出发！」"
                }
            ]
        },
        {
            "talkId": "6763204",
            "initDialog": "676320401",
            "dialogues": [
                {
                    "id": "676320401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "676320402",
                    "speaker": "泽纳娜",
                    "text": "好的，让我再研究下地图…"
                }
            ]
        },
        {
            "talkId": "6763205",
            "initDialog": "676320501",
            "dialogues": [
                {
                    "id": "676320501",
                    "speaker": "泽纳娜",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6763206",
            "initDialog": "676320601",
            "dialogues": [
                {
                    "id": "676320601",
                    "speaker": "泽纳娜",
                    "text": "竟、竟然赢了吗？哈哈，多谢了！"
                }
            ]
        },
        {
            "talkId": "6763207",
            "initDialog": "676320701",
            "dialogues": [
                {
                    "id": "676320701",
                    "speaker": "泽纳娜",
                    "text": "欸？我输了？究竟是哪里开始出错了来着？"
                }
            ]
        }
    ]
}