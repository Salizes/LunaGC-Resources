{
    "groupId": "4108",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "马斯鲁尔": 9
    },
    "talks": [
        {
            "talkId": "6410801",
            "initDialog": "641080101",
            "dialogues": [
                {
                    "id": "641080101",
                    "speaker": "马斯鲁尔",
                    "text": "欢迎来到奥摩斯港，请在此处登记入港的船舶。"
                }
            ]
        },
        {
            "talkId": "6410802",
            "initDialog": "641080201",
            "dialogues": [
                {
                    "id": "641080201",
                    "speaker": "Player",
                    "text": "小船也需要吗？"
                },
                {
                    "id": "641080202",
                    "speaker": "马斯鲁尔",
                    "text": "请问是商船吗？"
                },
                {
                    "id": "641080203",
                    "speaker": "马斯鲁尔",
                    "text": "理论上所有入港的船只都要登记所有人信息和入港事由等内容。"
                },
                {
                    "id": "641080204",
                    "speaker": "马斯鲁尔",
                    "text": "涉及贸易往来的更是尤为重要。"
                },
                {
                    "id": "641080205",
                    "speaker": "马斯鲁尔",
                    "text": "未登记的商船在奥摩斯港做生意，一旦被发现，会被立即叫停并受到行政处罚。"
                }
            ]
        },
        {
            "talkId": "6410803",
            "initDialog": "641080301",
            "dialogues": [
                {
                    "id": "641080301",
                    "speaker": "Player",
                    "text": "关于奥摩斯港…"
                },
                {
                    "id": "641080302",
                    "speaker": "马斯鲁尔",
                    "text": "奥摩斯港是须弥最大的商港，也是贸易经济的重要枢纽。"
                },
                {
                    "id": "641080303",
                    "speaker": "马斯鲁尔",
                    "text": "虽然比不上全大陆最大的港口璃月港，但这里每日的吞吐量也是非常可观的。"
                },
                {
                    "id": "641080304",
                    "speaker": "马斯鲁尔",
                    "text": "所以希望往来船只都能积极配合港务官的工作，共同成就须弥的繁荣经济。"
                }
            ]
        },
        {
            "talkId": "6410804",
            "initDialog": "641080401",
            "dialogues": [
                {
                    "id": "641080401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "641080402",
                    "speaker": "马斯鲁尔",
                    "text": "祝旅途顺利。"
                }
            ]
        }
    ]
}