    },
    "talks": [
        {
            "talkId": "6300801",
            "initDialog": "630080101",
            "dialogues": [
                {
                    "id": "630080101",
                    "speaker": "冈崎绘里香",
                    "text": "客人请坐，想吃什么跟我讲。"
                }
            ]
        },
        {
            "talkId": "6300802",
            "initDialog": "630080201",
            "dialogues": [
                {
                    "id": "630080201",
                    "speaker": "Player",
                    "text": "想买些「好手艺」。"
                },
                {
                    "id": "630080202",
                    "speaker": "冈崎绘里香",
                    "text": "这位客人可真会讲话。想吃什么自己挑吧，不过看你的年纪，酒就不卖给你了。"
                }
            ]
        },
        {
            "talkId": "6300803",
            "initDialog": "630080301",
            "dialogues": [
                {
                    "id": "630080301",
                    "speaker": "Player",
                    "text": "你和店主是怎么认识的？"
                },
                {
                    "id": "630080302",
                    "speaker": "冈崎绘里香",
                    "text": "你说我和他？哎呀，客人你问了个难讲的问题呢，这可是一段孽缘。"
                },
                {
                    "id": "630080303",
                    "speaker": "冈崎绘里香",
                    "text": "当年我还年轻时，奉命监视一位天领奉行中的大人物，岂料…"
                },
                {
                    "id": "630080304",
                    "speaker": "冈崎绘里香",
                    "text": "哎，不提了。只能说谢天谢地这人后来隐退，我俩才得以正式成婚。谢天谢地啊。"
                }
            ]
        },
        {
            "talkId": "6300804",
            "initDialog": "630080401",
            "dialogues": [
                {
                    "id": "630080401",
                    "speaker": "Player",
                    "text": "再见啦。"
                },
                {
                    "id": "630080402",
                    "speaker": "冈崎绘里香",
                    "text": "吃饱就好，欢迎下次再来。"
                }
            ]
        }
    ]
}