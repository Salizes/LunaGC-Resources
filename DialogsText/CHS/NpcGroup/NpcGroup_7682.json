{
    "groupId": "7682",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "托萨利斯": 9
    },
    "talks": [
        {
            "talkId": "6768201",
            "initDialog": "676820101",
            "dialogues": [
                {
                    "id": "676820101",
                    "speaker": "托萨利斯",
                    "text": "啊…一个「偶然性」的「具象」，我看到它正在走出「此在」的「沉沦」。"
                }
            ]
        },
        {
            "talkId": "6768202",
            "initDialog": "676820201",
            "dialogues": [
                {
                    "id": "676820201",
                    "speaker": "Player",
                    "text": "你说「偶然性」的什么？"
                },
                {
                    "id": "676820202",
                    "speaker": "托萨利斯",
                    "text": "很好，你很敏锐，抓住了「偶然性」这个词。"
                },
                {
                    "id": "676820203",
                    "speaker": "托萨利斯",
                    "text": "「偶然性」意味着无法预知的未来与可能，而拥有可能便等同于拥有希望。"
                },
                {
                    "id": "676820204",
                    "speaker": "托萨利斯",
                    "text": "当初那位圣徒就是这么对我们说的。但是很可惜，在我来到这里后不久，他所拥有的可能性就灰飞烟灭了。"
                }
            ]
        },
        {
            "talkId": "6768203",
            "initDialog": "676820301",
            "dialogues": [
                {
                    "id": "676820301",
                    "speaker": "Player",
                    "text": "你在这里做什么。"
                },
                {
                    "id": "676820302",
                    "speaker": "托萨利斯",
                    "text": "就像你所听到的，我在把我能记得住的词汇反复念诵出来，直到它们在语言的实践中被重新赋予意义…"
                },
                {
                    "id": "676820303",
                    "speaker": "托萨利斯",
                    "text": "或者一直到我觉得满足了为止，至少现在我的感觉不错。"
                }
            ]
        },
        {
            "talkId": "6768204",
            "initDialog": "676820401",
            "dialogues": [
                {
                    "id": "676820401",
                    "speaker": "Player",
                    "text": "打扰了…"
                },
                {
                    "id": "676820402",
                    "speaker": "托萨利斯",
                    "text": "没关系，不可说的，只可不说。"
                }
            ]
        },
        {
            "talkId": "6768205",
            "initDialog": "676820501",
            "dialogues": [
                {
                    "id": "676820501",
                    "speaker": "Player",
                    "text": "虽然没听懂，但似乎有些悲伤…"
                },
                {
                    "id": "676820502",
                    "speaker": "托萨利斯",
                    "text": "的确是个悲剧…不过这就是历史。历史和语言一样是流动的，就像词汇也没有固定的所指。"
                },
                {
                    "id": "676820503",
                    "speaker": "托萨利斯",
                    "text": "所以词汇本身并不重要，重要的是我们已经达成了理解，完全可以说这是一场成功的对话。"
                }
            ]
        }
    ]
}