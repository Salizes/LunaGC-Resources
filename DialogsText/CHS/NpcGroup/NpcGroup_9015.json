{
    "groupId": "9015",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Player": 18,
        "凯亚": 47
    },
    "talks": [
        {
            "talkId": "6901501",
            "initDialog": "690150101",
            "dialogues": [
                {
                    "id": "690150101",
                    "speaker": "凯亚",
                    "text": "#唷，{NICKNAME}。"
                },
                {
                    "id": "690150102",
                    "speaker": "凯亚",
                    "text": "没想到又见到你了。"
                }
            ]
        },
        {
            "talkId": "6901502",
            "initDialog": "690150201",
            "dialogues": [
                {
                    "id": "690150201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690150701",
                    "speaker": "凯亚",
                    "text": "哦，习惯得很。"
                },
                {
                    "id": "690150702",
                    "speaker": "凯亚",
                    "text": "唔，只说「习惯」的话怎么想都会觉得程度不够吧。"
                },
                {
                    "id": "690150703",
                    "speaker": "凯亚",
                    "text": "最初的确是「大吃一惊」。",
                    "choices": [
                        {
                            "id": "690150704",
                            "text": "惊喜的那种？",
                            "response": [
                                {
                                    "id": "690150705",
                                    "speaker": "凯亚",
                                    "text": "嗯，没错！"
                                },
                                {
                                    "id": "690150708",
                                    "speaker": "凯亚",
                                    "text": "这里比我当初想象得更漂亮。"
                                },
                                {
                                    "id": "690150709",
                                    "speaker": "凯亚",
                                    "text": "但是，待的时间长了，吃惊的感觉没留下多少。倒是因为这种自在，产生了点归属感。"
                                },
                                {
                                    "id": "690150710",
                                    "speaker": "凯亚",
                                    "text": "真是难得啊…"
                                }
                            ]
                        },
                        {
                            "id": "690150706",
                            "text": "惊吓的那种？",
                            "response": [
                                {
                                    "id": "690150707",
                                    "speaker": "凯亚",
                                    "text": "哎——当然是惊喜的那种啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901503",
            "initDialog": "690150301",
            "dialogues": [
                {
                    "id": "690150301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690150801",
                    "speaker": "凯亚",
                    "text": "哦？那你可是找对人了。"
                },
                {
                    "id": "690150802",
                    "speaker": "凯亚",
                    "text": "说吧，我很乐意奉陪。"
                },
                {
                    "id": "690150803",
                    "speaker": "凯亚",
                    "text": "唔…要是手边有杯酒就更好了啊…"
                },
                {
                    "id": "690150804",
                    "speaker": "Player",
                    "text": "凯亚为什么那么喜欢喝酒呢？"
                },
                {
                    "id": "690150805",
                    "speaker": "凯亚",
                    "text": "嗯…口感是很重要的一部分。"
                },
                {
                    "id": "690150806",
                    "speaker": "凯亚",
                    "text": "不过，也有一部分原因是喜欢喝酒的感觉。",
                    "choices": [
                        {
                            "id": "690150807",
                            "text": "我隐约能够理解。",
                            "response": [
                                {
                                    "id": "690150808",
                                    "speaker": "凯亚",
                                    "text": "哦？明明没有实践却能单纯通过话语理解。"
                                },
                                {
                                    "id": "690150809",
                                    "speaker": "凯亚",
                                    "text": "你果然有过人的天赋啊。"
                                },
                                {
                                    "id": "690150813",
                                    "speaker": "凯亚",
                                    "text": "话说回来，跟你聊天是一件很让人陶醉的事情。"
                                },
                                {
                                    "id": "690150814",
                                    "speaker": "凯亚",
                                    "text": "喝酒对我来说也一样。"
                                },
                                {
                                    "id": "690150815",
                                    "speaker": "凯亚",
                                    "text": "所以…我只是比较贪心吧。想要让这些快乐的事情叠加在一起。"
                                },
                                {
                                    "id": "690150816",
                                    "speaker": "Player",
                                    "text": "它们会像鸡尾酒一样分层吗？"
                                },
                                {
                                    "id": "690150817",
                                    "speaker": "凯亚",
                                    "text": "哈哈…有意思有意思。是我没有思考过的角度。"
                                },
                                {
                                    "id": "690150818",
                                    "speaker": "凯亚",
                                    "text": "我想想…"
                                },
                                {
                                    "id": "690150819",
                                    "speaker": "凯亚",
                                    "text": "嗯…可能会吧。"
                                },
                                {
                                    "id": "690150820",
                                    "speaker": "凯亚",
                                    "text": "但酒的作用是衬托你。"
                                }
                            ]
                        },
                        {
                            "id": "690150810",
                            "text": "原来不是因为能够麻醉痛苦之类的？",
                            "response": [
                                {
                                    "id": "690150811",
                                    "speaker": "凯亚",
                                    "text": "哎——瞧你这说的。我哪有那么多痛苦的事情。"
                                },
                                {
                                    "id": "690150812",
                                    "speaker": "凯亚",
                                    "text": "对于现在的生活，我可是很知足的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901504",
            "initDialog": "690150401",
            "dialogues": [
                {
                    "id": "690150401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690150901",
                    "speaker": "凯亚",
                    "text": "我嘛，只要有你在身边就满足了。"
                },
                {
                    "id": "690150902",
                    "speaker": "凯亚",
                    "text": "#倒是有什么能为你效劳的吗？{NICKNAME}。",
                    "choices": [
                        {
                            "id": "690150903",
                            "text": "凯亚还是那么会说话啊…",
                            "response": [
                                {
                                    "id": "690150904",
                                    "speaker": "凯亚",
                                    "text": "哈，哪里哪里。"
                                },
                                {
                                    "id": "690150905",
                                    "speaker": "凯亚",
                                    "text": "我说的可都是我的真心话。"
                                },
                                {
                                    "id": "690150906",
                                    "speaker": "凯亚",
                                    "text": "如果我的点子对你起到了什么帮助，那感到自豪的可是我本人。"
                                },
                                {
                                    "id": "690150907",
                                    "speaker": "凯亚",
                                    "text": "这说明你信任我，也说明我有这种为你解决问题的能力。"
                                },
                                {
                                    "id": "690150910",
                                    "speaker": "凯亚",
                                    "text": "哦，对了。要不要为你编写一本指南呢…"
                                },
                                {
                                    "id": "690150911",
                                    "speaker": "凯亚",
                                    "text": "将居家旅行的实用知识收纳其中，我所总结出的三教九流交流技巧也可以尽数分享给你。",
                                    "choices": [
                                        {
                                            "id": "690150912",
                                            "text": "感觉会很有用…",
                                            "response": [
                                                {
                                                    "id": "690150914",
                                                    "speaker": "凯亚",
                                                    "text": "哈哈…谢谢！"
                                                },
                                                {
                                                    "id": "690150915",
                                                    "speaker": "凯亚",
                                                    "text": "看来我要早点开工了啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690150913",
                                            "text": "不愧是凯亚呢。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690150908",
                            "text": "以后也可以借用凯亚的智慧吗？",
                            "response": [
                                {
                                    "id": "690150909",
                                    "speaker": "凯亚",
                                    "text": "听候你的差遣。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901505",
            "initDialog": "690150501",
            "dialogues": [
                {
                    "id": "690150501",
                    "speaker": "Player",
                    "text": "早啊，凯亚。"
                },
                {
                    "id": "690151001",
                    "speaker": "凯亚",
                    "text": "#嗯，早啊，{NICKNAME}。"
                },
                {
                    "id": "690151002",
                    "speaker": "凯亚",
                    "text": "如果想找个倾诉的对象，别忘了还有我。"
                }
            ]
        },
        {
            "talkId": "6901506",
            "initDialog": "690150601",
            "dialogues": [
                {
                    "id": "690150601",
                    "speaker": "Player",
                    "text": "晚安，凯亚。"
                },
                {
                    "id": "690151101",
                    "speaker": "凯亚",
                    "text": "已经那么快就到晚上了吗。真有点舍不得。"
                },
                {
                    "id": "690151102",
                    "speaker": "凯亚",
                    "text": "嗯…休息好才会有精神。好啦，晚安。"
                }
            ]
        },
        {
            "talkId": "6901512",
            "initDialog": "690151201",
            "dialogues": [
                {
                    "id": "690151201",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6901513",
            "initDialog": "690151301",
            "dialogues": [
                {
                    "id": "690151301",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6901514",
            "initDialog": "690151401",
            "dialogues": [
                {
                    "id": "690151401",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6901550",
            "initDialog": "690155001",
            "dialogues": [
                {
                    "id": "690155001",
                    "speaker": "凯亚",
                    "text": "答应我，葡萄熟了，可别用来榨汁，酿成美酒才算物尽其用。"
                },
                {
                    "id": "690155002",
                    "speaker": "凯亚",
                    "text": "…呵呵，想起了从前在酒庄的日子。"
                },
                {
                    "id": "690155003",
                    "speaker": "凯亚",
                    "text": "不如我来和你分享分享，酿酒的秘诀吧。"
                }
            ]
        },
        {
            "talkId": "6901551",
            "initDialog": "690155101",
            "dialogues": [
                {
                    "id": "690155101",
                    "speaker": "凯亚",
                    "text": "呆在这里感觉好像身在蒙德，唯一不同的就是不会有团里的差事烦心。"
                },
                {
                    "id": "690155102",
                    "speaker": "凯亚",
                    "text": "带上陈年的美酒，在这里品尝的话，那就太惬意了。"
                },
                {
                    "id": "690155103",
                    "speaker": "凯亚",
                    "text": "到时候也这样陪我聊两句吧，朋友。"
                }
            ]
        }
    ]
}