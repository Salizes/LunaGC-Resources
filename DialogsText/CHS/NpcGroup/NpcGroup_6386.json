{
    "groupId": "6386",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "尤洛": 9
    },
    "talks": [
        {
            "talkId": "6638601",
            "initDialog": "663860101",
            "dialogues": [
                {
                    "id": "663860101",
                    "speaker": "尤洛",
                    "text": "好，这次的作品，也要展现出前所未有的活力！"
                }
            ]
        },
        {
            "talkId": "6638602",
            "initDialog": "663860201",
            "dialogues": [
                {
                    "id": "663860201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "663860202",
                    "speaker": "尤洛",
                    "text": "哟，新面孔！欢迎来到涂鸦联盟的画廊！"
                },
                {
                    "id": "663860203",
                    "speaker": "尤洛",
                    "text": "看到岩壁上的画了吧？这些都是我们联盟的作品，每一幅都灌注了灵魂！"
                }
            ]
        },
        {
            "talkId": "6638603",
            "initDialog": "663860301",
            "dialogues": [
                {
                    "id": "663860301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "663860302",
                    "speaker": "尤洛",
                    "text": "好，祝你一路顺风！"
                }
            ]
        },
        {
            "talkId": "6638604",
            "initDialog": "663860401",
            "dialogues": [
                {
                    "id": "663860401",
                    "speaker": "Player",
                    "text": "灵魂？"
                },
                {
                    "id": "663860402",
                    "speaker": "尤洛",
                    "text": "没错！每一幅涂鸦都有自己的灵魂，就好像每一幅织卷都隐藏着自己的传说。"
                },
                {
                    "id": "663860403",
                    "speaker": "尤洛",
                    "text": "要知道啊，在遥远的过去，这可不只是比喻——曾经有一群秘术师，真的能将大灵的力量注入色彩，以涂鸦护佑纳塔免遭灾厄。"
                },
                {
                    "id": "663860404",
                    "speaker": "尤洛",
                    "text": "虽说我们没有那么强大的力量，但艺术本身也有自己的灵魂。"
                },
                {
                    "id": "663860405",
                    "speaker": "尤洛",
                    "text": "不同的矿石、花瓣，甚至是龙掉落的鳞片，都能调配出独一无二的色彩——这就是涂鸦的「灵魂」！"
                },
                {
                    "id": "663860406",
                    "speaker": "尤洛",
                    "text": "要不要来试试看？别怕弄脏衣服，涂鸦嘛，就是要玩得尽兴才行！"
                }
            ]
        }
    ]
}