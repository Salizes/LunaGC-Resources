{
    "groupId": "5201",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 9,
        "达希": 24
    },
    "talks": [
        {
            "talkId": "6520101",
            "initDialog": "652010101",
            "dialogues": [
                {
                    "id": "652010101",
                    "speaker": "达希",
                    "text": "你好！今天也是美好的一天啊，对吧？"
                }
            ]
        },
        {
            "talkId": "6520102",
            "initDialog": "652010201",
            "dialogues": [
                {
                    "id": "652010201",
                    "speaker": "Player",
                    "text": "是啊，今天真是个好日子。"
                },
                {
                    "id": "652010202",
                    "speaker": "达希",
                    "text": "要是每天都是像今天一样的好日子就好了！"
                }
            ]
        },
        {
            "talkId": "6520103",
            "initDialog": "652010301",
            "dialogues": [
                {
                    "id": "652010301",
                    "speaker": "Player",
                    "text": "不，要我说，今天真是糟透了。"
                },
                {
                    "id": "652010302",
                    "speaker": "达希",
                    "text": "别这么说嘛！今天还没结束呢，不如接下来做些开心的事，这样至少能够高兴地迎来明天。"
                },
                {
                    "id": "652010303",
                    "speaker": "达希",
                    "text": "今天有个开心的结束，明天有个高兴的开始，多好呀！"
                }
            ]
        },
        {
            "talkId": "6520104",
            "initDialog": "652010401",
            "dialogues": [
                {
                    "id": "652010401",
                    "speaker": "达希",
                    "text": "你好呀！有什么我能为你效劳的吗？"
                }
            ]
        },
        {
            "talkId": "6520105",
            "initDialog": "652010501",
            "dialogues": [
                {
                    "id": "652010501",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "652010502",
                    "speaker": "达希",
                    "text": "当然是为了帮助像你一样的人啦！"
                },
                {
                    "id": "652010503",
                    "speaker": "达希",
                    "text": "那些来了之后手上拿着莫莱妮小姐塞给他们的空白表格左顾右盼不知该如何是好的新人，总得有个好心人给他们正确的指引吧？"
                },
                {
                    "id": "652010504",
                    "speaker": "达希",
                    "text": "除了我，曾经的「漂亮脸蛋」，还有谁能胜任这份工作呢？"
                },
                {
                    "id": "652010505",
                    "speaker": "达希",
                    "text": "偷偷告诉你，你可千万别告诉别人，我的工作是受到莫莱妮小姐的认可的，虽然她不会在公开场合承认这一点，但是我知道…"
                },
                {
                    "id": "652010506",
                    "speaker": "达希",
                    "text": "她心里一定是这么想的！"
                }
            ]
        },
        {
            "talkId": "6520106",
            "initDialog": "652010601",
            "dialogues": [
                {
                    "id": "652010601",
                    "speaker": "Player",
                    "text": "有什么有趣的小道消息吗？"
                },
                {
                    "id": "652010602",
                    "speaker": "达希",
                    "text": "你是说，除了「漂亮脸蛋」变成「脏脸」之外的消息吗？唔，那我可得好好想想。"
                },
                {
                    "id": "652010603",
                    "speaker": "达希",
                    "text": "哈哈，开玩笑的。不过说实话，也没什么可说的小道消息了。不是消息太大你肯定早就听说了，就是事情太小讲起来不够有趣。"
                },
                {
                    "id": "652010604",
                    "speaker": "达希",
                    "text": "唉，要不还是你给我讲讲有趣的小道消息吧。"
                }
            ]
        },
        {
            "talkId": "6520107",
            "initDialog": "652010701",
            "dialogues": [
                {
                    "id": "652010701",
                    "speaker": "Player",
                    "text": "没什么需要帮忙的，再见。"
                },
                {
                    "id": "652010702",
                    "speaker": "达希",
                    "text": "看来你已经习惯了在梅洛彼得堡的生活呢，真好！"
                }
            ]
        },
        {
            "talkId": "6520108",
            "initDialog": "652010801",
            "dialogues": [
                {
                    "id": "652010801",
                    "speaker": "Player",
                    "text": "我没什么可说的，再见。"
                },
                {
                    "id": "652010802",
                    "speaker": "达希",
                    "text": "没消息就是好消息！真和平呀。"
                }
            ]
        },
        {
            "talkId": "6520109",
            "initDialog": "652010901",
            "dialogues": [
                {
                    "id": "652010901",
                    "speaker": "达希",
                    "text": "好朋友，见到你真高兴！"
                }
            ]
        },
        {
            "talkId": "6520110",
            "initDialog": "652011001",
            "dialogues": [
                {
                    "id": "652011001",
                    "speaker": "Player",
                    "text": "关于艾蒂安的游戏…"
                },
                {
                    "id": "652011002",
                    "speaker": "达希",
                    "text": "恭喜你们赢了游戏！"
                },
                {
                    "id": "652011003",
                    "speaker": "达希",
                    "text": "说起来我都没怎么见过卡特皮拉…原来他手上有那么多特许券啊，真叫人羡慕！如果我也能有那么多特许券…"
                },
                {
                    "id": "652011004",
                    "speaker": "达希",
                    "text": "就请梅洛彼得堡的大家都尝尝新口味的枫达…不，买下大家一天的工时，请大家放假一天！"
                },
                {
                    "id": "652011005",
                    "speaker": "达希",
                    "text": "或者说，由我出资，举办一场七圣召唤的比赛？唔，每个点子都好棒，好难取舍…哦！为什么要选呢？我也可以全都要嘛！"
                }
            ]
        },
        {
            "talkId": "6520111",
            "initDialog": "652011101",
            "dialogues": [
                {
                    "id": "652011101",
                    "speaker": "Player",
                    "text": "还有其他事，先告辞了。"
                },
                {
                    "id": "652011102",
                    "speaker": "达希",
                    "text": "真辛苦啊。要多保重哦！"
                }
            ]
        },
        {
            "talkId": "7493601",
            "initDialog": "749360101",
            "dialogues": [
                {
                    "id": "749360101",
                    "speaker": "Player",
                    "text": "关于梅洛彼得堡…"
                },
                {
                    "id": "749360102",
                    "speaker": "达希",
                    "text": "我挺喜欢在这里的生活的！以前在外边的时候，我经常过着昼夜颠倒的生活，晚上彻夜失眠，白天萎靡不振…"
                },
                {
                    "id": "749360103",
                    "speaker": "达希",
                    "text": "但是自从来了梅洛彼得堡，我就过上了规律健康的生活！"
                },
                {
                    "id": "749360104",
                    "speaker": "达希",
                    "text": "如果你也有这方面的烦恼，应该在这里多住一段时间！"
                }
            ]
        }
    ]
}