{
    "groupId": "1541",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "布洛克": 17
    },
    "talks": [
        {
            "talkId": "4111533",
            "initDialog": "411153301",
            "dialogues": [
                {
                    "id": "411153301",
                    "speaker": "布洛克",
                    "text": "陨石事件的调查现在有进展了吗？我相信肯定会完美解决的。"
                },
                {
                    "id": "411153302",
                    "speaker": "布洛克",
                    "text": "那些昏迷的人们一旦醒过来，一定会觉得饿坏了吧？我也该预先为他们准备些肉类料理了。"
                }
            ]
        },
        {
            "talkId": "7092101",
            "initDialog": "709210101",
            "dialogues": [
                {
                    "id": "709210101",
                    "speaker": "Player",
                    "text": "好香啊…"
                },
                {
                    "id": "709210102",
                    "speaker": "布洛克",
                    "text": "哼哼，那当然了，这可是我布洛克做的肉排！"
                },
                {
                    "id": "709210103",
                    "speaker": "布洛克",
                    "text": "我可以自豪地说，在蒙德我的肉排绝对是最顶级的。"
                },
                {
                    "id": "709210104",
                    "speaker": "布洛克",
                    "text": "你尝过了吗？如果没尝过的话就来一块吧。"
                },
                {
                    "id": "709210105",
                    "speaker": "布洛克",
                    "text": "别客气，这可是能革新你味觉的美味！"
                }
            ]
        },
        {
            "talkId": "6154101",
            "initDialog": "615410101",
            "dialogues": [
                {
                    "id": "615410101",
                    "speaker": "布洛克",
                    "text": "嗯？被肉的香味吸引而来的么，哼哼。"
                }
            ]
        },
        {
            "talkId": "6154102",
            "initDialog": "615410201",
            "dialogues": [
                {
                    "id": "615410201",
                    "speaker": "Player",
                    "text": "你是谁？"
                },
                {
                    "id": "615410202",
                    "speaker": "布洛克",
                    "text": "你没见过我吗？我叫布洛克，我做的肉类料理在蒙德可是很出名的。"
                }
            ]
        },
        {
            "talkId": "6154103",
            "initDialog": "615410301",
            "dialogues": [
                {
                    "id": "615410301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "615410302",
                    "speaker": "布洛克",
                    "text": "为了得到最最最新鲜的肉，从狩猎到开始料理的过程可是一会儿也不能耽误的。"
                },
                {
                    "id": "615410303",
                    "speaker": "布洛克",
                    "text": "这也是我来到清泉镇定居的原因。"
                },
                {
                    "id": "615410304",
                    "speaker": "布洛克",
                    "text": "经我之手做出来的肉料理，虽然大部分都用来出售了。"
                },
                {
                    "id": "615410305",
                    "speaker": "布洛克",
                    "text": "但一天之中最最最新鲜的那块肉嘛…我一般只留给自己享受。"
                }
            ]
        },
        {
            "talkId": "6154104",
            "initDialog": "615410401",
            "dialogues": [
                {
                    "id": "615410401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615410402",
                    "speaker": "布洛克",
                    "text": "再见，祝你有个好胃口。"
                }
            ]
        },
        {
            "talkId": "6154105",
            "initDialog": "615410501",
            "dialogues": [
                {
                    "id": "615410501",
                    "speaker": "Player",
                    "text": "我想买些吃的可以吗？"
                },
                {
                    "id": "615410502",
                    "speaker": "布洛克",
                    "text": "当然没问题。新鲜的大肉排，这可是蒙德最好的肉类料理。"
                }
            ]
        },
        {
            "talkId": "6154106",
            "initDialog": "615410601",
            "dialogues": [
                {
                    "id": "615410601",
                    "speaker": "Player",
                    "text": "又见面了。"
                },
                {
                    "id": "615410602",
                    "speaker": "布洛克",
                    "text": "你不是那个璃月大厨香菱的助手来着吗？"
                },
                {
                    "id": "615410603",
                    "speaker": "布洛克",
                    "text": "来这里应该不单单只是闲逛吧？莫非是她想要再次挑战「蒙德肉类料理厨艺之王」的我？哼…"
                },
                {
                    "id": "615410604",
                    "speaker": "布洛克",
                    "text": "…唔，好像不对，上次是我输了来着…再挑战我也没什么意义啊…"
                }
            ]
        }
    ]
}