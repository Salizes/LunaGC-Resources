    "talks": [
        {
            "talkId": "6520801",
            "initDialog": "652080101",
            "dialogues": [
                {
                    "id": "652080101",
                    "speaker": "希塞蕾",
                    "text": "不做研究的感觉真不错啊…"
                }
            ]
        },
        {
            "talkId": "6520802",
            "initDialog": "652080201",
            "dialogues": [
                {
                    "id": "652080201",
                    "speaker": "Player",
                    "text": "你是研究员吗？"
                },
                {
                    "id": "652080202",
                    "speaker": "希塞蕾",
                    "text": "我之前是。现在已经不再进行研究工作了，只是在这里帮助雷蒙多先生整理资料和文件。"
                },
                {
                    "id": "652080203",
                    "speaker": "希塞蕾",
                    "text": "现在回头来看，我应该再早一些中断研究工作，让博絮埃这个傻瓜老头自己去写那些干巴巴的论文…反正他也只会做这件事了。"
                }
            ]
        },
        {
            "talkId": "6520803",
            "initDialog": "652080301",
            "dialogues": [
                {
                    "id": "652080301",
                    "speaker": "Player",
                    "text": "你是研究员吗？"
                },
                {
                    "id": "652080302",
                    "speaker": "希塞蕾",
                    "text": "我之前是。在离开博絮埃的项目后，我顶多算是个「荣誉研究员」。当然啦，比不上你这位「荣誉高级研究员」。"
                },
                {
                    "id": "652080303",
                    "speaker": "希塞蕾",
                    "text": "总之，我现在已经不再进行研究工作了，只是在这里帮助雷蒙多先生整理资料和文件。"
                },
                {
                    "id": "652080304",
                    "speaker": "希塞蕾",
                    "text": "现在回头来看，我应该再早一些中断研究工作，让博絮埃这个傻瓜老头自己去写那些干巴巴的论文…反正他也只会做这件事了。"
                }
            ]
        },
        {
            "talkId": "6520804",
            "initDialog": "652080401",
            "dialogues": [
                {
                    "id": "652080401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652080402",
                    "speaker": "希塞蕾",
                    "text": "再见。如果你以后遇见了博絮埃，记得离他远一点。"
                }
            ]
        },
        {
            "talkId": "6520805",
            "initDialog": "652080501",
            "dialogues": [
                {
                    "id": "652080501",
                    "speaker": "Player",
                    "text": "博絮埃是…"
                },
                {
                    "id": "652080502",
                    "speaker": "希塞蕾",
                    "text": "他是一个老眼昏花的老头子、毫无创造力的研究员、自我感觉良好的荣誉衣服架子，和离开手下的研究员就一无是处的论文吸血虫。"
                }
            ]
        },
        {
            "talkId": "6520806",
            "initDialog": "652080601",
            "dialogues": [
                {
                    "id": "652080601",
                    "speaker": "Player",
                    "text": "还、还真是一个特别的人…"
                },
                {
                    "id": "652080602",
                    "speaker": "希塞蕾",
                    "text": "是的。如果我能再早一些认清楚博絮埃的「特别之处」，并且下定决心离开，说不定就不会受那么多苦。"
                },
                {
                    "id": "652080603",
                    "speaker": "希塞蕾",
                    "text": "算了，无论怎么说，我现在已经不再研究了，生活也正在回到正轨。这已经让我很满足了。"
                }
            ]
        }
    ]
}