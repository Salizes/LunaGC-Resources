{
    "groupId": "7539",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "希特罗夫": 7
    },
    "talks": [
        {
            "talkId": "6753901",
            "initDialog": "675390101",
            "dialogues": [
                {
                    "id": "675390101",
                    "speaker": "希特罗夫",
                    "text": "以前我们赚钱哪有现在这么难啊，你们没赶上好时候啊！"
                }
            ]
        },
        {
            "talkId": "6753902",
            "initDialog": "675390201",
            "dialogues": [
                {
                    "id": "675390201",
                    "speaker": "Player",
                    "text": "赚钱的事我得听一听。"
                },
                {
                    "id": "675390202",
                    "speaker": "希特罗夫",
                    "text": "嘿，你是不知道，哥当年也是叱咤北陆的风云人物，做的那都是最来钱的生意。"
                },
                {
                    "id": "675390203",
                    "speaker": "希特罗夫",
                    "text": "至冬的矿石、蒙德的佳酿、须弥的罐装知识，哥当年可都倒腾过。"
                },
                {
                    "id": "675390204",
                    "speaker": "希特罗夫",
                    "text": "做生意嘛，讲究的就是一个信誉。那时候不管是有权有势的大官，还是地下帮派的老大，见了我那都得给足面子。"
                },
                {
                    "id": "675390205",
                    "speaker": "希特罗夫",
                    "text": "不过现在不行啦，那帮愚人众的家伙都太死板，没有咱们老至冬那种办事不拘小节的劲儿。"
                },
                {
                    "id": "675390206",
                    "speaker": "希特罗夫",
                    "text": "所以哥也就正好急流勇退，去远方寻找那什么…人生真谛去咯。"
                }
            ]
        },
        {
            "talkId": "6753903",
            "initDialog": "675390301",
            "dialogues": [
                {
                    "id": "675390301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675390302",
                    "speaker": "希特罗夫",
                    "text": "好，有缘再见。"
                }
            ]
        }
    ]
}