{
    "groupId": "6168",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "帕朗": 9
    },
    "talks": [
        {
            "talkId": "7508750",
            "initDialog": "750875001",
            "dialogues": [
                {
                    "id": "750875001",
                    "speaker": "帕朗",
                    "text": "是你呀，欢迎你来。",
                    "choices": [
                        {
                            "id": "750875002",
                            "text": "最近怎么样？",
                            "response": [
                                {
                                    "id": "750875005",
                                    "speaker": "帕朗",
                                    "text": "没什么变化，工作还是和以前一样多。不过这样也好，有事可干比无所事事好多啦。"
                                },
                                {
                                    "id": "750875008",
                                    "speaker": "帕朗",
                                    "text": "我要是游手好闲四处闲逛，免不了又要被人说三道四，唉…"
                                }
                            ]
                        },
                        {
                            "id": "750875003",
                            "text": "关于葵莉娅…",
                            "response": [
                                {
                                    "id": "750875009",
                                    "speaker": "帕朗",
                                    "text": "没想到她居然是受了豪卡叔叔的委托，想要陷害我拖我下水…"
                                },
                                {
                                    "id": "750875012",
                                    "speaker": "帕朗",
                                    "text": "你大概也听谁说起过吧，我的家族中有不少人被逐出了部族，但我留下来了。"
                                },
                                {
                                    "id": "750875011",
                                    "speaker": "帕朗",
                                    "text": "那些离开部族的人有时会给我捎信，之前豪卡叔叔也给我寄来一封信，说能帮我在圣火竞技场谋一份差事…"
                                },
                                {
                                    "id": "750875010",
                                    "speaker": "帕朗",
                                    "text": "我怎么可能答应呢？还是现在的生活比较适合我。真希望他们能早点放弃，不要再来纠缠我了。"
                                },
                                {
                                    "id": "750875006",
                                    "speaker": "帕朗",
                                    "text": "不过话说回来，他们提供的龙龙饼干品质真的很不错，除了最后那一批…要是在别处也能买到就好了。"
                                }
                            ]
                        },
                        {
                            "id": "750875004",
                            "text": "不打扰了。",
                            "response": [
                                {
                                    "id": "750875007",
                                    "speaker": "帕朗",
                                    "text": "祝你一路顺风。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}