{
    "groupId": "6093",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "伊克娜": 15
    },
    "talks": [
        {
            "talkId": "6609301",
            "initDialog": "660930101",
            "dialogues": [
                {
                    "id": "660930101",
                    "speaker": "伊克娜",
                    "text": "…其名为，「无可匹敌的坚毅狂战士」。"
                }
            ]
        },
        {
            "talkId": "6609302",
            "initDialog": "660930201",
            "dialogues": [
                {
                    "id": "660930201",
                    "speaker": "Player",
                    "text": "啥，啥？"
                },
                {
                    "id": "660930202",
                    "speaker": "伊克娜",
                    "text": "名字，我是说，工具的名字。"
                },
                {
                    "id": "660930203",
                    "speaker": "伊克娜",
                    "text": "「坚毅」是指它的强韧，「狂战士」是指它的力道，而「无可匹敌」，则是它在我心中的地位。"
                },
                {
                    "id": "660930204",
                    "speaker": "伊克娜",
                    "text": "名字在纳塔可是很重要的象征，我最趁手的工具值得一个最响亮的名字。"
                }
            ]
        },
        {
            "talkId": "6609303",
            "initDialog": "660930301",
            "dialogues": [
                {
                    "id": "660930301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660930302",
                    "speaker": "伊克娜",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6609304",
            "initDialog": "660930401",
            "dialogues": [
                {
                    "id": "660930401",
                    "speaker": "Player",
                    "text": "关于名字…"
                },
                {
                    "id": "660930402",
                    "speaker": "伊克娜",
                    "text": "「古名」，听说过吧？"
                },
                {
                    "id": "660930403",
                    "speaker": "伊克娜",
                    "text": "被大灵选中的强大战士，会被授予刻在黑曜石上的「古名」。"
                },
                {
                    "id": "660930404",
                    "speaker": "伊克娜",
                    "text": "这代表了这位战士有能力继承这个名字所包含的所有英雄遗志，继续为纳塔而战。"
                },
                {
                    "id": "660930405",
                    "speaker": "伊克娜",
                    "text": "大灵的眼光不会错，「古名」很珍贵，每个都能找到配得上它的战士。"
                },
                {
                    "id": "660930406",
                    "speaker": "伊克娜",
                    "text": "说起来，你有什么趁手的工具或者武器吗？也给它起个名字吧，它值得。"
                }
            ]
        },
        {
            "talkId": "6609305",
            "initDialog": "660930501",
            "dialogues": [
                {
                    "id": "660930501",
                    "speaker": "伊克娜",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6609306",
            "initDialog": "660930601",
            "dialogues": [
                {
                    "id": "660930601",
                    "speaker": "伊克娜",
                    "text": "很好，就把这套卡组名为「常胜无败的暴君」吧！"
                }
            ]
        },
        {
            "talkId": "6609307",
            "initDialog": "660930701",
            "dialogues": [
                {
                    "id": "660930701",
                    "speaker": "伊克娜",
                    "text": "竟然！唉，看起来需要另为这套卡组取一个名字了…"
                }
            ]
        },
        {
            "talkId": "7590301",
            "initDialog": "759030101",
            "dialogues": [
                {
                    "id": "759030101",
                    "speaker": "Player",
                    "text": "起名叫「最厉害的剑」。"
                },
                {
                    "id": "759030102",
                    "speaker": "伊克娜",
                    "text": "不错，真是简洁却野心十足的名字啊，学到了。"
                },
                {
                    "id": "759030103",
                    "speaker": "伊克娜",
                    "text": "我家里还有柄品质不错的锤子，我还想给它起名「肉龙掌」来着，现在得重新考虑一下了。"
                }
            ]
        }
    ]
}