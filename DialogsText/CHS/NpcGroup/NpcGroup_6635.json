    "talks": [
        {
            "talkId": "6663501",
            "initDialog": "666350101",
            "dialogues": [
                {
                    "id": "666350101",
                    "speaker": "阿霍伊内",
                    "text": "悠悠纳塔，悠悠夏天！欢迎来到浪浪湾，这位客人，要来试试我们的原彩送还大挑战吗？在这边就可以开始。"
                }
            ]
        },
        {
            "talkId": "6663502",
            "initDialog": "666350201",
            "dialogues": [
                {
                    "id": "666350201",
                    "speaker": "阿霍伊内",
                    "text": "恭喜您顺利完成了初级挑战。如果继续游玩的话，会有不止一位龙伙伴参与竞技。"
                }
            ]
        },
        {
            "talkId": "6663503",
            "initDialog": "666350301",
            "dialogues": [
                {
                    "id": "666350301",
                    "speaker": "阿霍伊内",
                    "text": "恭喜您顺利完成了中级挑战。再之后就是有四位龙伙伴一齐上场的最高难度挑战，您要一鼓作气完成吗？"
                }
            ]
        },
        {
            "talkId": "6663504",
            "initDialog": "666350401",
            "dialogues": [
                {
                    "id": "666350401",
                    "speaker": "阿霍伊内",
                    "text": "太厉害了，这位客人，我们准备的奖励都有点配不上您的身手。"
                }
            ]
        }
    ]
}