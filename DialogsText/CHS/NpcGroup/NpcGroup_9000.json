{
    "groupId": "9000",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 17,
        "奥兹": 12,
        "菲谢尔": 35
    },
    "talks": [
        {
            "talkId": "6903102",
            "initDialog": "690310201",
            "dialogues": [
                {
                    "id": "690310201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690310202",
                    "speaker": "菲谢尔",
                    "text": "我尽览三千世界的盛景，通晓过去与未来的殊途。"
                },
                {
                    "id": "690310203",
                    "speaker": "菲谢尔",
                    "text": "此地此景，勉强值得一观吧。",
                    "choices": [
                        {
                            "id": "690310204",
                            "text": "菲谢尔真严格啊。",
                            "response": [
                                {
                                    "id": "690310205",
                                    "speaker": "菲谢尔",
                                    "text": "哼，皇女所领略过的万象，是凡人穷尽一生也无法想象的。"
                                },
                                {
                                    "id": "690310208",
                                    "speaker": "菲谢尔",
                                    "text": "同我的幽夜净土相比，此处不过渺小一粟。"
                                },
                                {
                                    "id": "690310209",
                                    "speaker": "奥兹",
                                    "text": "可之前小姐还说，想多在这里待一会儿的。"
                                },
                                {
                                    "id": "690310210",
                                    "speaker": "菲谢尔",
                                    "text": "#那…那只是对{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}同为异世界之人的惦念罢了！"
                                }
                            ]
                        },
                        {
                            "id": "690310206",
                            "text": "菲谢尔喜欢就好。",
                            "response": [
                                {
                                    "id": "690310207",
                                    "speaker": "菲谢尔",
                                    "text": "哼，也就较那凡尘俗世略为清净罢了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903103",
            "initDialog": "690310301",
            "dialogues": [
                {
                    "id": "690310301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690310302",
                    "speaker": "菲谢尔",
                    "text": "那时间的步履已被我擒住，那命运的窥探已被我遮蔽。"
                },
                {
                    "id": "690310303",
                    "speaker": "菲谢尔",
                    "text": "异界之旅人啊，就让至高无上的皇女来裁断你心中的孽扰吧！"
                },
                {
                    "id": "690310304",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，现在她正好有空。"
                },
                {
                    "id": "690310305",
                    "speaker": "奥兹",
                    "text": "如果有什么烦心事，她很乐意倾听。"
                },
                {
                    "id": "690310306",
                    "speaker": "Player",
                    "text": "我其实想知道皇女殿下会不会有什么烦恼。"
                },
                {
                    "id": "690310307",
                    "speaker": "菲谢尔",
                    "text": "愚谬！吾乃断罪之皇女，凡间情愫何至于将我之心灵污扰？"
                },
                {
                    "id": "690310308",
                    "speaker": "奥兹",
                    "text": "在我外出侦察的时候，冒险家协会的新人不是因为会错了小姐的意，惹出了不小的笑话吗？"
                },
                {
                    "id": "690310309",
                    "speaker": "奥兹",
                    "text": "我记得小姐还为此苦恼过。"
                },
                {
                    "id": "690310310",
                    "speaker": "菲谢尔",
                    "text": "胡…胡言！本皇女岂会为区区扈从所扰？"
                },
                {
                    "id": "690310311",
                    "speaker": "菲谢尔",
                    "text": "我只不过在嗟叹，那些年轻的扈从，不似这位被命运之丝引至我身前的异界旅人…"
                },
                {
                    "id": "690310312",
                    "speaker": "菲谢尔",
                    "text": "能将吾之旨谕了然于心。",
                    "choices": [
                        {
                            "id": "690310313",
                            "text": "皇女过誉了。",
                            "response": [
                                {
                                    "id": "690310315",
                                    "speaker": "菲谢尔",
                                    "text": "嗯，错不了…"
                                },
                                {
                                    "id": "690310316",
                                    "speaker": "菲谢尔",
                                    "text": "本皇女心意已定，若再遇奥兹代我外出巡视，就恩许你与我同行。"
                                },
                                {
                                    "id": "690310317",
                                    "speaker": "菲谢尔",
                                    "text": "就由你，来向扈从们传达吾之意旨吧！"
                                },
                                {
                                    "id": "690310318",
                                    "speaker": "奥兹",
                                    "text": "坦白说，我也觉得这是个好主意。"
                                },
                                {
                                    "id": "690310319",
                                    "speaker": "Player",
                                    "text": "万一我没理解对…"
                                },
                                {
                                    "id": "690310320",
                                    "speaker": "菲谢尔",
                                    "text": "毋需烦忧。你为本皇女钦选之人，尽管向世人昭告吾之尊意吧！"
                                },
                                {
                                    "id": "690310321",
                                    "speaker": "Player",
                                    "text": "既然你们都这么说了…"
                                },
                                {
                                    "id": "690310322",
                                    "speaker": "菲谢尔",
                                    "text": "一言既定。"
                                },
                                {
                                    "id": "690310323",
                                    "speaker": "菲谢尔",
                                    "text": "庆贺吧！在吾至圣光耀之下，那恣肆的邪恶云翳就此消散！"
                                }
                            ]
                        },
                        {
                            "id": "690310314",
                            "text": "能够理解皇女是我的荣幸。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903104",
            "initDialog": "690310401",
            "dialogues": [
                {
                    "id": "690310401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690310402",
                    "speaker": "菲谢尔",
                    "text": "自高天陨落的星辰，是昭告终末之刻的沙漏。"
                },
                {
                    "id": "690310403",
                    "speaker": "菲谢尔",
                    "text": "地心中暗涌的震颤，是古神心脏垂死的残响。"
                },
                {
                    "id": "690310404",
                    "speaker": "菲谢尔",
                    "text": "难道本皇女终将独自一人迎来这世间孤寂的终篇吗？"
                },
                {
                    "id": "690310405",
                    "speaker": "菲谢尔",
                    "text": "祝圣之人啊…"
                },
                {
                    "id": "690310406",
                    "speaker": "菲谢尔",
                    "text": "你…你愿伴随本皇女见证这世间万象的终焉，迎候那永世幽夜的降临吗？"
                },
                {
                    "id": "690310407",
                    "speaker": "奥兹",
                    "text": "小姐的意思是…"
                },
                {
                    "id": "690310408",
                    "speaker": "菲谢尔",
                    "text": "奥…奥兹！",
                    "choices": [
                        {
                            "id": "690310409",
                            "text": "没事，我能听懂…",
                            "response": [
                                {
                                    "id": "690310411",
                                    "speaker": "菲谢尔",
                                    "text": "欸…欸？你说的是真的吗…"
                                },
                                {
                                    "id": "690310412",
                                    "speaker": "奥兹",
                                    "text": "小…小姐…"
                                },
                                {
                                    "id": "690310413",
                                    "speaker": "菲谢尔",
                                    "text": "啊！咳咳…！"
                                },
                                {
                                    "id": "690310414",
                                    "speaker": "菲谢尔",
                                    "text": "如此甚好，就让我以祝圣的荣辉，光耀你命运的旅途吧！"
                                },
                                {
                                    "id": "690310415",
                                    "speaker": "菲谢尔",
                                    "text": "我，菲谢尔·冯·露弗施洛斯·那菲多特…"
                                },
                                {
                                    "id": "690310416",
                                    "speaker": "菲谢尔",
                                    "text": "将携夜之眷属奥兹华尔多·赫芙那梵茵斯，守护你的前路。正如命运的默示录所昭告的那般！"
                                }
                            ]
                        },
                        {
                            "id": "690310410",
                            "text": "愿随皇女左右。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903105",
            "initDialog": "690310501",
            "dialogues": [
                {
                    "id": "690310501",
                    "speaker": "Player",
                    "text": "早啊，菲谢尔。"
                },
                {
                    "id": "690310502",
                    "speaker": "菲谢尔",
                    "text": "你我命运的虚影于这圣洁的光耀下交织，若是前路有黑暗相阻，便尽可呼唤吾之尊名。"
                },
                {
                    "id": "690310503",
                    "speaker": "奥兹",
                    "text": "小姐说，早，今天阳光不错，遇到困难就尽管叫她。"
                }
            ]
        },
        {
            "talkId": "6903106",
            "initDialog": "690310601",
            "dialogues": [
                {
                    "id": "690310601",
                    "speaker": "Player",
                    "text": "晚安，菲谢尔。"
                },
                {
                    "id": "690310602",
                    "speaker": "菲谢尔",
                    "text": "赞颂吧！此方净土亦受吾之祝圣，谁人都无法侵扰你的安眠。"
                },
                {
                    "id": "690310603",
                    "speaker": "奥兹",
                    "text": "小姐说，晚安，做个好梦。"
                }
            ]
        },
        {
            "talkId": "6903107",
            "initDialog": "690310701",
            "dialogues": [
                {
                    "id": "690310701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903108",
            "initDialog": "690310801",
            "dialogues": [
                {
                    "id": "690310801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903109",
            "initDialog": "690310901",
            "dialogues": [
                {
                    "id": "690310901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903150",
            "initDialog": "690315001",
            "dialogues": [
                {
                    "id": "690315001",
                    "speaker": "菲谢尔",
                    "text": "何等愉快！"
                },
                {
                    "id": "690315002",
                    "speaker": "菲谢尔",
                    "text": "司书魔女的宝库之外，竟有如此一隅，值得本皇女长久驻足，为祝圣之仪召集七成的伟力。"
                },
                {
                    "id": "690315003",
                    "speaker": "奥兹",
                    "text": "小姐的意思是，这里让她感兴趣的书籍，已经有七成之多了。"
                }
            ]
        },
        {
            "talkId": "6903151",
            "initDialog": "690315101",
            "dialogues": [
                {
                    "id": "690315101",
                    "speaker": "菲谢尔",
                    "text": "哈哈哈！你为探求高天与渊月所倾注的心血，已被本皇女见证。"
                },
                {
                    "id": "690315102",
                    "speaker": "菲谢尔",
                    "text": "不倦跋涉的旅人哟，务必为这乐土打上更为热忱的烙印。"
                },
                {
                    "id": "690315103",
                    "speaker": "奥兹",
                    "text": "小姐说，她很喜欢冒险家风格的营地，这种建筑多多益善。"
                }
            ]
        }
    ]
}