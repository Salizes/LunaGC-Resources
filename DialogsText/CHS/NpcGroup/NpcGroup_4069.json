            "dialogues": [
                {
                    "id": "640690101",
                    "speaker": "尤努斯",
                    "text": "你好，找我有事？"
                }
            ]
        },
        {
            "talkId": "6406902",
            "initDialog": "640690201",
            "dialogues": [
                {
                    "id": "640690201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640690202",
                    "speaker": "尤努斯",
                    "text": "我是聚砂厅的后勤官，负责分配「三十人团」的军用物资。"
                },
                {
                    "id": "640690203",
                    "speaker": "尤努斯",
                    "text": "除了教令院的任务需要之外，也会分一部分给阿芬迪先生。"
                },
                {
                    "id": "640690204",
                    "speaker": "尤努斯",
                    "text": "如果有人帮助了团里或者附近的居民，就可以用那部分物资来付报酬了。"
                }
            ]
        },
        {
            "talkId": "6406903",
            "initDialog": "640690301",
            "dialogues": [
                {
                    "id": "640690301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640690302",
                    "speaker": "尤努斯",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6406904",
            "initDialog": "640690401",
            "dialogues": [
                {
                    "id": "640690401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6406905",
            "initDialog": "640690501",
            "dialogues": [
                {
                    "id": "640690501",
                    "speaker": "尤努斯",
                    "text": "了不起的得胜方式，还挺有启发的…"
                }
            ]
        },
        {
            "talkId": "6406906",
            "initDialog": "640690601",
            "dialogues": [
                {
                    "id": "640690601",
                    "speaker": "尤努斯",
                    "text": "赢了，嗯…这种牌局，也是一种考验资源分配的试验啊…"
                }
            ]
        }
    ]
