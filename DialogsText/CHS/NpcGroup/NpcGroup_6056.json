    },
    "talks": [
        {
            "talkId": "6605601",
            "initDialog": "660560101",
            "dialogues": [
                {
                    "id": "660560101",
                    "speaker": "马努阿",
                    "text": "今天的提案都不算太离谱呢。"
                }
            ]
        },
        {
            "talkId": "6605602",
            "initDialog": "660560201",
            "dialogues": [
                {
                    "id": "660560201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "660560202",
                    "speaker": "马努阿",
                    "text": "你好你好，我是首领助理，阿米娜没有给你添麻烦吧？"
                },
                {
                    "id": "660560203",
                    "speaker": "马努阿",
                    "text": "不要误会，阿米娜很可靠，以前也跟着她爷爷学过很多管理部族的方法，我很信任她的潜力。"
                },
                {
                    "id": "660560204",
                    "speaker": "马努阿",
                    "text": "不过小孩子难免有不够细心的地方，请你多担待啦。"
                }
            ]
        },
        {
            "talkId": "6605603",
            "initDialog": "660560301",
            "dialogues": [
                {
                    "id": "660560301",
                    "speaker": "Player",
                    "text": "什么提案？"
                },
                {
                    "id": "660560302",
                    "speaker": "马努阿",
                    "text": "是首领大人阿米娜想的娱乐设施改造方案。"
                },
                {
                    "id": "660560303",
                    "speaker": "马努阿",
                    "text": "很奇怪吗，部族首领会向我提方案？"
                },
                {
                    "id": "660560304",
                    "speaker": "马努阿",
                    "text": "嗨，因为我是助理嘛。"
                },
                {
                    "id": "660560305",
                    "speaker": "马努阿",
                    "text": "阿米娜很聪明，会提出一些非常新颖的想法，比如建设激流赛道、办划艇大奖赛之类的。"
                },
                {
                    "id": "660560306",
                    "speaker": "马努阿",
                    "text": "哈哈，虽然很多可能只是她自己想玩罢了，但的确很受游客欢迎，我们理应全力支持。"
                }
            ]
        },
        {
            "talkId": "6605604",
            "initDialog": "660560401",
            "dialogues": [
                {
                    "id": "660560401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660560402",
                    "speaker": "马努阿",
                    "text": "再见，祝你玩得愉快。"
                }
            ]
        },
        {
            "talkId": "6605605",
            "initDialog": "660560501",
            "dialogues": [
                {
                    "id": "660560501",
                    "speaker": "Player",
                    "text": "什么提案？"
                },
                {
                    "id": "660560502",
                    "speaker": "马努阿",
                    "text": "是首领大人阿米娜想的备战和防护设施改造方案，以及人手调配的计划。"
                },
                {
                    "id": "660560503",
                    "speaker": "马努阿",
                    "text": "很奇怪吗，部族首领会向我提方案？"
                },
                {
                    "id": "660560504",
                    "speaker": "马努阿",
                    "text": "嗨，因为我是助理嘛。"
                },
                {
                    "id": "660560505",
                    "speaker": "马努阿",
                    "text": "阿米娜很聪明，以前总是会提出一些非常新颖的想法，不过大多都是她自己想玩的娱乐设施。"
                },
                {
                    "id": "660560506",
                    "speaker": "马努阿",
                    "text": "最近深渊入侵严重，我看她的玩心也收了不少。流泉之众算是受损较小的地方，但总有其他需要帮助的伙伴嘛。"
                }
            ]
        }
    ]
}