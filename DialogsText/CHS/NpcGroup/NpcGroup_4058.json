{
    "groupId": "4058",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "阿夫辛": 10
    },
    "talks": [
        {
            "talkId": "6405801",
            "initDialog": "640580101",
            "dialogues": [
                {
                    "id": "640580101",
                    "speaker": "阿夫辛",
                    "text": "我这有些好商品，还有些好故事，客人若有兴趣，不妨听我一叙。"
                }
            ]
        },
        {
            "talkId": "6405802",
            "initDialog": "640580201",
            "dialogues": [
                {
                    "id": "640580201",
                    "speaker": "Player",
                    "text": "看看。"
                },
                {
                    "id": "640580202",
                    "speaker": "阿夫辛",
                    "text": "仅靠眼睛很难看出商品的真实价值…所以只能给你看这些了。"
                }
            ]
        },
        {
            "talkId": "6405803",
            "initDialog": "640580301",
            "dialogues": [
                {
                    "id": "640580301",
                    "speaker": "Player",
                    "text": "听听。"
                },
                {
                    "id": "640580302",
                    "speaker": "阿夫辛",
                    "text": "傲然立于璃月山巅的花朵，在高空的寒风中飘摇，一如触碰过它的神女身后苍白的发丝…"
                },
                {
                    "id": "640580303",
                    "speaker": "阿夫辛",
                    "text": "此等不俗之物，仅售八万摩拉。"
                },
                {
                    "id": "640580304",
                    "speaker": "阿夫辛",
                    "text": "历经百年的酒坛，聆听过风神轻声哼唱的歌谣，喝了它，你也能随口唱出动人的诗篇…"
                },
                {
                    "id": "640580305",
                    "speaker": "阿夫辛",
                    "text": "如此神奇之物，仅售二十万摩拉。"
                }
            ]
        },
        {
            "talkId": "6405804",
            "initDialog": "640580401",
            "dialogues": [
                {
                    "id": "640580401",
                    "speaker": "Player",
                    "text": "走了。"
                },
                {
                    "id": "640580402",
                    "speaker": "阿夫辛",
                    "text": "真遗憾。"
                }
            ]
        },
        {
            "talkId": "7393601",
            "initDialog": "739360101",
            "dialogues": [
                {
                    "id": "739360101",
                    "speaker": "Player",
                    "text": "有点耳熟，又有点不同…"
                },
                {
                    "id": "739360102",
                    "speaker": "阿夫辛",
                    "text": "噢哟，听起来有些不信我啊…"
                },
                {
                    "id": "739360103",
                    "speaker": "阿夫辛",
                    "text": "那这件商品请您拿去，再多多体会一下其中的真谛吧。"
                },
                {
                    "id": "739360104",
                    "speaker": "阿夫辛",
                    "text": "无妨，在我那丰富的存货之中，这只是一件小小的纪念品罢了。"
                }
            ]
        }
    ]
}