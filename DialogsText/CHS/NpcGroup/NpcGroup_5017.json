{
    "groupId": "5017",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 7,
        "波蒂埃": 18
    },
    "talks": [
        {
            "talkId": "6501701",
            "initDialog": "650170101",
            "dialogues": [
                {
                    "id": "650170101",
                    "speaker": "波蒂埃",
                    "text": "~♪水光鳞澜，鱼儿跃；浪花声声，唱晚眠。♪~"
                },
                {
                    "id": "650170102",
                    "speaker": "波蒂埃",
                    "text": "~♪思乡的人儿轻捧沙；贝壳载泪先归家。♪~"
                }
            ]
        },
        {
            "talkId": "6501702",
            "initDialog": "650170201",
            "dialogues": [
                {
                    "id": "650170201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "650170202",
                    "speaker": "波蒂埃",
                    "text": "你好，美丽优雅又可爱的人♪~！"
                },
                {
                    "id": "650170203",
                    "speaker": "波蒂埃",
                    "text": "我叫波蒂埃，一位街头艺人。多才多艺，无所不能。"
                }
            ]
        },
        {
            "talkId": "6501703",
            "initDialog": "650170301",
            "dialogues": [
                {
                    "id": "650170301",
                    "speaker": "Player",
                    "text": "（静静欣赏…）"
                },
                {
                    "id": "650170302",
                    "speaker": "波蒂埃",
                    "text": "♪~"
                }
            ]
        },
        {
            "talkId": "6501704",
            "initDialog": "650170401",
            "dialogues": [
                {
                    "id": "650170401",
                    "speaker": "Player",
                    "text": "你还会些什么？"
                },
                {
                    "id": "650170402",
                    "speaker": "波蒂埃",
                    "text": "演戏、歌剧、弹琴…甚至魔术我也会。"
                },
                {
                    "id": "650170403",
                    "speaker": "波蒂埃",
                    "text": "艺术家嘛，得与时俱进，无论什么技能都得会一点。"
                },
                {
                    "id": "650170404",
                    "speaker": "波蒂埃",
                    "text": "有朝一日，希望我也能去那个歌剧院为人们演上一段。啊，当然不是说庭审那种。"
                }
            ]
        },
        {
            "talkId": "6501705",
            "initDialog": "650170501",
            "dialogues": [
                {
                    "id": "650170501",
                    "speaker": "波蒂埃",
                    "text": "需要开锁换锁吗？"
                }
            ]
        },
        {
            "talkId": "6501706",
            "initDialog": "650170601",
            "dialogues": [
                {
                    "id": "650170601",
                    "speaker": "Player",
                    "text": "你好像有点眼熟…"
                },
                {
                    "id": "650170602",
                    "speaker": "波蒂埃",
                    "text": "哦，那客人一定是白天见过我在街头弹琴唱歌了。"
                },
                {
                    "id": "650170603",
                    "speaker": "波蒂埃",
                    "text": "「水光鳞澜，鱼儿跃~」怎么样，是不是有印象了？"
                },
                {
                    "id": "650170604",
                    "speaker": "波蒂埃",
                    "text": "我知道你在想什么：「这人怎么什么都会啊？」"
                },
                {
                    "id": "650170605",
                    "speaker": "波蒂埃",
                    "text": "嘿嘿，技多不压身，都是小把戏，小把戏。能赚一点是一点。"
                }
            ]
        },
        {
            "talkId": "6501707",
            "initDialog": "650170701",
            "dialogues": [
                {
                    "id": "650170701",
                    "speaker": "Player",
                    "text": "这生意晚上做？"
                },
                {
                    "id": "650170702",
                    "speaker": "波蒂埃",
                    "text": "那当然，大家不都是晚上回到家才发现自己早上忘带钥匙了嘛。"
                },
                {
                    "id": "650170703",
                    "speaker": "波蒂埃",
                    "text": "哦，我明白了，你觉得我可能在做那种见不得人的生意对吧？"
                },
                {
                    "id": "650170704",
                    "speaker": "波蒂埃",
                    "text": "放心放心，我自有原则和分寸，我也不想在「庭审」时进入歌剧院表演嘛。"
                }
            ]
        },
        {
            "talkId": "6501708",
            "initDialog": "650170801",
            "dialogues": [
                {
                    "id": "650170801",
                    "speaker": "Player",
                    "text": "不用了，谢谢。"
                },
                {
                    "id": "650170802",
                    "speaker": "波蒂埃",
                    "text": "不客气，有需要随时招呼我。"
                }
            ]
        },
        {
            "talkId": "7492301",
            "initDialog": "749230101",
            "dialogues": [
                {
                    "id": "749230101",
                    "speaker": "Player",
                    "text": "唱得不错。"
                },
                {
                    "id": "749230102",
                    "speaker": "波蒂埃",
                    "text": "多谢您的捧场！人生总有离别时，愿我的歌声伴您在枫丹度过美好的一天。"
                }
            ]
        }
    ]
}