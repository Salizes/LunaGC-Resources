{
    "groupId": "2418",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "小雀儿": 14
    },
    "talks": [
        {
            "talkId": "6241805",
            "initDialog": "624180501",
            "dialogues": [
                {
                    "id": "624180501",
                    "speaker": "小雀儿",
                    "text": "呜…师兄…"
                },
                {
                    "id": "624180502",
                    "speaker": "小雀儿",
                    "text": "古华派，古华派，你眼里就从来没有我…呜…"
                }
            ]
        },
        {
            "talkId": "6241801",
            "initDialog": "624180101",
            "dialogues": [
                {
                    "id": "624180101",
                    "speaker": "小雀儿",
                    "text": "你是谁？我和你很熟吗！"
                }
            ]
        },
        {
            "talkId": "6241802",
            "initDialog": "624180201",
            "dialogues": [
                {
                    "id": "624180201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "624180202",
                    "speaker": "小雀儿",
                    "text": "我是谁与你何干！你怕不是山里的妖物，化成人形迷惑我二人的！"
                }
            ]
        },
        {
            "talkId": "6241803",
            "initDialog": "624180301",
            "dialogues": [
                {
                    "id": "624180301",
                    "speaker": "Player",
                    "text": "我…"
                },
                {
                    "id": "624180302",
                    "speaker": "小雀儿",
                    "text": "我？我什么我？我就知道你不是好人！"
                },
                {
                    "id": "624180303",
                    "speaker": "小雀儿",
                    "text": "要不是当着师兄的面，我早就一剑刺得你元神出窍了！"
                },
                {
                    "id": "624180304",
                    "speaker": "Player",
                    "text": "师兄…？"
                },
                {
                    "id": "624180305",
                    "speaker": "小雀儿",
                    "text": "师兄？我师兄是你叫的吗！"
                },
                {
                    "id": "624180306",
                    "speaker": "小雀儿",
                    "text": "我们二人今日来找仙人讨教复兴古华派的良方，我劝你别挡我们的路！"
                },
                {
                    "id": "624180307",
                    "speaker": "小雀儿",
                    "text": "更别想打我师兄的主意！"
                },
                {
                    "id": "624180308",
                    "speaker": "Player",
                    "text": "古华派？"
                },
                {
                    "id": "624180309",
                    "speaker": "小雀儿",
                    "text": "古华派，古华派怎么了？"
                },
                {
                    "id": "624180310",
                    "speaker": "小雀儿",
                    "text": "哼…师兄也是，古华派，古华派，天天只知道古华派…"
                },
                {
                    "id": "624180311",
                    "speaker": "小雀儿",
                    "text": "也不看看这破武馆除了我俩还有几个人了…"
                },
                {
                    "id": "624180312",
                    "speaker": "小雀儿",
                    "text": "要是能把这心思…哪怕一分两分放在我身上也好啊…"
                }
            ]
        },
        {
            "talkId": "6241804",
            "initDialog": "624180401",
            "dialogues": [
                {
                    "id": "624180401",
                    "speaker": "Player",
                    "text": "…再见。"
                },
                {
                    "id": "624180402",
                    "speaker": "小雀儿",
                    "text": "别来碍手碍脚，打扰我们两个，哼！"
                }
            ]
        }
    ]
}