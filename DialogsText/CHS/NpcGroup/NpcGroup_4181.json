        {
            "talkId": "6418101",
            "initDialog": "641810101",
            "dialogues": [
                {
                    "id": "641810101",
                    "speaker": "兰沙恭",
                    "text": "只要有「勇气」，不管来多少「毛毛脸面具怪兽」，兰沙恭都不会害怕啦！我不会让它们再偷走「勇气」！"
                }
            ]
        },
        {
            "talkId": "6418102",
            "initDialog": "641810201",
            "dialogues": [
                {
                    "id": "641810201",
                    "speaker": "Player",
                    "text": "其实勇气是偷不走的…"
                },
                {
                    "id": "641810202",
                    "speaker": "兰沙恭",
                    "text": "？"
                },
                {
                    "id": "641810203",
                    "speaker": "兰沙恭",
                    "text": "但是，「勇气」被偷走以后，我就手软软脚软软了…"
                }
            ]
        },
        {
            "talkId": "6418103",
            "initDialog": "641810301",
            "dialogues": [
                {
                    "id": "641810301",
                    "speaker": "Player",
                    "text": "嗯，要小心保存…"
                },
                {
                    "id": "641810302",
                    "speaker": "兰沙恭",
                    "text": "我会的！"
                }
            ]
        },
        {
            "talkId": "6418104",
            "initDialog": "641810401",
            "dialogues": [
                {
                    "id": "641810401",
                    "speaker": "Player",
                    "text": "勇气在兰沙恭心里…"
                },
                {
                    "id": "641810402",
                    "speaker": "兰沙恭",
                    "text": "#唔，那菈{NICKNAME}说的话，有点难懂…"
                }
            ]
        }
    ]
}