{
    "groupId": "5346",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 7,
        "戈伦德兰": 22
    },
    "talks": [
        {
            "talkId": "6534601",
            "initDialog": "653460101",
            "dialogues": [
                {
                    "id": "653460101",
                    "speaker": "戈伦德兰",
                    "text": "神王保佑，目前一切都在规划之内。"
                }
            ]
        },
        {
            "talkId": "6534602",
            "initDialog": "653460201",
            "dialogues": [
                {
                    "id": "653460201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "653460202",
                    "speaker": "戈伦德兰",
                    "text": "唔？这里怎么会有外来者？难不成，您是来朝圣的人？"
                },
                {
                    "id": "653460203",
                    "speaker": "戈伦德兰",
                    "text": "也难怪，雷穆利亚的伟迹，的确值得众人景仰。"
                },
                {
                    "id": "653460204",
                    "speaker": "戈伦德兰",
                    "text": "而且，既然神王恩准您沐浴他的光辉，那我也没有什么意见。"
                }
            ]
        },
        {
            "talkId": "6534603",
            "initDialog": "653460301",
            "dialogues": [
                {
                    "id": "653460301",
                    "speaker": "Player",
                    "text": "你提到的规划…"
                },
                {
                    "id": "653460302",
                    "speaker": "戈伦德兰",
                    "text": "那个啊。我正在做研究院来年的研究工作规划呢，事务很多，但托神王的光辉赐福，我们有许多聪明人能承担重任。"
                },
                {
                    "id": "653460303",
                    "speaker": "戈伦德兰",
                    "text": "神王在上，能够被赋予如此光荣的使命，真是再幸福不过了。"
                }
            ]
        },
        {
            "talkId": "6534604",
            "initDialog": "653460401",
            "dialogues": [
                {
                    "id": "653460401",
                    "speaker": "戈伦德兰",
                    "text": "相信我，这毫无疑问是一场双赢的合作。"
                }
            ]
        },
        {
            "talkId": "6534605",
            "initDialog": "653460501",
            "dialogues": [
                {
                    "id": "653460501",
                    "speaker": "Player",
                    "text": "你还在计划什么合作？"
                },
                {
                    "id": "653460502",
                    "speaker": "戈伦德兰",
                    "text": "我…唉，我想要给那几位先生的「空想俱乐部」投资，但他们却一直拒绝我！"
                },
                {
                    "id": "653460503",
                    "speaker": "戈伦德兰",
                    "text": "特别是加尔恰先生，我无论说什么，发什么誓他都不信，还让我快点离开！"
                },
                {
                    "id": "653460504",
                    "speaker": "戈伦德兰",
                    "text": "他们误会我了啊！我、我之前确实…是那个样子，但我现在已经变了，洗心革面！只想为他们的研究事业提供支持！"
                }
            ]
        },
        {
            "talkId": "6534606",
            "initDialog": "653460601",
            "dialogues": [
                {
                    "id": "653460601",
                    "speaker": "Player",
                    "text": "说实话，我也不信…"
                },
                {
                    "id": "653460602",
                    "speaker": "戈伦德兰",
                    "text": "您…好吧，一个坏心肠的人突然变好，说着要做好事，就像是毒蛇突然张开嘴，露着毒牙向人问好一样，的确不值得相信。"
                },
                {
                    "id": "653460603",
                    "speaker": "戈伦德兰",
                    "text": "还好梅康顿和巴比斯先生答应我，可以让我在这里暂住…我也答应了他们，会为他们的超级大炮工程提供资金支援。"
                },
                {
                    "id": "653460604",
                    "speaker": "戈伦德兰",
                    "text": "也许，只有做出些能看得见的行动，才能证明我真的不打算做坏事吧…"
                },
                {
                    "id": "653460605",
                    "speaker": "戈伦德兰",
                    "text": "但是，他们的超级大炮计划真的很有吸引力！"
                },
                {
                    "id": "653460606",
                    "speaker": "戈伦德兰",
                    "text": "就算暂时做不出来，只要借助这个工程的名头，也绝对能吸引不少人过来投资。"
                },
                {
                    "id": "653460607",
                    "speaker": "戈伦德兰",
                    "text": "到时候只要稍作运作…"
                }
            ]
        },
        {
            "talkId": "6534607",
            "initDialog": "653460701",
            "dialogues": [
                {
                    "id": "653460701",
                    "speaker": "Player",
                    "text": "咳，咳！"
                },
                {
                    "id": "653460702",
                    "speaker": "戈伦德兰",
                    "text": "呃…我、我是说…只要稍加运作，就能…吸引到不少投资者，和志同道合的研究者…"
                },
                {
                    "id": "653460703",
                    "speaker": "戈伦德兰",
                    "text": "人、人多力量大嘛，有这么多支持者，超级大炮工程何愁不成啊？"
                }
            ]
        },
        {
            "talkId": "6534608",
            "initDialog": "653460801",
            "dialogues": [
                {
                    "id": "653460801",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "653460802",
                    "speaker": "戈伦德兰",
                    "text": "唉，您慢走…"
                }
            ]
        },
        {
            "talkId": "6534609",
            "initDialog": "653460901",
            "dialogues": [
                {
                    "id": "653460901",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "653460902",
                    "speaker": "戈伦德兰",
                    "text": "再见。请您慢走。"
                }
            ]
        },
        {
            "talkId": "6534610",
            "initDialog": "653461001",
            "dialogues": [
                {
                    "id": "653461001",
                    "speaker": "戈伦德兰",
                    "text": "我真是无药可救…为什么我之前…天哪…我之前做出了那种事…"
                },
                {
                    "id": "653461002",
                    "speaker": "戈伦德兰",
                    "text": "我就像那个人一样，想捏着别人的心弦，只让他们听自己号令，不…不不不…"
                }
            ]
        }
    ]
}