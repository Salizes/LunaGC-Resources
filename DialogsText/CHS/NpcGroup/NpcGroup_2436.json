{
    "groupId": "2436",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "钱眼儿": 9
    },
    "talks": [
        {
            "talkId": "6243601",
            "initDialog": "624360101",
            "dialogues": [
                {
                    "id": "624360101",
                    "speaker": "钱眼儿",
                    "text": "真不愧是北斗大姐头，这次又是满载而归。"
                }
            ]
        },
        {
            "talkId": "6243602",
            "initDialog": "624360201",
            "dialogues": [
                {
                    "id": "624360201",
                    "speaker": "Player",
                    "text": "你好像很高兴？"
                },
                {
                    "id": "624360202",
                    "speaker": "钱眼儿",
                    "text": "当然开心，这次出海可赚了不少！"
                },
                {
                    "id": "624360203",
                    "speaker": "钱眼儿",
                    "text": "其实和大多数人印象里的情况不同，船队出海一无所获才是常态…"
                },
                {
                    "id": "624360204",
                    "speaker": "钱眼儿",
                    "text": "…我们船队算是特例，空手而归的情况几乎没有…这都要归功于北斗姐的英明指挥啊。"
                }
            ]
        },
        {
            "talkId": "6243603",
            "initDialog": "624360301",
            "dialogues": [
                {
                    "id": "624360301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624360302",
                    "speaker": "钱眼儿",
                    "text": "嘿嘿，祝你财运亨通。"
                }
            ]
        },
        {
            "talkId": "6243604",
            "initDialog": "624360401",
            "dialogues": [
                {
                    "id": "624360401",
                    "speaker": "Player",
                    "text": "分了钱之后你打算干什么？"
                },
                {
                    "id": "624360402",
                    "speaker": "钱眼儿",
                    "text": "怎么说呢，我只是比较喜欢赚钱的过程，至于赚到的钱要怎么花就没考虑过了。"
                },
                {
                    "id": "624360403",
                    "speaker": "钱眼儿",
                    "text": "…也许会拿去买一百份中原杂碎，然后请大家一起吃吧…谁知道呢。"
                },
                {
                    "id": "624360404",
                    "speaker": "钱眼儿",
                    "text": "有些人总是觉得结果大于一切，但仔细想想，假如「活着」这件事也只看结果的话，那一切还有什么意义呢？"
                },
                {
                    "id": "624360405",
                    "speaker": "钱眼儿",
                    "text": "总之，只是看结果的话，可能会错过很多东西哦。"
                }
            ]
        }
    ]
}