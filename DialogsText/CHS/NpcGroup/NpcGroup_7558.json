    "talks": [
        {
            "talkId": "6755801",
            "initDialog": "675580101",
            "dialogues": [
                {
                    "id": "675580101",
                    "speaker": "？？？",
                    "text": "阿贾克斯哥哥没给大家造成麻烦吧…"
                }
            ]
        },
        {
            "talkId": "6755802",
            "initDialog": "675580201",
            "dialogues": [
                {
                    "id": "675580201",
                    "speaker": "Player",
                    "text": "在担心「公子」吗…"
                },
                {
                    "id": "675580202",
                    "speaker": "？？？",
                    "text": "担心他？与其说是担心他，不如说是怕他又在哪里惹了什么麻烦…"
                },
                {
                    "id": "675580203",
                    "speaker": "？？？",
                    "text": "他以前在村子就到处打架…爸爸就是因为这个才不让他待在村子里的。"
                }
            ]
        },
        {
            "talkId": "6755803",
            "initDialog": "675580301",
            "dialogues": [
                {
                    "id": "675580301",
                    "speaker": "Player",
                    "text": "关于家人…"
                },
                {
                    "id": "675580302",
                    "speaker": "？？？",
                    "text": "托阿贾克斯哥哥到处帮忙找药，父亲的头疼已经好了很多了…"
                },
                {
                    "id": "675580303",
                    "speaker": "？？？",
                    "text": "三位哥哥里，就阿贾克斯哥哥天天不回家！每次答应要带我和托克玩，十有八九都爽约！"
                },
                {
                    "id": "675580304",
                    "speaker": "？？？",
                    "text": "不过，只要他还愿意带我们一起玩就好。"
                },
                {
                    "id": "675580305",
                    "speaker": "？？？",
                    "text": "总觉得，要是没有我们牵着他的手，他就会一下子跑到谁都找不到的地方去了。"
                }
            ]
        },
        {
            "talkId": "6755804",
            "initDialog": "675580401",
            "dialogues": [
                {
                    "id": "675580401",
                    "speaker": "Player",
                    "text": "下次再见。"
                },
                {
                    "id": "675580402",
                    "speaker": "？？？",
                    "text": "再见！"
                }
            ]
        },
