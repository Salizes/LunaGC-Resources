{
    "groupId": "7640",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "乌利亚娜": 10
    },
    "talks": [
        {
            "talkId": "6764001",
            "initDialog": "676400101",
            "dialogues": [
                {
                    "id": "676400101",
                    "speaker": "乌利亚娜",
                    "text": "唉，怎么又出去了，希望那小子别遇上什么危险…怎么了，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6764002",
            "initDialog": "676400201",
            "dialogues": [
                {
                    "id": "676400201",
                    "speaker": "Player",
                    "text": "发生什么事了吗？"
                },
                {
                    "id": "676400202",
                    "speaker": "乌利亚娜",
                    "text": "…我是在担心我的兄弟，他是我家里这一辈最小的那个，从那夏镇到了这儿来，成了执灯士。"
                },
                {
                    "id": "676400203",
                    "speaker": "乌利亚娜",
                    "text": "唉，他可真是个混蛋，皮拉米达离那夏镇也没有那么远嘛，每次都说作战太忙回不了家。"
                },
                {
                    "id": "676400204",
                    "speaker": "乌利亚娜",
                    "text": "想见他一面还得我自己跑过来…结果他又跟队出去，见都见不着一面。"
                }
            ]
        },
        {
            "talkId": "6764003",
            "initDialog": "676400301",
            "dialogues": [
                {
                    "id": "676400301",
                    "speaker": "Player",
                    "text": "没事，不打扰你了。"
                },
                {
                    "id": "676400302",
                    "speaker": "乌利亚娜",
                    "text": "好的…"
                }
            ]
        },
        {
            "talkId": "6764004",
            "initDialog": "676400401",
            "dialogues": [
                {
                    "id": "676400401",
                    "speaker": "Player",
                    "text": "或许没过多久他就回来了…"
                },
                {
                    "id": "676400402",
                    "speaker": "乌利亚娜",
                    "text": "那我就得好好捏捏他的脸蛋了！"
                },
                {
                    "id": "676400403",
                    "speaker": "乌利亚娜",
                    "text": "唉…干什么不好，为什么要当执灯士呢…"
                }
            ]
        },
        {
            "talkId": "6764005",
            "initDialog": "676400501",
            "dialogues": [
                {
                    "id": "676400501",
                    "speaker": "Player",
                    "text": "他会没事的。"
                },
                {
                    "id": "676400502",
                    "speaker": "乌利亚娜",
                    "text": "…嗯，但这样等待的滋味可不好受。"
                },
                {
                    "id": "676400503",
                    "speaker": "乌利亚娜",
                    "text": "当初他说要加入执灯人的时候，我就该拦着的。本来以为他没过多久就该哭哭啼啼回来啦，没想到他坚持了这么多年…"
                },
                {
                    "id": "676400504",
                    "speaker": "乌利亚娜",
                    "text": "我们能怎么办呢，只能为他祈祷…希望他平安归来。"
                }
            ]
        }
    ]
}