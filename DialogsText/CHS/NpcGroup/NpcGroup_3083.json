{
    "groupId": "3083",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "哈里森": 10
    },
    "talks": [
        {
            "talkId": "6308301",
            "initDialog": "630830101",
            "dialogues": [
                {
                    "id": "630830101",
                    "speaker": "哈里森",
                    "text": "嘘！客官可是来「进货」的？"
                },
                {
                    "id": "630830102",
                    "speaker": "哈里森",
                    "text": "小点声，我给你看看这里的好东西…"
                }
            ]
        },
        {
            "talkId": "6308302",
            "initDialog": "630830201",
            "dialogues": [
                {
                    "id": "630830201",
                    "speaker": "Player",
                    "text": "好东西…？"
                },
                {
                    "id": "630830202",
                    "speaker": "哈里森",
                    "text": "那可不，我们「万国杂货」的货品，都是各国商人手中的精品，多种多样，肯定有一款适合你。"
                }
            ]
        },
        {
            "talkId": "6308303",
            "initDialog": "630830301",
            "dialogues": [
                {
                    "id": "630830301",
                    "speaker": "Player",
                    "text": "莫不是走…"
                },
                {
                    "id": "630830302",
                    "speaker": "哈里森",
                    "text": "嘘！朋友，这可不兴乱说啊。"
                },
                {
                    "id": "630830303",
                    "speaker": "哈里森",
                    "text": "外国货的事情，怎么能叫走私呢？"
                },
                {
                    "id": "630830304",
                    "speaker": "哈里森",
                    "text": "看你也是外国人，应该懂得的吧，是吧。"
                },
                {
                    "id": "630830305",
                    "speaker": "哈里森",
                    "text": "如果有什么需要的，可以来照顾下兄弟的生意。"
                }
            ]
        },
        {
            "talkId": "6308304",
            "initDialog": "630830401",
            "dialogues": [
                {
                    "id": "630830401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630830402",
                    "speaker": "哈里森",
                    "text": "再见，需要什么东西的话都可以先来问我！"
                }
            ]
        },
        {
            "talkId": "7290701",
            "initDialog": "729070101",
            "dialogues": [
                {
                    "id": "729070101",
                    "speaker": "Player",
                    "text": "这…"
                },
                {
                    "id": "729070102",
                    "speaker": "哈里森",
                    "text": "哎…做生意讲究一个诚恳不是，这些你收下，就当是兄弟的见面礼。"
                },
                {
                    "id": "729070103",
                    "speaker": "哈里森",
                    "text": "富贵险中求嘛，以后多多关照啊！"
                }
            ]
        }
    ]
}