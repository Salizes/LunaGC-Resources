{
    "groupId": "2022",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "璃彩": 8
    },
    "talks": [
        {
            "talkId": "6202201",
            "initDialog": "620220101",
            "dialogues": [
                {
                    "id": "620220101",
                    "speaker": "璃彩",
                    "text": "欢迎光临「琉璃亭」，客官几位？有预定吗？"
                }
            ]
        },
        {
            "talkId": "6202202",
            "initDialog": "620220201",
            "dialogues": [
                {
                    "id": "620220201",
                    "speaker": "Player",
                    "text": "吃的可以打包吗？"
                },
                {
                    "id": "620220202",
                    "speaker": "璃彩",
                    "text": "可以哦，地道的璃菜，打包带走咯~！"
                }
            ]
        },
        {
            "talkId": "6202203",
            "initDialog": "620220301",
            "dialogues": [
                {
                    "id": "620220301",
                    "speaker": "Player",
                    "text": "还要预订的吗？"
                },
                {
                    "id": "620220302",
                    "speaker": "璃彩",
                    "text": "是哦，真是不好意思。堂吃的话麻烦至少提前三个月来预订位置，我会好好登记的。"
                },
                {
                    "id": "620220303",
                    "speaker": "璃彩",
                    "text": "欸…三个月很长吗？我们「琉璃亭」一天只在固定时间招待几桌客人，所以要排很久啦。"
                },
                {
                    "id": "620220304",
                    "speaker": "璃彩",
                    "text": "而且，能在「璃菜的天堂」享用最地道的璃菜，三个月的等待又算得了什么呢？"
                },
                {
                    "id": "620220305",
                    "speaker": "璃彩",
                    "text": "来「琉璃亭」的都是真正喜欢山珍料理的璃菜粉丝！即使是达官贵人也不能插队的。"
                },
                {
                    "id": "620220306",
                    "speaker": "璃彩",
                    "text": "虽说打包也可以啦，但吃饭重要的是氛围！氛围呀~！"
                }
            ]
        },
        {
            "talkId": "6202204",
            "initDialog": "620220401",
            "dialogues": [
                {
                    "id": "620220401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620220402",
                    "speaker": "璃彩",
                    "text": "请慢走，要预定请提前说哦~！"
                }
            ]
        }
    ]
}