{
    "groupId": "3138",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "落": 8
    },
    "talks": [
        {
            "talkId": "6313801",
            "initDialog": "631380101",
            "dialogues": [
                {
                    "id": "631380101",
                    "speaker": "落",
                    "text": "唉，久病难治，旧伤难愈啊…"
                }
            ]
        },
        {
            "talkId": "6313802",
            "initDialog": "631380201",
            "dialogues": [
                {
                    "id": "631380201",
                    "speaker": "Player",
                    "text": "你受伤了？"
                },
                {
                    "id": "631380202",
                    "speaker": "落",
                    "text": "可不是嘛！还是挺严重的伤呢，到现在还在痛…"
                },
                {
                    "id": "631380203",
                    "speaker": "落",
                    "text": "哎哎，不要探头探脑的。伤口老可怕了，普通人见了一定会被吓到的，快别偷看了。"
                },
                {
                    "id": "631380204",
                    "speaker": "落",
                    "text": "唉哟唉哟，真疼啊…"
                }
            ]
        },
        {
            "talkId": "6313803",
            "initDialog": "631380301",
            "dialogues": [
                {
                    "id": "631380301",
                    "speaker": "Player",
                    "text": "你保重。"
                },
                {
                    "id": "631380302",
                    "speaker": "落",
                    "text": "哎，好。唉哟唉哟，又痛起来了…"
                }
            ]
        },
        {
            "talkId": "6313804",
            "initDialog": "631380401",
            "dialogues": [
                {
                    "id": "631380401",
                    "speaker": "Player",
                    "text": "要不送你去医生那看看？"
                },
                {
                    "id": "631380402",
                    "speaker": "落",
                    "text": "啊？这…没必要没必要，早就给医生看过了。这么重的伤，怎么可能不去看医生呢，你说是吧。"
                },
                {
                    "id": "631380403",
                    "speaker": "落",
                    "text": "医生说这伤得静养，需要的是…呃，安静的环境，和很长的时间。"
                },
                {
                    "id": "631380404",
                    "speaker": "落",
                    "text": "你没别的事情做吗？你看上去也像是个大忙人，就别在我这浪费时间了，哈。"
                }
            ]
        }
    ]
}