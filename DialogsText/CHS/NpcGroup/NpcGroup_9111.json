{
    "groupId": "9111",
    "total_dialogue_lines": 72,
    "speaker_counts": {
        "Player": 23,
        "瓦雷莎": 49
    },
    "talks": [
        {
            "talkId": "6911101",
            "initDialog": "691110101",
            "dialogues": [
                {
                    "id": "691110101",
                    "speaker": "瓦雷莎",
                    "text": "哼哼哼~嘿嘿嘿~你来了！"
                },
                {
                    "id": "691110102",
                    "speaker": "瓦雷莎",
                    "text": "天气很棒，空气很清爽，周围都是漂亮的景色…最重要的是，你来找我玩啦，我现在超开心！"
                }
            ]
        },
        {
            "talkId": "6911102",
            "initDialog": "691110201",
            "dialogues": [
                {
                    "id": "691110201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691110202",
                    "speaker": "瓦雷莎",
                    "text": "唔？这个问题，我要想一想…"
                },
                {
                    "id": "691110203",
                    "speaker": "瓦雷莎",
                    "text": "平时我喜欢在各种地方野营，有的时候，停好运水果的货车，随便在路边找块平整的草地，搭起帐篷，我也感觉很自在。"
                },
                {
                    "id": "691110204",
                    "speaker": "瓦雷莎",
                    "text": "似乎，除了参加「归火圣夜巡礼」的团体赛，被对手们热切注视着之外，我还没有过「不习惯」的感受…",
                    "choices": [
                        {
                            "id": "691110205",
                            "text": "好强大的适应力！",
                            "response": [
                                {
                                    "id": "691110207",
                                    "speaker": "瓦雷莎",
                                    "text": "但这里不一样！"
                                },
                                {
                                    "id": "691110208",
                                    "speaker": "瓦雷莎",
                                    "text": "它让我有一种，其他地方都没有的…安心感？"
                                },
                                {
                                    "id": "691110209",
                                    "speaker": "瓦雷莎",
                                    "text": "就像是…有人已经为我安排好了一切，从植物、到房子，再到小小的陈设，全都让我超舒坦，好神奇！"
                                },
                                {
                                    "id": "691110210",
                                    "speaker": "瓦雷莎",
                                    "text": "哪怕在家里，有好几次，妈妈随手搬走了我常坐的椅子，我闭着眼睛不小心一下子坐空，哐咚一下摔在地上…"
                                },
                                {
                                    "id": "691110211",
                                    "speaker": "瓦雷莎",
                                    "text": "嘿嘿…还好我身体本来就圆圆的，没有受伤。",
                                    "choices": [
                                        {
                                            "id": "691110212",
                                            "text": "没错，就是为你特别安排的！",
                                            "response": [
                                                {
                                                    "id": "691110213",
                                                    "speaker": "瓦雷莎",
                                                    "text": "真，真的吗？我，我我…"
                                                },
                                                {
                                                    "id": "691110214",
                                                    "speaker": "瓦雷莎",
                                                    "text": "#英雄{NICKNAME}把我当成重要的客人招待了！这可是好多大人物不曾得到的殊荣！力量有如泉涌！"
                                                },
                                                {
                                                    "id": "691110218",
                                                    "speaker": "瓦雷莎",
                                                    "text": "哦！我现在充满干劲，要好好加油，努力锻炼才行！"
                                                },
                                                {
                                                    "id": "691110219",
                                                    "speaker": "瓦雷莎",
                                                    "text": "#英雄{NICKNAME}！我们来撞拳！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691110215",
                                            "text": "其实，这也是我喜欢的风格。",
                                            "response": [
                                                {
                                                    "id": "691110216",
                                                    "speaker": "瓦雷莎",
                                                    "text": "真，真的吗？我，我我…"
                                                },
                                                {
                                                    "id": "691110217",
                                                    "speaker": "瓦雷莎",
                                                    "text": "#我和走遍各地，见识过诸多英豪俊杰的{NICKNAME}喜欢一样的环境，默契不言自明！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691110206",
                            "text": "天然发现快乐的心态！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911103",
            "initDialog": "691110301",
            "dialogues": [
                {
                    "id": "691110301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691110302",
                    "speaker": "瓦雷莎",
                    "text": "好哎！正好悠悠哉哉，我们可以慢慢聊天…"
                },
                {
                    "id": "691110303",
                    "speaker": "瓦雷莎",
                    "text": "不过，说到聊天，有零食和饮料在身边才最惬意，当然正经的饭菜也可以！"
                },
                {
                    "id": "691110304",
                    "speaker": "瓦雷莎",
                    "text": "如果在这边架起篝火，支一口锅，就更有感觉了…甚至可以边做饭边聊。",
                    "choices": [
                        {
                            "id": "691110305",
                            "text": "瓦雷莎喜欢自己做饭吗？",
                            "response": [
                                {
                                    "id": "691110307",
                                    "speaker": "瓦雷莎",
                                    "text": "只是兴趣爱好，厨艺不厉害，嘿嘿…刚尝试新东西那阵，还有点丢人…"
                                },
                                {
                                    "id": "691110308",
                                    "speaker": "瓦雷莎",
                                    "text": "那是我在做「咚咚膨膨」的时候，不小心把家里的厨房搞炸了。锅飞出去好远好远，还正好砸中伊安珊老师。"
                                },
                                {
                                    "id": "691110309",
                                    "speaker": "瓦雷莎",
                                    "text": "结果锅受了重伤，到现在还没好。"
                                },
                                {
                                    "id": "691110310",
                                    "speaker": "瓦雷莎",
                                    "text": "从那以后，爸爸妈妈就不让我在屋子里做饭了，我只好在野营时做点简单的料理，慢慢练手。"
                                },
                                {
                                    "id": "691110311",
                                    "speaker": "瓦雷莎",
                                    "text": "自己动手一点点做出来的饭菜，味道可能没那么好，却有种特别的满足感，是外出就餐换不来的！",
                                    "choices": [
                                        {
                                            "id": "691110312",
                                            "text": "同感，这是自己动手的美味！",
                                            "response": [
                                                {
                                                    "id": "691110314",
                                                    "speaker": "瓦雷莎",
                                                    "text": "不如，下次我准备好肉和水果，你准备好蔬菜和调料，我们一起做道超级厉害的硬菜！"
                                                },
                                                {
                                                    "id": "691110315",
                                                    "speaker": "瓦雷莎",
                                                    "text": "#就用我们的名字来命名…比如…{NICKNAME}和瓦雷莎的辉煌烤肉大要塞！"
                                                },
                                                {
                                                    "id": "691110316",
                                                    "speaker": "瓦雷莎",
                                                    "text": "唔，要达到「辉煌」级别的话，应该要加很多味道厉害的调料，而且要猛火烈烤…"
                                                },
                                                {
                                                    "id": "691110317",
                                                    "speaker": "瓦雷莎",
                                                    "text": "还是找个僻静、安全的地方来做吧。万一出了什么意外，也不能把你用心布置的家园搞得一片狼藉。",
                                                    "choices": [
                                                        {
                                                            "id": "691110318",
                                                            "text": "说好了说好了！"
                                                        },
                                                        {
                                                            "id": "691110319",
                                                            "text": "大爆炸也不怕。",
                                                            "response": [
                                                                {
                                                                    "id": "691110320",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "嘿嘿，也不怕！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691110313",
                                            "text": "同感，我也炸过厨房！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691110306",
                            "text": "瓦雷莎对烹饪有造诣？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911104",
            "initDialog": "691110401",
            "dialogues": [
                {
                    "id": "691110401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691110402",
                    "speaker": "瓦雷莎",
                    "text": "嗯，其实有一件事，我考虑好久了。正好，现在应该算是我们两人独处…"
                },
                {
                    "id": "691110403",
                    "speaker": "瓦雷莎",
                    "text": "我，我要做好心理准备，鼓起勇气…",
                    "choices": [
                        {
                            "id": "691110404",
                            "text": "什…什么？",
                            "response": [
                                {
                                    "id": "691110406",
                                    "speaker": "瓦雷莎",
                                    "text": "能请你…使出全力，和我战斗一场，切磋一下吗？"
                                },
                                {
                                    "id": "691110407",
                                    "speaker": "瓦雷莎",
                                    "text": "你是现代英雄，当代传奇，我熟悉的…最强的人！还是我心目中的偶像，我希望赶上的榜样！"
                                },
                                {
                                    "id": "691110408",
                                    "speaker": "瓦雷莎",
                                    "text": "我很想知道，自己的实力和火力全开的你之间究竟差着多远…",
                                    "choices": [
                                        {
                                            "id": "691110409",
                                            "text": "慢着？",
                                            "response": [
                                                {
                                                    "id": "691110411",
                                                    "speaker": "瓦雷莎",
                                                    "text": "矛盾的是，就算知道你超级厉害，可以和神明打得有来有回，我还是害怕伤到你…因为我的战斗方式有点胡来。"
                                                },
                                                {
                                                    "id": "691110412",
                                                    "speaker": "瓦雷莎",
                                                    "text": "怎么办，我脑袋里乱乱的…",
                                                    "choices": [
                                                        {
                                                            "id": "691110413",
                                                            "text": "就算是切磋，我也没法毫不留情哦。",
                                                            "response": [
                                                                {
                                                                    "id": "691110415",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "呜…我明白了，我的这个要求太任性了…"
                                                                },
                                                                {
                                                                    "id": "691110416",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "虽然没能和你交手，但不知道为什么，听了你的说法，感觉心里暖暖的…"
                                                                },
                                                                {
                                                                    "id": "691110417",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "欸？那我们换个方法来切磋吧，比拼一下运动？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "691110418",
                                                                            "text": "这个提议可行不少。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "691110420",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "那，那我们先用九万步的短跑和一半距离的游泳热身吧，然后准备五十块杠铃片，每块的重量都是标准成年突角龙的体重…"
                                                                                },
                                                                                {
                                                                                    "id": "691110421",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "我开始期待了！你卧推杠铃时的力量感…一定很威风！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "691110419",
                                                                            "text": "还好我一直在冒险中健身。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691110414",
                                                            "text": "我和你一样，不想和朋友战斗。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691110410",
                                            "text": "全力切磋？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691110405",
                            "text": "如此郑重…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911105",
            "initDialog": "691110501",
            "dialogues": [
                {
                    "id": "691110501",
                    "speaker": "Player",
                    "text": "早啊，瓦雷莎。"
                },
                {
                    "id": "691110502",
                    "speaker": "瓦雷莎",
                    "text": "早呀！一见到你，我就精神满满，难得不想睡回笼觉了！"
                }
            ]
        },
        {
            "talkId": "6911106",
            "initDialog": "691110601",
            "dialogues": [
                {
                    "id": "691110601",
                    "speaker": "Player",
                    "text": "晚安，瓦雷莎。"
                },
                {
                    "id": "691110602",
                    "speaker": "瓦雷莎",
                    "text": "晚安哦！听到了你的问候，我肯定睡得更安稳！"
                }
            ]
        },
        {
            "talkId": "6911110",
            "initDialog": "691111001",
            "dialogues": [
                {
                    "id": "691111001",
                    "speaker": "瓦雷莎",
                    "text": "呜啊！这里的样子好熟悉，完全就是「沃陆之邦」的感觉，连锻炼的器材都一模一样！"
                },
                {
                    "id": "691111002",
                    "speaker": "瓦雷莎",
                    "text": "在外旅行很新奇，但总维持着新奇的兴奋度，时间一长还是有点累的。"
                },
                {
                    "id": "691111003",
                    "speaker": "瓦雷莎",
                    "text": "现在找到了第二个家，还有你在身边，感觉什么都不用担忧了。把烦恼撞飞喽！"
                }
            ]
        },
        {
            "talkId": "6911111",
            "initDialog": "691111101",
            "dialogues": [
                {
                    "id": "691111101",
                    "speaker": "瓦雷莎",
                    "text": "软软的床，蓬松的枕头，有点凉的、光滑的被子和床单…陷进去就出不来…"
                },
                {
                    "id": "691111102",
                    "speaker": "瓦雷莎",
                    "text": "不行不行，不能随随便便就睡着，应该先吃最喜欢的甜点到六成饱，在炉边把手脚都烤得暖暖的，再喝小半杯水…"
                },
                {
                    "id": "691111103",
                    "speaker": "瓦雷莎",
                    "text": "这样睡着的话，做的梦都是水果味的，嘿嘿…"
                }
            ]
        }
    ]
}