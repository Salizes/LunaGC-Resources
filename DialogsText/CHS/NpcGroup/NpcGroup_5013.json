{
    "groupId": "5013",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "普吕尼埃": 14
    },
    "talks": [
        {
            "talkId": "6501301",
            "initDialog": "650130101",
            "dialogues": [
                {
                    "id": "650130101",
                    "speaker": "普吕尼埃",
                    "text": "你好，水道没出什么状况吧？"
                }
            ]
        },
        {
            "talkId": "6501302",
            "initDialog": "650130201",
            "dialogues": [
                {
                    "id": "650130201",
                    "speaker": "Player",
                    "text": "据我所知，还没有。"
                },
                {
                    "id": "650130202",
                    "speaker": "普吕尼埃",
                    "text": "「还没有」听起来不是很吉利啊…不过没事就好。"
                },
                {
                    "id": "650130203",
                    "speaker": "普吕尼埃",
                    "text": "你知道我们检修员最害怕的东西是什么吗？看不见的裂痕！"
                },
                {
                    "id": "650130204",
                    "speaker": "普吕尼埃",
                    "text": "就像藏在面粉里的碎砂子，一不小心会毁了整个面包。"
                },
                {
                    "id": "650130205",
                    "speaker": "普吕尼埃",
                    "text": "哦对了，还有一个麻烦，就是乱拿工具的人。"
                },
                {
                    "id": "650130206",
                    "speaker": "普吕尼埃",
                    "text": "有次我就把撬棍放在身后一小会儿，就被路过的人顺走了！"
                },
                {
                    "id": "650130207",
                    "speaker": "普吕尼埃",
                    "text": "不过还好他在给了不知道什么人一棍子后马上又还了回来，不然我那天的工作都做不下去。"
                }
            ]
        },
        {
            "talkId": "6501303",
            "initDialog": "650130301",
            "dialogues": [
                {
                    "id": "650130301",
                    "speaker": "Player",
                    "text": "这里的重点是工作吗？"
                },
                {
                    "id": "650130302",
                    "speaker": "普吕尼埃",
                    "text": "对我来说是的。"
                },
                {
                    "id": "650130303",
                    "speaker": "普吕尼埃",
                    "text": "我记得那个被放倒的倒霉蛋好像是个小偷吧？算是罪有应得。"
                },
                {
                    "id": "650130304",
                    "speaker": "普吕尼埃",
                    "text": "后来好像还有个什么记者跑过来想要采访，被我赶走了。治安问题我哪懂啊，又不是我该考虑的事情。"
                },
                {
                    "id": "650130305",
                    "speaker": "普吕尼埃",
                    "text": "而且，附近不是一直有个穿便服的美露莘在盯着吗？"
                }
            ]
        },
        {
            "talkId": "6501304",
            "initDialog": "650130401",
            "dialogues": [
                {
                    "id": "650130401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650130402",
                    "speaker": "普吕尼埃",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6501305",
            "initDialog": "650130501",
            "dialogues": [
                {
                    "id": "650130501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6501306",
            "initDialog": "650130601",
            "dialogues": [
                {
                    "id": "650130601",
                    "speaker": "普吕尼埃",
                    "text": "赢了就好，看来今天很走运，不用担心水道的安全问题了！"
                }
            ]
        },
        {
            "talkId": "6501307",
            "initDialog": "650130701",
            "dialogues": [
                {
                    "id": "650130701",
                    "speaker": "普吕尼埃",
                    "text": "今天的运气不太好，有点不吉利，该去检查下水道有没有出什么状况了…"
                }
            ]
        }
    ]
}