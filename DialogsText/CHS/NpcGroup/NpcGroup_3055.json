{
    "groupId": "3055",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "池田总四郎": 12
    },
    "talks": [
        {
            "talkId": "6305501",
            "initDialog": "630550101",
            "dialogues": [
                {
                    "id": "630550101",
                    "speaker": "池田总四郎",
                    "text": "哦…你好呀…哎…谁来着？"
                },
                {
                    "id": "630550102",
                    "speaker": "池田总四郎",
                    "text": "是…是孝行家的孩子吗？不像啊…"
                }
            ]
        },
        {
            "talkId": "6305502",
            "initDialog": "630550201",
            "dialogues": [
                {
                    "id": "630550201",
                    "speaker": "Player",
                    "text": "孝行…？"
                },
                {
                    "id": "630550202",
                    "speaker": "池田总四郎",
                    "text": "就是那个，九条家的孝行。"
                },
                {
                    "id": "630550203",
                    "speaker": "池田总四郎",
                    "text": "老夫作为九条家的家臣，他家的人，都记得。孝行这孩子，天资不错，志向高远，应该能成事。"
                },
                {
                    "id": "630550204",
                    "speaker": "池田总四郎",
                    "text": "不知道他现在学习成绩是不是还和以前一样好，哈哈！"
                }
            ]
        },
        {
            "talkId": "6305503",
            "initDialog": "630550301",
            "dialogues": [
                {
                    "id": "630550301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630550302",
                    "speaker": "池田总四郎",
                    "text": "哦哦，孩子路上当心啊。"
                }
            ]
        },
        {
            "talkId": "6305504",
            "initDialog": "630550401",
            "dialogues": [
                {
                    "id": "630550401",
                    "speaker": "Player",
                    "text": "您好像有点糊涂了…"
                },
                {
                    "id": "630550402",
                    "speaker": "池田总四郎",
                    "text": "欸，你不是九条家的孩子啊…也是，老夫为他家工作了一辈子，确实没见过你这种样貌的…"
                },
                {
                    "id": "630550403",
                    "speaker": "池田总四郎",
                    "text": "唉老了，老了啊…孩子，听老人家一句劝，越是年轻越要慎重行事，不要做错误的选择啊。"
                }
            ]
        },
        {
            "talkId": "6305505",
            "initDialog": "630550501",
            "dialogues": [
                {
                    "id": "630550501",
                    "speaker": "Player",
                    "text": "学习成绩…"
                },
                {
                    "id": "630550502",
                    "speaker": "池田总四郎",
                    "text": "嗯，年轻人，学习可是很重要的，要好好读书、锻炼，文武兼备才能成为九条家的栋梁之才。"
                },
                {
                    "id": "630550503",
                    "speaker": "池田总四郎",
                    "text": "要我说，九条家的小辈都要向裟罗学习！裟罗武艺高强，又对九条家忠心耿耿，虽是被孝行那小子收养的，但是比大部分的本家人都靠得住，哈哈！"
                }
            ]
        },
        {
            "talkId": "7292301",
            "initDialog": "729230101",
            "dialogues": [
                {
                    "id": "729230101",
                    "speaker": "Player",
                    "text": "嗯，我知道了。"
                },
                {
                    "id": "729230102",
                    "speaker": "池田总四郎",
                    "text": "哎，这就对啦…好孩子，听老人家的话才能长得高。"
                },
                {
                    "id": "729230103",
                    "speaker": "池田总四郎",
                    "text": "这些点心你们小朋友应该喜欢，拿着路上吃吧。慢点走，别摔着。"
                }
            ]
        }
    ]
}