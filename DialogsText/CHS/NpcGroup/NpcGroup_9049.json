{
    "groupId": "9049",
    "total_dialogue_lines": 82,
    "speaker_counts": {
        "Player": 18,
        "宵宫": 64
    },
    "talks": [
        {
            "talkId": "6904901",
            "initDialog": "690490101",
            "dialogues": [
                {
                    "id": "690490101",
                    "speaker": "宵宫",
                    "text": "#啊，是你，{NICKNAME}，你好呀！"
                },
                {
                    "id": "690490102",
                    "speaker": "宵宫",
                    "text": "想要打发时间的话，找我不会错。"
                }
            ]
        },
        {
            "talkId": "6904902",
            "initDialog": "690490201",
            "dialogues": [
                {
                    "id": "690490201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690490202",
                    "speaker": "宵宫",
                    "text": "太厉害了！谁能想到你有一个这么厉害的地方！"
                },
                {
                    "id": "690490203",
                    "speaker": "宵宫",
                    "text": "这是璃月的仙家之物对吧？简直难以置信，你让我进到这个壶里来的时候，我以为你在开玩笑呢。"
                },
                {
                    "id": "690490204",
                    "speaker": "宵宫",
                    "text": "我还在想要怎么接你的话，是吐槽，还是顺着你的话题继续说下去…",
                    "choices": [
                        {
                            "id": "690490205",
                            "text": "吐槽会怎么说？",
                            "response": [
                                {
                                    "id": "690490206",
                                    "speaker": "宵宫",
                                    "text": "「进不去，怎么想都进不去嘛！」"
                                },
                                {
                                    "id": "690490207",
                                    "speaker": "宵宫",
                                    "text": "哈哈，这个是派蒙告诉我的，她刚刚见到壶的时候就是这个反应。"
                                },
                                {
                                    "id": "690490208",
                                    "speaker": "宵宫",
                                    "text": "她都进不去，那我就更不可能了嘛。"
                                },
                                {
                                    "id": "690490212",
                                    "speaker": "宵宫",
                                    "text": "结果谁能想到，你推了推我，我就眼前一黑，转眼就到了这里。"
                                },
                                {
                                    "id": "690490213",
                                    "speaker": "宵宫",
                                    "text": "视野开阔，空气新鲜，简直是绝美的宝地。"
                                },
                                {
                                    "id": "690490214",
                                    "speaker": "Player",
                                    "text": "你喜欢就好。"
                                },
                                {
                                    "id": "690490215",
                                    "speaker": "宵宫",
                                    "text": "当然喜欢啦，连一直住在这里的心都有了。"
                                },
                                {
                                    "id": "690490216",
                                    "speaker": "宵宫",
                                    "text": "欸，要不然在这里开一间「长野原」的分店好了。"
                                },
                                {
                                    "id": "690490217",
                                    "speaker": "宵宫",
                                    "text": "叫上我们的伙伴都来看烟花吧，就当是我送你的祝贺礼！"
                                }
                            ]
                        },
                        {
                            "id": "690490209",
                            "text": "顺着说会怎么说？",
                            "response": [
                                {
                                    "id": "690490210",
                                    "speaker": "宵宫",
                                    "text": "「那我就派出我家鱼缸里的大将，『金鱼太郎』陪你进去吧！」"
                                },
                                {
                                    "id": "690490211",
                                    "speaker": "宵宫",
                                    "text": "它的话肯定没问题，毕竟是金鱼嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904903",
            "initDialog": "690490301",
            "dialogues": [
                {
                    "id": "690490301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690490302",
                    "speaker": "宵宫",
                    "text": "好呀，你知道我最喜欢聊天了，我想想有没有什么有趣的话题…"
                },
                {
                    "id": "690490303",
                    "speaker": "宵宫",
                    "text": "对了，难得你有了这么大一块世外桃源，除了用来居住之外，还有别的想法吗？"
                },
                {
                    "id": "690490304",
                    "speaker": "宵宫",
                    "text": "比如建会客厅，展览馆，训练场什么的。",
                    "choices": [
                        {
                            "id": "690490305",
                            "text": "我想像你一样做生意。",
                            "response": [
                                {
                                    "id": "690490306",
                                    "speaker": "宵宫",
                                    "text": "欸？这样啊，不过可能你有点误会，我们家的生意和平常的生意不太一样。"
                                },
                                {
                                    "id": "690490307",
                                    "speaker": "宵宫",
                                    "text": "我知道璃月的商人都擅长赚大钱，大账小账都能做得特别精明。"
                                },
                                {
                                    "id": "690490308",
                                    "speaker": "宵宫",
                                    "text": "但对我们家来说，客人都是老主顾，抬头不见低头见，人情往来更加重要。"
                                },
                                {
                                    "id": "690490309",
                                    "speaker": "宵宫",
                                    "text": "所以，我和老爹做生意，为的是不辜负大家的信任吧。"
                                },
                                {
                                    "id": "690490315",
                                    "speaker": "宵宫",
                                    "text": "总之，等你建设完毕的时候，记得找我来给你放烟花庆祝哦。"
                                },
                                {
                                    "id": "690490316",
                                    "speaker": "Player",
                                    "text": "如果让你建，你有什么想法？"
                                },
                                {
                                    "id": "690490317",
                                    "speaker": "宵宫",
                                    "text": "我的话…嘿嘿，我想建游乐场！"
                                },
                                {
                                    "id": "690490318",
                                    "speaker": "宵宫",
                                    "text": "里面摆满了玩具，各种各样会闪的，会动的，会转的，饿了还有点心可以吃！"
                                },
                                {
                                    "id": "690490319",
                                    "speaker": "宵宫",
                                    "text": "住在那样的世界里，我就算圆梦了吧！"
                                },
                                {
                                    "id": "690490320",
                                    "speaker": "Player",
                                    "text": "我会考虑的。"
                                },
                                {
                                    "id": "690490321",
                                    "speaker": "宵宫",
                                    "text": "不用，不用，不需要认真考虑，这只是我的私心啦。"
                                },
                                {
                                    "id": "690490322",
                                    "speaker": "宵宫",
                                    "text": "不过…听到你这么说，我很开心。"
                                },
                                {
                                    "id": "690490323",
                                    "speaker": "宵宫",
                                    "text": "游乐场…啊，真好。"
                                }
                            ]
                        },
                        {
                            "id": "690490310",
                            "text": "我想打造一片园林。",
                            "response": [
                                {
                                    "id": "690490311",
                                    "speaker": "宵宫",
                                    "text": "哦，很有雅兴嘛！我觉得很有趣，我也想帮忙。"
                                },
                                {
                                    "id": "690490312",
                                    "speaker": "宵宫",
                                    "text": "你需要什么东西，尽管跟我说，只要稻妻能找到的，我都会想办法弄到。"
                                },
                                {
                                    "id": "690490313",
                                    "speaker": "宵宫",
                                    "text": "这也多亏家里的生意积累了人脉，哈哈。"
                                },
                                {
                                    "id": "690490314",
                                    "speaker": "宵宫",
                                    "text": "对了，摘星星摘月亮什么的不行哦，摘不到的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904904",
            "initDialog": "690490401",
            "dialogues": [
                {
                    "id": "690490401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690490402",
                    "speaker": "宵宫",
                    "text": "想了解更多关于你的事——！"
                },
                {
                    "id": "690490403",
                    "speaker": "宵宫",
                    "text": "和你一起冒险了这么长的时间，我也从很多地方听说了你的故事。"
                },
                {
                    "id": "690490404",
                    "speaker": "宵宫",
                    "text": "但是越听就越好奇，到底是什么让你这么与众不同呢？"
                },
                {
                    "id": "690490405",
                    "speaker": "宵宫",
                    "text": "总是有个原因的吧，比如我喜欢说话，是因为小时候以为老爹特别喜欢听我说话。"
                },
                {
                    "id": "690490406",
                    "speaker": "宵宫",
                    "text": "我喜欢烟花，是因为制作烟花这件事让我由衷自豪。"
                },
                {
                    "id": "690490407",
                    "speaker": "宵宫",
                    "text": "而你又是为什么呢？",
                    "choices": [
                        {
                            "id": "690490408",
                            "text": "有想要见到的人。",
                            "response": [
                                {
                                    "id": "690490409",
                                    "speaker": "宵宫",
                                    "text": "原来这就是你的动力啊。"
                                },
                                {
                                    "id": "690490410",
                                    "speaker": "宵宫",
                                    "text": "#「不希望重逢的时候让{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}失望」，对吧？"
                                },
                                {
                                    "id": "690490411",
                                    "speaker": "宵宫",
                                    "text": "唔，真的很佩服，而且，很羡慕！"
                                },
                                {
                                    "id": "690490412",
                                    "speaker": "宵宫",
                                    "text": "我会帮助你的，不管走到什么地方，是天上还是地下，你们一定要相见啊！"
                                },
                                {
                                    "id": "690490419",
                                    "speaker": "宵宫",
                                    "text": "嘿嘿，不好意思，稍微有点激动了。"
                                },
                                {
                                    "id": "690490420",
                                    "speaker": "宵宫",
                                    "text": "不过，我已经决定了，那就是，我想重走你走过的路！"
                                },
                                {
                                    "id": "690490421",
                                    "speaker": "宵宫",
                                    "text": "从蒙德开始，再到璃月，再到稻妻…看你看过的风景，见你见过的人和事。"
                                },
                                {
                                    "id": "690490422",
                                    "speaker": "宵宫",
                                    "text": "想要彻底地了解一个人，就应该这样做嘛！"
                                },
                                {
                                    "id": "690490423",
                                    "speaker": "Player",
                                    "text": "有点太隆重了。"
                                },
                                {
                                    "id": "690490424",
                                    "speaker": "宵宫",
                                    "text": "啊，我没有想让你产生压力的意思，只是，嗯…怎么说呢，是很纯粹的…"
                                },
                                {
                                    "id": "690490425",
                                    "speaker": "宵宫",
                                    "text": "想了解更多关于你的事——！"
                                }
                            ]
                        },
                        {
                            "id": "690490413",
                            "text": "有想要帮助的人。",
                            "response": [
                                {
                                    "id": "690490414",
                                    "speaker": "宵宫",
                                    "text": "原来这就是你的动力啊。"
                                },
                                {
                                    "id": "690490415",
                                    "speaker": "宵宫",
                                    "text": "「不想看到任何人经历不幸」，对吧？"
                                },
                                {
                                    "id": "690490416",
                                    "speaker": "宵宫",
                                    "text": "像故事书里的英雄一样，太帅了。"
                                },
                                {
                                    "id": "690490417",
                                    "speaker": "宵宫",
                                    "text": "欸？那我就是英雄的同伴了吧？"
                                },
                                {
                                    "id": "690490418",
                                    "speaker": "宵宫",
                                    "text": "我会全力辅助你的，加油，去书写你的故事吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904905",
            "initDialog": "690490501",
            "dialogues": [
                {
                    "id": "690490501",
                    "speaker": "Player",
                    "text": "早啊，宵宫。"
                },
                {
                    "id": "690490502",
                    "speaker": "宵宫",
                    "text": "#早啊，{NICKNAME}。"
                },
                {
                    "id": "690490503",
                    "speaker": "宵宫",
                    "text": "难得好日子，我们一起去玩吧！"
                }
            ]
        },
        {
            "talkId": "6904906",
            "initDialog": "690490601",
            "dialogues": [
                {
                    "id": "690490601",
                    "speaker": "Player",
                    "text": "晚安，宵宫。"
                },
                {
                    "id": "690490602",
                    "speaker": "宵宫",
                    "text": "#嘿嘿，晚安，{NICKNAME}，祝你有个好梦哦。"
                },
                {
                    "id": "690490603",
                    "speaker": "宵宫",
                    "text": "能梦到我的烟花就更好了。"
                }
            ]
        },
        {
            "talkId": "6904907",
            "initDialog": "690490701",
            "dialogues": [
                {
                    "id": "690490701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                }
            ]
        },
        {
            "talkId": "6904908",
            "initDialog": "690490801",
            "dialogues": [
                {
                    "id": "690490801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                }
            ]
        },
        {
            "talkId": "6904909",
            "initDialog": "690490901",
            "dialogues": [
                {
                    "id": "690490901",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                }
            ]
        },
        {
            "talkId": "6904910",
            "initDialog": "690491001",
            "dialogues": [
                {
                    "id": "690491001",
                    "speaker": "宵宫",
                    "text": "哇，我看到了什么，好棒的露天温泉！"
                },
                {
                    "id": "690491002",
                    "speaker": "宵宫",
                    "text": "结束一天的工作之后，泡个热乎乎的澡，再舒服不过了！"
                },
                {
                    "id": "690491003",
                    "speaker": "宵宫",
                    "text": "要一起吗？边泡澡边聊天，也是一种享受哦！"
                }
            ]
        },
        {
            "talkId": "6904911",
            "initDialog": "690491101",
            "dialogues": [
                {
                    "id": "690491101",
                    "speaker": "宵宫",
                    "text": "没错！就是这种感觉！这熟悉的氛围太让我喜欢了！"
                },
                {
                    "id": "690491102",
                    "speaker": "宵宫",
                    "text": "你还真厉害啊，居然能把这里布置成商店街的模样。快让我找找「长野原」在哪里。"
                },
                {
                    "id": "690491103",
                    "speaker": "宵宫",
                    "text": "哎呀，你也一起来吧，准备得那么辛苦，我们要好好玩个够才行！"
                }
            ]
        }
    ]
}