{
    "groupId": "1555",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 7,
        "艾迪丝博士": 18
    },
    "talks": [
        {
            "talkId": "7092701",
            "initDialog": "709270101",
            "dialogues": [
                {
                    "id": "709270101",
                    "speaker": "Player",
                    "text": "她的故事确实很传奇。"
                },
                {
                    "id": "709270102",
                    "speaker": "艾迪丝博士",
                    "text": "是吧？她的一生，是抗争的一生，这应该就是蒙德的自由精神吧。"
                },
                {
                    "id": "709270103",
                    "speaker": "艾迪丝博士",
                    "text": "想要了解她的过去的话，不妨读一读这本书吧。"
                }
            ]
        },
        {
            "talkId": "41737",
            "initDialog": "615550205",
            "dialogues": [
                {
                    "id": "615550205",
                    "speaker": "Player",
                    "text": "关于大树…"
                },
                {
                    "id": "615550206",
                    "speaker": "艾迪丝博士",
                    "text": "这棵大树就是在当年温妮莎登上天空岛的地方生长出来的，我敢保证你走遍蒙德都找不到这么大的橡树！"
                },
                {
                    "id": "615550207",
                    "speaker": "艾迪丝博士",
                    "text": "关于它，我收集了数不胜数的故事和诗歌，找个地方坐坐吧，这些故事我跟你讲三天三夜也讲不完…",
                    "choices": [
                        {
                            "id": "615550208",
                            "text": "…还是下次吧。",
                            "response": [
                                {
                                    "id": "615550209",
                                    "speaker": "艾迪丝博士",
                                    "text": "好吧，没关系。有时间的话随时欢迎！"
                                }
                            ]
                        },
                        {
                            "id": "615550210",
                            "text": "天空岛？",
                            "response": [
                                {
                                    "id": "615550211",
                                    "speaker": "艾迪丝博士",
                                    "text": "天空岛是人间伟大的英雄最终相聚的地方。"
                                },
                                {
                                    "id": "615550212",
                                    "speaker": "艾迪丝博士",
                                    "text": "登上天空岛而被接纳的英雄会成为诸神的一员，在高天之上继续守护人民。"
                                },
                                {
                                    "id": "615550213",
                                    "speaker": "艾迪丝博士",
                                    "text": "凡人不会知道天空岛上是什么样的景色。"
                                },
                                {
                                    "id": "615550214",
                                    "speaker": "艾迪丝博士",
                                    "text": "即使是行走大地的众神，也对天空岛缄口不言…"
                                },
                                {
                                    "id": "615550215",
                                    "speaker": "艾迪丝博士",
                                    "text": "或许天空岛的故事，只有那些在人间故去的英雄才有资格讲述吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6155501",
            "initDialog": "615550101",
            "dialogues": [
                {
                    "id": "615550101",
                    "speaker": "艾迪丝博士",
                    "text": "你好，旅行者，要听我讲讲温妮莎的传奇故事吗？"
                }
            ]
        },
        {
            "talkId": "6155502",
            "initDialog": "615550201",
            "dialogues": [
                {
                    "id": "615550201",
                    "speaker": "Player",
                    "text": "温妮莎？"
                },
                {
                    "id": "615550202",
                    "speaker": "艾迪丝博士",
                    "text": "是的，她就是解放蒙德的大英雄，自幼为奴，却推翻了贵族，为蒙德带来自由的勇士！"
                },
                {
                    "id": "615550203",
                    "speaker": "艾迪丝博士",
                    "text": "在传说中，她后来就是在这里登上了天空岛，从而化作了永远守护蒙德的神。"
                },
                {
                    "id": "615550204",
                    "speaker": "艾迪丝博士",
                    "text": "关于她的生平传说各异，但诸多故事却汇集在唯一的终点——就在这里。"
                }
            ]
        },
        {
            "talkId": "6155503",
            "initDialog": "615550301",
            "dialogues": [
                {
                    "id": "615550301",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "615550302",
                    "speaker": "艾迪丝博士",
                    "text": "啊啊，抱歉忘了自我介绍。"
                },
                {
                    "id": "615550303",
                    "speaker": "艾迪丝博士",
                    "text": "叫我艾迪丝就好，我是个历史作家和民俗研究者，最近在为我的作品取材。"
                },
                {
                    "id": "615550304",
                    "speaker": "艾迪丝博士",
                    "text": "你可能认识那个对丘丘人有着奇怪执着的学者，艾拉·马斯克，她是我的姐姐。"
                }
            ]
        },
        {
            "talkId": "6155504",
            "initDialog": "615550401",
            "dialogues": [
                {
                    "id": "615550401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615550402",
                    "speaker": "艾迪丝博士",
                    "text": "再见，愿温妮莎注视着你！"
                }
            ]
        }
    ]
}