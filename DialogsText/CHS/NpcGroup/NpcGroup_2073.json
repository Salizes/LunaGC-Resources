    "talks": [
        {
            "talkId": "6207301",
            "initDialog": "620730101",
            "dialogues": [
                {
                    "id": "620730101",
                    "speaker": "大武",
                    "text": "嗯？干什么的？"
                }
            ]
        },
        {
            "talkId": "6207302",
            "initDialog": "620730201",
            "dialogues": [
                {
                    "id": "620730201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "620730202",
                    "speaker": "大武",
                    "text": "这么没见识？这里是茂才公的府上，做矿石生意的大户人家。"
                },
                {
                    "id": "620730203",
                    "speaker": "大武",
                    "text": "没事儿就走开点，我家老爷现在不见客。"
                }
            ]
        },
        {
            "talkId": "6207303",
            "initDialog": "620730301",
            "dialogues": [
                {
                    "id": "620730301",
                    "speaker": "Player",
                    "text": "你看起来有些心虚的样子…"
                },
                {
                    "id": "620730302",
                    "speaker": "大武",
                    "text": "胡、胡说啥呢？"
                },
                {
                    "id": "620730303",
                    "speaker": "大武",
                    "text": "我就一看门儿的，啥也不知道。"
                },
                {
                    "id": "620730304",
                    "speaker": "大武",
                    "text": "就算偶尔听到点儿商业机密，也绝不会动卖情报的心思的，你别去外边瞎说啊…"
                }
            ]
        },
        {
            "talkId": "6207304",
            "initDialog": "620730401",
            "dialogues": [
                {
                    "id": "620730401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620730402",
                    "speaker": "大武",
                    "text": "走吧，走吧！"
                }
            ]
        },
        {
            "talkId": "6207305",
            "initDialog": "620730501",
            "dialogues": [
                {
                    "id": "620730501",
                    "speaker": "大武",
                    "text": "嗯？你怎么又来了？"
                }
            ]
        },
        {
            "talkId": "6207306",
            "initDialog": "620730601",
            "dialogues": [
                {
                    "id": "620730601",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "620730602",
                    "speaker": "大武",
                    "text": "这里是茂才公的府上，做矿石生意的大户人家。"
                },
                {
                    "id": "620730603",
                    "speaker": "大武",
                    "text": "不过前一段时间，听说商业机密泄露了，被飞云商会的人狠狠敲了一笔…"
                },
                {
                    "id": "620730604",
                    "speaker": "大武",
                    "text": "也不知道谁这么不小心把风声给走露了。"
                }
            ]
        }
    ]
}