{
    "groupId": "9579",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "克洛琳德": 10
    },
    "talks": [
        {
            "talkId": "6957901",
            "initDialog": "695790101",
            "dialogues": [
                {
                    "id": "695790101",
                    "speaker": "克洛琳德",
                    "text": "这里挺热闹的。但玩的游戏，似乎和「桌上剧团」里的大不一样。"
                }
            ]
        },
        {
            "talkId": "6957902",
            "initDialog": "695790201",
            "dialogues": [
                {
                    "id": "695790201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957903",
            "initDialog": "695790301",
            "dialogues": [
                {
                    "id": "695790301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695790302",
                    "speaker": "克洛琳德",
                    "text": "要走了？我还要再待一会，再研究一下这种卡牌游戏。有些卡牌的效果描述很有意思，或许…以后玩剧本的时候，能用得上。"
                }
            ]
        },
        {
            "talkId": "6957904",
            "initDialog": "695790401",
            "dialogues": [
                {
                    "id": "695790401",
                    "speaker": "克洛琳德",
                    "text": "这场对局，是我胜了。想看看我的牌组？都是些寻常组合，你想就拿去看吧，希望能对你有所启发。"
                }
            ]
        },
        {
            "talkId": "6957905",
            "initDialog": "695790501",
            "dialogues": [
                {
                    "id": "695790501",
                    "speaker": "克洛琳德",
                    "text": "你赢了。牌局胜负，只在于个人实力，我不会把败因归结到运气问题上，这是对你实力的不尊重。"
                }
            ]
        },
        {
            "talkId": "6957906",
            "initDialog": "695790601",
            "dialogues": [
                {
                    "id": "695790601",
                    "speaker": "克洛琳德",
                    "text": "好，我们切磋一局。"
                }
            ]
        },
        {
            "talkId": "6957908",
            "initDialog": "695790801",
            "dialogues": [
                {
                    "id": "695790801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957909",
            "initDialog": "695790901",
            "dialogues": [
                {
                    "id": "695790901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957910",
            "initDialog": "695791001",
            "dialogues": [
                {
                    "id": "695791001",
                    "speaker": "克洛琳德",
                    "text": "胜负已分。如果你想再做比试，我陪你。"
                }
            ]
        },
        {
            "talkId": "6957911",
            "initDialog": "695791101",
            "dialogues": [
                {
                    "id": "695791101",
                    "speaker": "克洛琳德",
                    "text": "…胜负已分，是我败了。"
                }
            ]
        },
        {
            "talkId": "6957912",
            "initDialog": "695791201",
            "dialogues": [
                {
                    "id": "695791201",
                    "speaker": "克洛琳德",
                    "text": "嗯，那就来一场公正的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957914",
            "initDialog": "695791401",
            "dialogues": [
                {
                    "id": "695791401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957915",
            "initDialog": "695791501",
            "dialogues": [
                {
                    "id": "695791501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957916",
            "initDialog": "695791601",
            "dialogues": [
                {
                    "id": "695791601",
                    "speaker": "克洛琳德",
                    "text": "结束了。我胜你一筹。"
                }
            ]
        },
        {
            "talkId": "6957917",
            "initDialog": "695791701",
            "dialogues": [
                {
                    "id": "695791701",
                    "speaker": "克洛琳德",
                    "text": "你的胜利无可置疑。是我技不如你，甘拜下风。"
                }
            ]
        },
        {
            "talkId": "6957918",
            "initDialog": "695791801",
            "dialogues": [
                {
                    "id": "695791801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}