{
    "groupId": "30065",
    "total_dialogue_lines": 45,
    "speaker_counts": {
        "Player": 9,
        "茅葺一庆": 36
    },
    "talks": [
        {
            "talkId": "4006333",
            "initDialog": "400633301",
            "dialogues": [
                {
                    "id": "400633301",
                    "speaker": "茅葺一庆",
                    "text": "稻妻轻文学界的锐意之作《异邦人喧哗旅》横空出世，要不要翻翻看？"
                }
            ]
        },
        {
            "talkId": "4006334",
            "initDialog": "400633401",
            "dialogues": [
                {
                    "id": "400633401",
                    "speaker": "Player",
                    "text": "《异邦人喧哗旅》？"
                },
                {
                    "id": "400633402",
                    "speaker": "茅葺一庆",
                    "text": "哈哈，这名字很响亮对吧，而且这部作品读起来也相当畅快！"
                },
                {
                    "id": "400633403",
                    "speaker": "茅葺一庆",
                    "text": "《异邦人喧哗旅》这系列小说一定会大受欢迎，我有信心。"
                },
                {
                    "id": "400633404",
                    "speaker": "茅葺一庆",
                    "text": "目前这本《吹向金发武士的死亡之风》仅仅只是系列的第一部，紧承其后的第二、三两部的名字我已经想好了…"
                },
                {
                    "id": "400633405",
                    "speaker": "茅葺一庆",
                    "text": "第二部就叫《花之夺命剑》，第三部就叫《金发武士风中疾走》。"
                },
                {
                    "id": "400633406",
                    "speaker": "茅葺一庆",
                    "text": "呵呵，我这起名的才华真是不一般哪。"
                },
                {
                    "id": "400633407",
                    "speaker": "茅葺一庆",
                    "text": "虽然续作该写些什么…我还没想好，不过这个问题现在不重要。"
                }
            ]
        },
        {
            "talkId": "4006335",
            "initDialog": "400633501",
            "dialogues": [
                {
                    "id": "400633501",
                    "speaker": "Player",
                    "text": "卖得怎么样？"
                },
                {
                    "id": "400633502",
                    "speaker": "茅葺一庆",
                    "text": "……"
                },
                {
                    "id": "400633503",
                    "speaker": "茅葺一庆",
                    "text": "暂时还没有卖出去。"
                }
            ]
        },
        {
            "talkId": "4006336",
            "initDialog": "400633601",
            "dialogues": [
                {
                    "id": "400633601",
                    "speaker": "Player",
                    "text": "一本都没卖出去吗？"
                },
                {
                    "id": "400633602",
                    "speaker": "茅葺一庆",
                    "text": "……"
                },
                {
                    "id": "400633603",
                    "speaker": "茅葺一庆",
                    "text": "嗯…的确。"
                },
                {
                    "id": "400633604",
                    "speaker": "茅葺一庆",
                    "text": "不过，我相信这只是一时的，毕竟，就算是名作家常老师也有过寂寂无名的时期。"
                },
                {
                    "id": "400633605",
                    "speaker": "茅葺一庆",
                    "text": "这种窘境就和话本里的武道试炼一样，也是一种磨炼心性的写作者生涯试炼吧，只要坚持过去…"
                },
                {
                    "id": "400633606",
                    "speaker": "茅葺一庆",
                    "text": "总有一天我的作品会获得认可！"
                }
            ]
        },
        {
            "talkId": "4006337",
            "initDialog": "400633701",
            "dialogues": [
                {
                    "id": "400633701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "400633702",
                    "speaker": "茅葺一庆",
                    "text": "再见再见。"
                },
                {
                    "id": "400633703",
                    "speaker": "茅葺一庆",
                    "text": "欸？说了这么半天，你不打算买一本吗？"
                }
            ]
        },
        {
            "talkId": "7266003",
            "initDialog": "726600301",
            "dialogues": [
                {
                    "id": "726600301",
                    "speaker": "茅葺一庆",
                    "text": "嗨，怎么了吗？",
                    "choices": [
                        {
                            "id": "726600302",
                            "text": "关于小说…",
                            "response": [
                                {
                                    "id": "726600303",
                                    "speaker": "茅葺一庆",
                                    "text": "我小的时候，也是读着话本、小说长大的，也想着长大了要变成像岩藏之胤、喜多院那样武艺高强，斩妖除魔的武者。"
                                },
                                {
                                    "id": "726600304",
                                    "speaker": "茅葺一庆",
                                    "text": "长大了才发现，我实在没那个才能。所以我决定，去写武者的故事。能在字里行间绽放光彩，也算是一种「武道」吧。"
                                },
                                {
                                    "id": "726600305",
                                    "speaker": "茅葺一庆",
                                    "text": "虽然当武官的文胆也不失为一种选择，但我还是更想写像你这样洒脱的异邦战士的故事。"
                                },
                                {
                                    "id": "726600306",
                                    "speaker": "茅葺一庆",
                                    "text": "我很期待你的表现，也很希望能将你的表现写进我的书中。"
                                }
                            ]
                        },
                        {
                            "id": "726600307",
                            "text": "关于「百人一揆」…",
                            "response": [
                                {
                                    "id": "726600308",
                                    "speaker": "茅葺一庆",
                                    "text": "最早是过去的「天狗党人」举办的神秘仪式，旨在宣扬打闹的好处。"
                                },
                                {
                                    "id": "726600309",
                                    "speaker": "茅葺一庆",
                                    "text": "但在他们被取缔后，还是会不时有人秘密举办。举办者的身份至今都笼罩在疑云之中。"
                                },
                                {
                                    "id": "726600310",
                                    "speaker": "茅葺一庆",
                                    "text": "总之，是相当热闹的乱斗大会。无论什么人、甚至是魔物都能参加。"
                                },
                                {
                                    "id": "726600311",
                                    "speaker": "茅葺一庆",
                                    "text": "对于渴求争斗的人来说，再合适不过了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7268203",
            "initDialog": "726820301",
            "dialogues": [
                {
                    "id": "726820301",
                    "speaker": "茅葺一庆",
                    "text": "嗨，怎么了吗？",
                    "choices": [
                        {
                            "id": "726820302",
                            "text": "关于小说…",
                            "response": [
                                {
                                    "id": "726820303",
