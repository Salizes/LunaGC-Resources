{
    "groupId": "6214",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "希皮利": 10
    },
    "talks": [
        {
            "talkId": "6621401",
            "initDialog": "662140101",
            "dialogues": [
                {
                    "id": "662140101",
                    "speaker": "希皮利",
                    "text": "只要能达到目的，换个办法应该也可以吧！"
                }
            ]
        },
        {
            "talkId": "6621402",
            "initDialog": "662140201",
            "dialogues": [
                {
                    "id": "662140201",
                    "speaker": "Player",
                    "text": "你是说…"
                },
                {
                    "id": "662140202",
                    "speaker": "希皮利",
                    "text": "你看，我是专门做手工艺品的，在这里开了家小店。"
                },
                {
                    "id": "662140203",
                    "speaker": "希皮利",
                    "text": "大家都说烟谜主做的东西有特别的功效，所以生意一直不错。"
                },
                {
                    "id": "662140204",
                    "speaker": "希皮利",
                    "text": "而我的诀窍呢，就是先不要问客人具体要什么东西，而是先问他们想做什么事情。"
                },
                {
                    "id": "662140205",
                    "speaker": "希皮利",
                    "text": "打个比方的话…如果有人想要做个美食探测器，我会建议他跟紧自己身边最喜欢吃东西的人。"
                },
                {
                    "id": "662140206",
                    "speaker": "希皮利",
                    "text": "很简单的道理吧？"
                }
            ]
        },
        {
            "talkId": "6621403",
            "initDialog": "662140301",
            "dialogues": [
                {
                    "id": "662140301",
                    "speaker": "Player",
                    "text": "有道理。"
                },
                {
                    "id": "662140302",
                    "speaker": "希皮利",
                    "text": "嗯，是这样的。"
                }
            ]
        },
        {
            "talkId": "6621404",
            "initDialog": "662140401",
            "dialogues": [
                {
                    "id": "662140401",
                    "speaker": "Player",
                    "text": "但那样生意不就…"
                },
                {
                    "id": "662140402",
                    "speaker": "希皮利",
                    "text": "道理不是这样讲的。"
                },
                {
                    "id": "662140403",
                    "speaker": "希皮利",
                    "text": "因为你想，究竟怎么才能做出美食探测器嘛。"
                },
                {
                    "id": "662140404",
                    "speaker": "希皮利",
                    "text": "面对自己接不了的委托，帮客人找个别的办法，总比直接说自己做不到强吧。"
                }
            ]
        }
    ]
}