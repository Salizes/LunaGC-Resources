{
    "groupId": "1786",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "林德曼": 10
    },
    "talks": [
        {
            "talkId": "6178601",
            "initDialog": "617860101",
            "dialogues": [
                {
                    "id": "617860101",
                    "speaker": "林德曼",
                    "text": "和运输一样，事事都是安全第一呀…"
                }
            ]
        },
        {
            "talkId": "6178602",
            "initDialog": "617860201",
            "dialogues": [
                {
                    "id": "617860201",
                    "speaker": "Player",
                    "text": "这里有什么不安全的事吗？"
                },
                {
                    "id": "617860202",
                    "speaker": "林德曼",
                    "text": "唉…荆夫港当然安全，我担心的是我女儿艾玫嘉。"
                },
                {
                    "id": "617860203",
                    "speaker": "林德曼",
                    "text": "不怕你笑话，我女儿作为德曼海文家族的继承人，最近居然让一个油嘴滑舌的小子骗得神魂颠倒的…"
                },
                {
                    "id": "617860204",
                    "speaker": "林德曼",
                    "text": "你看，我也不是什么冥顽不化的人。作为古恩希尔德的分家，我们的家训是「航往自由」，我当然也支持年轻人自由恋爱…"
                },
                {
                    "id": "617860205",
                    "speaker": "林德曼",
                    "text": "但是！那小子可是个水手啊！"
                }
            ]
        },
        {
            "talkId": "6178603",
            "initDialog": "617860301",
            "dialogues": [
                {
                    "id": "617860301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617860302",
                    "speaker": "林德曼",
                    "text": "再见，年轻人。"
                }
            ]
        },
        {
            "talkId": "6178604",
            "initDialog": "617860401",
            "dialogues": [
                {
                    "id": "617860401",
                    "speaker": "Player",
                    "text": "水手怎么了？"
                },
                {
                    "id": "617860402",
                    "speaker": "林德曼",
                    "text": "唉，水手是没什么问题…但你要知道，这几年，有个年轻的水手，从遗珑埠到贝洛沃迪港，在每个港口都骗到过几个相好的姑娘。"
                },
                {
                    "id": "617860403",
                    "speaker": "林德曼",
                    "text": "虽然我不记得那混账的名字了，但你想想，一般的水手能把我女儿迷成这样吗？"
                },
                {
                    "id": "617860404",
                    "speaker": "林德曼",
                    "text": "为了艾玫嘉的幸福，我得严防死守才行…"
                }
            ]
        },
        {
            "talkId": "6178605",
            "initDialog": "617860501",
            "dialogues": [
                {
                    "id": "617860501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "6178606",
            "initDialog": "617860601",
            "dialogues": [
                {
                    "id": "617860601",
                    "speaker": "林德曼",
                    "text": "附近嘛…最近倒是安宁的很，先前航往璃月与枫丹的商船也都顺利返航了。安全第一，安全第一呀…"
                }
            ]
        }
    ]
}