{
    "groupId": "1547",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "伊尔佳": 16
    },
    "talks": [
        {
            "talkId": "7092401",
            "initDialog": "709240101",
            "dialogues": [
                {
                    "id": "709240101",
                    "speaker": "Player",
                    "text": "冒险进行得怎么样？"
                },
                {
                    "id": "709240102",
                    "speaker": "伊尔佳",
                    "text": "还挺顺利的，截至目前已经将醉汉峡、清泉镇附近的地图校注完成了…"
                },
                {
                    "id": "709240103",
                    "speaker": "伊尔佳",
                    "text": "给地图做校注还真是一件让人疲劳的事情啊，但也很有成就感…莫非，你对我的工作感兴趣？"
                },
                {
                    "id": "709240104",
                    "speaker": "伊尔佳",
                    "text": "既然感兴趣就收下这些吧，这是我的一些冒险心得…迟早有一天，全蒙德都会用上我的地图！"
                }
            ]
        },
        {
            "talkId": "6154701",
            "initDialog": "615470101",
            "dialogues": [
                {
                    "id": "615470101",
                    "speaker": "伊尔佳",
                    "text": "哇啊！吓死我了！请不要在别人全神贯注的时候偷偷摸摸靠近好吗！"
                }
            ]
        },
        {
            "talkId": "6154702",
            "initDialog": "615470201",
            "dialogues": [
                {
                    "id": "615470201",
                    "speaker": "Player",
                    "text": "明明是你鬼鬼祟祟的吧？"
                },
                {
                    "id": "615470202",
                    "speaker": "伊尔佳",
                    "text": "说谁鬼鬼祟祟的？"
                },
                {
                    "id": "615470203",
                    "speaker": "伊尔佳",
                    "text": "我是预备传奇冒险家伊尔佳，记住这个名字，因为它马上就要永垂史册了！",
                    "choices": [
                        {
                            "id": "615470204",
                            "text": "「预备」？",
                            "response": [
                                {
                                    "id": "615470205",
                                    "speaker": "伊尔佳",
                                    "text": "就是…现在还没名气啦，你问那么多干什么！"
                                },
                                {
                                    "id": "615470206",
                                    "speaker": "伊尔佳",
                                    "text": "唉…要是我有「神之眼」就好了，神到底什么时候才会认可我的意志呢？"
                                },
                                {
                                    "id": "615470207",
                                    "speaker": "伊尔佳",
                                    "text": "能运用元素的力量的话，一定能开辟出一条自己的道路吧。"
                                }
                            ]
                        },
                        {
                            "id": "615470208",
                            "text": "你在做什么？",
                            "response": [
                                {
                                    "id": "615470209",
                                    "speaker": "伊尔佳",
                                    "text": "我正在勘察清泉镇周边的山地，为过去的地理地图做校注。"
                                },
                                {
                                    "id": "615470210",
                                    "speaker": "伊尔佳",
                                    "text": "虽说很多地形经历时代变迁也未改变，但也有一些地方的位置在现存的文献中模糊难辨…"
                                },
                                {
                                    "id": "615470211",
                                    "speaker": "伊尔佳",
                                    "text": "不过等我完成了蒙德地图全校，一定能在全提瓦特成名的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6154703",
            "initDialog": "615470301",
            "dialogues": [
                {
                    "id": "615470301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615470302",
                    "speaker": "伊尔佳",
                    "text": "不要再来打扰我了！"
                }
            ]
        },
        {
            "talkId": "6154704",
            "initDialog": "615470401",
            "dialogues": [
                {
                    "id": "615470401",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "615470402",
                    "speaker": "伊尔佳",
                    "text": "你是在找人吗？不好意思，我没什么印象了。"
                },
                {
                    "id": "615470403",
                    "speaker": "伊尔佳",
                    "text": "我近期在给蒙德地图做校注，现在我的双眼只能看到山川与河流…"
                },
                {
                    "id": "615470404",
                    "speaker": "伊尔佳",
                    "text": "…做事就是要全心投入才能做好，不是吗？"
                }
            ]
        }
    ]
}