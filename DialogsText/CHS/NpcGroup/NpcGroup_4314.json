{
    "groupId": "4314",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "阿斯法德": 13
    },
    "talks": [
        {
            "talkId": "6431401",
            "initDialog": "643140101",
            "dialogues": [
                {
                    "id": "643140101",
                    "speaker": "阿斯法德",
                    "text": "我是「聚砂厅」的顾问阿斯法德，愿意为你解答任何疑问。"
                }
            ]
        },
        {
            "talkId": "6431402",
            "initDialog": "643140201",
            "dialogues": [
                {
                    "id": "643140201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "643140202",
                    "speaker": "阿斯法德",
                    "text": "你好，这里是「聚砂厅」，也就是守卫须弥城的镀金旅团「三十人团」的驻地。"
                },
                {
                    "id": "643140203",
                    "speaker": "阿斯法德",
                    "text": "我虽然已经退休，但因为在「三十人团」和其他旅团中都任过职，所以被鲁克沙请来做相关的顾问。"
                },
                {
                    "id": "643140204",
                    "speaker": "阿斯法德",
                    "text": "如果发生了意外的冲突，可以叫我出面解决。"
                }
            ]
        },
        {
            "talkId": "6431403",
            "initDialog": "643140301",
            "dialogues": [
                {
                    "id": "643140301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643140302",
                    "speaker": "阿斯法德",
                    "text": "祝你旅途顺利。"
                }
            ]
        },
        {
            "talkId": "6431404",
            "initDialog": "643140401",
            "dialogues": [
                {
                    "id": "643140401",
                    "speaker": "阿斯法德",
                    "text": "这不是迪希雅的朋友吗，欢迎来到「聚砂厅」。"
                }
            ]
        },
        {
            "talkId": "6431405",
            "initDialog": "643140501",
            "dialogues": [
                {
                    "id": "643140501",
                    "speaker": "Player",
                    "text": "又见面了。"
                },
                {
                    "id": "643140502",
                    "speaker": "阿斯法德",
                    "text": "你好啊。到了这把年纪，能再见到熟悉的面孔真不错。"
                },
                {
                    "id": "643140503",
                    "speaker": "阿斯法德",
                    "text": "我和鲁克沙之前还在念叨，迪希雅这次的委托接的不错，不仅认识了呼玛伊家的小姐，还交到了新朋友呢。"
                },
                {
                    "id": "643140504",
                    "speaker": "阿斯法德",
                    "text": "迪希雅是很可靠的伙伴，在「三十人团」里也算是能力数一数二的好手了。就是有时说话太过直率，你多担待。"
                },
                {
                    "id": "643140505",
                    "speaker": "阿斯法德",
                    "text": "像镀金旅团这样总是需要出远门接活的人，同伴多一些总是好的。"
                }
            ]
        },
        {
            "talkId": "6431406",
            "initDialog": "643140601",
            "dialogues": [
                {
                    "id": "643140601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643140602",
                    "speaker": "阿斯法德",
                    "text": "祝你旅途顺利。"
                }
            ]
        },
        {
            "talkId": "6431407",
            "initDialog": "643140701",
            "dialogues": [
                {
                    "id": "643140701",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6431408",
            "initDialog": "643140801",
            "dialogues": [
                {
                    "id": "643140801",
                    "speaker": "阿斯法德",
                    "text": "嗯，真是败在了完全想不到的地方，视线狭隘，就看不到胜机啊。"
                }
            ]
        },
        {
            "talkId": "6431409",
            "initDialog": "643140901",
            "dialogues": [
                {
                    "id": "643140901",
                    "speaker": "阿斯法德",
                    "text": "哈哈，获胜还真是令人愉快。"
                }
            ]
        }
    ]
}