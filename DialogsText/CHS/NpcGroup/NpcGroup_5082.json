{
    "groupId": "5082",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "柯妮莉娅": 8
    },
    "talks": [
        {
            "talkId": "6508201",
            "initDialog": "650820101",
            "dialogues": [
                {
                    "id": "650820101",
                    "speaker": "柯妮莉娅",
                    "text": "你好，请问你要去哪里？"
                }
            ]
        },
        {
            "talkId": "6508202",
            "initDialog": "650820201",
            "dialogues": [
                {
                    "id": "650820201",
                    "speaker": "Player",
                    "text": "我、我只是看看…"
                },
                {
                    "id": "650820202",
                    "speaker": "柯妮莉娅",
                    "text": "啊，原来是来参观的客人。"
                },
                {
                    "id": "650820203",
                    "speaker": "柯妮莉娅",
                    "text": "抱歉，我以为你是来办公事的市民。"
                },
                {
                    "id": "650820204",
                    "speaker": "柯妮莉娅",
                    "text": "因为我的座位被安排在最靠门的地方，所以来的人都很喜欢找我问路。"
                }
            ]
        },
        {
            "talkId": "6508203",
            "initDialog": "650820301",
            "dialogues": [
                {
                    "id": "650820301",
                    "speaker": "Player",
                    "text": "不麻烦了。"
                },
                {
                    "id": "650820302",
                    "speaker": "柯妮莉娅",
                    "text": "那么再见。"
                }
            ]
        },
        {
            "talkId": "6508204",
            "initDialog": "650820401",
            "dialogues": [
                {
                    "id": "650820401",
                    "speaker": "Player",
                    "text": "真是辛苦你了。"
                },
                {
                    "id": "650820402",
                    "speaker": "柯妮莉娅",
                    "text": "没关系，我并不觉得辛苦。"
                },
                {
                    "id": "650820403",
                    "speaker": "柯妮莉娅",
                    "text": "更多的交流会为平淡的生活增添色彩，也能让人的头脑更加灵活。"
                },
                {
                    "id": "650820404",
                    "speaker": "柯妮莉娅",
                    "text": "在这里工作越久，你就越能感受到灵活是多么难能可贵的品德。"
                }
            ]
        }
    ]
}