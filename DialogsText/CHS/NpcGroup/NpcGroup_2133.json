    "talks": [
        {
            "talkId": "6213301",
            "initDialog": "621330101",
            "dialogues": [
                {
                    "id": "621330101",
                    "speaker": "卡斯帕",
                    "text": "……"
                },
                {
                    "id": "621330102",
                    "speaker": "卡斯帕",
                    "text": "啊，你好！我看风景有些入迷了。"
                }
            ]
        },
        {
            "talkId": "6213302",
            "initDialog": "621330201",
            "dialogues": [
                {
                    "id": "621330201",
                    "speaker": "Player",
                    "text": "风景如何？"
                },
                {
                    "id": "621330202",
                    "speaker": "卡斯帕",
                    "text": "实在是太棒了，跟我的家乡枫丹完全不一样啊！"
                },
                {
                    "id": "621330203",
                    "speaker": "卡斯帕",
                    "text": "即便是我路过时瞟到过的「庆云顶」，那在大雾中只能看轮廓的山峦，也是别有一番韵味啊…"
                },
                {
                    "id": "621330204",
                    "speaker": "卡斯帕",
                    "text": "此情此景，真是不禁想让人像璃月的诗人一样吟诗一首！"
                },
                {
                    "id": "621330205",
                    "speaker": "卡斯帕",
                    "text": "你看这山！…那什么，侧看有如…有如什么呢…"
                },
                {
                    "id": "621330206",
                    "speaker": "卡斯帕",
                    "text": "…算了，这山真棒啊！"
                }
            ]
        },
        {
            "talkId": "6213303",
            "initDialog": "621330301",
            "dialogues": [
                {
                    "id": "621330301",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "621330302",
                    "speaker": "卡斯帕",
                    "text": "再见！真希望在我的家乡也可以看到这样的景色啊！"
                }
            ]
        }
    ]
}