{
    "groupId": "9369",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "菲米尼": 9
    },
    "talks": [
        {
            "talkId": "6936901",
            "initDialog": "693690101",
            "dialogues": [
                {
                    "id": "693690101",
                    "speaker": "菲米尼",
                    "text": "那个，请问，接下来的任务还没开始吗？"
                },
                {
                    "id": "693690102",
                    "speaker": "菲米尼",
                    "text": "就算是休息时间，但什么也不做的话，总感觉心里空荡荡的。"
                },
                {
                    "id": "693690103",
                    "speaker": "菲米尼",
                    "text": "有点想戴上头盔，或者挪去墙角…可以吗？"
                }
            ]
        },
        {
            "talkId": "6936902",
            "initDialog": "693690201",
            "dialogues": [
                {
                    "id": "693690201",
                    "speaker": "菲米尼",
                    "text": "接下来的任务好像并不轻松，但我会执行你的指令。"
                },
                {
                    "id": "693690202",
                    "speaker": "菲米尼",
                    "text": "我刚刚为佩伊重新做了检查，它的状态不错，等下上场时它应该会更灵活一些。"
                },
                {
                    "id": "693690203",
                    "speaker": "菲米尼",
                    "text": "你有其他机械需要修理吗？我想我可以帮忙。"
                }
            ]
        },
        {
            "talkId": "6936903",
            "initDialog": "693690301",
            "dialogues": [
                {
                    "id": "693690301",
                    "speaker": "菲米尼",
                    "text": "这里的童话书都好有趣！跟我平时读的作品不太一样。"
                },
                {
                    "id": "693690302",
                    "speaker": "菲米尼",
                    "text": "机会难得。我应该多读几遍把它们背下来吗？还是找本本子，把它们誊抄下来呢？"
                },
                {
                    "id": "693690303",
                    "speaker": "菲米尼",
                    "text": "随时都可能有新的任务…我得抓紧时间了。"
                }
            ]
        }
    ]
}