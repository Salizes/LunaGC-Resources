{
    "groupId": "2404",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "老周叔": 13
    },
    "talks": [
        {
            "talkId": "6240401",
            "initDialog": "624040101",
            "dialogues": [
                {
                    "id": "624040101",
                    "speaker": "老周叔",
                    "text": "客人您好，请来这边坐！"
                }
            ]
        },
        {
            "talkId": "6240402",
            "initDialog": "624040201",
            "dialogues": [
                {
                    "id": "624040201",
                    "speaker": "Player",
                    "text": "这里是…？"
                },
                {
                    "id": "624040202",
                    "speaker": "老周叔",
                    "text": "这里是石门，过了这儿，再往南走就是璃月了！"
                },
                {
                    "id": "624040203",
                    "speaker": "老周叔",
                    "text": "客人您来点茶水吗？"
                }
            ]
        },
        {
            "talkId": "6240403",
            "initDialog": "624040301",
            "dialogues": [
                {
                    "id": "624040301",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "624040302",
                    "speaker": "老周叔",
                    "text": "我是这个茶摊的主人，小本生意，赚不来多少钱。不过啊，故事倒是不少。"
                },
                {
                    "id": "624040303",
                    "speaker": "老周叔",
                    "text": "嘿嘿…在这开一个茶摊，最享受的莫过于看行人来来往往，再随便听听故事。"
                },
                {
                    "id": "624040304",
                    "speaker": "Player",
                    "text": "故事…？"
                },
                {
                    "id": "624040305",
                    "speaker": "老周叔",
                    "text": "客人您看，我也是一身老骨头了。"
                },
                {
                    "id": "624040306",
                    "speaker": "老周叔",
                    "text": "这辈子没经历过什么大风大浪，过得也还算安稳踏实…"
                },
                {
                    "id": "624040307",
                    "speaker": "老周叔",
                    "text": "可人老了，总觉得少了点什么。"
                },
                {
                    "id": "624040308",
                    "speaker": "老周叔",
                    "text": "于是，我就带着些盘缠离开了轻策山…"
                },
                {
                    "id": "624040309",
                    "speaker": "老周叔",
                    "text": "从轻策庄出来啊，我就决定在这里开一个摊子，啥也不干，就听人讲故事，也给人讲故事…过得也挺好的。"
                }
            ]
        },
        {
            "talkId": "6240404",
            "initDialog": "624040401",
            "dialogues": [
                {
                    "id": "624040401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624040402",
                    "speaker": "老周叔",
                    "text": "欸，客人慢走！"
                },
                {
                    "id": "624040403",
                    "speaker": "老周叔",
                    "text": "浮萍一生，莫抱憾告老…"
                }
            ]
        },
        {
            "talkId": "6240405",
            "initDialog": "624040501",
            "dialogues": [
                {
                    "id": "624040501",
                    "speaker": "Player",
                    "text": "请给我来些茶水。"
                },
                {
                    "id": "624040502",
                    "speaker": "老周叔",
                    "text": "虽然我这儿卖的不是什么名茶，但味道一点都不差，来尝尝吧！"
                }
            ]
        }
    ]
}