{
    "groupId": "4163",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "凯万": 6
    },
    "talks": [
        {
            "talkId": "6416301",
            "initDialog": "641630101",
            "dialogues": [
                {
                    "id": "641630101",
                    "speaker": "凯万",
                    "text": "海边的生活虽然悠闲，但偶尔也会有危险发生，不可掉以轻心。"
                }
            ]
        },
        {
            "talkId": "6416302",
            "initDialog": "641630201",
            "dialogues": [
                {
                    "id": "641630201",
                    "speaker": "Player",
                    "text": "海边的危险…"
                },
                {
                    "id": "641630202",
                    "speaker": "凯万",
                    "text": "在须弥的沿海，会出现海兽袭击事件，海边的居民和渔夫们经常因此受伤，商船也颇受影响。"
                },
                {
                    "id": "641630203",
                    "speaker": "凯万",
                    "text": "幸好大家熟悉海洋情况，自我保护意识很强，再加上镀金旅团的帮助，才没有发生过比较大的伤亡。"
                },
                {
                    "id": "641630204",
                    "speaker": "凯万",
                    "text": "后来渐渐地，有教令院的学者过来研究海兽袭击的规律，防范工作也做得越来越好了。"
                },
                {
                    "id": "641630205",
                    "speaker": "凯万",
                    "text": "不过也不能因为情况好转就大意了啊，一定要随时观察海洋，遇到情况必须听从指引。"
                }
            ]
        },
        {
            "talkId": "6416303",
            "initDialog": "641630301",
            "dialogues": [
                {
                    "id": "641630301",
                    "speaker": "Player",
                    "text": "明白了。"
                },
                {
                    "id": "641630302",
                    "speaker": "凯万",
                    "text": "好，要注意安全啊。"
                }
            ]
        }
    ]
}