    "talks": [
        {
            "talkId": "6745901",
            "initDialog": "674590101",
            "dialogues": [
                {
                    "id": "674590101",
                    "speaker": "津年科",
                    "text": "各方面的能力都欠缺，该怎么办啊…"
                }
            ]
        },
        {
            "talkId": "6745902",
            "initDialog": "674590201",
            "dialogues": [
                {
                    "id": "674590201",
                    "speaker": "Player",
                    "text": "能力？"
                },
                {
                    "id": "674590202",
                    "speaker": "津年科",
                    "text": "唉…我在之前的演习中拿到了非常不错的成绩，才有幸被调到第一特殊任务营。"
                },
                {
                    "id": "674590203",
                    "speaker": "津年科",
                    "text": "结果没想到，在同僚们面前，我以前拿到的分数，都是小巫见大巫。"
                },
                {
                    "id": "674590204",
                    "speaker": "津年科",
                    "text": "他们一个个都像是人形机器，不管执行什么任务，都能在瓦列里少校的指挥下，像钟表一样把控时间…"
                },
                {
                    "id": "674590205",
                    "speaker": "津年科",
                    "text": "要跟上同僚们的节奏，实在非常吃力…"
                },
                {
                    "id": "674590206",
                    "speaker": "津年科",
                    "text": "好在瓦列里少校给了我不少适应时间，我得抓住这个机会，好好淬炼自己才行。"
                }
            ]
        },
        {
            "talkId": "6745903",
            "initDialog": "674590301",
            "dialogues": [
                {
                    "id": "674590301",
                    "speaker": "Player",
                    "text": "你加油。"
                },
                {
                    "id": "674590302",
                    "speaker": "津年科",
                    "text": "谢谢，我会尽全力的。"
                }
            ]
        }
    ]
}