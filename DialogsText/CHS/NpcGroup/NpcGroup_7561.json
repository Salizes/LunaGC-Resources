{
    "groupId": "7561",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "莱茜汀娜": 7
    },
    "talks": [
        {
            "talkId": "6756101",
            "initDialog": "675610101",
            "dialogues": [
                {
                    "id": "675610101",
                    "speaker": "莱茜汀娜",
                    "text": "今天的克什尼克之炬的运作怎么样呢…"
                }
            ]
        },
        {
            "talkId": "6756102",
            "initDialog": "675610201",
            "dialogues": [
                {
                    "id": "675610201",
                    "speaker": "Player",
                    "text": "大火炬状态如何？"
                },
                {
                    "id": "675610202",
                    "speaker": "莱茜汀娜",
                    "text": "听声音，排气管道有些许的堵塞…不过并没有造成运行上的阻碍，得想办法清理一下…"
                },
                {
                    "id": "675610203",
                    "speaker": "莱茜汀娜",
                    "text": "嘿嘿，不过，这个克什尼克之炬可算不上大，最大的那个在至冬堡的地下呢。"
                }
            ]
        },
        {
            "talkId": "6756103",
            "initDialog": "675610301",
            "dialogues": [
                {
                    "id": "675610301",
                    "speaker": "Player",
                    "text": "至冬有好多克什尼克之炬…"
                },
                {
                    "id": "675610302",
                    "speaker": "莱茜汀娜",
                    "text": "嗯，毕竟单纯靠一个巨大的克什尼克之炬以令热量覆盖整片冻土被证明是无法达成的幻想了…"
                },
                {
                    "id": "675610303",
                    "speaker": "莱茜汀娜",
                    "text": "所以至冬实际上的情况就是利用克什尼克之炬为点，列车与铁路为线，以此规划大家能够生活的区域。"
                },
                {
                    "id": "675610304",
                    "speaker": "莱茜汀娜",
                    "text": "…这样也能规避热量运输过程过长导致的损耗嘛。"
                }
            ]
        },
        {
            "talkId": "6756104",
            "initDialog": "675610401",
            "dialogues": [
                {
                    "id": "675610401",
                    "speaker": "Player",
                    "text": "希望检查顺利。"
                },
                {
                    "id": "675610402",
                    "speaker": "莱茜汀娜",
                    "text": "会的，作为能源协会的管理人员，这对我来说可谓是轻车熟路啦。"
                }
            ]
        }
    ]
}