{
    "groupId": "9329",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "胡桃": 9
    },
    "talks": [
        {
            "talkId": "6932901",
            "initDialog": "693290101",
            "dialogues": [
                {
                    "id": "693290101",
                    "speaker": "胡桃",
                    "text": "要是不急着出发，那就在这里多休息一会儿。"
                },
                {
                    "id": "693290102",
                    "speaker": "胡桃",
                    "text": "俗话说得好，猫咪睡觉老鼠闹，醒来一样全吃掉。"
                },
                {
                    "id": "693290103",
                    "speaker": "胡桃",
                    "text": "该是你的，就总是你的喽？"
                }
            ]
        },
        {
            "talkId": "6932902",
            "initDialog": "693290201",
            "dialogues": [
                {
                    "id": "693290201",
                    "speaker": "胡桃",
                    "text": "明知山有虎，偏往虎山行。看你的表情就知道，你肯定是想继续深入秘境啦。"
                },
                {
                    "id": "693290202",
                    "speaker": "胡桃",
                    "text": "不用担心，有本堂主在，能够帮你应对一切正常的和不正常的情况。"
                },
                {
                    "id": "693290203",
                    "speaker": "胡桃",
                    "text": "说走就走？别让魔物等急啦。"
                }
            ]
        },
        {
            "talkId": "6932903",
            "initDialog": "693290301",
            "dialogues": [
                {
                    "id": "693290301",
                    "speaker": "胡桃",
                    "text": "长大之后，我试着读过一些流行小说，有的喜欢在结尾时突然把死者复活，然后皆大欢喜。"
                },
                {
                    "id": "693290302",
                    "speaker": "胡桃",
                    "text": "啧啧啧。就算是在故事的世界里，死的人突然活了，那之前的经历又算什么？"
                },
                {
                    "id": "693290303",
                    "speaker": "胡桃",
                    "text": "「生于生时，亡于亡刻」，能保证这一点才算圆满呢。"
                }
            ]
        }
    ]
}