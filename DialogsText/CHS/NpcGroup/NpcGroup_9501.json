            "dialogues": [
                {
                    "id": "695010101",
                    "speaker": "菲谢尔",
                    "text": "对拥有「断罪之眼」的本皇女来说，这种用卡牌组构的游戏简直轻而易举。"
                }
            ]
        },
        {
            "talkId": "6950102",
            "initDialog": "695010201",
            "dialogues": [
                {
                    "id": "695010201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6950103",
            "initDialog": "695010301",
            "dialogues": [
                {
                    "id": "695010301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695010302",
                    "speaker": "菲谢尔",
                    "text": "要离席了吗？无妨，本皇女稍后也要歇憩了。"
                }
            ]
        },
        {
            "talkId": "6950104",
            "initDialog": "695010401",
            "dialogues": [
                {
                    "id": "695010401",
                    "speaker": "菲谢尔",
                    "text": "真实与虚构编织而成的卡牌之戏，皆在本皇女掌间。"
                }
            ]
        },
        {
            "talkId": "6950105",
            "initDialog": "695010501",
            "dialogues": [
                {
                    "id": "695010501",
                    "speaker": "菲谢尔",
                    "text": "本皇女的命运之敌…遮蔽了卡牌的「因果流向」吗…"
                }
            ]
        },
        {
            "talkId": "6950106",
            "initDialog": "695010601",
            "dialogues": [
                {
                    "id": "695010601",
                    "speaker": "菲谢尔",
                    "text": "幽幕为我拉开，让幻夜示现汝等的归宿吧！"
                }
            ]
        },
        {
            "talkId": "6950107",
            "initDialog": "695010701",
            "dialogues": [
                {
                    "id": "695010701",
                    "speaker": "菲谢尔",
                    "text": "幽幕为我拉开，让幻夜示现汝等的归宿吧！"
