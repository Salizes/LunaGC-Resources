{
    "groupId": "7655",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "阿格拉娅": 11
    },
    "talks": [
        {
            "talkId": "6765501",
            "initDialog": "676550101",
            "dialogues": [
                {
                    "id": "676550101",
                    "speaker": "阿格拉娅",
                    "text": "客人，还请遵守馆内的规定。"
                }
            ]
        },
        {
            "talkId": "6765502",
            "initDialog": "676550201",
            "dialogues": [
                {
                    "id": "676550201",
                    "speaker": "Player",
                    "text": "梅诗金是谁…"
                },
                {
                    "id": "676550202",
                    "speaker": "阿格拉娅",
                    "text": "可能是某位应该来参加典礼的客人的名字。"
                },
                {
                    "id": "676550203",
                    "speaker": "阿格拉娅",
                    "text": "或许，对于希望他出现的人来说，是很重要的客人吧…"
                }
            ]
        },
        {
            "talkId": "6765503",
            "initDialog": "676550301",
            "dialogues": [
                {
                    "id": "676550301",
                    "speaker": "Player",
                    "text": "关于馆内的规矩…"
                },
                {
                    "id": "676550302",
                    "speaker": "阿格拉娅",
                    "text": "哦，还需要再重复一遍吗？"
                },
                {
                    "id": "676550303",
                    "speaker": "阿格拉娅",
                    "text": "仪式会在<color=#00E1FFFF>钟响八声</color>之后开始，听到钟声后不要耽搁，即刻前往礼堂吧。"
                },
                {
                    "id": "676550304",
                    "speaker": "阿格拉娅",
                    "text": "在那之前，你们可以在馆内的大厅自由活动，其他的房间则不对客人开放。"
                }
            ]
        },
        {
            "talkId": "6765504",
            "initDialog": "676550401",
            "dialogues": [
                {
                    "id": "676550401",
                    "speaker": "阿格拉娅",
                    "text": "啊…梅诗金，梅诗金…怎么会，你怎么会已经…"
                }
            ]
        },
        {
            "talkId": "6765505",
            "initDialog": "676550501",
            "dialogues": [
                {
                    "id": "676550501",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "676550502",
                    "speaker": "阿格拉娅",
                    "text": "我…我的梅诗金，我竟然忘了他曾经来过，我忘了…他也被这个仪式卷入…"
                },
                {
                    "id": "676550503",
                    "speaker": "阿格拉娅",
                    "text": "我在这里等待了…等待了那么久…"
                },
                {
                    "id": "676550504",
                    "speaker": "阿格拉娅",
                    "text": "呜呜…竟然连他已经…都忘了…"
                }
            ]
        },
        {
            "talkId": "6765506",
            "initDialog": "676550601",
            "dialogues": [
                {
                    "id": "676550601",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "676550602",
                    "speaker": "阿格拉娅",
                    "text": "这一定是…对我的惩罚，要是我有勇气走出公馆，而不是想办法令他来寻我…呜…"
                }
            ]
        }
    ]
}