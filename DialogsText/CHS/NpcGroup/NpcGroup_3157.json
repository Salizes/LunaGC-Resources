    "talks": [
        {
            "talkId": "6315701",
            "initDialog": "631570101",
            "dialogues": [
                {
                    "id": "631570101",
                    "speaker": "小野",
                    "text": "嗯？你是从国外来稻妻旅行的人吗？"
                },
                {
                    "id": "631570102",
                    "speaker": "小野",
                    "text": "真是怪人，不去稻妻城吃喝游玩，却在这种危险的鬼地方闲逛。"
                }
            ]
        },
        {
            "talkId": "6315702",
            "initDialog": "631570201",
            "dialogues": [
                {
                    "id": "631570201",
                    "speaker": "Player",
                    "text": "关于战争…"
                },
                {
                    "id": "631570202",
                    "speaker": "小野",
                    "text": "都怪珊瑚宫那些不敬雷神的刁民，不仅不听从将军大人的命令，还要挑起纷争。"
                },
                {
                    "id": "631570203",
                    "speaker": "小野",
                    "text": "如果他们肯乖乖交出那个什么神之眼，这里就不用打仗了。我也就能回城里，在乌有亭好好喝一杯了。"
                },
                {
                    "id": "631570204",
                    "speaker": "小野",
                    "text": "唉，战争可真不是什么好东西。"
                }
            ]
        },
        {
            "talkId": "6315703",
            "initDialog": "631570301",
            "dialogues": [
                {
                    "id": "631570301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631570302",
                    "speaker": "小野",
                    "text": "再见，真搞不懂你。"
                }
            ]
        },
        {
            "talkId": "6315704",
            "initDialog": "631570401",
            "dialogues": [
                {
                    "id": "631570401",
                    "speaker": "小野",
                    "text": "嗯？你是从国外来稻妻旅行的人吗？"
                },
                {
                    "id": "631570402",
                    "speaker": "小野",
                    "text": "真是怪人，不去稻妻城吃喝游玩，却在这种危险的鬼地方闲逛。"
                }
            ]
        },
        {
            "talkId": "6315705",
            "initDialog": "631570501",
            "dialogues": [
                {
                    "id": "631570501",
                    "speaker": "Player",
                    "text": "关于战争…"
                },
                {
                    "id": "631570502",
                    "speaker": "小野",
                    "text": "在此之前，我想过很多种战况的走向。也许幕府会用绝对的战力优势击溃反抗军，也许反抗军会迫于压力投降…"
                },
                {
                    "id": "631570503",
                    "speaker": "小野",
                    "text": "但我万万没想到，幕府不仅没有占到便宜，甚至最后还和反抗军谈和了…"
                },
                {
                    "id": "631570504",
                    "speaker": "小野",
                    "text": "说实话，我对幕府上面的决策有些失望，但对休战一事又倍感庆幸。"
                },
                {
                    "id": "631570505",
                    "speaker": "小野",
                    "text": "作为一个普普通通的稻妻人，有谁真的想去战场上厮杀呢，你说对吧。"
                }
            ]
        },
        {
            "talkId": "6315706",
            "initDialog": "631570601",
            "dialogues": [
                {
                    "id": "631570601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631570602",
                    "speaker": "小野",
                    "text": "再见啦。"
                }
            ]
        }
    ]
}