            "dialogues": [
                {
                    "id": "624060101",
                    "speaker": "辉子",
                    "text": "这位英雄！救我！能帮我把那只狗赶走吗！"
                }
            ]
        },
        {
            "talkId": "6240602",
            "initDialog": "624060201",
            "dialogues": [
                {
                    "id": "624060201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624060202",
                    "speaker": "辉子",
                    "text": "我是盗…到、到这里旅游的外地人！那个…你还是先把狗赶走吧！"
                }
            ]
        },
        {
            "talkId": "6240603",
            "initDialog": "624060301",
            "dialogues": [
                {
                    "id": "624060301",
                    "speaker": "Player",
                    "text": "可是…它好像很喜欢你呢。"
                },
                {
                    "id": "624060302",
                    "speaker": "辉子",
                    "text": "这哪里像喜欢了啊！它一路追我到这里的！还咬我裤腿！"
                }
            ]
        },
        {
            "talkId": "6240604",
            "initDialog": "624060401",
            "dialogues": [
                {
                    "id": "624060401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624060402",
                    "speaker": "辉子",
                    "text": "别走！救救我！"
                }
            ]
        }
    ]
