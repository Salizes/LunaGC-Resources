{
    "groupId": "6023",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "艾库瓦": 12
    },
    "talks": [
        {
            "talkId": "6602301",
            "initDialog": "660230101",
            "dialogues": [
                {
                    "id": "660230101",
                    "speaker": "艾库瓦",
                    "text": "欢迎，客人要看看商品吗？"
                }
            ]
        },
        {
            "talkId": "6602302",
            "initDialog": "660230201",
            "dialogues": [
                {
                    "id": "660230201",
                    "speaker": "Player",
                    "text": "有新货吗？"
                },
                {
                    "id": "660230202",
                    "speaker": "艾库瓦",
                    "text": "哎呀，这位客人，本店的商品，当然是「旧」的比较好啦。"
                }
            ]
        },
        {
            "talkId": "6602303",
            "initDialog": "660230301",
            "dialogues": [
                {
                    "id": "660230301",
                    "speaker": "Player",
                    "text": "这里是卖什么的？"
                },
                {
                    "id": "660230302",
                    "speaker": "艾库瓦",
                    "text": "一些冒险的成果，也是一些先驱者的成就。"
                },
                {
                    "id": "660230303",
                    "speaker": "艾库瓦",
                    "text": "有的是我自己搜罗来的小玩意儿，还有些是别人送来的。所以能买到什么，就看客人你的眼力咯！"
                },
                {
                    "id": "660230304",
                    "speaker": "艾库瓦",
                    "text": "当然，客人如果有感兴趣的商品，也可以先交个定金，拿给龙遗物协会去鉴定一下，再决定买不买。"
                },
                {
                    "id": "660230305",
                    "speaker": "艾库瓦",
                    "text": "不过以他们的专业程度…哈哈，我也说不准啦。拿给他们看，还不如听我多讲几个小故事呢。"
                }
            ]
        },
        {
            "talkId": "6602304",
            "initDialog": "660230401",
            "dialogues": [
                {
                    "id": "660230401",
                    "speaker": "Player",
                    "text": "先不用了。"
                },
                {
                    "id": "660230402",
                    "speaker": "艾库瓦",
                    "text": "没关系，有空来聊聊天也好。"
                }
            ]
        },
        {
            "talkId": "6602305",
            "initDialog": "660230501",
            "dialogues": [
                {
                    "id": "660230501",
                    "speaker": "Player",
                    "text": "只听不买没关系吗？"
                },
                {
                    "id": "660230502",
                    "speaker": "艾库瓦",
                    "text": "当然没关系。有人愿意在我的摊位前停留，难道不是招揽顾客的最佳方式吗？"
                },
                {
                    "id": "660230503",
                    "speaker": "艾库瓦",
                    "text": "托这个的福，我也见识了不少奇人异士呢。"
                },
                {
                    "id": "660230504",
                    "speaker": "艾库瓦",
                    "text": "我记得有个枫丹来的酷哥，戴副墨镜，帽子上还插着个小船锚，给人印象很深。"
                },
                {
                    "id": "660230505",
                    "speaker": "艾库瓦",
                    "text": "他话不多，但对纳塔的「古名」很感兴趣，听我杂七杂八的念叨了好久。"
                },
                {
                    "id": "660230506",
                    "speaker": "艾库瓦",
                    "text": "说来惭愧，我当时说了什么自己都忘了…可能有些东西也不是很准确吧，哈哈。"
                }
            ]
        }
    ]
}