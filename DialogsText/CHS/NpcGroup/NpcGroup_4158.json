{
    "groupId": "4158",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "多加": 13
    },
    "talks": [
        {
            "talkId": "6415801",
            "initDialog": "641580101",
            "dialogues": [
                {
                    "id": "641580101",
                    "speaker": "多加",
                    "text": "小草神大人保佑，新到的这批木料非常结实，瑕疵也很少。"
                }
            ]
        },
        {
            "talkId": "6415802",
            "initDialog": "641580201",
            "dialogues": [
                {
                    "id": "641580201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641580202",
                    "speaker": "多加",
                    "text": "你好，我是这里的木匠，有什么木工活都可以给我做。"
                },
                {
                    "id": "641580203",
                    "speaker": "多加",
                    "text": "这附近邻里乡亲们的木工活都是我包揽的，保证价格实惠，质量也有保障。"
                },
                {
                    "id": "641580204",
                    "speaker": "多加",
                    "text": "正好新到的这批木料结实耐用，纹理漂亮，你要是想委托我打家具的话可得趁现在。"
                },
                {
                    "id": "641580205",
                    "speaker": "多加",
                    "text": "这可都是小草神大人的恩惠，我得把每一块木料都做成好东西才行。"
                }
            ]
        },
        {
            "talkId": "6415803",
            "initDialog": "641580301",
            "dialogues": [
                {
                    "id": "641580301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641580302",
                    "speaker": "多加",
                    "text": "再见，有木工活记得来找我啊！"
                }
            ]
        },
        {
            "talkId": "6415804",
            "initDialog": "641580401",
            "dialogues": [
                {
                    "id": "641580401",
                    "speaker": "Player",
                    "text": "关于小草神大人…"
                },
                {
                    "id": "641580402",
                    "speaker": "多加",
                    "text": "我们须弥人能在草木繁盛的地方生活，没有沦落到贫瘠的沙漠之中，靠的都是草神大人的恩惠。"
                },
                {
                    "id": "641580403",
                    "speaker": "多加",
                    "text": "树王大人留下了根基与养分，现在由小草神大人继承并守护。"
                },
                {
                    "id": "641580404",
                    "speaker": "多加",
                    "text": "所以我们现在生活中的一切收获，便都来源于她。"
                },
                {
                    "id": "641580405",
                    "speaker": "多加",
                    "text": "尤其我吃饭的手艺和树木息息相关，就更要感谢草神大人啦！"
                }
            ]
        },
        {
            "talkId": "6415805",
            "initDialog": "641580501",
            "dialogues": [
                {
                    "id": "641580501",
                    "speaker": "Player",
                    "text": "关于小草神大人…"
                },
                {
                    "id": "641580502",
                    "speaker": "多加",
                    "text": "我们须弥人能在草木繁盛的地方生活，没有沦落到贫瘠的沙漠之中，靠的都是草神大人的恩惠。"
                },
                {
                    "id": "641580503",
                    "speaker": "多加",
                    "text": "草神大人创建根基，留下养分，所以我们现在生活中的一切收获，便都来源于她。"
                },
                {
                    "id": "641580504",
                    "speaker": "多加",
                    "text": "尤其我吃饭的手艺和树木息息相关，就更要感谢小草神大人啦！"
                }
            ]
        }
    ]
}