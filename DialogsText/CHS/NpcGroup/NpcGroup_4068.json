    "talks": [
        {
            "talkId": "6406801",
            "initDialog": "640680101",
            "dialogues": [
                {
                    "id": "640680101",
                    "speaker": "乌达德",
                    "text": "是不是书读得多了，说话就会多拐几个弯啊？"
                }
            ]
        },
        {
            "talkId": "6406802",
            "initDialog": "640680201",
            "dialogues": [
                {
                    "id": "640680201",
                    "speaker": "Player",
                    "text": "你在发愁？"
                },
                {
                    "id": "640680202",
                    "speaker": "乌达德",
                    "text": "有点吧，虽然不是什么大问题，但就是心里堵得慌。"
                },
                {
                    "id": "640680203",
                    "speaker": "乌达德",
                    "text": "比如前几天吧，我在酒馆听见几个学者讨论什么大掌书。"
                },
                {
                    "id": "640680204",
                    "speaker": "乌达德",
                    "text": "我就问他们，大掌书，大掌书，到底是多大一本书？结果他们好像没太明白我在问什么。"
                },
                {
                    "id": "640680205",
                    "speaker": "乌达德",
                    "text": "我虽然战斗经验丰富，深得掌旗官信任，但每次和读书人交谈都由掌旗官打圆场，还是挺不好意思的…"
                }
            ]
        },
        {
            "talkId": "6406803",
            "initDialog": "640680301",
            "dialogues": [
                {
                    "id": "640680301",
                    "speaker": "Player",
                    "text": "也许吧。"
                },
                {
                    "id": "640680302",
                    "speaker": "乌达德",
                    "text": "唉，有话直说不好吗…"
                }
            ]
        }
    ]
}