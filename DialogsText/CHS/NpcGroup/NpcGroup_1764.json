{
    "groupId": "1764",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 2,
        "莱维": 10
    },
    "talks": [
        {
            "talkId": "6176401",
            "initDialog": "617640101",
            "dialogues": [
                {
                    "id": "617640101",
                    "speaker": "莱维",
                    "text": "呃啊…一直在忙其他事，到现在都还没清理风车…这样下去，用风之翼的熟练程度又要下降了！"
                }
            ]
        },
        {
            "talkId": "6176402",
            "initDialog": "617640201",
            "dialogues": [
                {
                    "id": "617640201",
                    "speaker": "Player",
                    "text": "清理风车？"
                },
                {
                    "id": "617640202",
                    "speaker": "莱维",
                    "text": "一般来说，我需要爬到风车内部，先检查机械结构是否有故障，或是有灰尘或是谷物卡住。"
                },
                {
                    "id": "617640203",
                    "speaker": "莱维",
                    "text": "接下来我需要尝试清理扇叶，将有破损的部分取下补好后放回。"
                },
                {
                    "id": "617640204",
                    "speaker": "莱维",
                    "text": "一般来说，这就是我工作的全部啦，如果机械结构有大的破损，我可能就要去请机械师傅来帮忙了。"
                },
                {
                    "id": "617640205",
                    "speaker": "莱维",
                    "text": "在此之后，我就会从风车的高处一跃而下，尽情享受练习的时光了！"
                },
                {
                    "id": "617640206",
                    "speaker": "莱维",
                    "text": "您似乎…是位旅行者？不知道您有没有去过纳塔，我听闻那边的山崖很高，还有擅长飞行的部族呢！"
                },
                {
                    "id": "617640207",
                    "speaker": "莱维",
                    "text": "我正在攒钱，想着有朝一日能够坐船去纳塔讨教一番他们的飞行技巧。"
                }
            ]
        },
        {
            "talkId": "6176403",
            "initDialog": "617640301",
            "dialogues": [
                {
                    "id": "617640301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617640302",
                    "speaker": "莱维",
                    "text": "慢走！"
                }
            ]
        },
        {
            "talkId": "6176404",
            "initDialog": "617640401",
            "dialogues": [
                {
                    "id": "617640401",
                    "speaker": "莱维",
                    "text": "要比赛飞行吗？"
                },
                {
                    "id": "617640402",
                    "speaker": "莱维",
                    "text": "嗯？好啊，正合我意！那我们随时开始吧？"
                }
            ]
        }
    ]
}