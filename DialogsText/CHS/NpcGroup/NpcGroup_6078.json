{
    "groupId": "6078",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "帕卡·努伊": 12
    },
    "talks": [
        {
            "talkId": "6607801",
            "initDialog": "660780101",
            "dialogues": [
                {
                    "id": "660780101",
                    "speaker": "帕卡·努伊",
                    "text": "欢迎，这位音乐爱好者！"
                }
            ]
        },
        {
            "talkId": "6607802",
            "initDialog": "660780201",
            "dialogues": [
                {
                    "id": "660780201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "660780202",
                    "speaker": "帕卡·努伊",
                    "text": "「花歌唱片店」！这名字是我表妹夏萝起的，很浪漫吧？"
                },
                {
                    "id": "660780203",
                    "speaker": "帕卡·努伊",
                    "text": "正如其名，卖唱片是本店的基本业务。除此之外，本店还可以为大家提供代出唱片的帮助。"
                },
                {
                    "id": "660780204",
                    "speaker": "帕卡·努伊",
                    "text": "如果有人写了音乐但不知道怎么出唱片，我可以从制作到发行进行全权代理。"
                },
                {
                    "id": "660780205",
                    "speaker": "帕卡·努伊",
                    "text": "你看，旁边正摆着的著名童谣音乐人的经典合集专辑，就是本店的成功作品之一。"
                }
            ]
        },
        {
            "talkId": "6607803",
            "initDialog": "660780301",
            "dialogues": [
                {
                    "id": "660780301",
                    "speaker": "Player",
                    "text": "我先自己看看。"
                },
                {
                    "id": "660780302",
                    "speaker": "帕卡·努伊",
                    "text": "请便！"
                }
            ]
        },
        {
            "talkId": "6607804",
            "initDialog": "660780401",
            "dialogues": [
                {
                    "id": "660780401",
                    "speaker": "Player",
                    "text": "算是拓展业务吗？"
                },
                {
                    "id": "660780402",
                    "speaker": "帕卡·努伊",
                    "text": "对，这位朋友很懂嘛。"
                },
                {
                    "id": "660780403",
                    "speaker": "帕卡·努伊",
                    "text": "我认识一些很喜欢音乐的朋友，有回声之子的唱片匠人，也有烟谜主的涂鸦艺术家。"
                },
                {
                    "id": "660780404",
                    "speaker": "帕卡·努伊",
                    "text": "如此一来，不仅是出唱片，就连包装、宣传海报之类的业务我也可以帮忙安排。"
                },
                {
                    "id": "660780405",
                    "speaker": "帕卡·努伊",
                    "text": "非常全面、贴心的一条龙服务，对吧？"
                }
            ]
        },
        {
            "talkId": "7593301",
            "initDialog": "759330101",
            "dialogues": [
                {
                    "id": "759330101",
                    "speaker": "Player",
                    "text": "很有商业头脑。"
                },
                {
                    "id": "759330102",
                    "speaker": "帕卡·努伊",
                    "text": "哈哈，当一家店的服务宗旨是尽量满足客户的需求时，生意应该不会不好的吧？"
                },
                {
                    "id": "759330103",
                    "speaker": "帕卡·努伊",
                    "text": "虽然我开店也没有很久，但这是我赚钱的经验之谈。"
                }
            ]
        }
    ]
}