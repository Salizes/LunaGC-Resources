{
    "groupId": "5200",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "舒当": 7
    },
    "talks": [
        {
            "talkId": "6520001",
            "initDialog": "652000101",
            "dialogues": [
                {
                    "id": "652000101",
                    "speaker": "舒当",
                    "text": "我…我还能喝！老板…不对，掌舵的！大副！二副！酒呢…"
                }
            ]
        },
        {
            "talkId": "6520002",
            "initDialog": "652000201",
            "dialogues": [
                {
                    "id": "652000201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "652000202",
                    "speaker": "舒当",
                    "text": "你…你是谁？「伯恩维尔」不好喝…不好喝，我要的「维德兰」在哪…"
                },
                {
                    "id": "652000203",
                    "speaker": "舒当",
                    "text": "我知道了！你是「奥吉尔」！哈哈哈！来！来给我喝一口！"
                }
            ]
        },
        {
            "talkId": "6520003",
            "initDialog": "652000301",
            "dialogues": [
                {
                    "id": "652000301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "652000302",
                    "speaker": "舒当",
                    "text": "我在喝酒，你看不出来吗？不和你喝，我…我不和你喝，至少…现在不和你喝…"
                }
            ]
        },
        {
            "talkId": "6520004",
            "initDialog": "652000401",
            "dialogues": [
                {
                    "id": "652000401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652000402",
                    "speaker": "舒当",
                    "text": "嗝…我要喝的酒，还没来…"
                }
            ]
        },
        {
            "talkId": "6520005",
            "initDialog": "652000501",
            "dialogues": [
                {
                    "id": "652000501",
                    "speaker": "Player",
                    "text": "你、你离我远点！正常点！"
                },
                {
                    "id": "652000502",
                    "speaker": "舒当",
                    "text": "…咦？你是谁，不和我喝酒？算了，我自己喝…嗝…"
                },
                {
                    "id": "652000503",
                    "speaker": "舒当",
                    "text": "我要…我要喝的酒，怎么还不来…"
                }
            ]
        }
    ]
}