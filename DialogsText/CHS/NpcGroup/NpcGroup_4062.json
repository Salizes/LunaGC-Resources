{
    "groupId": "4062",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "内嘉": 11
    },
    "talks": [
        {
            "talkId": "6406201",
            "initDialog": "640620101",
            "dialogues": [
                {
                    "id": "640620101",
                    "speaker": "内嘉",
                    "text": "你好。现在不是对外演出的时间，周围有些混乱…请注意脚下，和头顶。"
                }
            ]
        },
        {
            "talkId": "6406202",
            "initDialog": "640620201",
            "dialogues": [
                {
                    "id": "640620201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640620202",
                    "speaker": "内嘉",
                    "text": "我是祖拜尔剧场的道具工程师，除了设计和制作道具之外，也兼顾场地设施的维护工作。"
                }
            ]
        },
        {
            "talkId": "6406203",
            "initDialog": "640620301",
            "dialogues": [
                {
                    "id": "640620301",
                    "speaker": "Player",
                    "text": "谢谢提醒。"
                },
                {
                    "id": "640620302",
                    "speaker": "内嘉",
                    "text": "不客气。"
                }
            ]
        },
        {
            "talkId": "6406204",
            "initDialog": "640620401",
            "dialogues": [
                {
                    "id": "640620401",
                    "speaker": "Player",
                    "text": "工作顺利吗？"
                },
                {
                    "id": "640620402",
                    "speaker": "内嘉",
                    "text": "谢赫祖拜尔先生对演出相关的一切事物都有着十分严格的要求，所以我总是担心自己的工作做得不够好…"
                },
                {
                    "id": "640620403",
                    "speaker": "内嘉",
                    "text": "道具的外形是不是足够美观，细节是不是充分展现，机关能不能顺利运转…这些都是我每天在努力思考的事情。"
                },
                {
                    "id": "640620404",
                    "speaker": "内嘉",
                    "text": "有时候，我都想去报考妙论派进修了。有几个常客就是妙论派的，和我关系也不坏…"
                },
                {
                    "id": "640620405",
                    "speaker": "内嘉",
                    "text": "不过想想还是算了，又不是真的要我在舞台上建起一座完整的宫殿，对吧。"
                }
            ]
        },
        {
            "talkId": "6406205",
            "initDialog": "640620501",
            "dialogues": [
                {
                    "id": "640620501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "640620502",
                    "speaker": "内嘉",
                    "text": "唉，道具做到一半，想起来又该做场地维护了，得在演出开始前检查完成才行，不然演员可能会有危险。"
                }
            ]
        },
        {
            "talkId": "7393701",
            "initDialog": "739370101",
            "dialogues": [
                {
                    "id": "739370101",
                    "speaker": "Player",
                    "text": "放宽心。"
                },
                {
                    "id": "739370102",
                    "speaker": "内嘉",
                    "text": "要是我能像你这样豁达就好了。"
                },
                {
                    "id": "739370103",
                    "speaker": "内嘉",
                    "text": "归根到底，或许是因为我对这座剧场有着感情，也对自己有一定的要求吧。"
                },
                {
                    "id": "739370104",
                    "speaker": "内嘉",
                    "text": "不过还是谢谢你的安慰，这里有些打造道具剩下的石料，质量很不错，请收下吧。"
                }
            ]
        }
    ]
}