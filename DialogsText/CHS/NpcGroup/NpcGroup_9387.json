{
    "groupId": "9387",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "希诺宁": 9
    },
    "talks": [
        {
            "talkId": "6938701",
            "initDialog": "693870101",
            "dialogues": [
                {
                    "id": "693870101",
                    "speaker": "希诺宁",
                    "text": "总算能休息了，总之先找个地方坐下吧。"
                },
                {
                    "id": "693870102",
                    "speaker": "希诺宁",
                    "text": "别这么紧张地皱着眉了，休息的时候就该休息，不要为还没有发生的危机犯愁。"
                },
                {
                    "id": "693870103",
                    "speaker": "希诺宁",
                    "text": "来，喝点饮料吧，要吃点巧克力吗？奶糖要不要？"
                }
            ]
        },
        {
            "talkId": "6938702",
            "initDialog": "693870201",
            "dialogues": [
                {
                    "id": "693870201",
                    "speaker": "希诺宁",
                    "text": "你想的话，我可以先去前面探索一番。"
                },
                {
                    "id": "693870202",
                    "speaker": "希诺宁",
                    "text": "你见识过我的速度，只要我愿意，没有怪物能追上我。"
                },
                {
                    "id": "693870203",
                    "speaker": "希诺宁",
                    "text": "保险起见，还是一起走？行，你领头，听你的。"
                }
            ]
        },
        {
            "talkId": "6938703",
            "initDialog": "693870301",
            "dialogues": [
                {
                    "id": "693870301",
                    "speaker": "希诺宁",
                    "text": "我刚才去找了一圈，完全没有找到类似「织卷」的东西，柜子里的书也尽是些童话。"
                },
                {
                    "id": "693870302",
                    "speaker": "希诺宁",
                    "text": "这些资料里根本找不到什么有用的线索啊…"
                },
                {
                    "id": "693870303",
                    "speaker": "希诺宁",
                    "text": "唔…不然，我干脆从这里凿下点石头，带回去分析一下吧。"
                }
            ]
        }
    ]
}