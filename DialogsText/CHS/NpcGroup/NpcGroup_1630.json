{
    "groupId": "1630",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "奥拉夫": 10
    },
    "talks": [
        {
            "talkId": "6163001",
            "initDialog": "616300101",
            "dialogues": [
                {
                    "id": "616300101",
                    "speaker": "奥拉夫",
                    "text": "还是很难适应现代的生活啊…"
                }
            ]
        },
        {
            "talkId": "6163002",
            "initDialog": "616300201",
            "dialogues": [
                {
                    "id": "616300201",
                    "speaker": "Player",
                    "text": "和家人相处如何？"
                },
                {
                    "id": "616300202",
                    "speaker": "奥拉夫",
                    "text": "啊，毕竟就那样「跳过」 了百年的时间，我和杜拉夫已经论不清辈分了。"
                },
                {
                    "id": "616300203",
                    "speaker": "奥拉夫",
                    "text": "所以干脆就互相叫名字吧，这样的特殊情况也就顾不了那么多了，你说是吧？"
                },
                {
                    "id": "616300204",
                    "speaker": "奥拉夫",
                    "text": "不过血缘关系这种东西倒是真的很神奇，明明我和杜拉夫应该是形同陌路的，但很多地方却莫名很聊得来。"
                },
                {
                    "id": "616300205",
                    "speaker": "奥拉夫",
                    "text": "唔…尤其是喝酒方面，能看到百年后的蒙德对酒还是这么有品位，我就放心了。"
                },
                {
                    "id": "616300206",
                    "speaker": "奥拉夫",
                    "text": "可每当聊起这些，小迪奥娜却总是投来敌意的眼神，让我这个曾曾曾…唉不管是几个曾了的曾祖父很是苦恼。"
                }
            ]
        },
        {
            "talkId": "6163003",
            "initDialog": "616300301",
            "dialogues": [
                {
                    "id": "616300301",
                    "speaker": "Player",
                    "text": "关于过去的清泉镇。"
                },
                {
                    "id": "616300302",
                    "speaker": "奥拉夫",
                    "text": "你说我生活的那个时代的清泉镇吗？"
                },
                {
                    "id": "616300303",
                    "speaker": "奥拉夫",
                    "text": "这清泉是龙脊雪山上融化的雪水，我听说清泉镇最初也只是一群像我这样的猎人围绕水源建起的聚落。"
                },
                {
                    "id": "616300304",
                    "speaker": "奥拉夫",
                    "text": "久而久之就发展成了小镇的样子，我可不相信你们现在的人所说的什么「泉水精灵」的传说。"
                }
            ]
        },
        {
            "talkId": "6163004",
            "initDialog": "616300401",
            "dialogues": [
                {
                    "id": "616300401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616300402",
                    "speaker": "奥拉夫",
                    "text": "要去打猎了吗？祝你满载而归。"
                }
            ]
        }
    ]
}