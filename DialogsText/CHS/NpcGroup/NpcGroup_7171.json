{
    "groupId": "7171",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 3,
        "阿舍鲁": 6,
        "雅珂达": 21
    },
    "talks": [
        {
            "talkId": "6717101",
            "initDialog": "671710101",
            "dialogues": [
                {
                    "id": "671710101",
                    "speaker": "雅珂达",
                    "text": "哎呀，今天没什么客人，可算闲下来了。"
                },
                {
                    "id": "671710102",
                    "speaker": "雅珂达",
                    "text": "我就说嘛，找人找猫什么的，直接去冒险家协会就行，找我们做什么…"
                },
                {
                    "id": "671710103",
                    "speaker": "雅珂达",
                    "text": "不过，就这么站着没事干也挺无聊的啊…"
                },
                {
                    "id": "671710104",
                    "speaker": "Player",
                    "text": "你看来还是想工作。"
                },
                {
                    "id": "671710105",
                    "speaker": "雅珂达",
                    "text": "当然不想咯，但我要是翘班的话，老板又要念叨我了…"
                },
                {
                    "id": "671710106",
                    "speaker": "雅珂达",
                    "text": "#{NICKNAME}，不然你哪天帮我值个班吧，让我出去放放风，不然我要无聊死了…",
                    "choices": [
                        {
                            "id": "671710107",
                            "text": "我不愿意。",
                            "response": [
                                {
                                    "id": "671710110",
                                    "speaker": "雅珂达",
                                    "text": "唉，好啦好啦，我就是这么一说嘛…值班，我这就接着值班…"
                                },
                                {
                                    "id": "671710112",
                                    "speaker": "雅珂达",
                                    "text": "阿舍鲁啊阿舍鲁，你也不能帮我值一下吗？"
                                },
                                {
                                    "id": "671710113",
                                    "speaker": "阿舍鲁",
                                    "text": "喵喵？喵。喵~"
                                },
                                {
                                    "id": "671710108",
                                    "speaker": "雅珂达",
                                    "text": "喵！喵喵喵！"
                                },
                                {
                                    "id": "671710111",
                                    "speaker": "阿舍鲁",
                                    "text": "喵呜？"
                                },
                                {
                                    "id": "671710114",
                                    "speaker": "雅珂达",
                                    "text": "就知道指望不上你，行了行了，小猫咪…玩去吧。"
                                }
                            ]
                        },
                        {
                            "id": "671710109",
                            "text": "你自己值啦。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6717102",
            "initDialog": "671710201",
            "dialogues": [
                {
                    "id": "671710201",
                    "speaker": "雅珂达",
                    "text": "阿舍鲁，刚才老板回来了没有？"
                },
                {
                    "id": "671710202",
                    "speaker": "阿舍鲁",
                    "text": "喵~喵喵，喵——"
                },
                {
                    "id": "671710203",
                    "speaker": "雅珂达",
                    "text": "看周围的情况，老板应该没有回来…还好还好，赶回来了…"
                },
                {
                    "id": "671710204",
                    "speaker": "阿舍鲁",
                    "text": "喵喵，喵~"
                }
            ]
        },
        {
            "talkId": "6717103",
            "initDialog": "671710301",
            "dialogues": [
                {
                    "id": "671710301",
                    "speaker": "雅珂达",
                    "text": "阿舍鲁，刚才老板回来了没有？"
                },
                {
                    "id": "671710302",
                    "speaker": "阿舍鲁",
                    "text": "（回来了哟~你没发现~）"
                },
                {
                    "id": "671710303",
                    "speaker": "雅珂达",
                    "text": "看周围的情况，老板应该没有回来…还好还好，赶回来了…"
                },
                {
                    "id": "671710304",
                    "speaker": "阿舍鲁",
                    "text": "（人~笨笨~）"
                }
            ]
        },
        {
            "talkId": "6717104",
            "initDialog": "671710401",
            "dialogues": [
                {
                    "id": "671710401",
                    "speaker": "雅珂达",
                    "text": "上次看见老板神神秘秘地去小房间里，好像拿了点什么…难道是拿钱准备发工资了？"
                },
                {
                    "id": "671710402",
                    "speaker": "雅珂达",
                    "text": "肯定是的！而且她上次还答应，要帮我去找人做一副新眼镜呢，难道她正准备去买给我？"
                },
                {
                    "id": "671710403",
                    "speaker": "雅珂达",
                    "text": "老板！奈姐——你真是世界上最好最好最好的老板！"
                }
            ]
        },
        {
            "talkId": "6717105",
            "initDialog": "671710501",
            "dialogues": [
                {
                    "id": "671710501",
                    "speaker": "雅珂达",
                    "text": "呜——老板怎么什么都知道，这下完蛋了…"
                },
                {
                    "id": "671710502",
                    "speaker": "雅珂达",
                    "text": "本来还想请假去爱诺那边玩的，这下彻底请不到了…"
                }
            ]
        },
        {
            "talkId": "6717106",
            "initDialog": "671710601",
            "dialogues": [
                {
                    "id": "671710601",
                    "speaker": "雅珂达",
                    "text": "…老板没事吧，虽然她说让我安心值班，但是…"
                },
                {
                    "id": "671710602",
                    "speaker": "雅珂达",
                    "text": "算了！今天早点收工去看看老板的情况。"
                },
                {
                    "id": "671710603",
                    "speaker": "雅珂达",
                    "text": "要是她还是很难受，我说不定还要去请菈乌玛小姐过来…"
                }
            ]
        }
    ]
}