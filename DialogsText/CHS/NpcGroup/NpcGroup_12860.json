{
    "groupId": "12860",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 6,
        "雪怪伯": 26
    },
    "talks": [
        {
            "talkId": "4008133",
            "initDialog": "400813301",
            "dialogues": [
                {
                    "id": "400813301",
                    "speaker": "雪怪伯",
                    "text": "嗯，利用这些药剂，确实能让蕈兽发挥出冰霜的强大力量。"
                },
                {
                    "id": "400813302",
                    "speaker": "Player",
                    "text": "冰霜？"
                },
                {
                    "id": "400813303",
                    "speaker": "雪怪伯",
                    "text": "嗯，我年轻的时候去过蒙德，喜欢在寒冷的环境下工作，也因此被一些同行称为「雪怪人」。"
                },
                {
                    "id": "400813304",
                    "speaker": "雪怪伯",
                    "text": "现在参加了这场比赛，自然也要延续以前的习惯。"
                },
                {
                    "id": "400813305",
                    "speaker": "雪怪伯",
                    "text": "所以我的蕈兽队伍会以「冰爆菇」为核心去战斗，尽量扩大冰霜的影响。"
                },
                {
                    "id": "400813306",
                    "speaker": "派蒙",
                    "text": "你怎么就直接把自己的老底都交待出来了？万一之后要和我们比拼一场呢？"
                },
                {
                    "id": "400813307",
                    "speaker": "雪怪伯",
                    "text": "利用情报不对等来取得优势，这的确是一种策略，但不是我的作风。"
                },
                {
                    "id": "400813308",
                    "speaker": "雪怪伯",
                    "text": "毕竟这只是一场竞技赛事，而不是拼死拼活的战斗，我更看重公平，所以告诉你们也无妨。"
                }
            ]
        },
        {
            "talkId": "4008138",
            "initDialog": "400813801",
            "dialogues": [
                {
                    "id": "400813801",
                    "speaker": "雪怪伯",
                    "text": "还不错，是个接受磨砺的好地方。",
                    "choices": [
                        {
                            "id": "400813802",
                            "text": "磨砺？",
                            "response": [
                                {
                                    "id": "400813803",
                                    "speaker": "雪怪伯",
                                    "text": "共同接受磨砺，是和蕈兽们一起变强的正道。"
                                },
                                {
                                    "id": "400813804",
                                    "speaker": "雪怪伯",
                                    "text": "我年轻时，就曾和多地的冒险家组成过队伍，在各地游历，完成了协会的大量委托。"
                                },
                                {
                                    "id": "400813805",
                                    "speaker": "雪怪伯",
                                    "text": "经历各种艰险的挑战和「苦修」后，我们以之前不敢想象的速度变强了，这个道理同样适用于蕈兽的队伍。"
                                },
                                {
                                    "id": "400813806",
                                    "speaker": "雪怪伯",
                                    "text": "主办方划定的这个训练的场地，用来磨砺蕈兽的队伍，实在是太合了。"
                                },
                                {
                                    "id": "400813807",
                                    "speaker": "雪怪伯",
                                    "text": "虽然里边的敌人来历不明…但这种事情，不用我们这些参赛者搞得太清楚。"
                                },
                                {
                                    "id": "400813808",
                                    "speaker": "派蒙",
                                    "text": "唔，这个人考虑的事情还挺多呢，看来是个慎重的选手，但也不缺少热情！"
                                }
                            ]
                        },
                        {
                            "id": "400813809",
                            "text": "打扰了…",
                            "response": [
                                {
                                    "id": "400813810",
                                    "speaker": "雪怪伯",
                                    "text": "没事，大家都是参赛选手，互相认识一下也不错。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008140",
            "initDialog": "400814001",
            "dialogues": [
                {
                    "id": "400814001",
                    "speaker": "雪怪伯",
                    "text": "是你们啊，之前多谢你们了。",
                    "choices": [
                        {
                            "id": "400814002",
                            "text": "为什么？",
                            "response": [
                                {
                                    "id": "400814003",
                                    "speaker": "雪怪伯",
                                    "text": "你们让我看到了自己的不足之处，我还要继续苦修一番才行呐。"
                                },
                                {
                                    "id": "400814004",
                                    "speaker": "雪怪伯",
                                    "text": "在指挥蕈兽这方面，我似乎也太执着于单一元素的力量了。你们不一样，虽然也以某只蕈兽为重要战力，但队伍的搭配很均衡。"
                                },
                                {
                                    "id": "400814005",
                                    "speaker": "雪怪伯",
                                    "text": "换言之，你们有着均衡、平稳的指挥才能，值得学习。"
                                },
                                {
                                    "id": "400814006",
                                    "speaker": "派蒙",
                                    "text": "你太客气了！你和「冰爆菇」的表现也很棒哦！"
                                }
                            ]
                        },
                        {
                            "id": "400814007",
                            "text": "不用谢，再见！",
                            "response": [
                                {
                                    "id": "400814008",
                                    "speaker": "雪怪伯",
                                    "text": "那就再见了，希望以后还有机会交流！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008151",
            "initDialog": "400815101",
            "dialogues": [
                {
                    "id": "400815101",
                    "speaker": "雪怪伯",
                    "text": "「黄金流星」，还有「白银伴星」，恭喜你们进入决赛。",
                    "choices": [
                        {
                            "id": "400815102",
                            "text": "多谢多谢！",
                            "response": [
                                {
                                    "id": "400815103",
                                    "speaker": "雪怪伯",
                                    "text": "看过你们和莱依拉选手的比赛后，我能感觉到，你们对于蕈兽有一种共识。"
                                },
                                {
                                    "id": "400815104",
                                    "speaker": "雪怪伯",
                                    "text": "你们似乎倾向于…将宝珠控制下的蕈兽当成朋友，所以更了解它们，能将它们的潜力彻底发挥出来。"
                                },
                                {
                                    "id": "400815105",
                                    "speaker": "雪怪伯",
                                    "text": "相比之下，我还带着一点「主人」的心思，只想着和它们一起苦修，磨砺技艺，却没有给过它们足够的关怀。"
                                },
                                {
                                    "id": "400815106",
                                    "speaker": "雪怪伯",
                                    "text": "这种割裂，大概就是我败给你们的原因吧，我输得心服口服。"
                                },
                                {
                                    "id": "400815107",
                                    "speaker": "派蒙",
                                    "text": "不至于啦，雪什么来着…雪先生！你也没有对蕈兽伙伴太严苛，只是在用普通的方法去对待他们。"
                                },
                                {
                                    "id": "400815108",
                                    "speaker": "派蒙",
                                    "text": "而且，说不定我们也能向你学习呢，比如…一起和蕈兽伙伴冒险，适当吃一点点苦，来让我们的默契更加…坚不可摧！"
                                },
                                {
                                    "id": "400815109",
                                    "speaker": "雪怪伯",
                                    "text": "过奖了，「白银伴星」！修行没有终点，我还要多多精进才是呐…"
                                },
                                {
                                    "id": "400815110",
                                    "speaker": "雪怪伯",
                                    "text": "希望下次比赛，我能有幸和夺得了冠军的你们再切磋一次。"
                                },
                                {
                                    "id": "400815111",
                                    "speaker": "Player",
                                    "text": "等我们的好消息吧。"
                                },
                                {
                                    "id": "400815112",
                                    "speaker": "派蒙",
                                    "text": "我们也等着你的好消息哦。"
                                }
                            ]
                        },
                        {
                            "id": "400815113",
                            "text": "我们先去准备了。",
                            "response": [
                                {
                                    "id": "400815114",
                                    "speaker": "雪怪伯",
                                    "text": "嗯，强大的对手正等着你们，不可疏忽大意。我相信，你们是冠军的最佳人选！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}