    },
    "talks": [
        {
            "talkId": "6759701",
            "initDialog": "675970101",
            "dialogues": [
                {
                    "id": "675970101",
                    "speaker": "希什金娜",
                    "text": "唔，无论怎么感觉，都还是比不过真正的阳光啊…"
                }
            ]
        },
        {
            "talkId": "6759702",
            "initDialog": "675970201",
            "dialogues": [
                {
                    "id": "675970201",
                    "speaker": "Player",
                    "text": "你是在做维护工作吗？"
                },
                {
                    "id": "675970202",
                    "speaker": "希什金娜",
                    "text": "是啊。要是没了这玩意，周围的人非得被冻晕了不可。"
                },
                {
                    "id": "675970203",
                    "speaker": "希什金娜",
                    "text": "虽然现在是我的休假时间…但刚好有些手艺，就接下了维护工作，顺便还能给自己赚点外快呢。"
                },
                {
                    "id": "675970204",
                    "speaker": "希什金娜",
                    "text": "不过，就我个人来说，这东西虽然很暖和，但给人的感觉，依然不如真正的阳光啊。"
                },
                {
                    "id": "675970205",
                    "speaker": "希什金娜",
                    "text": "哈哈哈，但在这地方，阳光是可遇不可求的东西，想要取暖，还是靠这玩意比较靠谱啊。"
                }
            ]
        },
        {
            "talkId": "6759703",
            "initDialog": "675970301",
            "dialogues": [
                {
                    "id": "675970301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675970302",
                    "speaker": "希什金娜",
                    "text": "再见。记得把自己裹严实一点。"
                }
            ]
        }
    ]
}