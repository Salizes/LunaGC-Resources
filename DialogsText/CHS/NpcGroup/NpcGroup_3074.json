{
    "groupId": "3074",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 5,
        "婷婷": 22,
        "笹野": 4
    },
    "talks": [
        {
            "talkId": "4006301",
            "initDialog": "400630101",
            "dialogues": [
                {
                    "id": "400630101",
                    "speaker": "婷婷",
                    "text": "我们一起买的这本同人小说，你读完了吗？"
                },
                {
                    "id": "400630102",
                    "speaker": "笹野",
                    "text": "嗯嗯，大致读完了…"
                },
                {
                    "id": "400630103",
                    "speaker": "婷婷",
                    "text": "是不是很棒？我很喜欢女主角最后坚定信念，走向新生活的结尾。"
                },
                {
                    "id": "400630104",
                    "speaker": "笹野",
                    "text": "虽然前面的剧情都很精彩，但是我记得原作的结局似乎不是这样的…"
                },
                {
                    "id": "400630105",
                    "speaker": "婷婷",
                    "text": "哎，所以这就是同人作品的自由之处啦。"
                },
                {
                    "id": "400630106",
                    "speaker": "婷婷",
                    "text": "能在同人中见到多种多样的角色故事，正是乐趣所在啊。"
                },
                {
                    "id": "400630107",
                    "speaker": "笹野",
                    "text": "啊，是，是，你说得有道理…"
                },
                {
                    "id": "400630108",
                    "speaker": "笹野",
                    "text": "那个，我听说那边有新的绘本开启贩售了，要一起去看看吗？"
                }
            ]
        },
        {
            "talkId": "6307401",
            "initDialog": "630740101",
            "dialogues": [
                {
                    "id": "630740101",
                    "speaker": "婷婷",
                    "text": "嗯…即便遇见了他，我也还是要…"
                }
            ]
        },
        {
            "talkId": "6307402",
            "initDialog": "630740201",
            "dialogues": [
                {
                    "id": "630740201",
                    "speaker": "Player",
                    "text": "你在烦恼什么？"
                },
                {
                    "id": "630740202",
                    "speaker": "婷婷",
                    "text": "啊，是这样。我是来自璃月的学者，梦想是周游世界，遍历七国。"
                },
                {
                    "id": "630740203",
                    "speaker": "婷婷",
                    "text": "此前在蒙德、须弥、纳塔、枫丹的旅途都比较顺利，但没想到来稻妻之后，事情的发展出乎了我的意料。"
                },
                {
                    "id": "630740204",
                    "speaker": "婷婷",
                    "text": "因为锁国令的缘故，我无法进入稻妻城。而就在我要失望离开的时候，我遇见了他…"
                }
            ]
        },
        {
            "talkId": "6307403",
            "initDialog": "630740301",
            "dialogues": [
                {
                    "id": "630740301",
                    "speaker": "Player",
                    "text": "「他」？"
                },
                {
                    "id": "630740302",
                    "speaker": "婷婷",
                    "text": "嗯，他是我在稻妻遇见的第一个帮助我的人。"
                },
                {
                    "id": "630740303",
                    "speaker": "婷婷",
                    "text": "因为见我是孤身一人的异乡来客，他在我滞留离岛的这段时间里帮了我很多忙。"
                },
                {
                    "id": "630740304",
                    "speaker": "婷婷",
                    "text": "说实话，他为人温和亲切，我对他也渐渐有了些好感…"
                },
                {
                    "id": "630740305",
                    "speaker": "婷婷",
                    "text": "但是，我周游世界的旅途还未结束，实在无法在稻妻停下脚步。"
                },
                {
                    "id": "630740306",
                    "speaker": "婷婷",
                    "text": "爱情诚可贵，自由价更高…我，需要慎重选择才是。"
                }
            ]
        },
        {
            "talkId": "6307404",
            "initDialog": "630740401",
            "dialogues": [
                {
                    "id": "630740401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630740402",
                    "speaker": "婷婷",
                    "text": "再见，祝你旅途顺利。"
                }
            ]
        },
        {
            "talkId": "6307405",
            "initDialog": "630740501",
            "dialogues": [
                {
                    "id": "630740501",
                    "speaker": "婷婷",
                    "text": "唔…万一他执意要留下的话…"
                }
            ]
        },
        {
            "talkId": "6307406",
            "initDialog": "630740601",
            "dialogues": [
                {
                    "id": "630740601",
                    "speaker": "Player",
                    "text": "你在烦恼什么？"
                },
                {
                    "id": "630740602",
                    "speaker": "婷婷",
                    "text": "啊，是这样。我是来自璃月的学者，梦想是周游世界，遍历七国。"
                },
                {
                    "id": "630740603",
                    "speaker": "婷婷",
                    "text": "此前在蒙德、须弥、纳塔、枫丹的旅途都比较顺利，但没想到来稻妻之后，因为锁国令的缘故，我一直无法离开离岛。"
                },
                {
                    "id": "630740604",
                    "speaker": "婷婷",
                    "text": "而现在，我终于可以好好在稻妻游历一番了。"
                },
                {
                    "id": "630740605",
                    "speaker": "婷婷",
                    "text": "然而稻妻之游总会有抵达终点的一天，那时的我，没准就不得不离开他了…"
                }
            ]
        },
        {
            "talkId": "7290201",
            "initDialog": "729020101",
            "dialogues": [
                {
                    "id": "729020101",
                    "speaker": "Player",
                    "text": "自由…"
                },
                {
                    "id": "729020102",
                    "speaker": "婷婷",
                    "text": "嗯，如果没有了自由的心志，那么就算走再远的路也无法敞开胸怀。"
                },
                {
                    "id": "729020103",
                    "speaker": "婷婷",
                    "text": "看你的样子，也是旅行者吧？这些就送给你了。"
                },
                {
                    "id": "729020104",
                    "speaker": "婷婷",
                    "text": "等你也去更多的地方旅行过后，大概就更能理解自由的价值了吧。"
                }
            ]
        }
    ]
}