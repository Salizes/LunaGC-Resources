{
    "groupId": "7060",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "塔帕尼": 8
    },
    "talks": [
        {
            "talkId": "6706001",
            "initDialog": "670600101",
            "dialogues": [
                {
                    "id": "670600101",
                    "speaker": "塔帕尼",
                    "text": "哟，来喝点吗？还是找点乐子？"
                }
            ]
        },
        {
            "talkId": "6706002",
            "initDialog": "670600201",
            "dialogues": [
                {
                    "id": "670600201",
                    "speaker": "Player",
                    "text": "你是店里的人？"
                },
                {
                    "id": "670600202",
                    "speaker": "塔帕尼",
                    "text": "「旗舰」的员工？哈哈，当然不是啦。我看起来很像吗？还是因为刚才的问句像是德米安会说的话？"
                },
                {
                    "id": "670600203",
                    "speaker": "塔帕尼",
                    "text": "就跟打招呼一样，不过看来你不怎么吃这套啊。"
                },
                {
                    "id": "670600204",
                    "speaker": "塔帕尼",
                    "text": "有戒心是好事，不过，在这种地方有时就得放下戒心才能得到你想要的东西，哪怕是演出放下戒心的样子呢？你说对吧。"
                }
            ]
        },
        {
            "talkId": "6706003",
            "initDialog": "670600301",
            "dialogues": [
                {
                    "id": "670600301",
                    "speaker": "Player",
                    "text": "来点推荐。"
                },
                {
                    "id": "670600302",
                    "speaker": "塔帕尼",
                    "text": "转盘特调你肯定已经尝试过了吧？要说这儿有什么值得推荐的，当然还是各色饮品了。"
                },
                {
                    "id": "670600303",
                    "speaker": "塔帕尼",
                    "text": "如果你是累了想找点正经吃食，那不如去「斯佩兰扎」吧。啊，我可不是因为那是自己人才推荐的，别误会。"
                }
            ]
        },
        {
            "talkId": "6706004",
            "initDialog": "670600401",
            "dialogues": [
                {
                    "id": "670600401",
                    "speaker": "Player",
                    "text": "下次再说吧。"
                },
                {
                    "id": "670600402",
                    "speaker": "塔帕尼",
                    "text": "那就下次见。"
                }
            ]
        },
        {
            "talkId": "6706005",
            "initDialog": "670600501",
            "dialogues": [
                {
                    "id": "670600501",
                    "speaker": "Player",
                    "text": "自己人是说？"
                },
                {
                    "id": "670600502",
                    "speaker": "塔帕尼",
                    "text": "卡嘉是…是把我养大的人，这么说你该明白了吧。我可不是故意掖着藏着，只是这事也没必要大声宣扬罢了。"
                }
            ]
        }
    ]
}