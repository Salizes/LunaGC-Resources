{
    "groupId": "5115",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "莫妮欧": 12
    },
    "talks": [
        {
            "talkId": "6511501",
            "initDialog": "651150101",
            "dialogues": [
                {
                    "id": "651150101",
                    "speaker": "莫妮欧",
                    "text": "嗯…在哪能买到和芙宁娜大人的那块钟表类似的饰品呢？"
                }
            ]
        },
        {
            "talkId": "6511502",
            "initDialog": "651150201",
            "dialogues": [
                {
                    "id": "651150201",
                    "speaker": "Player",
                    "text": "什么样的钟表？"
                },
                {
                    "id": "651150202",
                    "speaker": "莫妮欧",
                    "text": "当然是著名的「湖女之泪」了！"
                },
                {
                    "id": "651150203",
                    "speaker": "莫妮欧",
                    "text": "它精致小巧，甚至能镶嵌在一枚戒指上。正因如此，才会被芙宁娜大人赐名「湖女之泪」吧。"
                },
                {
                    "id": "651150204",
                    "speaker": "莫妮欧",
                    "text": "我作为芙宁娜大人的追随者，若是能找到与之最为接近的饰品，应该也算是拉近了我与神明的距离吧…"
                },
                {
                    "id": "651150205",
                    "speaker": "莫妮欧",
                    "text": "啊，美丽的水神大人…精致的妆容、悠扬的声音、灵巧的舞姿…应当给她更大、更华丽的舞台呀…"
                }
            ]
        },
        {
            "talkId": "6511503",
            "initDialog": "651150301",
            "dialogues": [
                {
                    "id": "651150301",
                    "speaker": "Player",
                    "text": "不太清楚…"
                },
                {
                    "id": "651150302",
                    "speaker": "莫妮欧",
                    "text": "没关系，这本就是不容易的事情，但我不会放弃的！"
                }
            ]
        },
        {
            "talkId": "6511504",
            "initDialog": "651150401",
            "dialogues": [
                {
                    "id": "651150401",
                    "speaker": "莫妮欧",
                    "text": "听说了吗？芙宁娜大人再次登台演出了！太好了…我还以为再也见不到我的神明了…"
                }
            ]
        },
        {
            "talkId": "6511505",
            "initDialog": "651150501",
            "dialogues": [
                {
                    "id": "651150501",
                    "speaker": "Player",
                    "text": "关于芙宁娜大人…"
                },
                {
                    "id": "651150502",
                    "speaker": "莫妮欧",
                    "text": "哼，虽然很多人改口不再称呼她为神明，但对我来说，舞台上的她永远是「芙宁娜大人」…"
                },
                {
                    "id": "651150503",
                    "speaker": "莫妮欧",
                    "text": "唉，之前听说芙宁娜大人要永远离开歌剧院，我伤心得待在家里都不想出门了…"
                },
                {
                    "id": "651150504",
                    "speaker": "莫妮欧",
                    "text": "不过我就知道，我心中的神明是不会一蹶不振的！啊，美丽的芙宁娜大人…终于又能在舞台上见到您了！"
                },
                {
                    "id": "651150505",
                    "speaker": "莫妮欧",
                    "text": "精致的妆容、悠扬的声音、灵巧的舞姿…应当给她更大、更华丽的舞台呀…"
                }
            ]
        },
        {
            "talkId": "6511506",
            "initDialog": "651150601",
            "dialogues": [
                {
                    "id": "651150601",
                    "speaker": "Player",
                    "text": "为你高兴。"
                },
                {
                    "id": "651150602",
                    "speaker": "莫妮欧",
                    "text": "不，应当为芙宁娜大人喝彩！请务必支持她的新事业！"
                }
            ]
        }
    ]
}