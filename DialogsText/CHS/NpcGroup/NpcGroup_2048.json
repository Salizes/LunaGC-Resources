{
    "groupId": "2048",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 7,
        "老章": 18
    },
    "talks": [
        {
            "talkId": "6204801",
            "initDialog": "620480101",
            "dialogues": [
                {
                    "id": "620480101",
                    "speaker": "老章",
                    "text": "想买兵器还是委托锻造？修东西的话免费，记得帮我留意下有没有好矿石就行。"
                }
            ]
        },
        {
            "talkId": "6204802",
            "initDialog": "620480201",
            "dialogues": [
                {
                    "id": "620480201",
                    "speaker": "Player",
                    "text": "有什么卖的？"
                },
                {
                    "id": "620480202",
                    "speaker": "老章",
                    "text": "绝好的矿材，祖传的手艺，放心挑吧。"
                }
            ]
        },
        {
            "talkId": "6204803",
            "initDialog": "620480301",
            "dialogues": [
                {
                    "id": "620480301",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "620480302",
                    "speaker": "老章",
                    "text": "（没有可领取的装备时）"
                },
                {
                    "id": "620480303",
                    "speaker": "老章",
                    "text": "自己带了材料来吗？让我看看是些什么货色。"
                },
                {
                    "id": "620480304",
                    "speaker": "老章",
                    "text": "（有可领取的装备时）"
                },
                {
                    "id": "620480305",
                    "speaker": "老章",
                    "text": "哦，话说之前的委托已经锻造好了，还有其他委托么？"
                }
            ]
        },
        {
            "talkId": "6204804",
            "initDialog": "620480401",
            "dialogues": [
                {
                    "id": "620480401",
                    "speaker": "Player",
                    "text": "关于「寒锋铁器」…"
                },
                {
                    "id": "620480402",
                    "speaker": "老章",
                    "text": "这铺子是我爹留给我的，他老人家正在轻策庄养老呢。"
                },
                {
                    "id": "620480403",
                    "speaker": "老章",
                    "text": "爹留给我的除了这些工具和炉子外，还教给我做生意靠得是人情的道理。"
                },
                {
                    "id": "620480404",
                    "speaker": "老章",
                    "text": "附近的矿工劳工之类的，拿来要修的铁器，我从不收他们修理费。代价就是多多帮我留意稀有的矿石。"
                },
                {
                    "id": "620480405",
                    "speaker": "老章",
                    "text": "哪个铁匠不想打一把神兵利器出来呢？我想璃月既然是岩王爷的地盘，肯定会有大陆其他地方找不到的稀世好矿…"
                },
                {
                    "id": "620480406",
                    "speaker": "老章",
                    "text": "从原材料上就彻底打败那些同行，振一振这百年老铺的名声，嘿嘿。你也要记得帮我留意啊。"
                }
            ]
        },
        {
            "talkId": "6204805",
            "initDialog": "620480501",
            "dialogues": [
                {
                    "id": "620480501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620480502",
                    "speaker": "老章",
                    "text": "走吧，要帮忙记得回来找我。"
                }
            ]
        },
        {
            "talkId": "6204806",
            "initDialog": "620480601",
            "dialogues": [
                {
                    "id": "620480601",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "620480602",
                    "speaker": "老章",
                    "text": "自己带了材料来吗？让我看看是些什么货色。"
                }
            ]
        },
        {
            "talkId": "6204807",
            "initDialog": "620480701",
            "dialogues": [
                {
                    "id": "620480701",
                    "speaker": "老章",
                    "text": "<color=#FFCC33FF>委托锻造…</color>"
                },
                {
                    "id": "620480702",
                    "speaker": "老章",
                    "text": "哦，话说之前的委托已经锻造好了，还有其他委托么？"
                }
            ]
        },
        {
            "talkId": "6204808",
            "initDialog": "620480801",
            "dialogues": [
                {
                    "id": "620480801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么卖的？</color>"
                },
                {
                    "id": "620480802",
                    "speaker": "老章",
                    "text": "绝好的矿材，祖传的手艺，放心挑吧。"
                }
            ]
        },
        {
            "talkId": "8204801",
            "initDialog": "820480101",
            "dialogues": [
                {
                    "id": "820480101",
                    "speaker": "Player",
                    "text": "关于璃月的矿产…"
                }
            ]
        },
        {
            "talkId": "8204802",
            "initDialog": "820480201",
            "dialogues": [
                {
                    "id": "820480201",
                    "speaker": "老章",
                    "text": "矿石啊…附近的很多矿点你都去过了吧？"
                },
                {
                    "id": "820480202",
                    "speaker": "老章",
                    "text": "我这边暂时没什么新的情报，不如你下次再来碰碰运气。"
                }
            ]
        }
    ]
}