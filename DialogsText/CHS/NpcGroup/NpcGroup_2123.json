{
    "groupId": "2123",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "阿鸠": 10
    },
    "talks": [
        {
            "talkId": "6212301",
            "initDialog": "621230101",
            "dialogues": [
                {
                    "id": "621230101",
                    "speaker": "阿鸠",
                    "text": "你来的早了些…是想见证璃月最古早最威严的「那位」的复苏吗？"
                }
            ]
        },
        {
            "talkId": "6212302",
            "initDialog": "621230201",
            "dialogues": [
                {
                    "id": "621230201",
                    "speaker": "Player",
                    "text": "你指的是岩王帝君？"
                },
                {
                    "id": "621230202",
                    "speaker": "阿鸠",
                    "text": "呵呵呵…那个僭位者吗？"
                },
                {
                    "id": "621230203",
                    "speaker": "阿鸠",
                    "text": "人类眼中的历史…果然只是从人类的时代开始…"
                },
                {
                    "id": "621230204",
                    "speaker": "阿鸠",
                    "text": "如此便能将那些黑暗罪行封存在旧世界，然后安稳度日了吗？"
                },
                {
                    "id": "621230205",
                    "speaker": "阿鸠",
                    "text": "…也罢，既然你甘愿沉溺于虚伪的繁荣，那就在其中慢慢溺死吧。"
                }
            ]
        },
        {
            "talkId": "6212303",
            "initDialog": "621230301",
            "dialogues": [
                {
                    "id": "621230301",
                    "speaker": "Player",
                    "text": "复苏…？"
                },
                {
                    "id": "621230302",
                    "speaker": "阿鸠",
                    "text": "那些仙人妄图以树来加之束缚…却不知千年的岁月已将「伏龙树」融入其血肉…"
                },
                {
                    "id": "621230303",
                    "speaker": "阿鸠",
                    "text": "他伸展双臂，舒展腰身，延展根须…地脉亦如他所期望地回应着他。"
                },
                {
                    "id": "621230304",
                    "speaker": "阿鸠",
                    "text": "待地脉的精华填满他的饥渴…"
                },
                {
                    "id": "621230305",
                    "speaker": "阿鸠",
                    "text": "你我在此处的意义，便都会不复存在了吧？"
                }
            ]
        },
        {
            "talkId": "6212304",
            "initDialog": "621230401",
            "dialogues": [
                {
                    "id": "621230401",
                    "speaker": "Player",
                    "text": "我不太明白…"
                },
                {
                    "id": "621230402",
                    "speaker": "阿鸠",
                    "text": "别急…你会见证到的。"
                }
            ]
        }
    ]
}