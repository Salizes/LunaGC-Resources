{
    "groupId": "3139",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "博行": 14
    },
    "talks": [
        {
            "talkId": "6313901",
            "initDialog": "631390101",
            "dialogues": [
                {
                    "id": "631390101",
                    "speaker": "博行",
                    "text": "一旦陷入消耗战的话，可就糟了…"
                }
            ]
        },
        {
            "talkId": "6313902",
            "initDialog": "631390201",
            "dialogues": [
                {
                    "id": "631390201",
                    "speaker": "Player",
                    "text": "消耗战？"
                },
                {
                    "id": "631390202",
                    "speaker": "博行",
                    "text": "啊，我是在思考与幕府军对战的事情。"
                },
                {
                    "id": "631390203",
                    "speaker": "博行",
                    "text": "我曾经与执行眼狩令的幕府军交战过，知道他们的厉害。"
                },
                {
                    "id": "631390204",
                    "speaker": "博行",
                    "text": "和他们比起来，我们珊瑚宫军的物资缺口太大了，靠海祇岛的物产也很难顶上。一旦陷入消耗战，局势只会对我们不利。"
                },
                {
                    "id": "631390205",
                    "speaker": "博行",
                    "text": "而且毕竟拥有神之眼的人是少数，普通人要如何才能坚持抵制眼狩令到底呢？"
                },
                {
                    "id": "631390206",
                    "speaker": "博行",
                    "text": "唉，反抗幕府的这条路可不好走啊…"
                }
            ]
        },
        {
            "talkId": "6313903",
            "initDialog": "631390301",
            "dialogues": [
                {
                    "id": "631390301",
                    "speaker": "Player",
                    "text": "保重。"
                },
                {
                    "id": "631390302",
                    "speaker": "博行",
                    "text": "但愿如此吧。"
                }
            ]
        },
        {
            "talkId": "6313904",
            "initDialog": "631390401",
            "dialogues": [
                {
                    "id": "631390401",
                    "speaker": "博行",
                    "text": "现在不用再担心与幕府军对战的事情，心里轻松多了…"
                }
            ]
        },
        {
            "talkId": "6313905",
            "initDialog": "631390501",
            "dialogues": [
                {
                    "id": "631390501",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "631390502",
                    "speaker": "博行",
                    "text": "你也好！现在战争结束了，可以好好享受海祇岛的风光啦。"
                },
                {
                    "id": "631390503",
                    "speaker": "博行",
                    "text": "有没有去珊瑚宫附近逛过？巨大的珊瑚很壮观吧！"
                },
                {
                    "id": "631390504",
                    "speaker": "博行",
                    "text": "还有海祇岛特有的植物景观，也很值得一看。"
                },
                {
                    "id": "631390505",
                    "speaker": "博行",
                    "text": "咳咳…我好像有点放松过头了。虽然战争暂时停止了，眼狩令也废除了，但我们和幕府的矛盾依然还在…"
                },
                {
                    "id": "631390506",
                    "speaker": "博行",
                    "text": "不过，现在还算和平，就趁机让我轻松一阵吧。"
                }
            ]
        },
        {
            "talkId": "6313906",
            "initDialog": "631390601",
            "dialogues": [
                {
                    "id": "631390601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631390602",
                    "speaker": "博行",
                    "text": "再见啦！"
                }
            ]
        }
    ]
}