{
    "groupId": "3137",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "考什克": 14
    },
    "talks": [
        {
            "talkId": "6313701",
            "initDialog": "631370101",
            "dialogues": [
                {
                    "id": "631370101",
                    "speaker": "考什克",
                    "text": "原来如此…我看关于这个问题，需要一些更大胆的假设！"
                }
            ]
        },
        {
            "talkId": "6313702",
            "initDialog": "631370201",
            "dialogues": [
                {
                    "id": "631370201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "631370202",
                    "speaker": "考什克",
                    "text": "我是来自须弥的学者，正在研究海祇岛的文化与历史。"
                },
                {
                    "id": "631370203",
                    "speaker": "考什克",
                    "text": "我在锁国之前就来到了稻妻，一路游览下来，发现海祇岛和鸣神岛的区别可真大啊…"
                },
                {
                    "id": "631370204",
                    "speaker": "考什克",
                    "text": "比如这个，我从野外的遗迹里拓下的奇妙图腾。你看，根据这里的线条，还有这里的纹样，我得出了不得了的结论！"
                }
            ]
        },
        {
            "talkId": "6313703",
            "initDialog": "631370301",
            "dialogues": [
                {
                    "id": "631370301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631370302",
                    "speaker": "考什克",
                    "text": "再见，我的想法一定没错！"
                }
            ]
        },
        {
            "talkId": "6313704",
            "initDialog": "631370401",
            "dialogues": [
                {
                    "id": "631370401",
                    "speaker": "Player",
                    "text": "结论如何？"
                },
                {
                    "id": "631370402",
                    "speaker": "考什克",
                    "text": "结论就是，在远古的稻妻，应该有两个蛇神！"
                },
                {
                    "id": "631370403",
                    "speaker": "考什克",
                    "text": "其中之一和珊瑚结为一体，难以行动，建立了珊瑚宫。而它真正的神体正处于珊瑚宫之下的神秘渊下宫，始终守护着海祇岛的民众。"
                },
                {
                    "id": "631370404",
                    "speaker": "考什克",
                    "text": "而另一个蛇神呢，则好高骛远，妄图向东侵袭鸣神岛，结果被雷神中途斩杀。"
                },
                {
                    "id": "631370405",
                    "speaker": "考什克",
                    "text": "证据就是这个图腾上，有一处蛇的纹样身披珊瑚，而另一处则是光溜溜的！"
                },
                {
                    "id": "631370406",
                    "speaker": "考什克",
                    "text": "是不是很有道理？这个结果一旦发表，一定能让我名声大噪，哈哈哈！"
                }
            ]
        },
        {
            "talkId": "6313705",
            "initDialog": "631370501",
            "dialogues": [
                {
                    "id": "631370501",
                    "speaker": "Player",
                    "text": "你确定吗？"
                },
                {
                    "id": "631370502",
                    "speaker": "考什克",
                    "text": "当然。身为学者，就要有坚持自己观点的精神，哪怕其他人都认为蒙德的四风守护像字面一样只有四个，我也坚持说它们其实有五个！"
                },
                {
                    "id": "631370503",
                    "speaker": "考什克",
                    "text": "我的假设，一定不会有错！"
                },
                {
                    "id": "631370504",
                    "speaker": "考什克",
                    "text": "虽然珊瑚宫的巫女听了我的结论之后一直在摇头，但我觉得她是被自己的信仰蒙蔽了双眼。"
                },
                {
                    "id": "631370505",
                    "speaker": "考什克",
                    "text": "因为毕竟她也拿不出什么反驳证据，对吧。"
                }
            ]
        }
    ]
}