{
    "groupId": "5067",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "布莱卡利": 8
    },
    "talks": [
        {
            "talkId": "6506701",
            "initDialog": "650670101",
            "dialogues": [
                {
                    "id": "650670101",
                    "speaker": "布莱卡利",
                    "text": "要不要给孩子们再烤些饼干呢？或者上次做过的泡泡桔蛋糕也不错。"
                }
            ]
        },
        {
            "talkId": "6506703",
            "initDialog": "650670301",
            "dialogues": [
                {
                    "id": "650670301",
                    "speaker": "Player",
                    "text": "听上去很好吃。"
                },
                {
                    "id": "650670302",
                    "speaker": "布莱卡利",
                    "text": "呵呵，孩子们喜欢就好。"
                },
                {
                    "id": "650670303",
                    "speaker": "布莱卡利",
                    "text": "这里的大人们工作忙，总有小孩子来替家里买东西，我就会拿点零食给他们。"
                },
                {
                    "id": "650670304",
                    "speaker": "布莱卡利",
                    "text": "有时娜维娅那丫头也会过来，大包小包地带好多礼物给我，也跟小孩子一样嚷嚷着想吃蛋糕。"
                }
            ]
        },
        {
            "talkId": "6506704",
            "initDialog": "650670401",
            "dialogues": [
                {
                    "id": "650670401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650670402",
                    "speaker": "布莱卡利",
                    "text": "慢点走，小心别摔倒哦。"
                }
            ]
        },
        {
            "talkId": "6506705",
            "initDialog": "650670501",
            "dialogues": [
                {
                    "id": "650670501",
                    "speaker": "Player",
                    "text": "关于娜维娅…"
                },
                {
                    "id": "650670502",
                    "speaker": "布莱卡利",
                    "text": "我和她爸爸是老相识了，那丫头的好枪法里还有我的一点功劳呢。"
                },
                {
                    "id": "650670503",
                    "speaker": "布莱卡利",
                    "text": "当然，不是在这里学的。这里地方小，要是动起刀枪来，谁也得不到好处。"
                },
                {
                    "id": "650670504",
                    "speaker": "布莱卡利",
                    "text": "要是有人敢在这里闹事，就只好请他去大海里生活了。"
                }
            ]
        }
    ]
}