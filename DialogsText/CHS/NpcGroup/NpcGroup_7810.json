{
    "groupId": "7810",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "谢列布里亚科夫": 8
    },
    "talks": [
        {
            "talkId": "6781001",
            "initDialog": "678100101",
            "dialogues": [
                {
                    "id": "678100101",
                    "speaker": "谢列布里亚科夫",
                    "text": "各、各位乘客，一定要注意安全…没有、没有出事吧！"
                }
            ]
        },
        {
            "talkId": "6781002",
            "initDialog": "678100201",
            "dialogues": [
                {
                    "id": "678100201",
                    "speaker": "Player",
                    "text": "出事会怎么样？"
                },
                {
                    "id": "678100202",
                    "speaker": "谢列布里亚科夫",
                    "text": "那、那我一定会被革职…不对，关键不是这个…"
                },
                {
                    "id": "678100203",
                    "speaker": "谢列布里亚科夫",
                    "text": "我一定会尽我最大的努力解决列车上出现的问题！嗯…虽、虽然也不知道应该怎么解决。"
                },
                {
                    "id": "678100204",
                    "speaker": "谢列布里亚科夫",
                    "text": "但总之，先、先努力就行了…至少巴亚廷斯基前辈是这样说的，努力的心要先于解决的手段采取行动…"
                }
            ]
        },
        {
            "talkId": "6781003",
            "initDialog": "678100301",
            "dialogues": [
                {
                    "id": "678100301",
                    "speaker": "Player",
                    "text": "关于运输局…"
                },
                {
                    "id": "678100302",
                    "speaker": "谢列布里亚科夫",
                    "text": "哦，您…您是对「至冬皇家轨道运输局」感兴趣吗…运输局基本囊括了与列车相关的一应事务…"
                },
                {
                    "id": "678100303",
                    "speaker": "谢列布里亚科夫",
                    "text": "包括保证列车正常运转的安全员，像我们这些在列车运行过程中进行工作的列车员…"
                },
                {
                    "id": "678100304",
                    "speaker": "谢列布里亚科夫",
                    "text": "还有打击犯罪的警探…我、我一开始是想成为警探的，却被说胆子太小了，真是…真是令人悲伤。"
                }
            ]
        },
        {
            "talkId": "6781004",
            "initDialog": "678100401",
            "dialogues": [
                {
                    "id": "678100401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "678100402",
                    "speaker": "谢列布里亚科夫",
                    "text": "没、没有的事…一点都不打扰…"
                }
            ]
        }
    ]
}