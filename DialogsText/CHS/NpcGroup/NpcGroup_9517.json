        },
        {
            "talkId": "6951706",
            "initDialog": "695170601",
            "dialogues": [
                {
                    "id": "695170601",
                    "speaker": "莫娜",
                    "text": "真的要和我打牌吗？输了可别哭鼻子喔。"
