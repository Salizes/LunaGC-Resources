            "talkId": "6951705",
            "initDialog": "695170501",
            "dialogues": [
                {
                    "id": "695170501",
                    "speaker": "莫娜",
                    "text": "这游戏里要用的卡牌也太多了，怎么可能一下子记住啦。"
                }
