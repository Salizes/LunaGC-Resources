{
    "groupId": "7468",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "古列维科夫": 6
    },
    "talks": [
        {
            "talkId": "6746801",
            "initDialog": "674680101",
            "dialogues": [
                {
                    "id": "674680101",
                    "speaker": "古列维科夫",
                    "text": "各位乘客，请保持同行顺序，往后靠！先下后上，注意安全！…这位乘客，怎么了？"
                }
            ]
        },
        {
            "talkId": "6746802",
            "initDialog": "674680201",
            "dialogues": [
                {
                    "id": "674680201",
                    "speaker": "Player",
                    "text": "站台人真多…"
                },
                {
                    "id": "674680202",
                    "speaker": "古列维科夫",
                    "text": "那是当然的，这里可是至冬的列车总站，每天在这儿来往的可不是少数…"
                },
                {
                    "id": "674680203",
                    "speaker": "古列维科夫",
                    "text": "所以上下站台时人群总是别样拥挤，也是最容易出些小事故的地方…所以得小心应对。"
                }
            ]
        },
        {
            "talkId": "6746803",
            "initDialog": "674680301",
            "dialogues": [
                {
                    "id": "674680301",
                    "speaker": "Player",
                    "text": "如果在站台横冲直撞…"
                },
                {
                    "id": "674680302",
                    "speaker": "古列维科夫",
                    "text": "如果是相对紧急的情况，我们会谅解，可如果不是…那您就会因为破坏公众秩序被压去运输局总部…"
                },
                {
                    "id": "674680303",
                    "speaker": "古列维科夫",
                    "text": "估计得交一笔略大到…能让人长点记性的罚款了。"
                }
            ]
        },
        {
            "talkId": "6746804",
            "initDialog": "674680401",
            "dialogues": [
                {
                    "id": "674680401",
                    "speaker": "Player",
                    "text": "不，没什么事…"
                },
                {
                    "id": "674680402",
                    "speaker": "古列维科夫",
                    "text": "好的，还请注意安全，这位乘客。"
                }
            ]
        }
    ]
}