{
    "groupId": "4127",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "阿巴尼斯": 7
    },
    "talks": [
        {
            "talkId": "6412701",
            "initDialog": "641270101",
            "dialogues": [
                {
                    "id": "641270101",
                    "speaker": "阿巴尼斯",
                    "text": "最近是不是不太对劲啊…看样子得多找两个佣兵才行。"
                }
            ]
        },
        {
            "talkId": "6412702",
            "initDialog": "641270201",
            "dialogues": [
                {
                    "id": "641270201",
                    "speaker": "Player",
                    "text": "有情况？"
                },
                {
                    "id": "641270202",
                    "speaker": "阿巴尼斯",
                    "text": "倒也没发生什么严重的乱子，但反常的情况确实有。"
                },
                {
                    "id": "641270203",
                    "speaker": "阿巴尼斯",
                    "text": "我不是在商队有船吗，最近就发现至冬直供教令院的进口商品突然增加了不少。"
                },
                {
                    "id": "641270204",
                    "speaker": "阿巴尼斯",
                    "text": "这可让我们这的许多商队始料未及，好多定好的计划都被打乱了。"
                },
                {
                    "id": "641270205",
                    "speaker": "阿巴尼斯",
                    "text": "还有啊，总觉得最近海盗的动静也有些大，甚至有远海的海乱鬼出没！"
                },
                {
                    "id": "641270206",
                    "speaker": "阿巴尼斯",
                    "text": "我可不想碰上什么海盗袭击事件，必须赶紧想点办法。"
                }
            ]
        },
        {
            "talkId": "6412703",
            "initDialog": "641270301",
            "dialogues": [
                {
                    "id": "641270301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641270302",
                    "speaker": "阿巴尼斯",
                    "text": "再见，我得抓紧想想雇人的事情了。"
                }
            ]
        }
    ]
}