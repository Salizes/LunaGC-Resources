{
    "groupId": "9592",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "伊安珊": 10
    },
    "talks": [
        {
            "talkId": "6959201",
            "initDialog": "695920101",
            "dialogues": [
                {
                    "id": "695920101",
                    "speaker": "伊安珊",
                    "text": "大家都这么…坐着玩牌，一玩一整天？嗯…要是可以的话，也应该起身活动一下啊…"
                }
            ]
        },
        {
            "talkId": "6959202",
            "initDialog": "695920201",
            "dialogues": [
                {
                    "id": "695920201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959203",
            "initDialog": "695920301",
            "dialogues": [
                {
                    "id": "695920301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695920302",
                    "speaker": "伊安珊",
                    "text": "要走了？行，我也要回去了，部族里还有一群人等着我去训练呢。今天是他们的练腿日，谁都别想跑。"
                }
            ]
        },
        {
            "talkId": "6959204",
            "initDialog": "695920401",
            "dialogues": [
                {
                    "id": "695920401",
                    "speaker": "伊安珊",
                    "text": "果然玩牌之前就应该做点运动，这样脑子能转得更快。怎么样？和我一起出去慢跑两圈？"
                }
            ]
        },
        {
            "talkId": "6959205",
            "initDialog": "695920501",
            "dialogues": [
                {
                    "id": "695920501",
                    "speaker": "伊安珊",
                    "text": "唉，输掉了…怪了，怎么我头晕乎乎的，脑子也转得好慢。难道是今天的训练负重上太大了…？"
                }
            ]
        },
        {
            "talkId": "6959206",
            "initDialog": "695920601",
            "dialogues": [
                {
                    "id": "695920601",
                    "speaker": "伊安珊",
                    "text": "玩牌？好啊，我正好锻炼结束了。"
                }
            ]
        },
        {
            "talkId": "6959208",
            "initDialog": "695920801",
            "dialogues": [
                {
                    "id": "695920801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959209",
            "initDialog": "695920901",
            "dialogues": [
                {
                    "id": "695920901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959210",
            "initDialog": "695921001",
            "dialogues": [
                {
                    "id": "695921001",
                    "speaker": "伊安珊",
                    "text": "赢了！呼…刚才我紧张死了，心跳得比锻炼时还快啊…"
                }
            ]
        },
        {
            "talkId": "6959211",
            "initDialog": "695921101",
            "dialogues": [
                {
                    "id": "695921101",
                    "speaker": "伊安珊",
                    "text": "哎…一着不慎，全都输掉了。"
                }
            ]
        },
        {
            "talkId": "6959212",
            "initDialog": "695921201",
            "dialogues": [
                {
                    "id": "695921201",
                    "speaker": "伊安珊",
                    "text": "行，正好我也要休息一会。放心吧，虽然我今天的练习部位是胳膊，但握住几张牌还是轻轻松松的。"
                }
            ]
        },
        {
            "talkId": "6959214",
            "initDialog": "695921401",
            "dialogues": [
                {
                    "id": "695921401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959215",
            "initDialog": "695921501",
            "dialogues": [
                {
                    "id": "695921501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959216",
            "initDialog": "695921601",
            "dialogues": [
                {
                    "id": "695921601",
                    "speaker": "伊安珊",
                    "text": "赢了。被部族里的那些家伙每天抓着打牌，看来我也算是熟能生巧了。"
                }
            ]
        },
        {
            "talkId": "6959217",
            "initDialog": "695921701",
            "dialogues": [
                {
                    "id": "695921701",
                    "speaker": "伊安珊",
                    "text": "是我输了。你打牌比我厉害太多了，想要和你对局，我还要多加练习才是。"
                }
            ]
        },
        {
            "talkId": "6959218",
            "initDialog": "695921801",
            "dialogues": [
                {
                    "id": "695921801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}