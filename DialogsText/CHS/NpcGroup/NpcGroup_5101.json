{
    "groupId": "5101",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "格莱丝": 7
    },
    "talks": [
        {
            "talkId": "6510101",
            "initDialog": "651010101",
            "dialogues": [
                {
                    "id": "651010101",
                    "speaker": "格莱丝",
                    "text": "无论是想要前往歌剧院还是露景泉，都请沿着这条大道向南行进吧。"
                }
            ]
        },
        {
            "talkId": "6510102",
            "initDialog": "651010201",
            "dialogues": [
                {
                    "id": "651010201",
                    "speaker": "Player",
                    "text": "关于歌剧院…"
                },
                {
                    "id": "651010202",
                    "speaker": "格莱丝",
                    "text": "伊黎耶岛上最为宏伟的建筑就是「欧庇克莱歌剧院」，一般枫丹人口中的歌剧院便是指代那里。"
                },
                {
                    "id": "651010203",
                    "speaker": "格莱丝",
                    "text": "歌剧院除了承办各类文艺演出以外，还有一项更为重要的作用。"
                },
                {
                    "id": "651010204",
                    "speaker": "格莱丝",
                    "text": "那就是作为「审判庭」，见证枫丹所有案件的审理。"
                }
            ]
        },
        {
            "talkId": "6510103",
            "initDialog": "651010301",
            "dialogues": [
                {
                    "id": "651010301",
                    "speaker": "Player",
                    "text": "关于露景泉…"
                },
                {
                    "id": "651010302",
                    "speaker": "格莱丝",
                    "text": "露景泉是枫丹所有水流的汇集之地，所以是大家最喜欢去许愿的地方。"
                },
                {
                    "id": "651010303",
                    "speaker": "格莱丝",
                    "text": "想要孩子的枫丹夫妻通常会结伴去泉水边许愿，坚信水中的精灵会帮他们迎来一个健康又快乐的孩子。"
                }
            ]
        },
        {
            "talkId": "6510104",
            "initDialog": "651010401",
            "dialogues": [
                {
                    "id": "651010401",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "651010402",
                    "speaker": "格莱丝",
                    "text": "不客气。"
                }
            ]
        }
    ]
}