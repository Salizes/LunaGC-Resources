{
    "groupId": "15331",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "方谨": 26
    },
    "talks": [
        {
            "talkId": "7167001",
            "initDialog": "716700101",
            "dialogues": [
                {
                    "id": "716700101",
                    "speaker": "方谨",
                    "text": "要主动攻入地脉紊乱点的秘境了吗…祝旗开得胜！"
                }
            ]
        },
        {
            "talkId": "7167004",
            "initDialog": "716700401",
            "dialogues": [
                {
                    "id": "716700401",
                    "speaker": "方谨",
                    "text": "#{NICKNAME}，你来了！"
                },
                {
                    "id": "716700402",
                    "speaker": "方谨",
                    "text": "目前战况稳定，地脉紊乱点并不活跃，我部正持续清剿外逃的魔物。",
                    "choices": [
                        {
                            "id": "716700403",
                            "text": "关于地脉紊乱点…",
                            "response": [
                                {
                                    "id": "716700404",
                                    "speaker": "方谨",
                                    "text": "如您所见，相比最初的形态，地脉紊乱点发生了相当程度的变化。为此，我们加强了侦察，部署了更多预备队…"
                                },
                                {
                                    "id": "716700405",
                                    "speaker": "方谨",
                                    "text": "好在，根据斥候部队的综合情报分析，短时间内，威胁依然可控。"
                                },
                                {
                                    "id": "716700406",
                                    "speaker": "方谨",
                                    "text": "即便在它最为活跃的阶段，我们也能稳住防线。"
                                },
                                {
                                    "id": "716700407",
                                    "speaker": "方谨",
                                    "text": "当然，相信您也能不断削弱它的势头，压制它的进一步异变。"
                                }
                            ]
                        },
                        {
                            "id": "716700408",
                            "text": "关于驻军的情况…",
                            "response": [
                                {
                                    "id": "716700409",
                                    "speaker": "方谨",
                                    "text": "请放心，目前将士们精力充沛，配发了近乎全新的武备，部队韧性极佳，还能以最高战备长期驻守。"
                                },
                                {
                                    "id": "716700410",
                                    "speaker": "方谨",
                                    "text": "经开阳星大人精确调遣，每过半个月，一线作战的将士们都会进行轮换，以防部队劳损过度。"
                                },
                                {
                                    "id": "716700411",
                                    "speaker": "方谨",
                                    "text": "眼下，局面已趋于稳定，轮换部队已由七成老兵与三成新兵组成。"
                                },
                                {
                                    "id": "716700412",
                                    "speaker": "方谨",
                                    "text": "如此一来，既能稳定地应对敌情，又能将险境化为我用，为将士们提供充分的实战训练。"
                                },
                                {
                                    "id": "716700413",
                                    "speaker": "方谨",
                                    "text": "当然，无论人员如何调动，我和我的几位得力部下都会在此常驻，一直配合你，请放心。"
                                }
                            ]
                        },
                        {
                            "id": "716700414",
                            "text": "辛苦了。",
                            "response": [
                                {
                                    "id": "716700415",
                                    "speaker": "方谨",
                                    "text": "职责所在，理当全力以赴！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7167006",
            "initDialog": "716700601",
            "dialogues": [
                {
                    "id": "716700601",
                    "speaker": "方谨",
                    "text": "#又见面了，{NICKNAME}…"
                },
                {
                    "id": "716700602",
                    "speaker": "方谨",
                    "text": "我有两则消息要带给您，一则不幸，一则万幸。",
                    "choices": [
                        {
                            "id": "716700603",
                            "text": "请说不幸的消息。",
                            "response": [
                                {
                                    "id": "716700604",
                                    "speaker": "方谨",
                                    "text": "如你所见，地脉紊乱点再次开始活跃。相比最初的状态，现在它的外形似乎显得更为危险…当然，也只是外形而已。"
                                },
                                {
                                    "id": "716700605",
                                    "speaker": "方谨",
                                    "text": "凶戾的魔物已开始躁动，你来之前，我们已经击退了若干波次的攻势。"
                                },
                                {
                                    "id": "716700606",
                                    "speaker": "方谨",
                                    "text": "接下来，又要烦请你出手，攻抵秘境的最深处，将它再次重创了。",
                                    "choices": [
                                        {
                                            "id": "716700607",
                                            "text": "无妨，我随时准备着。",
                                            "response": [
                                                {
                                                    "id": "716700608",
                                                    "speaker": "方谨",
                                                    "text": "真是锐不可当的气势…相信您这次依然能斩获惊人的战果！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716700609",
                                            "text": "我稍作战斗准备再来。",
                                            "response": [
                                                {
                                                    "id": "716700610",
                                                    "speaker": "方谨",
                                                    "text": "请安心整备，在此之前，我部会将所有出逃的魔物全数清剿。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716700611",
                            "text": "先说万幸的好消息吧。",
                            "response": [
                                {
                                    "id": "716700612",
                                    "speaker": "方谨",
                                    "text": "得益于地脉紊乱点的再次活跃，将士们又将迎来一次极具考验的实战演练。"
                                },
                                {
                                    "id": "716700613",
                                    "speaker": "方谨",
                                    "text": "此前，璃月多地的危险魔物已被千岩军清剿一空，普通的将士很难得到这种真刀真枪对抗强敌的机会。"
                                },
                                {
                                    "id": "716700614",
                                    "speaker": "方谨",
                                    "text": "但长期处于安定的环境下，将士们的身体和意志都会生锈。实战则是反映问题、彻查不足的重要渠道。"
                                },
                                {
                                    "id": "716700615",
                                    "speaker": "方谨",
                                    "text": "所以，在保证防线稳定，确保严格抑制危害的前提下，千岩军正通过这个地脉紊乱点不断强化自身。"
                                },
                                {
                                    "id": "716700616",
                                    "speaker": "方谨",
                                    "text": "经过最近的磨练，不少战士进步显著，相信以后还会涌现出更多杰出强者！"
                                }
                            ]
                        },
                        {
                            "id": "716700617",
                            "text": "容我斟酌一番，再来与你交流。",
                            "response": [
                                {
                                    "id": "716700618",
                                    "speaker": "方谨",
                                    "text": "好的，我随时在此候命。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}