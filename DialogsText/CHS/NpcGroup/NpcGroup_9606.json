{
    "groupId": "9606",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "菈乌玛": 10
    },
    "talks": [
        {
            "talkId": "6960601",
            "initDialog": "696060101",
            "dialogues": [
                {
                    "id": "696060101",
                    "speaker": "菈乌玛",
                    "text": "狂风难以在深林处起舞。霜月之子中也有一些人在玩「七圣召唤」。或许，应该鼓励他们外出交流一番…"
                }
            ]
        },
        {
            "talkId": "6960602",
            "initDialog": "696060201",
            "dialogues": [
                {
                    "id": "696060201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960603",
            "initDialog": "696060301",
            "dialogues": [
                {
                    "id": "696060301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696060302",
                    "speaker": "菈乌玛",
                    "text": "愿月光为你照亮前路，愿谧林保佑你永不迷途。"
                }
            ]
        },
        {
            "talkId": "6960604",
            "initDialog": "696060401",
            "dialogues": [
                {
                    "id": "696060401",
                    "speaker": "菈乌玛",
                    "text": "即使恒常如月，也会有升落。你这次或许只是运气不好而已，要不要再来一局试试看？"
                }
            ]
        },
        {
            "talkId": "6960605",
            "initDialog": "696060501",
            "dialogues": [
                {
                    "id": "696060501",
                    "speaker": "菈乌玛",
                    "text": "我听说沙漠里有流沙，会主动设下陷阱迷惑那些粗心的敌人。刚刚的对局让我觉得，你的策略正是如此精妙呢。嗯，什么？你说流沙不是这样的？"
                }
            ]
        },
        {
            "talkId": "6960606",
            "initDialog": "696060601",
            "dialogues": [
                {
                    "id": "696060601",
                    "speaker": "菈乌玛",
                    "text": "「七圣召唤」？当然没问题，只不过关于它的规则，我都是从朋友们那里听说的。如果我的理解有误，还请不要介意。"
                }
            ]
        },
        {
            "talkId": "6960608",
            "initDialog": "696060801",
            "dialogues": [
                {
                    "id": "696060801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960609",
            "initDialog": "696060901",
            "dialogues": [
                {
                    "id": "696060901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960610",
            "initDialog": "696061001",
            "dialogues": [
                {
                    "id": "696061001",
                    "speaker": "菈乌玛",
                    "text": "一切皆仰赖月光的指引…"
                }
            ]
        },
        {
            "talkId": "6960611",
            "initDialog": "696061101",
            "dialogues": [
                {
                    "id": "696061101",
                    "speaker": "菈乌玛",
                    "text": "看起来我的牌技，还是远远不够呢。"
                }
            ]
        },
        {
            "talkId": "6960612",
            "initDialog": "696061201",
            "dialogues": [
                {
                    "id": "696061201",
                    "speaker": "菈乌玛",
                    "text": "要再来一局？嗯，好，如果这是你的愿望的话。"
                }
            ]
        },
        {
            "talkId": "6960614",
            "initDialog": "696061401",
            "dialogues": [
                {
                    "id": "696061401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960615",
            "initDialog": "696061501",
            "dialogues": [
                {
                    "id": "696061501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960616",
            "initDialog": "696061601",
            "dialogues": [
                {
                    "id": "696061601",
                    "speaker": "菈乌玛",
                    "text": "转瞬即逝的好运，是谧林赠予的祝福…"
                }
            ]
        },
        {
            "talkId": "6960617",
            "initDialog": "696061701",
            "dialogues": [
                {
                    "id": "696061701",
                    "speaker": "菈乌玛",
                    "text": "输了吗？果然不应该太过激进的。"
                }
            ]
        },
        {
            "talkId": "6960618",
            "initDialog": "696061801",
            "dialogues": [
                {
                    "id": "696061801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}