{
    "groupId": "5089",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "瓦纳格姆": 8
    },
    "talks": [
        {
            "talkId": "6508901",
            "initDialog": "650890101",
            "dialogues": [
                {
                    "id": "650890101",
                    "speaker": "瓦纳格姆",
                    "text": "艺术与美食相伴，如此美妙的生活…"
                }
            ]
        },
        {
            "talkId": "6508902",
            "initDialog": "650890201",
            "dialogues": [
                {
                    "id": "650890201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "650890202",
                    "speaker": "瓦纳格姆",
                    "text": "很高兴能在这样美妙的日子遇见您，尊敬的客人。鄙人瓦纳格姆，是这家餐厅的经营者。"
                },
                {
                    "id": "650890203",
                    "speaker": "瓦纳格姆",
                    "text": "如您对菜品或演出有任何意见或建议，还请您坦言相告，鄙人将竭力为您奉上更周全的服务。"
                }
            ]
        },
        {
            "talkId": "6508903",
            "initDialog": "650890301",
            "dialogues": [
                {
                    "id": "650890301",
                    "speaker": "Player",
                    "text": "关于艺术…"
                },
                {
                    "id": "650890302",
                    "speaker": "瓦纳格姆",
                    "text": "如您所知，我们经常会邀请艺术家在餐厅内进行才艺演出。眼下最受观众欢迎的，当属林尼先生与琳妮特小姐的魔术表演。"
                },
                {
                    "id": "650890303",
                    "speaker": "瓦纳格姆",
                    "text": "「艺术是美食最好的作料。」这正是鄙人所坚持的信条。由衷希望此举也能将这里的文化氛围进一步传播与发扬。"
                }
            ]
        },
        {
            "talkId": "6508904",
            "initDialog": "650890401",
            "dialogues": [
                {
                    "id": "650890401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650890402",
                    "speaker": "瓦纳格姆",
                    "text": "再见，尊敬的客人，希望德波大饭店为您留下一段美好的记忆。"
                }
            ]
        },
        {
            "talkId": "7493201",
            "initDialog": "749320101",
            "dialogues": [
                {
                    "id": "749320101",
                    "speaker": "Player",
                    "text": "很了不起。"
                },
                {
                    "id": "749320102",
                    "speaker": "瓦纳格姆",
                    "text": "衷心感谢您的认可，尊敬的客人。如您愿意，请收下这份甜品，作为鄙人个人名义的答谢。"
                },
                {
                    "id": "749320103",
                    "speaker": "瓦纳格姆",
                    "text": "祝您用餐愉快。"
                }
            ]
        }
    ]
}