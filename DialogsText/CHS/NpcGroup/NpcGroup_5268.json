{
    "groupId": "5268",
    "total_dialogue_lines": 88,
    "speaker_counts": {
        "Black Screen": 2,
        "Player": 26,
        "吉雅罗": 42,
        "派蒙": 17,
        "陷入迷惑的小猫": 1
    },
    "talks": [
        {
            "talkId": "7005001",
            "initDialog": "700500101",
            "dialogues": [
                {
                    "id": "700500101",
                    "speaker": "吉雅罗",
                    "text": "…这只小猫…没错，一定是这样！太棒了，我就知道！",
                    "choices": [
                        {
                            "id": "700500102",
                            "text": "吉雅罗？",
                            "response": [
                                {
                                    "id": "700500103",
                                    "speaker": "吉雅罗",
                                    "text": "#欸？{NICKNAME}，派蒙，这么巧，你们也来翘英庄玩吗？"
                                },
                                {
                                    "id": "700500106",
                                    "speaker": "派蒙",
                                    "text": "你…写完小说了吗？不会还在想那些奇奇怪怪的事吧…",
                                    "choices": [
                                        {
                                            "id": "700500107",
                                            "text": "还有妄想症状吗？",
                                            "response": [
                                                {
                                                    "id": "700500109",
                                                    "speaker": "吉雅罗",
                                                    "text": "不会不会，我那本《诡计枫丹廷》已经写好啦，现在就等着刊印和正式发售了。"
                                                },
                                                {
                                                    "id": "700500110",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇，听起来好像是一本很厉害的书！里面都讲了什么呀？"
                                                },
                                                {
                                                    "id": "700500111",
                                                    "speaker": "吉雅罗",
                                                    "text": "一个胆小的侦探和他无畏的妹妹兼助手，一家搜集了无数犯罪者罪证的「罪案博物馆」…"
                                                },
                                                {
                                                    "id": "700500112",
                                                    "speaker": "吉雅罗",
                                                    "text": "失踪的双胞胎、哭泣着的机关人偶、溺亡在喷泉里的博物馆长…嫌疑人却是一个年仅三岁的孩子。",
                                                    "choices": [
                                                        {
                                                            "id": "700500113",
                                                            "text": "好了！好了！身上发冷了！",
                                                            "response": [
                                                                {
                                                                    "id": "700500115",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "哈哈哈，到时候正式发售后，我会送两本签名本给你们的。"
                                                                },
                                                                {
                                                                    "id": "700500116",
                                                                    "speaker": "派蒙",
                                                                    "text": "好欸！不过…我应该不敢一个人看…"
                                                                },
                                                                {
                                                                    "id": "700500117",
                                                                    "speaker": "派蒙",
                                                                    "text": "#决定了！{NICKNAME}念给我听！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700500118",
                                                                            "text": "我、我也不敢看啊…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700500119",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这样吗…那没办法了，只能我们一起看了…"
                                                                                },
                                                                                {
                                                                                    "id": "700500122",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "你们别这么夸张啦，这也只是一本罪案小说，真的不会很吓人的。"
                                                                                },
                                                                                {
                                                                                    "id": "700500123",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "真正吓人的…是我正准备写的新小说，我已经拟好了一个粗略的大纲，正在为了故事细节四处取材呢。"
                                                                                },
                                                                                {
                                                                                    "id": "700500124",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "…你们别这么看着我嘛。我这次只是想要把罪案小说和民俗传说联系在一起，就算是取材，也绝对不会像上次那样一惊一乍啦。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "700500125",
                                                                                            "text": "你为什么不在枫丹取材？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700500126",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "这个啊…哎呀，枫丹的民俗传说已经有好多人写过了，我想要找一些有新意的题材嘛。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500129",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "正巧我有一个认识的朋友要来翘英庄考察茶叶生意，我就搭着顺路船过来啦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500130",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "一下船，我就发现了一个绝佳的题材，正在思考如何追查下去呢，你们就过来了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500131",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "用璃月人的话来说，这就是…那个，呃…「有缘千里来相会」？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500132",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "已经开始融入璃月氛围了啊…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500133",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "怎么说…该说不愧是作家吗？在理解文化氛围这件事上还真是迅速啊…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500134",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "不过，你说已经找到了题材？周围什么东西也没有呀。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500135",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "谁说没有的，喏，看见这只小猫了吗？",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "700500136",
                                                                                                            "text": "看见很久了！难道它还能不是小猫吗？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "700500140",
                                                                                                                    "speaker": "陷入迷惑的小猫",
                                                                                                                    "text": "喵…？喵…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500141",
                                                                                                                    "speaker": "吉雅罗",
                                                                                                                    "text": "这就是你有所不知了，在翘英庄的传说中，有一种名为「玄文兽」的异兽。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500142",
                                                                                                                    "speaker": "吉雅罗",
                                                                                                                    "text": "传说里，这种异兽体如幼猫，夜伏昼出，餐…那个，餐风饮露，日行千里，能辨别善恶，每夜都在啃噬茶树，以此供养己身…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500143",
                                                                                                                    "speaker": "吉雅罗",
                                                                                                                    "text": "总之！《惊奇！》里的那篇文章是这么写的啦！",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "700500144",
                                                                                                                            "text": "听这名字就一点可信度也没有！",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "700500146",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "总感觉…写这篇文章的人，就仅仅打听到了「玄文兽」这个名字，然后就一股脑的把各种乱七八糟的传闻拼了上去…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500147",
                                                                                                                                    "speaker": "吉雅罗",
                                                                                                                                    "text": "不过，根据我的调查，翘英庄附近的确存在着「玄文兽」，虽然不知道它的详细情况…但只要存在，就能够取材！"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500148",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "呜哇…吉雅罗小姐的状态，和上次见面的时候完全不一样了。明明之前还是一副超胆小的样子…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500149",
                                                                                                                                    "speaker": "Player",
                                                                                                                                    "text": "现在凭着一个名字追到了这里…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500150",
                                                                                                                                    "speaker": "吉雅罗",
                                                                                                                                    "text": "哈哈哈哈哈，抱歉啦。这是我个人的一个毛病，只要开始写书，就会不由自主地代入书里的状态。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500151",
                                                                                                                                    "speaker": "吉雅罗",
                                                                                                                                    "text": "我这本书的主角是一个超级自信，甚至可以称得上是「目中无人」的侦探啦…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500152",
                                                                                                                                    "speaker": "吉雅罗",
                                                                                                                                    "text": "好了，闲话说到这里，我要好好研究一下这只…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500153",
                                                                                                                                    "speaker": "Black Screen",
                                                                                                                                    "text": "小猫飞快地转身跑开了…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500154",
                                                                                                                                    "speaker": "吉雅罗",
                                                                                                                                    "text": "呜哇！跑掉了，快追！"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500155",
                                                                                                                                    "speaker": "Black Screen",
                                                                                                                                    "text": "吉雅罗二话不说，拔腿追逐起了飞奔的小猫…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500156",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "#又开始啦！我们快追上，{NICKNAME}，不然说不定吉雅罗小姐又要做什么奇怪的事了！"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500157",
                                                                                                                                    "speaker": "派蒙",
                                                                                                                                    "text": "吉雅罗小姐！慢点跑啦！"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "700500145",
                                                                                                                            "text": "这又是哪里来的地摊小报？"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "700500137",
                                                                                                            "text": "难道它不是小猫，是别的什么…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "700500138",
                                                                                                                    "speaker": "吉雅罗",
                                                                                                                    "text": "你也这么想？！太好了，你和我的想法完全一致！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500139",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "不不不不，完全不对吧！无论如何，看起来都只是一只普普通通的小猫啦！"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "700500127",
                                                                                            "text": "亏你专门跑来翘英庄取材啊…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700500128",
                                                                                                    "speaker": "吉雅罗",
                                                                                                    "text": "毕竟枫丹的民俗传说已经有好多人写过了嘛，我想要找一些有新意的题材…"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700500120",
                                                                            "text": "交给我吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700500121",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嘿嘿，就知道你最好了。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700500114",
                                                            "text": "听起来就是一个超级大案…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700500108",
                                            "text": "这里可不是枫丹，离家很远喔。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700500104",
                            "text": "这只小猫怎么了？",
                            "response": [
                                {
                                    "id": "700500105",
                                    "speaker": "吉雅罗",
                                    "text": "#我认为它就是…欸？欸？{NICKNAME}，派蒙，这么巧，你们也来翘英庄玩吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7480001",
            "initDialog": "748000101",
            "dialogues": [
                {
                    "id": "748000101",
                    "speaker": "吉雅罗",
                    "text": "应该不会…应该不会…"
                },
                {
                    "id": "748000102",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "748000103",
                    "speaker": "吉雅罗",
                    "text": "啊！别！我什么也没干，别伤害我！"
                },
                {
                    "id": "748000104",
                    "speaker": "派蒙",
                    "text": "你在说什么呢。我们为什么要伤害你呀？"
                },
                {
                    "id": "748000105",
                    "speaker": "吉雅罗",
                    "text": "我不知道！但我也不知道你们不会伤害我。",
                    "choices": [
                        {
                            "id": "748000106",
                            "text": "什么乱七八糟的…",
                            "response": [
                                {
                                    "id": "748000108",
                                    "speaker": "吉雅罗",
                                    "text": "对了…对了！一定是因为我发现了你们的秘密，对吧？"
                                },
                                {
                                    "id": "748000109",
                                    "speaker": "吉雅罗",
                                    "text": "是…是我在咖啡馆里拿走了夹着你们密信的报纸？"
                                },
                                {
                                    "id": "748000110",
                                    "speaker": "吉雅罗",
                                    "text": "还是我不小心看见了你们接头的密语？等等，难道是我昨晚上吃的那一条鱼…"
                                },
                                {
                                    "id": "748000111",
                                    "speaker": "吉雅罗",
                                    "text": "我就说那条鱼为什么刺那么少，是你们把那条鱼身上的刺给剔下来的！"
                                },
                                {
                                    "id": "748000112",
                                    "speaker": "吉雅罗",
                                    "text": "对，对，你们想用鱼骨两侧不同的鱼刺数量传递消息…但这条鱼却阴差阳错被我买回了家…"
                                },
                                {
                                    "id": "748000113",
                                    "speaker": "派蒙",
                                    "text": "这家伙，到底在说什么呀？完全听不明白…",
                                    "choices": [
                                        {
                                            "id": "748000114",
                                            "text": "我不会伤害你的。",
                                            "response": [
                                                {
                                                    "id": "748000116",
                                                    "speaker": "吉雅罗",
                                                    "text": "你们、你们真不是来害我的？"
                                                },
                                                {
                                                    "id": "748000117",
                                                    "speaker": "派蒙",
                                                    "text": "你这个人！我们才第一次见到你，为什么要害你呀？"
                                                },
                                                {
                                                    "id": "748000118",
                                                    "speaker": "吉雅罗",
                                                    "text": "是吗？那、那就好…真是抱歉，不好意思…"
                                                },
                                                {
                                                    "id": "748000119",
                                                    "speaker": "吉雅罗",
                                                    "text": "我最近一直在琢磨一篇侦探小说，但一直不知道让里面的犯人用什么手法作案比较巧妙。"
                                                },
                                                {
                                                    "id": "748000120",
                                                    "speaker": "吉雅罗",
                                                    "text": "因为我想得太多，所以…现在看见任何东西，第一反应就是如何用它来…作案。"
                                                },
                                                {
                                                    "id": "748000121",
                                                    "speaker": "吉雅罗",
                                                    "text": "唉，所以我才…这么紧张，真是不好意思。用人家的话来说，我简直有「被害妄想」了。"
                                                },
                                                {
                                                    "id": "748000122",
                                                    "speaker": "吉雅罗",
                                                    "text": "我刚才准备坐巡轨船去城里喝杯咖啡，但当我看见巡轨船运行的样子…"
                                                },
                                                {
                                                    "id": "748000123",
                                                    "speaker": "吉雅罗",
                                                    "text": "我、我脑子里一瞬间就浮现了无数种我在巡轨船上被害的样子，根本不敢上船。",
                                                    "choices": [
                                                        {
                                                            "id": "748000124",
                                                            "text": "你自己都说是「妄想」了。",
                                                            "response": [
                                                                {
                                                                    "id": "748000126",
                                                                    "speaker": "吉雅罗",
                                                                    "text": "话是这么说没错。但我就是忍不住想个没完，越想就越害怕…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "748000127",
                                                                            "text": "我陪你去吧…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "748000129",
                                                                                    "speaker": "吉雅罗",
                                                                                    "text": "真的？！太好了，但是…如果那个想要害我的人，连你一起害了呢？"
                                                                                },
                                                                                {
                                                                                    "id": "748000130",
                                                                                    "speaker": "Player",
                                                                                    "text": "你就放心吧…"
                                                                                },
                                                                                {
                                                                                    "id": "748000131",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#走啦走啦，别想那么多。无论任何问题，{NICKNAME}都会轻松解决掉的。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "748000128",
                                                                            "text": "我来护送你。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "748000125",
                                                            "text": "怎么可能，别想太多了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000115",
                                            "text": "别妄想这些乱七八糟的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000107",
                            "text": "你在说什么呢？"
                        }
                    ]
                }
            ]
        }
    ]
}