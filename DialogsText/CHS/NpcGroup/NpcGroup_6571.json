            "dialogues": [
                {
                    "id": "665710101",
                    "speaker": "卡苏娅",
                    "text": "眼睛里有飘飘的东西，可恶，明明景色这么好…"
                }
            ]
        },
        {
            "talkId": "6657102",
            "initDialog": "665710201",
            "dialogues": [
                {
                    "id": "665710201",
                    "speaker": "Player",
                    "text": "飘飘的东西？"
                },
                {
                    "id": "665710202",
                    "speaker": "卡苏娅",
                    "text": "欸？你没看到吗？你等着，我现在就去找我的龙伙伴来，我抓住它给你看！"
                },
                {
                    "id": "665710203",
                    "speaker": "卡苏娅",
                    "text": "没错，现在就去…现在…现在…呼…"
                }
            ]
        },
        {
            "talkId": "6657104",
            "initDialog": "665710401",
            "dialogues": [
                {
                    "id": "665710401",
                    "speaker": "Player",
                    "text": "不好意思打扰了…"
                },
                {
                    "id": "665710402",
                    "speaker": "卡苏娅",
                    "text": "好、好的，下次再聊，呼…"
                }
            ]
        },
        {
            "talkId": "6657105",
            "initDialog": "665710501",
            "dialogues": [
                {
                    "id": "665710501",
                    "speaker": "卡苏娅",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6657106",
            "initDialog": "665710601",
            "dialogues": [
                {
                    "id": "665710601",
                    "speaker": "卡苏娅",
                    "text": "飘飘的东西，消失了，呼…"
                }
            ]
        },
        {
            "talkId": "6657107",
            "initDialog": "665710701",
            "dialogues": [
                {
                    "id": "665710701",
                    "speaker": "卡苏娅",
                    "text": "飘飘的东西，讨厌，呼…"
                }
            ]
        }
    ]
