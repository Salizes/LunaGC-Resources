{
    "groupId": "30139",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "小野寺": 8
    },
    "talks": [
        {
            "talkId": "4006329",
            "initDialog": "400632901",
            "dialogues": [
                {
                    "id": "400632901",
                    "speaker": "小野寺",
                    "text": "是你们啊，在容彩祭上玩得开心吗？"
                }
            ]
        },
        {
            "talkId": "4006330",
            "initDialog": "400633001",
            "dialogues": [
                {
                    "id": "400633001",
                    "speaker": "Player",
                    "text": "新刊发售会怎么样？"
                },
                {
                    "id": "400633002",
                    "speaker": "小野寺",
                    "text": "活动非常成功，读者们也都非常满意。"
                },
                {
                    "id": "400633003",
                    "speaker": "小野寺",
                    "text": "不过我现在回想起来，还是有点后怕，哈哈…"
                },
                {
                    "id": "400633004",
                    "speaker": "小野寺",
                    "text": "如果不是有你们帮忙，只凭我个人的力量，恐怕会把事情搞砸吧…"
                }
            ]
        },
        {
            "talkId": "4006331",
            "initDialog": "400633101",
            "dialogues": [
                {
                    "id": "400633101",
                    "speaker": "Player",
                    "text": "打起精神来！"
                },
                {
                    "id": "400633102",
                    "speaker": "小野寺",
                    "text": "嗯，您说得对，今后我得变得更可靠才行！"
                },
                {
                    "id": "400633103",
                    "speaker": "小野寺",
                    "text": "说起来，那天我把整件事的来龙去脉告诉八重大人的时候，她似乎心情异常地好。"
                },
                {
                    "id": "400633104",
                    "speaker": "小野寺",
                    "text": "甚至她还对我说：「因为有了小野寺，容彩祭才变得这么有趣！」"
                },
                {
                    "id": "400633105",
                    "speaker": "小野寺",
                    "text": "总觉得八重大人的话好像意有所指似的…"
                }
            ]
        }
    ]
}