{
    "groupId": "2408",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "文泽": 11
    },
    "talks": [
        {
            "talkId": "7193501",
            "initDialog": "719350101",
            "dialogues": [
                {
                    "id": "719350101",
                    "speaker": "Player",
                    "text": "你懂得真多啊。"
                },
                {
                    "id": "719350102",
                    "speaker": "文泽",
                    "text": "其实也没什么，我从小就很喜欢历史，后来很想亲自去查看这些遗迹，于是就成了冒险家。"
                },
                {
                    "id": "719350103",
                    "speaker": "文泽",
                    "text": "嗯…这些是我冒险时记下来的一些心得，送给你好了。"
                },
                {
                    "id": "719350104",
                    "speaker": "文泽",
                    "text": "如果我的知识能帮到他人的话，那就再好不过了！"
                }
            ]
        },
        {
            "talkId": "6240801",
            "initDialog": "624080101",
            "dialogues": [
                {
                    "id": "624080101",
                    "speaker": "文泽",
                    "text": "你好，你也是来寻找废都的冒险家吗？"
                }
            ]
        },
        {
            "talkId": "6240802",
            "initDialog": "624080201",
            "dialogues": [
                {
                    "id": "624080201",
                    "speaker": "Player",
                    "text": "废都？"
                },
                {
                    "id": "624080202",
                    "speaker": "文泽",
                    "text": "怎么，你不知道吗？这片废墟的地下有一座古老的废都。"
                },
                {
                    "id": "624080203",
                    "speaker": "文泽",
                    "text": "冒险家协会的前辈中流传着这样的传说，但还没有人真正发现过它。"
                }
            ]
        },
        {
            "talkId": "6240803",
            "initDialog": "624080301",
            "dialogues": [
                {
                    "id": "624080301",
                    "speaker": "Player",
                    "text": "这里有什么历史吗？"
                },
                {
                    "id": "624080302",
                    "speaker": "文泽",
                    "text": "这座遗迹曾经也是一座古城，或许早在魔神战争之前就已经荒废了。"
                },
                {
                    "id": "624080303",
                    "speaker": "文泽",
                    "text": "传说那边的两棵树下埋着古城的末代之王与他的敌人，同时也是他的挚爱…"
                },
                {
                    "id": "624080304",
                    "speaker": "文泽",
                    "text": "他们在那里同归于尽，却永远无法相互触及。"
                },
                {
                    "id": "624080305",
                    "speaker": "文泽",
                    "text": "直到一切化为土灰，废墟上生出的树木也是这样相离相望…"
                }
            ]
        },
        {
            "talkId": "6240804",
            "initDialog": "624080401",
            "dialogues": [
                {
                    "id": "624080401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624080402",
                    "speaker": "文泽",
                    "text": "再见，向着星辰与深渊。"
                }
            ]
        }
    ]
}