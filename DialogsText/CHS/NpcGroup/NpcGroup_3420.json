    "talks": [
        {
            "talkId": "6342001",
            "initDialog": "634200101",
            "dialogues": [
                {
                    "id": "634200101",
                    "speaker": "兹韦季娜",
                    "text": "真不知道馆内现在情况如何了…"
                }
            ]
        },
        {
            "talkId": "6342002",
            "initDialog": "634200201",
            "dialogues": [
                {
                    "id": "634200201",
                    "speaker": "Player",
                    "text": "雪孃？"
                },
                {
                    "id": "634200202",
                    "speaker": "兹韦季娜",
                    "text": "哦，是的…怎么了，觉得在人类聚集的地方看到雪孃很奇怪？"
                },
                {
                    "id": "634200203",
                    "speaker": "兹韦季娜",
                    "text": "哈哈，实际上，这座山，以及这座臻冰矿，都算得上是大公帕芙琳娜大人的产业…而我则是负责在此地进行管理的事务官。"
                }
            ]
        },
        {
            "talkId": "6342003",
            "initDialog": "634200301",
            "dialogues": [
                {
                    "id": "634200301",
                    "speaker": "Player",
                    "text": "什么馆内…"
                },
                {
                    "id": "634200302",
                    "speaker": "兹韦季娜",
                    "text": "没什么…是山上雪精们生活的公馆。"
                },
                {
                    "id": "634200303",
                    "speaker": "兹韦季娜",
                    "text": "定期采买一些雪精们需要的物资并遣人运送上去也是我在这里的职责之一。"
                },
                {
                    "id": "634200304",
                    "speaker": "兹韦季娜",
                    "text": "不过，说来怀念，我倒是已经有很久没有回到馆内了…"
                }
            ]
        },
        {
            "talkId": "6342004",
            "initDialog": "634200401",
            "dialogues": [
                {
                    "id": "634200401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "634200402",
                    "speaker": "兹韦季娜",
                    "text": "再见。"
                }
            ]
        }
    ]
}