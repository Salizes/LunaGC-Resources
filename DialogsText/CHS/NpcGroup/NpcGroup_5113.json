{
    "groupId": "5113",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "布蕾莘": 8
    },
    "talks": [
        {
            "talkId": "6511301",
            "initDialog": "651130101",
            "dialogues": [
                {
                    "id": "651130101",
                    "speaker": "布蕾莘",
                    "text": "喷泉上上下下，好像魔术表演。"
                }
            ]
        },
        {
            "talkId": "6511302",
            "initDialog": "651130201",
            "dialogues": [
                {
                    "id": "651130201",
                    "speaker": "Player",
                    "text": "你喜欢魔术吗？"
                },
                {
                    "id": "651130202",
                    "speaker": "布蕾莘",
                    "text": "嗯。"
                },
                {
                    "id": "651130203",
                    "speaker": "布蕾莘",
                    "text": "我的眼神很好，可以看清案发现场的蛛丝马迹，但魔术的奥妙我却看不懂。"
                },
                {
                    "id": "651130204",
                    "speaker": "布蕾莘",
                    "text": "能骗过美露莘的眼睛，魔术师真是伟大的职业呀。"
                }
            ]
        },
        {
            "talkId": "6511303",
            "initDialog": "651130301",
            "dialogues": [
                {
                    "id": "651130301",
                    "speaker": "Player",
                    "text": "你喜欢喷泉吗？"
                },
                {
                    "id": "651130302",
                    "speaker": "布蕾莘",
                    "text": "嗯，因为喷泉是永不停歇，很有活力的水。"
                },
                {
                    "id": "651130303",
                    "speaker": "布蕾莘",
                    "text": "尤其是这些高高的水柱，时上时下，是不是很像歌剧表演时的背景音乐？"
                },
                {
                    "id": "651130304",
                    "speaker": "布蕾莘",
                    "text": "不过我不是很喜欢看歌剧院里的演出。那是编造出来的人类行为，对我来说不是真实的东西。"
                }
            ]
        },
        {
            "talkId": "6511304",
            "initDialog": "651130401",
            "dialogues": [
                {
                    "id": "651130401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651130402",
                    "speaker": "布蕾莘",
                    "text": "再见，小心被喷泉淋湿哦。"
                }
            ]
        }
    ]
}