{
    "groupId": "4084",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "海娜": 11,
        "齐里亚布": 5
    },
    "talks": [
        {
            "talkId": "6408305",
            "initDialog": "640830501",
            "dialogues": [
                {
                    "id": "640830501",
                    "speaker": "齐里亚布",
                    "text": "咳咳…「晚风如歌，为我诉说，人们白日的喜乐」…"
                },
                {
                    "id": "640830502",
                    "speaker": "海娜",
                    "text": "？"
                },
                {
                    "id": "640830503",
                    "speaker": "齐里亚布",
                    "text": "「我立风中，却只想听，你那温柔的轻和」。"
                },
                {
                    "id": "640830504",
                    "speaker": "齐里亚布",
                    "text": "嘿嘿…怎么样？"
                },
                {
                    "id": "640830505",
                    "speaker": "海娜",
                    "text": "呃，什么怎么样？"
                },
                {
                    "id": "640830506",
                    "speaker": "齐里亚布",
                    "text": "这首我精心创作的诗歌，你听完之后，感觉如何？"
                },
                {
                    "id": "640830507",
                    "speaker": "海娜",
                    "text": "这是…你的什么文学课作业吗？"
                },
                {
                    "id": "640830508",
                    "speaker": "海娜",
                    "text": "抱歉，我不是很懂啦…"
                },
                {
                    "id": "640830509",
                    "speaker": "齐里亚布",
                    "text": "没关系！听我给你细说——"
                }
            ]
        },
        {
            "talkId": "6408401",
            "initDialog": "640840101",
            "dialogues": [
                {
                    "id": "640840101",
                    "speaker": "海娜",
                    "text": "好困…什么时候他才能放弃那些长篇大论呢…"
                }
            ]
        },
        {
            "talkId": "6408402",
            "initDialog": "640840201",
            "dialogues": [
                {
                    "id": "640840201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "640840202",
                    "speaker": "海娜",
                    "text": "啊，由于某人的原因，导致我一直睡眠不足。"
                },
                {
                    "id": "640840203",
                    "speaker": "海娜",
                    "text": "每天晚上都要和他耽误好长时间，要是去酒馆喝酒也就算了，结果就只是站在路边吹风，听一些我搞不明白的东西…"
                },
                {
                    "id": "640840204",
                    "speaker": "海娜",
                    "text": "你说我要是喜欢听人念书的话，怎么不去找门课上呢！"
                },
                {
                    "id": "640840205",
                    "speaker": "海娜",
                    "text": "…难不成，是这混蛋在暗示我多读点书？！"
                },
                {
                    "id": "640840206",
                    "speaker": "海娜",
                    "text": "可恶，与读书人约会，原来是这么麻烦的事情吗？"
                }
            ]
        },
        {
            "talkId": "6408403",
            "initDialog": "640840301",
            "dialogues": [
                {
                    "id": "640840301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "640840302",
                    "speaker": "海娜",
                    "text": "要是我像哈坎一样会站着睡觉的本领就好了…"
                }
            ]
        }
    ]
}