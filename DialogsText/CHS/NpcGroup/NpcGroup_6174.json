            "dialogues": [
                {
                    "id": "661740101",
                    "speaker": "「金盏花」",
                    "text": "嘎呜…"
                },
                {
                    "id": "661740102",
                    "speaker": "伊卡尤",
                    "text": "情绪这么低落，是遇到难过的事了吗？没关系，还有我呢。"
                },
                {
                    "id": "661740103",
                    "speaker": "伊卡尤",
                    "text": "虽然我解决不了你的问题，但我一定会陪在你身边的。"
                }
            ]
        },
        {
            "talkId": "6617402",
            "initDialog": "661740201",
            "dialogues": [
                {
                    "id": "661740201",
                    "speaker": "伊卡尤",
                    "text": "说起来你最近是不是胖了点？"
                },
                {
                    "id": "661740202",
                    "speaker": "「小波」",
                    "text": "呜？"
                },
                {
                    "id": "661740203",
                    "speaker": "伊卡尤",
                    "text": "唉，胖点也很可爱。要再来一份酸汁腌鱼吗？"
                }
            ]
        },
        {
            "talkId": "6617403",
            "initDialog": "661740301",
            "dialogues": [
                {
                    "id": "661740301",
                    "speaker": "伊卡尤",
                    "text": "…好了好了，我知道了，我也很想你们，真没想到你们会同时出现在这里，这一定是三倍的幸运吧？"
                }
            ]
        }
    ]
