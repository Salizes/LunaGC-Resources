{
    "groupId": "6210",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "约洛特莉": 14
    },
    "talks": [
        {
            "talkId": "6621001",
            "initDialog": "662100101",
            "dialogues": [
                {
                    "id": "662100101",
                    "speaker": "约洛特莉",
                    "text": "你好，你好…是托尔特克先生叫你来找我的吗？"
                }
            ]
        },
        {
            "talkId": "6621002",
            "initDialog": "662100201",
            "dialogues": [
                {
                    "id": "662100201",
                    "speaker": "Player",
                    "text": "不是的。"
                },
                {
                    "id": "662100202",
                    "speaker": "约洛特莉",
                    "text": "呼…这样啊。"
                },
                {
                    "id": "662100203",
                    "speaker": "约洛特莉",
                    "text": "我是不是看起来很紧张？抱歉啦。"
                },
                {
                    "id": "662100204",
                    "speaker": "约洛特莉",
                    "text": "因为托尔特克先生的口信往往意味着新的地脉调查委托，可我还没做好再次出门的准备。"
                },
                {
                    "id": "662100205",
                    "speaker": "约洛特莉",
                    "text": "需要学习的秘术有很多，还得提前准备一些仪式用的材料…"
                },
                {
                    "id": "662100206",
                    "speaker": "约洛特莉",
                    "text": "我对地脉的感知能力一般，多半需要龙的帮助。暝视龙，可不是随随便便就会陪同人类出行的哦。"
                }
            ]
        },
        {
            "talkId": "6621003",
            "initDialog": "662100301",
            "dialogues": [
                {
                    "id": "662100301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "662100302",
                    "speaker": "约洛特莉",
                    "text": "哦，太好了…"
                }
            ]
        },
        {
            "talkId": "6621004",
            "initDialog": "662100401",
            "dialogues": [
                {
                    "id": "662100401",
                    "speaker": "Player",
                    "text": "需要准备很多礼物吗？"
                },
                {
                    "id": "662100402",
                    "speaker": "约洛特莉",
                    "text": "不不不，恰恰相反。"
                },
                {
                    "id": "662100403",
                    "speaker": "约洛特莉",
                    "text": "暝视龙最不喜欢其他种族的生物为了一己私利借用它们的能力，自然也不会被简单的好处收买。"
                },
                {
                    "id": "662100404",
                    "speaker": "约洛特莉",
                    "text": "在请它们出马前，必须要做足仪式，表明需要它们提供帮助的理由和目的。"
                },
                {
                    "id": "662100405",
                    "speaker": "约洛特莉",
                    "text": "暝视龙的眼睛可是很亮的，千万不要想着去欺骗它们哦。"
                }
            ]
        },
        {
            "talkId": "7594201",
            "initDialog": "759420101",
            "dialogues": [
                {
                    "id": "759420101",
                    "speaker": "Player",
                    "text": "如果是不图回报的礼物呢？"
                },
                {
                    "id": "759420102",
                    "speaker": "约洛特莉",
                    "text": "这个嘛…就要看暝视龙对你的信任程度了。"
                },
                {
                    "id": "759420103",
                    "speaker": "约洛特莉",
                    "text": "毕竟世上没有免费的午餐，越是不求回报的，就越是可疑。"
                },
                {
                    "id": "759420104",
                    "speaker": "约洛特莉",
                    "text": "你要试试吗？那，听说暝视龙很喜欢这种菌类，祝你好运。"
                }
            ]
        }
    ]
}