{
    "groupId": "9573",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "闲云": 10
    },
    "talks": [
        {
            "talkId": "6957301",
            "initDialog": "695730101",
            "dialogues": [
                {
                    "id": "695730101",
                    "speaker": "闲云",
                    "text": "这游戏好则好矣，只是卡牌众多，打完一局还要先洗牌再理牌…唔，本仙有灵感了，不如做一个机关桌，打完牌后，只要把牌都推进桌内，让它自动洗牌理牌…"
                }
            ]
        },
        {
            "talkId": "6957302",
            "initDialog": "695730201",
            "dialogues": [
                {
                    "id": "695730201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957303",
            "initDialog": "695730301",
            "dialogues": [
                {
                    "id": "695730301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695730302",
                    "speaker": "闲云",
                    "text": "要走了？打算去哪里，本仙带你一程如何？"
                }
            ]
        },
        {
            "talkId": "6957304",
            "initDialog": "695730401",
            "dialogues": [
                {
                    "id": "695730401",
                    "speaker": "闲云",
                    "text": "用那种眼神看着本仙做什么，玩个牌何必驱使机关…不信？要本仙束起袖子再来一局？好，好，依你就是。"
                }
            ]
        },
        {
            "talkId": "6957305",
            "initDialog": "695730501",
            "dialogues": [
                {
                    "id": "695730501",
                    "speaker": "闲云",
                    "text": "输成如此惨状，下次和你打牌时，本仙非得要用点机关助力了…别噘嘴了，区区一个玩笑，本仙怎是这种赖人。"
                }
            ]
        },
        {
            "talkId": "6957306",
            "initDialog": "695730601",
            "dialogues": [
                {
                    "id": "695730601",
                    "speaker": "闲云",
                    "text": "这凡间游戏，我也有些兴致，那就浅试两局吧。"
                }
            ]
        },
        {
            "talkId": "6957308",
            "initDialog": "695730801",
            "dialogues": [
                {
                    "id": "695730801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957309",
            "initDialog": "695730901",
            "dialogues": [
                {
                    "id": "695730901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957310",
            "initDialog": "695731001",
            "dialogues": [
                {
                    "id": "695731001",
                    "speaker": "闲云",
                    "text": "你方才是大意了，这游戏玩起来急不得。"
                }
            ]
        },
        {
            "talkId": "6957311",
            "initDialog": "695731101",
            "dialogues": [
                {
                    "id": "695731101",
                    "speaker": "闲云",
                    "text": "呵，你倒是精于这游戏，不错。"
                }
            ]
        },
        {
            "talkId": "6957312",
            "initDialog": "695731201",
            "dialogues": [
                {
                    "id": "695731201",
                    "speaker": "闲云",
                    "text": "你这是提起胜负心了。好吧，那本仙便圆你的心思。"
                }
            ]
        },
        {
            "talkId": "6957314",
            "initDialog": "695731401",
            "dialogues": [
                {
                    "id": "695731401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957315",
            "initDialog": "695731501",
            "dialogues": [
                {
                    "id": "695731501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957316",
            "initDialog": "695731601",
            "dialogues": [
                {
                    "id": "695731601",
                    "speaker": "闲云",
                    "text": "险些被你夺了胜机，还好本仙有防备…莫要灰心，本仙再与你来一局就是。"
                }
            ]
        },
        {
            "talkId": "6957317",
            "initDialog": "695731701",
            "dialogues": [
                {
                    "id": "695731701",
                    "speaker": "闲云",
                    "text": "你这一局倒是思虑齐备，无可挑剔，是本仙输了。"
                }
            ]
        },
        {
            "talkId": "6957318",
            "initDialog": "695731801",
            "dialogues": [
                {
                    "id": "695731801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}