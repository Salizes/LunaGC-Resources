{
    "groupId": "1425",
    "total_dialogue_lines": 50,
    "speaker_counts": {
        "Player": 12,
        "芙萝拉": 38
    },
    "talks": [
        {
            "talkId": "2074001",
            "initDialog": "207400102",
            "dialogues": [
                {
                    "id": "207400102",
                    "speaker": "芙萝拉",
                    "text": "您要买花吗？不好意思，您来得不太巧…"
                },
                {
                    "id": "207400103",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "207400104",
                    "speaker": "芙萝拉",
                    "text": "呜…因为之前那阵很大的风，我店里的花被吹走了好多。"
                },
                {
                    "id": "207400105",
                    "speaker": "芙萝拉",
                    "text": "不仅我摆在外面的花都被吹走了，就连放在靠外面的货也被吹走了一些。"
                },
                {
                    "id": "207400106",
                    "speaker": "芙萝拉",
                    "text": "虽然备货还有不少…但是那些摆在外面的花，都是我每天选出来最漂亮的，很多顾客都是被它们吸引来。"
                },
                {
                    "id": "207400107",
                    "speaker": "芙萝拉",
                    "text": "现在这些花全都被风吹走了，而且我还要整理店里，一时半会也抽不开身再去摘新的…"
                },
                {
                    "id": "207400108",
                    "speaker": "芙萝拉",
                    "text": "旅行者，如果你愿意的话，能帮我去摘一些新鲜的花回来吗？"
                }
            ]
        },
        {
            "talkId": "2074002",
            "initDialog": "207400201",
            "dialogues": [
                {
                    "id": "207400201",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "207400202",
                    "speaker": "芙萝拉",
                    "text": "太好了！不过，可能要摘的数量有点多…"
                },
                {
                    "id": "207400203",
                    "speaker": "芙萝拉",
                    "text": "我看看…请你先帮我去低语森林摘一株小灯草和一株甜甜花吧。"
                },
                {
                    "id": "207400204",
                    "speaker": "芙萝拉",
                    "text": "然后再去风起地，帮我摘一株风车菊。"
                },
                {
                    "id": "207400205",
                    "speaker": "芙萝拉",
                    "text": "最后去摘星崖上，帮我采一株塞西莉亚花回来。"
                },
                {
                    "id": "207400206",
                    "speaker": "芙萝拉",
                    "text": "摘到之后就赶紧回来呀，别让那些花枯萎了，枯萎的话就不能摆在外面了。"
                }
            ]
        },
        {
            "talkId": "2074003",
            "initDialog": "207400301",
            "dialogues": [
                {
                    "id": "207400301",
                    "speaker": "Player",
                    "text": "还有别的事…"
                },
                {
                    "id": "207400302",
                    "speaker": "芙萝拉",
                    "text": "那好吧，等我有空之后自己去摘就好啦。"
                }
            ]
        },
        {
            "talkId": "7090401",
            "initDialog": "709040101",
            "dialogues": [
                {
                    "id": "709040101",
                    "speaker": "Player",
                    "text": "你为什么喜欢蒲公英？"
                },
                {
                    "id": "709040102",
                    "speaker": "芙萝拉",
                    "text": "呼呼，为什么呢…可能是因为以前看过的这本《蒲公英海的狐狸》吧。"
                },
                {
                    "id": "709040103",
                    "speaker": "芙萝拉",
                    "text": "这本书送给你吧，说不定看完了这个故事你也会喜欢上蒲公英呢，呼呼。"
                }
            ]
        },
        {
            "talkId": "40166",
            "initDialog": "4015142501",
            "dialogues": [
                {
                    "id": "4015142501",
                    "speaker": "芙萝拉",
                    "text": "欢迎光临「花语」，呼呼，有什么需要了解的吗？"
                }
            ]
        },
        {
            "talkId": "41710",
            "initDialog": "4015142519",
            "dialogues": [
                {
                    "id": "4015142519",
                    "speaker": "Player",
                    "text": "关于店里的花…"
                },
                {
                    "id": "4015142520",
                    "speaker": "芙萝拉",
                    "text": "呼呼~本店的花种类齐全哦，想了解哪一种呢？"
                }
            ]
        },
        {
            "talkId": "41711",
            "initDialog": "4015142505",
            "dialogues": [
                {
                    "id": "4015142505",
                    "speaker": "芙萝拉",
                    "text": "打扰了。"
                },
                {
                    "id": "4015142517",
                    "speaker": "芙萝拉",
                    "text": "唔，这就要走了吗。"
                },
                {
                    "id": "4015142518",
                    "speaker": "芙萝拉",
                    "text": "没事，芙萝拉以后也会告诉你花的事情。下次再来哦，呼呼。"
                }
            ]
        },
        {
            "talkId": "41725",
            "initDialog": "4015142502",
            "dialogues": [
                {
                    "id": "4015142502",
                    "speaker": "Player",
                    "text": "关于蒲公英。"
                },
                {
                    "id": "4015142506",
                    "speaker": "芙萝拉",
                    "text": "呼呼，芙萝拉最喜欢蒲公英啦。轻飘飘，轻飘飘。"
                },
                {
                    "id": "4015142507",
                    "speaker": "芙萝拉",
                    "text": "那位，骑士团的代理团长琴大人，好像就叫蒲公英骑士哦。"
                },
                {
                    "id": "4015142508",
                    "speaker": "芙萝拉",
                    "text": "说不定就是跟蒲公英待久了，才掌握了风元素的力量的呢，呼呼。"
                }
            ]
        },
        {
            "talkId": "41726",
            "initDialog": "4015142503",
            "dialogues": [
                {
                    "id": "4015142503",
                    "speaker": "Player",
                    "text": "关于甜甜花。"
                },
                {
                    "id": "4015142509",
                    "speaker": "芙萝拉",
                    "text": "甜甜花啊…呼呼。"
                },
                {
                    "id": "4015142510",
                    "speaker": "芙萝拉",
                    "text": "花朵是很好看，但大家一般都是拿它去做菜的呢。"
                },
                {
                    "id": "4015142511",
                    "speaker": "芙萝拉",
                    "text": "要是你看到有人家里种着甜甜花盆栽…"
                },
                {
                    "id": "4015142512",
                    "speaker": "芙萝拉",
                    "text": "说不定只是为了熬糖用的呢，呼呼。"
                }
            ]
        },
        {
            "talkId": "41727",
            "initDialog": "4015142504",
            "dialogues": [
                {
                    "id": "4015142504",
                    "speaker": "Player",
                    "text": "关于塞西莉亚花。"
                },
                {
                    "id": "4015142513",
                    "speaker": "芙萝拉",
                    "text": "塞西莉亚花呀，你可真有品味呢。"
                },
                {
                    "id": "4015142514",
                    "speaker": "芙萝拉",
                    "text": "耐寒，喜风，传说只会在安静的地方开放。"
                },
                {
                    "id": "4015142515",
                    "speaker": "芙萝拉",
                    "text": "如果想要培育的话…"
                },
                {
                    "id": "4015142516",
                    "speaker": "芙萝拉",
                    "text": "呼呼，或许比养冰雾花还要难呢！"
                }
            ]
        },
        {
            "talkId": "6142501",
            "initDialog": "614250101",
            "dialogues": [
                {
                    "id": "614250101",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>合成</color>"
                },
                {
                    "id": "614250102",
                    "speaker": "芙萝拉",
                    "text": "进行合成功能"
                }
            ]
        },
        {
            "talkId": "6142502",
            "initDialog": "614250201",
            "dialogues": [
                {
                    "id": "614250201",
                    "speaker": "Player",
                    "text": "我想买些花。"
                },
                {
                    "id": "614250202",
                    "speaker": "芙萝拉",
                    "text": "可以哦，无论是送人还是自己养都很不错的，呼呼。"
                }
            ]
        },
        {
            "talkId": "6142503",
            "initDialog": "614250301",
            "dialogues": [
                {
                    "id": "614250301",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614250302",
                    "speaker": "芙萝拉",
                    "text": "比起风魔龙，更吓人的是笼罩蒙德的飓风啊，呼呼…"
                },
                {
                    "id": "614250303",
                    "speaker": "芙萝拉",
                    "text": "虽然大家都在关注民众的伤亡与损失，而我更在意的还是那些花草植物。"
                },
                {
                    "id": "614250304",
                    "speaker": "芙萝拉",
                    "text": "就像巴巴托斯大人保护我们一样，我也会保护它们的，呼呼。"
                }
            ]
        },
        {
            "talkId": "6142504",
            "initDialog": "614250401",
            "dialogues": [
                {
                    "id": "614250401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614250402",
                    "speaker": "芙萝拉",
                    "text": "不用担心店里的花被风刮飞了，真是太好了呢。"
                },
                {
                    "id": "614250403",
                    "speaker": "芙萝拉",
                    "text": "不过蒲公英种子因为这次的风灾而随风飞向了蒙德各地，说不定不久后蒲公英就会在蒙德各地盛开呢。"
                },
                {
                    "id": "614250404",
                    "speaker": "芙萝拉",
                    "text": "这么一想，风灾好像也没那么可怕了，呼呼。"
                }
            ]
        }
    ]
}