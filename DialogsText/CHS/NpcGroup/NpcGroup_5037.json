{
    "groupId": "5037",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "爱洛芙": 14
    },
    "talks": [
        {
            "talkId": "6503701",
            "initDialog": "650370101",
            "dialogues": [
                {
                    "id": "650370101",
                    "speaker": "爱洛芙",
                    "text": "欢迎光临「千织屋」，请问您有什么需要吗？"
                }
            ]
        },
        {
            "talkId": "6503702",
            "initDialog": "650370201",
            "dialogues": [
                {
                    "id": "650370201",
                    "speaker": "Player",
                    "text": "关于「千织屋」…"
                },
                {
                    "id": "650370202",
                    "speaker": "爱洛芙",
                    "text": "这里是由闻名枫丹的稻妻设计师「千织」小姐开设的成衣店。"
                },
                {
                    "id": "650370203",
                    "speaker": "爱洛芙",
                    "text": "千织小姐凭借其设计理念中诸多「反抗」与「革新」的元素，赢得了枫丹时尚界的青睐。"
                },
                {
                    "id": "650370204",
                    "speaker": "爱洛芙",
                    "text": "虽然我这么说有些自卖自夸，但说千织小姐掀起了枫丹的一阵时尚热潮也毫不为过。"
                }
            ]
        },
        {
            "talkId": "6503703",
            "initDialog": "650370301",
            "dialogues": [
                {
                    "id": "650370301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650370302",
                    "speaker": "爱洛芙",
                    "text": "我是「千织屋」的店员爱洛芙，负责受理预约及接待客人。偶尔也负责安抚客人。"
                }
            ]
        },
        {
            "talkId": "6503704",
            "initDialog": "650370401",
            "dialogues": [
                {
                    "id": "650370401",
                    "speaker": "Player",
                    "text": "暂时没有要买的。"
                },
                {
                    "id": "650370402",
                    "speaker": "爱洛芙",
                    "text": "期待您的再次光临。"
                }
            ]
        },
        {
            "talkId": "6503705",
            "initDialog": "650370501",
            "dialogues": [
                {
                    "id": "650370501",
                    "speaker": "Player",
                    "text": "安抚客人？"
                },
                {
                    "id": "650370502",
                    "speaker": "爱洛芙",
                    "text": "我们老板的说话方式…较为直接，有些客人会不太习惯。"
                },
                {
                    "id": "650370503",
                    "speaker": "爱洛芙",
                    "text": "不过您放心，「千织屋」的设计绝对能令您满意。"
                },
                {
                    "id": "650370504",
                    "speaker": "爱洛芙",
                    "text": "这也是一些客人气呼呼离开之后，过几天依旧委托鄙店设计服装的原因。"
                }
            ]
        },
        {
            "talkId": "6503706",
            "initDialog": "650370601",
            "dialogues": [
                {
                    "id": "650370601",
                    "speaker": "爱洛芙",
                    "text": "是你啊，欢迎光临。今天有什么需要吗？"
                }
            ]
        },
        {
            "talkId": "6503707",
            "initDialog": "650370701",
            "dialogues": [
                {
                    "id": "650370701",
                    "speaker": "Player",
                    "text": "最近生意怎么样？"
                },
                {
                    "id": "650370702",
                    "speaker": "爱洛芙",
                    "text": "托你的福，千织小姐的时装秀大获成功。"
                },
                {
                    "id": "650370703",
                    "speaker": "爱洛芙",
                    "text": "在那之后，千织屋又推出了许多新品，来客络绎不绝。店里的人手都有些不够了。"
                },
                {
                    "id": "650370704",
                    "speaker": "爱洛芙",
                    "text": "千织小姐还说，有机会的话，还想和你一起出去旅游呢。"
                },
                {
                    "id": "650370705",
                    "speaker": "爱洛芙",
                    "text": "啊，但你可别告诉她是我说的哦。"
                }
            ]
        }
    ]
}