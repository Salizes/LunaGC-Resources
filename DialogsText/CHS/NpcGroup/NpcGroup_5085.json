            "dialogues": [
                {
                    "id": "650850101",
                    "speaker": "瑟米安",
                    "text": "无论在哪工作都差不多，还是这边好。"
                }
            ]
        },
        {
            "talkId": "6508502",
            "initDialog": "650850201",
            "dialogues": [
                {
                    "id": "650850201",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "650850202",
                    "speaker": "瑟米安",
                    "text": "因为上班地点离城里的住处更近了。"
                },
                {
                    "id": "650850203",
                    "speaker": "瑟米安",
                    "text": "之前我的工作和审判庭有关，常常需要沫芒宫和歌剧院两头跑。现在方便多了。"
                },
                {
                    "id": "650850204",
                    "speaker": "瑟米安",
                    "text": "偶尔休假时去那边看看演出，见到以前工作过的地方，竟然感觉有些怀念。"
                }
            ]
        },
        {
            "talkId": "6508503",
            "initDialog": "650850301",
            "dialogues": [
                {
                    "id": "650850301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650850302",
                    "speaker": "瑟米安",
                    "text": "慢走。"
                }
            ]
        }
    ]
}