{
    "groupId": "9108",
    "total_dialogue_lines": 84,
    "speaker_counts": {
        "Player": 18,
        "蓝砚": 66
    },
    "talks": [
        {
            "talkId": "6910801",
            "initDialog": "691080101",
            "dialogues": [
                {
                    "id": "691080101",
                    "speaker": "蓝砚",
                    "text": "嗨，我在这呢。"
                },
                {
                    "id": "691080102",
                    "speaker": "蓝砚",
                    "text": "这个地方好有意思，玩风行迷踪一定很合适。"
                }
            ]
        },
        {
            "talkId": "6910802",
            "initDialog": "691080201",
            "dialogues": [
                {
                    "id": "691080201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691080202",
                    "speaker": "蓝砚",
                    "text": "当然不太习惯，跟我平时爱待的地方太不一样了。"
                },
                {
                    "id": "691080203",
                    "speaker": "Player",
                    "text": "有哪里不满意吗？"
                },
                {
                    "id": "691080204",
                    "speaker": "蓝砚",
                    "text": "欸？不不，你误会了，不是不满意的意思。"
                },
                {
                    "id": "691080205",
                    "speaker": "蓝砚",
                    "text": "我说不习惯，指的是在这里很难保持平时的心境…"
                },
                {
                    "id": "691080206",
                    "speaker": "蓝砚",
                    "text": "毕竟我还没住过这么奇妙的地方，说实话，直到这一刻我还很兴奋呢，心扑通乱跳。"
                },
                {
                    "id": "691080207",
                    "speaker": "Player",
                    "text": "我家是挺大的。"
                },
                {
                    "id": "691080208",
                    "speaker": "蓝砚",
                    "text": "对对…大是一方面，可最让人啧啧称奇的还要数你在布设上的巧思。"
                },
                {
                    "id": "691080209",
                    "speaker": "蓝砚",
                    "text": "我家乡的山也很大，但我从来不会迷路。"
                },
                {
                    "id": "691080210",
                    "speaker": "蓝砚",
                    "text": "刚刚我独自在周边逛了一下，得亏边走边留神着，不然可就找不着回来的路喽。"
                },
                {
                    "id": "691080211",
                    "speaker": "Player",
                    "text": "没关系，我会来救你的！"
                },
                {
                    "id": "691080212",
                    "speaker": "蓝砚",
                    "text": "嘻嘻，真的？"
                },
                {
                    "id": "691080213",
                    "speaker": "蓝砚",
                    "text": "那你听见远处突然传来慌慌张张的银铃声时，要记得来找我哦？"
                }
            ]
        },
        {
            "talkId": "6910803",
            "initDialog": "691080301",
            "dialogues": [
                {
                    "id": "691080301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691080302",
                    "speaker": "蓝砚",
                    "text": "那我想要聊…唔…就聊一聊此时此刻你的心情吧！"
                },
                {
                    "id": "691080303",
                    "speaker": "蓝砚",
                    "text": "没错，就现在，这一分钟这一秒钟你的心里正在想什么呢？"
                },
                {
                    "id": "691080304",
                    "speaker": "Player",
                    "text": "突然这么问，有点答不上来…"
                },
                {
                    "id": "691080305",
                    "speaker": "蓝砚",
                    "text": "对吧对吧！"
                },
                {
                    "id": "691080306",
                    "speaker": "蓝砚",
                    "text": "不知道你有没有发现，我对你的了解好像比你对我的少得多。"
                },
                {
                    "id": "691080307",
                    "speaker": "蓝砚",
                    "text": "你看，我们聊过好多好多…我的爱好啊，烦恼啊，出糗的瞬间啊…"
                },
                {
                    "id": "691080308",
                    "speaker": "蓝砚",
                    "text": "可关于你，我只知道你有很多了不起的经历，还有很多非常重要的事情等着你去完成…"
                },
                {
                    "id": "691080309",
                    "speaker": "蓝砚",
                    "text": "噢，我不是说这样不好，只是…「过去」和「未来」加起来应该不能等于一个人的「全部」吧？"
                },
                {
                    "id": "691080310",
                    "speaker": "蓝砚",
                    "text": "总感觉大家都很容易忽视「现在」…"
                },
                {
                    "id": "691080311",
                    "speaker": "蓝砚",
                    "text": "有过「走很远的路都不会累」的记录，所以哪怕现在脚很痛了，也要咬着牙继续赶路。"
                },
                {
                    "id": "691080312",
                    "speaker": "蓝砚",
                    "text": "计划一天要完成很多事情，所以即使早早困了也不肯去睡觉…"
                },
                {
                    "id": "691080313",
                    "speaker": "蓝砚",
                    "text": "你每天好像比筑巢的燕子还忙，我还挺好奇这种状态真是你当下想要的吗？",
                    "choices": [
                        {
                            "id": "691080314",
                            "text": "当然，这样很充实！",
                            "response": [
                                {
                                    "id": "691080315",
                                    "speaker": "蓝砚",
                                    "text": "啊——？出乎意料的答案！"
                                },
                                {
                                    "id": "691080316",
                                    "speaker": "蓝砚",
                                    "text": "我还以为你会哭诉说你真的累了呢。"
                                },
                                {
                                    "id": "691080317",
                                    "speaker": "蓝砚",
                                    "text": "哈哈，也好。这是最好不过的答案，至少说明你从内而外都是那么有活力！"
                                },
                                {
                                    "id": "691080318",
                                    "speaker": "蓝砚",
                                    "text": "呼…那我就不用担心了。来，快陪我再聊几句。"
                                },
                                {
                                    "id": "691080319",
                                    "speaker": "蓝砚",
                                    "text": "快告诉我像你这么忙的人会睡懒觉吗？你左手和右手能各自做完全不相干的事情吗？"
                                }
                            ]
                        },
                        {
                            "id": "691080320",
                            "text": "我真的累了…",
                            "response": [
                                {
                                    "id": "691080321",
                                    "speaker": "蓝砚",
                                    "text": "嗯…我们又不是银器工艺品，不需要被千锤百炼，累了就歇会吧！"
                                },
                                {
                                    "id": "691080322",
                                    "speaker": "蓝砚",
                                    "text": "听我的，你现在闭上眼睛，脑海中浮现的第一个画面是什么，我们就去做什么。"
                                },
                                {
                                    "id": "691080323",
                                    "speaker": "蓝砚",
                                    "text": "是好吃的？还是好看的风景？"
                                },
                                {
                                    "id": "691080324",
                                    "speaker": "蓝砚",
                                    "text": "什么？！是冒险手册上没做完的委托清单？"
                                },
                                {
                                    "id": "691080325",
                                    "speaker": "蓝砚",
                                    "text": "哎…看来不解决这个问题你是歇不住了…"
                                },
                                {
                                    "id": "691080326",
                                    "speaker": "蓝砚",
                                    "text": "好吧，我们一起去，但要两天后才能出发哦。"
                                },
                                {
                                    "id": "691080327",
                                    "speaker": "蓝砚",
                                    "text": "因为我现在不想去，我要尊重自己「现在」的想法，给你做个好榜样。"
                                },
                                {
                                    "id": "691080328",
                                    "speaker": "蓝砚",
                                    "text": "可以在你的手册里插入一条紧急委托吗？那就是陪我好好放两天假吧！我倒是真的累了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910804",
            "initDialog": "691080401",
            "dialogues": [
                {
                    "id": "691080401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691080402",
                    "speaker": "蓝砚",
                    "text": "我在想还需要添置些什么呢…"
                },
                {
                    "id": "691080403",
                    "speaker": "Player",
                    "text": "欸？还缺什么吗？"
                },
                {
                    "id": "691080404",
                    "speaker": "蓝砚",
                    "text": "唔…原本打算做一些藤编家具送你，但你这家具陈设一应俱全，就连小件摆设都已经不缺什么了…"
                },
                {
                    "id": "691080405",
                    "speaker": "Player",
                    "text": "嗯，全是我的杰作和收藏！"
                },
                {
                    "id": "691080406",
                    "speaker": "蓝砚",
                    "text": "嘿嘿，看得出来，有些物件应该很有意义吧，一尘不染的，你一定很爱惜它们。"
                },
                {
                    "id": "691080407",
                    "speaker": "蓝砚",
                    "text": "哈，我想到了！"
                },
                {
                    "id": "691080408",
                    "speaker": "蓝砚",
                    "text": "给桌椅板凳铺上藤席，还有，易碎的器皿摆件也套个藤甲，这样就不怕刮花碰坏啦！"
                },
                {
                    "id": "691080409",
                    "speaker": "Player",
                    "text": "那多麻烦你呀！"
                },
                {
                    "id": "691080410",
                    "speaker": "蓝砚",
                    "text": "怎么能说是麻烦，你忘啦？我是手工艺协会的成员，我擅长也喜欢做这种手工活。"
                },
                {
                    "id": "691080411",
                    "speaker": "蓝砚",
                    "text": "况且我来你这里打搅了这么久，你也没说麻烦呀。"
                },
                {
                    "id": "691080412",
                    "speaker": "蓝砚",
                    "text": "要是你觉得好呢，我就打点打点马上动手，还有顾虑的话…不妨趁这个机会说说看？",
                    "choices": [
                        {
                            "id": "691080413",
                            "text": "能收获蓝师傅的匠心力作，当然好！",
                            "response": [
                                {
                                    "id": "691080414",
                                    "speaker": "蓝砚",
                                    "text": "抬爱啦。我的小手工能被大名鼎鼎的旅行者夸赞，荣幸至极！"
                                },
                                {
                                    "id": "691080415",
                                    "speaker": "蓝砚",
                                    "text": "好了好了，我的配合打得不错吧？可以暂停客套了哦？"
                                },
                                {
                                    "id": "691080416",
                                    "speaker": "蓝砚",
                                    "text": "轮到我直说了——"
                                },
                                {
                                    "id": "691080417",
                                    "speaker": "蓝砚",
                                    "text": "藤席也好藤甲也好，做好以后你就大胆随心使用，最好不要放到柜子里收藏啦。"
                                },
                                {
                                    "id": "691080423",
                                    "speaker": "蓝砚",
                                    "text": "还有，请答应我，不要因为怕弄脏弄坏再盖一层软布之类的…"
                                },
                                {
                                    "id": "691080424",
                                    "speaker": "蓝砚",
                                    "text": "唉…我都快忘了我家里的家具原来的样子了，妈妈总是一层盖一层，再盖一层…"
                                },
                                {
                                    "id": "691080425",
                                    "speaker": "Player",
                                    "text": "哈哈，包在我身上！"
                                },
                                {
                                    "id": "691080426",
                                    "speaker": "蓝砚",
                                    "text": "好耶！开工开工。我来量尺寸！"
                                },
                                {
                                    "id": "691080427",
                                    "speaker": "Player",
                                    "text": "我也来帮忙！"
                                },
                                {
                                    "id": "691080428",
                                    "speaker": "蓝砚",
                                    "text": "有件事确实只有你能帮忙。"
                                },
                                {
                                    "id": "691080429",
                                    "speaker": "蓝砚",
                                    "text": "给我说说这些家具摆件背后的故事吧，我想听！"
                                }
                            ]
                        },
                        {
                            "id": "691080418",
                            "text": "我舍不得弄坏你做的藤编…",
                            "response": [
                                {
                                    "id": "691080419",
                                    "speaker": "蓝砚",
                                    "text": "嗐，原来你在担心这个呀？"
                                },
                                {
                                    "id": "691080420",
                                    "speaker": "蓝砚",
                                    "text": "藤枝藤条都要先经历过洗、晒、拗、刨、等等好多道工序，还要熏蒸干燥，抹油上色…"
                                },
                                {
                                    "id": "691080421",
                                    "speaker": "蓝砚",
                                    "text": "放一百个心好了，不是我自卖自夸，我做的藤器水不腐，虫不蠹，结实又耐用，没那么容易坏！"
                                },
                                {
                                    "id": "691080422",
                                    "speaker": "蓝砚",
                                    "text": "退一万步来说，真弄坏了，可以修呀，我随时都在呢，难不成你还不相信我的手艺？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910805",
            "initDialog": "691080501",
            "dialogues": [
                {
                    "id": "691080501",
                    "speaker": "Player",
                    "text": "早啊，蓝砚。"
                },
                {
                    "id": "691080502",
                    "speaker": "蓝砚",
                    "text": "早上好啊，睡得好吗？"
                },
                {
                    "id": "691080503",
                    "speaker": "蓝砚",
                    "text": "看你的状态，睡个回笼觉比较好哦？"
                }
            ]
        },
        {
            "talkId": "6910806",
            "initDialog": "691080601",
            "dialogues": [
                {
                    "id": "691080601",
                    "speaker": "Player",
                    "text": "晚安，蓝砚。"
                },
                {
                    "id": "691080602",
                    "speaker": "蓝砚",
                    "text": "晚安，快睡吧。"
                },
                {
                    "id": "691080603",
                    "speaker": "蓝砚",
                    "text": "这小说还有两页，马上看完了，已经讲到主角睡前被床底下的手抓住脚跟的情节了…"
                }
            ]
        },
        {
            "talkId": "6910810",
            "initDialog": "691081001",
            "dialogues": [
                {
                    "id": "691081001",
                    "speaker": "蓝砚",
                    "text": "真没想到这里也有乡街子逛！难不成是专门为我而设的吗？"
                },
                {
                    "id": "691081002",
                    "speaker": "蓝砚",
                    "text": "蔬菜水果日用杂货…那边的又是什么？有些看花眼了，哈哈。"
                },
                {
                    "id": "691081003",
                    "speaker": "蓝砚",
                    "text": "我可得慢慢逛逛，来呀，快跟上，别走散喽。"
                }
            ]
        },
        {
            "talkId": "6910811",
            "initDialog": "691081101",
            "dialogues": [
                {
                    "id": "691081101",
                    "speaker": "蓝砚",
                    "text": "银器和书籍一样需要干燥洁净的环境，不瞒你说，我们自家存放银器的地方也是像这样的书房。"
                },
                {
                    "id": "691081102",
                    "speaker": "蓝砚",
                    "text": "有些银器质地较软，不宜叠放，用绒布包好铺陈在书架上最合适不过了…"
                },
                {
                    "id": "691081103",
                    "speaker": "蓝砚",
                    "text": "差点忘了，我还带了些需要勤保养的收藏过来，也是时候擦拭一番了…想看看吗？"
                }
            ]
        }
    ]
}