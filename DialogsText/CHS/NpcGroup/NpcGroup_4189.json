{
    "groupId": "4189",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "兰那库拉": 20
    },
    "talks": [
        {
            "talkId": "6418901",
            "initDialog": "641890101",
            "dialogues": [
                {
                    "id": "641890101",
                    "speaker": "兰那库拉",
                    "text": "#这里不会有无留陀和坏种子，想要留下那菈{NICKNAME}的「石头的记忆」。"
                }
            ]
        },
        {
            "talkId": "6418902",
            "initDialog": "641890201",
            "dialogues": [
                {
                    "id": "641890201",
                    "speaker": "Player",
                    "text": "你打算做什么？"
                },
                {
                    "id": "641890202",
                    "speaker": "兰那库拉",
                    "text": "#啊，是金色的那菈{NICKNAME}…"
                },
                {
                    "id": "641890203",
                    "speaker": "兰那库拉",
                    "text": "#兰那库拉在准备为那菈{NICKNAME}留下「石头的记忆」。"
                },
                {
                    "id": "641890204",
                    "speaker": "兰那库拉",
                    "text": "#这样一来，即便那菈{NICKNAME}离开了，再回来的时候，也能重新想起大树的叶子、林间的风还有兰那库拉。"
                },
                {
                    "id": "641890205",
                    "speaker": "兰那库拉",
                    "text": "要是那菈法留纳回来了，也会知道，还有另外一个，被桓那记住的金色那菈。"
                }
            ]
        },
        {
            "talkId": "6418903",
            "initDialog": "641890301",
            "dialogues": [
                {
                    "id": "641890301",
                    "speaker": "Player",
                    "text": "关于兰百梨迦…"
                },
                {
                    "id": "641890302",
                    "speaker": "兰那库拉",
                    "text": "兰百梨迦很勇敢，一直说想要像兰帝裟那样保护桓那。"
                },
                {
                    "id": "641890303",
                    "speaker": "兰那库拉",
                    "text": "可是兰那库拉觉得，让苗圃中生长出高兴的花，让他们的旋律传遍所有的树梢，也能够保护桓那。"
                },
                {
                    "id": "641890304",
                    "speaker": "兰那库拉",
                    "text": "虽然没有兰百梨迦的一半那么厉害，但是，要超过兰百梨迦一半的一半。"
                }
            ]
        },
        {
            "talkId": "6418904",
            "initDialog": "641890401",
            "dialogues": [
                {
                    "id": "641890401",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "641890402",
                    "speaker": "兰那库拉",
                    "text": "嗯，虽然兰那库拉现在没有力量留下「石头的记忆」，但是会努力。"
                }
            ]
        },
        {
            "talkId": "6418905",
            "initDialog": "641890501",
            "dialogues": [
                {
                    "id": "641890501",
                    "speaker": "兰那库拉",
                    "text": "因为金色的那菈和派蒙的帮助，毗波耶比之前任何一次都要高兴。"
                }
            ]
        },
        {
            "talkId": "6418906",
            "initDialog": "641890601",
            "dialogues": [
                {
                    "id": "641890601",
                    "speaker": "Player",
                    "text": "关于毗波耶…"
                },
                {
                    "id": "641890602",
                    "speaker": "兰那库拉",
                    "text": "金色的那菈想唱歌给毗波耶听吗？"
                },
                {
                    "id": "641890603",
                    "speaker": "兰那库拉",
                    "text": "兰那库拉想听金色的那菈的歌声，毗波耶也一定会喜欢金色的那菈的歌声。"
                },
                {
                    "id": "641890604",
                    "speaker": "兰那库拉",
                    "text": "#可是…那菈{NICKNAME}还是会离开的…"
                }
            ]
        },
        {
            "talkId": "6418907",
            "initDialog": "641890701",
            "dialogues": [
                {
                    "id": "641890701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641890702",
                    "speaker": "兰那库拉",
                    "text": "#再见，那菈{NICKNAME}，毗波耶会一直陪伴着你。"
                }
            ]
        },
        {
            "talkId": "6418908",
            "initDialog": "641890801",
            "dialogues": [
                {
                    "id": "641890801",
                    "speaker": "兰那库拉",
                    "text": "#那菈{NICKNAME}，兰那库拉打算为你留下「泥土的记忆」…"
                }
            ]
        },
        {
            "talkId": "6418909",
            "initDialog": "641890901",
            "dialogues": [
                {
                    "id": "641890901",
                    "speaker": "Player",
                    "text": "「泥土的记忆」？"
                },
                {
                    "id": "641890902",
                    "speaker": "兰那库拉",
                    "text": "是的，比起石头，泥土像云朵那样柔软，可以变成不同的形状。"
                },
                {
                    "id": "641890903",
                    "speaker": "兰那库拉",
                    "text": "#所以兰那库拉打算用花圃的泥土揉成那菈{NICKNAME}的样子，看着毗波耶。"
                },
                {
                    "id": "641890904",
                    "speaker": "兰那库拉",
                    "text": "这样，毗波耶们也一定会高兴的。"
                },
                {
                    "id": "641890905",
                    "speaker": "兰那库拉",
                    "text": "#那菈法留纳回来，也会知道那菈{NICKNAME}的样子。"
                }
            ]
        },
        {
            "talkId": "6418910",
            "initDialog": "641891001",
            "dialogues": [
                {
                    "id": "641891001",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "641891002",
                    "speaker": "兰那库拉",
                    "text": "#也谢谢那菈{NICKNAME}，帮助了兰那库拉许多。"
                }
            ]
        }
    ]
}