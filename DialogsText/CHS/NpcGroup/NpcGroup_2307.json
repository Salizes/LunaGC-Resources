{
    "groupId": "2307",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "云淡": 9
    },
    "talks": [
        {
            "talkId": "6230701",
            "initDialog": "623070101",
            "dialogues": [
                {
                    "id": "623070101",
                    "speaker": "云淡",
                    "text": "你好，欢迎来到我们这个小村子。"
                }
            ]
        },
        {
            "talkId": "6230702",
            "initDialog": "623070201",
            "dialogues": [
                {
                    "id": "623070201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "623070202",
                    "speaker": "云淡",
                    "text": "普通的老太太而已，以前倒是去过璃月港，忙碌了一段时间之后发现我终究是个普通人，就回来了。"
                },
                {
                    "id": "623070203",
                    "speaker": "云淡",
                    "text": "现在就帮帮村里人照顾下小娃娃们，孩子们又乖巧又很听话，让我也省心不少啊。"
                },
                {
                    "id": "623070204",
                    "speaker": "Player",
                    "text": "关于过去。"
                },
                {
                    "id": "623070205",
                    "speaker": "云淡",
                    "text": "年轻的时候我和弟弟在璃月港附近捕鱼，一不小心赚了点钱，生活就好了起来。"
                },
                {
                    "id": "623070206",
                    "speaker": "云淡",
                    "text": "不过我实在不习惯吵闹的感觉，也学不会做生意的勾心斗角…或许我就不应该发财吧，哈哈。"
                },
                {
                    "id": "623070207",
                    "speaker": "云淡",
                    "text": "像现在这样乐得清静，实在是舒服多了。"
                }
            ]
        },
        {
            "talkId": "6230703",
            "initDialog": "623070301",
            "dialogues": [
                {
                    "id": "623070301",
                    "speaker": "Player",
                    "text": "关于家人…"
                },
                {
                    "id": "623070302",
                    "speaker": "云淡",
                    "text": "我弟弟也是个普通人，只是现在好像在做些不那么普通的工作，说话也习惯遮遮掩掩、故弄玄虚的。"
                },
                {
                    "id": "623070303",
                    "speaker": "云淡",
                    "text": "反正城里的那些我也不是很懂，不知道他什么时候才想回来一趟呢…"
                }
            ]
        },
        {
            "talkId": "6230704",
            "initDialog": "623070401",
            "dialogues": [
                {
                    "id": "623070401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "623070402",
                    "speaker": "云淡",
                    "text": "路上小心，一路顺风啊。"
                }
            ]
        }
    ]
}