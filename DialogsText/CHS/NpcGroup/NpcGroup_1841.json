    "talks": [
        {
            "talkId": "6184101",
            "initDialog": "618410101",
            "dialogues": [
                {
                    "id": "618410101",
                    "speaker": "兴邦",
                    "text": "「刀枪剑戟三千队，铁马兵戈十万重…」"
                }
            ]
        },
        {
            "talkId": "6184102",
            "initDialog": "618410201",
            "dialogues": [
                {
                    "id": "618410201",
                    "speaker": "Player",
                    "text": "说说你的时代吧。"
                },
                {
                    "id": "618410202",
                    "speaker": "兴邦",
                    "text": "与其说是时代，不如说是我自己的一些回忆吧。"
                },
                {
                    "id": "618410203",
                    "speaker": "兴邦",
                    "text": "月光下的狐狸，荒野里试图摘下月亮当自己眼瞳的大骷髅…"
                },
                {
                    "id": "618410204",
                    "speaker": "兴邦",
                    "text": "冬天的风，众神的长旅…"
                }
            ]
        },
        {
            "talkId": "6184103",
            "initDialog": "618410301",
            "dialogues": [
                {
                    "id": "618410301",
                    "speaker": "Player",
                    "text": "你觉得对于小说最重要的是什么？"
                },
                {
                    "id": "618410302",
                    "speaker": "兴邦",
                    "text": "是主角团人数。"
                },
                {
                    "id": "618410303",
                    "speaker": "兴邦",
                    "text": "是主角团人数。"
                },
                {
                    "id": "618410304",
                    "speaker": "Player",
                    "text": "说了两遍。"
                },
                {
                    "id": "618410305",
                    "speaker": "兴邦",
                    "text": "对于鸿篇巨制来说，四个人的主角团有点少，一百零八个有点多。"
                },
                {
                    "id": "618410306",
                    "speaker": "兴邦",
                    "text": "我觉得八个是最完美的数字。"
                }
            ]
        },
        {
            "talkId": "6184104",
            "initDialog": "618410401",
            "dialogues": [
                {
                    "id": "618410401",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "618410402",
                    "speaker": "兴邦",
                    "text": "嗯嗯，再会。"
                }
            ]
        }
    ]
}