{
    "groupId": "5012",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "勒芒德": 10
    },
    "talks": [
        {
            "talkId": "5900126",
            "initDialog": "590012601",
            "dialogues": [
                {
                    "id": "590012601",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900127",
            "initDialog": "590012701",
            "dialogues": [
                {
                    "id": "590012701",
                    "speaker": "勒芒德",
                    "text": "好像没什么特别的…都没有我拍的照片有意思。"
                }
            ]
        },
        {
            "talkId": "6501201",
            "initDialog": "650120101",
            "dialogues": [
                {
                    "id": "650120101",
                    "speaker": "勒芒德",
                    "text": "等整理完之前拍好的底片后，就可以继续拍船了！"
                }
            ]
        },
        {
            "talkId": "6501202",
            "initDialog": "650120201",
            "dialogues": [
                {
                    "id": "650120201",
                    "speaker": "Player",
                    "text": "拍船？"
                },
                {
                    "id": "650120202",
                    "speaker": "勒芒德",
                    "text": "哦，就是拍摄巡轨船画片的意思。"
                },
                {
                    "id": "650120203",
                    "speaker": "勒芒德",
                    "text": "我深爱着枫丹的水道交通，恨不得把巡轨船的每一个细节都刻在脑子里。"
                },
                {
                    "id": "650120204",
                    "speaker": "勒芒德",
                    "text": "我有一个梦想，就是在完全不看实物或者画片的情况下，只靠记忆还原出巡轨船的等比例发条模型。"
                },
                {
                    "id": "650120205",
                    "speaker": "勒芒德",
                    "text": "目前已经进行到每日拍摄、观看画片并熟背于心的阶段了，为我加油吧，朋友！"
                }
            ]
        },
        {
            "talkId": "6501203",
            "initDialog": "650120301",
            "dialogues": [
                {
                    "id": "650120301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650120302",
                    "speaker": "勒芒德",
                    "text": "再见，请一定要坐一次巡轨船啊！"
                }
            ]
        },
        {
            "talkId": "7492101",
            "initDialog": "749210101",
            "dialogues": [
                {
                    "id": "749210101",
                    "speaker": "Player",
                    "text": "听着挺厉害的。"
                },
                {
                    "id": "749210102",
                    "speaker": "勒芒德",
                    "text": "那当然！如果你也感兴趣的话，欢迎加入我们水道爱好者的行列。"
                },
                {
                    "id": "749210103",
                    "speaker": "勒芒德",
                    "text": "不过对新入门的同好，我必须强调一些注意事项。"
                },
                {
                    "id": "749210104",
                    "speaker": "勒芒德",
                    "text": "在欣赏巡轨船时，千万不能做出侵扰水道航线正常运转的行为，也不能干扰船上导游的正常工作哦。"
                }
            ]
        }
    ]
}