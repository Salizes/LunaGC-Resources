        "雅珂达": 6
    },
    "talks": [
        {
            "talkId": "6700801",
            "initDialog": "670080101",
            "dialogues": [
                {
                    "id": "670080101",
                    "speaker": "萨维特",
                    "text": "出版业也不挣钱哪，还是看看新的投资吧…"
                }
            ]
        },
        {
            "talkId": "6700802",
            "initDialog": "670080201",
            "dialogues": [
                {
                    "id": "670080201",
                    "speaker": "Player",
                    "text": "有什么推荐的读物吗？"
                },
                {
                    "id": "670080202",
                    "speaker": "萨维特",
                    "text": "都在这儿了，随便挑。"
                }
            ]
        },
        {
            "talkId": "6700803",
            "initDialog": "670080301",
            "dialogues": [
                {
                    "id": "670080301",
                    "speaker": "Player",
                    "text": "我要结算投资回报。"
                },
                {
                    "id": "670080302",
                    "speaker": "萨维特",
                    "text": "哟，你又来了。不过可惜呀，还没到结算的时候，一周只能结算一次，有劳你下周再来了。"
                }
            ]
        },
        {
            "talkId": "6700804",
            "initDialog": "670080401",
            "dialogues": [
                {
                    "id": "670080401",
                    "speaker": "Player",
                    "text": "我要结算投资回报。"
                },
                {
                    "id": "670080402",
                    "speaker": "萨维特",
                    "text": "哟，瞧瞧，这不是老主顾么。之前的投资回报你打开检查过盈亏了吗？可别心急啊。"
                }
            ]
        },
        {
            "talkId": "6700805",
            "initDialog": "670080501",
            "dialogues": [
                {
                    "id": "670080501",
                    "speaker": "Player",
                    "text": "什么投资？"
                },
                {
                    "id": "670080502",
                    "speaker": "萨维特",
                    "text": "2000摩拉就能买到一张投资券，持有投资券就可以在投资期结算时领取投资回报。"
                },
                {
                    "id": "670080503",
                    "speaker": "萨维特",
                    "text": "投资嘛，盈亏都是常事。不过我可是靠这个投资挣到了不少啊，怎么样，你也要参与投资吗？"
                }
            ]
        },
        {
            "talkId": "6700806",
            "initDialog": "670080601",
            "dialogues": [
                {
                    "id": "670080601",
                    "speaker": "Player",
                    "text": "出版业怎么了？"
                },
                {
                    "id": "670080602",
                    "speaker": "萨维特",
                    "text": "利润微薄啊，才这么几个子儿我得到什么时候才能偿清负债…不算在须弥投资赔的，还有在枫丹采购设备的花费，唉。"
                },
                {
                    "id": "670080603",
                    "speaker": "萨维特",
                    "text": "这儿的人个个都精得很，今天来看几页明天来看几页，一摩拉不花把书给看了！当然现在不行了，有我盯着呢。"
                },
                {
                    "id": "670080604",
                    "speaker": "萨维特",
                    "text": "还有人抱怨《那夏快报》上广告太多，我这不是也没辙嘛。"
                }
            ]
        },
        {
            "talkId": "6700807",
            "initDialog": "670080701",
            "dialogues": [
                {
                    "id": "670080701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670080702",
                    "speaker": "萨维特",
                    "text": "什么都不买吗？好吧。"
                }
            ]
        },
        {
            "talkId": "7613903",
            "initDialog": "761390319",
            "dialogues": [
                {
                    "id": "761390319",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎对投资券有兴趣…）"
                },
                {
                    "id": "761390301",
                    "speaker": "萨维特",
                    "text": "怎么又是你，我不卖投资券了，走吧走吧。"
                },
                {
                    "id": "761390302",
                    "speaker": "萨维特",
                    "text": "唉，回头一想，我就不该信你还有什么朋友…",
                    "choices": [
                        {
                            "id": "761390303",
                            "text": "你那完全就是骗人啦。",
                            "response": [
                                {
                                    "id": "761390305",
                                    "speaker": "派蒙",
                                    "text": "是啊，好好卖书不是挺好的？"
                                },
                                {
                                    "id": "761390306",
                                    "speaker": "派蒙",
                                    "text": "#喔！{NICKNAME}，你看那边，那本书好像很有趣，我们去看看吧。"
                                },
                                {
                                    "id": "761390307",
                                    "speaker": "萨维特",
                                    "text": "行，行，算我倒…霉…"
                                },
                                {
                                    "id": "761390308",
                                    "speaker": "萨维特",
                                    "text": "奈…奈芙尔老板！没想到您居然大驾光临…您…您也想买张投资…不是，您想买本书吗？"
                                },
                                {
                                    "id": "761390309",
                                    "speaker": "奈芙尔",
                                    "text": "我就不了，只是陪我这位朋友过来看看而已。"
                                },
                                {
                                    "id": "761390310",
                                    "speaker": "奈芙尔",
                                    "text": "听说萨维特老板的投资生意做得有声有色，今天一看，果然如此。"
                                },
                                {
                                    "id": "761390311",
                                    "speaker": "萨维特",
                                    "text": "一般，一般，哈哈哈…小本生意，糊口罢了。"
                                },
                                {
                                    "id": "761390312",
                                    "speaker": "奈芙尔",
                                    "text": "萨维特老板客气了，您的信誉和商业头脑，在那夏镇可是很有名的。"
                                },
                                {
                                    "id": "761390313",
                                    "speaker": "奈芙尔",
                                    "text": "我相信，大家跟着您投资，您一定能赚到大钱。"
                                },
                                {
                                    "id": "761390314",
                                    "speaker": "萨维特",
                                    "text": "借奈芙尔老板吉言…借奈芙尔老板吉言。"
                                },
                                {
                                    "id": "761390315",
                                    "speaker": "萨维特",
                                    "text": "…然后，奈芙尔老板，上次我拜托您帮忙找的那个…"
                                },
                                {
                                    "id": "761390316",
                                    "speaker": "奈芙尔",
                                    "text": "东西是已经找到了，但…"
                                },
                                {
                                    "id": "761390317",
                                    "speaker": "奈芙尔",
                                    "text": "萨维特先生，不要心急。事情，要一步一步地做才稳当。"
                                },
                                {
                                    "id": "761390318",
                                    "speaker": "萨维特",
                                    "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…"
                                }
                            ]
                        },
                        {
                            "id": "761390304",
                            "text": "下次别干了喔。"
                        }
                    ]
                }
            ]
        },
