    },
    "talks": [
        {
            "talkId": "6940001",
            "initDialog": "694000101",
            "dialogues": [
                {
                    "id": "694000101",
                    "speaker": "伊涅芙",
                    "text": "统计目前战斗数据，持续挑战需要消耗大量能量。"
                },
                {
                    "id": "694000102",
                    "speaker": "伊涅芙",
                    "text": "建议及时充能，避免意外停机。"
                },
                {
                    "id": "694000103",
                    "speaker": "伊涅芙",
                    "text": "叮——我准备了刚烤好的点心，请坐下来尝尝吧。"
                }
            ]
        },
        {
            "talkId": "6940002",
            "initDialog": "694000201",
            "dialogues": [
                {
                    "id": "694000201",
                    "speaker": "伊涅芙",
                    "text": "你是说，在这里不用限制出力功率，随意战斗也不会把家具打坏？"
                },
                {
                    "id": "694000202",
                    "speaker": "伊涅芙",
                    "text": "明白了，参数设置已更新，切换到「特攻模式」。"
                },
                {
                    "id": "694000203",
                    "speaker": "伊涅芙",
                    "text": "如果遇到棘手的敌人，就请交给我来打扫战场吧。"
                }
            ]
        },
        {
            "talkId": "6940003",
            "initDialog": "694000301",
            "dialogues": [
                {
                    "id": "694000301",
                    "speaker": "伊涅芙",
                    "text": "检测到家居整洁度优良，无需进行额外清理或收纳。"
                },
                {
                    "id": "694000302",
                    "speaker": "伊涅芙",
                    "text": "扫描书架，识别到未知书籍，即将开始读取数据。"
                },
                {
                    "id": "694000303",
                    "speaker": "伊涅芙",
                    "text": "睡前故事储备已更新。下次睡不着的时候，请让我为你朗读故事。"
                }
            ]
        }
    ]
}