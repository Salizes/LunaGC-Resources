{
    "groupId": "9360",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "瑶瑶": 9
    },
    "talks": [
        {
            "talkId": "6936001",
            "initDialog": "693600101",
            "dialogues": [
                {
                    "id": "693600101",
                    "speaker": "瑶瑶",
                    "text": "你看上去有点累，要不要先休息一会儿呢？"
                },
                {
                    "id": "693600102",
                    "speaker": "瑶瑶",
                    "text": "肚子饿了的话，我还带着一些炸萝卜丸子，是来这里之前就准备好的。"
                },
                {
                    "id": "693600103",
                    "speaker": "瑶瑶",
                    "text": "把生活节奏放慢一些，对健康有好处哦！"
                }
            ]
        },
        {
            "talkId": "6936002",
            "initDialog": "693600201",
            "dialogues": [
                {
                    "id": "693600201",
                    "speaker": "瑶瑶",
                    "text": "我在山中采药时，有时会遇到一些危险的敌人。比如贪心的盗宝团，还有凶猛的林猪。"
                },
                {
                    "id": "693600202",
                    "speaker": "瑶瑶",
                    "text": "我明白，不是所有的地方都和爹娘隐居的地方一样平和，也不是任何时候都能有师父陪在身边。"
                },
                {
                    "id": "693600203",
                    "speaker": "瑶瑶",
                    "text": "所以，虽然不喜欢，但我还是在坚持练枪，这样就能靠自己打跑坏人！"
                }
            ]
        },
        {
            "talkId": "6936003",
            "initDialog": "693600301",
            "dialogues": [
                {
                    "id": "693600301",
                    "speaker": "瑶瑶",
                    "text": "大人看的书里总有很多大道理，就算想很久也想不明白。"
                },
                {
                    "id": "693600302",
                    "speaker": "瑶瑶",
                    "text": "师父常说，很多事情瑶瑶长大以后就明白了。"
                },
                {
                    "id": "693600303",
                    "speaker": "瑶瑶",
                    "text": "同样的事情，长大后就会有不同的理解吗？"
                }
            ]
        }
    ]
}