{
    "groupId": "2449",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "老赵": 10
    },
    "talks": [
        {
            "talkId": "6244901",
            "initDialog": "624490101",
            "dialogues": [
                {
                    "id": "624490101",
                    "speaker": "老赵",
                    "text": "嗯，没算错，今晚…又少了一个。"
                }
            ]
        },
        {
            "talkId": "6244902",
            "initDialog": "624490201",
            "dialogues": [
                {
                    "id": "624490201",
                    "speaker": "Player",
                    "text": "你刚才在说什么？"
                },
                {
                    "id": "624490202",
                    "speaker": "老赵",
                    "text": "被你听到了？没什么，只是平时常来的常客又少了一个。"
                },
                {
                    "id": "624490203",
                    "speaker": "老赵",
                    "text": "大概…是消失了吧。"
                },
                {
                    "id": "624490204",
                    "speaker": "老赵",
                    "text": "不过很快就会有新的客人被介绍到这里，所以这种事也不用放在心上。"
                }
            ]
        },
        {
            "talkId": "6244903",
            "initDialog": "624490301",
            "dialogues": [
                {
                    "id": "624490301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624490302",
                    "speaker": "老赵",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6244904",
            "initDialog": "624490401",
            "dialogues": [
                {
                    "id": "624490401",
                    "speaker": "Player",
                    "text": "消失了？"
                },
                {
                    "id": "624490402",
                    "speaker": "老赵",
                    "text": "嗯，就是字面意义上的消失了，从璃月港彻底消失了。"
                },
                {
                    "id": "624490403",
                    "speaker": "老赵",
                    "text": "有些客人前一日还在船上大摆宴席，结果第二天便消失得无影无踪，就仿佛从未存在过一样。"
                },
                {
                    "id": "624490404",
                    "speaker": "老赵",
                    "text": "…我在这艘船上担任保镖已经十几年了，这种事情早就屡见不鲜了。"
                },
                {
                    "id": "624490405",
                    "speaker": "老赵",
                    "text": "虽然这「珠钿舫」看着光鲜亮丽，但实际上是个吃人不吐骨头的地方。"
                },
                {
                    "id": "624490406",
                    "speaker": "老赵",
                    "text": "没事的话就别在这边闲逛了，把心放在正事上，旅行者。"
                }
            ]
        }
    ]
}