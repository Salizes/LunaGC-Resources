{
    "groupId": "1597",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "小吉": 10
    },
    "talks": [
        {
            "talkId": "7093501",
            "initDialog": "709350101",
            "dialogues": [
                {
                    "id": "709350101",
                    "speaker": "Player",
                    "text": "那你喜欢什么？"
                },
                {
                    "id": "709350102",
                    "speaker": "小吉",
                    "text": "当然是螃蟹了，你不感觉横着爬的螃蟹很可爱吗？"
                },
                {
                    "id": "709350103",
                    "speaker": "小吉",
                    "text": "而且比鱼什么的要难抓呢！你要是也这么想的话，这些螃蟹就送给你吧。"
                },
                {
                    "id": "709350104",
                    "speaker": "小吉",
                    "text": "我还会再抓一些的，没关系的。"
                }
            ]
        },
        {
            "talkId": "6159701",
            "initDialog": "615970101",
            "dialogues": [
                {
                    "id": "615970101",
                    "speaker": "小吉",
                    "text": "咦？有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6159702",
            "initDialog": "615970201",
            "dialogues": [
                {
                    "id": "615970201",
                    "speaker": "Player",
                    "text": "沙滩上有好看的贝壳吗？"
                },
                {
                    "id": "615970202",
                    "speaker": "小吉",
                    "text": "唔…对不起，其实我不喜欢贝壳。"
                }
            ]
        },
        {
            "talkId": "6159703",
            "initDialog": "615970301",
            "dialogues": [
                {
                    "id": "615970301",
                    "speaker": "Player",
                    "text": "你们为什么在这里玩？"
                },
                {
                    "id": "615970302",
                    "speaker": "小吉",
                    "text": "唔，看到那边的卫兵叔叔了吗？"
                },
                {
                    "id": "615970303",
                    "speaker": "小吉",
                    "text": "我和小威想去风起地找艾迪丝老师玩…"
                },
                {
                    "id": "615970304",
                    "speaker": "小吉",
                    "text": "可是他一直跟着我们，甩也甩不掉，一副坏人的样子。"
                },
                {
                    "id": "615970305",
                    "speaker": "小吉",
                    "text": "不然我们也不会跑到这儿的呀。"
                }
            ]
        },
        {
            "talkId": "6159704",
            "initDialog": "615970401",
            "dialogues": [
                {
                    "id": "615970401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615970402",
                    "speaker": "小吉",
                    "text": "再见！"
                }
            ]
        }
    ]
}