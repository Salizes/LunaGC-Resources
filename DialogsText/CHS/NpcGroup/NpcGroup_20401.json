                {
                    "id": "5042601",
                    "speaker": "小仓屋告示板",
                    "text": "实在抱歉，由于「锁国令」影响，进口霓裳花丝绸暂时缺货。"
                },
                {
                    "id": "5042602",
                    "speaker": "小仓屋告示板",
                    "text": "如有定制需要请事先预告，本店一定详加记录，待丝绸到货即刻为您开工。"
                }
            ]
        },
        {
            "talkId": "50438",
            "initDialog": "5043801",
            "dialogues": [
                {
                    "id": "5043801",
                    "speaker": "小仓屋告示板",
                    "text": "本店正在积极与商人交涉，进口霓裳花丝绸即将恢复供应。"
                },
                {
                    "id": "5043802",
                    "speaker": "小仓屋告示板",
                    "text": "请各位稍安勿躁，可先行与本店进行预约，待丝绸到货即刻按序开工。"
                }
            ]
        }
    ]
