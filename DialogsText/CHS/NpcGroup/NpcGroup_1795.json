{
    "groupId": "1795",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 6,
        "方妮雅": 25
    },
    "talks": [
        {
            "talkId": "6179501",
            "initDialog": "617950101",
            "dialogues": [
                {
                    "id": "617950101",
                    "speaker": "方妮雅",
                    "text": "选拔计划还算顺利…啊…是荣誉骑士，又见面了。"
                }
            ]
        },
        {
            "talkId": "6179502",
            "initDialog": "617950201",
            "dialogues": [
                {
                    "id": "617950201",
                    "speaker": "Player",
                    "text": "选拔计划？选什么人？"
                },
                {
                    "id": "617950202",
                    "speaker": "方妮雅",
                    "text": "是新晋的信号官。"
                },
                {
                    "id": "617950203",
                    "speaker": "方妮雅",
                    "text": "为了获取战场的主动权，在有利阵位与有利时间和敌人交战，有必要提升骑士们的战场信息获取能力。"
                },
                {
                    "id": "617950204",
                    "speaker": "方妮雅",
                    "text": "信号官正是为了这一目的，在近年增设的岗位。"
                },
                {
                    "id": "617950205",
                    "speaker": "方妮雅",
                    "text": "相比于先导定位，极度轻装的侦察骑士，信号官的阵位与行动时机更靠后，与主力配合更加紧密。"
                },
                {
                    "id": "617950206",
                    "speaker": "方妮雅",
                    "text": "同时，使用的炼金侦察器械也相对复杂，机动性介于轻装与重装骑士之间，更依赖团队合作的保障。"
                },
                {
                    "id": "617950207",
                    "speaker": "方妮雅",
                    "text": "计划中，一切装备和组织方式成熟后，信号官们会被分配到各个小队，以保证各队能力的均衡提升。",
                    "choices": [
                        {
                            "id": "617950208",
                            "text": "听起来负担不轻…",
                            "response": [
                                {
                                    "id": "617950210",
                                    "speaker": "方妮雅",
                                    "text": "整体要求确实强于一般骑士。"
                                },
                                {
                                    "id": "617950211",
                                    "speaker": "方妮雅",
                                    "text": "前几年，我还在担心，使用对应设备的门槛太高，很难筛选人才…"
                                },
                                {
                                    "id": "617950212",
                                    "speaker": "方妮雅",
                                    "text": "毕竟最早通过莱奥诺拉前辈测试的人，只有三人，然后只有我一直坚持到各种装备完成测试。"
                                },
                                {
                                    "id": "617950213",
                                    "speaker": "方妮雅",
                                    "text": "就算现在我转为了情报官，许多相关的事务还是需要我来处理。"
                                },
                                {
                                    "id": "617950214",
                                    "speaker": "方妮雅",
                                    "text": "好在，远征归来的队员们对于新知识和复杂机关的理解能力远远高于预期，目前计划推行得相当顺利。"
                                },
                                {
                                    "id": "617950215",
                                    "speaker": "方妮雅",
                                    "text": "希望在下次重要的战事到来前，我们能完成第一批信号官的部署，有效拔高骑士团的整体战力。"
                                }
                            ]
                        },
                        {
                            "id": "617950209",
                            "text": "要学的东西很多吧？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6179503",
            "initDialog": "617950301",
            "dialogues": [
                {
                    "id": "617950301",
                    "speaker": "Player",
                    "text": "最近还好吗？"
                },
                {
                    "id": "617950302",
                    "speaker": "方妮雅",
                    "text": "这…执勤方面，完全没有问题。"
                },
                {
                    "id": "617950303",
                    "speaker": "方妮雅",
                    "text": "最近一段时间，我恢复得还算不错，已经能够以精神饱满的状态工作了。"
                },
                {
                    "id": "617950304",
                    "speaker": "方妮雅",
                    "text": "感谢代理团长和阿贝多队长的关照，那场风波中，只有艾玛托和押送我的骑士们知道了一些内幕。"
                },
                {
                    "id": "617950305",
                    "speaker": "方妮雅",
                    "text": "骑士团的大部分同僚对我都没有成见，我还能顺利地工作。"
                },
                {
                    "id": "617950306",
                    "speaker": "方妮雅",
                    "text": "以我那次失误为戒的《骑士专用精神干扰防治建议》一文也写好梗概了，我争取尽早完稿。"
                },
                {
                    "id": "617950307",
                    "speaker": "Player",
                    "text": "除了工作，生活上呢？"
                },
                {
                    "id": "617950308",
                    "speaker": "方妮雅",
                    "text": "啊，多谢关心…"
                },
                {
                    "id": "617950309",
                    "speaker": "方妮雅",
                    "text": "由于调到了荆夫港来工作，我把自己的房子租了出去，和艾玛托在这边找了间新住处。"
                },
                {
                    "id": "617950310",
                    "speaker": "方妮雅",
                    "text": "客厅非常宽敞，可以放下很多猫爬架和猫玩具，让艾玛托领养的「团团灰」尽情玩闹。"
                },
                {
                    "id": "617950311",
                    "speaker": "方妮雅",
                    "text": "托她们俩的福，我最近的心情很不错…"
                },
                {
                    "id": "617950312",
                    "speaker": "方妮雅",
                    "text": "莱奥诺拉前辈也偶尔会来我们这里做客，使我感觉，生活正变得愈发有趣。"
                },
                {
                    "id": "617950313",
                    "speaker": "方妮雅",
                    "text": "有机会的话，您也请来我们家坐坐，一起喝杯茶，聊聊您对骑士团建设的看法。"
                }
            ]
        },
        {
            "talkId": "6179504",
            "initDialog": "617950401",
            "dialogues": [
                {
                    "id": "617950401",
                    "speaker": "Player",
                    "text": "下次再聊。"
                },
                {
                    "id": "617950402",
                    "speaker": "方妮雅",
                    "text": "好的，随时恭候。"
                }
            ]
        }
    ]
}