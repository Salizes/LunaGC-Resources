{
    "groupId": "9063",
    "total_dialogue_lines": 75,
    "speaker_counts": {
        "Player": 24,
        "申鹤": 51
    },
    "talks": [
        {
            "talkId": "6906301",
            "initDialog": "690630101",
            "dialogues": [
                {
                    "id": "690630101",
                    "speaker": "申鹤",
                    "text": "#{NICKNAME}，辛苦了，欢迎回家。"
                },
                {
                    "id": "690630102",
                    "speaker": "申鹤",
                    "text": "听说家人外出归来时，要说这样的话，对吗？"
                }
            ]
        },
        {
            "talkId": "6906302",
            "initDialog": "690630201",
            "dialogues": [
                {
                    "id": "690630201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690630202",
                    "speaker": "申鹤",
                    "text": "我原以为这里会跟仙家洞府差不多…"
                },
                {
                    "id": "690630203",
                    "speaker": "申鹤",
                    "text": "没想到经你改造，跟我想象中大有不同。"
                },
                {
                    "id": "690630204",
                    "speaker": "Player",
                    "text": "申鹤更喜欢哪边呢？"
                },
                {
                    "id": "690630205",
                    "speaker": "申鹤",
                    "text": "嗯…大多仙人常年云游在外，虽然洞府奇巧别致，但更像是个寂寥的仙境。"
                },
                {
                    "id": "690630206",
                    "speaker": "申鹤",
                    "text": "而这里氛围温馨，还有你这样的热心之人作伴。是我从来没有体会过的经历。"
                },
                {
                    "id": "690630207",
                    "speaker": "申鹤",
                    "text": "所以，我喜欢这里。我会爱惜这个地方，慢慢适应它。"
                },
                {
                    "id": "690630208",
                    "speaker": "Player",
                    "text": "那我就放心了。"
                },
                {
                    "id": "690630209",
                    "speaker": "申鹤",
                    "text": "只是…有许多布设和家具我都未曾见过，不清楚它们的用途和意义…"
                },
                {
                    "id": "690630210",
                    "speaker": "申鹤",
                    "text": "等你有空，还请和我说明一下。"
                }
            ]
        },
        {
            "talkId": "6906303",
            "initDialog": "690630301",
            "dialogues": [
                {
                    "id": "690630301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690630302",
                    "speaker": "申鹤",
                    "text": "聊天？你也跟师父一样，喜欢聊天吗？"
                },
                {
                    "id": "690630303",
                    "speaker": "申鹤",
                    "text": "也好，修行之外，师父也教过我聊天的技巧。不过大多数时间都是她说，我听。"
                },
                {
                    "id": "690630304",
                    "speaker": "申鹤",
                    "text": "难得有实践的机会，请出招。"
                },
                {
                    "id": "690630305",
                    "speaker": "Player",
                    "text": "都有哪些聊天技巧？"
                },
                {
                    "id": "690630306",
                    "speaker": "申鹤",
                    "text": "唔…聊天这种行为和修炼方术不同，似乎没有具体口诀。"
                },
                {
                    "id": "690630307",
                    "speaker": "申鹤",
                    "text": "只记得她说过，聊天的目的不仅在于传递信息，还能调节气氛和增进情感。",
                    "choices": [
                        {
                            "id": "690630308",
                            "text": "怎么调节气氛？",
                            "response": [
                                {
                                    "id": "690630309",
                                    "speaker": "申鹤",
                                    "text": "根据她的说法，聊一些对方感兴趣的人和事，最能调动气氛。"
                                },
                                {
                                    "id": "690630310",
                                    "speaker": "申鹤",
                                    "text": "但在认识你之前，我熟悉的人不多，感兴趣的话题也…几乎没有。",
                                    "choices": [
                                        {
                                            "id": "690630315",
                                            "text": "也就是说…",
                                            "response": [
                                                {
                                                    "id": "690630317",
                                                    "speaker": "申鹤",
                                                    "text": "但师父和我聊起你时，我会觉得…很有趣。"
                                                },
                                                {
                                                    "id": "690630318",
                                                    "speaker": "Player",
                                                    "text": "我？"
                                                },
                                                {
                                                    "id": "690630319",
                                                    "speaker": "申鹤",
                                                    "text": "嗯。说你在大家眼中是个身手了得的大英雄，然而上次你却惊慌失措地摔下了群玉…"
                                                },
                                                {
                                                    "id": "690630320",
                                                    "speaker": "Player",
                                                    "text": "好了请别往下说了…"
                                                },
                                                {
                                                    "id": "690630321",
                                                    "speaker": "申鹤",
                                                    "text": "你脸红了。是因为被这个话题调动了情绪吗？"
                                                },
                                                {
                                                    "id": "690630322",
                                                    "speaker": "申鹤",
                                                    "text": "看来师父的聊天技巧是有用的…"
                                                },
                                                {
                                                    "id": "690630323",
                                                    "speaker": "申鹤",
                                                    "text": "明白了，今后我会向师父多多询问你的事情，以便增加我们之间的话题。"
                                                },
                                                {
                                                    "id": "690630324",
                                                    "speaker": "Player",
                                                    "text": "请不要这样做…"
                                                },
                                                {
                                                    "id": "690630325",
                                                    "speaker": "申鹤",
                                                    "text": "啊，也对。你近在咫尺，不必如此麻烦。"
                                                },
                                                {
                                                    "id": "690630326",
                                                    "speaker": "申鹤",
                                                    "text": "那么，请告诉我更多关于你的事情吧，我会牢牢记住的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690630316",
                                            "text": "申鹤其实不喜欢聊天…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690630311",
                            "text": "怎么增进感情？",
                            "response": [
                                {
                                    "id": "690630312",
                                    "speaker": "申鹤",
                                    "text": "说来惭愧，这方面我没有天赋，没能习得师父半点真传…"
                                },
                                {
                                    "id": "690630313",
                                    "speaker": "申鹤",
                                    "text": "仙人们与我的师徒之情非比寻常，不需要通过聊天来增进。"
                                },
                                {
                                    "id": "690630314",
                                    "speaker": "申鹤",
                                    "text": "除了他们，我也没有其他朋友，所以，没有需要增进感情的对象。",
                                    "choices": [
                                        {
                                            "id": "690630315",
                                            "text": "也就是说…"
                                        },
                                        {
                                            "id": "690630316",
                                            "text": "申鹤其实不喜欢聊天…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906304",
            "initDialog": "690630401",
            "dialogues": [
                {
                    "id": "690630401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690630402",
                    "speaker": "申鹤",
                    "text": "嗯，想吃饭。"
                },
                {
                    "id": "690630403",
                    "speaker": "Player",
                    "text": "肚子饿了吗？"
                },
                {
                    "id": "690630404",
                    "speaker": "申鹤",
                    "text": "其实不太饿…我只是想和你一起坐下来，慢慢地吃顿饭。"
                },
                {
                    "id": "690630405",
                    "speaker": "申鹤",
                    "text": "我听说「吃饭」在璃月人眼中是件大事。"
                },
                {
                    "id": "690630406",
                    "speaker": "申鹤",
                    "text": "不仅为了填饱肚子，更重要的是，「跟重要的人共享一段温馨时光」。"
                },
                {
                    "id": "690630407",
                    "speaker": "申鹤",
                    "text": "聚在一起吃饭，这个场面就叫「团圆」。我学的对吗？"
                },
                {
                    "id": "690630408",
                    "speaker": "Player",
                    "text": "对，尤其在节日里。"
                },
                {
                    "id": "690630409",
                    "speaker": "申鹤",
                    "text": "比如海灯节？我知道会放霄灯，但海灯节一年只有一次。太遗憾了。",
                    "choices": [
                        {
                            "id": "690630410",
                            "text": "也有其他节日…",
                            "response": [
                                {
                                    "id": "690630412",
                                    "speaker": "申鹤",
                                    "text": "是吗…"
                                },
                                {
                                    "id": "690630413",
                                    "speaker": "申鹤",
                                    "text": "以前总觉得，任何节日都与我无关，但现在…心中好像有个声音呼唤下个节日早点到来。"
                                },
                                {
                                    "id": "690630414",
                                    "speaker": "申鹤",
                                    "text": "想用我学到的东西，和你一起庆祝。",
                                    "choices": [
                                        {
                                            "id": "690630415",
                                            "text": "不知不觉间…",
                                            "response": [
                                                {
                                                    "id": "690630417",
                                                    "speaker": "申鹤",
                                                    "text": "这是因为一直有你指导。我不会忘记你的恩情。"
                                                },
                                                {
                                                    "id": "690630418",
                                                    "speaker": "申鹤",
                                                    "text": "我对你的感情，也不止感激…"
                                                },
                                                {
                                                    "id": "690630419",
                                                    "speaker": "申鹤",
                                                    "text": "总之，下个节日，我们也一起度过吧。"
                                                },
                                                {
                                                    "id": "690630420",
                                                    "speaker": "Player",
                                                    "text": "团团圆圆？"
                                                },
                                                {
                                                    "id": "690630421",
                                                    "speaker": "申鹤",
                                                    "text": "嗯，团团圆圆。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690630416",
                                            "text": "申鹤成熟起来了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690630411",
                            "text": "比如逐月节会一起赏月…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906305",
            "initDialog": "690630501",
            "dialogues": [
                {
                    "id": "690630501",
                    "speaker": "Player",
                    "text": "早啊，申鹤。"
                },
                {
                    "id": "690630502",
                    "speaker": "申鹤",
                    "text": "#{NICKNAME}，你已经起来了？"
                },
                {
                    "id": "690630503",
                    "speaker": "申鹤",
                    "text": "如果是鸟儿太吵的话，我去把它们解决掉…"
                },
                {
                    "id": "690630504",
                    "speaker": "申鹤",
                    "text": "好吧，就只把它们赶跑，不会伤害它们。"
                }
            ]
        },
        {
            "talkId": "6906306",
            "initDialog": "690630601",
            "dialogues": [
                {
                    "id": "690630601",
                    "speaker": "Player",
                    "text": "晚安，申鹤。"
                },
                {
                    "id": "690630602",
                    "speaker": "申鹤",
                    "text": "#晚安，{NICKNAME}，好好休息。"
                },
                {
                    "id": "690630603",
                    "speaker": "申鹤",
                    "text": "如果睡不着，我这里有些宁神助眠的仙草，可以随时找我来取。"
                },
                {
                    "id": "690630604",
                    "speaker": "申鹤",
                    "text": "放心，不管多晚，都不会打扰到我休息的。"
                }
            ]
        },
        {
            "talkId": "6906307",
            "initDialog": "690630701",
            "dialogues": [
                {
                    "id": "690630701",
                    "speaker": "申鹤",
                    "text": "相较于嘈杂热闹的城市，我的确更喜欢宁静之地。"
                },
                {
                    "id": "690630702",
                    "speaker": "申鹤",
                    "text": "放空自我，不受外物所累。"
                },
                {
                    "id": "690630703",
                    "speaker": "申鹤",
                    "text": "「闲云野鹤」般的生活…你也喜欢吗？"
                }
            ]
        },
        {
            "talkId": "6906308",
            "initDialog": "690630801",
            "dialogues": [
                {
                    "id": "690630801",
                    "speaker": "申鹤",
                    "text": "若在璃月港，这条街道一定会是人来人往的地方吧…我大概不会停留太久。"
                },
                {
                    "id": "690630802",
                    "speaker": "申鹤",
                    "text": "但在这里，应该比较安全…"
                },
                {
                    "id": "690630803",
                    "speaker": "申鹤",
                    "text": "陪我逛逛？就当是你带我融入凡间的演练吧。"
                }
            ]
        }
    ]
}