{
    "groupId": "7141",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Player": 19,
        "爱诺": 4,
        "阿莎莎·郎勃罗": 47
    },
    "talks": [
        {
            "talkId": "6713301",
            "initDialog": "671330101",
            "dialogues": [
                {
                    "id": "671330101",
                    "speaker": "爱诺",
                    "text": "阿莎莎，最近你总能从垃圾堆里挑出有用的宝贝，是不是变聪明了？"
                },
                {
                    "id": "671330102",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "哼，我比你聪明一万倍。"
                },
                {
                    "id": "671330103",
                    "speaker": "爱诺",
                    "text": "哎呀，比聪明更膨胀的原来是嚣张。再这样我就要把你的花花摘掉，它开始让你认不清自己啦。"
                },
                {
                    "id": "671330104",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "不许摘！那不是花花。"
                },
                {
                    "id": "671330105",
                    "speaker": "爱诺",
                    "text": "明明就是我上次给你戴的花花。"
                },
                {
                    "id": "671330106",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "总之不许摘！"
                },
                {
                    "id": "671330107",
                    "speaker": "爱诺",
                    "text": "为什么？"
                },
                {
                    "id": "671330108",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "因为那是我的聪明草。"
                }
            ]
        },
        {
            "talkId": "6714102",
            "initDialog": "671410201",
            "dialogues": [
                {
                    "id": "671410201",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "哦，哦，是你啊，哼哼，你有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6714103",
            "initDialog": "671410301",
            "dialogues": [
                {
                    "id": "671410301",
                    "speaker": "Player",
                    "text": "你最近在做什么？"
                },
                {
                    "id": "671410302",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "捡捡捡捡捡垃圾，拣拣拣拣拣垃圾。"
                },
                {
                    "id": "671410303",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "她们管这个叫垃圾分类，可是垃圾让它躺在那里就好了啊，还要分类干什么？"
                }
            ]
        },
        {
            "talkId": "6714104",
            "initDialog": "671410401",
            "dialogues": [
                {
                    "id": "671410401",
                    "speaker": "Player",
                    "text": "你看起来不太高兴。"
                },
                {
                    "id": "671410402",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "因为我的死期要到了。"
                }
            ]
        },
        {
            "talkId": "6714105",
            "initDialog": "671410501",
            "dialogues": [
                {
                    "id": "671410501",
                    "speaker": "Player",
                    "text": "你还记得以前的事吗？"
                },
                {
                    "id": "671410502",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "当然记得！我永远不会忘记，你帮爱诺逮住了我。"
                },
                {
                    "id": "671410503",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "原本我是自由自在的淘金小弟，现在我却成为了为垃圾拼搏的苦工头子。"
                },
                {
                    "id": "671410504",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "我会永永远远记住你，永永远远。"
                }
            ]
        },
        {
            "talkId": "6714106",
            "initDialog": "671410601",
            "dialogues": [
                {
                    "id": "671410601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "671410602",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "略略。"
                }
            ]
        },
        {
            "talkId": "6714107",
            "initDialog": "671410701",
            "dialogues": [
                {
                    "id": "671410701",
                    "speaker": "Player",
                    "text": "不同的垃圾有不同的作用。"
                },
                {
                    "id": "671410702",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "那我是什么垃圾？我有什么作用？"
                }
            ]
        },
        {
            "talkId": "6714108",
            "initDialog": "671410801",
            "dialogues": [
                {
                    "id": "671410801",
                    "speaker": "Player",
                    "text": "怎么回事？"
                },
                {
                    "id": "671410802",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "嗯？你没有遇到过死期吗？就是截止日期，如果超过就会死掉，你不知道吗？"
                }
            ]
        },
        {
            "talkId": "6714109",
            "initDialog": "671410901",
            "dialogues": [
                {
                    "id": "671410901",
                    "speaker": "Player",
                    "text": "…那更早一点的事呢？"
                },
                {
                    "id": "671410902",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "更早一点的？更更更更早一点的？更更更更更更更…"
                },
                {
                    "id": "671410903",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "……"
                },
                {
                    "id": "671410904",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "…系统重启中…"
                },
                {
                    "id": "671410905",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "哦，哦，是你啊，哼哼，你有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6714110",
            "initDialog": "671411001",
            "dialogues": [
                {
                    "id": "671411001",
                    "speaker": "Player",
                    "text": "你不是垃圾，你是阿莎莎。"
                },
                {
                    "id": "671411002",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "我怎么不是呢？我可是用好多垃圾拼起来的…"
                },
                {
                    "id": "671411003",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "我肯定是垃圾中的垃圾。"
                }
            ]
        },
        {
            "talkId": "6714111",
            "initDialog": "671411101",
            "dialogues": [
                {
                    "id": "671411101",
                    "speaker": "Player",
                    "text": "原来是那个死期…"
                },
                {
                    "id": "671411102",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "爱涅诺和伊芙说这批垃圾分类的死期就是明天…"
                }
            ]
        },
        {
            "talkId": "6714112",
            "initDialog": "671411201",
            "dialogues": [
                {
                    "id": "671411201",
                    "speaker": "Player",
                    "text": "比如「托萝莎」…"
                },
                {
                    "id": "671411202",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "……"
                },
                {
                    "id": "671411203",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "托萝莎…"
                },
                {
                    "id": "671411204",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "托萝莎…探员…"
                },
                {
                    "id": "671411205",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "……"
                },
                {
                    "id": "671411206",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "托萝莎…探员…会成为逐影庭…"
                },
                {
                    "id": "671411207",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "……"
                },
                {
                    "id": "671411208",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "警告！核心升温中！警告！"
                },
                {
                    "id": "671411209",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "…执行爱诺协议…自保护打开…系统强制重启中…"
                },
                {
                    "id": "671411210",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "哦，哦，是你啊，哼哼，你有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6714113",
            "initDialog": "671411301",
            "dialogues": [
                {
                    "id": "671411301",
                    "speaker": "Player",
                    "text": "但你很有用。"
                },
                {
                    "id": "671411302",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "有什么用？"
                },
                {
                    "id": "671411303",
                    "speaker": "Player",
                    "text": "你可以给别的垃圾分类。"
                },
                {
                    "id": "671411304",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "是哦，这…真了不起，那我大概是垃圾队长吧？"
                },
                {
                    "id": "671411305",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "不，垃圾队长也没我擅长捡拣捡拣捡垃圾，这种事，只有站在垃圾堆巅峰的我才能做得到吧？"
                },
                {
                    "id": "671411306",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "谢谢你，我已经明白了，我是垃圾大王，这一点不会有错。"
                },
                {
                    "id": "671411307",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "嗯！现在，垃圾大王要开始工作了，快让一让，你还不满足被本大王捡走的要求。"
                }
            ]
        },
        {
            "talkId": "6714114",
            "initDialog": "671411401",
            "dialogues": [
                {
                    "id": "671411401",
                    "speaker": "Player",
                    "text": "是爱诺和伊涅芙…吧？"
                },
                {
                    "id": "671411402",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "是爱涅诺和伊芙！"
                },
                {
                    "id": "671411403",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "我已经超过一次死期了，爱诺和伊涅芙都已经死掉了，所以现在是爱涅诺和伊芙。"
                }
            ]
        },
        {
            "talkId": "6714115",
            "initDialog": "671411501",
            "dialogues": [
                {
                    "id": "671411501",
                    "speaker": "Player",
                    "text": "为什么是她们…"
                },
                {
                    "id": "671411502",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "因为活是我干的呀！死的当然就不该是我了。不然也太不公平了吧？我们应该把利益平等地分给每个人。"
                },
                {
                    "id": "671411503",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "好了，我要继续干活了，不要来害我分心啦！不然下次你就只能看到爱芙和伊涅诺了。"
                }
            ]
        },
        {
            "talkId": "6714116",
            "initDialog": "671411601",
            "dialogues": [
                {
                    "id": "671411601",
                    "speaker": "Player",
                    "text": "你可以给我讲一个笑话吗？"
                },
                {
                    "id": "671411602",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "什么是笑话？"
                },
                {
                    "id": "671411603",
                    "speaker": "Player",
                    "text": "就是让人笑起来的话。"
                },
                {
                    "id": "671411604",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "你今天真好看！"
                },
                {
                    "id": "671411605",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "671411606",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "这个笑话怎么样？"
                },
                {
                    "id": "671411607",
                    "speaker": "Player",
                    "text": "虽然很好，但这个不算笑话。"
                },
                {
                    "id": "671411608",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "怎么不是啦？昨天爱诺就是这么对伊涅芙说的，伊涅芙笑了，我看到了！"
                },
                {
                    "id": "671411609",
                    "speaker": "Player",
                    "text": "好吧，你还有别的笑话吗？"
                },
                {
                    "id": "671411610",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "你好丑哦！"
                },
                {
                    "id": "671411611",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "嗯？你怎么不笑了？这是前天爱诺把奶油抹在伊涅芙脸上的时候说的，伊涅芙也笑了，我也看到了…"
                },
                {
                    "id": "671411612",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "喂！你那是什么眼神啊？你是不是想说这也不算笑话？"
                },
                {
                    "id": "671411613",
                    "speaker": "阿莎莎·郎勃罗",
                    "text": "看来你根本不懂笑话…快走开！我再也不跟你说笑话了！"
                }
            ]
        }
    ]
}