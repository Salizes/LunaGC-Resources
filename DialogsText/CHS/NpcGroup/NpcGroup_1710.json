            "dialogues": [
                {
                    "id": "617100101",
                    "speaker": "伽禄",
                    "text": "哼，我一定会像追击猎物那样，逐渐击败所有的敌人，成为最强的「七圣召唤」牌手…怎么了，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6171002",
            "initDialog": "617100201",
            "dialogues": [
                {
                    "id": "617100201",
                    "speaker": "Player",
                    "text": "那就来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6171003",
            "initDialog": "617100301",
            "dialogues": [
                {
                    "id": "617100301",
                    "speaker": "伽禄",
                    "text": "哼哼，这下，你也成为我捕获的「猎物」了。"
                }
            ]
        },
        {
            "talkId": "6171004",
            "initDialog": "617100401",
            "dialogues": [
                {
                    "id": "617100401",
                    "speaker": "伽禄",
                    "text": "居然被你逃脱了！没有关系，你不可能一直都那么幸运的…"
                }
            ]
        },
        {
            "talkId": "6171005",
            "initDialog": "617100501",
            "dialogues": [
                {
                    "id": "617100501",
                    "speaker": "Player",
                    "text": "不，没什么事…"
                },
                {
                    "id": "617100502",
                    "speaker": "伽禄",
                    "text": "哼，等你想要找人进行「七圣召唤」的时候，就来找我吧。"
                }
            ]
        }
    ]
