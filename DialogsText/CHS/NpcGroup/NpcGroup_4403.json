{
    "groupId": "4403",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "福迪尔": 18
    },
    "talks": [
        {
            "talkId": "6440301",
            "initDialog": "644030101",
            "dialogues": [
                {
                    "id": "644030101",
                    "speaker": "福迪尔",
                    "text": "你好。"
                }
            ]
        },
        {
            "talkId": "6440302",
            "initDialog": "644030201",
            "dialogues": [
                {
                    "id": "644030201",
                    "speaker": "Player",
                    "text": "从这往前是…"
                },
                {
                    "id": "644030202",
                    "speaker": "福迪尔",
                    "text": "这要取决于你说的「往前」是指哪边了。"
                },
                {
                    "id": "644030203",
                    "speaker": "福迪尔",
                    "text": "一边是阿如村，如你所见就是这座沙漠边缘的村庄，也是我们沙漠子民的家。"
                },
                {
                    "id": "644030204",
                    "speaker": "福迪尔",
                    "text": "虽然被防沙壁隔绝在外，但仍是可供行人小憩的安全地带。"
                },
                {
                    "id": "644030205",
                    "speaker": "福迪尔",
                    "text": "旅途劳累，沙漠的环境又险恶，如果需要中途休整的话，这里是最好的地方了。"
                }
            ]
        },
        {
            "talkId": "6440303",
            "initDialog": "644030301",
            "dialogues": [
                {
                    "id": "644030301",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "644030302",
                    "speaker": "福迪尔",
                    "text": "如果你想靠拉拢关系探听情报的话，那可是找错人了。"
                },
                {
                    "id": "644030303",
                    "speaker": "福迪尔",
                    "text": "一来，阿如村没有什么机密。"
                },
                {
                    "id": "644030304",
                    "speaker": "福迪尔",
                    "text": "这里是教令院的放逐之地，大部分人光是讨生活就很辛苦了，没那么多乱七八糟的心思。"
                },
                {
                    "id": "644030305",
                    "speaker": "福迪尔",
                    "text": "二来，这里是沙漠子民最后的家园，我们无论如何都会尽力守护到底。"
                },
                {
                    "id": "644030306",
                    "speaker": "福迪尔",
                    "text": "所以无论你立场如何，只要影响了村子的稳定生活，阿如村的守卫都会毫不犹豫地出手。"
                }
            ]
        },
        {
            "talkId": "6440304",
            "initDialog": "644030401",
            "dialogues": [
                {
                    "id": "644030401",
                    "speaker": "Player",
                    "text": "嗯。"
                },
                {
                    "id": "644030402",
                    "speaker": "福迪尔",
                    "text": "那就好。祝你一路顺风。"
                }
            ]
        },
        {
            "talkId": "6440305",
            "initDialog": "644030501",
            "dialogues": [
                {
                    "id": "644030501",
                    "speaker": "Player",
                    "text": "另一边呢？"
                },
                {
                    "id": "644030502",
                    "speaker": "福迪尔",
                    "text": "是我不熟悉的地方。"
                },
                {
                    "id": "644030503",
                    "speaker": "福迪尔",
                    "text": "以前我还在镀金旅团里时，去过几次奥摩斯港，但碰上的净是些趁火打劫的生意。"
                },
                {
                    "id": "644030504",
                    "speaker": "福迪尔",
                    "text": "我不喜欢，就离开了，此后再没离开过村子。"
                },
                {
                    "id": "644030505",
                    "speaker": "福迪尔",
                    "text": "那段经历里唯一值得肯定的，就只有在摸爬滚打中学来的身手了吧。"
                },
                {
                    "id": "644030506",
                    "speaker": "福迪尔",
                    "text": "现在可以用来保护阿如村，正好。"
                }
            ]
        },
        {
            "talkId": "6440306",
            "initDialog": "644030601",
            "dialogues": [
                {
                    "id": "644030601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6440307",
            "initDialog": "644030701",
            "dialogues": [
                {
                    "id": "644030701",
                    "speaker": "福迪尔",
                    "text": "没关系，我空闲的时候经常打牌，输给我不是什么大事。"
                }
            ]
        },
        {
            "talkId": "6440308",
            "initDialog": "644030801",
            "dialogues": [
                {
                    "id": "644030801",
                    "speaker": "福迪尔",
                    "text": "不错啊！放眼沙漠地区，你的牌技应该都算是顶尖的级别！"
                }
            ]
        }
    ]
}