{
    "groupId": "6107",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "哈卡乌": 8
    },
    "talks": [
        {
            "talkId": "6610701",
            "initDialog": "661070101",
            "dialogues": [
                {
                    "id": "661070101",
                    "speaker": "哈卡乌",
                    "text": "原来住在高处的人每天都要这么辛苦啊…"
                },
                {
                    "id": "661070102",
                    "speaker": "哈卡乌",
                    "text": "真好奇被匿叶龙甩来甩去是什么感觉。"
                }
            ]
        },
        {
            "talkId": "6610702",
            "initDialog": "661070201",
            "dialogues": [
                {
                    "id": "661070201",
                    "speaker": "Player",
                    "text": "挺痛快的吧。"
                },
                {
                    "id": "661070202",
                    "speaker": "哈卡乌",
                    "text": "是指来去自如的痛快吗？"
                },
                {
                    "id": "661070203",
                    "speaker": "哈卡乌",
                    "text": "唔…你说，在空气中飘荡，是不是就像在水里游泳差不多啊？"
                },
                {
                    "id": "661070204",
                    "speaker": "哈卡乌",
                    "text": "那我多少能理解了。"
                }
            ]
        },
        {
            "talkId": "6610703",
            "initDialog": "661070301",
            "dialogues": [
                {
                    "id": "661070301",
                    "speaker": "Player",
                    "text": "挺痛苦的吧。"
                },
                {
                    "id": "661070302",
                    "speaker": "哈卡乌",
                    "text": "真的吗？那悬木人的兄弟姐妹们岂不是每天都在苦修？"
                },
                {
                    "id": "661070303",
                    "speaker": "哈卡乌",
                    "text": "哦…怪不得他们的战士都那么厉害…不像我们流泉之众，只能搞搞岩浆之类的小把戏…"
                }
            ]
        },
        {
            "talkId": "6610704",
            "initDialog": "661070401",
            "dialogues": [
                {
                    "id": "661070401",
                    "speaker": "Player",
                    "text": "不如亲自试试。"
                },
                {
                    "id": "661070402",
                    "speaker": "哈卡乌",
                    "text": "也对。"
                }
            ]
        }
    ]
}