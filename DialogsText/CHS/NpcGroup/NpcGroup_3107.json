{
    "groupId": "3107",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 8,
        "麻纪": 20
    },
    "talks": [
        {
            "talkId": "6310701",
            "initDialog": "631070101",
            "dialogues": [
                {
                    "id": "631070101",
                    "speaker": "麻纪",
                    "text": "你好，是来参观「鸣神大社」的游客吗？来求个签吧。"
                }
            ]
        },
        {
            "talkId": "6310702",
            "initDialog": "631070201",
            "dialogues": [
                {
                    "id": "631070201",
                    "speaker": "Player",
                    "text": "关于神樱树…"
                },
                {
                    "id": "631070202",
                    "speaker": "麻纪",
                    "text": "传说中，这棵雷樱树是鸣神大人力量的化形，因此被称为「神樱树」。"
                },
                {
                    "id": "631070203",
                    "speaker": "麻纪",
                    "text": "「神樱树」常年花开，护稻妻永世安康。"
                }
            ]
        },
        {
            "talkId": "6310703",
            "initDialog": "631070301",
            "dialogues": [
                {
                    "id": "631070301",
                    "speaker": "Player",
                    "text": "关于求签…"
                },
                {
                    "id": "631070302",
                    "speaker": "麻纪",
                    "text": "来神社的人们，大多想要寻求神明的庇护。"
                },
                {
                    "id": "631070303",
                    "speaker": "麻纪",
                    "text": "稻妻人相信，如果求签的结果吉利，就是收到了雷神大人的祝福，接下来的日子必将顺风顺水。"
                },
                {
                    "id": "631070304",
                    "speaker": "麻纪",
                    "text": "如果得到的结果是凶的话，则可以把签留在神社，以求逢凶化吉。"
                },
                {
                    "id": "631070305",
                    "speaker": "麻纪",
                    "text": "你如果有什么心愿的话，不妨也来求一签吧。"
                }
            ]
        },
        {
            "talkId": "6310704",
            "initDialog": "631070401",
            "dialogues": [
                {
                    "id": "631070401",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "631070402",
                    "speaker": "麻纪",
                    "text": "唔…的确有人认为愿望说出口就不作数了。"
                },
                {
                    "id": "631070403",
                    "speaker": "麻纪",
                    "text": "无论是什么样的愿望，祝你早日得偿所愿。"
                }
            ]
        },
        {
            "talkId": "6310705",
            "initDialog": "631070501",
            "dialogues": [
                {
                    "id": "631070501",
                    "speaker": "Player",
                    "text": "想要和亲人重逢。"
                },
                {
                    "id": "631070502",
                    "speaker": "麻纪",
                    "text": "飘散再远的花瓣也将重归故土，雷神保佑你。"
                }
            ]
        },
        {
            "talkId": "6310706",
            "initDialog": "631070601",
            "dialogues": [
                {
                    "id": "631070601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631070602",
                    "speaker": "麻纪",
                    "text": "再见，祝你运势昌盛。"
                }
            ]
        },
        {
            "talkId": "6310707",
            "initDialog": "631070701",
            "dialogues": [
                {
                    "id": "631070701",
                    "speaker": "Player",
                    "text": "关于大祓…"
                },
                {
                    "id": "631070702",
                    "speaker": "麻纪",
                    "text": "啊…听八重大人说，你就是帮助完成了神樱大祓的那位旅者吧。"
                },
                {
                    "id": "631070703",
                    "speaker": "麻纪",
                    "text": "真是非常感谢。大祓完成之后，神樱的繁茂更胜从前。"
                },
                {
                    "id": "631070704",
                    "speaker": "麻纪",
                    "text": "神樱树根环环相连，庇佑稻妻全境。你行走在这片土地上，也会受到祝福的。"
                }
            ]
        },
        {
            "talkId": "6310708",
            "initDialog": "631070801",
            "dialogues": [
                {
                    "id": "631070801",
                    "speaker": "Player",
                    "text": "关于玄冬林檎…"
                },
                {
                    "id": "631070802",
                    "speaker": "麻纪",
                    "text": "哦，你是说她最近变得不一样了啊。"
                },
                {
                    "id": "631070803",
                    "speaker": "麻纪",
                    "text": "确实最近她对前来求签的人态度亲切了很多，而且也变得会耐心解答大家的问题了。"
                },
                {
                    "id": "631070804",
                    "speaker": "麻纪",
                    "text": "托她的福，现在来神社求签的人也变多了。"
                }
            ]
        },
        {
            "talkId": "7293501",
            "initDialog": "729350101",
            "dialogues": [
                {
                    "id": "729350101",
                    "speaker": "Player",
                    "text": "常道恢弘…"
                },
                {
                    "id": "729350102",
                    "speaker": "麻纪",
                    "text": "…鸣神永恒。"
                },
                {
                    "id": "729350103",
                    "speaker": "麻纪",
                    "text": "没错，这就是雷神大人所追求的「永恒」的力量。看来你对稻妻已经有所了解了。"
                },
                {
                    "id": "729350104",
                    "speaker": "麻纪",
                    "text": "这个小小的花饰就送给你吧。虽然不是神力化形的花朵，但应该也可以较为长久地陪伴着你。祝你好运。"
                }
            ]
        }
    ]
}