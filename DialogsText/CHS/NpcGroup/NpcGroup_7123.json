{
    "groupId": "7123",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "利乌芭": 6
    },
    "talks": [
        {
            "talkId": "6712301",
            "initDialog": "671230101",
            "dialogues": [
                {
                    "id": "671230101",
                    "speaker": "利乌芭",
                    "text": "这项研究，的确很有前途呢…不过要是有人能来帮个小忙就更好啦。"
                }
            ]
        },
        {
            "talkId": "6712302",
            "initDialog": "671230201",
            "dialogues": [
                {
                    "id": "671230201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "671230202",
                    "speaker": "利乌芭",
                    "text": "欸，我吗？我是利乌芭，枫丹科学院的工程师，正在用这些显像机关收集一些流体冲击力相关的数据。"
                },
                {
                    "id": "671230203",
                    "speaker": "利乌芭",
                    "text": "其实我以前的研究方向和现在差别挺大的，几年前，我还在和一位叫莱莲的同事一起研究美容仪器…"
                },
                {
                    "id": "671230204",
                    "speaker": "利乌芭",
                    "text": "不过…怎么说呢，看了她做出来的试作品之后，我反而获得了冲击型战斗机关的灵感…只能说，科学的道路总是充满惊喜吧。"
                }
            ]
        },
        {
            "talkId": "6712303",
            "initDialog": "671230301",
            "dialogues": [
                {
                    "id": "671230301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "671230302",
                    "speaker": "利乌芭",
                    "text": "好的，路上小心。"
                }
            ]
        },
        {
            "talkId": "6712304",
            "initDialog": "671230401",
            "dialogues": [
                {
                    "id": "671230401",
                    "speaker": "Player",
                    "text": "这边的宝箱是？"
                },
                {
                    "id": "671230402",
                    "speaker": "利乌芭",
                    "text": "是给协助研究的朋友的一点小小的奖励！如果你愿意帮忙完成四次不同情况的数据收集，那这个宝箱就归你啦。"
                }
            ]
        }
    ]
}