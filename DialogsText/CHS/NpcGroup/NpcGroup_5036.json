    "talks": [
        {
            "talkId": "6503601",
            "initDialog": "650360101",
            "dialogues": [
                {
                    "id": "650360101",
                    "speaker": "利涅尔",
                    "text": "…不能再商量商量吗？"
                },
                {
                    "id": "650360102",
                    "speaker": "萨维尼恩",
                    "text": "就这个数，不能少。"
                },
                {
                    "id": "650360103",
                    "speaker": "利涅尔",
                    "text": "我知道您很厉害，可这已经比正常的决斗代理费高出五成了！"
                },
                {
                    "id": "650360104",
                    "speaker": "萨维尼恩",
                    "text": "这是「亲情价」。"
                },
                {
                    "id": "650360105",
                    "speaker": "利涅尔",
                    "text": "什、什么亲情？而且哪有亲情价往上涨的？"
                },
                {
                    "id": "650360106",
                    "speaker": "萨维尼恩",
                    "text": "我都查到了，你想要发起决斗的对象，其实是你的表亲吧。"
                },
                {
                    "id": "650360107",
                    "speaker": "利涅尔",
                    "text": "……"
                },
                {
                    "id": "650360108",
                    "speaker": "萨维尼恩",
                    "text": "亲属纠纷可是很难办的，要是你请不起我的话，那我不如…"
                },
                {
                    "id": "650360109",
                    "speaker": "利涅尔",
                    "text": "稍等，稍等！我再想想！"
                }
            ]
        }
    ]
}