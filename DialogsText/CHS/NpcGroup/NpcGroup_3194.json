    "talks": [
        {
            "talkId": "6319401",
            "initDialog": "631940101",
            "dialogues": [
                {
                    "id": "631940101",
                    "speaker": "小卷",
                    "text": "你好啊，年轻人！"
                }
            ]
        },
        {
            "talkId": "6319402",
            "initDialog": "631940201",
            "dialogues": [
                {
                    "id": "631940201",
                    "speaker": "Player",
                    "text": "您好，小卷婆婆！"
                },
                {
                    "id": "631940202",
                    "speaker": "小卷",
                    "text": "呵呵，再次看到你们真高兴啊…下次有机会再来占卜一番吧？"
                }
            ]
        },
        {
            "talkId": "6319403",
            "initDialog": "631940301",
            "dialogues": [
                {
                    "id": "631940301",
                    "speaker": "Player",
                    "text": "关于望泷村…"
                },
                {
                    "id": "631940302",
                    "speaker": "小卷",
                    "text": "哦？你说望泷村呀…"
                },
                {
                    "id": "631940303",
                    "speaker": "小卷",
                    "text": "这村子没什么好讲的，只是我们代代生活的地方而已。"
                },
                {
                    "id": "631940304",
                    "speaker": "小卷",
                    "text": "只不过呀，这个村子比其他地方承担了更久远的历史吧…当然，比不上珊瑚宫那样久远，呵呵。"
                }
            ]
        },
        {
            "talkId": "6319404",
            "initDialog": "631940401",
            "dialogues": [
                {
                    "id": "631940401",
                    "speaker": "Player",
                    "text": "关于「灵草」…"
                },
                {
                    "id": "631940402",
                    "speaker": "小卷",
                    "text": "感谢你们的帮忙，灵草的状态很好…"
                },
                {
                    "id": "631940403",
                    "speaker": "小卷",
                    "text": "只是呀，若是想要再度灵验，恐怕需要让它歇息一段时日了，呵呵…"
                },
                {
                    "id": "631940404",
                    "speaker": "小卷",
                    "text": "近来水中的「愿望」很充沛，是个好年景呀。以后一定会越来越好的…"
                }
            ]
        },
        {
            "talkId": "6319405",
            "initDialog": "631940501",
            "dialogues": [
                {
                    "id": "631940501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631940502",
                    "speaker": "小卷",
                    "text": "嗯，慢走，有机会多回来呀。"
                }
            ]
        }
    ]
}