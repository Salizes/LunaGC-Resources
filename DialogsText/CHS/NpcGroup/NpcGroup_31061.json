                {
                    "id": "765110901",
                    "speaker": "「咕咕丸」",
                    "text": "咕！",
                    "choices": [
                        {
                            "id": "765110902",
                            "text": "帅狗狗！",
                            "response": [
                                {
                                    "id": "765110903",
                                    "speaker": "「咕咕丸」",
                                    "text": "咕咕！"
                                },
                                {
                                    "id": "765110904",
                                    "speaker": "「咕咕丸」",
                                    "text": "（这只忍犬似乎对你很有好感，眼里闪烁着期待的光芒…）"
                                }
                            ]
                        },
                        {
                            "id": "765110905",
                            "text": "狗不是这么叫的！",
                            "response": [
                                {
                                    "id": "765110906",
                                    "speaker": "「咕咕丸」",
                                    "text": "呜…"
                                },
                                {
                                    "id": "765110907",
                                    "speaker": "「咕咕丸」",
                                    "text": "嗷？"
                                },
                                {
                                    "id": "765110908",
                                    "speaker": "Player",
                                    "text": "乖狗狗！"
                                },
                                {
                                    "id": "765110909",
                                    "speaker": "「咕咕丸」",
                                    "text": "（这只忍犬的眼神变得格外明亮，显然非常开心。）"
                                }
                            ]
                        },
                        {
                            "id": "765110910",
                            "text": "待会儿再来陪你玩。",
                            "response": [
                                {
                                    "id": "765110911",
                                    "speaker": "「咕咕丸」",
                                    "text": "咕~"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7651116",
            "initDialog": "765111601",
            "dialogues": [
                {
                    "id": "765111601",
                    "speaker": "「咕咕丸」",
                    "text": "咕…"
                },
                {
                    "id": "765111602",
                    "speaker": "Player",
                    "text": "刚刚打得非常棒！"
                },
                {
                    "id": "765111603",
                    "speaker": "「咕咕丸」",
                    "text": "？"
                },
                {
                    "id": "765111604",
                    "speaker": "「咕咕丸」",
                    "text": "嗷嗷，嗷，嗷嗷嗷嗷！"
                },
                {
                    "id": "765111605",
                    "speaker": "「咕咕丸」",
                    "text": "（这只忍犬好像受到了莫大的鼓舞，又快乐又充满干劲…）"
                }
            ]
        },
        {
            "talkId": "7651203",
            "initDialog": "765120301",
            "dialogues": [
                {
                    "id": "765120301",
                    "speaker": "「咕咕丸」",
                    "text": "嗷嗷！嗷嗷！"
                },
                {
                    "id": "765120302",
                    "speaker": "堇葵",
                    "text": "看来「咕咕丸」打了个痛快。"
                },
                {
                    "id": "765120303",
                    "speaker": "堇葵",
                    "text": "由衷感谢您的赐教，希望以后还能得到您的指导。"
                }
            ]
