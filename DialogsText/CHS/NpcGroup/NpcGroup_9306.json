{
    "groupId": "9306",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "香菱": 9
    },
    "talks": [
        {
            "talkId": "6930601",
            "initDialog": "693060101",
            "dialogues": [
                {
                    "id": "693060101",
                    "speaker": "香菱",
                    "text": "接下来还要继续战斗的话，要不要先尝尝我做的饭菜，把肚子填饱？"
                },
                {
                    "id": "693060102",
                    "speaker": "香菱",
                    "text": "吃饱了才有力气干活！更别说心情好的话，应对危机时的状态也会变好。"
                },
                {
                    "id": "693060103",
                    "speaker": "香菱",
                    "text": "来，给你筷子。哎呀你就别和我客气啦！"
                }
            ]
        },
        {
            "talkId": "6930602",
            "initDialog": "693060201",
            "dialogues": [
                {
                    "id": "693060201",
                    "speaker": "香菱",
                    "text": "累了吗？我有一个好办法，那就是把面前的敌人统统想象成美味的食材！"
                },
                {
                    "id": "693060202",
                    "speaker": "香菱",
                    "text": "滑滑嫩嫩、香喷喷…美食就在不远处，挥动武器的手是不是突然就有力气了？"
                },
                {
                    "id": "693060203",
                    "speaker": "香菱",
                    "text": "欸，不容易想象吗？这倒是我的盲区…"
                }
            ]
        },
        {
            "talkId": "6930603",
            "initDialog": "693060301",
            "dialogues": [
                {
                    "id": "693060301",
                    "speaker": "香菱",
                    "text": "我的创新菜肴，只有很小一部分上了万民堂的菜单。"
                },
                {
                    "id": "693060302",
                    "speaker": "香菱",
                    "text": "多数是因为我觉得口感不佳，要么就是味道上还有很大改进空间…但我没打算在半山腰停下来。"
                },
                {
                    "id": "693060303",
                    "speaker": "香菱",
                    "text": "好吃的菜肴，早晚会被我挖掘出来的！"
                }
            ]
        }
    ]
}