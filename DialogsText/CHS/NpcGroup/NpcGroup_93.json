    },
    "talks": [
        {
            "talkId": "31256",
            "initDialog": "3125601",
            "dialogues": [
                {
                    "id": "3125601",
                    "speaker": "(test)任务测试npc$UNRELEASED",
                    "text": "喂！那边的旅行者！$UNRELEASED"
                },
                {
                    "id": "3125602",
                    "speaker": "(test)任务测试npc$UNRELEASED",
                    "text": "前面很危险！不要向前走了！$UNRELEASED",
                    "choices": [
                        {
                            "id": "3125603",
                            "text": "…有什么事吗？$UNRELEASED",
                            "response": [
                                {
                                    "id": "3125604",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "前方十分危险，已经有运输队在山道上被强大的怪物袭击了。$UNRELEASED"
                                },
                                {
                                    "id": "3125605",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "如果没什么事的话，还是赶紧离开比较好。$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "3125606",
                            "text": "再见。$UNRELEASED",
                            "response": [
                                {
                                    "id": "3125607",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "嗯，路上小心。$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "31257",
            "initDialog": "3125701",
            "dialogues": [
                {
                    "id": "3125701",
                    "speaker": "(test)任务测试npc$UNRELEASED",
                    "text": "前面是危险地带…欸？你难道是…$UNRELEASED",
                    "choices": [
                        {
                            "id": "3125702",
                            "text": "…有什么事吗？$UNRELEASED",
                            "response": [
                                {
                                    "id": "3125703",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "这个装束…难道你就是他们说的那个的旅行者？！$UNRELEASED"
                                },
                                {
                                    "id": "3125704",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "哎？你不知道？你的事情已经在蒙德传开了呢，听说就是你破除了蒙德的风灾。$UNRELEASED"
                                },
                                {
                                    "id": "3125705",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "虽说你应该有能力应付这前面的怪物了，不过还是要说一句，请注意安全哦。$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "3125706",
                            "text": "再见。$UNRELEASED",
                            "response": [
                                {
                                    "id": "3125707",
                                    "speaker": "(test)任务测试npc$UNRELEASED",
                                    "text": "嗯，路上小心。$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6009301",
            "initDialog": "4015140501",
            "dialogues": [
                {
                    "id": "4015140501",
                    "speaker": "安娜",
                    "text": "你好，请问…咳咳…找我有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6009302",
            "initDialog": "4015140502",
            "dialogues": [
                {
                    "id": "4015140502",
                    "speaker": "安娜",
                    "text": "你在干什么？"
                },
                {
                    "id": "4015140506",
                    "speaker": "安娜",
                    "text": "我在…咳咳…许愿。"
                },
                {
                    "id": "4015140507",
                    "speaker": "安娜",
                    "text": "像这样把硬币投进水池里，然后默念心愿…"
                },
                {
                    "id": "4015140508",
                    "speaker": "安娜",
                    "text": "据说…要有诚心，坚持每天许愿，泉水精灵才会听到…咳…"
                },
                {
                    "id": "4015140509",
                    "speaker": "安娜",
                    "text": "对不起，那个…一直在咳嗽…"
                },
                {
                    "id": "4015140503",
                    "speaker": "安娜",
                    "text": "你的愿望是？"
                },
                {
                    "id": "4015140510",
                    "speaker": "安娜",
                    "text": "啊…我的身体一直不太好。"
                },
                {
                    "id": "4015140511",
                    "speaker": "安娜",
                    "text": "我想要泉水精灵保佑我快点好起来。"
                },
                {
                    "id": "4015140512",
                    "speaker": "安娜",
                    "text": "这样，就不会再给爸爸妈妈，还有安东尼哥哥添麻烦了…"
                }
            ]
        },
        {
            "talkId": "6009303",
            "initDialog": "4015140505",
            "dialogues": [
                {
                    "id": "4015140505",
                    "speaker": "安娜",
                    "text": "打扰了。"
                },
                {
                    "id": "4015140517",
                    "speaker": "安娜",
                    "text": "没有的事。"
                },
                {
                    "id": "4015140518",
                    "speaker": "安娜",
                    "text": "旅行者，希望你的愿望…咳咳…也能早日实现。"
                }
            ]
        }
    ]
}