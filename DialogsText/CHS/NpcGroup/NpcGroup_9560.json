    "talks": [
        {
            "talkId": "6956001",
            "initDialog": "695600101",
            "dialogues": [
                {
                    "id": "695600101",
                    "speaker": "托马",
                    "text": "猫尾酒馆好像比之前还要热闹了，不错不错。真怀念啊！"
                }
            ]
        },
        {
            "talkId": "6956002",
            "initDialog": "695600201",
            "dialogues": [
                {
                    "id": "695600201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956003",
            "initDialog": "695600301",
            "dialogues": [
                {
                    "id": "695600301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695600302",
                    "speaker": "托马",
                    "text": "嗯，我过一会也要去街上逛逛，然后…唔，买点东西带给家主大人和神里小姐。"
                }
            ]
        },
        {
            "talkId": "6956004",
            "initDialog": "695600401",
            "dialogues": [
                {
                    "id": "695600401",
                    "speaker": "托马",
                    "text": "哈哈哈，是我赢了。看来我今天的运势大吉啊，不好意思啦。"
                }
            ]
        },
        {
            "talkId": "6956005",
            "initDialog": "695600501",
            "dialogues": [
                {
                    "id": "695600501",
                    "speaker": "托马",
                    "text": "输了输了，是你更厉害。你做什么都是一把好手啊，真是让人佩服。"
                }
            ]
        },
        {
            "talkId": "6956006",
            "initDialog": "695600601",
            "dialogues": [
                {
                    "id": "695600601",
                    "speaker": "托马",
                    "text": "没问题，我正好学了几式新招。"
                }
            ]
        },
        {
            "talkId": "6956008",
            "initDialog": "695600801",
            "dialogues": [
                {
                    "id": "695600801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956009",
            "initDialog": "695600901",
            "dialogues": [
                {
                    "id": "695600901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956010",
            "initDialog": "695601001",
            "dialogues": [
                {
                    "id": "695601001",
                    "speaker": "托马",
                    "text": "我最后决胜的那一手还不错吧。"
                }
            ]
        },
        {
            "talkId": "6956011",
            "initDialog": "695601101",
            "dialogues": [
                {
                    "id": "695601101",
                    "speaker": "托马",
                    "text": "居、居然输成这样…我的牌力还是太弱了…"
                }
            ]
        },
        {
            "talkId": "6956012",
            "initDialog": "695601201",
            "dialogues": [
                {
                    "id": "695601201",
                    "speaker": "托马",
                    "text": "来吧，这次我可要拿出真本事了。"
                }
            ]
        },
        {
            "talkId": "6956014",
            "initDialog": "695601401",
            "dialogues": [
                {
                    "id": "695601401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956015",
            "initDialog": "695601501",
            "dialogues": [
                {
                    "id": "695601501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956016",
            "initDialog": "695601601",
            "dialogues": [
                {
                    "id": "695601601",
                    "speaker": "托马",
                    "text": "赢了，太好了，我总算没白向家主大人讨教。"
                }
            ]
        },
        {
            "talkId": "6956017",
            "initDialog": "695601701",
            "dialogues": [
                {
                    "id": "695601701",
                    "speaker": "托马",
                    "text": "输掉了。我还是没完全学懂家主大人教的那几招啊，只能下次再找机会讨教了…"
                }
            ]
        },
        {
            "talkId": "6956018",
            "initDialog": "695601801",
            "dialogues": [
                {
                    "id": "695601801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}