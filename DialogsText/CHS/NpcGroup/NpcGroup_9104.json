{
    "groupId": "9104",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Player": 21,
        "恰斯卡": 47
    },
    "talks": [
        {
            "talkId": "6910401",
            "initDialog": "691040101",
            "dialogues": [
                {
                    "id": "691040101",
                    "speaker": "恰斯卡",
                    "text": "这里就是你的「栖居地」吗？环境很不错。"
                },
                {
                    "id": "691040102",
                    "speaker": "恰斯卡",
                    "text": "如果能多些易守难攻的制高点就更好了…虽然这里也没人能打进来吧。"
                }
            ]
        },
        {
            "talkId": "6910402",
            "initDialog": "691040201",
            "dialogues": [
                {
                    "id": "691040201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691040202",
                    "speaker": "恰斯卡",
                    "text": "习惯…可能还说不上。"
                },
                {
                    "id": "691040203",
                    "speaker": "恰斯卡",
                    "text": "这里的空气安宁得出奇。风的呼啸，野兽间动荡的敌意，隐藏在人群喧闹声下的汹涌浪潮…我都听不到。"
                },
                {
                    "id": "691040204",
                    "speaker": "恰斯卡",
                    "text": "内心深处一直躁动着的感觉似乎也平和了下来…非常奇妙。",
                    "choices": [
                        {
                            "id": "691040205",
                            "text": "要练练手吗？",
                            "response": [
                                {
                                    "id": "691040206",
                                    "speaker": "恰斯卡",
                                    "text": "还是算了，我可不忍心破坏这么难得的安宁。"
                                },
                                {
                                    "id": "691040209",
                                    "speaker": "恰斯卡",
                                    "text": "这世上的纷争跟矛盾已经够多了，就让它们都留在外面吧。"
                                },
                                {
                                    "id": "691040210",
                                    "speaker": "恰斯卡",
                                    "text": "#{NICKNAME}，谢谢你带我来这里。"
                                }
                            ]
                        },
                        {
                            "id": "691040207",
                            "text": "这是坏事吗？",
                            "response": [
                                {
                                    "id": "691040208",
                                    "speaker": "恰斯卡",
                                    "text": "不，我很钟意这种「不习惯」。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910403",
            "initDialog": "691040301",
            "dialogues": [
                {
                    "id": "691040301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691040302",
                    "speaker": "恰斯卡",
                    "text": "好啊，刚好我有点事想问问你。"
                },
                {
                    "id": "691040303",
                    "speaker": "Player",
                    "text": "嗯？什么事？"
                },
                {
                    "id": "691040304",
                    "speaker": "恰斯卡",
                    "text": "那边那位…名字是叫阿圆对吗？你知道她是怎么浮起来的吗？"
                },
                {
                    "id": "691040305",
                    "speaker": "恰斯卡",
                    "text": "明明看起来圆滚滚沉甸甸的，也看不出有什么动力源，却能一直保持滞空状态…"
                },
                {
                    "id": "691040306",
                    "speaker": "恰斯卡",
                    "text": "要是能弄清楚是什么原理，说不定我就能带着更多火力上天了。"
                },
                {
                    "id": "691040307",
                    "speaker": "Player",
                    "text": "估计是璃月的仙术…"
                },
                {
                    "id": "691040308",
                    "speaker": "恰斯卡",
                    "text": "「仙术」？我从前也听人说起过，当时就觉得不可思议，可惜故事里的「仙人」总是难得一见。"
                },
                {
                    "id": "691040309",
                    "speaker": "Player",
                    "text": "要不直接问问阿圆？"
                },
                {
                    "id": "691040310",
                    "speaker": "恰斯卡",
                    "text": "嗯，我已经跟她打过招呼了，也试着问过。"
                },
                {
                    "id": "691040311",
                    "speaker": "恰斯卡",
                    "text": "…不过她似乎有点害怕，说我盯着她的眼神就像盯着小鸟的猛禽…"
                },
                {
                    "id": "691040312",
                    "speaker": "Player",
                    "text": "我觉得可能更像绒翼龙…"
                },
                {
                    "id": "691040313",
                    "speaker": "恰斯卡",
                    "text": "是吗？唔…绒翼龙的一些特征确实挺像猛禽的。",
                    "choices": [
                        {
                            "id": "691040314",
                            "text": "比如说眼神吗？",
                            "response": [
                                {
                                    "id": "691040315",
                                    "speaker": "恰斯卡",
                                    "text": "嗯，绒翼龙跟多数猛禽的眉骨突出、双目靠前，是为了在高速机动中保护眼睛，以及更好地从高空锁定目标。"
                                },
                                {
                                    "id": "691040316",
                                    "speaker": "恰斯卡",
                                    "text": "乍一眼看上去，确实会显得有些凶戾。"
                                },
                                {
                                    "id": "691040320",
                                    "speaker": "Player",
                                    "text": "难怪阿圆会害怕…"
                                },
                                {
                                    "id": "691040321",
                                    "speaker": "恰斯卡",
                                    "text": "咳…不过再怎么说，我也不会把阿圆当成猎物的…况且我又不是绒翼龙。"
                                },
                                {
                                    "id": "691040322",
                                    "speaker": "恰斯卡",
                                    "text": "得找个机会调解这场误会了…等等，当事人是不是不能担任调解人？",
                                    "choices": [
                                        {
                                            "id": "691040323",
                                            "text": "不如送点羽毛护理工具？",
                                            "response": [
                                                {
                                                    "id": "691040324",
                                                    "speaker": "恰斯卡",
                                                    "text": "唔…挺不错的建议，绒翼龙每天都会花上不少时间来打理自己的羽毛。"
                                                },
                                                {
                                                    "id": "691040325",
                                                    "speaker": "恰斯卡",
                                                    "text": "我也学着配过一些羽毛护理喷雾，不但能保持羽毛鲜亮，还能驱虫除味…不知道阿圆能不能用得上。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691040326",
                                            "text": "不如送点亮晶晶的小饰品？",
                                            "response": [
                                                {
                                                    "id": "691040327",
                                                    "speaker": "恰斯卡",
                                                    "text": "哦？你挺懂的嘛。我跟「妈妈」都很乐于收集这类装饰，不知道阿圆喜不喜欢。"
                                                },
                                                {
                                                    "id": "691040328",
                                                    "speaker": "恰斯卡",
                                                    "text": "嗯…看「洞天宝钱」的样式，应该没问题吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691040317",
                            "text": "比如说食性吗？",
                            "response": [
                                {
                                    "id": "691040318",
                                    "speaker": "恰斯卡",
                                    "text": "嗯，绒翼龙和猛禽平时都以肉食为主，都有着尖锐的钩喙和锋利的趾爪。"
                                },
                                {
                                    "id": "691040319",
                                    "speaker": "恰斯卡",
                                    "text": "除了常见的中小型兽类和鱼类，有时还会袭击体型比自己小的鸟类…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910404",
            "initDialog": "691040401",
            "dialogues": [
                {
                    "id": "691040401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691040402",
                    "speaker": "恰斯卡",
                    "text": "我想从高空侦察一下这里的地形，看看有什么守备薄弱的环节…"
                },
                {
                    "id": "691040403",
                    "speaker": "Player",
                    "text": "这里应该还算安全…"
                },
                {
                    "id": "691040404",
                    "speaker": "恰斯卡",
                    "text": "开玩笑的，我只是想要俯瞰一下你创造出的风景。"
                },
                {
                    "id": "691040405",
                    "speaker": "恰斯卡",
                    "text": "平时飞得太快，眼里只有远方的目标，或者地上的敌人，很少有机会静下心欣赏特定的景色。"
                },
                {
                    "id": "691040406",
                    "speaker": "恰斯卡",
                    "text": "不过在这里，应该能有这种闲暇了。"
                },
                {
                    "id": "691040407",
                    "speaker": "Player",
                    "text": "听起来和「旅行」一样？"
                },
                {
                    "id": "691040408",
                    "speaker": "恰斯卡",
                    "text": "嗯，「旅行的目的不只是终点」…是这么说的吧？",
                    "choices": [
                        {
                            "id": "691040409",
                            "text": "所以「沿途的风景」…",
                            "response": [
                                {
                                    "id": "691040411",
                                    "speaker": "恰斯卡",
                                    "text": "当然，平时可看不见这样的角度。"
                                },
                                {
                                    "id": "691040412",
                                    "speaker": "恰斯卡",
                                    "text": "习以为常的建筑变得像箱子一样小，在地面时只能仰望的山石，一伸手就能够触碰得到…"
                                },
                                {
                                    "id": "691040413",
                                    "speaker": "恰斯卡",
                                    "text": "…在高处看着下边的景色，就像是把平时看不完的世界，都塞进了一幅画里一样奇妙。"
                                },
                                {
                                    "id": "691040414",
                                    "speaker": "Player",
                                    "text": "那要不要专门为你摆一幅画？"
                                },
                                {
                                    "id": "691040415",
                                    "speaker": "恰斯卡",
                                    "text": "嗯？你是说…只能在天上看全的「地画」吗？呵，听起来挺有趣的。"
                                },
                                {
                                    "id": "691040416",
                                    "speaker": "恰斯卡",
                                    "text": "「花羽会」边上有不少绘制在山崖上的壁画，却少有能铺得下巨幅地画的平地。"
                                },
                                {
                                    "id": "691040417",
                                    "speaker": "恰斯卡",
                                    "text": "想要画什么？已经有想法了吗？"
                                },
                                {
                                    "id": "691040418",
                                    "speaker": "恰斯卡",
                                    "text": "唔…要不我也来一起布置？如果能随时从天上俯瞰，「画」起来应该也会更快吧。"
                                }
                            ]
                        },
                        {
                            "id": "691040410",
                            "text": "会有什么不一样吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910405",
            "initDialog": "691040501",
            "dialogues": [
                {
                    "id": "691040501",
                    "speaker": "Player",
                    "text": "早啊，恰斯卡。"
                },
                {
                    "id": "691040502",
                    "speaker": "恰斯卡",
                    "text": "#早，{NICKNAME}。今天有什么计划吗？"
                }
            ]
        },
        {
            "talkId": "6910406",
            "initDialog": "691040601",
            "dialogues": [
                {
                    "id": "691040601",
                    "speaker": "Player",
                    "text": "晚安，恰斯卡。"
                },
                {
                    "id": "691040602",
                    "speaker": "恰斯卡",
                    "text": "晚安。好好睡一觉吧，为了迎接明天。"
                }
            ]
        },
        {
            "talkId": "6910410",
            "initDialog": "691041001",
            "dialogues": [
                {
                    "id": "691041001",
                    "speaker": "恰斯卡",
                    "text": "花羽会的风格吗…还记得我刚来部族的时候，看什么都不顺眼。"
                },
                {
                    "id": "691041002",
                    "speaker": "恰斯卡",
                    "text": "每天不是打坏几只气球，就是拆掉几个平台…闹太大了就跑出去。"
                },
                {
                    "id": "691041003",
                    "speaker": "恰斯卡",
                    "text": "只是不知不觉间…我也已经迷恋上这样的景色了呢。"
                }
            ]
        },
        {
            "talkId": "6910411",
            "initDialog": "691041101",
            "dialogues": [
                {
                    "id": "691041101",
                    "speaker": "恰斯卡",
                    "text": "哦…是谈判桌的气味吗，真是令人安心。只要接受「调停」的双方能走到这里，事情就总会有些进展。"
                },
                {
                    "id": "691041102",
                    "speaker": "恰斯卡",
                    "text": "毕竟很多时候调停矛盾最难的一步，就是如何把冥顽不灵的家伙给拉上谈判桌。"
                },
                {
                    "id": "691041103",
                    "speaker": "恰斯卡",
                    "text": "至于能在桌上达成什么协议…却往往取决于谈判桌之外了。"
                }
            ]
        }
    ]
}