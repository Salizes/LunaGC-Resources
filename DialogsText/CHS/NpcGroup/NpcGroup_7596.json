{
    "groupId": "7596",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "多洛霍夫": 11
    },
    "talks": [
        {
            "talkId": "6759601",
            "initDialog": "675960101",
            "dialogues": [
                {
                    "id": "675960101",
                    "speaker": "多洛霍夫",
                    "text": "哈哈哈…都是故事…不是真的，不是真的…"
                }
            ]
        },
        {
            "talkId": "6759602",
            "initDialog": "675960201",
            "dialogues": [
                {
                    "id": "675960201",
                    "speaker": "Player",
                    "text": "什么不是真的？"
                },
                {
                    "id": "675960202",
                    "speaker": "多洛霍夫",
                    "text": "哎哟！您、您吓我一跳，天哪，吓死我了…"
                }
            ]
        },
        {
            "talkId": "6759603",
            "initDialog": "675960301",
            "dialogues": [
                {
                    "id": "675960301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "675960302",
                    "speaker": "多洛霍夫",
                    "text": "哎哟！什么？噢…！再见…再见…"
                }
            ]
        },
        {
            "talkId": "6759604",
            "initDialog": "675960401",
            "dialogues": [
                {
                    "id": "675960401",
                    "speaker": "Player",
                    "text": "你怎么了…"
                },
                {
                    "id": "675960402",
                    "speaker": "多洛霍夫",
                    "text": "呃…我没事，就是被…赫鲁塔廖夫的故事…吓着了…"
                },
                {
                    "id": "675960403",
                    "speaker": "多洛霍夫",
                    "text": "您知道赫鲁塔廖夫吗？就是在旁边一直念叨着灵异故事的那一位。我偶尔会和赫鲁塔廖夫聊天，他也会把他写的故事念给我听…"
                },
                {
                    "id": "675960404",
                    "speaker": "多洛霍夫",
                    "text": "他…他念故事的时候很随意，而且一直说，这些故事既无聊又没新意，但…"
                },
                {
                    "id": "675960405",
                    "speaker": "多洛霍夫",
                    "text": "但…但我真的遇见那些说不清道不明的事啊！比如厨房里的锅碗在半夜突然响起来，窗户外传来抓挠的声音，门外出现了倒着的脚印…"
                },
                {
                    "id": "675960406",
                    "speaker": "多洛霍夫",
                    "text": "我都要被吓疯了！只能安慰自己，这应该就是单纯的犯罪未遂啦…哈哈…"
                }
            ]
        },
        {
            "talkId": "6759605",
            "initDialog": "675960501",
            "dialogues": [
                {
                    "id": "675960501",
                    "speaker": "Player",
                    "text": "这听着也不是很妙欸…"
                },
                {
                    "id": "675960502",
                    "speaker": "多洛霍夫",
                    "text": "如果真是有人想犯罪，那我至少可以报警。但如果是…"
                },
                {
                    "id": "675960503",
                    "speaker": "多洛霍夫",
                    "text": "…那我就真的无计可施了…"
                },
                {
                    "id": "675960504",
                    "speaker": "多洛霍夫",
                    "text": "不管了，都不是真的都不是真的…"
                }
            ]
        }
    ]
}