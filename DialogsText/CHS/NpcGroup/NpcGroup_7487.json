    "talks": [
        {
            "talkId": "6748701",
            "initDialog": "674870101",
            "dialogues": [
                {
                    "id": "674870101",
                    "speaker": "基拉",
                    "text": "请有序进站，如有必要，请配合工作人员检查。"
                }
            ]
        },
        {
            "talkId": "6748702",
            "initDialog": "674870201",
            "dialogues": [
                {
                    "id": "674870201",
                    "speaker": "Player",
                    "text": "检查？"
                },
                {
                    "id": "674870202",
                    "speaker": "基拉",
                    "text": "按照新规定，我们有权力对任何具有潜在风险的人士进行抽检，包括但不限于行李检查与个人情况询问。"
                },
                {
                    "id": "674870203",
                    "speaker": "热拉尔",
                    "text": "如有任何问题，请向运输局反馈。"
                }
            ]
        },
        {
            "talkId": "6748703",
            "initDialog": "674870301",
            "dialogues": [
                {
                    "id": "674870301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674870302",
                    "speaker": "基拉",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6748704",
            "initDialog": "674870401",
            "dialogues": [
                {
                    "id": "674870401",
                    "speaker": "Player",
                    "text": "新规定？"
                },
                {
                    "id": "674870402",
                    "speaker": "基拉",
                    "text": "是为保证「严冬计划」顺利进行，防止意外发生的新规定。"
                }
            ]
        },
        {
            "talkId": "6748705",
            "initDialog": "674870501",
            "dialogues": [
                {
                    "id": "674870501",
                    "speaker": "Player",
                    "text": "谁会是「具有潜在风险的人士」？"
                },
                {
                    "id": "674870502",
                    "speaker": "基拉",
                    "text": "…如您所见，每个进入车站的旅客都可能有潜在风险。如果您对我们的判断标准有什么疑问，可以向运输局反馈。"
                }
            ]
        },
        {
            "talkId": "6748706",
            "initDialog": "674870601",
            "dialogues": [
                {
                    "id": "674870601",
                    "speaker": "Player",
                    "text": "都会有什么样的意外？"
                },
                {
                    "id": "674870602",
                    "speaker": "基拉",
                    "text": "…总之，这是运输局的规定，一切都是为了至冬的安全。如果您对规定的内容有疑问，可以向运输局反馈。"
                }
            ]
        },
        {
            "talkId": "6748707",
            "initDialog": "674870701",
            "dialogues": [
                {
                    "id": "674870701",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "674870702",
                    "speaker": "派蒙",
                    "text": ""
                }
            ]
        }
    ]
}