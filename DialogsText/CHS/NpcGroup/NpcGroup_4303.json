{
    "groupId": "4303",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "卡姆兰": 17
    },
    "talks": [
        {
            "talkId": "6430301",
            "initDialog": "643030101",
            "dialogues": [
                {
                    "id": "643030101",
                    "speaker": "卡姆兰",
                    "text": "要不是因为树林可以缓解病症…哪轮得到魔鳞病人当巡林员啊。"
                }
            ]
        },
        {
            "talkId": "6430302",
            "initDialog": "643030201",
            "dialogues": [
                {
                    "id": "643030201",
                    "speaker": "Player",
                    "text": "魔鳞病？"
                },
                {
                    "id": "643030202",
                    "speaker": "卡姆兰",
                    "text": "嗯？你是谁？来干什么的？问这个干嘛？"
                }
            ]
        },
        {
            "talkId": "6430303",
            "initDialog": "643030301",
            "dialogues": [
                {
                    "id": "643030301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "643030302",
                    "speaker": "卡姆兰",
                    "text": "哦，不送。"
                }
            ]
        },
        {
            "talkId": "6430304",
            "initDialog": "643030401",
            "dialogues": [
                {
                    "id": "643030401",
                    "speaker": "Player",
                    "text": "只是路过。"
                },
                {
                    "id": "643030402",
                    "speaker": "卡姆兰",
                    "text": "哦。"
                },
                {
                    "id": "643030403",
                    "speaker": "卡姆兰",
                    "text": "这里是化城郭，你如果累了可以在这里歇脚。"
                },
                {
                    "id": "643030404",
                    "speaker": "卡姆兰",
                    "text": "如果不想被巡林官「教育」，也顺便读一读告示板上的东西吧。"
                },
                {
                    "id": "643030405",
                    "speaker": "卡姆兰",
                    "text": "其他的，恕我无可奉告。"
                }
            ]
        },
        {
            "talkId": "6430305",
            "initDialog": "643030501",
            "dialogues": [
                {
                    "id": "643030501",
                    "speaker": "Player",
                    "text": "我是提纳里的朋友。"
                },
                {
                    "id": "643030502",
                    "speaker": "卡姆兰",
                    "text": "欸，竟然是巡林官的朋友？失敬失敬。"
                },
                {
                    "id": "643030503",
                    "speaker": "卡姆兰",
                    "text": "魔鳞病是须弥这边一种很麻烦的病症。正如其名，病人的身上会出现像鳞片一样的东西。"
                },
                {
                    "id": "643030504",
                    "speaker": "卡姆兰",
                    "text": "「健康之家」说这个病需要静养…那一个病人却做了巡林员，每天忙来忙去的，真的没问题吗？"
                }
            ]
        },
        {
            "talkId": "6430306",
            "initDialog": "643030601",
            "dialogues": [
                {
                    "id": "643030601",
                    "speaker": "卡姆兰",
                    "text": "真没想到魔鳞病竟然会有痊愈的那一天…那么那个小姑娘应该很快就会离开巡林队了吧。"
                }
            ]
        },
        {
            "talkId": "6430307",
            "initDialog": "643030701",
            "dialogues": [
                {
                    "id": "643030701",
                    "speaker": "Player",
                    "text": "哪个小姑娘？"
                },
                {
                    "id": "643030702",
                    "speaker": "卡姆兰",
                    "text": "嗯？你是谁？来干什么的？问这个干嘛？"
                }
            ]
        },
        {
            "talkId": "6430309",
            "initDialog": "643030901",
            "dialogues": [
                {
                    "id": "643030901",
                    "speaker": "Player",
                    "text": "我是提纳里的朋友。"
                },
                {
                    "id": "643030902",
                    "speaker": "卡姆兰",
                    "text": "欸，竟然是巡林官的朋友？失敬失敬。"
                },
                {
                    "id": "643030903",
                    "speaker": "卡姆兰",
                    "text": "我说的小姑娘指的是我们这里的一名见习巡林员啦。"
                },
                {
                    "id": "643030904",
                    "speaker": "卡姆兰",
                    "text": "她本来就是为了养病才在林子里待着的，现在病好了，应该也该离开这里了吧。"
                },
                {
                    "id": "643030905",
                    "speaker": "卡姆兰",
                    "text": "虽说她自己好像挺愿意继续当巡林员的，但人总是善变的嘛。"
                },
                {
                    "id": "643030906",
                    "speaker": "卡姆兰",
                    "text": "现在就连贤者的话都不能相信了，所以也别对其他的事情抱太大希望。"
                }
            ]
        }
    ]
}