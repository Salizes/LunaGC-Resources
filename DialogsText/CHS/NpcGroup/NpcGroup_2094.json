{
    "groupId": "2094",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "公明": 13
    },
    "talks": [
        {
            "talkId": "6209401",
            "initDialog": "620940101",
            "dialogues": [
                {
                    "id": "620940101",
                    "speaker": "公明",
                    "text": "请说明你的来意。"
                },
                {
                    "id": "620940102",
                    "speaker": "公明",
                    "text": "这里是璃月要地，请恕我有些神经过敏。"
                }
            ]
        },
        {
            "talkId": "6209402",
            "initDialog": "620940201",
            "dialogues": [
                {
                    "id": "620940201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "620940202",
                    "speaker": "公明",
                    "text": "我本来没有义务回答你的问题，但你的问题实在过于缺乏常识…"
                },
                {
                    "id": "620940203",
                    "speaker": "公明",
                    "text": "那就回答你好了，这里是「黄金屋」，或者你直接称这里为璃月…不，提瓦特大陆的造币厂也可以。"
                },
                {
                    "id": "620940204",
                    "speaker": "公明",
                    "text": "财富的源泉，欲望的根基，经济的命脉…我作为统管此处的理事，再小心也不为过。"
                }
            ]
        },
        {
            "talkId": "6209403",
            "initDialog": "620940301",
            "dialogues": [
                {
                    "id": "620940301",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620940302",
                    "speaker": "公明",
                    "text": "这消息看起来很多人都知道了呢…七星的那些大人们看来也不是万能的…"
                },
                {
                    "id": "620940303",
                    "speaker": "公明",
                    "text": "说实话，我十分动摇。那位大人忽然离我们而去，究竟意味着什么，我甚至没有胆量去细细思索…"
                },
                {
                    "id": "620940304",
                    "speaker": "公明",
                    "text": "而且，七星采取的一些行动也令我捉摸不透…那些远超我「权限」的命令究竟是…"
                }
            ]
        },
        {
            "talkId": "6209404",
            "initDialog": "620940401",
            "dialogues": [
                {
                    "id": "620940401",
                    "speaker": "Player",
                    "text": "不好意思，再见。"
                },
                {
                    "id": "620940402",
                    "speaker": "公明",
                    "text": "嗯，不是「黄金屋」的相关业务人员的话，还请不要擅自出入。"
                }
            ]
        },
        {
            "talkId": "6209405",
            "initDialog": "620940501",
            "dialogues": [
                {
                    "id": "620940501",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620940502",
                    "speaker": "公明",
                    "text": "如今，这件事已经不再是秘密了，恐怕街头巷尾都在讨论这件事吧。"
                },
                {
                    "id": "620940503",
                    "speaker": "公明",
                    "text": "真是屋漏偏逢连夜雨…就在岩王爷离去之际，身份不明的贼人强行闯入了「黄金屋」…"
                },
                {
                    "id": "620940504",
                    "speaker": "公明",
                    "text": "…不过最让我在意的是，经过清点后发现，里面存放的摩拉分文不少…"
                },
                {
                    "id": "620940505",
                    "speaker": "公明",
                    "text": "袭击了「黄金屋」却不是为了摩拉，这到底是怎么回事？我实在是无法理解啊…"
                }
            ]
        }
    ]
}