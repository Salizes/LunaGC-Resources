{
    "groupId": "13088",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "「造笼师」": 12,
        "派蒙": 3
    },
    "talks": [
        {
            "talkId": "7273003",
            "initDialog": "727300301",
            "dialogues": [
                {
                    "id": "727300301",
                    "speaker": "「造笼师」",
                    "text": "「电气鞘翅」…要怎么帮你雪耻呢…",
                    "choices": [
                        {
                            "id": "727300302",
                            "text": "再和派蒙斗一回？",
                            "response": [
                                {
                                    "id": "727300303",
                                    "speaker": "「造笼师」",
                                    "text": "什么？难道你们想把我当成免费陪练的沙包吗？"
                                },
                                {
                                    "id": "727300304",
                                    "speaker": "「造笼师」",
                                    "text": "岂有此理！这次我就让你们输个凄凄惨惨！"
                                }
                            ]
                        },
                        {
                            "id": "727300305",
                            "text": "关于「花角玉将」…",
                            "response": [
                                {
                                    "id": "727300306",
                                    "speaker": "「造笼师」",
                                    "text": "呵！休想刺探「花角玉将」的机密！"
                                },
                                {
                                    "id": "727300307",
                                    "speaker": "「造笼师」",
                                    "text": "你们只需要知道，「花角玉将」有着让人迷途知返的本领，能让人深切领会斗虫的魅力！"
                                },
                                {
                                    "id": "727300308",
                                    "speaker": "派蒙",
                                    "text": "迷途知返？你的用词好夸张啊…"
                                },
                                {
                                    "id": "727300309",
                                    "speaker": "「造笼师」",
                                    "text": "可不是吗！当年的我一心沉迷木工，完全没有考虑过，如何将木工本领的价值发挥出来。"
                                },
                                {
                                    "id": "727300310",
                                    "speaker": "「造笼师」",
                                    "text": "看着堂妹的二表哥的舅舅的挚友的侄子「电气鞘翅」沉迷斗虫，居然还妄图阻挠他…"
                                },
                                {
                                    "id": "727300311",
                                    "speaker": "「造笼师」",
                                    "text": "还好，「电气鞘翅」带我去见了「花角玉将」，听过他的演说后，我才明白斗虫有多可贵，自己有多幼稚！"
                                },
                                {
                                    "id": "727300312",
                                    "speaker": "「造笼师」",
                                    "text": "从此，我就开始钻研斗虫的门道，并将自己毕生钻研的木工本领运用在制作虫笼上，全力支援「电气鞘翅」和「花角玉将」。"
                                },
                                {
                                    "id": "727300313",
                                    "speaker": "「造笼师」",
                                    "text": "「破空白铁小堇瓜」，你也该好好听「花角玉将」的演说，然后为他效命！"
                                },
                                {
                                    "id": "727300314",
                                    "speaker": "派蒙",
                                    "text": "才不要！听你这么一说，我反而有点害怕！"
                                },
                                {
                                    "id": "727300315",
                                    "speaker": "派蒙",
                                    "text": "别搞那么多花里胡哨的词语嘛，还是放牛的…还是「真剑斗虫大鬼王」的话，听着更舒服！"
                                },
                                {
                                    "id": "727300316",
                                    "speaker": "「造笼师」",
                                    "text": "对牛弹琴，不弹也罢，你们就继续迷糊去吧！"
                                }
                            ]
                        },
                        {
                            "id": "727300317",
                            "text": "告辞！",
                            "response": [
                                {
                                    "id": "727300318",
                                    "speaker": "「造笼师」",
                                    "text": "快走快走！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}