        {
            "talkId": "1402203",
            "initDialog": "140220301",
            "dialogues": [
                {
                    "id": "140220301",
                    "speaker": "阅读",
                    "text": "桌上散落着一些笔记…",
                    "choices": [
                        {
                            "id": "140220302",
                            "text": "旅行计划",
                            "response": [
                                {
                                    "id": "140220303",
                                    "speaker": "旅行计划",
                                    "text": "「听说纳塔的人们穿着新潮，有时间去看看…」"
                                },
                                {
                                    "id": "140220304",
                                    "speaker": "旅行计划",
                                    "text": "「至冬的设计能作为冬装参考…顺路的话…」"
                                }
                            ]
                        },
                        {
                            "id": "140220305",
                            "text": "寄给夏沃蕾的信",
                            "response": [
                                {
                                    "id": "140220306",
                                    "speaker": "寄给夏沃蕾的信",
                                    "text": "「执律庭…的职员，于店内提及上司与…的交易，语气确凿…」"
                                },
                                {
                                    "id": "140220307",
                                    "speaker": "寄给夏沃蕾的信",
                                    "text": "「有人于…目击到通缉犯…出没，恐怕是谣言…」"
                                }
                            ]
                        },
                        {
                            "id": "140220308",
                            "text": "寄给夏洛蒂的信",
                            "response": [
                                {
                                    "id": "140220309",
                                    "speaker": "寄给夏洛蒂的信",
                                    "text": "「…多谢前阵子的报道，这是为温亨廷先生设计的新款装饰。」"
                                },
                                {
                                    "id": "140220310",
                                    "speaker": "寄给夏洛蒂的信",
                                    "text": "「…有机会一起喝茶。只是喝茶，不是采访。」"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}