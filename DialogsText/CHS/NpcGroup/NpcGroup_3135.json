{
    "groupId": "3135",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "未来": 14
    },
    "talks": [
        {
            "talkId": "6313501",
            "initDialog": "631350101",
            "dialogues": [
                {
                    "id": "631350101",
                    "speaker": "未来",
                    "text": "哥哥什么时候才能回家呢…"
                }
            ]
        },
        {
            "talkId": "6313502",
            "initDialog": "631350201",
            "dialogues": [
                {
                    "id": "631350201",
                    "speaker": "Player",
                    "text": "你的哥哥去哪了？"
                },
                {
                    "id": "631350202",
                    "speaker": "未来",
                    "text": "我的哥哥可厉害了！他是军队的士兵，现在正在…呃，很远很远的地方守护着我们。"
                },
                {
                    "id": "631350203",
                    "speaker": "未来",
                    "text": "这次的任务一定非常重要吧，哥哥出门了好久好久…"
                },
                {
                    "id": "631350204",
                    "speaker": "未来",
                    "text": "不过我已经不是喜欢哭闹的小孩子了，会乖乖等哥哥回家的。"
                },
                {
                    "id": "631350205",
                    "speaker": "未来",
                    "text": "上次哥哥写信回来，说了不少外面的故事，看上去心情很好。一定是军队的任务完成得很顺利，他过不久就能回家了！"
                },
                {
                    "id": "631350206",
                    "speaker": "未来",
                    "text": "那我要趁现在多去野外采些花，这样等哥哥回来就可以送给他啦！"
                }
            ]
        },
        {
            "talkId": "6313503",
            "initDialog": "631350301",
            "dialogues": [
                {
                    "id": "631350301",
                    "speaker": "Player",
                    "text": "小妹妹再见。"
                },
                {
                    "id": "631350302",
                    "speaker": "未来",
                    "text": "嗯，再见！"
                }
            ]
        },
        {
            "talkId": "6313504",
            "initDialog": "631350401",
            "dialogues": [
                {
                    "id": "631350401",
                    "speaker": "Player",
                    "text": "一个人没问题吗？"
                },
                {
                    "id": "631350402",
                    "speaker": "未来",
                    "text": "没关系的！我经常出去玩，对村子附近已经很熟悉啦。"
                },
                {
                    "id": "631350403",
                    "speaker": "未来",
                    "text": "而且就算不小心摔倒，玲玲姐也会照顾我的。"
                },
                {
                    "id": "631350404",
                    "speaker": "未来",
                    "text": "玲玲姐是医生哦，虽然说话有点凶，但会帮我把擦破皮的地方包扎好，还会给我甜甜的点心吃。"
                },
                {
                    "id": "631350405",
                    "speaker": "未来",
                    "text": "当然我自己也不应该再乱跑了，不能给大家添麻烦才是。哥哥说过，知错就改，就是好孩子。"
                }
            ]
        },
        {
            "talkId": "7293701",
            "initDialog": "729370101",
            "dialogues": [
                {
                    "id": "729370101",
                    "speaker": "Player",
                    "text": "要注意安全。"
                },
                {
                    "id": "729370102",
                    "speaker": "未来",
                    "text": "嗯，谢谢你！你说话好像我哥哥哦，他也总是这样叮嘱我，嘿嘿。"
                },
                {
                    "id": "729370103",
                    "speaker": "未来",
                    "text": "这里有些我在外边玩的时候找到的东西，送给你！"
                },
                {
                    "id": "729370104",
                    "speaker": "未来",
                    "text": "你收下吧，没关系的，我每天都有很多时间，可以再去找。"
                }
            ]
        }
    ]
}