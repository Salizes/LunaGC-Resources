{
    "groupId": "5128",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "桑迪诺": 14
    },
    "talks": [
        {
            "talkId": "6512801",
            "initDialog": "651280101",
            "dialogues": [
                {
                    "id": "651280101",
                    "speaker": "桑迪诺",
                    "text": "嗯…看来今天也钓不上了。"
                }
            ]
        },
        {
            "talkId": "6512802",
            "initDialog": "651280201",
            "dialogues": [
                {
                    "id": "651280201",
                    "speaker": "Player",
                    "text": "抱歉，走得有点急…"
                },
                {
                    "id": "651280202",
                    "speaker": "桑迪诺",
                    "text": "嗯？为什么道歉？"
                },
                {
                    "id": "651280203",
                    "speaker": "桑迪诺",
                    "text": "啊，你误会了，我不是在怪你把鱼吓跑了，真是不好意思。"
                },
                {
                    "id": "651280204",
                    "speaker": "桑迪诺",
                    "text": "是我家孙子总在这附近跑来跑去的，是鱼是鸟看到他在都不会愿意停留的。"
                },
                {
                    "id": "651280205",
                    "speaker": "桑迪诺",
                    "text": "不过我也习惯了，我爱钓鱼只是喜欢这种需要耐心、可以静下来思考的过程，有没有鱼无所谓啦。"
                },
                {
                    "id": "651280206",
                    "speaker": "桑迪诺",
                    "text": "卡瓦的父母常年不在家陪他，这孩子能自己开心地玩耍，已经很让我省心了。"
                }
            ]
        },
        {
            "talkId": "6512803",
            "initDialog": "651280301",
            "dialogues": [
                {
                    "id": "651280301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "651280302",
                    "speaker": "桑迪诺",
                    "text": "没关系，慢点走，地上滑。"
                }
            ]
        },
        {
            "talkId": "6512804",
            "initDialog": "651280401",
            "dialogues": [
                {
                    "id": "651280401",
                    "speaker": "Player",
                    "text": "关于之前的水灾…"
                },
                {
                    "id": "651280402",
                    "speaker": "桑迪诺",
                    "text": "对于白淞镇这样的小镇来说，差不多是灭顶之灾了吧…所以镇上能修复成现在这样，可以算得上是奇迹了。"
                },
                {
                    "id": "651280403",
                    "speaker": "桑迪诺",
                    "text": "娜维娅小姐她年纪轻轻就要面对这种情况，真令人难过…"
                },
                {
                    "id": "651280404",
                    "speaker": "桑迪诺",
                    "text": "她还说要准备赔偿金什么的，可自然的灾害怎么会是刺玫会的错呢？"
                },
                {
                    "id": "651280405",
                    "speaker": "桑迪诺",
                    "text": "说来惭愧，我这把年纪，别说帮忙，不拖后腿就已经很不错了。"
                },
                {
                    "id": "651280406",
                    "speaker": "桑迪诺",
                    "text": "要感谢刺玫会，还有艾琪诺小姐。要不是她在附近，我和孙子可能就没这么幸运了。"
                }
            ]
        },
        {
            "talkId": "7490901",
            "initDialog": "749090101",
            "dialogues": [
                {
                    "id": "749090101",
                    "speaker": "Player",
                    "text": "看来您的确很有耐心。"
                },
                {
                    "id": "749090102",
                    "speaker": "桑迪诺",
                    "text": "呵呵，年纪大了，已经没有什么需要我去马上处理的事情啦。"
                },
                {
                    "id": "749090103",
                    "speaker": "桑迪诺",
                    "text": "陪我这老头子聊了这么多，要不要在这吃顿便饭？虽然不是我亲手钓的鱼，但味道绝对有保障。"
                }
            ]
        }
    ]
}