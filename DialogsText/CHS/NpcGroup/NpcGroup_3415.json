    "talks": [
        {
            "talkId": "6341501",
            "initDialog": "634150101",
            "dialogues": [
                {
                    "id": "634150101",
                    "speaker": "拉杜日娜娅",
                    "text": "欢迎来到赫斯珀利德斯之馆！我是负责在前厅接待客人的克谢尼娅，客人有什么需要请尽管和我说哦！"
                }
            ]
        },
        {
            "talkId": "6341502",
            "initDialog": "634150201",
            "dialogues": [
                {
                    "id": "634150201",
                    "speaker": "Player",
                    "text": "关于这座公馆…"
                },
                {
                    "id": "634150202",
                    "speaker": "奥克萨娜",
                    "text": "嗯…好哦！这就为客人介绍，嘿嘿，我很少做这种介绍所以还有点紧张…"
                },
                {
                    "id": "634150203",
                    "speaker": "奥克萨娜",
                    "text": "这里名为赫斯珀利德斯之馆，在白沙皇陛下统一北地建立苍星王廷之后，由初代雪精大公建立在此…"
                },
                {
                    "id": "634150204",
                    "speaker": "奥克萨娜",
                    "text": "(test)台词文本"
                },
                {
                    "id": "634150205",
                    "speaker": "奥克萨娜",
                    "text": "虽然从那以后已经过去了好几个千年，大公之位上的雪精也几经更迭…"
                },
                {
                    "id": "634150206",
                    "speaker": "奥克萨娜",
                    "text": "不过由于我们的辛勤维护，这座公馆还保持着和初建时差不多的样貌呢！"
                }
            ]
        },
        {
            "talkId": "6341503",
            "initDialog": "634150301",
            "dialogues": [
                {
                    "id": "634150301",
                    "speaker": "Player",
                    "text": "没什么需要。"
                }
            ]
        }
    ]
}