{
    "groupId": "4465",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "萨嘉尔": 17
    },
    "talks": [
        {
            "talkId": "6446501",
            "initDialog": "644650101",
            "dialogues": [
                {
                    "id": "644650101",
                    "speaker": "萨嘉尔",
                    "text": "接下来我还有巡查任务，有什么事，简单点说。"
                }
            ]
        },
        {
            "talkId": "6446502",
            "initDialog": "644650201",
            "dialogues": [
                {
                    "id": "644650201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "644650202",
                    "speaker": "萨嘉尔",
                    "text": "我是拜达港的总务官，你可以叫我萨嘉尔，或者萨嘉尔大姐头，随你的便。"
                },
                {
                    "id": "644650203",
                    "speaker": "萨嘉尔",
                    "text": "我不是那种强行要求尊称的人，人应该依靠自己实际做的事情来赢得尊敬。"
                }
            ]
        },
        {
            "talkId": "6446503",
            "initDialog": "644650301",
            "dialogues": [
                {
                    "id": "644650301",
                    "speaker": "Player",
                    "text": "关于拜达港…"
                },
                {
                    "id": "644650302",
                    "speaker": "萨嘉尔",
                    "text": "拜达港虽说各方势力纷杂，但治安还算良好，毕竟我的职责就是让每个人都安分守己。"
                },
                {
                    "id": "644650303",
                    "speaker": "萨嘉尔",
                    "text": "你可以放心，一般的走私犯都不敢在这里乱来。"
                }
            ]
        },
        {
            "talkId": "6446504",
            "initDialog": "644650401",
            "dialogues": [
                {
                    "id": "644650401",
                    "speaker": "Player",
                    "text": "其实没什么事。"
                },
                {
                    "id": "644650402",
                    "speaker": "萨嘉尔",
                    "text": "嗯，没什么事就是最好的事，再见。"
                }
            ]
        },
        {
            "talkId": "6446505",
            "initDialog": "644650501",
            "dialogues": [
                {
                    "id": "644650501",
                    "speaker": "Player",
                    "text": "好厉害。"
                },
                {
                    "id": "644650502",
                    "speaker": "萨嘉尔",
                    "text": "分内之事而已。有些人对我的出身不够信任，而我最讨厌质疑的声音。"
                },
                {
                    "id": "644650503",
                    "speaker": "萨嘉尔",
                    "text": "哦，忘了说，我从前是镀金旅团的佣兵。后来嘛！接受了教令院的雇佣，成了这里的总务官。"
                },
                {
                    "id": "644650504",
                    "speaker": "萨嘉尔",
                    "text": "做佣兵和做总务官没什么区别。「拿钱」，「办事」，再加一条「不好惹」，就够了。"
                },
                {
                    "id": "644650505",
                    "speaker": "萨嘉尔",
                    "text": "看你的表情，你也是这样认为的吧？"
                }
            ]
        },
        {
            "talkId": "6446506",
            "initDialog": "644650601",
            "dialogues": [
                {
                    "id": "644650601",
                    "speaker": "Player",
                    "text": "不一般的走私犯呢？"
                },
                {
                    "id": "644650602",
                    "speaker": "萨嘉尔",
                    "text": "如果是说本地的镀金旅团，从前我在那里干过一段时间，相当了解他们的手段。"
                },
                {
                    "id": "644650603",
                    "speaker": "萨嘉尔",
                    "text": "至于从璃月和枫丹来的走私犯——"
                },
                {
                    "id": "644650604",
                    "speaker": "萨嘉尔",
                    "text": "哼！在他们有什么动向之前，我已经收到密信，了解得清清楚楚了。"
                }
            ]
        },
        {
            "talkId": "6446507",
            "initDialog": "644650701",
            "dialogues": [
                {
                    "id": "644650701",
                    "speaker": "Player",
                    "text": "呃…"
                },
                {
                    "id": "644650702",
                    "speaker": "萨嘉尔",
                    "text": "闲聊就到这里，我要继续执勤了。"
                }
            ]
        },
        {
            "talkId": "6446508",
            "initDialog": "644650801",
            "dialogues": [
                {
                    "id": "644650801",
                    "speaker": "Player",
                    "text": "密信？"
                },
                {
                    "id": "644650802",
                    "speaker": "萨嘉尔",
                    "text": "没办法，拜达港的外国人太多了，不得不采用一些必要的外交手段。"
                },
                {
                    "id": "644650803",
                    "speaker": "萨嘉尔",
                    "text": "柔灯港和遗珑埠都有我的「熟人」，用情报换情报，也算划得来。"
                },
                {
                    "id": "644650804",
                    "speaker": "萨嘉尔",
                    "text": "唉，本来是为了轻松才来到这个小地方，结果没想到，该做的事一点也不比奥摩斯港少…"
                }
            ]
        }
    ]
}