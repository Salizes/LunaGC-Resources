{
    "groupId": "4035",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "法尔扎妮": 6
    },
    "talks": [
        {
            "talkId": "6403501",
            "initDialog": "640350101",
            "dialogues": [
                {
                    "id": "640350101",
                    "speaker": "法尔扎妮",
                    "text": "你好，有事找我吗？请麻烦话说快一点，我在一个地方站久了会有点头晕…"
                }
            ]
        },
        {
            "talkId": "6403502",
            "initDialog": "640350201",
            "dialogues": [
                {
                    "id": "640350201",
                    "speaker": "Player",
                    "text": "需要送你去医院吗？"
                },
                {
                    "id": "640350202",
                    "speaker": "法尔扎妮",
                    "text": "啊，不是你想的那样，我只是有些不适应岸上的生活。"
                },
                {
                    "id": "640350203",
                    "speaker": "法尔扎妮",
                    "text": "我是武装商船公司的老板，曾经在璃月的南十字船队做过僚舰的船长，跟着赚了不少钱。"
                },
                {
                    "id": "640350204",
                    "speaker": "法尔扎妮",
                    "text": "后来有了自己的商船公司后，就不再自己驾船远航冒险了。"
                },
                {
                    "id": "640350205",
                    "speaker": "法尔扎妮",
                    "text": "不过可能因为在海上待久了，很难适应平稳的大地，要来回走走才不会头晕…"
                }
            ]
        },
        {
            "talkId": "6403503",
            "initDialog": "640350301",
            "dialogues": [
                {
                    "id": "640350301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "640350302",
                    "speaker": "法尔扎妮",
                    "text": "那我接着散步了。"
                }
            ]
        }
    ]
}