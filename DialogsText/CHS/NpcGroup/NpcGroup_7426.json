{
    "groupId": "7426",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "斯米尔诺夫": 6
    },
    "talks": [
        {
            "talkId": "6742601",
            "initDialog": "674260101",
            "dialogues": [
                {
                    "id": "674260101",
                    "speaker": "斯米尔诺夫",
                    "text": "您好，尊贵的客人，调酒师斯米尔诺夫为您服务，怎么样，有什么需要的吗？"
                }
            ]
        },
        {
            "talkId": "6742602",
            "initDialog": "674260201",
            "dialogues": [
                {
                    "id": "674260201",
                    "speaker": "Player",
                    "text": "有什么推荐吗？"
                },
                {
                    "id": "674260202",
                    "speaker": "斯米尔诺夫",
                    "text": "牛奶，或者日落果，或者冰醋栗的果酱…嗯？哦，我是说，这些都很适合搭配火水来喝。"
                },
                {
                    "id": "674260203",
                    "speaker": "斯米尔诺夫",
                    "text": "而最推荐的，当然是火水…是从新基捷边上的酿酒厂运来的，绝对的正品。"
                }
            ]
        },
        {
            "talkId": "6742603",
            "initDialog": "674260301",
            "dialogues": [
                {
                    "id": "674260301",
                    "speaker": "Player",
                    "text": "兽爪也能调酒吗？"
                },
                {
                    "id": "674260302",
                    "speaker": "斯米尔诺夫",
                    "text": "常有人类客人这样好奇…当然了，我们的手指没有像人类那样纤细，但是我保证，它们比你想象中要灵活。"
                },
                {
                    "id": "674260303",
                    "speaker": "斯米尔诺夫",
                    "text": "更何况，我们还有肉垫呢，这能保证酒瓶躺在掌心里…就像婴儿回到母亲怀抱那样稳当。"
                }
            ]
        },
        {
            "talkId": "6742604",
            "initDialog": "674260401",
            "dialogues": [
                {
                    "id": "674260401",
                    "speaker": "Player",
                    "text": "不，暂时没有什么需要的。"
                },
                {
                    "id": "674260402",
                    "speaker": "斯米尔诺夫",
                    "text": "好的，客人，如果想要喝上几杯，记得来找我哦。"
                }
            ]
        }
    ]
}