{
    "groupId": "9371",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "莱欧斯利": 9
    },
    "talks": [
        {
            "talkId": "6937101",
            "initDialog": "693710101",
            "dialogues": [
                {
                    "id": "693710101",
                    "speaker": "莱欧斯利",
                    "text": "看了这里的环境，我在想是否应该将梅洛彼得堡的图书室翻新扩大一些。"
                },
                {
                    "id": "693710102",
                    "speaker": "莱欧斯利",
                    "text": "不过一想到那里面多半是无人问津的普法读物和有关机械原理的基础课本…还是算了吧。"
                },
                {
                    "id": "693710103",
                    "speaker": "莱欧斯利",
                    "text": "你问小说？那确实更受欢迎一些，所以它们才很难在图书室里找到。"
                }
            ]
        },
        {
            "talkId": "6937102",
            "initDialog": "693710201",
            "dialogues": [
                {
                    "id": "693710201",
                    "speaker": "莱欧斯利",
                    "text": "按照经验，越到最后的敌人越难对付。"
                },
                {
                    "id": "693710202",
                    "speaker": "莱欧斯利",
                    "text": "无论是否会遇到更强大的敌人，光是抵达深处就已经耗费不少精力了。"
                },
                {
                    "id": "693710203",
                    "speaker": "莱欧斯利",
                    "text": "所以，一定要做好提前准备。"
                }
            ]
        },
        {
            "talkId": "6937103",
            "initDialog": "693710301",
            "dialogues": [
                {
                    "id": "693710301",
                    "speaker": "莱欧斯利",
                    "text": "看童话是个不错的消遣。"
                },
                {
                    "id": "693710302",
                    "speaker": "莱欧斯利",
                    "text": "措辞简洁，又具备童趣和浪漫，很适合放空大脑阅读。"
                },
                {
                    "id": "693710303",
                    "speaker": "莱欧斯利",
                    "text": "只要不去多想「人的想象无法脱离现实」就行了。"
                }
            ]
        }
    ]
}