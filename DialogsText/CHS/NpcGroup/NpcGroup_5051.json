{
    "groupId": "5051",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "于贝尔": 7
    },
    "talks": [
        {
            "talkId": "6505101",
            "initDialog": "650510101",
            "dialogues": [
                {
                    "id": "650510101",
                    "speaker": "于贝尔",
                    "text": "您好，欢迎来到文字的海洋！"
                }
            ]
        },
        {
            "talkId": "6505102",
            "initDialog": "650510201",
            "dialogues": [
                {
                    "id": "650510201",
                    "speaker": "Player",
                    "text": "看看书。"
                },
                {
                    "id": "650510202",
                    "speaker": "于贝尔",
                    "text": "请慢慢挑选，我个人推荐悬疑小说哦！"
                }
            ]
        },
        {
            "talkId": "6505103",
            "initDialog": "650510301",
            "dialogues": [
                {
                    "id": "650510301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650510302",
                    "speaker": "于贝尔",
                    "text": "您好，我暂时是这个小小书报摊的摊主。"
                },
                {
                    "id": "650510303",
                    "speaker": "于贝尔",
                    "text": "说「暂时」，是因为我的梦想是加入蒸汽鸟报社！"
                },
                {
                    "id": "650510304",
                    "speaker": "于贝尔",
                    "text": "我每时每刻都在努力，琢磨行文，积累修辞，不断学习语言的艺术！"
                },
                {
                    "id": "650510305",
                    "speaker": "于贝尔",
                    "text": "有朝一日，我要亲自报道我的所见所闻，让我的斐然文采流淌在这头版之上！"
                }
            ]
        },
        {
            "talkId": "6505105",
            "initDialog": "650510501",
            "dialogues": [
                {
                    "id": "650510501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650510502",
                    "speaker": "于贝尔",
                    "text": "书本杂志常看常新，欢迎再来！"
                }
            ]
        }
    ]
}