{
    "groupId": "30967",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 2,
        "安柏": 6,
        "派蒙": 2,
        "芭芭拉": 3
    },
    "talks": [
        {
            "talkId": "4023157",
            "initDialog": "402315701",
            "dialogues": [
                {
                    "id": "402315701",
                    "speaker": "派蒙",
                    "text": "蒙德人好像没有在这里养林猪的习惯吧？"
                },
                {
                    "id": "402315702",
                    "speaker": "安柏",
                    "text": "找到了，芭芭拉，在这里！"
                },
                {
                    "id": "402315703",
                    "speaker": "芭芭拉",
                    "text": "来了来了，哎，怎么会变成这样？"
                },
                {
                    "id": "402315704",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "402315705",
                    "speaker": "安柏",
                    "text": "听我说，荣誉骑士，我和芭芭拉本来想在这里面的「猎鹿人」吃点东西。"
                },
                {
                    "id": "402315706",
                    "speaker": "安柏",
                    "text": "结果没想到，甜甜花酿鸡和蜜酱胡萝卜煎肉都活过来了！"
                },
                {
                    "id": "402315707",
                    "speaker": "派蒙",
                    "text": "活、活过来了？"
                },
                {
                    "id": "402315708",
                    "speaker": "Player",
                    "text": "所以这是蜜酱胡萝卜煎肉…？"
                },
                {
                    "id": "402315709",
                    "speaker": "芭芭拉",
                    "text": "没错，甜甜花酿鸡我已经抓到了。"
                },
                {
                    "id": "402315710",
                    "speaker": "安柏",
                    "text": "先抓回去，然后我们一起吃吧！"
                },
                {
                    "id": "402315711",
                    "speaker": "安柏",
                    "text": "欸，等等，不对！"
                },
                {
                    "id": "402315712",
                    "speaker": "芭芭拉",
                    "text": "怎么了？"
                },
                {
                    "id": "402315713",
                    "speaker": "安柏",
                    "text": "有更多的食物变成鸽子和林猪逃走了！我们的午餐！"
                }
            ]
        }
    ]
}