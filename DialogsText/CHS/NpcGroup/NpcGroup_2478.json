{
    "groupId": "2478",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "百疏": 15
    },
    "talks": [
        {
            "talkId": "6247801",
            "initDialog": "624780101",
            "dialogues": [
                {
                    "id": "624780101",
                    "speaker": "百疏",
                    "text": "祝来来往往的朋友们身体健康，生意兴隆，事业一帆风顺，早日功成名就，金玉满堂！"
                }
            ]
        },
        {
            "talkId": "6247802",
            "initDialog": "624780201",
            "dialogues": [
                {
                    "id": "624780201",
                    "speaker": "Player",
                    "text": "好雅兴！你也发财！"
                },
                {
                    "id": "624780202",
                    "speaker": "百疏",
                    "text": "客官有礼了！"
                },
                {
                    "id": "624780203",
                    "speaker": "百疏",
                    "text": "看您仪表堂堂…显然也是一位贵人，说不定早就家财万贯了！"
                },
                {
                    "id": "624780204",
                    "speaker": "百疏",
                    "text": "若是日后要在遗珑埠发展，有什么需求，请尽管来找我，我定全力相助！"
                }
            ]
        },
        {
            "talkId": "6247803",
            "initDialog": "624780301",
            "dialogues": [
                {
                    "id": "624780301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624780302",
                    "speaker": "百疏",
                    "text": "在下百疏，是九略茶馆的老板。"
                },
                {
                    "id": "624780303",
                    "speaker": "百疏",
                    "text": "附近的几间客栈也是我名下的产业，客官在遗珑埠的吃住，都可以放心交给在下的伙计。"
                }
            ]
        },
        {
            "talkId": "6247804",
            "initDialog": "624780401",
            "dialogues": [
                {
                    "id": "624780401",
                    "speaker": "Player",
                    "text": "（点头后离去。）"
                },
                {
                    "id": "624780402",
                    "speaker": "百疏",
                    "text": "这位客官的气势…真是深不可测！期待下次与您再见！"
                }
            ]
        },
        {
            "talkId": "6247805",
            "initDialog": "624780501",
            "dialogues": [
                {
                    "id": "624780501",
                    "speaker": "Player",
                    "text": "那你生意做得挺大！"
                },
                {
                    "id": "624780502",
                    "speaker": "百疏",
                    "text": "过奖过奖，只是有幸搭上了产业升级的顺风船。"
                },
                {
                    "id": "624780503",
                    "speaker": "百疏",
                    "text": "从前，我不过是个普普通通的茶农，种出的茶叶平平无奇。"
                },
                {
                    "id": "624780504",
                    "speaker": "百疏",
                    "text": "多亏了九贯大师的启发，我的财运才得以大变——"
                },
                {
                    "id": "624780505",
                    "speaker": "百疏",
                    "text": "沉玉谷的主力制茶设备从旧式茶釜换成机器时，我及时跟进，抓住较早入场的优势，积累了一笔资金。"
                },
                {
                    "id": "624780506",
                    "speaker": "百疏",
                    "text": "凭借这笔资金，我做起了茶馆的生意，很快就扩大经营规模，增设了饭馆和客栈。"
                },
                {
                    "id": "624780507",
                    "speaker": "百疏",
                    "text": "外国客人在我家的茶馆、饭馆和客栈消费后，多多少少会买些茶叶回去试试，或是当作礼品。"
                },
                {
                    "id": "624780508",
                    "speaker": "百疏",
                    "text": "既然无法成为优秀的茶叶种植者，就为茶叶种植者们提供经济和宣传上的支持…"
                },
                {
                    "id": "624780509",
                    "speaker": "百疏",
                    "text": "现在我对自己的个人事业相当满意，接下来的愿望就是像九贯大师那样，帮助更多生意人！"
                }
            ]
        }
    ]
}