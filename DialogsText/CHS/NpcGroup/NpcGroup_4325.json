    "talks": [
        {
            "talkId": "6432501",
            "initDialog": "643250101",
            "dialogues": [
                {
                    "id": "643250101",
                    "speaker": "素达蓓",
                    "text": "长大以后，素达蓓也要变成祭司大姐姐那样的大姐姐！又聪明，又漂亮，又厉害！"
                }
            ]
        },
        {
            "talkId": "6432502",
            "initDialog": "643250201",
            "dialogues": [
                {
                    "id": "643250201",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643250202",
                    "speaker": "素达蓓",
                    "text": "拉娜姐姐也是厉害又漂亮的大姐姐。素达蓓看过的故事里，最后快乐地生活在一起的人，都得一样聪明又厉害…"
                },
                {
                    "id": "643250203",
                    "speaker": "素达蓓",
                    "text": "所以为了能够娶拉娜姐姐，素达蓓也要变成和拉娜姐姐一样厉害的大姐姐！"
                }
            ]
        },
        {
            "talkId": "6432503",
            "initDialog": "643250301",
            "dialogues": [
                {
                    "id": "643250301",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "643250302",
                    "speaker": "素达蓓",
                    "text": "对不起，素达蓓不能说…可是素达蓓有不能说的理由…"
                }
            ]
        },
        {
            "talkId": "6432504",
            "initDialog": "643250401",
            "dialogues": [
                {
                    "id": "643250401",
                    "speaker": "Player",
                    "text": "关于两位姐姐的故事…"
                },
                {
                    "id": "643250402",
                    "speaker": "素达蓓",
                    "text": "两位姐姐的故事，因为有女王姐姐和祭司姐姐两个厉害的大姐姐才有趣！"
                },
                {
                    "id": "643250403",
                    "speaker": "素达蓓",
                    "text": "如果只有一个大姐姐的话，就太寂寞了…"
                }
            ]
        },
        {
            "talkId": "6432505",
            "initDialog": "643250501",
            "dialogues": [
                {
                    "id": "643250501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643250502",
                    "speaker": "素达蓓",
                    "text": "再见！下次见面，素达蓓就会再长大一点啦！"
                }
            ]
        },
        {
            "talkId": "6432506",
            "initDialog": "643250601",
