            "dialogues": [
                {
                    "id": "643251101",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643251102",
                    "speaker": "素达蓓",
                    "text": "拉娜姐姐说要去旅行，看上去要出去很久的样子…"
                },
                {
                    "id": "643251103",
                    "speaker": "素达蓓",
                    "text": "虽然素达蓓有点伤心，但是这也是素达蓓趁拉娜姐姐不在偷偷长大的好时机！"
                },
                {
                    "id": "643251104",
                    "speaker": "素达蓓",
                    "text": "等长大了以后，素达蓓就突然出现在拉娜姐姐身前，一定能吓她一大跳！"
                }
            ]
        },
        {
            "talkId": "6432512",
            "initDialog": "643251201",
            "dialogues": [
                {
                    "id": "643251201",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "643251202",
                    "speaker": "素达蓓",
                    "text": "不行，素达蓓不能告诉你们…不过，素达蓓也很久没有看到过了…"
                }
            ]
        },
        {
            "talkId": "6432513",
