            "dialogues": [
                {
                    "id": "643251301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "643251302",
                    "speaker": "素达蓓",
                    "text": "#嗯，那{M#哥哥}{F#姐姐}就去做自己的事吧，素达蓓也要去做自己的事了！"
                }
            ]
        },
        {
            "talkId": "7394901",
            "initDialog": "739490101",
            "dialogues": [
                {
                    "id": "739490101",
                    "speaker": "Player",
                    "text": "素达蓓一定能变成了不起的大姐姐。"
                },
                {
                    "id": "739490102",
                    "speaker": "素达蓓",
                    "text": "#谢谢{M#哥哥}{F#姐姐}！素达蓓很努力哦，为了快点长大，现在都在自己研究怎么做饭！"
                },
                {
                    "id": "739490103",
                    "speaker": "素达蓓",
                    "text": "#{M#哥哥}{F#姐姐}，尝尝我做的咖喱吧！爸爸和哥哥吃了以后，说很好吃！"
                },
                {
                    "id": "739490104",
                    "speaker": "素达蓓",
                    "text": "还说太好吃了要珍惜，所以要我以后少做一些。不过，素达蓓还是会继续做的！"
                }
            ]
        }
    ]
