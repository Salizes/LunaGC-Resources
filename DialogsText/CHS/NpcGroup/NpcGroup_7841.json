        {
            "talkId": "6784102",
            "initDialog": "678410201",
            "dialogues": [
                {
                    "id": "678410201",
                    "speaker": "Player",
                    "text": "是在等主人吗？"
                },
                {
                    "id": "678410202",
                    "speaker": "「白痴」",
                    "text": "（小狗立刻非常热情快活地摇起了尾巴。虽然看上去有些笨笨的，但它似乎很喜欢你。）"
                },
                {
                    "id": "678410203",
                    "speaker": "「白痴」",
                    "text": "呜汪…呜汪！"
                }
            ]
        },
        {
            "talkId": "6784103",
            "initDialog": "678410301",
            "dialogues": [
                {
                    "id": "678410301",
                    "speaker": "Player",
                    "text": "冷吗？"
                },
                {
                    "id": "678410302",
                    "speaker": "「白痴」",
                    "text": "（小狗非常顺从地任由你摸了摸它的毛皮。虽然看上去有些笨笨的，但它似乎很喜欢你。）"
                },
                {
                    "id": "678410303",
                    "speaker": "「白痴」",
                    "text": "呜汪…呜汪！"
                }
            ]
        },
        {
            "talkId": "6784104",
            "initDialog": "678410401",
            "dialogues": [
                {
                    "id": "678410401",
                    "speaker": "Player",
                    "text": "再见啦。"
                },
                {
