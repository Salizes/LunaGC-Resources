{
    "groupId": "1769",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "狄米特列夫": 7
    },
    "talks": [
        {
            "talkId": "6176901",
            "initDialog": "617690101",
            "dialogues": [
                {
                    "id": "617690101",
                    "speaker": "狄米特列夫",
                    "text": "马上…他要是来了，我就得救了。"
                }
            ]
        },
        {
            "talkId": "6176902",
            "initDialog": "617690201",
            "dialogues": [
                {
                    "id": "617690201",
                    "speaker": "Player",
                    "text": "谁？"
                },
                {
                    "id": "617690202",
                    "speaker": "狄米特列夫",
                    "text": "唉，我在等埃斯特拉冈。他说要来我这取货，可是到现在都没有来…已经不知道迟到多久了。"
                },
                {
                    "id": "617690203",
                    "speaker": "狄米特列夫",
                    "text": "他要是不来，我就只能在这里等他。没有办法，只能如此。"
                }
            ]
        },
        {
            "talkId": "6176903",
            "initDialog": "617690301",
            "dialogues": [
                {
                    "id": "617690301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617690302",
                    "speaker": "狄米特列夫",
                    "text": "再见…他会来的，他会来的。"
                }
            ]
        },
        {
            "talkId": "6176904",
            "initDialog": "617690401",
            "dialogues": [
                {
                    "id": "617690401",
                    "speaker": "Player",
                    "text": "他是你这批货的买家吗？"
                },
                {
                    "id": "617690402",
                    "speaker": "狄米特列夫",
                    "text": "对，我们约定在这个地方见面的。可是他一直不见踪影。我也不敢抛下货物去找他，只得在此等待。"
                },
                {
                    "id": "617690403",
                    "speaker": "狄米特列夫",
                    "text": "我在这里日复一日地等待他，他要是来了，我就得救啦。"
                },
                {
                    "id": "617690404",
                    "speaker": "狄米特列夫",
                    "text": "我简直等得想要上吊了。"
                }
            ]
        }
    ]
}