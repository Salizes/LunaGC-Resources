            "dialogues": [
                {
                    "id": "642230101",
                    "speaker": "法莎",
                    "text": "如果真的有兰那罗的话，他们也会喜欢吃甜甜花吗？唔…如果能见到就好了。"
                }
            ]
        },
        {
            "talkId": "6422302",
            "initDialog": "642230201",
            "dialogues": [
                {
                    "id": "642230201",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "642230202",
                    "speaker": "法莎",
                    "text": "兰那库拉和兰伽卢…对吧，我记得你们提过兰那罗的名字。"
                },
                {
                    "id": "642230203",
                    "speaker": "法莎",
                    "text": "虽然还没能见到他们…不过你说，如果我在这儿唱歌，他们会听到吗？他们会喜欢吗？"
                }
            ]
        },
        {
            "talkId": "6422303",
            "initDialog": "642230301",
            "dialogues": [
                {
                    "id": "642230301",
                    "speaker": "Player",
                    "text": "要照顾好自己。"
                },
                {
                    "id": "642230302",
                    "speaker": "法莎",
                    "text": "我不会有事的，你们也要多保重。"
                }
            ]
        }
    ]
