{
    "groupId": "9105",
    "total_dialogue_lines": 85,
    "speaker_counts": {
        "Player": 25,
        "欧洛伦": 60
    },
    "talks": [
        {
            "talkId": "6910501",
            "initDialog": "691050101",
            "dialogues": [
                {
                    "id": "691050101",
                    "speaker": "欧洛伦",
                    "text": "你来了。"
                },
                {
                    "id": "691050102",
                    "speaker": "欧洛伦",
                    "text": "这里的时间流逝跟外面一样吗？我应该说早上好还是晚上好？"
                }
            ]
        },
        {
            "talkId": "6910502",
            "initDialog": "691050201",
            "dialogues": [
                {
                    "id": "691050201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691050202",
                    "speaker": "欧洛伦",
                    "text": "当然，放心吧。"
                },
                {
                    "id": "691050203",
                    "speaker": "欧洛伦",
                    "text": "我的适应能力很强，无论是住在壶、水杯、酒桶还是别的什么容器里，我都能找到办法的。"
                },
                {
                    "id": "691050204",
                    "speaker": "Player",
                    "text": "真的吗？为你高兴。"
                },
                {
                    "id": "691050205",
                    "speaker": "欧洛伦",
                    "text": "谢谢，我也很高兴。"
                },
                {
                    "id": "691050206",
                    "speaker": "欧洛伦",
                    "text": "这里很舒适，布置也很特别，我找不到不喜欢的理由。"
                },
                {
                    "id": "691050207",
                    "speaker": "Player",
                    "text": "过奖了，只是随便弄弄。"
                },
                {
                    "id": "691050208",
                    "speaker": "欧洛伦",
                    "text": "挺好的，我觉得「随便」是种很棒的人生态度。"
                },
                {
                    "id": "691050209",
                    "speaker": "欧洛伦",
                    "text": "能有这种心态的人，心中没什么放不下的东西，也就不会有什么越不过去的坎坷。"
                },
                {
                    "id": "691050210",
                    "speaker": "欧洛伦",
                    "text": "而且，既然是家里，当然是以主人的生活舒适为最优先。"
                },
                {
                    "id": "691050211",
                    "speaker": "欧洛伦",
                    "text": "能四仰八叉，随随便便生活的地方，自然就是最好的家。我家也是这样的，东西摆放比较随意。"
                },
                {
                    "id": "691050212",
                    "speaker": "Player",
                    "text": "那也请你在这里「随便」生活吧。"
                },
                {
                    "id": "691050213",
                    "speaker": "欧洛伦",
                    "text": "嗯，我会的，而且已经在了。"
                }
            ]
        },
        {
            "talkId": "6910503",
            "initDialog": "691050301",
            "dialogues": [
                {
                    "id": "691050301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691050302",
                    "speaker": "欧洛伦",
                    "text": "你想吗？我可以陪你。"
                },
                {
                    "id": "691050303",
                    "speaker": "欧洛伦",
                    "text": "不过让我挑话题的话，可选范围会很窄。"
                },
                {
                    "id": "691050304",
                    "speaker": "Player",
                    "text": "比如种菜？"
                },
                {
                    "id": "691050305",
                    "speaker": "欧洛伦",
                    "text": "对。"
                },
                {
                    "id": "691050306",
                    "speaker": "欧洛伦",
                    "text": "你已经开始熟悉我了，这感觉真奇妙。"
                },
                {
                    "id": "691050307",
                    "speaker": "Player",
                    "text": "会让你觉得「越界」吗？"
                },
                {
                    "id": "691050308",
                    "speaker": "欧洛伦",
                    "text": "嗯？当然不。"
                },
                {
                    "id": "691050309",
                    "speaker": "欧洛伦",
                    "text": "你像是那种在安全范围内主动亲近人的野生动物，没人会不欢迎的。"
                },
                {
                    "id": "691050310",
                    "speaker": "欧洛伦",
                    "text": "…抱歉，把你比作小动物，我并没有想要冒犯的意思。"
                },
                {
                    "id": "691050311",
                    "speaker": "欧洛伦",
                    "text": "我只是想说，你身边的氛围毛茸茸的，会让人不由自主放下戒备。"
                },
                {
                    "id": "691050312",
                    "speaker": "欧洛伦",
                    "text": "当然我也能感觉到，你的灵魂比外表看上去要成熟很多。"
                },
                {
                    "id": "691050313",
                    "speaker": "欧洛伦",
                    "text": "年轻的表象下包裹着丰富的经历与经验。比喻成水果，就是皮薄的美食…"
                },
                {
                    "id": "691050314",
                    "speaker": "欧洛伦",
                    "text": "有点说不明白了，但请放心，我觉得非常好，大家都会喜欢这样的人。",
                    "choices": [
                        {
                            "id": "691050315",
                            "text": "第一次听人这样说。",
                            "response": [
                                {
                                    "id": "691050316",
                                    "speaker": "欧洛伦",
                                    "text": "会很奇怪吗？"
                                },
                                {
                                    "id": "691050317",
                                    "speaker": "欧洛伦",
                                    "text": "不好意思啊，我是怪人。"
                                },
                                {
                                    "id": "691050318",
                                    "speaker": "欧洛伦",
                                    "text": "不过看起来你并没有感到不舒服，嗯，我会保持这样和你相处。"
                                }
                            ]
                        },
                        {
                            "id": "691050319",
                            "text": "听起来还挺不错的。",
                            "response": [
                                {
                                    "id": "691050320",
                                    "speaker": "欧洛伦",
                                    "text": "是啊，比上了年纪却没能学到任何东西要好太多了。"
                                },
                                {
                                    "id": "691050321",
                                    "speaker": "欧洛伦",
                                    "text": "…希望我以后不要变成那样的人。"
                                },
                                {
                                    "id": "691050322",
                                    "speaker": "欧洛伦",
                                    "text": "怎么说呢…至少我很会种菜、打猎，不会饿肚子，对吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910504",
            "initDialog": "691050401",
            "dialogues": [
                {
                    "id": "691050401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691050402",
                    "speaker": "欧洛伦",
                    "text": "暂时没想到什么。有推荐吗？"
                },
                {
                    "id": "691050403",
                    "speaker": "Player",
                    "text": "比如…安静的事情？"
                },
                {
                    "id": "691050404",
                    "speaker": "欧洛伦",
                    "text": "哦…那，想试试「燃素刻录」吗？"
                },
                {
                    "id": "691050405",
                    "speaker": "欧洛伦",
                    "text": "它只有名字听上去很严肃，简单来说，就是用颜料绘制花纹，然后使用燃素或者元素力激活，从而产生不同的力量。"
                },
                {
                    "id": "691050406",
                    "speaker": "欧洛伦",
                    "text": "或者更简单一些，如果不追求特定效果，我们可以只把它当成一次简单的涂鸦绘画，剩下的顺其自然。"
                },
                {
                    "id": "691050407",
                    "speaker": "欧洛伦",
                    "text": "比如画一个派蒙在手背上，可能过一会儿你就会感到饿了。"
                },
                {
                    "id": "691050408",
                    "speaker": "Player",
                    "text": "像是会发生的事情。"
                },
                {
                    "id": "691050409",
                    "speaker": "欧洛伦",
                    "text": "嗯。图案的意义很重要，有时，颜料的配方也很重要。"
                },
                {
                    "id": "691050410",
                    "speaker": "Player",
                    "text": "或者…有什么不安静的事情吗？"
                },
                {
                    "id": "691050411",
                    "speaker": "欧洛伦",
                    "text": "你是说运动之类的吗？"
                },
                {
                    "id": "691050412",
                    "speaker": "欧洛伦",
                    "text": "我们可以赛跑。"
                },
                {
                    "id": "691050413",
                    "speaker": "Player",
                    "text": "？",
                    "choices": [
                        {
                            "id": "691050414",
                            "text": "你说的赛跑是「比赛逃跑」吗？",
                            "response": [
                                {
                                    "id": "691050416",
                                    "speaker": "欧洛伦",
                                    "text": "不，永远不要低估自己。"
                                },
                                {
                                    "id": "691050417",
                                    "speaker": "欧洛伦",
                                    "text": "如果你没信心，我可以先教你怎么做涂鸦烟雾弹，这样我们就能公平竞争了。",
                                    "choices": [
                                        {
                                            "id": "691050418",
                                            "text": "我很愿意。",
                                            "response": [
                                                {
                                                    "id": "691050420",
                                                    "speaker": "欧洛伦",
                                                    "text": "噢…你说得对。"
                                                },
                                                {
                                                    "id": "691050421",
                                                    "speaker": "欧洛伦",
                                                    "text": "这里太舒适了，我完全忘了自己正在别人家里做客，实在不好意思。"
                                                },
                                                {
                                                    "id": "691050422",
                                                    "speaker": "欧洛伦",
                                                    "text": "那我们就只能干巴巴地赛跑了。也好吧，也是一种锻炼。"
                                                },
                                                {
                                                    "id": "691050423",
                                                    "speaker": "Player",
                                                    "text": "还有别的选项吗？"
                                                },
                                                {
                                                    "id": "691050424",
                                                    "speaker": "欧洛伦",
                                                    "text": "有，动静结合。"
                                                },
                                                {
                                                    "id": "691050425",
                                                    "speaker": "欧洛伦",
                                                    "text": "也就是一边赛跑一边涂鸦。",
                                                    "choices": [
                                                        {
                                                            "id": "691050426",
                                                            "text": "哈哈！",
                                                            "response": [
                                                                {
                                                                    "id": "691050429",
                                                                    "speaker": "欧洛伦",
                                                                    "text": "看你样子，应该是希望我在开玩笑。"
                                                                },
                                                                {
                                                                    "id": "691050430",
                                                                    "speaker": "欧洛伦",
                                                                    "text": "所以我应该是在开玩笑。"
                                                                },
                                                                {
                                                                    "id": "691050431",
                                                                    "speaker": "Player",
                                                                    "text": "谢谢，和你聊天很愉快。"
                                                                },
                                                                {
                                                                    "id": "691050432",
                                                                    "speaker": "欧洛伦",
                                                                    "text": "不用客气，我才是应该道谢的那个人。"
                                                                },
                                                                {
                                                                    "id": "691050433",
                                                                    "speaker": "欧洛伦",
                                                                    "text": "我不常到朋友家做客，所以，非常感谢你愿意邀请我。"
                                                                },
                                                                {
                                                                    "id": "691050434",
                                                                    "speaker": "Player",
                                                                    "text": "不客气，喜欢再来。"
                                                                },
                                                                {
                                                                    "id": "691050435",
                                                                    "speaker": "欧洛伦",
                                                                    "text": "嗯，我会的。下次，我会带家门口最大的萝卜来。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691050427",
                                                            "text": "…是开玩笑的对吧？",
                                                            "response": [
                                                                {
                                                                    "id": "691050428",
                                                                    "speaker": "欧洛伦",
                                                                    "text": "…对。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691050419",
                                            "text": "但会很难打扫。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691050415",
                            "text": "那我输定了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910505",
            "initDialog": "691050501",
            "dialogues": [
                {
                    "id": "691050501",
                    "speaker": "Player",
                    "text": "早啊，欧洛伦。"
                },
                {
                    "id": "691050502",
                    "speaker": "欧洛伦",
                    "text": "早上好。我一般不这么早起床，也就是说，我还没睡。"
                },
                {
                    "id": "691050503",
                    "speaker": "欧洛伦",
                    "text": "你去忙吧，我等下就去休息。"
                }
            ]
        },
        {
            "talkId": "6910506",
            "initDialog": "691050601",
            "dialogues": [
                {
                    "id": "691050601",
                    "speaker": "Player",
                    "text": "晚安，欧洛伦。"
                },
                {
                    "id": "691050602",
                    "speaker": "欧洛伦",
                    "text": "晚安，你要休息了吗？"
                },
                {
                    "id": "691050603",
                    "speaker": "欧洛伦",
                    "text": "真遗憾，我精神还不错。如果不是这里太安全，我可以发挥特长帮你望风的。"
                },
                {
                    "id": "691050604",
                    "speaker": "欧洛伦",
                    "text": "你说派蒙也会？那下次有机会的话，我跟派蒙一起望风。"
                }
            ]
        },
        {
            "talkId": "6910510",
            "initDialog": "691051001",
            "dialogues": [
                {
                    "id": "691051001",
                    "speaker": "欧洛伦",
                    "text": "看到这些摆设，感觉就像回到了小时候…"
                },
                {
                    "id": "691051002",
                    "speaker": "欧洛伦",
                    "text": "你看，这些很高的东西，我以前得费不少力气才能爬上去。"
                },
                {
                    "id": "691051003",
                    "speaker": "欧洛伦",
                    "text": "长高以后，低处的东西反而得弯腰才能看得清了…原来长大了就是长反了啊。"
                }
            ]
        },
        {
            "talkId": "6910511",
            "initDialog": "691051101",
            "dialogues": [
                {
                    "id": "691051101",
                    "speaker": "欧洛伦",
                    "text": "这些植物都长得很好，心情也不错。"
                },
                {
                    "id": "691051102",
                    "speaker": "欧洛伦",
                    "text": "你很会照顾朋友嘛。"
                },
                {
                    "id": "691051103",
                    "speaker": "欧洛伦",
                    "text": "当然，万一它们哪天不高兴了，可以叫我来谈心，我很乐意帮忙。"
                }
            ]
        }
    ]
}