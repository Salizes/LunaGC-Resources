{
    "groupId": "7122",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "诺米奥": 7
    },
    "talks": [
        {
            "talkId": "6712201",
            "initDialog": "671220101",
            "dialogues": [
                {
                    "id": "671220101",
                    "speaker": "诺米奥",
                    "text": "正常夜班都是领工钱睡大觉的工作才对吧！"
                }
            ]
        },
        {
            "talkId": "6712202",
            "initDialog": "671220201",
            "dialogues": [
                {
                    "id": "671220201",
                    "speaker": "Player",
                    "text": "夜班…是这样的吗？"
                },
                {
                    "id": "671220202",
                    "speaker": "诺米奥",
                    "text": "反正夜班比日班还忙的地方，我还没在别处见过呢！你说，为什么大家都在晚上运货呢？"
                },
                {
                    "id": "671220203",
                    "speaker": "诺米奥",
                    "text": "又不是什么见不得人的东西！就算是见不得人的东西好了，我们这儿又不是枫丹，又没有警备队，干嘛非要在晚上运嘛…"
                },
                {
                    "id": "671220204",
                    "speaker": "诺米奥",
                    "text": "唉，好不容易有机会邀请采若姑娘去「旗舰」喝一杯的…却不得不跑来上班！"
                }
            ]
        },
        {
            "talkId": "6712203",
            "initDialog": "671220301",
            "dialogues": [
                {
                    "id": "671220301",
                    "speaker": "Player",
                    "text": "不是很了解呢。"
                },
                {
                    "id": "671220302",
                    "speaker": "诺米奥",
                    "text": "希望你永远不会了解…不，不对！希望每一个人都给我好好了解！"
                }
            ]
        },
        {
            "talkId": "6712204",
            "initDialog": "671220401",
            "dialogues": [
                {
                    "id": "671220401",
                    "speaker": "Player",
                    "text": "白天也可以去嘛。"
                },
                {
                    "id": "671220402",
                    "speaker": "诺米奥",
                    "text": "约女孩子…？去「旗舰」？白天？"
                },
                {
                    "id": "671220403",
                    "speaker": "诺米奥",
                    "text": "你是怎么做到把这几个词串在一句话里说出来的啊？这已经不是分拣错乱，是整条传送带都阻塞了吧…"
                }
            ]
        }
    ]
}