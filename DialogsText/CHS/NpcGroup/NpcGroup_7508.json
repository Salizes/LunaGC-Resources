{
    "groupId": "7508",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "彼塞姆斯基": 12
    },
    "talks": [
        {
            "talkId": "6750801",
            "initDialog": "675080101",
            "dialogues": [
                {
                    "id": "675080101",
                    "speaker": "彼塞姆斯基",
                    "text": "如此朴实的激情，又怎么能不被称作美？"
                }
            ]
        },
        {
            "talkId": "6750802",
            "initDialog": "675080201",
            "dialogues": [
                {
                    "id": "675080201",
                    "speaker": "Player",
                    "text": "什么意思？"
                },
                {
                    "id": "675080202",
                    "speaker": "彼塞姆斯基",
                    "text": "我在回味昨晚的演出。"
                },
                {
                    "id": "675080203",
                    "speaker": "彼塞姆斯基",
                    "text": "您看，传统的至冬歌剧往往侧重于宏大的悲剧，用繁复的唱词填补情感的空白…"
                },
                {
                    "id": "675080204",
                    "speaker": "彼塞姆斯基",
                    "text": "但奥黛塔小姐与沃雅妮莎小姐的演出，则摒弃了那些冗余的表达——优雅！何等优雅！"
                },
                {
                    "id": "675080205",
                    "speaker": "彼塞姆斯基",
                    "text": "尤其是奥黛塔小姐的步法——与其说是「舞」，不如说是「武」。您明白吧？"
                }
            ]
        },
        {
            "talkId": "6750803",
            "initDialog": "675080301",
            "dialogues": [
                {
                    "id": "675080301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675080302",
                    "speaker": "彼塞姆斯基",
                    "text": "再会。希望有一天，你也能领略到这门艺术的严谨与美妙。"
                }
            ]
        },
        {
            "talkId": "6750804",
            "initDialog": "675080401",
            "dialogues": [
                {
                    "id": "675080401",
                    "speaker": "Player",
                    "text": "懂你意思。"
                },
                {
                    "id": "675080402",
                    "speaker": "彼塞姆斯基",
                    "text": "您很有品味，朋友！奥黛塔小姐的舞步总是有一种武技般的克制感。"
                },
                {
                    "id": "675080403",
                    "speaker": "彼塞姆斯基",
                    "text": "许多演员在表达激烈情感时，往往容易陷入无序的肢体宣泄——但她不同。"
                },
                {
                    "id": "675080404",
                    "speaker": "彼塞姆斯基",
                    "text": "有些评论家同行——恕我向您直言，他们什么都不明白——总是喜欢把她与她母亲相比，分析二人的相似之处…"
                },
                {
                    "id": "675080405",
                    "speaker": "彼塞姆斯基",
                    "text": "但从真正专业的角度来看，维奥莱塔的表演风格更偏向古典主义的绝对克制，而奥黛塔小姐…"
                },
                {
                    "id": "675080406",
                    "speaker": "彼塞姆斯基",
                    "text": "唉，算了，真正的艺术应当是用心去感受的！言语不能传达的，就应当保持沉默才对！"
                }
            ]
        },
        {
            "talkId": "6750805",
            "initDialog": "675080501",
            "dialogues": [
                {
                    "id": "675080501",
                    "speaker": "Player",
                    "text": "完全听不懂你在说什么。"
                },
                {
                    "id": "675080502",
                    "speaker": "彼塞姆斯基",
                    "text": "没关系，真正的艺术应当是用心去感受的。言语不能传达的，就应当保持沉默才对。"
                }
            ]
        }
    ]
}