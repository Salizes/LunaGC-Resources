{
    "groupId": "9052",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 21,
        "影": 42,
        "雷电将军": 8
    },
    "talks": [
        {
            "talkId": "6905201",
            "initDialog": "690520101",
            "dialogues": [
                {
                    "id": "690520101",
                    "speaker": "雷电将军",
                    "text": "……"
                },
                {
                    "id": "690520102",
                    "speaker": "雷电将军",
                    "text": "此身暂留此间，稍访浮世箱庭。"
                }
            ]
        },
        {
            "talkId": "6905202",
            "initDialog": "690520201",
            "dialogues": [
                {
                    "id": "690520201",
                    "speaker": "影",
                    "text": "#{NICKNAME}，是你。"
                },
                {
                    "id": "690520202",
                    "speaker": "影",
                    "text": "莫非…是专程来看望我的吗？"
                }
            ]
        },
        {
            "talkId": "6905203",
            "initDialog": "690520301",
            "dialogues": [
                {
                    "id": "690520301",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690520302",
                    "speaker": "影",
                    "text": "如果是与「一心净土」相提并论的话，这里热闹了很多。"
                },
                {
                    "id": "690520303",
                    "speaker": "Player",
                    "text": "会不适应吗？"
                },
                {
                    "id": "690520304",
                    "speaker": "影",
                    "text": "不会，不用担心。"
                },
                {
                    "id": "690520305",
                    "speaker": "影",
                    "text": "热闹仅仅是外在的，我的内心依旧保持平静。",
                    "choices": [
                        {
                            "id": "690520306",
                            "text": "这样就好。",
                            "response": [
                                {
                                    "id": "690520307",
                                    "speaker": "影",
                                    "text": "嗯，谢谢你的理解。"
                                },
                                {
                                    "id": "690520310",
                                    "speaker": "影",
                                    "text": "……"
                                },
                                {
                                    "id": "690520311",
                                    "speaker": "影",
                                    "text": "要再多待一会儿吗？"
                                },
                                {
                                    "id": "690520312",
                                    "speaker": "影",
                                    "text": "有你在旁边，即使相顾无言，心中也会变得安然。"
                                },
                                {
                                    "id": "690520313",
                                    "speaker": "影",
                                    "text": "我并不讨厌这样的变化。"
                                }
                            ]
                        },
                        {
                            "id": "690520308",
                            "text": "要不要试着「热闹」起来？",
                            "response": [
                                {
                                    "id": "690520309",
                                    "speaker": "影",
                                    "text": "听上去有违「永恒」的理念，我会再考虑一下的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905204",
            "initDialog": "690520401",
            "dialogues": [
                {
                    "id": "690520401",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690520402",
                    "speaker": "影",
                    "text": "好啊，我正好也有事情想询问你。"
                },
                {
                    "id": "690520403",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "690520404",
                    "speaker": "影",
                    "text": "我想知道，你是怎么把甜点心做得那么好吃的？"
                },
                {
                    "id": "690520405",
                    "speaker": "影",
                    "text": "咳咳…至少很符合我的口味。",
                    "choices": [
                        {
                            "id": "690520406",
                            "text": "最重要的是耐心。",
                            "response": [
                                {
                                    "id": "690520407",
                                    "speaker": "影",
                                    "text": "尝试的结果可能是失败，但却不会因为失败而放弃再度尝试。"
                                },
                                {
                                    "id": "690520408",
                                    "speaker": "影",
                                    "text": "在实践过程中通过微量调试，不断总结和积累经验。"
                                },
                                {
                                    "id": "690520409",
                                    "speaker": "影",
                                    "text": "…是这个意思吗？"
                                },
                                {
                                    "id": "690520415",
                                    "speaker": "Player",
                                    "text": "没错。"
                                },
                                {
                                    "id": "690520416",
                                    "speaker": "影",
                                    "text": "…嗯，我记下了。"
                                },
                                {
                                    "id": "690520417",
                                    "speaker": "影",
                                    "text": "既然已经得到了你的验证，那么下次对于将军人偶的优化，也按照这个方向尝试吧。",
                                    "choices": [
                                        {
                                            "id": "690520418",
                                            "text": "原来问这些的目的…",
                                            "response": [
                                                {
                                                    "id": "690520420",
                                                    "speaker": "影",
                                                    "text": "嗯？我都说了我不会做饭嘛…"
                                                },
                                                {
                                                    "id": "690520421",
                                                    "speaker": "影",
                                                    "text": "不过我问这些，跟你也不是完全没有关系…"
                                                },
                                                {
                                                    "id": "690520422",
                                                    "speaker": "影",
                                                    "text": "更厉害的将军…也就更能从不同的危机中保护你吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690520419",
                                            "text": "不是为了学做点心…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690520410",
                            "text": "最重要的是愿望。",
                            "response": [
                                {
                                    "id": "690520411",
                                    "speaker": "影",
                                    "text": "愿望？"
                                },
                                {
                                    "id": "690520412",
                                    "speaker": "影",
                                    "text": "没想到让甜点心变得更好吃…这居然也是一种愿望。"
                                },
                                {
                                    "id": "690520413",
                                    "speaker": "影",
                                    "text": "不…仔细想想的话，应该不止那么简单。"
                                },
                                {
                                    "id": "690520414",
                                    "speaker": "影",
                                    "text": "「愿望」同时也指的是，想要满足食客的那一份心意吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905205",
            "initDialog": "690520501",
            "dialogues": [
                {
                    "id": "690520501",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690520502",
                    "speaker": "影",
                    "text": "嗯，拔剑吧。",
                    "choices": [
                        {
                            "id": "690520503",
                            "text": "等等，现在吗？",
                            "response": [
                                {
                                    "id": "690520505",
                                    "speaker": "影",
                                    "text": "哼，那就等你准备好了再来。我的时间很多。"
                                },
                                {
                                    "id": "690520506",
                                    "speaker": "影",
                                    "text": "你的剑术是否有所生疏，我会用这一刀来确认。"
                                },
                                {
                                    "id": "690520507",
                                    "speaker": "Player",
                                    "text": "原来你是认真的？"
                                },
                                {
                                    "id": "690520508",
                                    "speaker": "影",
                                    "text": "那是当然。"
                                },
                                {
                                    "id": "690520509",
                                    "speaker": "影",
                                    "text": "刀剑相交之时，瞬间亦能化作永恒。我能借此感受你的内心。"
                                },
                                {
                                    "id": "690520510",
                                    "speaker": "影",
                                    "text": "这是比所有言语都简明、直接的方式。也是能让我确认自身存在的方式。",
                                    "choices": [
                                        {
                                            "id": "690520511",
                                            "text": "感觉哪里不太对劲…",
                                            "response": [
                                                {
                                                    "id": "690520513",
                                                    "speaker": "影",
                                                    "text": "欸？已经被你看出来了吗？我还以为我装得够像了。"
                                                },
                                                {
                                                    "id": "690520514",
                                                    "speaker": "影",
                                                    "text": "算了算了，我还是直说好了，我的确是想找你切磋来着。"
                                                },
                                                {
                                                    "id": "690520515",
                                                    "speaker": "影",
                                                    "text": "毕竟能接下我一刀的人也不多啦。而且有你陪练…会很开心。"
                                                },
                                                {
                                                    "id": "690520516",
                                                    "speaker": "影",
                                                    "text": "我怕你不愿意对我出手，才故意用了将军的样子。",
                                                    "choices": [
                                                        {
                                                            "id": "690520517",
                                                            "text": "其实不用绕弯子…",
                                                            "response": [
                                                                {
                                                                    "id": "690520519",
                                                                    "speaker": "影",
                                                                    "text": "没有直接反对，那就是答应了？"
                                                                },
                                                                {
                                                                    "id": "690520520",
                                                                    "speaker": "影",
                                                                    "text": "呵呵…要记得好好准备哦！我可是不会手下留情的。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690520518",
                                                            "text": "这个要求是有点奇怪…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690520512",
                                            "text": "是「影」吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690520504",
                            "text": "我完全没有心理准备…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905206",
            "initDialog": "690520601",
            "dialogues": [
                {
                    "id": "690520601",
                    "speaker": "Player",
                    "text": "早啊，影。"
                },
                {
                    "id": "690520602",
                    "speaker": "影",
                    "text": "#早上好，{NICKNAME}。"
                },
                {
                    "id": "690520603",
                    "speaker": "影",
                    "text": "仅仅像这样互相问候，就好像充满了动力…真是不可思议。"
                }
            ]
        },
        {
            "talkId": "6905207",
            "initDialog": "690520701",
            "dialogues": [
                {
                    "id": "690520701",
                    "speaker": "Player",
                    "text": "晚安，影。"
                },
                {
                    "id": "690520702",
                    "speaker": "影",
                    "text": "夜晚到了吗，那你便去休息吧。"
                },
                {
                    "id": "690520703",
                    "speaker": "影",
                    "text": "#晚安，{NICKNAME}。愿你的梦境平稳祥和。"
                }
            ]
        },
        {
            "talkId": "6905211",
            "initDialog": "690521101",
            "dialogues": [
                {
                    "id": "690521101",
                    "speaker": "雷电将军",
                    "text": "有些眼熟的神社。"
                },
                {
                    "id": "690521102",
                    "speaker": "雷电将军",
                    "text": "我这是在…触景生情吗？"
                },
                {
                    "id": "690521103",
                    "speaker": "雷电将军",
                    "text": "罢了，这种感觉并不坏。"
                }
            ]
        },
        {
            "talkId": "6905212",
            "initDialog": "690521201",
            "dialogues": [
                {
                    "id": "690521201",
                    "speaker": "雷电将军",
                    "text": "道场？…"
                },
                {
                    "id": "690521202",
                    "speaker": "雷电将军",
                    "text": "你在精进武艺？想必是「无想的一刀」促成了你的决意。"
                },
                {
                    "id": "690521203",
                    "speaker": "雷电将军",
                    "text": "追索极致之人，当赏。"
                }
            ]
        }
    ]
}