{
    "groupId": "7698",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "兹梅伊": 8
    },
    "talks": [
        {
            "talkId": "6769802",
            "initDialog": "676980201",
            "dialogues": [
                {
                    "id": "676980201",
                    "speaker": "兹梅伊",
                    "text": "嗯，就把这作为「高桌」的决定吧…"
                }
            ]
        },
        {
            "talkId": "6769803",
            "initDialog": "676980301",
            "dialogues": [
                {
                    "id": "676980301",
                    "speaker": "Player",
                    "text": "最近还好吗？"
                },
                {
                    "id": "676980302",
                    "speaker": "兹梅伊",
                    "text": "一切都很顺利，我们为瓦西里举办了葬礼，正在为「伊兹梅洛」准备一个新的主人。"
                },
                {
                    "id": "676980303",
                    "speaker": "兹梅伊",
                    "text": "我们都认为…瓦西里做了些错事，但是这并不是伊兹梅洛的错。"
                },
                {
                    "id": "676980304",
                    "speaker": "兹梅伊",
                    "text": "这个名字有其向未来传承的价值。"
                }
            ]
        },
        {
            "talkId": "6769804",
            "initDialog": "676980401",
            "dialogues": [
                {
                    "id": "676980401",
                    "speaker": "Player",
                    "text": "「高桌」怎么了？"
                },
                {
                    "id": "676980402",
                    "speaker": "兹梅伊",
                    "text": "没什么，我在起草我的第一份「议题」，我想要缓和矛盾。"
                },
                {
                    "id": "676980403",
                    "speaker": "兹梅伊",
                    "text": "我得想办法安抚「伊兹梅洛」剩下的人，同时又不能因此得罪这场冲突里「伊兹梅洛」伤害的那些人…"
                },
                {
                    "id": "676980404",
                    "speaker": "兹梅伊",
                    "text": "可不能把任何一方逼急啦…这场争端里，流血的人已经太多了。"
                }
            ]
        },
        {
            "talkId": "6769805",
            "initDialog": "676980501",
            "dialogues": [
                {
                    "id": "676980501",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "676980502",
                    "speaker": "兹梅伊",
                    "text": "#再见，{NICKNAME}，「卢契烬」永远的朋友。"
                }
            ]
        }
    ]
}