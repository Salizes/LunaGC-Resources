    "talks": [
        {
            "talkId": "6651301",
            "initDialog": "665130101",
            "dialogues": [
                {
                    "id": "665130101",
                    "speaker": "卡内",
                    "text": "嗯…这下订单就快完成了。"
                }
            ]
        },
        {
            "talkId": "6651302",
            "initDialog": "665130201",
            "dialogues": [
                {
                    "id": "665130201",
                    "speaker": "Player",
                    "text": "什么订单？"
                },
                {
                    "id": "665130202",
                    "speaker": "卡内",
                    "text": "就是一些纪念品订单啦，最近度假村开始试营业了，包括玩偶在内的很多纪念品都供不应求。"
                },
                {
                    "id": "665130203",
                    "speaker": "卡内",
                    "text": "但是托你的福，这次订单一定可以顺利完成。"
                }
            ]
        },
        {
            "talkId": "6651303",
            "initDialog": "665130301",
            "dialogues": [
                {
                    "id": "665130301",
                    "speaker": "Player",
                    "text": "这里是什么地方？"
                },
                {
                    "id": "665130302",
                    "speaker": "卡内",
                    "text": "这里是度假村的颜料工坊，负责给涂鸦提供颜料，还会给一些玩偶和纪念品上色。"
                }
            ]
        },
        {
            "talkId": "6651304",
            "initDialog": "665130401",
            "dialogues": [
                {
                    "id": "665130401",
                    "speaker": "Player",
                    "text": "你一个人忙得过来吗？"
                },
                {
                    "id": "665130402",
                    "speaker": "卡内",
                    "text": "我还有一个学徒和一些阿夏呢，阿夏很喜欢色彩，也很喜欢摆弄颜料。"
                },
                {
                    "id": "665130403",
                    "speaker": "卡内",
                    "text": "多亏了它们帮忙，这座工坊才能供应出度假村需要的颜料。"
                }
            ]
        },
        {
            "talkId": "6651308",
            "initDialog": "665130801",
            "dialogues": [
                {
                    "id": "665130801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "665130802",
                    "speaker": "卡内",
                    "text": "玩的愉快啊，客人。"
                }
            ]
        }
    ]
}