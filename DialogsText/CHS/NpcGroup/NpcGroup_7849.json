{
    "groupId": "7849",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 3,
        "叶尔莫洛夫": 10,
        "派蒙": 12
    },
    "talks": [
        {
            "talkId": "6784901",
            "initDialog": "678490101",
            "dialogues": [
                {
                    "id": "678490101",
                    "speaker": "叶尔莫洛夫",
                    "text": "哼。这样下去，就是女皇陛下来了也没办法。"
                }
            ]
        },
        {
            "talkId": "6784902",
            "initDialog": "678490201",
            "dialogues": [
                {
                    "id": "678490201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "678490202",
                    "speaker": "叶尔莫洛夫",
                    "text": "什么事？瞧你说的，什么事都没发生…那些老爷们想必就是这么认为的。"
                },
                {
                    "id": "678490203",
                    "speaker": "叶尔莫洛夫",
                    "text": "官老爷们——就算看到我们把日子过成了这样，也只会轻飘飘地说一句「特殊时期，大家一起努力克服困难」。"
                },
                {
                    "id": "678490204",
                    "speaker": "叶尔莫洛夫",
                    "text": "哼，说得容易。自从「严冬计划」开始，谁不是节衣缩食地过日子，我家餐厅生意眼瞧着越来越冷清…"
                },
                {
                    "id": "678490205",
                    "speaker": "叶尔莫洛夫",
                    "text": "如今，我们更是连晶矿都拿不到，别说做生意了，再这样下去，家里连做饭的火都生不起来。"
                },
                {
                    "id": "678490206",
                    "speaker": "叶尔莫洛夫",
                    "text": "不过，那些愚人众、那个联络官，还有镇长，他们家里肯定是不缺晶矿的。"
                },
                {
                    "id": "678490207",
                    "speaker": "叶尔莫洛夫",
                    "text": "我看呐，要是没了这些不作为的家伙，哼，说不定镇上的大伙儿还能多撑两天。"
                }
            ]
        },
        {
            "talkId": "6784903",
            "initDialog": "678490301",
            "dialogues": [
                {
                    "id": "678490301",
                    "speaker": "Player",
                    "text": "这些酒…"
                },
                {
                    "id": "678490302",
                    "speaker": "叶尔莫洛夫",
                    "text": "这是我家餐厅自己酿的酒。这段时间没什么客人，晶矿也越来越少…我索性关了门，把剩下的酒拿出来卖。"
                },
                {
                    "id": "678490303",
                    "speaker": "叶尔莫洛夫",
                    "text": "但再这样下去，怕是连酒都卖不出去了。"
                }
            ]
        },
        {
            "talkId": "6784904",
            "initDialog": "678490401",
            "dialogues": [
                {
                    "id": "678490401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678490402",
                    "speaker": "叶尔莫洛夫",
                    "text": "不送。"
                }
            ]
        },
