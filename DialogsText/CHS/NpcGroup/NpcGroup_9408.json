    },
    "talks": [
        {
            "talkId": "6940801",
            "initDialog": "694080101",
            "dialogues": [
                {
                    "id": "694080101",
                    "speaker": "兹白",
                    "text": "张弛有度，自是正理。"
                },
                {
                    "id": "694080102",
                    "speaker": "兹白",
                    "text": "等到休憩好之后，厘清眼前诸事，再细做打算。"
                },
                {
                    "id": "694080103",
                    "speaker": "兹白",
                    "text": "如此，才能算是胜战之策。"
                }
            ]
        },
        {
            "talkId": "6940802",
            "initDialog": "694080201",
            "dialogues": [
                {
                    "id": "694080201",
                    "speaker": "兹白",
                    "text": "此次冒险，你应该已经准备齐全，成竹在胸了吧。"
                },
                {
                    "id": "694080202",
                    "speaker": "兹白",
                    "text": "既然如此，那就勇往直前便是。"
                },
                {
                    "id": "694080203",
                    "speaker": "兹白",
                    "text": "若遇见险阻需我相助，尽可开口。"
                }
            ]
        },
        {
            "talkId": "6940803",
            "initDialog": "694080301",
            "dialogues": [
                {
                    "id": "694080301",
                    "speaker": "兹白",
                    "text": "这里的书籍也不少，而且大多数书都是异国的民俗童话…"
                },
                {
                    "id": "694080302",
                    "speaker": "兹白",
                    "text": "倒是有趣，容我先去取几本书读一读。"
                },
                {
                    "id": "694080303",
                    "speaker": "兹白",
                    "text": "要是读到了有趣的故事，还能再讲给学堂里的孩子们听。"
                }
            ]
        }
    ]
}