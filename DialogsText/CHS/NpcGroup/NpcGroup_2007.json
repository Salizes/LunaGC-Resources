{
    "groupId": "2007",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Player": 5,
        "一弦": 13,
        "一柱": 29
    },
    "talks": [
        {
            "talkId": "4003732",
            "initDialog": "400373201",
            "dialogues": [
                {
                    "id": "400373201",
                    "speaker": "一弦",
                    "text": "哥哥…我又想妈妈了…想和妈妈一起逛霄市…"
                },
                {
                    "id": "400373202",
                    "speaker": "一柱",
                    "text": "弦儿别哭，今年哥哥陪你好不好？"
                },
                {
                    "id": "400373203",
                    "speaker": "一柱",
                    "text": "我们一起去买玩具，看霄灯，赏烟花。走累了的话，我来背你。"
                },
                {
                    "id": "400373204",
                    "speaker": "一弦",
                    "text": "哥哥…呜…"
                },
                {
                    "id": "400373205",
                    "speaker": "一弦",
                    "text": "那今年…哥哥可以教我编霄灯吗？我想给妈妈编霄灯。"
                },
                {
                    "id": "400373206",
                    "speaker": "一柱",
                    "text": "当然可以。去年我们一起给妈妈做了霄灯，今年我来教你，保证你一个人就能做得又快又好。"
                },
                {
                    "id": "400373207",
                    "speaker": "一弦",
                    "text": "嗯！"
                },
                {
                    "id": "400373208",
                    "speaker": "一柱",
                    "text": "等妈妈看到霄灯，灵魂就会和大英雄们一起回来了。到时候我们要一起笑着迎接她。"
                },
                {
                    "id": "400373209",
                    "speaker": "一弦",
                    "text": "好！"
                }
            ]
        },
        {
            "talkId": "4003733",
            "initDialog": "400373301",
            "dialogues": [
                {
                    "id": "400373301",
                    "speaker": "一柱",
                    "text": "你好…你是找我吗？",
                    "choices": [
                        {
                            "id": "400373302",
                            "text": "你是？",
                            "response": [
                                {
                                    "id": "400373303",
                                    "speaker": "一柱",
                                    "text": "我叫一柱，你可能也见过我妹妹一弦。"
                                },
                                {
                                    "id": "400373304",
                                    "speaker": "一柱",
                                    "text": "我答应过她，今年要一起过海灯节，还要教她为妈妈做一盏霄灯。"
                                },
                                {
                                    "id": "400373305",
                                    "speaker": "一柱",
                                    "text": "我正在准备材料的时候，没想到长顺姐姐特意给我们拿了一些…"
                                },
                                {
                                    "id": "400373306",
                                    "speaker": "一柱",
                                    "text": "所以，我也给长顺姐姐做了一盏霄灯，希望她能喜欢。"
                                },
                                {
                                    "id": "400373307",
                                    "speaker": "一柱",
                                    "text": "最近我们兄妹受到了很多关照，真的很感谢大家。"
                                }
                            ]
                        },
                        {
                            "id": "400373308",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "400373309",
                                    "speaker": "一柱",
                                    "text": "再见…愿薪火相传，美德不灭。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6200701",
            "initDialog": "620180101",
            "dialogues": [
                {
                    "id": "620180101",
                    "speaker": "一柱",
                    "text": "弦儿乖，我们回家啦…"
                },
                {
                    "id": "620180102",
                    "speaker": "一弦",
                    "text": "我不要！我要找妈妈…！"
                },
                {
                    "id": "620180103",
                    "speaker": "一柱",
                    "text": "可是妈妈不会回来了…"
                },
                {
                    "id": "620180104",
                    "speaker": "一弦",
                    "text": "呜呜…为什么…是我们不够乖吗…？"
                },
                {
                    "id": "620180105",
                    "speaker": "一柱",
                    "text": "不是的…"
                },
                {
                    "id": "620180106",
                    "speaker": "一弦",
                    "text": "可是…可是…我明明看见黑衣服的姐姐把她送到这里了…呜呜…"
                },
                {
                    "id": "620180107",
                    "speaker": "一柱",
                    "text": "好了，其实…其实妈妈已经变成天上的星星了哦。"
                },
                {
                    "id": "620180108",
                    "speaker": "一弦",
                    "text": "你是说妈妈不用再像那时候一样，一直睡觉了吗？…你一定又在骗我，我才不信…"
                },
                {
                    "id": "620180109",
                    "speaker": "一柱",
                    "text": "是真的哦，等晚上我带你上屋顶看，好不好？星光会像妈妈的眼神一样温柔的…"
                }
            ]
        },
        {
            "talkId": "6200705",
            "initDialog": "620070501",
            "dialogues": [
                {
                    "id": "620070501",
                    "speaker": "一柱",
                    "text": "你好…你是找我吗？"
                }
            ]
        },
        {
            "talkId": "6200706",
            "initDialog": "620070601",
            "dialogues": [
                {
                    "id": "620070601",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "620070602",
                    "speaker": "一柱",
                    "text": "我叫一柱，你一定也见过我妹妹一弦吧？"
                },
                {
                    "id": "620070603",
                    "speaker": "一柱",
                    "text": "最近…家里空荡荡了很多，我怕弦儿会觉得寂寞，所以想要买件玩具陪她。"
                },
                {
                    "id": "620070604",
                    "speaker": "一柱",
                    "text": "长顺姐姐听了我的事，说可以免费挑一件玩具带回家，最近大家真的对我们兄妹很温柔…"
                },
                {
                    "id": "620070605",
                    "speaker": "一柱",
                    "text": "……"
                },
                {
                    "id": "620070606",
                    "speaker": "一柱",
                    "text": "…不行，不能哭，要笑给妹妹看。"
                }
            ]
        },
        {
            "talkId": "6200707",
            "initDialog": "620070701",
            "dialogues": [
                {
                    "id": "620070701",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620070702",
                    "speaker": "一柱",
                    "text": "不好意思，请不要再提那个字了，尤其是千万不要在我妹妹面前提。"
                },
                {
                    "id": "620070703",
                    "speaker": "一柱",
                    "text": "我不关心那些…我只关心怎么才能让妹妹不再哭了。"
                }
            ]
        },
        {
            "talkId": "6200708",
            "initDialog": "620070801",
            "dialogues": [
                {
                    "id": "620070801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620070802",
                    "speaker": "一柱",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "7200701",
            "initDialog": "720180101",
            "dialogues": [
                {
                    "id": "720180101",
                    "speaker": "一弦",
                    "text": "…以前都是妈妈陪我们一起逛「霄市」的…"
                },
                {
                    "id": "720180102",
                    "speaker": "一柱",
                    "text": "嗯，妈妈总是给我们买玩具，陪我们看霄灯，走到累了的时候就会背起你…"
                },
                {
                    "id": "720180103",
                    "speaker": "一弦",
                    "text": "…哥哥，我想妈妈。"
                },
                {
                    "id": "720180104",
                    "speaker": "一柱",
                    "text": "弦儿…别哭了，我们也给妈妈做个霄灯吧。"
                },
                {
                    "id": "720180105",
                    "speaker": "一弦",
                    "text": "欸？可是都说霄灯是为了纪念守护璃月的英雄…"
                },
                {
                    "id": "720180106",
                    "speaker": "一柱",
                    "text": "没错，妈妈也是守护我们的英雄呀。"
                },
                {
                    "id": "720180107",
                    "speaker": "一柱",
                    "text": "所以别哭了，等妈妈的灵魂和大英雄们一起回来的时候，你要笑着迎接她。"
                },
                {
                    "id": "720180108",
                    "speaker": "一弦",
                    "text": "嗯！"
                }
            ]
        }
    ]
}