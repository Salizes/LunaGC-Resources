{
    "groupId": "9008",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 18,
        "夜兰": 48
    },
    "talks": [
        {
            "talkId": "6900801",
            "initDialog": "690080101",
            "dialogues": [
                {
                    "id": "690080101",
                    "speaker": "夜兰",
                    "text": "哦？大忙人出现了。"
                },
                {
                    "id": "690080102",
                    "speaker": "夜兰",
                    "text": "#{NICKNAME}，该不会有什么事要我帮忙吧？"
                }
            ]
        },
        {
            "talkId": "6900802",
            "initDialog": "690080201",
            "dialogues": [
                {
                    "id": "690080201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690080202",
                    "speaker": "夜兰",
                    "text": "还算不错，庭院里的陈设赏心悦目，远方的景致也别有一番韵味。"
                },
                {
                    "id": "690080203",
                    "speaker": "夜兰",
                    "text": "嗯，算能让我享受闲暇时光了。",
                    "choices": [
                        {
                            "id": "690080204",
                            "text": "夜兰一般住在哪里？",
                            "response": [
                                {
                                    "id": "690080206",
                                    "speaker": "夜兰",
                                    "text": "那当然是自己的家里。"
                                },
                                {
                                    "id": "690080207",
                                    "speaker": "夜兰",
                                    "text": "只不过我的家在城外，是个很清静的地方。"
                                },
                                {
                                    "id": "690080208",
                                    "speaker": "夜兰",
                                    "text": "呵呵…看你的眼神，该不会是听信了什么传言，以为我名下有不少财产，对生活起居的要求很严苛吧。"
                                },
                                {
                                    "id": "690080209",
                                    "speaker": "夜兰",
                                    "text": "眼见都未必为实，更何况是流言呢。",
                                    "choices": [
                                        {
                                            "id": "690080210",
                                            "text": "远离喧嚣也有好处…",
                                            "response": [
                                                {
                                                    "id": "690080212",
                                                    "speaker": "夜兰",
                                                    "text": "没错，这样的回答才像话，看来你也上道了。"
                                                },
                                                {
                                                    "id": "690080213",
                                                    "speaker": "夜兰",
                                                    "text": "住得够远，就更有名正言顺的借口翘班啦。比如山路受阻，或者中途遭遇了拦路的盗宝团…"
                                                },
                                                {
                                                    "id": "690080214",
                                                    "speaker": "夜兰",
                                                    "text": "何况，住在人来人往的城里，难免被人察觉到行踪。这会制造不必要的麻烦，妨碍我追查目标。"
                                                },
                                                {
                                                    "id": "690080215",
                                                    "speaker": "Player",
                                                    "text": "原来还有这层考虑…"
                                                },
                                                {
                                                    "id": "690080216",
                                                    "speaker": "夜兰",
                                                    "text": "话说回来，这里我进出自由，来去自如，不当做备用据点都有点可惜了。"
                                                },
                                                {
                                                    "id": "690080217",
                                                    "speaker": "夜兰",
                                                    "text": "你不会介意的吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690080211",
                                            "text": "或许对你的工作有帮助…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690080205",
                            "text": "夜兰一般去哪放松？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900803",
            "initDialog": "690080301",
            "dialogues": [
                {
                    "id": "690080301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690080302",
                    "speaker": "夜兰",
                    "text": "当然可以。"
                },
                {
                    "id": "690080303",
                    "speaker": "夜兰",
                    "text": "沏一壶好茶，边品茶边聊天，享受幽静的时光，也是恢复精力的好办法啊。"
                },
                {
                    "id": "690080304",
                    "speaker": "夜兰",
                    "text": "对了，与你关系很好的那位「销虹霁雨真君」也很喜欢品茶。不如用她珍藏的好茶来招待我，怎么样？",
                    "choices": [
                        {
                            "id": "690080305",
                            "text": "不要欺负阿圆…",
                            "response": [
                                {
                                    "id": "690080307",
                                    "speaker": "夜兰",
                                    "text": "呵呵，开个玩笑。她已经请我喝过了，我们还聊得挺投机的。"
                                },
                                {
                                    "id": "690080308",
                                    "speaker": "夜兰",
                                    "text": "想要聊天进展顺利，重点在于话题的选择。"
                                },
                                {
                                    "id": "690080309",
                                    "speaker": "夜兰",
                                    "text": "跟你的话…不如就来谈谈追踪目标的技巧，设伏的要点，发展线人和布设眼哨的原则。",
                                    "choices": [
                                        {
                                            "id": "690080310",
                                            "text": "好专业…",
                                            "response": [
                                                {
                                                    "id": "690080312",
                                                    "speaker": "夜兰",
                                                    "text": "呵呵，如果你是想找我聊些无关痛痒的话题，我也能够奉陪。"
                                                },
                                                {
                                                    "id": "690080313",
                                                    "speaker": "夜兰",
                                                    "text": "你懂的，角色扮演算我的强项。"
                                                },
                                                {
                                                    "id": "690080314",
                                                    "speaker": "夜兰",
                                                    "text": "…但在我看来，真正值得与你分享的，还要算那些话题。"
                                                },
                                                {
                                                    "id": "690080315",
                                                    "speaker": "夜兰",
                                                    "text": "我的心得结合了千岩军斥候的秘法、商界交锋的实例，还有不少外国组织的经验。"
                                                },
                                                {
                                                    "id": "690080316",
                                                    "speaker": "夜兰",
                                                    "text": "对于你而言，这些知识迟早能派上用场。"
                                                },
                                                {
                                                    "id": "690080317",
                                                    "speaker": "夜兰",
                                                    "text": "学会之后，也就不会被懂行的人欺负了。"
                                                },
                                                {
                                                    "id": "690080318",
                                                    "speaker": "夜兰",
                                                    "text": "总之，想要在这些方面有所精进的时候，记得来找我。我会好好教导你的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690080311",
                                            "text": "好正式…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690080306",
                            "text": "你自己去提升信任度嘛…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900804",
            "initDialog": "690080401",
            "dialogues": [
                {
                    "id": "690080401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690080402",
                    "speaker": "夜兰",
                    "text": "现在是你的休息时间吧？那就做一些不那么费脑力的事情好了。"
                },
                {
                    "id": "690080403",
                    "speaker": "夜兰",
                    "text": "啊，口袋里正好装着骰子，不如来玩个小游戏吧。"
                },
                {
                    "id": "690080404",
                    "speaker": "夜兰",
                    "text": "我投骰子，根据点数来决定接下来的倾诉者。",
                    "choices": [
                        {
                            "id": "690080405",
                            "text": "点数？",
                            "response": [
                                {
                                    "id": "690080407",
                                    "speaker": "夜兰",
                                    "text": "如果投出一三五，就由你来扮演「倾诉者」，要告诉我一个…绝不能被第三人知道的秘密。"
                                },
                                {
                                    "id": "690080408",
                                    "speaker": "夜兰",
                                    "text": "如果是二四六，就由我来坦白相同分量的秘密，如何？",
                                    "choices": [
                                        {
                                            "id": "690080409",
                                            "text": "感觉有点危险…",
                                            "response": [
                                                {
                                                    "id": "690080410",
                                                    "speaker": "夜兰",
                                                    "text": "看来你对我还有所保留呢。"
                                                },
                                                {
                                                    "id": "690080411",
                                                    "speaker": "夜兰",
                                                    "text": "不过，合格了。在哪怕重要的合作伙伴面前也留了一线，我反而对你更放心了。"
                                                },
                                                {
                                                    "id": "690080412",
                                                    "speaker": "夜兰",
                                                    "text": "有朝一日，说不定你也会成为很出色的情报人员呢。我会期待和你过招的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690080413",
                                            "text": "那就试试看吧！",
                                            "response": [
                                                {
                                                    "id": "690080414",
                                                    "speaker": "夜兰",
                                                    "text": "哦？明明这个游戏有一半的概率只亏不赢，你仍然愿意进行吗？"
                                                },
                                                {
                                                    "id": "690080415",
                                                    "speaker": "夜兰",
                                                    "text": "还是说，为了掌握我的秘密，你不惜投入这份赌注呢？"
                                                },
                                                {
                                                    "id": "690080416",
                                                    "speaker": "夜兰",
                                                    "text": "有意思。本来还想暗中动点小机关的，现在连我也期待起来了。"
                                                },
                                                {
                                                    "id": "690080417",
                                                    "speaker": "夜兰",
                                                    "text": "呵呵…那就赶快开始第一轮吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690080406",
                            "text": "倾诉者？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900805",
            "initDialog": "690080501",
            "dialogues": [
                {
                    "id": "690080501",
                    "speaker": "Player",
                    "text": "早啊，夜兰。"
                },
                {
                    "id": "690080502",
                    "speaker": "夜兰",
                    "text": "嗯…确实挺早的，你还真有精神呢。"
                },
                {
                    "id": "690080503",
                    "speaker": "夜兰",
                    "text": "看你也没什么事，那我再小睡一会儿。"
                }
            ]
        },
        {
            "talkId": "6900806",
            "initDialog": "690080601",
            "dialogues": [
                {
                    "id": "690080601",
                    "speaker": "Player",
                    "text": "晚安，夜兰。"
                },
                {
                    "id": "690080602",
                    "speaker": "夜兰",
                    "text": "#也对，那就晚安了，{NICKNAME}。"
                },
                {
                    "id": "690080603",
                    "speaker": "夜兰",
                    "text": "我再忙一会儿。对我来说，现在可是思维最活跃的黄金时段，最适合整理零碎的线索…"
                }
            ]
        },
        {
            "talkId": "6900807",
            "initDialog": "690080701",
            "dialogues": [
                {
                    "id": "690080701",
                    "speaker": "夜兰",
                    "text": "这座院落，和我在珉林西南的临时住所有些相似。"
                },
                {
                    "id": "690080702",
                    "speaker": "夜兰",
                    "text": "那次行动很顺利，回想起来都让人心情不错。"
                },
                {
                    "id": "690080703",
                    "speaker": "夜兰",
                    "text": "哪天抽空回去打扫打扫吧，或许以后也有用呢…"
                }
            ]
        },
        {
            "talkId": "6900808",
            "initDialog": "690080801",
            "dialogues": [
                {
                    "id": "690080801",
                    "speaker": "夜兰",
                    "text": "食坊不错，把吃虎岩的市井气息都还原了出来。"
                },
                {
                    "id": "690080802",
                    "speaker": "夜兰",
                    "text": "喝一顿丰盛的早茶再去上班，工作状态才会好。"
                },
                {
                    "id": "690080803",
                    "speaker": "夜兰",
                    "text": "坐在路边摊位，也能从各种人嘴边听到不少碎片信息…"
                }
            ]
        }
    ]
}