    "talks": [
        {
            "talkId": "7508765",
            "initDialog": "750876501",
            "dialogues": [
                {
                    "id": "750876501",
                    "speaker": "拉密萨纳",
                    "text": "…这么说，你愿意原谅我了？"
                },
                {
                    "id": "750876502",
                    "speaker": "莉瓦",
                    "text": "我哪有这么说。塔卢加可是我的亲弟弟，都是因为你，让他卷入那么危险的事件里，要是他有个万一…"
                },
                {
                    "id": "750876503",
                    "speaker": "拉密萨纳",
                    "text": "你、你先别急，他这不是没事吗！他这么机灵的小孩，不管遇到什么危险都能化险为夷的，你也要对他有信心啊。"
                },
                {
                    "id": "750876504",
                    "speaker": "莉瓦",
                    "text": "你之前明明常说他不懂事，靠不住…"
                },
                {
                    "id": "750876505",
                    "speaker": "拉密萨纳",
                    "text": "这不是经过这次的事，我已经对他刮目相看了嘛。所以，你什么时候才能对我也刮目相看呢…"
                }
            ]
        }
    ]
}