{
    "groupId": "4193",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 7,
        "兰萨卡": 18
    },
    "talks": [
        {
            "talkId": "6419301",
            "initDialog": "641930101",
            "dialogues": [
                {
                    "id": "641930101",
                    "speaker": "兰萨卡",
                    "text": "#谢谢你，那菈{NICKNAME}。因为你，大家才能在无忧节都尝到「开心的味道」。"
                }
            ]
        },
        {
            "talkId": "6419302",
            "initDialog": "641930201",
            "dialogues": [
                {
                    "id": "641930201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "641930202",
                    "speaker": "兰萨卡",
                    "text": "能够分享的朋友越多，「开心的味道」就会越开心，所以等到无忧节的时候，我打算让所有的兰那罗都品尝「开心的味道」。"
                },
                {
                    "id": "641930203",
                    "speaker": "兰萨卡",
                    "text": "到时候…兰帕卡提也一定会和大家一起开心的吧。"
                }
            ]
        },
        {
            "talkId": "6419303",
            "initDialog": "641930301",
            "dialogues": [
                {
                    "id": "641930301",
                    "speaker": "Player",
                    "text": "关于「开心的味道」…"
                },
                {
                    "id": "641930302",
                    "speaker": "兰萨卡",
                    "text": "除了「开心的味道」，也有「难过的味道」。"
                },
                {
                    "id": "641930303",
                    "speaker": "兰萨卡",
                    "text": "就是可怕的盐的味道，每次只要尝一点点，就会感到很难过很难过。"
                },
                {
                    "id": "641930304",
                    "speaker": "兰萨卡",
                    "text": "但是那菈们好像很喜欢「难过的味道」，不懂，不明白。"
                },
                {
                    "id": "641930305",
                    "speaker": "兰萨卡",
                    "text": "难道是因为分享「难过的味道」也很开心吗？"
                }
            ]
        },
        {
            "talkId": "6419304",
            "initDialog": "641930401",
            "dialogues": [
                {
                    "id": "641930401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641930402",
                    "speaker": "兰萨卡",
                    "text": "吃到「开心的味道」，开心！"
                }
            ]
        },
        {
            "talkId": "6419305",
            "initDialog": "641930501",
            "dialogues": [
                {
                    "id": "641930501",
                    "speaker": "兰萨卡",
                    "text": "#啊，是那菈{NICKNAME}！你知道「生气的味道」吗？"
                }
            ]
        },
        {
            "talkId": "6419306",
            "initDialog": "641930601",
            "dialogues": [
                {
                    "id": "641930601",
                    "speaker": "Player",
                    "text": "「生气的味道」？"
                },
                {
                    "id": "641930602",
                    "speaker": "兰萨卡",
                    "text": "这种味道，那菈法留纳提到过。"
                },
                {
                    "id": "641930603",
                    "speaker": "兰萨卡",
                    "text": "吃了以后，嘴里像是吞下桓那吉喷出的火一样，咿——想想就很可怕。"
                },
                {
                    "id": "641930604",
                    "speaker": "兰萨卡",
                    "text": "可是也有那菈喜欢这种味道，他们一定在那菈中也是最勇敢的那菈。"
                },
                {
                    "id": "641930605",
                    "speaker": "兰萨卡",
                    "text": "#所以勇敢的那菈{NICKNAME}也一定会喜欢「生气的味道」。"
                }
            ]
        },
        {
            "talkId": "6419307",
            "initDialog": "641930701",
            "dialogues": [
                {
                    "id": "641930701",
                    "speaker": "Player",
                    "text": "我还有其他事要忙…"
                },
                {
                    "id": "641930702",
                    "speaker": "兰萨卡",
                    "text": "这样啊…那忙完了记得要告诉兰萨卡…"
                }
            ]
        },
        {
            "talkId": "6419308",
            "initDialog": "641930801",
            "dialogues": [
                {
                    "id": "641930801",
                    "speaker": "Player",
                    "text": "很喜欢。"
                },
                {
                    "id": "641930802",
                    "speaker": "兰萨卡",
                    "text": "看来勇敢的那菈都很喜欢「生气的味道」。"
                },
                {
                    "id": "641930803",
                    "speaker": "兰萨卡",
                    "text": "那么接下来的「特别烹饪修行」，我就要挑战「生气的味道」，希望…不会太痛。"
                }
            ]
        },
        {
            "talkId": "6419309",
            "initDialog": "641930901",
            "dialogues": [
                {
                    "id": "641930901",
                    "speaker": "Player",
                    "text": "不喜欢。"
                },
                {
                    "id": "641930902",
                    "speaker": "兰萨卡",
                    "text": "唔…原来并不是勇敢的那菈都喜欢「生气的味道」啊…"
                },
                {
                    "id": "641930903",
                    "speaker": "兰萨卡",
                    "text": "接下来的「特别烹饪修行」，我想要找到勇敢的那菈喜欢的味道…"
                }
            ]
        }
    ]
}