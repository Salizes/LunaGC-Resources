    "talks": [
        {
            "talkId": "6309301",
            "initDialog": "630930101",
            "dialogues": [
                {
                    "id": "630930101",
                    "speaker": "横山",
                    "text": "有什么事吗，异乡人？"
                }
            ]
        },
        {
            "talkId": "6309302",
            "initDialog": "630930201",
            "dialogues": [
                {
                    "id": "630930201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "630930202",
                    "speaker": "横山",
                    "text": "此处乃是「勘定奉行」要地，不是你这样的异乡人该来的地方。"
                },
                {
                    "id": "630930203",
                    "speaker": "横山",
                    "text": "若是有事想要求见勘定奉行大人，那就先去「远国监司」递上信函和名帖。"
                },
                {
                    "id": "630930204",
                    "speaker": "横山",
                    "text": "至于能否见到奉行大人…那就要看你的运气了。"
                }
            ]
        },
        {
            "talkId": "6309304",
            "initDialog": "630930401",
            "dialogues": [
                {
                    "id": "630930401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630930402",
                    "speaker": "横山",
                    "text": "哼…不送。"
                }
            ]
        },
        {
            "talkId": "6309305",
            "initDialog": "630930501",
            "dialogues": [
                {
                    "id": "630930501",
                    "speaker": "横山",
                    "text": "你好，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6309306",
            "initDialog": "630930601",
            "dialogues": [
                {
                    "id": "630930601",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "630930602",
                    "speaker": "横山",
                    "text": "此处乃是「勘定奉行」要地，是全离岛的管理中枢。"
                },
                {
                    "id": "630930603",
                    "speaker": "横山",
                    "text": "若是有事想要求见家主大人…那你来的不是时候。"
                },
                {
                    "id": "630930604",
                    "speaker": "横山",
                    "text": "在大御所殿下做出判决之前，大概谁也见不到的。"
                }
            ]
        },
        {
            "talkId": "6309307",
            "initDialog": "630930701",
            "dialogues": [
                {
                    "id": "630930701",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630930702",
                    "speaker": "横山",
                    "text": "不送。"
                }
            ]
        }
    ]
}