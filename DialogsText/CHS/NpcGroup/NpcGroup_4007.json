{
    "groupId": "4007",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "侯赛因": 10
    },
    "talks": [
        {
            "talkId": "6400701",
            "initDialog": "640070101",
            "dialogues": [
                {
                    "id": "640070101",
                    "speaker": "侯赛因",
                    "text": "维护平静的生活也是需要勇气的啊。"
                }
            ]
        },
        {
            "talkId": "6400702",
            "initDialog": "640070201",
            "dialogues": [
                {
                    "id": "640070201",
                    "speaker": "Player",
                    "text": "遇到困难了吗？"
                },
                {
                    "id": "640070202",
                    "speaker": "侯赛因",
                    "text": "没有没有，只是有感而发。"
                },
                {
                    "id": "640070203",
                    "speaker": "侯赛因",
                    "text": "我以前是做水手的，什么风浪都见过，就连海难也没能带走我的生命。"
                },
                {
                    "id": "640070204",
                    "speaker": "侯赛因",
                    "text": "在我看来，大风大浪都不足为惧，能够一直维持平稳才是更难的事情。"
                },
                {
                    "id": "640070205",
                    "speaker": "侯赛因",
                    "text": "埋下一颗种子不难，但将一棵小苗培育成大树就不那么容易了…大概就是这个意思吧。"
                },
                {
                    "id": "640070206",
                    "speaker": "侯赛因",
                    "text": "不过这话可不能让我哥哥哈桑听见，不然他又要教训我不知足了，哈哈。"
                }
            ]
        },
        {
            "talkId": "6400703",
            "initDialog": "640070301",
            "dialogues": [
                {
                    "id": "640070301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640070302",
                    "speaker": "侯赛因",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "7392401",
            "initDialog": "739240101",
            "dialogues": [
                {
                    "id": "739240101",
                    "speaker": "Player",
                    "text": "确实有点。"
                },
                {
                    "id": "739240102",
                    "speaker": "侯赛因",
                    "text": "真的吗？"
                },
                {
                    "id": "739240103",
                    "speaker": "侯赛因",
                    "text": "等你遇到教令官叫你一直把摊位搬来搬去，直到找到一块「不影响市容」的地方时，就不会这么想了…"
                },
                {
                    "id": "739240104",
                    "speaker": "侯赛因",
                    "text": "碰上这种情况，就算有扛过十次海难的经验也用不上啊。"
                }
            ]
        }
    ]
}