{
    "groupId": "4009",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "娜比雅": 8
    },
    "talks": [
        {
            "talkId": "6400901",
            "initDialog": "640090101",
            "dialogues": [
                {
                    "id": "640090101",
                    "speaker": "娜比雅",
                    "text": "诱惑会引发爱意，而过分的爱则会引发灾难…"
                },
                {
                    "id": "640090102",
                    "speaker": "娜比雅",
                    "text": "不过幸好，它们不是很喜欢你。"
                }
            ]
        },
        {
            "talkId": "6400902",
            "initDialog": "640090201",
            "dialogues": [
                {
                    "id": "640090201",
                    "speaker": "Player",
                    "text": "「它们」是…"
                },
                {
                    "id": "640090202",
                    "speaker": "娜比雅",
                    "text": "哈鲁特和玛鲁特，它们是灵活鬼魅的身影，是自由无拘的生灵…"
                },
                {
                    "id": "640090203",
                    "speaker": "娜比雅",
                    "text": "…也就是我的猫猫。"
                }
            ]
        },
        {
            "talkId": "6400903",
            "initDialog": "640090301",
            "dialogues": [
                {
                    "id": "640090301",
                    "speaker": "Player",
                    "text": "真遗憾。"
                },
                {
                    "id": "640090302",
                    "speaker": "娜比雅",
                    "text": "也许是吧，但也许不是。"
                }
            ]
        },
        {
            "talkId": "6400904",
            "initDialog": "640090401",
            "dialogues": [
                {
                    "id": "640090401",
                    "speaker": "Player",
                    "text": "那么诱惑与爱意是…"
                },
                {
                    "id": "640090402",
                    "speaker": "娜比雅",
                    "text": "猫猫是会好奇的。虽然猫有很多优点，但好奇是它们的软肋。"
                },
                {
                    "id": "640090403",
                    "speaker": "娜比雅",
                    "text": "因为它们的好奇和喜爱，让水中的鱼被扑上岸边，令天上的鸟被困在地面…"
                },
                {
                    "id": "640090404",
                    "speaker": "娜比雅",
                    "text": "对于鱼和鸟来说，不就是一场灾难嘛。"
                }
            ]
        }
    ]
}