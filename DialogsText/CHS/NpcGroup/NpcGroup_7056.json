    },
    "talks": [
        {
            "talkId": "6705601",
            "initDialog": "670560101",
            "dialogues": [
                {
                    "id": "670560101",
                    "speaker": "霍尔雷",
                    "text": "呼…嗯？我也不太清楚，你问问别人吧。"
                }
            ]
        },
        {
            "talkId": "6705602",
            "initDialog": "670560201",
            "dialogues": [
                {
                    "id": "670560201",
                    "speaker": "Player",
                    "text": "关于那夏镇…"
                },
                {
                    "id": "670560202",
                    "speaker": "霍尔雷",
                    "text": "商会和港口都在里面，有银行。要吃饭和住宿也有，进去自己找吧。"
                }
            ]
        },
        {
            "talkId": "6705603",
            "initDialog": "670560301",
            "dialogues": [
                {
                    "id": "670560301",
                    "speaker": "Player",
                    "text": "那边那个人也是守卫吗？"
                },
                {
                    "id": "670560302",
                    "speaker": "霍尔雷",
                    "text": "不知道，反正我是。"
                }
            ]
        },
        {
            "talkId": "6705604",
            "initDialog": "670560401",
            "dialogues": [
                {
                    "id": "670560401",
                    "speaker": "Player",
                    "text": "好吧，那不打扰你了。"
                },
                {
                    "id": "670560402",
                    "speaker": "霍尔雷",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6705605",
            "initDialog": "670560501",
            "dialogues": [
                {
                    "id": "670560501",
                    "speaker": "Player",
                    "text": "守卫的工作看上去很轻松…"
                },
                {
                    "id": "670560502",
                    "speaker": "霍尔雷",
                    "text": "…如果没事了的话请让开，我要继续睡…啊不对，我要继续工作了。"
                }
            ]
        },
        {
            "talkId": "6705606",
            "initDialog": "670560601",
            "dialogues": [
                {
                    "id": "670560601",
                    "speaker": "Player",
                    "text": "他看起来有点可疑…"
                },
                {
                    "id": "670560602",
                    "speaker": "霍尔雷",
                    "text": "我觉得你看起来才比较可疑一点。"
                }
            ]
        }
    ]
}