{
    "groupId": "6397",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "夏贝瓦": 9
    },
    "talks": [
        {
            "talkId": "6639701",
            "initDialog": "663970101",
            "dialogues": [
                {
                    "id": "663970101",
                    "speaker": "夏贝瓦",
                    "text": "哼哼，看来我还是很有天赋的嘛！好，再来一次！"
                }
            ]
        },
        {
            "talkId": "6639702",
            "initDialog": "663970201",
            "dialogues": [
                {
                    "id": "663970201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "663970202",
                    "speaker": "夏贝瓦",
                    "text": "哦，你好呀！我是夏贝瓦，来自烟谜主的摔…呃，不对，应该是祭司。"
                },
                {
                    "id": "663970203",
                    "speaker": "夏贝瓦",
                    "text": "咳咳，总之，我是来研究火山历史的。不过嘛，学术研究也是需要放松的，对吧？所以我就报了这个健身班！"
                },
                {
                    "id": "663970204",
                    "speaker": "夏贝瓦",
                    "text": "更何况，编织卷哪有摔人好玩…不对，我的意思是，灵感要磨砺，肉体也要锻炼，这样才称得上健全！"
                }
            ]
        },
        {
            "talkId": "6639703",
            "initDialog": "663970301",
            "dialogues": [
                {
                    "id": "663970301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "663970302",
                    "speaker": "夏贝瓦",
                    "text": "好，路上小心！那我接着摔…咳，不对，愿迷烟护佑你的前路，异邦的旅人。"
                }
            ]
        },
        {
            "talkId": "7594901",
            "initDialog": "759490101",
            "dialogues": [
                {
                    "id": "759490101",
                    "speaker": "Player",
                    "text": "呃，那关于火山的历史研究呢？"
                },
                {
                    "id": "759490102",
                    "speaker": "夏贝瓦",
                    "text": "这、这个嘛，已经在研究了，在研究了！比方说，火山与摔角招式之间，就存在着某种关联…"
                },
                {
                    "id": "759490103",
                    "speaker": "夏贝瓦",
                    "text": "「众生的角逐铸就了今日的历史，因而摔角即是历史之音」，此事在祭司王马古汉留下的织卷中亦有记载…"
                },
                {
                    "id": "759490104",
                    "speaker": "夏贝瓦",
                    "text": "…啊，不对，并没有记载。这句话好像是桑哈杰大师胡说的…"
                },
                {
                    "id": "759490105",
                    "speaker": "夏贝瓦",
                    "text": "总之，「角逐」也确实是纳塔历史重要的一环，所以研究摔角也是有意义的…嗯！"
                }
            ]
        }
    ]
}