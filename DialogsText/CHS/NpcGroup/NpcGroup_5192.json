{
    "groupId": "5192",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "兴澄": 7
    },
    "talks": [
        {
            "talkId": "6519201",
            "initDialog": "651920101",
            "dialogues": [
                {
                    "id": "651920101",
                    "speaker": "兴澄",
                    "text": "她懂什么？我们这些茶叶可都是贵重货！慢点搬怎么了？啊！？"
                }
            ]
        },
        {
            "talkId": "6519202",
            "initDialog": "651920201",
            "dialogues": [
                {
                    "id": "651920201",
                    "speaker": "Player",
                    "text": "你、你冷静点。"
                },
                {
                    "id": "651920202",
                    "speaker": "兴澄",
                    "text": "呼…真是气死我了，我卸货也没花多少时间啊！难道我非得把茶叶一箱箱往底下丢，她才满意吗？"
                },
                {
                    "id": "651920203",
                    "speaker": "兴澄",
                    "text": "我的茶叶本来就是大头贵重货，要是搬的时候哪箱茶饼出了问题，我不得赔个底儿掉啊？她给我赔！？"
                }
            ]
        },
        {
            "talkId": "6519203",
            "initDialog": "651920301",
            "dialogues": [
                {
                    "id": "651920301",
                    "speaker": "Player",
                    "text": "再、再见！"
                },
                {
                    "id": "651920302",
                    "speaker": "兴澄",
                    "text": "真是气死我了，这个不识货的家伙！"
                }
            ]
        },
        {
            "talkId": "6519204",
            "initDialog": "651920401",
            "dialogues": [
                {
                    "id": "651920401",
                    "speaker": "Player",
                    "text": "这些茶叶很珍贵吗？"
                },
                {
                    "id": "651920402",
                    "speaker": "兴澄",
                    "text": "废…咳，当然了，这些可都是我们翘英庄里最好的茶叶，无论是原料还是制作工艺，都是最好的！"
                },
                {
                    "id": "651920403",
                    "speaker": "兴澄",
                    "text": "这个不识货的家伙，我真懒得和她费口舌。"
                },
                {
                    "id": "651920404",
                    "speaker": "兴澄",
                    "text": "先不和你说了，我等会非得和那家伙理论理论不可！"
                }
            ]
        }
    ]
}