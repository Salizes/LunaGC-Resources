{
    "groupId": "3108",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "山田": 15
    },
    "talks": [
        {
            "talkId": "6310801",
            "initDialog": "631080101",
            "dialogues": [
                {
                    "id": "631080101",
                    "speaker": "山田",
                    "text": "嗯？有事吗？没事的话，我还要继续求签呢。"
                }
            ]
        },
        {
            "talkId": "6310802",
            "initDialog": "631080201",
            "dialogues": [
                {
                    "id": "631080201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "631080202",
                    "speaker": "山田",
                    "text": "我在求签，希望将军大人能回心转意，早日解除「锁国令」…"
                },
                {
                    "id": "631080203",
                    "speaker": "山田",
                    "text": "可是我抽了好几次，结果都是「凶」或者「大凶」！唉，真是晦气！"
                },
                {
                    "id": "631080204",
                    "speaker": "山田",
                    "text": "因为「锁国令」的限制，我没法出海经商，手边的货物都堆积起来了。"
                },
                {
                    "id": "631080205",
                    "speaker": "山田",
                    "text": "经商如此不顺，就连「鸣神大社」也不能保佑我了吗…难道目睹了那件事之后，我的运势再也好不起来了？"
                },
                {
                    "id": "631080206",
                    "speaker": "山田",
                    "text": "不、不行！我绝不放弃！无论多少次，一定要抽出「吉」才行！"
                }
            ]
        },
        {
            "talkId": "6310803",
            "initDialog": "631080301",
            "dialogues": [
                {
                    "id": "631080301",
                    "speaker": "Player",
                    "text": "那件事…"
                },
                {
                    "id": "631080302",
                    "speaker": "山田",
                    "text": "那是「眼狩令」颁布之后的事情了。当时有个自不量力的家伙，向执行「眼狩令」的天领奉行发起了「御前决斗」。"
                },
                {
                    "id": "631080303",
                    "speaker": "山田",
                    "text": "结果自然是，这个贸然挑战权威的人惨败，最后被将军大人的神罚制裁…唉，现在想想真是惨烈…"
                },
                {
                    "id": "631080304",
                    "speaker": "山田",
                    "text": "只是没想到，那人落败后掉下的「神之眼」，竟被当时闯入现场的另一个年轻人抢走了！"
                },
                {
                    "id": "631080305",
                    "speaker": "山田",
                    "text": "那神之眼本应成为将军大人神像上的一部分，却被不知名的浪人武士夺取…欸，真是不吉利！"
                }
            ]
        },
        {
            "talkId": "6310804",
            "initDialog": "631080401",
            "dialogues": [
                {
                    "id": "631080401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "631080402",
                    "speaker": "山田",
                    "text": "下一签一定要是「吉」啊，拜托了…"
                }
            ]
        },
        {
            "talkId": "6310805",
            "initDialog": "631080501",
            "dialogues": [
                {
                    "id": "631080501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "631080502",
                    "speaker": "山田",
                    "text": "我在求签，想看看今后的生意运势…"
                },
                {
                    "id": "631080503",
                    "speaker": "山田",
                    "text": "本来以为趁现在出国做些买卖应该能大赚一笔，但谁知抽出来的签全是「凶」…"
                },
                {
                    "id": "631080504",
                    "speaker": "山田",
                    "text": "经商如此不顺，就连「鸣神大社」也不能保佑我了吗…难道目睹了那件事之后，我的运势再也好不起来了？"
                },
                {
                    "id": "631080505",
                    "speaker": "山田",
                    "text": "不、不行！我绝不放弃！无论多少次，一定要抽出「吉」才行！"
                }
            ]
        }
    ]
}