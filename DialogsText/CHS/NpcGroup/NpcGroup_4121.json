{
    "groupId": "4121",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "贝拉特": 9
    },
    "talks": [
        {
            "talkId": "6412101",
            "initDialog": "641210101",
            "dialogues": [
                {
                    "id": "641210101",
                    "speaker": "贝拉特",
                    "text": "人的注视，会改变大海。"
                }
            ]
        },
        {
            "talkId": "6412102",
            "initDialog": "641210201",
            "dialogues": [
                {
                    "id": "641210201",
                    "speaker": "Player",
                    "text": "你好？"
                },
                {
                    "id": "641210202",
                    "speaker": "贝拉特",
                    "text": "听我说，最好别一直盯着大海看哦。"
                },
                {
                    "id": "641210203",
                    "speaker": "贝拉特",
                    "text": "不然的话，你会一直坐在那里，就那样一直看着，什么也做不了。"
                },
                {
                    "id": "641210204",
                    "speaker": "贝拉特",
                    "text": "直到天空与海水终于变成红色，直到万物消散，你也最终逝去…"
                }
            ]
        },
        {
            "talkId": "6412103",
            "initDialog": "641210301",
            "dialogues": [
                {
                    "id": "641210301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641210302",
                    "speaker": "贝拉特",
                    "text": "呵，记住我的忠告。"
                }
            ]
        },
        {
            "talkId": "6412104",
            "initDialog": "641210401",
            "dialogues": [
                {
                    "id": "641210401",
                    "speaker": "Player",
                    "text": "紫色的海水确实…"
                },
                {
                    "id": "641210402",
                    "speaker": "贝拉特",
                    "text": "哦？你见过紫色的海了？"
                },
                {
                    "id": "641210403",
                    "speaker": "贝拉特",
                    "text": "那一定是有更诡谲的眼睛盯着它！"
                },
                {
                    "id": "641210404",
                    "speaker": "贝拉特",
                    "text": "…总之，一定要听我的——"
                },
                {
                    "id": "641210405",
                    "speaker": "贝拉特",
                    "text": "不要一直盯着大海看。"
                }
            ]
        }
    ]
}