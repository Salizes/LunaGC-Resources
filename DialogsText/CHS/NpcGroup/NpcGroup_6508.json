    "talks": [
        {
            "talkId": "6650801",
            "initDialog": "665080101",
            "dialogues": [
                {
                    "id": "665080101",
                    "speaker": "索林",
                    "text": "要不试试这个构图方案吧？我管这个叫水平构图！怎么样，这个线条十分舒展吧！"
                },
                {
                    "id": "665080102",
                    "speaker": "索尔顿",
                    "text": "…"
                },
                {
                    "id": "665080103",
                    "speaker": "索林",
                    "text": "不合适啊…你说得也没错，确实有一点太平和的感觉…那、那这个有框架的呢？这个明暗反差大，会有较强的动态感。"
                },
                {
                    "id": "665080104",
                    "speaker": "索尔顿",
                    "text": "…"
                },
                {
                    "id": "665080105",
                    "speaker": "索林",
                    "text": "原来如此，太压抑了啊…下一个、下一个一定能行！你看这个！这个螺旋线！是不是很有聚焦感！"
                },
                {
                    "id": "665080106",
                    "speaker": "索尔顿",
                    "text": "…"
                },
                {
                    "id": "665080107",
                    "speaker": "索林",
                    "text": "啊——！对啊，太复杂了不好上色！啧，我怎么把这个都忘了！真是够笨的！"
                },
                {
                    "id": "665080108",
                    "speaker": "索林",
                    "text": "你别急，我现在就回去想。我可是最好的助手！我一定能想出让你满意的方案的！"
                },
                {
                    "id": "665080109",
                    "speaker": "索尔顿",
                    "text": "？"
                },
                {
                    "id": "665080110",
                    "speaker": "索尔顿",
                    "text": "~"
                }
            ]
        }
    ]
}