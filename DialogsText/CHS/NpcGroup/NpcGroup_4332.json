{
    "groupId": "4332",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "玥文": 9
    },
    "talks": [
        {
            "talkId": "6433201",
            "initDialog": "643320101",
            "dialogues": [
                {
                    "id": "643320101",
                    "speaker": "玥文",
                    "text": "这里真是度假的好地方，如何，你也这么觉得吧？"
                }
            ]
        },
        {
            "talkId": "6433202",
            "initDialog": "643320201",
            "dialogues": [
                {
                    "id": "643320201",
                    "speaker": "Player",
                    "text": "你是从璃月来的？"
                },
                {
                    "id": "643320202",
                    "speaker": "玥文",
                    "text": "对啊，自璃月来，经水路可直达奥摩斯港。"
                },
                {
                    "id": "643320203",
                    "speaker": "玥文",
                    "text": "我刚在那卸了一批货物，赚了一笔小钱，打算在维摩庄休息一段时日再回璃月。"
                },
                {
                    "id": "643320204",
                    "speaker": "玥文",
                    "text": "结果发现这里实在是一处适合偷闲的宝地啊…让人舍不得离开。"
                }
            ]
        },
        {
            "talkId": "6433203",
            "initDialog": "643320301",
            "dialogues": [
                {
                    "id": "643320301",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "643320302",
                    "speaker": "玥文",
                    "text": "看来英雄所见略同，甚好甚好。"
                }
            ]
        },
        {
            "talkId": "7395201",
            "initDialog": "739520101",
            "dialogues": [
                {
                    "id": "739520101",
                    "speaker": "Player",
                    "text": "要定居吗？"
                },
                {
                    "id": "739520102",
                    "speaker": "玥文",
                    "text": "我也在思考这个问题。"
                },
                {
                    "id": "739520103",
                    "speaker": "玥文",
                    "text": "似乎是因为以前忙惯了，我身上那股勤劳的血液正催促着我赶紧去干活…"
                },
                {
                    "id": "739520104",
                    "speaker": "玥文",
                    "text": "但我听村民们讲，须弥有句古话：「巧思才能得真知。」"
                },
                {
                    "id": "739520105",
                    "speaker": "玥文",
                    "text": "没准，换个想法、换种生活，才更适合我呢？"
                }
            ]
        }
    ]
}