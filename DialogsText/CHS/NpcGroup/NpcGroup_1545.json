{
    "groupId": "1545",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "玛拉": 8
    },
    "talks": [
        {
            "talkId": "7092301",
            "initDialog": "709230101",
            "dialogues": [
                {
                    "id": "709230101",
                    "speaker": "Player",
                    "text": "你为什么这么困呢？"
                },
                {
                    "id": "709230102",
                    "speaker": "玛拉",
                    "text": "嗯…因为我的恋人，他和我只有在晚上才能相会…"
                },
                {
                    "id": "709230103",
                    "speaker": "玛拉",
                    "text": "另一个原因是，我最近在看《野猪公主》系列，刚好看完大结局了。"
                },
                {
                    "id": "709230104",
                    "speaker": "玛拉",
                    "text": "虽然结局让人觉得有些怪怪的，不过最后野猪公主和小狼能在一起真是太好了呢！"
                },
                {
                    "id": "709230105",
                    "speaker": "玛拉",
                    "text": "你看过这本书了吗？如果没看过的话，就请看看吧…看完了麻烦替我还给图书馆哦，谢谢。"
                }
            ]
        },
        {
            "talkId": "41734",
            "initDialog": "615450203",
            "dialogues": [
                {
                    "id": "615450203",
                    "speaker": "Player",
                    "text": "没什么特别的事…"
                },
                {
                    "id": "615450204",
                    "speaker": "玛拉",
                    "text": "没事吗？呼…多亏这里有一把椅子，那我准备睡一会儿了。"
                }
            ]
        },
        {
            "talkId": "6154501",
            "initDialog": "615450101",
            "dialogues": [
                {
                    "id": "615450101",
                    "speaker": "玛拉",
                    "text": "你好…找我有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6154502",
            "initDialog": "615450201",
            "dialogues": [
                {
                    "id": "615450201",
                    "speaker": "Player",
                    "text": "你看上去很困…"
                },
                {
                    "id": "615450202",
                    "speaker": "玛拉",
                    "text": "是呀，我感觉随时都可能睡着，所以有什么事就快说吧…"
                }
            ]
        },
        {
            "talkId": "6154503",
            "initDialog": "615450301",
            "dialogues": [
                {
                    "id": "615450301",
                    "speaker": "Player",
                    "text": "不打扰了…"
                },
                {
                    "id": "615450302",
                    "speaker": "玛拉",
                    "text": "呼……呼……"
                }
            ]
        }
    ]
}