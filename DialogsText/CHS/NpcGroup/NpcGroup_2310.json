{
    "groupId": "2310",
    "total_dialogue_lines": 46,
    "speaker_counts": {
        "Player": 10,
        "路爷": 36
    },
    "talks": [
        {
            "talkId": "6231006",
            "initDialog": "623100601",
            "dialogues": [
                {
                    "id": "623100601",
                    "speaker": "Player",
                    "text": "关于徒弟…"
                },
                {
                    "id": "623100602",
                    "speaker": "路爷",
                    "text": "客官是听到老夫念叨了吗？"
                },
                {
                    "id": "623100603",
                    "speaker": "路爷",
                    "text": "呵呵，老夫新收的徒弟大雨，干活麻利，人也算勤快，就是话太多。"
                },
                {
                    "id": "623100604",
                    "speaker": "路爷",
                    "text": "我们做木匠的，踏踏实实做好自己的活计就行了，跟客人说那么多闲话做什么。"
                },
                {
                    "id": "623100605",
                    "speaker": "路爷",
                    "text": "这小子不够稳健哪，我还是再收一个徒弟好。"
                },
                {
                    "id": "623100606",
                    "speaker": "路爷",
                    "text": "两个徒弟相互帮衬着，就能把「范木堂」的名号好好传承下去了吧。"
                },
                {
                    "id": "623100607",
                    "speaker": "路爷",
                    "text": "…这么说来，客官对木工活有兴趣吗？"
                }
            ]
        },
        {
            "talkId": "6231007",
            "initDialog": "623100701",
            "dialogues": [
                {
                    "id": "623100701",
                    "speaker": "Player",
                    "text": "师父！"
                },
                {
                    "id": "623100702",
                    "speaker": "路爷",
                    "text": "哦哦，此话当真？"
                },
                {
                    "id": "623100703",
                    "speaker": "路爷",
                    "text": "但看你的样子，也有不得不做的事情，有不得不去的地方吧。"
                },
                {
                    "id": "623100704",
                    "speaker": "路爷",
                    "text": "等你把该做的事情做完了，到时候如果老夫还健在，再来叫我师父吧。"
                },
                {
                    "id": "623100705",
                    "speaker": "路爷",
                    "text": "决定了，届时一定倾尽全力把「范木堂」的手艺传授给你。"
                }
            ]
        },
        {
            "talkId": "6231008",
            "initDialog": "623100801",
            "dialogues": [
                {
                    "id": "623100801",
                    "speaker": "Player",
                    "text": "还是算了。"
                },
                {
                    "id": "623100802",
                    "speaker": "路爷",
                    "text": "真遗憾。木工活真的很有趣。"
                },
                {
                    "id": "623100803",
                    "speaker": "路爷",
                    "text": "看你的样子，也有不得不做的事情，不得不去的地方吧。"
                },
                {
                    "id": "623100804",
                    "speaker": "路爷",
                    "text": "等你把该做的事情做完了，如果改变了心意的话，一定要来找老夫啊。"
                },
                {
                    "id": "623100805",
                    "speaker": "路爷",
                    "text": "届时老夫一定倾尽全力把「范木堂」的手艺传授给你。"
                }
            ]
        },
        {
            "talkId": "6231009",
            "initDialog": "623100901",
            "dialogues": [
                {
                    "id": "623100901",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6231010",
            "initDialog": "623101001",
            "dialogues": [
                {
                    "id": "623101001",
                    "speaker": "路爷",
                    "text": "和你打牌格外解闷！有空再来陪老夫玩两局啊！"
                }
            ]
        },
        {
            "talkId": "6231011",
            "initDialog": "623101101",
            "dialogues": [
                {
                    "id": "623101101",
                    "speaker": "路爷",
                    "text": "不错不错！年轻人果然更擅长牌戏！"
                }
            ]
        },
        {
            "talkId": "2101301",
            "initDialog": "210130101",
            "dialogues": [
                {
                    "id": "210130101",
                    "speaker": "路爷",
                    "text": "唉…"
                }
            ]
        },
        {
            "talkId": "6231001",
            "initDialog": "623100101",
            "dialogues": [
                {
                    "id": "623100101",
                    "speaker": "路爷",
                    "text": "欢迎来到「范木堂」，轻策庄老字号工坊！"
                },
                {
                    "id": "623100102",
                    "speaker": "路爷",
                    "text": "大到百尺高楼，小到指尖陀螺，但凡是客官想得到的，没有老夫做不出的！"
                }
            ]
        },
        {
            "talkId": "6231002",
            "initDialog": "623100201",
            "dialogues": [
                {
                    "id": "623100201",
                    "speaker": "Player",
                    "text": "工坊？"
                },
                {
                    "id": "623100202",
                    "speaker": "路爷",
                    "text": "从我爷爷的爷爷那一代，一直传到老夫手里的木工作坊。"
                },
                {
                    "id": "623100203",
                    "speaker": "路爷",
                    "text": "常家九爷的房子也好，庄里的大磨坊也好，都是我们「范木堂」修的。"
                },
                {
                    "id": "623100204",
                    "speaker": "路爷",
                    "text": "就连七星的人也会来找我们定制家具。"
                }
            ]
        },
        {
            "talkId": "6231003",
            "initDialog": "623100301",
            "dialogues": [
                {
                    "id": "623100301",
                    "speaker": "Player",
                    "text": "关于徒弟…"
                },
                {
                    "id": "623100302",
                    "speaker": "路爷",
                    "text": "客官是听到老夫念叨了吗，唉…"
                },
                {
                    "id": "623100303",
                    "speaker": "路爷",
                    "text": "老夫年纪已经太大了，风也见过雨也见过，腿脚不麻利了。"
                },
                {
                    "id": "623100304",
                    "speaker": "路爷",
                    "text": "还是想收个徒弟，把「范木堂」的名号传下去啊。"
                },
                {
                    "id": "623100305",
                    "speaker": "路爷",
                    "text": "…这么说来，你对木工活有兴趣吗？通过劳动，把原始的木材，变成巧夺天工的艺术品，这样的事情，没兴趣吗？",
                    "choices": [
