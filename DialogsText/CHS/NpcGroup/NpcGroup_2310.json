                    ]
                }
            ]
        },
        {
            "talkId": "6231004",
            "initDialog": "623100401",
            "dialogues": [
                {
                    "id": "623100401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "623100402",
                    "speaker": "路爷",
                    "text": "这就走了吗？唉…对老夫来说，客人也是接一个少一个咯…"
                }
            ]
        },
        {
            "talkId": "6231005",
            "initDialog": "623100501",
            "dialogues": [
                {
                    "id": "623100501",
                    "speaker": "Player",
                    "text": "关于摆设…"
                },
                {
                    "id": "623100502",
                    "speaker": "路爷",
                    "text": "哦？客官可是想制作些摆设？恰好我们「范木堂」进了些图纸，客官来挑挑吧…"
                }
            ]
