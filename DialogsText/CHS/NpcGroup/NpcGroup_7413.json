{
    "groupId": "7413",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 7,
        "齐良诺夫": 9
    },
    "talks": [
        {
            "talkId": "6741301",
            "initDialog": "674130101",
            "dialogues": [
                {
                    "id": "674130101",
                    "speaker": "齐良诺夫",
                    "text": "饮料，好喝又实惠的饮料，口渴的喝一口不口渴，身子冷的喝一口立刻就热嘞！"
                }
            ]
        },
        {
            "talkId": "6741302",
            "initDialog": "674130201",
            "dialogues": [
                {
                    "id": "674130201",
                    "speaker": "Player",
                    "text": "有什么喝的？"
                },
                {
                    "id": "674130202",
                    "speaker": "齐良诺夫",
                    "text": "…嘿嘿，好喝的可不少嘞，您看看吧！"
                }
            ]
        },
        {
            "talkId": "6741303",
            "initDialog": "674130301",
            "dialogues": [
                {
                    "id": "674130301",
                    "speaker": "Player",
                    "text": "有多实惠？"
                },
                {
                    "id": "674130302",
                    "speaker": "齐良诺夫",
                    "text": "要多实惠有多实惠…不过这些都是官方定的价，如果客人你想要，还有点更便宜的…"
                }
            ]
        },
        {
            "talkId": "6741304",
            "initDialog": "674130401",
            "dialogues": [
                {
                    "id": "674130401",
                    "speaker": "Player",
                    "text": "没什么想喝的…"
                },
                {
                    "id": "674130402",
                    "speaker": "齐良诺夫",
                    "text": "哎呀，没事，想喝点什么了，就来找我嘞！"
                }
            ]
        },
        {
            "talkId": "6741305",
            "initDialog": "674130501",
            "dialogues": [
                {
                    "id": "674130501",
                    "speaker": "Player",
                    "text": "更便宜的？"
                },
                {
                    "id": "674130502",
                    "speaker": "齐良诺夫",
                    "text": "嘿嘿，这可就是小店的门路了，有些朋友们自己做的…"
                },
                {
                    "id": "674130503",
                    "speaker": "齐良诺夫",
                    "text": "喝起来劲更大，虽然滋味淡点，有的时候也会喝出些问题…不过胜在便宜嘛。"
                }
            ]
        },
        {
            "talkId": "6741306",
            "initDialog": "674130601",
            "dialogues": [
                {
                    "id": "674130601",
                    "speaker": "Player",
                    "text": "算了，便宜没好货…"
                },
                {
                    "id": "674130602",
                    "speaker": "齐良诺夫",
                    "text": "那是比不得这些正经厂子里出来的，可是胜在便宜嘛。"
                }
            ]
        },
        {
            "talkId": "6741307",
            "initDialog": "674130701",
            "dialogues": [
                {
                    "id": "674130701",
                    "speaker": "Player",
                    "text": "呃呃，还是算了…"
                },
                {
                    "id": "674130702",
                    "speaker": "齐良诺夫",
                    "text": "没事，如果你哪天想试试了，我可以给你十足的优惠嘞！"
                }
            ]
        },
        {
            "talkId": "6741308",
            "initDialog": "674130801",
            "dialogues": [
                {
                    "id": "674130801",
                    "speaker": "Player",
                    "text": "你这有冰淇淋吗？"
                },
                {
                    "id": "674130802",
                    "speaker": "齐良诺夫",
                    "text": "你今天已经品尝过冰淇淋了，明天再来吧…"
                }
            ]
        }
    ]
}