{
    "groupId": "7826",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 6,
        "阿尔谢尼耶夫": 8
    },
    "talks": [
        {
            "talkId": "6782601",
            "initDialog": "678260101",
            "dialogues": [
                {
                    "id": "678260101",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "唉，这样下去，至冬前途一片黑暗啊…这可怎么办？"
                }
            ]
        },
        {
            "talkId": "6782602",
            "initDialog": "678260201",
            "dialogues": [
                {
                    "id": "678260201",
                    "speaker": "Player",
                    "text": "怎么就一片黑暗了？"
                },
                {
                    "id": "678260202",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "这就是你不懂了吧，据我知道的消息，其实璃月的岩之神没有真正死去，而是将自己的精神化作千万亿份…"
                },
                {
                    "id": "678260203",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "附在了摩拉之上，就是为了能够窃听至冬的消息…"
                }
            ]
        },
        {
            "talkId": "6782603",
            "initDialog": "678260301",
            "dialogues": [
                {
                    "id": "678260301",
                    "speaker": "Player",
                    "text": "那可管不了了…"
                },
                {
                    "id": "678260302",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "虽然情况令人绝望，但是我们还是得一直保持思考才行啊…"
                }
            ]
        },
        {
            "talkId": "6782604",
            "initDialog": "678260401",
            "dialogues": [
                {
                    "id": "678260401",
                    "speaker": "Player",
                    "text": "就这？"
                },
                {
                    "id": "678260402",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "还有呢，我听说纳塔的火神，正在不停往火山里填柴…就是为了能够通过地热把至冬宫融化！"
                }
            ]
        },
        {
            "talkId": "6782605",
            "initDialog": "678260501",
            "dialogues": [
                {
                    "id": "678260501",
                    "speaker": "Player",
                    "text": "你刚才说的不也被摩拉听到了…"
                },
                {
                    "id": "678260502",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "完了，我晚上就要被秘密潜入至冬境内的千岩军抓走了！这、这该怎么办…"
                }
            ]
        },
        {
            "talkId": "6782606",
            "initDialog": "678260601",
            "dialogues": [
                {
                    "id": "678260601",
                    "speaker": "Player",
                    "text": "你都哪听来的这些消息…"
                },
                {
                    "id": "678260602",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "这些都是秘密中的秘密，我当然有自己的杂志…自己的信息源…"
                }
            ]
        },
        {
            "talkId": "6782607",
            "initDialog": "678260701",
            "dialogues": [
                {
                    "id": "678260701",
                    "speaker": "Player",
                    "text": "那真是太可怕了！"
                },
                {
                    "id": "678260702",
                    "speaker": "阿尔谢尼耶夫",
                    "text": "是吧，你也这么觉得！"
                }
            ]
        }
    ]
}