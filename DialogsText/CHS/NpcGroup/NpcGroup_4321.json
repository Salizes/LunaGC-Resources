{
    "groupId": "4321",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 14,
        "阿玛兹亚": 27
    },
    "talks": [
        {
            "talkId": "6432101",
            "initDialog": "643210101",
            "dialogues": [
                {
                    "id": "643210101",
                    "speaker": "阿玛兹亚",
                    "text": "希望维摩庄的孩子们能够平安长大…嗯？是有人在这儿吗？"
                }
            ]
        },
        {
            "talkId": "6432102",
            "initDialog": "643210201",
            "dialogues": [
                {
                    "id": "643210201",
                    "speaker": "Player",
                    "text": "您的视力…"
                },
                {
                    "id": "643210202",
                    "speaker": "阿玛兹亚",
                    "text": "唉，真是抱歉啊，年纪上来之后，眼睛就变得不太好使了，看什么都是一团模糊的影子，不过好在这双耳朵还算灵敏…"
                },
                {
                    "id": "643210203",
                    "speaker": "阿玛兹亚",
                    "text": "你也是来维摩庄休息的客人吗？无论你从何处来，维摩庄都欢迎你…"
                }
            ]
        },
        {
            "talkId": "6432103",
            "initDialog": "643210301",
            "dialogues": [
                {
                    "id": "643210301",
                    "speaker": "Player",
                    "text": "关于孩子们…"
                },
                {
                    "id": "643210302",
                    "speaker": "阿玛兹亚",
                    "text": "嗯，他们都是很好、很有活力的孩子们呀…希望小草神大人能够庇佑他们，平平安安长大。"
                }
            ]
        },
        {
            "talkId": "6432104",
            "initDialog": "643210401",
            "dialogues": [
                {
                    "id": "643210401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "643210402",
                    "speaker": "阿玛兹亚",
                    "text": "没事，没事，来的都是客…"
                }
            ]
        },
        {
            "talkId": "6432105",
            "initDialog": "643210501",
            "dialogues": [
                {
                    "id": "643210501",
                    "speaker": "阿玛兹亚",
                    "text": "是拉娜带来的小客人啊，怎么样，拉娜是个很好的向导吧…"
                }
            ]
        },
        {
            "talkId": "6432106",
            "initDialog": "643210601",
            "dialogues": [
                {
                    "id": "643210601",
                    "speaker": "Player",
                    "text": "您的视力…"
                },
                {
                    "id": "643210602",
                    "speaker": "阿玛兹亚",
                    "text": "唉，真是抱歉啊，年纪上来之后，眼睛就变得不太好使了，看什么都是一团模糊的影子，不过好在这双耳朵还算灵敏…"
                },
                {
                    "id": "643210603",
                    "speaker": "阿玛兹亚",
                    "text": "之前真是不好意思啊…"
                }
            ]
        },
        {
            "talkId": "6432107",
            "initDialog": "643210701",
            "dialogues": [
                {
                    "id": "643210701",
                    "speaker": "Player",
                    "text": "关于孩子们…"
                },
                {
                    "id": "643210702",
                    "speaker": "阿玛兹亚",
                    "text": "那群「小老虎」啊，他们都是很好、很有活力的孩子们呀…希望小草神大人能够庇佑他们，平平安安长大。"
                }
            ]
        },
        {
            "talkId": "6432108",
            "initDialog": "643210801",
            "dialogues": [
                {
                    "id": "643210801",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643210802",
                    "speaker": "阿玛兹亚",
                    "text": "拉娜，唉，拉娜这孩子呀，打小就聪明…可有的时候太要强了一些。"
                },
                {
                    "id": "643210803",
                    "speaker": "阿玛兹亚",
                    "text": "当上巡林官之后啊，回村里的次数就少了。巡林官工作繁忙，我也理解，我担心的啊，是她有没有好好休息…"
                }
            ]
        },
        {
            "talkId": "6432109",
            "initDialog": "643210901",
            "dialogues": [
                {
                    "id": "643210901",
                    "speaker": "Player",
                    "text": "关于村长的过去…"
                },
                {
                    "id": "643210902",
                    "speaker": "阿玛兹亚",
                    "text": "都是些过去的故事了，虽然那个时候我放弃成为冒险家，但是也并不后悔…"
                },
                {
                    "id": "643210903",
                    "speaker": "阿玛兹亚",
                    "text": "每个人，都有自己的路要走啊…"
                }
            ]
        },
        {
            "talkId": "6432110",
            "initDialog": "643211001",
            "dialogues": [
                {
                    "id": "643211001",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643211002",
                    "speaker": "阿玛兹亚",
                    "text": "嗯，就不耽搁你的时间啦…"
                },
                {
                    "id": "643211003",
                    "speaker": "阿玛兹亚",
                    "text": "哦对了，小客人，要是遇到了拉娜，记得劝她多休息休息啊…"
                }
            ]
        },
        {
            "talkId": "6432111",
            "initDialog": "643211101",
            "dialogues": [
                {
                    "id": "643211101",
                    "speaker": "阿玛兹亚",
                    "text": "是拉娜带来的小客人，哎呀，如果你要找拉娜的话，她去旅行了，要过一阵子才回来啦。"
                }
            ]
        },
        {
            "talkId": "6432112",
            "initDialog": "643211201",
            "dialogues": [
                {
                    "id": "643211201",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643211202",
                    "speaker": "阿玛兹亚",
                    "text": "拉娜啊，她突然回来，说着「要跟一个很重要、很重要的朋友去旅行」…"
                },
                {
                    "id": "643211203",
                    "speaker": "阿玛兹亚",
                    "text": "听得出来，这孩子的语气非常认真…只有旅行过的人才能明白旅行的意义，希望她能得到自己想要的东西吧…"
                }
            ]
        },
        {
            "talkId": "6432113",
            "initDialog": "643211301",
            "dialogues": [
                {
                    "id": "643211301",
                    "speaker": "Player",
                    "text": "关于乐器…"
                },
                {
                    "id": "643211302",
                    "speaker": "阿玛兹亚",
                    "text": "那件乐器啊…那件乐器就放在你那儿吧。"
                },
                {
                    "id": "643211303",
                    "speaker": "阿玛兹亚",
                    "text": "它本就属于听风而行的旅人，已经在我身边停留太长的时间啦。"
                },
                {
                    "id": "643211304",
                    "speaker": "阿玛兹亚",
                    "text": "能让它在林子里唱唱歌，也算是没有辜负当初那位女诗人吧…"
                }
            ]
        },
        {
            "talkId": "6432114",
            "initDialog": "643211401",
            "dialogues": [
                {
                    "id": "643211401",
                    "speaker": "Player",
                    "text": "关于村长的过去…"
                },
                {
                    "id": "643211402",
                    "speaker": "阿玛兹亚",
                    "text": "都是些过去的故事了，虽然那个时候我放弃成为冒险家，但是也并不后悔…"
                },
                {
                    "id": "643211403",
                    "speaker": "阿玛兹亚",
                    "text": "每个人，都有自己的路要走啊…"
                }
            ]
        },
        {
            "talkId": "6432115",
            "initDialog": "643211501",
            "dialogues": [
                {
                    "id": "643211501",
                    "speaker": "Player",
                    "text": "关于艾方索…"
                },
                {
                    "id": "643211502",
                    "speaker": "阿玛兹亚",
                    "text": "艾方索这孩子，怎么不声不响地就走了，他来维摩庄好几年啦，大家都说他是个好孩子…"
                }
            ]
        },
        {
            "talkId": "6432116",
            "initDialog": "643211601",
            "dialogues": [
                {
                    "id": "643211601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643211602",
                    "speaker": "阿玛兹亚",
                    "text": "嗯，就不耽搁你的时间啦…"
                }
            ]
        },
        {
            "talkId": "6432117",
            "initDialog": "643211701",
            "dialogues": [
                {
                    "id": "643211701",
                    "speaker": "Player",
                    "text": "他可能不会回来了…"
                },
                {
                    "id": "643211702",
                    "speaker": "阿玛兹亚",
                    "text": "唉，这孩子…其他的什么都好，就是有的时候啊，感觉他心里沉甸甸的，压着什么事，我也不方便问出口…"
                },
                {
                    "id": "643211703",
                    "speaker": "阿玛兹亚",
                    "text": "希望他以后，能别再为那些事而烦恼了吧。"
                }
            ]
        }
    ]
}