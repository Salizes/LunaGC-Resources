    "talks": [
        {
            "talkId": "6704401",
            "initDialog": "670440101",
            "dialogues": [
                {
                    "id": "670440101",
                    "speaker": "阿莉妲",
                    "text": "号外！号外！最新一期的「那夏快报」，要来一份吗？"
                }
            ]
        },
        {
            "talkId": "6704402",
            "initDialog": "670440201",
            "dialogues": [
                {
                    "id": "670440201",
                    "speaker": "Player",
                    "text": "给我来一份。"
                },
                {
                    "id": "670440202",
                    "speaker": "阿莉妲",
                    "text": "好嘞，你要是能多给几个摩拉的话，我就教你怎么分辨报纸上这些新闻的真假。"
                }
            ]
        },
        {
            "talkId": "6704403",
            "initDialog": "670440301",
            "dialogues": [
                {
                    "id": "670440301",
                    "speaker": "Player",
                    "text": "不用了。"
                },
                {
                    "id": "670440302",
                    "speaker": "阿莉妲",
                    "text": "这样啊，那好吧。"
                }
            ]
        },
        {
            "talkId": "6704404",
            "initDialog": "670440401",
            "dialogues": [
                {
                    "id": "670440401",
                    "speaker": "Player",
                    "text": "新闻还有假的？"
                },
                {
                    "id": "670440402",
                    "speaker": "阿莉妲",
                    "text": "这可是「那夏快报」，十条里能有一条真新闻就不错了！"
                },
                {
                    "id": "670440403",
                    "speaker": "阿莉妲",
                    "text": "你瞧「相关人士透露」开头的全是瞎编，说是「亲身体验」的都是卖出去的广告版面！"
                },
                {
                    "id": "670440404",
                    "speaker": "阿莉妲",
                    "text": "欸，不对，你还没付钱呢，我怎么就告诉你了…"
                },
                {
                    "id": "670440405",
                    "speaker": "阿莉妲",
                    "text": "算啦算啦，看在你长得还挺顺眼的份上，就当我送你的好啦！"
                }
            ]
        }
    ]
}