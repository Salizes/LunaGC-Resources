{
    "groupId": "3130",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 7,
        "白井": 25
    },
    "talks": [
        {
            "talkId": "6313001",
            "initDialog": "631300101",
            "dialogues": [
                {
                    "id": "631300101",
                    "speaker": "白井",
                    "text": "不错，最近又拿到了不少新消息…"
                }
            ]
        },
        {
            "talkId": "6313002",
            "initDialog": "631300201",
            "dialogues": [
                {
                    "id": "631300201",
                    "speaker": "Player",
                    "text": "新消息？"
                },
                {
                    "id": "631300202",
                    "speaker": "白井",
                    "text": "对啊对啊，我这里有不少稻妻之外的消息，都是「最新鲜」的绝密情报。"
                },
                {
                    "id": "631300203",
                    "speaker": "白井",
                    "text": "听说过吗，在北境的蒙德，前一阵有巨龙出没。"
                },
                {
                    "id": "631300204",
                    "speaker": "白井",
                    "text": "那巨龙展开双翼，遮天蔽日，能施展狂风之力，席卷蒙德境内…"
                },
                {
                    "id": "631300205",
                    "speaker": "白井",
                    "text": "嘿嘿，感兴趣吗？不过接下来的故事，可就不是免费的咯。"
                }
            ]
        },
        {
            "talkId": "6313003",
            "initDialog": "631300301",
            "dialogues": [
                {
                    "id": "631300301",
                    "speaker": "Player",
                    "text": "不用了，谢谢。"
                },
                {
                    "id": "631300302",
                    "speaker": "白井",
                    "text": "欸，不听听看吗？"
                },
                {
                    "id": "631300303",
                    "speaker": "白井",
                    "text": "好吧，这可是你的损失！"
                }
            ]
        },
        {
            "talkId": "6313004",
            "initDialog": "631300401",
            "dialogues": [
                {
                    "id": "631300401",
                    "speaker": "Player",
                    "text": "…有更新一点的消息吗？"
                },
                {
                    "id": "631300402",
                    "speaker": "白井",
                    "text": "喔…看来这样的情报还不能满足你啊。"
                },
                {
                    "id": "631300403",
                    "speaker": "白井",
                    "text": "那这个如何：掌管璃月数千年的古老神明，竟在一年一度的请仙典仪上不幸殒命！"
                },
                {
                    "id": "631300404",
                    "speaker": "白井",
                    "text": "事发突然，请仙典仪变送仙典仪，究竟是天降浩劫，还是另有阴谋？"
                },
                {
                    "id": "631300405",
                    "speaker": "白井",
                    "text": "怎么样，想知道详情吗？好奇的话，就拿出点交换情报的诚意吧！"
                }
            ]
        },
        {
            "talkId": "6313005",
            "initDialog": "631300501",
            "dialogues": [
                {
                    "id": "631300501",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "631300502",
                    "speaker": "白井",
                    "text": "咦，看你一副兴趣缺缺的样子，难道是我的消息太不灵通了…"
                },
                {
                    "id": "631300503",
                    "speaker": "白井",
                    "text": "没办法啊，稻妻锁国已久，这些已经是我经过多方打听，努力搜集来的情报了。"
                },
                {
                    "id": "631300504",
                    "speaker": "白井",
                    "text": "在见过世面的人面前可能有些小巫见大巫了，但在海祇岛的居民之中，这些外面发生的事情还是很受欢迎的哦。"
                },
                {
                    "id": "631300505",
                    "speaker": "白井",
                    "text": "看来我以后还是多找本地人做生意吧…"
                }
            ]
        },
        {
            "talkId": "6313006",
            "initDialog": "631300601",
            "dialogues": [
                {
                    "id": "631300601",
                    "speaker": "Player",
                    "text": "新消息？"
                },
                {
                    "id": "631300602",
                    "speaker": "白井",
                    "text": "对啊对啊，我这里有不少稻妻的消息，都是「最新鲜」的绝密情报。"
                },
                {
                    "id": "631300603",
                    "speaker": "白井",
                    "text": "听说过吗，眼狩令解除了，之前那些被没收了神之眼的人们，又可以重新使用元素力了！"
                },
                {
                    "id": "631300604",
                    "speaker": "白井",
                    "text": "在我们普通人眼里，那种能力简直就像变戏法一样啊！"
                }
            ]
        },
        {
            "talkId": "6313007",
            "initDialog": "631300701",
            "dialogues": [
                {
                    "id": "631300701",
                    "speaker": "Player",
                    "text": "…有更新一点的消息吗？"
                },
                {
                    "id": "631300702",
                    "speaker": "白井",
                    "text": "喔…看来这样的情报还不能满足你啊。"
                },
                {
                    "id": "631300703",
                    "speaker": "白井",
                    "text": "那这个如何：在稻妻施行已久的锁国令，终于迎来了终结的一天！"
                },
                {
                    "id": "631300704",
                    "speaker": "白井",
                    "text": "重新开放的海域，究竟会迎来希望，还是遭遇外敌？"
                },
                {
                    "id": "631300705",
                    "speaker": "白井",
                    "text": "怎么样，想知道详情吗？好奇的话，就拿出点交换情报的诚意吧！"
                }
            ]
        },
        {
            "talkId": "6313008",
            "initDialog": "631300801",
            "dialogues": [
                {
                    "id": "631300801",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "631300802",
                    "speaker": "白井",
                    "text": "咦，看你一副兴趣缺缺的样子，难道是我的消息太不灵通了…"
                },
                {
                    "id": "631300803",
                    "speaker": "白井",
                    "text": "还是说我找的对象都是比我还熟悉稻妻的人？"
                },
                {
                    "id": "631300804",
                    "speaker": "白井",
                    "text": "看来我看人的本领还有待加强啊。以后难道只能找那种连路都认不清的外地游客了吗…"
                }
            ]
        }
    ]
}