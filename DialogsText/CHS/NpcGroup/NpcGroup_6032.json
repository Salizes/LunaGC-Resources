{
    "groupId": "6032",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "尤季娜": 12
    },
    "talks": [
        {
            "talkId": "6603201",
            "initDialog": "660320101",
            "dialogues": [
                {
                    "id": "660320101",
                    "speaker": "尤季娜",
                    "text": "你好，是需要协助比赛裁判的吗？"
                },
                {
                    "id": "660320102",
                    "speaker": "尤季娜",
                    "text": "啊，好像不是啊。"
                }
            ]
        },
        {
            "talkId": "6603202",
            "initDialog": "660320201",
            "dialogues": [
                {
                    "id": "660320201",
                    "speaker": "Player",
                    "text": "协助裁判？"
                },
                {
                    "id": "660320202",
                    "speaker": "尤季娜",
                    "text": "嗯，我是归火圣夜巡礼的赛事摄影师。"
                },
                {
                    "id": "660320203",
                    "speaker": "尤季娜",
                    "text": "除了用作宣传和留档之外，我拍的画片有时也会被当作比赛时裁判判罚的佐证。"
                },
                {
                    "id": "660320204",
                    "speaker": "尤季娜",
                    "text": "竞技场上总是很热闹，有时也会出现一些难以定夺的情况。"
                },
                {
                    "id": "660320205",
                    "speaker": "尤季娜",
                    "text": "这时光靠裁判的肉眼判断是很难下结论的，但如果有了我的画片辅助，情况就不一样了。"
                }
            ]
        },
        {
            "talkId": "6603203",
            "initDialog": "660320301",
            "dialogues": [
                {
                    "id": "660320301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "660320302",
                    "speaker": "尤季娜",
                    "text": "哦，没关系。"
                }
            ]
        },
        {
            "talkId": "6603204",
            "initDialog": "660320401",
            "dialogues": [
                {
                    "id": "660320401",
                    "speaker": "Player",
                    "text": "万一你也没拍到怎么办？"
                },
                {
                    "id": "660320402",
                    "speaker": "尤季娜",
                    "text": "那这就是最麻烦的状况了，或许只能靠加赛来定夺。"
                },
                {
                    "id": "660320403",
                    "speaker": "尤季娜",
                    "text": "不过一般不会发生这种事情的。先不说一场比赛的裁判有很多位，高台上可还有火神大人一直盯着呢。"
                }
            ]
        },
        {
            "talkId": "6603205",
            "initDialog": "660320501",
            "dialogues": [
                {
                    "id": "660320501",
                    "speaker": "Player",
                    "text": "可以请你拍照吗？"
                },
                {
                    "id": "660320502",
                    "speaker": "尤季娜",
                    "text": "这个恕难从命。"
                },
                {
                    "id": "660320503",
                    "speaker": "尤季娜",
                    "text": "以前也有人问过我，能不能买我拍的画片去找选手签名，但为了避免高价倒卖，我还是一律谢绝了。"
                },
                {
                    "id": "660320504",
                    "speaker": "尤季娜",
                    "text": "再加上辅助裁判的事情时有发生，为了公正起见，我是不接私人委托的，还请见谅。"
                }
            ]
        }
    ]
}