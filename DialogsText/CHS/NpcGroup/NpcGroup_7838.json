            "dialogues": [
                {
                    "id": "678380401",
                    "speaker": "Player",
                    "text": "呃，你往哪儿去？"
                },
                {
                    "id": "678380402",
                    "speaker": "叶弗列莫娃",
                    "text": "赫斯珀利德斯之馆。"
                }
            ]
        },
        {
            "talkId": "6783805",
            "initDialog": "678380501",
            "dialogues": [
                {
                    "id": "678380501",
                    "speaker": "Player",
                    "text": "哦，那是个怎样的地方？"
                },
                {
                    "id": "678380502",
                    "speaker": "叶弗列莫娃",
                    "text": "不知道，我已经很久没回去了。没有拉莉莎的赫斯珀利德斯之馆…"
                },
                {
                    "id": "678380503",
                    "speaker": "叶弗列莫娃",
                    "text": "从前，我不喜欢那儿的新主人，自认为是主人的雪精。"
                },
                {
                    "id": "678380504",
                    "speaker": "叶弗列莫娃",
                    "text": "但在那之外的世界…我已经厌倦了，现在只想回去。"
                }
            ]
        }
    ]
