    },
    "talks": [
        {
            "talkId": "5900190",
            "initDialog": "590019001",
            "dialogues": [
                {
                    "id": "590019001",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900191",
            "initDialog": "590019101",
            "dialogues": [
                {
                    "id": "590019101",
                    "speaker": "阿霍伊图",
                    "text": "我想想…现在温泉的温度应该很不错，要去泡一泡吗？"
                }
            ]
        },
        {
            "talkId": "6605701",
            "initDialog": "660570101",
            "dialogues": [
                {
                    "id": "660570101",
                    "speaker": "阿霍伊图",
                    "text": "嗯，该更新一批装备了…"
                }
            ]
        },
        {
            "talkId": "6605702",
            "initDialog": "660570201",
            "dialogues": [
                {
                    "id": "660570201",
                    "speaker": "Player",
                    "text": "什么装备？"
                },
                {
                    "id": "660570202",
                    "speaker": "阿霍伊图",
                    "text": "是耐高温的衣服和工具，这样我们部族的人就能穿戴进入火山深处进行定期检查了。"
                },
                {
                    "id": "660570203",
                    "speaker": "阿霍伊图",
                    "text": "鳍游龙是纳塔唯一一种能够穿越岩浆的龙，所以监测火山状况的责任就落在我们肩上啦。"
                },
                {
                    "id": "660570204",
                    "speaker": "阿霍伊图",
                    "text": "火山自古以来就是事故多发地，无论是从里还是从外都容易遭受魔物袭击，我们可得看紧点。"
                }
            ]
        },
        {
            "talkId": "6605703",
            "initDialog": "660570301",
            "dialogues": [
                {
                    "id": "660570301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660570302",
                    "speaker": "阿霍伊图",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6605704",
            "initDialog": "660570401",
            "dialogues": [
                {
                    "id": "660570401",
                    "speaker": "阿霍伊图",
                    "text": "嗯，该补充一批装备了…"
                }
            ]
        },
        {
            "talkId": "6605705",
            "initDialog": "660570501",
            "dialogues": [
                {
                    "id": "660570501",
                    "speaker": "Player",
                    "text": "什么装备？"
                },
                {
                    "id": "660570502",
                    "speaker": "阿霍伊图",
                    "text": "是耐高温的衣服和工具，这样我们部族的人就能穿戴进入火山深处进行定期检查了。"
                },
                {
                    "id": "660570503",
                    "speaker": "阿霍伊图",
                    "text": "鳍游龙是纳塔唯一一种能够穿越岩浆的龙，所以监测火山状况的责任就落在我们肩上啦。"
                },
                {
                    "id": "660570504",
                    "speaker": "阿霍伊图",
                    "text": "火山自古以来就是事故多发地，无论是从里还是从外都容易遭受魔物袭击，我们可得看紧点。"
                },
                {
                    "id": "660570505",
                    "speaker": "阿霍伊图",
                    "text": "之前与深渊的大战可给大伙儿折腾得够呛，我战后休养了好一阵，不少装备也在各种突发状况中消耗掉了。"
                },
                {
                    "id": "660570506",
                    "speaker": "阿霍伊图",
                    "text": "不过还好，装备都是可以再准备的，只要胜利的决心不死，就算再来多少麻烦也不怕。"
                }
            ]
        }
    ]
}