{
    "groupId": "5195",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "肖诺": 14
    },
    "talks": [
        {
            "talkId": "6519501",
            "initDialog": "651950101",
            "dialogues": [
                {
                    "id": "651950101",
                    "speaker": "肖诺",
                    "text": "你干什么，来偷听我的新闻？离远点！"
                }
            ]
        },
        {
            "talkId": "6519502",
            "initDialog": "651950201",
            "dialogues": [
                {
                    "id": "651950201",
                    "speaker": "Player",
                    "text": "我都没听到你说什么。"
                },
                {
                    "id": "651950202",
                    "speaker": "肖诺",
                    "text": "呼…还好还好，上次我的独家新闻就被一个坏心眼的家伙偷走了！"
                },
                {
                    "id": "651950203",
                    "speaker": "肖诺",
                    "text": "那可是一大笔收入！等我抓住他的把柄，一定要把他送去梅洛彼得堡里！"
                },
                {
                    "id": "651950204",
                    "speaker": "肖诺",
                    "text": "但是没关系，我已经有了新的消息，这一篇新闻，一定只属于我，只属于我一个人！"
                }
            ]
        },
        {
            "talkId": "6519503",
            "initDialog": "651950301",
            "dialogues": [
                {
                    "id": "651950301",
                    "speaker": "Player",
                    "text": "…再见。"
                },
                {
                    "id": "651950302",
                    "speaker": "肖诺",
                    "text": "这篇报道…该怎么改改呢…"
                }
            ]
        },
        {
            "talkId": "6519504",
            "initDialog": "651950401",
            "dialogues": [
                {
                    "id": "651950401",
                    "speaker": "Player",
                    "text": "你真的很在意独家…"
                },
                {
                    "id": "651950402",
                    "speaker": "肖诺",
                    "text": "那当然，一篇独家新闻就意味着一大笔酬劳，一看你就不是做我们这行的。"
                },
                {
                    "id": "651950403",
                    "speaker": "肖诺",
                    "text": "哼，我告诉你，只要手里捏着独家新闻，甚至还可以去多方比价，哪家报社出价高，我就卖给谁。"
                },
                {
                    "id": "651950404",
                    "speaker": "肖诺",
                    "text": "哈哈哈，之前甚至还有新闻的相关人士来找到我，希望能买断我手上的新闻呢。"
                },
                {
                    "id": "651950405",
                    "speaker": "肖诺",
                    "text": "说什么…要是登报的话，会损害自己的形象，造成麻烦…"
                }
            ]
        },
        {
            "talkId": "6519505",
            "initDialog": "651950501",
            "dialogues": [
                {
                    "id": "651950501",
                    "speaker": "Player",
                    "text": "你怎么做了？"
                },
                {
                    "id": "651950502",
                    "speaker": "肖诺",
                    "text": "哈哈哈！我当然是狠狠赚了一笔。不过，我也是有道德的人，人家买下了报道，我才不会再换个笔名把新闻再送出去。"
                },
                {
                    "id": "651950503",
                    "speaker": "肖诺",
                    "text": "好了好了，不和你说了，我要继续想想怎么把这篇报道写得更受欢迎一点了。"
                }
            ]
        },
        {
            "talkId": "6519506",
            "initDialog": "651950601",
            "dialogues": [
                {
                    "id": "651950601",
                    "speaker": "肖诺",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6519507",
            "initDialog": "651950701",
            "dialogues": [
                {
                    "id": "651950701",
                    "speaker": "肖诺",
                    "text": "请详细报上你的名号，我们的对局会刊登在下一期报纸的七圣召唤版块。"
                }
            ]
        },
        {
            "talkId": "6519508",
            "initDialog": "651950801",
            "dialogues": [
                {
                    "id": "651950801",
                    "speaker": "肖诺",
                    "text": "我输了…那这次对局还是别报道了吧。"
                }
            ]
        }
    ]
}