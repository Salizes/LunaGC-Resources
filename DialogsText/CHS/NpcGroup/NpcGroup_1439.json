{
    "groupId": "1439",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 7,
        "劳伦斯": 30
    },
    "talks": [
        {
            "talkId": "6143901",
            "initDialog": "4015143901",
            "dialogues": [
                {
                    "id": "4015143901",
                    "speaker": "劳伦斯",
                    "text": "欢迎来到蒙德，旅行者。有什么可以效劳的吗？"
                }
            ]
        },
        {
            "talkId": "6143902",
            "initDialog": "614390201",
            "dialogues": [
                {
                    "id": "614390201",
                    "speaker": "劳伦斯",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6143903",
            "initDialog": "614390301",
            "dialogues": [
                {
                    "id": "614390301",
                    "speaker": "劳伦斯",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6143904",
            "initDialog": "614390401",
            "dialogues": [
                {
                    "id": "614390401",
                    "speaker": "劳伦斯",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        },
        {
            "talkId": "6143905",
            "initDialog": "614390501",
            "dialogues": [
                {
                    "id": "614390501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614390502",
                    "speaker": "劳伦斯",
                    "text": "事情刚发生的时候完全不知道怎办才好啊，现在终于告一段落了。"
                },
                {
                    "id": "614390503",
                    "speaker": "劳伦斯",
                    "text": "不过恰好我们这一代遇到这么重大的事件，也是挺不可思议的，我们也算是见证历史了吧？"
                },
                {
                    "id": "614390504",
                    "speaker": "劳伦斯",
                    "text": "…以后别人再问我有什么逸闻和传说时，我可以讲讲关于特瓦林的故事了。"
                }
            ]
        },
        {
            "talkId": "6143906",
            "initDialog": "4015143902",
            "dialogues": [
                {
                    "id": "4015143902",
                    "speaker": "Player",
                    "text": "关于蒙德城。"
                },
                {
                    "id": "4015143906",
                    "speaker": "劳伦斯",
                    "text": "是「北境的明冠」，是「牧歌之城」，是多少赞美之词都不足以描述的美妙城市。"
                },
                {
                    "id": "4015143907",
                    "speaker": "劳伦斯",
                    "text": "最近城里又来了个吟游诗人，想体验蒙德风情的话，可以去进城找找他。"
                },
                {
                    "id": "4015143908",
                    "speaker": "劳伦斯",
                    "text": "不过他的曲子…怎么说呢，有点太古典了？"
                },
                {
                    "id": "4015143909",
                    "speaker": "劳伦斯",
                    "text": "…那种千年前的歌谣，他究竟是从哪里学到的呢…",
                    "choices": [
                        {
                            "id": "4015143903",
                            "text": "蒙德有什么传说吗？",
                            "response": [
                                {
                                    "id": "4015143910",
                                    "speaker": "劳伦斯",
                                    "text": "那你可问对人了。"
                                },
                                {
                                    "id": "4015143911",
                                    "speaker": "劳伦斯",
                                    "text": "据说蒙德最近的晚上，经常有一位惩恶扬善的英雄人物出现。"
                                },
                                {
                                    "id": "4015143912",
                                    "speaker": "劳伦斯",
                                    "text": "不过至今还没人知道他的身份…"
                                },
                                {
                                    "id": "4015143913",
                                    "speaker": "劳伦斯",
                                    "text": "不行不行，提起他的事我就要说个没完啦，万一又被团长看到…"
                                },
                                {
                                    "id": "4015143914",
                                    "speaker": "劳伦斯",
                                    "text": "等下次有机会再和你聊吧，真是不好意思。"
                                }
                            ]
                        },
                        {
                            "id": "4015143904",
                            "text": "蒙德有什么逸闻吗？",
                            "response": [
                                {
                                    "id": "4015143915",
                                    "speaker": "劳伦斯",
                                    "text": "逸闻啊…不知道这个算不算。"
                                },
                                {
                                    "id": "4015143916",
                                    "speaker": "劳伦斯",
                                    "text": "我在这里站岗的时候，偶尔会注意到天气突变，电闪雷鸣…不过一小会儿就又消失了。"
                                },
                                {
                                    "id": "4015143917",
                                    "speaker": "劳伦斯",
                                    "text": "嗯…感觉不像是自然现象，是人为操控天气所致。可又是谁拥有这么强的魔力呢？"
                                },
                                {
                                    "id": "4015143918",
                                    "speaker": "劳伦斯",
                                    "text": "骑士团的高层似乎也没有这样的人物，真是奇怪。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6143907",
            "initDialog": "4015143905",
            "dialogues": [
                {
                    "id": "4015143905",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "4015143919",
                    "speaker": "劳伦斯",
                    "text": "再见，旅行者。愿您享受在蒙德的时光。"
                }
            ]
        },
        {
            "talkId": "6143908",
            "initDialog": "614390801",
            "dialogues": [
                {
                    "id": "614390801",
                    "speaker": "Player",
                    "text": "关于你和劳伦斯家族…"
                },
                {
                    "id": "614390802",
                    "speaker": "劳伦斯",
                    "text": "呃，这个嘛，其实我和劳伦斯家族一点关系都没有…唉，这件事就说来话长了…"
                },
                {
                    "id": "614390803",
                    "speaker": "劳伦斯",
                    "text": "你应该认识铁匠瓦格纳吧？他除了打铁，就喜欢和别人赌酒、比试酒量，而且喝多了什么都敢赌…"
                },
                {
                    "id": "614390804",
                    "speaker": "劳伦斯",
                    "text": "你看，他那家铁匠铺之所以叫「舒茨铁铺」，就是因为他和徒弟舒茨赌酒赌输了才改的名字。"
                },
                {
                    "id": "614390805",
                    "speaker": "劳伦斯",
                    "text": "…咳咳，然后呢，我的父亲是个来蒙德做生意的枫丹商人，也是个嗜酒如命的人…"
                },
                {
                    "id": "614390806",
                    "speaker": "劳伦斯",
                    "text": "有一天他俩就赌起酒来了，而我父亲的赌注是自己孩子的名字，也就是我的名字，后来…"
                },
                {
                    "id": "614390807",
                    "speaker": "劳伦斯",
                    "text": "唉，那时候我父亲哪知道劳伦斯这个名字背后牵扯了这么多东西啊…"
                }
            ]
        },
        {
            "talkId": "6143909",
            "initDialog": "614390901",
            "dialogues": [
                {
                    "id": "614390901",
                    "speaker": "Player",
                    "text": "那结果呢？"
                },
                {
                    "id": "614390902",
                    "speaker": "劳伦斯",
                    "text": "结果…如你所见，隔三差五就有人来问我和劳伦斯家族的关系。"
                },
                {
                    "id": "614390903",
                    "speaker": "劳伦斯",
                    "text": "每次我和我父亲聊起这事，他都无比懊悔…"
                },
                {
                    "id": "614390904",
                    "speaker": "劳伦斯",
                    "text": "…他要是能再多喝一杯，瓦格纳就要给自己最满意的兵器起名叫「粉红毛兔兔」了，唉…"
                }
            ]
        }
    ]
}