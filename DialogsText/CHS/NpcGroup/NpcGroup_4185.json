{
    "groupId": "4185",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "兰利遮": 19
    },
    "talks": [
        {
            "talkId": "6418501",
            "initDialog": "641850101",
            "dialogues": [
                {
                    "id": "641850101",
                    "speaker": "兰利遮",
                    "text": "无忧节快开始，很快乐，可是担心桓那，不快乐。想要回去…"
                }
            ]
        },
        {
            "talkId": "6418502",
            "initDialog": "641850201",
            "dialogues": [
                {
                    "id": "641850201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "641850202",
                    "speaker": "兰利遮",
                    "text": "#你好，那菈{NICKNAME}。"
                },
                {
                    "id": "641850203",
                    "speaker": "兰利遮",
                    "text": "#兰利遮一想到能听到那菈{NICKNAME}唱歌，就很快乐。"
                },
                {
                    "id": "641850204",
                    "speaker": "兰利遮",
                    "text": "#再茁壮，再固执的桓摩达听到那菈{NICKNAME}的歌声，都会快乐地转起来的。"
                }
            ]
        },
        {
            "talkId": "6418503",
            "initDialog": "641850301",
            "dialogues": [
                {
                    "id": "641850301",
                    "speaker": "Player",
                    "text": "你看起来不太高兴…"
                },
                {
                    "id": "641850302",
                    "speaker": "兰利遮",
                    "text": "在桓那兰那，没有希望桓那生病的坏家伙。"
                },
                {
                    "id": "641850303",
                    "speaker": "兰利遮",
                    "text": "如果森林的病痊愈的话，一定也会和桓那兰那一样。"
                },
                {
                    "id": "641850304",
                    "speaker": "兰利遮",
                    "text": "所以虽然无忧节很快乐，但是兰利遮还是想要回到森林，不让那些坏家伙接近。"
                }
            ]
        },
        {
            "talkId": "6418504",
            "initDialog": "641850401",
            "dialogues": [
                {
                    "id": "641850401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641850402",
                    "speaker": "兰利遮",
                    "text": "#再见，希望那菈{NICKNAME}能在无忧节快乐。"
                }
            ]
        },
        {
            "talkId": "6418505",
            "initDialog": "641850501",
            "dialogues": [
                {
                    "id": "641850501",
                    "speaker": "兰利遮",
                    "text": "#那菈{NICKNAME}和派蒙，兰利遮的朋友。在桓那兰那见到朋友，快乐。"
                }
            ]
        },
        {
            "talkId": "6418506",
            "initDialog": "641850601",
            "dialogues": [
                {
                    "id": "641850601",
                    "speaker": "Player",
                    "text": "关于森林…"
                },
                {
                    "id": "641850602",
                    "speaker": "兰利遮",
                    "text": "没有了坏东西，森林不会再生病了。"
                },
                {
                    "id": "641850603",
                    "speaker": "兰利遮",
                    "text": "兰利遮就会留在桓那兰那，和许多兰那罗在一起，不用再遇见奇怪的那菈。"
                },
                {
                    "id": "641850604",
                    "speaker": "兰利遮",
                    "text": "#谢谢你，那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6418507",
            "initDialog": "641850701",
            "dialogues": [
                {
                    "id": "641850701",
                    "speaker": "Player",
                    "text": "关于加扎里…"
                },
                {
                    "id": "641850702",
                    "speaker": "兰利遮",
                    "text": "那菈加扎里也是奇怪的那菈，经常像是生病一样发出很大叫声，但是兰利遮觉得他不是坏那菈。"
                },
                {
                    "id": "641850703",
                    "speaker": "兰利遮",
                    "text": "如果他可以看见兰利遮，应该也能成为兰利遮的朋友。"
                },
                {
                    "id": "641850704",
                    "speaker": "兰利遮",
                    "text": "#希望那菈{NICKNAME}能够和那菈加扎里成为很好的朋友。"
                },
                {
                    "id": "641850705",
                    "speaker": "兰利遮",
                    "text": "#也希望那菈{NICKNAME}不被那菈加扎里的奇怪叫声吓到。"
                }
            ]
        },
        {
            "talkId": "6418508",
            "initDialog": "641850801",
            "dialogues": [
                {
                    "id": "641850801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641850802",
                    "speaker": "兰利遮",
                    "text": "再见，兰利遮的朋友，森林会看顾你们。"
                }
            ]
        },
        {
            "talkId": "6418509",
            "initDialog": "641850901",
            "dialogues": [
                {
                    "id": "641850901",
                    "speaker": "兰利遮",
                    "text": "#谢谢那菈{NICKNAME}和派蒙。之后，兰利遮要回到那个又脏又坏的东西那边，去看看，有没有什么坏事。"
                },
                {
                    "id": "641850902",
                    "speaker": "兰利遮",
                    "text": "#兰利遮一直一直是那菈{NICKNAME}和派蒙的好朋友！"
                }
            ]
        }
    ]
}