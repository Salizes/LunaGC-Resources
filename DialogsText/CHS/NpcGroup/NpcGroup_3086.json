{
    "groupId": "3086",
    "total_dialogue_lines": 46,
    "speaker_counts": {
        "Player": 9,
        "柊千里": 37
    },
    "talks": [
        {
            "talkId": "4006309",
            "initDialog": "400630901",
            "dialogues": [
                {
                    "id": "400630901",
                    "speaker": "柊千里",
                    "text": "既然「光华容彩祭」选在离岛举办，那勘定奉行必须要负起责任来。"
                },
                {
                    "id": "400630902",
                    "speaker": "柊千里",
                    "text": "无论是招待来宾，还是布置场地，都要考虑周全…"
                },
                {
                    "id": "400630903",
                    "speaker": "柊千里",
                    "text": "啊，还有游客的安全问题！得叫卫兵们加强海边的巡逻才行…"
                },
                {
                    "id": "400630904",
                    "speaker": "柊千里",
                    "text": "哎呀，抱歉，光顾着思考工作，都忘了打招呼。"
                },
                {
                    "id": "400630905",
                    "speaker": "柊千里",
                    "text": "旅行者，你好！今天找我有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6308601",
            "initDialog": "630860101",
            "dialogues": [
                {
                    "id": "630860101",
                    "speaker": "柊千里",
                    "text": "镰治先生…"
                },
                {
                    "id": "630860102",
                    "speaker": "柊千里",
                    "text": "我的信，要如何才能送到你手中呢…"
                }
            ]
        },
        {
            "talkId": "6308602",
            "initDialog": "630860201",
            "dialogues": [
                {
                    "id": "630860201",
                    "speaker": "柊千里",
                    "text": "啊，是你，旅行者。"
                },
                {
                    "id": "630860202",
                    "speaker": "柊千里",
                    "text": "给镰治先生送信的事情，就拜托你了。预祝一切顺利。"
                }
            ]
        },
        {
            "talkId": "6308603",
            "initDialog": "630860301",
            "dialogues": [
                {
                    "id": "630860301",
                    "speaker": "柊千里",
                    "text": "哎呀，原来是旅行者，你好！今天找我有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6308604",
            "initDialog": "630860401",
            "dialogues": [
                {
                    "id": "630860401",
                    "speaker": "Player",
                    "text": "最近如何？"
                },
                {
                    "id": "630860402",
                    "speaker": "柊千里",
                    "text": "托你的福，一切平安。"
                },
                {
                    "id": "630860403",
                    "speaker": "柊千里",
                    "text": "之前多谢你愿意为我送信。你知道，碍于我和镰治的身份，想要通信十分困难…"
                },
                {
                    "id": "630860404",
                    "speaker": "柊千里",
                    "text": "九条家的事务也想必十分繁忙，我也不想经常打扰他…欸？他说很想登门拜访吗？"
                },
                {
                    "id": "630860405",
                    "speaker": "柊千里",
                    "text": "哎呀…以现在我们两家的关系，应该还办不到吧，但是…他能有这份心意，我很开心。"
                },
                {
                    "id": "630860406",
                    "speaker": "柊千里",
                    "text": "如果不是你，我们大概很久也没办法联系到对方一次，所以真的十分感谢你。"
                }
            ]
        },
        {
            "talkId": "6308605",
            "initDialog": "630860501",
            "dialogues": [
                {
                    "id": "630860501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630860502",
                    "speaker": "柊千里",
                    "text": "再见，祝你一路顺风。"
                }
            ]
        },
        {
            "talkId": "6308606",
            "initDialog": "630860601",
            "dialogues": [
                {
                    "id": "630860601",
                    "speaker": "Player",
                    "text": "关于柊家…"
                },
                {
                    "id": "630860602",
                    "speaker": "柊千里",
                    "text": "父亲的事情…我现在也终于知道实情了。"
                },
                {
                    "id": "630860603",
                    "speaker": "柊千里",
                    "text": "原来当时那个趾高气昂的女人竟然是…"
                },
                {
                    "id": "630860604",
                    "speaker": "柊千里",
                    "text": "年迈的家父被关押起来，我作为女儿，确实很担心他的状况。"
                },
                {
                    "id": "630860605",
                    "speaker": "柊千里",
                    "text": "但…无论是谁，只要犯下错误，都要担起相应的责任。"
                },
                {
                    "id": "630860606",
                    "speaker": "柊千里",
                    "text": "至于结果如何，只能看将军大人的决断了…总之，谢谢你的关心。"
                }
            ]
        },
        {
            "talkId": "6308607",
            "initDialog": "630860701",
            "dialogues": [
                {
                    "id": "630860701",
                    "speaker": "柊千里",
                    "text": "旅行者，你好！今天找我有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6308608",
            "initDialog": "630860801",
            "dialogues": [
                {
                    "id": "630860801",
                    "speaker": "Player",
                    "text": "最近如何？"
                },
                {
                    "id": "630860802",
                    "speaker": "柊千里",
                    "text": "家里的情况远比我想得复杂，一时还难以全部掌控。"
                },
                {
                    "id": "630860803",
                    "speaker": "柊千里",
                    "text": "所幸大家都愿意听取我的意见，我可以从最简单的地方入手，慢慢把一切都梳理清楚。"
                },
                {
                    "id": "630860804",
                    "speaker": "柊千里",
                    "text": "越做越觉得，家里这些事既紧迫又很意义非凡，而且…只有我才能处理。"
                },
                {
                    "id": "630860805",
                    "speaker": "柊千里",
                    "text": "没有陷入更深的泥潭真是太好了。"
                }
            ]
        },
        {
            "talkId": "6308609",
            "initDialog": "630860901",
            "dialogues": [
                {
                    "id": "630860901",
                    "speaker": "Player",
                    "text": "继续加油吧。"
                },
                {
                    "id": "630860902",
                    "speaker": "柊千里",
                    "text": "多亏了你和社奉行大人的帮助，我一定不会辜负你们的好心好意。"
                },
                {
                    "id": "630860903",
                    "speaker": "柊千里",
                    "text": "我准备了一份薄礼，是可以随身携带的小物。如不嫌弃的话，请收下吧。"
                }
            ]
        },
        {
            "talkId": "6308610",
            "initDialog": "630861001",
            "dialogues": [
                {
                    "id": "630861001",
                    "speaker": "Player",
                    "text": "关于公告的后续…"
                },
                {
                    "id": "630861002",
                    "speaker": "柊千里",
                    "text": "松浦家已经派人处理，现在大家都认为那是一场误会。"
                },
                {
                    "id": "630861003",
                    "speaker": "柊千里",
                    "text": "虽然还有一些不太好的流言与传闻，但我相信会随着时间慢慢消失。"
                },
                {
                    "id": "630861004",
                    "speaker": "柊千里",
                    "text": "我会多加注意，希望不要再有类似的事发生了。"
                }
            ]
        },
        {
            "talkId": "6308611",
            "initDialog": "630861101",
            "dialogues": [
                {
                    "id": "630861101",
                    "speaker": "Player",
                    "text": "关于婚事…"
                },
                {
                    "id": "630861102",
                    "speaker": "柊千里",
                    "text": "在那之后，我和镰治又商量了一番，他非常支持我现在的做法。"
                },
                {
                    "id": "630861103",
                    "speaker": "柊千里",
                    "text": "「无论多久，我都会等你。」——这就是他为我留下的承诺。有了这句话，我也安心了许多。"
                },
                {
                    "id": "630861104",
                    "speaker": "柊千里",
                    "text": "虽然形式上的东西往后推迟了一些，但我们的心靠得更近，这便是令我最欣慰的收获。"
                }
            ]
        },
        {
            "talkId": "6308612",
            "initDialog": "630861201",
            "dialogues": [
                {
                    "id": "630861201",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630861202",
                    "speaker": "柊千里",
                    "text": "再见，祝你一路顺风。"
                }
            ]
        },
        {
            "talkId": "7293301",
            "initDialog": "729330101",
            "dialogues": [
                {
                    "id": "729330101",
                    "speaker": "Player",
                    "text": "举手之劳，不足挂齿。"
                },
                {
                    "id": "729330102",
                    "speaker": "柊千里",
                    "text": "不必客气，说不定…以后我还要请你帮忙呢。"
                },
                {
                    "id": "729330103",
                    "speaker": "柊千里",
                    "text": "我准备了一份薄礼，是可以随身携带的小物。如不嫌弃的话，请收下吧。"
                }
            ]
        }
    ]
}