{
    "groupId": "4070",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "阿芬迪": 14
    },
    "talks": [
        {
            "talkId": "6407001",
            "initDialog": "640700101",
            "dialogues": [
                {
                    "id": "640700101",
                    "speaker": "阿芬迪",
                    "text": "你好，欢迎来到聚砂厅，有兴趣接一些委托工作吗？"
                }
            ]
        },
        {
            "talkId": "6407002",
            "initDialog": "640700201",
            "dialogues": [
                {
                    "id": "640700201",
                    "speaker": "Player",
                    "text": "我在须弥城的声望…"
                },
                {
                    "id": "640700202",
                    "speaker": "阿芬迪",
                    "text": "如果你愿意帮忙完成一些委托任务，我可以付报酬给你。"
                }
            ]
        },
        {
            "talkId": "6407003",
            "initDialog": "640700301",
            "dialogues": [
                {
                    "id": "640700301",
                    "speaker": "阿芬迪",
                    "text": "好久不见，今天也是为了居民委托而来吗？"
                }
            ]
        },
        {
            "talkId": "6407004",
            "initDialog": "640700401",
            "dialogues": [
                {
                    "id": "640700401",
                    "speaker": "Player",
                    "text": "我在须弥城的声望…"
                },
                {
                    "id": "640700402",
                    "speaker": "阿芬迪",
                    "text": "我代表教令院感谢你为须弥城做出的贡献。"
                }
            ]
        },
        {
            "talkId": "6407005",
            "initDialog": "640700501",
            "dialogues": [
                {
                    "id": "640700501",
                    "speaker": "阿芬迪",
                    "text": "你来了，欢迎！最近如何，一切还顺利吗？"
                },
                {
                    "id": "640700502",
                    "speaker": "阿芬迪",
                    "text": "我这边又有了些新委托，你愿意帮忙的话就太好了。"
                }
            ]
        },
        {
            "talkId": "6407006",
            "initDialog": "640700601",
            "dialogues": [
                {
                    "id": "640700601",
                    "speaker": "Player",
                    "text": "我在须弥城的声望…"
                },
                {
                    "id": "640700602",
                    "speaker": "阿芬迪",
                    "text": "大家对你的工作结果评价很高，连最不爱说话的老佣兵都点头同意。真希望你能长期为我们做事啊。"
                }
            ]
        },
        {
            "talkId": "6407007",
            "initDialog": "640700701",
            "dialogues": [
                {
                    "id": "640700701",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "640700702",
                    "speaker": "阿芬迪",
                    "text": "我是教令院派至聚砂厅的联络员。"
                },
                {
                    "id": "640700703",
                    "speaker": "阿芬迪",
                    "text": "聚砂厅是「三十人团」的据点，每天都有不少镀金旅团的人来来往往。"
                },
                {
                    "id": "640700704",
                    "speaker": "阿芬迪",
                    "text": "不过我主要和掌旗官、后勤官这两位交流就行。"
                },
                {
                    "id": "640700705",
                    "speaker": "阿芬迪",
                    "text": "掌旗官以前曾是学者，后勤官也很友好，总体来说大家都是很好交流的人，也让我的工作顺利了不少。"
                },
                {
                    "id": "640700706",
                    "speaker": "阿芬迪",
                    "text": "不过「三十人团」的人还是被教令院的任务占据了太多的时间，所以我会把部分委托对外发布。"
                },
                {
                    "id": "640700707",
                    "speaker": "阿芬迪",
                    "text": "尤努斯后勤官也很支持这种做法，愿意拨出一部分军用物资用来发放报酬。"
                }
            ]
        },
        {
            "talkId": "6407008",
            "initDialog": "640700801",
            "dialogues": [
                {
                    "id": "640700801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640700802",
                    "speaker": "阿芬迪",
                    "text": "保重。"
                }
            ]
        }
    ]
}