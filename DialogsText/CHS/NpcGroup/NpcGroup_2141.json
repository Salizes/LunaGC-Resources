{
    "groupId": "2141",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "镇海": 14
    },
    "talks": [
        {
            "talkId": "6214107",
            "initDialog": "621410701",
            "dialogues": [
                {
                    "id": "621410701",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "621410702",
                    "speaker": "镇海",
                    "text": "你好，我是凝光大人的守卫。"
                },
                {
                    "id": "621410703",
                    "speaker": "镇海",
                    "text": "不过与其说是守卫…不如说只是半个打杂的文职罢了。"
                },
                {
                    "id": "621410704",
                    "speaker": "镇海",
                    "text": "之前我去四处做过不少零工，群玉阁重建之后便又被拉来做这份闲差了。"
                }
            ]
        },
        {
            "talkId": "6214101",
            "initDialog": "621410101",
            "dialogues": [
                {
                    "id": "621410101",
                    "speaker": "镇海",
                    "text": "欢迎登门，有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6214102",
            "initDialog": "621410201",
            "dialogues": [
                {
                    "id": "621410201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "621410202",
                    "speaker": "镇海",
                    "text": "你好，我是凝光大人的守卫。旅行者，你有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6214103",
            "initDialog": "621410301",
            "dialogues": [
                {
                    "id": "621410301",
                    "speaker": "Player",
                    "text": "关于凝光…"
                },
                {
                    "id": "621410302",
                    "speaker": "镇海",
                    "text": "怎么，你也来向我打探凝光大人的机密吗？不好意思，我知道的可不比你多…"
                },
                {
                    "id": "621410303",
                    "speaker": "镇海",
                    "text": "凝光大人一向不喜欢把护卫带在身边，我能在这里值班，还是多亏了表姐…"
                },
                {
                    "id": "621410304",
                    "speaker": "镇海",
                    "text": "就是百晓姐软磨硬泡才勉强定下来的…"
                }
            ]
        },
        {
            "talkId": "6214104",
            "initDialog": "621410401",
            "dialogues": [
                {
                    "id": "621410401",
                    "speaker": "Player",
                    "text": "关于锻炼身体…"
                },
                {
                    "id": "621410402",
                    "speaker": "镇海",
                    "text": "怎么，你也对锻炼感兴趣吗？不如等哪天我休假，我们去找个地方交流一下吧？"
                },
                {
                    "id": "621410403",
                    "speaker": "镇海",
                    "text": "我虽说是千岩军文职，但总想再把身体练得壮一点…"
                },
                {
                    "id": "621410404",
                    "speaker": "镇海",
                    "text": "所以我常常会打些苦力类的零工，健壮的男人才更有魅力不是吗？"
                }
            ]
        },
        {
            "talkId": "6214105",
            "initDialog": "621410305",
            "dialogues": [
                {
                    "id": "621410305",
                    "speaker": "Player",
                    "text": "表姐…？"
                },
                {
                    "id": "621410306",
                    "speaker": "镇海",
                    "text": "…啊，什么表姐？！"
                },
                {
                    "id": "621410307",
                    "speaker": "镇海",
                    "text": "别乱说啊！我什么都没说，你什么也没听到！"
                }
            ]
        },
        {
            "talkId": "6214106",
            "initDialog": "621410601",
            "dialogues": [
                {
                    "id": "621410601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621410602",
                    "speaker": "镇海",
                    "text": "贵客慢走。"
                }
            ]
        }
    ]
}