{
    "groupId": "9014",
    "total_dialogue_lines": 60,
    "speaker_counts": {
        "Player": 17,
        "芭芭拉": 43
    },
    "talks": [
        {
            "talkId": "6901401",
            "initDialog": "690140101",
            "dialogues": [
                {
                    "id": "690140101",
                    "speaker": "芭芭拉",
                    "text": "#你好呀，{NICKNAME}。"
                },
                {
                    "id": "690140102",
                    "speaker": "芭芭拉",
                    "text": "看见你那么有精神的样子，我就放心啦。"
                }
            ]
        },
        {
            "talkId": "6901402",
            "initDialog": "690140201",
            "dialogues": [
                {
                    "id": "690140201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690140701",
                    "speaker": "芭芭拉",
                    "text": "嗯，我很喜欢这里！"
                },
                {
                    "id": "690140702",
                    "speaker": "芭芭拉",
                    "text": "与蒙德城不同的风景，对我来说很有新鲜感。"
                },
                {
                    "id": "690140703",
                    "speaker": "芭芭拉",
                    "text": "练习唱歌的时候，也可以放开歌喉。不用担心万一打扰到了别人该怎么办。",
                    "choices": [
                        {
                            "id": "690140704",
                            "text": "芭芭拉的歌声不能说是打扰吧。",
                            "response": [
                                {
                                    "id": "690140705",
                                    "speaker": "芭芭拉",
                                    "text": "唔…"
                                },
                                {
                                    "id": "690140706",
                                    "speaker": "芭芭拉",
                                    "text": "谢谢你能这样说。但我…还是要多考虑点别人的感受嘛。"
                                },
                                {
                                    "id": "690140707",
                                    "speaker": "芭芭拉",
                                    "text": "总之，我很开心能收到你的邀请。"
                                },
                                {
                                    "id": "690140710",
                                    "speaker": "芭芭拉",
                                    "text": "我还想在这里多待一会儿。"
                                }
                            ]
                        },
                        {
                            "id": "690140708",
                            "text": "那就太好了。",
                            "response": [
                                {
                                    "id": "690140709",
                                    "speaker": "芭芭拉",
                                    "text": "嗯，我很开心能收到你的邀请。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901403",
            "initDialog": "690140301",
            "dialogues": [
                {
                    "id": "690140301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690140801",
                    "speaker": "芭芭拉",
                    "text": "啊，好的！"
                },
                {
                    "id": "690140802",
                    "speaker": "芭芭拉",
                    "text": "嘿嘿…",
                    "choices": [
                        {
                            "id": "690140803",
                            "text": "你怎么突然笑了。",
                            "response": [
                                {
                                    "id": "690140805",
                                    "speaker": "芭芭拉",
                                    "text": "啊，我刚刚意识到，自己很久没有像现在这样，轻轻松松地和朋友聊天。"
                                },
                                {
                                    "id": "690140806",
                                    "speaker": "芭芭拉",
                                    "text": "突然就觉得很幸福。",
                                    "choices": [
                                        {
                                            "id": "690140807",
                                            "text": "芭芭拉很容易满足啊。",
                                            "response": [
                                                {
                                                    "id": "690140808",
                                                    "speaker": "芭芭拉",
                                                    "text": "唔，唔，是这样吗…"
                                                },
                                                {
                                                    "id": "690140809",
                                                    "speaker": "芭芭拉",
                                                    "text": "好像，这也不是什么坏事。"
                                                },
                                                {
                                                    "id": "690140810",
                                                    "speaker": "芭芭拉",
                                                    "text": "很容易就感到幸福的话，就会有很多的能量，然后就可以把幸福的感觉传递给别人。"
                                                },
                                                {
                                                    "id": "690140815",
                                                    "speaker": "芭芭拉",
                                                    "text": "唔，你不要总是夸我啦…"
                                                },
                                                {
                                                    "id": "690140816",
                                                    "speaker": "芭芭拉",
                                                    "text": "有批评…才会有进步，对吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690140811",
                                            "text": "因为芭芭拉总是在为别人考虑。",
                                            "response": [
                                                {
                                                    "id": "690140812",
                                                    "speaker": "芭芭拉",
                                                    "text": "那也是理所当然的嘛。"
                                                },
                                                {
                                                    "id": "690140813",
                                                    "speaker": "芭芭拉",
                                                    "text": "我一直受到大家的照顾，我也想用自己的努力来回应这些善意。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690140814",
                                            "text": "真不愧是芭芭拉啊。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690140804",
                            "text": "想到什么有趣的事情了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901404",
            "initDialog": "690140401",
            "dialogues": [
                {
                    "id": "690140401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690140901",
                    "speaker": "芭芭拉",
                    "text": "啊，我最近练习了一首新的曲子。"
                },
                {
                    "id": "690140902",
                    "speaker": "芭芭拉",
                    "text": "但有些细节我还把握不好…"
                },
                {
                    "id": "690140903",
                    "speaker": "芭芭拉",
                    "text": "副歌在重复的时候要不要升个调，舞步有没有优化的空间…"
                },
                {
                    "id": "690140904",
                    "speaker": "芭芭拉",
                    "text": "如果不麻烦你的话，我希望你能看我的表演，再给我一些建议。",
                    "choices": [
                        {
                            "id": "690140905",
                            "text": "我会为你「全力应援」。",
                            "response": [
                                {
                                    "id": "690140907",
                                    "speaker": "芭芭拉",
                                    "text": "谢谢…"
                                },
                                {
                                    "id": "690140908",
                                    "speaker": "芭芭拉",
                                    "text": "唔…如果有不成熟的地方，不要笑话我哦。"
                                },
                                {
                                    "id": "690140909",
                                    "speaker": "芭芭拉",
                                    "text": "我思考过很多次，现在是鼓起勇气，才敢在那么近的地方表演给你看的。"
                                },
                                {
                                    "id": "690140910",
                                    "speaker": "芭芭拉",
                                    "text": "要是你笑话我的话，我都不知道要往哪里躲…",
                                    "choices": [
                                        {
                                            "id": "690140911",
                                            "text": "不会的，放心吧。",
                                            "response": [
                                                {
                                                    "id": "690140913",
                                                    "speaker": "芭芭拉",
                                                    "text": "呼…好。"
                                                },
                                                {
                                                    "id": "690140914",
                                                    "speaker": "芭芭拉",
                                                    "text": "那么…"
                                                },
                                                {
                                                    "id": "690140915",
                                                    "speaker": "芭芭拉",
                                                    "text": "演唱，开始！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690140912",
                                            "text": "我相信你哦，芭芭拉也要相信自己。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690140906",
                            "text": "这是我的荣幸。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901405",
            "initDialog": "690140501",
            "dialogues": [
                {
                    "id": "690140501",
                    "speaker": "Player",
                    "text": "早啊，芭芭拉。"
                },
                {
                    "id": "690141001",
                    "speaker": "芭芭拉",
                    "text": "早！祝愿你度过美好的一天。"
                },
                {
                    "id": "690141002",
                    "speaker": "芭芭拉",
                    "text": "我会为你祈祷的。"
                }
            ]
        },
        {
            "talkId": "6901406",
            "initDialog": "690140601",
            "dialogues": [
                {
                    "id": "690140601",
                    "speaker": "Player",
                    "text": "晚安，芭芭拉。"
                },
                {
                    "id": "690141101",
                    "speaker": "芭芭拉",
                    "text": "晚安，愿你做个美梦。"
                }
            ]
        },
        {
            "talkId": "6901412",
            "initDialog": "690141201",
            "dialogues": [
                {
                    "id": "690141201",
                    "speaker": "芭芭拉",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6901413",
            "initDialog": "690141301",
            "dialogues": [
                {
                    "id": "690141301",
                    "speaker": "芭芭拉",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6901414",
            "initDialog": "690141401",
            "dialogues": [
                {
                    "id": "690141401",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6901450",
            "initDialog": "690145001",
            "dialogues": [
                {
                    "id": "690145001",
                    "speaker": "芭芭拉",
                    "text": "好整洁的卧室，让我想起了骑士团的客房。"
                },
                {
                    "id": "690145002",
                    "speaker": "芭芭拉",
                    "text": "要是增加一些可爱的饰品，休息的时候就更舒服了…"
                },
                {
                    "id": "690145003",
                    "speaker": "芭芭拉",
                    "text": "有空的话，我们一起去采购吧！"
                }
            ]
        },
        {
            "talkId": "6901451",
            "initDialog": "690145101",
            "dialogues": [
                {
                    "id": "690145101",
                    "speaker": "芭芭拉",
                    "text": "穿过这座公园的风，带来了熟悉的气息。"
                },
                {
                    "id": "690145102",
                    "speaker": "芭芭拉",
                    "text": "如果午后在这边小憩片刻，听听流水的细语，感觉心情也会跟着放松下来。"
                },
                {
                    "id": "690145103",
                    "speaker": "芭芭拉",
                    "text": "谢谢你！我很喜欢这里！"
                }
            ]
        }
    ]
}