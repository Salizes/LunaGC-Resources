{
    "groupId": "6094",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "卡乌胡": 12
    },
    "talks": [
        {
            "talkId": "6609401",
            "initDialog": "660940101",
            "dialogues": [
                {
                    "id": "660940101",
                    "speaker": "卡乌胡",
                    "text": "「不要畏惧失败与死亡，它们是荣耀到来的前兆。」"
                }
            ]
        },
        {
            "talkId": "6609402",
            "initDialog": "660940201",
            "dialogues": [
                {
                    "id": "660940201",
                    "speaker": "Player",
                    "text": "关于我在「回声之子」的声望…"
                },
                {
                    "id": "660940202",
                    "speaker": "卡乌胡",
                    "text": "感谢你的帮助，祝你在纷争的国度永无败绩。"
                }
            ]
        },
        {
            "talkId": "6609403",
            "initDialog": "660940301",
            "dialogues": [
                {
                    "id": "660940301",
                    "speaker": "Player",
                    "text": "你好，这里是…"
                },
                {
                    "id": "660940302",
                    "speaker": "卡乌胡",
                    "text": "啊，此物是部族信仰的中心，纳塔部族的「曜石图腾柱」，是各部族与夜神之国连接的象征。"
                },
                {
                    "id": "660940303",
                    "speaker": "卡乌胡",
                    "text": "但并不是每个纳塔人都能通过图腾柱和夜神之国的大灵对话。"
                },
                {
                    "id": "660940304",
                    "speaker": "卡乌胡",
                    "text": "只有极少数德高望重或者能力突出的人能做到，而且大多集中在烟谜主。"
                },
                {
                    "id": "660940305",
                    "speaker": "卡乌胡",
                    "text": "不过，如果能够帮助部族完成一些委托，说不定你也能得到回应。"
                },
                {
                    "id": "660940306",
                    "speaker": "卡乌胡",
                    "text": "部族里经常有需要人手的事务，如果你感兴趣的话，就来试试吧。"
                }
            ]
        },
        {
            "talkId": "6609404",
            "initDialog": "660940401",
            "dialogues": [
                {
                    "id": "660940401",
                    "speaker": "Player",
                    "text": "失败与死亡…"
                },
                {
                    "id": "660940402",
                    "speaker": "卡乌胡",
                    "text": "哈哈，你可能有所不知，在纳塔，失败的战士也有重新来过的机会。"
                },
                {
                    "id": "660940403",
                    "speaker": "卡乌胡",
                    "text": "只要你像我一样拥有「古名」，并且与你并肩作战的伙伴取得胜利，即便自己失败了，也有再次回到战场的机会。"
                },
                {
                    "id": "660940404",
                    "speaker": "卡乌胡",
                    "text": "毫不避讳地讲，我经历过死亡…体验并不好受，但幸好我不是孤军奋战。"
                },
                {
                    "id": "660940405",
                    "speaker": "卡乌胡",
                    "text": "唉，不过我的年纪也渐渐大了…也许有一天，我的「古名」会带着我的故事，找到新的主人。"
                }
            ]
        },
        {
            "talkId": "6609405",
            "initDialog": "660940501",
            "dialogues": [
                {
                    "id": "660940501",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "660940502",
                    "speaker": "卡乌胡",
                    "text": "谢谢你，朋友。"
                }
            ]
        }
    ]
}