{
    "groupId": "3056",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "御舆源次郎": 11
    },
    "talks": [
        {
            "talkId": "6305601",
            "initDialog": "630560101",
            "dialogues": [
                {
                    "id": "630560101",
                    "speaker": "御舆源次郎",
                    "text": "你好。如果是公务的话，请讲明你的身份、来由、交付时限。"
                },
                {
                    "id": "630560102",
                    "speaker": "御舆源次郎",
                    "text": "如果不是公务的话，我没空闲聊。"
                }
            ]
        },
        {
            "talkId": "6305602",
            "initDialog": "630560201",
            "dialogues": [
                {
                    "id": "630560201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630560202",
                    "speaker": "御舆源次郎",
                    "text": "我叫御舆源次郎，是隶属天领奉行的官员。"
                },
                {
                    "id": "630560203",
                    "speaker": "御舆源次郎",
                    "text": "什么…你原来不是来交接工作的人吗。那请你离开吧。"
                },
                {
                    "id": "630560204",
                    "speaker": "御舆源次郎",
                    "text": "像我这样的精英，每天不是执行公务就是忙于提升自己的能力。毕竟优胜劣汰，只有足够优秀的人才能生存下去。"
                }
            ]
        },
        {
            "talkId": "6305603",
            "initDialog": "630560301",
            "dialogues": [
                {
                    "id": "630560301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630560302",
                    "speaker": "御舆源次郎",
                    "text": "再见吧。"
                }
            ]
        },
        {
            "talkId": "6305604",
            "initDialog": "630560401",
            "dialogues": [
                {
                    "id": "630560401",
                    "speaker": "Player",
                    "text": "关于工作…"
                },
                {
                    "id": "630560402",
                    "speaker": "御舆源次郎",
                    "text": "我认为，每个人都应该认真对待自己的工作，这样才能保证整个体系的顺利运转。"
                },
                {
                    "id": "630560403",
                    "speaker": "御舆源次郎",
                    "text": "像是军队的那些人，过了这么长时间还是没能战胜珊瑚宫，实在可笑。"
                },
                {
                    "id": "630560404",
                    "speaker": "御舆源次郎",
                    "text": "我还听说珊瑚宫军队是「狗」在担任大将…如果传闻属实，那九条裟罗也未免太无用了！"
                }
            ]
        },
        {
            "talkId": "6305605",
            "initDialog": "630560501",
            "dialogues": [
                {
                    "id": "630560501",
                    "speaker": "Player",
                    "text": "御舆源一郎是你的哥哥？"
                },
                {
                    "id": "630560502",
                    "speaker": "御舆源次郎",
                    "text": "嘁…那个不成器的家伙，守着一家简陋的小店就满足了。这么多年了还是老样子，不思进取。"
                },
                {
                    "id": "630560503",
                    "speaker": "御舆源次郎",
                    "text": "从小就可以看出他不是能成就一番事业的人。我们御舆家的未来，还是要靠我来振兴。"
                }
            ]
        }
    ]
}