{
    "groupId": "1601",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "诺拉": 13
    },
    "talks": [
        {
            "talkId": "6160101",
            "initDialog": "616010101",
            "dialogues": [
                {
                    "id": "616010101",
                    "speaker": "诺拉",
                    "text": "啊，什么！你要陪诺拉玩吗？"
                }
            ]
        },
        {
            "talkId": "6160102",
            "initDialog": "616010201",
            "dialogues": [
                {
                    "id": "616010201",
                    "speaker": "Player",
                    "text": "你的家人呢？"
                },
                {
                    "id": "616010202",
                    "speaker": "诺拉",
                    "text": "我的爸爸是巴顿！"
                },
                {
                    "id": "616010203",
                    "speaker": "诺拉",
                    "text": "就在醉醺醺的大叔们经常出现的那边。"
                },
                {
                    "id": "616010204",
                    "speaker": "诺拉",
                    "text": "爸爸工作很忙，所以诺拉就自己玩！"
                }
            ]
        },
        {
            "talkId": "6160103",
            "initDialog": "616010301",
            "dialogues": [
                {
                    "id": "616010301",
                    "speaker": "Player",
                    "text": "你在玩什么？"
                },
                {
                    "id": "616010302",
                    "speaker": "诺拉",
                    "text": "诺拉喜欢在神像下面玩！"
                },
                {
                    "id": "616010303",
                    "speaker": "诺拉",
                    "text": "神像又高又漂亮。"
                },
                {
                    "id": "616010304",
                    "speaker": "诺拉",
                    "text": "你有爬到过上面去吗？那天诺拉想要爬上去，却被葛瑞丝阿姨训了。"
                },
                {
                    "id": "616010305",
                    "speaker": "诺拉",
                    "text": "葛瑞丝阿姨是好人，诺拉不愿意再给她添麻烦。"
                },
                {
                    "id": "616010306",
                    "speaker": "诺拉",
                    "text": "如果你能爬上去的话，就把上面的景色讲给诺拉听吧。"
                }
            ]
        },
        {
            "talkId": "6160104",
            "initDialog": "616010401",
            "dialogues": [
                {
                    "id": "616010401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616010402",
                    "speaker": "诺拉",
                    "text": "欸，你也要走了吗？"
                }
            ]
        },
        {
            "talkId": "6160105",
            "initDialog": "616010501",
            "dialogues": [
                {
                    "id": "616010501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "616010502",
                    "speaker": "诺拉",
                    "text": "爸爸说一定是诺拉那次想要爬到风神像上面，所以才引来了风魔龙…"
                },
                {
                    "id": "616010503",
                    "speaker": "诺拉",
                    "text": "诺拉做错了！诺拉再也不想爬神像了…呜呜…"
                },
                {
                    "id": "616010504",
                    "speaker": "诺拉",
                    "text": "…巴巴托斯大人不要生气了嘛，呜呜呜…"
                }
            ]
        }
    ]
}