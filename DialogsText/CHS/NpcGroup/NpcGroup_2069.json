{
    "groupId": "2069",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "金钟": 15
    },
    "talks": [
        {
            "talkId": "4003743",
            "initDialog": "400374301",
            "dialogues": [
                {
                    "id": "400374301",
                    "speaker": "金钟",
                    "text": "你好，这附近禁止大声喧哗和商业宣传…啊抱歉，不好意思认错人了。"
                },
                {
                    "id": "400374302",
                    "speaker": "金钟",
                    "text": "最近总有往生堂的人到这边来…呃，做什么业务拓展，着实令人头痛，还请见谅。"
                },
                {
                    "id": "400374303",
                    "speaker": "金钟",
                    "text": "那么言归正传，请问你是有什么事情要汇报吗？"
                }
            ]
        },
        {
            "talkId": "6206901",
            "initDialog": "620690101",
            "dialogues": [
                {
                    "id": "620690101",
                    "speaker": "金钟",
                    "text": "嗯，你好，有什么事情要汇报吗？"
                },
                {
                    "id": "620690102",
                    "speaker": "金钟",
                    "text": "我批准了。"
                }
            ]
        },
        {
            "talkId": "6206902",
            "initDialog": "620690201",
            "dialogues": [
                {
                    "id": "620690201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "620690202",
                    "speaker": "金钟",
                    "text": "我？"
                },
                {
                    "id": "620690203",
                    "speaker": "金钟",
                    "text": "鄙人金钟，是负责守卫玉京台居民区的千岩军。"
                },
                {
                    "id": "620690204",
                    "speaker": "金钟",
                    "text": "如果有什么事情要汇报的话麻烦尽快，毕竟护卫玉京台的达官贵人们可是重中之重啊。"
                }
            ]
        },
        {
            "talkId": "6206903",
            "initDialog": "620690301",
            "dialogues": [
                {
                    "id": "620690301",
                    "speaker": "Player",
                    "text": "你住在玉京台？"
                },
                {
                    "id": "620690302",
                    "speaker": "金钟",
                    "text": "并不是，其实我全家都在吃虎岩，我的父母都是渔民。"
                },
                {
                    "id": "620690303",
                    "speaker": "金钟",
                    "text": "不过我现在在玉京台驻守，这就标志着我已经迈入上流社会了——起码工作时间内都在玉京台内不是吗。"
                },
                {
                    "id": "620690304",
                    "speaker": "金钟",
                    "text": "虽然目前我还是一个站岗巡逻的千岩军，但相信在不久的将来，我一定能在玉京台扎根…"
                },
                {
                    "id": "620690305",
                    "speaker": "金钟",
                    "text": "…从此成为一个住在玉京台的上流人士。"
                },
                {
                    "id": "620690306",
                    "speaker": "金钟",
                    "text": "到时候有什么需要我帮忙的，可以跟我讲，哼哼…"
                }
            ]
        },
        {
            "talkId": "6206904",
            "initDialog": "620690401",
            "dialogues": [
                {
                    "id": "620690401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620690402",
                    "speaker": "金钟",
                    "text": "千岩牢固，重嶂不移。"
                },
                {
                    "id": "620690403",
                    "speaker": "金钟",
                    "text": "如果有重要情况的话记得向我汇报。"
                }
            ]
        }
    ]
}