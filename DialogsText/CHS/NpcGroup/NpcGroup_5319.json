        {
            "talkId": "6531901",
            "initDialog": "653190101",
            "dialogues": [
                {
                    "id": "653190101",
                    "speaker": "希洛娜",
                    "text": "哎呀，如果嘉莱娜以后想要加入「逐影庭」的话，我也要加油了…啊，就稍微加一点吧…"
                }
            ]
        },
        {
            "talkId": "6531902",
            "initDialog": "653190201",
            "dialogues": [
                {
                    "id": "653190201",
                    "speaker": "Player",
                    "text": "为什么想加入「逐影庭」？"
                },
                {
                    "id": "653190202",
                    "speaker": "希洛娜",
                    "text": "啊，真要说的话，也没有那么想进「逐影庭」啦…只不过是因为嘉莱娜想去。"
                },
                {
                    "id": "653190203",
                    "speaker": "希洛娜",
                    "text": "嘉莱娜呀，性格稍微有点冲动，做事情也有些毛手毛脚，好胜心还很强，嘿嘿，这也是她可爱的地方嘛。"
                },
                {
                    "id": "653190204",
                    "speaker": "希洛娜",
                    "text": "不过，哎呀，如果她真的进了「逐影庭」，就有点让人担心了。"
                },
                {
                    "id": "653190205",
                    "speaker": "希洛娜",
                    "text": "所以如果嘉莱娜想去的话，我也得一起跟着去。"
                }
            ]
        },
        {
            "talkId": "6531903",
            "initDialog": "653190301",
            "dialogues": [
                {
                    "id": "653190301",
                    "speaker": "Player",
                    "text": "祝你成功…"
                },
                {
                    "id": "653190302",
                    "speaker": "希洛娜",
                    "text": "哈哈，要不还是先祝嘉莱娜能够成功吧…"
                }
            ]
        }
    ]
}