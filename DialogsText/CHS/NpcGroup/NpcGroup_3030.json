    },
    "talks": [
        {
            "talkId": "4006320",
            "initDialog": "400632001",
            "dialogues": [
                {
                    "id": "400632001",
                    "speaker": "荒谷",
                    "text": "嗯，这个问题已经解决，该思考接下来的活动了…要不要增加新的抽奖方式呢…"
                },
                {
                    "id": "400632002",
                    "speaker": "荒谷",
                    "text": "除了祭典之外，其他的企划也不能怠慢…"
                },
                {
                    "id": "400632003",
                    "speaker": "荒谷",
                    "text": "啊，说起来，最近离岛「那边」的书也快到了，可以参考…"
                }
            ]
        },
        {
            "talkId": "6303001",
            "initDialog": "630300101",
            "dialogues": [
                {
                    "id": "630300101",
                    "speaker": "荒谷",
                    "text": "要不要做期特别刊呢…接力连载也不错…"
                },
                {
                    "id": "630300102",
                    "speaker": "荒谷",
                    "text": "啊，说起来，最近离岛「那边」的书也快到了，可以参考…"
                }
            ]
        },
        {
            "talkId": "6303002",
            "initDialog": "630300201",
            "dialogues": [
                {
                    "id": "630300201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630300202",
                    "speaker": "荒谷",
                    "text": "我在八重堂出版社工作，负责各项企划的策划和推进。"
                },
                {
                    "id": "630300203",
                    "speaker": "荒谷",
                    "text": "比如「这本小说真厉害！」比赛，就是我提议、组织，一手操办起来的。"
                },
                {
                    "id": "630300204",
                    "speaker": "荒谷",
                    "text": "一开始我的上司平冢还不肯批准，不知道是因为死脑筋，还是只是单纯地不想做麻烦活儿…"
                },
                {
                    "id": "630300205",
                    "speaker": "荒谷",
                    "text": "还好我一再坚持，并且答应自己完成所有的工作，比赛才最后举办起来。"
                },
                {
                    "id": "630300206",
                    "speaker": "荒谷",
                    "text": "你看，「这本小说真厉害！」现在不是成了八重堂最受瞩目的企划了，所有的轻小说读者都在关注比赛结果。不愧是我。"
                },
                {
                    "id": "630300207",
                    "speaker": "荒谷",
                    "text": "最近我正在筹备更新的企划，拭目以待吧。"
                }
            ]
        },
        {
            "talkId": "6303003",
            "initDialog": "630300301",
            "dialogues": [
                {
                    "id": "630300301",
                    "speaker": "Player",
                    "text": "离岛「那边」的书？"
                },
                {
                    "id": "630300302",
                    "speaker": "荒谷",
                    "text": "欸！你听到了？这…唔，算了，你是异国人吧，应该可以理解我。"
                },
                {
                    "id": "630300303",
                    "speaker": "荒谷",
                    "text": "因为锁国令的缘故，外国的书籍越来越难买了。可是我的工作依赖创意，怎么能不多了解新东西呢？"
                },
                {
                    "id": "630300304",
                    "speaker": "荒谷",
                    "text": "所以我会偷偷委托能出入稻妻的人，从国外带些新书给我。如果离岛有被扣押的书籍，也一并运进来。"
                },
                {
                    "id": "630300305",
                    "speaker": "荒谷",
                    "text": "你可要替我保守秘密啊。作为交换，下次有了新书可以借给你看。"
                }
            ]
        },
        {
            "talkId": "6303004",
            "initDialog": "630300401",
            "dialogues": [
                {
                    "id": "630300401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630300402",
                    "speaker": "荒谷",
                    "text": "嗯，就这么办…哦，再见。"
                }
            ]
        },
        {
            "talkId": "6303005",
            "initDialog": "630300501",
            "dialogues": [
                {
                    "id": "630300501",
                    "speaker": "Player",
                    "text": "关于名叫墨田的小说家…"
                },
                {
                    "id": "630300502",
                    "speaker": "荒谷",
                    "text": "墨田…这么说来，也有一段时间没见到她了呢。"
                },
                {
                    "id": "630300503",
                    "speaker": "荒谷",
                    "text": "之前郑重其事地向我道别说要外出旅行，并且说等她回来的时候，一定会拿下「这本小说真厉害！」的大奖。"
                },
                {
                    "id": "630300504",
                    "speaker": "荒谷",
                    "text": "虽然她至今还没有完成过一本小说…"
                }
            ]
        },
        {
            "talkId": "6303006",
            "initDialog": "630300601",
            "dialogues": [
                {
                    "id": "630300601",
                    "speaker": "Player",
                    "text": "从来没有完成过…？"
                },
                {
                    "id": "630300602",
                    "speaker": "荒谷",
                    "text": "嗯。她的想法太过跳跃，自我要求又实在太高，所以经常半途而废。"
                },
                {
                    "id": "630300603",
                    "speaker": "荒谷",
                    "text": "但是，我对她有着很高的期待。因为，这样的人写出来的故事，往往是最好的。"
                },
                {
                    "id": "630300604",
                    "speaker": "荒谷",
                    "text": "希望她能信守诺言。把配得上大奖的稿子，当作旅行的纪念品带给我。"
                }
            ]
        },
        {
            "talkId": "6303007",
            "initDialog": "630300701",
            "dialogues": [
                {
                    "id": "630300701",
                    "speaker": "Player",
                    "text": "离岛「那边」的书？"
                },
                {
                    "id": "630300702",
                    "speaker": "荒谷",
                    "text": "对啊，我的工作依赖创意，怎么能不多了解新东西呢？"
                },
                {
                    "id": "630300703",
                    "speaker": "荒谷",
                    "text": "所以我常常拜托朋友从国外带些新书给我。如果离岛那被扣押的非法货物里有书籍，也一并运进来。"
                },
                {
                    "id": "630300704",
                    "speaker": "荒谷",
                    "text": "当然关于那些被扣押的书…你可要替我保守秘密啊。作为交换，下次有了新书可以借给你看。"
                }
            ]
        },
        {
            "talkId": "7280601",
            "initDialog": "728060101",
            "dialogues": [
                {
                    "id": "728060101",
                    "speaker": "荒谷",
                    "text": "这种时候…怎么联系这两位老师呢…"
                },
                {
                    "id": "728060102",
                    "speaker": "Player",
                    "text": "联系什么？"
                },
                {
                    "id": "728060103",
                    "speaker": "荒谷",
                    "text": "欸！是旅行者啊，你…你来得正好，我正有事想请人帮忙呢。"
                },
                {
                    "id": "728060104",
                    "speaker": "荒谷",
                    "text": "是这样，「八重堂」一年一度的小说比赛就快要开始了，按照惯例，我们打算邀请几位作家老师来当评委。"
                },
                {
                    "id": "728060105",
                    "speaker": "荒谷",
                    "text": "但是…有两位老师并不是稻妻人，目前也不在稻妻国内。"
                },
                {
                    "id": "728060106",
                    "speaker": "荒谷",
                    "text": "您也知道，眼下这种时候，实在没法邀请国外人士过来。"
                },
                {
                    "id": "728060107",
                    "speaker": "荒谷",
                    "text": "但这种大事，如果不给作者老师们知会一声，也不太合适…"
                },
                {
                    "id": "728060108",
                    "speaker": "荒谷",
                    "text": "所以我就想着，至少托人送点礼物过去，也算是不失了礼节，顺便还可以再附信一封，预约一下往后的稿子，咳…"
                },
                {
                    "id": "728060109",
                    "speaker": "荒谷",
                    "text": "不知道，您意下如何呀？",
                    "choices": [
                        {
                            "id": "728060110",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "728060111",
                                    "speaker": "荒谷",
                                    "text": "那就拜托你了，旅行者。"
                                },
                                {
                                    "id": "728060114",
                                    "speaker": "荒谷",
                                    "text": "常九爷的小说《古华派的大师兄》，叙述的是一个出身古典宗门的璃月大师兄与异国的稻妻小师妹之间的江湖故事。"
                                },
                                {
                                    "id": "728060115",
                                    "speaker": "荒谷",
                                    "text": "要我说的话，题材和剧情其实都有些老套了，但好在还有一些读者买账，销量也还可以。"
                                },
                                {
                                    "id": "728060116",
                                    "speaker": "荒谷",
                                    "text": "我们也总结过几封意见信，托人带给常九爷，希望能帮助他在后续的作品里做出一些突破…"
                                },
                                {
                                    "id": "728060117",
                                    "speaker": "荒谷",
                                    "text": "但信寄出去之后却一直杳无回音，也不知道是送丢了，还是怎么回事…"
                                },
                                {
                                    "id": "728060118",
                                    "speaker": "Player",
                                    "text": "「枕玉」是谁？"
                                },
                                {
                                    "id": "728060119",
                                    "speaker": "荒谷",
                                    "text": "那我可不知道，应该是这位老师的笔名吧。"
                                },
                                {
                                    "id": "728060120",
                                    "speaker": "荒谷",
                                    "text": "这位老师写的《沉秋拾剑录》？这可是引起轰动的著作！"
                                },
                                {
                                    "id": "728060121",
                                    "speaker": "荒谷",
                                    "text": "无论是设定还是剧情，都大大地引领了一波创作的风潮。"
                                },
                                {
                                    "id": "728060122",
                                    "speaker": "Player",
                                    "text": "那我要去哪找这位老师…"
                                },
                                {
                                    "id": "728060123",
                                    "speaker": "荒谷",
                                    "text": "呃…这个…这位老师应该也是在璃月。据那位把这本《沉秋拾剑录》带回稻妻的客商说，他是在「万文集舍」里看见的这本书。"
                                },
                                {
                                    "id": "728060124",
                                    "speaker": "荒谷",
                                    "text": "我想，问问「万文集舍」的人，应该就能找到这位老师了。"
                                },
                                {
                                    "id": "728060125",
                                    "speaker": "荒谷",
                                    "text": "不过…咳！先不说这些了，这些礼物和信件请你拿好了，这件事就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "728060112",
                            "text": "那两位老师分别是谁？",
                            "response": [
                                {
                                    "id": "728060113",
                                    "speaker": "荒谷",
                                    "text": "那两位老师一位叫「枕玉」，一位是叫…常九爷。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
