{
    "groupId": "5086",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "伊诺米娅": 11
    },
    "talks": [
        {
            "talkId": "6508601",
            "initDialog": "650860101",
            "dialogues": [
                {
                    "id": "650860101",
                    "speaker": "伊诺米娅",
                    "text": "凡事都有正确的度量标准，我更喜欢这样的工作呢。"
                }
            ]
        },
        {
            "talkId": "6508602",
            "initDialog": "650860201",
            "dialogues": [
                {
                    "id": "650860201",
                    "speaker": "Player",
                    "text": "「更」？"
                },
                {
                    "id": "650860202",
                    "speaker": "伊诺米娅",
                    "text": "嗯，我是说与我之前在宣传部的工作相比。"
                },
                {
                    "id": "650860203",
                    "speaker": "伊诺米娅",
                    "text": "我始终理解不了有些旧同事的思维，他们的脑子里似乎翻腾着大瀑布，冲走了所有的理智。"
                },
                {
                    "id": "650860204",
                    "speaker": "伊诺米娅",
                    "text": "「咱们应该在沫芒宫门口建一座最高审判官大人的半身像！」"
                },
                {
                    "id": "650860205",
                    "speaker": "伊诺米娅",
                    "text": "——好像嫌办公场所的外来人员还不够多似的。"
                }
            ]
        },
        {
            "talkId": "6508603",
            "initDialog": "650860301",
            "dialogues": [
                {
                    "id": "650860301",
                    "speaker": "Player",
                    "text": "关于度量标准…"
                },
                {
                    "id": "650860302",
                    "speaker": "伊诺米娅",
                    "text": "这就是我现在的工作重点了。"
                },
                {
                    "id": "650860303",
                    "speaker": "伊诺米娅",
                    "text": "你知道，生活在不同地区的人，对计量的感知习惯是不一样。"
                },
                {
                    "id": "650860304",
                    "speaker": "伊诺米娅",
                    "text": "城东的人说某条绳子有四分之一米，而城西的人则大惊小怪：「你说的四分之一米究竟是多少呢？」"
                },
                {
                    "id": "650860305",
                    "speaker": "伊诺米娅",
                    "text": "我的工作就是把这些对不上的东西都对对齐，再起个通用的名字来替代，就叫「沫芒米」之类的。"
                },
                {
                    "id": "650860306",
                    "speaker": "伊诺米娅",
                    "text": "…刚刚只是举个例子，请不要真的相信。"
                }
            ]
        },
        {
            "talkId": "6508604",
            "initDialog": "650860401",
            "dialogues": [
                {
                    "id": "650860401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650860402",
                    "speaker": "伊诺米娅",
                    "text": "再见。"
                }
            ]
        }
    ]
}