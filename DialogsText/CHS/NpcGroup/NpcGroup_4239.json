{
    "groupId": "4239",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "兰修提袈": 12
    },
    "talks": [
        {
            "talkId": "6423901",
            "initDialog": "642390101",
            "dialogues": [
                {
                    "id": "642390101",
                    "speaker": "兰修提袈",
                    "text": "#那菈{NICKNAME}在准备无忧节，这次无忧节一定会成为温暖的歌。"
                }
            ]
        },
        {
            "talkId": "6423902",
            "initDialog": "642390201",
            "dialogues": [
                {
                    "id": "642390201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "642390202",
                    "speaker": "兰修提袈",
                    "text": "#兰修提袈想现在就和那菈{NICKNAME}一起歌唱。"
                },
                {
                    "id": "642390203",
                    "speaker": "兰修提袈",
                    "text": "#可是那菈{NICKNAME}还要与兰罗摩一起准备无忧节。"
                },
                {
                    "id": "642390204",
                    "speaker": "兰修提袈",
                    "text": "如果感到疲倦，就来听一听采歌者们的歌吧。"
                }
            ]
        },
        {
            "talkId": "6423903",
            "initDialog": "642390301",
            "dialogues": [
                {
                    "id": "642390301",
                    "speaker": "Player",
                    "text": "关于兰玛哈…"
                },
                {
                    "id": "642390302",
                    "speaker": "兰修提袈",
                    "text": "#谢谢那菈{NICKNAME}让我听到了兰玛哈的歌。"
                },
                {
                    "id": "642390303",
                    "speaker": "兰修提袈",
                    "text": "离「源之歌」，歌的故乡又更近了一些。"
                }
            ]
        },
        {
            "talkId": "6423904",
            "initDialog": "642390401",
            "dialogues": [
                {
                    "id": "642390401",
                    "speaker": "兰修提袈",
                    "text": "金色的那菈就要离开，不快乐，不过更多的歌会诞生，「源之歌」会更近。"
                }
            ]
        },
        {
            "talkId": "6423905",
            "initDialog": "642390501",
            "dialogues": [
                {
                    "id": "642390501",
                    "speaker": "Player",
                    "text": "关于「源之歌」…"
                },
                {
                    "id": "642390502",
                    "speaker": "兰修提袈",
                    "text": "无忧节上金色的那菈与兰那罗一起唱起的歌，是我听过的歌里，最明亮的，像是最饱满的石榴。"
                },
                {
                    "id": "642390503",
                    "speaker": "兰修提袈",
                    "text": "也许这是最接近源之歌的旋律。"
                },
                {
                    "id": "642390504",
                    "speaker": "兰修提袈",
                    "text": "我觉得金色的那菈的旅途越长，源之歌就会越近。"
                }
            ]
        },
        {
            "talkId": "6423906",
            "initDialog": "642390601",
            "dialogues": [
                {
                    "id": "642390601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642390602",
                    "speaker": "兰修提袈",
                    "text": "再见，金色的那菈，希望我们的歌能一直伴随着你。"
                }
            ]
        },
        {
            "talkId": "6423907",
            "initDialog": "642390701",
            "dialogues": [
                {
                    "id": "642390701",
                    "speaker": "兰修提袈",
                    "text": "金色的那菈，希望你的冒险中有许多的困难，然后你将它们全部克服。这样，就能诞生许多故事，而故事就能变成美好的歌！"
                }
            ]
        }
    ]
}