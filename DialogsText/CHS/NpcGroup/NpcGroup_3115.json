{
    "groupId": "3115",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "高桥": 19
    },
    "talks": [
        {
            "talkId": "6311501",
            "initDialog": "631150101",
            "dialogues": [
                {
                    "id": "631150101",
                    "speaker": "高桥",
                    "text": "唉，你说这场战争什么时候才能结束…"
                },
                {
                    "id": "631150102",
                    "speaker": "高桥",
                    "text": "虽然为了妹妹的安全，我什么都愿意做，但实在是不想打仗啊。"
                }
            ]
        },
        {
            "talkId": "6311502",
            "initDialog": "631150201",
            "dialogues": [
                {
                    "id": "631150201",
                    "speaker": "Player",
                    "text": "关于你的妹妹…"
                },
                {
                    "id": "631150202",
                    "speaker": "高桥",
                    "text": "嗯，我有一个很可爱的小妹，她现在正在海祇岛的家中。"
                },
                {
                    "id": "631150203",
                    "speaker": "高桥",
                    "text": "妹妹年纪尚小，但聪明懂事。我这个做哥哥的，还是希望她能永远纯真烂漫，实在不想让她知道世界上的这些坏事。"
                },
                {
                    "id": "631150204",
                    "speaker": "高桥",
                    "text": "不是有人说过，战争中没有胜利的一方吗。只要有纷争，大家就都会受伤。"
                },
                {
                    "id": "631150205",
                    "speaker": "高桥",
                    "text": "所以为了妹妹的安全，我就算再讨厌打仗也得守住这里，决不能让幕府的大军踏足我的家乡。"
                }
            ]
        },
        {
            "talkId": "6311503",
            "initDialog": "631150301",
            "dialogues": [
                {
                    "id": "631150301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631150302",
                    "speaker": "高桥",
                    "text": "再见，希望家乡的小妹一切安好…"
                }
            ]
        },
        {
            "talkId": "6311504",
            "initDialog": "631150401",
            "dialogues": [
                {
                    "id": "631150401",
                    "speaker": "Player",
                    "text": "关于你的家乡…"
                },
                {
                    "id": "631150402",
                    "speaker": "高桥",
                    "text": "我家世代住在海祇岛上的望泷村，是个风景优美、生活恬淡的小村庄。"
                },
                {
                    "id": "631150403",
                    "speaker": "高桥",
                    "text": "我小的时候常常听着附近瀑布的声音，一发呆就是一整天…"
                },
                {
                    "id": "631150404",
                    "speaker": "高桥",
                    "text": "若是不发生战争，我也许一辈子也不会离开家乡，就这么度过平静的一生…"
                }
            ]
        },
        {
            "talkId": "6311505",
            "initDialog": "631150501",
            "dialogues": [
                {
                    "id": "631150501",
                    "speaker": "高桥",
                    "text": "珊瑚宫和幕府的休战协议已签，应该不会再开战了吧。"
                },
                {
                    "id": "631150502",
                    "speaker": "高桥",
                    "text": "希望能早日回家见到我的小妹啊。"
                }
            ]
        },
        {
            "talkId": "6311506",
            "initDialog": "631150601",
            "dialogues": [
                {
                    "id": "631150601",
                    "speaker": "Player",
                    "text": "关于你的妹妹…"
                },
                {
                    "id": "631150602",
                    "speaker": "高桥",
                    "text": "嗯，我有一个很可爱的小妹，她现在正在海祇岛的家中。"
                },
                {
                    "id": "631150603",
                    "speaker": "高桥",
                    "text": "妹妹年纪尚小，但聪明懂事。我这个做哥哥的，最大的愿望就是她能健康长大，永远纯真烂漫。"
                },
                {
                    "id": "631150604",
                    "speaker": "高桥",
                    "text": "为了我的妹妹，我会尽最大的努力去维持这份和平，不让幕府的大军踏足我的家乡。"
                }
            ]
        },
