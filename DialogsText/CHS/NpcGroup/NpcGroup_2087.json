{
    "groupId": "2087",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "月疏": 8
    },
    "talks": [
        {
            "talkId": "6208701",
            "initDialog": "620870101",
            "dialogues": [
                {
                    "id": "620870101",
                    "speaker": "月疏",
                    "text": "欢迎来到「新月轩」，客官您预定的是几号桌呢？"
                }
            ]
        },
        {
            "talkId": "6208702",
            "initDialog": "620870201",
            "dialogues": [
                {
                    "id": "620870201",
                    "speaker": "Player",
                    "text": "我想打包可以吗？"
                },
                {
                    "id": "620870202",
                    "speaker": "月疏",
                    "text": "当然，欢迎享用最好的月菜，请您点餐吧~！"
                }
            ]
        },
        {
            "talkId": "6208703",
            "initDialog": "620870301",
            "dialogues": [
                {
                    "id": "620870301",
                    "speaker": "Player",
                    "text": "没有预定可以吗？"
                },
                {
                    "id": "620870302",
                    "speaker": "月疏",
                    "text": "「新月轩」是璃月港最好的月菜馆，而且一天只在固定时间招待几桌客人…"
                },
                {
                    "id": "620870303",
                    "speaker": "月疏",
                    "text": "所以从很久以前，就必须提前三个月左右预定才可以呢。"
                },
                {
                    "id": "620870304",
                    "speaker": "月疏",
                    "text": "毕竟来「新月轩」的都是真正喜欢海味料理的月菜粉丝！"
                },
                {
                    "id": "620870305",
                    "speaker": "月疏",
                    "text": "哪怕是内部员工也不能插队，我的丈夫和孩子至今也还无福享用…啊哈哈…"
                },
                {
                    "id": "620870306",
                    "speaker": "月疏",
                    "text": "不过这么火爆也是必然吧，毕竟这里有着最地道的月菜~！"
                }
            ]
        },
        {
            "talkId": "6208704",
            "initDialog": "620870401",
            "dialogues": [
                {
                    "id": "620870401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620870402",
                    "speaker": "月疏",
                    "text": "「新月轩」恭候您的大驾——只要您提前预定了的话~！"
                }
            ]
        }
    ]
}