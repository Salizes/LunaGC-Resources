{
    "groupId": "7823",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "维亚泽姆斯基": 9
    },
    "talks": [
        {
            "talkId": "6782301",
            "initDialog": "678230101",
            "dialogues": [
                {
                    "id": "678230101",
                    "speaker": "维亚泽姆斯基",
                    "text": "就这点钱，够买啥啊。"
                }
            ]
        },
        {
            "talkId": "6782302",
            "initDialog": "678230201",
            "dialogues": [
                {
                    "id": "678230201",
                    "speaker": "Player",
                    "text": "钱不够吗？"
                },
                {
                    "id": "678230202",
                    "speaker": "维亚泽姆斯基",
                    "text": "杯水车薪啊。最近凿冰的工具报废得快，也不晓得是怎么搞的，总不能是山上的雪精给冰施了什么奇怪的法术吧？"
                },
                {
                    "id": "678230203",
                    "speaker": "维亚泽姆斯基",
                    "text": "要采买新工具，又只给这么几个子儿，够买点啥啊。"
                },
                {
                    "id": "678230204",
                    "speaker": "维亚泽姆斯基",
                    "text": "我看就是有人中饱私囊！哎，这种有油水捞的好差事怎么就轮不到我。"
                }
            ]
        },
        {
            "talkId": "6782303",
            "initDialog": "678230301",
            "dialogues": [
                {
                    "id": "678230301",
                    "speaker": "Player",
                    "text": "你要买什么？"
                },
                {
                    "id": "678230302",
                    "speaker": "维亚泽姆斯基",
                    "text": "采冰的家伙，凿子、镐子，就那些东西，最近工具报废得快，我为了采买都跑了好几趟了。"
                },
                {
                    "id": "678230303",
                    "speaker": "维亚泽姆斯基",
                    "text": "这种时候就不得不羡慕新基捷城的矮灵啊，我看他们的臻冰工具好使得很，要是什么时候能用上那个就好了。"
                }
            ]
        },
        {
            "talkId": "6782304",
            "initDialog": "678230401",
            "dialogues": [
                {
                    "id": "678230401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678230402",
                    "speaker": "维亚泽姆斯基",
                    "text": "哦，不聊会儿吗？那就再见了。"
                }
            ]
        },
        {
            "talkId": "6782305",
            "initDialog": "678230501",
            "dialogues": [
                {
                    "id": "678230501",
                    "speaker": "Player",
                    "text": "这不好吧。"
                },
                {
                    "id": "678230502",
                    "speaker": "维亚泽姆斯基",
                    "text": "当然不好。尤其是捞钱的人不是我，就更不好了。"
                },
                {
                    "id": "678230503",
                    "speaker": "维亚泽姆斯基",
                    "text": "…唉，不过想想，说不定那人哪天就因为这事儿栽了。毕竟钱来得不干净，麻烦就会找上身。"
                }
            ]
        }
    ]
}