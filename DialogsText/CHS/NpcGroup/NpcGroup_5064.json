            "dialogues": [
                {
                    "id": "650640101",
                    "speaker": "泰托",
                    "text": "有什么需要吗？我可以帮你解决。"
                }
            ]
        },
        {
            "talkId": "6506403",
            "initDialog": "650640301",
            "dialogues": [
                {
                    "id": "650640301",
                    "speaker": "Player",
                    "text": "什么都能解决吗？"
                },
                {
                    "id": "650640302",
                    "speaker": "泰托",
                    "text": "理论上来说，我不相信这世上有只能靠武力解决的问题。"
                },
                {
                    "id": "650640303",
                    "speaker": "泰托",
                    "text": "由我们刺玫会出手，相信一定能找到损伤最小的解决方案。"
                },
                {
                    "id": "650640304",
                    "speaker": "泰托",
                    "text": "小到生活物资和家庭事务，大到帮派纠纷和救人性命…刺玫会尽力而为。"
                }
            ]
        },
        {
            "talkId": "6506404",
            "initDialog": "650640401",
            "dialogues": [
                {
                    "id": "650640401",
                    "speaker": "Player",
                    "text": "先不打扰了。"
                },
                {
                    "id": "650640402",
                    "speaker": "泰托",
                    "text": "谈不上打扰，这里都论互帮互助。"
                }
            ]
        }
    ]
