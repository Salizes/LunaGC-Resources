{
    "groupId": "4090",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "玛赫菲": 7
    },
    "talks": [
        {
            "talkId": "6409001",
            "initDialog": "640900101",
            "dialogues": [
                {
                    "id": "640900101",
                    "speaker": "玛赫菲",
                    "text": "学者的生活，也不止研究课题这么简单哪…"
                }
            ]
        },
        {
            "talkId": "6409002",
            "initDialog": "640900201",
            "dialogues": [
                {
                    "id": "640900201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "640900202",
                    "speaker": "玛赫菲",
                    "text": "抱歉，让你听到了我的抱怨。"
                },
                {
                    "id": "640900203",
                    "speaker": "玛赫菲",
                    "text": "我只是在感慨，学者也不止需要潜心研究，还得处理其他方面的工作。"
                },
                {
                    "id": "640900204",
                    "speaker": "玛赫菲",
                    "text": "比如教令院的安排，导师的任务，同僚之间的关系…甚至偶尔还有风纪官的盘查。"
                },
                {
                    "id": "640900205",
                    "speaker": "玛赫菲",
                    "text": "唉，如果这些事情能和植物开枝散叶一样自然天成就好了…"
                },
                {
                    "id": "640900206",
                    "speaker": "玛赫菲",
                    "text": "现在，我多多少少明白提纳里学长为什么会离开教令院了。"
                }
            ]
        },
        {
            "talkId": "6409003",
            "initDialog": "640900301",
            "dialogues": [
                {
                    "id": "640900301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640900302",
                    "speaker": "玛赫菲",
                    "text": "单纯的生活一去不返…"
                }
            ]
        }
    ]
}