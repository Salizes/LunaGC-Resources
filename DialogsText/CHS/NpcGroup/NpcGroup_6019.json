{
    "groupId": "6019",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "凯塔": 10
    },
    "talks": [
        {
            "talkId": "6601901",
            "initDialog": "660190101",
            "dialogues": [
                {
                    "id": "660190101",
                    "speaker": "凯塔",
                    "text": "燃素刻录的讲究可是很多的，唉，不过，现在的年轻人…"
                }
            ]
        },
        {
            "talkId": "6601902",
            "initDialog": "660190201",
            "dialogues": [
                {
                    "id": "660190201",
                    "speaker": "Player",
                    "text": "这个是什么？"
                },
                {
                    "id": "660190202",
                    "speaker": "凯塔",
                    "text": "哦，你好，异邦人。这里是供奉煅石之轮的地方。"
                },
                {
                    "id": "660190203",
                    "speaker": "凯塔",
                    "text": "煅石之轮，是纳塔各部族与圣火相连一体的象征。"
                },
                {
                    "id": "660190204",
                    "speaker": "凯塔",
                    "text": "每个纳塔人都能通过圣火，与部族中的其他人，与龙，与火神建立起紧密的联系。"
                },
                {
                    "id": "660190205",
                    "speaker": "凯塔",
                    "text": "如果渴望圣火的庇佑，就在煅石之轮前进行祷告吧…"
                }
            ]
        },
        {
            "talkId": "6601903",
            "initDialog": "660190301",
            "dialogues": [
                {
                    "id": "660190301",
                    "speaker": "Player",
                    "text": "燃素刻录是…"
                },
                {
                    "id": "660190302",
                    "speaker": "凯塔",
                    "text": "燃素刻录是很久以前的纳塔人模仿古老的语言创造的图形。"
                },
                {
                    "id": "660190303",
                    "speaker": "凯塔",
                    "text": "他们通过这种语言来与燃素沟通，或与圣火进行连接。"
                },
                {
                    "id": "660190304",
                    "speaker": "凯塔",
                    "text": "虽然随着时代的变更，涂鸦反而是现在比较流行的形式…"
                },
                {
                    "id": "660190305",
                    "speaker": "凯塔",
                    "text": "不过，燃素刻录本身还是具备一些不同的内涵，现在很少有人能耐得下性子研究了。"
                }
            ]
        },
        {
            "talkId": "6601904",
            "initDialog": "660190401",
            "dialogues": [
                {
                    "id": "660190401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "660190402",
                    "speaker": "凯塔",
                    "text": "没事，愿你的旅途一帆风顺，异邦人。"
                }
            ]
        }
    ]
}