{
    "groupId": "1654",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "查耶维奇": 16
    },
    "talks": [
        {
            "talkId": "6165401",
            "initDialog": "616540101",
            "dialogues": [
                {
                    "id": "616540101",
                    "speaker": "查耶维奇",
                    "text": "真是的，到底要让我等到什么时候！"
                }
            ]
        },
        {
            "talkId": "6165402",
            "initDialog": "616540201",
            "dialogues": [
                {
                    "id": "616540201",
                    "speaker": "查耶维奇",
                    "text": "怎么了？"
                },
                {
                    "id": "616540202",
                    "speaker": "查耶维奇",
                    "text": "峡谷里有魔物，骑士团的人不准我们进去，说里面很危险。"
                },
                {
                    "id": "616540203",
                    "speaker": "查耶维奇",
                    "text": "结果都等好久了，也没见要放行的意思，这就是大名鼎鼎的「西风骑士团」的效率吗？"
                },
                {
                    "id": "616540204",
                    "speaker": "查耶维奇",
                    "text": "喂，你是冒险家吧？那就别光看着，到峡谷里去把魔物都给我杀了，快去快去。"
                }
            ]
        },
        {
            "talkId": "6165403",
            "initDialog": "616540301",
            "dialogues": [
                {
                    "id": "616540301",
                    "speaker": "查耶维奇",
                    "text": "关于你。"
                },
                {
                    "id": "616540302",
                    "speaker": "查耶维奇",
                    "text": "居然不知道查耶维奇这个名字？咳咳……算了，乡下人没有见识我已经见怪不怪了。"
                },
                {
                    "id": "616540303",
                    "speaker": "查耶维奇",
                    "text": "我是至冬国著名的商人，频繁走访七国经营贸易，结果蒙德这地方让我大开眼界……别会错意，是出人意料的烂。"
                },
                {
                    "id": "616540304",
                    "speaker": "查耶维奇",
                    "text": "这里的人都太单纯了，也没有什么贸易头脑，这里的经济体制给我一周我就能摧毁。"
                },
                {
                    "id": "616540305",
                    "speaker": "查耶维奇",
                    "text": "唉，不过也对，要是会做生意，这里也不会是一副穷酸样了。"
                },
                {
                    "id": "616540306",
                    "speaker": "查耶维奇",
                    "text": "你和你的手下怎么不去？"
                },
                {
                    "id": "616540307",
                    "speaker": "查耶维奇",
                    "text": "我？别开玩笑了，这种粗野的活路我怎么可能做？"
                },
                {
                    "id": "616540308",
                    "speaker": "查耶维奇",
                    "text": "我的手下也没义务帮那群骑士，他们可都是我花钱雇来的，骑士团给我钱了吗？"
                },
                {
                    "id": "616540309",
                    "speaker": "查耶维奇",
                    "text": "那群骑士愣头愣脑，在蒙德城的时候也不给我行方便，现在想占我便宜？想都别想！"
                }
            ]
        },
        {
            "talkId": "6165404",
            "initDialog": "616540401",
            "dialogues": [
                {
                    "id": "616540401",
                    "speaker": "查耶维奇",
                    "text": "再见。"
                },
                {
                    "id": "616540402",
                    "speaker": "查耶维奇",
                    "text": "嗯，快去前面把魔物给我清理了，别让我久等。"
                }
            ]
        }
    ]
}