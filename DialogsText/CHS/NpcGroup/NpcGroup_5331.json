            "talkId": "6533101",
            "initDialog": "653310101",
            "dialogues": [
                {
                    "id": "653310101",
                    "speaker": "奇怪的箱子",
                    "text": "（蒙上了厚厚灰尘的沉重箱子，又旧又破，被突兀地堆放在这里几乎破坏了明亮干净的枫丹廷街景。）"
                },
                {
                    "id": "653310102",
                    "speaker": "奇怪的箱子",
                    "text": "（箱子底部有明显的陈年水渍，似乎曾经被堆放在极度潮湿的地方。）"
                },
                {
                    "id": "653310103",
                    "speaker": "奇怪的箱子",
                    "text": "（比起门口的污迹，这个脏兮兮的箱子似乎更应该被清理掉。)"
                }
            ]
        }
    ]
}