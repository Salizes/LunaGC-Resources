{
    "groupId": "2332",
    "total_dialogue_lines": 4,
    "speaker_counts": {
        "先民札记·其一": 4
    },
    "talks": [
        {
            "talkId": "6233201",
            "initDialog": "623320101",
            "dialogues": [
                {
                    "id": "623320101",
                    "speaker": "先民札记·其一",
                    "text": "「…乡民为山兽所逐至此，本以为必亡，不意得遇上仙…」"
                },
                {
                    "id": "623320102",
                    "speaker": "先民札记·其一",
                    "text": "「…盛容姣丽，何可极言。上古既无，世所未见。瑰姿玮态，不可胜赞。芳音若兰，其名灵…」"
                },
                {
                    "id": "623320103",
                    "speaker": "先民札记·其一",
                    "text": "「…曰：来歆既覆，浮锦已…我亦…分昔日降霖璞玉，以避妖邪觊夺…奉之于此，汝等且安居，以待…」"
                },
                {
                    "id": "623320104",
                    "speaker": "先民札记·其一",
                    "text": "「…于是循上仙之言，封闭宫室…」"
                }
            ]
        }
    ]
}