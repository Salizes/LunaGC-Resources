{
    "groupId": "2025",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 8,
        "畅畅": 28
    },
    "talks": [
        {
            "talkId": "4003741",
            "initDialog": "400374101",
            "dialogues": [
                {
                    "id": "400374101",
                    "speaker": "畅畅",
                    "text": "今年的海灯节，畅畅有了新的愿望，就是和爸爸一起看一次烟花！"
                },
                {
                    "id": "400374102",
                    "speaker": "畅畅",
                    "text": "今年没赶上的话，那就下次、下下次、下下下次…总有一天会实现的！"
                }
            ]
        },
        {
            "talkId": "7180701",
            "initDialog": "718070101",
            "dialogues": [
                {
                    "id": "718070101",
                    "speaker": "畅畅",
                    "text": "哎呀…这样怎么喂它呀…"
                },
                {
                    "id": "718070102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718070103",
                    "speaker": "畅畅",
                    "text": "畅畅正在想怎么去喂认识的那只小狗呢。"
                },
                {
                    "id": "718070104",
                    "speaker": "畅畅",
                    "text": "之前爷爷说城里太乱，怎么样都不带畅畅去喂它。"
                },
                {
                    "id": "718070105",
                    "speaker": "畅畅",
                    "text": "虽然最近爷爷说城里没事了，但他还有很多事要忙，没空带畅畅去…"
                },
                {
                    "id": "718070106",
                    "speaker": "畅畅",
                    "text": "都这么久没喂它了，它不会饿坏了吧…虽然爷爷说小狗会自己找吃的，但畅畅还是很担心…"
                },
                {
                    "id": "718070107",
                    "speaker": "畅畅",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能帮畅畅去城门口附近喂喂它吗？",
                    "choices": [
                        {
                            "id": "718070108",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "718070109",
                                    "speaker": "畅畅",
                                    "text": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                                },
                                {
                                    "id": "718070113",
                                    "speaker": "Player",
                                    "text": "喂什么呢？"
                                },
                                {
                                    "id": "718070114",
                                    "speaker": "畅畅",
                                    "text": "平时都是爷爷准备好喂它的东西，好像用的是禽肉，还是什么的…"
                                },
                                {
                                    "id": "718070115",
                                    "speaker": "畅畅",
                                    "text": "#唔…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，那就请你找一份禽肉去喂它吧。"
                                },
                                {
                                    "id": "718070116",
                                    "speaker": "畅畅",
                                    "text": "请快一点呀，说不定它都要饿坏了…"
                                }
                            ]
                        },
                        {
                            "id": "718070110",
                            "text": "我有点怕狗…",
                            "response": [
                                {
                                    "id": "718070111",
                                    "speaker": "畅畅",
                                    "text": "别担心，它很好的，绝对不会咬人。"
                                },
                                {
                                    "id": "718070112",
                                    "speaker": "畅畅",
                                    "text": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6202501",
            "initDialog": "620250101",
            "dialogues": [
                {
                    "id": "620250101",
                    "speaker": "畅畅",
                    "text": "爸爸什么时候回来呀…欸，你好！"
                }
            ]
        },
        {
            "talkId": "6202502",
            "initDialog": "620250201",
            "dialogues": [
                {
                    "id": "620250201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "620250202",
                    "speaker": "畅畅",
                    "text": "嘿嘿，畅畅最懂礼貌了！你也是来等人的吗？",
                    "choices": [
                        {
                            "id": "620250203",
                            "text": "你一个人在这里吗？",
                            "response": [
                                {
                                    "id": "620250204",
                                    "speaker": "畅畅",
                                    "text": "嗯！畅畅最懂事了，自己一个人玩也没问题！爷爷在那边的船厂上帮呢…上帮？上班…？上班！"
                                },
                                {
                                    "id": "620250205",
                                    "speaker": "畅畅",
                                    "text": "畅畅不怕，这里的哥哥姐姐们都是好人…千岩军哥哥专门打坏人！"
                                }
                            ]
                        },
                        {
                            "id": "620250206",
                            "text": "你在玩什么呢？",
                            "response": [
                                {
                                    "id": "620250207",
                                    "speaker": "畅畅",
                                    "text": "畅畅没有玩！畅畅做正事！"
                                },
                                {
                                    "id": "620250208",
                                    "speaker": "畅畅",
                                    "text": "畅畅在等爸爸呢，爸爸多少天没回来了呢…"
                                },
                                {
                                    "id": "620250209",
                                    "speaker": "畅畅",
                                    "text": "爸爸每次回来都会带好多好多好吃的和玩具…"
                                },
                                {
                                    "id": "620250210",
                                    "speaker": "畅畅",
                                    "text": "上次是衣服，上上次是小小风车，上上上次是一大大大堆糖！"
                                },
                                {
                                    "id": "620250211",
                                    "speaker": "畅畅",
                                    "text": "还有…上上上上次…是…好漂亮的瓷娃娃！还有还有…钩钩果蛋糕、起风就会发光的小瓶子、紫色的小沙漏…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6202503",
            "initDialog": "620250301",
            "dialogues": [
                {
                    "id": "620250301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620250302",
                    "speaker": "畅畅",
                    "text": "嗯，再见！"
                }
            ]
        },
        {
            "talkId": "7202501",
            "initDialog": "720250101",
            "dialogues": [
                {
                    "id": "720250101",
                    "speaker": "畅畅",
                    "text": "畅畅呀，刚才把布娃娃捐了哦。"
                },
                {
                    "id": "720250102",
                    "speaker": "畅畅",
                    "text": "昨晚我梦到她说想要飞到天上去看看。"
                },
                {
                    "id": "720250103",
                    "speaker": "畅畅",
                    "text": "我就把她捐给大鹿灯那边的姐姐了，马上她就会实现愿望了吧？"
                },
                {
                    "id": "720250104",
                    "speaker": "畅畅",
                    "text": "畅畅是做了件好事吗？海灯节是实现大家愿望的日子吧？"
                }
            ]
        }
    ]
}