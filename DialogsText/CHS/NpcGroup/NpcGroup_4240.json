{
    "groupId": "4240",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "兰纳真": 11
    },
    "talks": [
        {
            "talkId": "6424001",
            "initDialog": "642400101",
            "dialogues": [
                {
                    "id": "642400101",
                    "speaker": "兰纳真",
                    "text": "啊…是那菈朋友，你…你好…"
                }
            ]
        },
        {
            "talkId": "6424002",
            "initDialog": "642400201",
            "dialogues": [
                {
                    "id": "642400201",
                    "speaker": "Player",
                    "text": "你好…"
                },
                {
                    "id": "642400202",
                    "speaker": "兰纳真",
                    "text": "桓那兰那很少有那菈造访，不过来造访的那菈都是兰那罗的朋友。"
                },
                {
                    "id": "642400203",
                    "speaker": "兰纳真",
                    "text": "兰纳真欢迎你…初次见面的那菈朋友。"
                }
            ]
        },
        {
            "talkId": "6424003",
            "initDialog": "642400301",
            "dialogues": [
                {
                    "id": "642400301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "642400302",
                    "speaker": "兰纳真",
                    "text": "再见…那菈朋友。"
                }
            ]
        },
        {
            "talkId": "6424004",
            "initDialog": "642400401",
            "dialogues": [
                {
                    "id": "642400401",
                    "speaker": "兰纳真",
                    "text": "#「苦舍桓」呀~「白飞飞」~♪那菈{NICKNAME}和白飞飞，一起唱吧~"
                }
            ]
        },
        {
            "talkId": "6424005",
            "initDialog": "642400501",
            "dialogues": [
                {
                    "id": "642400501",
                    "speaker": "Player",
                    "text": "关于歌声…"
                },
                {
                    "id": "642400502",
                    "speaker": "兰纳真",
                    "text": "这首歌，是你们讲的故事里，「须罗蕈」到手后，兰纳真唱的歌。"
                },
                {
                    "id": "642400503",
                    "speaker": "兰纳真",
                    "text": "#虽然兰纳真已经不记得了，但是森林里的草木听到这首歌，一定能够回忆起来。兰纳真曾经告诉过他们：那菈{NICKNAME}是厉害的种子，是兰纳真的朋友。"
                }
            ]
        },
        {
            "talkId": "6424006",
            "initDialog": "642400601",
            "dialogues": [
                {
                    "id": "642400601",
                    "speaker": "Player",
                    "text": "关于海亚姆…"
                },
                {
                    "id": "642400602",
                    "speaker": "兰纳真",
                    "text": "那菈海亚姆，我曾忘记了他的名字，他也看不到我们了，对吗…？"
                },
                {
                    "id": "642400603",
                    "speaker": "兰纳真",
                    "text": "虽然无法再与他相见，但是我会用歌声告诉森林，告诉风，留下他的痕迹。"
                },
                {
                    "id": "642400604",
                    "speaker": "兰纳真",
                    "text": "这样，就不会再忘记他的名字。"
                }
            ]
        },
        {
            "talkId": "6424007",
            "initDialog": "642400701",
            "dialogues": [
                {
                    "id": "642400701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642400702",
                    "speaker": "兰纳真",
                    "text": "再见，兰纳真的朋友。"
                }
            ]
        }
    ]
}