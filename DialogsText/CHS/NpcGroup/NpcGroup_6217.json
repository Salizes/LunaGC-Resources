    },
    "talks": [
        {
            "talkId": "6621701",
            "initDialog": "662170101",
            "dialogues": [
                {
                    "id": "662170101",
                    "speaker": "玛伊蕾",
                    "text": "你好啊，朋友！要陪我在这聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6621702",
            "initDialog": "662170201",
            "dialogues": [
                {
                    "id": "662170201",
                    "speaker": "Player",
                    "text": "好啊。"
                },
                {
                    "id": "662170202",
                    "speaker": "玛伊蕾",
                    "text": "哈哈，答应得真爽快啊，我喜欢！"
                },
                {
                    "id": "662170203",
                    "speaker": "玛伊蕾",
                    "text": "不过也没什么特别想聊的…唉，你知道，烟谜主的人总是神出鬼没，我来找她之前就想到可能会这样啦。"
                },
                {
                    "id": "662170204",
                    "speaker": "玛伊蕾",
                    "text": "最近刚学了新的乐器，想来弹给她听。要是把等她的时间全都用来练习，我一定能成为大师！"
                },
                {
                    "id": "662170205",
                    "speaker": "玛伊蕾",
                    "text": "不过总弹那几首曲子也没什么意思了…你说，我要不要就在这附近拜师学习涂鸦艺术呢…"
                },
                {
                    "id": "662170206",
                    "speaker": "玛伊蕾",
                    "text": "哎呀，抱歉抱歉，拖着你聊了这么多，你也该去忙别的事情了吧。"
                }
            ]
        },
        {
            "talkId": "6621703",
            "initDialog": "662170301",
            "dialogues": [
                {
                    "id": "662170301",
                    "speaker": "Player",
                    "text": "好啊。"
                },
                {
                    "id": "662170302",
                    "speaker": "玛伊蕾",
                    "text": "哈哈，答应得真爽快啊，我喜欢！"
                },
                {
                    "id": "662170303",
                    "speaker": "玛伊蕾",
                    "text": "不过也没什么特别想聊的…唉，你知道，烟谜主的人总是神出鬼没，我来找她之前就想到可能会这样啦。"
                },
                {
                    "id": "662170304",
                    "speaker": "玛伊蕾",
                    "text": "一开始我还担心了一下呢，以为她在深渊入侵的时候受伤了。找人打听了一下，只是有些小磕碰嘛！"
                },
                {
                    "id": "662170305",
                    "speaker": "玛伊蕾",
                    "text": "最近刚学了新的乐器，想来弹给她听。要是把等她的时间全都用来练习，我一定能成为大师！"
                },
                {
                    "id": "662170306",
                    "speaker": "玛伊蕾",
                    "text": "不过总弹那几首曲子也没什么意思了…你说，我要不要就在这附近拜师学习涂鸦艺术呢…"
                },
                {
                    "id": "662170307",
                    "speaker": "玛伊蕾",
                    "text": "哎呀，抱歉抱歉，拖着你聊了这么多，你也该去忙别的事情了吧。"
                }
            ]
        },
        {
            "talkId": "6621704",
            "initDialog": "662170401",
            "dialogues": [
                {
                    "id": "662170401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "662170402",
                    "speaker": "玛伊蕾",
                    "text": "哦哦，那快去忙吧，别让我耽误了你的时间！"
                }
            ]
        },
        {
            "talkId": "7594301",
            "initDialog": "759430101",
            "dialogues": [
                {
                    "id": "759430101",
                    "speaker": "Player",
                    "text": "没关系。"
                },
                {
                    "id": "759430102",
                    "speaker": "玛伊蕾",
                    "text": "嘿嘿，你脾气真不错，挺有耐心的，一定能交到很多朋友。"
                },
                {
                    "id": "759430103",
                    "speaker": "玛伊蕾",
                    "text": "这样才对嘛，人就是要和朋友分享时间，分享喜悦，分享美食才对！"
                }
            ]
