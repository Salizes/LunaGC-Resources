{
    "groupId": "9316",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "迪卢克": 9
    },
    "talks": [
        {
            "talkId": "6931601",
            "initDialog": "693160101",
            "dialogues": [
                {
                    "id": "693160101",
                    "speaker": "迪卢克",
                    "text": "有时候，战场之外的闲言碎语，才是决定胜负的关键。"
                },
                {
                    "id": "693160102",
                    "speaker": "迪卢克",
                    "text": "因此，即使在战斗间隙，我也不会放松戒备。"
                },
                {
                    "id": "693160103",
                    "speaker": "迪卢克",
                    "text": "收集情报的事交给我吧，你可以休息。"
                }
            ]
        },
        {
            "talkId": "6931602",
            "initDialog": "693160201",
            "dialogues": [
                {
                    "id": "693160201",
                    "speaker": "迪卢克",
                    "text": "目前的战斗强度，你还应付得来吗？"
                },
                {
                    "id": "693160202",
                    "speaker": "迪卢克",
                    "text": "我无法在战局中随时关注你的情况，希望你不要硬撑。"
                },
                {
                    "id": "693160203",
                    "speaker": "迪卢克",
                    "text": "至于棘手的敌人，交给我来处理就好。"
                }
            ]
        },
        {
            "talkId": "6931603",
            "initDialog": "693160301",
            "dialogues": [
                {
                    "id": "693160301",
                    "speaker": "迪卢克",
                    "text": "从前，我也经常像你这般，不断地深入险境，直面强敌。"
                },
                {
                    "id": "693160302",
                    "speaker": "迪卢克",
                    "text": "驱使我的并非骑士团手册里的「规则」，而是我自身的「信念」。"
                },
                {
                    "id": "693160303",
                    "speaker": "迪卢克",
                    "text": "它会让人忘记伤口与疲倦，引领你步入黎明。"
                }
            ]
        }
    ]
}