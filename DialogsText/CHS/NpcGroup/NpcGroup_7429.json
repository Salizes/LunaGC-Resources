    "talks": [
        {
            "talkId": "6742901",
            "initDialog": "674290101",
            "dialogues": [
                {
                    "id": "674290101",
                    "speaker": "叶芙琳娜",
                    "text": "您好，想看点什么吗？有什么想看的还请随意…"
                }
            ]
        },
        {
            "talkId": "6742902",
            "initDialog": "674290201",
            "dialogues": [
                {
                    "id": "674290201",
                    "speaker": "Player",
                    "text": "不怕我弄坏吗？"
                },
                {
                    "id": "674290202",
                    "speaker": "叶芙琳娜",
                    "text": "当然不，毕竟弄坏了就得赔偿，不过如果您真的在意的话…"
                },
                {
                    "id": "674290203",
                    "speaker": "叶芙琳娜",
                    "text": "您中意的的物品，可以让我拿在手里为您展示，如果那时候弄坏了…"
                },
                {
                    "id": "674290204",
                    "speaker": "叶芙琳娜",
                    "text": "哈哈，就得从我的工钱里扣啦。"
                }
            ]
        },
        {
            "talkId": "6742903",
            "initDialog": "674290301",
            "dialogues": [
                {
                    "id": "674290301",
                    "speaker": "Player",
                    "text": "想了解些详情…"
                },
                {
                    "id": "674290302",
                    "speaker": "叶芙琳娜",
                    "text": "那就请和我们的老板布柳什科聊聊吧。"
                },
                {
                    "id": "674290303",
                    "speaker": "叶芙琳娜",
                    "text": "我只是在这里打工的，对于这些东西的来历也不是特别清楚…"
                },
                {
                    "id": "674290304",
                    "speaker": "叶芙琳娜",
                    "text": "不过应该也有来路不明的东西吧，我来面试的时候老板向我反复确认，没有在冬契军任职的亲戚，才让我过关的。"
                }
            ]
        },
        {
            "talkId": "6742904",
            "initDialog": "674290401",
            "dialogues": [
                {
                    "id": "674290401",
                    "speaker": "Player",
                    "text": "没什么想看的。"
                },
                {
                    "id": "674290402",
                    "speaker": "叶芙琳娜",
                    "text": "好吧，那也请您随意…"
                }
            ]
        },
