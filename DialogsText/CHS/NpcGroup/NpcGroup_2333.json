            "dialogues": [
                {
                    "id": "623330101",
                    "speaker": "先民札记·其二",
                    "text": "「…苍璧既琢，黄琮亦镌；奉兹赤望，聆彼玄天…」"
                },
                {
                    "id": "623330102",
                    "speaker": "先民札记·其二",
                    "text": "「…自古在昔，先民有贤；顾予烝尝，佑我福绵…」"
                }
            ]
        }
    ]
}