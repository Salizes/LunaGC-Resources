    },
    "talks": [
        {
            "talkId": "6403701",
            "initDialog": "640370101",
            "dialogues": [
                {
                    "id": "640370101",
                    "speaker": "扎凯",
                    "text": "为什么须弥人都这么喜欢讨价还价呢？我也是须弥人啊，就没有这个臭毛病。"
                }
            ]
        },
        {
            "talkId": "6403702",
            "initDialog": "640370201",
            "dialogues": [
                {
                    "id": "640370201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640370202",
                    "speaker": "扎凯",
                    "text": "我是渔夫，也是鲜鱼的批发商，主要为须弥城里的餐馆提供大量海货。"
                },
                {
                    "id": "640370203",
                    "speaker": "扎凯",
                    "text": "同时也为几位生论派的学者提供研究材料。"
                },
                {
                    "id": "640370204",
                    "speaker": "扎凯",
                    "text": "客户都是些老主顾了，合作一直很稳定，就是每次进货时都要和我在价格上掰扯一番…"
                },
                {
                    "id": "640370205",
                    "speaker": "扎凯",
                    "text": "我寻思着，为什么量大就要便宜呢？我这里的每一箱鱼，难道不都是同样的质量吗？"
                },
                {
                    "id": "640370206",
                    "speaker": "扎凯",
                    "text": "如果我轻易给出了折扣，买家才应该担心货物出了问题啊，你说对不对。"
                }
            ]
        },
        {
            "talkId": "6403703",
            "initDialog": "640370301",
            "dialogues": [
                {
                    "id": "640370301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640370302",
                    "speaker": "扎凯",
                    "text": "再见。"
                }
            ]
        }
    ]
}