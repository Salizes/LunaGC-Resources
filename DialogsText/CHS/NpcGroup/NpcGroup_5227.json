    "talks": [
        {
            "talkId": "6522701",
            "initDialog": "652270101",
            "dialogues": [
                {
                    "id": "652270101",
                    "speaker": "巴朗",
                    "text": "你来了，之前非常感谢你的协助。"
                }
            ]
        },
        {
            "talkId": "6522702",
            "initDialog": "652270201",
            "dialogues": [
                {
                    "id": "652270201",
                    "speaker": "Player",
                    "text": "最近还好吗？"
                },
                {
                    "id": "652270202",
                    "speaker": "巴朗",
                    "text": "最近几次检修发现管道的状态维护得还不错，应该没什么值得担心的。"
                },
                {
                    "id": "652270203",
                    "speaker": "巴朗",
                    "text": "艾蒂安先生带来的帮手们也很专业，帮大忙了。"
                }
            ]
        },
        {
            "talkId": "6522703",
            "initDialog": "652270301",
            "dialogues": [
                {
                    "id": "652270301",
                    "speaker": "Player",
                    "text": "没什么，再见。"
                },
                {
                    "id": "652270302",
                    "speaker": "巴朗",
                    "text": "祝你一路顺风。"
                }
            ]
        },
        {
            "talkId": "6522704",
            "initDialog": "652270401",
            "dialogues": [
                {
                    "id": "652270401",
                    "speaker": "Player",
                    "text": "我是问你最近还好吗，不是管道。"
                },
                {
                    "id": "652270402",
                    "speaker": "巴朗",
                    "text": "哦！原来是这样…非常感谢你的关心。"
                },
                {
                    "id": "652270403",
                    "speaker": "巴朗",
                    "text": "在那之后，我利用休假时间学习了一些基本的防身术，现在就算在检修工作时遇到危险，自行脱身应该是没有问题的。"
                },
                {
                    "id": "652270404",
                    "speaker": "巴朗",
                    "text": "在野外的工作确实有这方面的风险，如果今后能将工作人员的体能训练和防身技巧训练纳入员工培训的一环就好了。"
                }
            ]
        },
        {
            "talkId": "7409111",
            "initDialog": "740911101",
            "dialogues": [
                {
                    "id": "740911101",
                    "speaker": "？？？",
                    "text": "救…谁来救救我…"
                },
                {
                    "id": "740911102",
                    "speaker": "派蒙",
                    "text": "得先把这些丘丘人赶走才行！"
                }
            ]
        }
    ]
}