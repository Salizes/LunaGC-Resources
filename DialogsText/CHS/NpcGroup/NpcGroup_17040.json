{
    "groupId": "17040",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 2,
        "科赫": 10,
        "赫得蔚格": 3
    },
    "talks": [
        {
            "talkId": "7668305",
            "initDialog": "766830501",
            "dialogues": [
                {
                    "id": "766830501",
                    "speaker": "科赫",
                    "text": "荣誉骑士，枪匠科赫向你问好！祝你测距精准，打出理想的弹道。",
                    "choices": [
                        {
                            "id": "766830507",
                            "text": "关于「观测榴弹」的其他原理…",
                            "response": [
                                {
                                    "id": "766830508",
                                    "speaker": "科赫",
                                    "text": "猜你想问：榴弹的变向机制。"
                                },
                                {
                                    "id": "766830509",
                                    "speaker": "科赫",
                                    "text": "哈哈，其实原理也不难，榴弹本体采用的无烟火药能量较低，速度并不夸张。"
                                },
                                {
                                    "id": "766830510",
                                    "speaker": "科赫",
                                    "text": "配合观测机关周围的黏着装置，就能实现命中后附着在目标上，然后点燃后部侧面的示踪剂，发出命中信号。"
                                },
                                {
                                    "id": "766830511",
                                    "speaker": "科赫",
                                    "text": "弹头里余下的空间，都用来装填变向用的火药了，远程控制它指向想要的目标后，就可以点燃这些发射药，飞向下一个目标。"
                                },
                                {
                                    "id": "766830512",
                                    "speaker": "科赫",
                                    "text": "因此，在推演中，「观测榴弹」就能进行次数有限的变向。"
                                },
                                {
                                    "id": "766830513",
                                    "speaker": "科赫",
                                    "text": "这完全符合推演的主题——「用有限的射击次数，打出最完美的弹道。」"
                                }
                            ]
                        },
                        {
                            "id": "766830514",
                            "text": "待会儿再来和你聊。",
                            "response": [
                                {
                                    "id": "766830515",
                                    "speaker": "科赫",
                                    "text": "了解，我随时在此待命。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7668404",
            "initDialog": "766840401",
            "dialogues": [
                {
                    "id": "766840401",
                    "speaker": "科赫",
                    "text": "快要收工了…去那边的「锈舵」喝两杯？"
                },
                {
                    "id": "766840402",
                    "speaker": "赫得蔚格",
                    "text": "喝什么喝！你们自己掏腰包喔？我一摩拉都不会给你们批的。"
                },
                {
                    "id": "766840403",
                    "speaker": "科赫",
                    "text": "没事，我们自己出钱，再带几瓶好的回去给霍肯、乌苏拉和君特！噢，还有凯亚队长和大团长！"
                },
                {
                    "id": "766840404",
                    "speaker": "赫得蔚格",
                    "text": "反正我就免了，我要好好整理这次推演的记录，远程小队得留个人下来帮我！"
                },
                {
                    "id": "766840405",
                    "speaker": "赫得蔚格",
                    "text": "还有特巡队给团长的书面文件，进修计划…无意之间，又开了个好头啊！"
                }
            ]
        }
    ]
}