{
    "groupId": "9044",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Player": 19,
        "辛焱": 51
    },
    "talks": [
        {
            "talkId": "6904401",
            "initDialog": "690440101",
            "dialogues": [
                {
                    "id": "690440101",
                    "speaker": "辛焱",
                    "text": "#唷，你好啊，{NICKNAME}。"
                },
                {
                    "id": "690440102",
                    "speaker": "辛焱",
                    "text": "需要来点音乐吗？我现在也是最佳状态！"
                }
            ]
        },
        {
            "talkId": "6904402",
            "initDialog": "690440201",
            "dialogues": [
                {
                    "id": "690440201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690440202",
                    "speaker": "辛焱",
                    "text": "嗯！够大够自由，是非常酷的排练场地！",
                    "choices": [
                        {
                            "id": "690440203",
                            "text": "我可以来看辛焱排练吗？",
                            "response": [
                                {
                                    "id": "690440204",
                                    "speaker": "辛焱",
                                    "text": "欸！如…如果可以的话，我还是希望自己演奏熟练之后，再表演给你看。"
                                },
                                {
                                    "id": "690440205",
                                    "speaker": "辛焱",
                                    "text": "这样才能带给你最佳的视听体验嘛。"
                                },
                                {
                                    "id": "690440206",
                                    "speaker": "辛焱",
                                    "text": "不过…谢谢你的支持，我一定会努力的！"
                                },
                                {
                                    "id": "690440210",
                                    "speaker": "辛焱",
                                    "text": "哦，对了！每次排练完，我都会把场地收拾干净的。"
                                },
                                {
                                    "id": "690440211",
                                    "speaker": "辛焱",
                                    "text": "就跟新的一样，你放心好了。"
                                }
                            ]
                        },
                        {
                            "id": "690440207",
                            "text": "谢谢你喜欢…",
                            "response": [
                                {
                                    "id": "690440208",
                                    "speaker": "辛焱",
                                    "text": "欸，哪里的话。"
                                },
                                {
                                    "id": "690440209",
                                    "speaker": "辛焱",
                                    "text": "要谢也该是我来谢你呀！邀请我来你住的地方，也不限制我做这做那。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904403",
            "initDialog": "690440301",
            "dialogues": [
                {
                    "id": "690440301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690440302",
                    "speaker": "辛焱",
                    "text": "好啊！我遇到了个创作难题…陪我换换思路吧！",
                    "choices": [
                        {
                            "id": "690440303",
                            "text": "辛焱的曲子都是自己写的？",
                            "response": [
                                {
                                    "id": "690440304",
                                    "speaker": "辛焱",
                                    "text": "那是当然的！"
                                },
                                {
                                    "id": "690440305",
                                    "speaker": "辛焱",
                                    "text": "在璃月港，「摇滚」只能算是小众吧。乐迷虽多，创作者却少。"
                                },
                                {
                                    "id": "690440306",
                                    "speaker": "辛焱",
                                    "text": "虽然我也会听来自「枫丹」的作品，但那只是欣赏和学习。"
                                },
                                {
                                    "id": "690440307",
                                    "speaker": "辛焱",
                                    "text": "真正落到创作的时候，还是得亲力亲为，才能配得上「摇滚」二字！"
                                },
                                {
                                    "id": "690440313",
                                    "speaker": "Player",
                                    "text": "真了不起！"
                                },
                                {
                                    "id": "690440314",
                                    "speaker": "辛焱",
                                    "text": "嘿嘿…谢谢你赏识。"
                                },
                                {
                                    "id": "690440315",
                                    "speaker": "辛焱",
                                    "text": "不过…最近倒是有些苦恼。"
                                },
                                {
                                    "id": "690440318",
                                    "speaker": "辛焱",
                                    "text": "新的曲子被乐迷评价「火热中能听出温柔的感觉」，觉得风格变了…"
                                },
                                {
                                    "id": "690440319",
                                    "speaker": "辛焱",
                                    "text": "可能是因为近期心境变化了吧。唔，到底该不该避免呢…"
                                }
                            ]
                        },
                        {
                            "id": "690440308",
                            "text": "以往会从什么题材入手呢？",
                            "response": [
                                {
                                    "id": "690440309",
                                    "speaker": "辛焱",
                                    "text": "那当然是对「成见」的反抗！"
                                },
                                {
                                    "id": "690440310",
                                    "speaker": "辛焱",
                                    "text": "街头巷尾耳闻目睹的事情，再结合我自身的体验…"
                                },
                                {
                                    "id": "690440311",
                                    "speaker": "辛焱",
                                    "text": "叙述、抒情…最重要的是用足够的「激情」来发问！"
                                },
                                {
                                    "id": "690440312",
                                    "speaker": "辛焱",
                                    "text": "一定要直指灵魂才行！"
                                },
                                {
                                    "id": "690440316",
                                    "speaker": "Player",
                                    "text": "那最近是有什么苦恼呢？"
                                },
                                {
                                    "id": "690440317",
                                    "speaker": "辛焱",
                                    "text": "嗯…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904404",
            "initDialog": "690440401",
            "dialogues": [
                {
                    "id": "690440401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690440402",
                    "speaker": "辛焱",
                    "text": "嗯…你想不想试试看弹琴？"
                },
                {
                    "id": "690440403",
                    "speaker": "辛焱",
                    "text": "你看，你也听过我那么多场表演了。"
                },
                {
                    "id": "690440404",
                    "speaker": "辛焱",
                    "text": "如果感兴趣，自己也想试试的话，我可以手把手教你！",
                    "choices": [
                        {
                            "id": "690440405",
                            "text": "乐器的话，我以前学过。",
                            "response": [
                                {
                                    "id": "690440406",
                                    "speaker": "辛焱",
                                    "text": "欸，真的吗？太好了！"
                                },
                                {
                                    "id": "690440411",
                                    "speaker": "辛焱",
                                    "text": "啊，对我来说，「摇滚」是像生命一样重要的东西。"
                                },
                                {
                                    "id": "690440412",
                                    "speaker": "辛焱",
                                    "text": "假如能跟你一起演绎「摇滚」，那一定是双倍的…不，那一定是这个世上最棒的事情！"
                                },
                                {
                                    "id": "690440413",
                                    "speaker": "辛焱",
                                    "text": "当，当然…我知道音乐品味会有不同。我心目中的「摇滚」也不止于音乐本身。"
                                },
                                {
                                    "id": "690440414",
                                    "speaker": "辛焱",
                                    "text": "如果你有不情愿的地方，我肯定不会强迫你的！",
                                    "choices": [
                                        {
                                            "id": "690440415",
                                            "text": "为辛焱的话，我可以试试…",
                                            "response": [
                                                {
                                                    "id": "690440416",
                                                    "speaker": "辛焱",
                                                    "text": "嗯…嗯…"
                                                },
                                                {
                                                    "id": "690440417",
                                                    "speaker": "辛焱",
                                                    "text": "那我可不能辜负你的信任，要做个好老师啊。"
                                                },
                                                {
                                                    "id": "690440418",
                                                    "speaker": "辛焱",
                                                    "text": "给，这是我的琴。"
                                                },
                                                {
                                                    "id": "690440419",
                                                    "speaker": "辛焱",
                                                    "text": "魔鬼训练…要开始了哦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690440420",
                                            "text": "或许能找到其他演绎「摇滚」的方法？",
                                            "response": [
                                                {
                                                    "id": "690440421",
                                                    "speaker": "辛焱",
                                                    "text": "没·问·题！"
                                                },
                                                {
                                                    "id": "690440422",
                                                    "speaker": "辛焱",
                                                    "text": "其实…你能答应我，我已经很感动了。"
                                                },
                                                {
                                                    "id": "690440423",
                                                    "speaker": "辛焱",
                                                    "text": "毕竟，你对我而言，意义不凡…"
                                                },
                                                {
                                                    "id": "690440424",
                                                    "speaker": "辛焱",
                                                    "text": "咳咳…我会期待，和你一起「摇滚」起来的！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690440407",
                            "text": "我怕我弹不好…",
                            "response": [
                                {
                                    "id": "690440408",
                                    "speaker": "辛焱",
                                    "text": "没事，有我帮你！"
                                },
                                {
                                    "id": "690440409",
                                    "speaker": "辛焱",
                                    "text": "我会注意方式方法、循序渐进的…虽然我也是第一次当老师。"
                                }
                            ]
                        },
                        {
                            "id": "690440410",
                            "text": "为什么会想到这个？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904405",
            "initDialog": "690440501",
            "dialogues": [
                {
                    "id": "690440501",
                    "speaker": "Player",
                    "text": "早啊，辛焱。"
                },
                {
                    "id": "690440502",
                    "speaker": "辛焱",
                    "text": "早！需要气氛火热起来的场合，找我没错！"
                }
            ]
        },
        {
            "talkId": "6904406",
            "initDialog": "690440601",
            "dialogues": [
                {
                    "id": "690440601",
                    "speaker": "Player",
                    "text": "晚安，辛焱。"
                },
                {
                    "id": "690440602",
                    "speaker": "辛焱",
                    "text": "#看样子你也辛苦了一天了，晚安，{NICKNAME}。"
                },
                {
                    "id": "690440603",
                    "speaker": "辛焱",
                    "text": "哦，要是腰酸腿痛的话，泡个热水澡吧。会很舒服的！"
                }
            ]
        },
        {
            "talkId": "6904407",
            "initDialog": "690440701",
            "dialogues": [
                {
                    "id": "690440701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6904408",
            "initDialog": "690440801",
            "dialogues": [
                {
                    "id": "690440801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6904409",
            "initDialog": "690440901",
            "dialogues": [
                {
                    "id": "690440901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6904450",
            "initDialog": "690445001",
            "dialogues": [
                {
                    "id": "690445001",
                    "speaker": "辛焱",
                    "text": "住在村里的人大多过着安逸的生活，时间一长，都快闷坏了。"
                },
                {
                    "id": "690445002",
                    "speaker": "辛焱",
                    "text": "用我的摇滚肯定能给他们带去新奇的体验，还有久违的热情！"
                },
                {
                    "id": "690445003",
                    "speaker": "辛焱",
                    "text": "事不宜迟，你就替我搭建舞台好了！"
                }
            ]
        },
        {
            "talkId": "6904451",
            "initDialog": "690445101",
            "dialogues": [
                {
                    "id": "690445101",
                    "speaker": "辛焱",
                    "text": "唔！练习消耗了太多体力，得吃饱喝足才行！"
                },
                {
                    "id": "690445102",
                    "speaker": "辛焱",
                    "text": "这里的菜品还不少，我要把所有摊位都尝个遍，看看哪家够摇滚。"
                },
                {
                    "id": "690445103",
                    "speaker": "辛焱",
                    "text": "你也来吧！我也想了解你的口味！"
                }
            ]
        }
    ]
}