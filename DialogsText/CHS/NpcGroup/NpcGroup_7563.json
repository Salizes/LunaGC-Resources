{
    "groupId": "7563",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "瓦洁丝卡娅": 7
    },
    "talks": [
        {
            "talkId": "6756301",
            "initDialog": "675630101",
            "dialogues": [
                {
                    "id": "675630101",
                    "speaker": "瓦洁丝卡娅",
                    "text": "哎呀，幸好这次运气还不错！"
                }
            ]
        },
        {
            "talkId": "6756302",
            "initDialog": "675630201",
            "dialogues": [
                {
                    "id": "675630201",
                    "speaker": "Player",
                    "text": "那条章鱼…"
                },
                {
                    "id": "675630202",
                    "speaker": "瓦洁丝卡娅",
                    "text": "对，那条章鱼是我们的船出海捕的，刷新记录啦，哈哈！"
                },
                {
                    "id": "675630203",
                    "speaker": "瓦洁丝卡娅",
                    "text": "捕捞的过程中也挺惊心动魄的，船险些被它整个掀翻…"
                },
                {
                    "id": "675630204",
                    "speaker": "瓦洁丝卡娅",
                    "text": "不过我们的船员都是镇上了不起的捕鱼高手，它最后还是没能斗过我们，嘿嘿，我们可是海屑镇的儿女…"
                }
            ]
        },
        {
            "talkId": "6756303",
            "initDialog": "675630301",
            "dialogues": [
                {
                    "id": "675630301",
                    "speaker": "Player",
                    "text": "你不去接受采访吗？"
                },
                {
                    "id": "675630302",
                    "speaker": "瓦洁丝卡娅",
                    "text": "接受采访？那种事比捕这么大的怪物回来还麻烦…"
                },
                {
                    "id": "675630303",
                    "speaker": "瓦洁丝卡娅",
                    "text": "还是交给我可靠的大副去解决吧…"
                }
            ]
        },
        {
            "talkId": "6756304",
            "initDialog": "675630401",
            "dialogues": [
                {
                    "id": "675630401",
                    "speaker": "Player",
                    "text": "祝你一直有好运！"
                },
                {
                    "id": "675630402",
                    "speaker": "瓦洁丝卡娅",
                    "text": "世上倒没有一直跟着的好运，如果有，那我希望它还是跟着您吧，朋友。"
                }
            ]
        }
    ]
}