    },
    "talks": [
        {
            "talkId": "6512601",
            "initDialog": "651260101",
            "dialogues": [
                {
                    "id": "651260101",
                    "speaker": "科赛尔",
                    "text": "嗯？有新货送到？我这就过去搬。"
                }
            ]
        },
        {
            "talkId": "6512602",
            "initDialog": "651260201",
            "dialogues": [
                {
                    "id": "651260201",
                    "speaker": "Player",
                    "text": "新货是…"
                },
                {
                    "id": "651260202",
                    "speaker": "科赛尔",
                    "text": "想哪去了，就是指普通货物而已。"
                },
                {
                    "id": "651260203",
                    "speaker": "科赛尔",
                    "text": "穆纳切洛老是强调「情报也是货物」，搞得大家都开始对搬运工这个职业产生不必要的期待了。"
                },
                {
                    "id": "651260204",
                    "speaker": "科赛尔",
                    "text": "不用听他神神叨叨，大家该干什么就干什么吧。"
                }
            ]
        },
        {
            "talkId": "6512603",
            "initDialog": "651260301",
            "dialogues": [
                {
                    "id": "651260301",
                    "speaker": "Player",
                    "text": "啊，不是的…"
                },
                {
                    "id": "651260302",
                    "speaker": "科赛尔",
                    "text": "哦，原来是客人。"
                },
                {
                    "id": "651260303",
                    "speaker": "科赛尔",
                    "text": "那您请便吧，有事再叫我。"
                }
            ]
        },
        {
            "talkId": "6512604",
            "initDialog": "651260401",
            "dialogues": [
                {
                    "id": "651260401",
                    "speaker": "科赛尔",
                    "text": "你好。这里是运货的必经之路，小心别被撞到。"
                }
            ]
        },
        {
            "talkId": "6512605",
            "initDialog": "651260501",
            "dialogues": [
                {
                    "id": "651260501",
                    "speaker": "Player",
                    "text": "货物是指…"
                },
                {
                    "id": "651260502",
                    "speaker": "科赛尔",
                    "text": "用来救灾和重建的物资。"
                },
                {
                    "id": "651260503",
                    "speaker": "科赛尔",
                    "text": "有的是至冬人送来的，也有克洛琳德小姐安排的。"
                },
                {
                    "id": "651260504",
                    "speaker": "科赛尔",
                    "text": "老板都打过招呼了，我会一一处理，不劳客人费心。"
                }
            ]
        },
        {
            "talkId": "6512606",
            "initDialog": "651260601",
            "dialogues": [
                {
                    "id": "651260601",
                    "speaker": "Player",
                    "text": "明白了。"
                },
                {
                    "id": "651260602",
                    "speaker": "科赛尔",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6512607",
            "initDialog": "651260701",
            "dialogues": [
                {
                    "id": "651260701",
                    "speaker": "科赛尔",
                    "text": "嗯？有新货送到？我这就过去搬。"
                }
            ]
        },
        {
            "talkId": "6512608",
            "initDialog": "651260801",
            "dialogues": [
                {
                    "id": "651260801",
                    "speaker": "Player",
                    "text": "新货是…"
                },
                {
                    "id": "651260802",
                    "speaker": "科赛尔",
                    "text": "就是指普通货物而已。"
                },
                {
                    "id": "651260803",
                    "speaker": "科赛尔",
                    "text": "以前穆纳切洛老是强调「情报也是货物」，搞得大家对搬运工这个职业产生了不必要的期待。"
                },
                {
                    "id": "651260804",
                    "speaker": "科赛尔",
                    "text": "现在是听不到他神神叨叨了…搬运工也就又变回无聊的职业了。"
                }
            ]
        },
        {
            "talkId": "6512609",
            "initDialog": "651260901",
            "dialogues": [
                {
