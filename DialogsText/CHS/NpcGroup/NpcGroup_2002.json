{
    "groupId": "2002",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "永安": 16
    },
    "talks": [
        {
            "talkId": "7090101",
            "initDialog": "709010101",
            "dialogues": [
                {
                    "id": "709010101",
                    "speaker": "Player",
                    "text": "关于猫…"
                },
                {
                    "id": "709010102",
                    "speaker": "永安",
                    "text": "说起来早上我巡逻时，发现居然有个女孩要给它们喂牛奶…阿嚏！"
                },
                {
                    "id": "709010103",
                    "speaker": "永安",
                    "text": "幸亏我赶紧拦住了她…虽说是出于好心吧，可猫喝牛奶是会闹肚子的！"
                },
                {
                    "id": "709010104",
                    "speaker": "永安",
                    "text": "…可能是跟猫待久了，我也变得不爱喝牛奶了，这些牛奶就送给你好…阿嚏！"
                }
            ]
        },
        {
            "talkId": "6200201",
            "initDialog": "620020101",
            "dialogues": [
                {
                    "id": "620020101",
                    "speaker": "永安",
                    "text": "你好，旅…旅…旅…阿嚏！"
                },
                {
                    "id": "620020102",
                    "speaker": "永安",
                    "text": "对不起…有什么需要帮忙的吗？"
                }
            ]
        },
        {
            "talkId": "6200202",
            "initDialog": "620020201",
            "dialogues": [
                {
                    "id": "620020201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "620020202",
                    "speaker": "永安",
                    "text": "我没事，谢谢关心…阿嚏！"
                },
                {
                    "id": "620020203",
                    "speaker": "永安",
                    "text": "实在抱歉，强哥到了换毛的时节了，平时一般不会这样…阿…阿…阿嚏！！"
                }
            ]
        },
        {
            "talkId": "6200203",
            "initDialog": "620020301",
            "dialogues": [
                {
                    "id": "620020301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620020302",
                    "speaker": "永安",
                    "text": "一路平安…阿嚏！"
                }
            ]
        },
        {
            "talkId": "6200204",
            "initDialog": "620020401",
            "dialogues": [
                {
                    "id": "620020401",
                    "speaker": "Player",
                    "text": "强哥？"
                },
                {
                    "id": "620020402",
                    "speaker": "永安",
                    "text": "嗯，强哥就是这群猫里最威风、最强壮的那只橘猫，它是女孩子哦。"
                },
                {
                    "id": "620020403",
                    "speaker": "永安",
                    "text": "我给这里的每只猫都取了名字。你看，那只叫阿珍，还有大头和桂芬…"
                },
                {
                    "id": "620020404",
                    "speaker": "永安",
                    "text": "每次我一叫它们就会过来…阿嚏！"
                }
            ]
        },
        {
            "talkId": "6200205",
            "initDialog": "620020501",
            "dialogues": [
                {
                    "id": "620020501",
                    "speaker": "Player",
                    "text": "你真的不要紧吗…？"
                },
                {
                    "id": "620020502",
                    "speaker": "永安",
                    "text": "没…没问题的，我只是有点过敏而已。都是可以…可以…克服的小毛病…阿嚏！！"
                }
            ]
        },
        {
            "talkId": "6200206",
            "initDialog": "620020601",
            "dialogues": [
                {
                    "id": "620020601",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "620020602",
                    "speaker": "永安",
                    "text": "阿嚏，我一直在码头这边巡逻，没有看到过这样的人…"
                },
                {
                    "id": "620020603",
                    "speaker": "永安",
                    "text": "唉，不过我也可能是我看漏了吧…"
                },
                {
                    "id": "620020604",
                    "speaker": "永安",
                    "text": "和猫一起待久了，都有些脸盲了，上次我就把我们教头看成了问路的大爷…"
                },
                {
                    "id": "620020605",
                    "speaker": "永安",
                    "text": "阿嚏！以后我巡逻的时候会帮你找找看的，千岩牢固…阿嚏，重嶂不移！"
                }
            ]
        }
    ]
}