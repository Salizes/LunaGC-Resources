{
    "groupId": "7511",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "塔里娅": 11
    },
    "talks": [
        {
            "talkId": "6751101",
            "initDialog": "675110101",
            "dialogues": [
                {
                    "id": "675110101",
                    "speaker": "塔里娅",
                    "text": "看看至冬堡纪念品吗？物美价廉，超乎想象，绝不让您失望！"
                }
            ]
        },
        {
            "talkId": "6751102",
            "initDialog": "675110201",
            "dialogues": [
                {
                    "id": "675110201",
                    "speaker": "Player",
                    "text": "至冬堡纪念品？"
                },
                {
                    "id": "675110202",
                    "speaker": "塔里娅",
                    "text": "没错，您没听错，独属于至冬堡的纪念品，目的是为人们在这个伟大城市的美好记忆定格。"
                }
            ]
        },
        {
            "talkId": "6751103",
            "initDialog": "675110301",
            "dialogues": [
                {
                    "id": "675110301",
                    "speaker": "Player",
                    "text": "不用了。"
                },
                {
                    "id": "675110302",
                    "speaker": "塔里娅",
                    "text": "再会。"
                }
            ]
        },
        {
            "talkId": "6751104",
            "initDialog": "675110401",
            "dialogues": [
                {
                    "id": "675110401",
                    "speaker": "Player",
                    "text": "你的生意好吗？"
                },
                {
                    "id": "675110402",
                    "speaker": "塔里娅",
                    "text": "那还用说吗？谁不想为自己在这个伟大城市的美好记忆定格？您瞧瞧会上我这来的人吧——"
                },
                {
                    "id": "675110403",
                    "speaker": "塔里娅",
                    "text": "每一个来至冬堡的旅客，好比像您这样的外国人，或者那些来自新基捷城、海屑镇之类的外地游客。"
                },
                {
                    "id": "675110404",
                    "speaker": "塔里娅",
                    "text": "而我塔里娅的货源有专门渠道，所以东西一概物美价廉。放眼整个至冬堡，也不会有比这里更划算的地方了。"
                },
                {
                    "id": "675110405",
                    "speaker": "塔里娅",
                    "text": "只要旅客还来至冬堡，我的生意就差不了。"
                }
            ]
        },
        {
            "talkId": "6751105",
            "initDialog": "675110501",
            "dialogues": [
                {
                    "id": "675110501",
                    "speaker": "Player",
                    "text": "这些纪念品和商店里的有区别吗？"
                },
                {
                    "id": "675110502",
                    "speaker": "塔里娅",
                    "text": "区别非常大！您在商店里只能找到最大众、最庸常的礼品，为此还要支付高昂的价格。"
                },
                {
                    "id": "675110503",
                    "speaker": "塔里娅",
                    "text": "但在我这里——跟您交个底吧，我这里有一些…运输局的人脉。"
                },
                {
                    "id": "675110504",
                    "speaker": "塔里娅",
                    "text": "所以，哪怕「严冬计划」来了，您在这里能找到的东西，都是最超乎想象，也最物美价廉的。"
                },
                {
                    "id": "675110505",
                    "speaker": "塔里娅",
                    "text": "不论是成色最好的臻冰制品，还是奥黛塔和沃雅妮莎的签名照…这些东西可不是在商店里能找得到的。"
                }
            ]
        }
    ]
}