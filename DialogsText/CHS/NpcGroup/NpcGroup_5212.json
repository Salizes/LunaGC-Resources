{
    "groupId": "5212",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 10,
        "卡兰萨": 17
    },
    "talks": [
        {
            "talkId": "6521201",
            "initDialog": "652120101",
            "dialogues": [
                {
                    "id": "652120101",
                    "speaker": "卡兰萨",
                    "text": "数学不仅很美，而且很有用。可惜很多人并不理解这一点。"
                }
            ]
        },
        {
            "talkId": "6521202",
            "initDialog": "652120201",
            "dialogues": [
                {
                    "id": "652120201",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "652120202",
                    "speaker": "卡兰萨",
                    "text": "我在等待。我听到了消息，如果消息准确无误的话，我将采取行动。"
                }
            ]
        },
        {
            "talkId": "6521203",
            "initDialog": "652120301",
            "dialogues": [
                {
                    "id": "652120301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "652120302",
                    "speaker": "卡兰萨",
                    "text": "再会。"
                }
            ]
        },
        {
            "talkId": "6521204",
            "initDialog": "652120401",
            "dialogues": [
                {
                    "id": "652120401",
                    "speaker": "Player",
                    "text": "听不懂你在说什么…"
                },
                {
                    "id": "652120402",
                    "speaker": "卡兰萨",
                    "text": "很好。因为我不希望你听懂，否则你也会成为竞争者。"
                },
                {
                    "id": "652120403",
                    "speaker": "卡兰萨",
                    "text": "如果你真的这样迫切地想找到一个聊天对象，我们可以谈一些别的，不会对任何人的利益造成损害的话题，比如数学…"
                }
            ]
        },
        {
            "talkId": "6521205",
            "initDialog": "652120501",
            "dialogues": [
                {
                    "id": "652120501",
                    "speaker": "Player",
                    "text": "告辞。"
                },
                {
                    "id": "652120502",
                    "speaker": "卡兰萨",
                    "text": "不送。"
                }
            ]
        },
        {
            "talkId": "6521206",
            "initDialog": "652120601",
            "dialogues": [
                {
                    "id": "652120601",
                    "speaker": "卡兰萨",
                    "text": "工作之余的学习意识是很重要的，比起戏剧之类的收效甚微的教化，不如学习更有用的知识…比如数学。"
                }
            ]
        },
        {
            "talkId": "6521207",
            "initDialog": "652120701",
            "dialogues": [
                {
                    "id": "652120701",
                    "speaker": "Player",
                    "text": "你为什么在这里？"
                },
                {
                    "id": "652120702",
                    "speaker": "卡兰萨",
                    "text": "你可以在这里，我当然也可以。这里用作教室真是太合适不过了，我可以在这里开展一番事业。"
                }
            ]
        },
        {
            "talkId": "6521208",
            "initDialog": "652120801",
            "dialogues": [
                {
                    "id": "652120801",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "652120802",
                    "speaker": "卡兰萨",
                    "text": "再会。"
                }
            ]
        },
        {
            "talkId": "6521209",
            "initDialog": "652120901",
            "dialogues": [
                {
                    "id": "652120901",
                    "speaker": "Player",
                    "text": "…事业？"
                },
                {
                    "id": "652120902",
                    "speaker": "卡兰萨",
                    "text": "理想情况是让大家都认识到数学之美，但我知道这显然是不可能的。"
                },
                {
                    "id": "652120903",
                    "speaker": "卡兰萨",
                    "text": "所以，至少让有心向学的人掌握一些实用的数学知识吧。这比什么三枚券剧团在干的事更有意义。"
                }
            ]
        },
        {
            "talkId": "6521210",
            "initDialog": "652121001",
            "dialogues": [
                {
                    "id": "652121001",
                    "speaker": "Player",
                    "text": "祝你成功。"
                },
                {
                    "id": "652121002",
                    "speaker": "卡兰萨",
                    "text": "借你吉言。"
                }
            ]
        },
        {
            "talkId": "6521211",
            "initDialog": "652121101",
            "dialogues": [
                {
                    "id": "652121101",
                    "speaker": "Player",
                    "text": "各有各的好。"
                },
                {
                    "id": "652121102",
                    "speaker": "卡兰萨",
                    "text": "但大部分人都做不到两者兼顾。你得明白。"
                }
            ]
        },
        {
            "talkId": "6521212",
            "initDialog": "652121201",
            "dialogues": [
                {
                    "id": "652121201",
                    "speaker": "Player",
                    "text": "祝你成功。"
                },
                {
                    "id": "652121202",
                    "speaker": "卡兰萨",
                    "text": "借你吉言。"
                }
            ]
        },
        {
            "talkId": "6521213",
            "initDialog": "652121301",
            "dialogues": [
                {
                    "id": "652121301",
                    "speaker": "卡兰萨",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6521214",
            "initDialog": "652121401",
            "dialogues": [
                {
                    "id": "652121401",
                    "speaker": "卡兰萨",
                    "text": "感谢赐教，这次的牌局交流，给我提供了不错的学习样本。"
                }
            ]
        },
        {
            "talkId": "6521215",
            "initDialog": "652121501",
            "dialogues": [
                {
                    "id": "652121501",
                    "speaker": "卡兰萨",
                    "text": "看来还得再分析一下牌组的搭配啊…"
                }
            ]
        }
    ]
}