    "talks": [
        {
            "talkId": "6605801",
            "initDialog": "660580101",
            "dialogues": [
                {
                    "id": "660580101",
                    "speaker": "莉洛娅",
                    "text": "马努阿这家伙，又答应首领的要求了吧。"
                }
            ]
        },
        {
            "talkId": "6605802",
            "initDialog": "660580201",
            "dialogues": [
                {
                    "id": "660580201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "660580202",
                    "speaker": "莉洛娅",
                    "text": "你好，我是舞台设计师。"
                },
                {
                    "id": "660580203",
                    "speaker": "莉洛娅",
                    "text": "…话虽如此，其实我的工作内容涵盖了与部族旅游业相关的各个方面。"
                },
                {
                    "id": "660580204",
                    "speaker": "莉洛娅",
                    "text": "这毕竟是部族收入的主要来源。除了演出以外，音乐制作、宣传引导，这些工作我都有涉及。"
                }
            ]
        },
        {
            "talkId": "6605803",
            "initDialog": "660580301",
            "dialogues": [
                {
                    "id": "660580301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660580302",
                    "speaker": "莉洛娅",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6605804",
            "initDialog": "660580401",
            "dialogues": [
                {
                    "id": "660580401",
                    "speaker": "Player",
                    "text": "懂了，钱全靠你赚。"
                },
                {
                    "id": "660580402",
                    "speaker": "莉洛娅",
                    "text": "总得有人来做啦。"
                },
                {
                    "id": "660580403",
                    "speaker": "莉洛娅",
                    "text": "马努阿那家伙虽然经验丰富，但对首领有些溺爱。"
                },
                {
                    "id": "660580404",
                    "speaker": "莉洛娅",
                    "text": "而且我看他最大的心愿大概是让首领赶紧成长起来吧，这样他就能快点退休去泡温泉咯。"
                },
                {
                    "id": "660580405",
                    "speaker": "莉洛娅",
                    "text": "还好我很有耐心，可以慢慢帮他们把那些奇奇怪怪的主意转化成可以实现的样子。"
                }
            ]
        },
        {
            "talkId": "6605805",
            "initDialog": "660580501",
            "dialogues": [
                {
                    "id": "660580501",
                    "speaker": "Player",
                    "text": "懂了，钱全靠你赚。"
                },
                {
                    "id": "660580502",
                    "speaker": "莉洛娅",
                    "text": "总得有人来做啦。有钱才能有办法解决更重要的问题。"
                },
                {
                    "id": "660580503",
                    "speaker": "莉洛娅",
                    "text": "我不怎么擅长战斗，但很擅长赚钱，看来每个人都有自己应该去的位置。"
                },
                {
                    "id": "660580504",
                    "speaker": "莉洛娅",
                    "text": "马努阿那家伙虽然经验丰富，但对首领有些溺爱。"
                },
                {
                    "id": "660580505",
                    "speaker": "莉洛娅",
                    "text": "而且我看他最大的心愿大概是让首领赶紧成长起来吧，这样他就能快点退休去泡温泉咯。"
                },
                {
                    "id": "660580506",
                    "speaker": "莉洛娅",
                    "text": "还好我很有耐心，可以慢慢帮他们把那些奇奇怪怪的主意转化成可以实现的样子。"
                }
            ]
        }
    ]
