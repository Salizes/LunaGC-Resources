{
    "groupId": "7733",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "蒙周": 11
    },
    "talks": [
        {
            "talkId": "6773301",
            "initDialog": "677330101",
            "dialogues": [
                {
                    "id": "677330101",
                    "speaker": "蒙周",
                    "text": "大道废，有文章♪~智慧出，多书蠹♪~"
                }
            ]
        },
        {
            "talkId": "6773302",
            "initDialog": "677330201",
            "dialogues": [
                {
                    "id": "677330201",
                    "speaker": "Player",
                    "text": "在这里唱歌不太好吧…"
                },
                {
                    "id": "677330202",
                    "speaker": "蒙周",
                    "text": "怎么了，因为这里是读书的地方？正因如此，我才要唱歌呢！"
                },
                {
                    "id": "677330203",
                    "speaker": "蒙周",
                    "text": "不管多么荒诞无稽的话，只要写成文字，就会被当成事实。这里到处都是这样可笑的书。"
                },
                {
                    "id": "677330204",
                    "speaker": "蒙周",
                    "text": "在我们琅玕国，从来没人会写这种东西。不管遇到什么事情，人们都只会把它们编成歌谣。"
                },
                {
                    "id": "677330205",
                    "speaker": "蒙周",
                    "text": "大王派下来的采诗官听到这些歌谣后，就会记下来，回到宫廷里唱给那些大人们听。"
                },
                {
                    "id": "677330206",
                    "speaker": "蒙周",
                    "text": "这里头饱含着的真情，可比那些破文章有意思多了。"
                }
            ]
        },
        {
            "talkId": "6773303",
            "initDialog": "677330301",
            "dialogues": [
                {
                    "id": "677330301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "677330302",
                    "speaker": "蒙周",
                    "text": "你是来看书的吗？那不如坐下来，听我唱一曲再走。"
                }
            ]
        },
        {
            "talkId": "6773304",
            "initDialog": "677330401",
            "dialogues": [
                {
                    "id": "677330401",
                    "speaker": "Player",
                    "text": "那你为什么会在这里？"
                },
                {
                    "id": "677330402",
                    "speaker": "蒙周",
                    "text": "谁知道呢。兴许是哪个自大的家伙，觉得把什么「文明」「历史」保存起来是件了不得的大事。"
                },
                {
                    "id": "677330403",
                    "speaker": "蒙周",
                    "text": "于是就连我也被当作「历史」的一部分塞了进来。"
                }
            ]
        },
        {
            "talkId": "6773305",
            "initDialog": "677330501",
            "dialogues": [
                {
                    "id": "677330501",
                    "speaker": "Player",
                    "text": "文字总能留得久一点吧。"
                },
                {
                    "id": "677330502",
                    "speaker": "蒙周",
                    "text": "那又有什么用，一旦写下便成了死物。时间一长，解释就会歪曲，最后只留下几个无知的后人，为了一两个字的意思大打出手。"
                },
                {
                    "id": "677330503",
                    "speaker": "蒙周",
                    "text": "啧，还不如编故事呢，至少没人会把它们当真。"
                }
            ]
        }
    ]
}