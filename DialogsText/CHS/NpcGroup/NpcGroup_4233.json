{
    "groupId": "4233",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "阿凡": 11
    },
    "talks": [
        {
            "talkId": "6423301",
            "initDialog": "642330101",
            "dialogues": [
                {
                    "id": "642330101",
                    "speaker": "阿凡",
                    "text": "怎么就是不长呢？"
                }
            ]
        },
        {
            "talkId": "6423302",
            "initDialog": "642330201",
            "dialogues": [
                {
                    "id": "642330201",
                    "speaker": "Player",
                    "text": "你好…？"
                },
                {
                    "id": "642330202",
                    "speaker": "阿凡",
                    "text": "…又是来推销的行商，这都多少个了…"
                },
                {
                    "id": "642330203",
                    "speaker": "阿凡",
                    "text": "不缺吃穿，没存款，不管你想跟我推销什么，找别人去吧。"
                },
                {
                    "id": "642330204",
                    "speaker": "阿凡",
                    "text": "老头我还要忙着种花，不懂种花的人就别来打扰了。"
                }
            ]
        },
        {
            "talkId": "6423303",
            "initDialog": "642330301",
            "dialogues": [
                {
                    "id": "642330301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642330302",
                    "speaker": "阿凡",
                    "text": "要推销找别人去，再见…不对，别见了。"
                }
            ]
        },
        {
            "talkId": "6423304",
            "initDialog": "642330401",
            "dialogues": [
                {
                    "id": "642330401",
                    "speaker": "阿凡",
                    "text": "♪…是你啊，来看看，这些花长得不错吧？"
                }
            ]
        },
        {
            "talkId": "6423306",
            "initDialog": "642330601",
            "dialogues": [
                {
                    "id": "642330601",
                    "speaker": "Player",
                    "text": "关于歌谣…"
                },
                {
                    "id": "642330602",
                    "speaker": "阿凡",
                    "text": "你还记得这首歌谣啊…又有一个年轻人记住了它，呵呵，是好事啊。"
                },
                {
                    "id": "642330603",
                    "speaker": "阿凡",
                    "text": "「蔷薇啊蔷薇，实现我的愿望。花从石头中绽放，金蔷薇对我歌唱。」"
                },
                {
                    "id": "642330604",
                    "speaker": "阿凡",
                    "text": "「没有土地承载我，唯有歌谣承载我。歌谣战胜敌视我的命运，战胜我的结局。」"
                },
                {
                    "id": "642330605",
                    "speaker": "阿凡",
                    "text": "「战胜我战胜时间，战胜永不消逝的消逝…」"
                }
            ]
        },
        {
            "talkId": "6423307",
            "initDialog": "642330701",
            "dialogues": [
                {
                    "id": "642330701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642330702",
                    "speaker": "阿凡",
                    "text": "你是个善良的好孩子，神看到你的热心肠会庇护你的，再见。"
                }
            ]
        }
    ]
}