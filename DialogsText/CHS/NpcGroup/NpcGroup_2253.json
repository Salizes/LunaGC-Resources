    "talks": [
        {
            "talkId": "6225301",
            "initDialog": "622530101",
            "dialogues": [
                {
                    "id": "622530101",
                    "speaker": "《古华诸贤谱录》",
                    "text": "「凡入我门，当袭古华宗师之故事，修枪剑生克之要诀，逢卫道锄恶之侠义…特此立诸贤之谱录，以勉后进…」"
                },
                {
                    "id": "622530102",
                    "speaker": "《古华诸贤谱录》",
                    "text": "「宗师古华…号『枪剑双绝』…」"
                },
                {
                    "id": "622530103",
                    "speaker": "《古华诸贤谱录》",
                    "text": "「三代掌门…武理通达…著有《诸武集成校笺》…」"
                },
                {
                    "id": "622530104",
                    "speaker": "《古华诸贤谱录》",
                    "text": "（由于年代久远，诸多字迹已无法辨认。）"
                }
            ]
        }
    ]
}