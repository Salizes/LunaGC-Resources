{
    "groupId": "4347",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "哈扬": 16
    },
    "talks": [
        {
            "talkId": "6434701",
            "initDialog": "643470101",
            "dialogues": [
                {
                    "id": "643470101",
                    "speaker": "哈扬",
                    "text": "如果从这里往左走的话…"
                }
            ]
        },
        {
            "talkId": "6434702",
            "initDialog": "643470201",
            "dialogues": [
                {
                    "id": "643470201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643470202",
                    "speaker": "哈扬",
                    "text": "我是来道成林进行生态考察的学者，旁边那位是我请来的保镖。我们都不是什么可疑人员，请不必有太大的戒心。"
                },
                {
                    "id": "643470203",
                    "speaker": "哈扬",
                    "text": "最近死域的问题似乎变多了，但道成林的生态却没有太大的变化，看来巡林员们做出了很大的努力。"
                }
            ]
        },
        {
            "talkId": "6434703",
            "initDialog": "643470301",
            "dialogues": [
                {
                    "id": "643470301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643470302",
                    "speaker": "哈扬",
                    "text": "再见，途经林中最好提前规划路线。"
                }
            ]
        },
        {
            "talkId": "6434704",
            "initDialog": "643470401",
            "dialogues": [
                {
                    "id": "643470401",
                    "speaker": "Player",
                    "text": "关于雨林…"
                },
                {
                    "id": "643470402",
                    "speaker": "哈扬",
                    "text": "如果你了解须弥的话，就会知道，这里只是其中最东部的区域。"
                },
                {
                    "id": "643470403",
                    "speaker": "哈扬",
                    "text": "越过喀万驿再往西，就是一望无际的沙漠了。"
                },
                {
                    "id": "643470404",
                    "speaker": "哈扬",
                    "text": "相传在最最古老的过去，整个须弥都是被绿草覆盖的乐园，而沙漠则是某种灾难的后果。"
                }
            ]
        },
        {
            "talkId": "6434705",
            "initDialog": "643470501",
            "dialogues": [
                {
                    "id": "643470501",
                    "speaker": "Player",
                    "text": "关于死域…"
                },
                {
                    "id": "643470502",
                    "speaker": "哈扬",
                    "text": "死域…是污染的结果。"
                },
                {
                    "id": "643470503",
                    "speaker": "哈扬",
                    "text": "如果不能消灭污染的源头，那它们就会不断地出现。"
                },
                {
                    "id": "643470504",
                    "speaker": "哈扬",
                    "text": "但世界树的污染，哪是可以轻易被消灭的东西呢？"
                },
                {
                    "id": "643470505",
                    "speaker": "哈扬",
                    "text": "在研究出根本性的解决办法之前，也只能辛苦巡林员们了。"
                }
            ]
        },
        {
            "talkId": "6434706",
            "initDialog": "643470601",
            "dialogues": [
                {
                    "id": "643470601",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643470602",
                    "speaker": "哈扬",
                    "text": "我是来道成林进行生态考察的学者，旁边那位是我请来的保镖。我们都不是什么可疑人员，请不必有太大的戒心。"
                },
                {
                    "id": "643470603",
                    "speaker": "哈扬",
                    "text": "最近死域的问题大大缓解，虽然还有些残留，但雨林的环境明显变好了不少。"
                }
            ]
        },
        {
            "talkId": "6434707",
            "initDialog": "643470701",
            "dialogues": [
                {
                    "id": "643470701",
                    "speaker": "Player",
                    "text": "关于死域…"
                },
                {
                    "id": "643470702",
                    "speaker": "哈扬",
                    "text": "就我的观察，雨林中几乎已经没有新的污染出现了。就算是残留的死域，也没有扩散。"
                },
                {
                    "id": "643470703",
                    "speaker": "哈扬",
                    "text": "这是个好兆头，说明世界树已经不再被新的污染侵蚀了。"
                },
                {
                    "id": "643470704",
                    "speaker": "哈扬",
                    "text": "想必接下来在小吉祥草王大人的带领下，我们教令院的学者会在有关世界树的研究上有更新的突破。"
                }
            ]
        }
    ]
}