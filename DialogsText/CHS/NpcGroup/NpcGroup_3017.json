{
    "groupId": "3017",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "幸雄": 13
    },
    "talks": [
        {
            "talkId": "6301701",
            "initDialog": "630170101",
            "dialogues": [
                {
                    "id": "630170101",
                    "speaker": "幸雄",
                    "text": "酱烤禽肉串、盐烤香鱼、狐狸拉面…这位客人，来试试稻妻特色小吃吧？"
                },
                {
                    "id": "630170102",
                    "speaker": "幸雄",
                    "text": "茶的话也有，玄米茶、大麦茶、乌龙茶，想要哪种？只是不卖酒哦。"
                }
            ]
        },
        {
            "talkId": "6301702",
            "initDialog": "630170201",
            "dialogues": [
                {
                    "id": "630170201",
                    "speaker": "Player",
                    "text": "没有酒吗？"
                },
                {
                    "id": "630170202",
                    "speaker": "幸雄",
                    "text": "嗯，很奇怪对吧？但客人你想啊，酒喝多了之后，味蕾会麻痹，不就尝不出料理的味道了吗？"
                },
                {
                    "id": "630170203",
                    "speaker": "幸雄",
                    "text": "所以虽然稻妻小吃里多是下酒菜，但我这里是不卖酒水的哦。"
                },
                {
                    "id": "630170204",
                    "speaker": "幸雄",
                    "text": "在我看来，茶的苦涩和回甘，更能衬托烤串的多汁和酱料的美味，不像酒水一样喧宾夺主。"
                },
                {
                    "id": "630170205",
                    "speaker": "幸雄",
                    "text": "除了烤串之外，想吃饱些的话点份狐狸拉面也不错…啊，话说客人你对豆类不过敏吧？"
                }
            ]
        },
        {
            "talkId": "6301703",
            "initDialog": "630170301",
            "dialogues": [
                {
                    "id": "630170301",
                    "speaker": "Player",
                    "text": "豆类过敏？"
                },
                {
                    "id": "630170302",
                    "speaker": "幸雄",
                    "text": "因为以前有过先例，所以保险起见先问一句。"
                },
                {
                    "id": "630170303",
                    "speaker": "幸雄",
                    "text": "曾经有位鬼族的大哥，和一位有着狐耳的小姐在我这里打赌，比赛谁能吃下更多的狐狸拉面。"
                },
                {
                    "id": "630170304",
                    "speaker": "幸雄",
                    "text": "但狐狸拉面里是有油豆腐的，而鬼族又对豆子过敏…"
                },
                {
                    "id": "630170305",
                    "speaker": "幸雄",
                    "text": "所以那位鬼角长长的大哥虽然赢了比赛，但也差点人没了…这一切，究竟值得吗？"
                }
            ]
        },
        {
            "talkId": "6301704",
            "initDialog": "630170401",
            "dialogues": [
                {
                    "id": "630170401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630170402",
                    "speaker": "幸雄",
                    "text": "慢走，下次再来哦。"
                }
            ]
        },
        {
            "talkId": "7291101",
            "initDialog": "729110101",
            "dialogues": [
                {
                    "id": "729110101",
                    "speaker": "Player",
                    "text": "我还不能喝酒来着。"
                },
                {
                    "id": "729110102",
                    "speaker": "幸雄",
                    "text": "哦哦，客人还没到喝酒的年纪是吧，岂不是正好。那就喝点茶，慢慢品尝稻妻的小吃吧。"
                },
                {
                    "id": "729110103",
                    "speaker": "幸雄",
                    "text": "喏，这些饭团是今天新做的，客人尝尝看，美味又管饱哦。"
                }
            ]
        }
    ]
}