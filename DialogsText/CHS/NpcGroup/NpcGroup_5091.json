{
    "groupId": "5091",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "爱洛依丝": 14
    },
    "talks": [
        {
            "talkId": "6509101",
            "initDialog": "650910101",
            "dialogues": [
                {
                    "id": "650910101",
                    "speaker": "爱洛依丝",
                    "text": "怎么，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6509102",
            "initDialog": "650910201",
            "dialogues": [
                {
                    "id": "650910201",
                    "speaker": "Player",
                    "text": "心情不好？"
                },
                {
                    "id": "650910202",
                    "speaker": "爱洛依丝",
                    "text": "哼，谢谢你的问候。"
                },
                {
                    "id": "650910203",
                    "speaker": "爱洛依丝",
                    "text": "我原本只是来吃个便饭。谁知会因为佐餐的酒选的不好，被那位招待用鼻子尖看人。"
                },
                {
                    "id": "650910204",
                    "speaker": "爱洛依丝",
                    "text": "「莎当」和「歌妲」不都是白葡萄酒品种嘛，吃个饭的事情，至于那么小题大做？"
                },
                {
                    "id": "650910205",
                    "speaker": "爱洛依丝",
                    "text": "最可气的是，我本着息事宁人的想法说那就按他推荐的来，结果不仅价格便宜，味道还真比我自己选的好。"
                },
                {
                    "id": "650910206",
                    "speaker": "爱洛依丝",
                    "text": "本来应该感谢他的…但他的态度真的是…见鬼了。"
                }
            ]
        },
        {
            "talkId": "6509103",
            "initDialog": "650910301",
            "dialogues": [
                {
                    "id": "650910301",
                    "speaker": "Player",
                    "text": "你在思考什么？"
                },
                {
                    "id": "650910302",
                    "speaker": "爱洛依丝",
                    "text": "枫丹的法律体系和庭审流程，为什么是这样的？"
                },
                {
                    "id": "650910303",
                    "speaker": "爱洛依丝",
                    "text": "我去不同的国家走访过，在了解别国的法律之后，我已经越来越难以忍受枫丹如今的戏剧化庭审了。"
                },
                {
                    "id": "650910304",
                    "speaker": "爱洛依丝",
                    "text": "这样的表演既侮辱了法律，也影响了艺术的发展…上头的人到底是怎么想的？"
                }
            ]
        },
        {
            "talkId": "6509104",
            "initDialog": "650910401",
            "dialogues": [
                {
                    "id": "650910401",
                    "speaker": "Player",
                    "text": "没什么事。"
                },
                {
                    "id": "650910402",
                    "speaker": "爱洛依丝",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6509105",
            "initDialog": "650910501",
            "dialogues": [
                {
                    "id": "650910501",
                    "speaker": "Player",
                    "text": "你在思考什么？"
                },
                {
                    "id": "650910502",
                    "speaker": "爱洛依丝",
                    "text": "总觉得枫丹的法律体系和庭审流程，正在发生微妙的变化。"
                },
                {
                    "id": "650910503",
                    "speaker": "爱洛依丝",
                    "text": "之前我去不同的国家走访过，在了解别国的法律之后，有些难以忍受枫丹的戏剧化庭审。"
                },
                {
                    "id": "650910504",
                    "speaker": "爱洛依丝",
                    "text": "不过近来这样的「表演」似乎没有那么夸张了。观众们不像是来看演出的，反而像是来了解法律常识的。"
                },
                {
                    "id": "650910505",
                    "speaker": "爱洛依丝",
                    "text": "…是我的错觉吗？还是再观察一阵吧。"
                }
            ]
        }
    ]
}