    "talks": [
        {
            "talkId": "6972501",
            "initDialog": "697250101",
            "dialogues": [
                {
                    "id": "697250101",
                    "speaker": "薇娜",
                    "text": "难得有个假期，希望旅游途中的牌局能让我好好放松一下…"
                },
                {
                    "id": "697250102",
                    "speaker": "薇娜",
                    "text": "你愿意陪我玩牌吗，异乡的朋友？"
                }
            ]
        },
        {
            "talkId": "6972502",
            "initDialog": "697250201",
            "dialogues": [
                {
                    "id": "697250201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6972503",
            "initDialog": "697250301",
            "dialogues": [
                {
                    "id": "697250301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697250302",
                    "speaker": "薇娜",
                    "text": "没关系，说不定以后我们还能在海露港再见呢，到时候再来玩牌也不迟。"
                }
            ]
        },
        {
            "talkId": "6972504",
            "initDialog": "697250401",
            "dialogues": [
                {
                    "id": "697250401",
                    "speaker": "薇娜",
                    "text": "你是不是没拿出全力呢？就算我是客人，也不用和我这么客气哦。"
                }
            ]
        },
        {
            "talkId": "6972505",
            "initDialog": "697250501",
            "dialogues": [
                {
                    "id": "697250501",
                    "speaker": "薇娜",
                    "text": "你打得很精彩，我玩得很尽兴！"
                }
            ]
        }
    ]
}