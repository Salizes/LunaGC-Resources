{
    "groupId": "1631",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "齐格芙丽雅": 8
    },
    "talks": [
        {
            "talkId": "6163101",
            "initDialog": "616310101",
            "dialogues": [
                {
                    "id": "616310101",
                    "speaker": "齐格芙丽雅",
                    "text": "有什么要送的货吗？去蒙德城里那种。"
                }
            ]
        },
        {
            "talkId": "6163102",
            "initDialog": "616310201",
            "dialogues": [
                {
                    "id": "616310201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "616310202",
                    "speaker": "齐格芙丽雅",
                    "text": "我叫齐格芙丽雅，工作是来回在蒙德和清泉镇跑腿。"
                },
                {
                    "id": "616310203",
                    "speaker": "齐格芙丽雅",
                    "text": "没有活儿干的时候我会在附近采采野菜，找猎人大叔们换点肉吃。"
                },
                {
                    "id": "616310204",
                    "speaker": "齐格芙丽雅",
                    "text": "猎人也不能每天只吃荤的嘛，这算是一桩双方都高兴的买卖。"
                }
            ]
        },
        {
            "talkId": "6163103",
            "initDialog": "616310301",
            "dialogues": [
                {
                    "id": "616310301",
                    "speaker": "Player",
                    "text": "你好像对吃的很感兴趣。"
                },
                {
                    "id": "616310302",
                    "speaker": "齐格芙丽雅",
                    "text": "欸，也算不上兴趣吧，只是…不吃不行呀！"
                },
                {
                    "id": "616310303",
                    "speaker": "齐格芙丽雅",
                    "text": "我所有的薪水都花在饭钱上了，再加上采来的野菜和好心猎人的支援，才勉强每天吃个八分饱…"
                },
                {
                    "id": "616310304",
                    "speaker": "齐格芙丽雅",
                    "text": "然后一开始工作，就又觉得饿了呢…"
                }
            ]
        },
        {
            "talkId": "6163104",
            "initDialog": "616310401",
            "dialogues": [
                {
                    "id": "616310401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616310402",
                    "speaker": "齐格芙丽雅",
                    "text": "路上当心哦。"
                }
            ]
        }
    ]
}