{
    "groupId": "3193",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "露子": 11
    },
    "talks": [
        {
            "talkId": "6319301",
            "initDialog": "631930101",
            "dialogues": [
                {
                    "id": "631930101",
                    "speaker": "露子",
                    "text": "是你们呀，好久不见了！"
                }
            ]
        },
        {
            "talkId": "6319302",
            "initDialog": "631930201",
            "dialogues": [
                {
                    "id": "631930201",
                    "speaker": "Player",
                    "text": "最近如何？"
                },
                {
                    "id": "631930202",
                    "speaker": "露子",
                    "text": "什么如何…？哦哦，你是说珊瑚宫的事务吗？"
                },
                {
                    "id": "631930203",
                    "speaker": "露子",
                    "text": "近来一直在处理战事相关的民生事宜…这种枯燥的话题，恐怕你不会感兴趣吧。"
                },
                {
                    "id": "631930204",
                    "speaker": "露子",
                    "text": "总之，我过得还不错，谢谢你的关心。"
                }
            ]
        },
        {
            "talkId": "6319303",
            "initDialog": "631930301",
            "dialogues": [
                {
                    "id": "631930301",
                    "speaker": "Player",
                    "text": "关于渊下宫…"
                },
                {
                    "id": "631930302",
                    "speaker": "露子",
                    "text": "现人神巫女大人尚未批准开启渊下宫的请求，我们还需要耐心等待。"
                },
                {
                    "id": "631930303",
                    "speaker": "露子",
                    "text": "毕竟现在的当务之急是恢复民生…更长远的计划需要往后放放了。"
                },
                {
                    "id": "631930304",
                    "speaker": "露子",
                    "text": "不过海渊之下我们祖先居住的土地究竟是怎样的景象…要说不怀期待，也是不可能的。"
                },
                {
                    "id": "631930305",
                    "speaker": "露子",
                    "text": "话说回来，这也多亏你的帮忙，外来的旅行者。容我再次感谢。"
                }
            ]
        },
        {
            "talkId": "6319304",
            "initDialog": "631930401",
            "dialogues": [
                {
                    "id": "631930401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631930402",
                    "speaker": "露子",
                    "text": "再见，海祇岛永远欢迎你。"
                }
            ]
        },
        {
            "talkId": "6319305",
            "initDialog": "631930501",
            "dialogues": [
                {
                    "id": "631930501",
                    "speaker": "Player",
                    "text": "关于白夜国…"
                },
                {
                    "id": "631930502",
                    "speaker": "露子",
                    "text": "渊下宫曾经的名字就叫做白夜国。因为地下之国并无日月，只有白夜和常夜两种天象。"
                },
                {
                    "id": "631930503",
                    "speaker": "露子",
                    "text": "我的家系之中曾有一位名叫乌帽子的巫女，在白夜国历史里也算个人物，所以才让我负责「海祇御灵祭」。"
                }
            ]
        }
    ]
}