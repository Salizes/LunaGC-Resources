            "dialogues": [
                {
                    "id": "620840101",
                    "speaker": "摆渡人",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6208402",
            "initDialog": "620840201",
            "dialogues": [
                {
                    "id": "620840201",
                    "speaker": "Player",
                    "text": "…小姐？"
                },
                {
                    "id": "620840202",
                    "speaker": "摆渡人",
                    "text": "……"
                },
                {
                    "id": "620840203",
                    "speaker": "Player",
                    "text": "…怎么没反应？"
                },
                {
                    "id": "620840204",
                    "speaker": "摆渡人",
                    "text": "…莫非，你是在向我搭话吗？"
                },
                {
                    "id": "620840205",
                    "speaker": "摆渡人",
                    "text": "按照璃月的风俗，人们一般是会避免与「往生堂」的子弟交谈的。"
                },
                {
                    "id": "620840206",
                    "speaker": "摆渡人",
                    "text": "所以…你是外来人吧？还是说你是什么「别的东西」…",
                    "choices": [
                        {
                            "id": "620840207",
                            "text": "是外来人。",
                            "response": [
                                {
                                    "id": "620840208",
                                    "speaker": "摆渡人",
                                    "text": "原来如此，你好。"
                                },
                                {
                                    "id": "620840209",
                                    "speaker": "摆渡人",
                                    "text": "我在「往生堂」的门下，想来已经很久没和同门以外的人说过话了。"
                                },
                                {
                                    "id": "620840210",
                                    "speaker": "摆渡人",
                                    "text": "即使在「工作」之时，出于对古老传统以及逝去之人的尊重，与家属之间也不会有交谈。"
                                },
                                {
                                    "id": "620840211",
                                    "speaker": "摆渡人",
                                    "text": "入夜，家属留下必备用具和待客小食，便会紧闭房门。而我们则尽可能悄无声息地完成工作，留下骨灰龛离开。"
                                },
                                {
                                    "id": "620840212",
                                    "speaker": "摆渡人",
                                    "text": "所以遇到这种夜里被人搭话的情况实在太过少见，我刚才并不是有意无视你的，不好意思。"
                                }
                            ]
                        },
                        {
                            "id": "620840213",
                            "text": "没错，是「别的东西」…",
                            "response": [
                                {
                                    "id": "620840214",
                                    "speaker": "摆渡人",
                                    "text": "……果然吗。"
                                },
                                {
                                    "id": "620840215",
                                    "speaker": "摆渡人",
                                    "text": "我是「代替他人直视死亡之人」。"
                                },
                                {
                                    "id": "620840216",
                                    "speaker": "摆渡人",
                                    "text": "我与你来时的一切毫无牵连。"
                                },
                                {
                                    "id": "620840217",
                                    "speaker": "摆渡人",
                                    "text": "我与你去时的一切了无因缘。"
                                },
                                {
                                    "id": "620840218",
                                    "speaker": "摆渡人",
                                    "text": "彷徨的人，请离去吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
