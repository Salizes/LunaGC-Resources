{
    "groupId": "30189",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "阿守": 13
    },
    "talks": [
        {
            "talkId": "7268472",
            "initDialog": "726847201",
            "dialogues": [
                {
                    "id": "726847201",
                    "speaker": "阿守",
                    "text": "我是荒泷豪鼓祭氛围大使阿守，您有什么需要吗？"
                },
                {
                    "id": "726847202",
                    "speaker": "阿守",
                    "text": "您问我的工作？"
                },
                {
                    "id": "726847203",
                    "speaker": "阿守",
                    "text": "啊，氛围大使嘛，主要就是营造火热的氛围，让参加祭典的人们产生「我快要嗨到不行了」的感觉。"
                },
                {
                    "id": "726847204",
                    "speaker": "阿守",
                    "text": "您有那种感觉吗？",
                    "choices": [
                        {
                            "id": "726847205",
                            "text": "完全没有。",
                            "response": [
                                {
                                    "id": "726847207",
                                    "speaker": "阿守",
                                    "text": "请…请不要说这种话啊！"
                                },
                                {
                                    "id": "726847208",
                                    "speaker": "阿守",
                                    "text": "不要这样冷漠地打击我的积极性啊！这样我的工作不就失去了意义吗？"
                                },
                                {
                                    "id": "726847209",
                                    "speaker": "阿守",
                                    "text": "您是老大的挚友，请代替老大给我一些支持吧。拜托了，对我说那句话吧！"
                                },
                                {
                                    "id": "726847210",
                                    "speaker": "Player",
                                    "text": "哪句话？"
                                },
                                {
                                    "id": "726847211",
                                    "speaker": "阿守",
                                    "text": "「我快要嗨到不行了」那句话。",
                                    "choices": [
                                        {
                                            "id": "726847212",
                                            "text": "我快要嗨到不行了。",
                                            "response": [
                                                {
                                                    "id": "726847213",
                                                    "speaker": "阿守",
                                                    "text": "太棒了！太棒了！"
                                                },
                                                {
                                                    "id": "726847214",
                                                    "speaker": "阿守",
                                                    "text": "这是对我最好的认可！"
                                                },
                                                {
                                                    "id": "726847218",
                                                    "speaker": "阿守",
                                                    "text": "来吧，朋友们！接着奏乐！接着舞！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726847215",
                                            "text": "我快要…我快要…抱歉我说不出口。",
                                            "response": [
                                                {
                                                    "id": "726847216",
                                                    "speaker": "阿守",
                                                    "text": "唔…好吧。就算您这样说，但看着荒泷派的大家都在努力做好自己的工作，所以就算这样我也不能松懈…"
                                                },
                                                {
                                                    "id": "726847217",
                                                    "speaker": "阿守",
                                                    "text": "无论遭受什么打击也不放弃，这是老大的教导！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726847206",
                            "text": "根本不会有。"
                        }
                    ]
                }
            ]
        }
    ]
}