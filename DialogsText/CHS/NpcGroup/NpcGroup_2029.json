{
    "groupId": "2029",
    "total_dialogue_lines": 72,
    "speaker_counts": {
        "Player": 17,
        "慧心": 55
    },
    "talks": [
        {
            "talkId": "4003744",
            "initDialog": "400374401",
            "dialogues": [
                {
                    "id": "400374401",
                    "speaker": "慧心",
                    "text": "哦，是你呀。有什么我能帮忙的吗？"
                },
                {
                    "id": "400374402",
                    "speaker": "慧心",
                    "text": "听说这次群玉阁的重建工作多亏了你的帮助才得以顺利完成，海中的敌人也没有对璃月港造成过大的损失，真的非常感谢。"
                },
                {
                    "id": "400374403",
                    "speaker": "慧心",
                    "text": "接下来就请尽情享受海灯节吧。"
                }
            ]
        },
        {
            "talkId": "6202901",
            "initDialog": "620290101",
            "dialogues": [
                {
                    "id": "620290101",
                    "speaker": "慧心",
                    "text": "您是…？民事事务的话请移步璃月总务司。"
                }
            ]
        },
        {
            "talkId": "6202902",
            "initDialog": "620290201",
            "dialogues": [
                {
                    "id": "620290201",
                    "speaker": "Player",
                    "text": "想了解些事情。"
                },
                {
                    "id": "620290202",
                    "speaker": "慧心",
                    "text": "啊好的，在能回答的范围内我会尽可能解答。",
                    "choices": [
                        {
                            "id": "620290203",
                            "text": "关于璃月…",
                            "response": [
                                {
                                    "id": "620290204",
                                    "speaker": "慧心",
                                    "text": "嗯？这么问的话，您是从国外来的吗？"
                                },
                                {
                                    "id": "620290205",
                                    "speaker": "慧心",
                                    "text": "啊，没关系，我们璃月人是不会排外的。璃月作为商港，倒不如说外国人少的话才是令人苦恼的事。"
                                },
                                {
                                    "id": "620290206",
                                    "speaker": "慧心",
                                    "text": "在岩王帝君的引导下，璃月发展至今已经有千年的历史。"
                                },
                                {
                                    "id": "620290207",
                                    "speaker": "慧心",
                                    "text": "先民冶炼矿石、制造琉璃，发展与海外城市的贸易，积累了海量的财富。"
                                },
                                {
                                    "id": "620290208",
                                    "speaker": "慧心",
                                    "text": "最值得自豪的便是全提瓦特流通的货币「摩拉」是由璃月的「黄金屋」所铸造，更是以岩王帝君的本名「摩拉克斯」来定名的。"
                                }
                            ]
                        },
                        {
                            "id": "620290209",
                            "text": "关于「七星」…",
                            "response": [
                                {
                                    "id": "620290210",
                                    "speaker": "慧心",
                                    "text": "「七星」的话，可以说是我的上司…只是介绍下的话应该不算背后议论上司吧？哈哈…"
                                },
                                {
                                    "id": "620290211",
                                    "speaker": "慧心",
                                    "text": "「七星」即璃月常驻议事委员会，也是负责处理璃月政事的七位大商人的统称。"
                                },
                                {
                                    "id": "620290212",
                                    "speaker": "慧心",
                                    "text": "群玉阁的凝光大人你应该听说过吧？「七星」中每一位都是举手投足便能影响整个商界的大人物。"
                                },
                                {
                                    "id": "620290213",
                                    "speaker": "慧心",
                                    "text": "他们会负责贯彻岩王帝君的方针，决议要事，如同岩王帝君的手足一般。"
                                },
                                {
                                    "id": "62090219",
                                    "speaker": "Player",
                                    "text": "能多介绍一些「七星」的事吗？"
                                },
                                {
                                    "id": "62090220",
                                    "speaker": "慧心",
                                    "text": "嗯…实际上「七星」在内部是有明确分工的。"
                                },
                                {
                                    "id": "62090221",
                                    "speaker": "慧心",
                                    "text": "除您熟知的「天权」凝光大人之外，「玉衡」刻晴大人则主掌土地与建设等方面的工作。"
                                },
                                {
                                    "id": "62090222",
                                    "speaker": "慧心",
                                    "text": "毕竟璃月幅员辽阔，必须要严格规划好发展方向才行…"
                                },
                                {
                                    "id": "62090223",
                                    "speaker": "慧心",
                                    "text": "其他几位「七星」大人也都在各自的领域有所建树，是璃月港今日繁华的依托。"
                                }
                            ]
                        },
                        {
                            "id": "620290214",
                            "text": "这里是？",
                            "response": [
                                {
                                    "id": "620290215",
                                    "speaker": "慧心",
                                    "text": "这里是月海亭，「七星」议事的场所，影响整个璃月的很多重大决议都是在这里做出的。"
                                },
                                {
                                    "id": "620290216",
                                    "speaker": "慧心",
                                    "text": "服务「七星」就是服务整个璃月，能在这里做事是我的荣幸。"
                                },
                                {
                                    "id": "620290217",
                                    "speaker": "慧心",
                                    "text": "有时候在这月海亭，觉得自己举手投足都好像威严起来了一样，呵呵。"
                                },
                                {
                                    "id": "620290218",
                                    "speaker": "慧心",
                                    "text": "现在那些「大人们」都不在，估计在忙自己的生意吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6202903",
            "initDialog": "620290301",
            "dialogues": [
                {
                    "id": "620290301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620290302",
                    "speaker": "慧心",
                    "text": "再见，祝您一切顺利。"
                }
            ]
        },
        {
            "talkId": "6202904",
            "initDialog": "620290401",
            "dialogues": [
                {
                    "id": "620290401",
                    "speaker": "慧心",
                    "text": "啊，你好，我没想到这个时间会有人来。"
                }
            ]
        },
        {
            "talkId": "6202905",
            "initDialog": "620290501",
            "dialogues": [
                {
                    "id": "620290501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "620290502",
                    "speaker": "慧心",
                    "text": "现在是月海亭的休息时间，没有事务的时候我会偶尔在这边散散步，思考些事情。"
                },
                {
                    "id": "620290503",
                    "speaker": "慧心",
                    "text": "这世上有太多的参不透的东西，参不透海上季风的规律，参不透天空岛上到底有什么，参不透命运，参不透人心…"
                },
                {
                    "id": "620290504",
                    "speaker": "慧心",
                    "text": "「七星」的那些大人们，究竟在想什么呢…"
                },
                {
                    "id": "620290505",
                    "speaker": "慧心",
                    "text": "难道说「岩之神」他…"
                }
            ]
        },
        {
            "talkId": "6202906",
            "initDialog": "620290601",
            "dialogues": [
                {
                    "id": "620290601",
                    "speaker": "Player",
                    "text": "打扰你了。"
                },
                {
                    "id": "620290602",
                    "speaker": "慧心",
                    "text": "嗯，走夜路要小心。"
                }
            ]
        },
        {
            "talkId": "6202907",
            "initDialog": "620290701",
            "dialogues": [
                {
                    "id": "620290701",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620290702",
                    "speaker": "慧心",
                    "text": "送别了岩王爷后，璃月的子民再也没法得到岩王爷的指引了…"
                },
                {
                    "id": "620290703",
                    "speaker": "慧心",
                    "text": "…引导人民的重担，从此就要由「七星」来肩负了。"
                },
                {
                    "id": "620290704",
                    "speaker": "慧心",
                    "text": "不过我并不担心璃月的未来，毕竟除了「七星」，还有甘雨前辈呢，她的话一定能辅佐好「七星」的！"
                }
            ]
        },
        {
            "talkId": "6202908",
            "initDialog": "620290801",
            "dialogues": [
                {
                    "id": "620290801",
                    "speaker": "慧心",
                    "text": "哦，是你呀。有什么我能帮忙的吗？"
                }
            ]
        },
        {
            "talkId": "6202909",
            "initDialog": "620290901",
            "dialogues": [
                {
                    "id": "620290901",
                    "speaker": "Player",
                    "text": "想了解些事情。"
                },
                {
                    "id": "620290902",
                    "speaker": "慧心",
                    "text": "啊好的，在能回答的范围内我会尽可能解答。"
                }
            ]
        },
        {
            "talkId": "6202910",
            "initDialog": "620291001",
            "dialogues": [
                {
                    "id": "620291001",
                    "speaker": "Player",
                    "text": "关于璃月…"
                },
                {
                    "id": "620291002",
                    "speaker": "慧心",
                    "text": "虽然您并非璃月本地人，但我们璃月人是从来不会排外的。"
                },
                {
                    "id": "620291003",
                    "speaker": "慧心",
                    "text": "璃月作为商港，倒不如说外国人少的话才是令人苦恼的事。"
                },
                {
                    "id": "620291004",
                    "speaker": "慧心",
                    "text": "在岩王帝君的引导下，璃月发展至今已经有千年的历史。"
                },
                {
                    "id": "620291005",
                    "speaker": "慧心",
                    "text": "先民冶炼矿石、制造琉璃，发展与海外城市的贸易，积累了海量的财富。"
                },
                {
                    "id": "620291006",
                    "speaker": "慧心",
                    "text": "最值得自豪的便是全提瓦特流通的货币「摩拉」是由璃月的「黄金屋」所铸造，更是以岩王帝君的本名「摩拉克斯」来定名的。"
                }
            ]
        },
        {
            "talkId": "7202901",
            "initDialog": "720290101",
            "dialogues": [
                {
                    "id": "720290101",
                    "speaker": "慧心",
                    "text": "你好，我是月海亭的干事慧心，服务璃月是我的使命。"
                }
            ]
        },
        {
            "talkId": "7202902",
            "initDialog": "720290201",
            "dialogues": [
                {
                    "id": "720290201",
                    "speaker": "Player",
                    "text": "捐献「明霄灯」材料。"
                },
                {
                    "id": "720290202",
                    "speaker": "慧心",
                    "text": "专程来捐赠材料吗？真是热心！"
                }
            ]
        },
        {
            "talkId": "7202903",
            "initDialog": "720290301",
            "dialogues": [
                {
                    "id": "720290301",
                    "speaker": "Player",
                    "text": "查看「明霄灯」建造进度。"
                },
                {
                    "id": "720290302",
                    "speaker": "慧心",
                    "text": "托璃月大家的福，「明霄灯」的建造正火热进行中哦。"
                }
            ]
        },
        {
            "talkId": "7202904",
            "initDialog": "720290401",
            "dialogues": [
                {
                    "id": "720290401",
                    "speaker": "Player",
                    "text": "关于「海灯节」。"
                },
                {
                    "id": "720290402",
                    "speaker": "慧心",
                    "text": "你是第一次来参加海灯节吗？我可以当你的讲解员哦？",
                    "choices": [
                        {
                            "id": "720290403",
                            "text": "关于「明霄灯」。",
                            "response": [
                                {
                                    "id": "720290404",
                                    "speaker": "慧心",
                                    "text": "在久远之前，英雄与人们一起群策群力守护着璃月的土地。"
                                },
                                {
                                    "id": "720290405",
                                    "speaker": "慧心",
                                    "text": "而如今的和平时代，为了让团结的精神永不磨灭，沿袭下了全城共建巨大浮灯「明霄灯」的习俗。"
                                },
                                {
                                    "id": "720290406",
                                    "speaker": "慧心",
                                    "text": "人们搜集建材，贡献劳力，最后在海灯节闭幕的当天，在全城民众的见证下放飞，是海灯节最重要的「仪式」。"
                                },
                                {
                                    "id": "720290407",
                                    "speaker": "慧心",
                                    "text": "看到「明霄灯」中间的那块巨岩了吗？它是璃月本年度出产的最大的「浮空石」。"
                                },
                                {
                                    "id": "720290408",
                                    "speaker": "慧心",
                                    "text": "「明霄灯」的大小是由当年「浮空石」的大小决定的哦，而今年据说是二十年来最大的一块呢。"
                                },
                                {
                                    "id": "720290409",
                                    "speaker": "慧心",
                                    "text": "为了纪念守护璃月而死的英雄们，「明霄灯」的造型会按照英雄生前的「仙体」来设计建造。"
                                },
                                {
                                    "id": "720290410",
                                    "speaker": "慧心",
                                    "text": "顺便今年的「明霄灯」描绘的是「移霄导天真君」的英姿哦，是月海亭根据民众呼声决定的。"
                                }
                            ]
                        },
                        {
                            "id": "720290411",
                            "text": "关于「霄市」。",
                            "response": [
                                {
                                    "id": "720290412",
                                    "speaker": "慧心",
                                    "text": "「霄市」简单来说就是，海灯节附属的娱乐活动吧。"
                                },
                                {
                                    "id": "720290413",
                                    "speaker": "慧心",
                                    "text": "「明霄灯」的筹建资金很多也是源自于「霄市」上的摊位。"
                                },
                                {
                                    "id": "720290414",
                                    "speaker": "慧心",
                                    "text": "所以说，作为商港的璃月港虽然有很多商贩平时看起来有些小气，但其实都是很好的人哦。"
                                },
                                {
                                    "id": "720290415",
                                    "speaker": "慧心",
                                    "text": "趁着大家聚集于此，多和璃月的子民们聊聊天吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7202905",
            "initDialog": "720290501",
            "dialogues": [
                {
                    "id": "720290501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "720290502",
                    "speaker": "慧心",
                    "text": "再见。愿薪火相传，美德不灭。"
                }
            ]
        }
    ]
}