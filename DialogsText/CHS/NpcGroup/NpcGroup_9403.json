{
    "groupId": "9403",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "爱诺": 9
    },
    "talks": [
        {
            "talkId": "6940301",
            "initDialog": "694030101",
            "dialogues": [
                {
                    "id": "694030101",
                    "speaker": "爱诺",
                    "text": "就算是机械，也需要偶尔关机。平时什么缓冲也不做的话，轻则零件老化，重则过载损坏…更何况是人呢？"
                },
                {
                    "id": "694030102",
                    "speaker": "爱诺",
                    "text": "快来歇歇。哼哼，我提前在袖子里藏了些蛋卷，我们一起享用~"
                },
                {
                    "id": "694030103",
                    "speaker": "爱诺",
                    "text": "…你没把伊涅芙叫来吧？"
                }
            ]
        },
        {
            "talkId": "6940302",
            "initDialog": "694030201",
            "dialogues": [
                {
                    "id": "694030201",
                    "speaker": "爱诺",
                    "text": "即使是像爱诺我这样的天才，在刚刚动手制作第一个机械的时候，也不知道自己最终能不能完成。"
                },
                {
                    "id": "694030202",
                    "speaker": "爱诺",
                    "text": "但是，不尝试肯定是没办法有成果的，对吧？"
                },
                {
                    "id": "694030203",
                    "speaker": "爱诺",
                    "text": "所以呢，还不如先动手再说，就算装了又拆，拆了又装也没关系，说不定试着试着就做好了呢？"
                }
            ]
        },
        {
            "talkId": "6940303",
            "initDialog": "694030301",
            "dialogues": [
                {
                    "id": "694030301",
                    "speaker": "爱诺",
                    "text": "我刚刚看到了那边的「能够播放音乐的神奇机关」…"
                },
                {
                    "id": "694030302",
                    "speaker": "爱诺",
                    "text": "好奇妙…我一眼就能看出来，它的构造和一般的机械机关不太一样。"
                },
                {
                    "id": "694030303",
                    "speaker": "爱诺",
                    "text": "好想拆一拆…欸？我的扳手呢？怎么找不到了——"
                }
            ]
        }
    ]
}