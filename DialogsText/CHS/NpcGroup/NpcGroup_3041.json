{
    "groupId": "3041",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "珊瑚": 14
    },
    "talks": [
        {
            "talkId": "6304101",
            "initDialog": "630410101",
            "dialogues": [
                {
                    "id": "630410101",
                    "speaker": "珊瑚",
                    "text": "万事万物皆有源头…阁下今日拜访「万端珊瑚侦探社」，是为何而来呀？"
                }
            ]
        },
        {
            "talkId": "6304102",
            "initDialog": "630410201",
            "dialogues": [
                {
                    "id": "630410201",
                    "speaker": "Player",
                    "text": "关于「万端珊瑚侦探社」…"
                },
                {
                    "id": "630410202",
                    "speaker": "珊瑚",
                    "text": "正如其名，是帮人查明事件真相的侦探社。"
                },
                {
                    "id": "630410203",
                    "speaker": "珊瑚",
                    "text": "无论是杀人越货、江洋大盗，还是调查外遇、寻找宠物…什么大小难题都能帮你解决——这可不是什么大话哦。"
                },
                {
                    "id": "630410204",
                    "speaker": "珊瑚",
                    "text": "当然对应的，与服务相称的委托费可不便宜，还请阁下准备好报酬再来登门。"
                },
                {
                    "id": "630410205",
                    "speaker": "珊瑚",
                    "text": "让我想想还有什么…啊，对了，还有句经验之谈要先奉劝阁下——"
                },
                {
                    "id": "630410206",
                    "speaker": "珊瑚",
                    "text": "感情是真相的敌人，良知是智慧的累赘。若还没做好接受真相的心，也请不要轻易踏入智慧的门槛哦。"
                }
            ]
        },
        {
            "talkId": "6304103",
            "initDialog": "630410301",
            "dialogues": [
                {
                    "id": "630410301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630410302",
                    "speaker": "珊瑚",
                    "text": "嗯，会再见面的。"
                }
            ]
        },
        {
            "talkId": "6304104",
            "initDialog": "630410401",
            "dialogues": [
                {
                    "id": "630410401",
                    "speaker": "Player",
                    "text": "我想找人。"
                },
                {
                    "id": "630410402",
                    "speaker": "珊瑚",
                    "text": "因为无名神明的袭击而失散的亲人…有意思的事件，值得「万端珊瑚侦探社」出手。"
                },
                {
                    "id": "630410403",
                    "speaker": "珊瑚",
                    "text": "嗯嗯…有见过面的线索是吗，那就方便多了。把你知道的情报都告诉我吧。"
                },
                {
                    "id": "630410404",
                    "speaker": "珊瑚",
                    "text": "……"
                },
                {
                    "id": "630410405",
                    "speaker": "珊瑚",
                    "text": "…喂，再凑过来一点呀。重要的情报可别给外人偷听了去。"
                }
            ]
        },
        {
            "talkId": "6304105",
            "initDialog": "630410501",
            "dialogues": [
                {
                    "id": "630410501",
                    "speaker": "Player",
                    "text": "接下来要出门调查吗？"
                },
                {
                    "id": "630410502",
                    "speaker": "珊瑚",
                    "text": "搜集情报的工作嘛，交给龙二就好了。"
                },
                {
                    "id": "630410503",
                    "speaker": "珊瑚",
                    "text": "…哈？我，偷懒？才不是呢！哼，我看你是完全不懂行哦！"
                },
                {
                    "id": "630410504",
                    "speaker": "珊瑚",
                    "text": "解析线索正如抽丝剥茧，而作为一切事件的核心处理人，我只要耐心等待情报送上门来，汇集在我手中即可。"
                }
            ]
        }
    ]
}