{
    "groupId": "7586",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "别斯特洛夫": 5,
        "谢列布罗夫": 6
    },
    "talks": [
        {
            "talkId": "6758701",
            "initDialog": "675870101",
            "dialogues": [
                {
                    "id": "675870101",
                    "speaker": "别斯特洛夫",
                    "text": "老兄，你不能总是这样，总该为捷丘娜着想一下吧？"
                },
                {
                    "id": "675870102",
                    "speaker": "谢列布罗夫",
                    "text": "嗝…刚刚你说什么来着？"
                },
                {
                    "id": "675870103",
                    "speaker": "别斯特洛夫",
                    "text": "你又喝多了…你是时候学一门手艺了，日子不会总是这么苦，得想一下将来怎么养家，怎么照顾捷丘娜。"
                },
                {
                    "id": "675870104",
                    "speaker": "谢列布罗夫",
                    "text": "嗝…我倒是觉得，我得离她远点，她能照顾好自己的。"
                },
                {
                    "id": "675870105",
                    "speaker": "谢列布罗夫",
                    "text": "她…她也跑了才好呢。"
                },
                {
                    "id": "675870106",
                    "speaker": "别斯特洛夫",
                    "text": "这算什么话？"
                },
                {
                    "id": "675870107",
                    "speaker": "谢列布罗夫",
                    "text": "那样的话…那些帮派成员找过来的时候…我就没什么好怕的了…"
                },
                {
                    "id": "675870108",
                    "speaker": "别斯特洛夫",
                    "text": "…放心，那些帮派成员找不到这里来的。"
                },
                {
                    "id": "675870109",
                    "speaker": "谢列布罗夫",
                    "text": "那…那我又能为她做些什么呢？呜呜…"
                },
                {
                    "id": "675870110",
                    "speaker": "别斯特洛夫",
                    "text": "别哭啊，这样吧，我打算抽时间把一些维修工的手艺教给别尔斯基，你就跟着一起学，怎么样？"
                },
                {
                    "id": "675870111",
                    "speaker": "谢列布罗夫",
                    "text": "好吧，呜呜…"
                }
            ]
        }
    ]
}