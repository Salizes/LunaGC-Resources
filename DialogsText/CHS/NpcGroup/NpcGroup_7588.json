{
    "groupId": "7588",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "莎普林娜": 8
    },
    "talks": [
        {
            "talkId": "6758801",
            "initDialog": "675880101",
            "dialogues": [
                {
                    "id": "675880101",
                    "speaker": "莎普林娜",
                    "text": "嗯…距离炉子这么近，甚至还有点变热了…"
                }
            ]
        },
        {
            "talkId": "6758802",
            "initDialog": "675880201",
            "dialogues": [
                {
                    "id": "675880201",
                    "speaker": "Player",
                    "text": "这个炉子的情况怎么样？"
                },
                {
                    "id": "675880202",
                    "speaker": "莎普林娜",
                    "text": "挺好的，至少支撑得够久…这样也可以供更多的人前来取暖啦。"
                },
                {
                    "id": "675880203",
                    "speaker": "莎普林娜",
                    "text": "而且我从前偷听…呃反正就是听到两个很大声聊天的至冬能源协会的人说，一旦持续温度，能耗也会缓缓降低。"
                },
                {
                    "id": "675880204",
                    "speaker": "莎普林娜",
                    "text": "说不定只要弄来一点克什尼克晶矿，就能让这个家伙运转很久呢…"
                }
            ]
        },
        {
            "talkId": "6758803",
            "initDialog": "675880301",
            "dialogues": [
                {
                    "id": "675880301",
                    "speaker": "Player",
                    "text": "关于阿罗夏…"
                },
                {
                    "id": "675880302",
                    "speaker": "莎普林娜",
                    "text": "嘿嘿，他可是至冬冻原上最强的猎人，不管是什么样的猎物都能猎到手。"
                },
                {
                    "id": "675880303",
                    "speaker": "莎普林娜",
                    "text": "之前看到大家挨冻，他就说：「我来找不用进城不会挨冻的地方！」"
                },
                {
                    "id": "675880304",
                    "speaker": "莎普林娜",
                    "text": "那个时候大家都不信他真能找到…结果还真让他找到啦。"
                }
            ]
        },
        {
            "talkId": "6758804",
            "initDialog": "675880401",
            "dialogues": [
                {
                    "id": "675880401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "675880402",
                    "speaker": "莎普林娜",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
}