{
    "groupId": "9128",
    "total_dialogue_lines": 88,
    "speaker_counts": {
        "Player": 33,
        "法尔伽": 55
    },
    "talks": [
        {
            "talkId": "6912801",
            "initDialog": "691280101",
            "dialogues": [
                {
                    "id": "691280101",
                    "speaker": "法尔伽",
                    "text": "哟！荣誉骑士。"
                },
                {
                    "id": "691280102",
                    "speaker": "法尔伽",
                    "text": "看来你也有一座相当气派的据点呀？"
                }
            ]
        },
        {
            "talkId": "6912802",
            "initDialog": "691280201",
            "dialogues": [
                {
                    "id": "691280201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691280202",
                    "speaker": "法尔伽",
                    "text": "习惯得不得了，「北风」在哪里都能找到适合自己的窝。",
                    "choices": [
                        {
                            "id": "691280203",
                            "text": "这还是「北风」吗…",
                            "response": [
                                {
                                    "id": "691280205",
                                    "speaker": "法尔伽",
                                    "text": "动物为了生存会学着适应各种环境，我在远征前后也做过不少类似的事情。",
                                    "choices": [
                                        {
                                            "id": "691280206",
                                            "text": "远征之前？",
                                            "response": [
                                                {
                                                    "id": "691280207",
                                                    "speaker": "法尔伽",
                                                    "text": "一些动物会躲藏在隐蔽的环境中来规避狩猎者，而那些躲藏地的条件往往不会有多好。"
                                                },
                                                {
                                                    "id": "691280208",
                                                    "speaker": "法尔伽",
                                                    "text": "比如带刺的灌木丛、陡峭的绝壁…西风教会的塔尖、骑士团的屋顶…"
                                                },
                                                {
                                                    "id": "691280209",
                                                    "speaker": "Player",
                                                    "text": "等等，最后两个不太对劲啊？"
                                                },
                                                {
                                                    "id": "691280210",
                                                    "speaker": "法尔伽",
                                                    "text": "哈哈，那都是我逃出办公室之后的躲藏地啊！不过越到后来就越容易被抓住了。"
                                                },
                                                {
                                                    "id": "691280211",
                                                    "speaker": "法尔伽",
                                                    "text": "现在嘛…大概得躲去风龙废墟的风墙里头，或者下着暴雪的龙脊雪山山顶…",
                                                    "choices": [
                                                        {
                                                            "id": "691280212",
                                                            "text": "还、还是待着这里吧…",
                                                            "response": [
                                                                {
                                                                    "id": "691280214",
                                                                    "speaker": "法尔伽",
                                                                    "text": "多谢啦，不过枕头就不用了，睡得太踏实会影响警觉性和逃跑速度。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691280213",
                                                            "text": "需要的话再给你变个枕头。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691280215",
                                            "text": "远征之后？",
                                            "response": [
                                                {
                                                    "id": "691280216",
                                                    "speaker": "法尔伽",
                                                    "text": "远征的路上多的是荒芜又危险的地界，有些时候也必须在里头扎营过夜。"
                                                },
                                                {
                                                    "id": "691280217",
                                                    "speaker": "法尔伽",
                                                    "text": "虽然我们也带了行军床跟帐篷，但总会遇到来不及铺开的夜晚。"
                                                },
                                                {
                                                    "id": "691280218",
                                                    "speaker": "Player",
                                                    "text": "大团长没有自己的大帐吗？"
                                                },
                                                {
                                                    "id": "691280219",
                                                    "speaker": "法尔伽",
                                                    "text": "有倒是有，不过部下要挨冻的时候，待在那里头反而睡不踏实吧？所以我都是把它腾给伤员用的。"
                                                },
                                                {
                                                    "id": "691280220",
                                                    "speaker": "法尔伽",
                                                    "text": "唉，要是那些时候，也有个这么方便的壶就好了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691280204",
                            "text": "听着像是流浪动物…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912803",
            "initDialog": "691280301",
            "dialogues": [
                {
                    "id": "691280301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691280302",
                    "speaker": "法尔伽",
                    "text": "「聊天」？行啊，我可会聊了！"
                },
                {
                    "id": "691280303",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "691280304",
                    "speaker": "Player",
                    "text": "…为何沉默？"
                },
                {
                    "id": "691280305",
                    "speaker": "法尔伽",
                    "text": "…我在等你拿酒出来？难道…没有吗？"
                },
                {
                    "id": "691280306",
                    "speaker": "Player",
                    "text": "没有哦…"
                },
                {
                    "id": "691280307",
                    "speaker": "法尔伽",
                    "text": "不配酒干聊天…哈哈，原来是这样…",
                    "choices": [
                        {
                            "id": "691280308",
                            "text": "你看起来特别失落。",
                            "response": [
                                {
                                    "id": "691280310",
                                    "speaker": "法尔伽",
                                    "text": "没事，我是经验老到的西风骑士，无论遇到怎样的情景都能迅速调节自己的状态…"
                                },
                                {
                                    "id": "691280311",
                                    "speaker": "法尔伽",
                                    "text": "是我今天的期待值不恰当地高了一点而已。我没关系，好，来吧！开始我们的「会谈」。",
                                    "choices": [
                                        {
                                            "id": "691280312",
                                            "text": "呃…会谈？",
                                            "response": [
                                                {
                                                    "id": "691280314",
                                                    "speaker": "法尔伽",
                                                    "text": "这种没有酒的聊天，我通常称之为「会谈」。"
                                                },
                                                {
                                                    "id": "691280315",
                                                    "speaker": "法尔伽",
                                                    "text": "上次「会谈」好像还是在跟魔女会的女士们喝茶？嗯，远征期间也遇上过几次…",
                                                    "choices": [
                                                        {
                                                            "id": "691280316",
                                                            "text": "那干脆就聊聊…",
                                                            "response": [
                                                                {
                                                                    "id": "691280318",
                                                                    "speaker": "法尔伽",
                                                                    "text": "嚯，这确实是个不错的话题。首先拿大家的共同点，或是对方关心的人或事来切入。就比如说…"
                                                                },
                                                                {
                                                                    "id": "691280319",
                                                                    "speaker": "法尔伽",
                                                                    "text": "「哎呀，您家的孩子真可爱！不让人省心？哈哈，孩子嘛，哪有让人省心的，就说我家那两个…」"
                                                                },
                                                                {
                                                                    "id": "691280320",
                                                                    "speaker": "法尔伽",
                                                                    "text": "「想在提瓦特找个落脚地？那肯定得是蒙德啊！我跟您说说这蒙德都有哪些好…」"
                                                                },
                                                                {
                                                                    "id": "691280321",
                                                                    "speaker": "法尔伽",
                                                                    "text": "等话题开始热络之后，再寻找新的突破口…"
                                                                },
                                                                {
                                                                    "id": "691280322",
                                                                    "speaker": "法尔伽",
                                                                    "text": "「您看孩子都留在蒙德了，各位魔女不妨也加入我们？」"
                                                                },
                                                                {
                                                                    "id": "691280323",
                                                                    "speaker": "法尔伽",
                                                                    "text": "「噢，不是要几位加入骑士团的意思，我想想…外援这个词还合适吗？」"
                                                                },
                                                                {
                                                                    "id": "691280324",
                                                                    "speaker": "法尔伽",
                                                                    "text": "接着趁对方还在犹豫的时候，一口气打消掉顾虑！然后一锤定音！"
                                                                },
                                                                {
                                                                    "id": "691280325",
                                                                    "speaker": "法尔伽",
                                                                    "text": "「放心！蒙德本来就什么人都有。您大概听说过？就连北风王狼都是从异乡流浪来的！」"
                                                                },
                                                                {
                                                                    "id": "691280326",
                                                                    "speaker": "法尔伽",
                                                                    "text": "「也不用特地做什么！大部分情况我们自己能处理，真遇上得请诸位出手的时候…我猜也是合乎大家立场的。」"
                                                                },
                                                                {
                                                                    "id": "691280327",
                                                                    "speaker": "Player",
                                                                    "text": "真有两下。"
                                                                },
                                                                {
                                                                    "id": "691280328",
                                                                    "speaker": "法尔伽",
                                                                    "text": "哈哈，多谢你的赞美！那么，为了回报你的赏识，咱们去喝一杯吧，我请！"
                                                                },
                                                                {
                                                                    "id": "691280329",
                                                                    "speaker": "Player",
                                                                    "text": "还惦记着呢！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691280317",
                                                            "text": "你跟魔女会最初是怎么聊的？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691280313",
                                            "text": "倒也不必那么正式…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691280309",
                            "text": "你平时不也聊得挺欢吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912804",
            "initDialog": "691280401",
            "dialogues": [
                {
                    "id": "691280401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691280402",
                    "speaker": "法尔伽",
                    "text": "嗯…想把留在挪德卡莱据点里的沙盘给带进来。",
                    "choices": [
                        {
                            "id": "691280403",
                            "text": "在这也要办公？",
                            "response": [
                                {
                                    "id": "691280405",
                                    "speaker": "法尔伽",
                                    "text": "哈哈…那套沙盘一开始确实是为了做正经战术推演才带上的。"
                                },
                                {
                                    "id": "691280406",
                                    "speaker": "法尔伽",
                                    "text": "后来为了培养骑士们的战术思维，我在闲暇时会把沙盘借出去给他们做假想训练用。"
                                },
                                {
                                    "id": "691280407",
                                    "speaker": "法尔伽",
                                    "text": "其中一些骑士凑巧是「璃月千年」的爱好者，就拿出了自己珍藏的棋子来标识敌我，增强代入感。",
                                    "choices": [
                                        {
                                            "id": "691280408",
                                            "text": "「璃月千年」啊…",
                                            "response": [
                                                {
                                                    "id": "691280410",
                                                    "speaker": "法尔伽",
                                                    "text": "再后来他们觉得假想训练不能局限于遭遇战，还要有敌人的动机、详尽的过程，要加上探索调查和交涉…"
                                                },
                                                {
                                                    "id": "691280411",
                                                    "speaker": "法尔伽",
                                                    "text": "这时又有骑士提出可以参考枫丹的「桌上剧团」，就照那形式写了不少战役模组出来。"
                                                },
                                                {
                                                    "id": "691280412",
                                                    "speaker": "法尔伽",
                                                    "text": "最好的地图、最好的棋子、最好的模组…结果你应该也猜得到。",
                                                    "choices": [
                                                        {
                                                            "id": "691280413",
                                                            "text": "这么好的配置…",
                                                            "response": [
                                                                {
                                                                    "id": "691280415",
                                                                    "speaker": "法尔伽",
                                                                    "text": "嗨，「想象力」也是临敌应变的重要素质，能一边玩得开心，一边有所收获，那当然是最好不过。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "691280416",
                                                                            "text": "老实说…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "691280418",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "691280419",
                                                                                    "speaker": "Player",
                                                                                    "text": "果然。"
                                                                                },
                                                                                {
                                                                                    "id": "691280420",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "咳…这也不能算玩物丧志吧！我有好多计划都是这么推演出来的！"
                                                                                },
                                                                                {
                                                                                    "id": "691280421",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "——而且他们总得找个又懂战场，又懂应变，最好还有点口才的人来主持流程？"
                                                                                },
                                                                                {
                                                                                    "id": "691280422",
                                                                                    "speaker": "Player",
                                                                                    "text": "合着「主持人」就是你啊！"
                                                                                },
                                                                                {
                                                                                    "id": "691280423",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "哈哈，「大团长」来当「带团长」，虽然像是喝酒喝多了大舌头，但也没什么不行的吧？"
                                                                                },
                                                                                {
                                                                                    "id": "691280424",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "下次有团要一起来啊，荣誉骑士！"
                                                                                },
                                                                                {
                                                                                    "id": "691280425",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "话又说回来，你这据点…是不是能当更豪华的沙盘地图来用？"
                                                                                },
                                                                                {
                                                                                    "id": "691280426",
                                                                                    "speaker": "法尔伽",
                                                                                    "text": "就是得自己当棋子跑来跑去，再加上战斗…那不就成真练兵了吗？很难说是更有趣还是更累了啊…"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "691280417",
                                                                            "text": "你是不是也沉迷了？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691280414",
                                                            "text": "换我也想玩。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691280409",
                                            "text": "是那套很贵的战棋…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691280404",
                            "text": "这不像你啊！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912805",
            "initDialog": "691280501",
            "dialogues": [
                {
                    "id": "691280501",
                    "speaker": "Player",
                    "text": "早啊，法尔伽。"
                },
                {
                    "id": "691280502",
                    "speaker": "法尔伽",
                    "text": "早！荣誉骑士。"
                },
                {
                    "id": "691280503",
                    "speaker": "法尔伽",
                    "text": "今天的风很不错，希望你的旅程也能一路顺风。"
                }
            ]
        },
        {
            "talkId": "6912806",
            "initDialog": "691280601",
            "dialogues": [
                {
                    "id": "691280601",
                    "speaker": "Player",
                    "text": "晚安，法尔伽。"
                },
                {
                    "id": "691280602",
                    "speaker": "法尔伽",
                    "text": "嗯，你早点睡。至于我嘛…夜晚的生活才刚开始呢！"
                }
            ]
        },
        {
            "talkId": "6912810",
            "initDialog": "691281001",
            "dialogues": [
                {
                    "id": "691281001",
                    "speaker": "法尔伽",
                    "text": "走在这种地方，总会有种拐个弯就能回到「旗舰」的错觉呀。"
                },
                {
                    "id": "691281002",
                    "speaker": "法尔伽",
                    "text": "我在远征路上也试过不少地方的好酒，璃月的，纳塔的…要论烈度就得上至冬的「火水」！"
                },
                {
                    "id": "691281003",
                    "speaker": "法尔伽",
                    "text": "不过嘛，走了那么远，喝过那么多，才会发现还是老家的酒，最让人念念不忘！哈哈！"
                }
            ]
        },
        {
            "talkId": "6912811",
            "initDialog": "691281101",
            "dialogues": [
                {
                    "id": "691281101",
                    "speaker": "法尔伽",
                    "text": "嗯，在这儿就能更好地修缮武器了。剑变成了两把，维护工作也成了两倍啊。"
                },
                {
                    "id": "691281102",
                    "speaker": "法尔伽",
                    "text": "对「北风骑士」来说，武器既是撕裂敌人的「爪牙」，也是寄托信念的「心脏」。"
                },
                {
                    "id": "691281103",
                    "speaker": "法尔伽",
                    "text": "所以历代骑士们的武器，也常与它们的主人一起成为传奇…你说，将来我的剑，都能留下些什么故事？"
                }
            ]
        }
    ]
}