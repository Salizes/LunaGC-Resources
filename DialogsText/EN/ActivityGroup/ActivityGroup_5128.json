    "talks": [
        {
            "talkId": "7351104",
            "initDialog": "735110401",
            "dialogues": [
                {
                    "id": "735110401",
                    "speaker": "Vinayak",
                    "text": "Brave adventurer, are you ready to go collect those components?",
                    "choices": [
                        {
                            "id": "735110402",
                            "text": "I'm ready.",
                            "response": [
                                {
                                    "id": "735110403",
                                    "speaker": "Vinayak",
                                    "text": "Excellent! In that case, I leave this matter in your hands."
                                }
                            ]
                        },
                        {
                            "id": "735110404",
                            "text": "Not yet.",
                            "response": [
                                {
                                    "id": "735110405",
                                    "speaker": "Vinayak",
                                    "text": "Alright then. Planning ahead is good for efficiency, after all. But don't end up like Shriya, ever planning but never executing."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351302",
            "initDialog": "735130201",
            "dialogues": [
                {
                    "id": "735130201",
                    "speaker": "Vinayak",
                    "text": "Brave adventurer, are you ready now?",
                    "choices": [
                        {
                            "id": "735130202",
                            "text": "I'm ready.",
                            "response": [
                                {
                                    "id": "735130203",
                                    "speaker": "Vinayak",
                                    "text": "Excellent, excellent! Then let us begin."
                                }
                            ]
                        },
                        {
                            "id": "735130204",
                            "text": "Not yet.",
                            "response": [
                                {
                                    "id": "735130205",
                                    "speaker": "Vinayak",
                                    "text": "Alright then. Planning ahead is good for efficiency, after all. But don't spend all your time planning and not executing, like some people."
                                },
                                {
                                    "id": "735130206",
                                    "speaker": "Shriya",
                                    "text": "Hey! What's that supposed to mean!? Are you itching for another debate? I'll prove you wrong, I will!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351502",
            "initDialog": "735150201",
            "dialogues": [
                {
                    "id": "735150201",
                    "speaker": "Vinayak",
                    "text": "Brave adventurer, are you ready to operate the Wenutslayer Cannon?",
                    "choices": [
                        {
                            "id": "735150202",
                            "text": "I'm ready.",
                            "response": [
                                {
                                    "id": "735150203",
                                    "speaker": "Vinayak",
                                    "text": "Alright! Sandstorm's whipping up now. Everyone to your positions!"
                                }
                            ]
                        },
                        {
                            "id": "735150204",
                            "text": "Not yet.",
                            "response": [
                                {
                                    "id": "735150205",
                                    "speaker": "Vinayak",
                                    "text": "Alright then. Planning ahead is good for efficiency, after all. But don't spend all your time planning and not executing, like some people."
                                },
                                {
                                    "id": "735150206",
                                    "speaker": "Shriya",
                                    "text": "Hey! What's that supposed to mean!? Are you itching for another debate? I'll prove you wrong, I will!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351702",
            "initDialog": "735170201",
            "dialogues": [
                {
                    "id": "735170201",
                    "speaker": "Vinayak",
                    "text": "If Shriya's hypotheses are correct, this will be the Wenutslayer Cannon's most critical battle. Brave adventurer, are you ready?",
                    "choices": [
                        {
                            "id": "735170202",
                            "text": "I'm ready.",
                            "response": [
                                {
                                    "id": "735170203",
                                    "speaker": "Vinayak",
                                    "text": "Alright then, let us begin! Let us prove to all of Sumeru that this cannon isn't just a pretty face!"
                                }
                            ]
                        },
                        {
                            "id": "735170204",
                            "text": "Not yet.",
                            "response": [
                                {
                                    "id": "735170205",
                                    "speaker": "Vinayak",
                                    "text": "Alright then. Planning ahead is good for efficiency, after all..."
                                },
                                {
                                    "id": "735170206",
                                    "speaker": "Shriya",
                                    "text": "Huh. Is it just me, or has your attitude improved a little?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351902",
            "initDialog": "735190201",
            "dialogues": [
                {
                    "id": "735190201",
                    "speaker": "Vinayak",
                    "text": "...Well, there are still some affected Wenut nearby. If you've got the time, please help take care of them.",
                    "choices": [
                        {
                            "id": "735190202",
                            "text": "That's what I'm here for.",
                            "response": [
                                {
                                    "id": "735190203",
                                    "speaker": "Vinayak",
                                    "text": "Wonderful! Why, this is the best opportunity to test the full output of the Wenutslayer Cannon, if I do say so myself!"
                                }
                            ]
                        },
                        {
                            "id": "735190204",
                            "text": "Maybe next time.",
                            "response": [
                                {
                                    "id": "735190205",
                                    "speaker": "Vinayak",
                                    "text": "Sure. Just come to me when you have the time."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351903",
            "initDialog": "735190301",
            "dialogues": [
                {
                    "id": "735190301",
                    "speaker": "Shriya",
                    "text": "That idiot...! Who even comes to a café just to write reports!?",
                    "choices": [
                        {
                            "id": "735190302",
                            "text": "Why are you here by yourself?",
                            "response": [
                                {
                                    "id": "735190304",
                                    "speaker": "Shriya",
                                    "text": "Ugh, let's not talk about that half-witted gearhead! The sun must've baked my brains out for me to have believed that he'd seen the light!"
                                },
                                {
                                    "id": "735190305",
                                    "speaker": "Shriya",
                                    "text": "The last time we agreed to meet at a café, I spent half a day to get ready, and even changed into a brand new set of clothes..."
                                },
                                {
                                    "id": "735190306",
                                    "speaker": "Shriya",
                                    "text": "And the first thing he said when he saw me was \"Did you bring the materials and writing tools?\""
                                },
                                {
                                    "id": "735190307",
                                    "speaker": "Shriya",
                                    "text": "Argh! He should just... stay with his precious machines forever! They'll keep him company, I'm sure!"
                                }
                            ]
                        },
                        {
                            "id": "735190303",
                            "text": "Where did Vinayak hop off to?"
                        }
                    ]
                }
            ]
        }
    ]
}