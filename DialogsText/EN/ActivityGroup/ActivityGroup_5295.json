{
    "groupId": "5295",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Assistant Instructor Yehyeh": 6,
        "Komina": 13,
        "Kweku": 11,
        "Player": 14
    },
    "talks": [
        {
            "talkId": "7567002",
            "initDialog": "756700201",
            "dialogues": [
                {
                    "id": "756700201",
                    "speaker": "Komina",
                    "text": "Hey there, you two! How was it?",
                    "choices": [
                        {
                            "id": "756700202",
                            "text": "It was fantastic. I think everyone's really going to like it.",
                            "response": [
                                {
                                    "id": "756700203",
                                    "speaker": "Komina",
                                    "text": "Such high praise! I'm sure Mr. Kweku would really appreciate hearing it."
                                },
                                {
                                    "id": "756700204",
                                    "speaker": "Komina",
                                    "text": "He often stares into space, ever since that battle ended. Every time he comes back around, he pushes us to come up with more and more creative and fun ways to work together with saurians."
                                },
                                {
                                    "id": "756700205",
                                    "speaker": "Komina",
                                    "text": "I'm guessing that once upon a time, he must've had a really good friend — one who's still on his mind..."
                                },
                                {
                                    "id": "756700206",
                                    "speaker": "Komina",
                                    "text": "The good thing is, he's been doing less of that these days... Working with someone as full of beans as Yehyeh every day sure beats sitting around at home alone."
                                }
                            ]
                        },
                        {
                            "id": "756700207",
                            "text": "Why not take one home...?",
                            "response": [
                                {
                                    "id": "756700208",
                                    "speaker": "Komina",
                                    "text": "These little saurians do seem to really charm folks."
                                },
                                {
                                    "id": "756700209",
                                    "speaker": "Komina",
                                    "text": "Sure, they don't talk, and they're always getting into trouble, but as long as I have them around, it just feels like everything's going to be okay..."
                                },
                                {
                                    "id": "756700210",
                                    "speaker": "Komina",
                                    "text": "Maybe this is exactly what Mr. Kweku hopes everyone can experience for themselves.",
                                    "choices": [
                                        {
                                            "id": "756700211",
                                            "text": "Saurians really do make great companions.",
                                            "response": [
                                                {
                                                    "id": "756700213",
                                                    "speaker": "Komina",
                                                    "text": "Spending time with saurians feels amazing. I sometimes think it's more effective than some of my treatments."
                                                },
                                                {
                                                    "id": "756700214",
                                                    "speaker": "Komina",
                                                    "text": "Anyway, enough with the small talk. It's time for me to give the saurians their check-up. If you want to try out those stages, please feel free to do so."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756700212",
                                            "text": "Now I really want another go!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756700215",
                            "text": "I was just about to!",
                            "response": [
                                {
                                    "id": "756700216",
                                    "speaker": "Komina",
                                    "text": "Alright then... Oh, just a heads-up — people tend to lose track of time when they're playing with saurians."
                                },
                                {
                                    "id": "756700217",
                                    "speaker": "Komina",
                                    "text": "When your body starts to feel tired, that's your cue to take a break."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567003",
            "initDialog": "756700301",
            "dialogues": [
                {
                    "id": "756700301",
                    "speaker": "Kweku",
                    "text": "Want to give it a try? The saurians are ready and raring to go.",
                    "choices": [
                        {
                            "id": "756700302",
                            "text": "Sure! I'm ready too.",
                            "response": [
                                {
                                    "id": "756700303",
                                    "speaker": "Kweku",
                                    "text": "Come on then! I'm sure you won't be disappointed."
                                }
                            ]
                        },
                        {
                            "id": "756700304",
                            "text": "I wish I could play longer.",
                            "response": [
                                {
                                    "id": "756700305",
                                    "speaker": "Kweku",
                                    "text": "Seriously? To be honest, before setting up at the Children of Echoes, I was really worried that no one would be interested..."
                                },
                                {
                                    "id": "756700306",
                                    "speaker": "Kweku",
                                    "text": "It wasn't that I had any particular concerns. It's just that when I look into those shiny saurian eyes, I can't help but be reminded of an old friend..."
                                },
                                {
                                    "id": "756700307",
                                    "speaker": "Kweku",
                                    "text": "It was such a good saurian... It was so lively, it practically bounced off the walls. If you weren't playing with it, it'd run in circles around you like a curious toddler."
                                },
                                {
                                    "id": "756700308",
                                    "speaker": "Kweku",
                                    "text": "And then there's Miss Komina... There've been times I wouldn't have known what to do had it not been for her."
                                },
                                {
                                    "id": "756700309",
                                    "speaker": "Kweku",
                                    "text": "But now we have your seal of approval, I feel so much better. People are sure to be interested now, and it's all thanks to you!",
                                    "choices": [
                                        {
                                            "id": "756700310",
                                            "text": "People will be interested no matter what.",
                                            "response": [
                                                {
                                                    "id": "756700312",
                                                    "speaker": "Kweku",
                                                    "text": "Ahahahaha! Regardless, you've been a great help."
                                                },
                                                {
                                                    "id": "756700313",
                                                    "speaker": "Kweku",
                                                    "text": "Next time I come up with a new stage, you'll be the first person I ask to try it out."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756700311",
                                            "text": "It's hard to say no to hanging out with a saurian."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756700314",
                            "text": "I'll be sure to warm up first.",
                            "response": [
                                {
                                    "id": "756700315",
                                    "speaker": "Kweku",
                                    "text": "Warming up before any form of exercise is the right thing to do... Come see me whenever you want to play. I'll be right here."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567004",
            "initDialog": "756700401",
            "dialogues": [
                {
                    "id": "756700401",
                    "speaker": "Assistant Instructor Yehyeh",
                    "text": "Yeh, yeh!",
                    "choices": [
                        {
                            "id": "756700402",
                            "text": "(Pat pat.)",
                            "response": [
                                {
                                    "id": "756700403",
                                    "speaker": "Assistant Instructor Yehyeh",
                                    "text": "Raooo..."
                                }
                            ]
                        },
                        {
                            "id": "756700404",
                            "text": "See you around!",
                            "response": [
                                {
                                    "id": "756700405",
                                    "speaker": "Assistant Instructor Yehyeh",
                                    "text": "Rroo... Mrrooh!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567005",
            "initDialog": "756700501",
            "dialogues": [
                {
                    "id": "756700501",
                    "speaker": "Assistant Instructor Yehyeh",
                    "text": "Hello! Hello!",
                    "choices": [
                        {
                            "id": "756700502",
                            "text": "Did you have fun, Yehyeh?",
                            "response": [
                                {
                                    "id": "756700503",
                                    "speaker": "Assistant Instructor Yehyeh",
                                    "text": "Rawr! Yehyeh's so happy!"
                                }
                            ]
                        },
                        {
                            "id": "756700504",
                            "text": "See you around!",
                            "response": [
                                {
                                    "id": "756700505",
                                    "speaker": "Assistant Instructor Yehyeh",
                                    "text": "Yeh, yeh! See you!"
                                }
                            ]
                        }
                    ]
                }
            ]
