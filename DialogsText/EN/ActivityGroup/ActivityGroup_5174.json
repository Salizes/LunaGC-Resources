    "talks": [
        {
            "talkId": "7467302",
            "initDialog": "746730201",
            "dialogues": [
                {
                    "id": "746730201",
                    "speaker": "Ulman",
                    "text": "Yo! You're back so soon! Did you find the treasure?",
                    "choices": [
                        {
                            "id": "746730202",
                            "text": "Show me what you've got.",
                            "response": [
                                {
                                    "id": "746730210",
                                    "speaker": "Ulman",
                                    "text": "Sure, have a look!"
                                }
                            ]
                        },
                        {
                            "id": "746730203",
                            "text": "Why did you come to Fontaine?",
                            "response": [
                                {
                                    "id": "746730204",
                                    "speaker": "Ulman",
                                    "text": "Of course I'm here to... Uh... do business! A few of my business partners came here, so of course I came as well."
                                },
                                {
                                    "id": "746730205",
                                    "speaker": "Paimon",
                                    "text": "Hey, aren't those business partners of yours... Treasure Hoarders or something of the sort?"
                                },
                                {
                                    "id": "746730206",
                                    "speaker": "Ulman",
                                    "text": "No way! I'd never work with people like that! It'd be way too risky..."
                                },
                                {
                                    "id": "746730207",
                                    "speaker": "Ulman",
                                    "text": "Uh... Or at least I wouldn't work with them directly. If for some reason I had to work with them, I'd need to find a middleman."
                                }
                            ]
                        },
                        {
                            "id": "746730208",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "746730209",
                                    "speaker": "Ulman",
                                    "text": "Goodbye! I leave retrieving the Ancient Iron Coins to you, remember to bring any you find to me! I'll definitely buy them for a good price."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7467402",
            "initDialog": "746740201",
            "dialogues": [
                {
                    "id": "746740201",
                    "speaker": "Ulman",
                    "text": "What to do, what to do... *sigh* Maybe I should just go straight back to Mondstadt..."
                },
                {
                    "id": "746740202",
                    "speaker": "Ulman",
                    "text": "It's been so long that I've forgotten even the taste of Dandelion Wine...",
                    "choices": [
                        {
                            "id": "746740203",
                            "text": "Show me what you've got.",
                            "response": [
                                {
                                    "id": "746740205",
                                    "speaker": "Ulman",
                                    "text": "Sure, have a look!"
                                }
                            ]
                        },
                        {
                            "id": "746740204",
                            "text": "See you.",
                            "response": [
                                {
                                    "id": "746740206",
                                    "speaker": "Ulman",
                                    "text": "See you next time! I've got a feeling we'll be working together again in the future. I'll be counting on you when the time comes!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}