{
    "groupId": "5191",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Brest": 17,
        "Paimon": 7,
        "Player": 8
    },
    "talks": [
        {
            "talkId": "7468510",
            "initDialog": "746851001",
            "dialogues": [
                {
                    "id": "746851001",
                    "speaker": "Brest",
                    "text": "Ready to experience the joy of the Crococannon?",
                    "choices": [
                        {
                            "id": "746851002",
                            "text": "More than ready, it's bubbleball time!",
                            "response": [
                                {
                                    "id": "746851003",
                                    "speaker": "Brest",
                                    "text": "Great, have fun!"
                                }
                            ]
                        },
                        {
                            "id": "746851004",
                            "text": "About your old job...",
                            "response": [
                                {
                                    "id": "746851005",
                                    "speaker": "Brest",
                                    "text": "As I said before, I was a naval artillery engineer. Not to brag, but I was one of the top three engineers on the team!"
                                },
                                {
                                    "id": "746851006",
                                    "speaker": "Paimon",
                                    "text": "Top three! Wow, you're amazing!"
                                },
                                {
                                    "id": "746851007",
                                    "speaker": "Brest",
                                    "text": "Hehe, though at that time our team only had three engineers."
                                },
                                {
                                    "id": "746851008",
                                    "speaker": "Paimon",
                                    "text": "Wait, wouldn't that make you the worst?"
                                },
                                {
                                    "id": "746851009",
                                    "speaker": "Brest",
                                    "text": "Th—Though my skills were pretty average, I was really lucky! I never had a single accident at work, and I even managed to avoid that huge explosion."
                                },
                                {
                                    "id": "746851010",
                                    "speaker": "Brest",
                                    "text": "And when I was feeling utterly lost, I suddenly came across Monsieur Chatillon's blueprints."
                                },
                                {
                                    "id": "746851011",
                                    "speaker": "Brest",
                                    "text": "It gave me the chance to not only create and spread happiness for other people, but also to run into the best of partners! I have to say, I really am fortunate!",
                                    "choices": [
                                        {
                                            "id": "746851012",
                                            "text": "You really are fortunate.",
                                            "response": [
                                                {
                                                    "id": "746851015",
                                                    "speaker": "Brest",
                                                    "text": "Hehe, that's right! Since I'm this lucky, I believe that as long as I try my best, good things are bound to happen! Building a water park will be a cinch!",
                                                    "choices": [
                                                        {
                                                            "id": "746851016",
                                                            "text": "You can't rely only on luck...",
                                                            "response": [
                                                                {
                                                                    "id": "746851017",
                                                                    "speaker": "Brest",
                                                                    "text": "That's true, opening a water park isn't that easy. Funding, brand awareness, and a ton more... you can't drop the ball on any of them."
                                                                },
                                                                {
                                                                    "id": "746851018",
                                                                    "speaker": "Brest",
                                                                    "text": "But I've already taken all that into consideration! I have faith that as long as the Crococannon can target the entertainment equipment market and let loose, everything will get better!"
                                                                },
                                                                {
                                                                    "id": "746851019",
                                                                    "speaker": "Brest",
                                                                    "text": "Naturally, the first and most important step is to promote the Crococannon! So, please have fun playing with it!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746851020",
                                                            "text": "Hope it goes well.",
                                                            "response": [
                                                                {
                                                                    "id": "746851021",
                                                                    "speaker": "Paimon",
                                                                    "text": "Don't give up, Ms. Brest! Paimon believes in you!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746851013",
                                            "text": "True, we really are the best.",
                                            "response": [
                                                {
                                                    "id": "746851014",
                                                    "speaker": "Paimon",
                                                    "text": "Hey, the point is her good luck!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746851022",
                            "text": "About Chatillon...",
                            "response": [
                                {
                                    "id": "746851023",
                                    "speaker": "Paimon",
                                    "text": "Yeah, have you ever met Mr. Chatillon? How is he?"
                                },
                                {
                                    "id": "746851024",
                                    "speaker": "Brest",
                                    "text": "Regrettably, I never got the chance to meet him. After all, he passed away long before I was born..."
                                },
                                {
                                    "id": "746851025",
                                    "speaker": "Paimon",
                                    "text": "So Mr. Chatillon is already..."
                                },
                                {
                                    "id": "746851026",
                                    "speaker": "Brest",
                                    "text": "But I'm positive he must've lived a very happy life! After all, the words in his design documents are filled with hope and strength."
                                },
                                {
                                    "id": "746851027",
                                    "speaker": "Brest",
                                    "text": "\"In the past, I used cannons to fight external enemies. Now, I use them to destroy my sorrows. Peace is hard-won, and only by picking ourselves up and being happy do we honor the sacrifice of those who died...\""
                                },
                                {
                                    "id": "746851028",
                                    "speaker": "Brest",
                                    "text": "I was so inspired by his words that I immediately resolved to carry on his will, and restarted the \"Crococannon\" project."
                                },
                                {
                                    "id": "746851029",
                                    "speaker": "Paimon",
                                    "text": "If Mr. Chatillon knew, he'd definitely be really proud of you!"
                                },
                                {
                                    "id": "746851030",
                                    "speaker": "Brest",
                                    "text": "Hehe, then for Monsieur Chatillon, for picking ourselves up and being happy, please, continue to operate the Crococannon, and have fun to your heart's content!"
                                }
                            ]
                        },
                        {
                            "id": "746851031",
                            "text": "We'll be back later.",
                            "response": [
                                {
                                    "id": "746851032",
                                    "speaker": "Brest",
                                    "text": "No problem, I'll be around here for some time, so come back whenever you'd like!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}