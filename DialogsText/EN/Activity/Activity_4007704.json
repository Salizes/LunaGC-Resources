    },
    "dialogues": [
        {
            "id": "400770401",
            "speaker": "Mona",
            "text": "Is this the end of our vacation...",
            "choices": [
                {
                    "id": "400770402",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400770403",
                            "speaker": "Mona",
                            "text": "Sure, is there something you wanted to ask me?",
                            "choices": [
                                {
                                    "id": "400770406",
                                    "text": "About your scryglass...",
                                    "response": [
                                        {
                                            "id": "400770407",
                                            "speaker": "Mona",
                                            "text": "*sigh* It's really quite frustrating. Lately, my scryglass has been acting up whenever something major occurs."
                                        },
                                        {
                                            "id": "400770408",
                                            "speaker": "Mona",
                                            "text": "...It's as if it's deliberately trying to stop me from seeing how things will end."
                                        },
                                        {
                                            "id": "400770409",
                                            "speaker": "Mona",
                                            "text": "Hold on... I hope you didn't bring that up just to poke fun at me?"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770410",
                                    "text": "About the starry sky...",
                                    "response": [
                                        {
                                            "id": "400770411",
                                            "speaker": "Mona",
                                            "text": "Oh, I actually wanted to ask you as well. How did you feel when you saw that stretch of sky?"
                                        },
                                        {
                                            "id": "400770412",
                                            "speaker": "Player",
                                            "text": "It was magnificent!"
                                        },
                                        {
                                            "id": "400770413",
                                            "speaker": "Mona",
                                            "text": "Oh... oh really?"
                                        },
                                        {
                                            "id": "400770414",
                                            "speaker": "Mona",
                                            "text": "Well, I—I am a genius astrologist, after all. Of course my mirage was going to be magnificent..."
                                        },
                                        {
                                            "id": "400770415",
                                            "speaker": "Player",
                                            "text": "That's the Mona I know!"
                                        },
                                        {
                                            "id": "400770416",
                                            "speaker": "Mona",
                                            "text": "Hmm... But I was so immersed in my thoughts at the time, I didn't realize how magnificent until I heard you speak..."
                                        },
                                        {
                                            "id": "400770417",
                                            "speaker": "Player",
                                            "text": "It was so spellbinding!"
                                        },
                                        {
                                            "id": "400770418",
                                            "speaker": "Mona",
                                            "text": "Yes, I know... It was on purpose, wasn't it?"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770419",
                                    "text": "About this vacation...",
                                    "response": [
                                        {
                                            "id": "400770420",
                                            "speaker": "Mona",
                                            "text": "Although I'm only here because Fischl dragged me along, somewhere on the way, this turned into a wonderful summer."
                                        },
                                        {
                                            "id": "400770421",
                                            "speaker": "Mona",
                                            "text": "To bear witness and to defend everyone's destiny... that's exactly what I try to do."
                                        },
                                        {
                                            "id": "400770422",
                                            "speaker": "Player",
                                            "text": "You've done a great job."
                                        },
                                        {
                                            "id": "400770423",
                                            "speaker": "Mona",
                                            "text": "Thank you. You too, of course... you've done a lot here."
                                        },
                                        {
                                            "id": "400770424",
                                            "speaker": "Mona",
                                            "text": "I look forward to working with you again, hehe... I'm sure we will be even better partners."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770404",
                    "text": "I won't disturb you.",
                    "response": [
                        {
                            "id": "400770405",
                            "speaker": "Mona",
                            "text": "Mmm, make sure to enjoy yourself before leaving this island.",
                            "choices": [
                                {
                                    "id": "400770406",
                                    "text": "About your scryglass..."
                                },
                                {
                                    "id": "400770410",
                                    "text": "About the starry sky..."
                                },
                                {
                                    "id": "400770419",
                                    "text": "About this vacation..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}