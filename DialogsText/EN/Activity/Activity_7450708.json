{
    "talkId": "7450708",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Bongo-Head": 6,
        "Kindlejoy": 6,
        "Observe the \"Miss Gardemetiquette\"": 1,
        "Observe the Gardemek": 2,
        "Paimon": 25,
        "Player": 9
    },
    "dialogues": [
        {
            "id": "745070801",
            "speaker": "Paimon",
            "text": "Bongo-Head! Kindlejoy! Long time no see! Paimon's missed you!",
            "choices": [
                {
                    "id": "745070802",
                    "text": "Pinch our fungi friends!",
                    "response": [
                        {
                            "id": "745070803",
                            "speaker": "Bongo-Head",
                            "text": "♪"
                        },
                        {
                            "id": "745070804",
                            "speaker": "Kindlejoy",
                            "text": "♫~"
                        },
                        {
                            "id": "745070805",
                            "speaker": "Paimon",
                            "text": "Paimon wants to hold Bongo-Head and pinch Kindlejoy, too!"
                        },
                        {
                            "id": "745070806",
                            "speaker": "Bongo-Head",
                            "text": "♪♪~"
                        },
                        {
                            "id": "745070807",
                            "speaker": "Kindlejoy",
                            "text": "♫♫~"
                        },
                        {
                            "id": "745070808",
                            "speaker": "Paimon",
                            "text": "Huh? Hold on a second..."
                        },
                        {
                            "id": "745070809",
                            "speaker": "Paimon",
                            "text": "You both still look more or less the same, but it feels like... you've gotten rounder!",
                            "choices": [
                                {
                                    "id": "745070810",
                                    "text": "That means they've been eating well!",
                                    "response": [
                                        {
                                            "id": "745070812",
                                            "speaker": "Paimon",
                                            "text": "Well, if they keep eating well, maybe they'll be bigger than even us one day!"
                                        },
                                        {
                                            "id": "745070813",
                                            "speaker": "Paimon",
                                            "text": "Then, when we travel together, Bongo-Head can put us on its head and fly in the sky!"
                                        },
                                        {
                                            "id": "745070814",
                                            "speaker": "Paimon",
                                            "text": "And if Bongo-Head gets tired, then Kindlejoy will take us, or we can find a Sumpter Beast and all ride on it!"
                                        },
                                        {
                                            "id": "745070815",
                                            "speaker": "Bongo-Head",
                                            "text": "♪♪♪!"
                                        },
                                        {
                                            "id": "745070816",
                                            "speaker": "Kindlejoy",
                                            "text": "♫♫♫!"
                                        },
                                        {
                                            "id": "745070817",
                                            "speaker": "Paimon",
                                            "text": "Looks like you're all looking forward to the journey, huh?"
                                        },
                                        {
                                            "id": "745070818",
                                            "speaker": "Paimon",
                                            "text": "Once the Wisdom Orb is improved, and the Fungi can move more freely..."
                                        },
                                        {
                                            "id": "745070819",
                                            "speaker": "Paimon",
                                            "text": "#Where should we go? {NICKNAME}, should we start planning?"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070811",
                                    "text": "That means Haniyyah is taking good care of them!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070820",
                    "text": "Let's feed them first.",
                    "response": [
                        {
                            "id": "745070821",
                            "speaker": "Paimon",
                            "text": "Sure! We have a few new jelly flavors this time, too. What flavor will we go with?",
                            "choices": [
                                {
                                    "id": "745070822",
                                    "text": "Use the Fish and Chips-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "745070823",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "745070824",
                                            "speaker": "Kindlejoy",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "745070825",
                                            "speaker": "Paimon",
                                            "text": "Paimon didn't think the fungi would like Fish and Chips!"
                                        },
                                        {
                                            "id": "745070826",
                                            "speaker": "Paimon",
                                            "text": "Guess they're not picky about what they eat. That's good! A good appetite is important for staying healthy!"
                                        },
                                        {
                                            "id": "745070837",
                                            "speaker": "Paimon",
                                            "text": "Hmm... Y'know, since we've discovered new dishes in Fontaine, we can tell Haniyyah and get her to develop new jelly flavors!"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070827",
                                    "text": "Use the Coffee-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "745070828",
                                            "speaker": "Bongo-Head",
                                            "text": "!"
                                        },
                                        {
                                            "id": "745070829",
                                            "speaker": "Kindlejoy",
                                            "text": "!"
                                        },
                                        {
                                            "id": "745070830",
                                            "speaker": "Paimon",
                                            "text": "They look even more energetic now!"
                                        },
                                        {
                                            "id": "745070831",
                                            "speaker": "Paimon",
                                            "text": "Huh, do Coffee-flavored jellies actually contain coffee?"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070832",
                                    "text": "Use the Fonta-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "745070833",
                                            "speaker": "Bongo-Head",
                                            "text": "?"
                                        },
                                        {
                                            "id": "745070834",
                                            "speaker": "Kindlejoy",
                                            "text": "?"
                                        },
                                        {
                                            "id": "745070835",
                                            "speaker": "Paimon",
                                            "text": "Uh, it looks like they're about to float away!"
                                        },
                                        {
                                            "id": "745070836",
                                            "speaker": "Paimon",
                                            "text": "So they can't have carbonated things?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070838",
                    "text": "And this is...",
                    "response": [
                        {
                            "id": "745070839",
                            "speaker": "Paimon",
                            "text": "Looks like a Gardemek that Turenna brought with her."
                        },
                        {
                            "id": "745070840",
                            "speaker": "Paimon",
                            "text": "Was it playing with the Fungi while we were gone?"
                        },
                        {
                            "id": "745070841",
                            "speaker": "Observe the Gardemek",
                            "text": "(The Gardemek seems to nod as its parts whirl and make low mechanical noises.)"
                        },
                        {
                            "id": "745070842",
                            "speaker": "Observe the Gardemek",
                            "text": "(Despite not speaking, it gives off a sense of... elegance, for some reason.)"
                        },
                        {
                            "id": "745070843",
                            "speaker": "Paimon",
                            "text": "How polite! Paimon will give you a great nickname!"
                        },
                        {
                            "id": "745070844",
                            "speaker": "Paimon",
                            "text": "How about... Miss Gardemetiquette!"
                        },
                        {
                            "id": "745070845",
                            "speaker": "Observe the \"Miss Gardemetiquette\"",
                            "text": "(The Gardemek's visible parts glow faintly with joy.)"
                        },
                        {
                            "id": "745070846",
                            "speaker": "Paimon",
                            "text": "Hey! Seems like it likes the name!"
                        },
                        {
                            "id": "745070847",
                            "speaker": "Paimon",
                            "text": "The fungi will be happy to have a new friend like you, Miss Gardemetiquette!"
                        }
                    ]
                },
                {
                    "id": "745070848",
                    "text": "Let's leave for now...",
                    "response": [
                        {
                            "id": "745070849",
                            "speaker": "Paimon",
                            "text": "Well, we'll come play with our Fungi friends when we have time, right?"
                        }
                    ]
                }
            ]
        }
    ]
}