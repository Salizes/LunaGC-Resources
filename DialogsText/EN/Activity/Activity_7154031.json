{
    "talkId": "7154031",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "Tighnari": 10
    },
    "dialogues": [
        {
            "id": "715403101",
            "speaker": "Tighnari",
            "text": "What should I get...?",
            "choices": [
                {
                    "id": "715403102",
                    "text": "Tighnari, this gift envelope is for you.",
                    "response": [
                        {
                            "id": "715403103",
                            "speaker": "Tighnari",
                            "text": "#Ah, I didn't expect to see you here, {NICKNAME}. Thank you for the envelope — it's lovely."
                        },
                        {
                            "id": "715403104",
                            "speaker": "Player",
                            "text": "Enjoying the festival?"
                        },
                        {
                            "id": "715403105",
                            "speaker": "Tighnari",
                            "text": "Cyno and I have had a great time. We ate a lot of delicious food and bought quite a few gifts."
                        },
                        {
                            "id": "715403106",
                            "speaker": "Tighnari",
                            "text": "Unfortunately, the Harbor is a little too busy this time of year. If I stay around the commotion for too long, my ears start to hurt."
                        },
                        {
                            "id": "715403107",
                            "speaker": "Tighnari",
                            "text": "So, I came over here for a break."
                        },
                        {
                            "id": "715403108",
                            "speaker": "Tighnari",
                            "text": "Cyno said he needed to be alone for a while to think about something.",
                            "choices": [
                                {
                                    "id": "715403109",
                                    "text": "Oh... a case of some sort?",
                                    "response": [
                                        {
                                            "id": "715403111",
                                            "speaker": "Tighnari",
                                            "text": "No, I don't think so..."
                                        },
                                        {
                                            "id": "715403112",
                                            "speaker": "Tighnari",
                                            "text": "He kept mumbling about \"gift envelopes,\" so odds are, he's trying to come up with a new joke..."
                                        },
                                        {
                                            "id": "715403113",
                                            "speaker": "Tighnari",
                                            "text": "How do you even make a joke out of something like that...?"
                                        }
                                    ]
                                },
                                {
                                    "id": "715403110",
                                    "text": "Something to do with work?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715403114",
                    "text": "See you later, then.",
                    "response": [
                        {
                            "id": "715403115",
                            "speaker": "Tighnari",
                            "text": "Bye! I'm going to look for Cyno. *sigh* Let's hope he's not feeling too inspired today..."
                        }
                    ]
                }
            ]
        }
    ]
}