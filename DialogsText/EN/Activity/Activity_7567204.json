{
    "talkId": "7567204",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Minnie": 14,
        "Player": 12,
        "Varesa": 18
    },
    "dialogues": [
        {
            "id": "756720401",
            "speaker": "Varesa",
            "text": "Minnie, Minnie... Look at what Asha painted over there. Doesn't it look like a Fonta bottle got knocked over... with juice splashed all over a mushroom pizza?"
        },
        {
            "id": "756720402",
            "speaker": "Minnie",
            "text": "You're right! It sure looks like it..."
        },
        {
            "id": "756720403",
            "speaker": "Minnie",
            "text": "Now I want to eat it."
        },
        {
            "id": "756720404",
            "speaker": "Varesa",
            "text": "Me too... But isn't it a bit strange to mix the flavor of Bulle Fruit with mushroom?",
            "choices": [
                {
                    "id": "756720405",
                    "text": "Should we give it a try?",
                    "response": [
                        {
                            "id": "756720406",
                            "speaker": "Varesa",
                            "text": "Huh? Am I... hallucinating from too many mushrooms...?"
                        },
                        {
                            "id": "756720407",
                            "speaker": "Minnie",
                            "text": "#Nope. It's really {NICKNAME}! What a surprise to see you here at the resort!",
                            "choices": [
                                {
                                    "id": "756720408",
                                    "text": "Your name was... Minnie, right?",
                                    "response": [
                                        {
                                            "id": "756720409",
                                            "speaker": "Minnie",
                                            "text": "Oh, you remember me? Nice... I feel really encouraged again..."
                                        },
                                        {
                                            "id": "756720410",
                                            "speaker": "Varesa",
                                            "text": "That's right! She's our lead artist at The Legion of Soulblazers who's now working on a side story For The Soulblazer Saga."
                                        },
                                        {
                                            "id": "756720411",
                                            "speaker": "Varesa",
                                            "text": "Minnie's done something really amazing this time, she came all the way to Natlan by herself, riding in on the adventurers' caravan!",
                                            "choices": [
                                                {
                                                    "id": "756720412",
                                                    "text": "That really is a long way to come.",
                                                    "response": [
                                                        {
                                                            "id": "756720414",
                                                            "speaker": "Minnie",
                                                            "text": "#It's okay now, and it's all thanks to you, {NICKNAME}, Varesa, and Xilonen. You convinced my parents before, so they're not as strict anymore."
                                                        },
                                                        {
                                                            "id": "756720415",
                                                            "speaker": "Minnie",
                                                            "text": "After the cross-country challenge, I finally had the chance to draw some public service posters for the Church of Favonius, as well as illustrations for a few publications..."
                                                        },
                                                        {
                                                            "id": "756720416",
                                                            "speaker": "Minnie",
                                                            "text": "Later on, Varesa sent a story I wrote inspired by The Soulblazer Saga to Yae Publishing House, and it was noticed by Ms. Asagiri, the famous illustrator."
                                                        },
                                                        {
                                                            "id": "756720417",
                                                            "speaker": "Minnie",
                                                            "text": "What incredible luck! Ms. Asagiri liked my work so much, she even wrote a letter to mom and dad."
                                                        },
                                                        {
                                                            "id": "756720418",
                                                            "speaker": "Minnie",
                                                            "text": "Now, my parents understand that illustration can be a serious career and is very much worth my time.",
                                                            "choices": [
                                                                {
                                                                    "id": "756720419",
                                                                    "text": "Sounds like things are going well for you.",
                                                                    "response": [
                                                                        {
                                                                            "id": "756720421",
                                                                            "speaker": "Varesa",
                                                                            "text": "If you ask me, Minnie, you should believe in yourself more. Your skills have nothing to do with luck. They're the result of your hard work every day."
                                                                        },
                                                                        {
                                                                            "id": "756720422",
                                                                            "speaker": "Varesa",
                                                                            "text": "It's like... how I can wrestle pretty well these days thanks to my training with Coach Iansan."
                                                                        },
                                                                        {
                                                                            "id": "756720423",
                                                                            "speaker": "Varesa",
                                                                            "text": "Ms. Asagiri has also worked on illustrations and comics for many \"The Soulblazers\" titles, and she directly recommended Minnie to Editor Moriko, who is known for her extremely high standards..."
                                                                        },
                                                                        {
                                                                            "id": "756720424",
                                                                            "speaker": "Varesa",
                                                                            "text": "And it so happened that they had been looking for an artist for the comic adaptation of a side story in The Soulblazer Saga for quite some time..."
                                                                        },
                                                                        {
                                                                            "id": "756720425",
                                                                            "speaker": "Varesa",
                                                                            "text": "They had Minnie take a written test, on which she scored over 90 points and even broke the recruitment record!",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "756720426",
                                                                                    "text": "That's incredible!",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "756720428",
                                                                                            "speaker": "Minnie",
                                                                                            "text": "T—thank you!!!"
                                                                                        },
                                                                                        {
                                                                                            "id": "756720429",
                                                                                            "speaker": "Minnie",
                                                                                            "text": "But this isn't the time to celebrate yet... To be honest, it makes me rather nervous to work on such an important series when I don't even have anything else published yet..."
                                                                                        },
                                                                                        {
                                                                                            "id": "756720430",
                                                                                            "speaker": "Minnie",
                                                                                            "text": "I'll keep improving my skills while I try my best to complete this work."
                                                                                        },
                                                                                        {
                                                                                            "id": "756720431",
                                                                                            "speaker": "Minnie",
                                                                                            "text": "For this trip to Natlan, I'm not only planning to meet up with Varesa, Xilonen, and Nepecha, but I also want to explore as much of the local culture as I can, so I'll have plenty of reference for the job!"
                                                                                        },
                                                                                        {
                                                                                            "id": "756720432",
                                                                                            "speaker": "Varesa",
                                                                                            "text": "Heh heh. I got my hands on several... relics (?) from the Saurian Relics Association when I was selling fruits over at the Stadium of the Sacred Flame recently."
                                                                                        },
                                                                                        {
                                                                                            "id": "756720433",
                                                                                            "speaker": "Varesa",
                                                                                            "text": "So, in short, I now have a better understanding of how Fietena and Taika were portrayed in history, and even their Saurian companions and caravans!"
                                                                                        },
                                                                                        {
                                                                                            "id": "756720434",
                                                                                            "speaker": "Varesa",
                                                                                            "text": "You can send me your first draft. I'd be happy to give you some feedback!"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "756720427",
                                                                                    "text": "Congrats!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756720420",
                                                                    "text": "That's good news."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756720413",
                                                    "text": "Isn't your family worried about you?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756720435",
                                    "text": "Who's this? I don't think we've met before...?",
                                    "response": [
                                        {
                                            "id": "756720436",
                                            "speaker": "Varesa",
                                            "text": "Allow me to introduce Minnie, our lead artist at The Legion of Soulblazers. She's a friend of mine who's also really into woven scroll comics."
                                        },
                                        {
                                            "id": "756720437",
                                            "speaker": "Varesa",
                                            "text": "We took part in the Dragonspine International Cross Country Challenge together, and placed pretty well in the end!"
                                        },
                                        {
                                            "id": "756720438",
                                            "speaker": "Varesa",
                                            "text": "This time, she's here to take in the culture of Natlan in preparation for a comic job!",
                                            "choices": [
                                                {
                                                    "id": "756720439",
                                                    "text": "Have fun, you two.",
                                                    "response": [
                                                        {
                                                            "id": "756720441",
                                                            "speaker": "Minnie",
                                                            "text": "Alright... we won't keep you any longer."
                                                        },
                                                        {
                                                            "id": "756720442",
                                                            "speaker": "Varesa",
                                                            "text": "#Do come by the Collective of Plenty when you have the time, {NICKNAME}!"
                                                        },
                                                        {
                                                            "id": "756720443",
                                                            "speaker": "Varesa",
                                                            "text": "Vanana and I will have the sweetest fruits ready for you!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756720440",
                                                    "text": "Please excuse me. I have to go take care of something."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756720444",
                    "text": "(I don't really want to eat this though... Better bounce while I can.)"
                }
            ]
        }
    ]
}