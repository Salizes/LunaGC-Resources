{
    "talkId": "7350807",
    "total_dialogue_lines": 58,
    "speaker_counts": {
        "Blitzara": 2,
        "Bongo-Head": 2,
        "Paimon": 33,
        "Player": 17,
        "Pyro-1": 2,
        "Twirly-Whirly": 2
    },
    "dialogues": [
        {
            "id": "735080701",
            "speaker": "Paimon",
            "text": "Bongo-Head, Kindlejoy, Twirly-Whirly, Blitzara! You're all here!",
            "choices": [
                {
                    "id": "735080702",
                    "text": "The gang's all here, indeed.",
                    "response": [
                        {
                            "id": "735080703",
                            "speaker": "Paimon",
                            "text": "Make sure you listen to Haniyyah, alright? Eat on time, sleep well, train hard, and live happy lives!"
                        },
                        {
                            "id": "735080704",
                            "speaker": "Bongo-Head",
                            "text": "♪~"
                        },
                        {
                            "id": "735080705",
                            "speaker": "Pyro-1",
                            "text": "♫~"
                        },
                        {
                            "id": "735080706",
                            "speaker": "Twirly-Whirly",
                            "text": "♩~"
                        },
                        {
                            "id": "735080707",
                            "speaker": "Blitzara",
                            "text": "♬~"
                        },
                        {
                            "id": "735080708",
                            "speaker": "Paimon",
                            "text": "Hehehe, that's good, that's good. We'll have loads of presents for you all the next time we meet!",
                            "choices": [
                                {
                                    "id": "735080709",
                                    "text": "Behold Paimon, grandmaster of the fungal tongue!",
                                    "response": [
                                        {
                                            "id": "735080711",
                                            "speaker": "Paimon",
                                            "text": "Hehe, to be honest, Paimon doesn't know what they're saying either, but they sure do look happy, and they listen to Paimon!"
                                        },
                                        {
                                            "id": "735080712",
                                            "speaker": "Paimon",
                                            "text": "Hehe, Paimon already knows what we should bring them then..."
                                        },
                                        {
                                            "id": "735080713",
                                            "speaker": "Paimon",
                                            "text": "We'll get Bongo-Head a real round hat. It'll look nice and it'll also protect its soft head."
                                        },
                                        {
                                            "id": "735080714",
                                            "speaker": "Paimon",
                                            "text": "It can wear that hat, and when it doesn't, Paimon will take care of it."
                                        },
                                        {
                                            "id": "735080715",
                                            "speaker": "Paimon",
                                            "text": "That way, Bongo-Head will never go bongo-less, and it'll be cooler than ever!"
                                        },
                                        {
                                            "id": "735080716",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~",
                                            "choices": [
                                                {
                                                    "id": "735080717",
                                                    "text": "Bongo-Head's a Hydro Fungus...",
                                                    "response": [
                                                        {
                                                            "id": "735080719",
                                                            "speaker": "Paimon",
                                                            "text": "Uh, um... Guess we can just get it a waterproof hat! Y'know, maybe we'll get one that's made of Nilotpala Lotus or something like that. That way, the water droplets will just slide off it!"
                                                        },
                                                        {
                                                            "id": "735080720",
                                                            "speaker": "Paimon",
                                                            "text": "It'll be a bit more expensive, but eh, it's fine — you can just take it out of Paimon's allowance!"
                                                        },
                                                        {
                                                            "id": "735080721",
                                                            "speaker": "Paimon",
                                                            "text": "Twirly-Whirly's next up. We should get it a satchel for it to store Marvelous Jellies. That way, it can just grab some whenever it's hungry."
                                                        },
                                                        {
                                                            "id": "735080722",
                                                            "speaker": "Paimon",
                                                            "text": "Twirly-Whirly is all floaty-boaty, it can use Anemo, and it's really strong, too — carrying stuff for the other Fungi should be no problem!"
                                                        },
                                                        {
                                                            "id": "735080723",
                                                            "speaker": "Paimon",
                                                            "text": "It can drag its own luggage along, after all."
                                                        },
                                                        {
                                                            "id": "735080724",
                                                            "speaker": "Player",
                                                            "text": "Twirly-Whirly's pretty strong."
                                                        },
                                                        {
                                                            "id": "735080725",
                                                            "speaker": "Twirly-Whirly",
                                                            "text": "♩~"
                                                        },
                                                        {
                                                            "id": "735080726",
                                                            "speaker": "Paimon",
                                                            "text": "Hehe! Looks like Twirly-Whirly loves the idea!"
                                                        },
                                                        {
                                                            "id": "735080727",
                                                            "speaker": "Paimon",
                                                            "text": "Kindlejoy's up next. We need to pick a snug eyemask for it that won't fall off no matter how it swings around..."
                                                        },
                                                        {
                                                            "id": "735080728",
                                                            "speaker": "Paimon",
                                                            "text": "Right, we should also find an opportunity to have Haniyyah take its measurements.",
                                                            "choices": [
                                                                {
                                                                    "id": "735080729",
                                                                    "text": "And what for again?",
                                                                    "response": [
                                                                        {
                                                                            "id": "735080731",
                                                                            "speaker": "Paimon",
                                                                            "text": "C'mon, Kindlejoy's a Pyro Fungus. Just think about it. Pyro Fungi are like, super shiny!"
                                                                        },
                                                                        {
                                                                            "id": "735080732",
                                                                            "speaker": "Paimon",
                                                                            "text": "Don't you think that the light that Kindlejoy might wind up waking itself up with its own light from time to time? That sounds like it'd be really uncomfortable!",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "735080733",
                                                                                    "text": "Well, do you see Kindlejoy having eye bags?",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "735080735",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Maybe we should just ask the shroom in question!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080736",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Kindlejoy, do you normally sleep well?"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080737",
                                                                                            "speaker": "Pyro-1",
                                                                                            "text": "♫~"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080738",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "It seems to be saying... \"very well indeed\"... So it doesn't have this particular problem, huh."
                                                                                        },
                                                                                        {
                                                                                            "id": "735080739",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Let's give this a little more thought. Paimon's sure that we can come up with something that Kindlejoy will love!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080740",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Next, let's talk about Blitzara's gift. Paimon thinks it should be a drawing board that you can leave traces on using Electro."
                                                                                        },
                                                                                        {
                                                                                            "id": "735080741",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Blitzara's a very active and agile sort, so it should really enjoy drawing!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080742",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "And it can also get some exercise at the same time — two birds with one stone!"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080743",
                                                                                            "speaker": "Blitzara",
                                                                                            "text": "♬~",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "735080744",
                                                                                                    "text": "It would need to give you the option of scrubbing the board clean.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "735080746",
                                                                                                            "speaker": "Paimon",
                                                                                                            "text": "That's true! Let's give that function a bit of thought before placing an order with a craftsperson, shall we?"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "735080747",
                                                                                                            "speaker": "Paimon",
                                                                                                            "text": "We also need to think about who would be able to fulfill such a commission...",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "735080748",
                                                                                                                    "text": "Hmm, but you know, you've already revealed the contents of the gifts...",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "735080750",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Hehe, it's fine! Paimon said that we'd come up with \"loads\" of presents, so there'll be more to come!"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "735080751",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "We can take our time to consider and take our pick. We're not strictly by numbers, after all."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "735080752",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Our goal is to make sure that our shroom buddies will have loads of fun with the gifts!",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "735080753",
                                                                                                                                    "text": "A pile of gifts it shall be.",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "735080755",
                                                                                                                                            "speaker": "Paimon",
                                                                                                                                            "text": "Alright, guess we should set off too. Let's take as many commissions as we can, so that we can save the Mora we'll need to buy these presents."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "735080756",
                                                                                                                                            "speaker": "Paimon",
                                                                                                                                            "text": "Alright then, Bongo-Head, Kindlejoy, Twirly-Whirly, Blitzara. We'll see you all soon, so be patient, alright?"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "735080754",
                                                                                                                                    "text": "It'll be tons of fun indeed!"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "735080749",
                                                                                                                    "text": "Haven't you already ruined the surprise at this point, though?"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "735080745",
                                                                                                    "text": "We'd have to prevent the drawing board from turning into an utter mess."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "735080734",
                                                                                    "text": "Hmm... Y'know, when you put it like that, it does seem that Haniyyah might be the one who needs an eyemask."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "735080730",
                                                                    "text": "Wait, I don't get the point of this gift."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735080718",
                                                    "text": "Don't you mean it'll be wetter than ever?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735080710",
                                    "text": "Teach me your ways, great master!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735080757",
                    "text": "We'll come back and play with them later.",
                    "response": [
                        {
                            "id": "735080758",
                            "speaker": "Paimon",
                            "text": "Hmm, it seems like Haniyyah and Souka are getting ready to leave soon. Let's be quick and make sure we come back in time and get to see everyone!"
                        }
                    ]
                }
            ]
        }
    ]
}