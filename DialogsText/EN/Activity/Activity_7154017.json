{
    "talkId": "7154017",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Baizhu": 12,
        "Changsheng": 2,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "715401701",
            "speaker": "Baizhu",
            "text": "This medicine is all set... I'll have Herbalist Gui deliver it in a bit.",
            "choices": [
                {
                    "id": "715401702",
                    "text": "Baizhu, this gift envelope is for you.",
                    "response": [
                        {
                            "id": "715401703",
                            "speaker": "Baizhu",
                            "text": "That's very considerate, thank you. How have you been feeling the past few days?",
                            "choices": [
                                {
                                    "id": "715401704",
                                    "text": "All good, thanks to your miraculous skills.",
                                    "response": [
                                        {
                                            "id": "715401705",
                                            "speaker": "Baizhu",
                                            "text": "There was nothing miraculous about it — simple medical treatment, nothing more."
                                        },
                                        {
                                            "id": "715401708",
                                            "speaker": "Baizhu",
                                            "text": "Your constitution is strong. You were covered in fetor, but your cardiovascular system remained unaffected."
                                        },
                                        {
                                            "id": "715401709",
                                            "speaker": "Baizhu",
                                            "text": "The real miracle is the fact that you walked away from the array with no lasting damage... *cough* *cough*",
                                            "choices": [
                                                {
                                                    "id": "715401710",
                                                    "text": "Are you okay? Please have some water.",
                                                    "response": [
                                                        {
                                                            "id": "715401712",
                                                            "speaker": "Baizhu",
                                                            "text": "*cough*... *cough*... Don't worry, it's just exhaustion — I stayed up all night writing prescriptions."
                                                        },
                                                        {
                                                            "id": "715401713",
                                                            "speaker": "Changsheng",
                                                            "text": "*sigh* Which is exactly why you need a break. Relax, or your body will pay the price."
                                                        },
                                                        {
                                                            "id": "715401714",
                                                            "speaker": "Baizhu",
                                                            "text": "Hehe, there's no need to worry. I know what I'm doing."
                                                        },
                                                        {
                                                            "id": "715401715",
                                                            "speaker": "Baizhu",
                                                            "text": "Come find me if you begin to feel unwell. I can provide you with some restorative medicine."
                                                        },
                                                        {
                                                            "id": "715401716",
                                                            "speaker": "Baizhu",
                                                            "text": "Never forget — even minor symptoms can be important warning signs."
                                                        },
                                                        {
                                                            "id": "715401717",
                                                            "speaker": "Changsheng",
                                                            "text": "How about taking your own advice? Staying up all night — you need some restorative medicine of your own."
                                                        },
                                                        {
                                                            "id": "715401718",
                                                            "speaker": "Baizhu",
                                                            "text": "It's alright, Changsheng. I know what I'm doing."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715401711",
                                                    "text": "Did you use Changsheng's secret art again?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715401706",
                                    "text": "I'm feeling just fine!",
                                    "response": [
                                        {
                                            "id": "715401707",
                                            "speaker": "Baizhu",
                                            "text": "That's good to hear. Standard medical texts offer little information on the treatment of fetor. I had to rely on ordinary methods."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715401719",
                    "text": "See you.",
                    "response": [
                        {
                            "id": "715401720",
                            "speaker": "Baizhu",
                            "text": "Take care! Now that the crisis is over, you should get some rest and enjoy the festivities."
                        }
                    ]
                }
            ]
        }
    ]
}