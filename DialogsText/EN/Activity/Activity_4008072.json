{
    "talkId": "4008072",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "Venti": 15
    },
    "dialogues": [
        {
            "id": "400807201",
            "speaker": "Venti",
            "text": "I didn't expect you to come by here. Unless... oh, were you following the fragrance of wine on the wind?",
            "choices": [
                {
                    "id": "400807202",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400807205",
                            "speaker": "Venti",
                            "text": "Sure, the sound of your voice is always a pleasure to hear.",
                            "choices": [
                                {
                                    "id": "400807206",
                                    "text": "About the blessings...",
                                    "response": [
                                        {
                                            "id": "400807207",
                                            "speaker": "Venti",
                                            "text": "Blessings? Oh, that."
                                        },
                                        {
                                            "id": "400807208",
                                            "speaker": "Venti",
                                            "text": "Between you and me... I breathed a sigh of relief when nobody said their wishes out loud during the toast. That would've really put me in a tough spot. Hahaha... The Anemo Archon, Barbatos, doesn't have unlimited power, you know."
                                        },
                                        {
                                            "id": "400807209",
                                            "speaker": "Venti",
                                            "text": "I had to take a really deep breath to get the winds of the far-flung past blowing. I nearly went blue in the face."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807210",
                                    "text": "About Razor...",
                                    "response": [
                                        {
                                            "id": "400807211",
                                            "speaker": "Venti",
                                            "text": "He's grown up so much recently... It's such a joy to see."
                                        },
                                        {
                                            "id": "400807212",
                                            "speaker": "Venti",
                                            "text": "Huh... Suddenly I sound just like an old grandpa."
                                        },
                                        {
                                            "id": "400807213",
                                            "speaker": "Venti",
                                            "text": "He was lucky to have friends like you ready to support him through all this."
                                        },
                                        {
                                            "id": "400807214",
                                            "speaker": "Venti",
                                            "text": "I see a kind, gentle soul, with a healthy dose of romance and freedom, too... In other words, a true Mondstadter, who grew up drinking the water of Cider Lake."
                                        },
                                        {
                                            "id": "400807215",
                                            "speaker": "Venti",
                                            "text": "You, on the other hand... Don't worry, you're the gentlest soul I've ever met."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807216",
                                    "text": "About drinking...",
                                    "response": [
                                        {
                                            "id": "400807217",
                                            "speaker": "Venti",
                                            "text": "Oh, I've been very busy on that front. I'd long since drunk my fill by Windcoming Day."
                                        },
                                        {
                                            "id": "400807218",
                                            "speaker": "Venti",
                                            "text": "But, uh, I wasn't counting on everyone bringing out their finest vintage to welcome me."
                                        },
                                        {
                                            "id": "400807219",
                                            "speaker": "Venti",
                                            "text": "Ah, the fragrance alone was so intoxicating... I had no choice but to make room for a few more rounds..."
                                        },
                                        {
                                            "id": "400807220",
                                            "speaker": "Venti",
                                            "text": "Full disclosure — I also secretly hid two bottles away for myself at the end."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807203",
                    "text": "I'll leave you in peace.",
                    "response": [
                        {
                            "id": "400807204",
                            "speaker": "Venti",
                            "text": "Then go, my friend. The stories that unfolded here shall be remembered by the wind in the form of verse."
                        }
                    ]
                }
            ]
        }
    ]
}