    "dialogues": [
        {
            "id": "715400301",
            "speaker": "Lan Yan",
            "text": "Phew... Thank goodness everything worked out...",
            "choices": [
                {
                    "id": "715400302",
                    "text": "Lan Yan, this gift envelope is for you.",
                    "response": [
                        {
                            "id": "715400303",
                            "speaker": "Lan Yan",
                            "text": "#For me? Thank you, {NICKNAME}, it's beautiful!"
                        },
                        {
                            "id": "715400304",
                            "speaker": "Player",
                            "text": "Wishing you all the best in the new year."
                        },
                        {
                            "id": "715400305",
                            "speaker": "Lan Yan",
                            "text": "Likewise! I hope this year treats you well!"
                        },
                        {
                            "id": "715400306",
                            "speaker": "Lan Yan",
                            "text": "Although... I'm sure you're someone who can take that into your own hands."
                        },
                        {
                            "id": "715400307",
                            "speaker": "Lan Yan",
                            "text": "I have no doubt that you can turn any bad situation on its head.",
                            "choices": [
                                {
                                    "id": "715400308",
                                    "text": "I try my best.",
                                    "response": [
                                        {
                                            "id": "715400310",
                                            "speaker": "Lan Yan",
                                            "text": "As expected of the great hero of Liyue and the esteemed guest of the Tianquan — your words exude confidence."
                                        },
                                        {
                                            "id": "715400311",
                                            "speaker": "Lan Yan",
                                            "text": "Anyway, you and Hu Tao solved the problem with the border, and now my grandpa doesn't need to worry about getting yelled at because of his fortunes."
                                        },
                                        {
                                            "id": "715400312",
                                            "speaker": "Lan Yan",
                                            "text": "In that sense, I guess this year's Lantern Rite was a huge success!"
                                        },
                                        {
                                            "id": "715400313",
                                            "speaker": "Lan Yan",
                                            "text": "I wish you health, success, and happiness in the new year!"
                                        }
                                    ]
                                },
                                {
                                    "id": "715400309",
                                    "text": "If I set my mind to it, of course."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715400314",
                    "text": "See you.",
                    "response": [
                        {
                            "id": "715400315",
                            "speaker": "Lan Yan",
                            "text": "Bye! Happy Lantern Rite!"
                        }
                    ]
                }
            ]
        }
    ]
}