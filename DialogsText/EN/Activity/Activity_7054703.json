{
    "talkId": "7054703",
    "total_dialogue_lines": 78,
    "speaker_counts": {
        "Ematol": 26,
        "Phonia": 36,
        "Player": 16
    },
    "dialogues": [
        {
            "id": "705470301",
            "speaker": "Ematol",
            "text": "Feeling better, Phonia?"
        },
        {
            "id": "705470302",
            "speaker": "Phonia",
            "text": "My head doesn't hurt as much... I suppose eating sweets does help..."
        },
        {
            "id": "705470303",
            "speaker": "Phonia",
            "text": "Ematol... Thank you."
        },
        {
            "id": "705470304",
            "speaker": "Ematol",
            "text": "What are you thanking me for!? No need to be so formal!"
        },
        {
            "id": "705470305",
            "speaker": "Ematol",
            "text": "You need to get better and get back to work. Everyone's waiting for you!",
            "choices": [
                {
                    "id": "705470306",
                    "text": "Afternoon tea? Do you have space for one more?",
                    "response": [
                        {
                            "id": "705470307",
                            "speaker": "Ematol",
                            "text": "Honorary Knight!"
                        },
                        {
                            "id": "705470308",
                            "speaker": "Phonia",
                            "text": "#{M#Sir}{F#Lady} {NICKNAME}..."
                        },
                        {
                            "id": "705470309",
                            "speaker": "Player",
                            "text": "Why do you look upset?"
                        },
                        {
                            "id": "705470310",
                            "speaker": "Phonia",
                            "text": "...It's been a while, but seeing you still makes me feel guilty."
                        },
                        {
                            "id": "705470311",
                            "speaker": "Player",
                            "text": "Oh, you mean that incident from before..."
                        },
                        {
                            "id": "705470312",
                            "speaker": "Ematol",
                            "text": "Umm... Honorary Knight, are you sure you want to talk about that...?"
                        },
                        {
                            "id": "705470313",
                            "speaker": "Ematol",
                            "text": "Just thinking about the Durin incident still sends shivers down my spine... so...",
                            "choices": [
                                {
                                    "id": "705470314",
                                    "text": "I'm sure Phonia's ready to talk.",
                                    "response": [
                                        {
                                            "id": "705470315",
                                            "speaker": "Phonia",
                                            "text": "...That's right. I can't run from this."
                                        },
                                        {
                                            "id": "705470316",
                                            "speaker": "Phonia",
                                            "text": "#Please allow me to report the situation to you, {M#Sir}{F#Lady} Honorary Knight."
                                        },
                                        {
                                            "id": "705470317",
                                            "speaker": "Phonia",
                                            "text": "During the incident, the Acting Grand Master exposed the fact that Durin had influenced my mind, and ordered the knights to escort me back to headquarters immediately..."
                                        },
                                        {
                                            "id": "705470318",
                                            "speaker": "Phonia",
                                            "text": "In my confinement cell, I heard the sound of fireworks coming from outside, followed by a strange burst of... something."
                                        },
                                        {
                                            "id": "705470319",
                                            "speaker": "Phonia",
                                            "text": "It was like... Waking up from an eerie dream, and having your mind suddenly cleared."
                                        },
                                        {
                                            "id": "705470320",
                                            "speaker": "Phonia",
                                            "text": "Only then did I slowly realize the terrible things I'd done..."
                                        },
                                        {
                                            "id": "705470321",
                                            "speaker": "Phonia",
                                            "text": "Afterwards, Captain Albedo and Miss Sucrose made me some soothing potions, and I've since gradually recovered from all the negative aftereffects of Durin's influence."
                                        },
                                        {
                                            "id": "705470322",
                                            "speaker": "Phonia",
                                            "text": "Captain Albedo treated the other affected knights with the same method, and soon, we returned to normal."
                                        },
                                        {
                                            "id": "705470323",
                                            "speaker": "Phonia",
                                            "text": "After confirming that I was alright, the Acting Grand Master gave me an extended vacation. She probably hoped I'd recover during this time."
                                        },
                                        {
                                            "id": "705470324",
                                            "speaker": "Phonia",
                                            "text": "But even after my vacation ended, I've still been struggling with stress. So... I won't be able to return to my post for the time being."
                                        },
                                        {
                                            "id": "705470325",
                                            "speaker": "Ematol",
                                            "text": "Nobody blames you for this, Phonia. After all, who could've predicted that Durin would... you know...",
                                            "choices": [
                                                {
                                                    "id": "705470326",
                                                    "text": "You were a victim in all that.",
                                                    "response": [
                                                        {
                                                            "id": "705470328",
                                                            "speaker": "Ematol",
                                                            "text": "*sigh*... Back then, I didn't even realize something was wrong."
                                                        },
                                                        {
                                                            "id": "705470329",
                                                            "speaker": "Ematol",
                                                            "text": "I was thinking about how Phonia got transferred to the 7th Company and was part of a major operation... and whether we should hold a banquet to celebrate."
                                                        },
                                                        {
                                                            "id": "705470330",
                                                            "speaker": "Ematol",
                                                            "text": "I didn't expect things to turn out like this..."
                                                        },
                                                        {
                                                            "id": "705470331",
                                                            "speaker": "Phonia",
                                                            "text": "Looking back now, Durin's influence likely came into play during the seventh round of extreme-cold environment gear testing."
                                                        },
                                                        {
                                                            "id": "705470332",
                                                            "speaker": "Phonia",
                                                            "text": "During the test, I came too close to its still-dangerous remains, and when I returned, I felt sick and weak... I was on the verge of fainting while writing my report."
                                                        },
                                                        {
                                                            "id": "705470333",
                                                            "speaker": "Phonia",
                                                            "text": "Captain Albedo must have realized from reading my substandard report that I'd been affected."
                                                        },
                                                        {
                                                            "id": "705470334",
                                                            "speaker": "Phonia",
                                                            "text": "That's why he transferred me to the 7th Company to take part in the simulation once my condition had stabilized somewhat."
                                                        },
                                                        {
                                                            "id": "705470335",
                                                            "speaker": "Phonia",
                                                            "text": "Perhaps it was because I was in that important role that Durin marked me as a key informant then.",
                                                            "choices": [
                                                                {
                                                                    "id": "705470336",
                                                                    "text": "So wouldn't the results of the simulation have been...",
                                                                    "response": [
                                                                        {
                                                                            "id": "705470338",
                                                                            "speaker": "Phonia",
                                                                            "text": "Well, I did give it my all, so yes, I did come up with some new tactics."
                                                                        },
                                                                        {
                                                                            "id": "705470339",
                                                                            "speaker": "Phonia",
                                                                            "text": "But please don't worry, my tactical knowledge hasn't compromised Mondstadt's defenses in any way."
                                                                        },
                                                                        {
                                                                            "id": "705470340",
                                                                            "speaker": "Phonia",
                                                                            "text": "After looking back on things more carefully, I realized that Captain Albedo and the Acting Grand Master, through their own clever methods, had been controlling the information that Durin was able to glean from me..."
                                                                        },
                                                                        {
                                                                            "id": "705470341",
                                                                            "speaker": "Phonia",
                                                                            "text": "They were thus able to control Durin's plan of attack in reverse, to a certain extent."
                                                                        },
                                                                        {
                                                                            "id": "705470342",
                                                                            "speaker": "Ematol",
                                                                            "text": "Controlling Durin in reverse... Sounds like they were working real magic..."
                                                                        },
                                                                        {
                                                                            "id": "705470343",
                                                                            "speaker": "Phonia",
                                                                            "text": "Every combat strategy report I submitted was reviewed jointly by the Acting Grand Master and trusted Captains to determine whether they would be adopted."
                                                                        },
                                                                        {
                                                                            "id": "705470344",
                                                                            "speaker": "Phonia",
                                                                            "text": "Unaware that his informant had been compromised, Durin believed the adopted strategy would shape the Knights' latest defensive tactics."
                                                                        },
                                                                        {
                                                                            "id": "705470345",
                                                                            "speaker": "Phonia",
                                                                            "text": "But in reality, this strategy was nothing more than bait."
                                                                        },
                                                                        {
                                                                            "id": "705470346",
                                                                            "speaker": "Ematol",
                                                                            "text": "Ooh, so that's how it was!"
                                                                        },
                                                                        {
                                                                            "id": "705470347",
                                                                            "speaker": "Ematol",
                                                                            "text": "No wonder so many of our colleagues mentioned training in \"new tactics\" — only for us to use a completely different plan during our defensive battle...",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "705470348",
                                                                                    "text": "So you took advantage of the information being leaked...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "705470350",
                                                                                            "speaker": "Phonia",
                                                                                            "text": "That's right. During the battle, the main attacking force of monsters behaved just as the Knights foresaw — they moved to counter the strategy they thought we would use."
                                                                                        },
                                                                                        {
                                                                                            "id": "705470351",
                                                                                            "speaker": "Phonia",
                                                                                            "text": "But in the end, that allowed the Knights to take the initiative, minimizing the damage to our city and citizens."
                                                                                        },
                                                                                        {
                                                                                            "id": "705470352",
                                                                                            "speaker": "Phonia",
                                                                                            "text": "Still, I can't afford to be complacent. Even intentionally leaked intel might trigger unexpected reactions from the monsters around Mondstadt."
                                                                                        },
                                                                                        {
                                                                                            "id": "705470353",
                                                                                            "speaker": "Phonia",
                                                                                            "text": "Since recovering, I've run 830 simulations based on Durin's intel and had Ematol deliver the analyses to Captain Albedo..."
                                                                                        },
                                                                                        {
                                                                                            "id": "705470354",
                                                                                            "speaker": "Ematol",
                                                                                            "text": "But he assured me that the dust had settled, and there was nothing we needed to worry about."
                                                                                        },
                                                                                        {
                                                                                            "id": "705470355",
                                                                                            "speaker": "Ematol",
                                                                                            "text": "So, Phonia! Your top priority right now is to rest up, get better, and come back to us as soon as possible!",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "705470356",
                                                                                                    "text": "That's right. There's nothing to worry about now.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "705470358",
                                                                                                            "speaker": "Phonia",
                                                                                                            "text": "I see..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705470359",
                                                                                                            "speaker": "Phonia",
                                                                                                            "text": "Then I'll write a detailed report based on my own experience to serve as a warning to those who come after us."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705470360",
                                                                                                            "speaker": "Phonia",
                                                                                                            "text": "I hope the other knights will take what happened to me to heart and take care out in the wild... Last thing we want is more of us falling under the control of strange forces..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705470361",
                                                                                                            "speaker": "Phonia",
                                                                                                            "text": "Maybe we can develop this into some sort of specialized discipline? Like... \"Psychic Disruption and Prevention\"?"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "705470357",
                                                                                                    "text": "Albedo took care of everything."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "705470349",
                                                                                    "text": "...To lure the enemy into doing something predictable."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "705470337",
                                                                    "text": "So Durin adopted the all-new strategies from that simulation..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705470327",
                                                    "text": "Being extra vigilant next time couldn't hurt."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705470362",
                                    "text": "Let's talk about something more relaxing, then.",
                                    "response": [
                                        {
                                            "id": "705470363",
                                            "speaker": "Ematol",
                                            "text": "Mhm! When you eat desserts, the conversation should be just as sweet!"
                                        },
                                        {
                                            "id": "705470364",
                                            "speaker": "Ematol",
                                            "text": "Phonia and I made a new friend recently. She's a very passionate adventurer!"
                                        },
                                        {
                                            "id": "705470365",
                                            "speaker": "Ematol",
                                            "text": "She plans to reopen her shelter for stray animals. Maybe you'll be able to visit her soon."
                                        },
                                        {
                                            "id": "705470366",
                                            "speaker": "Ematol",
                                            "text": "If you don't mind, shall we visit her together, Honorary Knight?"
                                        },
                                        {
                                            "id": "705470367",
                                            "speaker": "Ematol",
                                            "text": "I'm curious to see what kind of cats you'd be fond of!"
                                        },
                                        {
                                            "id": "705470368",
                                            "speaker": "Ematol",
                                            "text": "Also — big news! I've revamped Dodoco's Boom-Bastic Escapades into a cooperative adventure game: Dodoco's Blow-Up-Erative Bomb-Nanza!"
                                        },
                                        {
                                            "id": "705470369",
                                            "speaker": "Ematol",
                                            "text": "When I played it with my new friend, we had loads of fun! I want to promote the game, so I've asked her to help with that."
                                        },
                                        {
                                            "id": "705470370",
                                            "speaker": "Ematol",
                                            "text": "The game table is in the garden near the Knights of Favonius headquarters. Feel free to check it out whenever you're free!",
                                            "choices": [
                                                {
                                                    "id": "705470371",
                                                    "text": "Sounds great!",
                                                    "response": [
                                                        {
                                                            "id": "705470373",
                                                            "speaker": "Ematol",
                                                            "text": "Phonia, once you're feeling better, let's invite your partner from the 7th Company. We can try out the game together!"
                                                        },
                                                        {
                                                            "id": "705470374",
                                                            "speaker": "Ematol",
                                                            "text": "I remember Captain Albedo saying that once the basic framework of their reconnaissance system is in place, your duties will be fully transferred to her — and you'll be transferred back here..."
                                                        },
                                                        {
                                                            "id": "705470375",
                                                            "speaker": "Ematol",
                                                            "text": "It's going to be hard work for her, so let's make up for it in advance by having fun!"
                                                        },
                                                        {
                                                            "id": "705470376",
                                                            "speaker": "Phonia",
                                                            "text": "Alright. I think she has a few months until her transfer to Dornman Port, so she'll probably have some free time."
                                                        },
                                                        {
                                                            "id": "705470377",
                                                            "speaker": "Phonia",
                                                            "text": "And it's probably time for me to do something to lift my mood, anyways."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705470372",
                                                    "text": "I'll definitely give it a try!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705470378",
                    "text": "(Best not to bother them further...)"
                }
            ]
        }
    ]
}