    "dialogues": [
        {
            "id": "711550301",
            "speaker": "Yumemizuki Mizuki",
            "text": "#{NICKNAME}? What a pleasant surprise. Happy Lantern Rite.",
            "choices": [
                {
                    "id": "711550302",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711550304",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "I saw it, and what a beautiful lantern it was. I gave it a little boost just now, so it should soar to even greater heights."
                        },
                        {
                            "id": "711550314",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "Hehe... As they say in Liyue, wishes written on lanterns are sure to come true."
                        },
                        {
                            "id": "711550303",
                            "speaker": "Player",
                            "text": "About the souvenir photo..."
                        },
                        {
                            "id": "711550315",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "Ah... I did ask Miss Pingxi to help arrange a commemorative photoshoot. You must be the photographer she had in mind, then."
                        },
                        {
                            "id": "711550316",
                            "speaker": "Yumemizuki Mizuki",
                            "text": "Wonderful! Looks like I'll be bringing back some lovely photos from this year's Lantern Rite.",
                            "choices": [
                                {
                                    "id": "711550305",
                                    "text": "Let's start the photoshoot, then.",
                                    "response": [
                                        {
                                            "id": "711550306",
                                            "speaker": "Yumemizuki Mizuki",
                                            "text": "Alright then, Master Photographer, what kind of pose do you think would be the most photogenic?",
                                            "choices": [
                                                {
                                                    "id": "711550309",
                                                    "text": "A more relaxed pose.",
                                                    "response": [
                                                        {
                                                            "id": "711550311",
                                                            "speaker": "Player",
                                                            "text": "Let's try the second pose...",
                                                            "choices": [
                                                                {
                                                                    "id": "711550313",
                                                                    "text": "Let's try the first pose..."
                                                                },
                                                                {
                                                                    "id": "711550312",
                                                                    "text": "This pose works."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711550310",
                                                    "text": "A more serious pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711550307",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
                                            "id": "711550308",
                                            "speaker": "Yumemizuki Mizuki",
                                            "text": "Do you have something to attend to? No problem at all, we can discuss the details once you're free."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711550303",
                    "text": "About the souvenir photo..."
                }
            ]
        }
    ]
