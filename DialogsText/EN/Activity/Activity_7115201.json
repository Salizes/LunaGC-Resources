    "dialogues": [
        {
            "id": "711520101",
            "speaker": "Kujou Sara",
            "text": "Hm... To encounter you here, amidst Liyue's celebrations, is... unsurprising. Happy Lantern Rite.",
            "choices": [
                {
                    "id": "711520102",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711520104",
                            "speaker": "Kujou Sara",
                            "text": "Yes, I saw it. I intend to purchase some Xiao Lanterns to take back to Inazuma after this. They will look quite nice hanging at the entrance of the Tenryou Commission."
                        },
                        {
                            "id": "711520114",
                            "speaker": "Kujou Sara",
                            "text": "With Doushin Shikanoin around, I doubt any thieves would dare lay hands on them."
                        },
                        {
                            "id": "711520103",
                            "speaker": "Player",
                            "text": "About the souvenir photo..."
                        },
                        {
                            "id": "711520115",
                            "speaker": "Kujou Sara",
                            "text": "Indeed, I submitted the request to Miss Pingxi. Evidently, you are the professional photographer she mentioned."
                        },
                        {
                            "id": "711520116",
                            "speaker": "Kujou Sara",
                            "text": "Very well. I trust you will take excellent photographs. Let us begin.",
                            "choices": [
                                {
                                    "id": "711520117",
                                    "text": "All set!",
                                    "response": [
                                        {
                                            "id": "711520120",
                                            "speaker": "Kujou Sara",
                                            "text": "In that case, please advise me on an appropriate pose while we prepare.",
                                            "choices": [
                                                {
                                                    "id": "711520121",
                                                    "text": "Something more serious.",
                                                    "response": [
                                                        {
                                                            "id": "711520123",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711520122",
                                                    "text": "A more relaxed pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711520118",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
                                            "id": "711520119",
                                            "speaker": "Kujou Sara",
                                            "text": "You have something urgent to attend to? No matter, I shall wait here. Come find me once you're done."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711520103",
                    "text": "About the souvenir photo..."
                }
            ]
        }
    ]
}