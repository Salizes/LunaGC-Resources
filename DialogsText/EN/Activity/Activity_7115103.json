    "dialogues": [
        {
            "id": "711510301",
            "speaker": "Wriothesley",
            "text": "Whoa, quick work. Shall we, then?",
            "choices": [
                {
                    "id": "711510302",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711510303",
                            "speaker": "Wriothesley",
                            "text": "Not bad at all, flew high and burned bright. Makes me wanna buy a few to bring back to the Fortress."
                        },
                        {
                            "id": "711510304",
                            "speaker": "Wriothesley",
                            "text": "Then again... Xiao Lanterns released in the Fortress of Meropide wouldn't fly to the sky or grant wishes. They'd just mean more work for the janitorial crew.",
                            "choices": [
                                {
                                    "id": "711510305",
                                    "text": "No problem, ready when you are.",
                                    "response": [
                                        {
                                            "id": "711510306",
                                            "speaker": "Wriothesley",
                                            "text": "#Sure. Do I need to strike a pose, or...? Suggestions are welcome, {NICKNAME}.",
                                            "choices": [
                                                {
                                                    "id": "711510309",
                                                    "text": "Something more serious.",
                                                    "response": [
                                                        {
                                                            "id": "711510311",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711510310",
                                                    "text": "A more relaxed pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711510307",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
                                            "id": "711510308",
                                            "speaker": "Wriothesley",
                                            "text": "Got something to take care of? Take your time, I'm in no rush."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711510305",
                    "text": "No problem, ready when you are."
                },
