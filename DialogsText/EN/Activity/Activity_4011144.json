    "dialogues": [
        {
            "id": "401114401",
            "speaker": "Tighnari",
            "text": "#{NICKNAME}, what a coincidence! Cyno already told me everything that happened.",
            "choices": [
                {
                    "id": "401114402",
                    "text": "About Cyno's unfunny jokes...",
                    "response": [
                        {
                            "id": "401114403",
                            "speaker": "Tighnari",
                            "text": "I'll stop you right there! Cyno has already told me countless jokes with that smug look on his face. I don't want to hear any more."
                        },
                        {
                            "id": "401114404",
                            "speaker": "Tighnari",
                            "text": "That's all I have to say on that topic.",
                            "choices": [
                                {
                                    "id": "401114405",
                                    "text": "About Genius Invokation TCG...",
                                    "response": [
                                        {
                                            "id": "401114406",
                                            "speaker": "Tighnari",
                                            "text": "Things have been quiet in the Avidya Forest lately, so I've been playing with Collei every now and then."
                                        },
                                        {
                                            "id": "401114407",
                                            "speaker": "Tighnari",
                                            "text": "Collei never ceases to amaze me. She even managed to place well in that tournament."
                                        },
                                        {
                                            "id": "401114408",
                                            "speaker": "Tighnari",
                                            "text": "Even though I was able to make it out of the qualifiers, luck wasn't on my side and I faced Cyno only a few matches in."
                                        },
                                        {
                                            "id": "401114409",
                                            "speaker": "Tighnari",
                                            "text": "That guy shows no mercy when it comes to Genius Invokation. He even let out a loud yell when he played the winning card... It really hurt my ears."
                                        },
                                        {
                                            "id": "401114410",
                                            "speaker": "Tighnari",
                                            "text": "It's been a while since I've seen him get so stirred up like that.",
                                            "choices": [
                                                {
                                                    "id": "401114402",
                                                    "text": "About Cyno's unfunny jokes..."
                                                },
                                                {
                                                    "id": "401114411",
                                                    "text": "I'll be on my way, then.",
                                                    "response": [
                                                        {
                                                            "id": "401114412",
                                                            "speaker": "Tighnari",
                                                            "text": "No need to be so polite. You should visit again when you have the time."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401114411",
                                    "text": "I'll be on my way, then."
                                }
                            ]
                        }
                    ]
                },
