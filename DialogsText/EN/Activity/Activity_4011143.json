    "dialogues": [
        {
            "id": "401114301",
            "speaker": "Sangonomiya Kokomi",
            "text": "Hmm? Oh, did you make the trip all the way back here just to see me?",
            "choices": [
                {
                    "id": "401114302",
                    "text": "About the thieves...",
                    "response": [
                        {
                            "id": "401114303",
                            "speaker": "Sangonomiya Kokomi",
                            "text": "Ah, so that's what you uncovered in the end. Hmm, I'm not quite sure how I feel about that."
                        },
                        {
                            "id": "401114304",
                            "speaker": "Sangonomiya Kokomi",
                            "text": "But thank you for letting me know."
                        },
                        {
                            "id": "401114305",
                            "speaker": "Sangonomiya Kokomi",
                            "text": "Hearing how things ended almost feels like reading the end of a light novel. Now we can all rest at ease.",
                            "choices": [
                                {
                                    "id": "401114306",
                                    "text": "About the tournament...",
                                    "response": [
                                        {
                                            "id": "401114307",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "\"Winning or losing isn't what's most important. It's about playing with elegance.\" That's how I've always looked at it, anyway."
                                        },
                                        {
                                            "id": "401114308",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "After seeing you all cheering for me though, I suppose I really tried to bring my best to the game."
                                        },
                                        {
                                            "id": "401114309",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "Hehe... Now that I think about it, it was great that I was able to speak with you before the competition."
                                        },
                                        {
                                            "id": "401114310",
                                            "speaker": "Player",
                                            "text": "Energy +5?"
                                        },
                                        {
                                            "id": "401114311",
                                            "speaker": "Sangonomiya Kokomi",
                                            "text": "Ah! No, please don't ever mention that to anyone!",
                                            "choices": [
                                                {
                                                    "id": "401114302",
                                                    "text": "About the thieves..."
                                                },
                                                {
                                                    "id": "401114312",
                                                    "text": "I'll be on my way, then.",
                                                    "response": [
                                                        {
                                                            "id": "401114313",
                                                            "speaker": "Sangonomiya Kokomi",
                                                            "text": "Since you came all the way to Watatsumi Island, you might as well rest for a moment before you return."
                                                        },
                                                        {
                                                            "id": "401114314",
                                                            "speaker": "Sangonomiya Kokomi",
                                                            "text": "I hope this view will stay in your heart forever."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401114312",
                                    "text": "I'll be on my way, then."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401114306",
                    "text": "About the tournament..."
                },
                {
                    "id": "401114312",
                    "text": "I'll be on my way, then."
                }
            ]
        }
    ]
}