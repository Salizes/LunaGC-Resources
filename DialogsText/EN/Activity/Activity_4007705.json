    },
    "dialogues": [
        {
            "id": "400770501",
            "speaker": "Xinyan",
            "text": "I've got some new inspiration for a song...",
            "choices": [
                {
                    "id": "400770502",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400770503",
                            "speaker": "Xinyan",
                            "text": "Sure, I'd love to.",
                            "choices": [
                                {
                                    "id": "400770506",
                                    "text": "About friends...",
                                    "response": [
                                        {
                                            "id": "400770507",
                                            "speaker": "Xinyan",
                                            "text": "I am going to share this adventure with my friends when I get back. Who knows, it may even give Yun Jin some new ideas for her opera."
                                        },
                                        {
                                            "id": "400770508",
                                            "speaker": "Xinyan",
                                            "text": "As for Xiangling, I'm sure she'll come up with a bunch of suggestions the minute that anything cooking-related comes up."
                                        },
                                        {
                                            "id": "400770509",
                                            "speaker": "Xinyan",
                                            "text": "You know her, a true professional, she knows everything... Like how to make a good stew without a pot. That's something I'd like to learn from her..."
                                        },
                                        {
                                            "id": "400770510",
                                            "speaker": "Xinyan",
                                            "text": "I need to learn some new dishes before my new friends come to visit. Oh, and Roasted Lavender Melons is definitely gonna be one of them!"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770511",
                                    "text": "About music...",
                                    "response": [
                                        {
                                            "id": "400770512",
                                            "speaker": "Xinyan",
                                            "text": "Are you a little disappointed that I didn't play any rock music back in my mirage?"
                                        },
                                        {
                                            "id": "400770513",
                                            "speaker": "Player",
                                            "text": "Not at all."
                                        },
                                        {
                                            "id": "400770514",
                                            "speaker": "Xinyan",
                                            "text": "Whew, glad to hear it."
                                        },
                                        {
                                            "id": "400770515",
                                            "speaker": "Xinyan",
                                            "text": "Rock 'n' roll is my first love, that'll never change."
                                        },
                                        {
                                            "id": "400770516",
                                            "speaker": "Xinyan",
                                            "text": "But music is also a vehicle for all kinds of emotions. Rather than only expressing my own feelings, I figured what I did was more suitable for the occasion."
                                        },
                                        {
                                            "id": "400770517",
                                            "speaker": "Xinyan",
                                            "text": "Hehe, perhaps now, I can call you a kindred spirit in our understanding of music."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770518",
                                    "text": "About this vacation...",
                                    "response": [
                                        {
                                            "id": "400770519",
                                            "speaker": "Xinyan",
                                            "text": "It's been action-packed and awesome fun!"
                                        },
                                        {
                                            "id": "400770520",
                                            "speaker": "Xinyan",
                                            "text": "I really have to thank you and that bard fella for the invitation."
                                        },
                                        {
                                            "id": "400770521",
                                            "speaker": "Xinyan",
                                            "text": "I wonder how his live performances have been going... I owe him big time. I'll have to find a way to thank that guy in the future."
                                        },
                                        {
                                            "id": "400770522",
                                            "speaker": "Player",
                                            "text": "Let's buy him a drink."
                                        },
                                        {
                                            "id": "400770523",
                                            "speaker": "Xinyan",
                                            "text": "Sure! It's a deal!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770504",
                    "text": "I won't disturb you.",
                    "response": [
                        {
                            "id": "400770505",
                            "speaker": "Xinyan",
                            "text": "Okay, make sure to take it easy.",
                            "choices": [
                                {
                                    "id": "400770506",
                                    "text": "About friends..."
                                },
                                {
                                    "id": "400770511",
                                    "text": "About music..."
                                },
                                {
                                    "id": "400770518",
                                    "text": "About this vacation..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}