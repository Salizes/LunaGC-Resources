    "dialogues": [
        {
            "id": "711530302",
            "speaker": "Sigewinne",
            "text": "All taken care of? Then let's take that picture now!",
            "choices": [
                {
                    "id": "711530301",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711530309",
                            "speaker": "Sigewinne",
                            "text": "It's so lovely! I once treated a patient back in the Fortress who talked about wanting to release a Xiao Lantern himself."
                        },
                        {
                            "id": "711530310",
                            "speaker": "Sigewinne",
                            "text": "Since I'm here... I think I'll release one on his behalf and let his wish soar.",
                            "choices": [
                                {
                                    "id": "711530303",
                                    "text": "No problem, ready when you are.",
                                    "response": [
                                        {
                                            "id": "711530304",
                                            "speaker": "Sigewinne",
                                            "text": "Sure! Well then, as the \"professional photographer,\" what pose would you recommend?",
                                            "choices": [
                                                {
                                                    "id": "711530307",
                                                    "text": "Something more serious.",
                                                    "response": [
                                                        {
                                                            "id": "711530311",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711530308",
                                                    "text": "A more relaxed pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711530305",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
                                            "id": "711530306",
                                            "speaker": "Sigewinne",
                                            "text": "Oh, something came up? That's fine, I'll take a stroll nearby. Come find me once you're ready!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711530303",
                    "text": "No problem, ready when you are."
