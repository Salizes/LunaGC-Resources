    "dialogues": [
        {
            "id": "711500201",
            "speaker": "Varesa",
            "text": "Liyue's got so much delicious food! What should I eat next... Oh, how about boiled fish?"
        },
        {
            "id": "711500202",
            "speaker": "Varesa",
            "text": "No, wait... I need to take a picture for everyone back at the tribe first...",
            "choices": [
                {
                    "id": "711500203",
                    "text": "About the Xiao Lantern I released...",
                    "response": [
                        {
                            "id": "711500204",
                            "speaker": "Varesa",
                            "text": "#Wow... it's way up there! Hey, {NICKNAME}, is there a limit to how many Xiao Lanterns we can release? I wanna launch one for everyone in the tribe!"
                        },
                        {
                            "id": "711500205",
                            "speaker": "Varesa",
                            "text": "I wrote down all their wishes in my notebook, and there's a ton of 'em, hehe... So we're gonna need a mountain of lanterns."
                        },
                        {
                            "id": "711500206",
                            "speaker": "Player",
                            "text": "Varesa? Want a souvenir picture?"
                        },
                        {
                            "id": "711500207",
                            "speaker": "Varesa",
                            "text": "#{NICKNAME}? Oh wow, so you're the pro photographer that that lady was talking about?"
                        },
                        {
                            "id": "711500208",
                            "speaker": "Player",
                            "text": "That's me."
                        },
                        {
                            "id": "711500209",
                            "speaker": "Varesa",
                            "text": "Hehe, that's fantastic! You're so talented, of course you're good with a Kamera too!",
                            "choices": [
                                {
                                    "id": "711500210",
                                    "text": "Shall we begin, then?",
                                    "response": [
                                        {
                                            "id": "711500211",
                                            "speaker": "Varesa",
                                            "text": "Sure! I wanna strike a cool pose... but, what if it looks weird in the picture..."
                                        },
                                        {
                                            "id": "711500212",
                                            "speaker": "Varesa",
                                            "text": "Any advice?",
                                            "choices": [
                                                {
                                                    "id": "711500213",
                                                    "text": "Up the awesomeness!",
                                                    "response": [
                                                        {
                                                            "id": "711500215",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711500214",
                                                    "text": "A more relaxed pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711500216",
                                    "text": "Wait a moment...",
                                    "response": [
                                        {
                                            "id": "711500217",
                                            "speaker": "Varesa",
                                            "text": "Got something on your plate? All good, I'll grab a bite to eat first... hehe..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711500206",
                    "text": "Varesa? Want a souvenir picture?"
                }
            ]
        }
    ]
}