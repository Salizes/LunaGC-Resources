{
    "talkId": "4008071",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Lisa": 17,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "400807101",
            "speaker": "Lisa",
            "text": "Ah, I'm much more suited to leisurely days like these...",
            "choices": [
                {
                    "id": "400807102",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400807105",
                            "speaker": "Lisa",
                            "text": "I'd love to, cutie. Hmm, too bad I can't offer you some tea.",
                            "choices": [
                                {
                                    "id": "400807106",
                                    "text": "About Varka...",
                                    "response": [
                                        {
                                            "id": "400807107",
                                            "speaker": "Lisa",
                                            "text": "I was quite surprised to learn that the Grand Master had written a private message just for me."
                                        },
                                        {
                                            "id": "400807108",
                                            "speaker": "Lisa",
                                            "text": "And I was equally surprised to find out that Razor's been on his mind this whole time."
                                        },
                                        {
                                            "id": "400807109",
                                            "speaker": "Lisa",
                                            "text": "Especially given how demanding he is of Jean... He left her to figure out the whole Weinlesefest on her own, and didn't give her a single word of acknowledgment."
                                        },
                                        {
                                            "id": "400807110",
                                            "speaker": "Lisa",
                                            "text": "I'll have to have to a stern word with him on Jean's behalf when he returns."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807111",
                                    "text": "About Razor...",
                                    "response": [
                                        {
                                            "id": "400807112",
                                            "speaker": "Lisa",
                                            "text": "It's funny — I always thought the Grand Master was the one who gave him the name \"Razor\"..."
                                        },
                                        {
                                            "id": "400807113",
                                            "speaker": "Lisa",
                                            "text": "But it turns out his birth parents chose it all along."
                                        },
                                        {
                                            "id": "400807114",
                                            "speaker": "Lisa",
                                            "text": "..."
                                        },
                                        {
                                            "id": "400807115",
                                            "speaker": "Lisa",
                                            "text": "Anyway, Razor told me he heard the voices of his parents during the festival."
                                        },
                                        {
                                            "id": "400807116",
                                            "speaker": "Lisa",
                                            "text": "\"Like stepping on a rock in the sun. Warm, but also heavy.\""
                                        },
                                        {
                                            "id": "400807117",
                                            "speaker": "Lisa",
                                            "text": "I'm sure he must think of them as both kind and dauntless people..."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807118",
                                    "text": "About the Weinlesefest...",
                                    "response": [
                                        {
                                            "id": "400807119",
                                            "speaker": "Lisa",
                                            "text": "Originally, I only planned on having a glass or two. I thought I deserved a treat after being such a good teacher recently."
                                        },
                                        {
                                            "id": "400807120",
                                            "speaker": "Lisa",
                                            "text": "But that was before I came to appreciate how truly exceptional the festival-exclusive vintage was..."
                                        },
                                        {
                                            "id": "400807121",
                                            "speaker": "Lisa",
                                            "text": "Before I knew it, I was already rather tipsy, hehe..."
                                        },
                                        {
                                            "id": "400807122",
                                            "speaker": "Lisa",
                                            "text": "I'm a bad example. Don't be like me, cutie."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807103",
                    "text": "I'll leave you in peace.",
                    "response": [
                        {
                            "id": "400807104",
                            "speaker": "Lisa",
                            "text": "Alright, but remember, it's important to rest when you're feeling tired. It makes my heart ache to see you so busy all the time."
                        }
                    ]
                }
            ]
        }
    ]
}