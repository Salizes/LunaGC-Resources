{
    "talkId": "7154036",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Charlotte": 13,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "715403601",
            "speaker": "Charlotte",
            "text": "Weird... Why can't I find any clues?",
            "choices": [
                {
                    "id": "715403602",
                    "text": "Charlotte, this gift envelope is—",
                    "response": [
                        {
                            "id": "715403603",
                            "speaker": "Charlotte",
                            "text": "Huh? OH! Great Hero of Liyue! Perfect timing!"
                        },
                        {
                            "id": "715403604",
                            "speaker": "Charlotte",
                            "text": "C'mon, I have so much to ask you! Don't worry — completely off the record...",
                            "choices": [
                                {
                                    "id": "715403605",
                                    "text": "I—I'm just here to give you a gift envelope!",
                                    "response": [
                                        {
                                            "id": "715403607",
                                            "speaker": "Charlotte",
                                            "text": "Ah, thank you for this — it's beautiful. Now, onto the real business at hand."
                                        },
                                        {
                                            "id": "715403608",
                                            "speaker": "Charlotte",
                                            "text": "You know about the ritual Lady Tianquan conducted, right?"
                                        },
                                        {
                                            "id": "715403609",
                                            "speaker": "Charlotte",
                                            "text": "I've asked around, and everyone says it's one of this land's traditional ceremonies. But, I also heard it hasn't been performed in a long time."
                                        },
                                        {
                                            "id": "715403610",
                                            "speaker": "Charlotte",
                                            "text": "Not to mention, as the ritual was starting, I saw a flock of birds scatter in the mountains near the harbor, and a strange light coming from the forest...",
                                            "choices": [
                                                {
                                                    "id": "715403611",
                                                    "text": "How did you see that?",
                                                    "response": [
                                                        {
                                                            "id": "715403613",
                                                            "speaker": "Charlotte",
                                                            "text": "Ah, it's all thanks to my Kamera. I bought an ultra-telephoto lens not too long ago — definitely came in handy just now!"
                                                        },
                                                        {
                                                            "id": "715403614",
                                                            "speaker": "Charlotte",
                                                            "text": "Unfortunately, it was super dark, so the photos are too blurry to make out anything..."
                                                        },
                                                        {
                                                            "id": "715403615",
                                                            "speaker": "Charlotte",
                                                            "text": "#That's why I was hoping you could fill me in, {NICKNAME}. Is there anything you can tell me? Doesn't have to be right now — you can write me a letter if you remember something..."
                                                        },
                                                        {
                                                            "id": "715403616",
                                                            "speaker": "Charlotte",
                                                            "text": "Here, take this. Think of it as... an advance."
                                                        },
                                                        {
                                                            "id": "715403617",
                                                            "speaker": "Charlotte",
                                                            "text": "I'll treat you to a meal back in Fontaine, too! How does that sound?"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715403612",
                                                    "text": "Did you walk over there?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715403606",
                                    "text": "D—Don't smile at me like that!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715403618",
                    "text": "Yeah. I'll, ah, see you around, I guess?",
                    "response": [
                        {
                            "id": "715403619",
                            "speaker": "Charlotte",
                            "text": "Bye! I'm going to ask around some more..."
                        }
                    ]
                }
            ]
        }
    ]
}