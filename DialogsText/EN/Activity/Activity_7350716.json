{
    "talkId": "7350716",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Blitzara": 6,
        "Paimon": 31,
        "Player": 9,
        "Twirly-Whirly": 7
    },
    "dialogues": [
        {
            "id": "735071601",
            "speaker": "Paimon",
            "text": "Hey there, Twirly-Whirly! Hey there, Blitzara! Still remember us?"
        },
        {
            "id": "735071602",
            "speaker": "Paimon",
            "text": "Hahaha, no hesitation at all! They look so happy!"
        },
        {
            "id": "735071603",
            "speaker": "Paimon",
            "text": "Hmm, what should we do while we're hanging out?",
            "choices": [
                {
                    "id": "735071604",
                    "text": "Let's feed them, shall we?",
                    "response": [
                        {
                            "id": "735071605",
                            "speaker": "Paimon",
                            "text": "Alright, let's see what flavors they like!",
                            "choices": [
                                {
                                    "id": "735071606",
                                    "text": "Use the Berry-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "735071607",
                                            "speaker": "Twirly-Whirly",
                                            "text": "♩~"
                                        },
                                        {
                                            "id": "735071608",
                                            "speaker": "Blitzara",
                                            "text": "♬~"
                                        },
                                        {
                                            "id": "735071609",
                                            "speaker": "Paimon",
                                            "text": "Hehe, looks like they both love the flavor of Berries!"
                                        },
                                        {
                                            "id": "735071610",
                                            "speaker": "Paimon",
                                            "text": "Berries are pretty easy to find — we snag loads just by walking around. Guess we can leave some for our shroom friends, eh?"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071611",
                                    "text": "Use the Lavender Melon-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "735071612",
                                            "speaker": "Paimon",
                                            "text": "Wow, this flavor's really unexpected! Haniyyah's really good at this — Paimon didn't think she'd use ingredients from other nations in her Marvelous Jellies."
                                        },
                                        {
                                            "id": "735071613",
                                            "speaker": "Twirly-Whirly",
                                            "text": "..."
                                        },
                                        {
                                            "id": "735071614",
                                            "speaker": "Blitzara",
                                            "text": "♬~"
                                        },
                                        {
                                            "id": "735071615",
                                            "speaker": "Paimon",
                                            "text": "Twirly-Whirly doesn't seem to understand the flavor of Lavender Melon. Maybe it's wondering whether they're fruits or vegetables."
                                        },
                                        {
                                            "id": "735071616",
                                            "speaker": "Paimon",
                                            "text": "Well, Blitzara's having no problems, though. Maybe it's thinking about something happy."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071617",
                                    "text": "Use the Onion-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "735071618",
                                            "speaker": "Paimon",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071619",
                                            "speaker": "Twirly-Whirly",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071620",
                                            "speaker": "Blitzara",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071621",
                                            "speaker": "Paimon",
                                            "text": "Is this flavor really a thing? Haniyyah's thought processes sure are interesting..."
                                        },
                                        {
                                            "id": "735071622",
                                            "speaker": "Twirly-Whirly",
                                            "text": "...♩~"
                                        },
                                        {
                                            "id": "735071623",
                                            "speaker": "Paimon",
                                            "text": "Eh? Looks like Twirly-Whirly's come around... and it seems to like that!"
                                        },
                                        {
                                            "id": "735071624",
                                            "speaker": "Paimon",
                                            "text": "Is there anything special about onions? Let Paimon think..."
                                        },
                                        {
                                            "id": "735071625",
                                            "speaker": "Paimon",
                                            "text": "Hmm... Does it have invigorating effects?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071626",
                    "text": "Let's use different sounds to communicate with them, shall we?",
                    "response": [
                        {
                            "id": "735071627",
                            "speaker": "Paimon",
                            "text": "Ooh, so you're gonna imitate animals? Sure! Paimon would like to know how Twirly-Whirly and Blitzara relate to other animals too!"
                        },
                        {
                            "id": "735071628",
                            "speaker": "Paimon",
                            "text": "C'mon, let's give it a try!",
                            "choices": [
                                {
                                    "id": "735071629",
                                    "text": "Cuckoo!",
                                    "response": [
                                        {
                                            "id": "735071630",
                                            "speaker": "Twirly-Whirly",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071631",
                                            "speaker": "Blitzara",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071632",
                                            "speaker": "Paimon",
                                            "text": "Hmm, Sumeru doesn't really have pigeons, so our Fungi friends didn't really understand you at all."
                                        },
                                        {
                                            "id": "735071633",
                                            "speaker": "Paimon",
                                            "text": "Maybe you can try imitating Dusk Birds instead?"
                                        },
                                        {
                                            "id": "735071634",
                                            "speaker": "Paimon",
                                            "text": "Chachacha, cha~chacha, chacha~ cha!"
                                        },
                                        {
                                            "id": "735071635",
                                            "speaker": "Paimon",
                                            "text": "Uh... Hmm, this is kinda difficult. Paimon can't match their rhythm at all. That might've just confused our shroom buddies more..."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071636",
                                    "text": "Rawr!",
                                    "response": [
                                        {
                                            "id": "735071637",
                                            "speaker": "Paimon",
                                            "text": "What? What were you trying to imitate? Wait. Was that you trying to sound like a Rishboland Tiger?"
                                        },
                                        {
                                            "id": "735071638",
                                            "speaker": "Paimon",
                                            "text": "You'll scare them!"
                                        },
                                        {
                                            "id": "735071639",
                                            "speaker": "Twirly-Whirly",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071640",
                                            "speaker": "Blitzara",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071641",
                                            "speaker": "Paimon",
                                            "text": "Wait, what? They seem pretty excited..."
                                        },
                                        {
                                            "id": "735071642",
                                            "speaker": "Paimon",
                                            "text": "Have they made friends with Rishboland Tigers and fought alongside them before?"
                                        },
                                        {
                                            "id": "735071643",
                                            "speaker": "Paimon",
                                            "text": "That's a bit difficult to imagine... Maybe we should observe Fungi out in the wild more carefully next time."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071644",
                                    "text": "Gang~ gang~ woo!",
                                    "response": [
                                        {
                                            "id": "735071645",
                                            "speaker": "Paimon",
                                            "text": "Wait, why are you copying the Abyss Mages now? Well, you're not very convincing, sure, but you might still frighten them!"
                                        },
                                        {
                                            "id": "735071646",
                                            "speaker": "Twirly-Whirly",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071647",
                                            "speaker": "Blitzara",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071648",
                                            "speaker": "Paimon",
                                            "text": "Um, Twirly-Whirly and Blitzara both look kinda scared!"
                                        },
                                        {
                                            "id": "735071649",
                                            "speaker": "Paimon",
                                            "text": "#It's okay, it's okay, {NICKNAME}'s just playing a prank on you two. There's no Abyss Mage nearby."
                                        },
                                        {
                                            "id": "735071650",
                                            "speaker": "Paimon",
                                            "text": "Still, do Abyss Mages go around bullying Fungi, with hilichurls in tow and all?"
                                        },
                                        {
                                            "id": "735071651",
                                            "speaker": "Paimon",
                                            "text": "Grr, that makes Paimon kinda mad. If we encounter Fungi getting bullied out in the wild next time, there's no way we'd just stand by and let it happen!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071652",
                    "text": "We'll come back later and play with them then.",
                    "response": [
                        {
                            "id": "735071653",
                            "speaker": "Paimon",
                            "text": "Yeah, there's still some stuff we need to do. Well, let's get it done quick, then come back and hang out with Twirly-Whirly and Blitzara, shall we?"
                        }
                    ]
                }
            ]
        }
    ]
}