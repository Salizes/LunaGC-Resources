    "dialogues": [
        {
            "id": "711510101",
            "speaker": "Wriothesley",
            "text": "#{NICKNAME}, had a feeling I might run into you here. Ah... allow me to extend a traditional Liyue greeting: Happy Lantern Rite.",
            "choices": [
                {
                    "id": "711510102",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711510104",
                            "speaker": "Wriothesley",
                            "text": "Not bad at all, flew high and burned bright. Makes me wanna buy a few to bring back to the Fortress."
                        },
                        {
                            "id": "711510111",
                            "speaker": "Wriothesley",
                            "text": "Then again... Xiao Lanterns released in the Fortress of Meropide wouldn't fly to the sky or grant wishes. They'd just mean more work for the janitorial crew."
                        },
                        {
                            "id": "711510103",
                            "speaker": "Player",
                            "text": "About the souvenir photo..."
                        },
                        {
                            "id": "711510112",
                            "speaker": "Wriothesley",
                            "text": "Correct, I requested one from Miss Pingxi. Seems she really did secure a professional photographer."
                        },
                        {
                            "id": "711510113",
                            "speaker": "Wriothesley",
                            "text": "Shall we, then? Take a good shot, I plan to stick it up on my office wall when I get back to Fontaine.",
                            "choices": [
                                {
                                    "id": "711510105",
                                    "text": "Let's start the photoshoot, then.",
                                    "response": [
                                        {
                                            "id": "711510106",
                                            "speaker": "Wriothesley",
                                            "text": "#Sure. Do I need to strike a pose, or...? Suggestions are welcome, {NICKNAME}.",
                                            "choices": [
                                                {
                                                    "id": "711510109",
                                                    "text": "Something more serious.",
                                                    "response": [
                                                        {
                                                            "id": "711510114",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711510110",
                                                    "text": "A more relaxed pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711510107",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
                                            "id": "711510108",
                                            "speaker": "Wriothesley",
                                            "text": "Got something to take care of? Take your time, I'm in no rush."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711510103",
                    "text": "About the souvenir photo..."
                }
            ]
        }
    ]
}