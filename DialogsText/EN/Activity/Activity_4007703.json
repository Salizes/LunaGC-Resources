    },
    "dialogues": [
        {
            "id": "400770301",
            "speaker": "Fischl",
            "text": "Hehe, greetings, my most loyal attendant.",
            "choices": [
                {
                    "id": "400770302",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400770303",
                            "speaker": "Fischl",
                            "text": "Why, certainly. I bestow upon thee permission to ask any questions.",
                            "choices": [
                                {
                                    "id": "400770306",
                                    "text": "About Nachtraben Theater...",
                                    "response": [
                                        {
                                            "id": "400770307",
                                            "speaker": "Fischl",
                                            "text": "Oh? You have witnessed the theater of the Holy Land?"
                                        },
                                        {
                                            "id": "400770308",
                                            "speaker": "Fischl",
                                            "text": "Alright, out with it, be liberal with your words of praise. It is a singular achievement in all the world."
                                        },
                                        {
                                            "id": "400770309",
                                            "speaker": "Oz",
                                            "text": "Mein Fräulein eagerly anticipates your comments."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770310",
                                    "text": "About \"Hymn of the Holy Land\"...",
                                    "response": [
                                        {
                                            "id": "400770311",
                                            "speaker": "Fischl",
                                            "text": "It is the sacred scripture of the Immernachtreich. It must never be allowed to fall into disrepair from a lack of upkeep..."
                                        },
                                        {
                                            "id": "400770312",
                                            "speaker": "Player",
                                            "text": "I'll take good care of it."
                                        },
                                        {
                                            "id": "400770313",
                                            "speaker": "Fischl",
                                            "text": "Hmph, you'd better."
                                        },
                                        {
                                            "id": "400770314",
                                            "speaker": "Oz",
                                            "text": "In mein Fräulein's mind, it is a treasured memento of this journey. She is positively thrilled to know that you also see it as such."
                                        },
                                        {
                                            "id": "400770315",
                                            "speaker": "Fischl",
                                            "text": "Oz, do not over-interpret my speech!"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770316",
                                    "text": "About this vacation...",
                                    "response": [
                                        {
                                            "id": "400770317",
                                            "speaker": "Fischl",
                                            "text": "One was most delighted to behold the grand ceremony and celebration with which one's official excursion to this blessed land was received."
                                        },
                                        {
                                            "id": "400770318",
                                            "speaker": "Fischl",
                                            "text": "Alas, my journey through countless worlds has taught me that even the most splendid of things must come to an end."
                                        },
                                        {
                                            "id": "400770319",
                                            "speaker": "Fischl",
                                            "text": "This is why I have declared to my people that my excursion goes on, as there are still attendants from faraway lands who require the Prinzessin's royal assistance."
                                        },
                                        {
                                            "id": "400770320",
                                            "speaker": "Oz",
                                            "text": "Mein Fräulein cried when she bade farewell to everyone."
                                        },
                                        {
                                            "id": "400770321",
                                            "speaker": "Fischl",
                                            "text": "Oz! I told you, that was only because an insolent grain of sand rudely took refuge in my eyes!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770304",
                    "text": "I won't disturb you.",
                    "response": [
                        {
                            "id": "400770305",
                            "speaker": "Fischl",
                            "text": "O, thou whose fate doth intersect with mine own, please enjoy thyself fully in this paradise.",
                            "choices": [
                                {
                                    "id": "400770306",
                                    "text": "About Nachtraben Theater..."
                                },
                                {
                                    "id": "400770310",
                                    "text": "About \"Hymn of the Holy Land\"..."
                                },
                                {
                                    "id": "400770316",
                                    "text": "About this vacation..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}