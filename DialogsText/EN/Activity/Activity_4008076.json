{
    "talkId": "4008076",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "Sucrose": 18
    },
    "dialogues": [
        {
            "id": "400807601",
            "speaker": "Sucrose",
            "text": "Hi there, are you here to take a look at my stall? I have a lot of newly developed research products.",
            "choices": [
                {
                    "id": "400807602",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400807605",
                            "speaker": "Sucrose",
                            "text": "Um, okay, go ahead...",
                            "choices": [
                                {
                                    "id": "400807606",
                                    "text": "About your stall...",
                                    "response": [
                                        {
                                            "id": "400807607",
                                            "speaker": "Sucrose",
                                            "text": "Oh, this?"
                                        },
                                        {
                                            "id": "400807608",
                                            "speaker": "Sucrose",
                                            "text": "I actually wrote out all the nutritional information and prices for my Bio-Alchemy products in advance. But the customers still prefer to ask directly..."
                                        },
                                        {
                                            "id": "400807609",
                                            "speaker": "Sucrose",
                                            "text": "So... I just read off the sheet for them..."
                                        },
                                        {
                                            "id": "400807610",
                                            "speaker": "Sucrose",
                                            "text": "Running a stall is a huge challenge for me."
                                        },
                                        {
                                            "id": "400807611",
                                            "speaker": "Sucrose",
                                            "text": "Maybe I could get Noelle to interact with the customers, and I do the rest... Mmm, no, never mind... She's probably busy enough already."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807612",
                                    "text": "About your Bio-Alchemy products...",
                                    "response": [
                                        {
                                            "id": "400807613",
                                            "speaker": "Sucrose",
                                            "text": "I have here the Iota-Series Rapid-Acting Deep Freeze Mist Flower, the Theta-Series Fragrance-Enhanced Sweet Flower, Variation 21..."
                                        },
                                        {
                                            "id": "400807614",
                                            "speaker": "Sucrose",
                                            "text": "And the Epsilon-Series Tetrasweet Sunsettia, Variation 63. I'm proud to put my name to all of these products!"
                                        },
                                        {
                                            "id": "400807615",
                                            "speaker": "Sucrose",
                                            "text": "You won't need me to read out all the details, right?"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807616",
                                    "text": "About Razor...",
                                    "response": [
                                        {
                                            "id": "400807617",
                                            "speaker": "Sucrose",
                                            "text": "I'm sorry for running off back then..."
                                        },
                                        {
                                            "id": "400807618",
                                            "speaker": "Sucrose",
                                            "text": "I just thought that you and Noelle would do a better job of expressing things than I could..."
                                        },
                                        {
                                            "id": "400807619",
                                            "speaker": "Sucrose",
                                            "text": "Did everything work out in the end? Mixing the Epsilon-Series Tetrasweet Sunsettia, Variation 63 with the other ingredients didn't cause any problems, did it?"
                                        },
                                        {
                                            "id": "400807620",
                                            "speaker": "Sucrose",
                                            "text": "Oh, and uh... how did things go with Razor..."
                                        },
                                        {
                                            "id": "400807621",
                                            "speaker": "Player",
                                            "text": "Don't worry. Everything turned out great."
                                        },
                                        {
                                            "id": "400807622",
                                            "speaker": "Sucrose",
                                            "text": "Phew... Thank goodness."
                                        },
                                        {
                                            "id": "400807623",
                                            "speaker": "Sucrose",
                                            "text": "Then... can I ask you for a favor? I want to make a note of the full recipe for the Thousand-Wind Wine we made."
                                        },
                                        {
                                            "id": "400807624",
                                            "speaker": "Sucrose",
                                            "text": "That way, we'll be able to recreate the exact same flavor we did today in the future, no matter how many years go by."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807603",
                    "text": "I'll leave you in peace.",
                    "response": [
                        {
                            "id": "400807604",
                            "speaker": "Sucrose",
                            "text": "Oh, sure. No problem."
                        }
                    ]
                }
            ]
        }
    ]
}