    "dialogues": [
        {
            "id": "711540601",
            "speaker": "Charlotte",
            "text": "Hey, over here, over here!"
        },
        {
            "id": "711540602",
            "speaker": "Charlotte",
            "text": "I knew you wouldn't miss Lantern Rite! I was wondering when I'd bump into you.",
            "choices": [
                {
                    "id": "711540603",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711540605",
                            "speaker": "Charlotte",
                            "text": "I know, I saw it already! I'd launched a whole bunch earlier. It was the perfect photo op!"
                        },
                        {
                            "id": "711540606",
                            "speaker": "Charlotte",
                            "text": "Wishes? What... HAH!? I was so busy taking photos, I forgot to write any! Shoot, and I released so many... Does that mean my wishes aren't gonna count...?"
                        },
                        {
                            "id": "711540604",
                            "speaker": "Player",
                            "text": "Here for work again, Charlotte?"
                        },
                        {
                            "id": "711540607",
                            "speaker": "Charlotte",
                            "text": "No no no, I can't be working at every Lantern Rite, now can I? I really am here on vacation this time!"
                        },
                        {
                            "id": "711540608",
                            "speaker": "Player",
                            "text": "You signed up for a souvenir picture, didn't you?"
                        },
                        {
                            "id": "711540609",
                            "speaker": "Charlotte",
                            "text": "Yep! Miss Pingxi said she'd find a professional photographer to take a good portrait photo... Hey, wait a sec, don't tell me..."
                        },
                        {
                            "id": "711540610",
                            "speaker": "Player",
                            "text": "Professional photographer, reporting for duty."
                        },
                        {
                            "id": "711540611",
                            "speaker": "Charlotte",
                            "text": "It really is you? Hehe, that's perfect then! Come on, take my photo, let's see who's better behind the lens!"
                        },
                        {
                            "id": "711540612",
                            "speaker": "Charlotte",
                            "text": "So, ready to start?",
                            "choices": [
                                {
                                    "id": "711540613",
                                    "text": "No problem, ready when you are.",
                                    "response": [
                                        {
                                            "id": "711540614",
                                            "speaker": "Charlotte",
                                            "text": "#Alrighty! Can't take a picture without posing for the Kamera, though... Any suggestions, {NICKNAME}?",
                                            "choices": [
                                                {
                                                    "id": "711540615",
                                                    "text": "Something more serious.",
                                                    "response": [
                                                        {
                                                            "id": "711540619",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711540616",
                                                    "text": "A more relaxed pose.",
                                                    "response": [
                                                        {
                                                            "id": "711540621",
                                                            "speaker": "Player",
                                                            "text": "Let's try the first pose...",
                                                            "choices": [
                                                                {
                                                                    "id": "711540620",
                                                                    "text": "Let's try the second pose..."
                                                                },
                                                                {
                                                                    "id": "711540619",
                                                                    "text": "This pose works."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711540617",
                                    "text": "Wait a moment...",
                                    "response": [
                                        {
                                            "id": "711540618",
                                            "speaker": "Charlotte",
                                            "text": "Uh, have something else to take care of? No worries, we can come back to the photo later."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711540604",
                    "text": "Here for work again, Charlotte?"
                }
            ]
        }
    ]
}