                                                    "text": "A more relaxed pose.",
                                                    "response": [
                                                        {
                                                            "id": "711550708",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711550707",
                                                    "text": "A more serious pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711550704",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
