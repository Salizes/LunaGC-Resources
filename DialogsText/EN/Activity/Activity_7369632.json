    "dialogues": [
        {
            "id": "736963201",
            "speaker": "Bahar",
            "text": "Why was his mentor angry?",
            "choices": [
                {
                    "id": "736963202",
                    "text": "Because he could not obtain the letter.",
                    "response": [
                        {
                            "id": "736963206",
                            "speaker": "Bahar",
                            "text": "Who was it who last came into contact with the letter?",
                            "choices": [
                                {
                                    "id": "736963207",
                                    "text": "The contact that the Treasure Hoarders had within the Akademiya.",
                                    "response": [
                                        {
                                            "id": "736963211",
                                            "speaker": "Bahar",
                                            "text": "Where was the letter?",
                                            "choices": [
                                                {
                                                    "id": "736963212",
                                                    "text": "The mentor's office.",
                                                    "response": [
                                                        {
                                                            "id": "736963216",
                                                            "speaker": "Bahar",
                                                            "text": "What was within the letter, then?",
                                                            "choices": [
                                                                {
                                                                    "id": "736963217",
                                                                    "text": "An alchemical potion."
                                                                },
                                                                {
                                                                    "id": "736963218",
                                                                    "text": "The keys to the office."
                                                                },
                                                                {
                                                                    "id": "736963219",
                                                                    "text": "Correspondence from the Treasure Hoarders."
                                                                },
                                                                {
                                                                    "id": "736963220",
                                                                    "text": "A bill."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "736963213",
                                                    "text": "It was hidden."
                                                },
                                                {
                                                    "id": "736963214",
                                                    "text": "It was with the matra."
                                                },
                                                {
                                                    "id": "736963215",
                                                    "text": "It was destroyed."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "736963208",
                                    "text": "The Darshan staff member who was in charge of passing on the letter."
                                },
                                {
                                    "id": "736963209",
                                    "text": "The matra."
                                },
                                {
                                    "id": "736963210",
                                    "text": "Bahera."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "736963203",
                    "text": "The contents of the letter had been ruined."
                },
                {
                    "id": "736963204",
                    "text": "His plan was about to be exposed."
                },
                {
                    "id": "736963205",
                    "text": "Bahera was working with the Treasure Hoarders."
