{
    "talkId": "7451502",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Hosseini": 10,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "745150201",
            "speaker": "Hosseini",
            "text": "So, how's the experiment going?",
            "choices": [
                {
                    "id": "745150202",
                    "text": "Eh, within expectations, more or less.",
                    "response": [
                        {
                            "id": "745150203",
                            "speaker": "Hosseini",
                            "text": "The Amplifier is functioning stably, and the recorded data is clear. Normally, I'd be thrilled."
                        },
                        {
                            "id": "745150204",
                            "speaker": "Hosseini",
                            "text": "But after seeing how you fight for myself, I just feel like there's still much room for my device to improve.",
                            "choices": [
                                {
                                    "id": "745150205",
                                    "text": "Well, I am a virtuoso of violently vanquishing villainy.",
                                    "response": [
                                        {
                                            "id": "745150206",
                                            "speaker": "Hosseini",
                                            "text": "Haha, yes, that's true! So I too must keep at it, and work hard."
                                        }
                                    ]
                                },
                                {
                                    "id": "745150207",
                                    "text": "Being able to spot issues is always a good thing.",
                                    "response": [
                                        {
                                            "id": "745150208",
                                            "speaker": "Hosseini",
                                            "text": "#Precisely. And as it happens, I already have some ideas, so this round of experiments was very productive indeed. Thank you, {NICKNAME}."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745150209",
                    "text": "I just noticed... you don't cough anymore.",
                    "response": [
                        {
                            "id": "745150210",
                            "speaker": "Hosseini",
                            "text": "Huh. Now that you mention it... My cough has gotten better since my Amplifier started making progress."
                        },
                        {
                            "id": "745150211",
                            "speaker": "Hosseini",
                            "text": "Perhaps it is as the doctors say, that \"laughter is the best medicine\"?",
                            "choices": [
                                {
                                    "id": "745150212",
                                    "text": "Hope all goes well.",
                                    "response": [
                                        {
                                            "id": "745150213",
                                            "speaker": "Hosseini",
                                            "text": "#Thank you, {NICKNAME}."
                                        }
                                    ]
                                },
                                {
                                    "id": "745150214",
                                    "text": "Can it cure your nongraduatitis?",
                                    "response": [
                                        {
                                            "id": "745150215",
                                            "speaker": "Hosseini",
                                            "text": "We might need my mentor's mood to cooperate for that."
                                        },
                                        {
                                            "id": "745150216",
                                            "speaker": "Hosseini",
                                            "text": "Theoretically, though, if the Hosseini Amplifier does perform up to par, he'll have to be happy whether he wants to be or not, ha!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}