{
    "talkId": "4019705",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Paimon": 9,
        "Player": 10,
        "Sigewinne": 16
    },
    "dialogues": [
        {
            "id": "401970501",
            "speaker": "Sigewinne",
            "text": "#Hey there, {NICKNAME}, Paimon!"
        },
        {
            "id": "401970502",
            "speaker": "Paimon",
            "text": "Hey, Sigewinne! Welcome to the Chevalmarin Film Fantasyland!",
            "choices": [
                {
                    "id": "401970503",
                    "text": "You sure have your finger on the pulse!",
                    "response": [
                        {
                            "id": "401970505",
                            "speaker": "Sigewinne",
                            "text": "Actually, both! Navia told me about the plans at the Beauty Association's last meet-up, so I've been looking forward to it since."
                        },
                        {
                            "id": "401970506",
                            "speaker": "Sigewinne",
                            "text": "But it's become so popular now that everyone's talking about it, even down in the Fortress of Meropide! Many of our staff members are actually hoping to take time off to visit."
                        },
                        {
                            "id": "401970507",
                            "speaker": "Paimon",
                            "text": "Aw, your encouragement leaves Paimon feeling even more motivated than ever!",
                            "choices": [
                                {
                                    "id": "401970508",
                                    "text": "What kind of films are you into, Sigewinne?",
                                    "response": [
                                        {
                                            "id": "401970510",
                                            "speaker": "Sigewinne",
                                            "text": "Oh, well... I guess I prefer animated films! You know, the light-hearted and fun type."
                                        },
                                        {
                                            "id": "401970511",
                                            "speaker": "Sigewinne",
                                            "text": "For example, there's a group of creators who come up with these magical stories about cute little animals. I've watched every last one of their films!"
                                        },
                                        {
                                            "id": "401970512",
                                            "speaker": "Sigewinne",
                                            "text": "Funnily enough, it just so happens that according to our new regulations, well-behaved inmates are now allowed to spend their Credit Coupons on watching films up to three times a week."
                                        },
                                        {
                                            "id": "401970513",
                                            "speaker": "Sigewinne",
                                            "text": "I run the projector in my free time since we don't have a dedicated staff member yet."
                                        },
                                        {
                                            "id": "401970514",
                                            "speaker": "Sigewinne",
                                            "text": "So, I decided to show them films like My Neighbor Kokoro."
                                        },
                                        {
                                            "id": "401970515",
                                            "speaker": "Sigewinne",
                                            "text": "I also started showing them a famous series called Dom and Cherry. It's super long, with hundreds of episodes, but it never gets old.",
                                            "choices": [
                                                {
                                                    "id": "401970516",
                                                    "text": "A bunch of hardened criminals watching films about cute little animals...",
                                                    "response": [
                                                        {
                                                            "id": "401970518",
                                                            "speaker": "Paimon",
                                                            "text": "But now they've got films to watch, even the ones who used to cause trouble might settle down a bit, right?"
                                                        },
                                                        {
                                                            "id": "401970519",
                                                            "speaker": "Paimon",
                                                            "text": "We have our very own animal-themed area, by the way. We call it \"Mellow Manor.\" Customers are calling it the most relaxing place in the park!"
                                                        },
                                                        {
                                                            "id": "401970520",
                                                            "speaker": "Sigewinne",
                                                            "text": "Ooh, ooh, I've been there already! I wasn't expecting it to be so fun!"
                                                        },
                                                        {
                                                            "id": "401970521",
                                                            "speaker": "Sigewinne",
                                                            "text": "There were all kinds of animals living together, ones I'd never even imagined. It almost felt like I'd stepped into the film Zoo-Opolis!",
                                                            "choices": [
                                                                {
                                                                    "id": "401970522",
                                                                    "text": "If you've got the time, why don't you come back every day?",
                                                                    "response": [
                                                                        {
                                                                            "id": "401970524",
                                                                            "speaker": "Paimon",
                                                                            "text": "Oh, you mean we could invite Sigewinne to be a consultant at Mellow Manor?"
                                                                        },
                                                                        {
                                                                            "id": "401970525",
                                                                            "speaker": "Paimon",
                                                                            "text": "Now that you mention it, that sounds like a great idea! Sigewinne's great at caring for people, and she's so warm and gentle. Looking after animals should be a piece of cake!"
                                                                        },
                                                                        {
                                                                            "id": "401970526",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "A... consultant?"
                                                                        },
                                                                        {
                                                                            "id": "401970527",
                                                                            "speaker": "Paimon",
                                                                            "text": "Yeah! Like someone who gives advice and tells the park staff how to do their jobs better!"
                                                                        },
                                                                        {
                                                                            "id": "401970528",
                                                                            "speaker": "Paimon",
                                                                            "text": "The workload won't be too heavy, but it's important work. Besides, you'll mostly be playing with the animals!"
                                                                        },
                                                                        {
                                                                            "id": "401970529",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "That sounds like a lot of fun! Sign me up!"
                                                                        },
                                                                        {
                                                                            "id": "401970530",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "As it happens, things aren't that busy in the Fortress right now. Had I known you were recruiting for this position earlier, I might've even applied myself!"
                                                                        },
                                                                        {
                                                                            "id": "401970531",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "But before I start, I'll have to make arrangements for the medical team in my absence, borrow some related books from my doctor friends, and — last but not least — prepare gifts for the animals!"
                                                                        },
                                                                        {
                                                                            "id": "401970532",
                                                                            "speaker": "Sigewinne",
                                                                            "text": "If it's not too inconvenient for you, why don't we meet up again at Marcotte Station sometime soon?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "401970533",
                                                                                    "text": "No inconvenience at all!",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "401970535",
                                                                                            "speaker": "Paimon",
                                                                                            "text": "Hehe, with Sigewinne on board, Mellow Manor's gonna be even better than before. Paimon has a feeling our revenue's gonna shoot through the roof!"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "401970534",
                                                                                    "text": "It's settled, then!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "401970523",
                                                                    "text": "Wanna enjoy yourself there and earn some Mora on the side?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401970517",
                                                    "text": "I'm finding it quite hard to imagine."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401970509",
                                    "text": "I'm curious what your favorite genres are..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401970504",
                    "text": "Or has the park really become that famous?"
                }
            ]
        }
    ]
}