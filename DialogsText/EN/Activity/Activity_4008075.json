{
    "talkId": "4008075",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "Rosaria": 14
    },
    "dialogues": [
        {
            "id": "400807501",
            "speaker": "Rosaria",
            "text": "#{NICKNAME}, hello again...",
            "choices": [
                {
                    "id": "400807502",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400807505",
                            "speaker": "Rosaria",
                            "text": "Sure. Did you have something you wanted to ask me about?",
                            "choices": [
                                {
                                    "id": "400807506",
                                    "text": "About Varka...",
                                    "response": [
                                        {
                                            "id": "400807507",
                                            "speaker": "Rosaria",
                                            "text": "Oh. Yes, I read his letter. Barbara showed it to me."
                                        },
                                        {
                                            "id": "400807508",
                                            "speaker": "Rosaria",
                                            "text": "She'd been so worried about her father, Seamus. She almost burst into tears when she read that \"the expedition is safe and all of its members are accounted for.\""
                                        },
                                        {
                                            "id": "400807509",
                                            "speaker": "Rosaria",
                                            "text": "Hmm? ...My thoughts?"
                                        },
                                        {
                                            "id": "400807510",
                                            "speaker": "Rosaria",
                                            "text": "Hehe... You're curious what he means to me as a father figure, is that right? Well, I guess I'm not like other daughters. I can't bring myself to worry about him."
                                        },
                                        {
                                            "id": "400807511",
                                            "speaker": "Rosaria",
                                            "text": "He wouldn't be leading that many people if he didn't have the necessary strength and courage for it. He's not the kind of person you need to worry about."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807512",
                                    "text": "About Razor...",
                                    "response": [
                                        {
                                            "id": "400807513",
                                            "speaker": "Rosaria",
                                            "text": "So, he's finally come to terms with everything?"
                                        },
                                        {
                                            "id": "400807514",
                                            "speaker": "Player",
                                            "text": "At the very least, he's no longer lost and confused."
                                        },
                                        {
                                            "id": "400807515",
                                            "speaker": "Player",
                                            "text": "He has a direction now."
                                        },
                                        {
                                            "id": "400807516",
                                            "speaker": "Rosaria",
                                            "text": "Hmm, sounds like he still has some way to go before he can say he's fully independent. But everyone goes through their own life in their own way."
                                        },
                                        {
                                            "id": "400807517",
                                            "speaker": "Rosaria",
                                            "text": "Well done. It sounds like your efforts were all worth it in the end."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807518",
                                    "text": "About the Weinlesefest...",
                                    "response": [
                                        {
                                            "id": "400807519",
                                            "speaker": "Rosaria",
                                            "text": "I thought that if I made it to the Weinlesefest, I'd have the chance to spend a whole day in the tavern. Turns out, there's actually more work during a festival than usual."
                                        },
                                        {
                                            "id": "400807520",
                                            "speaker": "Rosaria",
                                            "text": "I managed to escape to here, but I still can't completely let my guard down. Who knows when Victoria or Dahlia might show up and drag me off to the sung poetry event."
                                        },
                                        {
                                            "id": "400807521",
                                            "speaker": "Rosaria",
                                            "text": "*sigh* The sooner this festival is over, the better."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807503",
                    "text": "I'll leave you in peace.",
                    "response": [
                        {
                            "id": "400807504",
                            "speaker": "Rosaria",
                            "text": "Alright. But don't tell anyone else that I'm here. I don't want to have to move anytime soon."
                        }
                    ]
                }
            ]
        }
    ]
}