{
    "talkId": "7055703",
    "total_dialogue_lines": 48,
    "speaker_counts": {
        "Horken": 33,
        "Player": 15
    },
    "dialogues": [
        {
            "id": "705570301",
            "speaker": "Horken",
            "text": "Greetings, Honorary Knight. I'm Horken, Cavalry Company liaison to the General Affairs Company. Is there anything I can help you with besides the play?",
            "choices": [
                {
                    "id": "705570302",
                    "text": "Tell me more about the General Affairs Company...",
                    "response": [
                        {
                            "id": "705570303",
                            "speaker": "Horken",
                            "text": "Oh, so you're interested in the First Company? In that case, please allow me to give you a brief overview."
                        },
                        {
                            "id": "705570304",
                            "speaker": "Horken",
                            "text": "The General Affairs Company is responsible for planning and organizing Mondstadt's general affairs — things like economic output, enforcement of regulations, city management — those sorts of things."
                        },
                        {
                            "id": "705570305",
                            "speaker": "Horken",
                            "text": "Because of that, most of their duties involve a lot of paperwork. As a liaison, my role is to assist Captain Kaeya in coordinating cooperation between the General Affairs Company and our own.",
                            "choices": [
                                {
                                    "id": "705570306",
                                    "text": "Sounds like a pretty cozy position?",
                                    "response": [
                                        {
                                            "id": "705570308",
                                            "speaker": "Horken",
                                            "text": "You're not wrong. The pay's good, the hours are reasonable, and most of the time I get to deal with the friendly, welcoming citizens of Mondstadt. It's a very enjoyable role."
                                        },
                                        {
                                            "id": "705570309",
                                            "speaker": "Horken",
                                            "text": "That said, if you have any friends who want to join the Knights of Favonius, it's probably best not to aim straight for the First Company.",
                                            "choices": [
                                                {
                                                    "id": "705570310",
                                                    "text": "Why's that?",
                                                    "response": [
                                                        {
                                                            "id": "705570312",
                                                            "speaker": "Horken",
                                                            "text": "At present, we prioritize recruiting knights who've sustained combat injuries and can no longer serve at full strength on the front lines."
                                                        },
                                                        {
                                                            "id": "705570313",
                                                            "speaker": "Horken",
                                                            "text": "As for full-time clerks, they're required to pass rigorous professional qualifying exams. It's fair to say that anyone training from a young age to become a Knight rarely has the time to study to that level of specialized knowledge."
                                                        },
                                                        {
                                                            "id": "705570314",
                                                            "speaker": "Horken",
                                                            "text": "Comfortable, well-paid positions are something you earn through proven ability and conviction. They're not easy roles to get...",
                                                            "choices": [
                                                                {
                                                                    "id": "705570315",
                                                                    "text": "So, what's your situation?",
                                                                    "response": [
                                                                        {
                                                                            "id": "705570316",
                                                                            "speaker": "Horken",
                                                                            "text": "My situation... isn't too bad. During an engagement with a pair of Eyes of the Storm, both of my legs were broken — compound fractures."
                                                                        },
                                                                        {
                                                                            "id": "705570317",
                                                                            "speaker": "Horken",
                                                                            "text": "After years of recovery, I can walk just fine, but I can no longer charge, much less fight shoulder to shoulder with my comrades. That's how I became a liaison."
                                                                        },
                                                                        {
                                                                            "id": "705570318",
                                                                            "speaker": "Player",
                                                                            "text": "Have you considered using prosthetics?"
                                                                        },
                                                                        {
                                                                            "id": "705570319",
                                                                            "speaker": "Horken",
                                                                            "text": "Hmm... That's not a bad idea."
                                                                        },
                                                                        {
                                                                            "id": "705570320",
                                                                            "speaker": "Horken",
                                                                            "text": "If I could find a suitable model — and my comrades don't mind someone slightly weaker fighting beside them — I wouldn't mind trying it out."
                                                                        },
                                                                        {
                                                                            "id": "705570321",
                                                                            "speaker": "Horken",
                                                                            "text": "That way, even if that lunatic Hedwig ever returns to the frontlines, I'll at least be able to keep an eye on her — and spare my parents some worry."
                                                                        },
                                                                        {
                                                                            "id": "705570331",
                                                                            "speaker": "Horken",
                                                                            "text": "Yes. Our families used to live one floor apart. When Hedwig was seven, her parents went abroad. After that, something must have happened, because there's been no word of them since."
                                                                        },
                                                                        {
                                                                            "id": "705570332",
                                                                            "speaker": "Horken",
                                                                            "text": "My family took her in. She stayed with us until she grew up, found work, and moved out on her own."
                                                                        },
                                                                        {
                                                                            "id": "705570333",
                                                                            "speaker": "Horken",
                                                                            "text": "Even though we always treated her like one of the family, when a child's real parents are gone... often the emptiness that's left behind can't be filled by anything else."
                                                                        },
                                                                        {
                                                                            "id": "705570334",
                                                                            "speaker": "Horken",
                                                                            "text": "I think that may be why she so deeply admires Commander Gunnhildr — both of them.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "705570335",
                                                                                    "text": "Deeply admires?",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "705570337",
                                                                                            "speaker": "Horken",
                                                                                            "text": "It's just a guess, really..."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570338",
                                                                                            "speaker": "Horken",
                                                                                            "text": "At first, she may have simply hoped that her mother was as brave as the Alder Knight, that her parents' long silence meant they were fighting some dark forces somewhere, rather than having met an unfortunate end."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570339",
                                                                                            "speaker": "Horken",
                                                                                            "text": "And she probably wished that she herself could become as strong as the Lionfang Knight — strong enough that one day, she could overcome every obstacle and travel abroad to find her parents."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570340",
                                                                                            "speaker": "Horken",
                                                                                            "text": "Later on, influenced by the two Commanders Gunnhildr, she must have let go of some of those dreams. What remained was a single conviction — to fight for Mondstadt."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570341",
                                                                                            "speaker": "Horken",
                                                                                            "text": "That's why she pushed herself so hard to join the Knights of Favonius, why she threw herself into duty without regard for her own safety, doing everything she could to eliminate danger wherever it appeared."
                                                                                        },
                                                                                        {
                                                                                            "id": "705570342",
                                                                                            "speaker": "Horken",
                                                                                            "text": "As her \"younger brother,\" I figured I should do something to keep her from getting herself killed. So, I followed her into service with the Knights.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "705570343",
                                                                                                    "text": "When you put it like that...",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "705570345",
                                                                                                            "speaker": "Horken",
                                                                                                            "text": "Well, I've gone on long enough. Thank you for listening so patiently. It's truly an honor."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705570346",
                                                                                                            "speaker": "Horken",
                                                                                                            "text": "If you'd like to know more about the General Affairs Company, feel free to come by another time. I can prepare some documents and go over everything in detail."
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "705570344",
                                                                                                    "text": "I still don't quite get it..."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "705570336",
                                                                                    "text": "I'm not quite following the logic here..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "705570322",
                                                                    "text": "What's Hedwig's situation...?",
                                                                    "response": [
                                                                        {
                                                                            "id": "705570323",
                                                                            "speaker": "Horken",
                                                                            "text": "Her situation is a little different... She transferred directly from the Cavalry Company to the General Affairs Company."
                                                                        },
                                                                        {
                                                                            "id": "705570324",
                                                                            "speaker": "Horken",
                                                                            "text": "Her unit discovered two inactive Ruin Guards concealed in the bushes next to a major road. While attempting to neutralize the threat, the Ruin Guards suddenly reactivated."
                                                                        },
                                                                        {
                                                                            "id": "705570325",
                                                                            "speaker": "Horken",
                                                                            "text": "She and two comrades covered the unit's retreat, sent word for reinforcements, and held their ground until Commander Gunnhildr arrived."
                                                                        },
                                                                        {
                                                                            "id": "705570326",
                                                                            "speaker": "Horken",
                                                                            "text": "It took over a year for her comrades to recover, but Hedwig returned to duty after just three months. She was determined to eliminate the threat completely, so she returned to investigate the area where the Ruin Guards had been."
                                                                        },
                                                                        {
                                                                            "id": "705570327",
                                                                            "speaker": "Horken",
                                                                            "text": "This led her to a small and extremely dangerous Domain. Another brutal fight ensued, one that required Commander Gunnhildr's intervention yet again."
                                                                        },
                                                                        {
                                                                            "id": "705570328",
                                                                            "speaker": "Horken",
                                                                            "text": "This time, half her internal organs were damaged beyond use. The fact she survived at all was a miracle. She'll need at least another five years to recover. The honors and rewards she received are scant recompense for the pain it caused my parents."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "705570329",
                                                                    "text": "So your parents know Hedwig, too?"
                                                                },
                                                                {
                                                                    "id": "705570330",
                                                                    "text": "Sounds like you two are pretty close..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705570311",
                                                    "text": "Are there too few openings?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705570307",
                                    "text": "It doesn't look like your duties are stressing you out."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705570347",
                    "text": "Alright then. See you around!",
                    "response": [
                        {
                            "id": "705570348",
                            "speaker": "Horken",
                            "text": "Take care."
                        }
                    ]
                }
            ]
        }
    ]
}