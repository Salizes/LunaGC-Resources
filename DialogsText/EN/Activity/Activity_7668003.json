            "text": "?",
            "choices": [
                {
                    "id": "766800302",
                    "text": "Good weasel! Well done!",
                    "response": [
                        {
                            "id": "766800303",
                            "speaker": "Sproutie",
                            "text": "..."
                        },
                        {
                            "id": "766800304",
                            "speaker": "Observe Sproutie",
                            "text": "(It doesn't look like this little weasel has been praised like this before — there's a look of shyness in its eyes...)"
                        }
                    ]
                },
                {
                    "id": "766800305",
                    "text": "You handsome weasel! Let's do great things together!",
                    "response": [
                        {
                            "id": "766800306",
                            "speaker": "Sproutie",
                            "text": "!!!"
                        },
                        {
                            "id": "766800307",
                            "speaker": "Observe Sproutie",
                            "text": "(This little weasel seems really encouraged — its eyes are sparkling with determination...)"
                        }
                    ]
                },
                {
                    "id": "766800308",
                    "text": "See you next time, weasel!",
                    "response": [
                        {
                            "id": "766800309",
                            "speaker": "Observe Sproutie",
                            "text": "(The little weasel seems unusually calm — it's just staring at you as you walk away...)"
                        }
                    ]
                }
            ]
        }
    ]
