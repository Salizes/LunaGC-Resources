{
    "talkId": "7350711",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Bongo-Head": 9,
        "Paimon": 39,
        "Player": 13,
        "Pyro-1": 9
    },
    "dialogues": [
        {
            "id": "735071101",
            "speaker": "Paimon",
            "text": "Hey there, Bongo-Head, Kindlejoy! We're here to play with you!"
        },
        {
            "id": "735071102",
            "speaker": "Paimon",
            "text": "#What shall we do together with our shroom buddies, {NICKNAME}?",
            "choices": [
                {
                    "id": "735071103",
                    "text": "Let's feed them, shall we?",
                    "response": [
                        {
                            "id": "735071104",
                            "speaker": "Paimon",
                            "text": "Sure! We had so much fun last time that we didn't notice the many Marvelous Jelly flavors available. Let's pay a bit more attention to the ones the shrooms prefer, shall we?",
                            "choices": [
                                {
                                    "id": "735071105",
                                    "text": "Use the Valberry-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "735071106",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071107",
                                            "speaker": "Pyro-1",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071108",
                                            "speaker": "Paimon",
                                            "text": "Ooh, so Bongo-Head likes the Valberry-flavored ones, huh?"
                                        },
                                        {
                                            "id": "735071109",
                                            "speaker": "Paimon",
                                            "text": "Maybe we can squeeze lots of Valberry juice and let Bongo-Head soak in them next time..."
                                        },
                                        {
                                            "id": "735071110",
                                            "speaker": "Paimon",
                                            "text": "On the other hand, it seems like Kindlejoy isn't that keen... Maybe it doesn't like sweet stuff — that sure fits its personality!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071111",
                                    "text": "Use the Mint-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "735071112",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071113",
                                            "speaker": "Pyro-1",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071114",
                                            "speaker": "Paimon",
                                            "text": "Hey, looks like Bongo-Head loves minty-fresh flavors!"
                                        },
                                        {
                                            "id": "735071115",
                                            "speaker": "Paimon",
                                            "text": "Do you think it'll have tons of fun in a Mint field?"
                                        },
                                        {
                                            "id": "735071116",
                                            "speaker": "Paimon",
                                            "text": "Hmm... But it looks like Kindlejoy's not loving the cool flavors much."
                                        }
                                    ]
                                },
                                {
                                    "id": "735071117",
                                    "text": "Use the Crab Roe-flavored jellies.",
                                    "response": [
                                        {
                                            "id": "735071118",
                                            "speaker": "Paimon",
                                            "text": "Um, is this flavor really a thing? Haniyyah sure gets some... interesting ideas..."
                                        },
                                        {
                                            "id": "735071119",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071120",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071121",
                                            "speaker": "Paimon",
                                            "text": "Huh, looks like Bongo-Head doesn't mind the flavor of Crab Roe at all!"
                                        },
                                        {
                                            "id": "735071122",
                                            "speaker": "Paimon",
                                            "text": "Kindlejoy seems pleased too. Looks like Crab Roe's the happy medium!"
                                        },
                                        {
                                            "id": "735071123",
                                            "speaker": "Paimon",
                                            "text": "It is kinda time-consuming to make Crab Roe, but it's a small sacrifice to make for our buddies, eh? Let's make some for them later!"
                                        },
                                        {
                                            "id": "735071124",
                                            "speaker": "Paimon",
                                            "text": "Once we know how to make Marvelous Jellies, we can whip up a great feast for them!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071125",
                    "text": "Let's make some gestures at them, shall we?",
                    "response": [
                        {
                            "id": "735071126",
                            "speaker": "Paimon",
                            "text": "Hmm? That's true, it seems some people can use simple hand gestures to make animals understand what they mean."
                        },
                        {
                            "id": "735071127",
                            "speaker": "Paimon",
                            "text": "Let's give it a go — with our bond with our Fungi friends, we should have no problem!",
                            "choices": [
                                {
                                    "id": "735071128",
                                    "text": "Give your Fungi friends a thumbs-up.",
                                    "response": [
                                        {
                                            "id": "735071129",
                                            "speaker": "Paimon",
                                            "text": "Right, Paimon'll do it too. Thumbs up for good ol' Bongo-Head and the handsome Kindlejoy!"
                                        },
                                        {
                                            "id": "735071130",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071131",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071132",
                                            "speaker": "Paimon",
                                            "text": "Hehe, looks like they're both mighty pleased. Let's give them more encouragement in the future!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071133",
                                    "text": "Waggle your index finger around in a circle.",
                                    "response": [
                                        {
                                            "id": "735071134",
                                            "speaker": "Paimon",
                                            "text": "Are you asking them to turn around? Isn't that a bit complicated?"
                                        },
                                        {
                                            "id": "735071135",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071136",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071137",
                                            "speaker": "Paimon",
                                            "text": "Hahaha, look at them go! They're so smart!"
                                        },
                                        {
                                            "id": "735071138",
                                            "speaker": "Paimon",
                                            "text": "It's almost like they're dancing. Maybe if Paimon danced too, Bongo-Head would be willing to be Paimon's dance partner!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071139",
                                    "text": "Point at Paimon with the right hand, left hand at your head.",
                                    "response": [
                                        {
                                            "id": "735071140",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071141",
                                            "speaker": "Paimon",
                                            "text": "Whoa, looks like Bongo-Head's coming over to let Paimon pat it!"
                                        },
                                        {
                                            "id": "735071142",
                                            "speaker": "Paimon",
                                            "text": "But, uh, Kindlejoy is..."
                                        },
                                        {
                                            "id": "735071143",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071144",
                                            "speaker": "Paimon",
                                            "text": "Wait! Stop, stop! Kindlejoy looks like it's about to jump on Paimon's head!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071145",
                    "text": "Let's use different sounds to call out to them, shall we?",
                    "response": [
                        {
                            "id": "735071146",
                            "speaker": "Paimon",
                            "text": "Do you mean that we should try imitating other animals to see what sort of reaction we'll get from them?"
                        },
                        {
                            "id": "735071147",
                            "speaker": "Paimon",
                            "text": "Hehe, Paimon wants to try that too!",
                            "choices": [
                                {
                                    "id": "735071148",
                                    "text": "*roar*",
                                    "response": [
                                        {
                                            "id": "735071149",
                                            "speaker": "Paimon",
                                            "text": "What kinda sound was that? Were you trying to imitate a Sumpter Beast? Paimon's never heard that one before, though..."
                                        },
                                        {
                                            "id": "735071150",
                                            "speaker": "Bongo-Head",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071151",
                                            "speaker": "Pyro-1",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071152",
                                            "speaker": "Paimon",
                                            "text": "Huh, looks like they're coming over..."
                                        },
                                        {
                                            "id": "735071153",
                                            "speaker": "Paimon",
                                            "text": "Do Fungi also stick to Sumpter Beasts for warmth when they feel cold?"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071154",
                                    "text": "Meow~",
                                    "response": [
                                        {
                                            "id": "735071155",
                                            "speaker": "Paimon",
                                            "text": "Haha, so you're a cat, huh? Alright, Paimon's joining in!"
                                        },
                                        {
                                            "id": "735071156",
                                            "speaker": "Bongo-Head",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071157",
                                            "speaker": "Pyro-1",
                                            "text": "?"
                                        },
                                        {
                                            "id": "735071158",
                                            "speaker": "Paimon",
                                            "text": "Huh, they seem kinda curious. Have they never seen a cat before?"
                                        },
                                        {
                                            "id": "735071159",
                                            "speaker": "Paimon",
                                            "text": "Well, guess that just means we should introduce them to some in the future and help them make some new friends!"
                                        },
                                        {
                                            "id": "735071160",
                                            "speaker": "Paimon",
                                            "text": "Speaking of which, would we call a cat that lives in the rainforest a Forest Cat?"
                                        },
                                        {
                                            "id": "735071161",
                                            "speaker": "Paimon",
                                            "text": "And if it makes friends with a Fungus, that makes it a Shroomcat!"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071162",
                                    "text": "Ya!",
                                    "response": [
                                        {
                                            "id": "735071163",
                                            "speaker": "Paimon",
                                            "text": "Hey, hey, that's not an animal you're imitating! You're gonna make our shroom buddies nervous!"
                                        },
                                        {
                                            "id": "735071164",
                                            "speaker": "Bongo-Head",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071165",
                                            "speaker": "Pyro-1",
                                            "text": "!"
                                        },
                                        {
                                            "id": "735071166",
                                            "speaker": "Paimon",
                                            "text": "See? They've been alerted now!"
                                        },
                                        {
                                            "id": "735071167",
                                            "speaker": "Paimon",
                                            "text": "#Don't worry, don't worry, there are no hilichurls around. {NICKNAME}'s just joking."
                                        },
                                        {
                                            "id": "735071168",
                                            "speaker": "Paimon",
                                            "text": "Hmm, guess this means that the shrooms can help us keep watch while we're asleep. They're pretty reliable, huh?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071169",
                    "text": "We'll come back later and play with them.",
                    "response": [
                        {
                            "id": "735071170",
                            "speaker": "Paimon",
                            "text": "Huh, do we have something else to do? Well then, let's get to it quickly — then we can get back and continue playing with Bongo-Head and Kindlejoy!"
                        }
                    ]
                }
            ]
        }
    ]
}