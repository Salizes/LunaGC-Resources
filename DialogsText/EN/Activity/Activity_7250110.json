{
    "talkId": "7250110",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "Tartaglia": 10
    },
    "dialogues": [
        {
            "id": "725011001",
            "speaker": "Tartaglia",
            "text": "Whew, it's finally done. I have to catch up with the others...",
            "choices": [
                {
                    "id": "725011002",
                    "text": "Tartaglia?",
                    "response": [
                        {
                            "id": "725011004",
                            "speaker": "Tartaglia",
                            "text": "#Ah, {NICKNAME}? Haha, you're just in time. I'm chasing after the powerful \"Great Mujina Youkai\" with some new comrades I met.",
                            "choices": [
                                {
                                    "id": "725011005",
                                    "text": "Wait, the Great Mujina Youkai?",
                                    "response": [
                                        {
                                            "id": "725011007",
                                            "speaker": "Tartaglia",
                                            "text": "Why, from those comrades of mine, of course. Apparently, this extremely powerful youkai has been wreaking havoc across rural Inazuma. Whenever it comes across a child who has snuck outside to play, it starts teasing them."
                                        },
                                        {
                                            "id": "725011008",
                                            "speaker": "Tartaglia",
                                            "text": "You know, things like tying their shoelaces together, or turning mud and roots into fruits on a tree then tricking the children into eating them..."
                                        },
                                        {
                                            "id": "725011009",
                                            "speaker": "Tartaglia",
                                            "text": "Sometimes, it even dispatches a few mini mujina and has them turn into parents or teachers to frighten the children."
                                        },
                                        {
                                            "id": "725011010",
                                            "speaker": "Tartaglia",
                                            "text": "Anyway, there's no way I'm gonna let such a formidable youkai run loose."
                                        },
                                        {
                                            "id": "725011011",
                                            "speaker": "Tartaglia",
                                            "text": "If you have time, why not join us on our pursuit of the Great Mujina Youkai?",
                                            "choices": [
                                                {
                                                    "id": "725011012",
                                                    "text": "So these \"comrades\" of yours...",
                                                    "response": [
                                                        {
                                                            "id": "725011014",
                                                            "speaker": "Tartaglia",
                                                            "text": "Oh? So you know Yoimiya too? What a coincidence..."
                                                        },
                                                        {
                                                            "id": "725011015",
                                                            "speaker": "Tartaglia",
                                                            "text": "Anyway, now's not the time for chitchat. Yoimiya and the others are looking for the Great Mujina Youkai's tracks up ahead."
                                                        },
                                                        {
                                                            "id": "725011016",
                                                            "speaker": "Tartaglia",
                                                            "text": "It's my responsibility to bring up the rear, and ensure the Great Mujina doesn't attack us from behind in a fit of rage."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "725011013",
                                                    "text": "Could one of them be Yoimiya?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "725011006",
                                    "text": "Where did you hear that name?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "725011003",
                    "text": "What are you doing here?"
                }
            ]
        }
    ]
}