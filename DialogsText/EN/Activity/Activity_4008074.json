{
    "talkId": "4008074",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Diluc": 16,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "400807401",
            "speaker": "Diluc",
            "text": "So, what do you think of the Weinlesefest? Have you enjoyed yourself?",
            "choices": [
                {
                    "id": "400807402",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400807405",
                            "speaker": "Diluc",
                            "text": "Well, what would you like to know?",
                            "choices": [
                                {
                                    "id": "400807406",
                                    "text": "About Razor...",
                                    "response": [
                                        {
                                            "id": "400807407",
                                            "speaker": "Diluc",
                                            "text": "*sigh* I can sympathize with the anguish of being away from family."
                                        },
                                        {
                                            "id": "400807408",
                                            "speaker": "Diluc",
                                            "text": "Certainly, a tragic situation. But tragedy can also drive personal growth, and perhaps learning how to face it head-on is part of growing up... part of becoming an adult."
                                        },
                                        {
                                            "id": "400807409",
                                            "speaker": "Diluc",
                                            "text": "Having the support of some good friends will certainly make that journey easier."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807410",
                                    "text": "About the voices...",
                                    "response": [
                                        {
                                            "id": "400807411",
                                            "speaker": "Diluc",
                                            "text": "...When I unsealed the wine, it seemed that the words of my late father were sealed inside."
                                        },
                                        {
                                            "id": "400807412",
                                            "speaker": "Diluc",
                                            "text": "I wonder what he would think if he were to see me now."
                                        },
                                        {
                                            "id": "400807413",
                                            "speaker": "Diluc",
                                            "text": "Somehow, I doubt he'd share the same view as he did back then."
                                        },
                                        {
                                            "id": "400807414",
                                            "speaker": "Player",
                                            "text": "Of course he would."
                                        },
                                        {
                                            "id": "400807415",
                                            "speaker": "Diluc",
                                            "text": "Heh..."
                                        },
                                        {
                                            "id": "400807416",
                                            "speaker": "Diluc",
                                            "text": "If you say so."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807417",
                                    "text": "About the Weinlesefest...",
                                    "response": [
                                        {
                                            "id": "400807418",
                                            "speaker": "Diluc",
                                            "text": "To the people of Mondstadt, wine-making is a way of working through emotions, and remembering our history."
                                        },
                                        {
                                            "id": "400807419",
                                            "speaker": "Diluc",
                                            "text": "We're only able to make such high-quality wines these days thanks to the peace we enjoy. War is a thing of the distant past."
                                        },
                                        {
                                            "id": "400807420",
                                            "speaker": "Diluc",
                                            "text": "Even though you might not see me reveling with the crowds, I am grateful for this as much as anyone."
                                        },
                                        {
                                            "id": "400807421",
                                            "speaker": "Diluc",
                                            "text": "Say, have you tried our latest product, \"Fruits of the Festival\"?"
                                        },
                                        {
                                            "id": "400807422",
                                            "speaker": "Diluc",
                                            "text": "If you have any thoughts on how it could be improved, I'm all ears."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807403",
                    "text": "I'll leave you in peace.",
                    "response": [
                        {
                            "id": "400807404",
                            "speaker": "Diluc",
                            "text": "Sure. We'll talk when you're free."
                        }
                    ]
                }
            ]
        }
    ]
}