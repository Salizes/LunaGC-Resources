{
    "talkId": "7115301",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 10,
        "Sigewinne": 9
    },
    "dialogues": [
        {
            "id": "711530102",
            "speaker": "Sigewinne",
            "text": "#Happy Holidays, {NICKNAME}!"
        },
        {
            "id": "711530103",
            "speaker": "Sigewinne",
            "text": "The Duke mentioned we might meet you here, but I didn't expect our paths to cross so soon.",
            "choices": [
                {
                    "id": "711530101",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711530104",
                            "speaker": "Sigewinne",
                            "text": "It's so lovely! I once treated a patient back in the Fortress who talked about wanting to release a Xiao Lantern himself."
                        },
                        {
                            "id": "711530105",
                            "speaker": "Sigewinne",
                            "text": "Since I'm here... I think I'll release one on his behalf and let his wish soar."
                        },
                        {
                            "id": "711530106",
                            "speaker": "Player",
                            "text": "Did you come with Wriothesley, Sigewinne?"
                        },
                        {
                            "id": "711530119",
                            "speaker": "Sigewinne",
                            "text": "Yep! He invited me to experience Liyue's Lantern Rite with him, and also... to finally use up all the vacation days I never got around to taking."
                        },
                        {
                            "id": "711530120",
                            "speaker": "Sigewinne",
                            "text": "We met a very kind lady at the harbor who said that if we'd like, she could arrange for a professional photographer to take our picture as a keepsake!",
                            "choices": [
                                {
                                    "id": "711530107",
                                    "text": "About that...",
                                    "response": [
                                        {
                                            "id": "711530109",
                                            "speaker": "Sigewinne",
                                            "text": "Oh, that's perfect! I'm sure you'll take a really good photo, and then I'll be able to show it to Monsieur Neuvillette later!",
                                            "choices": [
                                                {
                                                    "id": "711530110",
                                                    "text": "Shall we begin, then?",
                                                    "response": [
                                                        {
                                                            "id": "711530111",
                                                            "speaker": "Sigewinne",
                                                            "text": "Sure! Well then, as the \"professional photographer,\" what pose would you recommend?",
                                                            "choices": [
                                                                {
                                                                    "id": "711530114",
                                                                    "text": "Something more serious.",
                                                                    "response": [
                                                                        {
                                                                            "id": "711530116",
                                                                            "speaker": "Player",
                                                                            "text": "This pose works."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "711530115",
                                                                    "text": "A more relaxed pose."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711530112",
                                                    "text": "Hang on a sec...",
                                                    "response": [
                                                        {
                                                            "id": "711530113",
                                                            "speaker": "Sigewinne",
                                                            "text": "Oh, something came up? That's fine, I'll take a stroll nearby. Come find me once you're ready!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711530108",
                                    "text": "I'm that \"professional photographer\"."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711530106",
                    "text": "Did you come with Wriothesley, Sigewinne?"
                }
            ]
        }
    ]
}