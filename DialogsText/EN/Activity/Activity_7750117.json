{
    "talkId": "7750117",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "NPC#17331": 24,
        "Player": 11
    },
    "dialogues": [
        {
            "id": "775011701",
            "speaker": "NPC#17331",
            "text": "#Hello, {NICKNAME}. Thank you again for taking part in the first Adventurers' Tournament.",
            "choices": [
                {
                    "id": "775011702",
                    "text": "Could you remind me who you are?",
                    "response": [
                        {
                            "id": "775011703",
                            "speaker": "NPC#17331",
                            "text": "Ah... To be honest, what I said when we first met was just about everything..."
                        },
                        {
                            "id": "775011704",
                            "speaker": "NPC#17331",
                            "text": "My name is Talalikhin Gogol. I serve as a clerk at Adventurers' Guild Headquarters.",
                            "choices": [
                                {
                                    "id": "775011705",
                                    "text": "But your leaderboard score is not low by any means.",
                                    "response": [
                                        {
                                            "id": "775011707",
                                            "speaker": "NPC#17331",
                                            "text": "I was only asked to take part because I'm familiar with this kind of work. The rest was just luck"
                                        },
                                        {
                                            "id": "775011708",
                                            "speaker": "NPC#17331",
                                            "text": "Besides, I suppose I did have a bit of an advantage — Snezhnayan adventurers are more used to contest events like these, after all."
                                        }
                                    ]
                                },
                                {
                                    "id": "775011706",
                                    "text": "Is that really the sort of ranking one would expect from a clerk?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011709",
                    "text": "Are you close with Lan?",
                    "response": [
                        {
                            "id": "775011710",
                            "speaker": "NPC#17331",
                            "text": "I would not say close, exactly. She has been with the Guild much longer than I have."
                        },
                        {
                            "id": "775011711",
                            "speaker": "NPC#17331",
                            "text": "But this time, Lan and I will be working together behind the scenes.",
                            "choices": [
                                {
                                    "id": "775011712",
                                    "text": "What do you mean?",
                                    "response": [
                                        {
                                            "id": "775011714",
                                            "speaker": "NPC#17331",
                                            "text": "Do you remember the sword called \"Unseen Razor\"?"
                                        },
                                        {
                                            "id": "775011715",
                                            "speaker": "NPC#17331",
                                            "text": "Lan, the Liyue Branch Master of the Adventurers' Guild, is also Huo Lanling — the \"Swordseeker of Qingxu.\" She has never failed a commission since taking office."
                                        },
                                        {
                                            "id": "775011716",
                                            "speaker": "NPC#17331",
                                            "text": "There is another important reason Lan came here. She is searching for the former owner of \"Unseen Razor.\"",
                                            "choices": [
                                                {
                                                    "id": "775011717",
                                                    "text": "I don't know much about what happened with Lan...",
                                                    "response": [
                                                        {
                                                            "id": "775011718",
                                                            "speaker": "NPC#17331",
                                                            "text": "In that case, if you do not mind, I can take a few minutes to explain."
                                                        },
                                                        {
                                                            "id": "775011721",
                                                            "speaker": "NPC#17331",
                                                            "text": "Lan and I both have a reason to find this person."
                                                        },
                                                        {
                                                            "id": "775011722",
                                                            "speaker": "NPC#17331",
                                                            "text": "Because..."
                                                        },
                                                        {
                                                            "id": "775011723",
                                                            "speaker": "NPC#17331",
                                                            "text": "Her elder brother, Master Huo Zhaohui, once traveled across the frozen plains of Snezhnaya alongside my uncle."
                                                        },
                                                        {
                                                            "id": "775011724",
                                                            "speaker": "NPC#17331",
                                                            "text": "They were searching for the \"adamant material,\" hoping to forge the perfect blade and develop a fighting style where warrior and weapon moved as one."
                                                        },
                                                        {
                                                            "id": "775011725",
                                                            "speaker": "NPC#17331",
                                                            "text": "But in the end, they were both caught up in an accident involving the Shadow Realm, and no one has known where they are ever since.",
                                                            "choices": [
                                                                {
                                                                    "id": "775011726",
                                                                    "text": "I had not heard of this before...",
                                                                    "response": [
                                                                        {
                                                                            "id": "775011728",
                                                                            "speaker": "NPC#17331",
                                                                            "text": "That is understandable. The accident was extremely complicated, and the investigation report alone was thicker than a dictionary."
                                                                        },
                                                                        {
                                                                            "id": "775011729",
                                                                            "speaker": "NPC#17331",
                                                                            "text": "The full report was only thoroughly reviewed recently, and the information in it was confirmed to be \"relatively accurate.\" The Special Assignments Battalion has since shared it with the Adventurers' Guild."
                                                                        },
                                                                        {
                                                                            "id": "775011730",
                                                                            "speaker": "NPC#17331",
                                                                            "text": "Once the tournament is over, I will be organizing those findings on the Guild's behalf and using them to create a set of mental training exercises based on simulated Shadow Realm combat."
                                                                        },
                                                                        {
                                                                            "id": "775011731",
                                                                            "speaker": "NPC#17331",
                                                                            "text": "If you are interested, you can find me near the headquarters then."
                                                                        },
                                                                        {
                                                                            "id": "775011732",
                                                                            "speaker": "NPC#17331",
                                                                            "text": "For the sake of the Guild, and for personal reasons as well, I will do everything I can to help Lan find her brother."
                                                                        },
                                                                        {
                                                                            "id": "775011733",
                                                                            "speaker": "NPC#17331",
                                                                            "text": "Perhaps I may also have a chance to find my uncle and help my family move past the grief we have carried for years."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "775011727",
                                                                    "text": "Did Lan not know about it?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011719",
                                                    "text": "I think I helped her look for that sword before...",
                                                    "response": [
                                                        {
                                                            "id": "775011720",
                                                            "speaker": "NPC#17331",
                                                            "text": "Then you do remember. She mentioned it recently, how the two of you searched for the sword together. She seemed very excited when she spoke of it."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011713",
                                    "text": "Are you two working together on something else?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011734",
                    "text": "This must be hard for you, too.",
                    "response": [
                        {
                            "id": "775011735",
                            "speaker": "NPC#17331",
                            "text": "Thank you for your concern. This is my duty, and I will do my best."
                        }
                    ]
                }
            ]
        }
    ]
}