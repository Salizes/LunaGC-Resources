    "dialogues": [
        {
            "id": "711520401",
            "speaker": "Kujou Sara",
            "text": "I see you are ready. Let us proceed with the photograph, then.",
            "choices": [
                {
                    "id": "711520411",
                    "text": "I've released my Xiao Lantern, too.",
                    "response": [
                        {
                            "id": "711520412",
                            "speaker": "Kujou Sara",
                            "text": "Yes, I saw it. I intend to purchase some Xiao Lanterns to take back to Inazuma after this. They will look quite nice hanging at the entrance of the Tenryou Commission."
                        },
                        {
                            "id": "711520413",
                            "speaker": "Kujou Sara",
                            "text": "With Doushin Shikanoin around, I doubt any thieves would dare lay hands on them.",
                            "choices": [
                                {
                                    "id": "711520402",
                                    "text": "No problem, ready when you are.",
                                    "response": [
                                        {
                                            "id": "711520404",
                                            "speaker": "Kujou Sara",
                                            "text": "In that case, please advise me on an appropriate pose while we prepare.",
                                            "choices": [
                                                {
                                                    "id": "711520406",
                                                    "text": "Something more serious.",
                                                    "response": [
                                                        {
                                                            "id": "711520408",
                                                            "speaker": "Player",
                                                            "text": "This pose works."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711520407",
                                                    "text": "A more relaxed pose."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711520403",
                                    "text": "Hang on a sec...",
                                    "response": [
                                        {
                                            "id": "711520405",
                                            "speaker": "Kujou Sara",
                                            "text": "You have something urgent to attend to? No matter, I shall wait here. Come find me once you're done."
