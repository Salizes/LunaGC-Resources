{
    "talkId": "4008073",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "Razor": 19
    },
    "dialogues": [
        {
            "id": "400807301",
            "speaker": "Razor",
            "text": "The wind is gentle, comfortable.",
            "choices": [
                {
                    "id": "400807302",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400807305",
                            "speaker": "Razor",
                            "text": "Yes.",
                            "choices": [
                                {
                                    "id": "400807306",
                                    "text": "About Varka...",
                                    "response": [
                                        {
                                            "id": "400807307",
                                            "speaker": "Razor",
                                            "text": "The message in the letter... I want to thank him."
                                        },
                                        {
                                            "id": "400807308",
                                            "speaker": "Razor",
                                            "text": "...I miss him. Lupical miss him, too."
                                        },
                                        {
                                            "id": "400807309",
                                            "speaker": "Razor",
                                            "text": "Now, I am grown up."
                                        },
                                        {
                                            "id": "400807310",
                                            "speaker": "Razor",
                                            "text": "I want to hear him talk about human father and mother."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807311",
                                    "text": "About your parents...",
                                    "response": [
                                        {
                                            "id": "400807312",
                                            "speaker": "Razor",
                                            "text": "Their voices. I heard them."
                                        },
                                        {
                                            "id": "400807313",
                                            "speaker": "Razor",
                                            "text": "Human father and mother... were adventurers..."
                                        },
                                        {
                                            "id": "400807314",
                                            "speaker": "Razor",
                                            "text": "Teacher said, maybe they didn't survive..."
                                        },
                                        {
                                            "id": "400807315",
                                            "speaker": "Player",
                                            "text": "Aw, Razor..."
                                        },
                                        {
                                            "id": "400807316",
                                            "speaker": "Razor",
                                            "text": "I have a wooden box. Inside are treasures from my friends."
                                        },
                                        {
                                            "id": "400807317",
                                            "speaker": "Razor",
                                            "text": "They are, most precious things I own."
                                        },
                                        {
                                            "id": "400807318",
                                            "speaker": "Razor",
                                            "text": "..."
                                        },
                                        {
                                            "id": "400807319",
                                            "speaker": "Razor",
                                            "text": "Inside box from human father and mother... is all about me..."
                                        }
                                    ]
                                },
                                {
                                    "id": "400807320",
                                    "text": "About friends...",
                                    "response": [
                                        {
                                            "id": "400807321",
                                            "speaker": "Razor",
                                            "text": "A long time ago, I thought I was alone. Only have lupical."
                                        },
                                        {
                                            "id": "400807322",
                                            "speaker": "Razor",
                                            "text": "Now, I know many people."
                                        },
                                        {
                                            "id": "400807323",
                                            "speaker": "Razor",
                                            "text": "Everyone helps me. I will help everyone, too."
                                        },
                                        {
                                            "id": "400807324",
                                            "speaker": "Razor",
                                            "text": "Humans, wolves, everyone."
                                        },
                                        {
                                            "id": "400807325",
                                            "speaker": "Razor",
                                            "text": "I am the bridge between city and outside."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807303",
                    "text": "I'll leave you in peace.",
                    "response": [
                        {
                            "id": "400807304",
                            "speaker": "Razor",
                            "text": "Okay. You go enjoy the wind."
                        }
                    ]
                }
            ]
        }
    ]
}