{
    "talkId": "7154019",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 8,
        "Xiao": 13
    },
    "dialogues": [
        {
            "id": "715401901",
            "speaker": "Xiao",
            "text": "You're here.",
            "choices": [
                {
                    "id": "715401902",
                    "text": "Xiao, this gift envelope is for you.",
                    "response": [
                        {
                            "id": "715401903",
                            "speaker": "Xiao",
                            "text": "...Thank you."
                        },
                        {
                            "id": "715401904",
                            "speaker": "Xiao",
                            "text": "Your breathing is steady, and your footsteps are light — looks like you made a full recovery."
                        },
                        {
                            "id": "715401905",
                            "speaker": "Xiao",
                            "text": "Still, your actions were too reckless. You should reflect on your lack of regard for your safety...",
                            "choices": [
                                {
                                    "id": "715401906",
                                    "text": "Well, it was an emergency...",
                                    "response": [
                                        {
                                            "id": "715401908",
                                            "speaker": "Xiao",
                                            "text": "I wasn't there in the moment, but through the witness sigil, I was able to sense your actions."
                                        },
                                        {
                                            "id": "715401909",
                                            "speaker": "Xiao",
                                            "text": "I could tell you entered the array and took on the force of the blast on behalf of the young girl from Wangsheng Funeral Parlor."
                                        },
                                        {
                                            "id": "715401910",
                                            "speaker": "Xiao",
                                            "text": "...",
                                            "choices": [
                                                {
                                                    "id": "715401911",
                                                    "text": "I got through just fine.",
                                                    "response": [
                                                        {
                                                            "id": "715401913",
                                                            "speaker": "Xiao",
                                                            "text": "In any case, I'm glad you were unharmed."
                                                        },
                                                        {
                                                            "id": "715401914",
                                                            "speaker": "Xiao",
                                                            "text": "...Now, I can put my worries to rest."
                                                        },
                                                        {
                                                            "id": "715401915",
                                                            "speaker": "Xiao",
                                                            "text": "Monsters driven mad by fetor could still attack, so I should patrol the area."
                                                        },
                                                        {
                                                            "id": "715401916",
                                                            "speaker": "Xiao",
                                                            "text": "If you run into trouble...",
                                                            "choices": [
                                                                {
                                                                    "id": "715401917",
                                                                    "text": "I'll call your name.",
                                                                    "response": [
                                                                        {
                                                                            "id": "715401919",
                                                                            "speaker": "Xiao",
                                                                            "text": "Alright, take care."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "715401918",
                                                                    "text": "I'll leave the patrolling to you."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715401912",
                                                    "text": "Baizhu's medicine is quite effective."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715401907",
                                    "text": "Ah, so you found out..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715401920",
                    "text": "See you.",
                    "response": [
                        {
                            "id": "715401921",
                            "speaker": "Xiao",
                            "text": "Take care."
                        }
                    ]
                }
            ]
        }
    ]
}