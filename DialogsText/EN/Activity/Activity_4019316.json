    "dialogues": [
        {
            "id": "401931601",
            "speaker": "Inagi Hotomi",
            "text": "#Hmm? Have you noticed this little youkai as well, {NICKNAME}?",
            "choices": [
                {
                    "id": "401931602",
                    "text": "This is a youkai too?",
                    "response": [
                        {
                            "id": "401931604",
                            "speaker": "Inagi Hotomi",
                            "text": "That's right, though it only seems to have become one very recently — it lacks the power and intelligence to speak just yet. Still, it appears to have been attracted by the festive atmosphere."
                        },
                        {
                            "id": "401931605",
                            "speaker": "???",
                            "text": "♪~"
                        },
                        {
                            "id": "401931606",
                            "speaker": "Inagi Hotomi",
                            "text": "Hmm? This little one... seems to want to see the Mikawa Flower Festival with you. If I'm not mistaken, it sees you as a powerful elder youkai.",
                            "choices": [
                                {
                                    "id": "401931607",
                                    "text": "Then let me do my duty as a \"representative\"...",
                                    "response": [
                                        {
                                            "id": "401931609",
                                            "speaker": "???",
                                            "text": "♪~♪~♪~"
                                        },
                                        {
                                            "id": "401931610",
                                            "speaker": "Player",
                                            "text": "And what might it mean this time?"
                                        },
                                        {
                                            "id": "401931611",
                                            "speaker": "Inagi Hotomi",
                                            "text": "Hmm. If I had to guess, it'd be... \"I'll be in your care!\""
                                        }
                                    ]
                                },
                                {
                                    "id": "401931608",
                                    "text": "And show my little \"junior\" the sights!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401931603",
                    "text": "Huh, and here I thought it was a street lamp..."
                }
            ]
        }
    ]
}