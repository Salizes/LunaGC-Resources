{
    "talkId": "7567409",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Nilou": 29,
        "Player": 10
    },
    "dialogues": [
        {
            "id": "756740901",
            "speaker": "Nilou",
            "text": "#You emanate joy today, {NICKNAME}. I'm happy for you.",
            "choices": [
                {
                    "id": "756740902",
                    "text": "I'm happy for you too. You seem to have made some great new friends.",
                    "response": [
                        {
                            "id": "756740903",
                            "speaker": "Nilou",
                            "text": "#Thank you, {NICKNAME}."
                        },
                        {
                            "id": "756740904",
                            "speaker": "Nilou",
                            "text": "This time around, I've stayed in Natlan for more than half a month."
                        },
                        {
                            "id": "756740905",
                            "speaker": "Nilou",
                            "text": "Previously, it was my first time experiencing life outside Sumeru. I'd never even traveled very far at that time."
                        },
                        {
                            "id": "756740906",
                            "speaker": "Nilou",
                            "text": "And here at the Easybreeze Holiday Resort, I've experienced something quite different from my time with the People of the Springs."
                        },
                        {
                            "id": "756740907",
                            "speaker": "Nilou",
                            "text": "Natlan really is amazing. Each of the six tribes has its own musical styles..."
                        },
                        {
                            "id": "756740908",
                            "speaker": "Nilou",
                            "text": "When Kachina took me on a tour of the Children of Echoes, I got to see their unique dance battles."
                        },
                        {
                            "id": "756740909",
                            "speaker": "Nilou",
                            "text": "Some of their moves are really impressive, like the one where they push off the ground with one hand and lift their body into the air..."
                        },
                        {
                            "id": "756740910",
                            "speaker": "Nilou",
                            "text": "...Or the one where they lie on their stomachs or backs and begin to spin rapidly."
                        },
                        {
                            "id": "756740911",
                            "speaker": "Nilou",
                            "text": "I never knew \"strength\" could be expressed through dance like that.",
                            "choices": [
                                {
                                    "id": "756740912",
                                    "text": "Everyone's got their specialties.",
                                    "response": [
                                        {
                                            "id": "756740914",
                                            "speaker": "Nilou",
                                            "text": "Yes. I couldn't imagine what it would be like to do that dance for myself..."
                                        },
                                        {
                                            "id": "756740915",
                                            "speaker": "Nilou",
                                            "text": "Of course, it's probably not wise to force yourself to learn everything, but we can be open to new things, like Mualani."
                                        },
                                        {
                                            "id": "756740916",
                                            "speaker": "Nilou",
                                            "text": "One's art must constantly seek nourishment to grow into something lovelier. Isn't that so?"
                                        },
                                        {
                                            "id": "756740917",
                                            "speaker": "Nilou",
                                            "text": "On that note, I think I've learned a thing or two thanks to Deaconess Barbara from Mondstadt as well.",
                                            "choices": [
                                                {
                                                    "id": "756740918",
                                                    "text": "From Barbara?",
                                                    "response": [
                                                        {
                                                            "id": "756740920",
                                                            "speaker": "Nilou",
                                                            "text": "About the \"energy\" in dance."
                                                        },
                                                        {
                                                            "id": "756740921",
                                                            "speaker": "Nilou",
                                                            "text": "As you know, dancing was not supported in Sumeru in the past."
                                                        },
                                                        {
                                                            "id": "756740922",
                                                            "speaker": "Nilou",
                                                            "text": "This restriction has long since been lifted, but old habits die hard, you know?"
                                                        },
                                                        {
                                                            "id": "756740923",
                                                            "speaker": "Nilou",
                                                            "text": "As such, our songs and dances continue to prize wisdom, elegance, and beauty, incorporating no exaggerated movements."
                                                        },
                                                        {
                                                            "id": "756740924",
                                                            "speaker": "Nilou",
                                                            "text": "Dehya says that this is what they call \"cultural inertia.\" It's all a bit profound for me, though.",
                                                            "choices": [
                                                                {
                                                                    "id": "756740925",
                                                                    "text": "It takes years for perspectives to shift.",
                                                                    "response": [
                                                                        {
                                                                            "id": "756740927",
                                                                            "speaker": "Nilou",
                                                                            "text": "I see... So that's how it is."
                                                                        },
                                                                        {
                                                                            "id": "756740928",
                                                                            "speaker": "Nilou",
                                                                            "text": "By contrast, Barbara seems much freer when she dances..."
                                                                        },
                                                                        {
                                                                            "id": "756740929",
                                                                            "speaker": "Nilou",
                                                                            "text": "...It's very cute, I'd say."
                                                                        },
                                                                        {
                                                                            "id": "756740930",
                                                                            "speaker": "Nilou",
                                                                            "text": "But — and I do think it's a shame that this happens — she seems a bit too polite when talking to me."
                                                                        },
                                                                        {
                                                                            "id": "756740931",
                                                                            "speaker": "Nilou",
                                                                            "text": "Hmm, that's not quite right. Would \"reserved\" be a better way to put it?"
                                                                        },
                                                                        {
                                                                            "id": "756740932",
                                                                            "speaker": "Nilou",
                                                                            "text": "Is it because of her position? Or is there something else?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "756740933",
                                                                                    "text": "You're meeting for the first time, so maybe she isn't sure how to proceed.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "756740935",
                                                                                            "speaker": "Nilou",
                                                                                            "text": "...Is that so?"
                                                                                        },
                                                                                        {
                                                                                            "id": "756740936",
                                                                                            "speaker": "Nilou",
                                                                                            "text": "Don't worry, I'll wait for her to be ready."
                                                                                        },
                                                                                        {
                                                                                            "id": "756740937",
                                                                                            "speaker": "Nilou",
                                                                                            "text": "I'd love to be friends with her, just like I am with Mualani."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "756740934",
                                                                                    "text": "Sometimes you've just got to take it slow."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756740926",
                                                                    "text": "Widespread change takes more time."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756740919",
                                                    "text": "What did you learn?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756740913",
                                    "text": "I mean, that's a whole different breed of dance there."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740938",
                    "text": "Let's keep dancing, and keep the good times rolling!",
                    "response": [
                        {
                            "id": "756740939",
                            "speaker": "Nilou",
                            "text": "That's right! Let's recharge our spirits with this joyful music."
                        }
                    ]
                }
            ]
        }
    ]
}