    },
    "dialogues": [
        {
            "id": "400770601",
            "speaker": "Kaedehara Kazuha",
            "text": "The sound of nature is so relaxing. There's nothing more to worry about...",
            "choices": [
                {
                    "id": "400770602",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400770603",
                            "speaker": "Kaedehara Kazuha",
                            "text": "Sure. What's on your mind?",
                            "choices": [
                                {
                                    "id": "400770606",
                                    "text": "About drinking...",
                                    "response": [
                                        {
                                            "id": "400770607",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Ahem..."
                                        },
                                        {
                                            "id": "400770608",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "That was days ago. I'm surprised you still remember..."
                                        },
                                        {
                                            "id": "400770609",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Fine drinks belong in the same space as poetry and elegance. To lose myself like that in the tavern... it was truly humiliating."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770610",
                                    "text": "About your past...",
                                    "response": [
                                        {
                                            "id": "400770611",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Right, about that. After these events, I suppose I've bid a formal farewell to my past."
                                        },
                                        {
                                            "id": "400770612",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Don't worry, I feel just as fine as I did during the times before. I am burdened by neither grief nor regret."
                                        },
                                        {
                                            "id": "400770613",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "I appreciate these twists of fate from the bottom of my heart."
                                        },
                                        {
                                            "id": "400770614",
                                            "speaker": "Player",
                                            "text": "You're always so chill..."
                                        },
                                        {
                                            "id": "400770615",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Thank you. Can I take it as a compliment?"
                                        },
                                        {
                                            "id": "400770616",
                                            "speaker": "Player",
                                            "text": "Certainly."
                                        },
                                        {
                                            "id": "400770617",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "I'm so happy to have a friend like you."
                                        },
                                        {
                                            "id": "400770618",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Let's shift our focus back to the scenery in front of us and take a good look at the clouds and waves before we leave."
                                        }
                                    ]
                                },
                                {
                                    "id": "400770619",
                                    "text": "About this vacation...",
                                    "response": [
                                        {
                                            "id": "400770620",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "It's had its ups and downs, but ultimately, it's been quite rewarding."
                                        },
                                        {
                                            "id": "400770621",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "If Beidou and the crew ask me about our experiences, I suppose I'll tell them about the squirrel and the ship spirit... as for stories about my new friends, I'll keep them to myself."
                                        },
                                        {
                                            "id": "400770622",
                                            "speaker": "Player",
                                            "text": "That's good."
                                        },
                                        {
                                            "id": "400770623",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "#The end of every journey marks the beginning of a new adventure. I'm sure this is a feeling you are most familiar with, {NICKNAME}."
                                        },
                                        {
                                            "id": "400770624",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "...Keep moving forwards. That's the important thing."
                                        },
                                        {
                                            "id": "400770625",
                                            "speaker": "Kaedehara Kazuha",
                                            "text": "Just like you, I have a lot of hope for the future."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770604",
                    "text": "I won't disturb you.",
                    "response": [
                        {
                            "id": "400770605",
                            "speaker": "Kaedehara Kazuha",
                            "text": "You must be tired from the past few days. Take a well-deserved rest.",
                            "choices": [
                                {
                                    "id": "400770606",
                                    "text": "About drinking..."
                                },
                                {
                                    "id": "400770610",
                                    "text": "About your past..."
                                },
                                {
                                    "id": "400770619",
                                    "text": "About this vacation..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}