{
    "groupId": "9125",
    "total_dialogue_lines": 98,
    "speaker_counts": {
        "Columbina": 61,
        "Player": 37
    },
    "talks": [
        {
            "talkId": "6912501",
            "initDialog": "691250101",
            "dialogues": [
                {
                    "id": "691250101",
                    "speaker": "Columbina",
                    "text": "Hello."
                },
                {
                    "id": "691250102",
                    "speaker": "Columbina",
                    "text": "This is your garden, so it is my turn to greet you first."
                }
            ]
        },
        {
            "talkId": "6912502",
            "initDialog": "691250201",
            "dialogues": [
                {
                    "id": "691250201",
                    "speaker": "Player",
                    "text": "Are you settling in okay?"
                },
                {
                    "id": "691250202",
                    "speaker": "Columbina",
                    "text": "Hmm... Not really."
                },
                {
                    "id": "691250203",
                    "speaker": "Player",
                    "text": "Oh... Is it too noisy here?"
                },
                {
                    "id": "691250204",
                    "speaker": "Columbina",
                    "text": "No, that's not the issue."
                },
                {
                    "id": "691250205",
                    "speaker": "Columbina",
                    "text": "It's just... you've been my guest so often up till now. Now that I am suddenly the guest, I find myself unused to it."
                },
                {
                    "id": "691250206",
                    "speaker": "Columbina",
                    "text": "What should I do? Chat with you? Or perhaps play games together?",
                    "choices": [
                        {
                            "id": "691250207",
                            "text": "Just think of this place as your \"home\"...",
                            "response": [
                                {
                                    "id": "691250209",
                                    "speaker": "Columbina",
                                    "text": "Really? Hmm... In that case, can I stroll about, singing as I do?"
                                },
                                {
                                    "id": "691250210",
                                    "speaker": "Player",
                                    "text": "Of course you can."
                                },
                                {
                                    "id": "691250211",
                                    "speaker": "Columbina",
                                    "text": "Can I take a nap anywhere I choose, should I wish to rest?"
                                },
                                {
                                    "id": "691250212",
                                    "speaker": "Player",
                                    "text": "Holler if you need a pillow."
                                },
                                {
                                    "id": "691250213",
                                    "speaker": "Columbina",
                                    "text": "And would it be all right to pick some of the plants you've planted? You know, as you sometimes do with Moonfall Silver at Silvermoon Hall?",
                                    "choices": [
                                        {
                                            "id": "691250214",
                                            "text": "So you knew the whole time...",
                                            "response": [
                                                {
                                                    "id": "691250216",
                                                    "speaker": "Columbina",
                                                    "text": "Haha, only a jest. So long as they will help you on your journey, I would never object."
                                                },
                                                {
                                                    "id": "691250217",
                                                    "speaker": "Columbina",
                                                    "text": "You've created a very pleasant environment here. I'm already satisfied to just enjoy it in peace."
                                                },
                                                {
                                                    "id": "691250218",
                                                    "speaker": "Columbina",
                                                    "text": "I wonder... should I try decorating Silvermoon Hall as well?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691250215",
                                            "text": "So, you've been holding a grudge..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691250208",
                            "text": "Do what you feel like doing."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912503",
            "initDialog": "691250301",
            "dialogues": [
                {
                    "id": "691250301",
                    "speaker": "Player",
                    "text": "Would you like to chat?"
                },
                {
                    "id": "691250302",
                    "speaker": "Columbina",
                    "text": "Sure. I might need you to start us off, though. I don't usually chat with others."
                },
                {
                    "id": "691250303",
                    "speaker": "Columbina",
                    "text": "Even when I was with the Fatui, I mostly sat in a corner during meetings and refrained from participating in debates."
                },
                {
                    "id": "691250304",
                    "speaker": "Columbina",
                    "text": "Most of the topics were boring anyway. Someone wants this, or to fight for that... And nobody would give an inch."
                },
                {
                    "id": "691250305",
                    "speaker": "Player",
                    "text": "(Guess she started off the conversation just fine...)"
                },
                {
                    "id": "691250306",
                    "speaker": "Columbina",
                    "text": "More vexing was how they would sometimes seek out my opinion."
                },
                {
                    "id": "691250307",
                    "speaker": "Columbina",
                    "text": "My eyes were always closed, and so they assumed that I was listening in silence. In truth, most of the time I was either sleeping, or simply not thinking about anything at all."
                },
                {
                    "id": "691250308",
                    "speaker": "Columbina",
                    "text": "But responding was not an issue. At times like those, I would pick one of the questioners and indicate that they were right. That always did the trick."
                },
                {
                    "id": "691250309",
                    "speaker": "Columbina",
                    "text": "If Regrator or The Rooster were arguing, I'd side with the latter. And if The Doctor and Arlecchino were locked in a debate, I'd pick Arlecchino."
                },
                {
                    "id": "691250310",
                    "speaker": "Columbina",
                    "text": "The Captain was always in the right, and while Sandrone could be quite stubborn, she was generally right as well."
                },
                {
                    "id": "691250311",
                    "speaker": "Columbina",
                    "text": "And if The Captain and Sandrone were to ask me at the same time? Hmm... That was quite rare. And were it to actually happen... I'd say that both sides had a point."
                },
                {
                    "id": "691250312",
                    "speaker": "Columbina",
                    "text": "They're both very independent-minded. My opinions would not alter their judgment."
                },
                {
                    "id": "691250313",
                    "speaker": "Columbina",
                    "text": "...Eh? What did you want to talk to me about again...?",
                    "choices": [
                        {
                            "id": "691250314",
                            "text": "Oh, don't worry. We're doing great.",
                            "response": [
                                {
                                    "id": "691250316",
                                    "speaker": "Columbina",
                                    "text": "Is that so? Well, I'm glad you're enjoying yourself."
                                },
                                {
                                    "id": "691250317",
                                    "speaker": "Columbina",
                                    "text": "In truth, I prefer speaking with kuuhenki rather than humans."
                                },
                                {
                                    "id": "691250318",
                                    "speaker": "Columbina",
                                    "text": "Their thinking is pure and simple, and they do not hide their thoughts."
                                },
                                {
                                    "id": "691250319",
                                    "speaker": "Columbina",
                                    "text": "\"Let's play,\" \"Tell me a story,\" \"I want to sleep,\" \"There's something nice over there\"..."
                                },
                                {
                                    "id": "691250320",
                                    "speaker": "Columbina",
                                    "text": "Seen through their eyes, the world is simple and beautiful."
                                }
                            ]
                        },
                        {
                            "id": "691250315",
                            "text": "You're an excellent storyteller, too..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912504",
            "initDialog": "691250401",
            "dialogues": [
                {
                    "id": "691250401",
                    "speaker": "Player",
                    "text": "Anything you'd like to do?"
                },
                {
                    "id": "691250402",
                    "speaker": "Columbina",
                    "text": "Um... I'm already here as your guest. Would it really be appropriate to have you fulfill my requests as well?",
                    "choices": [
                        {
                            "id": "691250403",
                            "text": "It's fine.",
                            "response": [
                                {
                                    "id": "691250405",
                                    "speaker": "Columbina",
                                    "text": "Very well then. In truth, I do have something I need help with."
                                },
                                {
                                    "id": "691250406",
                                    "speaker": "Player",
                                    "text": "I'm all ears."
                                },
                                {
                                    "id": "691250407",
                                    "speaker": "Columbina",
                                    "text": "Lauma said that she would introduce me to the Frostmoon Scions of today, in the hope that I might integrate into this family."
                                },
                                {
                                    "id": "691250408",
                                    "speaker": "Columbina",
                                    "text": "I'm glad she said so, but... also a little worried."
                                },
                                {
                                    "id": "691250409",
                                    "speaker": "Player",
                                    "text": "What are you worried about?"
                                },
                                {
                                    "id": "691250410",
                                    "speaker": "Columbina",
                                    "text": "I rarely interact much with strangers, so I worry that I may not be capable of keeping up the conversation. I do not wish to make them feel uncomfortable."
                                },
                                {
                                    "id": "691250411",
                                    "speaker": "Columbina",
                                    "text": "Could you help me... rehearse? Or rather, simulate situations I might encounter."
                                },
                                {
                                    "id": "691250412",
                                    "speaker": "Player",
                                    "text": "What do I need to do, precisely?"
                                },
                                {
                                    "id": "691250413",
                                    "speaker": "Columbina",
                                    "text": "It's simple. Ask me questions that the Scions might ask, and I will answer. If my reply is inappropriate, let me know.",
                                    "choices": [
                                        {
                                            "id": "691250414",
                                            "text": "Honestly, all you need to do is be yourself...",
                                            "response": [
                                                {
                                                    "id": "691250415",
                                                    "speaker": "Columbina",
                                                    "text": "I know. But this is a rare opportunity, and I wish to get along better with them, so..."
                                                },
                                                {
                                                    "id": "691250417",
                                                    "speaker": "Columbina",
                                                    "text": "Then let's begin."
                                                },
                                                {
                                                    "id": "691250418",
                                                    "speaker": "Player",
                                                    "text": "Will you leave us again, Lady Moon Goddess?"
                                                },
                                                {
                                                    "id": "691250419",
                                                    "speaker": "Columbina",
                                                    "text": "I will.",
                                                    "choices": [
                                                        {
                                                            "id": "691250420",
                                                            "text": "...Come again?",
                                                            "response": [
                                                                {
                                                                    "id": "691250422",
                                                                    "speaker": "Columbina",
                                                                    "text": "Hmm? I'll travel, won't I? That means I'll leave.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "691250423",
                                                                            "text": "You need to be clear when it comes to things like this...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "691250425",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Oh. I see. I will be clear.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "691250426",
                                                                                            "text": "And just in case...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "691250428",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Sure."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250429",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Might you bless my marriage proposal, that it be accepted?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250430",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "No."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250431",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Can you bless my child so that they might grow taller?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250432",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "If your child happens to be a Rimehorn Deer..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250433",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "In cases like these, you can just say no as well."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250434",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Very well. No."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250435",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Are there any guests you'd like to invite to visit us?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250436",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Sandrone of the Fatui, and Arlecchino, too. They are quite curious as to my life here."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250437",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Err, that might not go over too well..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250438",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Huh...? They mustn't see? Would they not approve?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250439",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "I'm saying it wouldn't go over well with the Frostmoon Scions..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250440",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "I see. In that case, I'd like to invite Maalaus, Mr. Albedo, and Miss Nicole."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250441",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Maalaus and Mr. Albedo are talented artists, while Miss Nicole is a gifted writer. I'd like them to chronicle the happy lives that the Frostmoon Scions lead today."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250442",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "An excellent notion."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250443",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Yes, and as for Sandrone and Arlecchino, I shall sneak them in when the opportunity presents itself."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250444",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Now that... is something you can't say."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250445",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Yes. And I will not."
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250446",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "Hmm... My answers are not yet good enough, are they?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "691250447",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "We should practice more if we have the chance."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "691250427",
                                                                                            "text": "Let me ask a few questions about tradition..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "691250424",
                                                                            "text": "That's not the sort of \"leave\" they'd be asking about..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691250421",
                                                            "text": "Y—You will...?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691250416",
                                            "text": "I understand."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691250404",
                            "text": "This is how I show hospitality to my guests."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912505",
            "initDialog": "691250501",
            "dialogues": [
                {
                    "id": "691250501",
                    "speaker": "Player",
                    "text": "Good morning, Columbina."
                },
                {
                    "id": "691250502",
                    "speaker": "Columbina",
                    "text": "Good morning. May you find success in your journey today."
                },
                {
                    "id": "691250503",
                    "speaker": "Columbina",
                    "text": "Though the moon has now hidden, this blessing will stay with you on my behalf."
                }
            ]
        },
        {
            "talkId": "6912506",
            "initDialog": "691250601",
            "dialogues": [
                {
                    "id": "691250601",
                    "speaker": "Player",
                    "text": "Good night, Columbina."
                },
                {
                    "id": "691250602",
                    "speaker": "Columbina",
                    "text": "Good night. I'll do my best not to sing while you are asleep."
                }
            ]
        },
        {
            "talkId": "6912510",
            "initDialog": "691251001",
            "dialogues": [
                {
                    "id": "691251001",
                    "speaker": "Columbina",
                    "text": "Did you transport Silvermoon Hall all the way here for me?"
                },
                {
                    "id": "691251002",
                    "speaker": "Columbina",
                    "text": "Hmm, no. Is it like a reflection in the water? How lovely. This brings back so many beautiful memories."
                },
                {
                    "id": "691251003",
                    "speaker": "Columbina",
                    "text": "I suppose we're just missing my song now."
                }
            ]
        },
        {
            "talkId": "6912511",
            "initDialog": "691251101",
            "dialogues": [
                {
                    "id": "691251101",
                    "speaker": "Columbina",
                    "text": "Oh, you even have these. These drums are the kuuhenki's favorite instruments."
                },
                {
                    "id": "691251102",
                    "speaker": "Columbina",
                    "text": "I used to worry that they would get carried away and hurt themselves, but — as though to loudly drum away my concerns — they played even harder."
                },
                {
                    "id": "691251103",
                    "speaker": "Columbina",
                    "text": "Can you teach me how to make them? I'm sure those children would be happy to receive one as a gift."
                }
            ]
        }
    ]
}