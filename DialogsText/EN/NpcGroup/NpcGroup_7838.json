            "dialogues": [
                {
                    "id": "678380501",
                    "speaker": "Player",
                    "text": "Oh? What kind of place is that?"
                },
                {
                    "id": "678380502",
                    "speaker": "Efremova",
                    "text": "I don't know. I haven't been back in a long time. The House of Hesperides without Larisa..."
                },
                {
                    "id": "678380503",
                    "speaker": "Efremova",
                    "text": "Back then, I didn't like its new master, the Snegovik who called herself the owner."
                },
                {
                    "id": "678380504",
                    "speaker": "Efremova",
                    "text": "But beyond that place... I've grown tired of the outside world. Now I just want to go back."
