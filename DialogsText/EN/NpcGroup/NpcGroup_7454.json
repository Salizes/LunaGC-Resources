                {
                    "id": "674540201",
                    "speaker": "Player",
                    "text": "Hello?"
                },
                {
                    "id": "674540202",
                    "speaker": "Yermolay",
                    "text": "...My apologies. I'm on duty, stranger, and I cannot answer your questions. If you require assistance, you may seek out Avreliya."
                },
                {
                    "id": "674540203",
                    "speaker": "Yermolay",
                    "text": "Lady Shakhovskaya transferred me here precisely so that I might uphold the old rites of courtesy. Even in front of a fae lord, I would not commit the slightest breach of etiquette."
                }
            ]
        },
        {
            "talkId": "6745403",
            "initDialog": "674540301",
            "dialogues": [
                {
                    "id": "674540301",
                    "speaker": "Player",
                    "text": "I'll leave you to your watch, then."
                },
                {
                    "id": "674540302",
                    "speaker": "Yermolay",
