    "talks": [
        {
            "talkId": "6242101",
            "initDialog": "624210101",
            "dialogues": [
                {
                    "id": "624210101",
                    "speaker": "Bao'er",
                    "text": "Hello, traveler. Are you here to pay homage to history?"
                }
            ]
        },
        {
            "talkId": "6242102",
            "initDialog": "624210201",
            "dialogues": [
                {
                    "id": "624210201",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "624210202",
                    "speaker": "Bao'er",
                    "text": "Trying to follow a trail of breadcrumbs, it feels like... Or, conducting an archaeological investigation, in technical terms.",
                    "choices": [
                        {
                            "id": "624210203",
                            "text": "Breadcrumbs? I am a bit peckish...",
                            "response": [
                                {
                                    "id": "624210204",
                                    "speaker": "Bao'er",
                                    "text": "...Sorry if I wasn't clear. I'm an archaeologist; I'm researching the historical architecture and relics of the Guili Plains."
                                }
                            ]
                        },
                        {
                            "id": "624210205",
                            "text": "You're an archaeologist?",
                            "response": [
                                {
                                    "id": "624210206",
                                    "speaker": "Bao'er",
                                    "text": "Yes. We are standing right now on the battlefield where the Archon War took place all those thousands of years ago."
                                },
                                {
                                    "id": "624210207",
                                    "speaker": "Bao'er",
                                    "text": "In other words, where the Geo Lord fought a bloody battle and secured a decisive and unequivocal victory against his enemies."
                                },
                                {
                                    "id": "624210208",
                                    "speaker": "Bao'er",
                                    "text": "There must be countless artifacts waiting to be unearthed beneath our very feet."
                                },
                                {
                                    "id": "624210209",
                                    "speaker": "Bao'er",
                                    "text": "I do long to know what treasures are buried here..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242103",
            "initDialog": "624210301",
            "dialogues": [
                {
                    "id": "624210301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "624210302",
                    "speaker": "Bao'er",
                    "text": "Fare thee well!"
                }
            ]
        }
    ]
}