{
    "groupId": "9026",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 18,
        "Xiao": 48
    },
    "talks": [
        {
            "talkId": "6902601",
            "initDialog": "690260101",
            "dialogues": [
                {
                    "id": "690260101",
                    "speaker": "Xiao",
                    "text": "#...It's you, {NICKNAME}."
                },
                {
                    "id": "690260102",
                    "speaker": "Xiao",
                    "text": "Did something happen?"
                }
            ]
        },
        {
            "talkId": "6902602",
            "initDialog": "690260201",
            "dialogues": [
                {
                    "id": "690260201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                },
                {
                    "id": "690260202",
                    "speaker": "Xiao",
                    "text": "..."
                },
                {
                    "id": "690260203",
                    "speaker": "Xiao",
                    "text": "There are no ominous things here. It's a quiet place."
                },
                {
                    "id": "690260204",
                    "speaker": "Xiao",
                    "text": "But...",
                    "choices": [
                        {
                            "id": "690260205",
                            "text": "But?",
                            "response": [
                                {
                                    "id": "690260206",
                                    "speaker": "Xiao",
                                    "text": "It's too comfortable."
                                },
                                {
                                    "id": "690260209",
                                    "speaker": "Xiao",
                                    "text": "I will protect this haven. For your sake."
                                },
                                {
                                    "id": "690260210",
                                    "speaker": "Xiao",
                                    "text": "I know that I can never have a peaceful and carefree life."
                                },
                                {
                                    "id": "690260211",
                                    "speaker": "Xiao",
                                    "text": "...Still, your kindness is accepted."
                                }
                            ]
                        },
                        {
                            "id": "690260207",
                            "text": "Not used to it?",
                            "response": [
                                {
                                    "id": "690260208",
                                    "speaker": "Xiao",
                                    "text": "...Yes."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902603",
            "initDialog": "690260301",
            "dialogues": [
                {
                    "id": "690260301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Want to chat?</color>"
                },
                {
                    "id": "690260302",
                    "speaker": "Xiao",
                    "text": "...Idle chatter?"
                },
                {
                    "id": "690260303",
                    "speaker": "Xiao",
                    "text": "...If you wish, I'll accompany you.",
                    "choices": [
                        {
                            "id": "690260304",
                            "text": "I thought you'd refuse.",
                            "response": [
                                {
                                    "id": "690260305",
                                    "speaker": "Xiao",
                                    "text": "Hm?"
                                },
                                {
                                    "id": "690260306",
                                    "speaker": "Xiao",
                                    "text": "To make a request but prepare yourself for rejection..."
                                },
                                {
                                    "id": "690260307",
                                    "speaker": "Xiao",
                                    "text": "Human interaction really is troublesome."
                                },
                                {
                                    "id": "690260311",
                                    "speaker": "Xiao",
                                    "text": "Generally, I don't partake in activities like \"chatting.\""
                                },
                                {
                                    "id": "690260312",
                                    "speaker": "Xiao",
                                    "text": "But if it's with you... I'll try."
                                },
                                {
                                    "id": "690260313",
                                    "speaker": "Player",
                                    "text": "How have you been?"
                                },
                                {
                                    "id": "690260314",
                                    "speaker": "Xiao",
                                    "text": "Are you asking about the effects of my karmic debt?"
                                },
                                {
                                    "id": "690260315",
                                    "speaker": "Xiao",
                                    "text": "...No issues."
                                },
                                {
                                    "id": "690260316",
                                    "speaker": "Xiao",
                                    "text": "It is of my own doing, so I alone will bear the consequences."
                                },
                                {
                                    "id": "690260317",
                                    "speaker": "Xiao",
                                    "text": "...I don't know if it's related to you, but recently, the pain from my karmic debt has been less excruciating."
                                },
                                {
                                    "id": "690260318",
                                    "speaker": "Xiao",
                                    "text": "It's much easier to bear than before."
                                },
                                {
                                    "id": "690260319",
                                    "speaker": "Xiao",
                                    "text": "As for any excess concerns... Best to leave that for yourself."
                                }
                            ]
                        },
                        {
                            "id": "690260308",
                            "text": "You seem a bit reluctant.",
                            "response": [
                                {
                                    "id": "690260309",
                                    "speaker": "Xiao",
                                    "text": "That's not it."
                                },
                                {
                                    "id": "690260310",
                                    "speaker": "Xiao",
                                    "text": "I didn't expect you to make such a request."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902604",
            "initDialog": "690260401",
            "dialogues": [
                {
                    "id": "690260401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
                },
                {
                    "id": "690260402",
                    "speaker": "Xiao",
                    "text": "If you have free time, we can go to Liyue Harbor together..."
                },
                {
                    "id": "690260403",
                    "speaker": "Xiao",
                    "text": "If not... never mind.",
                    "choices": [
                        {
                            "id": "690260404",
                            "text": "Of course we can.",
                            "response": [
                                {
                                    "id": "690260405",
                                    "speaker": "Xiao",
                                    "text": "Uh... alright."
                                },
                                {
                                    "id": "690260408",
                                    "speaker": "Xiao",
                                    "text": "I have no intention of getting close to the lives of mortals."
                                },
                                {
                                    "id": "690260409",
                                    "speaker": "Xiao",
                                    "text": "But I know that you often enter and leave the city, walking amidst the crowd."
                                },
                                {
                                    "id": "690260410",
                                    "speaker": "Xiao",
                                    "text": "The stories of these times, or their joys... If I don't experience such things myself, it'll be hard to understand your thoughts."
                                },
                                {
                                    "id": "690260411",
                                    "speaker": "Player",
                                    "text": "So... you're doing this for me?"
                                },
                                {
                                    "id": "690260412",
                                    "speaker": "Xiao",
                                    "text": "Yes, to understand you."
                                },
                                {
                                    "id": "690260413",
                                    "speaker": "Xiao",
                                    "text": "I had a feeling that it would be difficult, but after having such thoughts, I can't simply sit back and do nothing."
                                },
                                {
                                    "id": "690260414",
                                    "speaker": "Xiao",
                                    "text": "I will control myself while I am in the city."
                                },
                                {
                                    "id": "690260415",
                                    "speaker": "Xiao",
                                    "text": "I'll try to speak... as little as possible.",
                                    "choices": [
                                        {
                                            "id": "690260416",
                                            "text": "I'll be with you.",
                                            "response": [
                                                {
                                                    "id": "690260418",
                                                    "speaker": "Xiao",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690260419",
                                                    "speaker": "Xiao",
                                                    "text": "Let me know when you're ready to go."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690260417",
                                            "text": "You can say whatever you want. I'll bail you out."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690260406",
                            "text": "Finally decided to integrate into city life?",
                            "response": [
                                {
                                    "id": "690260407",
                                    "speaker": "Xiao",
                                    "text": "Ahem..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902605",
            "initDialog": "690260501",
            "dialogues": [
                {
                    "id": "690260501",
                    "speaker": "Player",
                    "text": "Good morning, Xiao."
                },
                {
                    "id": "690260502",
                    "speaker": "Xiao",
                    "text": "...Morning."
                },
                {
                    "id": "690260503",
                    "speaker": "Xiao",
                    "text": "If you encounter a difficult situation, don't be stubborn. Call my name. I will make it right."
                }
            ]
        },
        {
            "talkId": "6902606",
            "initDialog": "690260601",
            "dialogues": [
                {
                    "id": "690260601",
                    "speaker": "Player",
                    "text": "Good night, Xiao."
                },
                {
                    "id": "690260602",
                    "speaker": "Xiao",
                    "text": "Today..."
                },
                {
                    "id": "690260603",
                    "speaker": "Xiao",
                    "text": "...Forget it, it's nothing. Good night."
                }
            ]
        },
        {
            "talkId": "6902607",
            "initDialog": "690260701",
            "dialogues": [
                {
                    "id": "690260701",
                    "speaker": "Player",
                    "text": "Want to chat?"
                }
            ]
        },
        {
            "talkId": "6902608",
            "initDialog": "690260801",
            "dialogues": [
                {
                    "id": "690260801",
                    "speaker": "Player",
                    "text": "Is there anything you'd like to do?"
                }
            ]
        },
        {
            "talkId": "6902609",
            "initDialog": "690260901",
            "dialogues": [
                {
                    "id": "690260901",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                }
            ]
        },
        {
            "talkId": "6902650",
            "initDialog": "690265001",
            "dialogues": [
                {
                    "id": "690265001",
                    "speaker": "Xiao",
                    "text": "Short and squat wooden houses, sparsely scattered... Sometimes, a village like this can be easier to guard than a city."
                },
                {
                    "id": "690265002",
                    "speaker": "Xiao",
                    "text": "When hunting demons, I just want bystanders out of the area, so I can focus on fighting."
                },
                {
                    "id": "690265003",
                    "speaker": "Xiao",
                    "text": "...So this is what human construction looks like up close."
                }
            ]
        },
        {
            "talkId": "6902651",
            "initDialog": "690265101",
            "dialogues": [
                {
                    "id": "690265101",
                    "speaker": "Xiao",
                    "text": "The kitchen here is furnished just like Wangshu Inn's."
                },
                {
                    "id": "690265102",
                    "speaker": "Xiao",
                    "text": "Looking at the ingredients here... could you recreate that dish I'm familiar with? I assume you know the one..."
                },
                {
                    "id": "690265103",
                    "speaker": "Xiao",
                    "text": "...It's just an idle thought... I'm not expecting anything."
                }
            ]
        }
    ]
}