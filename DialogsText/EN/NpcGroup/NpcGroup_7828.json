    "talks": [
        {
            "talkId": "6782801",
            "initDialog": "678280101",
            "dialogues": [
                {
                    "id": "678280101",
                    "speaker": "Akhmatova",
                    "text": "What they call the \"Shadow Realm\" is in truth nothing more than a dark mirror held up to our everyday existence... Hmm. That actually sounds pretty good. I should write it down."
                }
            ]
        },
        {
            "talkId": "6782802",
            "initDialog": "678280201",
            "dialogues": [
                {
                    "id": "678280201",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "678280202",
                    "speaker": "Akhmatova",
                    "text": "An ordinary person who lives, who labors, and who sometimes writes poetry as well."
                },
                {
                    "id": "678280203",
                    "speaker": "Akhmatova",
                    "text": "While I wander from place to place without a place to rest my weary feet for now, that's just how life is — it's nothing more than a journey."
                }
            ]
        },
        {
            "talkId": "6782803",
            "initDialog": "678280301",
            "dialogues": [
                {
                    "id": "678280301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "678280302",
                    "speaker": "Akhmatova",
                    "text": "Goodbye, Traveler."
                }
            ]
        }
    ]
}