{
    "groupId": "15888",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "???": 1,
        "Cat in a Box": 2,
        "Flying Squirrel Fairy": 4,
        "Giraffe King": 3,
        "Narrator": 2,
        "Paimon": 13,
        "Player": 7,
        "Stray Cat": 8
    },
    "talks": [
        {
            "talkId": "1600225",
            "initDialog": "160022501",
            "dialogues": [
                {
                    "id": "160022501",
                    "speaker": "Narrator",
                    "text": "The story's witnesses arrived at a hidden nook tucked inside the towering walls, a place tied to one of the little dragon's most cherished memories."
                },
                {
                    "id": "160022502",
                    "speaker": "Narrator",
                    "text": "Within those memories lived the friends he made in the castle."
                },
                {
                    "id": "160022503",
                    "speaker": "Paimon",
                    "text": "Hey, you're all still here! Guess that's proof that Durin's friends from Simulanka really do hold a special place in his heart..."
                },
                {
                    "id": "160022504",
                    "speaker": "Flying Squirrel Fairy",
                    "text": "Hello again, golden-haired traveler and silver pixie. How fares the little dragon on his journey?",
                    "choices": [
                        {
                            "id": "160022505",
                            "text": "There's been some... complications.",
                            "response": [
                                {
                                    "id": "160022507",
                                    "speaker": "Flying Squirrel Fairy",
                                    "text": "What? But, I still remember him."
                                },
                                {
                                    "id": "160022508",
                                    "speaker": "Giraffe King",
                                    "text": "I haven't forgotten him either!"
                                },
                                {
                                    "id": "160022509",
                                    "speaker": "Cat in a Box",
                                    "text": "Neither has this cat in a box."
                                },
                                {
                                    "id": "160022510",
                                    "speaker": "Paimon",
                                    "text": "That's good news! At least Durin's friends still remember him. Okay, we'll just have to find a way to help everyone else remember him too."
                                },
                                {
                                    "id": "160022511",
                                    "speaker": "Paimon",
                                    "text": "Oh, wait, are we missing someone?"
                                },
                                {
                                    "id": "160022512",
                                    "speaker": "Giraffe King",
                                    "text": "Ah, you mean that stray cat? He doesn't want to see the little dragon... and he's been hiding from the rest of us too.",
                                    "choices": [
                                        {
                                            "id": "160022513",
                                            "text": "A stray cat?",
                                            "response": [
                                                {
                                                    "id": "160022515",
                                                    "speaker": "Paimon",
                                                    "text": "Seriously, what's his problem? He won't tell Durin what's bothering him in the real world, and now, he's hiding from him in the story world too..."
                                                },
                                                {
                                                    "id": "160022516",
                                                    "speaker": "Flying Squirrel Fairy",
                                                    "text": "His hiding spot's over there, but he won't talk to us. Maybe you could try instead?"
                                                },
                                                {
                                                    "id": "160022517",
                                                    "speaker": "Player",
                                                    "text": "Leave it to us."
                                                },
                                                {
                                                    "id": "160022518",
                                                    "speaker": "Paimon",
                                                    "text": "Hey, Mr. Wandering Tom! How come you're hiding from the little dragon?"
                                                },
                                                {
                                                    "id": "160022519",
                                                    "speaker": "???",
                                                    "text": "You came all the way over here just to ask me that?"
                                                },
                                                {
                                                    "id": "160022520",
                                                    "speaker": "Paimon",
                                                    "text": "Hah, so you can talk!"
                                                },
                                                {
                                                    "id": "160022521",
                                                    "speaker": "Stray Cat",
                                                    "text": "You just said it yourself. A lot of people don't even remember him."
                                                },
                                                {
                                                    "id": "160022522",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah, so?"
                                                },
                                                {
                                                    "id": "160022523",
                                                    "speaker": "Stray Cat",
                                                    "text": "So don't let him get anywhere near me."
                                                },
                                                {
                                                    "id": "160022524",
                                                    "speaker": "Paimon",
                                                    "text": "What's that supposed to mean? Hey! Ugh, we're getting the silent treatment again..."
                                                },
                                                {
                                                    "id": "160022525",
                                                    "speaker": "Stray Cat",
                                                    "text": "Don't talk about other people behind their backs. Of course I remember him."
                                                },
                                                {
                                                    "id": "160022526",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa! You can't just sneak up on people like that!"
                                                },
                                                {
                                                    "id": "160022527",
                                                    "speaker": "Stray Cat",
                                                    "text": "Hmph..."
                                                },
                                                {
                                                    "id": "160022528",
                                                    "speaker": "Paimon",
                                                    "text": "Pfft, gotta say, though... This is quite the look for you."
                                                },
                                                {
                                                    "id": "160022529",
                                                    "speaker": "Stray Cat",
                                                    "text": "You can think whatever you want, but this is what I've always looked like."
                                                },
                                                {
                                                    "id": "160022530",
                                                    "speaker": "Paimon",
                                                    "text": "Huh, and no angry comeback? That's a first...",
                                                    "choices": [
                                                        {
                                                            "id": "160022531",
                                                            "text": "He's probably just a character from the story.",
                                                            "response": [
                                                                {
                                                                    "id": "160022533",
                                                                    "speaker": "Paimon",
                                                                    "text": "True... and come to think of it, when everyone made that wish for Durin before, you were the only one who wasn't there."
                                                                },
                                                                {
                                                                    "id": "160022534",
                                                                    "speaker": "Stray Cat",
                                                                    "text": "Pfft, and why would he need my help with a childish thing like that? If he ever runs into real trouble, he knows where to come looking."
                                                                },
                                                                {
                                                                    "id": "160022535",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmph... He might not be the real Hat Guy, but he's definitely \"in-character\"..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "160022532",
                                                            "text": "Not the real Hat Guy."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "160022514",
                                            "text": "Ahh... Must be that \"wandering\" tom."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "160022506",
                            "text": "Almost everyone seems to have forgotten who he is."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "1600228",
            "initDialog": "160022801",
            "dialogues": [
                {
                    "id": "160022801",
                    "speaker": "Flying Squirrel Fairy",
                    "text": "But... How could everyone just forget him like that? Does he need another blessing?"
                },
                {
                    "id": "160022802",
                    "speaker": "Giraffe King",
                    "text": "He was bound to face challenges in the world outside the castle. It would have been a pretty boring journey otherwise."
                },
                {
                    "id": "160022803",
                    "speaker": "Cat in a Box",
                    "text": "If you ask me, the less eventful a journey, the better..."
                },
                {
                    "id": "160022804",
                    "speaker": "Stray Cat",
                    "text": "..."
                },
                {
                    "id": "160022805",
                    "speaker": "Stray Cat",
                    "text": "If he ever runs into real trouble, he knows where to come looking."
                }
            ]
        }
    ]
}