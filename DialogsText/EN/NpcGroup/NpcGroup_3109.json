        },
        {
            "talkId": "6310902",
            "initDialog": "631090201",
            "dialogues": [
                {
                    "id": "631090201",
                    "speaker": "Player",
                    "text": "Who's \"he,\" if I might ask?"
                },
                {
                    "id": "631090202",
                    "speaker": "Kanra",
                    "text": "Ah, I'm talking about my lover. He is now serving as a soldier in Tatarasuna."
                },
                {
                    "id": "631090203",
                    "speaker": "Kanra",
                    "text": "I've written letters to him before, asking if he was doing well... But somehow none of these letters got a reply."
                },
                {
                    "id": "631090204",
                    "speaker": "Kanra",
                    "text": "I don't really have any other way to contact him, so I can only pray for him here. I hope that the archon will bless him and keep him safe..."
                }
            ]
        },
        {
            "talkId": "6310903",
            "initDialog": "631090301",
            "dialogues": [
                {
                    "id": "631090301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "631090302",
                    "speaker": "Kanra",
                    "text": "Alas, goodbye..."
                }
            ]
        },
        {
            "talkId": "7292701",
            "initDialog": "729270101",
            "dialogues": [
                {
                    "id": "729270101",
                    "speaker": "Player",
                    "text": "Best of luck to you."
                },
                {
                    "id": "729270102",
                    "speaker": "Kanra",
                    "text": "You are too nice. Thank you."
                },
                {
                    "id": "729270103",
                    "speaker": "Kanra",
                    "text": "Umm... You seem like a seasoned Traveler. I'll give this amulet to you, it'll protect you in your journeys ahead."
                },
                {
                    "id": "729270104",
                    "speaker": "Kanra",
                    "text": "If I can see my lover again, I'll prepare one for him as well..."
                }
            ]
        }
    ]
}