                {
                    "id": "641440201",
                    "speaker": "Player",
                    "text": "Hello."
                },
                {
                    "id": "641440202",
                    "speaker": "Vanita",
                    "text": "Hello."
                },
                {
                    "id": "641440203",
                    "speaker": "Vanita",
                    "text": "..."
                },
                {
                    "id": "641440204",
                    "speaker": "Vanita",
                    "text": "Sorry, my colleagues and I are not good at small talk. It's easy to get distracted by talking after all."
                },
                {
                    "id": "641440205",
                    "speaker": "Vanita",
                    "text": "This is the Wikala Funduq. Many people come here to do business every day. Interest rates can incite disputes, so this place must be strictly guarded."
                },
                {
                    "id": "641440206",
                    "speaker": "Vanita",
                    "text": "Oh, right, I must also remind you that if you are new to the city, it's best not to trust those who wear the uniform of the Eremites."
                },
                {
                    "id": "641440207",
                    "speaker": "Vanita",
                    "text": "Especially those who peddle dangerous goods related to obtaining knowledge. They are driven by money and are not afraid to cross the lines considered unforgivable by the Akademiya."
                }
            ]
        },
        {
            "talkId": "6414403",
            "initDialog": "641440301",
            "dialogues": [
                {
                    "id": "641440301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641440302",
