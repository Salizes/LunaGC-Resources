            "dialogues": [
                {
                    "id": "650680101",
                    "speaker": "Lisette",
                    "text": "Where should I adventure next?"
                }
            ]
        },
        {
            "talkId": "6506802",
            "initDialog": "650680201",
            "dialogues": [
                {
                    "id": "650680201",
                    "speaker": "Player",
                    "text": "Adventure, you say?"
                },
                {
                    "id": "650680202",
                    "speaker": "Lisette",
                    "text": "That's right. My adventure here's been awesome! Everyone treats me well, especially the people at the Spina di Rosula."
                }
            ]
        },
        {
            "talkId": "6506803",
            "initDialog": "650680301",
            "dialogues": [
                {
                    "id": "650680301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "650680302",
                    "speaker": "Lisette",
                    "text": "Yup, seeya!"
                }
            ]
        },
        {
            "talkId": "6506804",
            "initDialog": "650680401",
            "dialogues": [
                {
                    "id": "650680401",
                    "speaker": "Player",
                    "text": "You're not from around here originally?"
                },
                {
                    "id": "650680402",
                    "speaker": "Lisette",
                    "text": "Um, I... don't really remember."
                },
                {
                    "id": "650680403",
                    "speaker": "Lisette",
                    "text": "One day, when I woke up, I was... just here. Maybe Mom and Dad abandoned me, or something..."
                }
            ]
        },
        {
            "talkId": "6506805",
            "initDialog": "650680501",
            "dialogues": [
                {
                    "id": "650680501",
                    "speaker": "Player",
                    "text": "That wasn't your fault."
                },
                {
                    "id": "650680502",
                    "speaker": "Lisette",
                    "text": "I know. Everyone here tells me that too."
                },
                {
                    "id": "650680503",
                    "speaker": "Lisette",
                    "text": "Everyone here is super friendly, and I'm living really well. Even if I don't go back... I mean, I'd be totally okay staying here forever!"
                }
            ]
        }
    ]
