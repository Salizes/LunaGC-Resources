        },
        {
            "talkId": "6411302",
            "initDialog": "641130201",
            "dialogues": [
                {
                    "id": "641130201",
                    "speaker": "Player",
                    "text": "And you are..."
                },
                {
                    "id": "641130202",
                    "speaker": "Bita",
                    "text": "I'm just an unimportant, ordinary dockworker."
                },
                {
                    "id": "641130203",
                    "speaker": "Bita",
                    "text": "What's important is the cargo in my hand."
                },
                {
                    "id": "641130204",
                    "speaker": "Bita",
                    "text": "See what this place is?"
                },
                {
                    "id": "641130205",
                    "speaker": "Bita",
                    "text": "It's Port Ormos!"
                },
                {
                    "id": "641130206",
                    "speaker": "Bita",
                    "text": "It's imported goods, don't you get it?"
                },
                {
                    "id": "641130207",
                    "speaker": "Bita",
                    "text": "Want to check them out?"
                }
            ]
        },
        {
            "talkId": "6411303",
            "initDialog": "641130301",
            "dialogues": [
                {
                    "id": "641130301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641130302",
                    "speaker": "Bita",
                    "text": "Don't ask if you aren't buying."
                }
            ]
        },
        {
            "talkId": "6411304",
            "initDialog": "641130401",
            "dialogues": [
                {
                    "id": "641130401",
                    "speaker": "Player",
                    "text": "I'm just asking..."
                },
                {
                    "id": "641130402",
                    "speaker": "Bita",
                    "text": "Another one!?"
                },
                {
                    "id": "641130403",
                    "speaker": "Bita",
                    "text": "My boss wouldn't take a person like you even if you worked for free!"
                }
            ]
        }
    ]
