    "talks": [
        {
            "talkId": "6405701",
            "initDialog": "640570101",
            "dialogues": [
                {
                    "id": "640570101",
                    "speaker": "Hushang",
                    "text": "If only I could break into the Liyue market..."
                }
            ]
        },
        {
            "talkId": "6405702",
            "initDialog": "640570201",
            "dialogues": [
                {
                    "id": "640570201",
                    "speaker": "Player",
                    "text": "What are you planning?"
                },
                {
                    "id": "640570202",
                    "speaker": "Hushang",
                    "text": "It's about the toy trade. I hear that toys from Snezhnaya sell very well in Liyue, and now I'm feeling some regret."
                },
                {
                    "id": "640570203",
                    "speaker": "Hushang",
                    "text": "If I could have seized the opportunity to bring my handmade toys to Liyue, they'd definitely be more popular now than anything from Snezhnaya!"
                },
                {
                    "id": "640570204",
                    "speaker": "Hushang",
                    "text": "What could a frigid place like that know about a child's heart?"
                }
            ]
        },
        {
            "talkId": "6405703",
            "initDialog": "640570301",
            "dialogues": [
                {
                    "id": "640570301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640570302",
                    "speaker": "Hushang",
                    "text": "Why, why!?"
                }
            ]
        },
        {
            "talkId": "6405704",
            "initDialog": "640570401",
            "dialogues": [
                {
                    "id": "640570401",
                    "speaker": "Player",
                    "text": "Duel"
                }
            ]
        },
        {
            "talkId": "6405705",
            "initDialog": "640570501",
            "dialogues": [
                {
                    "id": "640570501",
                    "speaker": "Hushang",
                    "text": "Alas... What's so fun about cards? Come on, guest, look at the toys I've made..."
                }
            ]
        },
        {
            "talkId": "6405706",
            "initDialog": "640570601",
            "dialogues": [
                {
                    "id": "640570601",
                    "speaker": "Hushang",
                    "text": "I won! As a toy maker, I'm practically a colleague of these card makers and of course I understand how things work!"
                }
            ]
        }
    ]
}