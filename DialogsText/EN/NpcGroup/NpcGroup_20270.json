{
    "groupId": "20270",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Parvaneh": 16,
        "Player": 7
    },
    "talks": [
        {
            "talkId": "2201601",
            "initDialog": "220160101",
            "dialogues": [
                {
                    "id": "220160101",
                    "speaker": "Parvaneh",
                    "text": "Traveler... you're just in time! Have you seen Julie? The... the short Mondstadt girl who was with me!?"
                },
                {
                    "id": "220160102",
                    "speaker": "Player",
                    "text": "No, I haven't..."
                },
                {
                    "id": "220160103",
                    "speaker": "Parvaneh",
                    "text": "You— You haven't seen her either? Where on earth did that idiot go..."
                },
                {
                    "id": "220160104",
                    "speaker": "Player",
                    "text": "What happened?"
                },
                {
                    "id": "220160105",
                    "speaker": "Parvaneh",
                    "text": "Julie suddenly disappeared. No, well... maybe it's not accurate to say that she \"suddenly\" disappeared."
                },
                {
                    "id": "220160106",
                    "speaker": "Parvaneh",
                    "text": "We met an old man named Kamei Munehisa when you last came with us to collect ingredients. Do you remember him?",
                    "choices": [
                        {
                            "id": "220160107",
                            "text": "Sort of, yes...",
                            "response": [
                                {
                                    "id": "220160109",
                                    "speaker": "Parvaneh",
                                    "text": "Yeah. He defeated the monsters near the camp and gave us ingredients from around those parts."
                                },
                                {
                                    "id": "220160110",
                                    "speaker": "Parvaneh",
                                    "text": "Ever since we got back, Julie has been talking about sending him food to show our appreciation..."
                                },
                                {
                                    "id": "220160111",
                                    "speaker": "Parvaneh",
                                    "text": "Xudong and I thought she was just saying it. However, she left a note in the camp today and actually went looking for him."
                                },
                                {
                                    "id": "220160112",
                                    "speaker": "Parvaneh",
                                    "text": "The idiot... She doesn't know what she's doing! That Kamei Munehisa looked so suspicious!"
                                },
                                {
                                    "id": "220160113",
                                    "speaker": "Parvaneh",
                                    "text": "*sigh* Xudong and I split up. He went to find the place where we met Kamei Munehisa the previous time. I came to the Adventurers' Guild to post a missing person commission."
                                },
                                {
                                    "id": "220160114",
                                    "speaker": "Parvaneh",
                                    "text": "I can't believe that she actually dared to run off with how things are in Inazuma right now... We must find her, and quickly!",
                                    "choices": [
                                        {
                                            "id": "220160115",
                                            "text": "I'll go with you.",
                                            "response": [
                                                {
                                                    "id": "220160116",
                                                    "speaker": "Parvaneh",
                                                    "text": "That would be great."
                                                },
                                                {
                                                    "id": "220160123",
                                                    "speaker": "Parvaneh",
                                                    "text": "Xudong and I have agreed on a rendezvous point, so we'll meet him there first."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220160117",
                                            "text": "If she runs into a monster...",
                                            "response": [
                                                {
                                                    "id": "220160118",
                                                    "speaker": "Parvaneh",
                                                    "text": "If Julie runs into a monster... Honestly, I'd be more worried for the monster."
                                                },
                                                {
                                                    "id": "220160119",
                                                    "speaker": "Parvaneh",
                                                    "text": "But if she runs into the Kairagi or something like that, that would be bad. Kairagi can't be dealt with in the same way as monsters..."
                                                },
                                                {
                                                    "id": "220160120",
                                                    "speaker": "Parvaneh",
                                                    "text": "Even if Xudong and I joined forces, it would still be..."
                                                },
                                                {
                                                    "id": "220160121",
                                                    "speaker": "Player",
                                                    "text": "I can help, too."
                                                },
                                                {
                                                    "id": "220160122",
                                                    "speaker": "Parvaneh",
                                                    "text": "Huh? You're willing to help? That would be great."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220160108",
                            "text": "The samurai?"
                        }
                    ]
                }
            ]
        }
    ]
}