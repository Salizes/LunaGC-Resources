            "dialogues": [
                {
                    "id": "643290101",
                    "speaker": "Bahram",
                    "text": "Selling things here is a pursuit of leisure."
                }
            ]
        },
        {
            "talkId": "6432902",
            "initDialog": "643290201",
            "dialogues": [
                {
                    "id": "643290201",
                    "speaker": "Player",
                    "text": "How's the business going?"
                },
                {
                    "id": "643290202",
                    "speaker": "Bahram",
                    "text": "It's enough to make the ends meet."
                },
                {
                    "id": "643290203",
                    "speaker": "Bahram",
                    "text": "This is a key area on the river path to Sumeru, so many caravans pass through all year round."
                },
                {
                    "id": "643290204",
                    "speaker": "Bahram",
                    "text": "But you can travel along the river to Port Ormos, so few merchants would stay here."
                },
                {
                    "id": "643290205",
                    "speaker": "Bahram",
                    "text": "But it's also a good thing. Fewer merchants, less competition, you know."
                }
            ]
        },
        {
            "talkId": "6432903",
            "initDialog": "643290301",
            "dialogues": [
                {
                    "id": "643290301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "643290302",
                    "speaker": "Bahram",
                    "text": "Take care."
                }
            ]
        }
    ]
}