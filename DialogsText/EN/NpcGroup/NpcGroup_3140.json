{
    "groupId": "3140",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Matsuda": 7,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6314001",
            "initDialog": "631400101",
            "dialogues": [
                {
                    "id": "631400101",
                    "speaker": "Matsuda",
                    "text": "Halt! All passers-by must allow themselves to be inspected!"
                },
                {
                    "id": "631400102",
                    "speaker": "Matsuda",
                    "text": "Where are you from? Where are you going? Answer me honestly!"
                }
            ]
        },
        {
            "talkId": "6314002",
            "initDialog": "631400201",
            "dialogues": [
                {
                    "id": "631400201",
                    "speaker": "Player",
                    "text": "Do you really have to ask in so much detail?"
                },
                {
                    "id": "631400202",
                    "speaker": "Matsuda",
                    "text": "Of course! This is my duty. I will see it through to the utmost of my ability!"
                },
                {
                    "id": "631400203",
                    "speaker": "Matsuda",
                    "text": "Who knows what suspicious people might get into the camp if we aren't thorough..."
                }
            ]
        },
        {
            "talkId": "6314003",
            "initDialog": "631400301",
            "dialogues": [
                {
                    "id": "631400301",
                    "speaker": "Player",
                    "text": "See you around."
                },
                {
                    "id": "631400302",
                    "speaker": "Matsuda",
                    "text": "Eh? Don't just ignore me..."
                }
            ]
        },
        {
            "talkId": "6314004",
            "initDialog": "631400401",
            "dialogues": [
                {
                    "id": "631400401",
                    "speaker": "Player",
                    "text": "Has something similar happened before?"
                },
                {
                    "id": "631400402",
                    "speaker": "Matsuda",
                    "text": "H—How would I... Um, ahem! I mean, of course not!"
                },
                {
                    "id": "631400403",
                    "speaker": "Matsuda",
                    "text": "I've only been dispatched here recently, but I'm a dutiful soldier. For my comrades' safety, I won't let any spies in!"
                }
            ]
        }
    ]
}