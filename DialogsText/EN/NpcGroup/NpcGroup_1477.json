    "talks": [
        {
            "talkId": "6147701",
            "initDialog": "4015147701",
            "dialogues": [
                {
                    "id": "4015147701",
                    "speaker": "Nelson",
                    "text": "Want to join me? Come on, have a seat."
                }
            ]
        },
        {
            "talkId": "6147702",
            "initDialog": "4015147702",
            "dialogues": [
                {
                    "id": "4015147702",
                    "speaker": "Nelson",
                    "text": "How is it?"
                },
                {
                    "id": "4015147705",
                    "speaker": "Nelson",
                    "text": "You need to ask? Drinks brewed from the waters of Cider Lake are famous in all Teyvat."
                },
                {
                    "id": "4015147706",
                    "speaker": "Nelson",
                    "text": "Here, have a taste! Oh, you can't drink alcohol? What a shame."
                }
            ]
        },
        {
            "talkId": "6147703",
            "initDialog": "4015147703",
            "dialogues": [
                {
                    "id": "4015147703",
                    "speaker": "Nelson",
                    "text": "How's Mondstadt?"
                },
                {
                    "id": "4015147707",
                    "speaker": "Nelson",
                    "text": "This is a good place."
                },
                {
                    "id": "4015147708",
                    "speaker": "Nelson",
                    "text": "As to the Crown of the North, the romantic City of Pastorals, it's all writers' way of putting it."
                },
                {
                    "id": "4015147709",
                    "speaker": "Nelson",
                    "text": "To me, beautiful scenery and good wine are more than enough!"
                },
                {
                    "id": "4015147710",
                    "speaker": "Nelson",
                    "text": "*hic* The wine here is the best. I'm not going anywhere."
                }
            ]
        },
        {
            "talkId": "6147704",
            "initDialog": "4015147704",
            "dialogues": [
                {
                    "id": "4015147704",
                    "speaker": "Nelson",
                    "text": "Goodbye."
                },
                {
                    "id": "4015147711",
                    "speaker": "Nelson",
                    "text": "Goodbye! Let's have a drink next time!"
                }
            ]
        },
        {
            "talkId": "6147705",
            "initDialog": "614770501",
            "dialogues": [
                {
                    "id": "614770501",
                    "speaker": "Player",
                    "text": "About Stormterror..."
                },
                {
                    "id": "614770502",
                    "speaker": "Nelson",
                    "text": "What I think? I think that now that this is all over, I can finally proudly declare that \"Mondstadt is a great place!\""
                },
                {
                    "id": "614770503",
                    "speaker": "Nelson",
                    "text": "The scenery's good, the wine is fine, and the Knights of Favonius will defend us when crises come. That's what I call great!"
                }
            ]
        }
    ]
}