        },
        {
            "talkId": "6166002",
            "initDialog": "616600201",
            "dialogues": [
                {
                    "id": "616600201",
                    "speaker": "Player",
                    "text": "Hey there, kiddo."
                },
                {
                    "id": "616600202",
                    "speaker": "Sage",
                    "text": "Mm! Say, have you heard of the Dandelion Sea?"
                }
            ]
        },
        {
            "talkId": "6166003",
            "initDialog": "616600301",
            "dialogues": [
                {
                    "id": "616600301",
                    "speaker": "Player",
                    "text": "The Dandelion Sea, you say?"
                },
                {
                    "id": "616600302",
                    "speaker": "Sage",
                    "text": "Uh-huh! There's this book I read, it says that somewhere in Mondstadt, there is a biiiiig sea of dandelions!"
                },
                {
                    "id": "616600303",
                    "speaker": "Sage",
                    "text": "It even has little talking foxes in it!"
                }
            ]
        },
        {
            "talkId": "6166004",
            "initDialog": "616600401",
            "dialogues": [
                {
                    "id": "616600401",
                    "speaker": "Player",
                    "text": "See you, kiddo."
                },
                {
                    "id": "616600402",
                    "speaker": "Sage",
                    "text": "Seeya!"
                },
                {
                    "id": "616600403",
                    "speaker": "Sage",
                    "text": "Tell me if you ever see the Dandelion Sea!"
                }
            ]
        },
        {
            "talkId": "6166005",
            "initDialog": "616600501",
            "dialogues": [
                {
                    "id": "616600501",
                    "speaker": "Player",
                    "text": "Little talking foxes?"
                },
                {
                    "id": "616600502",
                    "speaker": "Sage",
                    "text": "Yup! I wanna know what talking to animals is like!"
                },
                {
                    "id": "616600503",
                    "speaker": "Sage",
                    "text": "Hmm... But I've only seen a guy in green clothes and white socks talk to animals before. Happened to bump into him."
                },
                {
                    "id": "616600504",
                    "speaker": "Sage",
                    "text": "I told Mom how awesome he was, but that guy said that I was mistaken."
                }
            ]
        }
    ]
