    "talks": [
        {
            "talkId": "6419501",
            "initDialog": "641950101",
            "dialogues": [
                {
                    "id": "641950101",
                    "speaker": "Araphala",
                    "text": "Araphala thought Arapacati was going to cook Araphala into gruel... Luckily, Araphala picked many fruits."
                }
            ]
        },
        {
            "talkId": "6419502",
            "initDialog": "641950201",
            "dialogues": [
                {
                    "id": "641950201",
                    "speaker": "Player",
                    "text": "About Arapacati..."
                },
                {
                    "id": "641950202",
                    "speaker": "Araphala",
                    "text": "I gave several Unrivaled Fresh Fruits to sister, she is less angry after eating them."
                },
                {
                    "id": "641950203",
                    "speaker": "Araphala",
                    "text": "Last time she was angry, was when we made all that smoke in Vanarana."
                },
                {
                    "id": "641950204",
                    "speaker": "Araphala",
                    "text": "Araphala will give her more Unrivaled Fresh Fruits, when that happens again..."
                },
                {
                    "id": "641950205",
                    "speaker": "Araphala",
                    "text": "No, not again."
                }
            ]
        },
        {
            "talkId": "6419503",
            "initDialog": "641950301",
            "dialogues": [
                {
                    "id": "641950301",
                    "speaker": "Player",
                    "text": "About the fruits..."
                },
                {
                    "id": "641950302",
                    "speaker": "Araphala",
                    "text": "#Thanks to the help of Nara {NICKNAME}, Araphala brought many Unrivaled Fresh Fruits."
                },
                {
                    "id": "641950303",
                    "speaker": "Araphala",
                    "text": "When Festival Utsava comes, Araphala will show the training results to everyone."
                }
            ]
        },
        {
            "talkId": "6419504",
            "initDialog": "641950401",
            "dialogues": [
                {
                    "id": "641950401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641950402",
                    "speaker": "Araphala",
                    "text": "Okay!"
                }
            ]
        },
        {
            "talkId": "6419505",
            "initDialog": "641950501",
            "dialogues": [
                {
                    "id": "641950501",
                    "speaker": "Araphala",
                    "text": "Unrivaled Fresh Fruits, blessings from the strong trees... Vasara Tree and Ashvattha, are the strongest trees..."
                }
            ]
        },
        {
            "talkId": "6419506",
            "initDialog": "641950601",
            "dialogues": [
                {
                    "id": "641950601",
                    "speaker": "Player",
                    "text": "About the Vasara Tree..."
                },
                {
                    "id": "641950602",
                    "speaker": "Araphala",
                    "text": "Vasara Tree is so strong, how does the Vasoma Fruit it bears taste..."
                }
            ]
        },
        {
            "talkId": "6419507",
            "initDialog": "641950701",
            "dialogues": [
                {
                    "id": "641950701",
                    "speaker": "Player",
                    "text": "About the Ashvattha..."
                },
                {
                    "id": "641950702",
                    "speaker": "Araphala",
                    "text": "Bijas are only found on the strongest Vasara Tree that is able to be the Ashvattha. Bijas must be delicious."
                },
                {
                    "id": "641950703",
                    "speaker": "Araphala",
                    "text": "If a Nara has tried Bija, they will not want any other fruits because they've already tasted the very best of fruits in the forest."
                }
            ]
        },
        {
            "talkId": "6419508",
            "initDialog": "641950801",
            "dialogues": [
                {
                    "id": "641950801",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641950802",
                    "speaker": "Araphala",
                    "text": "How would it taste..."
                }
            ]
        }
    ]
