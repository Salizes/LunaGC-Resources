    "talks": [
        {
            "talkId": "6610801",
            "initDialog": "661080101",
            "dialogues": [
                {
                    "id": "661080101",
                    "speaker": "Sinchi",
                    "text": "Hello. Is there anything I can bring back for you?"
                }
            ]
        },
        {
            "talkId": "6610802",
            "initDialog": "661080201",
            "dialogues": [
                {
                    "id": "661080201",
                    "speaker": "Player",
                    "text": "How about relatives?"
                },
                {
                    "id": "661080202",
                    "speaker": "Sinchi",
                    "text": "...You misunderstood me. I'm just a regular hunter."
                },
                {
                    "id": "661080203",
                    "speaker": "Sinchi",
                    "text": "If you're looking for someone, you should probably hire a private detective, or file a commission with the Adventurers' Guild... I'm honestly not too sure either."
                },
                {
                    "id": "661080204",
                    "speaker": "Sinchi",
                    "text": "The only thing I know how to do is go on hunts with my Yumkasaurus partner. As long as you give me a target, I'll be able to bring it back for you."
                }
            ]
        },
        {
            "talkId": "6610803",
            "initDialog": "661080301",
            "dialogues": [
                {
                    "id": "661080301",
                    "speaker": "Player",
                    "text": "I'm fine, thanks."
                },
                {
                    "id": "661080302",
                    "speaker": "Sinchi",
                    "text": "Oh."
                }
            ]
        }
    ]
}