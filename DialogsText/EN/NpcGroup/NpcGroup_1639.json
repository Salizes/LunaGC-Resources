{
    "groupId": "1639",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 3,
        "Sharp": 22
    },
    "talks": [
        {
            "talkId": "7090901",
            "initDialog": "709090101",
            "dialogues": [
                {
                    "id": "709090101",
                    "speaker": "Player",
                    "text": "Are you bored?"
                },
                {
                    "id": "709090102",
                    "speaker": "Sharp",
                    "text": "Of course. After chasing the monsters away, I have absolutely nothing to do."
                },
                {
                    "id": "709090103",
                    "speaker": "Sharp",
                    "text": "Earlier, the young master asked me to help him pick some flowers, but he and that young lady started getting all lovey-dovey right away..."
                },
                {
                    "id": "709090104",
                    "speaker": "Sharp",
                    "text": "What need do they have for flowers? I reckon the young master's forgotten all about it already."
                },
                {
                    "id": "709090105",
                    "speaker": "Sharp",
                    "text": "Do you want them? Just take them if you do. They're no use to me, anyhow."
                }
            ]
        },
        {
            "talkId": "6163901",
            "initDialog": "616390101",
            "dialogues": [
                {
                    "id": "616390101",
                    "speaker": "Sharp",
                    "text": "...What do you think you're doing?"
                }
            ]
        },
        {
            "talkId": "6163902",
            "initDialog": "616390201",
            "dialogues": [
                {
                    "id": "616390201",
                    "speaker": "Sharp",
                    "text": "Who are you?"
                },
                {
                    "id": "616390202",
                    "speaker": "Sharp",
                    "text": "Sharp."
                },
                {
                    "id": "616390203",
                    "speaker": "Sharp",
                    "text": "Master Goth's PSD."
                },
                {
                    "id": "616390204",
                    "speaker": "Sharp",
                    "text": "If you know the first thing about me, you'll keep away from my VIP."
                },
                {
                    "id": "616390205",
                    "speaker": "Sharp",
                    "text": "\"PSD\"?"
                },
                {
                    "id": "616390206",
                    "speaker": "Sharp",
                    "text": "Tsk. Of course. You wouldn't know."
                },
                {
                    "id": "616390207",
                    "speaker": "Sharp",
                    "text": "PSD, personal security detachment. Bodyguard. We take the hit, so our clients don't have to."
                },
                {
                    "id": "616390208",
                    "speaker": "Sharp",
                    "text": "Personally, I much prefer \"merc for hire.\" But now that I work for them, they've insisted on PSD."
                }
            ]
        },
        {
            "talkId": "6163903",
            "initDialog": "616390301",
            "dialogues": [
                {
                    "id": "616390301",
                    "speaker": "Sharp",
                    "text": "Sorry to bother you."
                },
                {
                    "id": "616390302",
                    "speaker": "Sharp",
                    "text": "Mm. On your way."
                }
            ]
        },
        {
            "talkId": "6163904",
            "initDialog": "616390401",
            "dialogues": [
                {
                    "id": "616390401",
                    "speaker": "Sharp",
                    "text": "What do you want?"
                }
            ]
        },
        {
            "talkId": "6163905",
            "initDialog": "616390501",
            "dialogues": [
                {
                    "id": "616390501",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "616390502",
                    "speaker": "Sharp",
                    "text": "Master Goth pays me to protect his young esquire. His young esquire pays me to keep this a secret from his old man."
                },
                {
                    "id": "616390503",
                    "speaker": "Sharp",
                    "text": "To get paid double, I just have to stay put and keep my mouth shut."
                },
                {
                    "id": "616390504",
                    "speaker": "Sharp",
                    "text": "Hmph, look at them. Being all lovey-dovey when I'm right here watching. Young people these days, no sense of shame..."
                },
                {
                    "id": "616390505",
                    "speaker": "Sharp",
                    "text": "Wait a second... Are they getting a kick out of me watching them!?"
                },
                {
                    "id": "616390506",
                    "speaker": "Sharp",
                    "text": "...Ugh, I cannot abide this!"
                }
            ]
        },
        {
            "talkId": "6163906",
            "initDialog": "616390601",
            "dialogues": [
                {
                    "id": "616390601",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "616390602",
                    "speaker": "Sharp",
                    "text": "Scram!"
                }
            ]
        }
    ]
}