{
    "groupId": "4013",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Farooq": 9,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6401301",
            "initDialog": "640130101",
            "dialogues": [
                {
                    "id": "640130101",
                    "speaker": "Farooq",
                    "text": "Watch out for pickpockets."
                }
            ]
        },
        {
            "talkId": "6401302",
            "initDialog": "640130201",
            "dialogues": [
                {
                    "id": "640130201",
                    "speaker": "Player",
                    "text": "Are there lots of thieves?"
                },
                {
                    "id": "640130202",
                    "speaker": "Farooq",
                    "text": "With the Corps of Thirty around, pickpockets wouldn't dare come around often."
                },
                {
                    "id": "640130203",
                    "speaker": "Farooq",
                    "text": "But there could be \"inside jobs.\""
                },
                {
                    "id": "640130204",
                    "speaker": "Farooq",
                    "text": "If you see someone who looks exactly like me, watch your wallet."
                },
                {
                    "id": "640130205",
                    "speaker": "Farooq",
                    "text": "He's my twin brother. A petty thief who talks nonsense all the time."
                },
                {
                    "id": "640130206",
                    "speaker": "Farooq",
                    "text": "Don't let him rub off on you. Just keep an eye on his actions."
                }
            ]
        },
        {
            "talkId": "6401303",
            "initDialog": "640130301",
            "dialogues": [
                {
                    "id": "640130301",
                    "speaker": "Player",
                    "text": "Thanks for the reminder."
                },
                {
                    "id": "640130302",
                    "speaker": "Farooq",
                    "text": "Good to hear that."
                }
            ]
        },
        {
            "talkId": "7392601",
            "initDialog": "739260101",
            "dialogues": [
                {
                    "id": "739260101",
                    "speaker": "Player",
                    "text": "You all look pretty much the same..."
                },
                {
                    "id": "739260102",
                    "speaker": "Farooq",
                    "text": "That's even easier: Don't trust anyone."
                },
                {
                    "id": "739260103",
                    "speaker": "Farooq",
                    "text": "You'll pay the price someday if you let your guard down around people in uniforms."
                }
            ]
        }
    ]
}