                                }
                            ]
                        },
                        {
                            "id": "732852110",
                            "text": "About the Order of Skeptics...",
                            "response": [
                                {
                                    "id": "732852111",
                                    "speaker": "Sosi",
                                    "text": "Our Vijnanapati... No, Nasejuna's actions have been despicable. Yet you were still able to extinguish the Sign of Apaosha... Impressive as always, Lady Sorush."
                                },
                                {
                                    "id": "732852112",
                                    "speaker": "Sosi",
                                    "text": "My only regret is that I couldn't participate in such a historical moment myself..."
                                }
                            ]
                        },
                        {
                            "id": "732852113",
                            "text": "I won't disturb you then.",
                            "response": [
                                {
                                    "id": "732852114",
                                    "speaker": "Sosi",
                                    "text": "You're too kind. I'll be continuing with my work then."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7328522",
            "initDialog": "732852201",
            "dialogues": [
                {
                    "id": "732852201",
                    "speaker": "Sosi",
                    "text": "Lady Sorush's Yasnapati... Don't give up so easily. You should... try harder.",
                    "choices": [
                        {
                            "id": "732852202",
                            "text": "Has something happened?",
                            "response": [
                                {
                                    "id": "732852203",
                                    "speaker": "Sosi",
                                    "text": "Oh, it's nothing. I'm not making much progress in my research, that's all. This is all part and parcel of a researcher's life."
                                }
                            ]
                        },
                        {
                            "id": "732852204",
                            "text": "I won't disturb you then.",
                            "response": [
                                {
                                    "id": "732852205",
                                    "speaker": "Sosi",
                                    "text": "Thank you for your understanding. I'll be continuing with my work then."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
