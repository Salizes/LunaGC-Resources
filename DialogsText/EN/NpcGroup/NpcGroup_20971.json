    "talks": [
        {
            "talkId": "7328519",
            "initDialog": "732851901",
            "dialogues": [
                {
                    "id": "732851901",
                    "speaker": "Sosi",
                    "text": "Outlander from afar... speak to the Vijnanapati if you have matters to discuss.",
                    "choices": [
                        {
                            "id": "732851902",
                            "text": "What are you doing here?",
                            "response": [
                                {
                                    "id": "732851903",
                                    "speaker": "Sosi",
                                    "text": "I'm... Ahem, you need not know that much."
                                },
                                {
                                    "id": "732851904",
                                    "speaker": "Sosi",
                                    "text": "If there's nothing else, please leave as soon as possible."
                                }
                            ]
                        },
                        {
                            "id": "732851905",
                            "text": "I won't disturb you then.",
                            "response": [
                                {
                                    "id": "732851906",
                                    "speaker": "Sosi",
                                    "text": "Alright. I'll be continuing with my work."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7328520",
            "initDialog": "732852001",
            "dialogues": [
                {
                    "id": "732852001",
                    "speaker": "Sosi",
                    "text": "...Oh! It's you, Lady Sorush's Yasnapati. If you have any questions at all, I'll make sure to tell you everything I know.",
                    "choices": [
                        {
                            "id": "732852002",
                            "text": "About the Khvarena Monument...",
                            "response": [
                                {
                                    "id": "732852003",
                                    "speaker": "Sosi",
                                    "text": "As you may have noticed, I haven't given up on investigating the Order of Skeptics' documents."
                                },
                                {
                                    "id": "732852004",
                                    "speaker": "Sosi",
                                    "text": "Although there had been some discrepancies between the records and the apparent situation..."
                                },
                                {
                                    "id": "732852005",
                                    "speaker": "Sosi",
                                    "text": "I believe that as long as I look closely enough, the truth will emerge sooner or later."
                                }
                            ]
                        },
                        {
                            "id": "732852006",
                            "text": "About the Fatui...",
                            "response": [
                                {
                                    "id": "732852007",
                                    "speaker": "Sosi",
                                    "text": "Thanks to you all, Markozov has already withdrawn his troops."
                                },
                                {
                                    "id": "732852008",
                                    "speaker": "Sosi",
                                    "text": "However, the Fatui would never give up that easily..."
                                },
                                {
                                    "id": "732852009",
                                    "speaker": "Sosi",
                                    "text": "Perhaps it's time for the Order of Skeptics to recruit more capable personnel. At the very least, they should do better than Pyrrho."
                                }
                            ]
                        },
                        {
                            "id": "732852010",
                            "text": "I won't disturb you then.",
                            "response": [
                                {
                                    "id": "732852011",
                                    "speaker": "Sosi",
                                    "text": "You're too kind. I'll be continuing with my work then."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7328521",
            "initDialog": "732852101",
            "dialogues": [
