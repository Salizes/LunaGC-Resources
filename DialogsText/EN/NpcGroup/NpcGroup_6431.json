    "talks": [
        {
            "talkId": "5900241",
            "initDialog": "590024101",
            "dialogues": [
                {
                    "id": "590024101",
                    "speaker": "Player",
                    "text": "Is there anything of note nearby?"
                }
            ]
        },
        {
            "talkId": "5900242",
            "initDialog": "590024201",
            "dialogues": [
                {
                    "id": "590024201",
                    "speaker": "Pahua",
                    "text": "Let me think... Hmm, I don't suppose there's anything you'll find particularly interesting, but you know what they say, \"rest is where the gains are made\" — sometimes it's good just to relax."
                }
            ]
        },
        {
            "talkId": "6643101",
            "initDialog": "664310101",
            "dialogues": [
                {
                    "id": "664310101",
                    "speaker": "Pahua",
                    "text": "Pick the right equipment and work smarter, not harder."
                }
            ]
        },
        {
            "talkId": "6643102",
            "initDialog": "664310201",
            "dialogues": [
                {
                    "id": "664310201",
                    "speaker": "Player",
                    "text": "What are you selling?"
                },
                {
                    "id": "664310202",
                    "speaker": "Pahua",
                    "text": "Training equipment."
                },
                {
                    "id": "664310203",
                    "speaker": "Pahua",
                    "text": "But... looking at you, I think you're well past needing such entry-level gear."
                }
            ]
        },
        {
            "talkId": "6643103",
            "initDialog": "664310301",
            "dialogues": [
                {
                    "id": "664310301",
                    "speaker": "Player",
                    "text": "See you, then."
                },
                {
                    "id": "664310302",
                    "speaker": "Pahua",
                    "text": "Okay, goodbye."
                }
            ]
        },
        {
            "talkId": "6643104",
            "initDialog": "664310401",
            "dialogues": [
                {
                    "id": "664310401",
                    "speaker": "Player",
                    "text": "What do you mean?"
                },
                {
                    "id": "664310402",
                    "speaker": "Pahua",
                    "text": "Exactly what I said. I'm a fitness coach too, and I've got an eye for my customers' skill levels and needs."
                },
                {
                    "id": "664310403",
                    "speaker": "Pahua",
                    "text": "I only recommend equipment that I think will help, and you strike me as being a cut above the average fitness fanatic, am I right? Nothing I have here is going to challenge you enough."
                },
                {
                    "id": "664310404",
                    "speaker": "Pahua",
                    "text": "However, if you're looking to buy something for a friend, maybe I can help. Just fill me in on their physical condition they're in, and I'll do the rest."
                }
            ]
        },
        {
            "talkId": "6643105",
            "initDialog": "664310501",
            "dialogues": [
                {
                    "id": "664310501",
                    "speaker": "Pahua",
                    "text": "Duel"
                }
            ]
        },
        {
            "talkId": "6643106",
            "initDialog": "664310601",
            "dialogues": [
                {
                    "id": "664310601",
                    "speaker": "Pahua",
                    "text": "Hmm, looks like you should consider changing your deck."
                }
            ]
        },
        {
            "talkId": "6643107",
            "initDialog": "664310701",
            "dialogues": [
                {
                    "id": "664310701",
                    "speaker": "Pahua",
                    "text": "What a strong deck... It's perfect for someone of your skill."
                }
            ]
        }
    ]
}