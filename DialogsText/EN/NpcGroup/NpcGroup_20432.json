{
    "groupId": "20432",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Kid Kujirai": 15,
        "Paimon": 1,
        "Player": 6
    },
    "talks": [
        {
            "talkId": "7221910",
            "initDialog": "722191001",
            "dialogues": [
                {
                    "id": "722191001",
                    "speaker": "Kid Kujirai",
                    "text": "#{F#Big sis}{M#Big bro}, you're really good at this! You even cracked my \"Kujirai Art, Temari Jutsu.\"",
                    "choices": [
                        {
                            "id": "722191002",
                            "text": "About how to play Temari...",
                            "response": [
                                {
                                    "id": "722191003",
                                    "speaker": "Kid Kujirai",
                                    "text": "If you are looking for the Temari, you need to find the Temari hidden by others within the time limit and you win."
                                },
                                {
                                    "id": "722191004",
                                    "speaker": "Kid Kujirai",
                                    "text": "If you are hiding the Temari, you must hide the Temari within the same limited time. It's only fair to the player looking for it. The Big Sister adventurer said that fairness in the game is very important!"
                                }
                            ]
                        },
                        {
                            "id": "722191005",
                            "text": "Tell me a little about yourself, please...",
                            "response": [
                                {
                                    "id": "722191006",
                                    "speaker": "Kid Kujirai",
                                    "text": "Hmm, what's wrong?",
                                    "choices": [
                                        {
                                            "id": "722191007",
                                            "text": "\"Kujirai Art, Temari Jutsu\"?",
                                            "response": [
                                                {
                                                    "id": "722191008",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "Ah, it's a school of martial arts that we created ourselves with Grandpa Shousen's advice. The aim was to develop invincible martial arts using the Temari."
                                                },
                                                {
                                                    "id": "722191009",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "If we can use various methods to blast enemies away with explosive Temari, then we can win without even fighting!"
                                                },
                                                {
                                                    "id": "722191010",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon's very sure that that's not how you play Temari..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722191011",
                                            "text": "How many people are there in the Kujirai family?",
                                            "response": [
                                                {
                                                    "id": "722191012",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "Hmm, let me think..."
                                                },
                                                {
                                                    "id": "722191013",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "Besides my mom and dad, we have an eldest sister, named Momiji. She used to play with us a lot."
                                                },
                                                {
                                                    "id": "722191014",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "But ever since she got hooked on fishing, she won't play with us anymore. And she even says we'll scare the fish away!"
                                                },
                                                {
                                                    "id": "722191015",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "Then... how many brothers do I have? Honestly, I'm not too sure either..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722191016",
                                            "text": "About the adventurer you mentioned...",
                                            "response": [
                                                {
                                                    "id": "722191017",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "She's a very powerful Big Sister adventurer!"
                                                },
                                                {
                                                    "id": "722191018",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "She taught us how to play Temari, how to sing the Temari song, and how to use the Temari to blow up the bad guys!"
                                                },
                                                {
                                                    "id": "722191019",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "When she left, she said she was going somewhere far, far away to do something very important."
                                                },
                                                {
                                                    "id": "722191020",
                                                    "speaker": "Kid Kujirai",
                                                    "text": "That's why we have to study \"Temari Jutsu\" and help her in future!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722191021",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "722191022",
                                    "speaker": "Kid Kujirai",
                                    "text": "#Bye-bye, {F#big sis}{M#big bro}! Help me say hello if you see my brothers and sister!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}