            "dialogues": [
                {
                    "id": "678110101",
                    "speaker": "Lukova",
                    "text": "Please watch your step. If you fall while the train is moving, the Transport Bureau won't pay compensation."
                }
            ]
        },
        {
            "talkId": "6781102",
            "initDialog": "678110201",
            "dialogues": [
                {
                    "id": "678110201",
                    "speaker": "Player",
                    "text": "Then when does the Transport Bureau pay compensation?"
                },
                {
                    "id": "678110202",
                    "speaker": "Lukova",
                    "text": "Tch... you ask a lot of questions, passenger... The Transport Bureau compensates people when compensation is due..."
                },
                {
                    "id": "678110203",
                    "speaker": "Lukova",
                    "text": "As for exactly when that is, you'll know when you need to."
                }
            ]
        },
        {
            "talkId": "6781103",
            "initDialog": "678110301",
            "dialogues": [
                {
                    "id": "678110301",
                    "speaker": "Player",
                    "text": "Please excuse the interruption."
                },
                {
                    "id": "678110302",
                    "speaker": "Lukova",
                    "text": "No worries."
                }
            ]
        }
    ]
