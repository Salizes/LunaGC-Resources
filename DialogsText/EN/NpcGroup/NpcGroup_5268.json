{
    "groupId": "5268",
    "total_dialogue_lines": 88,
    "speaker_counts": {
        "Black Screen": 2,
        "Confused Kitty": 1,
        "Guijarro": 42,
        "Paimon": 17,
        "Player": 26
    },
    "talks": [
        {
            "talkId": "7005001",
            "initDialog": "700500101",
            "dialogues": [
                {
                    "id": "700500101",
                    "speaker": "Guijarro",
                    "text": "...This cat... Of course, that has to be it! Great, I just knew it!",
                    "choices": [
                        {
                            "id": "700500102",
                            "text": "Guijarro?",
                            "response": [
                                {
                                    "id": "700500103",
                                    "speaker": "Guijarro",
                                    "text": "#Huh? {NICKNAME}, Paimon, imagine running into you here! What're you doing in Qiaoying Village?"
                                },
                                {
                                    "id": "700500106",
                                    "speaker": "Paimon",
                                    "text": "Have you... finished writing your book? You wouldn't still happen to be imagining weird things, would you?",
                                    "choices": [
                                        {
                                            "id": "700500107",
                                            "text": "Or having symptoms of paranoia?",
                                            "response": [
                                                {
                                                    "id": "700500109",
                                                    "speaker": "Guijarro",
                                                    "text": "Oh, no, no! I've already finished writing that book. Right now, it's just a matter of waiting for \"The Courtcraft of Fontaine\" to get printed and go on sale."
                                                },
                                                {
                                                    "id": "700500110",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, Paimon's hooked just hearing the title! What's the book about?"
                                                },
                                                {
                                                    "id": "700500111",
                                                    "speaker": "Guijarro",
                                                    "text": "Let's see... it's about a cowardly detective and his fearless little sister, who's also acting as his assistant. They come across a \"Crime Museum,\" which hosts within it the evidence for countless crimes..."
                                                },
                                                {
                                                    "id": "700500112",
                                                    "speaker": "Guijarro",
                                                    "text": "Throughout the story, they also encounter missing twins, a meka puppet that cries, and a museum curator who's been drowned in his fountain... and in the end, they find out that the prime suspect is none other than a child who just turned three years old!",
                                                    "choices": [
                                                        {
                                                            "id": "700500113",
                                                            "text": "Okay, enough of that! I'm getting chills!",
                                                            "response": [
                                                                {
                                                                    "id": "700500115",
                                                                    "speaker": "Guijarro",
                                                                    "text": "Hahaha! Once it officially goes on sale, I'll send you both autographed copies."
                                                                },
                                                                {
                                                                    "id": "700500116",
                                                                    "speaker": "Paimon",
                                                                    "text": "Score! But... Paimon might be too scared to read it on her own..."
                                                                },
                                                                {
                                                                    "id": "700500117",
                                                                    "speaker": "Paimon",
                                                                    "text": "#It's decided then! {NICKNAME}, please read it to Paimon!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700500118",
                                                                            "text": "I—I'm also too scared...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700500119",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Really...? Then it looks like our only choice is to read it together!"
                                                                                },
                                                                                {
                                                                                    "id": "700500122",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "Come on, you two. No need to ham it up like that. It's just a crime novel, not a horror story."
                                                                                },
                                                                                {
                                                                                    "id": "700500123",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "As for something truly terrifying... I plan on writing a new novel. I've already made a rough outline, and I've been looking everywhere for new material to use as inspiration for the details."
                                                                                },
                                                                                {
                                                                                    "id": "700500124",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "...Hey, don't look at me like that! This time, all I want to do is combine the crime novel with some local folk tales. Even if we're collecting reference materials, there's no way I'll be all paranoid and jumpy like before.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "700500125",
                                                                                            "text": "Why not do this in Fontaine?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700500126",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "Ah, well... You see, many people have already written about Fontainian folklore, and I want to write something... a bit more original!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500129",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "It also just so happened that a friend of mine was planning to come here to check out the tea business, so I tagged along."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500130",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "No sooner had I stepped off the boat than I discovered some truly stellar subject matter! Just as I was considering how to best pursue the matter, you two came over."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500131",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "To borrow the local Liyue lingo, this would be... uh, um... \"destined to meet, though originally separated by more than a thousand miles\"?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500132",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Already adapting to the local culture, I see..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500133",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "How should Paimon put it... Well, maybe it's no wonder you're a great writer? You're so quick when it comes to understanding the local customs..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500134",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "But did you just say you've already found something? There's nothing here!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "700500135",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "Says who? Look! Do you not see this cat?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "700500136",
                                                                                                            "text": "Seen it from the start! But what's so strange about a cat?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "700500140",
                                                                                                                    "speaker": "Confused Kitty",
                                                                                                                    "text": "Meow...? Meeeow..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500141",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "Ah, you must be unaware. In the legends of Qiaoying Village, there are strange beasts known as \"Xuanwen Beasts.\""
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500142",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "According to the legends, these strange beasts appear like young cats and can sense good and evil, concealing themselves at night and rising with the sun, eating... uh... eating the wind and drinking the dew, crossing a thousand miles in a day, and gnawing tea trees at night to nourish themselves..."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500143",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "Anyway! That's what the article in \"Bedazzled!\" said, at least!",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "700500144",
                                                                                                                            "text": "You can tell from the name it's a load of tripe!",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "700500146",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Feels like whoever wrote that... All they heard was the name \"Xuanwen beast,\" and they just tossed every weird rumor they'd ever heard into a pot and started stirring!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500147",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Still, based on my own investigations, there are indeed \"Xuanwen beasts\" near Qiaoying Village, even if I'm still a bit fuzzy on the details... But as long as they exist, then I can study and use them!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500148",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Wow! Guijarro's completely different from before. She used to be so scared and timid..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500149",
                                                                                                                                    "speaker": "Player",
                                                                                                                                    "text": "And now, she came all the way here with nothing but a name to go on..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500150",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Hahaha! Apologies! It's one of my faults. As soon as I start writing, I'll find myself drawn into the same mindset as the book's characters."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500151",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "The protagonist of this book is a super-confident detective! So self-assured that you could say they consider everyone else to be beneath them..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500152",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Alrighty! That's enough blah-blah for now. I need to carefully research this little..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500153",
                                                                                                                                    "speaker": "Black Screen",
                                                                                                                                    "text": "The cat turns and flees like lightning..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500154",
                                                                                                                                    "speaker": "Guijarro",
                                                                                                                                    "text": "Whoa! It ran away, after it!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500155",
                                                                                                                                    "speaker": "Black Screen",
                                                                                                                                    "text": "Without another word, Guijarro breaks into a run, sprinting after the cat at breakneck speed..."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500156",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Not again! We've gotta catch up to her quickly, or who knows what kind of wacky hijinks Guijarro will get up to this time!"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "700500157",
                                                                                                                                    "speaker": "Paimon",
                                                                                                                                    "text": "Guijarro! Not so fast!"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "700500145",
                                                                                                                            "text": "Where did you dig up a tabloid like that?"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "700500137",
                                                                                                            "text": "Unless... it isn't a cat, and is instead...?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "700500138",
                                                                                                                    "speaker": "Guijarro",
                                                                                                                    "text": "You think so too!? I knew it, haha, great minds always think alike!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "700500139",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Nononono! Not at all! No matter what, it looks like it's just an ordinary little kitty!"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "700500127",
                                                                                            "text": "You came all the way to Qiaoying Village just to get some reference material...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "700500128",
                                                                                                    "speaker": "Guijarro",
                                                                                                    "text": "After all, Fontaine's folk tales have been written to death! I just want to write something original."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700500120",
                                                                            "text": "Leave it to me.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700500121",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yeah! You're the best."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700500114",
                                                            "text": "Sounds like quite the case..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700500108",
                                            "text": "We're not in Fontaine anymore. You're quite a ways from home."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700500104",
                            "text": "Is there... something wrong with this cat?",
                            "response": [
                                {
                                    "id": "700500105",
                                    "speaker": "Guijarro",
                                    "text": "#Ah, I believe it is... Eh? Huh? {NICKNAME}, Paimon, imagine running into you here! What are you doing in Qiaoying Village?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7480001",
            "initDialog": "748000101",
            "dialogues": [
                {
                    "id": "748000101",
                    "speaker": "Guijarro",
                    "text": "It can't be... It can't be..."
                },
                {
                    "id": "748000102",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "748000103",
                    "speaker": "Guijarro",
                    "text": "Ah! No! I swear I didn't do anything, please don't hurt me!"
                },
                {
                    "id": "748000104",
                    "speaker": "Paimon",
                    "text": "What are you talking about? Why would we want to hurt you?"
                },
                {
                    "id": "748000105",
                    "speaker": "Guijarro",
                    "text": "I don't know! But I also don't know that you won't really hurt me!",
                    "choices": [
                        {
                            "id": "748000106",
                            "text": "You're not making any sense...",
                            "response": [
                                {
                                    "id": "748000108",
                                    "speaker": "Guijarro",
                                    "text": "Oh! ...I've got it! It must be because I discovered your secret, right?"
                                },
                                {
                                    "id": "748000109",
                                    "speaker": "Guijarro",
                                    "text": "I... I took the newspaper with your secret letter hidden inside it in the coffee shop?"
                                },
                                {
                                    "id": "748000110",
                                    "speaker": "Guijarro",
                                    "text": "Or because I accidentally discovered your passphrase? Wait a moment, could it be that the fish I ate last night..."
                                },
                                {
                                    "id": "748000111",
                                    "speaker": "Guijarro",
                                    "text": "I say, the reason that the fish had so few bones is because you already deboned that fish!"
                                },
                                {
                                    "id": "748000112",
                                    "speaker": "Guijarro",
                                    "text": "Yes, yes, you wish to use the difference in the number of bones in each fish to send a message... But I accidentally bought this one and brought it back home with me..."
                                },
                                {
                                    "id": "748000113",
                                    "speaker": "Paimon",
                                    "text": "What the heck is this girl talking about? Paimon can't make heads or tails of it...",
                                    "choices": [
                                        {
                                            "id": "748000114",
                                            "text": "I won't hurt you.",
                                            "response": [
                                                {
                                                    "id": "748000116",
                                                    "speaker": "Guijarro",
                                                    "text": "Y—You really aren't out to hurt me?"
                                                },
                                                {
                                                    "id": "748000117",
                                                    "speaker": "Paimon",
                                                    "text": "What's with you!? We've only just met you, why would we want to hurt you?"
                                                },
                                                {
                                                    "id": "748000118",
                                                    "speaker": "Guijarro",
                                                    "text": "R—Really? I'm... I'm glad. And I'm really sorry, how embarrassing..."
                                                },
                                                {
                                                    "id": "748000119",
                                                    "speaker": "Guijarro",
                                                    "text": "I've been working hard on a detective novel recently, but I still don't know what methodology the criminal should use to commit their crime!"
                                                },
                                                {
                                                    "id": "748000120",
                                                    "speaker": "Guijarro",
                                                    "text": "And because I am always overthinking things, so... Now when I look at anything, my first reaction is to consider how it could be used to... you know, commit crimes."
                                                },
                                                {
                                                    "id": "748000121",
                                                    "speaker": "Guijarro",
                                                    "text": "*sigh* That's why I was... so nervous just now. I truly am sorry. Maybe I have become what they call \"paranoid\" now."
                                                },
                                                {
                                                    "id": "748000122",
                                                    "speaker": "Guijarro",
                                                    "text": "I was about to ride the aquabus into the city for a cup of coffee, but when I saw aquabus running..."
                                                },
                                                {
                                                    "id": "748000123",
                                                    "speaker": "Guijarro",
                                                    "text": "I... I immediately saw countless possibilities, all the ways I could be killed on an aquabus! I simply didn't dare to board.",
                                                    "choices": [
                                                        {
                                                            "id": "748000124",
                                                            "text": "You said yourself it was only paranoia.",
                                                            "response": [
                                                                {
                                                                    "id": "748000126",
                                                                    "speaker": "Guijarro",
                                                                    "text": "That may be so. But I simply cannot stop thinking about it, and the more I think, the more afraid I become...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "748000127",
                                                                            "text": "I'll accompany you...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "748000129",
                                                                                    "speaker": "Guijarro",
                                                                                    "text": "Really!? Amazing, but... What if the people who want to hurt me hurt you too?"
                                                                                },
                                                                                {
                                                                                    "id": "748000130",
                                                                                    "speaker": "Player",
                                                                                    "text": "You just try to relax..."
                                                                                },
                                                                                {
                                                                                    "id": "748000131",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Come on, come on! Stop overthinking it. No matter what the problem is, {NICKNAME} can handle it, easy peasy!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "748000128",
                                                                            "text": "I'll escort you there."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "748000125",
                                                            "text": "There's no way that'd happen, stop overthinking it."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "748000115",
                                            "text": "Don't be so paranoid."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "748000107",
                            "text": "What are you talking about?"
                        }
                    ]
                }
            ]
        }
    ]
}