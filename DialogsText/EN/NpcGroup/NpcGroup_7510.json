    "talks": [
        {
            "talkId": "6751001",
            "initDialog": "675100101",
            "dialogues": [
                {
                    "id": "675100101",
                    "speaker": "Yaroslav",
                    "text": "Stay indoors and still travel the world — right here in Snezhnaya! We've got everything!"
                }
            ]
        },
        {
            "talkId": "6751002",
            "initDialog": "675100201",
            "dialogues": [
                {
                    "id": "675100201",
                    "speaker": "Player",
                    "text": "Everything?"
                },
                {
                    "id": "675100202",
                    "speaker": "Yaroslav",
                    "text": "Everything! The sights and goods of nations across the world. You can find them all here."
                },
                {
                    "id": "675100203",
                    "speaker": "Yaroslav",
                    "text": "Inazuman novels, Sumeru research collections, Fontaine tea pastries, Natlan pigments..."
                },
                {
                    "id": "675100204",
                    "speaker": "Yaroslav",
                    "text": "With just a small amount of Mora, what you gain here might even surpass what those traveling adventurers bring back!"
                }
            ]
        },
        {
            "talkId": "6751003",
            "initDialog": "675100301",
            "dialogues": [
                {
                    "id": "675100301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "675100302",
                    "speaker": "Yaroslav",
                    "text": "Farewell."
                }
            ]
        },
        {
            "talkId": "6751004",
            "initDialog": "675100401",
            "dialogues": [
                {
                    "id": "675100401",
                    "speaker": "Player",
                    "text": "No local Snezhnayan goods?"
                },
                {
                    "id": "675100402",
                    "speaker": "Yaroslav",
                    "text": "Ah, I see you're not from around here, so let me be honest. What I really do is local business — for local people."
                },
                {
                    "id": "675100403",
                    "speaker": "Yaroslav",
                    "text": "On this vast land, most people spend their entire lives without ever crossing Snezhnaya's borders."
                },
                {
                    "id": "675100404",
                    "speaker": "Yaroslav",
                    "text": "But that doesn't mean they aren't curious about the outside world. It doesn't mean they don't long for something different."
                },
                {
                    "id": "675100405",
                    "speaker": "Yaroslav",
                    "text": "These little foreign curiosities — affordable, yet enough to weave a strange and distant dream..."
                },
                {
                    "id": "675100406",
                    "speaker": "Yaroslav",
                    "text": "As they say, where there's demand, there's a market. Right?"
                }
            ]
        },
        {
            "talkId": "6751005",
            "initDialog": "675100501",
            "dialogues": [
                {
                    "id": "675100501",
                    "speaker": "Player",
                    "text": "I've actually been to those places. All of them."
                },
                {
                    "id": "675100502",
                    "speaker": "Yaroslav",
                    "text": "Then you are truly fortunate — a brave and wise adventurer, no doubt."
                },
                {
                    "id": "675100503",
                    "speaker": "Yaroslav",
                    "text": "But there are many who will never leave Snezhnaya in their entire lives."
                },
                {
                    "id": "675100504",
                    "speaker": "Yaroslav",
                    "text": "Perhaps what I sell are only ordinary trinkets, but for them, it may be the fastest way to glimpse a foreign world."
                }
            ]
        },
