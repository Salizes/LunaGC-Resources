        {
            "talkId": "6751008",
            "initDialog": "675100801",
            "dialogues": [
                {
                    "id": "675100801",
                    "speaker": "Player",
                    "text": "Let's see what you've got..."
                },
                {
                    "id": "675100802",
                    "speaker": "Yaroslav",
                    "text": "Certainly! Now, I got all these from outside... lots of them are \"relics.\" The genuine article!"
                }
