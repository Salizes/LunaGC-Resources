    "talks": [
        {
            "talkId": "6957701",
            "initDialog": "695770101",
            "dialogues": [
                {
                    "id": "695770101",
                    "speaker": "Sigewinne",
                    "text": "When people play cards, their expressions are tense one moment, then relaxed the next... It's fascinating to watch!"
                }
            ]
        },
        {
            "talkId": "6957702",
            "initDialog": "695770201",
            "dialogues": [
                {
                    "id": "695770201",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957703",
            "initDialog": "695770301",
            "dialogues": [
                {
                    "id": "695770301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "695770302",
                    "speaker": "Sigewinne",
                    "text": "See you! I'll be heading back soon myself. It's just... the people here have been playing cards for too long. They should really get some rest! Hmm... maybe a sedative would do the trick?"
                }
            ]
        },
        {
            "talkId": "6957704",
            "initDialog": "695770401",
            "dialogues": [
                {
                    "id": "695770401",
                    "speaker": "Sigewinne",
                    "text": "Looks like I won this round. But, it's all in the past now, so no need to overanalyze your mistakes. If you're feeling up to it, let's have a rematch!"
                }
            ]
        },
        {
            "talkId": "6957705",
            "initDialog": "695770501",
            "dialogues": [
                {
                    "id": "695770501",
                    "speaker": "Sigewinne",
                    "text": "Great job! You think very clearly and your judgment's spot on... Up for a rematch? Just remember, you can't play cards all the time. You've got to get some proper rest too!"
                }
            ]
        },
        {
            "talkId": "6957706",
            "initDialog": "695770601",
            "dialogues": [
                {
                    "id": "695770601",
                    "speaker": "Sigewinne",
                    "text": "Oh, a game of cards? Count me in! Just remember to keep calm and don't put too much pressure on yourself."
                }
            ]
        },
        {
            "talkId": "6957708",
            "initDialog": "695770801",
            "dialogues": [
                {
                    "id": "695770801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957709",
            "initDialog": "695770901",
            "dialogues": [
                {
                    "id": "695770901",
                    "speaker": "Player",
                    "text": "Adjust the deck first..."
                }
            ]
        },
        {
            "talkId": "6957710",
            "initDialog": "695771001",
            "dialogues": [
                {
                    "id": "695771001",
                    "speaker": "Sigewinne",
                    "text": "Phew... My heart was racing there, but I won in the end! That wasn't easy."
                }
            ]
        },
        {
            "talkId": "6957711",
            "initDialog": "695771101",
            "dialogues": [
                {
                    "id": "695771101",
                    "speaker": "Sigewinne",
                    "text": "You won! Go ahead, give me a smile! Hehe, that's more like it!"
                }
            ]
        },
        {
            "talkId": "6957712",
            "initDialog": "695771201",
            "dialogues": [
                {
                    "id": "695771201",
                    "speaker": "Sigewinne",
                    "text": "Alright, another round it is! But before we start, let's take a few deep breaths... Let go of those nerves."
                }
            ]
        },
        {
            "talkId": "6957714",
            "initDialog": "695771401",
            "dialogues": [
                {
                    "id": "695771401",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957715",
            "initDialog": "695771501",
            "dialogues": [
                {
                    "id": "695771501",
                    "speaker": "Player",
                    "text": "Adjust the deck first..."
                }
            ]
        },
        {
            "talkId": "6957716",
            "initDialog": "695771601",
            "dialogues": [
                {
                    "id": "695771601",
                    "speaker": "Sigewinne",
                    "text": "Hey, don't look so down! It's just a game, remember? We can always play another round if you'd like."
                }
            ]
        },
        {
            "talkId": "6957717",
            "initDialog": "695771701",
            "dialogues": [
                {
                    "id": "695771701",
                    "speaker": "Sigewinne",
                    "text": "Whoa, careful! I know you're happy, but you could hurt yourself jumping around like that. Did you bump your knee? Let me take a look..."
                }
            ]
        },
        {
            "talkId": "6957718",
            "initDialog": "695771801",
            "dialogues": [
                {
                    "id": "695771801",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                }
            ]
        }
    ]
