    "talks": [
        {
            "talkId": "7103720",
            "initDialog": "710372001",
            "dialogues": [
                {
                    "id": "710372001",
                    "speaker": "Simple Bulletin Board",
                    "text": "\"We, the Chasm Exploration Team, have made this place our temporary base camp. All members, please pay attention to act within safety parameters at all times. Do not act alone without permission, and do not touch any unknown materials within the depths of The Chasm!\"",
                    "choices": [
                        {
                            "id": "710372002",
                            "text": "Continue Reading...",
                            "response": [
                                {
                                    "id": "710372004",
                                    "speaker": "Message",
                                    "text": "\"Recently, we have discovered an unknown black mud-like substance in part of the main mining area. It is exceedingly dangerous. All spelunkers must be on double guard. Be sure to avoid areas tainted by this substance. If you have any questions, please ask Zhiqiong to show you the way around.\"",
                                    "choices": [
                                        {
                                            "id": "710372005",
                                            "text": "Continue Reading...",
                                            "response": [
                                                {
                                                    "id": "710372007",
                                                    "speaker": "Message",
                                                    "text": "\"Taliesin's shoes have gotten wet. Could we ask the resupply team to send down some changes of clothes and shoes?\""
                                                },
                                                {
                                                    "id": "710372008",
                                                    "speaker": "Message",
                                                    "text": "\"Also, Jinwu needs a set of backup tools with which to process the Lumenstone Adjuvants. Could the resupply team please send these over as soon as possible? Thanks!\"",
                                                    "choices": [
                                                        {
                                                            "id": "710372009",
                                                            "text": "Continue Reading...",
                                                            "response": [
                                                                {
                                                                    "id": "710372011",
                                                                    "speaker": "Incomplete Note",
                                                                    "text": "(This half-torn sheet of paper is filled with complex mathematical workings and geometry. They seem to have something to do with astrology...)",
                                                                    "choices": [
                                                                        {
                                                                            "id": "710372012",
                                                                            "text": "Continue Reading...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "710372014",
                                                                                    "speaker": "Memo",
                                                                                    "text": "\"The 'Mountainator' cannon within the main mining area seems to remain undamaged. We should be able to use this to open up a path and save ourselves significant amounts of time exploring this place.\""
                                                                                },
                                                                                {
                                                                                    "id": "710372015",
                                                                                    "speaker": "Memo",
                                                                                    "text": "\"However, we need to first clear the area of roving bandits. Fortunately, there's good news: the Millelith are already on the move cutting off their links with Treasure Hoarders on the surface.\""
                                                                                },
                                                                                {
                                                                                    "id": "710372016",
                                                                                    "speaker": "Memo",
                                                                                    "text": "\"If their connection to the surface is cut, the Treasure Hoarders underground will likely fall back of their own accord...\""
                                                                                },
                                                                                {
                                                                                    "id": "710372017",
                                                                                    "speaker": "Exploration Team Campsite Noticeboard",
                                                                                    "text": "\"We need more supplies of vegetables. Also, having stayed down here without sunlight for too long, everyone needs eggs, mushrooms, and fish to keep themselves nourished.\"",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "710372018",
                                                                                            "text": "Continue Reading...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "710372020",
                                                                                                    "speaker": "Old Notice",
                                                                                                    "text": "(This notice is very old indeed. It seems to have been put up by miners well before the exploration team ever arrived on the scene.)"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710372021",
                                                                                                    "speaker": "Old Notice",
                                                                                                    "text": "\"The mines are a sprawling, complex place. Ensure that you carry a finch cage with you at all times while navigating any narrow spaces within in case of any leakage of poisonous or flammable gasses! Do not forget what our comrade Erge taught us!\"",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "710372022",
                                                                                                            "text": "Continue Reading...",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "710372024",
                                                                                                                    "speaker": "Incomplete Note",
                                                                                                                    "text": "(The edges of this incomplete sheet of paper have been charred a deep brown. It seems that someone read this under torchlight without keeping a safe distance...)"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "710372025",
                                                                                                                    "speaker": "Incomplete Note",
                                                                                                                    "text": "\"All miners have been equipped with specialized crystal lamps, so please do not bring flaming torches down into the mines. Additionally, professionals will direct you as to where you might start a fire. Please do not strike camp by yourself if you are unfamiliar with the terrain...\"",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "710372026",
                                                                                                                            "text": "Continue Reading...",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "710372028",
                                                                                                                                    "speaker": "Miner's Message",
                                                                                                                                    "text": "\"Please observe strict order while you disperse. Take your personal belongings with you and do not panic. Once the signal arrives from the surface, you may start leaving gradually in small groups!\""
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "710372029",
                                                                                                                                    "speaker": "Miner's Message",
                                                                                                                                    "text": "\"As for all those who have gone too near to the 'crystal fragment,' please report to the medical team immediately, regardless of whether you had a negative reaction or not, and leave The Chasm as soon as possible!\""
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "710372030",
                                                                                                                                    "speaker": "Miner's Message",
                                                                                                                                    "text": "\"Comrades, please do not panic and follow the higher-ups' announcements!\"",
                                                                                                                                    "choices": [
                                                                                                                                        {
                                                                                                                                            "id": "710372031",
                                                                                                                                            "text": "Continue Reading...",
                                                                                                                                            "response": [
                                                                                                                                                {
                                                                                                                                                    "id": "710372033",
                                                                                                                                                    "speaker": "Covered Message",
                                                                                                                                                    "text": "(This announcement and the messages written under it have been partially covered by newer notices. This might have been put up not long after the mines were sealed.)"
                                                                                                                                                },
                                                                                                                                                {
                                                                                                                                                    "id": "710372034",
                                                                                                                                                    "speaker": "Covered Message",
                                                                                                                                                    "text": "\"After the 'crystal fragment' was discovered, the amount of Lumenstone Ore present increased rapidly. As for its benefits or potential risks, we require the exploration team to further confirm them...\"",
                                                                                                                                                    "choices": [
                                                                                                                                                        {
                                                                                                                                                            "id": "710372035",
                                                                                                                                                            "text": "Continue Reading...",
                                                                                                                                                            "response": [
                                                                                                                                                                {
                                                                                                                                                                    "id": "710372037",
                                                                                                                                                                    "speaker": "Battered Namelist",
                                                                                                                                                                    "text": "(This old namelist seems to have been left here by the very first exploration team sent after the mine was sealed.)"
                                                                                                                                                                },
                                                                                                                                                                {
                                                                                                                                                                    "id": "710372038",
                                                                                                                                                                    "speaker": "Battered Namelist",
                                                                                                                                                                    "text": "\"We would like to invite the following professional staff to set up camp here to take samples, do research and learn how we might appropriately utilize Lumenstone:\""
                                                                                                                                                                },
                                                                                                                                                                {
                                                                                                                                                                    "id": "710372039",
                                                                                                                                                                    "speaker": "Battered Namelist",
                                                                                                                                                                    "text": "\"...Deputy Research Director, Jinwu. Experiment Assistant, Azadi... Explorers, He Zhi, He Wei...\""
                                                                                                                                                                }
                                                                                                                                                            ]
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "id": "710372036",
                                                                                                                                                            "text": "Leave"
                                                                                                                                                        }
                                                                                                                                                    ]
                                                                                                                                                }
                                                                                                                                            ]
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "710372032",
                                                                                                                                            "text": "Leave"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "710372027",
                                                                                                                            "text": "Leave"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
