    "talks": [
        {
            "talkId": "6601801",
            "initDialog": "660180101",
            "dialogues": [
                {
                    "id": "660180101",
                    "speaker": "Askia",
                    "text": "May blazing fruits never fall from their branches."
                }
            ]
        },
        {
            "talkId": "6601802",
            "initDialog": "660180201",
            "dialogues": [
                {
                    "id": "660180201",
                    "speaker": "Player",
                    "text": "Hello."
                },
                {
                    "id": "660180202",
                    "speaker": "Askia",
                    "text": "Hello, have you come to see the Sacred Flame too?"
                },
                {
                    "id": "660180203",
                    "speaker": "Askia",
                    "text": "Like an apple that hangs from the treetop, it is the very first flame to be won after victory in battle... It is also the final flame with which all corruption shall be incinerated..."
                },
                {
                    "id": "660180204",
                    "speaker": "Askia",
                    "text": "The Stele of the Sacred Flame was a blessing bestowed on Natlan by the heavens. Come, friend, pray with me."
                },
                {
                    "id": "660180205",
                    "speaker": "Askia",
                    "text": "May the Sacred Flame never fall; may the fruits of victory forever endure."
                }
            ]
        },
        {
            "talkId": "6601803",
            "initDialog": "660180301",
            "dialogues": [
                {
                    "id": "660180301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "660180302",
                    "speaker": "Askia",
                    "text": "Goodbye."
                }
            ]
        },
        {
            "talkId": "7591001",
            "initDialog": "759100101",
            "dialogues": [
                {
                    "id": "759100101",
                    "speaker": "Player",
                    "text": "(Pray in silence.)"
                },
                {
                    "id": "759100102",
                    "speaker": "Askia",
                    "text": "Here, give me your hand."
                },
                {
                    "id": "759100103",
                    "speaker": "Askia",
                    "text": "Don't worry, there's no special meaning to it. I just thought that obsidian really suits you."
                }
            ]
        }
    ]
}