    "talks": [
        {
            "talkId": "6741301",
            "initDialog": "674130101",
            "dialogues": [
                {
                    "id": "674130101",
                    "speaker": "Zyryanov",
                    "text": "Drinks! Tasty and affordable drinks! Feeling thirsty? Have a sip — it'll warm you up right double quick!"
                }
            ]
        },
        {
            "talkId": "6741302",
            "initDialog": "674130201",
            "dialogues": [
                {
                    "id": "674130201",
                    "speaker": "Player",
                    "text": "What drinks do you have?"
                },
                {
                    "id": "674130202",
                    "speaker": "Zyryanov",
                    "text": "...Hehe, oh, might as well ask me what we don't have! Check it out!"
                }
            ]
        },
        {
            "talkId": "6741303",
            "initDialog": "674130301",
            "dialogues": [
                {
                    "id": "674130301",
                    "speaker": "Player",
                    "text": "Good value, I presume?"
                },
                {
                    "id": "674130302",
                    "speaker": "Zyryanov",
                    "text": "Oh, as much as you could imagine! ... But these are the official prices, see. If you've got... requirements, I can quote you a special price..."
                }
            ]
        },
        {
            "talkId": "6741304",
            "initDialog": "674130401",
            "dialogues": [
                {
                    "id": "674130401",
                    "speaker": "Player",
                    "text": "I've not got any cravings for drink right now..."
                },
                {
                    "id": "674130402",
                    "speaker": "Zyryanov",
                    "text": "Ah, not to worry! If the mood takes you, come find me!"
                }
            ]
        },
        {
            "talkId": "6741305",
            "initDialog": "674130501",
            "dialogues": [
                {
                    "id": "674130501",
                    "speaker": "Player",
                    "text": "By \"special,\" you mean \"cheaper\"?"
                },
                {
                    "id": "674130502",
                    "speaker": "Zyryanov",
                    "text": "Hehe, that's how we run things around here, aye. Now, some buddies of mine made these themselves..."
                },
                {
                    "id": "674130503",
                    "speaker": "Zyryanov",
                    "text": "Stronger stuff it is, despite the milder flavor, and they cause a little upset from time to time... but you know what, it is cheaper."
                }
            ]
        },
        {
            "talkId": "6741306",
            "initDialog": "674130601",
            "dialogues": [
                {
                    "id": "674130601",
                    "speaker": "Player",
                    "text": "Err, forget it. Guess you get what you pay for..."
                },
                {
                    "id": "674130602",
                    "speaker": "Zyryanov",
                    "text": "That's how it is. The legit stuff doesn't come packed from the factories without extra cost, you know!"
                }
            ]
        },
        {
            "talkId": "6741307",
            "initDialog": "674130701",
            "dialogues": [
                {
                    "id": "674130701",
                    "speaker": "Player",
                    "text": "Errr, I think I'll pass..."
                },
                {
                    "id": "674130702",
                    "speaker": "Zyryanov",
                    "text": "All good, all good. If you ever wanna try some, give me a hoot, and I'll show you some good rates!"
                }
            ]
        },
        {
            "talkId": "6741308",
            "initDialog": "674130801",
