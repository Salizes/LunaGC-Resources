    "talks": [
        {
            "talkId": "6411701",
            "initDialog": "641170101",
            "dialogues": [
                {
                    "id": "641170101",
                    "speaker": "Fariba",
                    "text": "Welcome."
                }
            ]
        },
        {
            "talkId": "6411702",
            "initDialog": "641170201",
            "dialogues": [
                {
                    "id": "641170201",
                    "speaker": "Player",
                    "text": "What are you selling?"
                },
                {
                    "id": "641170202",
                    "speaker": "Fariba",
                    "text": "Well... I'm not familiar with every single product. Everything's displayed in the store for customers to check themselves."
                },
                {
                    "id": "641170203",
                    "speaker": "Fariba",
                    "text": "And there are some daily necessities here..."
                },
                {
                    "id": "641170204",
                    "speaker": "Fariba",
                    "text": "Blankets, spatulas, umbrellas, glasses, stuff like that..."
                }
            ]
        },
        {
            "talkId": "6411703",
            "initDialog": "641170301",
            "dialogues": [
                {
                    "id": "641170301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641170302",
                    "speaker": "Fariba",
                    "text": "Take care."
                }
            ]
        },
        {
            "talkId": "6411704",
            "initDialog": "641170401",
            "dialogues": [
                {
                    "id": "641170401",
                    "speaker": "Player",
                    "text": "How much is an umbrella?"
                },
                {
                    "id": "641170402",
                    "speaker": "Fariba",
                    "text": "Huh? There's no price tag on it?"
                },
                {
                    "id": "641170403",
                    "speaker": "Fariba",
                    "text": "Hmm, umbrella, umbrella..."
                },
                {
                    "id": "641170404",
                    "speaker": "Fariba",
                    "text": "*sigh* I can't remember the price."
                },
                {
                    "id": "641170405",
                    "speaker": "Fariba",
                    "text": "Why don't you look for something else?"
                }
            ]
        },
        {
            "talkId": "6411705",
            "initDialog": "641170501",
            "dialogues": [
                {
                    "id": "641170501",
                    "speaker": "Player",
                    "text": "...Are you able to make any sales like that?"
                },
                {
                    "id": "641170502",
                    "speaker": "Fariba",
                    "text": "I seem to be doing... okay? I don't keep the books, so I'm not quite sure about this."
                },
                {
                    "id": "641170503",
                    "speaker": "Fariba",
                    "text": "A few customers come to our shop every day, but none of them are regular."
                },
                {
                    "id": "641170504",
                    "speaker": "Fariba",
                    "text": "A little girl often comes to the manager for business. That's the only familiar face I can remember."
                },
                {
                    "id": "641170505",
                    "speaker": "Fariba",
                    "text": "But I don't know what goods she delivers..."
                },
                {
                    "id": "641170506",
                    "speaker": "Fariba",
                    "text": "The manager seems to be very respectful to her, but never displays what she's delivered to the store."
                }
            ]
        }
    ]
}