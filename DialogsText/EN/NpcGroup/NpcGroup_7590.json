    },
    "talks": [
        {
            "talkId": "6759001",
            "initDialog": "675900101",
            "dialogues": [
                {
                    "id": "675900101",
                    "speaker": "Mayskaya",
                    "text": "Welcome. You can play the latest edition of Bing-Bang Finchball here. Finches are so adorable, so please give it a try."
                }
            ]
        },
        {
            "talkId": "6759002",
            "initDialog": "675900201",
            "dialogues": [
                {
                    "id": "675900201",
                    "speaker": "Player",
                    "text": "O-Okay... I'd like to try."
                },
                {
                    "id": "675900202",
                    "speaker": "Mayskaya",
                    "text": "The preparation area is this way. The gameplay manual is on the table. Please read through it yourself."
                },
                {
                    "id": "675900203",
                    "speaker": "Mayskaya",
                    "text": "Enjoy! Trust me, finches are really adorable."
                }
            ]
        },
        {
            "talkId": "6759003",
            "initDialog": "675900301",
            "dialogues": [
                {
                    "id": "675900301",
                    "speaker": "Player",
                    "text": "Huh? I thought Basima would be here..."
                },
                {
                    "id": "675900302",
                    "speaker": "Mayskaya",
                    "text": "Basima is designing new Finchballs and can't come in person for the time being, so I'm managing the stall in her place."
                },
                {
                    "id": "675900303",
                    "speaker": "Mayskaya",
                    "text": "...Please forgive me if my expression makes you uneasy. I'm not upset, nor am I in a bad mood. I have simply... grown used to not showing any expression."
                },
                {
                    "id": "675900304",
                    "speaker": "Mayskaya",
                    "text": "I tried forcing myself to smile, but it seemed to startle Shatskaya when she came to play Bing-Bang Finchball."
                },
                {
                    "id": "675900305",
                    "speaker": "Mayskaya",
                    "text": "After that, I thought it would be better to remain expressionless..."
                },
                {
                    "id": "675900306",
                    "speaker": "Mayskaya",
                    "text": "Basima told me that I smile very naturally when I pet finches, but I have never noticed it myself."
                },
                {
                    "id": "675900307",
                    "speaker": "Mayskaya",
                    "text": "Still, when touching creatures as adorable as finches, it is only natural to smile. Should the opportunity arise, please spend more time with finches as well."
                },
                {
                    "id": "675900308",
                    "speaker": "Mayskaya",
                    "text": "After all, finches are the cutest."
                }
            ]
        },
        {
            "talkId": "6759004",
            "initDialog": "675900401",
            "dialogues": [
                {
                    "id": "675900401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "675900402",
                    "speaker": "Mayskaya",
                    "text": "Goodbye. Please come by anytime if you wish to play Bing-Bang Finchball."
                }
            ]
        },
