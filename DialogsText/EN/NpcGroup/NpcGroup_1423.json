            "dialogues": [
                {
                    "id": "614230901",
                    "speaker": "Blanche",
                    "text": "How watertight... I have seen what you can do."
                }
            ]
        },
        {
            "talkId": "6142310",
            "initDialog": "614231001",
            "dialogues": [
                {
                    "id": "614231001",
                    "speaker": "Blanche",
                    "text": "You snooze, you lose."
                }
            ]
        },
        {
            "talkId": "40165",
            "initDialog": "4015142351",
            "dialogues": [
                {
                    "id": "4015142351",
                    "speaker": "Blanche",
                    "text": "Hey there! We have quality goods at honest prices!"
                }
            ]
        },
        {
            "talkId": "41704",
            "initDialog": "4015142302",
            "dialogues": [
                {
                    "id": "4015142302",
                    "speaker": "Player",
                    "text": "What do you have for sale here?"
                },
                {
                    "id": "4015142306",
                    "speaker": "Blanche",
                    "text": "Please have a look around."
                }
            ]
        },
        {
            "talkId": "41705",
            "initDialog": "4015142313",
            "dialogues": [
                {
                    "id": "4015142313",
                    "speaker": "Player",
                    "text": "I'd like to ask about something."
                },
                {
                    "id": "4015142314",
                    "speaker": "Blanche",
                    "text": "I'm listening.",
                    "choices": [
                        {
                            "id": "4015142303",
                            "text": "What makes Mondstadt General Goods special?",
                            "response": [
                                {
                                    "id": "4015142307",
                                    "speaker": "Blanche",
                                    "text": "Our shop may be small, but we do have a warehouse in Liyue Harbor."
                                },
                                {
                                    "id": "4015142308",
                                    "speaker": "Blanche",
                                    "text": "We take pride in having the largest catalog of items and the fastest shipping in all of Mondstadt."
                                }
                            ]
                        },
                        {
                            "id": "4015142304",
                            "text": "What is Mondstadt known for?",
                            "response": [
                                {
                                    "id": "4015142309",
                                    "speaker": "Blanche",
                                    "text": "Mondstadt is a city known for its wines. Taverns are where you'd want to go."
                                },
                                {
                                    "id": "4015142310",
                                    "speaker": "Blanche",
                                    "text": "Most dwellers here go to one of the taverns for a drink after a hard day's work."
                                },
                                {
                                    "id": "4015142311",
                                    "speaker": "Blanche",
                                    "text": "You can meet all sorts of people in the taverns at night."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "41706",
            "initDialog": "4015142305",
            "dialogues": [
                {
                    "id": "4015142305",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "4015142312",
                    "speaker": "Blanche",
                    "text": "Thank you for coming to Mondstadt General Goods. Be sure to visit again!"
                }
            ]
        },
