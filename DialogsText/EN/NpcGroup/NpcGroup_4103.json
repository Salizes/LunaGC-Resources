        },
        {
            "talkId": "6410302",
            "initDialog": "641030201",
            "dialogues": [
                {
                    "id": "641030201",
                    "speaker": "Player",
                    "text": "What are you singing?"
                },
                {
                    "id": "641030202",
                    "speaker": "Nima",
                    "text": "It's a song I wrote myself!"
                },
                {
                    "id": "641030203",
                    "speaker": "Nima",
                    "text": "Maybe Raranana would visit me again if they heard the song."
                }
            ]
        },
        {
            "talkId": "6410303",
            "initDialog": "641030301",
            "dialogues": [
                {
                    "id": "641030301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641030302",
                    "speaker": "Nima",
                    "text": "Raranana, Raranana, when will I see you again!"
                }
            ]
        },
        {
            "talkId": "6410304",
            "initDialog": "641030401",
            "dialogues": [
                {
                    "id": "641030401",
                    "speaker": "Player",
                    "text": "Who's Raranana?"
                },
                {
                    "id": "641030402",
                    "speaker": "Nima",
                    "text": "Small, round friends."
                },
                {
                    "id": "641030403",
                    "speaker": "Nima",
                    "text": "Raranana would appear when the adults aren't around, just like me slacking off farming work."
                },
                {
                    "id": "641030404",
                    "speaker": "Nima",
                    "text": "But Minoo always made fun of me all the time for believing in Raranana, and got mad at me for saying the name wrong."
                },
                {
                    "id": "641030405",
                    "speaker": "Nima",
                    "text": "I've seen Raranana with my own eyes, though... They're the weedfolk, so Raranana does exist for sure."
                }
            ]
        }
    ]
}