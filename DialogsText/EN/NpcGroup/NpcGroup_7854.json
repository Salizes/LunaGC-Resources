    "talks": [
        {
            "talkId": "6785401",
            "initDialog": "678540101",
            "dialogues": [
                {
                    "id": "678540101",
                    "speaker": "Obolensky",
                    "text": "Just holding on here... There is nothing we cannot overcome, I'm sure!"
                }
            ]
        },
        {
            "talkId": "6785402",
            "initDialog": "678540201",
            "dialogues": [
                {
                    "id": "678540201",
                    "speaker": "Player",
                    "text": "\"Holding on\"...?"
                },
                {
                    "id": "678540202",
                    "speaker": "Obolensky",
                    "text": "That's right! That's how you live to see another day, and then the next, isn't it?"
                },
                {
                    "id": "678540203",
                    "speaker": "Obolensky",
                    "text": "I'm from a tiny village out in the middle of nowhere. There, the river stays frozen most of the year, and there was hardly ever enough food."
                },
                {
                    "id": "678540204",
                    "speaker": "Obolensky",
                    "text": "In a place like that, all a person can do is endure and keep enduring. In the end, I found a way to come to Sretomorozsk and make a life here."
                },
                {
                    "id": "678540206",
                    "speaker": "Obolensky",
                    "text": "Things may be hard here now, but they're still better than they were back in my village. So what is there for me to complain about?"
                },
                {
                    "id": "678540207",
                    "speaker": "Obolensky",
                    "text": "So I'll just keep holding on! That's just how life is. We'll just have to learn to endure and to work harder, and one day, we will see the light at the end of the tunnel."
                }
            ]
        },
        {
