    "talks": [
        {
            "talkId": "6418701",
            "initDialog": "641870101",
            "dialogues": [
                {
                    "id": "641870101",
                    "speaker": "Arapandu",
                    "text": "Golden Nara always helps Aranara out of trouble, too bad there are too few Golden Nara."
                }
            ]
        },
        {
            "talkId": "6418702",
            "initDialog": "641870201",
            "dialogues": [
                {
                    "id": "641870201",
                    "speaker": "Player",
                    "text": "About Golden Nara..."
                },
                {
                    "id": "641870202",
                    "speaker": "Arapandu",
                    "text": "Arapandu has seen many Nara, a lot of bad Nara, they are tall and suspicious."
                },
                {
                    "id": "641870203",
                    "speaker": "Arapandu",
                    "text": "#But Golden Nara, not many. Only Nara Varuna, and Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6418703",
            "initDialog": "641870301",
            "dialogues": [
                {
                    "id": "641870301",
                    "speaker": "Player",
                    "text": "About Vimara Village..."
                },
                {
                    "id": "641870302",
                    "speaker": "Arapandu",
                    "text": "Strange things at Vimara Village, Arana knows."
                },
                {
                    "id": "641870303",
                    "speaker": "Arapandu",
                    "text": "But she is using Ararakalari, to protect Narana. After Festival Utsava, you can try finding the answer."
                }
            ]
        },
        {
            "talkId": "6418704",
            "initDialog": "641870401",
            "dialogues": [
                {
                    "id": "641870401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641870402",
                    "speaker": "Arapandu",
                    "text": "Bye, Golden Nara."
                }
            ]
        },
        {
            "talkId": "6418705",
            "initDialog": "641870501",
            "dialogues": [
                {
                    "id": "641870501",
                    "speaker": "Arapandu",
                    "text": "#Varuna Contraption, with the sun shining; and {NICKNAME} Contraption, with the moon shining?"
                }
            ]
        },
        {
            "talkId": "6418706",
            "initDialog": "641870601",
            "dialogues": [
                {
                    "id": "641870601",
                    "speaker": "Player",
                    "text": "What are you talking about?"
                },
                {
                    "id": "641870602",
                    "speaker": "Arapandu",
                    "text": "#Ah, it's Nara {NICKNAME}."
                },
                {
                    "id": "641870603",
                    "speaker": "Arapandu",
                    "text": "#Nara {NICKNAME} healed Varuna Contraption, so the trees and seeds are lively again."
                },
                {
                    "id": "641870604",
                    "speaker": "Arapandu",
                    "text": "#That's why we are naming Varuna Contraption as {NICKNAME} Contraption, to show our thanks."
                },
                {
                    "id": "641870605",
                    "speaker": "Arapandu",
                    "text": "But that would break Nara Varuna's heart, if Nara Varuna comes back."
                },
                {
                    "id": "641870606",
                    "speaker": "Arapandu",
                    "text": "#So Arapandu is trying to make Nara {NICKNAME} and Nara Varuna happy together."
                }
            ]
        },
        {
            "talkId": "6418707",
            "initDialog": "641870701",
            "dialogues": [
                {
                    "id": "641870701",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641870702",
                    "speaker": "Arapandu",
                    "text": "#Hmm, hard to name it. Arapandu will tell Nara {NICKNAME} when the name is ready."
                }
            ]
        }
    ]
}