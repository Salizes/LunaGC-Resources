{
    "groupId": "5238",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Lechlade": 10,
        "Player": 6
    },
    "talks": [
        {
            "talkId": "6523801",
            "initDialog": "652380101",
            "dialogues": [
                {
                    "id": "652380101",
                    "speaker": "Lechlade",
                    "text": "Take my advice, kid. Stay away from those yellow-green stones! The further away, the better!"
                }
            ]
        },
        {
            "talkId": "6523802",
            "initDialog": "652380201",
            "dialogues": [
                {
                    "id": "652380201",
                    "speaker": "Player",
                    "text": "And you are?"
                },
                {
                    "id": "652380202",
                    "speaker": "Lechlade",
                    "text": "I'm just an old nobody..."
                }
            ]
        },
        {
            "talkId": "6523803",
            "initDialog": "652380301",
            "dialogues": [
                {
                    "id": "652380301",
                    "speaker": "Player",
                    "text": "About the yellow-green stones..."
                },
                {
                    "id": "652380302",
                    "speaker": "Lechlade",
                    "text": "Those stones are evil! They bring disaster to the greedy and misfortune to the ignorant..."
                }
            ]
        },
        {
            "talkId": "6523804",
            "initDialog": "652380401",
            "dialogues": [
                {
                    "id": "652380401",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "652380402",
                    "speaker": "Lechlade",
                    "text": "So trust me and stay as far away from them as you can!"
                }
            ]
        },
        {
            "talkId": "6523805",
            "initDialog": "652380501",
            "dialogues": [
                {
                    "id": "652380501",
                    "speaker": "Lechlade",
                    "text": "Health is something we only truly value after we've lost it..."
                }
            ]
        },
        {
            "talkId": "6523806",
            "initDialog": "652380601",
            "dialogues": [
                {
                    "id": "652380601",
                    "speaker": "Player",
                    "text": "How have you been?"
                },
                {
                    "id": "652380602",
                    "speaker": "Lechlade",
                    "text": "Dr. Arderne's medicine really worked. My headache is gone and I feel wide awake. It makes me think of the days I was able to help people like that..."
                },
                {
                    "id": "652380603",
                    "speaker": "Lechlade",
                    "text": "*sigh* It's all my fault. You need to look after yourself, and take any symptom seriously, even the smallest ones..."
                }
            ]
        },
        {
            "talkId": "6523807",
            "initDialog": "652380701",
            "dialogues": [
                {
                    "id": "652380701",
                    "speaker": "Player",
                    "text": "About the yellow-green stones..."
                },
                {
                    "id": "652380702",
                    "speaker": "Lechlade",
                    "text": "Those things are bad news!"
                },
                {
                    "id": "652380703",
                    "speaker": "Lechlade",
                    "text": "Cutting off the road to them isn't enough! We need to destroy them all... They can't be allowed to exist."
                }
            ]
        },
        {
            "talkId": "6523808",
            "initDialog": "652380801",
            "dialogues": [
                {
                    "id": "652380801",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "652380802",
                    "speaker": "Lechlade",
                    "text": "Goodbye. And remember to stay away from those yellow-green stones! The further away the better!"
                }
            ]
        }
    ]
}