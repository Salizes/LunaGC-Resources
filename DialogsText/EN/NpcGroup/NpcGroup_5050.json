            "dialogues": [
                {
                    "id": "650500101",
                    "speaker": "Justeau",
                    "text": "Things could really go bad at this rate. Does not one person care?"
                }
            ]
        },
        {
            "talkId": "6505002",
            "initDialog": "650500201",
            "dialogues": [
                {
                    "id": "650500201",
                    "speaker": "Player",
                    "text": "Care about what?"
                },
                {
                    "id": "650500202",
                    "speaker": "Justeau",
                    "text": "Our water pollution problem!"
                },
                {
                    "id": "650500203",
                    "speaker": "Justeau",
                    "text": "The crisis is so obvious, like dropping ink into clear water, but everyone just ignores it."
                },
                {
                    "id": "650500204",
                    "speaker": "Justeau",
                    "text": "Do only we of the Salon Caritat care about this in all the land?"
                }
            ]
        },
        {
            "talkId": "6505003",
            "initDialog": "650500301",
            "dialogues": [
                {
                    "id": "650500301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "650500302",
                    "speaker": "Justeau",
                    "text": "Believe me, friend, we should all be doing something about this!"
                }
            ]
        }
