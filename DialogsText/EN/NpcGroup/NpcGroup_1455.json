        {
            "talkId": "6145502",
            "initDialog": "614550201",
            "dialogues": [
                {
                    "id": "614550201",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "614550202",
                    "speaker": "Norma",
                    "text": "Oh, I was just on my way to buy some food."
                },
                {
                    "id": "614550203",
                    "speaker": "Norma",
                    "text": "Not groceries, though... I was going to get some restaurant takeout and bring it home with me. My husband has long since grown tired of my cooking..."
                },
                {
                    "id": "614550204",
                    "speaker": "Norma",
                    "text": "You're a traveler? How delightful..."
                },
                {
                    "id": "614550205",
                    "speaker": "Norma",
                    "text": "I've heard that over in Liyue they have such a wide variety of different dishes that they've had to split it into several different cuisines..."
                },
                {
                    "id": "614550206",
                    "speaker": "Norma",
                    "text": "I would love to visit if I ever had the chance."
                }
            ]
        },
        {
            "talkId": "6145503",
            "initDialog": "614550301",
            "dialogues": [
                {
                    "id": "614550301",
                    "speaker": "Player",
                    "text": "Goodbye..."
                },
                {
                    "id": "614550302",
                    "speaker": "Norma",
                    "text": "Okay, bye-bye."
                }
            ]
        }
    ]
