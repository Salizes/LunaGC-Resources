    "talks": [
        {
            "talkId": "6902001",
            "initDialog": "690200101",
            "dialogues": [
                {
                    "id": "690200101",
                    "speaker": "Razor",
                    "text": "#Hello, {NICKNAME}."
                },
                {
                    "id": "690200102",
                    "speaker": "Razor",
                    "text": "Looking... for me?"
                }
            ]
        },
        {
            "talkId": "6902002",
            "initDialog": "690200201",
            "dialogues": [
                {
                    "id": "690200201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                },
                {
                    "id": "690200701",
                    "speaker": "Razor",
                    "text": "I like."
                },
                {
                    "id": "690200702",
                    "speaker": "Razor",
                    "text": "The smell here... is your smell."
                },
                {
                    "id": "690200703",
                    "speaker": "Razor",
                    "text": "Good smell. Smell of safety.",
                    "choices": [
                        {
                            "id": "690200704",
                            "text": "What do I smell like?",
                            "response": [
                                {
                                    "id": "690200705",
                                    "speaker": "Razor",
                                    "text": "Stars... The sea... Windwheel Aster."
                                },
                                {
                                    "id": "690200708",
                                    "speaker": "Razor",
                                    "text": "Here, with you. I am happy."
                                }
                            ]
                        },
                        {
                            "id": "690200706",
                            "text": "As long as you're adjusting to life here.",
                            "response": [
                                {
                                    "id": "690200707",
                                    "speaker": "Razor",
                                    "text": "Ad—just—ing? Hmm... adjusting."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902003",
            "initDialog": "690200301",
            "dialogues": [
                {
                    "id": "690200301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
                },
                {
                    "id": "690200801",
                    "speaker": "Razor",
                    "text": "Sorry, not good at chat."
                },
                {
                    "id": "690200802",
                    "speaker": "Razor",
                    "text": "Talking is hard. Hard to find right words.",
                    "choices": [
                        {
                            "id": "690200803",
                            "text": "No worries. I understand what you're trying to say.",
                            "response": [
                                {
                                    "id": "690200804",
                                    "speaker": "Razor",
                                    "text": "Good... You are strong."
                                },
                                {
                                    "id": "690200807",
                                    "speaker": "Razor",
                                    "text": "Okay, I try to... speak more."
                                },
                                {
                                    "id": "690200808",
                                    "speaker": "Razor",
                                    "text": "..."
                                },
                                {
                                    "id": "690200809",
                                    "speaker": "Razor",
                                    "text": "I like grass more than floor."
                                },
                                {
                                    "id": "690200810",
                                    "speaker": "Razor",
                                    "text": "Floor is big, but hard. Grass is bigger... but it smells good.",
                                    "choices": [
                                        {
                                            "id": "690200811",
                                            "text": "Here, you'd use \"and\"...",
                                            "response": [
                                                {
                                                    "id": "690200813",
                                                    "speaker": "Razor",
                                                    "text": "Oh! \"AND...\" it smells good."
                                                },
                                                {
                                                    "id": "690200814",
                                                    "speaker": "Razor",
                                                    "text": "I like your cooked meat. Better than raw meat."
                                                },
                                                {
                                                    "id": "690200815",
                                                    "speaker": "Razor",
                                                    "text": "Raw meat sometimes makes my stomach hurt. Your cooked meat, smells good... AND... tastes good."
                                                },
                                                {
                                                    "id": "690200816",
                                                    "speaker": "Razor",
                                                    "text": "I want to... eat more of your cooked meat."
                                                },
                                                {
                                                    "id": "690200817",
                                                    "speaker": "Razor",
                                                    "text": "My words... are they alright?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690200812",
                                            "text": "\"And\" it smells good."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690200805",
                            "text": "I'll practice with you.",
                            "response": [
                                {
                                    "id": "690200806",
                                    "speaker": "Razor",
                                    "text": "Practice? Thank you."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902004",
            "initDialog": "690200401",
            "dialogues": [
                {
                    "id": "690200401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
                },
                {
                    "id": "690200901",
                    "speaker": "Razor",
                    "text": "I want to guard, for you.",
                    "choices": [
                        {
                            "id": "690200902",
                            "text": "You want to guard me?",
                            "response": [
                                {
                                    "id": "690200903",
                                    "speaker": "Razor",
                                    "text": "No, you are strong. Don't need to guard."
                                },
                                {
                                    "id": "690200904",
                                    "speaker": "Razor",
                                    "text": "I guard... home. For you."
                                },
                                {
                                    "id": "690200907",
                                    "speaker": "Razor",
                                    "text": "This place, your home."
                                },
                                {
                                    "id": "690200908",
                                    "speaker": "Razor",
                                    "text": "I come here, only a guest."
                                },
                                {
                                    "id": "690200909",
                                    "speaker": "Razor",
                                    "text": "But... you are my lupical."
                                },
                                {
                                    "id": "690200910",
                                    "speaker": "Razor",
                                    "text": "So here is also my home."
                                },
                                {
                                    "id": "690200911",
                                    "speaker": "Razor",
                                    "text": "I want to guard home.",
                                    "choices": [
                                        {
                                            "id": "690200912",
                                            "text": "There's no need to guard the house.",
                                            "response": [
                                                {
                                                    "id": "690200914",
                                                    "speaker": "Razor",
                                                    "text": "Hmm... Okay. What you like, I like too!"
                                                },
                                                {
                                                    "id": "690200915",
                                                    "speaker": "Razor",
                                                    "text": "Then, I guard you."
                                                },
                                                {
                                                    "id": "690200916",
                                                    "speaker": "Razor",
                                                    "text": "No matter where you go. If there is danger..."
                                                },
                                                {
                                                    "id": "690200917",
                                                    "speaker": "Razor",
                                                    "text": "I will come quickly, and protect you."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690200913",
                                            "text": "I'd rather you guarded me."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690200905",
                            "text": "So you want to guard the house?",
                            "response": [
                                {
                                    "id": "690200906",
                                    "speaker": "Razor",
                                    "text": "Yes. Guard house, guard home."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902005",
            "initDialog": "690200501",
            "dialogues": [
                {
                    "id": "690200501",
                    "speaker": "Player",
                    "text": "Morning, Razor."
                },
                {
                    "id": "690201001",
                    "speaker": "Razor",
                    "text": "*grunt* Morning..."
                },
                {
                    "id": "690201002",
                    "speaker": "Razor",
                    "text": "Hunt... must run. Need me, just shout."
                }
            ]
        },
        {
            "talkId": "6902006",
            "initDialog": "690200601",
            "dialogues": [
                {
                    "id": "690200601",
                    "speaker": "Player",
                    "text": "Good night, Razor."
                },
                {
                    "id": "690201101",
                    "speaker": "Razor",
                    "text": "#Mmm... Night, {NICKNAME}."
                },
                {
                    "id": "690201102",
                    "speaker": "Razor",
                    "text": "If you can't sleep, call me over."
                }
            ]
        },
        {
            "talkId": "6902012",
            "initDialog": "690201201",
            "dialogues": [
                {
                    "id": "690201201",
                    "speaker": "Player",
                    "text": "Would you like to have a chat with me?"
                }
            ]
        },
        {
            "talkId": "6902013",
            "initDialog": "690201301",
            "dialogues": [
                {
                    "id": "690201301",
                    "speaker": "Player",
                    "text": "Is there anything you'd like to do?"
                }
            ]
        },
        {
            "talkId": "6902014",
            "initDialog": "690201401",
            "dialogues": [
                {
                    "id": "690201401",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                }
            ]
        },
        {
            "talkId": "6902050",
            "initDialog": "690205001",
            "dialogues": [
                {
                    "id": "690205001",
                    "speaker": "Razor",
                    "text": "Villages are for people."
                },
                {
                    "id": "690205002",
                    "speaker": "Razor",
                    "text": "Sometimes, I want to visit. If you are here, I am... not scared."
                },
                {
                    "id": "690205003",
                    "speaker": "Razor",
                    "text": "Thank you for bringing me."
                }
            ]
        },
        {
            "talkId": "6902051",
            "initDialog": "690205101",
            "dialogues": [
                {
                    "id": "690205101",
                    "speaker": "Razor",
                    "text": "Kitchen, ingredients... Confusing. In the forest, we don't use."
                },
                {
                    "id": "690205102",
                    "speaker": "Razor",
                    "text": "I want to learn. Other than hash browns... Can you teach me?"
                },
                {
                    "id": "690205103",
                    "speaker": "Razor",
                    "text": "After making... Give to you and lupical to eat."
                }
            ]
        }
    ]
}