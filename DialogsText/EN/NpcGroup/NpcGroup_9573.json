    "talks": [
        {
            "talkId": "6957301",
            "initDialog": "695730101",
            "dialogues": [
                {
                    "id": "695730101",
                    "speaker": "Xianyun",
                    "text": "A fine game to be sure, this, but we play with many cards, and once done, we must manually shuffle and sort our decks... Hmm. One has an idea. Perhaps a mechanical desk might be constructed into which cards may be inserted once a game is over, and it shall do both in our stead..."
                }
            ]
        },
        {
            "talkId": "6957302",
            "initDialog": "695730201",
            "dialogues": [
                {
                    "id": "695730201",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957303",
            "initDialog": "695730301",
            "dialogues": [
                {
                    "id": "695730301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "695730302",
                    "speaker": "Xianyun",
                    "text": "Leaving, then? Where do you intend to go? One could give you a ride."
                }
            ]
        },
        {
            "talkId": "6957304",
            "initDialog": "695730401",
            "dialogues": [
                {
                    "id": "695730401",
                    "speaker": "Xianyun",
                    "text": "Come now, do not gaze upon one so. Why would a mere game of cards prescribe mechanical assistance? ...Hmm? Must one then roll up one's sleeves to play? Well. Be it as you wish, then."
                }
            ]
        },
        {
            "talkId": "6957305",
            "initDialog": "695730501",
            "dialogues": [
                {
                    "id": "695730501",
                    "speaker": "Xianyun",
                    "text": "After such utter defeat, one must now rely on mechanisms to assist the next time we play... Hah, do not pout. It was but a jest. One is no feckless insouciant."
                }
            ]
        },
        {
            "talkId": "6957306",
            "initDialog": "695730601",
            "dialogues": [
                {
                    "id": "695730601",
                    "speaker": "Xianyun",
                    "text": "This mortal game has one's interest piqued. Let us go for a few rounds, shall we?"
                }
            ]
        },
        {
            "talkId": "6957308",
            "initDialog": "695730801",
            "dialogues": [
                {
                    "id": "695730801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957309",
            "initDialog": "695730901",
            "dialogues": [
                {
                    "id": "695730901",
                    "speaker": "Player",
                    "text": "Adjust the deck first..."
                }
            ]
        },
        {
            "talkId": "6957310",
            "initDialog": "695731001",
            "dialogues": [
                {
                    "id": "695731001",
                    "speaker": "Xianyun",
                    "text": "You were careless. This game requires patience and deliberate thinking."
                }
            ]
        },
        {
            "talkId": "6957311",
            "initDialog": "695731101",
            "dialogues": [
                {
                    "id": "695731101",
                    "speaker": "Xianyun",
                    "text": "Ha, you are indeed skilled in this game. Excellent."
                }
            ]
        },
        {
            "talkId": "6957312",
            "initDialog": "695731201",
            "dialogues": [
                {
                    "id": "695731201",
                    "speaker": "Xianyun",
                    "text": "Ah, your competitor's spirit has been roused. Very well. One shall match your intent."
                }
            ]
        },
        {
            "talkId": "6957314",
            "initDialog": "695731401",
            "dialogues": [
                {
                    "id": "695731401",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957315",
            "initDialog": "695731501",
            "dialogues": [
                {
                    "id": "695731501",
                    "speaker": "Player",
                    "text": "Adjust the deck first..."
                }
            ]
        },
        {
            "talkId": "6957316",
            "initDialog": "695731601",
            "dialogues": [
                {
                    "id": "695731601",
                    "speaker": "Xianyun",
                    "text": "Victory was nigh within your grasp if not for one's prior preparations... Be not dispirited. Let us have another match."
