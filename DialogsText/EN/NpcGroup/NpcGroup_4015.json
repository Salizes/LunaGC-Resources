        {
            "talkId": "6401502",
            "initDialog": "640150201",
            "dialogues": [
                {
                    "id": "640150201",
                    "speaker": "Player",
                    "text": "And you are..."
                },
                {
                    "id": "640150202",
                    "speaker": "Fariha",
                    "text": "I'm Mr. Nizam's secretary. I'm responsible for taking minutes for him."
                },
                {
                    "id": "640150203",
                    "speaker": "Fariha",
                    "text": "If you see Mr. Nizam scowling or sighing in frustration, please don't take it personally. That's just how he is."
                },
                {
                    "id": "640150204",
                    "speaker": "Fariha",
                    "text": "Just make your request in advance and he'll make sure it gets taken care of."
                }
            ]
        },
        {
            "talkId": "6401503",
            "initDialog": "640150301",
            "dialogues": [
                {
                    "id": "640150301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640150302",
                    "speaker": "Fariha",
                    "text": "Take care, now."
                }
            ]
        }
