            "dialogues": [
                {
                    "id": "614270501",
                    "speaker": "Player",
                    "text": "Duel"
                }
            ]
        },
        {
            "talkId": "6142706",
            "initDialog": "614270601",
            "dialogues": [
                {
                    "id": "614270601",
                    "speaker": "Donna",
                    "text": "I still lost..."
                }
            ]
        },
        {
            "talkId": "6142707",
            "initDialog": "614270701",
            "dialogues": [
                {
                    "id": "614270701",
                    "speaker": "Donna",
                    "text": "Woo! You scared me! I didn't think I was going to win..."
                }
            ]
        },
        {
            "talkId": "6142708",
            "initDialog": "614270801",
            "dialogues": [
                {
                    "id": "614270801",
                    "speaker": "Donna",
                    "text": "Oh, that's no surprise..."
                }
            ]
        },
        {
            "talkId": "6142709",
            "initDialog": "614270901",
            "dialogues": [
                {
                    "id": "614270901",
                    "speaker": "Donna",
                    "text": "Good, good. Hard to believe I won..."
                }
            ]
        },
        {
            "talkId": "40167",
            "initDialog": "4015142701",
            "dialogues": [
                {
                    "id": "4015142701",
                    "speaker": "Donna",
                    "text": "Are you here for the flowers?"
                }
            ]
        },
        {
            "talkId": "6142701",
            "initDialog": "614270101",
            "dialogues": [
                {
                    "id": "614270101",
                    "speaker": "Player",
                    "text": "About Stormterror..."
                },
                {
                    "id": "614270102",
                    "speaker": "Donna",
                    "text": "Every time I think that such a thing happened to us, I grow very afraid..."
                },
                {
                    "id": "614270103",
                    "speaker": "Donna",
                    "text": "(If I were to be captured by Stormterror, Master Diluc would definitely come to my rescue...)"
                },
                {
                    "id": "614270104",
                    "speaker": "Donna",
                    "text": "(This... This must be the part where the dashing prince saves the kidnapped princess!)"
                },
                {
                    "id": "614270105",
                    "speaker": "Donna",
                    "text": "(Then... maybe our story will be written about in fairy tales... No, wait, why am I thinking about something like that now?)"
                },
                {
                    "id": "614270106",
                    "speaker": "Donna",
                    "text": "Wh—Whatever it is, it was too terrifying for me. Oh, Lord Barbatos, please protect Mondstadt..."
                }
            ]
        },
        {
            "talkId": "6142702",
            "initDialog": "4015142702",
            "dialogues": [
                {
                    "id": "4015142702",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "4015142706",
                    "speaker": "Donna",
                    "text": "...Huh?"
                },
                {
                    "id": "4015142707",
                    "speaker": "Donna",
                    "text": "I'm just an ordinary girl... helping out here..."
                },
                {
                    "id": "4015142708",
                    "speaker": "Donna",
                    "text": "(Gosh, am I blushing?)"
                },
                {
                    "id": "4015142709",
                    "speaker": "Donna",
                    "text": "(I was daydreaming about Diluc giving me flowers... Was it obvious?)"
                },
                {
                    "id": "4015142710",
                    "speaker": "Donna",
                    "text": "Don't... don't look at me like that... There's nothing special about me.",
                    "choices": [
                        {
                            "id": "4015142703",
                            "text": "Diluc?",
                            "response": [
                                {
                                    "id": "4015142711",
                                    "speaker": "Donna",
                                    "text": "Oh... Did I just... say...?"
                                },
                                {
                                    "id": "4015142712",
                                    "speaker": "Donna",
                                    "text": "I'm sorry..."
                                },
                                {
                                    "id": "4015142713",
                                    "speaker": "Donna",
                                    "text": "I've been daydreaming about meeting Diluc here... so I..."
                                },
                                {
                                    "id": "4015142714",
                                    "speaker": "Donna",
                                    "text": "No, I didn't..."
                                },
                                {
                                    "id": "4015142715",
                                    "speaker": "Donna",
                                    "text": "(What do I do? I love Diluc so much!)"
                                }
                            ]
                        },
                        {
                            "id": "4015142704",
                            "text": "Moon Pie?",
                            "response": [
                                {
                                    "id": "4015142716",
                                    "speaker": "Donna",
                                    "text": "Are you here... for the Moon Pies?"
                                },
                                {
                                    "id": "4015142717",
                                    "speaker": "Donna",
                                    "text": "They are a specialty of Mondstadt, a kind of meat pie that is sweet and fulfilling."
                                },
                                {
                                    "id": "4015142718",
                                    "speaker": "Donna",
                                    "text": "(I could make a delicious Moon Pie and give it to Diluc...)"
                                },
                                {
                                    "id": "4015142719",
                                    "speaker": "Donna",
                                    "text": "(Stop... stop it, Donna!)"
                                },
                                {
                                    "id": "4015142720",
                                    "speaker": "Donna",
                                    "text": "If you have the chance, be sure to check them out!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6142703",
            "initDialog": "4015142705",
            "dialogues": [
                {
                    "id": "4015142705",
                    "speaker": "Player",
                    "text": "Sorry for bothering you."
                },
                {
                    "id": "4015142721",
                    "speaker": "Donna",
                    "text": "I... I see..."
                },
                {
                    "id": "4015142722",
                    "speaker": "Donna",
                    "text": "Have a nice day."
                }
            ]
        }
    ]
}