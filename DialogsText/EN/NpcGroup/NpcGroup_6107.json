    "talks": [
        {
            "talkId": "6610701",
            "initDialog": "661070101",
            "dialogues": [
                {
                    "id": "661070101",
                    "speaker": "Hakau",
                    "text": "Who knew it'd be so hard to live so high up day after day..."
                },
                {
                    "id": "661070102",
                    "speaker": "Hakau",
                    "text": "I wonder how it would feel like to get swung back and forth by a Yumkasaur."
                }
            ]
        },
        {
            "talkId": "6610702",
            "initDialog": "661070201",
            "dialogues": [
                {
                    "id": "661070201",
                    "speaker": "Player",
                    "text": "Pretty great, huh?"
                },
                {
                    "id": "661070202",
                    "speaker": "Hakau",
                    "text": "Oh, you mean the pleasure of coming and going freely?"
                },
                {
                    "id": "661070203",
                    "speaker": "Hakau",
                    "text": "Hmm... Do you think floating in the air is kind of like swimming in water?"
                },
                {
                    "id": "661070204",
                    "speaker": "Hakau",
                    "text": "Then I can kind of understand."
                }
            ]
        },
        {
            "talkId": "6610703",
            "initDialog": "661070301",
            "dialogues": [
                {
                    "id": "661070301",
                    "speaker": "Player",
                    "text": "Pretty grating, huh?"
                },
                {
                    "id": "661070302",
                    "speaker": "Hakau",
                    "text": "Really? Then aren't the Scions of the Canopy always like... engaging in spiritual practices every day?"
                },
                {
                    "id": "661070303",
                    "speaker": "Hakau",
                    "text": "Oh... No wonder their warriors are so strong... Much better than us People of the Springs, who only know some cheap lava tricks..."
                }
            ]
        },
        {
            "talkId": "6610704",
            "initDialog": "661070401",
            "dialogues": [
                {
                    "id": "661070401",
                    "speaker": "Player",
                    "text": "Why not try it yourself?"
                },
                {
                    "id": "661070402",
                    "speaker": "Hakau",
                    "text": "You've got a point."
                }
            ]
        }
    ]
}