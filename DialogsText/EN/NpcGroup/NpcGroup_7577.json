        {
            "talkId": "6757701",
            "initDialog": "675770101",
            "dialogues": [
                {
                    "id": "675770101",
                    "speaker": "Ignat",
                    "text": "Ten thousand, twenty thousand..."
                }
            ]
        },
        {
            "talkId": "6757702",
            "initDialog": "675770201",
            "dialogues": [
                {
                    "id": "675770201",
                    "speaker": "Player",
                    "text": "What are you counting?"
                },
                {
                    "id": "675770202",
                    "speaker": "Ignat",
                    "text": "...Mora... Day shift pays over ten thousand... Night shift pays more... I can save up a fair bit in a year..."
                },
                {
                    "id": "675770203",
                    "speaker": "Ignat",
                    "text": "If I keep saving a while longer, it'll be enough..."
                }
            ]
        },
        {
            "talkId": "6757703",
            "initDialog": "675770301",
            "dialogues": [
                {
                    "id": "675770301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "675770302",
                    "speaker": "Ignat",
                    "text": "Yes"
                }
            ]
        },
        {
            "talkId": "6757704",
            "initDialog": "675770401",
            "dialogues": [
                {
                    "id": "675770401",
                    "speaker": "Player",
                    "text": "Enough for what?"
                },
                {
                    "id": "675770402",
                    "speaker": "Ignat",
                    "text": "A little house in Snezhnograd... The kind with a big stove... My Lyubavushka, she... doesn't do well with the cold..."
                },
                {
                    "id": "675770403",
                    "speaker": "Ignat",
                    "text": "I want her to live a little better... Svetloledovka is too cold. She won't get used to living here..."
                }
            ]
        }
    ]
}