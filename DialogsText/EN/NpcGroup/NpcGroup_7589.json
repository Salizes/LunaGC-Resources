{
    "groupId": "7589",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Paimon": 9,
        "Player": 5,
        "Yakhontov": 8
    },
    "talks": [
        {
            "talkId": "6758901",
            "initDialog": "675890101",
            "dialogues": [
                {
                    "id": "675890101",
                    "speaker": "Yakhontov",
                    "text": "Come on... why aren't they biting?"
                }
            ]
        },
        {
            "talkId": "6758902",
            "initDialog": "675890201",
            "dialogues": [
                {
                    "id": "675890201",
                    "speaker": "Player",
                    "text": "Catch anything yet?"
                },
                {
                    "id": "675890202",
                    "speaker": "Yakhontov",
                    "text": "Shh! Keep it down! The fish down below can hear us perfectly well. They're never going to take the bait if you keep talking."
                },
                {
                    "id": "675890203",
                    "speaker": "Yakhontov",
                    "text": "See? Ice fishing is a true art."
                }
            ]
        },
        {
            "talkId": "6758903",
            "initDialog": "675890301",
            "dialogues": [
                {
                    "id": "675890301",
                    "speaker": "Player",
                    "text": "Aren't you freezing out here?"
                },
                {
                    "id": "675890302",
                    "speaker": "Yakhontov",
                    "text": "Please. To a true ice-fishing master, a little chill like this is absolutely nothing."
                }
            ]
        },
        {
            "talkId": "6758904",
            "initDialog": "675890401",
            "dialogues": [
                {
                    "id": "675890401",
                    "speaker": "Player",
                    "text": "(Best not to disturb him.)"
                },
                {
                    "id": "675890402",
                    "speaker": "Yakhontov",
                    "text": "What's wrong with this place? Is it the bait, or..."
                },
                {
                    "id": "675890403",
                    "speaker": "Yakhontov",
                    "text": "Oh, wait. There's been a kid yelling his head off around here lately. I bet he's the one who scared all the fish away!"
                }
            ]
        },
        {
            "talkId": "6758905",
            "initDialog": "675890501",
            "dialogues": [
                {
                    "id": "675890501",
                    "speaker": "Player",
                    "text": "An art?"
                },
                {
                    "id": "675890502",
                    "speaker": "Yakhontov",
                    "text": "Exactly. Tell me, do you even know how many different ways there are to tie a fishing knot?"
                }
            ]
        },
        {
            "talkId": "6758906",
            "initDialog": "675890601",
            "dialogues": [
                {
                    "id": "675890601",
                    "speaker": "Player",
                    "text": "Let's head back. We've got enough food."
                },
                {
                    "id": "675890602",
                    "speaker": "Yakhontov",
                    "text": "You think fishing is just about the food?"
                }
            ]
        },
