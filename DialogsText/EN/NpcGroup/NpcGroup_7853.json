    "talks": [
        {
            "talkId": "6785301",
            "initDialog": "678530101",
            "dialogues": [
                {
                    "id": "678530101",
                    "speaker": "Vetrova",
                    "text": "Ah, life's getting harder by the day. Can't even get a decent meal around here anymore..."
                }
            ]
        },
        {
            "talkId": "6785302",
            "initDialog": "678530201",
            "dialogues": [
                {
                    "id": "678530201",
                    "speaker": "Player",
                    "text": "What were the \"old days\" like?"
                },
                {
                    "id": "678530202",
                    "speaker": "Vetrova",
                    "text": "The old days? Back then in Sretomorozsk... We might not be Snezhnograd, but we still had some class. Like, you'd always see fresh flowers inside our homes, no matter how cold it got outside."
                },
                {
                    "id": "678530203",
                    "speaker": "Vetrova",
                    "text": "Our tables had tablecloths, the kind with tassels and everything. And there was always a kettle whistling on the stove. We'd drink tea brought in from Fontaine using these silver spoons, and would often mix in honey and cream with them."
                },
                {
                    "id": "678530204",
                    "speaker": "Vetrova",
                    "text": "And we had these balls... You know what balls are, right? We'd wear our best gowns, made of organza or velvet... And the younger girls would have these flower crowns on their heads..."
                },
                {
                    "id": "678530205",
                    "speaker": "Vetrova",
                    "text": "But now, it's all over. We've lost all our money, and can't get ourselves any crystal ore either..."
                }
            ]
        },
