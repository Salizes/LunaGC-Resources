{
    "groupId": "20620",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Agafya": 5,
        "Mirror Maiden": 1,
        "Player": 6
    },
    "talks": [
        {
            "talkId": "7902224",
            "initDialog": "790222401",
            "dialogues": [
                {
                    "id": "790222401",
                    "speaker": "Agafya",
                    "text": "What is it? Is there anything else? I've already told you everything I know...",
                    "choices": [
                        {
                            "id": "790222402",
                            "text": "About the signal testing...",
                            "response": [
                                {
                                    "id": "790222403",
                                    "speaker": "Agafya",
                                    "text": "Like I told you, I don't know much about it... They were probably just some simple tests, but running all over these islands was just... incredibly tiring."
                                }
                            ]
                        },
                        {
                            "id": "790222404",
                            "text": "About Zakhar...",
                            "response": [
                                {
                                    "id": "790222405",
                                    "speaker": "Agafya",
                                    "text": "Zakhar is an orphan. His parents died of illness long ago, and it is said that he led a difficult life for a long time. He then heard that the Fatui provided free meals, and decided to join them..."
                                }
                            ]
                        },
                        {
                            "id": "790222406",
                            "text": "About the photo...",
                            "response": [
                                {
                                    "id": "790222407",
                                    "speaker": "Agafya",
                                    "text": "Well, that's my two brothers in the photo, both of whom have devoted their services to Snezhnaya. I've always been proud of them."
                                }
                            ]
                        },
                        {
                            "id": "790222408",
                            "text": "See you..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902230",
            "initDialog": "790223001",
            "dialogues": [
                {
                    "id": "790223001",
                    "speaker": "Mirror Maiden",
                    "text": "...I have to get back... I have to get back... He's still there. But my brothers are gone, and their photo...",
                    "choices": [
                        {
                            "id": "790223002",
                            "text": "(We aren't getting through to her...)"
                        },
                        {
                            "id": "790223003",
                            "text": "(Let's leave her alone for now...)"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902427",
            "initDialog": "790242701",
            "dialogues": [
                {
                    "id": "790242701",
                    "speaker": "Agafya",
                    "text": "The bulk of the troops have already left, and we're just about ready to leave as well..."
                }
            ]
        }
    ]
}