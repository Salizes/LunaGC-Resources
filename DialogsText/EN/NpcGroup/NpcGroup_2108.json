    "talks": [
        {
            "talkId": "6210801",
            "initDialog": "621080101",
            "dialogues": [
                {
                    "id": "621080101",
                    "speaker": "Hulu",
                    "text": "Welcome! Care for a bottle or two of Liyue's finest local brew?"
                }
            ]
        },
        {
            "talkId": "6210802",
            "initDialog": "621080201",
            "dialogues": [
                {
                    "id": "621080201",
                    "speaker": "Player",
                    "text": "What's it like?"
                },
                {
                    "id": "621080202",
                    "speaker": "Hulu",
                    "text": "It looks like liquid amber, and has just a hint of sweetness when it first hits the tongue..."
                },
                {
                    "id": "621080203",
                    "speaker": "Hulu",
                    "text": "...Followed shortly by a wonderful mellow aftertaste that lingers long after the fact. You won't find one better!"
                },
                {
                    "id": "621080204",
                    "speaker": "Hulu",
                    "text": "And because we buy direct from Dawn Winery, we pass the savings right on to you...",
                    "choices": [
                        {
                            "id": "621080207",
                            "text": "Dawn Winery?",
                            "response": [
                                {
                                    "id": "621080208",
                                    "speaker": "Hulu",
                                    "text": "What about it? ...Oops, did I..."
                                },
                                {
                                    "id": "621080209",
                                    "speaker": "Hulu",
                                    "text": "I—I don't think I... I definitely said this is a local Liyue wine..."
                                },
                                {
                                    "id": "621080210",
                                    "speaker": "Hulu",
                                    "text": "You said it alright, clear as day."
                                },
                                {
                                    "id": "621080211",
                                    "speaker": "Hulu",
                                    "text": "...I can tell from the look in your eyes that I am faced with an expert..."
                                },
                                {
                                    "id": "621080212",
                                    "speaker": "Hulu",
                                    "text": "Okay, I'll admit it. We buy from the Dawn Winery and change the labels."
                                },
                                {
                                    "id": "621080213",
                                    "speaker": "Hulu",
                                    "text": "It's not like I want to lie, but the Dawn Winery's wines are second to none..."
                                }
                            ]
                        },
                        {
                            "id": "621080205",
                            "text": "Not interested, thanks.",
                            "response": [
                                {
                                    "id": "621080206",
                                    "speaker": "Hulu",
                                    "text": "N—Not interested? Come on, it's not every day you travel to Liyue, surely? Don't go home empty-handed..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6210803",
            "initDialog": "621080301",
            "dialogues": [
                {
                    "id": "621080301",
                    "speaker": "Player",
                    "text": "No thanks, bye."
                },
                {
                    "id": "621080302",
                    "speaker": "Hulu",
                    "text": "You're sure I can't persuade you?"
                }
            ]
        }
    ]
}