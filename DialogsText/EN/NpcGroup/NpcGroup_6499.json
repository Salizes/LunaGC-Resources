    },
    "talks": [
        {
            "talkId": "6649901",
            "initDialog": "664990101",
            "dialogues": [
                {
                    "id": "664990101",
                    "speaker": "Fournier",
                    "text": "An easy-breezy Fontaine in an easy-breezy summer! Come get a taste of Fontaine's finest desserts — there's a flavor for everyone!"
                }
            ]
        },
        {
            "talkId": "6649902",
            "initDialog": "664990201",
            "dialogues": [
                {
                    "id": "664990201",
                    "speaker": "Player",
                    "text": "Let me see your catch."
                },
                {
                    "id": "664990202",
                    "speaker": "Fournier",
                    "text": "Absolutely!"
                }
            ]
        },
        {
            "talkId": "6649903",
            "initDialog": "664990301",
            "dialogues": [
                {
                    "id": "664990301",
                    "speaker": "Player",
                    "text": "You're from Fontaine?"
                },
                {
                    "id": "664990302",
                    "speaker": "Fournier",
                    "text": "Right you are! Have you heard of the famous Hotel Debord? I used to be a patissier there."
                },
                {
                    "id": "664990303",
                    "speaker": "Fournier",
                    "text": "Some time ago, we had a guest from Natlan. I learned about the Easybreeze Holiday Resort from him."
                },
                {
                    "id": "664990304",
                    "speaker": "Fournier",
                    "text": "It seemed like an excellent opportunity to promote Fontaine's desserts, so I decided to set up a stall here."
                },
                {
                    "id": "664990305",
                    "speaker": "Fournier",
                    "text": "That Natlanese guest's name was Tzompantli, I believe. I think he's got his own shop at the market. You should check it out — if you're interested."
                }
            ]
        },
        {
            "talkId": "6649904",
            "initDialog": "664990401",
            "dialogues": [
                {
                    "id": "664990401",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "664990402",
                    "speaker": "Fournier",
                    "text": "Goodbye."
                }
            ]
        }
    ]
}