    "talks": [
        {
            "talkId": "6508501",
            "initDialog": "650850101",
            "dialogues": [
                {
                    "id": "650850101",
                    "speaker": "Semaine",
                    "text": "Work is about the same no matter where you go — being here is best."
                }
            ]
        },
        {
            "talkId": "6508502",
            "initDialog": "650850201",
            "dialogues": [
                {
                    "id": "650850201",
                    "speaker": "Player",
                    "text": "And why is that?"
                },
                {
                    "id": "650850202",
                    "speaker": "Semaine",
                    "text": "Because my workplace is closer to where I live."
                },
                {
                    "id": "650850203",
                    "speaker": "Semaine",
                    "text": "My previous work was related to the courts, so I had to shuttle between the Palais Mermonia and the opera house. This location, on the other hand, is far more convenient."
                },
                {
                    "id": "650850204",
                    "speaker": "Semaine",
                    "text": "Sometimes, I head over there to watch a performance — and what do you know, I do sometimes miss my previous workplaces when I see them."
                }
            ]
        },
        {
            "talkId": "6508503",
            "initDialog": "650850301",
            "dialogues": [
                {
                    "id": "650850301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "650850302",
                    "speaker": "Semaine",
                    "text": "Take care."
                }
            ]
        }
    ]
}