{
    "groupId": "7414",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Alyosha": 5,
        "Grigory": 12,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6741401",
            "initDialog": "674140101",
            "dialogues": [
                {
                    "id": "674140101",
                    "speaker": "Grigory",
                    "text": "Check out our new stock! But take note that the transaction's done once you leave the counter... and we don't sell on credit. In principle, anyway!"
                }
            ]
        },
        {
            "talkId": "6741402",
            "initDialog": "674140201",
            "dialogues": [
                {
                    "id": "674140201",
                    "speaker": "Player",
                    "text": "Let's see what you've got..."
                },
                {
                    "id": "674140202",
                    "speaker": "Grigory",
                    "text": "Feel free! It's all newly shipped in!"
                }
            ]
        },
        {
            "talkId": "6741403",
            "initDialog": "674140301",
            "dialogues": [
                {
                    "id": "674140301",
                    "speaker": "Player",
                    "text": "Can I put it on my tab?"
                },
                {
                    "id": "674140302",
                    "speaker": "Grigory",
                    "text": "Haha, come now, dear customer, you hardly look poor. And besides, small outfits like ours need to run tight budgets, you know..."
                },
                {
                    "id": "674140303",
                    "speaker": "Grigory",
                    "text": "But in all seriousness, when we say \"credit,\" we mean helping villagers who struggle to make ends meet. People like you aren't who that service is for, you see."
                }
            ]
        },
        {
            "talkId": "6741404",
            "initDialog": "674140401",
            "dialogues": [
                {
                    "id": "674140401",
                    "speaker": "Player",
                    "text": "Do a lot of people purchase on credit?"
                },
                {
                    "id": "674140402",
                    "speaker": "Grigory",
                    "text": "...In the past? Occasionally, but numbers are up nowadays."
                },
                {
                    "id": "674140403",
                    "speaker": "Grigory",
                    "text": "Everyone's got their fair share of problems, and our clientele here at Bryatska are often nearby residents. And around these parts, there's always a cold chill of misfortune waiting around the corner to ruin someone's life..."
                },
                {
                    "id": "674140404",
                    "speaker": "Grigory",
                    "text": "So though we call it selling on credit, it's more like doing someone a favor."
                }
            ]
        },
        {
            "talkId": "6741405",
            "initDialog": "674140501",
            "dialogues": [
                {
                    "id": "674140501",
                    "speaker": "Player",
                    "text": "Not much I want to look at for the moment..."
                },
                {
                    "id": "674140502",
                    "speaker": "Grigory",
                    "text": "That so? Well, come back when we've got a new shipment. Maybe something will catch your eye then!"
                }
            ]
        },
