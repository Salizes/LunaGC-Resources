    "talks": [
        {
            "talkId": "6404401",
            "initDialog": "640440101",
            "dialogues": [
                {
                    "id": "640440101",
                    "speaker": "Farid",
                    "text": "Sometimes, places with a lot of people can be safer than you think."
                }
            ]
        },
        {
            "talkId": "6404402",
            "initDialog": "640440201",
            "dialogues": [
                {
                    "id": "640440201",
                    "speaker": "Player",
                    "text": "Are you on patrol?"
                },
                {
                    "id": "640440202",
                    "speaker": "Farid",
                    "text": "Yeah. It's my job to patrol around."
                },
                {
                    "id": "640440203",
                    "speaker": "Farid",
                    "text": "There's no danger around here. You can travel as you wish."
                },
                {
                    "id": "640440204",
                    "speaker": "Farid",
                    "text": "But that isn't necessarily true. A few days ago, there were two groups of researchers here who started a group fight. I was almost pulled into it."
                },
                {
                    "id": "640440205",
                    "speaker": "Farid",
                    "text": "Even in Sumeru City, you can still be in danger when faced with researchers who seem mild-mannered. It is a must to always be on the alert."
                }
            ]
        },
        {
            "talkId": "6404403",
            "initDialog": "640440301",
            "dialogues": [
                {
                    "id": "640440301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640440302",
                    "speaker": "Farid",
                    "text": "Goodbye."
                }
            ]
        }
    ]
}