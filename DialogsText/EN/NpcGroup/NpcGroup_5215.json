{
    "groupId": "5215",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "Rosolino": 8
    },
    "talks": [
        {
            "talkId": "6521501",
            "initDialog": "652150101",
            "dialogues": [
                {
                    "id": "652150101",
                    "speaker": "Rosolino",
                    "text": "On the left is the Mail Room, and on the right is the Infirmary. Don't mix them up."
                }
            ]
        },
        {
            "talkId": "6521502",
            "initDialog": "652150201",
            "dialogues": [
                {
                    "id": "652150201",
                    "speaker": "Player",
                    "text": "About the Mail Room..."
                },
                {
                    "id": "652150202",
                    "speaker": "Rosolino",
                    "text": "You pay with Coupons. Tell us the recipient and their address and we'll get the letter there, if it's in Fontaine. The letter can't be too long, and the content... well, work that out yourself."
                },
                {
                    "id": "652150203",
                    "speaker": "Rosolino",
                    "text": "And I advise you not to inquire about anything else."
                }
            ]
        },
        {
            "talkId": "6521503",
            "initDialog": "652150301",
            "dialogues": [
                {
                    "id": "652150301",
                    "speaker": "Player",
                    "text": "About the Infirmary..."
                },
                {
                    "id": "652150302",
                    "speaker": "Rosolino",
                    "text": "If Dr. Arderne isn't there, he's probably in the production zone. I don't know any more than that."
                }
            ]
        },
        {
            "talkId": "6521504",
            "initDialog": "652150401",
            "dialogues": [
                {
                    "id": "652150401",
                    "speaker": "Player",
                    "text": "Okay, thanks."
                },
                {
                    "id": "652150402",
                    "speaker": "Rosolino",
                    "text": "Don't mention it."
                }
            ]
        },
        {
            "talkId": "6521505",
            "initDialog": "652150501",
            "dialogues": [
                {
                    "id": "652150501",
                    "speaker": "Rosolino",
                    "text": "Duel"
                }
            ]
        },
        {
            "talkId": "6521506",
            "initDialog": "652150601",
            "dialogues": [
                {
                    "id": "652150601",
                    "speaker": "Rosolino",
                    "text": "Don't worry, you've still got plenty of time to work on your card skills. Although... I'll no doubt have even more, being in the Fortress of Meropide and all."
                }
            ]
        },
        {
            "talkId": "6521507",
            "initDialog": "652150701",
            "dialogues": [
                {
                    "id": "652150701",
                    "speaker": "Rosolino",
                    "text": "Not bad! You might look young, but you're clearly an old hand when it comes to cards!"
                }
            ]
        }
    ]
}