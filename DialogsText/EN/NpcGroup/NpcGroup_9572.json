    "talks": [
        {
            "talkId": "6957201",
            "initDialog": "695720101",
            "dialogues": [
                {
                    "id": "695720101",
                    "speaker": "Chevreuse",
                    "text": "These card games are quite popular in the Special Patrol. A lot of my colleagues like to buy and trade them... I won't stop my team from engaging in a sensible level of recreational activity, but I do warn them to play in moderation."
                }
            ]
        },
        {
            "talkId": "6957202",
            "initDialog": "695720201",
            "dialogues": [
                {
                    "id": "695720201",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957203",
            "initDialog": "695720301",
            "dialogues": [
                {
                    "id": "695720301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "695720302",
                    "speaker": "Chevreuse",
                    "text": "Goodbye. I'll be back on shift shortly. I'm sure a lot of work has already piled up while I've been gone..."
                }
            ]
        },
        {
            "talkId": "6957204",
            "initDialog": "695720401",
            "dialogues": [
                {
                    "id": "695720401",
                    "speaker": "Chevreuse",
                    "text": "I can't take credit for that win — I just got lucky. It could have gone either way."
                }
            ]
        },
        {
            "talkId": "6957205",
            "initDialog": "695720501",
            "dialogues": [
                {
                    "id": "695720501",
                    "speaker": "Chevreuse",
                    "text": "...Yeah, I'm no good at games like this. Ah... And it looks like my break time is about over."
                }
            ]
        },
        {
            "talkId": "6957206",
            "initDialog": "695720601",
            "dialogues": [
                {
                    "id": "695720601",
                    "speaker": "Chevreuse",
                    "text": "Let's begin. I'm always prepared for a fight."
                }
            ]
        },
        {
            "talkId": "6957208",
            "initDialog": "695720801",
            "dialogues": [
                {
                    "id": "695720801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957209",
            "initDialog": "695720901",
            "dialogues": [
                {
                    "id": "695720901",
                    "speaker": "Player",
                    "text": "Let me adjust my deck first..."
                }
            ]
        },
        {
            "talkId": "6957210",
            "initDialog": "695721001",
            "dialogues": [
                {
                    "id": "695721001",
                    "speaker": "Chevreuse",
                    "text": "Good thing I was adequately prepared, or I'd have lost."
                }
            ]
        },
        {
            "talkId": "6957211",
            "initDialog": "695721101",
            "dialogues": [
                {
                    "id": "695721101",
                    "speaker": "Chevreuse",
                    "text": "...I lost. I just couldn't figure out your tactics."
                }
            ]
        },
        {
            "talkId": "6957212",
            "initDialog": "695721201",
            "dialogues": [
                {
                    "id": "695721201",
                    "speaker": "Chevreuse",
                    "text": "Extra training? No problem, I'm in."
                }
            ]
        },
        {
            "talkId": "6957214",
            "initDialog": "695721401",
            "dialogues": [
                {
                    "id": "695721401",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6957215",
            "initDialog": "695721501",
            "dialogues": [
                {
                    "id": "695721501",
                    "speaker": "Player",
                    "text": "Let me adjust my deck first..."
