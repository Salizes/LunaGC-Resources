                            "response": [
                                {
                                    "id": "60067605",
                                    "speaker": "Aamu",
                                    "text": "Made up!? He lied to us for over a decade! That's not something you just forgive and forget!"
                                },
                                {
                                    "id": "60067606",
                                    "speaker": "Aamu",
                                    "text": "...He needs to apologize at least another three times..."
                                }
                            ]
                        }
                    ]
                }
