{
    "groupId": "2118",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Mengmeng": 11,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "7194601",
            "initDialog": "719460101",
            "dialogues": [
                {
                    "id": "719460101",
                    "speaker": "Player",
                    "text": "It might be bad to pick so many flowers..."
                },
                {
                    "id": "719460102",
                    "speaker": "Mengmeng",
                    "text": "Ah, I'm sorry, I did a bad thing."
                },
                {
                    "id": "719460103",
                    "speaker": "Mengmeng",
                    "text": "I'm not good with my hands... I broke a lot of flower stems, and they couldn't be used to make garland..."
                },
                {
                    "id": "719460104",
                    "speaker": "Mengmeng",
                    "text": "...Well, I guess I'll just give these flowers to you!"
                },
                {
                    "id": "719460105",
                    "speaker": "Mengmeng",
                    "text": "This way, they'll see some use."
                }
            ]
        },
        {
            "talkId": "6211801",
            "initDialog": "621180101",
            "dialogues": [
                {
                    "id": "621180101",
                    "speaker": "Mengmeng",
                    "text": "Eight, nine, ten..."
                },
                {
                    "id": "621180102",
                    "speaker": "Mengmeng",
                    "text": "...Aw shucks, I've run out of fingers. What do I do now?"
                }
            ]
        },
        {
            "talkId": "6211802",
            "initDialog": "621180201",
            "dialogues": [
                {
                    "id": "621180201",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "621180202",
                    "speaker": "Mengmeng",
                    "text": "Picking flowers!"
                },
                {
                    "id": "621180203",
                    "speaker": "Mengmeng",
                    "text": "I wanna make a flower chain for Yu. We were gonna play together today, but his dad's sick, so he has to watch the tea stand..."
                },
                {
                    "id": "621180204",
                    "speaker": "Mengmeng",
                    "text": "My garland keeps breaking, though. So I keep having to pick new flowers."
                }
            ]
        },
        {
            "talkId": "6211803",
            "initDialog": "621180301",
            "dialogues": [
                {
                    "id": "621180301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "621180302",
                    "speaker": "Mengmeng",
                    "text": "Bye-bye..."
                },
                {
                    "id": "621180303",
                    "speaker": "Mengmeng",
                    "text": "I need to find a new spot to pick flowers in. If I keep picking these ones, they'll all be gone!"
                }
            ]
        }
    ]
}