{
    "groupId": "7455",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Greygory": 8,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6745501",
            "initDialog": "674550101",
            "dialogues": [
                {
                    "id": "674550101",
                    "speaker": "Greygory",
                    "text": "Paper, paper! News every citizen of Snezhnaya ought to care about. Surely you wouldn’t want to miss it?"
                }
            ]
        },
        {
            "talkId": "6745502",
            "initDialog": "674550201",
            "dialogues": [
                {
                    "id": "674550201",
                    "speaker": "Player",
                    "text": "What kind of news?"
                },
                {
                    "id": "674550202",
                    "speaker": "Greygory",
                    "text": "Diplomacy, finance, war, important personages, and the Veche arguing furiously for three hours before finally deciding to continue arguing next week."
                },
                {
                    "id": "674550203",
                    "speaker": "Greygory",
                    "text": "That sort of thing. For just a few Mora, you can learn which way Snezhnaya's fate is turning."
                },
                {
                    "id": "674550204",
                    "speaker": "Greygory",
                    "text": "Go on, take one. I can tell you care at least a little about the way things are going."
                }
            ]
        },
        {
            "talkId": "6745503",
            "initDialog": "674550301",
            "dialogues": [
                {
                    "id": "674550301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "674550302",
                    "speaker": "Greygory",
                    "text": "Until next time."
                }
            ]
        },
        {
            "talkId": "6745504",
            "initDialog": "674550401",
            "dialogues": [
                {
                    "id": "674550401",
                    "speaker": "Player",
                    "text": "Can't say that I do."
                },
                {
                    "id": "674550402",
                    "speaker": "Greygory",
                    "text": "...H-How modest of you."
                },
                {
                    "id": "674550403",
                    "speaker": "Greygory",
                    "text": "Well then, if you ever wish to know which direction our fate is headed, and whether we will all be going hungry tomorrow, I will be waiting for you right here."
                }
            ]
        },
        {
            "talkId": "6745505",
            "initDialog": "674550501",
            "dialogues": [
                {
                    "id": "674550501",
                    "speaker": "Player",
                    "text": "I'm fine for now."
                },
                {
                    "id": "674550502",
                    "speaker": "Greygory",
                    "text": "That's a shame. Farewell."
                }
            ]
        }
    ]
}