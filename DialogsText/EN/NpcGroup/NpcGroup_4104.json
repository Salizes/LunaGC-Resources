    "talks": [
        {
            "talkId": "6410401",
            "initDialog": "641040101",
            "dialogues": [
                {
                    "id": "641040101",
                    "speaker": "Minoo",
                    "text": "Only kids who haven't grown up would believe in stories about Aranara."
                }
            ]
        },
        {
            "talkId": "6410402",
            "initDialog": "641040201",
            "dialogues": [
                {
                    "id": "641040201",
                    "speaker": "Player",
                    "text": "About the Aranara..."
                },
                {
                    "id": "641040202",
                    "speaker": "Minoo",
                    "text": "They're fantastical creatures from fairytales. You must keep that in mind."
                },
                {
                    "id": "641040203",
                    "speaker": "Minoo",
                    "text": "If you still believe in the Aranara, you haven't grown up yet."
                }
            ]
        },
        {
            "talkId": "6410403",
            "initDialog": "641040301",
            "dialogues": [
                {
                    "id": "641040301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641040302",
                    "speaker": "Minoo",
                    "text": "From now on, Minoo shall be a courageous adult."
                }
            ]
        },
        {
            "talkId": "6410404",
            "initDialog": "641040401",
            "dialogues": [
                {
                    "id": "641040401",
                    "speaker": "Player",
                    "text": "What kind of stories?"
                },
                {
                    "id": "641040402",
                    "speaker": "Minoo",
                    "text": "Many! Haven't you heard?"
                },
                {
                    "id": "641040403",
                    "speaker": "Minoo",
                    "text": "Like the \"Brave Aranara.\" They might be small, but very brave."
                },
                {
                    "id": "641040404",
                    "speaker": "Minoo",
                    "text": "Despite their fear of fire, Aranara would protect the forest... *sob* Putting out wildfires with their bodies..."
                },
                {
                    "id": "641040405",
                    "speaker": "Minoo",
                    "text": "*sob* Aranara..."
                },
                {
                    "id": "641040406",
                    "speaker": "Minoo",
                    "text": "Wait, no, that's just a childhood story! Minoo is older now and doesn't believe in that anymore..."
                },
                {
                    "id": "641040407",
                    "speaker": "Minoo",
                    "text": "*sob*"
                }
            ]
        }
    ]
}