        },
        {
            "talkId": "6506902",
            "initDialog": "650690201",
            "dialogues": [
                {
                    "id": "650690201",
                    "speaker": "Player",
                    "text": "What do you sell here?"
                },
                {
                    "id": "650690202",
                    "speaker": "Crossa",
                    "text": "Take your pick."
                }
            ]
        },
        {
            "talkId": "6506903",
            "initDialog": "650690301",
            "dialogues": [
                {
                    "id": "650690301",
                    "speaker": "Player",
                    "text": "I don't really feel anything."
                },
                {
                    "id": "650690302",
                    "speaker": "Crossa",
                    "text": "*sigh* Must be my old sickness acting up, then."
                },
                {
                    "id": "650690303",
                    "speaker": "Crossa",
                    "text": "I used to be a sailor, but I was injured in an accident, and ever since, I've felt like my surroundings are shaking."
                },
                {
                    "id": "650690304",
                    "speaker": "Crossa",
                    "text": "I can't go back to being a sailor, so I can only help old friends sell things they salvage underwater to make a living."
                }
            ]
        },
        {
            "talkId": "6506904",
            "initDialog": "650690401",
            "dialogues": [
                {
                    "id": "650690401",
                    "speaker": "Player",
                    "text": "Take care of yourself."
                },
                {
                    "id": "650690402",
                    "speaker": "Crossa",
                    "text": "Yeah... I think I should take a break for now."
                }
            ]
        }
