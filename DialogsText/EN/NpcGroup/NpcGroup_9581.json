            "dialogues": [
                {
                    "id": "695810301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "695810302",
                    "speaker": "Arlecchino",
                    "text": "Yes, time for me to head back, as well. No rest for the wicked."
