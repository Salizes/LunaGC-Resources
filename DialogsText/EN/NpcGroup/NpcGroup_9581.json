        {
            "talkId": "6958104",
            "initDialog": "695810401",
            "dialogues": [
                {
                    "id": "695810401",
                    "speaker": "Arlecchino",
                    "text": "Try hiding your tactics next time. A spider never builds a web in plain sight. It works in the shadows, until it's ready to strike."
                }
            ]
        },
        {
            "talkId": "6958105",
            "initDialog": "695810501",
            "dialogues": [
                {
                    "id": "695810501",
                    "speaker": "Arlecchino",
                    "text": "It would appear you have caught me in your web. Well done. You're learning."
                }
            ]
        },
        {
            "talkId": "6958106",
            "initDialog": "695810601",
            "dialogues": [
                {
                    "id": "695810601",
                    "speaker": "Arlecchino",
                    "text": "Ah, yes, I've seen the children play this game, so I'm familiar with the rules. A round, you say? As you wish."
                }
            ]
        },
        {
            "talkId": "6958108",
            "initDialog": "695810801",
            "dialogues": [
                {
                    "id": "695810801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6958109",
            "initDialog": "695810901",
            "dialogues": [
                {
                    "id": "695810901",
                    "speaker": "Player",
                    "text": "Let me adjust my deck first..."
                }
            ]
        },
        {
            "talkId": "6958110",
            "initDialog": "695811001",
            "dialogues": [
                {
                    "id": "695811001",
                    "speaker": "Arlecchino",
                    "text": "All that staring... Were you attempting to read my emotions? Or gauge the strength of my hand? Not a bad thought, but unsuccessful, I'm afraid."
                }
            ]
        },
        {
            "talkId": "6958111",
            "initDialog": "695811101",
            "dialogues": [
                {
                    "id": "695811101",
                    "speaker": "Arlecchino",
                    "text": "The children would love to see you. Feel free to come pay them a visit, should you have the time."
                }
            ]
        },
        {
            "talkId": "6958112",
            "initDialog": "695811201",
            "dialogues": [
                {
                    "id": "695811201",
                    "speaker": "Arlecchino",
                    "text": "Another round? Very well. I suppose I have a moment to spare."
                }
            ]
        },
        {
            "talkId": "6958114",
            "initDialog": "695811401",
            "dialogues": [
                {
                    "id": "695811401",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
