            "dialogues": [
                {
                    "id": "678510101",
                    "speaker": "Guseva",
                    "text": "There's nothing I can do now but wait..."
                }
            ]
        },
        {
            "talkId": "6785102",
            "initDialog": "678510201",
            "dialogues": [
                {
                    "id": "678510201",
                    "speaker": "Player",
                    "text": "What are you waiting for?"
                },
                {
                    "id": "678510202",
                    "speaker": "Guseva",
                    "text": "I am waiting for the next crystal ore shipment to arrive. I am waiting for things in Sretomorozsk to return to normal, so that the next train and come and take me away from here."
                }
            ]
        },
        {
            "talkId": "6785103",
            "initDialog": "678510301",
            "dialogues": [
                {
                    "id": "678510301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "678510302",
                    "speaker": "Guseva",
                    "text": "See you."
                }
            ]
        },
        {
            "talkId": "6785104",
            "initDialog": "678510401",
            "dialogues": [
                {
                    "id": "678510401",
                    "speaker": "Player",
                    "text": "Where are you going?"
                },
                {
                    "id": "678510402",
                    "speaker": "Guseva",
                    "text": "To Glupov. I was heading there for the Fatui recruitment exam originally. Had the trains not stopped running, I might have already been accepted by now."
                },
                {
                    "id": "678510403",
                    "speaker": "Guseva",
                    "text": "But this is my home, and no matter how great the storms here are, I shall weather them alongside."
                }
            ]
        },
        {
