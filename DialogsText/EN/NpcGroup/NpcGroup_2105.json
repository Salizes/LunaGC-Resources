        {
            "talkId": "6210502",
            "initDialog": "621050201",
            "dialogues": [
                {
                    "id": "621050201",
                    "speaker": "Player",
                    "text": "What's wrong?"
                },
                {
                    "id": "621050202",
                    "speaker": "Jingda",
                    "text": "Nothing. Life is exhausting enough by itself. Then there's talking to people, which takes brain power — and you know what's also exhausting? Using my brain."
                },
                {
                    "id": "621050203",
                    "speaker": "Jingda",
                    "text": "Ah, my existence is so tragic..."
                }
            ]
        },
        {
            "talkId": "6210503",
            "initDialog": "621050301",
            "dialogues": [
                {
                    "id": "621050301",
                    "speaker": "Player",
                    "text": "Sorry. It's nothing."
                },
                {
                    "id": "621050302",
                    "speaker": "Jingda",
                    "text": "Oh, nothing, is it? Great..."
                }
            ]
        }
