            "dialogues": [
                {
                    "id": "615780101",
                    "speaker": "Troubled Lianne",
                    "text": "Hello, do you have a favorite delicacy?"
                }
            ]
        },
        {
            "talkId": "6157802",
            "initDialog": "615780201",
            "dialogues": [
                {
                    "id": "615780201",
                    "speaker": "Player",
                    "text": "Define \"delicacy\"?"
                },
                {
                    "id": "615780202",
                    "speaker": "Troubled Lianne",
                    "text": "For me, a true delicacy has to be something that's made using only the very freshest ingredients."
                },
                {
                    "id": "615780203",
                    "speaker": "Troubled Lianne",
                    "text": "In fairness, most chefs in Mondstadt do use fresh produce from Springvale..."
                },
                {
                    "id": "615780204",
                    "speaker": "Troubled Lianne",
                    "text": "But I still feel safer when I've gone out and collected my ingredients myself."
                }
            ]
        },
        {
            "talkId": "6157803",
            "initDialog": "615780301",
            "dialogues": [
                {
                    "id": "615780301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "615780302",
                    "speaker": "Troubled Lianne",
                    "text": "Byeee!"
                }
            ]
        }
    ]
