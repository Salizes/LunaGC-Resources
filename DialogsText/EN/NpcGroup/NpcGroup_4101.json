{
    "groupId": "4101",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Nigina": 8,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6410101",
            "initDialog": "641010101",
            "dialogues": [
                {
                    "id": "641010101",
                    "speaker": "Nigina",
                    "text": "I wonder if the children are used to life in the Akademiya."
                }
            ]
        },
        {
            "talkId": "6410102",
            "initDialog": "641010201",
            "dialogues": [
                {
                    "id": "641010201",
                    "speaker": "Player",
                    "text": "About the children..."
                },
                {
                    "id": "641010202",
                    "speaker": "Nigina",
                    "text": "They all went to the Akademiya and became official researchers, too busy to come home more than a couple times a year."
                },
                {
                    "id": "641010203",
                    "speaker": "Nigina",
                    "text": "So that leaves my old bones here."
                },
                {
                    "id": "641010204",
                    "speaker": "Nigina",
                    "text": "They have a great future ahead of them, so no complaints from me. I just want to know how they're doing."
                }
            ]
        },
        {
            "talkId": "6410103",
            "initDialog": "641010301",
            "dialogues": [
                {
                    "id": "641010301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641010302",
                    "speaker": "Nigina",
                    "text": "Goodbye."
                }
            ]
        },
        {
            "talkId": "7394401",
            "initDialog": "739440101",
            "dialogues": [
                {
                    "id": "739440101",
                    "speaker": "Player",
                    "text": "Kids will grow up."
                },
                {
                    "id": "739440102",
                    "speaker": "Nigina",
                    "text": "Right, you're right. I trust them to take care of themselves."
                },
                {
                    "id": "739440103",
                    "speaker": "Nigina",
                    "text": "It's just that I always cook too much when cooking for myself. How about you take some if you don't mind?"
                },
                {
                    "id": "739440104",
                    "speaker": "Nigina",
                    "text": "It's just some common Sumeru dishes. Hope you'll like it."
                }
            ]
        }
    ]
}