    "talks": [
        {
            "talkId": "6419701",
            "initDialog": "641970101",
            "dialogues": [
                {
                    "id": "641970101",
                    "speaker": "Arakanta",
                    "text": "Arakanta, never raced Nara..."
                }
            ]
        },
        {
            "talkId": "6419702",
            "initDialog": "641970201",
            "dialogues": [
                {
                    "id": "641970201",
                    "speaker": "Player",
                    "text": "About Festival Utsava..."
                },
                {
                    "id": "641970202",
                    "speaker": "Arakanta",
                    "text": "Festival Utsava, a happy festival. Many Aranara run here and there in Vanarana, and Arakanta must run in the front."
                }
            ]
        },
        {
            "talkId": "6419703",
            "initDialog": "641970301",
            "dialogues": [
                {
                    "id": "641970301",
                    "speaker": "Player",
                    "text": "About running match..."
                },
                {
                    "id": "641970302",
                    "speaker": "Arakanta",
                    "text": "Arana said, little Nara like running matches, too."
                },
                {
                    "id": "641970303",
                    "speaker": "Arakanta",
                    "text": "Arakanta wonders who will be faster. Little Nara? or Arakanta?"
                },
                {
                    "id": "641970304",
                    "speaker": "Arakanta",
                    "text": "Nara friend in Vanarana, must be a fast runner, too. Come to Festival Utsava, we race."
                }
            ]
        },
        {
            "talkId": "6419704",
            "initDialog": "641970401",
            "dialogues": [
                {
                    "id": "641970401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641970402",
                    "speaker": "Arakanta",
                    "text": "Bye, Arakanta keeps running, here and there."
                }
            ]
        },
        {
            "talkId": "6419705",
            "initDialog": "641970501",
            "dialogues": [
                {
                    "id": "641970501",
                    "speaker": "Arakanta",
                    "text": "Running match, win or lose, Arakanta is always happy."
                }
            ]
        },
        {
            "talkId": "6419706",
            "initDialog": "641970601",
            "dialogues": [
                {
                    "id": "641970601",
                    "speaker": "Player",
                    "text": "About the running match..."
                },
                {
                    "id": "641970602",
                    "speaker": "Arakanta",
                    "text": "Arakanta wants a match with all Aranara, but Arama is now Ashvattha. Arakanta is winning."
                },
                {
                    "id": "641970603",
                    "speaker": "Arakanta",
                    "text": "But Arakanta will go back to Sarva. Arama, too. Let's race there then!"
                }
            ]
        },
        {
            "talkId": "6419707",
            "initDialog": "641970701",
            "dialogues": [
                {
                    "id": "641970701",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641970702",
                    "speaker": "Arakanta",
                    "text": "#Bye, Nara {NICKNAME}. Hope Nara {NICKNAME} will be the fastest runner among all Nara."
                }
            ]
        },
        {
            "talkId": "6419708",
            "initDialog": "641970801",
            "dialogues": [
                {
                    "id": "641970801",
                    "speaker": "Arakanta",
                    "text": "Festival Utsava is over? Time runs fast! Much faster than Arakanta! Arakanta wants more matches with Nara friend..."
                }
            ]
        }
    ]
}