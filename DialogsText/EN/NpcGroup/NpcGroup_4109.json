                {
                    "id": "641090101",
                    "speaker": "Oguz",
                    "text": "Hello, what can I help you with?"
                }
            ]
        },
        {
            "talkId": "6410902",
            "initDialog": "641090201",
            "dialogues": [
                {
                    "id": "641090201",
                    "speaker": "Player",
                    "text": "And you are..."
                },
                {
                    "id": "641090202",
                    "speaker": "Oguz",
                    "text": "I'm with the Eremites, hired by the Akademiya to be a guard here."
                },
                {
                    "id": "641090203",
                    "speaker": "Oguz",
                    "text": "What's important is the duty of the Eremites, not who I am. We are the only authorized mercenary organization in the entire Sumeru."
                },
                {
                    "id": "641090204",
                    "speaker": "Oguz",
                    "text": "Remember that so you won't get cheated by scammers."
                },
                {
                    "id": "641090205",
                    "speaker": "Oguz",
                    "text": "If you need a competent, reliable bodyguard or watchman in Port Ormos, see our Captain Feroz."
                },
                {
                    "id": "641090206",
                    "speaker": "Oguz",
                    "text": "He is rather blunt, but will give you good people."
                }
            ]
        },
        {
            "talkId": "6410903",
            "initDialog": "641090301",
            "dialogues": [
                {
                    "id": "641090301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
