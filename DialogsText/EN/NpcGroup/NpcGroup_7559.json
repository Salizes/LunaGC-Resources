    "talks": [
        {
            "talkId": "6755901",
            "initDialog": "675590101",
            "dialogues": [
                {
                    "id": "675590101",
                    "speaker": "???",
                    "text": "If only... if only he could come back home more often!"
                }
            ]
        },
        {
            "talkId": "6755902",
            "initDialog": "675590201",
            "dialogues": [
                {
                    "id": "675590201",
                    "speaker": "Player",
                    "text": "Are you missing your big brother?"
                },
                {
                    "id": "675590202",
                    "speaker": "???",
                    "text": "Yeah! I mean, I miss my two oldest brothers too, but they come home every few days, so it's not the same..."
                },
                {
                    "id": "675590203",
                    "speaker": "???",
                    "text": "But big brother Ajax, he's different and I miss him so much more! He's the best toy salesman ever, and he always brings back tons of new toys whenever he comes home!"
                },
                {
                    "id": "675590204",
                    "speaker": "???",
                    "text": "Even when he can't make it home, he still writes letters to Tonia... and he always sends lots of yummy treats and fun things with them."
                },
                {
                    "id": "675590205",
                    "speaker": "???",
                    "text": "The treats and toys are great and all, but... it's still way better when big brother comes home to play with me..."
                }
            ]
        },
        {
            "talkId": "6755903",
            "initDialog": "675590301",
            "dialogues": [
                {
                    "id": "675590301",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "675590302",
                    "speaker": "???",
                    "text": "I'm on an adventure with Mr. Cyclops! Uh-huh, I'm Mr. Cyclops's adventure partner!"
                },
                {
                    "id": "675590303",
                    "speaker": "???",
                    "text": "Mr. Cyclops beat up the... Sea Squishy-Hedgehog, and the Fire Squishy-Hedgehog, and the Grass Squishy-Hedgehog! Pew-Pew~"
                }
            ]
        },
        {
            "talkId": "6755904",
            "initDialog": "675590401",
            "dialogues": [
                {
                    "id": "675590401",
                    "speaker": "Player",
                    "text": "Goodbye, Teucer."
                },
                {
                    "id": "675590402",
                    "speaker": "???",
                    "text": "Bye-bye! Bye-byeee!"
                }
            ]
        },
        {
            "talkId": "6755905",
            "initDialog": "675590501",
            "dialogues": [
                {
                    "id": "675590501",
                    "speaker": "Player",
                    "text": "Why is everything a Squishy-Hedgehog...?"
                },
                {
                    "id": "675590502",
                    "speaker": "???",
                    "text": "Because when I went adventuring in the forest when I was little, I almost got bitten by one! If my big brother hadn't been there to protect me, it would've totally gotten me!..."
                },
                {
                    "id": "675590503",
                    "speaker": "???",
                    "text": "So Squishy-Hedgehogs are definitely bad things!"
                }
            ]
        },
        {
            "talkId": "6755906",
            "initDialog": "675590601",
            "dialogues": [
                {
                    "id": "675590601",
                    "speaker": "Player",
                    "text": "Don't tell me there are Geo, Electro, Cryo, and Anemo Squishy-Hedgehogs too..."
                },
                {
                    "id": "675590602",
                    "speaker": "???",
                    "text": "?"
                },
                {
                    "id": "675590603",
                    "speaker": "???",
                    "text": "I don't know about that, but since there are so many different kinds, maybe the next time Mr. Cyclops goes adventuring, he'll run into a Geo-Lectro, Cry-O-Nemo Squishy-Hedgehog just like you said!"
                }
            ]
        },
