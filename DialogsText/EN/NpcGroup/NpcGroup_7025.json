            "dialogues": [
                {
                    "id": "670250101",
                    "speaker": "Havu",
                    "text": "Conch Gang? Hmph! Who the heck cares about those dolts? I sure don't! Hmph!"
                }
            ]
        },
        {
            "talkId": "6702502",
            "initDialog": "670250201",
            "dialogues": [
                {
                    "id": "670250201",
                    "speaker": "Player",
                    "text": "I'm a gang member. Don't care about that, do you?"
                },
                {
                    "id": "670250202",
                    "speaker": "Havu",
                    "text": "Huh? L—Like heck you are! It's not that easy to join the Conch Gang... Wait, why are you even telling me this!?"
                },
                {
                    "id": "670250203",
                    "speaker": "Havu",
                    "text": "The Conch Gang's none of my business. None at all..."
                }
            ]
        },
        {
            "talkId": "6702503",
            "initDialog": "670250301",
            "dialogues": [
                {
                    "id": "670250301",
                    "speaker": "Player",
                    "text": "Did you have a falling out with them?"
                },
                {
                    "id": "670250302",
                    "speaker": "Havu",
                    "text": "Falling out? What, me?"
                },
                {
                    "id": "670250303",
                    "speaker": "Havu",
                    "text": "...Well, if you mean a fight, then yeah, we've fought before. But it's nothing serious. It's not my fault that I'm so strong, it's theirs for being too weak!"
                },
                {
                    "id": "670250304",
                    "speaker": "Havu",
                    "text": "Hmph! It's all because they don't know how strong I am! When they find out... Well, I'm not gonna let them off the hook so easy either way. That's what they get for starting it! Hmph!"
                }
            ]
        },
        {
            "talkId": "6702504",
            "initDialog": "670250401",
            "dialogues": [
                {
                    "id": "670250401",
                    "speaker": "Player",
                    "text": "Sorry to bother you."
                },
                {
                    "id": "670250402",
                    "speaker": "Havu",
                    "text": "Right."
                }
            ]
        },
        {
            "talkId": "6702505",
            "initDialog": "670250501",
            "dialogues": [
                {
                    "id": "670250501",
                    "speaker": "Havu",
                    "text": "Adventure Challenge"
