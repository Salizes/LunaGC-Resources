        },
        {
            "talkId": "6957905",
            "initDialog": "695790501",
            "dialogues": [
                {
                    "id": "695790501",
                    "speaker": "Clorinde",
                    "text": "Well done. Games like these are decided on skill, rather than luck. You won this fair and square, and I respect the result."
