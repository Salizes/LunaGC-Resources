{
    "groupId": "9029",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Klee": 49,
        "Player": 21
    },
    "talks": [
        {
            "talkId": "6902901",
            "initDialog": "690290101",
            "dialogues": [
                {
                    "id": "690290101",
                    "speaker": "Klee",
                    "text": "#Oh, it's {F#Miss}{M#Mr.} Honorary Knight!"
                },
                {
                    "id": "690290102",
                    "speaker": "Klee",
                    "text": "I'm really happy to see you again!"
                }
            ]
        },
        {
            "talkId": "6902902",
            "initDialog": "690290201",
            "dialogues": [
                {
                    "id": "690290201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                },
                {
                    "id": "690290202",
                    "speaker": "Klee",
                    "text": "It's really fun here!"
                },
                {
                    "id": "690290203",
                    "speaker": "Klee",
                    "text": "The house is huge and there's a lot of room."
                },
                {
                    "id": "690290204",
                    "speaker": "Klee",
                    "text": "There are lots of new things here. It'll take a loooong time to run from one end of the road to the other.",
                    "choices": [
                        {
                            "id": "690290205",
                            "text": "Sounds like you're having a fun time.",
                            "response": [
                                {
                                    "id": "690290206",
                                    "speaker": "Klee",
                                    "text": "A really really fun time!"
                                },
                                {
                                    "id": "690290207",
                                    "speaker": "Klee",
                                    "text": "#If {F#Miss}{M#Mr.} Honorary Knight has time, Klee will play with you!"
                                },
                                {
                                    "id": "690290212",
                                    "speaker": "Klee",
                                    "text": "Catching lizards, chasing frogs, drawing, making crafts, hide-and-seek... There are so many fun things to do!"
                                }
                            ]
                        },
                        {
                            "id": "690290208",
                            "text": "You haven't been up to mischief, have you?",
                            "response": [
                                {
                                    "id": "690290209",
                                    "speaker": "Klee",
                                    "text": "No! Definitely not!"
                                },
                                {
                                    "id": "690290210",
                                    "speaker": "Klee",
                                    "text": "#Master Jean told Klee many times that Klee can't destroy {F#Miss}{M#Mr.} Honorary Knight's house."
                                },
                                {
                                    "id": "690290211",
                                    "speaker": "Klee",
                                    "text": "So I didn't bring any of my treasures."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902903",
            "initDialog": "690290301",
            "dialogues": [
                {
                    "id": "690290301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
                },
                {
                    "id": "690290302",
                    "speaker": "Klee",
                    "text": "Okay, I'll come! I like chatting."
                },
                {
                    "id": "690290303",
                    "speaker": "Klee",
                    "text": "Ah, I can show you the latest cool thing I found.",
                    "choices": [
                        {
                            "id": "690290304",
                            "text": "Another cool thing?",
                            "response": [
                                {
                                    "id": "690290306",
                                    "speaker": "Klee",
                                    "text": "Look at this! An awesome fishing net!"
                                },
                                {
                                    "id": "690290307",
                                    "speaker": "Klee",
                                    "text": "Lemme teach you! You spread the net into the lake like this... Wait for the right moment and..."
                                },
                                {
                                    "id": "690290308",
                                    "speaker": "Klee",
                                    "text": "Woosh! You scoop it up."
                                },
                                {
                                    "id": "690290309",
                                    "speaker": "Klee",
                                    "text": "You have to make sure you're quietly hiding, then take them by surprise!",
                                    "choices": [
                                        {
                                            "id": "690290310",
                                            "text": "That was pretty impressive.",
                                            "response": [
                                                {
                                                    "id": "690290311",
                                                    "speaker": "Klee",
                                                    "text": "Hehe, Klee told you all her secrets. Now you can be as amazing as Klee!"
                                                },
                                                {
                                                    "id": "690290314",
                                                    "speaker": "Klee",
                                                    "text": "This way is a bit more annoying than using bombs though."
                                                },
                                                {
                                                    "id": "690290315",
                                                    "speaker": "Klee",
                                                    "text": "Fish are slippery and flop around a lot, so they'll jump back into the water if you don't hold them tight."
                                                },
                                                {
                                                    "id": "690290316",
                                                    "speaker": "Klee",
                                                    "text": "But... it's also fun to play with fish like this!",
                                                    "choices": [
                                                        {
                                                            "id": "690290317",
                                                            "text": "If you're with me, then don't worry, you can use your bombs.",
                                                            "response": [
                                                                {
                                                                    "id": "690290318",
                                                                    "speaker": "Klee",
                                                                    "text": "Oh! Really?"
                                                                },
                                                                {
                                                                    "id": "690290319",
                                                                    "speaker": "Klee",
                                                                    "text": "Then wait for me! I can make a lot of bombs really fast because I already prepared the materials!"
                                                                },
                                                                {
                                                                    "id": "690290323",
                                                                    "speaker": "Klee",
                                                                    "text": "Hee hee, I'm super happy!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690290320",
                                                            "text": "Let's have a fishing competition next time.",
                                                            "response": [
                                                                {
                                                                    "id": "690290321",
                                                                    "speaker": "Klee",
                                                                    "text": "Okay!"
                                                                },
                                                                {
                                                                    "id": "690290322",
                                                                    "speaker": "Klee",
                                                                    "text": "#If {F#Miss}{M#Mr.} Honorary Knight loses, then you have to cook dinner for Klee!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690290312",
                                            "text": "Why aren't you bombing the fish?",
                                            "response": [
                                                {
                                                    "id": "690290313",
                                                    "speaker": "Klee",
                                                    "text": "#Cause this is {F#Miss}{M#Mr.} Honorary Knight's house, so Klee should be careful not to blow stuff up..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690290305",
                            "text": "What is it?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902904",
            "initDialog": "690290401",
            "dialogues": [
                {
                    "id": "690290401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
                },
                {
                    "id": "690290402",
                    "speaker": "Klee",
                    "text": "#Yes! There's something that Klee needs your help with, {F#Miss}{M#Mr.} Honorary Knight!"
                },
                {
                    "id": "690290403",
                    "speaker": "Klee",
                    "text": "I wanna make a Jumpy Army!",
                    "choices": [
                        {
                            "id": "690290404",
                            "text": "...A Jumpy what?",
                            "response": [
                                {
                                    "id": "690290405",
                                    "speaker": "Klee",
                                    "text": "A Jumpy Army! It's just... lots and lots and lots of Jumpy Dumpties."
                                },
                                {
                                    "id": "690290406",
                                    "speaker": "Klee",
                                    "text": "#{F#Miss}{M#Mr.} Honorary Knight, pleeeeaaaase."
                                },
                                {
                                    "id": "690290407",
                                    "speaker": "Player",
                                    "text": "Alright then..."
                                },
                                {
                                    "id": "690290410",
                                    "speaker": "Klee",
                                    "text": "Then let's get started!"
                                },
                                {
                                    "id": "690290411",
                                    "speaker": "Klee",
                                    "text": "#I'll be responsible for making Jumpy Dumpties, so {F#Miss}{M#Mr.} Honorary Knight can give jobs to them."
                                },
                                {
                                    "id": "690290412",
                                    "speaker": "Klee",
                                    "text": "We need a shopkeeper, a chef, an artist, a circus performer...",
                                    "choices": [
                                        {
                                            "id": "690290413",
                                            "text": "Those don't sound like army ranks...",
                                            "response": [
                                                {
                                                    "id": "690290414",
                                                    "speaker": "Klee",
                                                    "text": "It's okay! They're here for Ludi Harpastum."
                                                },
                                                {
                                                    "id": "690290417",
                                                    "speaker": "Klee",
                                                    "text": "#With the Jumpy Army, Klee can celebrate Ludi Harpastum with {F#Miss}{M#Mr.} Honorary Knight every day!"
                                                },
                                                {
                                                    "id": "690290418",
                                                    "speaker": "Klee",
                                                    "text": "#A Ludi Harpastum with {F#Miss}{M#Mr.} Honorary Knight will be the bestest Ludi Harpastum!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690290415",
                                            "text": "Sounds a bit complicated.",
                                            "response": [
                                                {
                                                    "id": "690290416",
                                                    "speaker": "Klee",
                                                    "text": "It's fine. As long as everyone wears little accessories, you can tell what they're supposed to be!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690290408",
                            "text": "Sure, I can help out.",
                            "response": [
                                {
                                    "id": "690290409",
                                    "speaker": "Klee",
                                    "text": "#Yay, {F#Miss}{M#Mr.} Honorary Knight is the best!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902905",
            "initDialog": "690290501",
            "dialogues": [
                {
                    "id": "690290501",
                    "speaker": "Player",
                    "text": "Good morning, Klee."
                },
                {
                    "id": "690290502",
                    "speaker": "Klee",
                    "text": "#Morning, {F#Miss}{M#Mr.} Honorary Knight!"
                },
                {
                    "id": "690290503",
                    "speaker": "Klee",
                    "text": "Are you going to take me on a huge adventure? I've been waiting and waiting."
                }
            ]
        },
        {
            "talkId": "6902906",
            "initDialog": "690290601",
            "dialogues": [
                {
                    "id": "690290601",
                    "speaker": "Player",
                    "text": "Good night, Klee."
                },
                {
                    "id": "690290602",
                    "speaker": "Klee",
                    "text": "I don't wanna go to sleep yet..."
                },
                {
                    "id": "690290603",
                    "speaker": "Klee",
                    "text": "#But.. Klee promised she'd be good, so she will first say good night to {F#Miss}{M#Mr.} Honorary Knight."
                }
            ]
        },
        {
            "talkId": "6902907",
            "initDialog": "690290701",
            "dialogues": [
                {
                    "id": "690290701",
                    "speaker": "Player",
                    "text": "Would you like to have a chat with me?"
                }
            ]
        },
        {
            "talkId": "6902908",
            "initDialog": "690290801",
            "dialogues": [
                {
                    "id": "690290801",
                    "speaker": "Player",
                    "text": "Is there anything you'd like to do?"
                }
            ]
        },
        {
            "talkId": "6902909",
            "initDialog": "690290901",
            "dialogues": [
                {
                    "id": "690290901",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                }
            ]
        },
        {
            "talkId": "6902950",
            "initDialog": "690295001",
            "dialogues": [
                {
                    "id": "690295001",
                    "speaker": "Klee",
                    "text": "Ooh, I know how to use this workshop!"
                },
                {
                    "id": "690295002",
                    "speaker": "Klee",
                    "text": "Some things look kinda different, but I'm sure I'll get the hang of it after a few tries!"
                },
                {
                    "id": "690295003",
                    "speaker": "Klee",
                    "text": "#Hehe. Thank you, {F#Miss}{M#Mr.} Honorary Knight!"
                }
            ]
        },
        {
            "talkId": "6902951",
            "initDialog": "690295101",
            "dialogues": [
                {
                    "id": "690295101",
                    "speaker": "Klee",
                    "text": "This place sure looks familiar. I might have blown up— Um, I mean, seen a house like this one before!"
                },
                {
                    "id": "690295102",
                    "speaker": "Klee",
                    "text": "Anyway, this place is huuuuge! We're gonna have lots of fun, I know it!"
                },
                {
                    "id": "690295103",
                    "speaker": "Klee",
                    "text": "#{F#Miss}{M#Mr.} Honorary Knight, you can play with me, too!"
                }
            ]
        }
    ]
}