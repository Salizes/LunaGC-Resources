    "talks": [
        {
            "talkId": "30803",
            "initDialog": "3080301",
            "dialogues": [
                {
                    "id": "3080301",
                    "speaker": "Lisa",
                    "text": "I'm Lisa, the librarian. Do you need anything, cutie?",
                    "choices": [
                        {
                            "id": "3080302",
                            "text": "I'd like to know more about monsters.",
                            "response": [
                                {
                                    "id": "3080303",
                                    "speaker": "Lisa",
                                    "text": "The monsters out in the wild? We've got many resources here in the library."
                                },
                                {
                                    "id": "3080304",
                                    "speaker": "Lisa",
                                    "text": "Making good use of elemental advantages is the key to winning any battle."
                                },
                                {
                                    "id": "3080305",
                                    "speaker": "Lisa",
                                    "text": "By the way, would you be interested in having a part-time job here?"
                                },
                                {
                                    "id": "3080306",
                                    "speaker": "Lisa",
                                    "text": "We need people to... need people for doing... We just need more people."
                                }
                            ]
                        },
                        {
                            "id": "3080307",
                            "text": "How do we fight Stormterror?",
                            "response": [
                                {
                                    "id": "3080308",
                                    "speaker": "Lisa",
                                    "text": "A way to fight against Stormterror..."
                                },
                                {
                                    "id": "3080309",
                                    "speaker": "Lisa",
                                    "text": "I'm sorry, but there's no way to do it alone."
                                },
                                {
                                    "id": "3080310",
                                    "speaker": "Lisa",
                                    "text": "Judging by the level of its Anemo power, it's definitely not an ordinary creature."
                                },
                                {
                                    "id": "3080311",
                                    "speaker": "Lisa",
                                    "text": "I could teach you some elemental basics, so you'll have an idea of what I'm talking about."
                                }
                            ]
                        },
                        {
                            "id": "3080312",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3080313",
                                    "speaker": "Lisa",
                                    "text": "Heading out? See you in a bit."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "37314",
            "initDialog": "3730926",
            "dialogues": [
                {
                    "id": "3730926",
                    "speaker": "Lisa",
                    "text": "It's getting harder to make small talk these days. Even something as innocuous as \"what fine weather we're having today\" seems to fall completely flat...",
                    "choices": [
                        {
                            "id": "3730927",
                            "text": "Tell me about the library.",
                            "response": [
                                {
                                    "id": "3730928",
                                    "speaker": "Lisa",
                                    "text": "You can visit whenever you need to look something up."
                                },
                                {
                                    "id": "3730929",
                                    "speaker": "Lisa",
                                    "text": "Naturally the library is free to access."
                                },
                                {
                                    "id": "3730930",
                                    "speaker": "Lisa",
                                    "text": "Just don't forget to return books on time, or you'll make my job difficult."
                                }
                            ]
                        },
                        {
                            "id": "3730931",
                            "text": "I'd like to know more about monsters.",
                            "response": [
                                {
                                    "id": "3730932",
                                    "speaker": "Lisa",
                                    "text": "The monsters out in the wild? We've got many resources here in the library."
                                },
                                {
                                    "id": "3730933",
                                    "speaker": "Lisa",
                                    "text": "Making good use of elemental advantages is the key to winning any battle."
                                },
                                {
                                    "id": "3730934",
                                    "speaker": "Lisa",
                                    "text": "By the way, would you be interested in having a part-time job here?"
                                },
                                {
                                    "id": "3730935",
                                    "speaker": "Lisa",
                                    "text": "We need people to... need people for doing... We just need more people."
                                }
                            ]
                        },
                        {
                            "id": "3730936",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3730937",
                                    "speaker": "Lisa",
                                    "text": "You're leaving? Drop by again sometime when you're free."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}