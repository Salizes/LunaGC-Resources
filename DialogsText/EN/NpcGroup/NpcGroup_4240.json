            "dialogues": [
                {
                    "id": "642400101",
                    "speaker": "Aranakin",
                    "text": "Oh... It's Nara friend. H—Hello..."
                }
            ]
        },
        {
            "talkId": "6424002",
            "initDialog": "642400201",
            "dialogues": [
                {
                    "id": "642400201",
                    "speaker": "Player",
                    "text": "Hello..."
                },
                {
                    "id": "642400202",
                    "speaker": "Aranakin",
                    "text": "Vanarana rarely get visits from Nara, but Nara that come are all Aranara's friends."
                },
                {
                    "id": "642400203",
                    "speaker": "Aranakin",
                    "text": "Aranakin welcomes you... Nara friend that is met for the first time."
                }
            ]
        },
        {
            "talkId": "6424003",
            "initDialog": "642400301",
            "dialogues": [
                {
                    "id": "642400301",
                    "speaker": "Player",
                    "text": "See you..."
                },
                {
                    "id": "642400302",
                    "speaker": "Aranakin",
                    "text": "Goodbye... Nara friend."
                }
            ]
        },
        {
            "talkId": "6424004",
            "initDialog": "642400401",
            "dialogues": [
                {
                    "id": "642400401",
                    "speaker": "Aranakin",
                    "text": "#Kusava~ White Floaty~♪ Nara {NICKNAME} and White Floaty, sing together!"
                }
            ]
        },
        {
            "talkId": "6424005",
            "initDialog": "642400501",
            "dialogues": [
                {
                    "id": "642400501",
                    "speaker": "Player",
                    "text": "About singing..."
                },
                {
                    "id": "642400502",
                    "speaker": "Aranakin",
                    "text": "This song, it is from your story. Aranakin sang this song after obtaining the Zohrah Mushroom."
                },
                {
                    "id": "642400503",
                    "speaker": "Aranakin",
                    "text": "#Aranakin does not remember anymore, but the plants in the forest that hear this song will remember for sure. Aranakin once told them that Nara {NICKNAME} is an amazing seed, and Aranakin's friend."
                }
            ]
        },
        {
            "talkId": "6424006",
            "initDialog": "642400601",
            "dialogues": [
                {
                    "id": "642400601",
                    "speaker": "Player",
                    "text": "About Khayyam..."
                },
                {
                    "id": "642400602",
                    "speaker": "Aranakin",
                    "text": "Nara Khayyam... I had forgotten his name. He cannot see us anymore, right...?"
                },
                {
                    "id": "642400603",
                    "speaker": "Aranakin",
                    "text": "I can't meet him again, but I will use my singing to tell the forest, and tell the wind, to keep traces of him."
                },
                {
                    "id": "642400604",
                    "speaker": "Aranakin",
                    "text": "His name will not be forgotten again this way."
                }
            ]
        },
        {
            "talkId": "6424007",
            "initDialog": "642400701",
            "dialogues": [
                {
                    "id": "642400701",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "642400702",
                    "speaker": "Aranakin",
                    "text": "Bye, friend of Aranakin."
                }
            ]
        }
    ]
}