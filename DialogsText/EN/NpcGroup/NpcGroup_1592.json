{
    "groupId": "1592",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Greg": 14,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "6159201",
            "initDialog": "615920101",
            "dialogues": [
                {
                    "id": "615920101",
                    "speaker": "Greg",
                    "text": "You wanna grab a drink or two?"
                }
            ]
        },
        {
            "talkId": "6159202",
            "initDialog": "615920201",
            "dialogues": [
                {
                    "id": "615920201",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "615920202",
                    "speaker": "Greg",
                    "text": "The name's Greg! I work at the Dawn Winery — Master Diluc was in a good mood today and he gave me a bottle from his private stock!"
                },
                {
                    "id": "615920203",
                    "speaker": "Greg",
                    "text": "Good wine should be enjoyed in the company of good people! How's about you come with me to the winery and we crack this open together?"
                },
                {
                    "id": "615920204",
                    "speaker": "Greg",
                    "text": "Hmm... I must say I seem to have forgotten my way, the Dawn Winery is... northwest from here, right?",
                    "choices": [
                        {
                            "id": "615920205",
                            "text": "No.",
                            "response": [
                                {
                                    "id": "615920206",
                                    "speaker": "Greg",
                                    "text": "Tut-tut... You're clearly sober if your sense of direction is intact."
                                },
                                {
                                    "id": "615920207",
                                    "speaker": "Greg",
                                    "text": "Get outta my face, you non-drunkard!"
                                }
                            ]
                        },
                        {
                            "id": "615920208",
                            "text": "Yes.",
                            "response": [
                                {
                                    "id": "615920209",
                                    "speaker": "Greg",
                                    "text": "Hehehe, well, well, well... Off we go then!"
                                },
                                {
                                    "id": "615920210",
                                    "speaker": "Greg",
                                    "text": "It looks like someone's had a bit too much to drink! Here — let me hold you up..."
                                },
                                {
                                    "id": "615920211",
                                    "speaker": "Greg",
                                    "text": "Come on, don't worry about it! There's still a long way to go, let me hold you up."
                                },
                                {
                                    "id": "615920212",
                                    "speaker": "Player",
                                    "text": "You've been staring at my coin pouch this whole time."
                                },
                                {
                                    "id": "615920213",
                                    "speaker": "Greg",
                                    "text": "Ai-ya, my friend! Listen to the hurtful words you are saying! I couldn't possibly steal from you..."
                                },
                                {
                                    "id": "615920214",
                                    "speaker": "Greg",
                                    "text": "...Wait, how did you even notice?"
                                },
                                {
                                    "id": "615920215",
                                    "speaker": "Greg",
                                    "text": "If you're not drunk, then quit pretending to be! You're wasting my time!"
                                },
                                {
                                    "id": "615920216",
                                    "speaker": "Greg",
                                    "text": "Go on, move along. I've got no further interest in you."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6159203",
            "initDialog": "615920301",
            "dialogues": [
                {
                    "id": "615920301",
                    "speaker": "Player",
                    "text": "The feeling is mutual."
                },
                {
                    "id": "615920302",
                    "speaker": "Greg",
                    "text": "Whatever."
                }
            ]
        }
    ]
}