            "dialogues": [
                {
                    "id": "3125601",
                    "speaker": "Quest Test NPC",
                    "text": "Hey! Traveler!"
                },
                {
                    "id": "3125602",
                    "speaker": "Quest Test NPC",
                    "text": "It's dangerous ahead! Don't go that way!",
                    "choices": [
                        {
                            "id": "3125603",
                            "text": "...What's wrong?",
                            "response": [
                                {
                                    "id": "3125604",
                                    "speaker": "Quest Test NPC",
                                    "text": "The roads ahead are dangerous — a convoy was attacked by powerful monsters in the mountain pass."
                                },
                                {
                                    "id": "3125605",
                                    "speaker": "Quest Test NPC",
                                    "text": "We better leave if we have no business here."
                                }
                            ]
                        },
                        {
                            "id": "3125606",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3125607",
                                    "speaker": "Quest Test NPC",
                                    "text": "Take care."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "31257",
            "initDialog": "3125701",
            "dialogues": [
                {
                    "id": "3125701",
                    "speaker": "Quest Test NPC",
                    "text": "In front of you is the danger zone... Huh? Could you possibly be...",
                    "choices": [
                        {
                            "id": "3125702",
                            "text": "...What's wrong?",
                            "response": [
                                {
                                    "id": "3125703",
                                    "speaker": "Quest Test NPC",
                                    "text": "Your attire... Could you be the traveler they spoke of?"
                                },
                                {
                                    "id": "3125704",
                                    "speaker": "Quest Test NPC",
                                    "text": "Huh? You don't? Your heroic deeds have already spread across Mondstadt. I heard that it was you who put an end to the storms that terrorized Mondstadt!"
                                },
                                {
                                    "id": "3125705",
                                    "speaker": "Quest Test NPC",
                                    "text": "Though I believe you're capable of dealing with the monsters ahead, I'd still like to ask you to watch out and take care."
                                }
                            ]
                        },
                        {
                            "id": "3125706",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3125707",
                                    "speaker": "Quest Test NPC",
                                    "text": "Take care."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6009301",
            "initDialog": "4015140501",
            "dialogues": [
                {
                    "id": "4015140501",
                    "speaker": "Anna",
                    "text": "Hi. Is there something *coughs* I can do for you? *coughs*"
                }
            ]
        },
        {
            "talkId": "6009302",
            "initDialog": "4015140502",
            "dialogues": [
                {
                    "id": "4015140502",
                    "speaker": "Anna",
                    "text": "What are you doing?"
                },
                {
                    "id": "4015140506",
                    "speaker": "Anna",
                    "text": "I am... *coughs* making a wish."
                },
                {
                    "id": "4015140507",
                    "speaker": "Anna",
                    "text": "I just toss the coin *coughs* into the pool just like this, and *coughs* make a wish..."
                },
                {
                    "id": "4015140508",
                    "speaker": "Anna",
                    "text": "You must be *coughs* sincere and do it every day for the fountain fairy to hear you... *coughs*"
                },
                {
                    "id": "4015140509",
                    "speaker": "Anna",
                    "text": "I'm sorry... I can't stop coughing..."
                },
                {
                    "id": "4015140503",
                    "speaker": "Anna",
                    "text": "What do you want?"
                },
                {
                    "id": "4015140510",
                    "speaker": "Anna",
                    "text": "Oh... I've been *coughs* unwell for a long time."
                },
                {
                    "id": "4015140511",
                    "speaker": "Anna",
                    "text": "I wish that *coughs* the fountain fairy could help me *coughs* get better."
                },
                {
                    "id": "4015140512",
                    "speaker": "Anna",
                    "text": "So I can stop *coughs* being a burden to my parents and my *coughs* brother Anthony."
                }
            ]
        },
        {
            "talkId": "6009303",
            "initDialog": "4015140505",
            "dialogues": [
                {
                    "id": "4015140505",
                    "speaker": "Anna",
                    "text": "Sorry for bothering you."
                },
                {
                    "id": "4015140517",
                    "speaker": "Anna",
                    "text": "Be well."
                },
                {
                    "id": "4015140518",
                    "speaker": "Anna",
                    "text": "I hope *coughs* all your wishes will be granted soon... *coughs*"
                }
            ]
        }
    ]
