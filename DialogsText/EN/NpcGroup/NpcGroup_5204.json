{
    "groupId": "5204",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Lutz": 8,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "6520401",
            "initDialog": "652040101",
            "dialogues": [
                {
                    "id": "652040101",
                    "speaker": "Lutz",
                    "text": "Are you here to send a letter? If so, do you mind if I help you polish it a little?"
                }
            ]
        },
        {
            "talkId": "6520402",
            "initDialog": "652040201",
            "dialogues": [
                {
                    "id": "652040201",
                    "speaker": "Player",
                    "text": "A letter?"
                },
                {
                    "id": "652040202",
                    "speaker": "Lutz",
                    "text": "We can deliver letters to almost anyone in Fontaine, as long as you have the Coupons to pay for postage. Though we're practically doing it as charity, if I do say so myself."
                },
                {
                    "id": "652040203",
                    "speaker": "Lutz",
                    "text": "So would you like to send a letter? If so, please pay for postage first. And also, no queue jumping."
                }
            ]
        },
        {
            "talkId": "6520403",
            "initDialog": "652040301",
            "dialogues": [
                {
                    "id": "652040301",
                    "speaker": "Player",
                    "text": "Not right now."
                },
                {
                    "id": "652040302",
                    "speaker": "Lutz",
                    "text": "Okay. Come find me if you need to send any mail."
                }
            ]
        },
        {
            "talkId": "6520404",
            "initDialog": "652040401",
            "dialogues": [
                {
                    "id": "652040401",
                    "speaker": "Player",
                    "text": "I can write to anyone?"
                },
                {
                    "id": "652040402",
                    "speaker": "Lutz",
                    "text": "Well, usually we recommend writing to relatives or friends or... uh, joint guarantors, people like that?"
                },
                {
                    "id": "652040403",
                    "speaker": "Lutz",
                    "text": "And though we're operating for the public benefit, we have limited manpower. What is it they say? Resources are not allocated at random..."
                }
            ]
        },
        {
            "talkId": "6520405",
            "initDialog": "652040501",
            "dialogues": [
                {
                    "id": "652040501",
                    "speaker": "Player",
                    "text": "Not right now."
                },
                {
                    "id": "652040502",
                    "speaker": "Lutz",
                    "text": "Okay. Well, I'm here, typewriter and pneumatic tube at the ready. You know where to find me."
                }
            ]
        },
        {
            "talkId": "6520406",
            "initDialog": "652040601",
            "dialogues": [
                {
                    "id": "652040601",
                    "speaker": "Player",
                    "text": "Got it, thanks."
                },
                {
                    "id": "652040602",
                    "speaker": "Lutz",
                    "text": "Oh, don't mention it."
                }
            ]
        }
    ]
}