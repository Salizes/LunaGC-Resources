            "dialogues": [
                {
                    "id": "660700101",
                    "speaker": "Yelafath",
                    "text": "Welcome to Atlahua's Net!"
                }
            ]
        },
        {
            "talkId": "6607002",
            "initDialog": "660700201",
            "dialogues": [
                {
                    "id": "660700201",
                    "speaker": "Player",
                    "text": "What do you sell here?"
                },
                {
                    "id": "660700202",
                    "speaker": "Yelafath",
                    "text": "Fishing equipment, mostly. If there's water, there's fish, as they say, and many come to our tribe to do just that."
                },
                {
                    "id": "660700203",
                    "speaker": "Yelafath",
                    "text": "Thanks to them, business is pretty good! If your rod's broken, I can help fix it as well!"
                },
                {
                    "id": "660700204",
                    "speaker": "Yelafath",
                    "text": "I'm quite good at handicrafts, so I also sell small badges and ornaments."
                },
                {
                    "id": "660700205",
                    "speaker": "Yelafath",
                    "text": "Many tourists went to bring some souvenirs back, so I do custom work as well — if you want to engrave a name or something like that, I can do it, easy!"
                }
            ]
        },
        {
            "talkId": "6607003",
            "initDialog": "660700301",
            "dialogues": [
                {
                    "id": "660700301",
                    "speaker": "Player",
                    "text": "See you around."
                },
                {
                    "id": "660700302",
                    "speaker": "Yelafath",
                    "text": "Seeya, come back next time!"
                }
            ]
        },
        {
            "talkId": "6607004",
            "initDialog": "660700401",
            "dialogues": [
                {
                    "id": "660700401",
                    "speaker": "Yelafath",
                    "text": "Duel"
                }
            ]
        },
        {
            "talkId": "6607005",
            "initDialog": "660700501",
            "dialogues": [
                {
                    "id": "660700501",
                    "speaker": "Yelafath",
                    "text": "Sorry, but I'm the victor this time!"
                }
            ]
        },
        {
            "talkId": "6607006",
            "initDialog": "660700601",
            "dialogues": [
                {
                    "id": "660700601",
                    "speaker": "Yelafath",
                    "text": "Hehe, I lost! Let's play together again next time!"
                }
            ]
        }
    ]
