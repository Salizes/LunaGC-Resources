    "talks": [
        {
            "talkId": "6240501",
            "initDialog": "624050101",
            "dialogues": [
                {
                    "id": "624050101",
                    "speaker": "Jianqiu",
                    "text": "Hi, what's up?"
                }
            ]
        },
        {
            "talkId": "6240502",
            "initDialog": "624050201",
            "dialogues": [
                {
                    "id": "624050201",
                    "speaker": "Player",
                    "text": "Are you traveling?"
                },
                {
                    "id": "624050202",
                    "speaker": "Jianqiu",
                    "text": "I'm going with this young lady on a big once-in-a-lifetime trip."
                }
            ]
        },
        {
            "talkId": "6240503",
            "initDialog": "624050301",
            "dialogues": [
                {
                    "id": "624050301",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "624050302",
                    "speaker": "Jianqiu",
                    "text": "I taught arithmetic at Chihu Rock for a few years, where my students were all kids from poor families."
                },
                {
                    "id": "624050303",
                    "speaker": "Jianqiu",
                    "text": "Now I work at the Minghua Bank as Assistant Shopkeeper."
                },
                {
                    "id": "624050304",
                    "speaker": "Jianqiu",
                    "text": "I am accompanying this young lady on her travels to make sure she stays safe."
                },
                {
                    "id": "624050305",
                    "speaker": "Player",
                    "text": "Where are you going?"
                },
                {
                    "id": "624050306",
                    "speaker": "Jianqiu",
                    "text": "Dunno, maybe Celestia."
                },
                {
                    "id": "624050307",
                    "speaker": "Jianqiu",
                    "text": "Heh. Just joking. I'm not supposed to let people know where we're headed, I'm afraid, sorry about that."
                }
            ]
        },
        {
            "talkId": "6240504",
            "initDialog": "624050401",
            "dialogues": [
                {
                    "id": "624050401",
                    "speaker": "Player",
                    "text": "Bon voyage."
                },
                {
                    "id": "624050402",
                    "speaker": "Jianqiu",
                    "text": "With any luck, it will be. Thanks! Same to you."
                }
            ]
        }
    ]
}