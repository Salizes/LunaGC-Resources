        {
            "talkId": "7902321",
            "initDialog": "790232101",
            "dialogues": [
                {
                    "id": "790232101",
                    "speaker": "Chevka",
                    "text": "#*sigh*, what am I gonna do about Yakov... What, is there anything else, {NICKNAME}?",
                    "choices": [
                        {
                            "id": "790232102",
                            "text": "Why did you join the Fatui?",
                            "response": [
                                {
                                    "id": "790232103",
                                    "speaker": "Chevka",
                                    "text": "Why... I joined the Fatui?"
                                },
                                {
                                    "id": "790232104",
                                    "speaker": "Chevka",
                                    "text": "Well, I did it to help realize the long-cherished wish of Her Royal Highness the Tsaritsa... and to bring more honor to my family. I was raised to fight for the Tsaritsa."
                                }
                            ]
                        },
                        {
                            "id": "790232105",
                            "text": "About Yakov...",
                            "response": [
                                {
                                    "id": "790232106",
                                    "speaker": "Chevka",
                                    "text": "*sigh* It seems that Yakov is still delirious..."
                                }
                            ]
                        },
                        {
                            "id": "790232107",
                            "text": "It's nothing."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902332",
            "initDialog": "790233201",
            "dialogues": [
                {
                    "id": "790233201",
                    "speaker": "Electrohammer Vanguard",
                    "text": "No, I need to... bring the insignia back to him... I've got to find it...",
                    "choices": [
                        {
                            "id": "790233202",
                            "text": "(We aren't getting through to him...)"
                        },
                        {
                            "id": "790233203",
                            "text": "(Let's leave him alone for now...)"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902429",
            "initDialog": "790242901",
            "dialogues": [
                {
                    "id": "790242901",
                    "speaker": "Chevka",
                    "text": "Hehehe, that researcher Persikov, bossing us around and making us do all the hard work..."
                },
                {
                    "id": "790242902",
                    "speaker": "Chevka",
                    "text": "Now that this experiment has failed, there'll be a fine show to watch once we get back for sure."
                }
            ]
        }
    ]
