{
    "groupId": "9016",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Diluc": 45,
        "Player": 20
    },
    "talks": [
        {
            "talkId": "6901601",
            "initDialog": "690160101",
            "dialogues": [
                {
                    "id": "690160101",
                    "speaker": "Diluc",
                    "text": "#Ah, there you are, {NICKNAME}."
                },
                {
                    "id": "690160102",
                    "speaker": "Diluc",
                    "text": "You appear to be in good spirits."
                }
            ]
        },
        {
            "talkId": "6901602",
            "initDialog": "690160201",
            "dialogues": [
                {
                    "id": "690160201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                },
                {
                    "id": "690160701",
                    "speaker": "Diluc",
                    "text": "It's not bad.",
                    "choices": [
                        {
                            "id": "690160702",
                            "text": "...\"Not bad\"?",
                            "response": [
                                {
                                    "id": "690160704",
                                    "speaker": "Diluc",
                                    "text": "..."
                                },
                                {
                                    "id": "690160705",
                                    "speaker": "Diluc",
                                    "text": "Apologies, that wasn't intended as a slight against this residence."
                                },
                                {
                                    "id": "690160706",
                                    "speaker": "Diluc",
                                    "text": "Nor did I mean to upset you."
                                },
                                {
                                    "id": "690160707",
                                    "speaker": "Diluc",
                                    "text": "All I meant was... It could take me some time to get accustomed to lodging here."
                                },
                                {
                                    "id": "690160708",
                                    "speaker": "Diluc",
                                    "text": "...But don't take it the wrong way."
                                }
                            ]
                        },
                        {
                            "id": "690160703",
                            "text": "So it's true what people say about your sophisticated tastes..."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901603",
            "initDialog": "690160301",
            "dialogues": [
                {
                    "id": "690160301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
                },
                {
                    "id": "690160801",
                    "speaker": "Diluc",
                    "text": "...A chat of the idle variety?",
                    "choices": [
                        {
                            "id": "690160802",
                            "text": "I forgot, you're not a fan of small talk...",
                            "response": [
                                {
                                    "id": "690160803",
                                    "speaker": "Diluc",
                                    "text": "No, it's fine. I don't mind."
                                },
                                {
                                    "id": "690160804",
                                    "speaker": "Diluc",
                                    "text": "It's only fair that I set aside some time for you."
                                },
                                {
                                    "id": "690160810",
                                    "speaker": "Diluc",
                                    "text": "Hmph. How perceptive of you. Yes, I am."
                                },
                                {
                                    "id": "690160811",
                                    "speaker": "Diluc",
                                    "text": "Whether it's human avarice lurking in the shadows or a conspiracy from outside the human world..."
                                },
                                {
                                    "id": "690160812",
                                    "speaker": "Diluc",
                                    "text": "Evil-doers are only waiting for us to let our guard down."
                                },
                                {
                                    "id": "690160813",
                                    "speaker": "Diluc",
                                    "text": "..."
                                },
                                {
                                    "id": "690160814",
                                    "speaker": "Diluc",
                                    "text": "This is not what you wanted to talk about, is it?",
                                    "choices": [
                                        {
                                            "id": "690160815",
                                            "text": "Never mind...",
                                            "response": [
                                                {
                                                    "id": "690160816",
                                                    "speaker": "Diluc",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690160817",
                                                    "speaker": "Diluc",
                                                    "text": "I think I need to engage in a little introspection..."
                                                },
                                                {
                                                    "id": "690160821",
                                                    "speaker": "Diluc",
                                                    "text": "But I will also try to find some conversation topics that align with your interests."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690160818",
                                            "text": "Knowing that Mondstadt has a protector like you puts my mind at ease.",
                                            "response": [
                                                {
                                                    "id": "690160819",
                                                    "speaker": "Diluc",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690160820",
                                                    "speaker": "Diluc",
                                                    "text": "That's a given."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690160805",
                            "text": "You look so unhappy all the time, I thought I'd check in...",
                            "response": [
                                {
                                    "id": "690160806",
                                    "speaker": "Diluc",
                                    "text": "Unhappy...? Nothing of the sort."
                                },
                                {
                                    "id": "690160807",
                                    "speaker": "Diluc",
                                    "text": "I'm just thinking. Observing. Or planning."
                                },
                                {
                                    "id": "690160808",
                                    "speaker": "Diluc",
                                    "text": "However... I appreciate your concern. I didn't mean to worry you."
                                }
                            ]
                        },
                        {
                            "id": "690160809",
                            "text": "Are you still preoccupied with Mondstadt's security?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901604",
            "initDialog": "690160401",
            "dialogues": [
                {
                    "id": "690160401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
                },
                {
                    "id": "690160901",
                    "speaker": "Diluc",
                    "text": "Yes... Take a sip of this."
                },
                {
                    "id": "690160902",
                    "speaker": "Diluc",
                    "text": "It's an alcohol-free beverage based on a long-standing family recipe. But I put my own spin on it.",
                    "choices": [
                        {
                            "id": "690160903",
                            "text": "So crisp and refreshing!",
                            "response": [
                                {
                                    "id": "690160905",
                                    "speaker": "Diluc",
                                    "text": "The look on your face suggests that was rather to your liking."
                                },
                                {
                                    "id": "690160906",
                                    "speaker": "Diluc",
                                    "text": "Well, I'm glad. I tried to adjust the recipe to match your taste, and from the looks of it, I succeeded in doing just that."
                                },
                                {
                                    "id": "690160907",
                                    "speaker": "Diluc",
                                    "text": "Now. I have a favor to ask of you."
                                },
                                {
                                    "id": "690160908",
                                    "speaker": "Diluc",
                                    "text": "This drink hasn't been named yet. It wouldn't be appropriate to use its original name, since the recipe has been modified."
                                },
                                {
                                    "id": "690160909",
                                    "speaker": "Player",
                                    "text": "You want me to name it?"
                                },
                                {
                                    "id": "690160910",
                                    "speaker": "Diluc",
                                    "text": "Well, it was made to suit your tastes. It's only fitting that you name it."
                                },
                                {
                                    "id": "690160911",
                                    "speaker": "Diluc",
                                    "text": "Or perhaps... I should name it after you?",
                                    "choices": [
                                        {
                                            "id": "690160912",
                                            "text": "That'd be weird.",
                                            "response": [
                                                {
                                                    "id": "690160914",
                                                    "speaker": "Diluc",
                                                    "text": "...I suppose you're right."
                                                },
                                                {
                                                    "id": "690160915",
                                                    "speaker": "Diluc",
                                                    "text": "Well, there's no rush, so take your time. I can always make another glass for you if you forget how it tastes."
                                                },
                                                {
                                                    "id": "690160916",
                                                    "speaker": "Diluc",
                                                    "text": "Anywhere. Anytime."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690160913",
                                            "text": "Let me give this some more thought..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690160904",
                            "text": "What a mellow aftertaste!"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901605",
            "initDialog": "690160501",
            "dialogues": [
                {
                    "id": "690160501",
                    "speaker": "Player",
                    "text": "Good morning, Diluc. How are you doing?"
                },
                {
                    "id": "690161001",
                    "speaker": "Diluc",
                    "text": "Hmm... Nothing to complain about."
                },
                {
                    "id": "690161002",
                    "speaker": "Diluc",
                    "text": "If I'm ever needed somewhere, just say the word. Don't hesitate."
                }
            ]
        },
        {
            "talkId": "6901606",
            "initDialog": "690160601",
            "dialogues": [
                {
                    "id": "690160601",
                    "speaker": "Player",
                    "text": "Good night, Diluc."
                },
                {
                    "id": "690161101",
                    "speaker": "Diluc",
                    "text": "Good night..."
                },
                {
                    "id": "690161102",
                    "speaker": "Diluc",
                    "text": "...Never mind. You should get going."
                }
            ]
        },
        {
            "talkId": "6901612",
            "initDialog": "690161201",
            "dialogues": [
                {
                    "id": "690161201",
                    "speaker": "Player",
                    "text": "Would you like to have a chat with me?"
                }
            ]
        },
        {
            "talkId": "6901613",
            "initDialog": "690161301",
            "dialogues": [
                {
                    "id": "690161301",
                    "speaker": "Player",
                    "text": "Is there anything you'd like to do?"
                }
            ]
        },
        {
            "talkId": "6901614",
            "initDialog": "690161401",
            "dialogues": [
                {
                    "id": "690161401",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                }
            ]
        },
        {
            "talkId": "6901650",
            "initDialog": "690165001",
            "dialogues": [
                {
                    "id": "690165001",
                    "speaker": "Diluc",
                    "text": "Many factors must be considered when managing an orchard. It's not necessarily easier than combat or chess."
                },
                {
                    "id": "690165002",
                    "speaker": "Diluc",
                    "text": "Lost time from delayed weed removal can interfere with fruit quality and ultimately affect the taste of the wine."
                },
                {
                    "id": "690165003",
                    "speaker": "Diluc",
                    "text": "I can assist you if necessary. Strive to become a qualified manager."
                }
            ]
        },
        {
            "talkId": "6901651",
            "initDialog": "690165101",
            "dialogues": [
                {
                    "id": "690165101",
                    "speaker": "Diluc",
                    "text": "A sword is the most fundamental unit of strength, and each soldier is indispensable."
                },
                {
                    "id": "690165102",
                    "speaker": "Diluc",
                    "text": "A good billet is the key to maintaining a good blade."
                },
                {
                    "id": "690165103",
                    "speaker": "Diluc",
                    "text": "So don't be stingy when investing in your smithy."
                }
            ]
        }
    ]
}