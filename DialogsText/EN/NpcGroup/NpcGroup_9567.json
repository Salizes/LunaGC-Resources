    "talks": [
        {
            "talkId": "6956701",
            "initDialog": "695670101",
            "dialogues": [
                {
                    "id": "695670101",
                    "speaker": "Wriothesley",
                    "text": "I've seen some card game venues where they seal up the windows so no light can get in. That way, the customers lose track of time and never know when to stop. The boss of this place hasn't done that though. I guess they must be pretty confident in their business."
                }
            ]
        },
        {
            "talkId": "6956702",
            "initDialog": "695670201",
            "dialogues": [
                {
                    "id": "695670201",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6956703",
            "initDialog": "695670301",
            "dialogues": [
                {
                    "id": "695670301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "695670302",
                    "speaker": "Wriothesley",
                    "text": "Sure. I'll be leaving shortly too."
                }
            ]
        },
        {
            "talkId": "6956704",
            "initDialog": "695670401",
            "dialogues": [
                {
                    "id": "695670401",
                    "speaker": "Wriothesley",
                    "text": "Looks like I came better prepared than you did. How did I prepare? Well, I read the rules, of course, then looked back on some of my previous duels... Why, what did you think I was going to say?"
                }
            ]
        },
        {
            "talkId": "6956705",
            "initDialog": "695670501",
            "dialogues": [
                {
                    "id": "695670501",
                    "speaker": "Wriothesley",
                    "text": "A textbook victory, assuming there was no cheating involved. Although to be fair, even if there were, it would still count... as long as you didn't get caught, that is."
                }
            ]
        },
        {
            "talkId": "6956706",
            "initDialog": "695670601",
            "dialogues": [
                {
                    "id": "695670601",
                    "speaker": "Wriothesley",
                    "text": "Does it have to be right now? ...Fine."
                }
            ]
        },
        {
            "talkId": "6956708",
            "initDialog": "695670801",
            "dialogues": [
                {
                    "id": "695670801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6956709",
            "initDialog": "695670901",
            "dialogues": [
                {
                    "id": "695670901",
                    "speaker": "Player",
                    "text": "Adjust the deck first..."
                }
            ]
        },
        {
            "talkId": "6956710",
            "initDialog": "695671001",
            "dialogues": [
                {
                    "id": "695671001",
                    "speaker": "Wriothesley",
                    "text": "Apparently, this was the right choice of deck for this particular battle. Looks like I made a good judgment call."
                }
            ]
        },
        {
            "talkId": "6956711",
            "initDialog": "695671101",
            "dialogues": [
                {
                    "id": "695671101",
                    "speaker": "Wriothesley",
                    "text": "Evidently, accepting your challenge despite being unprepared wasn't a particularly wise move..."
                }
            ]
        },
        {
            "talkId": "6956712",
            "initDialog": "695671201",
            "dialogues": [
                {
                    "id": "695671201",
                    "speaker": "Wriothesley",
                    "text": "A duel, you say? Come on then. I can already see how determined you are to win."
                }
            ]
        },
        {
            "talkId": "6956714",
