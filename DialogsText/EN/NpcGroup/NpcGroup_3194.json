    "talks": [
        {
            "talkId": "6319401",
            "initDialog": "631940101",
            "dialogues": [
                {
                    "id": "631940101",
                    "speaker": "Komaki",
                    "text": "How do you do, youngster?"
                }
            ]
        },
        {
            "talkId": "6319402",
            "initDialog": "631940201",
            "dialogues": [
                {
                    "id": "631940201",
                    "speaker": "Player",
                    "text": "Hi there, Granny Komaki!"
                },
                {
                    "id": "631940202",
                    "speaker": "Komaki",
                    "text": "Haha, it's so good to see you all again. Might you be interested in a little fortune-telling next time if you get the chance?"
                }
            ]
        },
        {
            "talkId": "6319403",
            "initDialog": "631940301",
            "dialogues": [
                {
                    "id": "631940301",
                    "speaker": "Player",
                    "text": "About Bourou Village..."
                },
                {
                    "id": "631940302",
                    "speaker": "Komaki",
                    "text": "Oh? You're asking about the village?"
                },
                {
                    "id": "631940303",
                    "speaker": "Komaki",
                    "text": "There's not much to be said about it. It is simply the place where we have lived over many generations."
                },
                {
                    "id": "631940304",
                    "speaker": "Komaki",
                    "text": "It's just that this place has experienced far more history than many others... But not as much as Sangonomiya Shrine, of course..."
                }
            ]
        },
        {
            "talkId": "6319404",
            "initDialog": "631940401",
            "dialogues": [
                {
                    "id": "631940401",
                    "speaker": "Player",
                    "text": "About the Spiritherbs..."
                },
                {
                    "id": "631940402",
                    "speaker": "Komaki",
                    "text": "Thanks to your help, it's growing very well..."
                },
                {
                    "id": "631940403",
                    "speaker": "Komaki",
                    "text": "But I think that it will need some rest before it can regain its efficacy again, haha..."
                },
                {
                    "id": "631940404",
                    "speaker": "Komaki",
                    "text": "It is a fine year, and wishes in the waters have been very rich indeed. I believe that they will only get better..."
                }
            ]
        },
        {
            "talkId": "6319405",
            "initDialog": "631940501",
            "dialogues": [
                {
                    "id": "631940501",
                    "speaker": "Player",
                    "text": "See you, Granny."
                },
                {
                    "id": "631940502",
                    "speaker": "Komaki",
                    "text": "Alright, go well. Come again soon!"
                }
            ]
        }
    ]
}