    "talks": [
        {
            "talkId": "6520201",
            "initDialog": "652020101",
            "dialogues": [
                {
                    "id": "652020101",
                    "speaker": "Monglane",
                    "text": "Fill out the form first."
                }
            ]
        },
        {
            "talkId": "6520202",
            "initDialog": "652020201",
            "dialogues": [
                {
                    "id": "652020201",
                    "speaker": "Player",
                    "text": "Which form?"
                },
                {
                    "id": "652020202",
                    "speaker": "Monglane",
                    "text": "If you don't know which form you have to fill in, find someone who does know and then come back."
                }
            ]
        },
        {
            "talkId": "6520203",
            "initDialog": "652020301",
            "dialogues": [
                {
                    "id": "652020301",
                    "speaker": "Player",
                    "text": "Sorry to bother you."
                },
                {
                    "id": "652020302",
                    "speaker": "Monglane",
                    "text": "Mm-hmm."
                }
            ]
        },
        {
            "talkId": "6520204",
            "initDialog": "652020401",
            "dialogues": [
                {
                    "id": "652020401",
                    "speaker": "Monglane",
                    "text": "Hello."
                }
            ]
        },
        {
            "talkId": "6520205",
            "initDialog": "652020501",
            "dialogues": [
                {
                    "id": "652020501",
                    "speaker": "Player",
                    "text": "I have a few questions..."
                },
                {
                    "id": "652020502",
                    "speaker": "Monglane",
                    "text": "Add your questions, whatever they are, to this form. Once we've categorized them, we'll answer them all together at a later date."
                }
            ]
        },
        {
            "talkId": "6520206",
            "initDialog": "652020601",
            "dialogues": [
                {
                    "id": "652020601",
                    "speaker": "Player",
                    "text": "Sorry to bother you."
                },
                {
                    "id": "652020602",
                    "speaker": "Monglane",
                    "text": "Mm-hmm."
                }
            ]
        },
        {
            "talkId": "6520207",
            "initDialog": "652020701",
            "dialogues": [
                {
                    "id": "652020701",
                    "speaker": "Player",
                    "text": "Can't you just answer them now?"
                },
                {
                    "id": "652020702",
                    "speaker": "Monglane",
                    "text": "I can't determine whether or not your question is one which I can answer. Therefore I am unable to give you an answer to that question."
                },
                {
                    "id": "652020703",
                    "speaker": "Monglane",
                    "text": "But if you wish, you can add the question to the form."
                }
            ]
        },
        {
            "talkId": "6520208",
            "initDialog": "652020801",
            "dialogues": [
                {
                    "id": "652020801",
                    "speaker": "Player",
                    "text": "But I don't want to fill in the form."
                },
                {
                    "id": "652020802",
                    "speaker": "Monglane",
                    "text": "Me neither."
                },
                {
                    "id": "652020803",
                    "speaker": "Monglane",
                    "text": "But here, forms are how we create order. Forms are the only thing that can bring you any consolation."
                },
                {
                    "id": "652020804",
                    "speaker": "Monglane",
                    "text": "If you are still unwilling to fill in the form, feel free to take a look around."
                },
                {
                    "id": "652020805",
                    "speaker": "Monglane",
                    "text": "The rules aren't just on paper. They're in our every move and action. You should be able to find the answers you seek if you pay close attention and observe."
                }
            ]
        },
        {
            "talkId": "6520209",
            "initDialog": "652020901",
            "dialogues": [
                {
                    "id": "652020901",
                    "speaker": "Player",
                    "text": "Okay. Sorry to bother you."
                },
                {
                    "id": "652020902",
                    "speaker": "Monglane",
                    "text": "Mm-hmm."
                }
            ]
        }
    ]
}