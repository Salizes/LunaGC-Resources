    "talks": [
        {
            "talkId": "6407901",
            "initDialog": "640790101",
            "dialogues": [
                {
                    "id": "640790101",
                    "speaker": "Vardan",
                    "text": "Thanks for saving my son, Great Rukkhadevata..."
                }
            ]
        },
        {
            "talkId": "6407902",
            "initDialog": "640790201",
            "dialogues": [
                {
                    "id": "640790201",
                    "speaker": "Player",
                    "text": "About your son..."
                },
                {
                    "id": "640790202",
                    "speaker": "Vardan",
                    "text": "My son was a fisherman, and his boat capsized while out at sea."
                },
                {
                    "id": "640790203",
                    "speaker": "Vardan",
                    "text": "He was about to die until the Bimarstan doctors saved him at the last second."
                },
                {
                    "id": "640790204",
                    "speaker": "Vardan",
                    "text": "Ever since then, I started providing free medicinal herbs to Bimarstan."
                },
                {
                    "id": "640790205",
                    "speaker": "Vardan",
                    "text": "All we got is a small yard that didn't yield much, but we'd do anything we could to help."
                }
            ]
        },
        {
            "talkId": "6407903",
            "initDialog": "640790301",
            "dialogues": [
                {
                    "id": "640790301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640790302",
                    "speaker": "Vardan",
                    "text": "Take it easy."
                }
            ]
        },
        {
            "talkId": "6407904",
            "initDialog": "640790401",
            "dialogues": [
                {
                    "id": "640790401",
                    "speaker": "Vardan",
                    "text": "Oh, mighty Dendro Archon, thank you for saving my son from the vagaries of the sea..."
                }
            ]
        }
    ]
}