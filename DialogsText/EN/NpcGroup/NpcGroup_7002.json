            "dialogues": [
                {
                    "id": "670020101",
                    "speaker": "Arkhyp",
                    "text": "Better to let the young people do what they want to, hmm?"
                }
            ]
        },
        {
            "talkId": "6700202",
            "initDialog": "670020201",
            "dialogues": [
                {
                    "id": "670020201",
                    "speaker": "Player",
                    "text": "The young people?"
                },
                {
                    "id": "670020202",
                    "speaker": "Arkhyp",
                    "text": "Haha, just talking to myself here. It's about my daughter, Lyulka. She tinkers with her little kuuvahki gadgets, day in and day out. She even borrowed my workshop for it."
                },
                {
                    "id": "670020203",
                    "speaker": "Arkhyp",
                    "text": "I can't understand how those things work at all, but seeing as how she's so invested in them... As her old man, all I can do is to leave her to it."
                }
            ]
        },
        {
            "talkId": "6700203",
            "initDialog": "670020301",
            "dialogues": [
                {
                    "id": "670020301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "670020302",
                    "speaker": "Arkhyp",
                    "text": "Alright, take care now."
                }
            ]
        }
    ]
}