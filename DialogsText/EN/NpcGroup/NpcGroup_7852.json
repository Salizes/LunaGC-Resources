            "dialogues": [
                {
                    "id": "678520201",
                    "speaker": "Player",
                    "text": "Something's fishy?"
                },
                {
                    "id": "678520202",
                    "speaker": "Burtsev",
                    "text": "The crystal ore shipments we're getting here at Sretomorozsk keep getting smaller, but the price just keeps going up. Something's off, that's for sure."
                },
                {
                    "id": "678520203",
                    "speaker": "Burtsev",
                    "text": "Used to be that everyone would just close one eye and pretend nothing's wrong. I mean, no one wants to get into trouble for nothing..."
                },
                {
                    "id": "678520204",
                    "speaker": "Burtsev",
                    "text": "But nobody's going to be able to feed themselves if this keeps up. No, we must do something about it. We must stage a protest!"
                }
            ]
        },
