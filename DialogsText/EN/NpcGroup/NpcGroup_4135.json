    "talks": [
        {
            "talkId": "6413501",
            "initDialog": "641350101",
            "dialogues": [
                {
                    "id": "641350101",
                    "speaker": "Shapur",
                    "text": "Sisi, Sisi! Are you there?"
                }
            ]
        },
        {
            "talkId": "6413502",
            "initDialog": "641350201",
            "dialogues": [
                {
                    "id": "641350201",
                    "speaker": "Player",
                    "text": "Sisi?"
                },
                {
                    "id": "641350202",
                    "speaker": "Shapur",
                    "text": "Oh, are you a customer?"
                },
                {
                    "id": "641350203",
                    "speaker": "Shapur",
                    "text": "Sisi is my cat's name. I was just asking it a question."
                },
                {
                    "id": "641350204",
                    "speaker": "Shapur",
                    "text": "But this fellow's been capricious recently and doesn't respond no matter how much I call."
                },
                {
                    "id": "641350205",
                    "speaker": "Shapur",
                    "text": "Never mind, no need to worry. They are probably looking for trouble with Ouo again."
                },
                {
                    "id": "641350206",
                    "speaker": "Shapur",
                    "text": "I'd better ask my daughter to help you with check-in. Sareh... Sareh, are you there?"
                }
            ]
        },
        {
            "talkId": "6413503",
            "initDialog": "641350301",
            "dialogues": [
                {
                    "id": "641350301",
                    "speaker": "Player",
                    "text": "And you are..."
                },
                {
                    "id": "641350302",
                    "speaker": "Shapur",
                    "text": "Oh! You're at the door and you still can't tell who I am?"
                },
                {
                    "id": "641350303",
                    "speaker": "Shapur",
                    "text": "I'm the owner of this inn, which means that this inn is owned by me."
                },
                {
                    "id": "641350304",
                    "speaker": "Shapur",
                    "text": "Ah, look, Sisi. Young people's attention span is terrible these days."
                },
                {
                    "id": "641350305",
                    "speaker": "Shapur",
                    "text": "..."
                },
                {
                    "id": "641350306",
                    "speaker": "Shapur",
                    "text": "Sisi? Sisi! Where did that furball run off to now?"
                }
            ]
        },
        {
            "talkId": "6413504",
            "initDialog": "641350401",
            "dialogues": [
                {
                    "id": "641350401",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641350402",
                    "speaker": "Shapur",
                    "text": "Never mind, I'll ask Ouo."
                }
            ]
        }
    ]
}