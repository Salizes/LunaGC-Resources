                {
                    "id": "641450101",
                    "speaker": "Gauhar",
                    "text": "Hello. Only transactions within the limits of regulations can be made here."
                }
            ]
        },
        {
            "talkId": "6414502",
            "initDialog": "641450201",
            "dialogues": [
                {
                    "id": "641450201",
                    "speaker": "Player",
                    "text": "Within the limits..."
                },
                {
                    "id": "641450202",
                    "speaker": "Gauhar",
                    "text": "Yes, the contents must be sorted in accordance with the regulations, and the process must also follow regulations."
                },
                {
                    "id": "641450203",
                    "speaker": "Gauhar",
                    "text": "Registration, inspection, approval, contracts, secondary approval... Not one step can be skipped."
                },
                {
                    "id": "641450204",
                    "speaker": "Gauhar",
                    "text": "If any part of the process is not followed, you have to face the consequences at your own risk."
                }
            ]
        },
