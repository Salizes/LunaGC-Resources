        },
        {
            "talkId": "6406602",
            "initDialog": "640660201",
            "dialogues": [
                {
                    "id": "640660201",
                    "speaker": "Player",
                    "text": "And you are..."
                },
                {
                    "id": "640660202",
                    "speaker": "Rukh Shah",
                    "text": "I'm the Parchamdar for the Corps of Thirty, in charge of the Eremites in Sumeru City."
                }
            ]
        },
        {
            "talkId": "6406603",
            "initDialog": "640660301",
            "dialogues": [
                {
                    "id": "640660301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640660302",
                    "speaker": "Rukh Shah",
                    "text": "See you."
                }
            ]
        },
        {
            "talkId": "6406604",
            "initDialog": "640660401",
            "dialogues": [
                {
                    "id": "640660401",
                    "speaker": "Player",
                    "text": "About the Corps of Thirty..."
                },
                {
                    "id": "640660402",
                    "speaker": "Rukh Shah",
                    "text": "The Corps of Thirty is probably among the oldest Eremites in Sumeru. The name came from its thirty founders."
                },
                {
                    "id": "640660403",
                    "speaker": "Rukh Shah",
                    "text": "We're currently responsible for Sumeru's defenses. Most tasks are assigned by the Akademiya, in addition to those from civilians."
                },
                {
                    "id": "640660404",
                    "speaker": "Rukh Shah",
                    "text": "Unlike other Eremites, its members wear a green scarf. Feel free to seek assistance from us in town."
                },
                {
                    "id": "640660405",
                    "speaker": "Rukh Shah",
                    "text": "But once you're out of town, watch out for the other Eremites. Even if you're in Port Ormos. They might not have good intentions."
                }
            ]
        }
    ]
}