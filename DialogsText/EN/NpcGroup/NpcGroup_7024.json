            "dialogues": [
                {
                    "id": "670240101",
                    "speaker": "Jalo",
                    "text": "Hey, you're blocking the road."
                }
            ]
        },
        {
            "talkId": "6702402",
            "initDialog": "670240201",
            "dialogues": [
                {
                    "id": "670240201",
                    "speaker": "Player",
                    "text": "Where are you rushing off to?"
                },
                {
                    "id": "670240202",
                    "speaker": "Jalo",
                    "text": "I'm here to... Uhh, help out. There's not much I can do, but I'll try my best. I've also grown taller lately, and I'll definitely keep growing."
                },
                {
                    "id": "670240203",
                    "speaker": "Jalo",
                    "text": "Once I'm all grown up, I can help out like the adults. And when I do more of that, I can get more Mora..."
                }
            ]
        },
        {
            "talkId": "6702403",
            "initDialog": "670240301",
            "dialogues": [
                {
                    "id": "670240301",
                    "speaker": "Player",
                    "text": "Sorry. Be on your way, then."
                },
                {
                    "id": "670240302",
                    "speaker": "Jalo",
                    "text": "Thanks. You're a good person."
                }
            ]
        },
        {
            "talkId": "6702404",
            "initDialog": "670240401",
            "dialogues": [
                {
                    "id": "670240401",
                    "speaker": "Player",
                    "text": "What would you do with all that extra Mora?"
                },
                {
                    "id": "670240402",
                    "speaker": "Jalo",
                    "text": "My mother's sick... Ack, sorry, I shouldn't have said that. Please forget I did, okay?"
                }
            ]
        }
    ]
