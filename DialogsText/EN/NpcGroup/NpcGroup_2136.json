{
    "groupId": "2136",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Little Luo": 10,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6213601",
            "initDialog": "621360101",
            "dialogues": [
                {
                    "id": "621360101",
                    "speaker": "Little Luo",
                    "text": "Ah, how I'd like to see that adeptus again today, too. But he doesn't seem to like me..."
                }
            ]
        },
        {
            "talkId": "6213602",
            "initDialog": "621360201",
            "dialogues": [
                {
                    "id": "621360201",
                    "speaker": "Player",
                    "text": "An adeptus?"
                },
                {
                    "id": "621360202",
                    "speaker": "Little Luo",
                    "text": "One day, when I was in the forest, I met a handsome, dashing adeptus — it was as if he had popped right out of a story book!"
                },
                {
                    "id": "621360203",
                    "speaker": "Little Luo",
                    "text": "I smiled at him, but he didn't smile back."
                },
                {
                    "id": "621360204",
                    "speaker": "Little Luo",
                    "text": "He just returned the doll that the hilichurls stole back to me... Do you think he doesn't like me, by any chance?",
                    "choices": [
                        {
                            "id": "621360205",
                            "text": "Maybe?",
                            "response": [
                                {
                                    "id": "621360206",
                                    "speaker": "Little Luo",
                                    "text": "That... That's sad..."
                                },
                                {
                                    "id": "621360207",
                                    "speaker": "Little Luo",
                                    "text": "How do I get him to like me? ...Oh, I've never had this problem before..."
                                }
                            ]
                        },
                        {
                            "id": "621360208",
                            "text": "I'd say he actually likes you.",
                            "response": [
                                {
                                    "id": "621360209",
                                    "speaker": "Little Luo",
                                    "text": "Really?"
                                },
                                {
                                    "id": "621360210",
                                    "speaker": "Little Luo",
                                    "text": "...I did think about it as well, does he just not like smiling?"
                                },
                                {
                                    "id": "621360211",
                                    "speaker": "Little Luo",
                                    "text": "If I see him again, I'll definitely find a way to make him smile."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6213603",
            "initDialog": "621360301",
            "dialogues": [
                {
                    "id": "621360301",
                    "speaker": "Player",
                    "text": "Stay safe, then."
                },
                {
                    "id": "621360302",
                    "speaker": "Little Luo",
                    "text": "I'll be fine! If there's any danger, I'm sure the adeptus will come to rescue me."
                }
            ]
        }
    ]
}