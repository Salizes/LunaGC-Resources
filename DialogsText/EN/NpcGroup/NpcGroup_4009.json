    "talks": [
        {
            "talkId": "6400901",
            "initDialog": "640090101",
            "dialogues": [
                {
                    "id": "640090101",
                    "speaker": "Nabiya",
                    "text": "Temptation triggers love, but too much love triggers disaster..."
                },
                {
                    "id": "640090102",
                    "speaker": "Nabiya",
                    "text": "Luckily, they don't care too much for you."
                }
            ]
        },
        {
            "talkId": "6400902",
            "initDialog": "640090201",
            "dialogues": [
                {
                    "id": "640090201",
                    "speaker": "Player",
                    "text": "Who are \"they\"...?"
                },
                {
                    "id": "640090202",
                    "speaker": "Nabiya",
                    "text": "Harut and Marut. They're the shadows of nimble demons, free and unfettered creatures..."
                },
                {
                    "id": "640090203",
                    "speaker": "Nabiya",
                    "text": "...They're also my cats."
                }
            ]
        },
        {
            "talkId": "6400903",
            "initDialog": "640090301",
            "dialogues": [
                {
                    "id": "640090301",
                    "speaker": "Player",
                    "text": "That's a shame."
                },
                {
                    "id": "640090302",
                    "speaker": "Nabiya",
                    "text": "Perhaps, perhaps not."
                }
            ]
        },
        {
            "talkId": "6400904",
            "initDialog": "640090401",
            "dialogues": [
                {
                    "id": "640090401",
                    "speaker": "Player",
                    "text": "Then \"temptation\" and \"love\" are...?"
                },
                {
                    "id": "640090402",
                    "speaker": "Nabiya",
                    "text": "Cats are curious creatures. They have many strengths, but curiosity is not one of them."
                },
                {
                    "id": "640090403",
                    "speaker": "Nabiya",
                    "text": "Their curiosity and penchant strand fish on the shore and trap birds on the ground..."
                },
                {
                    "id": "640090404",
                    "speaker": "Nabiya",
                    "text": "That means disaster for the fish and birds, no?"
                }
            ]
        }
    ]
}