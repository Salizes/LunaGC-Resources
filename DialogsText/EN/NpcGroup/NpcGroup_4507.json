        },
        {
            "talkId": "6450702",
            "initDialog": "645070201",
            "dialogues": [
                {
                    "id": "645070201",
                    "speaker": "Player",
                    "text": "Tell me about your era."
                },
                {
                    "id": "645070202",
                    "speaker": "Venipi",
                    "text": "My era?"
                },
                {
                    "id": "645070203",
                    "speaker": "Venipi",
                    "text": "Well, officially I was an apprentice. In reality, I just hauled bricks."
                },
                {
                    "id": "645070204",
                    "speaker": "Venipi",
                    "text": "If there's one thing worth mentioning about those days..."
                },
                {
                    "id": "645070205",
                    "speaker": "Venipi",
                    "text": "Back in the day, everyone working on The Mausoleum of King Deshret got two cups of beer every day."
                },
                {
                    "id": "645070206",
                    "speaker": "Venipi",
                    "text": "Ah, I miss those times... though I can't remember what it tasted like anymore."
                }
            ]
        },
        {
            "talkId": "6450703",
            "initDialog": "645070301",
            "dialogues": [
                {
                    "id": "645070301",
                    "speaker": "Player",
                    "text": "Where's Kshama?"
                },
                {
                    "id": "645070302",
                    "speaker": "Venipi",
                    "text": "Kshama's gone to inspect the building and see what got damaged."
                },
                {
                    "id": "645070303",
                    "speaker": "Venipi",
                    "text": "Don't worry about her, though. It's safe here now."
                }
            ]
        },
        {
            "talkId": "6450704",
            "initDialog": "645070401",
            "dialogues": [
                {
                    "id": "645070401",
                    "speaker": "Player",
                    "text": "About the fighting strength rankings..."
                },
                {
                    "id": "645070402",
                    "speaker": "Venipi",
                    "text": "Well, that's top-tier, no question."
                }
            ]
        },
        {
            "talkId": "6450705",
            "initDialog": "645070501",
            "dialogues": [
                {
                    "id": "645070501",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "645070502",
                    "speaker": "Venipi",
                    "text": "See you!"
                }
            ]
        }
