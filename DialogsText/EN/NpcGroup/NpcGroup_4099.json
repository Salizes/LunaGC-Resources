    "talks": [
        {
            "talkId": "6409901",
            "initDialog": "640990101",
            "dialogues": [
                {
                    "id": "640990101",
                    "speaker": "Sirafi",
                    "text": "Don't take my goods for the simple stuff. They're all from the renowned \"Palace of Alcazarzaray.\""
                }
            ]
        },
        {
            "talkId": "6409902",
            "initDialog": "640990201",
            "dialogues": [
                {
                    "id": "640990201",
                    "speaker": "Player",
                    "text": "About the Palace of Alcazarzaray..."
                },
                {
                    "id": "640990202",
                    "speaker": "Sirafi",
                    "text": "Even if you've never heard of that name, you should know the enormous palace in northern Sumeru, right?"
                },
                {
                    "id": "640990203",
                    "speaker": "Sirafi",
                    "text": "That's right, that's the Palace of Alcazarzaray. I work for the owner."
                },
                {
                    "id": "640990204",
                    "speaker": "Sirafi",
                    "text": "Any product she touched carries a higher price, even if it couldn't be more ordinary!"
                }
            ]
        },
        {
            "talkId": "6409903",
            "initDialog": "640990301",
            "dialogues": [
                {
                    "id": "640990301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640990302",
                    "speaker": "Sirafi",
                    "text": "Guaranteed genuine article!"
                }
            ]
        },
        {
            "talkId": "7394301",
            "initDialog": "739430101",
            "dialogues": [
                {
                    "id": "739430101",
                    "speaker": "Player",
                    "text": "That good, huh?"
                },
                {
                    "id": "739430102",
                    "speaker": "Sirafi",
                    "text": "You don't believe me? Well, you should check the quality of my products before you make any judgment."
                },
                {
                    "id": "739430103",
                    "speaker": "Sirafi",
                    "text": "You can have them. The Palace of Alcazarzaray won't have a problem with it."
                }
            ]
        }
    ]
}