    "talks": [
        {
            "talkId": "6309301",
            "initDialog": "630930101",
            "dialogues": [
                {
                    "id": "630930101",
                    "speaker": "Yokoyama",
                    "text": "Do you need something, outlander?"
                }
            ]
        },
        {
            "talkId": "6309302",
            "initDialog": "630930201",
            "dialogues": [
                {
                    "id": "630930201",
                    "speaker": "Player",
                    "text": "What is this place?"
                },
                {
                    "id": "630930202",
                    "speaker": "Yokoyama",
                    "text": "This is a key site of the Kanjou Commission, not a place an outlander such as yourself should visit."
                },
                {
                    "id": "630930203",
                    "speaker": "Yokoyama",
                    "text": "If you wish to seek audience with the Kanjou Commissioner, then you should go to the Outlander Affairs Agency and hand in your letter and name card."
                },
                {
                    "id": "630930204",
                    "speaker": "Yokoyama",
                    "text": "As for whether you can see the Commissioner... I'd say it's up to luck."
                }
            ]
        },
        {
            "talkId": "6309304",
            "initDialog": "630930401",
            "dialogues": [
                {
                    "id": "630930401",
                    "speaker": "Player",
                    "text": "Goodbye..."
                },
                {
                    "id": "630930402",
                    "speaker": "Yokoyama",
                    "text": "Hmph... Whatever."
                }
            ]
        },
        {
            "talkId": "6309305",
            "initDialog": "630930501",
            "dialogues": [
                {
                    "id": "630930501",
                    "speaker": "Yokoyama",
                    "text": "Hi, can I help you?"
                }
            ]
        },
        {
            "talkId": "6309306",
            "initDialog": "630930601",
            "dialogues": [
                {
                    "id": "630930601",
                    "speaker": "Player",
                    "text": "What is this place?"
                },
                {
                    "id": "630930602",
                    "speaker": "Yokoyama",
                    "text": "This is a key site of the Kanjou Commission, the center of management for all of Ritou."
                },
                {
                    "id": "630930603",
                    "speaker": "Yokoyama",
                    "text": "If there is something you want to see the Clan Head for... I'm afraid you have come at a bad time."
                },
                {
                    "id": "630930604",
                    "speaker": "Yokoyama",
                    "text": "No one can see the Clan Head before Her Excellency the Ogosho makes a judgment."
                }
            ]
        },
        {
            "talkId": "6309307",
            "initDialog": "630930701",
            "dialogues": [
                {
                    "id": "630930701",
                    "speaker": "Player",
                    "text": "Goodbye..."
                },
                {
                    "id": "630930702",
                    "speaker": "Yokoyama",
                    "text": "Bye."
                }
            ]
        }
    ]
