{
    "groupId": "30185",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Kurai": 9,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "4004809",
            "initDialog": "400480901",
            "dialogues": [
                {
                    "id": "400480901",
                    "speaker": "Kurai",
                    "text": "I am the Jibashiri Kurai. Are you here to help solve the problem of these small orbs of thunder?",
                    "choices": [
                        {
                            "id": "400480902",
                            "text": "What problem is that?",
                            "response": [
                                {
                                    "id": "400480903",
                                    "speaker": "Kurai",
                                    "text": "Ah, yes, when I went to Narukami Island to conduct an exchange previously, I used a secret technique to capture some strange objects."
                                },
                                {
                                    "id": "400480904",
                                    "speaker": "Kurai",
                                    "text": "I think the academic name for it is an Electro Seele. Or something."
                                },
                                {
                                    "id": "400480905",
                                    "speaker": "Kurai",
                                    "text": "They fly all over the place, and numb all the people living here. It's quite vexing..."
                                }
                            ]
                        },
                        {
                            "id": "400480906",
                            "text": "What do you need solved?",
                            "response": [
                                {
                                    "id": "400480907",
                                    "speaker": "Kurai",
                                    "text": "Well, the issue of those Electro Cells, of course."
                                },
                                {
                                    "id": "400480908",
                                    "speaker": "Kurai",
                                    "text": "Between you and me, I have no idea what to do with them."
                                },
                                {
                                    "id": "400480909",
                                    "speaker": "Kurai",
                                    "text": "Vishaps and villains, I can master, but these little gadgets are way beyond me."
                                },
                                {
                                    "id": "400480910",
                                    "speaker": "Kurai",
                                    "text": "How am I supposed to stop them from moving?"
                                }
                            ]
                        },
                        {
                            "id": "400480911",
                            "text": "See you.",
                            "response": [
                                {
                                    "id": "400480912",
                                    "speaker": "Kurai",
                                    "text": "See you. If you know how, please help me solve this electric ball problem."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}