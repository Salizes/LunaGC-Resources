    "talks": [
        {
            "talkId": "6430901",
            "initDialog": "643090101",
            "dialogues": [
                {
                    "id": "643090101",
                    "speaker": "Yohanan",
                    "text": "Can't these Forest Rangers be a little clearer? Spores? Pollen? How do they expect anyone to understand what they're saying?"
                }
            ]
        },
        {
            "talkId": "6430902",
            "initDialog": "643090201",
            "dialogues": [
                {
                    "id": "643090201",
                    "speaker": "Player",
                    "text": "Who are you..."
                },
                {
                    "id": "643090202",
                    "speaker": "Yohanan",
                    "text": "I'm from the Eremites."
                },
                {
                    "id": "643090203",
                    "speaker": "Yohanan",
                    "text": "Uh... What else..."
                },
                {
                    "id": "643090204",
                    "speaker": "Yohanan",
                    "text": "By the way, do you need a bodyguard?"
                }
            ]
        },
        {
            "talkId": "6430903",
            "initDialog": "643090301",
            "dialogues": [
                {
                    "id": "643090301",
                    "speaker": "Player",
                    "text": "Seeya."
                },
                {
                    "id": "643090302",
                    "speaker": "Yohanan",
                    "text": "Huh? Okay."
                }
            ]
        },
        {
            "talkId": "6430904",
            "initDialog": "643090401",
            "dialogues": [
                {
                    "id": "643090401",
                    "speaker": "Player",
                    "text": "No, I'm really strong."
                },
                {
                    "id": "643090402",
                    "speaker": "Yohanan",
                    "text": "Whoa, talk about a braggart."
                },
                {
                    "id": "643090403",
                    "speaker": "Yohanan",
                    "text": "Well, here's hoping you're strong enough to survive the rainforest."
                },
                {
                    "id": "643090404",
                    "speaker": "Yohanan",
                    "text": "Otherwise, you'll end up like that researcher over there, who can't afford to hire anyone and just wanders around crowded places."
                },
                {
                    "id": "643090405",
                    "speaker": "Yohanan",
                    "text": "*sigh* I've heard that many researchers frequent the rainforest to study it, so there are more opportunities to make Mora here. Why can't I find anyone who'll hire me?"
                },
                {
                    "id": "643090406",
                    "speaker": "Yohanan",
                    "text": "I really envy \"Flame-Mane.\" It's said that she's got a huge job in the city. I'll make her buy me some drinks when I get back to the city!"
                }
            ]
        },
        {
            "talkId": "6430905",
            "initDialog": "643090501",
            "dialogues": [
                {
                    "id": "643090501",
                    "speaker": "Player",
                    "text": "Adventure Challenge"
                }
            ]
        },
        {
            "talkId": "6430906",
            "initDialog": "643090601",
            "dialogues": [
                {
                    "id": "643090601",
                    "speaker": "Yohanan",
                    "text": "What? You only won because you were carried by the strength of your deck..."
                }
            ]
        },
        {
            "talkId": "6430907",
            "initDialog": "643090701",
            "dialogues": [
                {
                    "id": "643090701",
                    "speaker": "Yohanan",
                    "text": "Haha, I won! I'm telling you, even some researchers can't win against me!"
                }
            ]
        }
    ]
}