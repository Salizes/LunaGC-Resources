    "talks": [
        {
            "talkId": "6424201",
            "initDialog": "642420101",
            "dialogues": [
                {
                    "id": "642420101",
                    "speaker": "Aranaga",
                    "text": "Brings the flowing, invisible, untouchable... \"Hope.\" A new Ashvattha."
                }
            ]
        },
        {
            "talkId": "6424202",
            "initDialog": "642420201",
            "dialogues": [
                {
                    "id": "642420201",
                    "speaker": "Player",
                    "text": "Hello..."
                },
                {
                    "id": "642420202",
                    "speaker": "Aranaga",
                    "text": "#Hello, Nara {NICKNAME}."
                },
                {
                    "id": "642420203",
                    "speaker": "Aranaga",
                    "text": "You stopped the Marana, and helped the wilting forest to be lush again. Thank you, and... Soft-Fluffy White-Mushroom Floaty."
                }
            ]
        },
        {
            "talkId": "6424203",
            "initDialog": "642420301",
            "dialogues": [
                {
                    "id": "642420301",
                    "speaker": "Player",
                    "text": "See you..."
                },
                {
                    "id": "642420302",
                    "speaker": "Aranaga",
                    "text": "#See you, Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6424204",
            "initDialog": "642420401",
            "dialogues": [
                {
                    "id": "642420401",
                    "speaker": "Aranaga",
                    "text": "Withered memories, and growing new friends... Like the Yajna Grass, Aranaga thinks."
                }
            ]
        },
        {
            "talkId": "6424205",
            "initDialog": "642420501",
            "dialogues": [
                {
                    "id": "642420501",
                    "speaker": "Player",
                    "text": "About the Yajna Grass..."
                },
                {
                    "id": "642420502",
                    "speaker": "Aranaga",
                    "text": "Already became dust in the wind, the Yajna Grass. Nara probably see it that way."
                },
                {
                    "id": "642420503",
                    "speaker": "Aranaga",
                    "text": "But... It is radiant again from the forest plants, those already floated away, deeply buried, memories of green leaves with no trace... Every time new Yajna Grass grows new sprouts."
                },
                {
                    "id": "642420504",
                    "speaker": "Aranaga",
                    "text": "#Nara {NICKNAME} and White Floaty are the same. New friends, also old friends. Because have withered and are reborn."
                }
            ]
        },
        {
            "talkId": "6424206",
            "initDialog": "642420601",
            "dialogues": [
                {
                    "id": "642420601",
                    "speaker": "Player",
                    "text": "About \"Mawtiyima\"..."
                },
                {
                    "id": "642420602",
                    "speaker": "Aranaga",
                    "text": "Without the infestation of Marana, Mawtiyima will once again cover flowers and trees... after the moon rises and sets."
                },
                {
                    "id": "642420603",
                    "speaker": "Aranaga",
                    "text": "#Aranaga must thank Nara {NICKNAME} and White Floaty."
                }
            ]
        },
        {
            "talkId": "6424207",
            "initDialog": "642420701",
            "dialogues": [
                {
                    "id": "642420701",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "642420702",
                    "speaker": "Aranaga",
                    "text": "Bye, new friends."
                }
            ]
        }
    ]
}