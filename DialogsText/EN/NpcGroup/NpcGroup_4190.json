    },
    "talks": [
        {
            "talkId": "6419001",
            "initDialog": "641900101",
            "dialogues": [
                {
                    "id": "641900101",
                    "speaker": "Arakunti",
                    "text": "Sound of cooking~ Sound of making puzzles~ And sounds of chasing~ Noisy and messy, but this is how Festival Utsava sounds~"
                }
            ]
        },
        {
            "talkId": "6419002",
            "initDialog": "641900201",
            "dialogues": [
                {
                    "id": "641900201",
                    "speaker": "Player",
                    "text": "About Festival Utsava..."
                },
                {
                    "id": "641900202",
                    "speaker": "Arakunti",
                    "text": "#We meet again, Nara {NICKNAME}."
                },
                {
                    "id": "641900203",
                    "speaker": "Arakunti",
                    "text": "#Nara {NICKNAME} is singing at Festival Utsava, right? That must sound like sunshine and moonlight mixed together, sky and water pool overlapping, and dewdrops and raindrops shaking hands."
                },
                {
                    "id": "641900204",
                    "speaker": "Arakunti",
                    "text": "#Sing with Nara {NICKNAME}, Paimon. No slacking off."
                }
            ]
        },
        {
            "talkId": "6419003",
            "initDialog": "641900301",
            "dialogues": [
                {
                    "id": "641900301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641900302",
                    "speaker": "Arakunti",
                    "text": "#Bye, Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6419004",
            "initDialog": "641900401",
            "dialogues": [
                {
                    "id": "641900401",
                    "speaker": "Arakunti",
                    "text": "#Nara {NICKNAME}'s songs sound golden, just like the warm sun. Arakunti keeps that in mind."
                }
            ]
        },
        {
            "talkId": "6419005",
            "initDialog": "641900501",
            "dialogues": [
                {
                    "id": "641900501",
                    "speaker": "Player",
                    "text": "About singing..."
                },
                {
                    "id": "641900502",
                    "speaker": "Arakunti",
                    "text": "#Arakunti heard the songs of Nara {NICKNAME}. Brave, and full of hope."
                },
                {
                    "id": "641900503",
                    "speaker": "Arakunti",
                    "text": "Just like Nara Varuna, in the stories."
                },
                {
                    "id": "641900504",
                    "speaker": "Arakunti",
                    "text": "#But Nara Varuna never returns to Vanarana. Please come visit, Nara {NICKNAME}."
                }
            ]
        },
        {
            "talkId": "6419006",
            "initDialog": "641900601",
            "dialogues": [
                {
                    "id": "641900601",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "641900602",
                    "speaker": "Arakunti",
                    "text": "#Yes... Promise to come back, please, Nara {NICKNAME}."
                }
            ]
        }
    ]
}