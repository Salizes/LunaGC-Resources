        {
            "talkId": "6957104",
            "initDialog": "695710401",
            "dialogues": [
                {
                    "id": "695710401",
                    "speaker": "Navia",
                    "text": "Don't feel bad! I bet you're just a little light-headed from too much sunlight, you wouldn't have made those mistakes with a clear head! Here, fan yourself with my hat, cool down, and then we'll play another round."
                }
            ]
        },
        {
            "talkId": "6957105",
            "initDialog": "695710501",
            "dialogues": [
                {
                    "id": "695710501",
                    "speaker": "Navia",
                    "text": "Phewee! Now that was fun! I can see why it's such a popular game. ...Hm? Oh, it's not about winning. All that matters to me is that I get to play with my partner!"
                }
            ]
        },
        {
            "talkId": "6957106",
