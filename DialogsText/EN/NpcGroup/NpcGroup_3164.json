{
    "groupId": "3164",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Nameless": 24,
        "Player": 7
    },
    "talks": [
        {
            "talkId": "7212401",
            "initDialog": "721240101",
            "dialogues": [
                {
                    "id": "721240101",
                    "speaker": "Nameless",
                    "text": "Why? Why can't I find it?"
                },
                {
                    "id": "721240102",
                    "speaker": "Player",
                    "text": "What are you looking for?"
                },
                {
                    "id": "721240103",
                    "speaker": "Nameless",
                    "text": "I'm looking for... for... I've forgotten. Each time I think I'm about to remember it, it disappears from my mind."
                },
                {
                    "id": "721240104",
                    "speaker": "Nameless",
                    "text": "Hey, do you know what I'm supposed to be looking for?",
                    "choices": [
                        {
                            "id": "721240105",
                            "text": "How would I know?",
                            "response": [
                                {
                                    "id": "721240106",
                                    "speaker": "Nameless",
                                    "text": "Ugh, I just can't think..."
                                },
                                {
                                    "id": "721240111",
                                    "speaker": "Nameless",
                                    "text": "Curses, curses! Why can't I remember?",
                                    "choices": [
                                        {
                                            "id": "721240112",
                                            "text": "It'll pop into your mind eventually.",
                                            "response": [
                                                {
                                                    "id": "721240113",
                                                    "speaker": "Nameless",
                                                    "text": "That won't do. I can't wait that long."
                                                },
                                                {
                                                    "id": "721240114",
                                                    "speaker": "Nameless",
                                                    "text": "Whatever it is that I'm looking for, it's definitely of the utmost importance to me. I need it back as soon as possible."
                                                },
                                                {
                                                    "id": "721240115",
                                                    "speaker": "Nameless",
                                                    "text": "I have an inexplicable feeling that the reason I am here in this place is to find that very thing. Failing to find it is not an option."
                                                },
                                                {
                                                    "id": "721240116",
                                                    "speaker": "Nameless",
                                                    "text": "I will strike down anyone that tries to interrupt me or stand in my way..."
                                                },
                                                {
                                                    "id": "721240117",
                                                    "speaker": "Nameless",
                                                    "text": "Strike down... Wait, that's right! Brandishing a sword and executing people... it feels familiar, pleasing, hahaha, the surge of blood, like a river of red."
                                                },
                                                {
                                                    "id": "721240122",
                                                    "speaker": "Nameless",
                                                    "text": "When was my sword last stained red?"
                                                },
                                                {
                                                    "id": "721240123",
                                                    "speaker": "Nameless",
                                                    "text": "Hmm, it must have been a few days by now. Well, at least you're here today."
                                                },
                                                {
                                                    "id": "721240124",
                                                    "speaker": "Nameless",
                                                    "text": "For now, let's leave aside the question of what I was looking for. I've tired myself out thinking about it for so long, and now I need to relax."
                                                },
                                                {
                                                    "id": "721240125",
                                                    "speaker": "Nameless",
                                                    "text": "Ah, it's been a while since I brandished my blade. I can hear Takatsuki Dougire complaining."
                                                },
                                                {
                                                    "id": "721240126",
                                                    "speaker": "Nameless",
                                                    "text": "Aw, listen, she's calling out because she wants to cut you into pieces, hahaha. Having a duel with you would make her very happy indeed.",
                                                    "choices": [
                                                        {
                                                            "id": "721240127",
                                                            "text": "Are you... okay?",
                                                            "response": [
                                                                {
                                                                    "id": "721240129",
                                                                    "speaker": "Nameless",
                                                                    "text": "You can't hear Takatsuki Dougire's voice? What a pity."
                                                                },
                                                                {
                                                                    "id": "721240130",
                                                                    "speaker": "Nameless",
                                                                    "text": "Those who live by the sword know to listen to the voice of their blade. ...Hehe, she's nagging me to get on with it again."
                                                                },
                                                                {
                                                                    "id": "721240131",
                                                                    "speaker": "Nameless",
                                                                    "text": "Come, draw your weapon and try your chances against me."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721240128",
                                                            "text": "Your sword can't speak."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721240118",
                                            "text": "Think back to when you arrived here.",
                                            "response": [
                                                {
                                                    "id": "721240119",
                                                    "speaker": "Nameless",
                                                    "text": "When I got here? All I remember doing here is wielding my sword. As for why I was wielding it..."
                                                },
                                                {
                                                    "id": "721240120",
                                                    "speaker": "Nameless",
                                                    "text": "Haha, yes, now that I do remember. I was executing someone!"
                                                },
                                                {
                                                    "id": "721240121",
                                                    "speaker": "Nameless",
                                                    "text": "If you strike your enemy with your sword, blood surges like a river of red. It gives you a real rush, hahaha."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721240107",
                            "text": "Have you looked in all your pockets?",
                            "response": [
                                {
                                    "id": "721240108",
                                    "speaker": "Nameless",
                                    "text": "I already have, it isn't on my person."
                                },
                                {
                                    "id": "721240109",
                                    "speaker": "Nameless",
                                    "text": "Even though I don't remember what I was after, I can tell when something's not what I'm looking for. Whatever it is, it's not on me."
                                },
                                {
                                    "id": "721240110",
                                    "speaker": "Nameless",
                                    "text": "Come on, what is it, what am I looking for..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}