                {
                    "id": "621110101",
                    "speaker": "Aunt Qiao",
                    "text": "You look weary, child. Why not take a rest?"
                }
            ]
        },
        {
            "talkId": "6211102",
            "initDialog": "621110201",
            "dialogues": [
                {
                    "id": "621110201",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "621110202",
                    "speaker": "Aunt Qiao",
                    "text": "Oh, just helping out with the stalls as well as an old lady can."
                },
                {
                    "id": "621110203",
                    "speaker": "Aunt Qiao",
                    "text": "I know all the vendors here very well. The ones who sell cups of tea, leaf tea, and tea eggs."
                },
                {
                    "id": "621110204",
                    "speaker": "Aunt Qiao",
                    "text": "When something comes up, they all feel safest asking me to watch their stalls for them."
                }
            ]
        },
