{
    "groupId": "2154",
    "total_dialogue_lines": 54,
    "speaker_counts": {
        "Paimon": 7,
        "Player": 21,
        "Taliesin": 26
    },
    "talks": [
        {
            "talkId": "6215401",
            "initDialog": "621540101",
            "dialogues": [
                {
                    "id": "621540101",
                    "speaker": "Taliesin",
                    "text": "Sorry, I'm a little dizzy at the moment, but I can take it! Ugh..."
                }
            ]
        },
        {
            "talkId": "6215402",
            "initDialog": "621540201",
            "dialogues": [
                {
                    "id": "621540201",
                    "speaker": "Player",
                    "text": "What is it you're doing here?"
                },
                {
                    "id": "621540202",
                    "speaker": "Taliesin",
                    "text": "I consider myself a bard of the old school, so of course I'm here to get some inspiration."
                },
                {
                    "id": "621540203",
                    "speaker": "Taliesin",
                    "text": "That said, I've never gone down into a mine before... and in my hurry to get here, I wound up... pulling a muscle."
                },
                {
                    "id": "621540204",
                    "speaker": "Taliesin",
                    "text": "Ow ow ow..."
                }
            ]
        },
        {
            "talkId": "6215403",
            "initDialog": "621540301",
            "dialogues": [
                {
                    "id": "621540301",
                    "speaker": "Player",
                    "text": "I won't disturb you, then."
                },
                {
                    "id": "621540302",
                    "speaker": "Taliesin",
                    "text": "Ah, yeah, if you come across any new stories, do tell me!"
                }
            ]
        },
        {
            "talkId": "7104115",
            "initDialog": "710411501",
            "dialogues": [
                {
                    "id": "710411501",
                    "speaker": "Taliesin",
                    "text": "#We meet again, golden-haired {NICKNAME}!",
                    "choices": [
                        {
                            "id": "710411502",
                            "text": "Taliesin, have you come for a duel?",
                            "response": [
                                {
                                    "id": "710411503",
                                    "speaker": "Paimon",
                                    "text": "Wait, what are you saying?"
                                },
                                {
                                    "id": "710411505",
                                    "speaker": "Taliesin",
                                    "text": "Haha, I'm here to get some inspiration, of course! Listen to this: the hero without a past, bereft of any clan, and their loyal fairy retainer!"
                                },
                                {
                                    "id": "710411506",
                                    "speaker": "Paimon",
                                    "text": "No idea who you're talking about."
                                },
                                {
                                    "id": "710411507",
                                    "speaker": "Player",
                                    "text": "Yup. No idea here either."
                                },
                                {
                                    "id": "710411508",
                                    "speaker": "Taliesin",
                                    "text": "Look, look! O modest hero, do not cast your perplexed gaze towards the distant mountains, for in this benighted land, you are the very light itself!"
                                },
                                {
                                    "id": "710411509",
                                    "speaker": "Paimon",
                                    "text": "Eh?"
                                },
                                {
                                    "id": "710411510",
                                    "speaker": "Player",
                                    "text": "What...?"
                                },
                                {
                                    "id": "710411511",
                                    "speaker": "Taliesin",
                                    "text": "I'm talking about you! In my current written template, of course."
                                },
                                {
                                    "id": "710411512",
                                    "speaker": "Player",
                                    "text": "Ah..."
                                },
                                {
                                    "id": "710411513",
                                    "speaker": "Paimon",
                                    "text": "Huh, so this guy can actually say things we understand."
                                },
                                {
                                    "id": "710411514",
                                    "speaker": "Player",
                                    "text": "See you."
                                },
                                {
                                    "id": "710411515",
                                    "speaker": "Taliesin",
                                    "text": "#See you, gold-haired {NICKNAME}!"
                                }
                            ]
                        },
                        {
                            "id": "710411504",
                            "text": "What are you doing here?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7108019",
            "initDialog": "710801901",
            "dialogues": [
                {
                    "id": "710801901",
                    "speaker": "Player",
                    "text": "I'm afraid I don't have any new tales for you at the moment."
                },
                {
                    "id": "710801902",
                    "speaker": "Taliesin",
                    "text": "Ah, is that so... No matter. Do tell me, though, if you do encounter any new stories in your adventures!"
                }
            ]
        },
        {
            "talkId": "7108020",
            "initDialog": "710802001",
            "dialogues": [
                {
                    "id": "710802001",
                    "speaker": "Player",
                    "text": "I'm afraid I don't have any new tales for you at the moment."
                },
                {
                    "id": "710802002",
                    "speaker": "Taliesin",
                    "text": "Ah, is that so... No matter. Journeys of adventure are endless, and so shall tales of adventure be!"
                }
            ]
        },
        {
            "talkId": "7108801",
            "initDialog": "710880101",
            "dialogues": [
                {
                    "id": "710880101",
                    "speaker": "Taliesin",
                    "text": "Hmm... no, no. That's not how that goes. According to the genealogy..."
                },
                {
                    "id": "710880102",
                    "speaker": "Taliesin",
                    "text": "Ooh? Oh! Hello, sorry, didn't see you there!",
                    "choices": [
                        {
                            "id": "710880103",
                            "text": "You...",
                            "response": [
                                {
                                    "id": "710880105",
                                    "speaker": "Taliesin",
                                    "text": "#{F#Shh! Shh! Ahem! She comes, she comes! Her eyes bright as the moon inimitable, her armor formidable, invincible! She is—}{M#Shh! Shh! Ahem! He comes, he comes! His sword shining like the moon so silver, at his footsteps even armies shiver! He is—}"
                                },
                                {
                                    "id": "710880106",
                                    "speaker": "Paimon",
                                    "text": "Blon—die—!",
                                    "choices": [
                                        {
                                            "id": "710880107",
                                            "text": "What!?",
                                            "response": [
                                                {
                                                    "id": "710880109",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe... Sorry, force of habit. It just slipped out, y'know?",
                                                    "choices": [
                                                        {
                                                            "id": "710880110",
                                                            "text": "What sort of habit is that, seriously...",
                                                            "response": [
                                                                {
                                                                    "id": "710880112",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmm, Paimon supposes that the nickname could be uglier..."
                                                                },
                                                                {
                                                                    "id": "710880113",
                                                                    "speaker": "Player",
                                                                    "text": "Hey!"
                                                                },
                                                                {
                                                                    "id": "710880114",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Hahahaha! Well said, good Paimon, well said!"
                                                                },
                                                                {
                                                                    "id": "710880115",
                                                                    "speaker": "Taliesin",
                                                                    "text": "#{F#She}{M#He} is the golden-haired {NICKNAME}!"
                                                                },
                                                                {
                                                                    "id": "710880116",
                                                                    "speaker": "Player",
                                                                    "text": "I object to these terrible-sounding, non-consensual appellations."
                                                                },
                                                                {
                                                                    "id": "710880117",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Apologies, apologies... I did not mean to offend. But more \"old-school\" poets from Mondstadt do tend to begin like that."
                                                                },
                                                                {
                                                                    "id": "710880118",
                                                                    "speaker": "Player",
                                                                    "text": "\"Old-school\"?"
                                                                },
                                                                {
                                                                    "id": "710880119",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Well, if you'll let me clarify, I don't mean old-school folksongs like the \"Dandelion Madrigals\" or old-school romances like \"Marriage, You Cheat, How I Hate Thee\"..."
                                                                },
                                                                {
                                                                    "id": "710880120",
                                                                    "speaker": "Taliesin",
                                                                    "text": "I'm referring to old-school historical epic poetry."
                                                                },
                                                                {
                                                                    "id": "710880121",
                                                                    "speaker": "Player",
                                                                    "text": "And what might that be?"
                                                                },
                                                                {
                                                                    "id": "710880122",
                                                                    "speaker": "Taliesin",
                                                                    "text": "Ah, simply put, it is the adaptation of heroic genealogies, the adding of flesh and skin atop the skeletal frame of history!"
                                                                },
                                                                {
                                                                    "id": "710880123",
                                                                    "speaker": "Taliesin",
                                                                    "text": "These epics sing of history through long-form poetry, awakening people to the knowledge of times past. Well, there you have it — the epic, and its value to society."
                                                                },
                                                                {
                                                                    "id": "710880124",
                                                                    "speaker": "Taliesin",
                                                                    "text": "The ability of poetry to awaken historical consciousness was precisely why it was banned all those years ago by the aristocracy."
                                                                },
                                                                {
                                                                    "id": "710880125",
                                                                    "speaker": "Taliesin",
                                                                    "text": "They feared that we would recall our former freedom and our history of resistance."
                                                                },
                                                                {
                                                                    "id": "710880126",
                                                                    "speaker": "Taliesin",
                                                                    "text": "And that is why I despise the popular poetry of the day and seek to revive these \"old-school epics.\""
                                                                },
                                                                {
                                                                    "id": "710880127",
                                                                    "speaker": "Player",
                                                                    "text": "I see. Bye."
                                                                },
                                                                {
                                                                    "id": "710880128",
                                                                    "speaker": "Taliesin",
                                                                    "text": "#Um, right, then. See you, golden-haired {NICKNAME}!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710880111",
                                                            "text": "That lacked creativity in the extreme."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710880108",
                                            "text": "Paimon!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710880104",
                            "text": "I'm..."
                        }
                    ]
                }
            ]
        }
    ]
}