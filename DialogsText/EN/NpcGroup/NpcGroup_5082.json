    "talks": [
        {
            "talkId": "6508201",
            "initDialog": "650820101",
            "dialogues": [
                {
                    "id": "650820101",
                    "speaker": "Cornelia",
                    "text": "Hello there. Where are you going, if I might ask?"
                }
            ]
        },
        {
            "talkId": "6508202",
            "initDialog": "650820201",
            "dialogues": [
                {
                    "id": "650820201",
                    "speaker": "Player",
                    "text": "I—I'm just looking around..."
                },
                {
                    "id": "650820202",
                    "speaker": "Cornelia",
                    "text": "Ah, so you're just a visiting guest."
                },
                {
                    "id": "650820203",
                    "speaker": "Cornelia",
                    "text": "My apologies, I thought you were a citizen here on business."
                },
                {
                    "id": "650820204",
                    "speaker": "Cornelia",
                    "text": "Since I've been placed here closest to the gate, people always ask me for directions."
                }
            ]
        },
        {
            "talkId": "6508203",
            "initDialog": "650820301",
            "dialogues": [
                {
                    "id": "650820301",
                    "speaker": "Player",
                    "text": "I shan't bother you, then."
                },
                {
                    "id": "650820302",
                    "speaker": "Cornelia",
                    "text": "See you, in that case."
                }
            ]
        },
        {
            "talkId": "6508204",
            "initDialog": "650820401",
            "dialogues": [
                {
                    "id": "650820401",
                    "speaker": "Player",
                    "text": "That sounds like a tough job."
                },
                {
                    "id": "650820402",
                    "speaker": "Cornelia",
                    "text": "It's fine. I don't think so."
                },
                {
                    "id": "650820403",
                    "speaker": "Cornelia",
                    "text": "Interaction brings color to an otherwise ordinary life, and it helps to make your mind more agile."
                },
                {
                    "id": "650820404",
                    "speaker": "Cornelia",
                    "text": "The longer you work here, the more you realize how important this agility is."
                }
            ]
        }
    ]
}