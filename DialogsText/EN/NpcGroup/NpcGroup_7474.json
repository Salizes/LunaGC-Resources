    "talks": [
        {
            "talkId": "6747401",
            "initDialog": "674740101",
            "dialogues": [
                {
                    "id": "674740101",
                    "speaker": "Katia",
                    "text": "Latest papers! The perfect travel companion! Hello there, would you care for a newspaper?"
                }
            ]
        },
        {
            "talkId": "6747402",
            "initDialog": "674740201",
            "dialogues": [
                {
                    "id": "674740201",
                    "speaker": "Player",
                    "text": "Newspaper?"
                },
                {
                    "id": "674740202",
                    "speaker": "Katia",
                    "text": "That’s right. Only a few left! Today's headline is a real page-turner, guaranteed to see you safely on your way!"
                },
                {
                    "id": "674740203",
                    "speaker": "Katia",
                    "text": "The train isn't going anywhere without you, so grab a paper first and keep boredom away!"
                }
            ]
        },
        {
            "talkId": "6747403",
            "initDialog": "674740301",
            "dialogues": [
                {
                    "id": "674740301",
                    "speaker": "Player",
                    "text": "I'm fine at the moment, thanks."
                },
                {
                    "id": "674740302",
                    "speaker": "Katia",
                    "text": "No worries. Best of luck today! And if it's papers you require, come find Katia, your humble supplier!"
                }
            ]
        },
        {
            "talkId": "6747404",
            "initDialog": "674740401",
            "dialogues": [
                {
                    "id": "674740401",
                    "speaker": "Player",
                    "text": "Your sales pitch is pretty interesting."
                },
                {
                    "id": "674740402",
                    "speaker": "Katia",
                    "text": "Oh my, thank you kindly! That means you have a gift for seeing the good in others, and a sharp eye besides!"
                },
                {
                    "id": "674740403",
                    "speaker": "Katia",
                    "text": "Good people deserve good news! And wouldn't you know it, today's paper is full of excellent news. So, would you care for a newspaper?"
                }
            ]
        },
        {
            "talkId": "6747405",
            "initDialog": "674740501",
            "dialogues": [
                {
                    "id": "674740501",
                    "speaker": "Player",
                    "text": "No need."
                },
                {
                    "id": "674740502",
                    "speaker": "Katia",
                    "text": "All right, no worries. And if it’s papers you require, come find Katia, your humble supplier!"
                }
            ]
        },
