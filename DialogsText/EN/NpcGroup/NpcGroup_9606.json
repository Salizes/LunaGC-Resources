        {
            "talkId": "6960601",
            "initDialog": "696060101",
            "dialogues": [
                {
                    "id": "696060101",
                    "speaker": "Lauma",
                    "text": "Even strong winds struggle to dance among the closely packed growth of the forest's depths. There are a few other Frostmoon Scions who also play Genius Invokation... Perhaps I should encourage them to go out into the world and play with others."
                }
            ]
        },
        {
            "talkId": "6960602",
            "initDialog": "696060201",
            "dialogues": [
                {
                    "id": "696060201",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6960603",
            "initDialog": "696060301",
            "dialogues": [
                {
                    "id": "696060301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "696060302",
                    "speaker": "Lauma",
                    "text": "May moonlight illuminate the path before you, and the tranquil forest protect you from ever losing your way."
                }
            ]
        },
        {
            "talkId": "6960604",
            "initDialog": "696060401",
            "dialogues": [
                {
                    "id": "696060401",
                    "speaker": "Lauma",
                    "text": "Even something as constant as the moon itself must wax and wane. Perhaps you were simply unlucky this time. Would you like to try another round?"
                }
            ]
        },
        {
            "talkId": "6960605",
            "initDialog": "696060501",
            "dialogues": [
                {
                    "id": "696060501",
                    "speaker": "Lauma",
                    "text": "I've heard that the desert uses quicksand to deliberately ensnare careless enemies. Your strategy feels equally brilliant. Hmm? You're saying... that's not how it works?"
                }
            ]
        },
        {
            "talkId": "6960606",
            "initDialog": "696060601",
            "dialogues": [
                {
                    "id": "696060601",
                    "speaker": "Lauma",
                    "text": "A game of cards? Sure, why not! Though the only rules I know are the ones I learned from my friends. I hope you don't mind if I get things wrong."
                }
            ]
        },
        {
            "talkId": "6960608",
            "initDialog": "696060801",
            "dialogues": [
                {
                    "id": "696060801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
