            "dialogues": [
                {
                    "id": "696060901",
                    "speaker": "Player",
                    "text": "Let me adjust my deck first..."
                }
            ]
        },
        {
            "talkId": "6960610",
            "initDialog": "696061001",
            "dialogues": [
                {
                    "id": "696061001",
                    "speaker": "Lauma",
                    "text": "The moonlight's guidance determines all..."
                }
            ]
        },
        {
            "talkId": "6960611",
            "initDialog": "696061101",
            "dialogues": [
                {
                    "id": "696061101",
                    "speaker": "Lauma",
                    "text": "Looks like my card skills still have a long way to go."
