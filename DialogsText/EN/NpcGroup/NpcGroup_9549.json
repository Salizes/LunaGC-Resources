            "initDialog": "695490401",
            "dialogues": [
                {
                    "id": "695490401",
                    "speaker": "Dehya",
                    "text": "Hahaha, don't let it get to ya. I almost never lose when I'm playing with the mercs in my brigade. Hardly any of 'em can ever beat me."
