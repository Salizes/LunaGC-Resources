        },
        {
            "talkId": "6954905",
            "initDialog": "695490501",
            "dialogues": [
                {
                    "id": "695490501",
                    "speaker": "Dehya",
                    "text": "Seems my luck ran out today... Hmm, maybe I used it up winning all that money off the others in the brigade?"
                }
            ]
        },
        {
            "talkId": "6954906",
            "initDialog": "695490601",
            "dialogues": [
                {
                    "id": "695490601",
                    "speaker": "Dehya",
                    "text": "Alright, show me what you've got."
