        {
            "talkId": "6954911",
            "initDialog": "695491101",
            "dialogues": [
                {
                    "id": "695491101",
                    "speaker": "Dehya",
                    "text": "I lost fair and square. Never thought you'd be even better than those old mercs I usually play against. Didn't see it coming at all."
