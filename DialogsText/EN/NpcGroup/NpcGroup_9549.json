        },
        {
            "talkId": "6954912",
            "initDialog": "695491201",
            "dialogues": [
                {
                    "id": "695491201",
                    "speaker": "Dehya",
                    "text": "Sure, I'll play... but I don't have anything valuable to bet with today. Guess it'll have to be a low-stakes game."
