            "dialogues": [
                {
                    "id": "635550101",
                    "speaker": "Katheryne",
                    "text": "Ad astra abyssosque!\\nWelcome to the Adventurers' Guild Headquarters."
                }
            ]
        },
        {
            "talkId": "6355502",
            "initDialog": "635550201",
            "dialogues": [
                {
                    "id": "635550201",
                    "speaker": "Katheryne",
                    "text": "Welcome to the Adventurers' Guild, My Lady. Is there something I can help you with?"
                }
            ]
        },
        {
            "talkId": "6741004",
            "initDialog": "674100401",
            "dialogues": [
                {
                    "id": "674100401",
                    "speaker": "Player",
                    "text": "Hey there, Katheryne."
                },
                {
                    "id": "674100402",
                    "speaker": "Katheryne",
                    "text": "Great to see you here."
                },
                {
                    "id": "674100403",
                    "speaker": "Katheryne",
                    "text": "I am Katheryne, the receptionist of the Adventurers' Guild. My job is to provide the adventurers with quests and intelligence support."
                },
                {
                    "id": "674100404",
                    "speaker": "Katheryne",
                    "text": "This is the Adventurers' Guild's headquarters. If you encounter any problems that the local Guilds can't handle, you can consult us here at HQ."
                }
            ]
        },
        {
            "talkId": "6741005",
            "initDialog": "674100501",
            "dialogues": [
                {
                    "id": "674100501",
                    "speaker": "Player",
                    "text": "Give me the rundown about Snezhnaya, if you would..."
                },
                {
                    "id": "674100502",
                    "speaker": "Katheryne",
                    "text": "Adventurers regard Snezhnaya as a vast territory, a great place to show off one's skills..."
                },
                {
                    "id": "674100503",
                    "speaker": "Katheryne",
                    "text": "But be cautious. The bitter cold on the frozen plains and the disasters caused by the Shadow Realm demand extra attention to safety while exploring."
                }
            ]
        },
        {
            "talkId": "6741006",
            "initDialog": "674100601",
            "dialogues": [
                {
                    "id": "674100601",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "674100602",
                    "speaker": "Katheryne",
                    "text": "Farewell, Adventurer, and thank you for supporting the Adventurers' Guild."
                }
            ]
        },
        {
            "talkId": "6741008",
            "initDialog": "674100801",
            "dialogues": [
                {
                    "id": "674100801",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "674100802",
                    "speaker": "Katheryne",
                    "text": "Farewell, My Lady, and thank you for supporting the Adventurers' Guild."
                }
            ]
        },
