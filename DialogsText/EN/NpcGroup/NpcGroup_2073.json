        "Sturdy Wu": 11
    },
    "talks": [
        {
            "talkId": "6207301",
            "initDialog": "620730101",
            "dialogues": [
                {
                    "id": "620730101",
                    "speaker": "Sturdy Wu",
                    "text": "Huh? What're you doin'?"
                }
            ]
        },
        {
            "talkId": "6207302",
            "initDialog": "620730201",
            "dialogues": [
                {
                    "id": "620730201",
                    "speaker": "Player",
                    "text": "Ahh, hello? Where are we right now?"
                },
                {
                    "id": "620730202",
                    "speaker": "Sturdy Wu",
                    "text": "Don't recognize this place? This is Gentry Maocai's residence. He's an ore mogul."
                },
                {
                    "id": "620730203",
                    "speaker": "Sturdy Wu",
                    "text": "If you haven't made an appointment, I'm going to have to ask you to leave. He's not seeing people right now."
                }
            ]
        },
        {
            "talkId": "6207303",
            "initDialog": "620730301",
            "dialogues": [
                {
                    "id": "620730301",
                    "speaker": "Player",
                    "text": "Why do you look like you're up to something...?"
                },
                {
                    "id": "620730302",
                    "speaker": "Sturdy Wu",
                    "text": "W-What're you talking about?"
                },
                {
                    "id": "620730303",
                    "speaker": "Sturdy Wu",
                    "text": "I just guard the door. I know nothing."
                },
                {
                    "id": "620730304",
                    "speaker": "Sturdy Wu",
                    "text": "Even if I did occasionally overhear business secrets, there's no way I'd go leaking information to people. Don't go spreading baseless rumors..."
                }
            ]
        },
        {
            "talkId": "6207304",
            "initDialog": "620730401",
            "dialogues": [
                {
                    "id": "620730401",
                    "speaker": "Player",
                    "text": "Right... We'll be going now."
                },
                {
                    "id": "620730402",
                    "speaker": "Sturdy Wu",
                    "text": "Yes, go. Go!"
                }
            ]
        },
        {
            "talkId": "6207305",
            "initDialog": "620730501",
            "dialogues": [
                {
                    "id": "620730501",
                    "speaker": "Sturdy Wu",
                    "text": "Oh? You again?"
                }
            ]
        },
        {
            "talkId": "6207306",
            "initDialog": "620730601",
            "dialogues": [
                {
                    "id": "620730601",
                    "speaker": "Player",
                    "text": "What is this place?"
                },
                {
                    "id": "620730602",
                    "speaker": "Sturdy Wu",
                    "text": "This is Gentry Maocai's residence. He's a big trader in the gem industry."
                },
                {
                    "id": "620730603",
                    "speaker": "Sturdy Wu",
                    "text": "Though apparently not long ago there was a leak in some sensitive business information, and as a result he ended up getting overcharged by someone from the Feiyun Commerce Guild."
                },
                {
                    "id": "620730604",
                    "speaker": "Sturdy Wu",
                    "text": "Who could be so careless as to let out such influential information?"
                }
            ]
        }
    ]
}