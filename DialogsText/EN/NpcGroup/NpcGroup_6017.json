        {
            "talkId": "6601704",
            "initDialog": "660170401",
            "dialogues": [
                {
                    "id": "660170401",
                    "speaker": "Player",
                    "text": "Will something bad happen if someone does?"
                },
                {
                    "id": "660170402",
                    "speaker": "Yagbeu",
                    "text": "No, not really."
                },
                {
                    "id": "660170403",
                    "speaker": "Yagbeu",
                    "text": "As long as you don't hear me whistle, it means everything around us is normal."
                },
                {
                    "id": "660170404",
                    "speaker": "Yagbeu",
                    "text": "Just go about doing what you need to get done."
                }
            ]
