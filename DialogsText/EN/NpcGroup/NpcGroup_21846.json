    "talks": [
        {
            "talkId": "1504452",
            "initDialog": "150445201",
            "dialogues": [
                {
                    "id": "150445201",
                    "speaker": "Chasca",
                    "text": "In the past, my idea of \"amusement\" has always been seeking out thrills and exciting challenges..."
                },
                {
                    "id": "150445202",
                    "speaker": "Chasca",
                    "text": "But this trip's made me realize, spending time relaxing like this isn't so bad either."
                }
            ]
        },
        {
            "talkId": "1504552",
            "initDialog": "150455201",
            "dialogues": [
                {
                    "id": "150455201",
                    "speaker": "Chasca",
                    "text": "Up for another challenge?"
                }
            ]
        },
        {
            "talkId": "1504583",
            "initDialog": "150458301",
            "dialogues": [
                {
                    "id": "150458301",
                    "speaker": "Player",
                    "text": "How about I take a picture for you?"
                },
                {
                    "id": "150458302",
                    "speaker": "Chasca",
                    "text": "Sure, let's go with that."
                },
                {
                    "id": "150458303",
                    "speaker": "Chasca",
                    "text": "I was thinking of giving something like this to my \"mom,\" but knowing her, she'd probably just raise her wings and give me a tongue-lashing for not visiting her more often instead..."
                },
                {
                    "id": "150458304",
                    "speaker": "Chasca",
                    "text": "So, I think I'll just hold onto this as a memento for myself."
                }
            ]
        },
        {
            "talkId": "1504584",
            "initDialog": "150458401",
            "dialogues": [
                {
                    "id": "150458401",
                    "speaker": "Player",
                    "text": "Sounds great."
                },
                {
                    "id": "150458402",
                    "speaker": "Chasca",
                    "text": "Alright then, let's do this."
                }
            ]
        },
        {
            "talkId": "1504585",
            "initDialog": "150458501",
            "dialogues": [
                {
                    "id": "150458501",
                    "speaker": "Player",
                    "text": "Maybe later?"
                },
                {
                    "id": "150458502",
                    "speaker": "Chasca",
                    "text": "Sure thing. Whenever's good for you."
                }
            ]
        }
    ]
}