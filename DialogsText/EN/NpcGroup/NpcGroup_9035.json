    },
    "talks": [
        {
            "talkId": "6903501",
            "initDialog": "690350101",
            "dialogues": [
                {
                    "id": "690350101",
                    "speaker": "Qiqi",
                    "text": "#Hello... Oh, it's you, {NICKNAME}."
                },
                {
                    "id": "690350102",
                    "speaker": "Qiqi",
                    "text": "I remember you."
                }
            ]
        },
        {
            "talkId": "6903502",
            "initDialog": "690350201",
            "dialogues": [
                {
                    "id": "690350201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                },
                {
                    "id": "690350202",
                    "speaker": "Qiqi",
                    "text": "Umm... nice. Peaceful."
                },
                {
                    "id": "690350203",
                    "speaker": "Qiqi",
                    "text": "I can do my stretches in the daytime without anyone watching."
                },
                {
                    "id": "690350204",
                    "speaker": "Qiqi",
                    "text": "And there aren't too many things to... uhh... remember.",
                    "choices": [
                        {
                            "id": "690350205",
                            "text": "Do you have your notebook with you?",
                            "response": [
                                {
                                    "id": "690350206",
                                    "speaker": "Qiqi",
                                    "text": "Notebook? Notebook..."
                                },
                                {
                                    "id": "690350207",
                                    "speaker": "Qiqi",
                                    "text": "Notebook... Who is that again...?"
                                },
                                {
                                    "id": "690350211",
                                    "speaker": "Player",
                                    "text": "(Oh dear...)"
                                },
                                {
                                    "id": "690350213",
                                    "speaker": "Qiqi",
                                    "text": "No need. I will be fine..."
                                },
                                {
                                    "id": "690350214",
                                    "speaker": "Qiqi",
                                    "text": "Don't forget, Qiqi is stronger than she looks."
                                }
                            ]
                        },
                        {
                            "id": "690350208",
                            "text": "Qiqi, do you still remember how to gather herbs?",
                            "response": [
                                {
                                    "id": "690350209",
                                    "speaker": "Qiqi",
                                    "text": "Herbs...? Herbs..."
                                },
                                {
                                    "id": "690350210",
                                    "speaker": "Qiqi",
                                    "text": "...Remind me, what are herbs again?"
                                },
                                {
                                    "id": "690350212",
                                    "speaker": "Player",
                                    "text": "I'll help you remember."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903503",
            "initDialog": "690350301",
            "dialogues": [
                {
                    "id": "690350301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
                },
                {
                    "id": "690350302",
                    "speaker": "Qiqi",
                    "text": "Chat... chat..."
                },
                {
                    "id": "690350303",
                    "speaker": "Qiqi",
                    "text": "That would be nice. Chatting with you would be great."
                },
                {
                    "id": "690350304",
                    "speaker": "Qiqi",
                    "text": "...But..."
                },
                {
                    "id": "690350305",
                    "speaker": "Player",
                    "text": "But what?"
                },
                {
                    "id": "690350306",
                    "speaker": "Qiqi",
                    "text": "...I'll forget."
                },
                {
                    "id": "690350307",
                    "speaker": "Qiqi",
                    "text": "I'll forget everything we said..."
                },
                {
                    "id": "690350308",
                    "speaker": "Qiqi",
                    "text": "...I'll forget what your voice sounded like..."
                },
                {
                    "id": "690350309",
                    "speaker": "Qiqi",
                    "text": "...And... the happy feeling... I'll forget that too...",
                    "choices": [
                        {
                            "id": "690350310",
                            "text": "But you will be happy in the moment, right? That's what's important.",
                            "response": [
                                {
                                    "id": "690350311",
                                    "speaker": "Qiqi",
                                    "text": "Oh... really?"
                                },
                                {
                                    "id": "690350312",
                                    "speaker": "Qiqi",
                                    "text": "I suppose that... if I was sad now... you would be sad, too."
                                },
                                {
                                    "id": "690350316",
                                    "speaker": "Qiqi",
                                    "text": "Okay. Qiqi wants to smile."
                                },
                                {
                                    "id": "690350317",
                                    "speaker": "Player",
                                    "text": "Aww, what a cute smile."
                                },
                                {
                                    "id": "690350318",
                                    "speaker": "Qiqi",
                                    "text": "Oh..."
                                },
                                {
                                    "id": "690350319",
                                    "speaker": "Qiqi",
                                    "text": "...It's because you're here."
                                }
                            ]
                        },
                        {
                            "id": "690350313",
                            "text": "I'll come and chat with you every day.",
                            "response": [
                                {
                                    "id": "690350314",
                                    "speaker": "Qiqi",
                                    "text": "Every day...?"
                                },
                                {
                                    "id": "690350315",
                                    "speaker": "Qiqi",
                                    "text": "So, every day will be... happy?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903504",
            "initDialog": "690350401",
            "dialogues": [
                {
                    "id": "690350401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
                },
                {
                    "id": "690350402",
                    "speaker": "Qiqi",
                    "text": "I... want to get a pet finch."
                },
                {
                    "id": "690350403",
                    "speaker": "Qiqi",
                    "text": "Then we can... look after it here... together."
                },
                {
                    "id": "690350404",
                    "speaker": "Qiqi",
                    "text": "If you find some seeds, I can feed it."
                },
                {
                    "id": "690350405",
                    "speaker": "Qiqi",
                    "text": "We can build a nest... so the wind and rain won't disturb it."
                },
                {
                    "id": "690350406",
                    "speaker": "Qiqi",
                    "text": "I will take it on walks during the daytime... and it can stretch with me before bedtime.",
                    "choices": [
                        {
                            "id": "690350407",
                            "text": "You'd be like the finch's older sister.",
                            "response": [
                                {
                                    "id": "690350409",
                                    "speaker": "Qiqi",
                                    "text": "Yes! I will be a good... role model."
                                },
                                {
                                    "id": "690350410",
                                    "speaker": "Qiqi",
                                    "text": "I'll protect it... and you too.",
                                    "choices": [
                                        {
                                            "id": "690350411",
                                            "text": "And I'll make sure to look after you both, too.",
                                            "response": [
                                                {
                                                    "id": "690350413",
                                                    "speaker": "Qiqi",
                                                    "text": "Mm-hmm!"
                                                },
                                                {
                                                    "id": "690350414",
                                                    "speaker": "Qiqi",
                                                    "text": "You, Qiqi, and a nice little finch..."
                                                },
                                                {
                                                    "id": "690350415",
                                                    "speaker": "Qiqi",
                                                    "text": "*sigh* That would be quite nice..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690350412",
                                            "text": "Thanks, Qiqi, counting on you!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690350408",
                            "text": "It'd be sure to grow up strong and healthy."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903505",
            "initDialog": "690350501",
            "dialogues": [
                {
                    "id": "690350501",
                    "speaker": "Player",
                    "text": "Morning, Qiqi."
                },
                {
                    "id": "690350502",
                    "speaker": "Qiqi",
                    "text": "#Morning, {NICKNAME}..."
                },
                {
                    "id": "690350503",
                    "speaker": "Qiqi",
                    "text": "Don't forget your things."
                }
            ]
        },
        {
            "talkId": "6903506",
            "initDialog": "690350601",
            "dialogues": [
                {
                    "id": "690350601",
                    "speaker": "Player",
                    "text": "Good night, Qiqi."
                },
                {
                    "id": "690350602",
                    "speaker": "Qiqi",
                    "text": "Good night... I will protect you in your dreams."
                }
            ]
        },
        {
            "talkId": "6903507",
            "initDialog": "690350701",
            "dialogues": [
                {
                    "id": "690350701",
                    "speaker": "Player",
                    "text": "Would you like to have a chat with me?"
                }
            ]
        },
        {
            "talkId": "6903508",
            "initDialog": "690350801",
            "dialogues": [
                {
                    "id": "690350801",
                    "speaker": "Player",
                    "text": "Is there anything you'd like to do?"
                }
            ]
        },
        {
            "talkId": "6903509",
            "initDialog": "690350901",
            "dialogues": [
                {
                    "id": "690350901",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                }
            ]
        },
        {
            "talkId": "6903550",
            "initDialog": "690355001",
            "dialogues": [
                {
                    "id": "690355001",
                    "speaker": "Qiqi",
                    "text": "This place feels... familiar. Let me look at my notebook."
                },
                {
                    "id": "690355002",
                    "speaker": "Qiqi",
                    "text": "Yes, when I was gathering herbs, I rested somewhere. It was like this place."
                },
                {
                    "id": "690355003",
                    "speaker": "Qiqi",
                    "text": "So... this place is safe. Thank you."
                }
            ]
        },
        {
            "talkId": "6903551",
            "initDialog": "690355101",
            "dialogues": [
                {
                    "id": "690355101",
                    "speaker": "Qiqi",
                    "text": "Hmm... My notebook doesn't say anything about this place."
                },
                {
                    "id": "690355102",
                    "speaker": "Qiqi",
                    "text": "But... it's very quiet. I like it. Can I come here often?"
                },
                {
                    "id": "690355103",
                    "speaker": "Qiqi",
                    "text": "I wrote it in my notebook. Thank you."
                }
            ]
        }
    ]
}