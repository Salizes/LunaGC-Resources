{
    "groupId": "5212",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Carranza": 17,
        "Player": 10
    },
    "talks": [
        {
            "talkId": "6521201",
            "initDialog": "652120101",
            "dialogues": [
                {
                    "id": "652120101",
                    "speaker": "Carranza",
                    "text": "Math isn't just beautiful, it's practical. I wish more people understood that."
                }
            ]
        },
        {
            "talkId": "6521202",
            "initDialog": "652120201",
            "dialogues": [
                {
                    "id": "652120201",
                    "speaker": "Player",
                    "text": "What are you doing here?"
                },
                {
                    "id": "652120202",
                    "speaker": "Carranza",
                    "text": "Waiting. I heard a rumor and if it turns out to be true, I will take action."
                }
            ]
        },
        {
            "talkId": "6521203",
            "initDialog": "652120301",
            "dialogues": [
                {
                    "id": "652120301",
                    "speaker": "Player",
                    "text": "Sorry to bother you."
                },
                {
                    "id": "652120302",
                    "speaker": "Carranza",
                    "text": "Until next time."
                }
            ]
        },
        {
            "talkId": "6521204",
            "initDialog": "652120401",
            "dialogues": [
                {
                    "id": "652120401",
                    "speaker": "Player",
                    "text": "I don't understand what you're talking about..."
                },
                {
                    "id": "652120402",
                    "speaker": "Carranza",
                    "text": "Excellent. I don't want you to understand, because if you did, you would become a rival."
                },
                {
                    "id": "652120403",
                    "speaker": "Carranza",
                    "text": "But if you really are in desperate need of someone to talk to, we could discuss something else entirely. Something that will not harm anyone's interests. Math, for example..."
                }
            ]
        },
        {
            "talkId": "6521205",
            "initDialog": "652120501",
            "dialogues": [
                {
                    "id": "652120501",
                    "speaker": "Player",
                    "text": "That's my cue to leave."
                },
                {
                    "id": "652120502",
                    "speaker": "Carranza",
                    "text": "I'll see myself out."
                }
            ]
        },
        {
            "talkId": "6521206",
            "initDialog": "652120601",
            "dialogues": [
                {
                    "id": "652120601",
                    "speaker": "Carranza",
                    "text": "It's important to study during your free time. Studying theater brings only the tiniest of results. It's better to study more practical subjects... Math, for example."
                }
            ]
        },
        {
            "talkId": "6521207",
            "initDialog": "652120701",
            "dialogues": [
                {
                    "id": "652120701",
                    "speaker": "Player",
                    "text": "Why are you here?"
                },
                {
                    "id": "652120702",
                    "speaker": "Carranza",
                    "text": "If you're allowed to be here, surely I am. This place is ideal for usage as a classroom. I can start my undertaking here."
                }
            ]
        },
        {
            "talkId": "6521208",
            "initDialog": "652120801",
            "dialogues": [
                {
                    "id": "652120801",
                    "speaker": "Player",
                    "text": "Sorry to bother you."
                },
                {
                    "id": "652120802",
                    "speaker": "Carranza",
                    "text": "Until next time."
                }
            ]
        },
        {
            "talkId": "6521209",
            "initDialog": "652120901",
            "dialogues": [
                {
                    "id": "652120901",
                    "speaker": "Player",
                    "text": "...Undertaking?"
                },
                {
                    "id": "652120902",
                    "speaker": "Carranza",
                    "text": "Ideally, I would help everyone realize the beauty of mathematics. I know that is not realistic, though."
                },
                {
                    "id": "652120903",
                    "speaker": "Carranza",
                    "text": "So I will teach those willing to learn some practical mathematics. This will be much more meaningful than what the Tri-Coupon Troupe is doing."
                }
            ]
        },
        {
            "talkId": "6521210",
            "initDialog": "652121001",
            "dialogues": [
                {
                    "id": "652121001",
                    "speaker": "Player",
                    "text": "Good luck."
                },
                {
                    "id": "652121002",
                    "speaker": "Carranza",
                    "text": "Thanks."
                }
            ]
        },
        {
            "talkId": "6521211",
            "initDialog": "652121101",
            "dialogues": [
                {
                    "id": "652121101",
                    "speaker": "Player",
                    "text": "They both have their benefits."
                },
                {
                    "id": "652121102",
                    "speaker": "Carranza",
                    "text": "But you have to understand that very few people can manage both at once."
                }
            ]
        },
        {
            "talkId": "6521212",
            "initDialog": "652121201",
            "dialogues": [
                {
                    "id": "652121201",
                    "speaker": "Player",
                    "text": "Good luck."
                },
                {
                    "id": "652121202",
                    "speaker": "Carranza",
                    "text": "Thanks."
                }
            ]
        },
        {
            "talkId": "6521213",
            "initDialog": "652121301",
            "dialogues": [
                {
                    "id": "652121301",
                    "speaker": "Carranza",
                    "text": "Adventure Challenge"
                }
            ]
        },
        {
            "talkId": "6521214",
            "initDialog": "652121401",
            "dialogues": [
                {
                    "id": "652121401",
                    "speaker": "Carranza",
                    "text": "Thanks for the match, I've learned a lot from our encounter."
                }
            ]
        },
        {
            "talkId": "6521215",
            "initDialog": "652121501",
            "dialogues": [
                {
                    "id": "652121501",
                    "speaker": "Carranza",
                    "text": "Looks like my deck needs a rethink..."
                }
            ]
        }
    ]
}