            "dialogues": [
                {
                    "id": "641060201",
                    "speaker": "Player",
                    "text": "Stock of what?"
                },
                {
                    "id": "641060202",
                    "speaker": "Mozhgan",
                    "text": "Sumeru Rose, Mint, Nilotpala Lotus, and the like."
                },
                {
                    "id": "641060203",
                    "speaker": "Mozhgan",
                    "text": "Don't underestimate those small plants. You'll benefit greatly if you know how to use them."
                },
                {
                    "id": "641060204",
                    "speaker": "Mozhgan",
                    "text": "For example, your face will glow if you mash Sumeru Rose in water, and apply the mixture onto your face!"
                },
                {
                    "id": "641060205",
                    "speaker": "Mozhgan",
                    "text": "So listen to me and always keep Sumeru roses in the house."
                }
            ]
        },
        {
            "talkId": "6410603",
            "initDialog": "641060301",
            "dialogues": [
                {
                    "id": "641060301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641060302",
                    "speaker": "Mozhgan",
                    "text": "Yeah, see you."
                }
            ]
        },
        {
            "talkId": "7394501",
            "initDialog": "739450101",
            "dialogues": [
                {
                    "id": "739450101",
                    "speaker": "Player",
                    "text": "Does it actually work?"
                },
                {
                    "id": "739450102",
                    "speaker": "Mozhgan",
                    "text": "Well... in my experience, it'll help at least a little bit."
                },
                {
                    "id": "739450103",
                    "speaker": "Mozhgan",
                    "text": "Anyway, it won't hurt to give it a shot. Just try your luck."
                }
            ]
        }
