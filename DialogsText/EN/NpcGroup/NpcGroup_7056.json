    "talks": [
        {
            "talkId": "6705601",
            "initDialog": "670560101",
            "dialogues": [
                {
                    "id": "670560101",
                    "speaker": "Hurley",
                    "text": "Uh... huh? Um, I'm not really sure, you should ask someone else..."
                }
            ]
        },
        {
            "talkId": "6705602",
            "initDialog": "670560201",
            "dialogues": [
                {
                    "id": "670560201",
                    "speaker": "Player",
                    "text": "Tell me a bit about Nasha Town..."
                },
                {
                    "id": "670560202",
                    "speaker": "Hurley",
                    "text": "There's a merchant guild and a harbor inside, and there are banks. If you need food or a place to stay, you can look for them yourself."
                }
            ]
        },
        {
            "talkId": "6705603",
            "initDialog": "670560301",
            "dialogues": [
                {
                    "id": "670560301",
                    "speaker": "Player",
                    "text": "Is that person also a guard?"
                },
                {
                    "id": "670560302",
                    "speaker": "Hurley",
                    "text": "No idea. I know I am."
                }
            ]
        },
        {
            "talkId": "6705604",
            "initDialog": "670560401",
            "dialogues": [
                {
                    "id": "670560401",
                    "speaker": "Player",
                    "text": "Alright. I shan't disturb you, then..."
                },
                {
                    "id": "670560402",
                    "speaker": "Hurley",
                    "text": "See you."
                }
            ]
        },
        {
            "talkId": "6705605",
            "initDialog": "670560501",
            "dialogues": [
                {
                    "id": "670560501",
                    "speaker": "Player",
                    "text": "Being a guard looks like a pretty cushy job."
                },
                {
                    "id": "670560502",
                    "speaker": "Hurley",
                    "text": "...If that's all from you, please leave. I need to get back to sleep— I mean, standing at attention."
                }
            ]
        },
        {
            "talkId": "6705606",
            "initDialog": "670560601",
            "dialogues": [
                {
                    "id": "670560601",
                    "speaker": "Player",
                    "text": "He looks a little shady..."
                },
                {
                    "id": "670560602",
                    "speaker": "Hurley",
                    "text": "Really? From where I'm standing, you look like the suspicious one."
                }
            ]
        }
    ]
