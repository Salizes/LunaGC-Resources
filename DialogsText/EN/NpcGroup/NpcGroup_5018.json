{
    "groupId": "5018",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Nour": 11,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "6501801",
            "initDialog": "650180101",
            "dialogues": [
                {
                    "id": "650180101",
                    "speaker": "Nour",
                    "text": "It might be time to check the durability of the bearings..."
                }
            ]
        },
        {
            "talkId": "6501802",
            "initDialog": "650180201",
            "dialogues": [
                {
                    "id": "650180201",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "650180202",
                    "speaker": "Nour",
                    "text": "I'm a patrolling Gardes member."
                },
                {
                    "id": "650180203",
                    "speaker": "Nour",
                    "text": "More precisely, I accompany the Gardemek on patrol."
                }
            ]
        },
        {
            "talkId": "6501803",
            "initDialog": "650180301",
            "dialogues": [
                {
                    "id": "650180301",
                    "speaker": "Player",
                    "text": "Tell me about the Gardemeks..."
                },
                {
                    "id": "650180302",
                    "speaker": "Nour",
                    "text": "They're machines, but they're an indispensable part of the Gardes. We rely upon them for the maintenance of public safety, day in and day out."
                },
                {
                    "id": "650180303",
                    "speaker": "Nour",
                    "text": "As for me, you can consider me more of an engineer in charge of their maintenance."
                }
            ]
        },
        {
            "talkId": "6501804",
            "initDialog": "650180401",
            "dialogues": [
                {
                    "id": "650180401",
                    "speaker": "Player",
                    "text": "Sorry for bothering you."
                },
                {
                    "id": "650180402",
                    "speaker": "Nour",
                    "text": "It's fine."
                }
            ]
        },
        {
            "talkId": "6501805",
            "initDialog": "650180501",
            "dialogues": [
                {
                    "id": "650180501",
                    "speaker": "Player",
                    "text": "That dog is a machine?"
                },
                {
                    "id": "650180502",
                    "speaker": "Nour",
                    "text": "Huh? Oh, no, no, I'm referring to that big machine over there in the distance, not this little cutie."
                },
                {
                    "id": "650180503",
                    "speaker": "Nour",
                    "text": "Of course, it's also of great assistance to us Gardes. Guard Poodles can do a great many things — neither man nor Mek can replace them."
                }
            ]
        },
        {
            "talkId": "7492401",
            "initDialog": "749240101",
            "dialogues": [
                {
                    "id": "749240101",
                    "speaker": "Player",
                    "text": "Sounds pretty easy."
                },
                {
                    "id": "749240102",
                    "speaker": "Nour",
                    "text": "It's a lot easier if we don't need to deal with any danger directly."
                },
                {
                    "id": "749240103",
                    "speaker": "Nour",
                    "text": "In turn, the maintenance and upkeep of Gardemeks must be practiced every day."
                },
                {
                    "id": "749240104",
                    "speaker": "Nour",
                    "text": "As long as I keep a Gardemek in good condition, it will be able to protect others. Simple, isn't it?"
                }
            ]
        }
    ]
}