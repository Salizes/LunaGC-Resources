            "dialogues": [
                {
                    "id": "640110101",
                    "speaker": "Layth",
                    "text": "The climate of the rainforest has been so unkind to me..."
                }
            ]
        },
        {
            "talkId": "6401102",
            "initDialog": "640110201",
            "dialogues": [
                {
                    "id": "640110201",
                    "speaker": "Player",
                    "text": "What is it?"
                },
                {
                    "id": "640110202",
                    "speaker": "Layth",
                    "text": "My old wound often aches in humid weather, so it pretty much hurts all the time in Sumeru City."
                },
                {
                    "id": "640110203",
                    "speaker": "Layth",
                    "text": "Also, because of it, I can only do simple work in town."
                },
                {
                    "id": "640110204",
                    "speaker": "Layth",
                    "text": "It's truly a dilemma..."
                }
            ]
        },
        {
            "talkId": "6401103",
            "initDialog": "640110301",
            "dialogues": [
                {
                    "id": "640110301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640110302",
                    "speaker": "Layth",
                    "text": "Someone come tell me when to retire..."
                }
            ]
        }
    ]
