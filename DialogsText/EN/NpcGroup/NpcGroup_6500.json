{
    "groupId": "6500",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Motolinia": 10,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "6650001",
            "initDialog": "665000101",
            "dialogues": [
                {
                    "id": "665000101",
                    "speaker": "Motolinia",
                    "text": "In the language of flowers, Brewblossoms represent the unpredictability of fate. According to my divination, you must be here to seek the guidance of my \"flowers\"..."
                }
            ]
        },
        {
            "talkId": "6650002",
            "initDialog": "665000201",
            "dialogues": [
                {
                    "id": "665000201",
                    "speaker": "Player",
                    "text": "Let me see your \"flowers.\""
                },
                {
                    "id": "665000202",
                    "speaker": "Motolinia",
                    "text": "May you find your fate within."
                }
            ]
        },
        {
            "talkId": "6650003",
            "initDialog": "665000301",
            "dialogues": [
                {
                    "id": "665000301",
                    "speaker": "Player",
                    "text": "And you are...?"
                },
                {
                    "id": "665000302",
                    "speaker": "Motolinia",
                    "text": "Me? I'm Motolinia, interpreter of the language of \"flowers.\" In layman's terms, I'm the owner of this flower shop."
                }
            ]
        },
        {
            "talkId": "6650004",
            "initDialog": "665000401",
            "dialogues": [
                {
                    "id": "665000401",
                    "speaker": "Player",
                    "text": "So these \"flowers\" can talk?"
                },
                {
                    "id": "665000402",
                    "speaker": "Motolinia",
                    "text": "Yes, and no. Flowers cannot talk, but everything about them speaks. Their appearances may unveil destiny. Their pollen may express emotions. And their buds may divine our endings."
                },
                {
                    "id": "665000403",
                    "speaker": "Motolinia",
                    "text": "And all you need do to understand them is merely listen carefully..."
                }
            ]
        },
        {
            "talkId": "6650005",
            "initDialog": "665000501",
            "dialogues": [
                {
                    "id": "665000501",
                    "speaker": "Player",
                    "text": "Any recommendations for which flowers to buy?"
                },
                {
                    "id": "665000502",
                    "speaker": "Motolinia",
                    "text": "Strong flowers are drawn to burning souls. Perhaps one that stands proudly in the wind, like a Brilliant Chrysanthemum, would be a more suitable companion for you."
                }
            ]
        },
        {
            "talkId": "6650007",
            "initDialog": "665000701",
            "dialogues": [
                {
                    "id": "665000701",
                    "speaker": "Player",
                    "text": "Sorry, maybe next time."
                },
                {
                    "id": "665000702",
                    "speaker": "Motolinia",
                    "text": "Be safe. As the \"flowers\" foretell, our paths are sure to cross once more..."
                }
            ]
        },
        {
            "talkId": "6650008",
            "initDialog": "665000801",
            "dialogues": [
                {
                    "id": "665000801",
                    "speaker": "Motolinia",
                    "text": "Adventure Challenge"
                }
            ]
        },
        {
            "talkId": "6650009",
            "initDialog": "665000901",
            "dialogues": [
                {
                    "id": "665000901",
                    "speaker": "Motolinia",
                    "text": "Everything comes from the guidance of \"flowers\"..."
                }
            ]
        },
        {
            "talkId": "6650010",
            "initDialog": "665001001",
            "dialogues": [
                {
                    "id": "665001001",
                    "speaker": "Motolinia",
                    "text": "What is it? Was my divination mistaken?"
                }
            ]
        }
    ]
}