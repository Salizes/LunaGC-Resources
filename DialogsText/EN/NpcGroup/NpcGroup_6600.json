            "dialogues": [
                {
                    "id": "666000101",
                    "speaker": "Q'utuj",
                    "text": "There's... two of you, right? Or is it four? Eh, make that... eight?"
                },
                {
                    "id": "666000102",
                    "speaker": "Player",
                    "text": "...I'm sorry?"
                },
                {
                    "id": "666000103",
                    "speaker": "Q'utuj",
                    "text": "And why do the eight of you all look the same? Are you octuplets?"
                },
                {
                    "id": "666000104",
                    "speaker": "Q'utuj",
                    "text": "Wait... No, you're quadruplets now?"
                },
                {
                    "id": "666000105",
                    "speaker": "Q'utuj",
                    "text": "I heard the Mare Jivari's supposed to be around here somewhere... Don't tell me you're all ghosts?!"
                }
            ]
        }
    ]
