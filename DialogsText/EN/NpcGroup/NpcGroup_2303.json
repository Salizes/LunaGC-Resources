{
    "groupId": "2303",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Little Xing": 13,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "6230301",
            "initDialog": "623030101",
            "dialogues": [
                {
                    "id": "623030101",
                    "speaker": "Little Xing",
                    "text": "Do you know what the most important thing is to have if you wanna be an adventurer?"
                }
            ]
        },
        {
            "talkId": "6230302",
            "initDialog": "623030201",
            "dialogues": [
                {
                    "id": "623030201",
                    "speaker": "Player",
                    "text": "Let me guess..."
                },
                {
                    "id": "623030202",
                    "speaker": "Little Xing",
                    "text": "Alright! What's your guess?",
                    "choices": [
                        {
                            "id": "623030203",
                            "text": "Courage.",
                            "response": [
                                {
                                    "id": "623030204",
                                    "speaker": "Little Xing",
                                    "text": "Yep! It's courage. Adventurers never know what they're gonna find, so they need courage to face it."
                                },
                                {
                                    "id": "623030205",
                                    "speaker": "Little Xing",
                                    "text": "Like, I've never left the village on my own before, but I'm a big boy so I'm... I'm not scared."
                                },
                                {
                                    "id": "623030206",
                                    "speaker": "Little Xing",
                                    "text": "It's the first step I need to take if I wanna become a mighty adventurer one day."
                                }
                            ]
                        },
                        {
                            "id": "623030207",
                            "text": "Vision.",
                            "response": [
                                {
                                    "id": "623030208",
                                    "speaker": "Little Xing",
                                    "text": "That's what Little Liu says. You definitely need a Vision."
                                },
                                {
                                    "id": "623030209",
                                    "speaker": "Little Xing",
                                    "text": "With a Vision, you can do literally anything! Not just defeating all the monsters; you can get loadsa money too..."
                                },
                                {
                                    "id": "623030210",
                                    "speaker": "Little Xing",
                                    "text": "If I had loadsa money Mom and Dad wouldn't need to work away from home. They could stay in the village and it would be fun here like it used to be — like how Little Liu says it was!"
                                }
                            ]
                        },
                        {
                            "id": "623030211",
                            "text": "Paimon.",
                            "response": [
                                {
                                    "id": "623030212",
                                    "speaker": "Little Xing",
                                    "text": "Paimon? What's a Paimon? No one's told me about them before."
                                },
                                {
                                    "id": "623030213",
                                    "speaker": "Little Xing",
                                    "text": "I'm asking an honest question here, buddy, and I'd appreciate an honest answer, too."
                                },
                                {
                                    "id": "623030214",
                                    "speaker": "Little Xing",
                                    "text": "Hmm... Is it some kind of food?"
                                },
                                {
                                    "id": "623030215",
                                    "speaker": "Little Xing",
                                    "text": "That would make sense; you can't let your tummy rumble when you're on an adventure."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6230303",
            "initDialog": "623030301",
            "dialogues": [
                {
                    "id": "623030301",
                    "speaker": "Player",
                    "text": "Who knows."
                },
                {
                    "id": "623030302",
                    "speaker": "Little Xing",
                    "text": "Huh. Okay then. Seems like Little Liu is the only one who's clued up on things around here..."
                }
            ]
        }
    ]
}