{
    "groupId": "6030",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Erinle": 11,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6603001",
            "initDialog": "660300101",
            "dialogues": [
                {
                    "id": "660300101",
                    "speaker": "Erinle",
                    "text": "Hi, one moment please."
                },
                {
                    "id": "660300102",
                    "speaker": "Erinle",
                    "text": "Please answer without thinking. When was your last checkup?"
                }
            ]
        },
        {
            "talkId": "6603002",
            "initDialog": "660300201",
            "dialogues": [
                {
                    "id": "660300201",
                    "speaker": "Player",
                    "text": "Err, probably..."
                },
                {
                    "id": "660300202",
                    "speaker": "Erinle",
                    "text": "Heh, you hesitated."
                },
                {
                    "id": "660300203",
                    "speaker": "Erinle",
                    "text": "Say no more. Make some time, go find a doctor, and get yourself a checkup."
                },
                {
                    "id": "660300204",
                    "speaker": "Erinle",
                    "text": "You might think I'm saying this just to scare you, but you probably don't know that many contestants only end up being told about major health issues just moments before they are supposed to compete."
                },
                {
                    "id": "660300205",
                    "speaker": "Erinle",
                    "text": "It's a real shame when minor, neglected illnesses turn into something more serious, ruining all that hard work they've put into training."
                },
                {
                    "id": "660300206",
                    "speaker": "Erinle",
                    "text": "And even if you're not a warrior, you still need to go for regular checkups!"
                },
                {
                    "id": "660300207",
                    "speaker": "Erinle",
                    "text": "You should know, a person without health is no different from a tribe without people."
                }
            ]
        },
        {
            "talkId": "6603003",
            "initDialog": "660300301",
            "dialogues": [
                {
                    "id": "660300301",
                    "speaker": "Player",
                    "text": "I'll go right away!"
                },
                {
                    "id": "660300302",
                    "speaker": "Erinle",
                    "text": "That's sorted then!"
                }
            ]
        },
        {
            "talkId": "7591601",
            "initDialog": "759160101",
            "dialogues": [
                {
                    "id": "759160101",
                    "speaker": "Player",
                    "text": "I—I get it."
                },
                {
                    "id": "759160102",
                    "speaker": "Erinle",
                    "text": "Good. That's another person persuaded."
                },
                {
                    "id": "759160103",
                    "speaker": "Erinle",
                    "text": "Nothing worse than waiting until you're already reaping the whirlwind with no way out."
                }
            ]
        }
    ]
}