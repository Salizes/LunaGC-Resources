    "talks": [
        {
            "talkId": "6742001",
            "initDialog": "674200101",
            "dialogues": [
                {
                    "id": "674200101",
                    "speaker": "Nefedov",
                    "text": "This order's ready! And this one here, it needs serving — Table One! Hmm? What is it?"
                }
            ]
        },
        {
            "talkId": "6742002",
            "initDialog": "674200201",
            "dialogues": [
                {
                    "id": "674200201",
                    "speaker": "Player",
                    "text": "Are you the boss here?"
                },
                {
                    "id": "674200202",
                    "speaker": "Nefedov",
                    "text": "That's right. This Volkodlak-founded, Volkodlak-run outfit, serving one and all in Snezhnaya... I run it, sure as snowfall."
                },
                {
                    "id": "674200203",
                    "speaker": "Nefedov",
                    "text": "Anyway, if you came to ask about that, I'm afraid we'll have to cut this conversation short. Got work to do and all."
                }
            ]
        },
        {
            "talkId": "6742003",
            "initDialog": "674200301",
            "dialogues": [
                {
                    "id": "674200301",
                    "speaker": "Player",
                    "text": "Would any fur drop into the dishes?"
                },
                {
                    "id": "674200302",
                    "speaker": "Nefedov",
                    "text": "Of course not. Our chefs clean up any loose fur before stepping up to the plate, and we do our best to ensure that nothing falls into the dishes while we cook..."
                },
                {
                    "id": "674200303",
                    "speaker": "Nefedov",
                    "text": "If you... do encounter something of the sort, you can get our waiter to clear the dish, and we'll make you a fresh one."
                }
            ]
        },
        {
            "talkId": "6742004",
            "initDialog": "674200401",
            "dialogues": [
                {
                    "id": "674200401",
                    "speaker": "Player",
                    "text": "It's nothing serious."
                },
                {
                    "id": "674200402",
                    "speaker": "Nefedov",
                    "text": "Then I wish you an enjoyable meal, dear customer."
                }
            ]
        },
