    "talks": [
        {
            "talkId": "37703",
            "initDialog": "3770301",
            "dialogues": [
                {
                    "id": "3770301",
                    "speaker": "Diluc",
                    "text": "Not now. It's still early. The tavern closes <color=#00E1FFFF>at midnight</color>. My contact will be on time."
                }
            ]
        },
        {
            "talkId": "37705",
            "initDialog": "3770303",
            "dialogues": [
                {
                    "id": "3770303",
                    "speaker": "Diluc",
                    "text": "Don't forget our meeting <color=#00E1FFFF>tomorrow night</color>."
                }
            ]
        },
        {
            "talkId": "38307",
            "initDialog": "3830527",
            "dialogues": [
                {
                    "id": "3830527",
                    "speaker": "Diluc",
                    "text": "Although we may be able to negotiate with Stormterror, we'll most likely have to fight. Please be ready for it.",
                    "choices": [
                        {
                            "id": "3830528",
                            "text": "Tell me about Angel's Share.",
                            "response": [
                                {
                                    "id": "3830529",
                                    "speaker": "Diluc",
                                    "text": "Some of Dawn Winery's wine is sold at Angel's Share, a local tavern."
                                },
                                {
                                    "id": "3830530",
                                    "speaker": "Diluc",
                                    "text": "I work the bar there sometimes. If you ever need to talk to me, feel free to find me there."
                                },
                                {
                                    "id": "3830531",
                                    "speaker": "Diluc",
                                    "text": "Otherwise, you might need to make an appointment with my butler."
                                }
                            ]
                        },
                        {
                            "id": "3830532",
                            "text": "Why are you helping us?",
                            "response": [
                                {
                                    "id": "3830533",
                                    "speaker": "Diluc",
                                    "text": "I mostly decided to do it on a whim. Though I must say, that bard is quite intriguing."
                                },
                                {
                                    "id": "3830534",
                                    "speaker": "Diluc",
                                    "text": "Besides, it's bad for my business if we keep letting Stormterror do whatever it pleases."
                                },
                                {
                                    "id": "3830535",
                                    "speaker": "Diluc",
                                    "text": "Let me be clear though. I did it for you, not for the Knights."
                                }
                            ]
                        },
                        {
                            "id": "3830536",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3830537",
                                    "speaker": "Diluc",
                                    "text": "Nothing more? We'll meet at Starsnatch Cliff then."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}