    "talks": [
        {
            "talkId": "6413401",
            "initDialog": "641340101",
            "dialogues": [
                {
                    "id": "641340101",
                    "speaker": "Servan",
                    "text": "Hey, wanna see something new?"
                }
            ]
        },
        {
            "talkId": "6413402",
            "initDialog": "641340201",
            "dialogues": [
                {
                    "id": "641340201",
                    "speaker": "Player",
                    "text": "Is this another one...?"
                },
                {
                    "id": "641340202",
                    "speaker": "Servan",
                    "text": "Huh? What do you mean by \"another one\"?"
                },
                {
                    "id": "641340203",
                    "speaker": "Servan",
                    "text": "I have something new here that you've definitely never seen before!"
                },
                {
                    "id": "641340204",
                    "speaker": "Servan",
                    "text": "Look at this! It can be squeezed into various shapes and can stick to the wall. It's slime paste!"
                },
                {
                    "id": "641340205",
                    "speaker": "Servan",
                    "text": "And this one is called \"Up, Up, and Away\"! Just rub it between your hands and it will rise up into the air!"
                },
                {
                    "id": "641340206",
                    "speaker": "Servan",
                    "text": "How do you like it? Fun, isn't it? Buy it for yourself or bring it back home to your kids, it's all good!"
                },
                {
                    "id": "641340207",
                    "speaker": "Servan",
                    "text": "Hey, d—don't go..."
                }
            ]
        },
        {
            "talkId": "6413403",
            "initDialog": "641340301",
            "dialogues": [
                {
                    "id": "641340301",
                    "speaker": "Player",
                    "text": "Bye!"
                },
                {
                    "id": "641340302",
                    "speaker": "Servan",
                    "text": "D—Don't walk away! Let me just give you a quick demo!"
                }
            ]
        }
    ]
}