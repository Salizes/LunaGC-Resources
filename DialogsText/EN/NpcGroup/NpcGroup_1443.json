    "talks": [
        {
            "talkId": "6144301",
            "initDialog": "614430101",
            "dialogues": [
                {
                    "id": "614430101",
                    "speaker": "Otto",
                    "text": "Hello, traveler. Welcome to Mondstadt."
                }
            ]
        },
        {
            "talkId": "6144302",
            "initDialog": "614430201",
            "dialogues": [
                {
                    "id": "614430201",
                    "speaker": "Player",
                    "text": "What are you doing here?"
                },
                {
                    "id": "614430202",
                    "speaker": "Otto",
                    "text": "As you can see, I am a Mondstadt guard."
                },
                {
                    "id": "614430203",
                    "speaker": "Otto",
                    "text": "Protecting the people, travelers, and merchants is my duty."
                }
            ]
        },
        {
            "talkId": "6144303",
            "initDialog": "614430301",
            "dialogues": [
                {
                    "id": "614430301",
                    "speaker": "Player",
                    "text": "Is there anything worth visiting in Mondstadt?"
                },
                {
                    "id": "614430302",
                    "speaker": "Otto",
                    "text": "If it's your first time here, I recommend visiting the Mondstadt Cathedral."
                },
                {
                    "id": "614430303",
                    "speaker": "Otto",
                    "text": "If you're tired, go have some of Mondstadt's famous wine at a tavern called \"Angel's Share.\""
                }
            ]
        },
        {
            "talkId": "6144304",
            "initDialog": "614430401",
            "dialogues": [
                {
                    "id": "614430401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "614430402",
                    "speaker": "Otto",
                    "text": "Goodbye, traveler."
                },
                {
                    "id": "614430403",
                    "speaker": "Otto",
                    "text": "May the Anemo Archon protect you."
                }
            ]
        },
        {
            "talkId": "6144305",
            "initDialog": "614430501",
            "dialogues": [
                {
                    "id": "614430501",
                    "speaker": "Otto",
                    "text": "We are currently experiencing abnormal weather patterns. It is dangerous outside. Citizens are advised to seek shelter."
                }
            ]
        },
        {
            "talkId": "6144306",
            "initDialog": "614430601",
            "dialogues": [
                {
                    "id": "614430601",
                    "speaker": "Otto",
                    "text": "That dragon could return at any time. The Knights of Favonius will keep watch; everyone else is urged to find shelter immediately."
                }
            ]
        },
        {
            "talkId": "6144307",
            "initDialog": "614430701",
            "dialogues": [
                {
                    "id": "614430701",
                    "speaker": "Otto",
                    "text": "This is an emergency. Please be assured that the Knights of Favonius' first priority is to guarantee the safety of everyone in the city."
                }
            ]
        }
    ]
}