{
    "groupId": "1441",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Guy": 16,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6144101",
            "initDialog": "4015144101",
            "dialogues": [
                {
                    "id": "4015144101",
                    "speaker": "Guy",
                    "text": "Another meaningless day..."
                },
                {
                    "id": "4015144116",
                    "speaker": "Guy",
                    "text": "Oh! Do you need a hand with anything? B—But never mind if you don't though!",
                    "choices": [
                        {
                            "id": "4015144102",
                            "text": "What are you doing?",
                            "response": [
                                {
                                    "id": "4015144105",
                                    "speaker": "Guy",
                                    "text": "I'd like to know as well... What are you doing here, Guy?"
                                },
                                {
                                    "id": "4015144106",
                                    "speaker": "Guy",
                                    "text": "Alright, I'm guarding the side gate of Mondstadt. As everyone knows, it's a gate that no one uses."
                                },
                                {
                                    "id": "4015144107",
                                    "speaker": "Guy",
                                    "text": "Mock me all you want. I know it's a pointless job."
                                }
                            ]
                        },
                        {
                            "id": "4015144103",
                            "text": "You seem upset.",
                            "response": [
                                {
                                    "id": "4015144108",
                                    "speaker": "Guy",
                                    "text": "Of course I'm upset."
                                },
                                {
                                    "id": "4015144109",
                                    "speaker": "Guy",
                                    "text": "I've started training at the age of 8, learned swordsmanship at the age of 10, and become a squire at 16..."
                                },
                                {
                                    "id": "4015144110",
                                    "speaker": "Guy",
                                    "text": "I'm the pride of the family, yet I'm tasked with such a job..."
                                },
                                {
                                    "id": "4015144111",
                                    "speaker": "Guy",
                                    "text": "As a member of the Knights of Favonius, guarding the side gate is like Cat's Tail without Diona. There's no soul in it!"
                                },
                                {
                                    "id": "4015144112",
                                    "speaker": "Guy",
                                    "text": "...Anyway, have you bumped into any trouble? Any kind at all — let me see if I can help! I am a Knight of Favonius after all!"
                                },
                                {
                                    "id": "4015144113",
                                    "speaker": "Guy",
                                    "text": "Oh... Okay then..."
                                }
                            ]
                        },
                        {
                            "id": "4015144104",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "4015144114",
                                    "speaker": "Guy",
                                    "text": "Please do come to me when you need help..."
                                },
                                {
                                    "id": "4015144115",
                                    "speaker": "Guy",
                                    "text": "Well, forget it. You won't remember me anyway..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6144102",
            "initDialog": "614410201",
            "dialogues": [
                {
                    "id": "614410201",
                    "speaker": "Guy",
                    "text": "We are currently experiencing abnormal weather patterns. It is dangerous outside. Citizens are advised to seek shelter."
                }
            ]
        },
        {
            "talkId": "6144103",
            "initDialog": "614410301",
            "dialogues": [
                {
                    "id": "614410301",
                    "speaker": "Guy",
                    "text": "That dragon could return at any time. The Knights of Favonius will keep watch; everyone else is urged to find shelter immediately."
                }
            ]
        },
        {
            "talkId": "6144104",
            "initDialog": "614410401",
            "dialogues": [
                {
                    "id": "614410401",
                    "speaker": "Guy",
                    "text": "This is an emergency. Please be assured that the Knights of Favonius' first priority is to guarantee the safety of everyone in the city."
                }
            ]
        }
    ]
}