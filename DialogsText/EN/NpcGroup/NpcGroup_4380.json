                    "text": "..."
                },
                {
                    "id": "643800102",
                    "speaker": "Hunayn",
                    "text": "Hello. How can I help you?"
                }
            ]
        },
        {
            "talkId": "6438002",
            "initDialog": "643800201",
            "dialogues": [
                {
                    "id": "643800201",
                    "speaker": "Player",
                    "text": "Who are you..."
                },
                {
                    "id": "643800202",
                    "speaker": "Hunayn",
                    "text": "I came to borrow some books. I've been applying for additional permits to borrow more books."
                },
                {
                    "id": "643800203",
                    "speaker": "Hunayn",
                    "text": "I've read almost everything on general knowledge that I can borrow from here. Hope my mentor can give me access to other books soon."
                }
            ]
        },
        {
            "talkId": "6438003",
            "initDialog": "643800301",
            "dialogues": [
                {
                    "id": "643800301",
                    "speaker": "Player",
                    "text": "Sorry to bother you..."
                },
                {
                    "id": "643800302",
                    "speaker": "Hunayn",
                    "text": "No worries."
                }
            ]
        },
        {
            "talkId": "6438004",
            "initDialog": "643800401",
            "dialogues": [
                {
                    "id": "643800401",
                    "speaker": "Player",
                    "text": "Do you have any recommended reads?"
                },
                {
                    "id": "643800402",
                    "speaker": "Hunayn",
                    "text": "It depends on which Darshan and subject you're interested in."
                },
                {
                    "id": "643800403",
                    "speaker": "Hunayn",
                    "text": "I can give you a list based on that."
                },
                {
                    "id": "643800404",
                    "speaker": "Hunayn",
                    "text": "But only researchers and students at the Akademiya can borrow books from the House of Daena, so you will need a permit."
                }
            ]
        }
    ]
}