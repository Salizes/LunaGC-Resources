{
    "groupId": "7735",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Congshen": 6,
        "Player": 7
    },
    "talks": [
        {
            "talkId": "6773501",
            "initDialog": "677350101",
            "dialogues": [
                {
                    "id": "677350101",
                    "speaker": "Congshen",
                    "text": "Dreams, illusions, bubbles, and shadows — why labor to grasp them? Even if you study the principles for a thousand years, if you keep your mind completely still and \"unborn,\" you simply won't understand."
                }
            ]
        },
        {
            "talkId": "6773502",
            "initDialog": "677350201",
            "dialogues": [
                {
                    "id": "677350201",
                    "speaker": "Player",
                    "text": "So... are you looking for a book?"
                },
                {
                    "id": "677350202",
                    "speaker": "Congshen",
                    "text": "Have you ever been here before?",
                    "choices": [
                        {
                            "id": "677350203",
                            "text": "Huh?",
                            "response": [
                                {
                                    "id": "677350206",
                                    "speaker": "Congshen",
                                    "text": "Then you understand.",
                                    "choices": [
                                        {
                                            "id": "677350207",
                                            "text": "Understand... understand what?",
                                            "response": [
                                                {
                                                    "id": "677350209",
                                                    "speaker": "Congshen",
                                                    "text": "When you need to sleep, sleep. When you need to understand, understand."
                                                },
                                                {
                                                    "id": "677350210",
                                                    "speaker": "Congshen",
                                                    "text": "You should head back now. When the world ends, just go with it."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "677350208",
                                            "text": "And how could I understand that?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "677350204",
                            "text": "Yes, I have."
                        },
                        {
                            "id": "677350205",
                            "text": "No, I haven't."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6773503",
            "initDialog": "677350301",
            "dialogues": [
                {
                    "id": "677350301",
                    "speaker": "Player",
                    "text": "You're talking in riddles. I'm leaving. Goodbye."
                },
                {
                    "id": "677350302",
                    "speaker": "Congshen",
                    "text": "Go ahead."
                }
            ]
        }
    ]
}