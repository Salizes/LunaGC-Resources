                    "text": "Intel Exchange"
                }
            ]
        },
        {
            "talkId": "6700010",
            "initDialog": "670001001",
            "dialogues": [
                {
                    "id": "670001001",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Intel Exchange</color>"
                }
            ]
        },
        {
            "talkId": "6700011",
            "initDialog": "670001101",
            "dialogues": [
                {
                    "id": "670001101",
                    "speaker": "Katheryne",
                    "text": "Intel Exchange"
                },
                {
                    "id": "670001102",
                    "speaker": "Player",
                    "text": "(It seems only those associated with the \"Curatorium of Secrets\" can conduct exchanges...)"
                }
            ]
        },
        {
            "talkId": "6700012",
            "initDialog": "670001201",
            "dialogues": [
                {
                    "id": "670001201",
                    "speaker": "Katheryne",
                    "text": "Welcome to the Adventurers' Guild, My Lady. Is there something I can help you with?"
                }
            ]
        },
        {
            "talkId": "6700013",
            "initDialog": "670001301",
            "dialogues": [
                {
                    "id": "670001301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "670001302",
                    "speaker": "Katheryne",
                    "text": "Farewell, My Lady, and thank you for supporting the Adventurers' Guild."
                }
            ]
        },
        {
            "talkId": "7068807",
            "initDialog": "706880701",
            "dialogues": [
                {
                    "id": "706880701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Have you any awesome commissions for me?</color>"
                },
                {
                    "id": "706880702",
                    "speaker": "Katheryne",
                    "text": "You've come at just the right time. I have a handbook that the Guild would like to present to veteran adventurers such as yourself.",
                    "choices": [
                        {
                            "id": "706880703",
                            "text": "Could it be the Official Teyvat Cookbook?",
                            "response": [
                                {
                                    "id": "706880704",
                                    "speaker": "Katheryne",
                                    "text": "Unfortunately, it isn't."
                                },
                                {
                                    "id": "706880707",
                                    "speaker": "Katheryne",
                                    "text": "As you can see, this handbook contains information on powerful enemies worth facing."
                                },
                                {
                                    "id": "706880708",
                                    "speaker": "Katheryne",
                                    "text": "If you can make good use of it, I'm sure it will be of great help in your adventures. Of course, you're welcome to come back anytime if you need to check on any relevant information."
                                },
                                {
                                    "id": "706880709",
                                    "speaker": "Katheryne",
                                    "text": "I wish you success in your endeavors!"
                                }
                            ]
                        },
                        {
                            "id": "706880705",
                            "text": "Is it another new quest...?",
                            "response": [
                                {
                                    "id": "706880706",
                                    "speaker": "Katheryne",
                                    "text": "It's up to you whether you wish to take on the challenge."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "Katheryne",
                    "text": "Claim Daily Commission Reward"
                },
                {
                    "id": "201013602",
                    "speaker": "Katheryne",
                    "text": "I am sorry, but you have not yet completed enough commissions."
                }
            ]
        },
        {
            "talkId": "2010137",
