                    "text": "<color=#FFCC33FF>Claim Adventure Rank Rewards</color>"
                }
            ]
        },
        {
            "talkId": "6700004",
            "initDialog": "670000401",
            "dialogues": [
                {
                    "id": "670000401",
                    "speaker": "Player",
                    "text": "Hey there, Katheryne."
                },
                {
                    "id": "670000402",
                    "speaker": "Katheryne",
                    "text": "Great to see you here."
                },
                {
                    "id": "670000403",
                    "speaker": "Katheryne",
                    "text": "I am Katheryne, the receptionist of the Adventurers' Guild. My job is to provide the adventurers with quests and intelligence support."
                },
                {
                    "id": "670000404",
                    "speaker": "Katheryne",
                    "text": "Nod-Krai is a land full of opportunities. We hope your adventures here will be filled with excitement and fun."
                }
            ]
        },
        {
            "talkId": "6700005",
            "initDialog": "670000501",
            "dialogues": [
                {
                    "id": "670000501",
                    "speaker": "Player",
                    "text": "Tell me a bit about Nod-Krai..."
                },
                {
                    "id": "670000502",
                    "speaker": "Katheryne",
                    "text": "For adventurers, the vast lands of Snezhnaya should be a great place to show off their skills."
                },
                {
                    "id": "670000503",
                    "speaker": "Katheryne",
                    "text": "However, there have been many factions marshaling their forces at the border as of late. Please be careful when traveling around the area."
                }
            ]
        },
        {
            "talkId": "6700006",
            "initDialog": "670000601",
            "dialogues": [
                {
                    "id": "670000601",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "670000602",
                    "speaker": "Katheryne",
                    "text": "Farewell, Adventurer, and thank you for supporting the Adventurers' Guild."
                }
            ]
        },
        {
            "talkId": "6700007",
            "initDialog": "670000701",
            "dialogues": [
                {
                    "id": "670000701",
                    "speaker": "Katheryne",
                    "text": "Check Valiant Chronicles information"
                }
            ]
        },
        {
            "talkId": "6700008",
            "initDialog": "670000801",
            "dialogues": [
                {
                    "id": "670000801",
                    "speaker": "Katheryne",
                    "text": "<color=#FFCC33FF>Check Valiant Chronicles information</color>"
                }
            ]
        },
        {
