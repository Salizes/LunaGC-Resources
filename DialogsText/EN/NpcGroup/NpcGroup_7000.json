            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Claim Daily Commission Reward</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "Katheryne",
                    "text": "Thank you for completing today's commissions. Here is your reward."
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "Katheryne",
                    "text": "<color=#999999FF>Claim Daily Commission Reward</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "Katheryne",
                    "text": "You have already claimed today's reward. Please come back for more commissions tomorrow!"
                }
            ]
        },
