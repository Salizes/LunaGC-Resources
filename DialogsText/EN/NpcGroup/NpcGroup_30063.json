                                            "response": [
                                                {
                                                    "id": "400122705",
                                                    "speaker": "Klee",
                                                    "text": "#That big meanie must be a bad guy! {F#Miss}{M#Mr.} Honorary Knight must be careful."
                                                },
                                                {
                                                    "id": "400122706",
                                                    "speaker": "Klee",
