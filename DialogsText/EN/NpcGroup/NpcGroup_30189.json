{
    "groupId": "30189",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Mamoru": 13,
        "Player": 5
    },
    "talks": [
        {
            "talkId": "7268472",
            "initDialog": "726847201",
            "dialogues": [
                {
                    "id": "726847201",
                    "speaker": "Mamoru",
                    "text": "I'm Mamoru, the Arataki Drumalong Festival Atmosphere Ambassador. How may I help?"
                },
                {
                    "id": "726847202",
                    "speaker": "Mamoru",
                    "text": "You're asking what my job is?"
                },
                {
                    "id": "726847203",
                    "speaker": "Mamoru",
                    "text": "Well, as the atmosphere ambassador, my job is mainly to create a lively atmosphere and give all attendants the feeling of \"I'm so hyped I'm going out of my mind.\""
                },
                {
                    "id": "726847204",
                    "speaker": "Mamoru",
                    "text": "Do you feel that way?",
                    "choices": [
                        {
                            "id": "726847205",
                            "text": "Not even slightly.",
                            "response": [
                                {
                                    "id": "726847207",
                                    "speaker": "Mamoru",
                                    "text": "...Hey, don't say that!"
                                },
                                {
                                    "id": "726847208",
                                    "speaker": "Mamoru",
                                    "text": "That was really disheartening, it's like being punched in the gut! If that's how you feel... my job's meaningless, isn't it?"
                                },
                                {
                                    "id": "726847209",
                                    "speaker": "Mamoru",
                                    "text": "You are the boss's friend. Please, show me some support for his sake. I'm begging you, say the line!"
                                },
                                {
                                    "id": "726847210",
                                    "speaker": "Player",
                                    "text": "What line?"
                                },
                                {
                                    "id": "726847211",
                                    "speaker": "Mamoru",
                                    "text": "You know, \"I'm so hyped I'm going out of my mind.\"",
                                    "choices": [
                                        {
                                            "id": "726847212",
                                            "text": "I'm so hyped I'm going out of my mind.",
                                            "response": [
                                                {
                                                    "id": "726847213",
                                                    "speaker": "Mamoru",
                                                    "text": "Great! Awesome!"
                                                },
                                                {
                                                    "id": "726847214",
                                                    "speaker": "Mamoru",
                                                    "text": "This is the best recognition I could ask for!"
                                                },
                                                {
                                                    "id": "726847218",
                                                    "speaker": "Mamoru",
                                                    "text": "Come on, people! More music, more dancing, let's keep this party going!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726847215",
                                            "text": "I'm so... I'm so... I'm sorry, I just can't.",
                                            "response": [
                                                {
                                                    "id": "726847216",
                                                    "speaker": "Mamoru",
                                                    "text": "Ugh... fine. Well, I guess I should at least keep trying, seeing how everyone else in the gang is working hard trying to do their jobs, too..."
                                                },
                                                {
                                                    "id": "726847217",
                                                    "speaker": "Mamoru",
                                                    "text": "You can punch me in the gut, but I won't give up! Just like the boss says!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726847206",
                            "text": "Nowhere near."
                        }
                    ]
                }
            ]
        }
    ]
}