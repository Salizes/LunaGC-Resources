            "dialogues": [
                {
                    "id": "617700201",
                    "speaker": "Player",
                    "text": "Fire-Water?"
                },
                {
                    "id": "617700202",
                    "speaker": "Matthaus",
                    "text": "Heh, yeah! I just got back from a business trip to Snezhnaya and brought in a whole batch of the good stuff!"
                },
                {
                    "id": "617700203",
                    "speaker": "Matthaus",
                    "text": "It's got a strong kick, bold and fiery, but there's this nice hint of citrus and honey underneath..."
                },
                {
                    "id": "617700204",
                    "speaker": "Matthaus",
                    "text": "Even if you're not much of a drinker, it makes a great gift for friends! Not to mention, they're top-quality stuff, all crafted by the fae in Novokitezhgrad. What do you think? Want to give it a try?"
                }
            ]
        },
        {
            "talkId": "6177003",
            "initDialog": "617700301",
            "dialogues": [
                {
                    "id": "617700301",
                    "speaker": "Player",
                    "text": "Maybe another time."
                },
                {
                    "id": "617700302",
                    "speaker": "Matthaus",
                    "text": "Haha, come back anytime you feel like it!"
                }
            ]
        }
