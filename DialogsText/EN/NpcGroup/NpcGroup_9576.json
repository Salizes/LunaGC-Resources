        {
            "talkId": "6957604",
            "initDialog": "695760401",
            "dialogues": [
                {
                    "id": "695760401",
                    "speaker": "Rosaria",
                    "text": "I'll let you off the hook this time, but if you lose again, you owe me a glass of Dandelion Wine."
                }
            ]
        },
        {
            "talkId": "6957605",
            "initDialog": "695760501",
            "dialogues": [
                {
                    "id": "695760501",
                    "speaker": "Rosaria",
                    "text": "Only took my eye off the prize for a second, and now it's game over... Hmph, impressive. Guess that means I owe you a drink. What'll it be?"
                }
            ]
        },
        {
            "talkId": "6957606",
            "initDialog": "695760601",
            "dialogues": [
                {
                    "id": "695760601",
                    "speaker": "Rosaria",
                    "text": "Oh, you want to play cards? Fine by me. We're not in the Cathedral, and I'm off the clock, anyway."
                }
            ]
        },
        {
            "talkId": "6957608",
            "initDialog": "695760801",
            "dialogues": [
                {
                    "id": "695760801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
