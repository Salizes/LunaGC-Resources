        {
            "talkId": "6957610",
            "initDialog": "695761001",
            "dialogues": [
                {
                    "id": "695761001",
                    "speaker": "Rosaria",
                    "text": "How did I get so good? Just a little hobby of mine. Being a Sister can be pretty dull, so I've got to keep myself busy somehow."
                }
            ]
        },
        {
            "talkId": "6957611",
            "initDialog": "695761101",
            "dialogues": [
                {
                    "id": "695761101",
                    "speaker": "Rosaria",
                    "text": "Mm, not bad at all. Didn't realize you were so good at this... We should play together more often."
                }
            ]
        },
        {
            "talkId": "6957612",
            "initDialog": "695761201",
            "dialogues": [
                {
                    "id": "695761201",
                    "speaker": "Rosaria",
                    "text": "Fancy another match? Who lost last time? Usually, the loser has to shuffle... Eh, I'll just go ahead. C'mon, take a seat."
                }
            ]
        },
        {
