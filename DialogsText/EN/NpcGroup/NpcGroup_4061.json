                {
                    "id": "640610101",
                    "speaker": "Kourosh",
                    "text": "*sob* The manager scolded me again today..."
                }
            ]
        },
        {
            "talkId": "6406102",
            "initDialog": "640610201",
            "dialogues": [
                {
                    "id": "640610201",
                    "speaker": "Player",
                    "text": "Are you alright?"
                },
                {
                    "id": "640610202",
                    "speaker": "Kourosh",
                    "text": "Not really, but I'm used to it."
                },
                {
                    "id": "640610203",
                    "speaker": "Kourosh",
                    "text": "It's practice. Lessons from Mr. Sheikh Zubayr, then more practice. Rinse and repeat."
                },
                {
                    "id": "640610204",
                    "speaker": "Kourosh",
                    "text": "I thought about giving up, but then I remembered how, despite all his criticisms, Mr. Zubayr never told me to quit."
                },
                {
                    "id": "640610205",
                    "speaker": "Kourosh",
                    "text": "That means there's still hope for me, right?"
                },
                {
                    "id": "640610206",
                    "speaker": "Kourosh",
                    "text": "But have I made any progress?"
                }
            ]
        },
        {
            "talkId": "6406103",
            "initDialog": "640610301",
            "dialogues": [
                {
                    "id": "640610301",
                    "speaker": "Player",
                    "text": "You can do it!"
                },
                {
                    "id": "640610302",
                    "speaker": "Kourosh",
                    "text": "Thanks. I won't give up."
                }
            ]
        }
    ]
}