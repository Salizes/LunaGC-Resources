    "talks": [
        {
            "talkId": "6600201",
            "initDialog": "660020101",
            "dialogues": [
                {
                    "id": "660020101",
                    "speaker": "Ezana",
                    "text": "Welcome."
                }
            ]
        },
        {
            "talkId": "6600202",
            "initDialog": "660020201",
            "dialogues": [
                {
                    "id": "660020201",
                    "speaker": "Player",
                    "text": "What is this place?"
                },
                {
                    "id": "660020202",
                    "speaker": "Ezana",
                    "text": "Here, we sell masks in the styles of all the different tribes. Let me know if you see anything you like the look of."
                },
                {
                    "id": "660020203",
                    "speaker": "Ezana",
                    "text": "In the extremely unlikely event that none of our pre-made masks take your fancy, we also have materials for you to make your own."
                },
                {
                    "id": "660020204",
                    "speaker": "Ezana",
                    "text": "If you make one yourself, you'll only be charged the cost of the materials."
                }
            ]
        },
        {
            "talkId": "6600203",
            "initDialog": "660020301",
            "dialogues": [
                {
                    "id": "660020301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "660020302",
                    "speaker": "Ezana",
                    "text": "Goodbye."
                }
            ]
        },
        {
            "talkId": "6600204",
            "initDialog": "660020401",
            "dialogues": [
                {
                    "id": "660020401",
                    "speaker": "Player",
                    "text": "When do you usually wear a mask?"
                },
                {
                    "id": "660020402",
                    "speaker": "Ezana",
                    "text": "You can wear a mask whenever you feel like it."
                },
                {
                    "id": "660020403",
                    "speaker": "Ezana",
                    "text": "But normally, you'll see more people wearing them on holidays."
                },
                {
                    "id": "660020404",
                    "speaker": "Ezana",
                    "text": "Also, when there's a competition, many people wear the masks of the tribe they support as a way of cheering on their warriors."
                },
                {
                    "id": "660020405",
                    "speaker": "Ezana",
                    "text": "But normally, you can just wear it as a fancy accessory."
                }
            ]
        },
        {
            "talkId": "6600205",
            "initDialog": "660020501",
            "dialogues": [
                {
                    "id": "660020501",
                    "speaker": "Player",
                    "text": "I'd like a Flying Lavender Melon mask, then."
                },
                {
                    "id": "660020502",
                    "speaker": "Ezana",
                    "text": "...Huh? What's that?"
                }
            ]
        }
    ]
}