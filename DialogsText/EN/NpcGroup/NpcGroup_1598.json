    "talks": [
        {
            "talkId": "7093601",
            "initDialog": "709360101",
            "dialogues": [
                {
                    "id": "709360101",
                    "speaker": "Player",
                    "text": "Having fun on the beach?"
                },
                {
                    "id": "709360102",
                    "speaker": "Will",
                    "text": "Yep! The scenery is soooo different from Mondstadt."
                },
                {
                    "id": "709360103",
                    "speaker": "Will",
                    "text": "I even caught a fish! Fish skin is slippery, so they're super hard to catch... Well, harder than catching crabs anyway. That's what Jill does."
                },
                {
                    "id": "709360104",
                    "speaker": "Will",
                    "text": "But anyway, I don't have a bowl to put this fish in. So why don't you take it?"
                }
            ]
        },
        {
            "talkId": "6159801",
            "initDialog": "615980101",
            "dialogues": [
                {
                    "id": "615980101",
                    "speaker": "Will",
                    "text": "Huh? Hi!"
                }
            ]
        },
        {
            "talkId": "6159802",
            "initDialog": "615980201",
            "dialogues": [
                {
                    "id": "615980201",
                    "speaker": "Player",
                    "text": "You kids be careful playing on the beach, now."
                },
                {
                    "id": "615980202",
                    "speaker": "Will",
                    "text": "I'll be fine!"
                },
                {
                    "id": "615980203",
                    "speaker": "Will",
                    "text": "But Mr. Guard keeps following us and Jill's scared to death."
                },
                {
                    "id": "615980204",
                    "speaker": "Will",
                    "text": "D'you think he's one of those, y'know... bad men who... who... make little kids... learn to read and write, and give them too much homework?"
                },
                {
                    "id": "615980205",
                    "speaker": "Will",
                    "text": "We were gonna go and play with Ms. Edith at Windrise, but now we're stuck here hiding..."
                }
            ]
        },
        {
            "talkId": "6159803",
            "initDialog": "615980301",
            "dialogues": [
                {
                    "id": "615980301",
                    "speaker": "Player",
                    "text": "Know much about Falcon Coast?"
                },
                {
                    "id": "615980302",
                    "speaker": "Will",
                    "text": "I love Falcon Coast!"
                },
                {
                    "id": "615980303",
                    "speaker": "Will",
                    "text": "Granny always takes me there to play, ever since I was teeny tiny."
                },
                {
                    "id": "615980304",
                    "speaker": "Will",
                    "text": "Wow... I love your hair! It looks all soft like the nicest sand on the beach! Can I touch it?"
                }
            ]
        },
        {
            "talkId": "6159804",
            "initDialog": "615980401",
            "dialogues": [
                {
                    "id": "615980401",
                    "speaker": "Player",
                    "text": "Be careful not to get lost."
                },
                {
                    "id": "615980402",
                    "speaker": "Will",
                    "text": "Hee-hee!"
                }
            ]
        }
    ]
}