            "dialogues": [
                {
                    "id": "663450101",
                    "speaker": "Runtuma",
                    "text": "Oh, it's you two, skillful travelers from afar! Have you tried making Magma Eggs yourselves?",
                    "choices": [
                        {
                            "id": "663450102",
                            "text": "I did! It was a super energizing dish!",
                            "response": [
                                {
                                    "id": "663450103",
                                    "speaker": "Runtuma",
                                    "text": "Right? That's the power of volcanic goodness packed into every bite!"
                                },
                                {
                                    "id": "663450104",
                                    "speaker": "Runtuma",
                                    "text": "They say you'll get stronger and stronger if you eat 'em every day!"
                                }
                            ]
                        },
                        {
                            "id": "663450105",
                            "text": "I overcooked mine... almost passed out after eating it.",
                            "response": [
                                {
                                    "id": "663450106",
                                    "speaker": "Runtuma",
                                    "text": "Haha, that taste really sticks with you, huh?"
                                },
                                {
                                    "id": "663450107",
                                    "speaker": "Runtuma",
                                    "text": "Honestly, it's not that bad once you get used to it."
                                }
                            ]
                        },
                        {
                            "id": "663450109",
                            "text": "Not yet. Maybe next time.",
                            "response": [
                                {
                                    "id": "663450110",
                                    "speaker": "Runtuma",
                                    "text": "No worries, that's fine. Hope the rest of your journey goes smoothly!"
