    "talks": [
        {
            "talkId": "4111542",
            "initDialog": "411154201",
            "dialogues": [
                {
                    "id": "411154201",
                    "speaker": "Yuhua",
                    "text": "Welcome, dear guest, please do come in. It may not be wise to stay out for too long under these circumstances..."
                }
            ]
        },
        {
            "talkId": "6220601",
            "initDialog": "622060101",
            "dialogues": [
                {
                    "id": "622060101",
                    "speaker": "Yuhua",
                    "text": "Greetings! Are you in need of a meal, or a room for the night?"
                }
            ]
        },
        {
            "talkId": "6220602",
            "initDialog": "622060201",
            "dialogues": [
                {
                    "id": "622060201",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "622060202",
                    "speaker": "Yuhua",
                    "text": "I am Yuhua, a waitress here at the Wangshu Inn."
                },
                {
                    "id": "622060203",
                    "speaker": "Yuhua",
                    "text": "Nothing suspicious about me whatsoever.",
                    "choices": [
                        {
                            "id": "622060204",
                            "text": "What's your role here?",
                            "response": [
                                {
                                    "id": "622060205",
                                    "speaker": "Yuhua",
                                    "text": "I am a waitress at this establishment, or a server if you will. I'm afraid there's not much more to say than that."
                                }
                            ]
                        },
                        {
                            "id": "622060206",
                            "text": "Tell me about the inn.",
                            "response": [
                                {
                                    "id": "622060207",
                                    "speaker": "Yuhua",
                                    "text": "The Wangshu Inn is situated in a convenient location on one of the main thoroughfares that runs between Mondstadt and Liyue. Boasting pleasant accommodation at an affordable price, there is simply no better choice for passing travelers who need somewhere to stay the night."
                                },
                                {
                                    "id": "622060208",
                                    "speaker": "Yuhua",
                                    "text": "Nothing suspicious about it whatsoever. Ahahahaha."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220603",
            "initDialog": "622060301",
            "dialogues": [
                {
                    "id": "622060301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "622060302",
                    "speaker": "Yuhua",
                    "text": "You are always welcome at the Wangshu Inn. Come by any time!"
                }
            ]
        },
        {
            "talkId": "6220604",
            "initDialog": "622060401",
            "dialogues": [
                {
                    "id": "622060401",
                    "speaker": "Yuhua",
                    "text": "Greetings! Are you in need of a meal, or a room for the night?"
                }
            ]
        },
        {
            "talkId": "6220605",
            "initDialog": "622060501",
            "dialogues": [
                {
                    "id": "622060501",
                    "speaker": "Player",
                    "text": "Can I ask who you are?"
                },
                {
                    "id": "622060502",
                    "speaker": "Yuhua",
                    "text": "I am Xiuhua, a staff member here at the Wangshu Inn."
                },
                {
                    "id": "622060503",
                    "speaker": "Yuhua",
                    "text": "Just a regular, inconspicuous staff member.",
                    "choices": [
                        {
                            "id": "622060504",
                            "text": "What's your story?",
                            "response": [
                                {
                                    "id": "622060505",
                                    "speaker": "Yuhua",
                                    "text": "You, you wanna know about what I do? ...Have I really been found out... Oh! Ah, nothing."
                                }
                            ]
                        },
                        {
                            "id": "622060506",
                            "text": "Tell me about Wangshu Inn.",
                            "response": [
                                {
                                    "id": "622060507",
                                    "speaker": "Yuhua",
                                    "text": "Th—The inn... could she have let slip about our mission from the Qixing? What? No, I didn't say anything..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220606",
            "initDialog": "622060601",
            "dialogues": [
                {
                    "id": "622060601",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "622060602",
                    "speaker": "Yuhua",
                    "text": "Wangshu Inn always welcomes you. Come again soon!"
                }
            ]
        }
    ]
}