    "talks": [
        {
            "talkId": "6306401",
            "initDialog": "630640101",
            "dialogues": [
                {
                    "id": "630640101",
                    "speaker": "Takeshi",
                    "text": "This place is off-limits. No unauthorized access for outlanders."
                }
            ]
        },
        {
            "talkId": "6306402",
            "initDialog": "630640201",
            "dialogues": [
                {
                    "id": "630640201",
                    "speaker": "Player",
                    "text": "You are..."
                },
                {
                    "id": "630640202",
                    "speaker": "Takeshi",
                    "text": "I am a member of the Okuzumeshuu. I only take orders from the Almighty Shogun."
                }
            ]
        },
        {
            "talkId": "6306403",
            "initDialog": "630640301",
            "dialogues": [
                {
                    "id": "630640301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "630640302",
                    "speaker": "Takeshi",
                    "text": "Yes, depart now."
                }
            ]
        },
        {
            "talkId": "6306404",
            "initDialog": "630640401",
            "dialogues": [
                {
                    "id": "630640401",
                    "speaker": "Player",
                    "text": "\"Okuzumeshuu\"?"
                },
                {
                    "id": "630640402",
                    "speaker": "Takeshi",
                    "text": "Generally speaking, we are the Almighty Shogun's bodyguards."
                },
                {
                    "id": "630640403",
                    "speaker": "Takeshi",
                    "text": "The reason for our existence is to make sure that the Almighty Shogun will always have a force by her side that she can always trust and deploy."
                },
                {
                    "id": "630640404",
                    "speaker": "Takeshi",
                    "text": "Loyalty is of the utmost importance here."
                }
            ]
        },
        {
            "talkId": "6306405",
            "initDialog": "630640501",
            "dialogues": [
                {
                    "id": "630640501",
                    "speaker": "Player",
                    "text": "Even the Shogun requires protection?"
                },
                {
                    "id": "630640502",
                    "speaker": "Takeshi",
                    "text": "Of course the Almighty Shogun doesn't need people like us for protection. I'm just here to protect the regular folks."
                },
                {
                    "id": "630640503",
                    "speaker": "Takeshi",
                    "text": "If someone dares to intrude into the forbidden zone, our Almighty Shogun wouldn't care what reasons they have."
                }
            ]
        }
    ]
}