    "talks": [
        {
            "talkId": "6748701",
            "initDialog": "674870101",
            "dialogues": [
                {
                    "id": "674870101",
                    "speaker": "Kira",
                    "text": "Passengers are requested to enter the station in an orderly manner. Security checks may be conducted at staff discretion."
                }
            ]
        },
        {
            "talkId": "6748702",
            "initDialog": "674870201",
            "dialogues": [
                {
                    "id": "674870201",
                    "speaker": "Player",
                    "text": "Inspection?"
                },
                {
                    "id": "674870202",
                    "speaker": "Kira",
                    "text": "Under the new regulations, we're authorized to conduct random checks on anyone who is considered a potential risk. That may include checking your luggage or asking a few questions about you."
                },
                {
                    "id": "674870203",
                    "speaker": "Gerard",
                    "text": "If you have any concerns, please feel free to direct them to the Transport Bureau."
                }
            ]
        },
        {
            "talkId": "6748703",
            "initDialog": "674870301",
            "dialogues": [
                {
                    "id": "674870301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "674870302",
                    "speaker": "Kira",
                    "text": "See you."
                }
            ]
        },
        {
            "talkId": "6748704",
            "initDialog": "674870401",
            "dialogues": [
                {
                    "id": "674870401",
                    "speaker": "Player",
                    "text": "\"New regulations\"?"
                },
                {
                    "id": "674870402",
                    "speaker": "Kira",
                    "text": "Correct. They're intended to prevent any disruptions and thus keep Project Stuzha on schedule."
                }
            ]
        },
        {
            "talkId": "6748705",
            "initDialog": "674870501",
            "dialogues": [
                {
                    "id": "674870501",
                    "speaker": "Player",
                    "text": "What makes someone a \"potential risk,\" exactly?"
                },
                {
                    "id": "674870502",
                    "speaker": "Kira",
                    "text": "...As you can see, any passenger entering the station could fall under that category. If you have any questions about our screening criteria, please feel free to direct them to the Transport Bureau."
                }
            ]
        },
        {
            "talkId": "6748706",
            "initDialog": "674870601",
            "dialogues": [
                {
                    "id": "674870601",
                    "speaker": "Player",
                    "text": "What kind of disruptions?"
                },
                {
                    "id": "674870602",
                    "speaker": "Kira",
                    "text": "...Regardless, these regulations were issued by the Transport Bureau to protect Snezhnaya. If you have any questions regarding policy, please feel free to direct them to the bureau."
                }
            ]
        },
        {
            "talkId": "6748707",
            "initDialog": "674870701",
            "dialogues": [
                {
                    "id": "674870701",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "674870702",
                    "speaker": "Paimon",
                    "text": ""
                }
            ]
        }
    ]
}