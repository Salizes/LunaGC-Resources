{
    "groupId": "7038",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Koloman": 9,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6703801",
            "initDialog": "670380101",
            "dialogues": [
                {
                    "id": "670380101",
                    "speaker": "Koloman",
                    "text": "Getting home from here takes forever. It's always such a hassle... Half my workday, every day, is my commute!"
                }
            ]
        },
        {
            "talkId": "6703802",
            "initDialog": "670380201",
            "dialogues": [
                {
                    "id": "670380201",
                    "speaker": "Player",
                    "text": "That's rough."
                },
                {
                    "id": "670380202",
                    "speaker": "Koloman",
                    "text": "Sure is. Doesn't even pay that well, and I've got to leave before the sun comes up, and get home long after it sets. Whether I leave my house or go back into it, my kid's fast asleep..."
                },
                {
                    "id": "670380203",
                    "speaker": "Koloman",
                    "text": "Maybe in a few years, I'll find that I've raised a child who doesn't remember my face at all..."
                }
            ]
        },
        {
            "talkId": "6703803",
            "initDialog": "670380301",
            "dialogues": [
                {
                    "id": "670380301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "670380302",
                    "speaker": "Koloman",
                    "text": "Goodbye... Ugh, I hope I can get home earlier tomorrow..."
                }
            ]
        },
        {
            "talkId": "6703804",
            "initDialog": "670380401",
            "dialogues": [
                {
                    "id": "670380401",
                    "speaker": "Player",
                    "text": "Back in the day, you..."
                },
                {
                    "id": "670380402",
                    "speaker": "Koloman",
                    "text": "...Yeah. That wasn't a good way to make a living, either. Used to think that life was all about having a thrill. Easy to think that, until a comrade dies before your eyes... Never mind. The past should stay in the past."
                },
                {
                    "id": "670380403",
                    "speaker": "Koloman",
                    "text": "Nowadays, all I want to do is live with my family in peace."
                }
            ]
        },
        {
            "talkId": "6703805",
            "initDialog": "670380501",
            "dialogues": [
                {
                    "id": "670380501",
                    "speaker": "Koloman",
                    "text": "Duel"
                }
            ]
        },
        {
            "talkId": "6703806",
            "initDialog": "670380601",
            "dialogues": [
                {
                    "id": "670380601",
                    "speaker": "Koloman",
                    "text": "Wait, did I actually win?"
                }
            ]
        },
        {
            "talkId": "6703807",
            "initDialog": "670380701",
            "dialogues": [
                {
                    "id": "670380701",
                    "speaker": "Koloman",
                    "text": "Hmm, impressive. I never knew that card could be used that way..."
                }
            ]
        }
    ]
}