    "talks": [
        {
            "talkId": "6905301",
            "initDialog": "690530101",
            "dialogues": [
                {
                    "id": "690530101",
                    "speaker": "Sayu",
                    "text": "#...*yawn*, {NICKNAME}."
                },
                {
                    "id": "690530102",
                    "speaker": "Sayu",
                    "text": "... Hi..."
                }
            ]
        },
        {
            "talkId": "6905302",
            "initDialog": "690530201",
            "dialogues": [
                {
                    "id": "690530201",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                },
                {
                    "id": "690530202",
                    "speaker": "Sayu",
                    "text": "Well, I slept very well."
                },
                {
                    "id": "690530203",
                    "speaker": "Sayu",
                    "text": "I don't have to worry about being called to work all of a sudden."
                },
                {
                    "id": "690530204",
                    "speaker": "Sayu",
                    "text": "Even if I sleep all the time, it's okay.",
                    "choices": [
                        {
                            "id": "690530205",
                            "text": "It's great that you like it here.",
                            "response": [
                                {
                                    "id": "690530206",
                                    "speaker": "Sayu",
                                    "text": "Of course. And there are no wild tanuki here."
                                },
                                {
                                    "id": "690530207",
                                    "speaker": "Sayu",
                                    "text": "I like this place a lot."
                                }
                            ]
                        },
                        {
                            "id": "690530208",
                            "text": "You can come more often.",
                            "response": [
                                {
                                    "id": "690530209",
                                    "speaker": "Sayu",
                                    "text": "Okay, thank you."
                                },
                                {
                                    "id": "690530210",
                                    "speaker": "Sayu",
                                    "text": "Then this will be my first choice when I skip... I mean, when I have a day off from work."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905303",
            "initDialog": "690530301",
            "dialogues": [
                {
                    "id": "690530301",
                    "speaker": "Player",
                    "text": "Do you want to chat?"
                },
                {
                    "id": "690530302",
                    "speaker": "Sayu",
                    "text": "Sure."
                },
                {
                    "id": "690530303",
                    "speaker": "Sayu",
                    "text": "I'll try to stay awake...",
                    "choices": [
                        {
                            "id": "690530304",
                            "text": "Did you get enough sleep?",
                            "response": [
                                {
                                    "id": "690530305",
                                    "speaker": "Sayu",
                                    "text": "Now that you ask, I'm getting a little sleepy again..."
                                },
                                {
                                    "id": "690530306",
                                    "speaker": "Sayu",
                                    "text": "... *yawn*"
                                },
                                {
                                    "id": "690530307",
                                    "speaker": "Sayu",
                                    "text": "No, I have to power through it..."
                                },
                                {
                                    "id": "690530311",
                                    "speaker": "Sayu",
                                    "text": "If I fall asleep while I'm with you... I'll be wasting precious time."
                                },
                                {
                                    "id": "690530312",
                                    "speaker": "Player",
                                    "text": "What about your work?"
                                },
                                {
                                    "id": "690530313",
                                    "speaker": "Sayu",
                                    "text": "It's okay..."
                                },
                                {
                                    "id": "690530314",
                                    "speaker": "Sayu",
                                    "text": "My work is just a bunch of meaningless little chores."
                                },
                                {
                                    "id": "690530315",
                                    "speaker": "Sayu",
                                    "text": "It's not as meaningful as staying here."
                                },
                                {
                                    "id": "690530316",
                                    "speaker": "Sayu",
                                    "text": "I can sleep, and I can chat with you..."
                                }
                            ]
                        },
                        {
                            "id": "690530308",
                            "text": "If you're sleepy, go lie down.",
                            "response": [
                                {
                                    "id": "690530309",
                                    "speaker": "Sayu",
                                    "text": "Hmm, I'm okay..."
                                },
                                {
                                    "id": "690530310",
                                    "speaker": "Sayu",
                                    "text": "*yawn*... I don't want to sleep yet..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905304",
            "initDialog": "690530401",
            "dialogues": [
                {
                    "id": "690530401",
                    "speaker": "Player",
                    "text": "Anything you want to do?"
                },
                {
                    "id": "690530402",
                    "speaker": "Sayu",
                    "text": "If you have the time..."
                },
                {
                    "id": "690530403",
                    "speaker": "Sayu",
                    "text": "Would you like to plant a tree with me?"
                },
                {
                    "id": "690530404",
                    "speaker": "Player",
                    "text": "Plant a tree?"
                },
                {
                    "id": "690530405",
                    "speaker": "Sayu",
                    "text": "Yeah, let's plant a big one!"
                },
                {
                    "id": "690530406",
                    "speaker": "Sayu",
                    "text": "Bigger than all those trees outside."
                },
                {
                    "id": "690530407",
                    "speaker": "Sayu",
                    "text": "I can teach you some ninjutsu using leaves."
                },
                {
                    "id": "690530408",
                    "speaker": "Sayu",
                    "text": "Oh, and they are all escape techniques..."
                },
                {
                    "id": "690530409",
                    "speaker": "Sayu",
                    "text": "Um, because escaping is very important! Especially when going up against really strong enemies!"
                },
                {
                    "id": "690530410",
                    "speaker": "Sayu",
                    "text": "I don't want to see you get hurt..."
                },
                {
                    "id": "690530411",
                    "speaker": "Player",
                    "text": "Then I'll be counting on you to teach me."
                },
                {
                    "id": "690530412",
                    "speaker": "Sayu",
                    "text": "No problem."
                },
                {
                    "id": "690530413",
                    "speaker": "Sayu",
                    "text": "After that, we can climb up the tree for a rest."
                },
                {
                    "id": "690530414",
                    "speaker": "Sayu",
                    "text": "Sitting on the trunk, enjoying the wind..."
                },
                {
                    "id": "690530415",
                    "speaker": "Sayu",
                    "text": "*yawn*... Just thinking about it... makes me a little sleepy.",
                    "choices": [
                        {
                            "id": "690530416",
                            "text": "Good night, Sayu.",
                            "response": [
                                {
                                    "id": "690530418",
                                    "speaker": "Sayu",
                                    "text": "#Likewise, {NICKNAME}."
                                },
                                {
                                    "id": "690530419",
                                    "speaker": "Sayu",
                                    "text": "*yawn*...I hope I dream of you every time I fall asleep..."
                                }
                            ]
                        },
                        {
                            "id": "690530417",
                            "text": "Sweet dreams, Sayu."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905305",
            "initDialog": "690530501",
            "dialogues": [
                {
                    "id": "690530501",
                    "speaker": "Player",
                    "text": "Good morning."
                },
                {
                    "id": "690530502",
                    "speaker": "Sayu",
                    "text": "...Morning? It's morning already?"
                },
                {
                    "id": "690530503",
                    "speaker": "Sayu",
                    "text": "Umm, I'm still sleepy."
                }
            ]
        },
        {
            "talkId": "6905306",
            "initDialog": "690530601",
            "dialogues": [
                {
                    "id": "690530601",
                    "speaker": "Player",
                    "text": "Good night, Sayu."
                },
                {
                    "id": "690530602",
                    "speaker": "Sayu",
                    "text": "#Good night, {NICKNAME}."
                },
                {
                    "id": "690530603",
                    "speaker": "Sayu",
                    "text": "I hope you sleep just as soundly as I do."
                }
            ]
        },
        {
            "talkId": "6905307",
            "initDialog": "690530701",
            "dialogues": [
                {
                    "id": "690530701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                }
            ]
        },
        {
            "talkId": "6905308",
            "initDialog": "690530801",
            "dialogues": [
                {
                    "id": "690530801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Do you want to chat?</color>"
                }
            ]
        },
        {
            "talkId": "6905309",
            "initDialog": "690530901",
            "dialogues": [
                {
                    "id": "690530901",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Anything you want to do?</color>"
                }
            ]
        },
        {
            "talkId": "6905310",
            "initDialog": "690531001",
            "dialogues": [
                {
                    "id": "690531001",
                    "speaker": "Sayu",
                    "text": "Seems like this would make a good safehouse."
                },
                {
                    "id": "690531002",
                    "speaker": "Sayu",
                    "text": "Y'know, somewhere where it's safe to snooze away undetected."
                },
                {
                    "id": "690531003",
                    "speaker": "Sayu",
                    "text": "I really like it here. Thanks!"
                }
            ]
        },
        {
            "talkId": "6905311",
            "initDialog": "690531101",
            "dialogues": [
                {
                    "id": "690531101",
                    "speaker": "Sayu",
                    "text": "The terrain in this village is pretty complex. I definitely wouldn't get found if I took a nap here."
                },
                {
                    "id": "690531102",
                    "speaker": "Sayu",
                    "text": "The buildings are just the right height, too. I should be able to practice my escape techniques..."
                },
                {
                    "id": "690531103",
                    "speaker": "Sayu",
                    "text": "Ah, this place is so great..."
                }
            ]
        }
    ]
}