    "talks": [
        {
            "talkId": "6758401",
            "initDialog": "675840101",
            "dialogues": [
                {
                    "id": "675840101",
                    "speaker": "Zhemchuzhina",
                    "text": "I wonder what they're saying to each other..."
                }
            ]
        },
        {
            "talkId": "6758402",
            "initDialog": "675840201",
            "dialogues": [
                {
                    "id": "675840201",
                    "speaker": "Player",
                    "text": "What are you looking at?"
                },
                {
                    "id": "675840202",
                    "speaker": "Zhemchuzhina",
                    "text": "Shh... I'm watching the dogs chat."
                },
                {
                    "id": "675840203",
                    "speaker": "Zhemchuzhina",
                    "text": "Alyosha told me that dogs are really smart, and I guess they speak a language of their own."
                },
                {
                    "id": "675840204",
                    "speaker": "Zhemchuzhina",
                    "text": "I want to learn it too, so I can talk to them."
                }
            ]
        },
        {
            "talkId": "6758403",
            "initDialog": "675840301",
            "dialogues": [
                {
                    "id": "675840301",
                    "speaker": "Player",
                    "text": "Where are your parents?"
                },
                {
                    "id": "675840302",
                    "speaker": "Zhemchuzhina",
                    "text": "My dad is over there... probably drunk out of his mind again. If he'd just drink a little less, maybe Mom wouldn't have left."
                },
                {
                    "id": "675840303",
                    "speaker": "Zhemchuzhina",
                    "text": "That's why I really want a hound of my own, so I can hunt and support the family just like Brother Alyosha. You can't count on Dad for anything anyway."
                },
                {
                    "id": "675840304",
                    "speaker": "Zhemchuzhina",
                    "text": "Once I've saved up enough Mora, I'm going to hire a doctor to help him quit drinking."
                }
            ]
        },
