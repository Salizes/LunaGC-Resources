{
    "groupId": "7566",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Lugovskoy": 8,
        "Paimon": 10,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6756601",
            "initDialog": "675660101",
            "dialogues": [
                {
                    "id": "675660101",
                    "speaker": "Lugovskoy",
                    "text": "Careful, now... Come on over slowly. Wouldn't want to upset my friend over here..."
                }
            ]
        },
        {
            "talkId": "6756602",
            "initDialog": "675660201",
            "dialogues": [
                {
                    "id": "675660201",
                    "speaker": "Player",
                    "text": "Did you tame this bear?"
                },
                {
                    "id": "675660202",
                    "speaker": "Lugovskoy",
                    "text": "Ah... The bond between caregiver and creature isn't that simple, little one. In the eyes of many, I am the one who raises this beast..."
                },
                {
                    "id": "675660203",
                    "speaker": "Lugovskoy",
                    "text": "But perhaps to him, he is the one looking after me... After all, when dealing with scoundrels, he proves far more reliable than any hound."
                }
            ]
        },
        {
            "talkId": "6756603",
            "initDialog": "675660301",
            "dialogues": [
                {
                    "id": "675660301",
                    "speaker": "Player",
                    "text": "So you are..."
                },
                {
                    "id": "675660302",
                    "speaker": "Lugovskoy",
                    "text": "A hunter... Back then, I was tracking a bear deep in the woods. I fought bitterly to bring the beast down, but when I approached the body, I found she was a mother. And her cub..."
                },
                {
                    "id": "675660303",
                    "speaker": "Lugovskoy",
                    "text": "Well, look at him now. He was just a tiny thing back then."
                },
                {
                    "id": "675660304",
                    "speaker": "Lugovskoy",
                    "text": "It's our tradition to bring him back. I took his mother's life, after all... So perhaps when I grow a bit older, when I'm too frail to even pull a trigger..."
                },
                {
                    "id": "675660305",
                    "speaker": "Lugovskoy",
                    "text": "He will turn on me and devour me. Just like the old saying goes... \"He who hunts the bear shall meet his end in its jaws.\""
                }
            ]
        },
        {
            "talkId": "6756604",
            "initDialog": "675660401",
            "dialogues": [
                {
                    "id": "675660401",
                    "speaker": "Player",
                    "text": "See you later!"
                },
                {
                    "id": "675660402",
                    "speaker": "Lugovskoy",
                    "text": "See you. Watch your step, though. You don't want to step on his paws..."
                }
            ]
        },
        {
