        {
            "talkId": "7093501",
            "initDialog": "709350101",
            "dialogues": [
                {
                    "id": "709350101",
                    "speaker": "Player",
                    "text": "So what do you like?"
                },
                {
                    "id": "709350102",
                    "speaker": "Jill",
                    "text": "Crabs, obviously. Don't you think it's cute, how they walk sideways?"
                },
                {
                    "id": "709350103",
                    "speaker": "Jill",
                    "text": "And they're even harder to catch than fish! Hey, since you're so interested, you might as well take 'em. Here."
                },
                {
                    "id": "709350104",
                    "speaker": "Jill",
                    "text": "I can always catch more, it's no big deal."
                }
            ]
        },
        {
            "talkId": "6159701",
            "initDialog": "615970101",
            "dialogues": [
                {
                    "id": "615970101",
                    "speaker": "Jill",
                    "text": "Hi...? Is something wrong?"
                }
            ]
        },
        {
            "talkId": "6159702",
            "initDialog": "615970201",
            "dialogues": [
                {
                    "id": "615970201",
                    "speaker": "Player",
                    "text": "Found any nice shells on the beach?"
                },
                {
                    "id": "615970202",
                    "speaker": "Jill",
                    "text": "Er... Sorry, I don't really like shells."
                }
            ]
        },
        {
            "talkId": "6159703",
            "initDialog": "615970301",
            "dialogues": [
                {
                    "id": "615970301",
                    "speaker": "Player",
                    "text": "What are you hanging out here for?"
                },
                {
                    "id": "615970302",
                    "speaker": "Jill",
                    "text": "Can you see Mr. Guard over there?"
                },
                {
                    "id": "615970303",
                    "speaker": "Jill",
                    "text": "Me and Will wanna go and play with Ms. Edith at Windrise..."
                },
                {
                    "id": "615970304",
                    "speaker": "Jill",
                    "text": "But Mr. Guard keeps following us and we can't get rid of him. I'm a bit scared, he looks like a bad guy."
                },
                {
                    "id": "615970305",
                    "speaker": "Jill",
                    "text": "That's why we ended up here, because we're trying to run away from him."
                }
            ]
        },
        {
            "talkId": "6159704",
            "initDialog": "615970401",
            "dialogues": [
                {
                    "id": "615970401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "615970402",
                    "speaker": "Jill",
                    "text": "Bye-bye!"
                }
            ]
        }
    ]
