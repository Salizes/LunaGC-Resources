    "talks": [
        {
            "talkId": "6750601",
            "initDialog": "675060101",
            "dialogues": [
                {
                    "id": "675060101",
                    "speaker": "Timothy",
                    "text": "Interested in some insider tickets? Korolevskiy Troupe tickets. Nothing but high art."
                }
            ]
        },
        {
            "talkId": "6750602",
            "initDialog": "675060201",
            "dialogues": [
                {
                    "id": "675060201",
                    "speaker": "Player",
                    "text": "Insider tickets...?"
                },
                {
                    "id": "675060202",
                    "speaker": "Timothy",
                    "text": "That's right. Want one? Guaranteed cheaper than buying them at the theater."
                },
                {
                    "id": "675060203",
                    "speaker": "Timothy",
                    "text": "People say there's nothing more beautiful in all of Snezhnograd than Odette's singing. And if you haven't seen Vodyanitsa dance, you may as well not have visited Snezhnograd at all."
                },
                {
                    "id": "675060204",
                    "speaker": "Timothy",
                    "text": "Operettas, ballettos, you know, all that fancy stuff — I got the whole lot! Straight from the troupe. Honest business!"
                }
            ]
        },
        {
            "talkId": "6750603",
            "initDialog": "675060301",
            "dialogues": [
                {
                    "id": "675060301",
                    "speaker": "Player",
                    "text": "Maybe next time."
                },
                {
                    "id": "675060302",
                    "speaker": "Timothy",
                    "text": "Take care."
                }
            ]
        },
        {
            "talkId": "6750604",
            "initDialog": "675060401",
            "dialogues": [
                {
                    "id": "675060401",
                    "speaker": "Player",
                    "text": "I think you mean \"opera\" and \"ballet.\""
                },
                {
                    "id": "675060402",
                    "speaker": "Timothy",
                    "text": "Oh! Right, right... Looks like we've got an expert here!"
                },
                {
                    "id": "675060403",
                    "speaker": "Timothy",
                    "text": "Truth be told, I may have tickets, but I've never actually seen any of those performances myself. Gotta make a living somehow."
                },
                {
                    "id": "675060404",
                    "speaker": "Timothy",
                    "text": "Ah, my apologies. Anyway, if you're ever looking for insider tickets, don't forget where to find me."
                }
            ]
        },
        {
            "talkId": "6750605",
            "initDialog": "675060501",
            "dialogues": [
                {
                    "id": "675060501",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "675060502",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "675060503",
                    "speaker": "Paimon",
                    "text": ""
                },
                {
                    "id": "675060504",
                    "speaker": "Paimon",
                    "text": ""
                }
            ]
        },
        {
            "talkId": "6750606",
            "initDialog": "675060601",
            "dialogues": [
                {
                    "id": "675060601",
                    "speaker": "Player",
                    "text": "Are these tickets even legitimate?"
                },
                {
                    "id": "675060602",
                    "speaker": "Timothy",
                    "text": "Now, come on! Business runs on trust."
                },
                {
                    "id": "675060603",
                    "speaker": "Timothy",
                    "text": "If you're not comfortable with it, no hard feelings. Come back when you've made up your mind, and we'll talk."
                }
            ]
        }
    ]
