{
    "groupId": "9043",
    "total_dialogue_lines": 63,
    "speaker_counts": {
        "Player": 22,
        "Sucrose": 41
    },
    "talks": [
        {
            "talkId": "6904301",
            "initDialog": "690430101",
            "dialogues": [
                {
                    "id": "690430101",
                    "speaker": "Sucrose",
                    "text": "#Hello, {NICKNAME}."
                },
                {
                    "id": "690430102",
                    "speaker": "Sucrose",
                    "text": "Thanks to you, my research is progressing smoothly."
                }
            ]
        },
        {
            "talkId": "6904302",
            "initDialog": "690430201",
            "dialogues": [
                {
                    "id": "690430201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>How do you like it here?</color>"
                },
                {
                    "id": "690430202",
                    "speaker": "Sucrose",
                    "text": "Oh, uh... Please don't worry about me."
                },
                {
                    "id": "690430203",
                    "speaker": "Sucrose",
                    "text": "As long as there's a dedicated laboratory, I am more than satisfied."
                },
                {
                    "id": "690430204",
                    "speaker": "Sucrose",
                    "text": "Your home far exceeds my needs.",
                    "choices": [
                        {
                            "id": "690430205",
                            "text": "No need to hold back.",
                            "response": [
                                {
                                    "id": "690430207",
                                    "speaker": "Sucrose",
                                    "text": "Oh... Um..."
                                },
                                {
                                    "id": "690430208",
                                    "speaker": "Sucrose",
                                    "text": "I'd feel guilty to trouble you..."
                                },
                                {
                                    "id": "690430209",
                                    "speaker": "Sucrose",
                                    "text": "But I greatly appreciate your kindness. It means a lot."
                                }
                            ]
                        },
                        {
                            "id": "690430206",
                            "text": "If there's equipment you need, just say the word."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904303",
            "initDialog": "690430301",
            "dialogues": [
                {
                    "id": "690430301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
                },
                {
                    "id": "690430302",
                    "speaker": "Sucrose",
                    "text": "Uh... I'm... not very good at making conversation."
                },
                {
                    "id": "690430303",
                    "speaker": "Sucrose",
                    "text": "Most of my time I spend alone in the laboratory, researching for many hours at a time."
                },
                {
                    "id": "690430304",
                    "speaker": "Sucrose",
                    "text": "If an experiment doesn't quite go to plan, it can even end up being several days."
                },
                {
                    "id": "690430305",
                    "speaker": "Sucrose",
                    "text": "I don't know much about what goes on in the outside world... or the kinds of things that people like to talk about..."
                },
                {
                    "id": "690430306",
                    "speaker": "Sucrose",
                    "text": "And, um... I don't really like to go out and socialize much, even on my days off.",
                    "choices": [
                        {
                            "id": "690430307",
                            "text": "What about socializing with me?",
                            "response": [
                                {
                                    "id": "690430309",
                                    "speaker": "Sucrose",
                                    "text": "Oh... If it's with you, then..."
                                },
                                {
                                    "id": "690430310",
                                    "speaker": "Sucrose",
                                    "text": "No, no... I still don't know what would be appropriate to talk about.",
                                    "choices": [
                                        {
                                            "id": "690430311",
                                            "text": "You can just talk about whatever comes to mind.",
                                            "response": [
                                                {
                                                    "id": "690430313",
                                                    "speaker": "Sucrose",
                                                    "text": "Hmm..."
                                                },
                                                {
                                                    "id": "690430314",
                                                    "speaker": "Sucrose",
                                                    "text": "Hearing you say this makes me feel more at ease."
                                                },
                                                {
                                                    "id": "690430315",
                                                    "speaker": "Sucrose",
                                                    "text": "I guess... I can try."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690430312",
                                            "text": "It's okay to have nothing particular to talk about, you know..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690430308",
                            "text": "What about chatting with me?"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904304",
            "initDialog": "690430401",
            "dialogues": [
                {
                    "id": "690430401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
                },
                {
                    "id": "690430402",
                    "speaker": "Sucrose",
                    "text": "Oh, actually... I have a few small questions I'd like to ask you."
                },
                {
                    "id": "690430403",
                    "speaker": "Sucrose",
                    "text": "Just say the first answer that comes to mind. There are no right or wrong answers."
                },
                {
                    "id": "690430404",
                    "speaker": "Sucrose",
                    "text": "Small Lamp Grass or Windwheel Aster?",
                    "choices": [
                        {
                            "id": "690430405",
                            "text": "Small Lamp Grass.",
                            "response": [
                                {
                                    "id": "690430407",
                                    "speaker": "Sucrose",
                                    "text": "Anemogranum or Anemo Crystalfly?",
                                    "choices": [
                                        {
                                            "id": "690430408",
                                            "text": "Anemogranum.",
                                            "response": [
                                                {
                                                    "id": "690430410",
                                                    "speaker": "Sucrose",
                                                    "text": "A sea of clouds or a field of flowers?",
                                                    "choices": [
                                                        {
                                                            "id": "690430411",
                                                            "text": "Sea of clouds.",
                                                            "response": [
                                                                {
                                                                    "id": "690430413",
                                                                    "speaker": "Sucrose",
                                                                    "text": "Okay, I've noted your responses."
                                                                },
                                                                {
                                                                    "id": "690430414",
                                                                    "speaker": "Sucrose",
                                                                    "text": "...Previously, I never really knew how to bring this up."
                                                                },
                                                                {
                                                                    "id": "690430415",
                                                                    "speaker": "Sucrose",
                                                                    "text": "I thought about inviting you to my private paradise... but currently, I still lack the ability to make it a reality."
                                                                },
                                                                {
                                                                    "id": "690430416",
                                                                    "speaker": "Sucrose",
                                                                    "text": "So, for now... all I can do is place your selected objects into this crystal ball."
                                                                },
                                                                {
                                                                    "id": "690430417",
                                                                    "speaker": "Sucrose",
                                                                    "text": "It will keep them safe until the day comes when they can adorn our very own paradise.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "690430418",
                                                                            "text": "It's a deal!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "690430419",
                                                                                    "speaker": "Sucrose",
                                                                                    "text": "...Alright, it's a deal."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "690430420",
                                                                            "text": "You should bring some of your favorite things, too.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "690430421",
                                                                                    "speaker": "Sucrose",
                                                                                    "text": "Mm-hmm... I'll get there, one day!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690430412",
                                                            "text": "Field of flowers."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690430409",
                                            "text": "Anemo Crystalfly."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690430406",
                            "text": "Windwheel Aster."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6904305",
            "initDialog": "690430501",
            "dialogues": [
                {
                    "id": "690430501",
                    "speaker": "Player",
                    "text": "Good morning, Sucrose."
                },
                {
                    "id": "690430502",
                    "speaker": "Sucrose",
                    "text": "#Good morning, {NICKNAME}."
                },
                {
                    "id": "690430503",
                    "speaker": "Sucrose",
                    "text": "P—Please take care."
                }
            ]
        },
        {
            "talkId": "6904306",
            "initDialog": "690430601",
            "dialogues": [
                {
                    "id": "690430601",
                    "speaker": "Player",
                    "text": "Good night, Sucrose."
                },
                {
                    "id": "690430602",
                    "speaker": "Sucrose",
                    "text": "#Good night, {NICKNAME}."
                },
                {
                    "id": "690430603",
                    "speaker": "Sucrose",
                    "text": "According to my research, this secondary phenotype of Calla Lily may be beneficial for sleep quality."
                },
                {
                    "id": "690430604",
                    "speaker": "Sucrose",
                    "text": "I dried some to make a scented sachet. You can place it next to your pillow if you'd like."
                }
            ]
        },
        {
            "talkId": "6904307",
            "initDialog": "690430701",
            "dialogues": [
                {
                    "id": "690430701",
                    "speaker": "Player",
                    "text": "Would you like to have a chat with me?"
                }
            ]
        },
        {
            "talkId": "6904308",
            "initDialog": "690430801",
            "dialogues": [
                {
                    "id": "690430801",
                    "speaker": "Player",
                    "text": "Is there anything you'd like to do?"
                }
            ]
        },
        {
            "talkId": "6904309",
            "initDialog": "690430901",
            "dialogues": [
                {
                    "id": "690430901",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                }
            ]
        },
        {
            "talkId": "6904350",
            "initDialog": "690435001",
            "dialogues": [
                {
                    "id": "690435001",
                    "speaker": "Sucrose",
                    "text": "A fully-equipped alchemy workshop? And arranged in a rather reasonable manner as well..."
                },
                {
                    "id": "690435002",
                    "speaker": "Sucrose",
                    "text": "Even if an experiment goes, uh, explosively wrong in here, the specimens stored in the storage cabinets shouldn't be damaged..."
                },
                {
                    "id": "690435003",
                    "speaker": "Sucrose",
                    "text": "Huh? Wh—When did you get here? I—I mean... I've been itching to conduct this experiment... I—Is it okay if I go ahead and do it?"
                }
            ]
        },
        {
            "talkId": "6904351",
            "initDialog": "690435101",
            "dialogues": [
                {
                    "id": "690435101",
                    "speaker": "Sucrose",
                    "text": "This camp is flawless in every way. It's just a shame that there are no bones lying around..."
                },
                {
                    "id": "690435102",
                    "speaker": "Sucrose",
                    "text": "With a little renovation, perhaps this place could be used for even more valuable research..."
                },
                {
                    "id": "690435103",
                    "speaker": "Sucrose",
                    "text": "Are you interested? Can you... help me?"
                }
            ]
        }
    ]
}