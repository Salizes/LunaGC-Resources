    "talks": [
        {
            "talkId": "6514901",
            "initDialog": "651490101",
            "dialogues": [
                {
                    "id": "651490101",
                    "speaker": "Hermosa",
                    "text": "These photos are all pretty good... I guess I'll ask the editors to take their pick."
                }
            ]
        },
        {
            "talkId": "6514902",
            "initDialog": "651490201",
            "dialogues": [
                {
                    "id": "651490201",
                    "speaker": "Player",
                    "text": "Are you a photographer?"
                },
                {
                    "id": "651490202",
                    "speaker": "Hermosa",
                    "text": "I'm afraid not. I'm good at photography, yes, but I prefer the title \"adventurer.\""
                },
                {
                    "id": "651490203",
                    "speaker": "Hermosa",
                    "text": "I take my cat on various adventures and take many photos that tell a story."
                },
                {
                    "id": "651490204",
                    "speaker": "Hermosa",
                    "text": "I mean, who says pictures can't tell stories? Some of these get published in the newspapers, and some get used as illustrations for books."
                },
                {
                    "id": "651490205",
                    "speaker": "Hermosa",
                    "text": "Each one of my pictures will definitely contain my cat — makes them easy to identify, you know."
                }
            ]
        },
        {
            "talkId": "6514903",
            "initDialog": "651490301",
            "dialogues": [
                {
                    "id": "651490301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "651490302",
                    "speaker": "Hermosa",
                    "text": "Hmm? Oh, yeah, bye."
                }
            ]
        },
        {
            "talkId": "6514904",
            "initDialog": "651490401",
            "dialogues": [
                {
                    "id": "651490401",
                    "speaker": "Player",
                    "text": "Adventure Challenge"
                }
            ]
        },
        {
            "talkId": "6514905",
            "initDialog": "651490501",
            "dialogues": [
                {
                    "id": "651490501",
                    "speaker": "Hermosa",
                    "text": "A wonderfully close game! Certainly worthy of being saved as a commemorative photo to fill my Adventure Album!"
                }
            ]
        },
        {
            "talkId": "6514906",
            "initDialog": "651490601",
            "dialogues": [
                {
                    "id": "651490601",
                    "speaker": "Hermosa",
                    "text": "Ugh... Should I take a photo of this defeat?"
                }
            ]
        }
    ]
}