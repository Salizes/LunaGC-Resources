                {
                    "id": "641810101",
                    "speaker": "Arashakun",
                    "text": "As long as Arashakun has \"courage,\" Arashakun won't be scared no matter how many \"masked monsters\" come! They will never steal \"courage\" again! Arashakun won't allow that!"
                }
            ]
        },
