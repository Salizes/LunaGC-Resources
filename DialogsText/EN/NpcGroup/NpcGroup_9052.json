{
    "groupId": "9052",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Ei": 42,
        "Player": 21,
        "Raiden Shogun": 8
    },
    "talks": [
        {
            "talkId": "6905201",
            "initDialog": "690520101",
            "dialogues": [
                {
                    "id": "690520101",
                    "speaker": "Raiden Shogun",
                    "text": "..."
                },
                {
                    "id": "690520102",
                    "speaker": "Raiden Shogun",
                    "text": "Since my physical form is here in this realm, I suppose there's no harm in seeing how you've utilized its infinitesimal space."
                }
            ]
        },
        {
            "talkId": "6905202",
            "initDialog": "690520201",
            "dialogues": [
                {
                    "id": "690520201",
                    "speaker": "Ei",
                    "text": "#Oh, it's you, {NICKNAME}."
                },
                {
                    "id": "690520202",
                    "speaker": "Ei",
                    "text": "Perhaps you have come just to see me?"
                }
            ]
        },
        {
            "talkId": "6905203",
            "initDialog": "690520301",
            "dialogues": [
                {
                    "id": "690520301",
                    "speaker": "Player",
                    "text": "How do you like it here?"
                },
                {
                    "id": "690520302",
                    "speaker": "Ei",
                    "text": "It's much livelier here than the plane of pure silence and tranquility that I'm used to."
                },
                {
                    "id": "690520303",
                    "speaker": "Player",
                    "text": "Will it be difficult for you to get used to this place?"
                },
                {
                    "id": "690520304",
                    "speaker": "Ei",
                    "text": "No, not at all."
                },
                {
                    "id": "690520305",
                    "speaker": "Ei",
                    "text": "Clamor and commotion are strictly external, my inner being shall remain tranquil as ever.",
                    "choices": [
                        {
                            "id": "690520306",
                            "text": "Okay, that's good.",
                            "response": [
                                {
                                    "id": "690520307",
                                    "speaker": "Ei",
                                    "text": "Thank you for your concern."
                                },
                                {
                                    "id": "690520310",
                                    "speaker": "Ei",
                                    "text": "..."
                                },
                                {
                                    "id": "690520311",
                                    "speaker": "Ei",
                                    "text": "Will you remain here a while longer?"
                                },
                                {
                                    "id": "690520312",
                                    "speaker": "Ei",
                                    "text": "With you by my side, though our mouths stay silent, my heart is at peace."
                                },
                                {
                                    "id": "690520313",
                                    "speaker": "Ei",
                                    "text": "Your companionship... This is one change that I shall not contest."
                                }
                            ]
                        },
                        {
                            "id": "690520308",
                            "text": "Would you like to join in the action?",
                            "response": [
                                {
                                    "id": "690520309",
                                    "speaker": "Ei",
                                    "text": "Such lively activities stand in direct contrast to the notion of Eternity. I'm afraid I'll have to consider it further."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905204",
            "initDialog": "690520401",
            "dialogues": [
                {
                    "id": "690520401",
                    "speaker": "Player",
                    "text": "Would you like to have a chat with me?"
                },
                {
                    "id": "690520402",
                    "speaker": "Ei",
                    "text": "Yes, I just so happen to have something that I would like to ask you."
                },
                {
                    "id": "690520403",
                    "speaker": "Player",
                    "text": "Oh really? What's that?"
                },
                {
                    "id": "690520404",
                    "speaker": "Ei",
                    "text": "I would like to know how you make such delicious desserts."
                },
                {
                    "id": "690520405",
                    "speaker": "Ei",
                    "text": "*ahem* I mean, they certainly seem to suit my taste.",
                    "choices": [
                        {
                            "id": "690520406",
                            "text": "The most important ingredient is patience.",
                            "response": [
                                {
                                    "id": "690520407",
                                    "speaker": "Ei",
                                    "text": "I see... Though your attempts may fail, you will not give up future attempts because of a temporary setback."
                                },
                                {
                                    "id": "690520408",
                                    "speaker": "Ei",
                                    "text": "By making adjustments along the way, you compile what you've learned and accumulate experience."
                                },
                                {
                                    "id": "690520409",
                                    "speaker": "Ei",
                                    "text": "...Is that what you mean?"
                                },
                                {
                                    "id": "690520415",
                                    "speaker": "Player",
                                    "text": "Exactly."
                                },
                                {
                                    "id": "690520416",
                                    "speaker": "Ei",
                                    "text": "I see. I'll be sure to remember that."
                                },
                                {
                                    "id": "690520417",
                                    "speaker": "Ei",
                                    "text": "Now that I've benefited from your experience, I'll try to follow your instructions the next time I'm attempting optimizations on the Shogun.",
                                    "choices": [
                                        {
                                            "id": "690520418",
                                            "text": "Oh, so that's what this is all about...",
                                            "response": [
                                                {
                                                    "id": "690520420",
                                                    "speaker": "Ei",
                                                    "text": "Hmm? Haven't I already mentioned that I cannot make food?"
                                                },
                                                {
                                                    "id": "690520421",
                                                    "speaker": "Ei",
                                                    "text": "However, the advice you gave me will benefit you as well..."
                                                },
                                                {
                                                    "id": "690520422",
                                                    "speaker": "Ei",
                                                    "text": "With a more powerful Shogun, I will be able to protect you from a myriad of dangers even more effectively."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690520419",
                                            "text": "I have a feeling that it's not learning how to make desserts that you're after..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690520410",
                            "text": "The most important ingredient is hope.",
                            "response": [
                                {
                                    "id": "690520411",
                                    "speaker": "Ei",
                                    "text": "Hope?"
                                },
                                {
                                    "id": "690520412",
                                    "speaker": "Ei",
                                    "text": "I would've never expected that trying to make desserts taste better was an expression of hope."
                                },
                                {
                                    "id": "690520413",
                                    "speaker": "Ei",
                                    "text": "But no... The more I think about it, it can't possibly be that simple."
                                },
                                {
                                    "id": "690520414",
                                    "speaker": "Ei",
                                    "text": "Perhaps \"hope\" means the desire to satisfy the eater."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905205",
            "initDialog": "690520501",
            "dialogues": [
                {
                    "id": "690520501",
                    "speaker": "Player",
                    "text": "Anything you want to do?"
                },
                {
                    "id": "690520502",
                    "speaker": "Ei",
                    "text": "Yes. Unsheathe your weapon.",
                    "choices": [
                        {
                            "id": "690520503",
                            "text": "Wait, you mean... now?",
                            "response": [
                                {
                                    "id": "690520505",
                                    "speaker": "Ei",
                                    "text": "Hmph. Then I will come again once your preparation is complete. I have time."
                                },
                                {
                                    "id": "690520506",
                                    "speaker": "Ei",
                                    "text": "I will use my blade to confirm whether you are out of practice or not."
                                },
                                {
                                    "id": "690520507",
                                    "speaker": "Player",
                                    "text": "Wait, are you serious?"
                                },
                                {
                                    "id": "690520508",
                                    "speaker": "Ei",
                                    "text": "Naturally."
                                },
                                {
                                    "id": "690520509",
                                    "speaker": "Ei",
                                    "text": "The moment that blades are crossed in battle also becomes a kind of Eternity. I shall use this moment to feel your inner being."
                                },
                                {
                                    "id": "690520510",
                                    "speaker": "Ei",
                                    "text": "A simple and direct method, yet more clear than any language could convey. It even allows me to verify my own existence.",
                                    "choices": [
                                        {
                                            "id": "690520511",
                                            "text": "Something seems a bit off...",
                                            "response": [
                                                {
                                                    "id": "690520513",
                                                    "speaker": "Ei",
                                                    "text": "Huh? So you could see through my guise? Oh. I thought my impression was accurate enough."
                                                },
                                                {
                                                    "id": "690520514",
                                                    "speaker": "Ei",
                                                    "text": "Never mind. I'll be honest with you then, I desire to spar with you."
                                                },
                                                {
                                                    "id": "690520515",
                                                    "speaker": "Ei",
                                                    "text": "After all, few have ever proved capable of withstanding my blade. It would be a pleasure to train with you."
                                                },
                                                {
                                                    "id": "690520516",
                                                    "speaker": "Ei",
                                                    "text": "However, I feared that you would be hesitant to strike me, so I used the identity of the Shogun.",
                                                    "choices": [
                                                        {
                                                            "id": "690520517",
                                                            "text": "There's no need to trick me into it...",
                                                            "response": [
                                                                {
                                                                    "id": "690520519",
                                                                    "speaker": "Ei",
                                                                    "text": "Ah, you don't refuse. May I assume you accept then?"
                                                                },
                                                                {
                                                                    "id": "690520520",
                                                                    "speaker": "Ei",
                                                                    "text": "Hehe, you should prepare yourself. I certainly won't go easy on you."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690520518",
                                                            "text": "That's an odd request..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690520512",
                                            "text": "Ei? Is that you?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690520504",
                            "text": "I'm not mentally prepared for this."
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905206",
            "initDialog": "690520601",
            "dialogues": [
                {
                    "id": "690520601",
                    "speaker": "Player",
                    "text": "Good morning, Ei."
                },
                {
                    "id": "690520602",
                    "speaker": "Ei",
                    "text": "#Good morning, {NICKNAME}."
                },
                {
                    "id": "690520603",
                    "speaker": "Ei",
                    "text": "Even such a trivial interaction fills me with motivation. Amazing..."
                }
            ]
        },
        {
            "talkId": "6905207",
            "initDialog": "690520701",
            "dialogues": [
                {
                    "id": "690520701",
                    "speaker": "Player",
                    "text": "Good night, Ei."
                },
                {
                    "id": "690520702",
                    "speaker": "Ei",
                    "text": "Oh, has night fallen already? Then you'd best go have a rest."
                },
                {
                    "id": "690520703",
                    "speaker": "Ei",
                    "text": "#Good night, {NICKNAME}. May your dreams be calm and peaceful."
                }
            ]
        },
        {
            "talkId": "6905211",
            "initDialog": "690521101",
            "dialogues": [
                {
                    "id": "690521101",
                    "speaker": "Raiden Shogun",
                    "text": "This shrine looks somewhat familiar."
                },
                {
                    "id": "690521102",
                    "speaker": "Raiden Shogun",
                    "text": "Is this what it means... to reminisce?"
                },
                {
                    "id": "690521103",
                    "speaker": "Raiden Shogun",
                    "text": "So be it. The sensation is not a disagreeable one."
                }
            ]
        },
        {
            "talkId": "6905212",
            "initDialog": "690521201",
            "dialogues": [
                {
                    "id": "690521201",
                    "speaker": "Raiden Shogun",
                    "text": "A dojo...?"
                },
                {
                    "id": "690521202",
                    "speaker": "Raiden Shogun",
                    "text": "So, you pursue distinction in the martial arts? Clearly, the Musou no Hitotachi has sharpened your resolve."
                },
                {
                    "id": "690521203",
                    "speaker": "Raiden Shogun",
                    "text": "Those who strive for perfection are to be commended."
                }
            ]
        }
    ]
}