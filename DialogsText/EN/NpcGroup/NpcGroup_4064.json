            "dialogues": [
                {
                    "id": "640640101",
                    "speaker": "Azra",
                    "text": "When will I be able to see Nilou perform again?"
                }
            ]
        },
        {
            "talkId": "6406402",
            "initDialog": "640640201",
            "dialogues": [
                {
                    "id": "640640201",
                    "speaker": "Player",
                    "text": "About Nilou..."
                },
                {
                    "id": "640640202",
                    "speaker": "Azra",
                    "text": "Let me tell you, Zubayr Theater's Nilou is the best dancer ever."
                },
                {
                    "id": "640640203",
                    "speaker": "Azra",
                    "text": "Many may be able to dance beautifully, but Nilou is unique in the way she infuses emotions into her dance."
                },
                {
                    "id": "640640204",
                    "speaker": "Azra",
                    "text": "It took me a long time to snap out of such a feeling after watching her performance. It's so..."
                }
            ]
        },
        {
            "talkId": "6406403",
            "initDialog": "640640301",
            "dialogues": [
                {
                    "id": "640640301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640640302",
                    "speaker": "Azra",
                    "text": "*sigh* Why doesn't the Akademiya like theaters?"
                }
            ]
        },
        {
            "talkId": "6406404",
            "initDialog": "640640401",
            "dialogues": [
                {
                    "id": "640640401",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "640640402",
                    "speaker": "Azra",
                    "text": "The ban on the arts has been lifted, so we should be able to watch more performances now..."
                }
            ]
        },
        {
            "talkId": "7393801",
            "initDialog": "739380101",
            "dialogues": [
                {
                    "id": "739380101",
                    "speaker": "Player",
                    "text": "That feeling?"
                },
                {
                    "id": "739380102",
                    "speaker": "Azra",
                    "text": "Just like water!"
                },
                {
                    "id": "739380103",
                    "speaker": "Azra",
                    "text": "I mean, pure water can be shaped into different forms, boiled, or frozen..."
                },
                {
                    "id": "739380104",
                    "speaker": "Azra",
                    "text": "*sigh* If I weren't assigned as a guard here, I would like to watch her perform every day."
                }
            ]
        }
    ]
