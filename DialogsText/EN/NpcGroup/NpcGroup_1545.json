            "dialogues": [
                {
                    "id": "709230101",
                    "speaker": "Player",
                    "text": "Why are you so exhausted?"
                },
                {
                    "id": "709230102",
                    "speaker": "Marla",
                    "text": "Hmm... Well, it's because I can only meet with my lover at night."
                },
                {
                    "id": "709230103",
                    "speaker": "Marla",
                    "text": "The other reason is that I've been reading the Boar Princess series lately. I just finished the grand finale."
                },
                {
                    "id": "709230104",
                    "speaker": "Marla",
                    "text": "The ending is a bit strange, but it's so wonderful that the Boar Princess and the wolf pup could be together!"
                },
                {
                    "id": "709230105",
                    "speaker": "Marla",
                    "text": "Have you read it? If you haven't, please do... and please help me return it to the library when you've finished it, thanks."
                }
            ]
        },
        {
            "talkId": "41734",
            "initDialog": "615450203",
            "dialogues": [
                {
                    "id": "615450203",
                    "speaker": "Player",
                    "text": "Nothing in particular..."
                },
                {
                    "id": "615450204",
                    "speaker": "Marla",
                    "text": "Okay then... Good thing this bench is here, I think I'll have a nap now."
                }
            ]
        },
        {
            "talkId": "6154501",
            "initDialog": "615450101",
            "dialogues": [
                {
                    "id": "615450101",
                    "speaker": "Marla",
                    "text": "Hello... Can I help you with something?"
