        {
            "talkId": "6752704",
            "initDialog": "675270401",
            "dialogues": [
                {
                    "id": "675270401",
                    "speaker": "Player",
                    "text": "Can you guarantee that the liquor you sell does indeed come from the fae?"
                },
                {
                    "id": "675270402",
                    "speaker": "Savva",
                    "text": "Oh, absolutely! This is the real deal, the good stuff brewed by them fae folks in Novokitezhgrad. Don't pay too much mind to that price tag, I'm telling you. You're getting a total steal here."
                },
                {
                    "id": "675270403",
                    "speaker": "Savva",
                    "text": "Look, if we were back in the days of the Belyi Tsar, only the aristocrats would've ever gotten to enjoy a drink this good."
                },
                {
                    "id": "675270404",
                    "speaker": "Savva",
                    "text": "But these days, as long as you've got enough Mora in your pocket, you can have a real good time with a bottle like this."
                }
            ]
        },
        {
            "talkId": "6752705",
            "initDialog": "675270501",
            "dialogues": [
                {
                    "id": "675270501",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "675270502",
                    "speaker": "Savva",
                    "text": "I'll see you around. You're welcome here anytime you need to warm your bones."
                }
            ]
        }
    ]
