    "talks": [
        {
            "talkId": "6424101",
            "initDialog": "642410101",
            "dialogues": [
                {
                    "id": "642410101",
                    "speaker": "Aragaru",
                    "text": "Golden Nara received many flowers. Friends of Vanarana are friends of mine."
                }
            ]
        },
        {
            "talkId": "6424102",
            "initDialog": "642410201",
            "dialogues": [
                {
                    "id": "642410201",
                    "speaker": "Player",
                    "text": "Hello..."
                },
                {
                    "id": "642410202",
                    "speaker": "Aragaru",
                    "text": "Hello, Golden Nara..."
                },
                {
                    "id": "642410203",
                    "speaker": "Aragaru",
                    "text": "You will be like Nara Varuna, and become a story we Aranara will not forget. I think so."
                }
            ]
        },
        {
            "talkId": "6424103",
            "initDialog": "642410301",
            "dialogues": [
                {
                    "id": "642410301",
                    "speaker": "Player",
                    "text": "Goodbye..."
                },
                {
                    "id": "642410302",
                    "speaker": "Aragaru",
                    "text": "Bye, Golden Nara..."
                }
            ]
        },
        {
            "talkId": "6424104",
            "initDialog": "642410401",
            "dialogues": [
                {
                    "id": "642410401",
                    "speaker": "Aragaru",
                    "text": "#Nara {NICKNAME} is a new friend, but has already received flowers a long time ago, from me."
                }
            ]
        },
        {
            "talkId": "6424105",
            "initDialog": "642410501",
            "dialogues": [
                {
                    "id": "642410501",
                    "speaker": "Player",
                    "text": "About flowers..."
                },
                {
                    "id": "642410502",
                    "speaker": "Aragaru",
                    "text": "#Festival Utsava was a very happy time, and Nara {NICKNAME} also received many flowers."
                },
                {
                    "id": "642410503",
                    "speaker": "Aragaru",
                    "text": "I am very curious. Why did Golden Nara receive everyone's flowers like the flowers are raindrops converging into river?"
                },
                {
                    "id": "642410504",
                    "speaker": "Aragaru",
                    "text": "I see, so I had given flowers long ago in the story."
                }
            ]
        },
        {
            "talkId": "6424106",
            "initDialog": "642410601",
            "dialogues": [
                {
                    "id": "642410601",
                    "speaker": "Player",
                    "text": "About bad Nara..."
                },
                {
                    "id": "642410602",
                    "speaker": "Aragaru",
                    "text": "I gave the bad Nara flowers. But I don't know who it was, because I don't remember."
                },
                {
                    "id": "642410603",
                    "speaker": "Aragaru",
                    "text": "But at that time, the bad Nara was definitely not bad yet."
                },
                {
                    "id": "642410604",
                    "speaker": "Aragaru",
                    "text": "Sometimes, when the bright moon rose, Nara was still a good child. But when the sun rose again, Nara became bad. I don't understand..."
                },
                {
                    "id": "642410605",
                    "speaker": "Aragaru",
                    "text": "#But no matter how many times the sun and moon rise and set, Nara {NICKNAME} will always be like Nara Varuna, shining like gold."
                }
            ]
        },
        {
            "talkId": "6424107",
            "initDialog": "642410701",
            "dialogues": [
                {
                    "id": "642410701",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "642410702",
                    "speaker": "Aragaru",
                    "text": "#Bye, shining Golden Nara {NICKNAME}."
                }
            ]
        }
    ]
}