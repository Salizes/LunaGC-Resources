            "dialogues": [
                {
                    "id": "650940101",
                    "speaker": "Leone",
                    "text": "Welcome! The weather's rather fine today, isn't it? Is there anything I can help you with?"
                }
            ]
        },
        {
            "talkId": "6509402",
            "initDialog": "650940201",
            "dialogues": [
                {
                    "id": "650940201",
                    "speaker": "Player",
                    "text": "Hello there."
                },
                {
                    "id": "650940202",
                    "speaker": "Leone",
                    "text": "Welcome, welcome. This is Hotel Debord, a stage for fine food and fine art both."
                },
                {
                    "id": "650940203",
                    "speaker": "Leone",
                    "text": "May you enjoy delicious food and exciting performances both here today."
                }
            ]
        },
        {
            "talkId": "6509403",
            "initDialog": "650940301",
            "dialogues": [
                {
                    "id": "650940301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "650940302",
                    "speaker": "Leone",
                    "text": "Take care."
                }
            ]
        },
        {
            "talkId": "6509404",
            "initDialog": "650940401",
            "dialogues": [
                {
                    "id": "650940401",
                    "speaker": "Player",
                    "text": "Tell me about the performances..."
                },
                {
                    "id": "650940402",
                    "speaker": "Leone",
                    "text": "If I had to recommend something, it would be the magic show by the Great Magician Lyney and Lynette."
                },
                {
                    "id": "650940403",
                    "speaker": "Leone",
                    "text": "Their magic is truly a thing of surpassing beauty, and they also have many unexpected ideas!"
                },
                {
                    "id": "650940404",
                    "speaker": "Leone",
                    "text": "That said, their performance times are as unpredictable as their magic tricks."
                },
                {
                    "id": "650940405",
                    "speaker": "Leone",
                    "text": "You would be very fortunate to meet them indeed."
                }
            ]
        }
    ]
}