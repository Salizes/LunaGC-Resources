{
    "groupId": "5235",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Irus": 7,
        "Player": 4
    },
    "talks": [
        {
            "talkId": "6523501",
            "initDialog": "652350101",
            "dialogues": [
                {
                    "id": "652350101",
                    "speaker": "Irus",
                    "text": "I didn't expect to see you here. What're you in for?"
                }
            ]
        },
        {
            "talkId": "6523502",
            "initDialog": "652350201",
            "dialogues": [
                {
                    "id": "652350201",
                    "speaker": "Player",
                    "text": "I haven't committed any crimes..."
                },
                {
                    "id": "652350202",
                    "speaker": "Irus",
                    "text": "What a pity."
                }
            ]
        },
        {
            "talkId": "6523503",
            "initDialog": "652350301",
            "dialogues": [
                {
                    "id": "652350301",
                    "speaker": "Player",
                    "text": "See you later."
                },
                {
                    "id": "652350302",
                    "speaker": "Irus",
                    "text": "Take care! I gotta say, saying \"See you later\" in a place like this feels quite strange."
                }
            ]
        },
        {
            "talkId": "6523504",
            "initDialog": "652350401",
            "dialogues": [
                {
                    "id": "652350401",
                    "speaker": "Player",
                    "text": "A pity?"
                },
                {
                    "id": "652350402",
                    "speaker": "Irus",
                    "text": "Oh, I didn't mean anything by it. Actually, this place isn't half bad."
                },
                {
                    "id": "652350403",
                    "speaker": "Irus",
                    "text": "The guards here are pretty friendly. And as long as you work, you get Credit Coupons. Heck, they even feed you on a daily basis. If nothing else, it's certainly more stable than being a mercenary."
                }
            ]
        },
        {
            "talkId": "6523505",
            "initDialog": "652350501",
            "dialogues": [
                {
                    "id": "652350501",
                    "speaker": "Player",
                    "text": "What about your companions?"
                },
                {
                    "id": "652350502",
                    "speaker": "Irus",
                    "text": "As for Kaykaus and Kaykubad, they were only considered accessories, so they were free to go after paying a fine."
                },
                {
                    "id": "652350503",
                    "speaker": "Irus",
                    "text": "I hope they can find more reliable employers and do some honest work for once."
                }
            ]
        }
    ]
}