            "dialogues": [
                {
                    "id": "624200101",
                    "speaker": "Huachu",
                    "text": "*sigh*... Morning, can I help?"
                }
            ]
        },
        {
            "talkId": "6242002",
            "initDialog": "624200201",
            "dialogues": [
                {
                    "id": "624200201",
                    "speaker": "Player",
                    "text": "What's the matter?"
                },
                {
                    "id": "624200202",
                    "speaker": "Huachu",
                    "text": "Oh... I'm fine. It's just my first time away from home and I'm still getting used to it."
                },
                {
                    "id": "624200203",
                    "speaker": "Huachu",
                    "text": "Even the tea here tastes different from what I'm used to..."
                }
            ]
        },
        {
            "talkId": "6242003",
            "initDialog": "624200301",
            "dialogues": [
                {
                    "id": "624200301",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "624200302",
                    "speaker": "Huachu",
                    "text": "Oh yes, sorry... I am the second daughter of the manager of the Minghua Company. Today, exceptionally, I have taken an excursion."
                },
                {
                    "id": "624200303",
                    "speaker": "Huachu",
                    "text": "But with this being my first excursion ever, I am struggling to adapt.",
                    "choices": [
                        {
                            "id": "624200304",
                            "text": "Just the two of you?",
                            "response": [
                                {
                                    "id": "624200305",
                                    "speaker": "Huachu",
                                    "text": "Yes... Out of consideration for the business, I limited myself to a single travel partner."
                                }
                            ]
                        },
                        {
                            "id": "624200306",
                            "text": "Where are you going?",
                            "response": [
                                {
                                    "id": "624200307",
                                    "speaker": "Huachu",
                                    "text": "Apologies, that information is company confidential."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242004",
            "initDialog": "624200401",
            "dialogues": [
                {
                    "id": "624200401",
                    "speaker": "Player",
                    "text": "Have a wonderful excursion."
                },
                {
                    "id": "624200402",
                    "speaker": "Huachu",
                    "text": "And the same to you."
                }
            ]
        }
    ]
}