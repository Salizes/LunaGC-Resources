    "talks": [
        {
            "talkId": "4111545",
            "initDialog": "411154501",
            "dialogues": [
                {
                    "id": "411154501",
                    "speaker": "Little Yi",
                    "text": "Oh, hello there, person whose name I don't know! You're not asleep either, are you? Let's listen to a story together, then."
                }
            ]
        },
        {
            "talkId": "6214901",
            "initDialog": "621490101",
            "dialogues": [
                {
                    "id": "621490101",
                    "speaker": "Little Yi",
                    "text": "Hello, person whose name I don't know! Are you here to hear the story?"
                }
            ]
        },
        {
            "talkId": "6214902",
            "initDialog": "621490201",
            "dialogues": [
                {
                    "id": "621490201",
                    "speaker": "Player",
                    "text": "A story?"
                },
                {
                    "id": "621490202",
                    "speaker": "Little Yi",
                    "text": "Yep! Uncle Ghast's stories are so cool! They're kinda scary... And they're true!",
                    "choices": [
                        {
                            "id": "621490203",
                            "text": "...True?",
                            "response": [
                                {
                                    "id": "621490204",
                                    "speaker": "Little Yi",
                                    "text": "Yep! Some of the stories actually happened in real life..."
                                },
                                {
                                    "id": "621490205",
                                    "speaker": "Little Yi",
                                    "text": "Like the one about Dusky Ming! I've even seen her before, and she said we should play again next time..."
                                },
                                {
                                    "id": "621490206",
                                    "speaker": "Little Yi",
                                    "text": "But I think ghosts probably don't have very good memory, because she's never come to play with me again since then."
                                }
                            ]
                        },
                        {
                            "id": "621490207",
                            "text": "How spooky...",
                            "response": [
                                {
                                    "id": "621490208",
                                    "speaker": "Little Yi",
                                    "text": "I know, right!? The story used to give me the creeps every time..."
                                },
                                {
                                    "id": "621490209",
                                    "speaker": "Little Yi",
                                    "text": "But after I saw Dusky Ming for myself, I wasn't scared anymore. Ghosts aren't that scary!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6214903",
            "initDialog": "621490301",
            "dialogues": [
                {
                    "id": "621490301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "621490302",
                    "speaker": "Little Yi",
                    "text": "Bye!"
                }
            ]
        }
    ]
}