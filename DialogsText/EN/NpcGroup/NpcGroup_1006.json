{
    "groupId": "1006",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Jean": 28,
        "Player": 9
    },
    "talks": [
        {
            "talkId": "30903",
            "initDialog": "3090301",
            "dialogues": [
                {
                    "id": "3090301",
                    "speaker": "Jean",
                    "text": "Thank you for accepting our invitation, traveler.",
                    "choices": [
                        {
                            "id": "3090302",
                            "text": "How do we fight Stormterror?",
                            "response": [
                                {
                                    "id": "3090303",
                                    "speaker": "Jean",
                                    "text": "Its change in size and power really is suspicious."
                                },
                                {
                                    "id": "3090304",
                                    "speaker": "Jean",
                                    "text": "But for the Knights of Favonius, our priority is to deal with the aftermath of this attack."
                                },
                                {
                                    "id": "3090305",
                                    "speaker": "Jean",
                                    "text": "The Grand Master entrusted the Knights of Favonius to me. I cannot let him or the people of Mondstadt down."
                                },
                                {
                                    "id": "3090306",
                                    "speaker": "Jean",
                                    "text": "I must get to the bottom of this..."
                                }
                            ]
                        },
                        {
                            "id": "3090307",
                            "text": "Are all the knights as... \"strict\" as Amber?",
                            "response": [
                                {
                                    "id": "3090308",
                                    "speaker": "Jean",
                                    "text": "I heard you and Outrider Amber had a misunderstanding."
                                },
                                {
                                    "id": "3090309",
                                    "speaker": "Jean",
                                    "text": "Please forgive her. She was just doing her job."
                                },
                                {
                                    "id": "3090310",
                                    "speaker": "Jean",
                                    "text": "Talk to Amber sometime. I'm sure you'll like how energetic she always is."
                                }
                            ]
                        },
                        {
                            "id": "3090311",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3090312",
                                    "speaker": "Jean",
                                    "text": "#Thanks again for your help, {NICKNAME}."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "37312",
            "initDialog": "3730902",
            "dialogues": [
                {
                    "id": "3730902",
                    "speaker": "Jean",
                    "text": "About Stormterror, there must be something we are still not aware of...",
                    "choices": [
                        {
                            "id": "3730903",
                            "text": "How do we fight Stormterror?",
                            "response": [
                                {
                                    "id": "3730904",
                                    "speaker": "Jean",
                                    "text": "Its change in size and power really is suspicious."
                                },
                                {
                                    "id": "3730905",
                                    "speaker": "Jean",
                                    "text": "But for the Knights of Favonius, our priority is to deal with the aftermath of this attack."
                                },
                                {
                                    "id": "3730906",
                                    "speaker": "Jean",
                                    "text": "The Grand Master entrusted the Knights of Favonius to me. I cannot let him or the people of Mondstadt down."
                                },
                                {
                                    "id": "3730907",
                                    "speaker": "Jean",
                                    "text": "I must get to the bottom of this..."
                                }
                            ]
                        },
                        {
                            "id": "3730908",
                            "text": "Tell me about the Fatui.",
                            "response": [
                                {
                                    "id": "3730909",
                                    "speaker": "Jean",
                                    "text": "Those people in strange uniforms... are Fatui."
                                },
                                {
                                    "id": "3730910",
                                    "speaker": "Jean",
                                    "text": "They're here as delegates from Snezhnaya."
                                },
                                {
                                    "id": "3730911",
                                    "speaker": "Jean",
                                    "text": "Stay away from them. Having contact with them is dangerous, even for innocent travelers."
                                }
                            ]
                        },
                        {
                            "id": "3730912",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3730913",
                                    "speaker": "Jean",
                                    "text": "May the Wind guide you."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "38306",
            "initDialog": "3830514",
            "dialogues": [
                {
                    "id": "3830514",
                    "speaker": "Jean",
                    "text": "I know I'm not here on official business, so why did I sound so stern just now? It seems I struggle to break out of work mode.",
                    "choices": [
                        {
                            "id": "3830515",
                            "text": "Tell me about the Knights.",
                            "response": [
                                {
                                    "id": "3830516",
                                    "speaker": "Jean",
                                    "text": "The Knights of Favonius were all very busy dealing with the aftermath of the incident. I'm a bit ashamed of myself for it..."
                                },
                                {
                                    "id": "3830517",
                                    "speaker": "Jean",
                                    "text": "If only I was a stronger leader..."
                                },
                                {
                                    "id": "3830518",
                                    "speaker": "Jean",
                                    "text": "Or at least good enough to boost the morale and the strength of our troops like our Grand Master does..."
                                },
                                {
                                    "id": "3830519",
                                    "speaker": "Jean",
                                    "text": "No, I cannot feel sorry for myself. We need to solve our problems first. Right?"
                                }
                            ]
                        },
                        {
                            "id": "3830520",
                            "text": "Tell me about the Holy Lyre.",
                            "response": [
                                {
                                    "id": "3830521",
                                    "speaker": "Jean",
                                    "text": "Barbatos' sacred relic, Mondstadt's treasure... The Holy Lyre."
                                },
                                {
                                    "id": "3830522",
                                    "speaker": "Jean",
                                    "text": "No wonder it has the power to purify evil..."
                                },
                                {
                                    "id": "3830523",
                                    "speaker": "Jean",
                                    "text": "I hope it will help us save Dvalin, like Venti says."
                                },
                                {
                                    "id": "3830524",
                                    "speaker": "Jean",
                                    "text": "If it can, then it truly is a blessing bestowed upon us by Lord Barbatos."
                                }
                            ]
                        },
                        {
                            "id": "3830525",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3830526",
                                    "speaker": "Jean",
                                    "text": "May the wind guide us in saving Dvalin."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}