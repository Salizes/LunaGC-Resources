        {
            "talkId": "6755801",
            "initDialog": "675580101",
            "dialogues": [
                {
                    "id": "675580101",
                    "speaker": "???",
                    "text": "Ajax wasn't any trouble for you all, was he...?"
                }
            ]
        },
        {
            "talkId": "6755802",
            "initDialog": "675580201",
            "dialogues": [
                {
                    "id": "675580201",
                    "speaker": "Player",
                    "text": "Are you worried about Childe?"
                },
                {
                    "id": "675580202",
                    "speaker": "???",
                    "text": "Worry about him? More like I'm just afraid of whatever trouble he's stirring up somewhere..."
                },
                {
                    "id": "675580203",
                    "speaker": "???",
                    "text": "He was always picking fights back when he lived here. That's exactly why father wouldn't let him stay in the village anymore."
                }
            ]
        },
        {
            "talkId": "6755803",
            "initDialog": "675580301",
            "dialogues": [
                {
                    "id": "675580301",
                    "speaker": "Player",
                    "text": "Tell me about your family."
                },
                {
                    "id": "675580302",
                    "speaker": "???",
                    "text": "With Ajax constantly bringing back medicine from his travels, father's headaches have gotten much better!"
                },
                {
                    "id": "675580303",
                    "speaker": "???",
                    "text": "But out of my three older brothers, Ajax is the only one who rarely comes home. Every time he promises to play with me and Teucer, he bails on us nine times out of ten!"
                },
                {
                    "id": "675580304",
                    "speaker": "???",
                    "text": "But, as long as he's still willing to play with us, I don't mind."
                },
                {
                    "id": "675580305",
                    "speaker": "???",
                    "text": "I just always feel like... if we aren't right there holding his hand, he'll suddenly slip away to a place where nobody can ever reach him."
                }
            ]
        },
        {
            "talkId": "6755804",
            "initDialog": "675580401",
            "dialogues": [
                {
                    "id": "675580401",
                    "speaker": "Player",
                    "text": "Until next time."
                },
                {
                    "id": "675580402",
                    "speaker": "???",
                    "text": "See you!"
                }
            ]
        },
        {
