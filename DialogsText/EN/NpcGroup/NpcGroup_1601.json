    "talks": [
        {
            "talkId": "6160101",
            "initDialog": "616010101",
            "dialogues": [
                {
                    "id": "616010101",
                    "speaker": "Nora",
                    "text": "What's this? You want to play with me?"
                }
            ]
        },
        {
            "talkId": "6160102",
            "initDialog": "616010201",
            "dialogues": [
                {
                    "id": "616010201",
                    "speaker": "Player",
                    "text": "Where are your mom and dad?"
                },
                {
                    "id": "616010202",
                    "speaker": "Nora",
                    "text": "My dad is Patton!"
                },
                {
                    "id": "616010203",
                    "speaker": "Nora",
                    "text": "He's at that place where all the drunken uncles go."
                },
                {
                    "id": "616010204",
                    "speaker": "Nora",
                    "text": "Dad has a busy job, so I play by myself a lot."
                }
            ]
        },
        {
            "talkId": "6160103",
            "initDialog": "616010301",
            "dialogues": [
                {
                    "id": "616010301",
                    "speaker": "Player",
                    "text": "Hey kid, what are you doing?"
                },
                {
                    "id": "616010302",
                    "speaker": "Nora",
                    "text": "I like playing by the god statue!"
                },
                {
                    "id": "616010303",
                    "speaker": "Nora",
                    "text": "It's so big and so pretty."
                },
                {
                    "id": "616010304",
                    "speaker": "Nora",
                    "text": "Have you ever climbed to the top? I tried to climb it once but got told off by Grace."
                },
                {
                    "id": "616010305",
                    "speaker": "Nora",
                    "text": "Grace is a nice lady, I don't want to make her mad again."
                },
                {
                    "id": "616010306",
                    "speaker": "Nora",
                    "text": "But if you go up there, I wanna hear what the view is like!"
                }
            ]
        },
        {
            "talkId": "6160104",
            "initDialog": "616010401",
            "dialogues": [
                {
                    "id": "616010401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "616010402",
                    "speaker": "Nora",
                    "text": "You're going? Oh well, bye!"
                }
            ]
        },
        {
            "talkId": "6160105",
            "initDialog": "616010501",
            "dialogues": [
                {
                    "id": "616010501",
                    "speaker": "Player",
                    "text": "About Stormterror..."
                },
                {
                    "id": "616010502",
                    "speaker": "Nora",
                    "text": "Daddy said that Stormterror must have come because I wanted to climb up the god's statue..."
                },
                {
                    "id": "616010503",
                    "speaker": "Nora",
                    "text": "I'm sorry! I won't ever climb the god's statue ever again... *sobs*"
                },
                {
                    "id": "616010504",
                    "speaker": "Nora",
                    "text": "Lord Barbatos, please don't be angry... *sobs*"
                }
            ]
        }
    ]
}