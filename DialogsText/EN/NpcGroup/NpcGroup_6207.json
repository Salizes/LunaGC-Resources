{
    "groupId": "6207",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Hampeq": 7,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "7505202",
            "initDialog": "750520201",
            "dialogues": [
                {
                    "id": "750520201",
                    "speaker": "Hampeq",
                    "text": "If I had tried another way...",
                    "choices": [
                        {
                            "id": "750520202",
                            "text": "About the Hawkwings...",
                            "response": [
                                {
                                    "id": "750520203",
                                    "speaker": "Hampeq",
                                    "text": "We'd already been scattered like grains of sand, but now... Well, why bring it up again? You might as well just see it as having ceased to exist... In fact, it has indeed ceased to exist."
                                },
                                {
                                    "id": "750520204",
                                    "speaker": "Hampeq",
                                    "text": "I wanted to protect it, even if it meant resorting to a few underhand tricks — that was how much it meant to me. Little did I know, however, that it was precisely this that brought about our downfall..."
                                }
                            ]
                        },
                        {
                            "id": "750520205",
                            "text": "About the Locusts...",
                            "response": [
                                {
                                    "id": "750520206",
                                    "speaker": "Hampeq",
                                    "text": "You're not here to taunt me, are you?"
                                },
                                {
                                    "id": "750520207",
                                    "speaker": "Hampeq",
                                    "text": "Of course, in a minor sense, they've been affected too. But that counts for nothing compared to what I've been through."
                                },
                                {
                                    "id": "750520208",
                                    "speaker": "Hampeq",
                                    "text": "Perhaps I should just be a better loser and leave this place as soon as I can..."
                                }
                            ]
                        },
                        {
                            "id": "750520209",
                            "text": "I shan't disturb you any longer.",
                            "response": [
                                {
                                    "id": "750520210",
                                    "speaker": "Hampeq",
                                    "text": "Goodbye..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}