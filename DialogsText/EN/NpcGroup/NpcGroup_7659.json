        },
        {
            "talkId": "6765902",
            "initDialog": "676590201",
            "dialogues": [
                {
                    "id": "676590201",
                    "speaker": "Player",
                    "text": "Thanks for your hard work."
                },
                {
                    "id": "676590202",
                    "speaker": "Anleifr",
                    "text": "Oh, thank you! But I hardly compare to our captain."
                },
                {
                    "id": "676590203",
                    "speaker": "Anleifr",
                    "text": "Oh, come to think of it, he's still a growing lad, ain't he? Next time we have dinner, I should make sure he sits down and has a proper meal instead of buzzing around like he usually does."
                }
            ]
        },
        {
            "talkId": "6765903",
            "initDialog": "676590301",
            "dialogues": [
                {
                    "id": "676590301",
                    "speaker": "Player",
                    "text": "(<color=#FFCC33FF>Illuga</color> looks like he has something to say...?)"
                },
                {
                    "id": "676590302",
                    "speaker": "Illuga",
                    "text": "Alright. Seen anything unusual going on here?"
                },
                {
                    "id": "676590303",
                    "speaker": "Anleifr",
                    "text": "No sir, nothing at the moment. But I'll keep an eye out, so don't you worry."
                },
                {
                    "id": "676590304",
                    "speaker": "Illuga",
                    "text": "Alright. If anything comes up, be sure to report it right away."
                },
                {
                    "id": "676590305",
                    "speaker": "Anleifr",
                    "text": "Yes, sir!"
                }
            ]
        },
        {
            "talkId": "6765904",
            "initDialog": "676590401",
            "dialogues": [
                {
                    "id": "676590401",
                    "speaker": "Player",
                    "text": "Thanks for your time."
                },
                {
                    "id": "676590402",
                    "speaker": "Anleifr",
                    "text": "No worries. Seeya."
                }
            ]
