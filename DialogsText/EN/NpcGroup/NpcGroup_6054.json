    "talks": [
        {
            "talkId": "6605401",
            "initDialog": "660540101",
            "dialogues": [
                {
                    "id": "660540101",
                    "speaker": "Aphila",
                    "text": "Hmm, there's no wind at the moment. When will it pick up again?"
                }
            ]
        },
        {
            "talkId": "6605402",
            "initDialog": "660540201",
            "dialogues": [
                {
                    "id": "660540201",
                    "speaker": "Player",
                    "text": "Hey there."
                },
                {
                    "id": "660540202",
                    "speaker": "Aphila",
                    "text": "Hello, nice to meet you."
                }
            ]
        },
        {
            "talkId": "6605403",
            "initDialog": "660540301",
            "dialogues": [
                {
                    "id": "660540301",
                    "speaker": "Player",
                    "text": "Are you waiting for someone?"
                },
                {
                    "id": "660540302",
                    "speaker": "Aphila",
                    "text": "No, I'm waiting for my Saurian! They are my trusty partner."
                },
                {
                    "id": "660540303",
                    "speaker": "Aphila",
                    "text": "We've known each other since we were very little, and pretty much grew up together. According to the elders in the tribe, our birthdays were separated by just one day."
                },
                {
                    "id": "660540304",
                    "speaker": "Aphila",
                    "text": "They learned everything a lot faster when we were little, too. At one point, I was worried that they'd leave me behind, since they learned how to fly so much faster than me."
                },
                {
                    "id": "660540305",
                    "speaker": "Aphila",
                    "text": "All was well, though, for I soon caught up! It wasn't long before we went on our first flight together, and I decided to name them \"The Twilight of That Day.\""
                },
                {
                    "id": "660540306",
                    "speaker": "Aphila",
                    "text": "Sorry, I just started rambling..."
                },
                {
                    "id": "660540307",
                    "speaker": "Aphila",
                    "text": "I just love them so much, I can never shut up when I start talking about them. It's my bad."
                }
            ]
        },
        {
            "talkId": "6605404",
            "initDialog": "660540401",
            "dialogues": [
                {
                    "id": "660540401",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "660540402",
                    "speaker": "Aphila",
                    "text": "Yeah."
                }
            ]
        }
    ]
}