    "talks": [
        {
            "talkId": "6412101",
            "initDialog": "641210101",
            "dialogues": [
                {
                    "id": "641210101",
                    "speaker": "Berat",
                    "text": "Human eye can change the sea."
                }
            ]
        },
        {
            "talkId": "6412102",
            "initDialog": "641210201",
            "dialogues": [
                {
                    "id": "641210201",
                    "speaker": "Player",
                    "text": "Hello?"
                },
                {
                    "id": "641210202",
                    "speaker": "Berat",
                    "text": "Hear me out and don't keep staring at the sea."
                },
                {
                    "id": "641210203",
                    "speaker": "Berat",
                    "text": "Otherwise, you'll just sit there and watch, unable to do anything else."
                },
                {
                    "id": "641210204",
                    "speaker": "Berat",
                    "text": "Until the sky and the sea eventually turn red and everything perishes, including you..."
                }
            ]
        },
        {
            "talkId": "6412103",
            "initDialog": "641210301",
            "dialogues": [
                {
                    "id": "641210301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "641210302",
                    "speaker": "Berat",
                    "text": "Remember what I told you."
                }
            ]
        },
        {
            "talkId": "6412104",
            "initDialog": "641210401",
            "dialogues": [
                {
                    "id": "641210401",
                    "speaker": "Player",
                    "text": "The purple seawater..."
                },
                {
                    "id": "641210402",
                    "speaker": "Berat",
                    "text": "Oh, you've seen the purple sea?"
                },
                {
                    "id": "641210403",
                    "speaker": "Berat",
                    "text": "A pair of more treacherous eyes must've been watching it then, too!"
                },
                {
                    "id": "641210404",
                    "speaker": "Berat",
                    "text": "Anyway, heed my warning..."
                },
                {
                    "id": "641210405",
                    "speaker": "Berat",
                    "text": "Do not stare at the sea."
                }
            ]
        }
    ]
}