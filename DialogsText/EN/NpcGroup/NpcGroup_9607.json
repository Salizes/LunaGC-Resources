        {
            "talkId": "6960704",
            "initDialog": "696070401",
            "dialogues": [
                {
                    "id": "696070401",
                    "speaker": "Nefer",
                    "text": "Phew, almost had me there. Too bad your expression gave the game away. Hm, you wanna know which one? That one where you're trying way too hard to keep a straight face."
                }
            ]
        },
        {
            "talkId": "6960705",
            "initDialog": "696070501",
            "dialogues": [
                {
                    "id": "696070501",
                    "speaker": "Nefer",
                    "text": "...Congratulations, the win is yours. How about I treat you to a couple more drinks, then we'll go again."
                }
            ]
        },
        {
            "talkId": "6960706",
            "initDialog": "696070601",
            "dialogues": [
                {
                    "id": "696070601",
                    "speaker": "Nefer",
                    "text": "Cards? Sure, I've got time to kill. Who knows, we might even have a little fun."
                }
            ]
        },
        {
            "talkId": "6960708",
            "initDialog": "696070801",
            "dialogues": [
                {
                    "id": "696070801",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6960709",
