            "dialogues": [
                {
                    "id": "696070101",
                    "speaker": "Nefer",
                    "text": "This place is as busy as The Flagship... Perfect for gathering intel. Maybe I should have Jahoda take a stroll around, see what useful tidbits she can pick up."
                }
