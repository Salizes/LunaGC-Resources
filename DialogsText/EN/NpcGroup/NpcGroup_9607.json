            "dialogues": [
                {
                    "id": "696070201",
                    "speaker": "Player",
                    "text": "Let's play Genius Invokation TCG."
                }
            ]
        },
        {
            "talkId": "6960703",
            "initDialog": "696070301",
            "dialogues": [
                {
                    "id": "696070301",
                    "speaker": "Player",
                    "text": "I've got other things to do right now..."
                },
                {
                    "id": "696070302",
                    "speaker": "Nefer",
                    "text": "Oh? Off to get some rest? Heh... go ahead. It's getting late, and I need to get to work."
                }
