            ]
        },
        {
            "talkId": "6960712",
            "initDialog": "696071201",
            "dialogues": [
                {
                    "id": "696071201",
                    "speaker": "Nefer",
                    "text": "You wanna do this for real, huh? In that case... the gloves are comin' off."
                }
            ]
        },
        {
            "talkId": "6960714",
            "initDialog": "696071401",
            "dialogues": [
                {
