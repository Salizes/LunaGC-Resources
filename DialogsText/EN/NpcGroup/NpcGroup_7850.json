    },
    "talks": [
        {
            "talkId": "6785001",
            "initDialog": "678500101",
            "dialogues": [
                {
                    "id": "678500101",
                    "speaker": "Cherkasskaya",
                    "text": "Will we even see tomorrow if this goes on...?"
                }
            ]
        },
        {
            "talkId": "6785002",
            "initDialog": "678500201",
            "dialogues": [
                {
                    "id": "678500201",
                    "speaker": "Cherkasskaya",
                    "text": "Are you alright?"
                },
                {
                    "id": "678500202",
                    "speaker": "Cherkasskaya",
                    "text": "May the Tsaritsa protect you, stranger.Times are hard, but not desperate yet. We can hold out a while longer."
                },
                {
                    "id": "678500203",
                    "speaker": "Cherkasskaya",
                    "text": "But these days, it's hard to see any hope on the horizon. The crystal ore grows scarce, and no one in Snezhnaya seems to spare a thought for Sretomorozsk anymore..."
                },
                {
                    "id": "678500204",
                    "speaker": "Cherkasskaya",
                    "text": "We've seen hard times before. In these past sixty years, there's been enough hunger and cold for all of us. But we had the Tsaritsa... and we were always able to overcome every difficulty that came our way."
                },
                {
                    "id": "678500205",
                    "speaker": "Cherkasskaya",
                    "text": "It is not that we cannot endure. In the past, we always knew what we were holding on for. But this time... it has never been this bad before. Now, the trains no longer even come..."
                },
                {
                    "id": "678500206",
                    "speaker": "Cherkasskaya",
                    "text": "And what has all this been for...? No, the Tsaritsa couldn't have forgotten about us. She will see our suffering one day, won't she? Hope is just over the horizon. There is hope for us..."
                }
            ]
        },
        {
            "talkId": "6785003",
            "initDialog": "678500301",
            "dialogues": [
                {
                    "id": "678500301",
                    "speaker": "Cherkasskaya",
                    "text": "Goodbye."
                },
                {
                    "id": "678500302",
                    "speaker": "Cherkasskaya",
                    "text": "May the Tsaritsa protect you."
                }
            ]
        },
