    "talks": [
        {
            "talkId": "37704",
            "initDialog": "3770302",
            "dialogues": [
                {
                    "id": "3770302",
                    "speaker": "Venti",
                    "text": "The tavern closes <color=#00E1FFFF>at midnight</color>, right? Then I'll have another drink or two... Don't worry, I won't get drunk."
                }
            ]
        },
        {
            "talkId": "37706",
            "initDialog": "3770304",
            "dialogues": [
                {
                    "id": "3770304",
                    "speaker": "Venti",
                    "text": "Okay, got it. <color=#00E1FFFF>Tomorrow night</color>, right? Don't worry, I'll show up..."
                }
            ]
        },
        {
            "talkId": "38305",
            "initDialog": "3830501",
            "dialogues": [
                {
                    "id": "3830501",
                    "speaker": "Venti",
                    "text": "#Great job, {NICKNAME}. Now, look at what I can do!",
                    "choices": [
                        {
                            "id": "3830502",
                            "text": "Tell me about Dvalin.",
                            "response": [
                                {
                                    "id": "3830503",
                                    "speaker": "Venti",
                                    "text": "Dvalin used to be my friend... I still regard him as such."
                                },
                                {
                                    "id": "3830504",
                                    "speaker": "Venti",
                                    "text": "We used to listen to the songs of the wind and sing Ode to the Dandelion together..."
                                },
                                {
                                    "id": "3830505",
                                    "speaker": "Venti",
                                    "text": "That's why I remember him as someone gentle."
                                },
                                {
                                    "id": "3830506",
                                    "speaker": "Venti",
                                    "text": "Huh? Of course, you're already my friend."
                                }
                            ]
                        },
                        {
                            "id": "3830507",
                            "text": "Tell me about wine.",
                            "response": [
                                {
                                    "id": "3830508",
                                    "speaker": "Venti",
                                    "text": "Mondstadt is famous for its wine. It's the city's most prized treasure, I'd say."
                                },
                                {
                                    "id": "3830509",
                                    "speaker": "Venti",
                                    "text": "Its dandelion wine is the best!"
                                },
                                {
                                    "id": "3830510",
                                    "speaker": "Venti",
                                    "text": "Actually, the scent of dandelion in the wind alone is enough to get you drunk."
                                },
                                {
                                    "id": "3830511",
                                    "speaker": "Venti",
                                    "text": "Ah, I almost forgot that you're underage. Such a shame..."
                                }
                            ]
                        },
                        {
                            "id": "3830512",
                            "text": "Goodbye.",
                            "response": [
                                {
                                    "id": "3830513",
                                    "speaker": "Venti",
                                    "text": "I should prepare to meet my old friend."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "1011401",
            "initDialog": "101140101",
            "dialogues": [
                {
                    "id": "101140101",
                    "speaker": "(Quietly gazes at Venti)",
                    "text": "(The green-clad figure is uncharacteristically silent.)"
                },
                {
                    "id": "101140102",
                    "speaker": "(Quietly gazes at Venti)",
                    "text": "(Sometimes even the lissome wind grows heavy in its grief... But not that mortals could ever see a moment oh so brief.)"
                }
            ]
        }
    ]
}