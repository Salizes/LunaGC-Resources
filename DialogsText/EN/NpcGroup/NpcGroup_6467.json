            "dialogues": [
                {
                    "id": "664670201",
                    "speaker": "Player",
                    "text": "Hello there!"
                },
                {
                    "id": "664670202",
                    "speaker": "Mint Daifuku",
                    "text": "Squee! Squee—ee!"
                },
                {
                    "id": "664670203",
                    "speaker": "Mint Daifuku",
                    "text": "(The peculiar little creature seems to feel a special sense of familiarity toward you. It appears to be extremely happy...)"
                }
            ]
        },
        {
            "talkId": "6646703",
            "initDialog": "664670301",
            "dialogues": [
                {
                    "id": "664670301",
                    "speaker": "Player",
                    "text": "Are you looking after the place?"
                },
                {
                    "id": "664670302",
                    "speaker": "Mint Daifuku",
                    "text": "Squee! Squee—ee... Squee..."
                },
                {
                    "id": "664670303",
                    "speaker": "Mint Daifuku",
                    "text": "(The peculiar little creature is very professional. It appears to have identified you as a key partner of the owner and is providing you with a detailed report...)"
                }
            ]
        },
        {
            "talkId": "6646704",
            "initDialog": "664670401",
            "dialogues": [
                {
                    "id": "664670401",
                    "speaker": "Player",
                    "text": "Here, have a pat on the head!"
                },
                {
                    "id": "664670402",
                    "speaker": "Mint Daifuku",
                    "text": "Squee!?"
                },
                {
                    "id": "664670403",
                    "speaker": "Mint Daifuku",
                    "text": "(The peculiar little creature is somewhat bashful. Your attempt to pat its head ends in failure...)"
                }
            ]
        },
        {
            "talkId": "6646705",
            "initDialog": "664670501",
            "dialogues": [
                {
                    "id": "664670501",
                    "speaker": "Player",
                    "text": "Squee ya!"
                },
                {
                    "id": "664670502",
                    "speaker": "Mint Daifuku",
                    "text": "Squee!"
                },
                {
                    "id": "664670503",
                    "speaker": "Mint Daifuku",
                    "text": "(The peculiar little creature respectfully says goodbye. Its eyes seem to convey a sense of expectation, as though it's hoping you drop by again soon...)"
                }
            ]
        }
    ]
