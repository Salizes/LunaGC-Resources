            "dialogues": [
                {
                    "id": "640750101",
                    "speaker": "Javad",
                    "text": "Ouch..."
                }
            ]
        },
        {
            "talkId": "6407502",
            "initDialog": "640750201",
            "dialogues": [
                {
                    "id": "640750201",
                    "speaker": "Player",
                    "text": "Are you hurting badly?"
                },
                {
                    "id": "640750202",
                    "speaker": "Javad",
                    "text": "It does hurt pretty bad, but I'm used to it."
                },
                {
                    "id": "640750203",
                    "speaker": "Javad",
                    "text": "Even the best doctor couldn't do anything with my affliction, so I don't have any high hopes."
                },
                {
                    "id": "640750204",
                    "speaker": "Javad",
                    "text": "Compared to griping and living in fear, it's better to be upbeat and charitable."
                }
            ]
        },
        {
            "talkId": "6407503",
            "initDialog": "640750301",
            "dialogues": [
                {
                    "id": "640750301",
                    "speaker": "Player",
                    "text": "Take care of yourself."
                },
                {
                    "id": "640750302",
                    "speaker": "Javad",
                    "text": "Okay."
                }
            ]
        },
        {
            "talkId": "7393901",
            "initDialog": "739390101",
            "dialogues": [
                {
                    "id": "739390101",
                    "speaker": "Player",
                    "text": "Get some rest."
                },
                {
                    "id": "739390102",
                    "speaker": "Javad",
                    "text": "I appreciate your kindness, but life has to go on."
                },
                {
                    "id": "739390103",
                    "speaker": "Javad",
                    "text": "I'd trade a few years of my life for not having to drink such bitter medicines every day!"
                }
            ]
        }
    ]
}