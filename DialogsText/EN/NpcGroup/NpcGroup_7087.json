            "dialogues": [
                {
                    "id": "670870101",
                    "speaker": "Mikko",
                    "text": "Katya isn't still angry with me, is she?"
                }
            ]
        },
        {
            "talkId": "6708702",
            "initDialog": "670870201",
            "dialogues": [
                {
                    "id": "670870201",
                    "speaker": "Player",
                    "text": "What's wrong?"
                },
                {
                    "id": "670870202",
                    "speaker": "Mikko",
                    "text": "O—Oh, it's nothing really, I just... dropped a few things... that broke."
                },
                {
                    "id": "670870203",
                    "speaker": "Mikko",
                    "text": "But it's not all my fault. If she'd listened to me and replaced everything with wood or iron, then none of this would've happened!"
                },
                {
                    "id": "670870204",
                    "speaker": "Mikko",
                    "text": "*sigh* I don't know what I'm going to do if she's still angry..."
                }
            ]
        },
        {
            "talkId": "6708703",
            "initDialog": "670870301",
            "dialogues": [
                {
                    "id": "670870301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "670870302",
                    "speaker": "Mikko",
                    "text": "Huh? Oh. G—Goodbye!"
                }
            ]
        },
        {
            "talkId": "6708704",
            "initDialog": "670870401",
            "dialogues": [
                {
                    "id": "670870401",
                    "speaker": "Player",
                    "text": "Have you apologized?"
                },
                {
                    "id": "670870402",
                    "speaker": "Mikko",
                    "text": "B—But it's not entirely my fault! Why should I apologize?"
                },
                {
                    "id": "670870403",
                    "speaker": "Mikko",
                    "text": "...So, you think it's my fault, too? ... Hmm. If I'm going to say sorry, shouldn't I also get her a gift? I could probably get something from the Voynich Guild..."
                }
            ]
        }
    ]
}