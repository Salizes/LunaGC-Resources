            "dialogues": [
                {
                    "id": "643760201",
                    "speaker": "Player",
                    "text": "Senior?"
                },
                {
                    "id": "643760202",
                    "speaker": "Sasani",
                    "text": "Yes, the one who designed this masterpiece is my senior."
                },
                {
                    "id": "643760203",
                    "speaker": "Sasani",
                    "text": "But it is a pity that Mr. Kaveh graduated before I was even admitted."
                },
                {
                    "id": "643760204",
                    "speaker": "Sasani",
                    "text": "So, I didn't have the honor to speak with him in person, and I've never even attended a single architectural elective taught by him."
                },
                {
                    "id": "643760205",
                    "speaker": "Sasani",
                    "text": "Hmm... Mr. Kaveh is so great. I'm sure he has gained both fame and fortune, holding an important position somewhere in the world..."
                }
            ]
        },
        {
            "talkId": "6437603",
            "initDialog": "643760301",
            "dialogues": [
                {
                    "id": "643760301",
                    "speaker": "Player",
                    "text": "See you."
                },
                {
                    "id": "643760302",
                    "speaker": "Sasani",
                    "text": "When... will I..."
                }
            ]
