            "dialogues": [
                {
                    "id": "614490301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "614490302",
                    "speaker": "Miles",
                    "text": "Goodbye, traveler."
                },
                {
                    "id": "614490303",
                    "speaker": "Miles",
                    "text": "Stay safe."
                }
            ]
        },
        {
            "talkId": "6144904",
            "initDialog": "614490401",
            "dialogues": [
                {
                    "id": "614490401",
                    "speaker": "Miles",
                    "text": "We are currently experiencing abnormal weather patterns. It is dangerous outside. Citizens are advised to seek shelter."
                }
            ]
        },
        {
            "talkId": "6144905",
            "initDialog": "614490501",
            "dialogues": [
                {
                    "id": "614490501",
                    "speaker": "Miles",
                    "text": "That dragon could return at any time. The Knights of Favonius will keep watch; everyone else is urged to find shelter immediately."
                }
            ]
        },
        {
            "talkId": "6144906",
            "initDialog": "614490601",
            "dialogues": [
                {
                    "id": "614490601",
                    "speaker": "Miles",
                    "text": "This is an emergency. Please be assured that the Knights of Favonius' first priority is to guarantee the safety of everyone in the city."
                }
            ]
        }
    ]
