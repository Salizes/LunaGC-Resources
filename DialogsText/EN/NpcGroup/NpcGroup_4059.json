            "dialogues": [
                {
                    "id": "640590201",
                    "speaker": "Player",
                    "text": "What public performance?"
                },
                {
                    "id": "640590202",
                    "speaker": "Farhad",
                    "text": "It's the new play that Mr. Zubayr's working on."
                },
                {
                    "id": "640590203",
                    "speaker": "Farhad",
                    "text": "Unsurprisingly, Miss Nilou will definitely be featured in it."
                },
                {
                    "id": "640590204",
                    "speaker": "Farhad",
                    "text": "Plays at Zubayr Theater never disappoint. Every time a new production is out, researchers all rush over and grab tickets, no matter what research they have."
                },
                {
                    "id": "640590205",
                    "speaker": "Farhad",
                    "text": "You should definitely check them out."
                }
            ]
