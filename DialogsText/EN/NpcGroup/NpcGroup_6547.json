            "dialogues": [
                {
                    "id": "665470201",
                    "speaker": "Player",
                    "text": "Hello, \"Miss Airborne Asha.\""
                },
                {
                    "id": "665470202",
                    "speaker": "Tikraq",
                    "text": "Haha, don't tease me. Do you need anything? Or have you been thinking about \"Airborne Asha\" all this time?"
                },
                {
                    "id": "665470203",
                    "speaker": "Tikraq",
                    "text": "Whether it be admiring the scenery or creating a new masterpiece, if you want to experience it again, I can take you up in the hot air balloon."
                }
            ]
        },
        {
            "talkId": "6654703",
            "initDialog": "665470301",
            "dialogues": [
                {
                    "id": "665470301",
                    "speaker": "Player",
                    "text": "That sounds wonderful."
                },
                {
                    "id": "665470302",
                    "speaker": "Tikraq",
                    "text": "No problem, let's go."
                }
            ]
        },
        {
            "talkId": "6654704",
            "initDialog": "665470401",
            "dialogues": [
                {
                    "id": "665470401",
                    "speaker": "Player",
                    "text": "Thanks, but maybe another time."
                },
                {
                    "id": "665470402",
                    "speaker": "Tikraq",
                    "text": "Of course. Feel free to come back whenever you like."
                }
