            "dialogues": [
                {
                    "id": "741013201",
                    "speaker": "Player",
                    "text": "(Begin to \"meditate\"...)"
                },
                {
                    "id": "741013202",
                    "speaker": "Player",
                    "text": "(Perhaps this can be used to re-enter the mysterious, previously-inaccessible space.)",
                    "choices": [
                        {
                            "id": "741013203",
                            "text": "(Begin to \"meditate\"...)",
                            "response": [
                                {
                                    "id": "741013204",
                                    "speaker": "Book of Revealing",
                                    "text": "(The edges of the pages blur gradually. A profoundly unfamiliar yet familiar world enters your field of vision. Here...)"
                                }
                            ]
                        },
                        {
                            "id": "741013205",
                            "text": "(You put some distance between yourself and the Book of Revealing.)",
                            "response": [
                                {
                                    "id": "741013206",
                                    "speaker": "Book of Revealing",
                                    "text": "(But the visions shown have already planted a seed within your heart.)"
                                }
                            ]
                        }
                    ]
                }
            ]
