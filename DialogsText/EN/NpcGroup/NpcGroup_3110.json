            "dialogues": [
                {
                    "id": "631100101",
                    "speaker": "Riku",
                    "text": "Ah, an outlander! Hello!"
                }
            ]
        },
        {
            "talkId": "6311002",
            "initDialog": "631100201",
            "dialogues": [
                {
                    "id": "631100201",
                    "speaker": "Player",
                    "text": "Wanna play?"
                },
                {
                    "id": "631100202",
                    "speaker": "Riku",
                    "text": "Okay! Let's play Hide-and-Seek!"
                },
                {
                    "id": "631100203",
                    "speaker": "Riku",
                    "text": "...Ah, but my sister is still working at the shrine, and I promised her that I wouldn't run around. I need to wait for her so we can go home together..."
                },
                {
                    "id": "631100204",
                    "speaker": "Riku",
                    "text": "If my sister can't find me, she'll probably worry..."
                },
                {
                    "id": "631100205",
                    "speaker": "Riku",
                    "text": "Thank you, but I think I'll just play by myself."
                }
            ]
        },
        {
            "talkId": "6311003",
            "initDialog": "631100301",
            "dialogues": [
                {
                    "id": "631100301",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "631100302",
                    "speaker": "Riku",
                    "text": "I'm counting the people coming to the shrine for fortune slips!"
                },
                {
                    "id": "631100303",
                    "speaker": "Riku",
                    "text": "There was a very short girl in a tanuki outfit drawing a slip, wishing to grow taller or something..."
                },
                {
                    "id": "631100304",
                    "speaker": "Riku",
                    "text": "There was also a beautiful older girl who wished that Inazuma will remain peaceful and stuff..."
                },
                {
                    "id": "631100305",
                    "speaker": "Riku",
                    "text": "Oh, and there was some big bro wishing for the Kujou Clan to be prosperous..."
                },
                {
                    "id": "631100306",
                    "speaker": "Riku",
                    "text": "Their wishes are so special. My wish is just to be able to play Hide-and-Seek with my sister..."
                }
            ]
        },
        {
            "talkId": "6311004",
            "initDialog": "631100401",
            "dialogues": [
                {
                    "id": "631100401",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "631100402",
                    "speaker": "Riku",
                    "text": "Okay, bye-bye!"
                }
            ]
        }
    ]
}