            "dialogues": [
                {
                    "id": "617520101",
                    "speaker": "Lilian",
                    "text": "Hmm? Didn't I water this one already?"
                }
            ]
        },
        {
            "talkId": "6175202",
            "initDialog": "617520201",
            "dialogues": [
                {
                    "id": "617520201",
                    "speaker": "Lilian",
                    "text": "Oh? Is that... your fragrance?"
                }
            ]
        },
        {
            "talkId": "6175203",
            "initDialog": "617520301",
            "dialogues": [
                {
                    "id": "617520301",
                    "speaker": "Player",
                    "text": "What are you working on?"
                },
                {
                    "id": "617520302",
                    "speaker": "Lilian",
                    "text": "I'm trying to grow flowers with different scents, so I can make a range of fragrances."
                },
                {
                    "id": "617520303",
                    "speaker": "Lilian",
                    "text": "Like this one, Miss Mary. You can craft a top note from it that's as fresh as a light rain. While Lady Gildan over there serves as a grounding, full-bodied middle note..."
                },
                {
                    "id": "617520304",
                    "speaker": "Lilian",
                    "text": "But then... Hmm. What should the base note be?"
                }
            ]
        },
        {
            "talkId": "6175204",
            "initDialog": "617520401",
            "dialogues": [
                {
                    "id": "617520401",
                    "speaker": "Player",
                    "text": "About fragrances..."
                },
                {
                    "id": "617520402",
                    "speaker": "Lilian",
                    "text": "Hehe, I've got a good nose. You're wearing one of Miss Annick's fragrances, aren't you?"
                },
                {
                    "id": "617520403",
                    "speaker": "Lilian",
                    "text": "The notes are rich and well-layered, with clear transitions. The whole scent comes together so perfectly... It feels like the winter sun at midday. Bright, but gentle."
                },
                {
                    "id": "617520404",
                    "speaker": "Lilian",
                    "text": "Thank you. This fragrance of yours... It's given me a fresh wave of inspiration."
                }
            ]
        },
        {
            "talkId": "6175205",
            "initDialog": "617520501",
            "dialogues": [
                {
                    "id": "617520501",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "617520502",
                    "speaker": "Lilian",
                    "text": "Alright! Take care."
                }
            ]
        }
    ]
