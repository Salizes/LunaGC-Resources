{
    "groupId": "5127",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Munaciello": 9,
        "Player": 3
    },
    "talks": [
        {
            "talkId": "6512701",
            "initDialog": "651270101",
            "dialogues": [
                {
                    "id": "651270101",
                    "speaker": "Munaciello",
                    "text": "Hello. I'm Munaciello the \"Porter.\" Do you know the rules?"
                }
            ]
        },
        {
            "talkId": "6512702",
            "initDialog": "651270201",
            "dialogues": [
                {
                    "id": "651270201",
                    "speaker": "Player",
                    "text": "What rules?"
                },
                {
                    "id": "651270202",
                    "speaker": "Munaciello",
                    "text": "Hehe, fresh fish, I see."
                },
                {
                    "id": "651270203",
                    "speaker": "Munaciello",
                    "text": "Don't worry, Munaciello the \"Porter\" never cheats his customers."
                },
                {
                    "id": "651270204",
                    "speaker": "Munaciello",
                    "text": "You have questions, I've got answers. We'll exchange what you know for what I know — in equivalent amounts, of course."
                },
                {
                    "id": "651270205",
                    "speaker": "Munaciello",
                    "text": "That's how Munaciello the \"Porter\" rolls."
                }
            ]
        },
        {
            "talkId": "6512703",
            "initDialog": "651270301",
            "dialogues": [
                {
                    "id": "651270301",
                    "speaker": "Player",
                    "text": "A \"porter\"?"
                },
                {
                    "id": "651270302",
                    "speaker": "Munaciello",
                    "text": "I transport information from one place to another, just like how sailors carry goods."
                },
                {
                    "id": "651270303",
                    "speaker": "Munaciello",
                    "text": "Information's like futures — no capital, no profit."
                },
                {
                    "id": "651270304",
                    "speaker": "Munaciello",
                    "text": "And trust me, I've got capital to spare — Munaciello the \"Porter\" won't run low on cargo to transport, believe you me."
                }
            ]
        },
        {
            "talkId": "6512704",
            "initDialog": "651270401",
            "dialogues": [
                {
                    "id": "651270401",
                    "speaker": "Player",
                    "text": "Y—Yeah, I'm good."
                },
                {
                    "id": "651270402",
                    "speaker": "Munaciello",
                    "text": "You can come back to me once you're done considering — if you live that long."
                }
            ]
        }
    ]
}