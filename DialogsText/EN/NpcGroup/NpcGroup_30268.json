                        {
                            "id": "736790202",
                            "text": "Giant Snowboar, here I come!"
                        },
                        {
                            "id": "736790203",
                            "text": "Hold on, I need more time to prepare.",
                            "response": [
                                {
                                    "id": "736790204",
                                    "speaker": "Farabi",
                                    "text": "It's okay, take your time. We're dealing with a chunky fellow, after all."
                                }
                            ]
                        },
                        {
                            "id": "736790205",
                            "text": "Where's Edmund?",
                            "response": [
                                {
                                    "id": "736790206",
                                    "speaker": "Farabi",
                                    "text": "Mr. Edmund is responsible for security in Springvale, so I told him to go back. Don't worry, I'll be careful and stay out of the way. I won't give you any trouble."
