        },
        {
            "talkId": "6532402",
            "initDialog": "653240201",
            "dialogues": [
                {
                    "id": "653240201",
                    "speaker": "Player",
                    "text": "Err, hello?"
                },
                {
                    "id": "653240202",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532403",
            "initDialog": "653240301",
            "dialogues": [
                {
                    "id": "653240301",
                    "speaker": "Player",
                    "text": "Heh. Never mind. Why am I talking to a Tent Tortoise, anyway..."
                },
                {
                    "id": "653240302",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532404",
            "initDialog": "653240401",
            "dialogues": [
                {
                    "id": "653240401",
                    "speaker": "Player",
                    "text": "That's right, you can't talk..."
                },
                {
                    "id": "653240402",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532405",
            "initDialog": "653240501",
            "dialogues": [
                {
                    "id": "653240501",
                    "speaker": "Player",
                    "text": "You won't even so much as call out to me."
                },
                {
                    "id": "653240502",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532406",
            "initDialog": "653240601",
            "dialogues": [
                {
                    "id": "653240601",
                    "speaker": "Player",
                    "text": "But are you really an ordinary, run-of-the-mill Tent Tortoise?"
                },
                {
                    "id": "653240602",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532407",
            "initDialog": "653240701",
            "dialogues": [
                {
                    "id": "653240701",
                    "speaker": "Player",
                    "text": "Why are you here?"
                },
                {
                    "id": "653240702",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532408",
            "initDialog": "653240801",
            "dialogues": [
                {
                    "id": "653240801",
                    "speaker": "Player",
                    "text": "Does your silence indicate displeasure?"
                },
                {
                    "id": "653240802",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532409",
            "initDialog": "653240901",
            "dialogues": [
                {
                    "id": "653240901",
                    "speaker": "Player",
                    "text": "Hah. What am I doing, expecting a reply like this..."
                },
                {
                    "id": "653240902",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532410",
            "initDialog": "653241001",
            "dialogues": [
                {
                    "id": "653241001",
                    "speaker": "Player",
                    "text": "Do you not know, either?"
                },
                {
                    "id": "653241002",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532411",
            "initDialog": "653241101",
            "dialogues": [
                {
                    "id": "653241101",
                    "speaker": "Player",
                    "text": "Is it too much to ask to expect you to make some noise?"
                },
                {
                    "id": "653241102",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532412",
            "initDialog": "653241201",
            "dialogues": [
                {
                    "id": "653241201",
                    "speaker": "Player",
                    "text": "Ah, but then again, there can be no disappointment without expectations, right?"
                },
                {
                    "id": "653241202",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532413",
            "initDialog": "653241301",
            "dialogues": [
                {
                    "id": "653241301",
                    "speaker": "Player",
                    "text": "Just like how I don't know why I'm here, either?"
                },
                {
                    "id": "653241302",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532414",
            "initDialog": "653241401",
            "dialogues": [
                {
                    "id": "653241401",
                    "speaker": "Player",
                    "text": "Alright then. In that case, I humbly beg your forgiveness."
                },
                {
                    "id": "653241402",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532415",
            "initDialog": "653241501",
            "dialogues": [
                {
                    "id": "653241501",
                    "speaker": "Player",
                    "text": "Thank you. This is, indeed, a truth to be held self-evident."
                },
                {
                    "id": "653241502",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532416",
            "initDialog": "653241601",
            "dialogues": [
                {
                    "id": "653241601",
                    "speaker": "Player",
                    "text": "...Perhaps I should leave now, yes?"
                },
                {
                    "id": "653241602",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        },
        {
            "talkId": "6532417",
            "initDialog": "653241701",
            "dialogues": [
                {
                    "id": "653241701",
                    "speaker": "Player",
                    "text": "Impressive. You have won my respect..."
                },
                {
                    "id": "653241702",
                    "speaker": "Consigliere",
                    "text": "..."
                }
            ]
        }
    ]
}