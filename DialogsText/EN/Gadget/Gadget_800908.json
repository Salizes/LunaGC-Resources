    "dialogues": [
        {
            "id": "80090801",
            "speaker": "Paimon",
            "text": "There's a box over here. Why don't we open it? Uh, and by \"we,\" Paimon means you... Paimon's just scared that... whatever's inside might bite her fingertips off...",
            "choices": [
                {
                    "id": "80090802",
                    "text": "What in the world is going through your head...",
                    "response": [
                        {
                            "id": "80090804",
                            "speaker": "Paimon",
                            "text": "Huh? This is... a mirror."
                        },
                        {
                            "id": "80090805",
                            "speaker": "Paimon",
                            "text": "It's broken, too. Was this a makeup box?",
                            "choices": [
                                {
                                    "id": "80090806",
                                    "text": "It's just a regular mirror.",
                                    "response": [
                                        {
                                            "id": "80090808",
                                            "speaker": "Paimon",
                                            "text": "Hmm. That's kinda... disappointing. Paimon was hoping we'd uncover some super big secret, especially after Dain talked this place up."
                                        }
                                    ]
                                },
                                {
                                    "id": "80090807",
                                    "text": "It's just broken."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "80090803",
                    "text": "You sure are going places with your paranoia..."
                }
            ]
        }
    ]
}