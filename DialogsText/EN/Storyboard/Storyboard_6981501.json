{
    "talkId": "6981501",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 8,
        "Sucrose": 14
    },
    "dialogues": [
        {
            "id": "698150101",
            "speaker": "Sucrose",
            "text": "...Yes, very interesting. Time to write all this down...",
            "choices": [
                {
                    "id": "698150102",
                    "text": "Is today your day off?",
                    "response": [
                        {
                            "id": "698150104",
                            "speaker": "Sucrose",
                            "text": "#{NICKNAME}? Oh, I... Uh, I didn't think anyone else would come here."
                        },
                        {
                            "id": "698150105",
                            "speaker": "Sucrose",
                            "text": "I'm taking advantage of my vacation to do some nature-watching."
                        },
                        {
                            "id": "698150106",
                            "speaker": "Player",
                            "text": "Nature-watching Ruin Guards, then?"
                        },
                        {
                            "id": "698150107",
                            "speaker": "Sucrose",
                            "text": "Look. Over there. Do you see that white pigeon?"
                        },
                        {
                            "id": "698150108",
                            "speaker": "Player",
                            "text": "Aren't they practically everywhere?"
                        },
                        {
                            "id": "698150109",
                            "speaker": "Sucrose",
                            "text": "Yes, but only in places high, safe, and inaccessible enough to humans will they show their most natural, authentic appearance."
                        },
                        {
                            "id": "698150110",
                            "speaker": "Sucrose",
                            "text": "Ah, speaking of which... See? Patrolling Ruin Guards don't disturb them at all.",
                            "choices": [
                                {
                                    "id": "698150111",
                                    "text": "Is that because Ruin Guards don't actively attack animals?",
                                    "response": [
                                        {
                                            "id": "698150113",
                                            "speaker": "Sucrose",
                                            "text": "That's precisely what I'm curious about."
                                        },
                                        {
                                            "id": "698150114",
                                            "speaker": "Sucrose",
                                            "text": "Once, I observed a Finch making a nest atop a Ruin Guard's head. And yet when others approached, the Ruin Guard restarted itself."
                                        },
                                        {
                                            "id": "698150115",
                                            "speaker": "Sucrose",
                                            "text": "Could such a relationship be considered symbiotic? Is there some language- or signal-based communication between them?"
                                        },
                                        {
                                            "id": "698150116",
                                            "speaker": "Sucrose",
                                            "text": "Is this trust in automatons an inherited instinct, much like the imprinting phenomenon? Or is this an indication of them possessing greater intelligence than we assumed?"
                                        },
                                        {
                                            "id": "698150117",
                                            "speaker": "Sucrose",
                                            "text": "Living creatures are host to so many secrets — and I want to learn all about them!",
                                            "choices": [
                                                {
                                                    "id": "698150118",
                                                    "text": "Those are questions worth considering.",
                                                    "response": [
                                                        {
                                                            "id": "698150120",
                                                            "speaker": "Sucrose",
                                                            "text": "Thank you! I'm glad I got the chance to share these ideas with you, too."
                                                        },
                                                        {
                                                            "id": "698150121",
                                                            "speaker": "Sucrose",
                                                            "text": "In the past, I've always thought... That doing experiments by myself in the lab was the happiest, most fulfilling thing in the world."
                                                        },
                                                        {
                                                            "id": "698150122",
                                                            "speaker": "Sucrose",
                                                            "text": "But now that I think about it, spending my vacation this way isn't so bad either."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698150119",
                                                    "text": "I totally understand how you feel."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698150112",
                                    "text": "Is that because animals understand that Ruin Guards aren't hostile?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698150103",
                    "text": "Why did you climb so high up, Sucrose?"
                }
            ]
        }
    ]
}