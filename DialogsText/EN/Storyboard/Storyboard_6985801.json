{
    "talkId": "6985801",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Cat": 3,
        "Lauma": 19,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "698580101",
            "speaker": "Lauma",
            "text": "..."
        },
        {
            "id": "698580102",
            "speaker": "Player",
            "text": "(Is she sleeping? I should wait until she wakes up...)"
        },
        {
            "id": "698580103",
            "speaker": "Player",
            "text": "(Or maybe... I can come back later?)"
        },
        {
            "id": "698580104",
            "speaker": "Lauma",
            "text": "Hehe...",
            "choices": [
                {
                    "id": "698580105",
                    "text": "Aah!",
                    "response": [
                        {
                            "id": "698580107",
                            "speaker": "Lauma",
                            "text": "There's no need to apologize."
                        },
                        {
                            "id": "698580108",
                            "speaker": "Lauma",
                            "text": "I wasn't sleeping — merely resting my eyes."
                        },
                        {
                            "id": "698580109",
                            "speaker": "Lauma",
                            "text": "Besides, this child heard your footsteps and told me of your approach."
                        },
                        {
                            "id": "698580110",
                            "speaker": "Lauma",
                            "text": "Animals sense more than we humans. No doubt this is a blessing from the Creator."
                        },
                        {
                            "id": "698580111",
                            "speaker": "Player",
                            "text": "Thank you, little kitty."
                        },
                        {
                            "id": "698580112",
                            "speaker": "Cat",
                            "text": "Meow."
                        },
                        {
                            "id": "698580113",
                            "speaker": "Player",
                            "text": "What did it say?"
                        },
                        {
                            "id": "698580114",
                            "speaker": "Lauma",
                            "text": "It acknowledges you as a kind soul."
                        },
                        {
                            "id": "698580115",
                            "speaker": "Lauma",
                            "text": "This child persuaded me to trick you by pretending to fall asleep."
                        },
                        {
                            "id": "698580116",
                            "speaker": "Lauma",
                            "text": "#\"Let's see if {M#he}{F#she} spies on you or tries to steal your food!\"",
                            "choices": [
                                {
                                    "id": "698580117",
                                    "text": "It's a good job I didn't reach my hand out, then!",
                                    "response": [
                                        {
                                            "id": "698580119",
                                            "speaker": "Lauma",
                                            "text": "Though I have faith in your noble character, even I couldn't help but be a little bit curious about what you would do — besides, it seemed harmless enough."
                                        },
                                        {
                                            "id": "698580120",
                                            "speaker": "Lauma",
                                            "text": "Can you forgive us?",
                                            "choices": [
                                                {
                                                    "id": "698580121",
                                                    "text": "No harm, no foul.",
                                                    "response": [
                                                        {
                                                            "id": "698580129",
                                                            "speaker": "Lauma",
                                                            "text": "Oh, I completely forgot to ask. What is it that brings you here?"
                                                        },
                                                        {
                                                            "id": "698580130",
                                                            "speaker": "Player",
                                                            "text": "I just came by to check in on you."
                                                        },
                                                        {
                                                            "id": "698580131",
                                                            "speaker": "Lauma",
                                                            "text": "Hehe... So that's how it is."
                                                        },
                                                        {
                                                            "id": "698580132",
                                                            "speaker": "Lauma",
                                                            "text": "I thank you for your concern. All is well with me."
                                                        },
                                                        {
                                                            "id": "698580133",
                                                            "speaker": "Lauma",
                                                            "text": "As it so happens, we received a large amount of fresh fruit today. Perhaps you'd like to eat some with me?"
                                                        },
                                                        {
                                                            "id": "698580134",
                                                            "speaker": "Cat",
                                                            "text": "Meow."
                                                        },
                                                        {
                                                            "id": "698580135",
                                                            "speaker": "Player",
                                                            "text": "Does the cat eat fruit too?"
                                                        },
                                                        {
                                                            "id": "698580136",
                                                            "speaker": "Lauma",
                                                            "text": "Haha, it doesn't wish to leave us. After a lot of lounging around, it's enjoying the commotion."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698580122",
                                                    "text": "The nerve!",
                                                    "response": [
                                                        {
                                                            "id": "698580123",
                                                            "speaker": "Lauma",
                                                            "text": "#I think we've upset {M#him}{F#her}. What should we do? How about you knead {M#his}{F#her} hand a little by way of apology?"
                                                        },
                                                        {
                                                            "id": "698580124",
                                                            "speaker": "Cat",
                                                            "text": "Meow."
                                                        },
                                                        {
                                                            "id": "698580125",
                                                            "speaker": "Player",
                                                            "text": "And what about your apology, Lauma?"
                                                        },
                                                        {
                                                            "id": "698580126",
                                                            "speaker": "Lauma",
                                                            "text": "My palms are the same as any other human. I'm afraid my kneading might not be so pleasant..."
                                                        },
                                                        {
                                                            "id": "698580127",
                                                            "speaker": "Lauma",
                                                            "text": "But I can bestow upon you my blessing as Moonchanter, and pray that your road ahead is a smooth one..."
                                                        },
                                                        {
                                                            "id": "698580128",
                                                            "speaker": "Player",
                                                            "text": "Thank you so much."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698580118",
                                    "text": "I can't believe you played along..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698580106",
                    "text": "I'm sorry, I woke you up..."
                }
            ]
        }
    ]
}