{
    "talkId": "6985610",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Ineffa": 20,
        "Player": 16
    },
    "dialogues": [
        {
            "id": "698561001",
            "speaker": "Ineffa",
            "text": "Three more to go. Familiar presence detected nearby..."
        },
        {
            "id": "698561002",
            "speaker": "Player",
            "text": "Ineffa?"
        },
        {
            "id": "698561003",
            "speaker": "Ineffa",
            "text": "#Hello, {NICKNAME}."
        },
        {
            "id": "698561004",
            "speaker": "Player",
            "text": "Are you picking Lakkaberries here?"
        },
        {
            "id": "698561005",
            "speaker": "Ineffa",
            "text": "Yes. Aino enjoys eating krumkakes made with fresher specimens."
        },
        {
            "id": "698561006",
            "speaker": "Ineffa",
            "text": "The ones at the marketplace today fell below her standards, and that is why I am presently here, carrying out orders to procure them.",
            "choices": [
                {
                    "id": "698561007",
                    "text": "Are you alright?",
                    "response": [
                        {
                            "id": "698561008",
                            "speaker": "Ineffa",
                            "text": "Yes, I am. How about you?"
                        },
                        {
                            "id": "698561009",
                            "speaker": "Player",
                            "text": "I'm good. But... one moment."
                        },
                        {
                            "id": "698561011",
                            "speaker": "Ineffa",
                            "text": "Thank you for your concern. A few days ago, Aino adjusted my humor module, returning it to its original output.",
                            "choices": [
                                {
                                    "id": "698561012",
                                    "text": "(Whew... So she's finally back to normal.)",
                                    "response": [
                                        {
                                            "id": "698561014",
                                            "speaker": "Ineffa",
                                            "text": "Because my efficiency in generating jokes decreased significantly after my first few responses. It was taxing to generate more afterward, and any forced results lacked humor."
                                        },
                                        {
                                            "id": "698561015",
                                            "speaker": "Ineffa",
                                            "text": "According to Aino, it is because the creative logic of these jokes is overly chaotic, and my logic module cannot comprehend their creative principles. Therefore, I cannot produce content of substance."
                                        },
                                        {
                                            "id": "698561016",
                                            "speaker": "Ineffa",
                                            "text": "In order not to affect the logic module's operation, Aino decided to return the humor module's parameters back to normal levels."
                                        },
                                        {
                                            "id": "698561017",
                                            "speaker": "Ineffa",
                                            "text": "#But if you enjoyed my sense of humor from before, {NICKNAME}, I can notify Aino.",
                                            "choices": [
                                                {
                                                    "id": "698561018",
                                                    "text": "Nope! This is great!",
                                                    "response": [
                                                        {
                                                            "id": "698561020",
                                                            "speaker": "Ineffa",
                                                            "text": "Do you not like these types of jokes?",
                                                            "choices": [
                                                                {
                                                                    "id": "698561021",
                                                                    "text": "I... know somebody who has that sense of humor.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698561023",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Is that so? He must be someone of great skill. To think that he can generate consistently humorous jokes from such bizarre and chaotic creative principles..."
                                                                        },
                                                                        {
                                                                            "id": "698561024",
                                                                            "speaker": "Player",
                                                                            "text": "Let's talk about krumkakes. Please..."
                                                                        },
                                                                        {
                                                                            "id": "698561025",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Of course. If you wish to ask me about adding more sugar to krumkakes..."
                                                                        },
                                                                        {
                                                                            "id": "698561026",
                                                                            "speaker": "Ineffa",
                                                                            "text": "My answer is this: Krumkake recipes include specific quantities of sugar to be added. Adding too much or too little will affect the taste of the finished product.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698561027",
                                                                                    "text": "Thank goodness...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698561029",
                                                                                            "speaker": "Ineffa",
                                                                                            "text": "Of course. I am scanning the area to determine if it is suitable for a cooking demonstration... The results are not favorable."
                                                                                        },
                                                                                        {
                                                                                            "id": "698561030",
                                                                                            "speaker": "Ineffa",
                                                                                            "text": "...But I did bring a ready-to-eat \"Thunderclap Slash!\" Here, take it.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698561032",
                                                                                                    "text": "(Looks like Ineffa really is back to normal.)",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698561034",
                                                                                                            "speaker": "Ineffa",
                                                                                                            "text": "You're welcome."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698561035",
                                                                                                            "speaker": "Ineffa",
                                                                                                            "text": "If you have time, remember to come visit."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698561036",
                                                                                                            "speaker": "Ineffa",
                                                                                                            "text": "Although my humor module has been restored to its original parameters, Aino has been researching the creative logic chain of these kinds of jokes."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698561037",
                                                                                                            "speaker": "Ineffa",
                                                                                                            "text": "#Should she manage to create a joke-generation module, I will be able to continue telling jokes. Please look forward to this update, {NICKNAME}."
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698561033",
                                                                                                    "text": "Umm... Thank you?"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698561028",
                                                                                    "text": "So... about Lakkaberry Krumkakes..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698561022",
                                                                    "text": "His jokes never, ever end..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698561019",
                                                    "text": "No upgrade! Please!"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698561013",
                                    "text": "Why did she undo the upgrade?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698561010",
                    "text": "How's your humor module?"
                }
            ]
        }
    ]
}