{
    "talkId": "6983005",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 13,
        "Shikanoin Heizou": 22
    },
    "dialogues": [
        {
            "id": "698300501",
            "speaker": "Shikanoin Heizou",
            "text": "Well, well, what do you know. Help can come from unexpected corners..."
        },
        {
            "id": "698300502",
            "speaker": "Shikanoin Heizou",
            "text": "Still, at least the case is closed. Now, as for Madam Kujou Sara... How should I go over this in the debriefing...",
            "choices": [
                {
                    "id": "698300503",
                    "text": "Cracked it already?",
                    "response": [
                        {
                            "id": "698300505",
                            "speaker": "Shikanoin Heizou",
                            "text": "You flatter me. If it weren't for Miss Dori's assistance, it would've been a real headache...",
                            "choices": [
                                {
                                    "id": "698300506",
                                    "text": "Dori? What'd she do to help?",
                                    "response": [
                                        {
                                            "id": "698300508",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "A potion from Miss Dori? Oh, that would be the \"Ultra-Amazing Miracle Tonic Guaranteed to Make You Taller with Zero Effort!\", right? I've heard of it."
                                        },
                                        {
                                            "id": "698300509",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Her name's been on the Tenryou Commission's watchlist for ages, and we've already tested the potion."
                                        },
                                        {
                                            "id": "698300510",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "It's a harmless herbal mix, and the herbs themselves are healthy, so it technically does boost growth."
                                        },
                                        {
                                            "id": "698300511",
                                            "speaker": "Player",
                                            "text": "Wait, you mean... she wasn't lying...?"
                                        },
                                        {
                                            "id": "698300512",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Hahaha, you should take a closer look at her tagline: It's an \"Ultra-Amazing Miracle Tonic Guaranteed to Make You Taller with Zero Effort!\""
                                        },
                                        {
                                            "id": "698300513",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "But did she mention anywhere how long it would take to grow taller?",
                                            "choices": [
                                                {
                                                    "id": "698300514",
                                                    "text": "Ah...!",
                                                    "response": [
                                                        {
                                                            "id": "698300516",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Bingo. Drinking it might promote growth over time, but as for how long you'd have to drink it before you saw results... Who can say?"
                                                        },
                                                        {
                                                            "id": "698300517",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "If you ask me, chugging milk would be way more effective than drinking that.",
                                                            "choices": [
                                                                {
                                                                    "id": "698300518",
                                                                    "text": "So that's why she had such a massive banner...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698300520",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "Exactly. From what I can tell, Miss Dori herself knows that this so-called \"miracle tonic\" is little more than a placebo."
                                                                        },
                                                                        {
                                                                            "id": "698300521",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "Which is why she put so much energy into hyping it up with marketing, redirecting everyone's attention right where she wanted it."
                                                                        },
                                                                        {
                                                                            "id": "698300522",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "Hmm, now that I think about it, that's probably why she was so cooperative... Didn't even want to talk about compensation.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698300523",
                                                                                    "text": "When you mean help...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698300525",
                                                                                            "speaker": "Shikanoin Heizou",
                                                                                            "text": "That's the one. It was thanks to her that I finally cracked the case wide open."
                                                                                        },
                                                                                        {
                                                                                            "id": "698300526",
                                                                                            "speaker": "Shikanoin Heizou",
                                                                                            "text": "Back when I first asked her to help, I thought a merchant of her repute would drive a hard bargain, but she didn't ask for anything..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698300527",
                                                                                            "speaker": "Shikanoin Heizou",
                                                                                            "text": "But now... I can only guess that she'd already scooped up all of the syndicate's remaining legitimate channels and partners.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698300528",
                                                                                                    "text": "No wonder she was so confident...",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698300530",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "Ah, well. Forget it. I don't even want to try untangling the minds of merchants."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300531",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "But with a well-connected \"informant\" like Miss Dori around, future cases should be much easier to solve..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300532",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "...*cough* Madam Kujou isn't listening, is she? Good thing she left..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300533",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "Still... Agh, look at the time. I need to get back to the station soon, or she's going to give me an earful."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300534",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "#Take care, {NICKNAME}."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698300535",
                                                                                                            "speaker": "Shikanoin Heizou",
                                                                                                            "text": "But remember... no crimes, okay?"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698300529",
                                                                                                    "text": "No wonder she suddenly got into the potion business..."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698300524",
                                                                                    "text": "Are you talking about the illicit potions case?"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698300519",
                                                                    "text": "And even hired Sayu, and even a magician..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698300515",
                                                    "text": "It... It really doesn't..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698300507",
                                    "text": "Y'know, I just got a potion from her..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698300504",
                    "text": "Nothing less than I expected of you, Heizou."
                }
            ]
        }
    ]
}