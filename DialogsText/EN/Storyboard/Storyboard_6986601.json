{
    "talkId": "6986601",
    "total_dialogue_lines": 81,
    "speaker_counts": {
        "Black Screen": 1,
        "Neuvillette": 11,
        "Pahsiv": 7,
        "Paimon": 16,
        "Player": 14,
        "Wriothesley": 32
    },
    "dialogues": [
        {
            "id": "698660101",
            "speaker": "Paimon",
            "text": "Huh? Are Paimon's eyes deceiving her? The person sitting behind the desk is..."
        },
        {
            "id": "698660102",
            "speaker": "Player",
            "text": "Oh no, the Duke has turned into a Melusine!"
        },
        {
            "id": "698660103",
            "speaker": "Paimon",
            "text": "Nuh-uh! That's not right! This is clearly..."
        },
        {
            "id": "698660104",
            "speaker": "Player",
            "text": "Oops, my mistake. The Duke turned into a vishap."
        },
        {
            "id": "698660105",
            "speaker": "Paimon",
            "text": "What on earth are you talking about?"
        },
        {
            "id": "698660106",
            "speaker": "Paimon",
            "text": "#Sorry, Pahsiv, {M#he's}{F#she's} not quite {M#himself}{F#herself} right now...",
            "choices": [
                {
                    "id": "698660107",
                    "text": "Hehe, I was just pullin' your leg.",
                    "response": [
                        {
                            "id": "698660109",
                            "speaker": "Pahsiv",
                            "text": "Morning, noon, night, Pahsiv!"
                        },
                        {
                            "id": "698660110",
                            "speaker": "Paimon",
                            "text": "Hello to you too, Pahsiv. Still... what are you doing here in the Fortress of Meropide?",
                            "choices": [
                                {
                                    "id": "698660111",
                                    "text": "Did you do something bad?",
                                    "response": [
                                        {
                                            "id": "698660112",
                                            "speaker": "Paimon",
                                            "text": "What bad things could Pahsiv do? Cause a mass Tidalga extinction in Fontaine?"
                                        },
                                        {
                                            "id": "698660115",
                                            "speaker": "Pahsiv",
                                            "text": "Big bright light, Melusine... Pahsiv, hungry..."
                                        },
                                        {
                                            "id": "698660116",
                                            "speaker": "Paimon",
                                            "text": "Hmm... Paimon doesn't know what that big bright light is, but we can deal with the hunger problem at least."
                                        },
                                        {
                                            "id": "698660117",
                                            "speaker": "Paimon",
                                            "text": "#{NICKNAME}, you must have something yummy in your bag. Why don't we..."
                                        },
                                        {
                                            "id": "698660118",
                                            "speaker": "Pahsiv",
                                            "text": "Ah... Wrio! Wrio!"
                                        },
                                        {
                                            "id": "698660119",
                                            "speaker": "Wriothesley",
                                            "text": "Wrio, right here."
                                        },
                                        {
                                            "id": "698660120",
                                            "speaker": "Wriothesley",
                                            "text": "Hah, I see we have some unexpected guests. Welcome. Just give me a moment to put my things down."
                                        },
                                        {
                                            "id": "698660121",
                                            "speaker": "Wriothesley",
                                            "text": "How times change, huh? Me, of all people, diving into the water to hunt for food..."
                                        },
                                        {
                                            "id": "698660122",
                                            "speaker": "Paimon",
                                            "text": "Paimon sure didn't expect you to do that personally, Your Grace!"
                                        },
                                        {
                                            "id": "698660123",
                                            "speaker": "Wriothesley",
                                            "text": "Haha, I don't actually mind. Nothing wrong with the occasional swim. It's good exercise — and if I'm lucky, I even get a free otter show out of it."
                                        },
                                        {
                                            "id": "698660124",
                                            "speaker": "Paimon",
                                            "text": "Right, almost forgot how idle you can be sometimes..."
                                        },
                                        {
                                            "id": "698660125",
                                            "speaker": "Player",
                                            "text": "So, how did Pahsiv end up here?"
                                        },
                                        {
                                            "id": "698660126",
                                            "speaker": "Wriothesley",
                                            "text": "Ah, so that's her name? \"Pahsiv\"?"
                                        },
                                        {
                                            "id": "698660127",
                                            "speaker": "Wriothesley",
                                            "text": "I like it. It sounds... leisurely. Just hearing it said out loud makes me feel relaxed."
                                        },
                                        {
                                            "id": "698660128",
                                            "speaker": "Wriothesley",
                                            "text": "Oh, but to answer your question... Basically, Miss Pahsiv lingered a little too long under the searchlight and got herself captured by some overzealous guards."
                                        },
                                        {
                                            "id": "698660129",
                                            "speaker": "Wriothesley",
                                            "text": "I suspect she was too busy admiring the nearby Tidalga to notice the trap closing in around her."
                                        },
                                        {
                                            "id": "698660130",
                                            "speaker": "Wriothesley",
                                            "text": "You should be more careful in the future, Pahsiv. Don't forget, some fish out there use lights on their heads as bait to snare their prey."
                                        },
                                        {
                                            "id": "698660131",
                                            "speaker": "Wriothesley",
                                            "text": "If you're hunting Tidalga, there's a good chance an Anglerfish is hunting you."
                                        },
                                        {
                                            "id": "698660132",
                                            "speaker": "Pahsiv",
                                            "text": "P...Pahsiv?"
                                        },
                                        {
                                            "id": "698660133",
                                            "speaker": "Wriothesley",
                                            "text": "Can't understand what I'm saying, huh? Well, not to worry. Someone that can translate will be here shortly."
                                        },
                                        {
                                            "id": "698660134",
                                            "speaker": "Paimon",
                                            "text": "Who?"
                                        },
                                        {
                                            "id": "698660135",
                                            "speaker": "Wriothesley",
                                            "text": "I believe you're already acquainted. He sometimes goes by \"New Valet.\""
                                        },
                                        {
                                            "id": "698660136",
                                            "speaker": "Paimon",
                                            "text": "...Pfft!"
                                        },
                                        {
                                            "id": "698660137",
                                            "speaker": "Player",
                                            "text": "I know him. I know him very well."
                                        },
                                        {
                                            "id": "698660138",
                                            "speaker": "Wriothesley",
                                            "text": "Thought so. See, I do have a knack for this. I understood who she was talking about right away..."
                                        },
                                        {
                                            "id": "698660139",
                                            "speaker": "Wriothesley",
                                            "text": "Not that it was hard to guess. Makes sense that a Melusine would know Neuvillette."
                                        },
                                        {
                                            "id": "698660140",
                                            "speaker": "Wriothesley",
                                            "text": "Still, I've never met a Melusine who eats Tidalga, speaks in riddles, and even uses \"Melusine\" to express negation."
                                        },
                                        {
                                            "id": "698660141",
                                            "speaker": "Paimon",
                                            "text": "Ah, well, about that...",
                                            "choices": [
                                                {
                                                    "id": "698660142",
                                                    "text": "It's a long story...",
                                                    "response": [
                                                        {
                                                            "id": "698660144",
                                                            "speaker": "Wriothesley",
                                                            "text": "...Where?"
                                                        },
                                                        {
                                                            "id": "698660145",
                                                            "speaker": "Neuvillette",
                                                            "text": "*ahem*"
                                                        },
                                                        {
                                                            "id": "698660146",
                                                            "speaker": "Neuvillette",
                                                            "text": "Sorry to keep everyone waiting. I trust I am not late?"
                                                        },
                                                        {
                                                            "id": "698660147",
                                                            "speaker": "Wriothesley",
                                                            "text": "Ah, Neuvillette! Of course not. Whenever you deem fit to grace us with your presence is always the perfect time. Miss Pahsiv is waiting for you."
                                                        },
                                                        {
                                                            "id": "698660148",
                                                            "speaker": "Pahsiv",
                                                            "text": "New... Va... let!"
                                                        },
                                                        {
                                                            "id": "698660149",
                                                            "speaker": "Neuvillette",
                                                            "text": "Take your time, finish your food. We'll talk afterwards."
                                                        },
                                                        {
                                                            "id": "698660150",
                                                            "speaker": "Paimon",
                                                            "text": "This looks just like a parent finding their lost child in the park..."
                                                        },
                                                        {
                                                            "id": "698660151",
                                                            "speaker": "Wriothesley",
                                                            "text": "Heh, that's about right actually. He's only here because I broadcasted a missing person notice throughout all of Fontaine.",
                                                            "choices": [
                                                                {
                                                                    "id": "698660152",
                                                                    "text": "I see.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698660154",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Heh... It seems we are in fine spirits today. These jokes are certainly imaginative."
                                                                        },
                                                                        {
                                                                            "id": "698660155",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Seeing Pahsiv safe and well seems to have put you in good spirits too. She must be very important to you."
                                                                        },
                                                                        {
                                                                            "id": "698660156",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Hmm..."
                                                                        },
                                                                        {
                                                                            "id": "698660157",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Since there are no outsiders here, I'll get right to the point."
                                                                        },
                                                                        {
                                                                            "id": "698660158",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Despite appearances, she is quite different from other Melusines..."
                                                                        },
                                                                        {
                                                                            "id": "698660181",
                                                                            "speaker": "Black Screen",
                                                                            "text": "You listen to Neuvillette's explanation about what makes Pahsiv special (though you already knew)..."
                                                                        },
                                                                        {
                                                                            "id": "698660159",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "That explains it. So that's why Pahsiv expresses herself in such a unique way."
                                                                        },
                                                                        {
                                                                            "id": "698660160",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "You see, this is why it's always worth striving to stay alive as long as possible."
                                                                        },
                                                                        {
                                                                            "id": "698660161",
                                                                            "speaker": "Player",
                                                                            "text": "To gain more knowledge?"
                                                                        },
                                                                        {
                                                                            "id": "698660162",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "To hear stories from those who have lived longer than you, about things you never knew."
                                                                        },
                                                                        {
                                                                            "id": "698660163",
                                                                            "speaker": "Pahsiv",
                                                                            "text": "Pahsiv!"
                                                                        },
                                                                        {
                                                                            "id": "698660164",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "It seems Miss Pahsiv agrees as well."
                                                                        },
                                                                        {
                                                                            "id": "698660165",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Indeed. Thank you very much for taking care of her."
                                                                        },
                                                                        {
                                                                            "id": "698660166",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "My pleasure."
                                                                        },
                                                                        {
                                                                            "id": "698660167",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "And thanks to you all, I now have ample reason to give my friends at the Fontaine Research Institute a little task. I'm hoping they can add some ID verification functionality to our \"Big Bright Lights.\""
                                                                        },
                                                                        {
                                                                            "id": "698660168",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "I mean, of all the ways to invite our friends of the Fortress to come and visit... This doesn't seem like the most sustainable long-term strategy."
                                                                        },
                                                                        {
                                                                            "id": "698660169",
                                                                            "speaker": "Paimon",
                                                                            "text": "You're right. Even we get picked up from time to time while passing by..."
                                                                        },
                                                                        {
                                                                            "id": "698660170",
                                                                            "speaker": "Player",
                                                                            "text": "Can't wait to see what the inventors come up with."
                                                                        },
                                                                        {
                                                                            "id": "698660171",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Don't get your hopes up... I'm just hoping I get to see it before I die."
                                                                        },
                                                                        {
                                                                            "id": "698660172",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Until the process is complete, I shall inform the Melusines to avoid any such... \"Big Bright Lights\" when passing through. I shall do the same."
                                                                        },
                                                                        {
                                                                            "id": "698660173",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Ah, um... Sounds good. I'm... sure you'll manage."
                                                                        },
                                                                        {
                                                                            "id": "698660174",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "Apologies for the inconvenience. In any case, I cannot stay long, so I shall take my leave together with Pahsiv."
                                                                        },
                                                                        {
                                                                            "id": "698660175",
                                                                            "speaker": "Neuvillette",
                                                                            "text": "If there are other matters to discuss, let us meet above the surface."
                                                                        },
                                                                        {
                                                                            "id": "698660176",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Understood."
                                                                        },
                                                                        {
                                                                            "id": "698660177",
                                                                            "speaker": "Pahsiv",
                                                                            "text": "Pahsiv, come! Goodbye, Wrio!"
                                                                        },
                                                                        {
                                                                            "id": "698660178",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "Bye-oh from Wrio. See you next time."
                                                                        },
                                                                        {
                                                                            "id": "698660179",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "(Oh dear, I forgot to have Neuvillette explain the Anglerfish metaphor to Pahsiv, and I didn't get to ask about Enkanomiya either.)"
                                                                        },
                                                                        {
                                                                            "id": "698660180",
                                                                            "speaker": "Wriothesley",
                                                                            "text": "(...Never mind, there's no rush. I'll write him a letter when I send the documents over.)"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698660153",
                                                                    "text": "What a touching reunion."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698660143",
                                                    "text": "Once upon a time, in Enkanomiya..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698660113",
                                    "text": "Did you get a job here?",
                                    "response": [
                                        {
                                            "id": "698660114",
                                            "speaker": "Paimon",
                                            "text": "Paimon can't imagine what kind of work Pahsiv could do here... Patrol the sea with vishaps in tow?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698660108",
                    "text": "Hey there, Pahsiv."
                }
            ]
        }
    ]
}