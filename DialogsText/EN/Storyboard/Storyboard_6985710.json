{
    "talkId": "6985710",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "\"Game Master\"": 1,
        "Clorinde": 6,
        "Illuga": 3,
        "Jahoda": 5,
        "Navia": 7,
        "Paimon": 1,
        "Player": 12
    },
    "dialogues": [
        {
            "id": "698571001",
            "speaker": "Jahoda",
            "text": "Illuga, can't you just, y'know, sneak up behind those monsters with me and BAM, take 'em all down?"
        },
        {
            "id": "698571002",
            "speaker": "Jahoda",
            "text": "I can act three times in a round, and there are only four monsters in total. I'll take three down, you just gotta handle the last one."
        },
        {
            "id": "698571003",
            "speaker": "Illuga",
            "text": "I can draw the monsters' attention from the front, but sneak attacks..."
        },
        {
            "id": "698571004",
            "speaker": "Navia",
            "text": "Hmm... Well, there isn't much we can do. Illuga's a \"Lochknight\" who chose the \"Goblet of Justice.\""
        },
        {
            "id": "698571005",
            "speaker": "\"Game Master\"",
            "text": "Indeed. If Illuga were to strike from behind, he would be forced to become an \"Oathbreaker Knight.\" A significant penalty would apply to all actions going forward."
        },
        {
            "id": "698571006",
            "speaker": "Navia",
            "text": "Oof, that's not good. If we don't defeat all these monsters in one go, those explosives are going to blow us sky-high!"
        },
        {
            "id": "698571007",
            "speaker": "Illuga",
            "text": "There's another way. I can use \"Raging Torrent\" to dash straight into the thick of it, then detonate the explosives..."
        },
        {
            "id": "698571008",
            "speaker": "Navia",
            "text": "No, no, that won't do at all! Your character would get \"Wiped Out\" that way! We finally managed to gather the party and have such a lovely time together. It would be such a shame if you were the only one who got \"Wiped Out.\""
        },
        {
            "id": "698571009",
            "speaker": "Illuga",
            "text": "But if we don't do this, the \"Character\" that you've been playing for so long might get \"Wiped Out\" too, Miss Navia. Wouldn't that be worse?"
        },
        {
            "id": "698571010",
            "speaker": "Jahoda",
            "text": "I only just started playing, please don't—"
        },
        {
            "id": "698571011",
            "speaker": "Navia",
            "text": "Hrrrm... Wait, I've got another trick up my sleeve."
        },
        {
            "id": "698571012",
            "speaker": "Clorinde",
            "text": "Navia, put that krumkake away."
        },
        {
            "id": "698571013",
            "speaker": "Jahoda",
            "text": "Uh-oh! That move was blocked too!",
            "choices": [
                {
                    "id": "698571014",
                    "text": "Navia?",
                    "response": [
                        {
                            "id": "698571016",
                            "speaker": "Paimon",
                            "text": "These pieces on the table, and the stuff you were saying just now — you're playing..."
                        },
                        {
                            "id": "698571017",
                            "speaker": "Navia",
                            "text": "Ah! A savior has arrived! Right on time! Quick, quick, quick, come join us!"
                        },
                        {
                            "id": "698571018",
                            "speaker": "Navia",
                            "text": "Clorinde, this doesn't count as violating the rules, right?"
                        },
                        {
                            "id": "698571103",
                            "speaker": "Clorinde",
                            "text": "#If {M#he's}{F#she's} willing to join us. Oh, by the way, we're currently playing on \"Easy Mode\" to accommodate the newcomers."
                        },
                        {
                            "id": "698571104",
                            "speaker": "Navia",
                            "text": "#{NICKNAME}, would you like to continue the adventure with us? You definitely would, right?",
                            "choices": [
                                {
                                    "id": "698571105",
                                    "text": "Sorry, what? What happened?",
                                    "response": [
                                        {
                                            "id": "698571107",
                                            "speaker": "Jahoda",
                                            "text": "Oh, come on! Any more questions and those explosives are gonna send us flying!",
                                            "choices": [
                                                {
                                                    "id": "698571108",
                                                    "text": "I—I will!",
                                                    "response": [
                                                        {
                                                            "id": "698571110",
                                                            "speaker": "Clorinde",
                                                            "text": "Good. Since you haven't played a script for a while now, you may have one chance to re-select your skills."
                                                        },
                                                        {
                                                            "id": "698571111",
                                                            "speaker": "Clorinde",
                                                            "text": "The skills you can modify are \"cooking\" and \"medicine.\" What do you think? Would you like to make any changes?",
                                                            "choices": [
                                                                {
                                                                    "id": "698571112",
                                                                    "text": "Learn \"cooking\"...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698571113",
                                                                            "speaker": "Clorinde",
                                                                            "text": "Very well. In that case, you want to learn the \"cooking\" skill, yes?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698571116",
                                                                                    "text": "I'm sure."
                                                                                },
                                                                                {
                                                                                    "id": "698571117",
                                                                                    "text": "Let me reconsider..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698571114",
                                                                    "text": "Learn \"medicine\"...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698571115",
                                                                            "speaker": "Clorinde",
                                                                            "text": "Very well. In that case, you wish to learn the \"medicine\" skill, yes?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698571116",
                                                                                    "text": "I'm sure."
                                                                                },
                                                                                {
                                                                                    "id": "698571117",
                                                                                    "text": "Let me reconsider..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698571109",
                                                    "text": "I'll join, I'll join—"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698571106",
                                    "text": "Continue the adventure? Are we continuing from that last..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698571015",
                    "text": "And Clorinde?"
                }
            ]
        }
    ]
}