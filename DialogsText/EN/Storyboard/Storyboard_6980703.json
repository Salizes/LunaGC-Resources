{
    "talkId": "6980703",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Chongyun": 13,
        "Player": 24,
        "Xingqiu": 31
    },
    "dialogues": [
        {
            "id": "698070301",
            "speaker": "Xingqiu",
            "text": "Okay, alright, no need to bring this up again..."
        },
        {
            "id": "698070302",
            "speaker": "Chongyun",
            "text": "But this is an emergency! If this doesn't work out, I'll ask my aunt for help."
        },
        {
            "id": "698070303",
            "speaker": "Xingqiu",
            "text": "You mean Miss Shenhe? No, no, please don't drag anyone else into this. Otherwise, I...",
            "choices": [
                {
                    "id": "698070304",
                    "text": "Run into trouble?",
                    "response": [
                        {
                            "id": "698070306",
                            "speaker": "Xingqiu",
                            "text": "#{NICKNAME}! You... Uh, well! What perfect... timing... you have.",
                            "choices": [
                                {
                                    "id": "698070307",
                                    "text": "Hmm? You're here too, Chongyun?",
                                    "response": [
                                        {
                                            "id": "698070309",
                                            "speaker": "Xingqiu",
                                            "text": "I fear this affair is a bit more complicated than that..."
                                        },
                                        {
                                            "id": "698070310",
                                            "speaker": "Xingqiu",
                                            "text": "Do you still remember the novel that I wrote under the pen-name \"Zhenyu\"?"
                                        },
                                        {
                                            "id": "698070311",
                                            "speaker": "Xingqiu",
                                            "text": "Um, I'm ashamed to admit this, but my handwriting is so... messy... that every time I send the editors a manuscript, they will send several letters in reply, asking me about this word or that sentence."
                                        },
                                        {
                                            "id": "698070312",
                                            "speaker": "Xingqiu",
                                            "text": "Correspondence like that takes too much time, so the editorial department and I agreed that I should try to finish a few days early."
                                        },
                                        {
                                            "id": "698070313",
                                            "speaker": "Xingqiu",
                                            "text": "After I finish, I submit it to the department and have an editor re-transcribe the text for me. Then, it is handed over to the other editors to print and publish."
                                        },
                                        {
                                            "id": "698070314",
                                            "speaker": "Player",
                                            "text": "Sounds like quite the ordeal..."
                                        },
                                        {
                                            "id": "698070315",
                                            "speaker": "Xingqiu",
                                            "text": "Indeed. I... I also feel pretty bad about the whole thing, so I often send them snacks as a token of my gratitude."
                                        },
                                        {
                                            "id": "698070316",
                                            "speaker": "Xingqiu",
                                            "text": "But then... I received a letter from them a few days ago. As it happens, that main editor has suddenly fallen ill, and now, there's nobody else that can do the transcribing...",
                                            "choices": [
                                                {
                                                    "id": "698070317",
                                                    "text": "Wait, with such a well-staffed department...",
                                                    "response": [
                                                        {
                                                            "id": "698070319",
                                                            "speaker": "Xingqiu",
                                                            "text": "*cough* Yes...",
                                                            "choices": [
                                                                {
                                                                    "id": "698070320",
                                                                    "text": "Really!? Seriously, just one of them!?",
                                                                    "response": [
                                                                        {
                                                                            "id": "698070322",
                                                                            "speaker": "Xingqiu",
                                                                            "text": "*sigh* Please, don't make fun of me..."
                                                                        },
                                                                        {
                                                                            "id": "698070323",
                                                                            "speaker": "Player",
                                                                            "text": "So, how's Chongyun's penmanship?"
                                                                        },
                                                                        {
                                                                            "id": "698070324",
                                                                            "speaker": "Chongyun",
                                                                            "text": "#See, that was {M#his}{F#her} first reaction too..."
                                                                        },
                                                                        {
                                                                            "id": "698070325",
                                                                            "speaker": "Xingqiu",
                                                                            "text": "No, no, no! Absolutely not! Stop bringing that up!"
                                                                        },
                                                                        {
                                                                            "id": "698070326",
                                                                            "speaker": "Player",
                                                                            "text": "Wait, does this mean that Chongyun's handwriting is also..."
                                                                        },
                                                                        {
                                                                            "id": "698070327",
                                                                            "speaker": "Xingqiu",
                                                                            "text": "Not at all. His writing is lovely. If anything, his talismans look better than my prose..."
                                                                        },
                                                                        {
                                                                            "id": "698070328",
                                                                            "speaker": "Player",
                                                                            "text": "Then why didn't you ask him for help?"
                                                                        },
                                                                        {
                                                                            "id": "698070329",
                                                                            "speaker": "Xingqiu",
                                                                            "text": "I... You... He... Well..."
                                                                        },
                                                                        {
                                                                            "id": "698070330",
                                                                            "speaker": "Chongyun",
                                                                            "text": "I suggested that to him that as well, and at first, he agreed to let me transcribe his work."
                                                                        },
                                                                        {
                                                                            "id": "698070331",
                                                                            "speaker": "Chongyun",
                                                                            "text": "But before I could copy more than a few sections, Xingqiu suddenly grabbed me by the shoulder and began shaking me and telling me to stop."
                                                                        },
                                                                        {
                                                                            "id": "698070332",
                                                                            "speaker": "Chongyun",
                                                                            "text": "For a moment, I wondered if my penmanship was terrible or something, but he suddenly blurted..."
                                                                        },
                                                                        {
                                                                            "id": "698070333",
                                                                            "speaker": "Xingqiu",
                                                                            "text": "Y—You... Just transcribing is one thing, wh—why did you have to suddenly start reading it out loud as you wrote?"
                                                                        },
                                                                        {
                                                                            "id": "698070334",
                                                                            "speaker": "Chongyun",
                                                                            "text": "Hmm? Well, because I think your writing is excellent. The narrative is interesting, and each character even has their own catchphrases... Catch-poems? Anyway, I couldn't help but read it all aloud."
                                                                        },
                                                                        {
                                                                            "id": "698070335",
                                                                            "speaker": "Chongyun",
                                                                            "text": "Especially when the heroine named the Flying Fox took the antidote down the mountain. You wrote a poetic header for that too, didn't you? As I recall, it was..."
                                                                        },
                                                                        {
                                                                            "id": "698070336",
                                                                            "speaker": "Chongyun",
                                                                            "text": "\"Clothes stained with wine and mortal sod, unwelcome in sword-realms the world she trod...\""
                                                                        },
                                                                        {
                                                                            "id": "698070337",
                                                                            "speaker": "Xingqiu",
                                                                            "text": "Y—Y—You... Chongyun, please, just... stop...",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698070338",
                                                                                    "text": "\"Clothes stained with wine and mortal sod...\"",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698070341",
                                                                                            "speaker": "Chongyun",
                                                                                            "text": "That said, while the story itself is good, it's also quite complex. I found myself failing to understand a lot of the details."
                                                                                        },
                                                                                        {
                                                                                            "id": "698070342",
                                                                                            "speaker": "Chongyun",
                                                                                            "text": "For example, why the Drunken Sage suddenly agreed to help, and how the Thirteen Blades of the Drunken Sect that belonged to him were stolen..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698070343",
                                                                                            "speaker": "Player",
                                                                                            "text": "It all sounds very interesting."
                                                                                        },
                                                                                        {
                                                                                            "id": "698070344",
                                                                                            "speaker": "Chongyun",
                                                                                            "text": "Right? Xingqiu writes amazing novels, and he's also penned quite a few excellent short stories besides, such as..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698070345",
                                                                                            "speaker": "Chongyun",
                                                                                            "text": "Wait. Why's your face so red, Xingqiu?",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698070346",
                                                                                                    "text": "His yang energy seems to be surging too.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698070348",
                                                                                                            "speaker": "Xingqiu",
                                                                                                            "text": "Pl—Please, you two, have mercy on me, I beg you... If you say any more, I fear my fingers shall crush the hilt of my sword..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698070349",
                                                                                                            "speaker": "Xingqiu",
                                                                                                            "text": "I'd rather attend half a dozen social banquets than listen to people I know read my work back to me!",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "698070350",
                                                                                                                    "text": "Alright, alright, I'll stop.",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "698070352",
                                                                                                                            "speaker": "Xingqiu",
                                                                                                                            "text": "A typewriter? I've heard of those — they're wondrous machines from Fontaine, yes?"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070353",
                                                                                                                            "speaker": "Player",
                                                                                                                            "text": "With one in hand, you shall be free from writing by hand."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070354",
                                                                                                                            "speaker": "Xingqiu",
                                                                                                                            "text": "Truly? That is wonderful news! I look forward to being forever liberated from the tyranny of calligraphy."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070355",
                                                                                                                            "speaker": "Xingqiu",
                                                                                                                            "text": "The ingenious inventions of Fontaine are truly something... I usually only ever hear of them from my brother, yet never had the chance to touch them myself..."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070356",
                                                                                                                            "speaker": "Xingqiu",
                                                                                                                            "text": "...Wait. Hold on. Doesn't my brother often go with our caravans to Fontaine? He must've heard of typewriters, surely."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070357",
                                                                                                                            "speaker": "Xingqiu",
                                                                                                                            "text": "He knows my calligraphy is poor, and that I'm always writing, and yet... he has never once mentioned them to me..."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698070358",
                                                                                                                            "speaker": "Xingqiu",
                                                                                                                            "text": "Forget it, now's not the time to worry about things like that. In any case, no matter how marvelous such devices are, there's no way for me to borrow one right now.",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "698070359",
                                                                                                                                    "text": "If all else fails, you can read, and I'll write.",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "698070361",
                                                                                                                                            "speaker": "Xingqiu",
                                                                                                                                            "text": "Well... At this point... That does seem like the only way..."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070362",
                                                                                                                                            "speaker": "Xingqiu",
                                                                                                                                            "text": "I was just joking before about incorporating your remarks into a novel, but as it turns out, you'll be the one committing mine to paper..."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070363",
                                                                                                                                            "speaker": "Xingqiu",
                                                                                                                                            "text": "*sigh* Perhaps this was all predetermined..."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070364",
                                                                                                                                            "speaker": "Player",
                                                                                                                                            "text": "Call it fate."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070365",
                                                                                                                                            "speaker": "Xingqiu",
                                                                                                                                            "text": "Y—Yes, I suppose ours are intertwined indeed..."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070366",
                                                                                                                                            "speaker": "Xingqiu",
                                                                                                                                            "text": "I'll go back and organize the manuscript. Once I'm done, I'll invite you over so I can dictate the text to you."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070367",
                                                                                                                                            "speaker": "Chongyun",
                                                                                                                                            "text": "Once you're done, would you mind showing it to me? I'm really quite curious about the Flying Fox..."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698070368",
                                                                                                                                            "speaker": "Xingqiu",
                                                                                                                                            "text": "Chongyun, please, spare me already..."
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "698070360",
                                                                                                                                    "text": "I promise not to ask too many unnecessary questions."
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "698070351",
                                                                                                                    "text": "Tell you what, I'll go borrow a typewriter for you."
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698070347",
                                                                                                    "text": "Did he eat a few chilis while we weren't looking?"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698070339",
                                                                                    "text": "\"Unwelcome in sword-realms the world she trod...\""
                                                                                },
                                                                                {
                                                                                    "id": "698070340",
                                                                                    "text": "Well written indeed! Is there more? I want to read it!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698070321",
                                                                    "text": "Your writing truly is a lethal weapon in and of itself..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698070318",
                                                    "text": "Only one of them can read your handwriting?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698070308",
                                    "text": "Are we going on an evil spirit hunt or something?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698070305",
                    "text": "Here I come to save the day!"
                }
            ]
        }
    ]
}