{
    "talkId": "6984801",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "Layla": 15,
        "Player": 12,
        "Yumemizuki Mizuki": 13
    },
    "dialogues": [
        {
            "id": "698480101",
            "speaker": "Layla",
            "text": "No, no, that's no good! The abstract needs to be more detailed..."
        },
        {
            "id": "698480102",
            "speaker": "Yumemizuki Mizuki",
            "text": "Excuse me, Ms. Layla..."
        },
        {
            "id": "698480103",
            "speaker": "Layla",
            "text": "But if we go too in-depth, it might come off as indistinct from the main body... *sigh* ... How am I going to do this..."
        },
        {
            "id": "698480104",
            "speaker": "Yumemizuki Mizuki",
            "text": "Miss Layla, shall we... discuss this inside? We can sit down and chat."
        },
        {
            "id": "698480105",
            "speaker": "Layla",
            "text": "Eh!? Sorry, so sorry! I didn't mean to spiral. I just couldn't help thinking about my thesis again..."
        },
        {
            "id": "698480106",
            "speaker": "Yumemizuki Mizuki",
            "text": "It's fine. I've treated several Akademiya students before. You can say I've encountered... similar states of mind to yours."
        },
        {
            "id": "698480107",
            "speaker": "Layla",
            "text": "You've been to Sumeru?"
        },
        {
            "id": "698480108",
            "speaker": "Yumemizuki Mizuki",
            "text": "Yes. A scholar there once invited me to help treat his students."
        },
        {
            "id": "698480109",
            "speaker": "Layla",
            "text": "R—Really...? Um, did any of them have severe issues...?"
        },
        {
            "id": "698480110",
            "speaker": "Yumemizuki Mizuki",
            "text": "I wouldn't go that far. Just long-term insomnia, terror, paranoia, as well as acute tinnitus and vertigo...",
            "choices": [
                {
                    "id": "698480111",
                    "text": "Are you describing thesis-writing...",
                    "response": [
                        {
                            "id": "698480113",
                            "speaker": "Layla",
                            "text": "I'd rather face the monsters..."
                        },
                        {
                            "id": "698480114",
                            "speaker": "Layla",
                            "text": "If you succeed, then all is well! If you fail... at least you'll never worry about anything else again."
                        },
                        {
                            "id": "698480115",
                            "speaker": "Layla",
                            "text": "B—But... a thesis... I don't even know what counts as success or failure."
                        },
                        {
                            "id": "698480116",
                            "speaker": "Layla",
                            "text": "I'd finally squeezed a third draft out, but upon seeing it, my advisor just flipped it facedown on the desk and said:"
                        },
                        {
                            "id": "698480117",
                            "speaker": "Layla",
                            "text": "\"Forget your thesis for now. First, you need to go to Aisa Bathhouse in Inazuma. Relax and recover a bit. I've already made the arrangements for you.\"",
                            "choices": [
                                {
                                    "id": "698480118",
                                    "text": "Your advisor sounds really nice...",
                                    "response": [
                                        {
                                            "id": "698480120",
                                            "speaker": "Yumemizuki Mizuki",
                                            "text": "That's correct. I received a letter from Miss Layla's advisor in advance, with details about her situation and a request to provide therapy for her."
                                        },
                                        {
                                            "id": "698480121",
                                            "speaker": "Yumemizuki Mizuki",
                                            "text": "I think it's quite likely that a mutual acquaintance shared my contact information."
                                        },
                                        {
                                            "id": "698480122",
                                            "speaker": "Layla",
                                            "text": "No, things can't be that simple... My thesis isn't done, we've just started our research topic, and I have a pile of unsubmitted work for my research group..."
                                        },
                                        {
                                            "id": "698480123",
                                            "speaker": "Layla",
                                            "text": "Maybe my advisor thinks I'm totally useless, and... and wants to get rid of me...",
                                            "choices": [
                                                {
                                                    "id": "698480124",
                                                    "text": "Layla! Snap out of it!",
                                                    "response": [
                                                        {
                                                            "id": "698480126",
                                                            "speaker": "Layla",
                                                            "text": "This must be my advisor's last gift... The last bath I'll ever take..."
                                                        },
                                                        {
                                                            "id": "698480127",
                                                            "speaker": "Layla",
                                                            "text": "Once I return to the Akademiya... I'll be expelled... and then left alone in a corner, doing star charts... Doing star charts forever...",
                                                            "choices": [
                                                                {
                                                                    "id": "698480128",
                                                                    "text": "No way! That's not gonna happen!",
                                                                    "response": [
                                                                        {
                                                                            "id": "698480130",
                                                                            "speaker": "Yumemizuki Mizuki",
                                                                            "text": "(...It's just as the letter said. Her symptoms are extremely severe. How long has she had this condition?)"
                                                                        },
                                                                        {
                                                                            "id": "698480131",
                                                                            "speaker": "Yumemizuki Mizuki",
                                                                            "text": "(However, her advisor's letter clearly acknowledges her abilities, emphasizing constantly that she is their most outstanding student.)"
                                                                        },
                                                                        {
                                                                            "id": "698480132",
                                                                            "speaker": "Yumemizuki Mizuki",
                                                                            "text": "(Perhaps it's Layla who doesn't believe in her own abilities, thus triggering these symptoms... Evidently, a more thorough evaluation is required...)"
                                                                        },
                                                                        {
                                                                            "id": "698480133",
                                                                            "speaker": "Layla",
                                                                            "text": "Excuse me... I'm going in now... If there's any letters for me, please sign for them...",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698480134",
                                                                                    "text": "Why does it feel like...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698480136",
                                                                                            "speaker": "Yumemizuki Mizuki",
                                                                                            "text": "...",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698480137",
                                                                                                    "text": "Please help her, Mizuki!",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698480139",
                                                                                                            "speaker": "Yumemizuki Mizuki",
                                                                                                            "text": "Don't worry, I will help her. In fact, I've already come up with a preliminary treatment plan."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698480140",
                                                                                                            "speaker": "Yumemizuki Mizuki",
                                                                                                            "text": "...Now, time to formally begin treatment."
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698480138",
                                                                                                    "text": "Think of something, Mizuki!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698480135",
                                                                                    "text": "Her condition's worsened..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698480129",
                                                                    "text": "Get a hold of yourself, Layla!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698480125",
                                                    "text": "Th—The light's left her eyes..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698480119",
                                    "text": "It's good to kick back and relax now and then."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698480112",
                    "text": "Or monster-slaying..."
                }
            ]
        }
    ]
}