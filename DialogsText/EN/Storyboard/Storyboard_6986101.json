{
    "talkId": "6986101",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Mika": 21,
        "Player": 12
    },
    "dialogues": [
        {
            "id": "698610101",
            "speaker": "Mika",
            "text": "This should just about do it...",
            "choices": [
                {
                    "id": "698610102",
                    "text": "Mika? What brings you here?",
                    "response": [
                        {
                            "id": "698610104",
                            "speaker": "Mika",
                            "text": "#{NICKNAME}? Hello, I didn't think I'd run into you here."
                        },
                        {
                            "id": "698610105",
                            "speaker": "Mika",
                            "text": "Um, right... I should've realized. Master Jean told me you'd be here, we just didn't know when you'd arrive."
                        },
                        {
                            "id": "698610106",
                            "speaker": "Mika",
                            "text": "I didn't expect to run into you as soon as I set foot in Nod-Krai!",
                            "choices": [
                                {
                                    "id": "698610107",
                                    "text": "The Knights of Favonius knew I'd be coming?",
                                    "response": [
                                        {
                                            "id": "698610109",
                                            "speaker": "Mika",
                                            "text": "Yes! The Grand Master sent you a letter, didn't he? He also sent one back to Mondstadt, telling us all about how you were doing."
                                        },
                                        {
                                            "id": "698610110",
                                            "speaker": "Mika",
                                            "text": "Of course, all the Knights back home are still figuring out how to support you, but the Grand Master wrote that we shouldn't be hasty, and that he already had everything in hand...",
                                            "choices": [
                                                {
                                                    "id": "698610111",
                                                    "text": "Things were indeed in order. Don't worry.",
                                                    "response": [
                                                        {
                                                            "id": "698610113",
                                                            "speaker": "Mika",
                                                            "text": "Yep, the Grand Master's always reliable when it comes to important business. So when he says he'll handle something, we know we can count on him."
                                                        },
                                                        {
                                                            "id": "698610114",
                                                            "speaker": "Mika",
                                                            "text": "But of course, if you run into any trouble, remember that the Knights will always be there to help you. Feel free to come look for us whenever."
                                                        },
                                                        {
                                                            "id": "698610115",
                                                            "speaker": "Mika",
                                                            "text": "After all, you're our Honorary Knight, a valued member of our order!"
                                                        },
                                                        {
                                                            "id": "698610116",
                                                            "speaker": "Mika",
                                                            "text": "That's what Master Jean told me to tell you when I departed from Mondstadt.",
                                                            "choices": [
                                                                {
                                                                    "id": "698610117",
                                                                    "text": "In that case, I'd like some apple cider.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698610119",
                                                                            "speaker": "Mika",
                                                                            "text": "Huh? U—Um, give me a moment! I didn't bring any Sweet Madame with me, but I do happen to have a bottle of our best cider."
                                                                        },
                                                                        {
                                                                            "id": "698610120",
                                                                            "speaker": "Mika",
                                                                            "text": "Captain Kaeya asked me to bring it along. He knew you'd miss it. Guess he was right!",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698610121",
                                                                                    "text": "Kaeya thought of even that...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698610123",
                                                                                            "speaker": "Mika",
                                                                                            "text": "Oookay, I need a minute... I put it in my backpack and wrapped it in clothes..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698610124",
                                                                                            "speaker": "Mika",
                                                                                            "text": "Here it is! Go on, have a taste.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698610125",
                                                                                                    "text": "You didn't bring some for the Grand Master?",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698610127",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "I did, of course! When I was leaving, the Grand Master specifically asked me to bring some bottles of our very best Dandelion Wine for him."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610128",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "At first, Master Jean protested that my main objective on this long journey was to deliver letters to Nod-Krai, and she'd rather I not overload my luggage. She said someone else could transport it later..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610129",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "But after giving it much thought, I packed two bottles of wine for the Grand Master anyway."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610130",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "Otherwise, he'd be talking my ear off about how wonderful Dandelion Wine is while waiting for it to get delivered..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610131",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "Oh, right! If you crave fresh Sweet Madames and steak, do come back and visit the Knights of Favonius' headquarters when you're free."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610132",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "Hehe, that was what Amber wanted me to tell you."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698610133",
                                                                                                            "speaker": "Mika",
                                                                                                            "text": "And that's all the messages I have for you. I should get going. Farewell, Honorary Knight!"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698610126",
                                                                                                    "text": "I heard he loves his liquor."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698610122",
                                                                                    "text": "I'd expect nothing less from his razor-sharp mind!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698610118",
                                                                    "text": "In that case, I'd like some Sweet Madame."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698610112",
                                                    "text": "He even got me some amazing accommodations."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698610108",
                                    "text": "Did Grand Master Varka..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698610103",
                    "text": "Are you out delivering letters again?"
                }
            ]
        }
    ]
}