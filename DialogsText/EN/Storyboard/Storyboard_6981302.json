{
    "talkId": "6981302",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Paimon": 7,
        "Player": 21,
        "Qiqi": 5,
        "Zibai": 26
    },
    "dialogues": [
        {
            "id": "698130201",
            "speaker": "Qiqi",
            "text": "...You can reach the main road from here. The road is wide. Very wide. You won't get lost."
        },
        {
            "id": "698130202",
            "speaker": "Zibai",
            "text": "My thanks, child. As I recall, you live at the Bubu Pharmacy, yes? I've seen you in the city."
        },
        {
            "id": "698130203",
            "speaker": "Qiqi",
            "text": "Yes. But my memory isn't good. I've forgotten you... Sorry for forgetting."
        },
        {
            "id": "698130204",
            "speaker": "Qiqi",
            "text": "Mm... I need to go gather herbs. Dr. Baizhu is waiting, so I have to leave."
        },
        {
            "id": "698130205",
            "speaker": "Zibai",
            "text": "Huh? Miss Qiqi, please wait, I..."
        },
        {
            "id": "698130206",
            "speaker": "Player",
            "text": "(Eh? That's Qiqi and...)"
        },
        {
            "id": "698130207",
            "speaker": "Paimon",
            "text": "Zibai. What an odd combination...",
            "choices": [
                {
                    "id": "698130208",
                    "text": "(Anyway, let's see how things play out first...)",
                    "response": [
                        {
                            "id": "698130210",
                            "speaker": "Paimon",
                            "text": "Okay, okay, ugh... Why are we being all sneaky, anyway? There's no way we can hide from..."
                        },
                        {
                            "id": "698130211",
                            "speaker": "Player",
                            "text": "(Shh...)"
                        },
                        {
                            "id": "698130212",
                            "speaker": "Qiqi",
                            "text": "If... If you need medicine, Dr. Baizhu is at the pharmacy. Please go there."
                        },
                        {
                            "id": "698130213",
                            "speaker": "Qiqi",
                            "text": "I—I'm sorry, but I really did forget you. I really need to go gather herbs now. Goodbye..."
                        },
                        {
                            "id": "698130214",
                            "speaker": "Zibai",
                            "text": "*sigh* How did this come to pass..."
                        },
                        {
                            "id": "698130215",
                            "speaker": "Zibai",
                            "text": "#{NICKNAME}, Paimon, do come out. You must have questions for me too."
                        },
                        {
                            "id": "698130216",
                            "speaker": "Player",
                            "text": "You knew we were here?"
                        },
                        {
                            "id": "698130217",
                            "speaker": "Paimon",
                            "text": "Told ya there was no way we could hide anything from Zibai... That said, why were you with Qiqi?"
                        },
                        {
                            "id": "698130218",
                            "speaker": "Player",
                            "text": "You didn't actually get lost, did you?"
                        },
                        {
                            "id": "698130219",
                            "speaker": "Zibai",
                            "text": "No, I did not. I was looking for the right moment to meet with young Qiqi in private."
                        },
                        {
                            "id": "698130220",
                            "speaker": "Zibai",
                            "text": "Never could I have imagined that such an \"adeptus\" might exist... One with an adeptal body, but no spirit to match. That absence must be the cause of her forgetful nature...",
                            "choices": [
                                {
                                    "id": "698130221",
                                    "text": "So you've figured out the whys and wherefores of this mystery?",
                                    "response": [
                                        {
                                            "id": "698130223",
                                            "speaker": "Zibai",
                                            "text": "I fear someone has already tried once before in secret. I am well-acquainted with the arts involved in the sigil on her head — it is a spell that bestills the soul."
                                        },
                                        {
                                            "id": "698130224",
                                            "speaker": "Zibai",
                                            "text": "Without it, Miss Qiqi's spirit would have been drained away long ago, turning her into an unfeeling, unconscious puppet.",
                                            "choices": [
                                                {
                                                    "id": "698130225",
                                                    "text": "Wait, you're familiar with that sigil?",
                                                    "response": [
                                                        {
                                                            "id": "698130227",
                                                            "speaker": "Zibai",
                                                            "text": "...Spellwork of the Three Deadly Selves."
                                                        },
                                                        {
                                                            "id": "698130228",
                                                            "speaker": "Paimon",
                                                            "text": "W—Wait a sec. You mean the sigil on her head involves similar techniques to the one you used?",
                                                            "choices": [
                                                                {
                                                                    "id": "698130229",
                                                                    "text": "That means...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698130231",
                                                                            "speaker": "Zibai",
                                                                            "text": "Indeed. She has also had her Three Deadly Selves severed. Having traveled with and observed her carefully, I perceive only one Deadly Self remaining in her present body."
                                                                        },
                                                                        {
                                                                            "id": "698130232",
                                                                            "speaker": "Zibai",
                                                                            "text": "Although I cannot determine which one it is exactly, this Self is also incomplete. It was shattered by an external force before being reassembled by someone through some intricate spellcraft..."
                                                                        },
                                                                        {
                                                                            "id": "698130233",
                                                                            "speaker": "Zibai",
                                                                            "text": "Heh, though it might not necessarily be a \"person\"... Perhaps some adeptus used their powers to pull Qiqi's soul together before using sigils to stabilize and nurture it.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698130234",
                                                                                    "text": "...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698130236",
                                                                                            "speaker": "Zibai",
                                                                                            "text": "Only she would know. It is no habit of mine to pry into others' personal affairs. However...",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "698130237",
                                                                                                    "text": "However?",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "698130239",
                                                                                                            "speaker": "Zibai",
                                                                                                            "text": "I sense intense fetor within Miss Qiqi's body.",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "698130240",
                                                                                                                    "text": "Could it be from that time during Lantern Rite...",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "698130242",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Ah...! Paimon remembers! Back then, Qiqi inhaled so much fetor that she almost fell asleep!"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130243",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "I see... Since she was already bereft of spirit, the fetor entered her body like an invader into territory unguarded."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130244",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "Had the sigil not aided in stabilizing her soul, her spirit might have fled right then and there."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130245",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "...But though it held the fetor back, the sigil's adeptal power was also greatly depleted."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130246",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "Said sigil was already like water cut off from its source. Once imbued by its creator with profound adeptal power... barely a tenth of it remains today."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130247",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "And with the fetor entering her body as you mentioned... I'm afraid the sigil's power shall soon be depleted."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130248",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "I suppose that explains the sudden arrival of two adepti at Bubu Pharmacy... They must have sensed something as well."
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130249",
                                                                                                                            "speaker": "Paimon",
                                                                                                                            "text": "Two of 'em? You mean Xianyun and Madame Ping?"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "698130250",
                                                                                                                            "speaker": "Zibai",
                                                                                                                            "text": "No, I would have known if it were them. The two I speak of were a bird and a deer who took the forms of human men before entering the city...",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "698130251",
                                                                                                                                    "text": "Mountain Shaper...",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "698130253",
                                                                                                                                            "speaker": "Zibai",
                                                                                                                                            "text": "#Ah, so that is what they are called. Thank you, {NICKNAME}."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130254",
                                                                                                                                            "speaker": "Zibai",
                                                                                                                                            "text": "Since we are all here to aid Miss Qiqi, perhaps I should go and meet them."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130255",
                                                                                                                                            "speaker": "Zibai",
                                                                                                                                            "text": "...Yes. No time like the present, as they say. I shall set off shortly to pay them a visit at their abodes."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130256",
                                                                                                                                            "speaker": "Player",
                                                                                                                                            "text": "And be sure to hit me up if you need any additional help!"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130257",
                                                                                                                                            "speaker": "Paimon",
                                                                                                                                            "text": "Paimon too!"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130258",
                                                                                                                                            "speaker": "Zibai",
                                                                                                                                            "text": "Hehe. Worry not. Miss Qiqi will be more than alright."
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "698130259",
                                                                                                                                            "speaker": "Zibai",
                                                                                                                                            "text": "Still, to see such a sophisticated version of the Three Deadly Selves technique in action... Who might it have been?"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "698130252",
                                                                                                                                    "text": "Moon Carver..."
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "698130241",
                                                                                                                    "text": "Did that happen when we entered the \"border between life and death\"...!?"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "698130238",
                                                                                                    "text": "Is there something wrong with Qiqi? Some sort of problem?"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698130235",
                                                                                    "text": "What happened to Qiqi back then..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698130230",
                                                                    "text": "Qiqi is like you..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698130226",
                                                    "text": "Then it must be..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698130222",
                                    "text": "Can you help treat Qiqi?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698130209",
                    "text": "(Fly lower, Paimon.)"
                }
            ]
        }
    ]
}