{
    "talkId": "6983702",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Cyno": 10,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "698370201",
            "speaker": "Cyno",
            "text": "...This should be enough bark samples. Next... soil collection.",
            "choices": [
                {
                    "id": "698370202",
                    "text": "Whatcha doing?",
                    "response": [
                        {
                            "id": "698370204",
                            "speaker": "Cyno",
                            "text": "I came here to assist Tighnari with collecting plant samples. He directed me to come collect bark around here."
                        },
                        {
                            "id": "698370205",
                            "speaker": "Cyno",
                            "text": "But these trees are covered in mushrooms, and I have to clear them away. It's not easy."
                        },
                        {
                            "id": "698370206",
                            "speaker": "Cyno",
                            "text": "I can't help but wonder just how these mushrooms got to that size.",
                            "choices": [
                                {
                                    "id": "698370207",
                                    "text": "Environmental factors?",
                                    "response": [
                                        {
                                            "id": "698370209",
                                            "speaker": "Cyno",
                                            "text": "Right. Tighnari also talked about how the environmental factors influencing the growth of fungi are extremely complex and varied, each interacting with the others."
                                        },
                                        {
                                            "id": "698370210",
                                            "speaker": "Cyno",
                                            "text": "Even the smallest change in one variable can greatly impact their growth process...",
                                            "choices": [
                                                {
                                                    "id": "698370211",
                                                    "text": "I thought you were from Spantamad, Cyno.",
                                                    "response": [
                                                        {
                                                            "id": "698370213",
                                                            "speaker": "Cyno",
                                                            "text": "No, I've simply been pondering a question these past few days."
                                                        },
                                                        {
                                                            "id": "698370214",
                                                            "speaker": "Cyno",
                                                            "text": "#{NICKNAME}, do you know why fungi only grow on trees and not on grilled meat?"
                                                        },
                                                        {
                                                            "id": "698370215",
                                                            "speaker": "Player",
                                                            "text": "Hmmm... Eh?"
                                                        },
                                                        {
                                                            "id": "698370216",
                                                            "speaker": "Cyno",
                                                            "text": "Because that's what they've always done. They're all..."
                                                        },
                                                        {
                                                            "id": "698370217",
                                                            "speaker": "Cyno",
                                                            "text": "Vegetarians."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698370212",
                                                    "text": "Since when are you this interested in Amurta's work?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698370208",
                                    "text": "The climate, perhaps..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698370203",
                    "text": "Mushroom picking, are we?"
                }
            ]
        }
    ]
}