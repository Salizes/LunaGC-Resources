{
    "talkId": "6985504",
    "total_dialogue_lines": 45,
    "speaker_counts": {
        "Aino": 18,
        "Ineffa": 13,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "698550401",
            "speaker": "Aino",
            "text": "Almost... There. That should do it. Once Ineffa wakes up, I'm treating myself to three whole slices of cake!"
        },
        {
            "id": "698550402",
            "speaker": "Player",
            "text": "Aino? What's wrong with Ineffa?"
        },
        {
            "id": "698550403",
            "speaker": "Aino",
            "text": "Oh hey, are you here to play? Sorry, but I'm busy right now! Just give me a bit, I'll be done soon!"
        },
        {
            "id": "698550404",
            "speaker": "Aino",
            "text": "Ineffa's fine, by the way. Just undergoing some routine maintenance."
        },
        {
            "id": "698550405",
            "speaker": "Aino",
            "text": "But a few days ago, Jahoda called her an \"unfunny, dumb-dumb metalface lunkhead.\" Right before starting her maintenance, she asked me if I could upgrade her sense of humor.",
            "choices": [
                {
                    "id": "698550406",
                    "text": "Ineffa's fine as she is, humor or no.",
                    "response": [
                        {
                            "id": "698550407",
                            "speaker": "Aino",
                            "text": "Yeah! Glad we're on the same page. Ineffa's the best!"
                        },
                        {
                            "id": "698550410",
                            "speaker": "Aino",
                            "text": "Okay, I'm going to activate her. Ineffa, wake up! Time to get out of bed."
                        },
                        {
                            "id": "698550411",
                            "speaker": "Ineffa",
                            "text": "#Good morning, Aino. Good morning, {NICKNAME}. Aino, have you managed to upgrade my sense of humor?"
                        },
                        {
                            "id": "698550412",
                            "speaker": "Aino",
                            "text": "Duh! Such a trivial task is nothing to a genius like me! Now, time to do some testing to see if the upgrade's resulted in any hiccups..."
                        },
                        {
                            "id": "698550413",
                            "speaker": "Aino",
                            "text": "Ineffa! Can you add more sugar to my krumkakes? Please respond to me in a way that is humorous."
                        },
                        {
                            "id": "698550414",
                            "speaker": "Ineffa",
                            "text": "I cannot. The more sugar I put into a krumkake, the less sugar the krumkake will have."
                        },
                        {
                            "id": "698550415",
                            "speaker": "Player",
                            "text": "Come again?"
                        },
                        {
                            "id": "698550416",
                            "speaker": "Aino",
                            "text": "What?"
                        },
                        {
                            "id": "698550417",
                            "speaker": "Ineffa",
                            "text": "The more sugar I put into a krumkake, the more prone Aino will be to toothaches. The more toothaches she has, the less sugar she can consume."
                        },
                        {
                            "id": "698550445",
                            "speaker": "Ineffa",
                            "text": "The less sugar she can consume, the less sugar I can add to the krumkakes."
                        },
                        {
                            "id": "698550418",
                            "speaker": "Ineffa",
                            "text": "Therefore: The more sugar I put into a krumkake, the less sugar the krumkake will have.",
                            "choices": [
                                {
                                    "id": "698550419",
                                    "text": "I... I don't think that's how it works...",
                                    "response": [
                                        {
                                            "id": "698550421",
                                            "speaker": "Aino",
                                            "text": "Okay, that's not supposed to happen... Help me with another test, will ya?",
                                            "choices": [
                                                {
                                                    "id": "698550422",
                                                    "text": "If you add a lot of sugar into the krumkakes and make Aino eat sweet things...",
                                                    "response": [
                                                        {
                                                            "id": "698550424",
                                                            "speaker": "Ineffa",
                                                            "text": "#If it stays bad for a while, {NICKNAME} will crack a smile."
                                                        },
                                                        {
                                                            "id": "698550425",
                                                            "speaker": "Player",
                                                            "text": "I'll what now?"
                                                        },
                                                        {
                                                            "id": "698550426",
                                                            "speaker": "Aino",
                                                            "text": "...What?",
                                                            "choices": [
                                                                {
                                                                    "id": "698550427",
                                                                    "text": "If this sense of humor's your speed...",
                                                                    "response": [
                                                                        {
                                                                            "id": "698550429",
                                                                            "speaker": "Ineffa",
                                                                            "text": "You are not laughing, so I suspect I was not understood. Actually, the first joke I told used a deliberately flawed chain of logic."
                                                                        },
                                                                        {
                                                                            "id": "698550430",
                                                                            "speaker": "Ineffa",
                                                                            "text": "After confusing the relative relationships between krumkakes, sugar, Aino, and Aino's dental health, I drew a ridiculous conclusion: That the more sugar I put into a krumkake, the less sugar the krumkake will have."
                                                                        },
                                                                        {
                                                                            "id": "698550431",
                                                                            "speaker": "Ineffa",
                                                                            "text": "For the second joke, I used a rhyme scheme between the similar-sounding phrases, \"bad for a while\" and \"crack a smile,\" to express humor."
                                                                        },
                                                                        {
                                                                            "id": "698550432",
                                                                            "speaker": "Aino",
                                                                            "text": "...Oookay... Well, the jokes are funny, but the punchlines don't work if they aren't explained."
                                                                        },
                                                                        {
                                                                            "id": "698550433",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Yes. However, according to my database queries, such statements are considered humorous due to their chaotic structure and lack of direct causal relationships."
                                                                        },
                                                                        {
                                                                            "id": "698550434",
                                                                            "speaker": "Ineffa",
                                                                            "text": "Such chaotic sentences serve as a form of guidepost, while the humor lies in the explanation that follows."
                                                                        },
                                                                        {
                                                                            "id": "698550435",
                                                                            "speaker": "Aino",
                                                                            "text": "Ohh..."
                                                                        },
                                                                        {
                                                                            "id": "698550436",
                                                                            "speaker": "Aino",
                                                                            "text": "Huh, interesting. Ineffa, write some of these chaotic jokes down! We'll get Jahoda to be our guinea pig."
                                                                        },
                                                                        {
                                                                            "id": "698550437",
                                                                            "speaker": "Aino",
                                                                            "text": "#{NICKNAME}, why are you covering your face? You got a toothache? Hehe, have you gone on a sugar binge too?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698550438",
                                                                                    "text": "No... I'm just tired.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698550440",
                                                                                            "speaker": "Aino",
                                                                                            "text": "#Huh? What's wrong? Don't tell me you're getting sick or something... Ineffa, go make {M#him}{F#her} something warm!"
                                                                                        },
                                                                                        {
                                                                                            "id": "698550441",
                                                                                            "speaker": "Ineffa",
                                                                                            "text": "#Understood. Maybe {M#he}{F#she} ate too many Harra Fruit, a type of plant from Sumeru."
                                                                                        },
                                                                                        {
                                                                                            "id": "698550442",
                                                                                            "speaker": "Aino",
                                                                                            "text": "Huh? What do those have to do with any of this?"
                                                                                        },
                                                                                        {
                                                                                            "id": "698550443",
                                                                                            "speaker": "Player",
                                                                                            "text": "Please don't ask..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698550444",
                                                                                            "speaker": "Ineffa",
                                                                                            "text": "Because eating them can make you feel \"Harra\"-fyingly cold."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698550439",
                                                                                    "text": "No... I'm just cold."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698550428",
                                                                    "text": "...I guess you can say she now has one?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698550423",
                                                    "text": "What'll happen if the situation stays bad for a while?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698550420",
                                    "text": "That... doesn't seem right..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698550408",
                    "text": "You're such an attentive parent, Aino.",
                    "response": [
                        {
                            "id": "698550409",
                            "speaker": "Aino",
                            "text": "Hehe, well of course! Why, I'm queen parent of parenthood kingdom!"
                        }
                    ]
                }
            ]
        }
    ]
}