{
    "talkId": "6984601",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Blubberbeast": 8,
        "Freminet": 24,
        "Player": 12
    },
    "dialogues": [
        {
            "id": "698460101",
            "speaker": "Freminet",
            "text": "...I love diving too."
        },
        {
            "id": "698460102",
            "speaker": "Blubberbeast",
            "text": "...",
            "choices": [
                {
                    "id": "698460103",
                    "text": "Hey there, Freminet!",
                    "response": [
                        {
                            "id": "698460105",
                            "speaker": "Freminet",
                            "text": "...Hey. Long time no see. I'm... talking with him."
                        },
                        {
                            "id": "698460106",
                            "speaker": "Player",
                            "text": "With a Blubberbeast?"
                        },
                        {
                            "id": "698460107",
                            "speaker": "Freminet",
                            "text": "Mhm... It might seem odd to you...",
                            "choices": [
                                {
                                    "id": "698460108",
                                    "text": "Not in the least! May I join you?",
                                    "response": [
                                        {
                                            "id": "698460110",
                                            "speaker": "Freminet",
                                            "text": "Really? I thought that was... something that only happened in picture books.",
                                            "choices": [
                                                {
                                                    "id": "698460111",
                                                    "text": "And what do those stories say?",
                                                    "response": [
                                                        {
                                                            "id": "698460113",
                                                            "speaker": "Freminet",
                                                            "text": "Alright, then I'll share them with you."
                                                        },
                                                        {
                                                            "id": "698460114",
                                                            "speaker": "Blubberbeast",
                                                            "text": "Awuu?"
                                                        },
                                                        {
                                                            "id": "698460115",
                                                            "speaker": "Freminet",
                                                            "text": "Ah, you want to hear them too? Okay, listen closely."
                                                        },
                                                        {
                                                            "id": "698460116",
                                                            "speaker": "Blubberbeast",
                                                            "text": "Awuu~ Awuuwuu~~"
                                                        },
                                                        {
                                                            "id": "698460117",
                                                            "speaker": "Freminet",
                                                            "text": "Legends speak of a time long, long ago, when there was a Blubberbeast who strayed from his family and friends, and lived all alone in the pitch-black depths of the sea."
                                                        },
                                                        {
                                                            "id": "698460118",
                                                            "speaker": "Freminet",
                                                            "text": "Even as he bravely lived on in solitude, he kept searching for his family. Until one day, a diver who loved to explore found him."
                                                        },
                                                        {
                                                            "id": "698460119",
                                                            "speaker": "Freminet",
                                                            "text": "The Blubberbeast had never seen a human before, and was scared at first. But the diver gave him lots of food, and promised to return the next day."
                                                        },
                                                        {
                                                            "id": "698460120",
                                                            "speaker": "Freminet",
                                                            "text": "And just like that, they became fast friends. Every time the diver came, the Blubberbeast would happily dance and slap his belly, singing the songs of the Blubberbeasts."
                                                        },
                                                        {
                                                            "id": "698460121",
                                                            "speaker": "Freminet",
                                                            "text": "The diver also adored his round belly, and could never resist giving it endless belly rubs..."
                                                        },
                                                        {
                                                            "id": "698460122",
                                                            "speaker": "Freminet",
                                                            "text": "The Blubberbeast also adored the feeling of belly rubs, but since he had terrible eyesight, he only ever saw the diver's blurry silhouette."
                                                        },
                                                        {
                                                            "id": "698460123",
                                                            "speaker": "Freminet",
                                                            "text": "So, whenever he saw a human form approach, he'd happily dance, patting his belly and singing."
                                                        },
                                                        {
                                                            "id": "698460124",
                                                            "speaker": "Blubberbeast",
                                                            "text": "Awuu! Awuu! Awuu!",
                                                            "choices": [
                                                                {
                                                                    "id": "698460125",
                                                                    "text": "So cute! Gotta give it a rub!",
                                                                    "response": [
                                                                        {
                                                                            "id": "698460127",
                                                                            "speaker": "Blubberbeast",
                                                                            "text": "Awuuuuu! Awuu!"
                                                                        },
                                                                        {
                                                                            "id": "698460128",
                                                                            "speaker": "Freminet",
                                                                            "text": "Good boy, here, have some fish. I just caught them, so bon appetit."
                                                                        },
                                                                        {
                                                                            "id": "698460129",
                                                                            "speaker": "Player",
                                                                            "text": "So... is that how the story ends?"
                                                                        },
                                                                        {
                                                                            "id": "698460130",
                                                                            "speaker": "Freminet",
                                                                            "text": "Mm... I wish that was where the story ended, but... One day, that diver stopped coming altogether."
                                                                        },
                                                                        {
                                                                            "id": "698460131",
                                                                            "speaker": "Freminet",
                                                                            "text": "The Blubberbeast waited for a long, long time. Finally, he gathered the courage to go look for the diver, swimming off in the direction the diver had swum off to until he had finally reached the beach."
                                                                        },
                                                                        {
                                                                            "id": "698460132",
                                                                            "speaker": "Freminet",
                                                                            "text": "And that's where the picture book I have ends. I don't know how the rest of the story goes. Our two friends might've..."
                                                                        },
                                                                        {
                                                                            "id": "698460133",
                                                                            "speaker": "Blubberbeast",
                                                                            "text": "Awuuu..."
                                                                        },
                                                                        {
                                                                            "id": "698460134",
                                                                            "speaker": "Freminet",
                                                                            "text": "*sigh* Don't be sad. It's just a story, it's not real... I think...",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "698460135",
                                                                                    "text": "I think they'll be reunited soon.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "698460137",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Uh... Yeah. I'm sure it will."
                                                                                        },
                                                                                        {
                                                                                            "id": "698460138",
                                                                                            "speaker": "Blubberbeast",
                                                                                            "text": "Awuu! Awuu! Awuu!"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460139",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Oh, want some more fish? Give me a second... I should still have some more..."
                                                                                        },
                                                                                        {
                                                                                            "id": "698460140",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Huh... I wonder, just what does a Blubberbeast's belly feel like?"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460141",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "...Hmm!"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460142",
                                                                                            "speaker": "Blubberbeast",
                                                                                            "text": "Awuu? Awuuu... Awuu."
                                                                                        },
                                                                                        {
                                                                                            "id": "698460143",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Uh... So... I guess I'll go for it then?"
                                                                                        },
                                                                                        {
                                                                                            "id": "698460144",
                                                                                            "speaker": "Freminet",
                                                                                            "text": "Wow... This is really something. A world removed from petting Lynette's cat..."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "698460136",
                                                                                    "text": "It'll have a happy ending."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698460126",
                                                                    "text": "Belly! Must rub!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698460112",
                                                    "text": "I'd like to hear more about those tales."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698460109",
                                    "text": "I've got Blubberbeast pals too, you know!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698460104",
                    "text": "Whatcha doing here?"
                }
            ]
        }
    ]
}