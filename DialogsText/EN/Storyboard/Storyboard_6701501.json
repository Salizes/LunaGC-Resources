{
    "talkId": "6701501",
    "total_dialogue_lines": 54,
    "speaker_counts": {
        "Cairuo": 4,
        "Player": 17,
        "Yelan": 33
    },
    "dialogues": [
        {
            "id": "670150101",
            "speaker": "Cairuo",
            "text": "...All fifteen samples have been collected and encased in low-temperature vessels — two layers, one metal, one ceramic — ready to be shipped tonight."
        },
        {
            "id": "670150102",
            "speaker": "Yelan",
            "text": "Take them to the Flower-Feather Clan via express ship. From there, get them on priority shipping using the couriers' \"Blue Bolt\" service. Once they reach the northern edge of the Children of Echoes, transfer them to another boat that'll go east and arrive at Yilong Wharf through a special customs checkpoint. Speed is of the essence."
        },
        {
            "id": "670150103",
            "speaker": "Cairuo",
            "text": "Got it. A combination of Plan B3 and Plan C2, then..."
        },
        {
            "id": "670150104",
            "speaker": "Cairuo",
            "text": "#Huh... It's {NICKNAME}! How did you do that? It's like you just appeared right there without even making the slightest noise..."
        },
        {
            "id": "670150105",
            "speaker": "Yelan",
            "text": "#Don't be nervous, just treat {M#him}{F#her} like {M#he's}{F#she's} your boss."
        },
        {
            "id": "670150106",
            "speaker": "Yelan",
            "text": "#Interesting timing. {NICKNAME}, meet Cairuo, she's with us."
        },
        {
            "id": "670150107",
            "speaker": "Cairuo",
            "text": "I'll leave you to it then. Miss Yelan, I'll ensure everything is arranged to your specifications.",
            "choices": [
                {
                    "id": "670150108",
                    "text": "Were you just arranging a delivery?",
                    "response": [
                        {
                            "id": "670150110",
                            "speaker": "Yelan",
                            "text": "They're plant and mineral samples containing kuuvahki. I'm sending them back to Liyue for the Ministry of Civil Affairs to analyze.",
                            "choices": [
                                {
                                    "id": "670150111",
                                    "text": "Plants and minerals...",
                                    "response": [
                                        {
                                            "id": "670150113",
                                            "speaker": "Yelan",
                                            "text": "Nothing escapes you."
                                        },
                                        {
                                            "id": "670150114",
                                            "speaker": "Yelan",
                                            "text": "There are also some pictures relating to the Fatui among these samples."
                                        },
                                        {
                                            "id": "670150153",
                                            "speaker": "Yelan",
                                            "text": "These show their research facilities, their current weaponry, and the distribution of their camps. Liyue's a long way from Nod-Krai, but it never hurts to be prepared."
                                        },
                                        {
                                            "id": "670150115",
                                            "speaker": "Player",
                                            "text": "So that's why you're here?"
                                        },
                                        {
                                            "id": "670150116",
                                            "speaker": "Yelan",
                                            "text": "It's one of the reasons. But I'm also here to purchase some intel from Nefer, boss of the Curatorium of Secrets."
                                        },
                                        {
                                            "id": "670150154",
                                            "speaker": "Yelan",
                                            "text": "Dealing with her always requires a lot of preparation — both mental and financial.",
                                            "choices": [
                                                {
                                                    "id": "670150117",
                                                    "text": "Nefer...",
                                                    "response": [
                                                        {
                                                            "id": "670150119",
                                                            "speaker": "Yelan",
                                                            "text": "..."
                                                        },
                                                        {
                                                            "id": "670150120",
                                                            "speaker": "Yelan",
                                                            "text": "Have you ever heard of the \"Northern Intelligence Network\"?"
                                                        },
                                                        {
                                                            "id": "670150121",
                                                            "speaker": "Player",
                                                            "text": "What's that...?"
                                                        },
                                                        {
                                                            "id": "670150122",
                                                            "speaker": "Yelan",
                                                            "text": "It's essentially a forum for intel exchange — a loosely structured organization with no real rules or regulations."
                                                        },
                                                        {
                                                            "id": "670150155",
                                                            "speaker": "Yelan",
                                                            "text": "But you can find well-connected people from all walks of life there who are willing to trade information — as long as you can pay their price."
                                                        },
                                                        {
                                                            "id": "670150123",
                                                            "speaker": "Yelan",
                                                            "text": "Nefer currently represents this Northern Intelligence Network, and the Curatorium she operates is its primary point of sale."
                                                        },
                                                        {
                                                            "id": "670150124",
                                                            "speaker": "Yelan",
                                                            "text": "If intel was all they sold, that would be one thing, but it's said the network has spies planted in every region, and that they're always on the lookout for even more informants."
                                                        },
                                                        {
                                                            "id": "670150126",
                                                            "speaker": "Player",
                                                            "text": "Even in Liyue...?"
                                                        },
                                                        {
                                                            "id": "670150127",
                                                            "speaker": "Yelan",
                                                            "text": "In no small part thanks to the efforts of my colleagues, the network's tendrils have been unable to take hold in Liyue."
                                                        },
                                                        {
                                                            "id": "670150128",
                                                            "speaker": "Yelan",
                                                            "text": "It doesn't matter if they send official representatives or smuggle in spies — they are met with a polite but firm \"rejection\" every time."
                                                        },
                                                        {
                                                            "id": "670150129",
                                                            "speaker": "Yelan",
                                                            "text": "I imagine that we must be one of the very few \"unknowns\" remaining on their map of the world.",
                                                            "choices": [
                                                                {
                                                                    "id": "670150130",
                                                                    "text": "Yet she's still willing to sell you intel?",
                                                                    "response": [
                                                                        {
                                                                            "id": "670150131",
                                                                            "speaker": "Yelan",
                                                                            "text": "Haha, business is business, and Mora talks. She's not one to say no to a big bag of coins."
                                                                        },
                                                                        {
                                                                            "id": "670150134",
                                                                            "speaker": "Yelan",
                                                                            "text": "Other factors notwithstanding, I'm a valuable customer. The Northern Intelligence Network has plenty of information that only I'm willing to buy.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "670150135",
                                                                                    "text": "Wait, wait, wait... You said, \"I'm\" a valuable customer?",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "670150137",
                                                                                            "speaker": "Yelan",
                                                                                            "text": "Well done for picking up on my phrasing — you're getting good at finding clues."
                                                                                        },
                                                                                        {
                                                                                            "id": "670150138",
                                                                                            "speaker": "Yelan",
                                                                                            "text": "Up until now, all of my dealings with the network have been of a personal nature. The Ministry has nothing to do with it.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "670150139",
                                                                                                    "text": "She's willing to deal with Li...",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "670150141",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "Of course. Let's just say I have lots of... influence."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150142",
                                                                                                            "speaker": "Player",
                                                                                                            "text": "And by \"influence,\" you mean...?"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150143",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "Mora."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150144",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "Lots and lots of Mora. More than enough to influence dear Lady Nefer."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150145",
                                                                                                            "speaker": "Player",
                                                                                                            "text": "That's the Yelan I know..."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150146",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "With someone like her, it's better to spend a little Mora than to end up owing a favor."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150147",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "It's important to remain vigilant in your dealings with her — she's not an easy person to deal with."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150148",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "If you ever see us together, chances are we're conducting business."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150149",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "If you have any trust in me at all, then cover your ears and stay out of it. That'll save you a whole world of trouble."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150150",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "Anyway, that's enough chit-chat, I still have some preparations to make. Goodbye for now."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150151",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "#...Oh, and {NICKNAME}, before I go. If you don't mind me saying, you may wish to return to Liyue for a cup of tea."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "670150152",
                                                                                                            "speaker": "Yelan",
                                                                                                            "text": "Even if stray winds blow, the mountains of Liyue should shield you while you drink."
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "670150140",
                                                                                                    "text": "Ahem, willing to deal with you?"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "670150136",
                                                                                    "text": "And here I thought the Ministry..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "670150132",
                                                                    "text": "Aren't you worried she might resort to drastic measures?",
                                                                    "response": [
                                                                        {
                                                                            "id": "670150133",
                                                                            "speaker": "Yelan",
                                                                            "text": "Why would she? Nefer's too smart to hold a grudge when it comes to business, and she's not one to say no to a big bag of coins."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "670150118",
                                                    "text": "...Has information about Liyue?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "670150112",
                                    "text": "...And that needs to be done in secret?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "670150109",
                    "text": "Are these important cargo?"
                }
            ]
        }
    ]
}