{
    "talkId": "6983003",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 8,
        "Shikanoin Heizou": 15
    },
    "dialogues": [
        {
            "id": "698300301",
            "speaker": "Shikanoin Heizou",
            "text": "Mmm... Looks like another uneventful day in Hanamizaka."
        },
        {
            "id": "698300302",
            "speaker": "Shikanoin Heizou",
            "text": "...*yawn*"
        },
        {
            "id": "698300303",
            "speaker": "Shikanoin Heizou",
            "text": "Well, since I'm already out and about, I might as well grab a quick bite before reporting back to Madam Kujou...",
            "choices": [
                {
                    "id": "698300304",
                    "text": "Gotcha!",
                    "response": [
                        {
                            "id": "698300306",
                            "speaker": "Shikanoin Heizou",
                            "text": "Ah, but on the contrary! I've just finished my work as a Doushin. My work as a detective has not yet begun."
                        },
                        {
                            "id": "698300307",
                            "speaker": "Shikanoin Heizou",
                            "text": "That accusation was almost too flimsy to bother refuting.",
                            "choices": [
                                {
                                    "id": "698300308",
                                    "text": "Semantics, Heizou.",
                                    "response": [
                                        {
                                            "id": "698300310",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Now, actually. I wasn't joking."
                                        },
                                        {
                                            "id": "698300311",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "Recently, a group of shady peddlers have been hawking illicit potions all over Hanamizaka."
                                        },
                                        {
                                            "id": "698300312",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "They used to be legitimate vendors, but they've gone rogue for some reason."
                                        },
                                        {
                                            "id": "698300313",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "They're using their legal businesses as cover to lead us in circles. The Doushin have been on it for ages without finding anything conclusive."
                                        },
                                        {
                                            "id": "698300314",
                                            "speaker": "Shikanoin Heizou",
                                            "text": "So, I plan to break this case wide open... my way.",
                                            "choices": [
                                                {
                                                    "id": "698300315",
                                                    "text": "Need help?",
                                                    "response": [
                                                        {
                                                            "id": "698300317",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Hahaha, appreciated, but this case isn't nearly serious enough to warrant you getting involved."
                                                        },
                                                        {
                                                            "id": "698300318",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Sango and the others have been conducting a covert investigation for some time now, they've already got most of the evidence."
                                                        },
                                                        {
                                                            "id": "698300319",
                                                            "speaker": "Shikanoin Heizou",
                                                            "text": "Now... it's my turn.",
                                                            "choices": [
                                                                {
                                                                    "id": "698300320",
                                                                    "text": "It'll be a cinch for the Great Detective Heizou.",
                                                                    "response": [
                                                                        {
                                                                            "id": "698300322",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "#Now that's a welcome sentiment, {NICKNAME}."
                                                                        },
                                                                        {
                                                                            "id": "698300323",
                                                                            "speaker": "Shikanoin Heizou",
                                                                            "text": "If everything does go well, I'll treat you to something tasty. Promise."
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "698300321",
                                                                    "text": "Case as good as closed."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "698300316",
                                                    "text": "We can team up."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "698300309",
                                    "text": "So, when does the case-cracking start?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "698300305",
                    "text": "Detective Slacker!"
                }
            ]
        }
    ]
}