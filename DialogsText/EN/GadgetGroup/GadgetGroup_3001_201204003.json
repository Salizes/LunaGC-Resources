            "dialogues": [
                {
                    "id": "686240101",
                    "speaker": "Jukebox",
                    "text": "(It looks like a jukebox that can switch records. There should be four different records, perhaps pressing these buttons will switch between them...)"
                }
            ]
        },
        {
            "talkId": "6862402",
            "initDialog": "686240201",
            "dialogues": [
                {
