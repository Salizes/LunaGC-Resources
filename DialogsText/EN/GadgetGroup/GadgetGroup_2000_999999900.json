            "dialogues": [
                {
                    "id": "689050101",
                    "speaker": "Chubby",
                    "text": "The one before you is known as Jade Seeker. One travels far and wide, seeking naught but to witness all of the treasures this world has to offer..."
                }
            ]
        },
        {
            "talkId": "6890502",
            "initDialog": "689050201",
            "dialogues": [
                {
                    "id": "689050201",
                    "speaker": "Player",
                    "text": "What do you sell here?"
                },
                {
                    "id": "689050202",
                    "speaker": "Chubby",
                    "text": "Ahh... encounters with fine treasures cannot be forced. This is something that only fate may decide."
                }
            ]
        },
        {
            "talkId": "6890503",
            "initDialog": "689050301",
            "dialogues": [
                {
                    "id": "689050301",
                    "speaker": "Player",
                    "text": "Goodbye."
                },
                {
                    "id": "689050302",
                    "speaker": "Chubby",
                    "text": "To gain that which you treasure is a blessing indeed — but do not be aggrieved should fate deny you the object of your desire."
                }
            ]
        },
        {
            "talkId": "6890511",
            "initDialog": "689051101",
            "dialogues": [
                {
                    "id": "689051101",
                    "speaker": "Observe",
                    "text": "(Seems we have ourselves another teapot spirit...)"
                }
            ]
        }
