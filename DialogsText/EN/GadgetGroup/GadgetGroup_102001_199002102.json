{
    "groupId": "102001_199002102",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Gentle Knight Raven": 6,
        "Player": 2
    },
    "talks": [
        {
            "talkId": "6800358",
            "initDialog": "680035801",
            "dialogues": [
                {
                    "id": "680035801",
                    "speaker": "Gentle Knight Raven",
                    "text": "The sky is mighty indeed, to be able to accept all things, yet remain so majestic. I wish that one day, I could be as the sky."
                },
                {
                    "id": "680035802",
                    "speaker": "Gentle Knight Raven",
                    "text": "..."
                },
                {
                    "id": "680035803",
                    "speaker": "Gentle Knight Raven",
                    "text": "Hah, the cusp of midsummer's night is as a fleeting dream. If only things could stay this way..."
                },
                {
                    "id": "680035804",
                    "speaker": "Gentle Knight Raven",
                    "text": "But summer is brief, Traveler. Joyous times, the morning of youth, the past spent with one's friends, playing and chasing, they all shall pass in the blink of an eye..."
                },
                {
                    "id": "680035805",
                    "speaker": "Gentle Knight Raven",
                    "text": "...Shall you remember this summer, Traveler?",
                    "choices": [
                        {
                            "id": "680035806",
                            "text": "Perhaps.",
                            "response": [
                                {
                                    "id": "680035808",
                                    "speaker": "Gentle Knight Raven",
                                    "text": "Haha, I hope you will, and that you will be gladdened whenever you do."
                                }
                            ]
                        },
                        {
                            "id": "680035807",
                            "text": "I certainly will."
                        }
                    ]
                }
            ]
        }
    ]
}