    "talks": [
        {
            "talkId": "6850002",
            "initDialog": "685000201",
            "dialogues": [
                {
                    "id": "685000201",
                    "speaker": "Monsieur Os",
                    "text": "Let us continue onward. It is time to end this story of the \"past.\"",
                    "choices": [
                        {
                            "id": "685000202",
                            "text": "So, what's the deal with you and Este...",
                            "response": [
                                {
                                    "id": "685000203",
                                    "speaker": "Monsieur Os",
                                    "text": "As you have seen, he was a friend of mine, and one of the survivors of Remuria's destruction."
                                },
                                {
                                    "id": "685000204",
                                    "speaker": "Monsieur Os",
                                    "text": "In later days, he followed me into the newborn Fontaine and was laid to rest there."
                                },
                                {
                                    "id": "685000205",
                                    "speaker": "Monsieur Os",
                                    "text": "The spring waters responded to us, who were entrapped in rock, just as it did ordinary Fontainians, and he had children of his own, building a family there..."
                                },
                                {
                                    "id": "685000206",
                                    "speaker": "Monsieur Os",
                                    "text": "His bloodline became joined to that of Fontaine, and all came to forget that he was no ordinary mortal."
                                },
                                {
                                    "id": "685000207",
                                    "speaker": "Monsieur Os",
                                    "text": "A good fate, no?"
                                }
                            ]
                        },
                        {
                            "id": "685000208",
                            "text": "(Pet him.)"
                        },
                        {
                            "id": "685000209",
                            "text": "It's nothing.",
                            "response": [
                                {
                                    "id": "685000210",
                                    "speaker": "Monsieur Os",
                                    "text": "Alright. If there is anything you wish to know, do not hesitate to ask me."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}