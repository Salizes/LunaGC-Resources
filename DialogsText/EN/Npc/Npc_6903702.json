{
    "talkId": "6903702",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Ganyu": 7,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "690370201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690370202",
            "speaker": "Ganyu",
            "text": "I think it's beautiful here."
        },
        {
            "id": "690370203",
            "speaker": "Ganyu",
            "text": "It must have been quite an undertaking to decorate such a large space. Thank you for all your efforts.",
            "choices": [
                {
                    "id": "690370204",
                    "text": "Don't mention it.",
                    "response": [
                        {
                            "id": "690370206",
                            "speaker": "Ganyu",
                            "text": "In my spare time, I particularly enjoy taking strolls outside. It's so quiet and peaceful."
                        },
                        {
                            "id": "690370207",
                            "speaker": "Ganyu",
                            "text": "Even at midday, it's perfectly safe to take a nap.",
                            "choices": [
                                {
                                    "id": "690370208",
                                    "text": "Yes, you definitely don't need to worry about safety here...",
                                    "response": [
                                        {
                                            "id": "690370209",
                                            "speaker": "Ganyu",
                                            "text": "Agreed! So I really do like it here."
                                        },
                                        {
                                            "id": "690370212",
                                            "speaker": "Ganyu",
                                            "text": "Anyway, um... Thanks so much, once again!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690370210",
                                    "text": "Take care to not catch a cold...",
                                    "response": [
                                        {
                                            "id": "690370211",
                                            "speaker": "Ganyu",
                                            "text": "Please don't worry, I've slept like this every day for at least a thousand years."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690370205",
                    "text": "As long as you like it."
                }
            ]
        }
    ]
}