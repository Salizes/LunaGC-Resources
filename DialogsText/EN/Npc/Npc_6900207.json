{
    "talkId": "6900207",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Kamisato Ayaka": 10,
        "Player": 4
    },
    "dialogues": [
        {
            "id": "690020701",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690020202",
            "speaker": "Kamisato Ayaka",
            "text": "Haha, you've no need to worry."
        },
        {
            "id": "690020203",
            "speaker": "Kamisato Ayaka",
            "text": "The sights here are nothing like what I've seen at home. There are new wonders to be found with each step."
        },
        {
            "id": "690020204",
            "speaker": "Kamisato Ayaka",
            "text": "But there's also an added layer of significance to it, because this place belongs to you.",
            "choices": [
                {
                    "id": "690020205",
                    "text": "Make yourself at home. I mean it quite literally, haha.",
                    "response": [
                        {
                            "id": "690020206",
                            "speaker": "Kamisato Ayaka",
                            "text": "Oh..."
                        },
                        {
                            "id": "690020207",
                            "speaker": "Kamisato Ayaka",
                            "text": "That would be too unseemly..."
                        },
                        {
                            "id": "690020208",
                            "speaker": "Kamisato Ayaka",
                            "text": "However, I appreciate your kindness."
                        },
                        {
                            "id": "690020212",
                            "speaker": "Player",
                            "text": "It's my pleasure."
                        },
                        {
                            "id": "690020213",
                            "speaker": "Kamisato Ayaka",
                            "text": "Ahaha... That's very considerate of you. However, you don't have to go above and beyond for me."
                        },
                        {
                            "id": "690020214",
                            "speaker": "Kamisato Ayaka",
                            "text": "Please let me know if you ever need my assistance. I hope I can be of some help to you too."
                        }
                    ]
                },
                {
                    "id": "690020209",
                    "text": "I hope that it's a place where you can let go of your worries and just relax.",
                    "response": [
                        {
                            "id": "690020210",
                            "speaker": "Kamisato Ayaka",
                            "text": "Hm... I appreciate your kindness."
                        },
                        {
                            "id": "690020211",
                            "speaker": "Kamisato Ayaka",
                            "text": "I wouldn't dare \"let go\" and \"relax.\" However, I am more than grateful for being able to rest here for a while."
                        }
                    ]
                }
            ]
        }
    ]
}