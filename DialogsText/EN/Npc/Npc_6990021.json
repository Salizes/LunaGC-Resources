    "speaker_counts": {
        "Paimon": 7,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "699002101",
            "speaker": "Player",
            "text": "About the Vision Hunt Decree"
        },
        {
            "id": "699002102",
            "speaker": "Paimon",
            "text": "It's hard to talk about the recent events in Inazuma and not mention the Vision Hunt Decree."
        },
        {
            "id": "699002103",
            "speaker": "Paimon",
            "text": "But you don't have a Vision, so you don't have to worry about losing one."
        },
        {
            "id": "699002104",
            "speaker": "Paimon",
            "text": "#On the flip side, if you are caught by the Tenryou Commission, {NICKNAME}, you also can't surrender your Vision in exchange for your life...",
            "choices": [
                {
                    "id": "699002105",
                    "text": "I can tell them...",
                    "response": [
                        {
                            "id": "699002107",
                            "speaker": "Paimon",
                            "text": "Another reason to have Paimon around... Wait, WHAT!?"
                        },
                        {
                            "id": "699002108",
                            "speaker": "Player",
                            "text": "Don't worry, I wouldn't let them take you, Paimon."
                        },
                        {
                            "id": "699002109",
                            "speaker": "Paimon",
                            "text": "That's more like it.",
                            "choices": [
                                {
                                    "id": "699002110",
                                    "text": "We'd just go to jail...",
                                    "response": [
                                        {
                                            "id": "699002112",
                                            "speaker": "Paimon",
                                            "text": "Uh... W—Well, if that's how it would go down, then maybe you should hand Paimon over to them..."
                                        },
                                        {
                                            "id": "699002113",
                                            "speaker": "Paimon",
                                            "text": "...Wait a minute! How about we just don't get caught in the first place?"
                                        }
                                    ]
                                },
                                {
                                    "id": "699002111",
                                    "text": "And suffer punishment together..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699002106",
                    "text": "...That you are my Vision."
                }
            ]
        }
    ]
}