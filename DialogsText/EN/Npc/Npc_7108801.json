{
    "talkId": "7108801",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Paimon": 3,
        "Player": 11,
        "Taliesin": 14
    },
    "dialogues": [
        {
            "id": "710880101",
            "speaker": "Taliesin",
            "text": "Hmm... no, no. That's not how that goes. According to the genealogy..."
        },
        {
            "id": "710880102",
            "speaker": "Taliesin",
            "text": "Ooh? Oh! Hello, sorry, didn't see you there!",
            "choices": [
                {
                    "id": "710880103",
                    "text": "You...",
                    "response": [
                        {
                            "id": "710880105",
                            "speaker": "Taliesin",
                            "text": "#{F#Shh! Shh! Ahem! She comes, she comes! Her eyes bright as the moon inimitable, her armor formidable, invincible! She is—}{M#Shh! Shh! Ahem! He comes, he comes! His sword shining like the moon so silver, at his footsteps even armies shiver! He is—}"
                        },
                        {
                            "id": "710880106",
                            "speaker": "Paimon",
                            "text": "Blon—die—!",
                            "choices": [
                                {
                                    "id": "710880107",
                                    "text": "What!?",
                                    "response": [
                                        {
                                            "id": "710880109",
                                            "speaker": "Paimon",
                                            "text": "Hehe... Sorry, force of habit. It just slipped out, y'know?",
                                            "choices": [
                                                {
                                                    "id": "710880110",
                                                    "text": "What sort of habit is that, seriously...",
                                                    "response": [
                                                        {
                                                            "id": "710880112",
                                                            "speaker": "Paimon",
                                                            "text": "Hmm, Paimon supposes that the nickname could be uglier..."
                                                        },
                                                        {
                                                            "id": "710880113",
                                                            "speaker": "Player",
                                                            "text": "Hey!"
                                                        },
                                                        {
                                                            "id": "710880114",
                                                            "speaker": "Taliesin",
                                                            "text": "Hahahaha! Well said, good Paimon, well said!"
                                                        },
                                                        {
                                                            "id": "710880115",
                                                            "speaker": "Taliesin",
                                                            "text": "#{F#She}{M#He} is the golden-haired {NICKNAME}!"
                                                        },
                                                        {
                                                            "id": "710880116",
                                                            "speaker": "Player",
                                                            "text": "I object to these terrible-sounding, non-consensual appellations."
                                                        },
                                                        {
                                                            "id": "710880117",
                                                            "speaker": "Taliesin",
                                                            "text": "Apologies, apologies... I did not mean to offend. But more \"old-school\" poets from Mondstadt do tend to begin like that."
                                                        },
                                                        {
                                                            "id": "710880118",
                                                            "speaker": "Player",
                                                            "text": "\"Old-school\"?"
                                                        },
                                                        {
                                                            "id": "710880119",
                                                            "speaker": "Taliesin",
                                                            "text": "Well, if you'll let me clarify, I don't mean old-school folksongs like the \"Dandelion Madrigals\" or old-school romances like \"Marriage, You Cheat, How I Hate Thee\"..."
                                                        },
                                                        {
                                                            "id": "710880120",
                                                            "speaker": "Taliesin",
                                                            "text": "I'm referring to old-school historical epic poetry."
                                                        },
                                                        {
                                                            "id": "710880121",
                                                            "speaker": "Player",
                                                            "text": "And what might that be?"
                                                        },
                                                        {
                                                            "id": "710880122",
                                                            "speaker": "Taliesin",
                                                            "text": "Ah, simply put, it is the adaptation of heroic genealogies, the adding of flesh and skin atop the skeletal frame of history!"
                                                        },
                                                        {
                                                            "id": "710880123",
                                                            "speaker": "Taliesin",
                                                            "text": "These epics sing of history through long-form poetry, awakening people to the knowledge of times past. Well, there you have it — the epic, and its value to society."
                                                        },
                                                        {
                                                            "id": "710880124",
                                                            "speaker": "Taliesin",
                                                            "text": "The ability of poetry to awaken historical consciousness was precisely why it was banned all those years ago by the aristocracy."
                                                        },
                                                        {
                                                            "id": "710880125",
                                                            "speaker": "Taliesin",
                                                            "text": "They feared that we would recall our former freedom and our history of resistance."
                                                        },
                                                        {
                                                            "id": "710880126",
                                                            "speaker": "Taliesin",
                                                            "text": "And that is why I despise the popular poetry of the day and seek to revive these \"old-school epics.\""
                                                        },
                                                        {
                                                            "id": "710880127",
                                                            "speaker": "Player",
                                                            "text": "I see. Bye."
                                                        },
                                                        {
                                                            "id": "710880128",
                                                            "speaker": "Taliesin",
                                                            "text": "#Um, right, then. See you, golden-haired {NICKNAME}!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "710880111",
                                                    "text": "That lacked creativity in the extreme."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "710880108",
                                    "text": "Paimon!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "710880104",
                    "text": "I'm..."
                }
            ]
        }
    ]
}