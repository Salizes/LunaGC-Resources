{
    "talkId": "6907509",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "Wanderer": 11
    },
    "dialogues": [
        {
            "id": "690750201",
            "speaker": "Player",
            "text": "How do you like it here?"
        },
        {
            "id": "690750202",
            "speaker": "Wanderer",
            "text": "...",
            "choices": [
                {
                    "id": "690750203",
                    "text": "Wh—What is it?",
                    "response": [
                        {
                            "id": "690750204",
                            "speaker": "Wanderer",
                            "text": "Hey, you own this place. What are you so nervous about? It's not a good look."
                        },
                        {
                            "id": "690750207",
                            "speaker": "Wanderer",
                            "text": "...It's nothing. I was just thinking about something inane."
                        },
                        {
                            "id": "690750208",
                            "speaker": "Wanderer",
                            "text": "In your, uh... realm, some areas are completely empty.",
                            "choices": [
                                {
                                    "id": "690750209",
                                    "text": "There's no need to fill everything to the brim. Empty space has a beauty of its own.",
                                    "response": [
                                        {
                                            "id": "690750210",
                                            "speaker": "Wanderer",
                                            "text": "You're right. Look at me, coming around here, criticizing your lifestyle choices."
                                        },
                                        {
                                            "id": "690750211",
                                            "speaker": "Wanderer",
                                            "text": "It's generous of you to host me in your home. The least I could do is be grateful."
                                        },
                                        {
                                            "id": "690750215",
                                            "speaker": "Wanderer",
                                            "text": "This is your home. Arrange it as you wish."
                                        },
                                        {
                                            "id": "690750216",
                                            "speaker": "Wanderer",
                                            "text": "I'm just another person passing through."
                                        }
                                    ]
                                },
                                {
                                    "id": "690750212",
                                    "text": "I'd place more things if I could, but I can't.",
                                    "response": [
                                        {
                                            "id": "690750213",
                                            "speaker": "Wanderer",
                                            "text": "I get it. There are always going to be those things that are just beyond our ability to manage."
                                        },
                                        {
                                            "id": "690750214",
                                            "speaker": "Wanderer",
                                            "text": "With some things, they improve over time. With other things, the most you can do is to maintain the status quo."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690750205",
                    "text": "If there's something you want to say, just say it.",
                    "response": [
                        {
                            "id": "690750206",
                            "speaker": "Wanderer",
                            "text": "Hmph."
                        }
                    ]
                }
            ]
        }
    ]
}