    "speaker_counts": {
        "Hardy Two-Blades": 8,
        "Paimon": 8,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "400814201",
            "speaker": "Hardy Two-Blades",
            "text": "Oh, dang it! Why is it the two of you? Hmph!",
            "choices": [
                {
                    "id": "400814202",
                    "text": "What do you mean?",
                    "response": [
                        {
                            "id": "400814203",
                            "speaker": "Hardy Two-Blades",
                            "text": "It's nothing. You'll understand eventually."
                        },
                        {
                            "id": "400814204",
                            "speaker": "Paimon",
                            "text": "What is this person doing at the training ground? Judging by his tone, could he also be one of the competitors?",
                            "choices": [
                                {
                                    "id": "400814205",
                                    "text": "There's no need to be afraid, Paimon.",
                                    "response": [
                                        {
                                            "id": "400814207",
                                            "speaker": "Paimon",
                                            "text": "You're right, we've defeated countless nasty people. This one's no different!"
                                        },
                                        {
                                            "id": "400814208",
                                            "speaker": "Paimon",
                                            "text": "Besides, Paimon has faith in Bongo-Head and the other Fungi! Someone with such a bad temper can't be good with Fungi anyway!"
                                        },
                                        {
                                            "id": "400814209",
                                            "speaker": "Hardy Two-Blades",
                                            "text": "I heard everything. You guys were pretty loud."
                                        },
                                        {
                                            "id": "400814210",
                                            "speaker": "Paimon",
                                            "text": "Eeeek!"
                                        },
                                        {
                                            "id": "400814211",
                                            "speaker": "Hardy Two-Blades",
                                            "text": "I'm not interested in bickering. We'll settle it in the arena."
                                        }
                                    ]
                                },
                                {
                                    "id": "400814206",
                                    "text": "He's a piece of cake."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400814212",
                    "text": "Hmph!",
                    "response": [
                        {
                            "id": "400814213",
                            "speaker": "Hardy Two-Blades",
                            "text": "Y—You're still feeling cocky!?"
                        },
                        {
                            "id": "400814214",
                            "speaker": "Paimon",
                            "text": "Whoa! Let's not make this a confrontation!"
                        },
                        {
                            "id": "400814215",
                            "speaker": "Player",
                            "text": "I can be mean too."
                        },
                        {
                            "id": "400814216",
                            "speaker": "Paimon",
                            "text": "But what if the two of you get in a fight because you upset him...?"
                        },
                        {
                            "id": "400814217",
                            "speaker": "Paimon",
                            "text": "Wait... he's the one Paimon should be worried about if the two of you start fighting... Just... make sure you don't hit him too hard!"
                        },
                        {
                            "id": "400814218",
                            "speaker": "Paimon",
                            "text": "#Anyway, for your safety, Mister Mercenary, you probably shouldn't agitate {NICKNAME} any further."
                        },
                        {
                            "id": "400814219",
                            "speaker": "Hardy Two-Blades",
                            "text": "I'm going to become a renowned beast tamer! It doesn't serve me any purpose to settle disputes through violence outside of the arena."
                        },
                        {
                            "id": "400814220",
                            "speaker": "Hardy Two-Blades",
                            "text": "Stop wasting time trying to argue with me and go do whatever it is you're supposed to be doing!"
                        }
                    ]
                },
                {
                    "id": "400814221",
                    "text": "Goodbye!",
                    "response": [
                        {
                            "id": "400814222",
                            "speaker": "Hardy Two-Blades",
                            "text": "Shut it! Just get out of here already!"
                        }
                    ]
                }
            ]
        }
    ]
}