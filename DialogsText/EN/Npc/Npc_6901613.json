{
    "talkId": "6901613",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Diluc": 11,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690161301",
            "speaker": "Player",
            "text": "Is there anything you'd like to do?"
        },
        {
            "id": "690160901",
            "speaker": "Diluc",
            "text": "Yes... Take a sip of this."
        },
        {
            "id": "690160902",
            "speaker": "Diluc",
            "text": "It's an alcohol-free beverage based on a long-standing family recipe. But I put my own spin on it.",
            "choices": [
                {
                    "id": "690160903",
                    "text": "So crisp and refreshing!",
                    "response": [
                        {
                            "id": "690160905",
                            "speaker": "Diluc",
                            "text": "The look on your face suggests that was rather to your liking."
                        },
                        {
                            "id": "690160906",
                            "speaker": "Diluc",
                            "text": "Well, I'm glad. I tried to adjust the recipe to match your taste, and from the looks of it, I succeeded in doing just that."
                        },
                        {
                            "id": "690160907",
                            "speaker": "Diluc",
                            "text": "Now. I have a favor to ask of you."
                        },
                        {
                            "id": "690160908",
                            "speaker": "Diluc",
                            "text": "This drink hasn't been named yet. It wouldn't be appropriate to use its original name, since the recipe has been modified."
                        },
                        {
                            "id": "690160909",
                            "speaker": "Player",
                            "text": "You want me to name it?"
                        },
                        {
                            "id": "690160910",
                            "speaker": "Diluc",
                            "text": "Well, it was made to suit your tastes. It's only fitting that you name it."
                        },
                        {
                            "id": "690160911",
                            "speaker": "Diluc",
                            "text": "Or perhaps... I should name it after you?",
                            "choices": [
                                {
                                    "id": "690160912",
                                    "text": "That'd be weird.",
                                    "response": [
                                        {
                                            "id": "690160914",
                                            "speaker": "Diluc",
                                            "text": "...I suppose you're right."
                                        },
                                        {
                                            "id": "690160915",
                                            "speaker": "Diluc",
                                            "text": "Well, there's no rush, so take your time. I can always make another glass for you if you forget how it tastes."
                                        },
                                        {
                                            "id": "690160916",
                                            "speaker": "Diluc",
                                            "text": "Anywhere. Anytime."
                                        }
                                    ]
                                },
                                {
                                    "id": "690160913",
                                    "text": "Let me give this some more thought..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690160904",
                    "text": "What a mellow aftertaste!"
                }
            ]
        }
    ]
}