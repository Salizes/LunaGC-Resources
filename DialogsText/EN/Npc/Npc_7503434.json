    "dialogues": [
        {
            "id": "750343401",
            "speaker": "Pampa",
            "text": "Yo, you've got time to come here?",
            "choices": [
                {
                    "id": "750343402",
                    "text": "Do we know you?",
                    "response": [
                        {
                            "id": "750343403",
                            "speaker": "Pampa",
                            "text": "We've met, we've talked, so we're friends! Besides, weren't we on the same side during that thing? Don't say you've forgotten already!"
                        },
                        {
                            "id": "750343404",
                            "speaker": "Player",
                            "text": "I'm on my own side."
                        },
                        {
                            "id": "750343405",
                            "speaker": "Pampa",
                            "text": "*sigh* Fine, you're right, you're right. I heard even Mr. Tenehua really admires you. Being your friend is a great honor!"
                        }
                    ]
                },
                {
                    "id": "750343406",
                    "text": "I should get going.",
                    "response": [
                        {
                            "id": "750343407",
                            "speaker": "Pampa",
                            "text": "Don't let me keep you!"
                        }
                    ]
                }
            ]
        }
    ]
}