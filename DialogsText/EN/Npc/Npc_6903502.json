    "dialogues": [
        {
            "id": "690350201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690350202",
            "speaker": "Qiqi",
            "text": "Umm... nice. Peaceful."
        },
        {
            "id": "690350203",
            "speaker": "Qiqi",
            "text": "I can do my stretches in the daytime without anyone watching."
        },
        {
            "id": "690350204",
            "speaker": "Qiqi",
            "text": "And there aren't too many things to... uhh... remember.",
            "choices": [
                {
                    "id": "690350205",
                    "text": "Do you have your notebook with you?",
                    "response": [
                        {
                            "id": "690350206",
                            "speaker": "Qiqi",
                            "text": "Notebook? Notebook..."
                        },
                        {
                            "id": "690350207",
                            "speaker": "Qiqi",
                            "text": "Notebook... Who is that again...?"
                        },
                        {
                            "id": "690350211",
                            "speaker": "Player",
                            "text": "(Oh dear...)"
                        },
                        {
                            "id": "690350213",
                            "speaker": "Qiqi",
                            "text": "No need. I will be fine..."
                        },
                        {
                            "id": "690350214",
                            "speaker": "Qiqi",
                            "text": "Don't forget, Qiqi is stronger than she looks."
                        }
                    ]
                },
                {
                    "id": "690350208",
                    "text": "Qiqi, do you still remember how to gather herbs?",
                    "response": [
                        {
                            "id": "690350209",
                            "speaker": "Qiqi",
                            "text": "Herbs...? Herbs..."
                        },
                        {
                            "id": "690350210",
                            "speaker": "Qiqi",
                            "text": "...Remind me, what are herbs again?"
                        },
                        {
                            "id": "690350212",
                            "speaker": "Player",
                            "text": "I'll help you remember."
                        }
                    ]
                }
            ]
        }
    ]
}