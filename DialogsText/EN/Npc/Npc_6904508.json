{
    "talkId": "6904508",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "Rosaria": 15
    },
    "dialogues": [
        {
            "id": "690450801",
            "speaker": "Player",
            "text": "Is there anything you'd like to do?"
        },
        {
            "id": "690450402",
            "speaker": "Rosaria",
            "text": "Hmm... let's go to the tavern."
        },
        {
            "id": "690450403",
            "speaker": "Rosaria",
            "text": "We'll drink to our hearts' delight, and who cares if we get drunk?",
            "choices": [
                {
                    "id": "690450404",
                    "text": "You actually get drunk?",
                    "response": [
                        {
                            "id": "690450406",
                            "speaker": "Rosaria",
                            "text": "...I've never allowed myself to get drunk."
                        },
                        {
                            "id": "690450407",
                            "speaker": "Rosaria",
                            "text": "I used to think it was idiotic to leave yourself vulnerable in front of others."
                        },
                        {
                            "id": "690450408",
                            "speaker": "Rosaria",
                            "text": "But my perspective on that has changed."
                        },
                        {
                            "id": "690450409",
                            "speaker": "Rosaria",
                            "text": "Huh... Maybe it's because I trust you... but that's beside the point."
                        },
                        {
                            "id": "690450410",
                            "speaker": "Rosaria",
                            "text": "Angel's Share or The Cat's Tail, which one you wanna go to?",
                            "choices": [
                                {
                                    "id": "690450411",
                                    "text": "Angel's Share.",
                                    "response": [
                                        {
                                            "id": "690450412",
                                            "speaker": "Rosaria",
                                            "text": "If it's from Dawn Winery, you can be absolutely assured of its quality."
                                        },
                                        {
                                            "id": "690450413",
                                            "speaker": "Rosaria",
                                            "text": "I'd recommend their Dandelion Wine."
                                        },
                                        {
                                            "id": "690450417",
                                            "speaker": "Rosaria",
                                            "text": "You'll throw back a couple of drinks with me, won't you?"
                                        },
                                        {
                                            "id": "690450418",
                                            "speaker": "Player",
                                            "text": "..."
                                        },
                                        {
                                            "id": "690450419",
                                            "speaker": "Rosaria",
                                            "text": "..."
                                        },
                                        {
                                            "id": "690450420",
                                            "speaker": "Rosaria",
                                            "text": "Never mind, I'll drink for you."
                                        },
                                        {
                                            "id": "690450421",
                                            "speaker": "Rosaria",
                                            "text": "Just return the favor when you're of age."
                                        }
                                    ]
                                },
                                {
                                    "id": "690450414",
                                    "text": "The Cat's Tail.",
                                    "response": [
                                        {
                                            "id": "690450415",
                                            "speaker": "Rosaria",
                                            "text": "Oh? Interested in their special cocktails, are you?"
                                        },
                                        {
                                            "id": "690450416",
                                            "speaker": "Rosaria",
                                            "text": "Their bartender doesn't work every day, but we can try our luck."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690450405",
                    "text": "I can't imagine you being drunk."
                }
            ]
        }
    ]
}