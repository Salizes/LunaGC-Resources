    "dialogues": [
        {
            "id": "663290101",
            "speaker": "Loshts",
            "text": "Such incredible \"intensity\"... It's thrilling! Absolutely thrilling!",
            "choices": [
                {
                    "id": "663290102",
                    "text": "Are you talking about me?",
                    "response": [
                        {
                            "id": "663290103",
                            "speaker": "Loshts",
                            "text": "Precisely, precisely! So, what do you say? Want to give the \"Warrior's Challenge\" a shot? Just sign up with the master. I've got high hopes for you!",
                            "choices": [
                                {
                                    "id": "663290106",
                                    "text": "I'll head over soon!",
                                    "response": [
                                        {
                                            "id": "663290107",
                                            "speaker": "Loshts",
                                            "text": "Lovely, lovely! Ah, I can hardly wait to see your legendary skills in action!"
                                        }
                                    ]
                                },
                                {
                                    "id": "663290108",
                                    "text": "Let me think about it...",
                                    "response": [
                                        {
                                            "id": "663290109",
                                            "speaker": "Loshts",
                                            "text": "Ah, a shame, a shame indeed... I suppose I won't get to witness you in action after all."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "663290104",
                    "text": "Sorry for disturbing you. Goodbye.",
                    "response": [
                        {
                            "id": "663290105",
                            "speaker": "Loshts",
                            "text": "Go well, go well."
                        }
                    ]
                }
            ]
        }
    ]
}