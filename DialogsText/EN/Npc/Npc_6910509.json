{
    "talkId": "6910509",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Ororon": 21,
        "Player": 14
    },
    "dialogues": [
        {
            "id": "691050401",
            "speaker": "Player",
            "text": "Anything you want to do?"
        },
        {
            "id": "691050402",
            "speaker": "Ororon",
            "text": "...I can't think of anything. Is there anything you recommend?"
        },
        {
            "id": "691050403",
            "speaker": "Player",
            "text": "How about... something peaceful?"
        },
        {
            "id": "691050404",
            "speaker": "Ororon",
            "text": "In that case... maybe you'd like to try out Phlogiston Engraving?"
        },
        {
            "id": "691050405",
            "speaker": "Ororon",
            "text": "It sounds more serious than it is. Basically, it involves painting patterns which can be activated to generate different effects, using either Phlogiston or elemental energy."
        },
        {
            "id": "691050406",
            "speaker": "Ororon",
            "text": "If we're not looking for a specific effect, we can make it even simpler by drawing random graffiti art and letting the rest happen naturally."
        },
        {
            "id": "691050407",
            "speaker": "Ororon",
            "text": "For instance, drawing Paimon on the back of your hand might trigger extreme hunger for a little while."
        },
        {
            "id": "691050408",
            "speaker": "Player",
            "text": "That checks out."
        },
        {
            "id": "691050409",
            "speaker": "Ororon",
            "text": "It all comes down to the pattern itself and the formula of the paint."
        },
        {
            "id": "691050410",
            "speaker": "Player",
            "text": "What about... something not peaceful at all?"
        },
        {
            "id": "691050411",
            "speaker": "Ororon",
            "text": "You mean some kind of sport or physical activity?"
        },
        {
            "id": "691050412",
            "speaker": "Ororon",
            "text": "We could race each other."
        },
        {
            "id": "691050413",
            "speaker": "Player",
            "text": "?",
            "choices": [
                {
                    "id": "691050414",
                    "text": "And by that you mean... seeing who can run away the fastest?",
                    "response": [
                        {
                            "id": "691050416",
                            "speaker": "Ororon",
                            "text": "Never underestimate yourself."
                        },
                        {
                            "id": "691050417",
                            "speaker": "Ororon",
                            "text": "If you're not feeling confident enough, I can show you how to make graffiti smoke bombs. That way, it's a fair contest.",
                            "choices": [
                                {
                                    "id": "691050418",
                                    "text": "I'd love that.",
                                    "response": [
                                        {
                                            "id": "691050420",
                                            "speaker": "Ororon",
                                            "text": "Oh... You're right."
                                        },
                                        {
                                            "id": "691050421",
                                            "speaker": "Ororon",
                                            "text": "This place feels so much like home, I almost forgot I'm still a guest. Sorry about that."
                                        },
                                        {
                                            "id": "691050422",
                                            "speaker": "Ororon",
                                            "text": "In that case, we'll have to settle for a good, old fashioned race. Fine by me, though — it's exercise either way."
                                        },
                                        {
                                            "id": "691050423",
                                            "speaker": "Player",
                                            "text": "Any other options?"
                                        },
                                        {
                                            "id": "691050424",
                                            "speaker": "Ororon",
                                            "text": "Sure. How about a combination of the two?"
                                        },
                                        {
                                            "id": "691050425",
                                            "speaker": "Ororon",
                                            "text": "In other words, doing graffiti while racing.",
                                            "choices": [
                                                {
                                                    "id": "691050426",
                                                    "text": "Haha!",
                                                    "response": [
                                                        {
                                                            "id": "691050429",
                                                            "speaker": "Ororon",
                                                            "text": "Based on your reaction, you're hoping it was a joke, right?"
                                                        },
                                                        {
                                                            "id": "691050430",
                                                            "speaker": "Ororon",
                                                            "text": "So, uh... Yeah. It was a joke."
                                                        },
                                                        {
                                                            "id": "691050431",
                                                            "speaker": "Player",
                                                            "text": "Thanks for chatting with me. It's been a lot of fun."
                                                        },
                                                        {
                                                            "id": "691050432",
                                                            "speaker": "Ororon",
                                                            "text": "Of course! And, anyway, I'm the one who should be thanking you."
                                                        },
                                                        {
                                                            "id": "691050433",
                                                            "speaker": "Ororon",
                                                            "text": "I don't get to visit friends' places very often, so I really appreciate you inviting me here."
                                                        },
                                                        {
                                                            "id": "691050434",
                                                            "speaker": "Player",
                                                            "text": "You're welcome! Feel free to stop by anytime."
                                                        },
                                                        {
                                                            "id": "691050435",
                                                            "speaker": "Ororon",
                                                            "text": "Thank you! Next time, I'll even bring along my prized radish — it's a big one."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691050427",
                                                    "text": "...You're kidding, right?",
                                                    "response": [
                                                        {
                                                            "id": "691050428",
                                                            "speaker": "Ororon",
                                                            "text": "...Yes?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691050419",
                                    "text": "But sounds like a tough clean-up..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691050415",
                    "text": "I'd lose for sure."
                }
            ]
        }
    ]
}