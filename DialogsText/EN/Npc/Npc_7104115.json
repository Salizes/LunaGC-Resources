    "dialogues": [
        {
            "id": "710411501",
            "speaker": "Taliesin",
            "text": "#We meet again, golden-haired {NICKNAME}!",
            "choices": [
                {
                    "id": "710411502",
                    "text": "Taliesin, have you come for a duel?",
                    "response": [
                        {
                            "id": "710411503",
                            "speaker": "Paimon",
                            "text": "Wait, what are you saying?"
                        },
                        {
                            "id": "710411505",
                            "speaker": "Taliesin",
                            "text": "Haha, I'm here to get some inspiration, of course! Listen to this: the hero without a past, bereft of any clan, and their loyal fairy retainer!"
                        },
                        {
                            "id": "710411506",
                            "speaker": "Paimon",
                            "text": "No idea who you're talking about."
                        },
                        {
                            "id": "710411507",
                            "speaker": "Player",
                            "text": "Yup. No idea here either."
                        },
                        {
                            "id": "710411508",
                            "speaker": "Taliesin",
                            "text": "Look, look! O modest hero, do not cast your perplexed gaze towards the distant mountains, for in this benighted land, you are the very light itself!"
                        },
                        {
                            "id": "710411509",
                            "speaker": "Paimon",
                            "text": "Eh?"
                        },
                        {
                            "id": "710411510",
                            "speaker": "Player",
                            "text": "What...?"
                        },
                        {
                            "id": "710411511",
                            "speaker": "Taliesin",
                            "text": "I'm talking about you! In my current written template, of course."
                        },
                        {
                            "id": "710411512",
                            "speaker": "Player",
                            "text": "Ah..."
                        },
                        {
                            "id": "710411513",
                            "speaker": "Paimon",
                            "text": "Huh, so this guy can actually say things we understand."
                        },
                        {
                            "id": "710411514",
                            "speaker": "Player",
                            "text": "See you."
                        },
                        {
                            "id": "710411515",
                            "speaker": "Taliesin",
                            "text": "#See you, gold-haired {NICKNAME}!"
                        }
                    ]
                },
                {
                    "id": "710411504",
                    "text": "What are you doing here?"
                }
            ]
        }
    ]
}