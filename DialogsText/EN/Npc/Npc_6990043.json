{
    "talkId": "6990043",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Paimon": 9,
        "Player": 9
    },
    "dialogues": [
        {
            "id": "699004301",
            "speaker": "Player",
            "text": "About Melusines..."
        },
        {
            "id": "699004302",
            "speaker": "Paimon",
            "text": "Apparently, every Melusine gets their own special token when they're born. They treat it as a symbol of their very being.",
            "choices": [
                {
                    "id": "699004303",
                    "text": "If you were a Melusine...",
                    "response": [
                        {
                            "id": "699004305",
                            "speaker": "Paimon",
                            "text": "Definitely a fork! To represent Paimon's lifelong mission to taste all the delicious food in the whole world!"
                        },
                        {
                            "id": "699004306",
                            "speaker": "Player",
                            "text": "Not Mora, then?"
                        },
                        {
                            "id": "699004307",
                            "speaker": "Paimon",
                            "text": "Ooh, good point... Yeah, if it were Mora, it'd mean that Paimon's destined to be a super rich person. Then Paimon could buy anything she wants!"
                        },
                        {
                            "id": "699004308",
                            "speaker": "Paimon",
                            "text": "Hmmmmm... Argh, Paimon's so torn! Both are so tempting...",
                            "choices": [
                                {
                                    "id": "699004309",
                                    "text": "How about a fork made from Mora?",
                                    "response": [
                                        {
                                            "id": "699004311",
                                            "speaker": "Paimon",
                                            "text": "Wow, that's a great idea!"
                                        },
                                        {
                                            "id": "699004312",
                                            "speaker": "Paimon",
                                            "text": "Anyway, enough about Paimon. Your token would probably be... a cooking pot, to represent being Paimon's personal gourmet chef!"
                                        },
                                        {
                                            "id": "699004313",
                                            "speaker": "Player",
                                            "text": "No no no, my token would be Paimon."
                                        },
                                        {
                                            "id": "699004314",
                                            "speaker": "Paimon",
                                            "text": "Aw, really?"
                                        },
                                        {
                                            "id": "699004315",
                                            "speaker": "Player",
                                            "text": "With Paimon as my token, everything that you have would ultimately belong to me."
                                        },
                                        {
                                            "id": "699004316",
                                            "speaker": "Paimon",
                                            "text": "Huh... Okay sure. Friends share everything, right?"
                                        },
                                        {
                                            "id": "699004317",
                                            "speaker": "Player",
                                            "text": "Haha, yeah... My stuff would still be mine..."
                                        },
                                        {
                                            "id": "699004318",
                                            "speaker": "Paimon",
                                            "text": "Hey, no fair!"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004310",
                                    "text": "Then you can have your cake and eat it, so to speak."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004304",
                    "text": "What would your token be?"
                }
            ]
        }
    ]
}