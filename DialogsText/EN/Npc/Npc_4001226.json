    "dialogues": [
        {
            "id": "400122601",
            "speaker": "Barbara",
            "text": "Honorary Knight, good timing! Would you like to watch the ocean together?",
            "choices": [
                {
                    "id": "400122602",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400122603",
                            "speaker": "Barbara",
                            "text": "Okay, is there anything you wanted to talk about?",
                            "choices": [
                                {
                                    "id": "400122604",
                                    "text": "Tell me about Ludi Harpastum...",
                                    "response": [
                                        {
                                            "id": "400122605",
                                            "speaker": "Barbara",
                                            "text": "You're probably familiar already but, Ludi Harpastum is a traditional Mondstadt festival."
                                        },
                                        {
                                            "id": "400122606",
                                            "speaker": "Barbara",
                                            "text": "During the festivities, we throw beautiful, brightly-colored harpasta into the air. It's a way for us to commemorate the Anemo Archon and send them glad tidings. A festival for all ages!"
                                        },
                                        {
                                            "id": "400122607",
                                            "speaker": "Barbara",
                                            "text": "Klee loves Ludi Harpastum. Still, it's not quite here yet... so I made her that special harpastum."
                                        },
                                        {
                                            "id": "400122608",
                                            "speaker": "Barbara",
                                            "text": "I hope it cheers her up. She has such a contagious smile, I can't help but smile myself when I see her... such a great feeling.",
                                            "choices": [
                                                {
                                                    "id": "400122604",
                                                    "text": "Tell me about Ludi Harpastum..."
                                                },
                                                {
                                                    "id": "400122609",
                                                    "text": "Tell me about these islands...",
                                                    "response": [
                                                        {
                                                            "id": "400122610",
                                                            "speaker": "Barbara",
                                                            "text": "I know my sister is always telling us to keep our guards up, but for me, these islands are a lot of fun."
                                                        },
                                                        {
                                                            "id": "400122611",
                                                            "speaker": "Barbara",
                                                            "text": "Sitting on the beach, looking out into the starry summer sky, humming along to the rolling waves..."
                                                        },
                                                        {
                                                            "id": "400122612",
                                                            "speaker": "Barbara",
                                                            "text": "It's so romantic..."
                                                        },
                                                        {
                                                            "id": "400122613",
                                                            "speaker": "Barbara",
                                                            "text": "And with you here, the summer feels just that much more special.",
                                                            "choices": [
                                                                {
                                                                    "id": "400122604",
                                                                    "text": "Tell me about Ludi Harpastum..."
                                                                },
                                                                {
                                                                    "id": "400122609",
                                                                    "text": "Tell me about these islands..."
                                                                },
                                                                {
                                                                    "id": "400122614",
                                                                    "text": "Tell me about yourself...",
                                                                    "response": [
                                                                        {
                                                                            "id": "400122615",
                                                                            "speaker": "Barbara",
                                                                            "text": "Oh... me?"
                                                                        },
                                                                        {
                                                                            "id": "400122616",
                                                                            "speaker": "Barbara",
                                                                            "text": "Well, I—I... Actually, I..."
                                                                        },
                                                                        {
                                                                            "id": "400122617",
                                                                            "speaker": "Barbara",
                                                                            "text": "*sigh* You wanna know the truth?"
                                                                        },
                                                                        {
                                                                            "id": "400122618",
                                                                            "speaker": "Barbara",
                                                                            "text": "I only came to the islands out of concern for everyone's safety... Though, I admit.... that I didn't want to miss out on traveling together with all of you either."
                                                                        },
                                                                        {
                                                                            "id": "400122619",
                                                                            "speaker": "Barbara",
                                                                            "text": "I—I hope you won't laugh at me. After all, a deaconess shouldn't concern herself with matters of fun and games..."
                                                                        },
                                                                        {
                                                                            "id": "400122620",
                                                                            "speaker": "Player",
                                                                            "text": "I wouldn't dare."
                                                                        },
                                                                        {
                                                                            "id": "400122621",
                                                                            "speaker": "Barbara",
                                                                            "text": "Phew... then I'm glad.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400122604",
                                                                                    "text": "Tell me about Ludi Harpastum..."
                                                                                },
                                                                                {
                                                                                    "id": "400122609",
                                                                                    "text": "Tell me about these islands..."
                                                                                },
                                                                                {
                                                                                    "id": "400122614",
                                                                                    "text": "Tell me about yourself..."
                                                                                },
                                                                                {
                                                                                    "id": "400122622",
                                                                                    "text": "About what happened today...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400122623",
                                                                                            "speaker": "Barbara",
                                                                                            "text": "I had no idea the others would be here, too. It was so nice to have everyone suddenly together like that."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122624",
                                                                                            "speaker": "Barbara",
                                                                                            "text": "I want to use this opportunity to get closer to everyone... especially my sister."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122625",
                                                                                            "speaker": "Barbara",
                                                                                            "text": "It might just be her personality, but she's always incredibly busy. She carries a lot on her shoulders."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122626",
                                                                                            "speaker": "Barbara",
                                                                                            "text": "I hope she can start to take more time for herself and relax a little more... At the very least, I hope I can make her happy when I'm around."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122627",
                                                                                            "speaker": "Barbara",
                                                                                            "text": "I wonder if I should sing her a song? Hmm...",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "400122604",
                                                                                                    "text": "Tell me about Ludi Harpastum..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122609",
                                                                                                    "text": "Tell me about these islands..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122614",
                                                                                                    "text": "Tell me about yourself..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122622",
                                                                                                    "text": "About what happened today..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122628",
                                                                                                    "text": "I won't disturb you.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "400122629",
                                                                                                            "speaker": "Barbara",
                                                                                                            "text": "No problem, see you later!"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
