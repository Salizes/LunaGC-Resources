    },
    "dialogues": [
        {
            "id": "620570201",
            "speaker": "Player",
            "text": "What was that noise?"
        },
        {
            "id": "620570202",
            "speaker": "Yicheng",
            "text": "Oh, it's just... *LOUD RUMBLING*"
        },
        {
            "id": "620570203",
            "speaker": "Yicheng",
            "text": "My tummy rumbling... *LOUD RUMBLING*"
        },
        {
            "id": "620570204",
            "speaker": "Yicheng",
            "text": "Because... *LOUD RUMBLING*"
        },
        {
            "id": "620570205",
            "speaker": "Yicheng",
            "text": "I'm always hungry, so it always... *LOUD RUMBLING* rumbles... *LOUD RUMBLING*",
            "choices": [
                {
                    "id": "620570206",
                    "text": "...Are you sure you're okay?",
                    "response": [
                        {
                            "id": "620570207",
                            "speaker": "Yicheng",
                            "text": "I'm fine... *LOUD RUMBLING*"
                        },
                        {
                            "id": "620570208",
                            "speaker": "Yicheng",
                            "text": "Apart from the fact that the... *LOUD RUMBLING* rumbling is so loud..."
                        },
                        {
                            "id": "620570209",
                            "speaker": "Yicheng",
                            "text": "That it drowns out my... *LOUD RUMBLING* voice..."
                        },
                        {
                            "id": "620570210",
                            "speaker": "Yicheng",
                            "text": "Everything else is... *LOUD RUMBLING* fine..."
                        }
                    ]
                },
                {
                    "id": "620570211",
                    "text": "Should I run and get you a bite to eat!?",
                    "response": [
                        {
                            "id": "620570212",
                            "speaker": "Yicheng",
                            "text": "That would be amazing!"
                        },
                        {
                            "id": "620570213",
                            "speaker": "Yicheng",
                            "text": "Right now, I could go for a *LOUD RUMBLING* ..."
                        },
                        {
                            "id": "620570214",
                            "speaker": "Yicheng",
                            "text": "And I could murder a *LOUD RUMBLING* ..."
                        },
                        {
                            "id": "620570215",
                            "speaker": "Yicheng",
                            "text": "Also, I've got a real craving for *LOUD RUMBLING* with a side of *LOUD RUMBLING* ..."
                        },
                        {
                            "id": "620570216",
                            "speaker": "Yicheng",
                            "text": "...That should do it. Thank you so much!"
                        }
                    ]
                }
            ]
        }
    ]
}