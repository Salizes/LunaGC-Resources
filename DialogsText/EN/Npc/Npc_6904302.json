    "dialogues": [
        {
            "id": "690430201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690430202",
            "speaker": "Sucrose",
            "text": "Oh, uh... Please don't worry about me."
        },
        {
            "id": "690430203",
            "speaker": "Sucrose",
            "text": "As long as there's a dedicated laboratory, I am more than satisfied."
        },
        {
            "id": "690430204",
            "speaker": "Sucrose",
            "text": "Your home far exceeds my needs.",
            "choices": [
                {
                    "id": "690430205",
                    "text": "No need to hold back.",
                    "response": [
                        {
                            "id": "690430207",
                            "speaker": "Sucrose",
                            "text": "Oh... Um..."
                        },
                        {
                            "id": "690430208",
                            "speaker": "Sucrose",
                            "text": "I'd feel guilty to trouble you..."
                        },
                        {
                            "id": "690430209",
                            "speaker": "Sucrose",
                            "text": "But I greatly appreciate your kindness. It means a lot."
                        }
                    ]
                },
                {
                    "id": "690430206",
                    "text": "If there's equipment you need, just say the word."
                }
            ]
        }
    ]
}