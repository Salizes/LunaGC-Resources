{
    "talkId": "6904807",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 6,
        "Yanfei": 12
    },
    "dialogues": [
        {
            "id": "690480701",
            "speaker": "Player",
            "text": "Would you like to have a chat with me?"
        },
        {
            "id": "690480302",
            "speaker": "Yanfei",
            "text": "Chat? Oh, I don't know about you, but I can chat, for sure! Good luck trying to get me to stop talking..."
        },
        {
            "id": "690480303",
            "speaker": "Yanfei",
            "text": "You seem like the quiet type, are you sure you won't find me too... animated?",
            "choices": [
                {
                    "id": "690480304",
                    "text": "I'm sure I'll manage...",
                    "response": [
                        {
                            "id": "690480305",
                            "speaker": "Yanfei",
                            "text": "Oh... good!"
                        },
                        {
                            "id": "690480306",
                            "speaker": "Yanfei",
                            "text": "I'm not sure why, but it's nice to hear you say that."
                        },
                        {
                            "id": "690480307",
                            "speaker": "Yanfei",
                            "text": "In that case, why don't you choose a topic?"
                        },
                        {
                            "id": "690480312",
                            "speaker": "Player",
                            "text": "Well then... let's chat about difficult clients of yours."
                        },
                        {
                            "id": "690480313",
                            "speaker": "Yanfei",
                            "text": "Huh? Of all the interesting topics you could choose, that's what you wanna talk about?",
                            "choices": [
                                {
                                    "id": "690480314",
                                    "text": "Most of the time you successfully win them over.",
                                    "response": [
                                        {
                                            "id": "690480316",
                                            "speaker": "Yanfei",
                                            "text": "Oh... I—I see."
                                        },
                                        {
                                            "id": "690480317",
                                            "speaker": "Yanfei",
                                            "text": "Thank you..."
                                        },
                                        {
                                            "id": "690480318",
                                            "speaker": "Yanfei",
                                            "text": "Ahem, then I'll start with a client who came to me with a civil case recently..."
                                        }
                                    ]
                                },
                                {
                                    "id": "690480315",
                                    "text": "This way, we can figure out any outstanding issues."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690480308",
                    "text": "I'm quite happy just to listen.",
                    "response": [
                        {
                            "id": "690480309",
                            "speaker": "Yanfei",
                            "text": "Uh... Just to listen?"
                        },
                        {
                            "id": "690480310",
                            "speaker": "Yanfei",
                            "text": "I don't think one person talking technically qualifies as a chat, per se..."
                        },
                        {
                            "id": "690480311",
                            "speaker": "Yanfei",
                            "text": "I'm no storyteller after all — I already found my calling in life. I don't plan on spinning yarns for a living any time soon."
                        }
                    ]
                }
            ]
        }
    ]
}