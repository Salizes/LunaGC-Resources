{
    "talkId": "6900308",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Jean": 12,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "690030801",
            "speaker": "Jean",
            "text": "Of course, it's always a pleasure to be in your company."
        },
        {
            "id": "690030802",
            "speaker": "Jean",
            "text": "Is there a particular topic that you wish to discuss?",
            "choices": [
                {
                    "id": "690030803",
                    "text": "Anything, except work...",
                    "response": [
                        {
                            "id": "690030804",
                            "speaker": "Jean",
                            "text": "I apologize... Evidently, I talk about work so much that it gets quite exasperating for the people around me."
                        },
                        {
                            "id": "690030805",
                            "speaker": "Jean",
                            "text": "I will think on this."
                        },
                        {
                            "id": "690030806",
                            "speaker": "Player",
                            "text": "Jean, no need to take it so seriously..."
                        },
                        {
                            "id": "690030807",
                            "speaker": "Jean",
                            "text": "I—I am sorry..."
                        },
                        {
                            "id": "690030808",
                            "speaker": "Jean",
                            "text": "I understand. You mean to say that we should be more informal in the way we interact with each other."
                        },
                        {
                            "id": "690030816",
                            "speaker": "Jean",
                            "text": "O—Okay, I..."
                        },
                        {
                            "id": "690030817",
                            "speaker": "Jean",
                            "text": "I will do my best..."
                        }
                    ]
                },
                {
                    "id": "690030809",
                    "text": "I've heard that you sing quite well?",
                    "response": [
                        {
                            "id": "690030810",
                            "speaker": "Jean",
                            "text": "...Only a few simple songs."
                        },
                        {
                            "id": "690030811",
                            "speaker": "Jean",
                            "text": "It's really nothing to brag about."
                        },
                        {
                            "id": "690030812",
                            "speaker": "Player",
                            "text": "I want to hear you sing."
                        },
                        {
                            "id": "690030813",
                            "speaker": "Jean",
                            "text": "Ah, um... But I'm completely unprepared..."
                        },
                        {
                            "id": "690030814",
                            "speaker": "Jean",
                            "text": "At the very least, let me practice first."
                        }
                    ]
                },
                {
                    "id": "690030815",
                    "text": "If that works for you, it works for me."
                }
            ]
        }
    ]
}