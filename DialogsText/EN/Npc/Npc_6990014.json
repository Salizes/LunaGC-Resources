    "dialogues": [
        {
            "id": "699001401",
            "speaker": "Player",
            "text": "About Effort and Reward"
        },
        {
            "id": "699001402",
            "speaker": "Paimon",
            "text": "Paimon finds that hard work hardly works here in Mondstadt."
        },
        {
            "id": "699001403",
            "speaker": "Player",
            "text": "Why'd you say so?"
        },
        {
            "id": "699001404",
            "speaker": "Paimon",
            "text": "Just look at Huffman from the Knights of Favonius. He does his best at his duties every day..."
        },
        {
            "id": "699001405",
            "speaker": "Paimon",
            "text": "But the ever-relaxed Captain Kaeya is his boss.",
            "choices": [
                {
                    "id": "699001406",
                    "text": "Hmm, but isn't Jean, who works the hardest...",
                    "response": [
                        {
                            "id": "699001408",
                            "speaker": "Paimon",
                            "text": "W—Well, how about this, then..."
                        },
                        {
                            "id": "699001409",
                            "speaker": "Paimon",
                            "text": "Venti's the god of Mondstadt, and he's the laziest of them all!"
                        }
                    ]
                },
                {
                    "id": "699001407",
                    "text": "...The Acting Grand Master?"
                }
            ]
        }
    ]
}