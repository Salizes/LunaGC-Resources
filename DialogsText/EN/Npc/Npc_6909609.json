{
    "talkId": "6909609",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Arlecchino": 9,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690960201",
            "speaker": "Player",
            "text": "How do you like it here?"
        },
        {
            "id": "690960202",
            "speaker": "Arlecchino",
            "text": "Thank you for inviting me to this realm. This has proved a fine vacation spot."
        },
        {
            "id": "690960203",
            "speaker": "Arlecchino",
            "text": "Is a transfer of ownership on the cards, by any chance?",
            "choices": [
                {
                    "id": "690960204",
                    "text": "...Huh!?",
                    "response": [
                        {
                            "id": "690960206",
                            "speaker": "Arlecchino",
                            "text": "No need to startle. This is a quiet and secure location, shielded from outside disturbances. It would make for a good backup base."
                        },
                        {
                            "id": "690960207",
                            "speaker": "Arlecchino",
                            "text": "Any object that could solve many problems is worth paying a fair price for.",
                            "choices": [
                                {
                                    "id": "690960208",
                                    "text": "Sorry to disappoint...",
                                    "response": [
                                        {
                                            "id": "690960210",
                                            "speaker": "Arlecchino",
                                            "text": "An unfortunate answer, but not an unexpected one."
                                        },
                                        {
                                            "id": "690960211",
                                            "speaker": "Arlecchino",
                                            "text": "This resembles a \"home\" more than it does a base. Let us keep it that way, then."
                                        },
                                        {
                                            "id": "690960212",
                                            "speaker": "Player",
                                            "text": "Speaking of \"home\"..."
                                        },
                                        {
                                            "id": "690960213",
                                            "speaker": "Arlecchino",
                                            "text": "Is something the matter?",
                                            "choices": [
                                                {
                                                    "id": "690960214",
                                                    "text": "Want to hold a \"family barbecue\"?",
                                                    "response": [
                                                        {
                                                            "id": "690960216",
                                                            "speaker": "Arlecchino",
                                                            "text": "A fine suggestion. This space is sufficiently large for a family gathering."
                                                        },
                                                        {
                                                            "id": "690960217",
                                                            "speaker": "Arlecchino",
                                                            "text": "The children will be glad to have the chance to visit and play at a friend's place. It is agreed, then... as for the costs of this gathering, simply leave it to me."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690960215",
                                                    "text": "All the children from the House of the Hearth would be welcome to come."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690960209",
                                    "text": "But this isn't for sale."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690960205",
                    "text": "You want to buy the Serenitea Pot?"
                }
            ]
        }
    ]
}