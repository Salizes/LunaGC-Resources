{
    "talkId": "6904402",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "Xinyan": 8
    },
    "dialogues": [
        {
            "id": "690440201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Do you like it here?</color>"
        },
        {
            "id": "690440202",
            "speaker": "Xinyan",
            "text": "Yeah! There's enough space and freedom — what a great rehearsal venue!",
            "choices": [
                {
                    "id": "690440203",
                    "text": "Can I watch you rehearse?",
                    "response": [
                        {
                            "id": "690440204",
                            "speaker": "Xinyan",
                            "text": "Uhh... If it's alright, I'd rather perform for you after I practice up."
                        },
                        {
                            "id": "690440205",
                            "speaker": "Xinyan",
                            "text": "That'll give you the best listenin' experience."
                        },
                        {
                            "id": "690440206",
                            "speaker": "Xinyan",
                            "text": "But thanks for your cheers! I'll do my best!"
                        },
                        {
                            "id": "690440210",
                            "speaker": "Xinyan",
                            "text": "Oh, right! After each rehearsal, I make sure to tidy up after myself."
                        },
                        {
                            "id": "690440211",
                            "speaker": "Xinyan",
                            "text": "Don't worry, I'll have this place like new!"
                        }
                    ]
                },
                {
                    "id": "690440207",
                    "text": "Thanks for liking it here...",
                    "response": [
                        {
                            "id": "690440208",
                            "speaker": "Xinyan",
                            "text": "Hey, what are you sayin'?"
                        },
                        {
                            "id": "690440209",
                            "speaker": "Xinyan",
                            "text": "If anything, I ought to be the one thanking YOU! Inviting me to your house, not tellin' me what I can and can't do."
                        }
                    ]
                }
            ]
        }
    ]
}