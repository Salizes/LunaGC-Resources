{
    "talkId": "6990053",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Paimon": 9,
        "Player": 12
    },
    "dialogues": [
        {
            "id": "699005301",
            "speaker": "Player",
            "text": "About Strange Technology",
            "choices": [
                {
                    "id": "699005302",
                    "text": "Come to think of it, we've met not one but two genius inventors in Nod-Krai, haven't we?",
                    "response": [
                        {
                            "id": "699005304",
                            "speaker": "Paimon",
                            "text": "Yeah, you're right. And the proof of their genius is in the hi-tech pudding: Ineffa Pudding and Pulonia Pudding!"
                        },
                        {
                            "id": "699005305",
                            "speaker": "Paimon",
                            "text": "Actually... Okay, well \"Pulonia Pudding\" kinda works, Paimon's not gonna lose any sleep over that one... but Ineffa Pudding feels a little disrespectful...",
                            "choices": [
                                {
                                    "id": "699005306",
                                    "text": "I'm speechless... After years of giving people ugly nicknames, you're finally learning!",
                                    "response": [
                                        {
                                            "id": "699005308",
                                            "speaker": "Paimon",
                                            "text": "Hey!",
                                            "choices": [
                                                {
                                                    "id": "699005309",
                                                    "text": "Seriously though...",
                                                    "response": [
                                                        {
                                                            "id": "699005311",
                                                            "speaker": "Paimon",
                                                            "text": "Are you for real!? Who's the name-caller now, huh!? Also, fantasizing about violence is a way worse habit than giving people ugly nicknames..."
                                                        },
                                                        {
                                                            "id": "699005312",
                                                            "speaker": "Paimon",
                                                            "text": "...Honestly, though? After everything that's happened recently, it's hard to imagine them getting into a fight. Everyone's getting along pretty well these days."
                                                        },
                                                        {
                                                            "id": "699005313",
                                                            "speaker": "Paimon",
                                                            "text": "It's just as dumb as trying to imagine Jean and Diluc in a fight..."
                                                        },
                                                        {
                                                            "id": "699005314",
                                                            "speaker": "Player",
                                                            "text": "I can't believe you still remember that..."
                                                        },
                                                        {
                                                            "id": "699005315",
                                                            "speaker": "Player",
                                                            "text": "Ahem, but anyway... we're getting sidetracked. Back to Ineffa and Pulonia: I've thought of a foolproof way of figuring out who's stronger...",
                                                            "choices": [
                                                                {
                                                                    "id": "699005316",
                                                                    "text": "All you'd have to do is lock them both in a room...",
                                                                    "response": [
                                                                        {
                                                                            "id": "699005318",
                                                                            "speaker": "Paimon",
                                                                            "text": "What the...!"
                                                                        },
                                                                        {
                                                                            "id": "699005319",
                                                                            "speaker": "Player",
                                                                            "text": "...And whoever gets destroyed last is clearly the strongest!"
                                                                        },
                                                                        {
                                                                            "id": "699005320",
                                                                            "speaker": "Paimon",
                                                                            "text": "Mmm, Paimon's not convinced. Like, sometimes, the more advanced technology is also the more fragile, right?"
                                                                        },
                                                                        {
                                                                            "id": "699005321",
                                                                            "speaker": "Paimon",
                                                                            "text": "...Ugh, what are we talking about? Enough! No more imaginary fights between friends!"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "699005317",
                                                                    "text": "Then drop Lynette inside..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "699005310",
                                                    "text": "Who do you think would win in a fight between Ineffa the Annihilator and Pulonia the Pulverizer?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "699005307",
                                    "text": "Yes, Paimon, name-calling IS disrespectful!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699005303",
                    "text": "First Aino, and then Sandrone."
                }
            ]
        }
    ]
}