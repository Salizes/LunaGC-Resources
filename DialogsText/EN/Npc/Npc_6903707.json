{
    "talkId": "6903707",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Ganyu": 10,
        "Player": 7
    },
    "dialogues": [
        {
            "id": "690370701",
            "speaker": "Player",
            "text": "Would you like to have a chat with me?"
        },
        {
            "id": "690370302",
            "speaker": "Ganyu",
            "text": "Sure... but I may not be able to offer any practical advice if our topic of discussion is not work-related.",
            "choices": [
                {
                    "id": "690370303",
                    "text": "I just meant small talk.",
                    "response": [
                        {
                            "id": "690370305",
                            "speaker": "Ganyu",
                            "text": "Oh, a—alright..."
                        },
                        {
                            "id": "690370306",
                            "speaker": "Ganyu",
                            "text": "You know, I used to agonize a lot over whether to try and integrate into human society."
                        },
                        {
                            "id": "690370307",
                            "speaker": "Ganyu",
                            "text": "When our workload is light, my coworkers sometimes organize social events."
                        },
                        {
                            "id": "690370308",
                            "speaker": "Ganyu",
                            "text": "But my strict vegetarian diet is completely different from everyone else's. And I don't really share their interest in shopping or lively forms of entertainment."
                        },
                        {
                            "id": "690370309",
                            "speaker": "Ganyu",
                            "text": "Sometimes they can be quite critical... People say that my whole mindset is just fundamentally different from an ordinary person's..."
                        },
                        {
                            "id": "690370310",
                            "speaker": "Ganyu",
                            "text": "But what can I do? It's hard to change your habits when they've been that way for thousands of years...",
                            "choices": [
                                {
                                    "id": "690370311",
                                    "text": "I'll think of a social activity that you would find easier to accept.",
                                    "response": [
                                        {
                                            "id": "690370313",
                                            "speaker": "Ganyu",
                                            "text": "Then it would only be proper for me to offer you something in return! Shall I take you out... for a meal? In a restaurant?",
                                            "choices": [
                                                {
                                                    "id": "690370314",
                                                    "text": "We're friends, so there's no need for all that formality.",
                                                    "response": [
                                                        {
                                                            "id": "690370315",
                                                            "speaker": "Ganyu",
                                                            "text": "Ahh... Okay... Duly noted!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690370316",
                                                    "text": "Sounds good, I'll take the opportunity to share more knowledge with you.",
                                                    "response": [
                                                        {
                                                            "id": "690370317",
                                                            "speaker": "Ganyu",
                                                            "text": "...Great, with your help, I'm sure I'll be able to integrate into human society in no time."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690370312",
                                    "text": "I can go with you and help you slowly get accustomed."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690370304",
                    "text": "Don't worry about that."
                }
            ]
        }
    ]
}