{
    "talkId": "6142702",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Donna": 15,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "4015142702",
            "speaker": "Player",
            "text": "Who are you?"
        },
        {
            "id": "4015142706",
            "speaker": "Donna",
            "text": "...Huh?"
        },
        {
            "id": "4015142707",
            "speaker": "Donna",
            "text": "I'm just an ordinary girl... helping out here..."
        },
        {
            "id": "4015142708",
            "speaker": "Donna",
            "text": "(Gosh, am I blushing?)"
        },
        {
            "id": "4015142709",
            "speaker": "Donna",
            "text": "(I was daydreaming about Diluc giving me flowers... Was it obvious?)"
        },
        {
            "id": "4015142710",
            "speaker": "Donna",
            "text": "Don't... don't look at me like that... There's nothing special about me.",
            "choices": [
                {
                    "id": "4015142703",
                    "text": "Diluc?",
                    "response": [
                        {
                            "id": "4015142711",
                            "speaker": "Donna",
                            "text": "Oh... Did I just... say...?"
                        },
                        {
                            "id": "4015142712",
                            "speaker": "Donna",
                            "text": "I'm sorry..."
                        },
                        {
                            "id": "4015142713",
                            "speaker": "Donna",
                            "text": "I've been daydreaming about meeting Diluc here... so I..."
                        },
                        {
                            "id": "4015142714",
                            "speaker": "Donna",
                            "text": "No, I didn't..."
                        },
                        {
                            "id": "4015142715",
                            "speaker": "Donna",
                            "text": "(What do I do? I love Diluc so much!)"
                        }
                    ]
                },
                {
                    "id": "4015142704",
                    "text": "Moon Pie?",
                    "response": [
                        {
                            "id": "4015142716",
                            "speaker": "Donna",
                            "text": "Are you here... for the Moon Pies?"
                        },
                        {
                            "id": "4015142717",
                            "speaker": "Donna",
                            "text": "They are a specialty of Mondstadt, a kind of meat pie that is sweet and fulfilling."
                        },
                        {
                            "id": "4015142718",
                            "speaker": "Donna",
                            "text": "(I could make a delicious Moon Pie and give it to Diluc...)"
                        },
                        {
                            "id": "4015142719",
                            "speaker": "Donna",
                            "text": "(Stop... stop it, Donna!)"
                        },
                        {
                            "id": "4015142720",
                            "speaker": "Donna",
                            "text": "If you have the chance, be sure to check them out!"
                        }
                    ]
                }
            ]
        }
    ]
}