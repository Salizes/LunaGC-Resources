{
    "talkId": "37312",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Jean": 9,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "3730902",
            "speaker": "Jean",
            "text": "About Stormterror, there must be something we are still not aware of...",
            "choices": [
                {
                    "id": "3730903",
                    "text": "How do we fight Stormterror?",
                    "response": [
                        {
                            "id": "3730904",
                            "speaker": "Jean",
                            "text": "Its change in size and power really is suspicious."
                        },
                        {
                            "id": "3730905",
                            "speaker": "Jean",
                            "text": "But for the Knights of Favonius, our priority is to deal with the aftermath of this attack."
                        },
                        {
                            "id": "3730906",
                            "speaker": "Jean",
                            "text": "The Grand Master entrusted the Knights of Favonius to me. I cannot let him or the people of Mondstadt down."
                        },
                        {
                            "id": "3730907",
                            "speaker": "Jean",
                            "text": "I must get to the bottom of this..."
                        }
                    ]
                },
                {
                    "id": "3730908",
                    "text": "Tell me about the Fatui.",
                    "response": [
                        {
                            "id": "3730909",
                            "speaker": "Jean",
                            "text": "Those people in strange uniforms... are Fatui."
                        },
                        {
                            "id": "3730910",
                            "speaker": "Jean",
                            "text": "They're here as delegates from Snezhnaya."
                        },
                        {
                            "id": "3730911",
                            "speaker": "Jean",
                            "text": "Stay away from them. Having contact with them is dangerous, even for innocent travelers."
                        }
                    ]
                },
                {
                    "id": "3730912",
                    "text": "Goodbye.",
                    "response": [
                        {
                            "id": "3730913",
                            "speaker": "Jean",
                            "text": "May the Wind guide you."
                        }
                    ]
                }
            ]
        }
    ]
}