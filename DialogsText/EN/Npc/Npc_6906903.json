{
    "talkId": "6906903",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 8,
        "Tighnari": 17
    },
    "dialogues": [
        {
            "id": "690690301",
            "speaker": "Player",
            "text": "Want to chat?"
        },
        {
            "id": "690690302",
            "speaker": "Tighnari",
            "text": "Of course. Anything you want to talk about?"
        },
        {
            "id": "690690303",
            "speaker": "Tighnari",
            "text": "If you let me start the conversation, it would definitely be about plants.",
            "choices": [
                {
                    "id": "690690304",
                    "text": "It's fine. I was expecting that, anyway.",
                    "response": [
                        {
                            "id": "690690306",
                            "speaker": "Tighnari",
                            "text": "Oh? So you're ready for class?"
                        },
                        {
                            "id": "690690307",
                            "speaker": "Tighnari",
                            "text": "Then let us begin with the basics. Botany is a branch of biology that focuses on the morphology, taxonomy, ecology, genetics, and evolution of plants."
                        },
                        {
                            "id": "690690308",
                            "speaker": "Tighnari",
                            "text": "The basic taxonomical classification of plants is as follows:",
                            "choices": [
                                {
                                    "id": "690690309",
                                    "text": "Zzz... zzz...",
                                    "response": [
                                        {
                                            "id": "690690311",
                                            "speaker": "Tighnari",
                                            "text": "No daydreaming, sleepyhead! This is what you asked for."
                                        },
                                        {
                                            "id": "690690312",
                                            "speaker": "Tighnari",
                                            "text": "...Heh, alright, I'm only teasing. People who don't work in this field don't have to bash their heads against the books."
                                        },
                                        {
                                            "id": "690690313",
                                            "speaker": "Tighnari",
                                            "text": "However, you spend a considerable amount of time traveling and traipsing through the outdoors. It would behoove you to learn a thing or two about common plants."
                                        },
                                        {
                                            "id": "690690314",
                                            "speaker": "Tighnari",
                                            "text": "For instance, discerning a plant's growth patterns to orient position, how to use stems and leaves to acquire potable water..."
                                        },
                                        {
                                            "id": "690690315",
                                            "speaker": "Tighnari",
                                            "text": "Which fruits are edible and palatable, which herbs are suitable for cooking with meat...",
                                            "choices": [
                                                {
                                                    "id": "690690316",
                                                    "text": "Oh no, I'm starting to drool...",
                                                    "response": [
                                                        {
                                                            "id": "690690318",
                                                            "speaker": "Tighnari",
                                                            "text": "Hey, what's the matter with you!? Is this what happens when you hear anything remotely about food?"
                                                        },
                                                        {
                                                            "id": "690690319",
                                                            "speaker": "Player",
                                                            "text": "It's mostly Paimon's fault..."
                                                        },
                                                        {
                                                            "id": "690690320",
                                                            "speaker": "Tighnari",
                                                            "text": "Ah yes, your little partner..."
                                                        },
                                                        {
                                                            "id": "690690321",
                                                            "speaker": "Tighnari",
                                                            "text": "She doesn't seem the most... intellectual sort, but she cares deeply about you."
                                                        },
                                                        {
                                                            "id": "690690322",
                                                            "speaker": "Tighnari",
                                                            "text": "Even if it's only for the sake of protecting your companion, you should learn more about the natural sciences."
                                                        },
                                                        {
                                                            "id": "690690323",
                                                            "speaker": "Tighnari",
                                                            "text": "Ah... Sorry, I slipped into training mode there for a second, look at me, talking to you like you're a rookie Forest Ranger. ...Please forgive me."
                                                        },
                                                        {
                                                            "id": "690690324",
                                                            "speaker": "Tighnari",
                                                            "text": "Anyway, you're smart enough to understand what I meant."
                                                        },
                                                        {
                                                            "id": "690690325",
                                                            "speaker": "Tighnari",
                                                            "text": "If you ever wish to learn more about flora, my door is open any time."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690690317",
                                                    "text": "Professor, I'm hungry."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690690310",
                                    "text": "*yawn*"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690690305",
                    "text": "Teach me something, Professor."
                }
            ]
        }
    ]
}