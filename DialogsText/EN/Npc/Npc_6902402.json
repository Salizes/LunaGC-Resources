{
    "talkId": "6902402",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Beidou": 8,
        "Player": 3
    },
    "dialogues": [
        {
            "id": "690240201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690240202",
            "speaker": "Beidou",
            "text": "Yeah, pretty good! Feels nice to sit and relax in such a scenic place!"
        },
        {
            "id": "690240203",
            "speaker": "Beidou",
            "text": "But...",
            "choices": [
                {
                    "id": "690240204",
                    "text": "But what?",
                    "response": [
                        {
                            "id": "690240205",
                            "speaker": "Beidou",
                            "text": "But you know that I'll be craving the billowing waves of the open ocean before too long! It's where I belong."
                        },
                        {
                            "id": "690240206",
                            "speaker": "Beidou",
                            "text": "The churning ocean waves are the best lullaby."
                        },
                        {
                            "id": "690240210",
                            "speaker": "Beidou",
                            "text": "Oh, don't get me wrong. I'm thrilled that you invited me here."
                        },
                        {
                            "id": "690240211",
                            "speaker": "Beidou",
                            "text": "I'll have to return the favor sometime by hosting you onboard the ship!"
                        }
                    ]
                },
                {
                    "id": "690240207",
                    "text": "But you miss the sea already?",
                    "response": [
                        {
                            "id": "690240208",
                            "speaker": "Beidou",
                            "text": "Haha! You get me!"
                        },
                        {
                            "id": "690240209",
                            "speaker": "Beidou",
                            "text": "Days spent sailing through a storm, conquering the surging waters... yeah, those are happy days!"
                        }
                    ]
                }
            ]
        }
    ]
}