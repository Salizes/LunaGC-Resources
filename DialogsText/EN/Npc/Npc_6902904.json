{
    "talkId": "6902904",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Klee": 12,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690290401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
        },
        {
            "id": "690290402",
            "speaker": "Klee",
            "text": "#Yes! There's something that Klee needs your help with, {F#Miss}{M#Mr.} Honorary Knight!"
        },
        {
            "id": "690290403",
            "speaker": "Klee",
            "text": "I wanna make a Jumpy Army!",
            "choices": [
                {
                    "id": "690290404",
                    "text": "...A Jumpy what?",
                    "response": [
                        {
                            "id": "690290405",
                            "speaker": "Klee",
                            "text": "A Jumpy Army! It's just... lots and lots and lots of Jumpy Dumpties."
                        },
                        {
                            "id": "690290406",
                            "speaker": "Klee",
                            "text": "#{F#Miss}{M#Mr.} Honorary Knight, pleeeeaaaase."
                        },
                        {
                            "id": "690290407",
                            "speaker": "Player",
                            "text": "Alright then..."
                        },
                        {
                            "id": "690290410",
                            "speaker": "Klee",
                            "text": "Then let's get started!"
                        },
                        {
                            "id": "690290411",
                            "speaker": "Klee",
                            "text": "#I'll be responsible for making Jumpy Dumpties, so {F#Miss}{M#Mr.} Honorary Knight can give jobs to them."
                        },
                        {
                            "id": "690290412",
                            "speaker": "Klee",
                            "text": "We need a shopkeeper, a chef, an artist, a circus performer...",
                            "choices": [
                                {
                                    "id": "690290413",
                                    "text": "Those don't sound like army ranks...",
                                    "response": [
                                        {
                                            "id": "690290414",
                                            "speaker": "Klee",
                                            "text": "It's okay! They're here for Ludi Harpastum."
                                        },
                                        {
                                            "id": "690290417",
                                            "speaker": "Klee",
                                            "text": "#With the Jumpy Army, Klee can celebrate Ludi Harpastum with {F#Miss}{M#Mr.} Honorary Knight every day!"
                                        },
                                        {
                                            "id": "690290418",
                                            "speaker": "Klee",
                                            "text": "#A Ludi Harpastum with {F#Miss}{M#Mr.} Honorary Knight will be the bestest Ludi Harpastum!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690290415",
                                    "text": "Sounds a bit complicated.",
                                    "response": [
                                        {
                                            "id": "690290416",
                                            "speaker": "Klee",
                                            "text": "It's fine. As long as everyone wears little accessories, you can tell what they're supposed to be!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690290408",
                    "text": "Sure, I can help out.",
                    "response": [
                        {
                            "id": "690290409",
                            "speaker": "Klee",
                            "text": "#Yay, {F#Miss}{M#Mr.} Honorary Knight is the best!"
                        }
                    ]
                }
            ]
        }
    ]
}