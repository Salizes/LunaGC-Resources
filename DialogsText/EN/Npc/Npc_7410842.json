{
    "talkId": "7410842",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Elphane": 14,
        "Player": 9
    },
    "dialogues": [
        {
            "id": "741084201",
            "speaker": "Elphane",
            "text": "Hello.",
            "choices": [
                {
                    "id": "741084202",
                    "text": "This aquabus is really...",
                    "response": [
                        {
                            "id": "741084203",
                            "speaker": "Elphane",
                            "text": "\"The Court Region Waterway Hub and the Fontaine Research Institute of Kinetic Energy Engineering are working to improve aquabus speed.\"",
                            "choices": [
                                {
                                    "id": "741084204",
                                    "text": "I was going to say that it was \"really beautiful.\"",
                                    "response": [
                                        {
                                            "id": "741084205",
                                            "speaker": "Elphane",
                                            "text": "I'm glad you think so."
                                        }
                                    ]
                                },
                                {
                                    "id": "741084206",
                                    "text": "But you haven't heard what I think of its speed yet...",
                                    "response": [
                                        {
                                            "id": "741084207",
                                            "speaker": "Elphane",
                                            "text": "Dear passenger. Previous feedback data indicates that you will either find it too fast or too slow. The official response to either is the same."
                                        },
                                        {
                                            "id": "741084208",
                                            "speaker": "Elphane",
                                            "text": "Of course, if you believe that its speed is \"really perfect,\" then good. Thank you, on behalf of the Court Region Waterway Hub and the aquabus itself."
                                        },
                                        {
                                            "id": "741084209",
                                            "speaker": "Player",
                                            "text": "Are you in a bad mood, Ms. Elphane?"
                                        },
                                        {
                                            "id": "741084210",
                                            "speaker": "Elphane",
                                            "text": "No. I simply..."
                                        },
                                        {
                                            "id": "741084211",
                                            "speaker": "Elphane",
                                            "text": "...Sorry."
                                        },
                                        {
                                            "id": "741084212",
                                            "speaker": "Elphane",
                                            "text": "Hmm... I'll be frank. If you just wish to experience the joys of an aquabus, I personally recommend that you ride the Clementine Line, for which Aeval is the guide."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "741084213",
                    "text": "Could you tell me about Erinnyes?",
                    "response": [
                        {
                            "id": "741084214",
                            "speaker": "Elphane",
                            "text": "Recommended areas of visitation are the Fountain of Lucine and Opera Epiclese. Other than that, I do not recommend anything. Institute's ruins comprise the northern part of Erinnyes...",
                            "choices": [
                                {
                                    "id": "741084215",
                                    "text": "Well, I'm an adventurer, so...",
                                    "response": [
                                        {
                                            "id": "741084216",
                                            "speaker": "Elphane",
                                            "text": "You misunderstand. That area is indeed dangerous, and does also play host to out-of-control clockwork meka."
                                        },
                                        {
                                            "id": "741084217",
                                            "speaker": "Elphane",
                                            "text": "However, the most potent threat present at the moment is the Institute Technicians. They can drone on for an entire day without giving you any information or expressing any perspective. Truly ghastly."
                                        },
                                        {
                                            "id": "741084219",
                                            "speaker": "Elphane",
                                            "text": "Do not go to Erinnyes's depths."
                                        },
                                        {
                                            "id": "741084220",
                                            "speaker": "Player",
                                            "text": "Why not?"
                                        },
                                        {
                                            "id": "741084221",
                                            "speaker": "Elphane",
                                            "text": "I apologize, but I do not know, either. This was Monsieur Neuvillette's suggestion, and I trust his wisdom."
                                        }
                                    ]
                                },
                                {
                                    "id": "741084218",
                                    "text": "Is there anything else?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "741084222",
                    "text": "See you.",
                    "response": [
                        {
                            "id": "741084223",
                            "speaker": "Elphane",
                            "text": "See you."
                        }
                    ]
                }
            ]
        }
    ]
}