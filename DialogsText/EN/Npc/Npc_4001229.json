    "dialogues": [
        {
            "id": "400122901",
            "speaker": "Kaeya",
            "text": "Oh, you've arrived at a most opportune time, Honorary Knight. Klee just invited me to catch lizards with her. Care to join?",
            "choices": [
                {
                    "id": "400122902",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400122903",
                            "speaker": "Kaeya",
                            "text": "Sure. Let's take advantage of the precious time left until lizard duty.",
                            "choices": [
                                {
                                    "id": "400122904",
                                    "text": "About why you came to the island...",
                                    "response": [
                                        {
                                            "id": "400122905",
                                            "speaker": "Kaeya",
                                            "text": "Let me guess, you're thinking something along the lines of, \"Kaeya seized an opportunity to shirk his duties\"?"
                                        },
                                        {
                                            "id": "400122906",
                                            "speaker": "Kaeya",
                                            "text": "*sigh* Why do you think of me so? Of course I have a special reason for coming here."
                                        },
                                        {
                                            "id": "400122907",
                                            "speaker": "Kaeya",
                                            "text": "Generally speaking, I'm responsible for wrapping up various cases... But this particular incident is special."
                                        },
                                        {
                                            "id": "400122908",
                                            "speaker": "Kaeya",
                                            "text": "You see, not only is the Acting Grand Master here, but the former fiery Cavalry Captain as well. Naturally, I had to see it for myself."
                                        },
                                        {
                                            "id": "400122909",
                                            "speaker": "Kaeya",
                                            "text": "Also, it seems like I ought to appreciate the splendid scenery and enjoy every second of summer.",
                                            "choices": [
                                                {
                                                    "id": "400122904",
                                                    "text": "About why you came to the island..."
                                                },
                                                {
                                                    "id": "400122910",
                                                    "text": "Tell me about these islands...",
                                                    "response": [
                                                        {
                                                            "id": "400122911",
                                                            "speaker": "Kaeya",
                                                            "text": "A lovely place, wouldn't you agree?"
                                                        },
                                                        {
                                                            "id": "400122912",
                                                            "speaker": "Kaeya",
                                                            "text": "When beholding a beautiful view, your expression should complement its beauty."
                                                        },
                                                        {
                                                            "id": "400122913",
                                                            "speaker": "Kaeya",
                                                            "text": "..."
                                                        },
                                                        {
                                                            "id": "400122914",
                                                            "speaker": "Kaeya",
                                                            "text": "Just listening to the waves and recalling old memories... is also nice.",
                                                            "choices": [
                                                                {
                                                                    "id": "400122904",
                                                                    "text": "About why you came to the island..."
                                                                },
                                                                {
                                                                    "id": "400122910",
                                                                    "text": "Tell me about these islands..."
                                                                },
                                                                {
                                                                    "id": "400122915",
                                                                    "text": "Tell me about yourself...",
                                                                    "response": [
                                                                        {
                                                                            "id": "400122916",
                                                                            "speaker": "Kaeya",
                                                                            "text": "Hmm, I just thought of something."
                                                                        },
                                                                        {
                                                                            "id": "400122917",
                                                                            "speaker": "Kaeya",
                                                                            "text": "Wouldn't it be great if we could age in reverse? To be a child again and free yourself from the strife of the adult world."
                                                                        },
                                                                        {
                                                                            "id": "400122918",
                                                                            "speaker": "Kaeya",
                                                                            "text": "To be like Klee, unrestrained and free to do whatever you want."
                                                                        },
                                                                        {
                                                                            "id": "400122919",
                                                                            "speaker": "Kaeya",
                                                                            "text": "Hahaha, do you not also yearn for such a thing?",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400122904",
                                                                                    "text": "About why you came to the island..."
                                                                                },
                                                                                {
                                                                                    "id": "400122910",
                                                                                    "text": "Tell me about these islands..."
                                                                                },
                                                                                {
                                                                                    "id": "400122915",
                                                                                    "text": "Tell me about yourself..."
                                                                                },
                                                                                {
                                                                                    "id": "400122920",
                                                                                    "text": "About what happened today...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400122921",
                                                                                            "speaker": "Kaeya",
                                                                                            "text": "What's the matter? Diluc's scowl still bothering you?"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122922",
                                                                                            "speaker": "Kaeya",
                                                                                            "text": "He's had that expression on his face for years now. He internalizes a lot of his feelings."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122923",
                                                                                            "speaker": "Kaeya",
                                                                                            "text": "So I'm afraid that his face is stuck like that. Just treat him like a big kid."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122924",
                                                                                            "speaker": "Kaeya",
                                                                                            "text": "In my opinion, it would be a good thing if people could stay young forever."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122925",
                                                                                            "speaker": "Kaeya",
                                                                                            "text": "Hm? What is that you ask? Hahaha, would I do such a thing? I wasn't jibing him."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122926",
                                                                                            "speaker": "Kaeya",
                                                                                            "text": "Whether they be adults or children, everyone on this island sure is a source of concern.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "400122904",
                                                                                                    "text": "About why you came to the island..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122910",
                                                                                                    "text": "Tell me about these islands..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122915",
                                                                                                    "text": "Tell me about yourself..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122920",
                                                                                                    "text": "About what happened today..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122927",
                                                                                                    "text": "I won't disturb you.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "400122928",
                                                                                                            "speaker": "Kaeya",
                                                                                                            "text": "Going so soon? Huh... Then have a good night."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "400122927",
                                                                                    "text": "I won't disturb you."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
