    "dialogues": [
        {
            "id": "690380201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690380202",
            "speaker": "Albedo",
            "text": "Hm, I believe that the utopia referenced in literature would likely resemble this place."
        },
        {
            "id": "690380203",
            "speaker": "Albedo",
            "text": "Peaceful and comforting, enough for one to forget the time while pouring oneself into research.",
            "choices": [
                {
                    "id": "690380204",
                    "text": "Remember to eat on time.",
                    "response": [
                        {
                            "id": "690380205",
                            "speaker": "Albedo",
                            "text": "..."
                        },
                        {
                            "id": "690380206",
                            "speaker": "Albedo",
                            "text": "Yes, of course."
                        },
                        {
                            "id": "690380207",
                            "speaker": "Albedo",
                            "text": "Ah, right..."
                        },
                        {
                            "id": "690380210",
                            "speaker": "Albedo",
                            "text": "I will often sketch my surroundings. Your arrangements in this realm also provide a source of inspiration for me."
                        },
                        {
                            "id": "690380211",
                            "speaker": "Albedo",
                            "text": "...Thank you."
                        }
                    ]
                },
                {
                    "id": "690380208",
                    "text": "You can tell me if you need anything.",
                    "response": [
                        {
                            "id": "690380209",
                            "speaker": "Albedo",
                            "text": "Hm... Let your creative instincts run unabated, and I should be quite content."
                        }
                    ]
                }
            ]
        }
    ]
}