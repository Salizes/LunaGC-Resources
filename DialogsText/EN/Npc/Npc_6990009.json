    "speaker_counts": {
        "Paimon": 5,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "699000901",
            "speaker": "Player",
            "text": "About Cider Lake..."
        },
        {
            "id": "699000902",
            "speaker": "Paimon",
            "text": "Cider Lake never freezes, no matter what time of the year it is."
        },
        {
            "id": "699000903",
            "speaker": "Paimon",
            "text": "The best apple ciders in Mondstadt can only be made using the fresh water from this lake."
        },
        {
            "id": "699000904",
            "speaker": "Paimon",
            "text": "It really does taste great! Paimon could drink two big bottles in a second!"
        },
        {
            "id": "699000905",
            "speaker": "Player",
            "text": "Wow."
        },
        {
            "id": "699000906",
            "speaker": "Paimon",
            "text": "Tee-hee!"
        },
        {
            "id": "699000907",
            "speaker": "Player",
            "text": "With your size...",
            "choices": [
                {
                    "id": "699000908",
                    "text": "I can't believe that you can drink that much water...",
                    "response": [
                        {
                            "id": "699000910",
                            "speaker": "Paimon",
                            "text": "Paimon always has room for tasty drinks."
                        },
                        {
                            "id": "699000911",
                            "speaker": "Player",
                            "text": "Huh...",
                            "choices": [
                                {
                                    "id": "699000912",
                                    "text": "I guess the world really is a big place."
                                },
                                {
                                    "id": "699000913",
                                    "text": "So many things to consider..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699000909",
                    "text": "...And not explode like an Anemo Slime."
                }
            ]
        }
    ]
}