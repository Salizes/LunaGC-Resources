{
    "talkId": "6911104",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 9,
        "Varesa": 12
    },
    "dialogues": [
        {
            "id": "691110401",
            "speaker": "Player",
            "text": "Anything you want to do?"
        },
        {
            "id": "691110402",
            "speaker": "Varesa",
            "text": "Actually, there's something I've been thinking about for a long time... And, now that it's just the two of us, I..."
        },
        {
            "id": "691110403",
            "speaker": "Varesa",
            "text": "I... think I'm gonna come right out and say it...",
            "choices": [
                {
                    "id": "691110404",
                    "text": "...Y—Yes?",
                    "response": [
                        {
                            "id": "691110406",
                            "speaker": "Varesa",
                            "text": "Can we... spar? Like, I want you to go all-out, hold nothing back!"
                        },
                        {
                            "id": "691110407",
                            "speaker": "Varesa",
                            "text": "You're a hero, a legend, and the strongest person I know... I really look up to you! You give me something to aspire to!"
                        },
                        {
                            "id": "691110408",
                            "speaker": "Varesa",
                            "text": "So, I want to see... Just how much separates the two of us at our full strength!",
                            "choices": [
                                {
                                    "id": "691110409",
                                    "text": "Hold on...",
                                    "response": [
                                        {
                                            "id": "691110411",
                                            "speaker": "Varesa",
                                            "text": "I guess it's a little confusing... I mean, you could probably go to toe-to-toe with an Archon, but I'm still scared of hurting you. My fighting style is a bit, um, all over the place..."
                                        },
                                        {
                                            "id": "691110412",
                                            "speaker": "Varesa",
                                            "text": "I just mean, um... *sigh* What am I even trying to say...",
                                            "choices": [
                                                {
                                                    "id": "691110413",
                                                    "text": "Even if it's just a spar, I don't think I can go all out against you.",
                                                    "response": [
                                                        {
                                                            "id": "691110415",
                                                            "speaker": "Varesa",
                                                            "text": "Oh, no... I get it. I should have thought about it that way..."
                                                        },
                                                        {
                                                            "id": "691110416",
                                                            "speaker": "Varesa",
                                                            "text": "I can get behind that answer. Somehow, it makes me feel all warm and fuzzy inside..."
                                                        },
                                                        {
                                                            "id": "691110417",
                                                            "speaker": "Varesa",
                                                            "text": "Wait... Why don't we test our strength a different way? Like... through some exercise?",
                                                            "choices": [
                                                                {
                                                                    "id": "691110418",
                                                                    "text": "That's a much better idea.",
                                                                    "response": [
                                                                        {
                                                                            "id": "691110420",
                                                                            "speaker": "Varesa",
                                                                            "text": "Alright, then we'll warm up with a ninety-thousand-step sprint and then swim half that distance. Once that's done, I'll bring out the weights. Fifty should do it... Each one is around the weight of an adult tatankasaur."
                                                                        },
                                                                        {
                                                                            "id": "691110421",
                                                                            "speaker": "Varesa",
                                                                            "text": "Ooh, I'm getting excited! I can't wait to see you bench! I bet you look so cool!"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691110419",
                                                                    "text": "I'm lucky adventuring helps keep me in shape."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691110414",
                                                    "text": "Because, like you, I don’t like fighting my friends."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691110410",
                                    "text": "You want me to go all out?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691110405",
                    "text": "You're being super serious all of a sudden..."
                }
            ]
        }
    ]
}