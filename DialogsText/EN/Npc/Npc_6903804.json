{
    "talkId": "6903804",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Albedo": 14,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "690380401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
        },
        {
            "id": "690380402",
            "speaker": "Albedo",
            "text": "Heh, where should I begin...?"
        },
        {
            "id": "690380403",
            "speaker": "Albedo",
            "text": "In your company, I never lack inspiration.",
            "choices": [
                {
                    "id": "690380404",
                    "text": "For drawing?",
                    "response": [
                        {
                            "id": "690380406",
                            "speaker": "Albedo",
                            "text": "It's good for both drawing and experiments."
                        },
                        {
                            "id": "690380407",
                            "speaker": "Albedo",
                            "text": "And not just for these, but for many other things."
                        },
                        {
                            "id": "690380408",
                            "speaker": "Albedo",
                            "text": "Speaking of which... I used to think interaction with others was a waste of time."
                        },
                        {
                            "id": "690380409",
                            "speaker": "Albedo",
                            "text": "But after meeting you, I'd rather spend my time on you than other matters."
                        },
                        {
                            "id": "690380410",
                            "speaker": "Albedo",
                            "text": "This is a unique anomaly. I think I likely know the reason why."
                        },
                        {
                            "id": "690380411",
                            "speaker": "Albedo",
                            "text": "So can you also... give me more of your time?",
                            "choices": [
                                {
                                    "id": "690380412",
                                    "text": "I'll accompany you while you sketch.",
                                    "response": [
                                        {
                                            "id": "690380413",
                                            "speaker": "Albedo",
                                            "text": "Thank you. Then, today's subject—"
                                        },
                                        {
                                            "id": "690380414",
                                            "speaker": "Albedo",
                                            "text": "You and your realm."
                                        },
                                        {
                                            "id": "690380418",
                                            "speaker": "Albedo",
                                            "text": "By the way, after we're done, may I have the pleasure of inviting you to dessert with me?"
                                        },
                                        {
                                            "id": "690380419",
                                            "speaker": "Albedo",
                                            "text": "To continue our time together, and to thank you for your company."
                                        }
                                    ]
                                },
                                {
                                    "id": "690380415",
                                    "text": "I'll accompany you during your experiments.",
                                    "response": [
                                        {
                                            "id": "690380416",
                                            "speaker": "Albedo",
                                            "text": "Thank you. I'll guarantee your safety, as I've done before."
                                        },
                                        {
                                            "id": "690380417",
                                            "speaker": "Albedo",
                                            "text": "We already understand each other quite well, don't we?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690380405",
                    "text": "For experiments?"
                }
            ]
        }
    ]
}