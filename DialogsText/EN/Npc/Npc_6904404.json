{
    "talkId": "6904404",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "Xinyan": 18
    },
    "dialogues": [
        {
            "id": "690440401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
        },
        {
            "id": "690440402",
            "speaker": "Xinyan",
            "text": "Hm... Wanna try out the lyre?"
        },
        {
            "id": "690440403",
            "speaker": "Xinyan",
            "text": "You've seen and heard so many of my shows."
        },
        {
            "id": "690440404",
            "speaker": "Xinyan",
            "text": "If you're interested and wanna give it a fair go, I can teach you step by step!",
            "choices": [
                {
                    "id": "690440405",
                    "text": "I've learned how to play instruments before.",
                    "response": [
                        {
                            "id": "690440406",
                            "speaker": "Xinyan",
                            "text": "Wow, really? That's great!"
                        },
                        {
                            "id": "690440411",
                            "speaker": "Xinyan",
                            "text": "Oh, at least for me, rock 'n' roll is somethin' as important as life itself."
                        },
                        {
                            "id": "690440412",
                            "speaker": "Xinyan",
                            "text": "If I could perform rock 'n' roll with you, that'd be twice as— no, the best thing in this world!"
                        },
                        {
                            "id": "690440413",
                            "speaker": "Xinyan",
                            "text": "O—Of course, I know that our music tastes won't be the same. The \"rock 'n' roll\" I'm thinkin' of here isn't limited to the music itself."
                        },
                        {
                            "id": "690440414",
                            "speaker": "Xinyan",
                            "text": "If there's a part of you that's unwillin', I definitely won't force ya!",
                            "choices": [
                                {
                                    "id": "690440415",
                                    "text": "For you, I'll try...",
                                    "response": [
                                        {
                                            "id": "690440416",
                                            "speaker": "Xinyan",
                                            "text": "Aw..."
                                        },
                                        {
                                            "id": "690440417",
                                            "speaker": "Xinyan",
                                            "text": "Then I gotta live up to your faith in me and be a good teacher!"
                                        },
                                        {
                                            "id": "690440418",
                                            "speaker": "Xinyan",
                                            "text": "Here, this is my lyre."
                                        },
                                        {
                                            "id": "690440419",
                                            "speaker": "Xinyan",
                                            "text": "Now get ready to train hard, because I'm about to turn up the heat!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690440420",
                                    "text": "Maybe we can find another way of interpreting rock 'n' roll?",
                                    "response": [
                                        {
                                            "id": "690440421",
                                            "speaker": "Xinyan",
                                            "text": "No. Prob. Lem!"
                                        },
                                        {
                                            "id": "690440422",
                                            "speaker": "Xinyan",
                                            "text": "Honestly... Just the fact that you're willin' to give it a try means a lot to me."
                                        },
                                        {
                                            "id": "690440423",
                                            "speaker": "Xinyan",
                                            "text": "After all, you're very special to me..."
                                        },
                                        {
                                            "id": "690440424",
                                            "speaker": "Xinyan",
                                            "text": "Hehe... I look forward to us doin' \"rock 'n' roll\" together!"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690440407",
                    "text": "I'm afraid that I won't play very well...",
                    "response": [
                        {
                            "id": "690440408",
                            "speaker": "Xinyan",
                            "text": "Don't sweat it, you got me helpin' you!"
                        },
                        {
                            "id": "690440409",
                            "speaker": "Xinyan",
                            "text": "I'll pay attention to every method and every step... Although this is my first time actin' as a teacher."
                        }
                    ]
                },
                {
                    "id": "690440410",
                    "text": "Why would you ask me to play?"
                }
            ]
        }
    ]
}