    "dialogues": [
        {
            "id": "677350201",
            "speaker": "Player",
            "text": "So... are you looking for a book?"
        },
        {
            "id": "677350202",
            "speaker": "Congshen",
            "text": "Have you ever been here before?",
            "choices": [
                {
                    "id": "677350203",
                    "text": "Huh?",
                    "response": [
                        {
                            "id": "677350206",
                            "speaker": "Congshen",
                            "text": "Then you understand.",
                            "choices": [
                                {
                                    "id": "677350207",
                                    "text": "Understand... understand what?",
                                    "response": [
                                        {
                                            "id": "677350209",
                                            "speaker": "Congshen",
                                            "text": "When you need to sleep, sleep. When you need to understand, understand."
                                        },
                                        {
                                            "id": "677350210",
                                            "speaker": "Congshen",
                                            "text": "You should head back now. When the world ends, just go with it."
                                        }
                                    ]
                                },
                                {
                                    "id": "677350208",
                                    "text": "And how could I understand that?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "677350204",
                    "text": "Yes, I have."
                },
                {
                    "id": "677350205",
                    "text": "No, I haven't."
                }
            ]
        }
    ]
}