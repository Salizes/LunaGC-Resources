    "dialogues": [
        {
            "id": "710440101",
            "speaker": "Muning",
            "text": "May I ask for your name?",
            "choices": [
                {
                    "id": "710440102",
                    "text": "Why, hello there...",
                    "response": [
                        {
                            "id": "710440104",
                            "speaker": "Muning",
                            "text": "My apologies, but The Chasm has been closed indefinitely. We do not take guests here."
                        },
                        {
                            "id": "710440105",
                            "speaker": "Muning",
                            "text": "Unless..."
                        },
                        {
                            "id": "710440106",
                            "speaker": "Player",
                            "text": "Unless...?"
                        },
                        {
                            "id": "710440107",
                            "speaker": "Muning",
                            "text": "Unless you can get permission from Yujing Terrace... Or if you are on a <color=#00E1FFFF>special commission</color>."
                        },
                        {
                            "id": "710440108",
                            "speaker": "Muning",
                            "text": "However, things have been quite unusual lately, and our bosses have been most busy... I'd advise that you mind your own business, lest you disturb them."
                        },
                        {
                            "id": "710440109",
                            "speaker": "Muning",
                            "text": "Please leave at once. This is for your own safety."
                        }
                    ]
                },
                {
                    "id": "710440103",
                    "text": "I'm..."
                }
            ]
        }
    ]
