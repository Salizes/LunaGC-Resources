    "dialogues": [
        {
            "id": "766771501",
            "speaker": "Varka",
            "text": "Turn, left... turn, right!",
            "choices": [
                {
                    "id": "766772301",
                    "text": "They haven't sobered up yet?",
                    "response": [
                        {
                            "id": "766772401",
                            "speaker": "Varka",
                            "text": "...Honorary Knight, feel like helping me get them cleaned up?"
                        }
                    ]
                },
                {
                    "id": "766772201",
                    "text": "What's going on here, Varka?",
                    "response": [
                        {
                            "id": "766772202",
                            "speaker": "Varka",
                            "text": "Oh, just some Knights of Favonius formation drills. These three overdid it last night, so I'm sobering them up."
                        },
                        {
                            "id": "766772203",
                            "speaker": "Varka",
                            "text": "...And rooting out the worst offender while I'm at it, whose grand prize will be 20 laps. The expeditionary force is allowed to drink liquor, but ground rules stand for when and how much you drink."
                        },
                        {
                            "id": "766772204",
                            "speaker": "Winfried",
                            "text": "I—I only had a little bit!"
                        },
                        {
                            "id": "766772205",
                            "speaker": "Ekbert",
                            "text": "M—Me too!"
                        },
                        {
                            "id": "766772206",
                            "speaker": "Varka",
                            "text": "...Save the excuses, prove it with your feet! Show me you can nail a picture-perfect parade-ground pivot while you're plastered!"
                        },
                        {
                            "id": "766772207",
                            "speaker": "Leifhelm",
                            "text": "Y—Yes Sir!"
                        }
                    ]
                }
            ]
        }
    ]
}