{
    "talkId": "6990035",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Paimon": 6,
        "Player": 5
    },
    "dialogues": [
        {
            "id": "699003501",
            "speaker": "Player",
            "text": "About Aranara names..."
        },
        {
            "id": "699003502",
            "speaker": "Paimon",
            "text": "Arama, Arana, Araja, Arakavi... Whew, Aranara names are so hard to remember..."
        },
        {
            "id": "699003503",
            "speaker": "Paimon",
            "text": "The only bit Paimon's sure of is that they all start with \"Ara\"!",
            "choices": [
                {
                    "id": "699003504",
                    "text": "Right, so if you were an Aranara...",
                    "response": [
                        {
                            "id": "699003506",
                            "speaker": "Paimon",
                            "text": "Yup, and as for you..."
                        },
                        {
                            "id": "699003507",
                            "speaker": "Paimon",
                            "text": "Hmm, actually, they'd probably call you \"Nara Traveler\"..."
                        },
                        {
                            "id": "699003508",
                            "speaker": "Player",
                            "text": "Yeah, we're all Nara to them..."
                        },
                        {
                            "id": "699003509",
                            "speaker": "Paimon",
                            "text": "So if there was someone whose actual name was \"Nara,\" what would the Aranara call them?"
                        },
                        {
                            "id": "699003510",
                            "speaker": "Player",
                            "text": "\"Nara Nara\"... I guess. Sounds kinda cute."
                        },
                        {
                            "id": "699003511",
                            "speaker": "Paimon",
                            "text": "Hehe, yeah."
                        }
                    ]
                },
                {
                    "id": "699003505",
                    "text": "Your name would be \"Arapaimon.\""
                }
            ]
        }
    ]
}