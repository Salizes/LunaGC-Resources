{
    "talkId": "6912808",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 11,
        "Varka": 18
    },
    "dialogues": [
        {
            "id": "691280301",
            "speaker": "Player",
            "text": "Would you like to chat?"
        },
        {
            "id": "691280302",
            "speaker": "Varka",
            "text": "Chat? Sure, I'm quite the talker!"
        },
        {
            "id": "691280303",
            "speaker": "Varka",
            "text": "..."
        },
        {
            "id": "691280304",
            "speaker": "Player",
            "text": "...Why so silent?"
        },
        {
            "id": "691280305",
            "speaker": "Varka",
            "text": "...I'm waiting for the drinks. Wait... Do you not have any?"
        },
        {
            "id": "691280306",
            "speaker": "Player",
            "text": "None at all..."
        },
        {
            "id": "691280307",
            "speaker": "Varka",
            "text": "Chatting without drinks... Haha, so that's how you do it...",
            "choices": [
                {
                    "id": "691280308",
                    "text": "You look a little lost.",
                    "response": [
                        {
                            "id": "691280310",
                            "speaker": "Varka",
                            "text": "I'm fine. As an experienced Knight of Favonius, I can quickly adjust to even the most unusual of situations..."
                        },
                        {
                            "id": "691280311",
                            "speaker": "Varka",
                            "text": "My expectations were a little... misaligned. Alright, let's go! Let's get this \"conference\" on the roaad.",
                            "choices": [
                                {
                                    "id": "691280312",
                                    "text": "Um... conference?",
                                    "response": [
                                        {
                                            "id": "691280314",
                                            "speaker": "Varka",
                                            "text": "Every conversation without drinks is a \"conference.\""
                                        },
                                        {
                                            "id": "691280315",
                                            "speaker": "Varka",
                                            "text": "I think my last one was probably when I had tea with the lovely ladies of the Hexenzirkel... Oh, actually, I may have attended a few during the expedition...",
                                            "choices": [
                                                {
                                                    "id": "691280316",
                                                    "text": "Well then, since you brought it up...",
                                                    "response": [
                                                        {
                                                            "id": "691280318",
                                                            "speaker": "Varka",
                                                            "text": "Ha, great question. First, find something you have in common, or bring up people or things they care about. For example..."
                                                        },
                                                        {
                                                            "id": "691280319",
                                                            "speaker": "Varka",
                                                            "text": "\"Oh my, your child is adorable! A real handful, you say? Haha, well, that's just how kids are — never a moment's peace. Take my two for example...\""
                                                        },
                                                        {
                                                            "id": "691280320",
                                                            "speaker": "Varka",
                                                            "text": "\"Looking for somewhere to settle in Teyvat? Well, it simply has to be Mondstadt! And just let me tell you why...\""
                                                        },
                                                        {
                                                            "id": "691280321",
                                                            "speaker": "Varka",
                                                            "text": "Then, once the conversation gets going, look for a new opening..."
                                                        },
                                                        {
                                                            "id": "691280322",
                                                            "speaker": "Varka",
                                                            "text": "\"Since the young 'uns are in Mondstadt, why don't you join us too?\""
                                                        },
                                                        {
                                                            "id": "691280323",
                                                            "speaker": "Varka",
                                                            "text": "\"Oh, I don't mean sign up to the Knights of Favonius. Let me think... would 'external support' be the right term?\""
                                                        },
                                                        {
                                                            "id": "691280324",
                                                            "speaker": "Varka",
                                                            "text": "Then, while they're still uncertain, go all in to assuage their concerns — and seal the deal!"
                                                        },
                                                        {
                                                            "id": "691280325",
                                                            "speaker": "Varka",
                                                            "text": "\"Don't worry! All sorts of people call Mondstadt home. I suppose you've heard that even Lupus Boreas was once a wanderer from a faraway land!\""
                                                        },
                                                        {
                                                            "id": "691280326",
                                                            "speaker": "Varka",
                                                            "text": "\"You don't need to do anything! We can handle most situations ourselves, and if we do need your help... I believe it'll be in everyone's interests.\""
                                                        },
                                                        {
                                                            "id": "691280327",
                                                            "speaker": "Player",
                                                            "text": "You've got quite the silver tongue."
                                                        },
                                                        {
                                                            "id": "691280328",
                                                            "speaker": "Varka",
                                                            "text": "Haha, thanks! In return for your kind words, let me treat you to a drink!"
                                                        },
                                                        {
                                                            "id": "691280329",
                                                            "speaker": "Player",
                                                            "text": "So you still want a proper \"conversation\"!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691280317",
                                                    "text": "How did you break the ice with the Hexenzirkel?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691280313",
                                    "text": "That sounds a bit formal..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691280309",
                    "text": "Aren't you usually an avid talker?"
                }
            ]
        }
    ]
}