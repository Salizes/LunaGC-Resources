    },
    "dialogues": [
        {
            "id": "699004501",
            "speaker": "Player",
            "text": "About Resolving Conflicts..."
        },
        {
            "id": "699004502",
            "speaker": "Paimon",
            "text": "Paimon's heard that even in Natlan, there are lots of ways to resolve conflict that don't involve contests of strength.",
            "choices": [
                {
                    "id": "699004503",
                    "text": "Really?",
                    "response": [
                        {
                            "id": "699004505",
                            "speaker": "Paimon",
                            "text": "Yeah! Like, apparently, some people in the Children of Echoes settle their disputes by holding a dance-off!",
                            "choices": [
                                {
                                    "id": "699004506",
                                    "text": "A dance-off?",
                                    "response": [
                                        {
                                            "id": "699004508",
                                            "speaker": "Paimon",
                                            "text": "Uh-huh!"
                                        },
                                        {
                                            "id": "699004509",
                                            "speaker": "Player",
                                            "text": "And just dance their socks off?"
                                        },
                                        {
                                            "id": "699004510",
                                            "speaker": "Paimon",
                                            "text": "Mm-hmm!"
                                        },
                                        {
                                            "id": "699004511",
                                            "speaker": "Player",
                                            "text": "Until one person gets so exhausted, they can't get up anymore?"
                                        },
                                        {
                                            "id": "699004512",
                                            "speaker": "Paimon",
                                            "text": "Yep!"
                                        },
                                        {
                                            "id": "699004513",
                                            "speaker": "Paimon",
                                            "text": "...Wait, what the... Hold on, that IS a contest of strength!"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004507",
                                    "text": "So like, they'll mutually decide on a time and place..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004504",
                    "text": "In the Nation of War?"
                }
            ]
        }
    ]
}