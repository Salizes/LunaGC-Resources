    "dialogues": [
        {
            "id": "624280201",
            "speaker": "Player",
            "text": "What's bothering you?"
        },
        {
            "id": "624280202",
            "speaker": "Xinghuo",
            "text": "*sigh* ...Isn't it obvious?"
        },
        {
            "id": "624280203",
            "speaker": "Xinghuo",
            "text": "That guy keeps imitating everything I say. It's driving me nuts.",
            "choices": [
                {
                    "id": "624280204",
                    "text": "Are you two friends?",
                    "response": [
                        {
                            "id": "624280205",
                            "speaker": "Xinghuo",
                            "text": "Hmm... I guess. We've known each other for a while."
                        }
                    ]
                },
                {
                    "id": "624280206",
                    "text": "Why does he imitate you?",
                    "response": [
                        {
                            "id": "624280207",
                            "speaker": "Xinghuo",
                            "text": "He used to speak with a stutter until a few years ago, until a traveler called Alice came along and gave him a bottle of medicine..."
                        },
                        {
                            "id": "624280208",
                            "speaker": "Xinghuo",
                            "text": "It cured his stutter completely. But then he couldn't stop imitating the way everyone around him speaks..."
                        }
                    ]
                }
            ]
        }
    ]
}