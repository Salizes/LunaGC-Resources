    "dialogues": [
        {
            "id": "400122801",
            "speaker": "Albedo",
            "text": "Hm? Oh, it's you. Taking a walk around these parts?",
            "choices": [
                {
                    "id": "400122802",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400122803",
                            "speaker": "Albedo",
                            "text": "Okay. What would you like to discuss?",
                            "choices": [
                                {
                                    "id": "400122804",
                                    "text": "About how you felt riding a dragon...",
                                    "response": [
                                        {
                                            "id": "400122805",
                                            "speaker": "Albedo",
                                            "text": "I have conducted all manner of research, but flying from Mondstadt to this island on a dragon... That was a first."
                                        },
                                        {
                                            "id": "400122806",
                                            "speaker": "Albedo",
                                            "text": "It was a good experience. In the sky, just speaking requires you to muster all your strength since the winds are so strong."
                                        },
                                        {
                                            "id": "400122807",
                                            "speaker": "Albedo",
                                            "text": "Opportunities to communicate loudly with others are scarce. Although I have little interest in it, the process was interesting."
                                        },
                                        {
                                            "id": "400122808",
                                            "speaker": "Albedo",
                                            "text": "I suppose this can be considered an unforgettable memory.",
                                            "choices": [
                                                {
                                                    "id": "400122804",
                                                    "text": "About how you felt riding a dragon..."
                                                },
                                                {
                                                    "id": "400122809",
                                                    "text": "Tell me about these islands...",
                                                    "response": [
                                                        {
                                                            "id": "400122810",
                                                            "speaker": "Albedo",
                                                            "text": "The nature of this island is extraordinary. Like a sealed-away secret, it opens only at specific times."
                                                        },
                                                        {
                                                            "id": "400122811",
                                                            "speaker": "Albedo",
                                                            "text": "And yet, the island still contains traces of human activity."
                                                        },
                                                        {
                                                            "id": "400122812",
                                                            "speaker": "Albedo",
                                                            "text": "Additionally, a plethora of organisms are present here."
                                                        },
                                                        {
                                                            "id": "400122813",
                                                            "speaker": "Albedo",
                                                            "text": "Ever since we arrived, I've been thinking: What is the limit to life? Even in the most desolate of places, will some form of life exist?",
                                                            "choices": [
                                                                {
                                                                    "id": "400122804",
                                                                    "text": "About how you felt riding a dragon..."
                                                                },
                                                                {
                                                                    "id": "400122809",
                                                                    "text": "Tell me about these islands..."
                                                                },
                                                                {
                                                                    "id": "400122814",
                                                                    "text": "Tell me about yourself...",
                                                                    "response": [
                                                                        {
                                                                            "id": "400122815",
                                                                            "speaker": "Albedo",
                                                                            "text": "Me? I'm doing quite well here. Thank you for your concern."
                                                                        },
                                                                        {
                                                                            "id": "400122816",
                                                                            "speaker": "Albedo",
                                                                            "text": "How do you feel here, if I might ask?"
                                                                        },
                                                                        {
                                                                            "id": "400122817",
                                                                            "speaker": "Player",
                                                                            "text": "Pretty good."
                                                                        },
                                                                        {
                                                                            "id": "400122818",
                                                                            "speaker": "Albedo",
                                                                            "text": "Okay, that's good to hear."
                                                                        },
                                                                        {
                                                                            "id": "400122819",
                                                                            "speaker": "Albedo",
                                                                            "text": "There are many landscapes worth drawing here. If you'd like to see, you may accompany me.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400122804",
                                                                                    "text": "About how you felt riding a dragon..."
                                                                                },
                                                                                {
                                                                                    "id": "400122809",
                                                                                    "text": "Tell me about these islands..."
                                                                                },
                                                                                {
                                                                                    "id": "400122814",
                                                                                    "text": "Tell me about yourself..."
                                                                                },
                                                                                {
                                                                                    "id": "400122820",
                                                                                    "text": "About what happened today...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400122821",
                                                                                            "speaker": "Albedo",
                                                                                            "text": "Today's events didn't feel that out of the ordinary."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122822",
                                                                                            "speaker": "Albedo",
                                                                                            "text": "Hmm? Sorry, do you mean when I left by myself?"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122823",
                                                                                            "speaker": "Albedo",
                                                                                            "text": "That was a personal choice. Don't stress over it. Sometimes, I like to be alone."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122824",
                                                                                            "speaker": "Albedo",
                                                                                            "text": "Communicating with others can be a taxing affair, but if I were to choose someone to talk to, I would pick you."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122825",
                                                                                            "speaker": "Albedo",
                                                                                            "text": "You're intelligent, and I like to talk to intelligent people."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "400122826",
                                                                                    "text": "I won't disturb you.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400122827",
                                                                                            "speaker": "Albedo",
                                                                                            "text": "Alright, good night."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "400122820",
                                                                    "text": "About what happened today..."
                                                                },
                                                                {
                                                                    "id": "400122826",
                                                                    "text": "I won't disturb you."
                                                                }
                                                            ]
                                                        }
