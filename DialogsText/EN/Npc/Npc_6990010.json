{
    "talkId": "6990010",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Paimon": 6,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "699001001",
            "speaker": "Player",
            "text": "About Razor"
        },
        {
            "id": "699001002",
            "speaker": "Paimon",
            "text": "Have you heard of the brush?",
            "choices": [
                {
                    "id": "699001003",
                    "text": "You mean pens made using animal hair...",
                    "response": [
                        {
                            "id": "699001005",
                            "speaker": "Paimon",
                            "text": "That's correct! They say that finely-made brushes sell for high prices among Liyue's merchants!"
                        },
                        {
                            "id": "699001006",
                            "speaker": "Player",
                            "text": "So, would you like to make some too?"
                        },
                        {
                            "id": "699001007",
                            "speaker": "Paimon",
                            "text": "Uh-huh! But the wild wolves are too fierce, so we should use Razor's fur to make brushes instead!"
                        },
                        {
                            "id": "699001008",
                            "speaker": "Paimon",
                            "text": "Razor's fur is all downy and soft. It'll definitely make great wolf pens! We could make lots of Mora like this!",
                            "choices": [
                                {
                                    "id": "699001009",
                                    "text": "Brushes made like that would conduct electricity.",
                                    "response": [
                                        {
                                            "id": "699001011",
                                            "speaker": "Player",
                                            "text": "Besides, Razor isn't a wolf."
                                        },
                                        {
                                            "id": "699001013",
                                            "speaker": "Paimon",
                                            "text": "Eh? Why are they called wolf pens, then?"
                                        },
                                        {
                                            "id": "699001014",
                                            "speaker": "Player",
                                            "text": "Well, does Cider Lake look like it's full of cider to you?"
                                        },
                                        {
                                            "id": "699001015",
                                            "speaker": "Paimon",
                                            "text": "Hmm. You have a point."
                                        }
                                    ]
                                },
                                {
                                    "id": "699001010",
                                    "text": "I'm not sure we could use them..."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699001004",
                    "text": "...For writing purposes?"
                }
            ]
        }
    ]
}