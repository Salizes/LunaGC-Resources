{
    "talkId": "6904407",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "Xinyan": 14
    },
    "dialogues": [
        {
            "id": "690440701",
            "speaker": "Player",
            "text": "Would you like to have a chat with me?"
        },
        {
            "id": "690440302",
            "speaker": "Xinyan",
            "text": "Sure! I've got some serious writer's block... Help me think it through!",
            "choices": [
                {
                    "id": "690440303",
                    "text": "You write your own songs?",
                    "response": [
                        {
                            "id": "690440304",
                            "speaker": "Xinyan",
                            "text": "Naturally!"
                        },
                        {
                            "id": "690440305",
                            "speaker": "Xinyan",
                            "text": "In Liyue Harbor, rock 'n' roll is considered niche. There's a lot of fans of the music, but few creators of it."
                        },
                        {
                            "id": "690440306",
                            "speaker": "Xinyan",
                            "text": "Although I listen to songs from Fontaine, that's just appreciation and learnin'."
                        },
                        {
                            "id": "690440307",
                            "speaker": "Xinyan",
                            "text": "When it's time for creation, you gotta do it yourself to live up to the words \"rock 'n' roll\"!"
                        },
                        {
                            "id": "690440313",
                            "speaker": "Player",
                            "text": "That's amazing!"
                        },
                        {
                            "id": "690440314",
                            "speaker": "Xinyan",
                            "text": "Hehe, thanks for your appreciation."
                        },
                        {
                            "id": "690440315",
                            "speaker": "Xinyan",
                            "text": "But... I've been kinda worried lately."
                        },
                        {
                            "id": "690440318",
                            "speaker": "Xinyan",
                            "text": "For my newest song, fans say they can \"hear tenderness within the searin' flames.\" They think my style has changed..."
                        },
                        {
                            "id": "690440319",
                            "speaker": "Xinyan",
                            "text": "Maybe it's because of recent changes in my heart. Ugh, should I not let that happen...?"
                        }
                    ]
                },
                {
                    "id": "690440308",
                    "text": "In the past, what sort of themes did you start with?",
                    "response": [
                        {
                            "id": "690440309",
                            "speaker": "Xinyan",
                            "text": "Overcomin' prejudice, of course!"
                        },
                        {
                            "id": "690440310",
                            "speaker": "Xinyan",
                            "text": "What I heard and saw in the streets, combined with my personal experiences..."
                        },
                        {
                            "id": "690440311",
                            "speaker": "Xinyan",
                            "text": "Narration, lyrics... The most important thing is to have enough passion to question everything!"
                        },
                        {
                            "id": "690440312",
                            "speaker": "Xinyan",
                            "text": "You gotta point right towards the soul!"
                        },
                        {
                            "id": "690440316",
                            "speaker": "Player",
                            "text": "Anything on your mind lately?"
                        },
                        {
                            "id": "690440317",
                            "speaker": "Xinyan",
                            "text": "Well..."
                        }
                    ]
                }
            ]
        }
    ]
}