{
    "talkId": "6902202",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "Venti": 8
    },
    "dialogues": [
        {
            "id": "690220201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>How do you like it here?</color>"
        },
        {
            "id": "690220202",
            "speaker": "Venti",
            "text": "It's great, of course."
        },
        {
            "id": "690220203",
            "speaker": "Venti",
            "text": "I know that every detail here is the result of your hard work. I hold immense gratitude for all you've done.",
            "choices": [
                {
                    "id": "690220204",
                    "text": "If you like it, I'm happy.",
                    "response": [
                        {
                            "id": "690220205",
                            "speaker": "Venti",
                            "text": "Yes, I love it!"
                        },
                        {
                            "id": "690220208",
                            "speaker": "Venti",
                            "text": "Oh, I'm flattered that you asked for my thoughts."
                        },
                        {
                            "id": "690220209",
                            "speaker": "Venti",
                            "text": "But you should be more confident in your own tastes!"
                        },
                        {
                            "id": "690220210",
                            "speaker": "Venti",
                            "text": "Here, you're the real-deal protagonist!"
                        },
                        {
                            "id": "690220211",
                            "speaker": "Venti",
                            "text": "Try things with confidence and turn your ideas into reality. And if you ever run into trouble, I'll lend a helping hand!"
                        }
                    ]
                },
                {
                    "id": "690220206",
                    "text": "Is there anything you want?",
                    "response": [
                        {
                            "id": "690220207",
                            "speaker": "Venti",
                            "text": "This place already has everything I want!"
                        }
                    ]
                }
            ]
        }
    ]
}