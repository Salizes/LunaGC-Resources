    "dialogues": [
        {
            "id": "400123001",
            "speaker": "Diluc",
            "text": "Walking along the shore by yourself at this time of night seems lonesome.",
            "choices": [
                {
                    "id": "400123002",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400123003",
                            "speaker": "Diluc",
                            "text": "Sure.",
                            "choices": [
                                {
                                    "id": "400123004",
                                    "text": "About the strange letters...",
                                    "response": [
                                        {
                                            "id": "400123005",
                                            "speaker": "Diluc",
                                            "text": "I was skeptical of the letter from the beginning."
                                        },
                                        {
                                            "id": "400123006",
                                            "speaker": "Diluc",
                                            "text": "But out of caution, I asked others about it. Sure enough, I wasn't the only recipient."
                                        },
                                        {
                                            "id": "400123007",
                                            "speaker": "Diluc",
                                            "text": "This is clearly a premeditated act. The responsible party's objective has yet to be revealed, so I came here to investigate."
                                        },
                                        {
                                            "id": "400123008",
                                            "speaker": "Diluc",
                                            "text": "Now that I'm here, you can relax.",
                                            "choices": [
                                                {
                                                    "id": "400123004",
                                                    "text": "About the strange letters..."
                                                },
                                                {
                                                    "id": "400123013",
                                                    "text": "Tell me about yourself...",
                                                    "response": [
                                                        {
                                                            "id": "400123014",
                                                            "speaker": "Diluc",
                                                            "text": "Me? My affairs are hardly worth discussion."
                                                        },
                                                        {
                                                            "id": "400123015",
                                                            "speaker": "Diluc",
                                                            "text": "Rather, I'm more concerned about your situation."
                                                        },
                                                        {
                                                            "id": "400123016",
                                                            "speaker": "Diluc",
                                                            "text": "How is it? Getting used to island life?"
                                                        },
                                                        {
                                                            "id": "400123017",
                                                            "speaker": "Player",
                                                            "text": "It's not bad."
                                                        },
                                                        {
                                                            "id": "400123018",
                                                            "speaker": "Diluc",
                                                            "text": "If you need help, come find me any time."
                                                        },
                                                        {
                                                            "id": "400123019",
                                                            "speaker": "Diluc",
                                                            "text": "And if you find any clues, contact me at once."
                                                        },
                                                        {
                                                            "id": "400123020",
                                                            "speaker": "Diluc",
                                                            "text": "Speaking of which, Klee just asked me to help her catch fish. *sigh* Come with me, if you want to.",
                                                            "choices": [
                                                                {
                                                                    "id": "400123004",
                                                                    "text": "About the strange letters..."
                                                                },
                                                                {
                                                                    "id": "400123013",
                                                                    "text": "Tell me about yourself..."
                                                                },
                                                                {
                                                                    "id": "400123021",
                                                                    "text": "About what happened today...",
                                                                    "response": [
                                                                        {
                                                                            "id": "400123022",
                                                                            "speaker": "Diluc",
                                                                            "text": "Today? ...Oh, you mean that."
                                                                        },
                                                                        {
                                                                            "id": "400123023",
                                                                            "speaker": "Diluc",
                                                                            "text": "Frivolous happenings aren't worth your attention."
                                                                        },
                                                                        {
                                                                            "id": "400123024",
                                                                            "speaker": "Diluc",
                                                                            "text": "And as for Kaeya... Hmph, he seems to be in high spirits."
                                                                        },
                                                                        {
                                                                            "id": "400123025",
                                                                            "speaker": "Diluc",
                                                                            "text": "Even after all these years, he still enjoys summer as much as he did as a kid.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400123004",
                                                                                    "text": "About the strange letters..."
                                                                                },
                                                                                {
                                                                                    "id": "400123013",
                                                                                    "text": "Tell me about yourself..."
                                                                                },
                                                                                {
                                                                                    "id": "400123021",
                                                                                    "text": "About what happened today..."
                                                                                },
                                                                                {
                                                                                    "id": "400123026",
                                                                                    "text": "I won't disturb you.",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400123027",
                                                                                            "speaker": "Diluc",
                                                                                            "text": "Good night. Get some rest."
                                                                                        }
