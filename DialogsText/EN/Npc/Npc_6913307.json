{
    "talkId": "6913307",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "Sandrone": 12
    },
    "dialogues": [
        {
            "id": "691330201",
            "speaker": "Player",
            "text": "How do you like it here?"
        },
        {
            "id": "691330202",
            "speaker": "Sandrone",
            "text": "It's nice. Thanks for asking.",
            "choices": [
                {
                    "id": "691330203",
                    "text": "Is that it?",
                    "response": [
                        {
                            "id": "691330205",
                            "speaker": "Sandrone",
                            "text": "Hah... Being \"hard to please\" is simply the mark of a lady's expectations and elevated taste. It doesn't mean she's incapable of adjusting."
                        },
                        {
                            "id": "691330206",
                            "speaker": "Sandrone",
                            "text": "Take this place, for example. Not a chair in sight, always raining, and the roof leaks — but you don't hear me complaining."
                        },
                        {
                            "id": "691330207",
                            "speaker": "Sandrone",
                            "text": "Of course, if I do start complaining, no matter how unpleasant my words, it'll all be entirely your fault.",
                            "choices": [
                                {
                                    "id": "691330208",
                                    "text": "So... Do you have any recommendations?",
                                    "response": [
                                        {
                                            "id": "691330210",
                                            "speaker": "Sandrone",
                                            "text": "I wouldn't use the word recommendations, per se... but if you're really interested, I can share some reference points from my former home."
                                        },
                                        {
                                            "id": "691330211",
                                            "speaker": "Sandrone",
                                            "text": "As for the interior, there's not much to say. But a warm fire in the hearth would make this place feel cozy all year round."
                                        },
                                        {
                                            "id": "691330212",
                                            "speaker": "Sandrone",
                                            "text": "If we're talking outdoors... I used to arrange my garden according to each plant's characteristics."
                                        },
                                        {
                                            "id": "691330213",
                                            "speaker": "Sandrone",
                                            "text": "Which flowers bloom in spring, which trees bear fruit in autumn... Making sure the fragrance of one flower doesn't overpower another... There's an art to it.",
                                            "choices": [
                                                {
                                                    "id": "691330214",
                                                    "text": "That sounds very complex...",
                                                    "response": [
                                                        {
                                                            "id": "691330215",
                                                            "speaker": "Sandrone",
                                                            "text": "It's simple once you learn the rules. I can teach you, if you'd like."
                                                        },
                                                        {
                                                            "id": "691330218",
                                                            "speaker": "Sandrone",
                                                            "text": "Anyway, under my care, the garden would change with the passing seasons. I was very proud of what I achieved — and it used to make Alain happy too."
                                                        },
                                                        {
                                                            "id": "691330219",
                                                            "speaker": "Sandrone",
                                                            "text": "Now that I think about it... I should really find the time to go back and tidy the whole place up."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691330216",
                                                    "text": "That sounds beautiful...",
                                                    "response": [
                                                        {
                                                            "id": "691330217",
                                                            "speaker": "Sandrone",
                                                            "text": "Hmph, that goes without saying."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691330209",
                                    "text": "How do you think I can improve this place?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691330204",
                    "text": "I thought you'd be harder to please..."
                }
            ]
        }
    ]
}