    "dialogues": [
        {
            "id": "690260901",
            "speaker": "Player",
            "text": "How do you like it here?"
        },
        {
            "id": "690260202",
            "speaker": "Xiao",
            "text": "..."
        },
        {
            "id": "690260203",
            "speaker": "Xiao",
            "text": "There are no ominous things here. It's a quiet place."
        },
        {
            "id": "690260204",
            "speaker": "Xiao",
            "text": "But...",
            "choices": [
                {
                    "id": "690260205",
                    "text": "But?",
                    "response": [
                        {
                            "id": "690260206",
                            "speaker": "Xiao",
                            "text": "It's too comfortable."
                        },
                        {
                            "id": "690260209",
                            "speaker": "Xiao",
                            "text": "I will protect this haven. For your sake."
                        },
                        {
                            "id": "690260210",
                            "speaker": "Xiao",
                            "text": "I know that I can never have a peaceful and carefree life."
                        },
                        {
                            "id": "690260211",
                            "speaker": "Xiao",
                            "text": "...Still, your kindness is accepted."
                        }
                    ]
                },
                {
                    "id": "690260207",
                    "text": "Not used to it?",
                    "response": [
                        {
                            "id": "690260208",
                            "speaker": "Xiao",
                            "text": "...Yes."
                        }
                    ]
                }
            ]
        }
    ]
}