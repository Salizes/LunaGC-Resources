{
    "talkId": "6901612",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Diluc": 16,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690161201",
            "speaker": "Player",
            "text": "Would you like to have a chat with me?"
        },
        {
            "id": "690160801",
            "speaker": "Diluc",
            "text": "...A chat of the idle variety?",
            "choices": [
                {
                    "id": "690160802",
                    "text": "I forgot, you're not a fan of small talk...",
                    "response": [
                        {
                            "id": "690160803",
                            "speaker": "Diluc",
                            "text": "No, it's fine. I don't mind."
                        },
                        {
                            "id": "690160804",
                            "speaker": "Diluc",
                            "text": "It's only fair that I set aside some time for you."
                        },
                        {
                            "id": "690160810",
                            "speaker": "Diluc",
                            "text": "Hmph. How perceptive of you. Yes, I am."
                        },
                        {
                            "id": "690160811",
                            "speaker": "Diluc",
                            "text": "Whether it's human avarice lurking in the shadows or a conspiracy from outside the human world..."
                        },
                        {
                            "id": "690160812",
                            "speaker": "Diluc",
                            "text": "Evil-doers are only waiting for us to let our guard down."
                        },
                        {
                            "id": "690160813",
                            "speaker": "Diluc",
                            "text": "..."
                        },
                        {
                            "id": "690160814",
                            "speaker": "Diluc",
                            "text": "This is not what you wanted to talk about, is it?",
                            "choices": [
                                {
                                    "id": "690160815",
                                    "text": "Never mind...",
                                    "response": [
                                        {
                                            "id": "690160816",
                                            "speaker": "Diluc",
                                            "text": "Hmm..."
                                        },
                                        {
                                            "id": "690160817",
                                            "speaker": "Diluc",
                                            "text": "I think I need to engage in a little introspection..."
                                        },
                                        {
                                            "id": "690160821",
                                            "speaker": "Diluc",
                                            "text": "But I will also try to find some conversation topics that align with your interests."
                                        }
                                    ]
                                },
                                {
                                    "id": "690160818",
                                    "text": "Knowing that Mondstadt has a protector like you puts my mind at ease.",
                                    "response": [
                                        {
                                            "id": "690160819",
                                            "speaker": "Diluc",
                                            "text": "Hmm..."
                                        },
                                        {
                                            "id": "690160820",
                                            "speaker": "Diluc",
                                            "text": "That's a given."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690160805",
                    "text": "You look so unhappy all the time, I thought I'd check in...",
                    "response": [
                        {
                            "id": "690160806",
                            "speaker": "Diluc",
                            "text": "Unhappy...? Nothing of the sort."
                        },
                        {
                            "id": "690160807",
                            "speaker": "Diluc",
                            "text": "I'm just thinking. Observing. Or planning."
                        },
                        {
                            "id": "690160808",
                            "speaker": "Diluc",
                            "text": "However... I appreciate your concern. I didn't mean to worry you."
                        }
                    ]
                },
                {
                    "id": "690160809",
                    "text": "Are you still preoccupied with Mondstadt's security?"
                }
            ]
        }
    ]
}