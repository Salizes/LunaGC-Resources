{
    "talkId": "6904109",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Mona": 9,
        "Player": 4
    },
    "dialogues": [
        {
            "id": "690410901",
            "speaker": "Player",
            "text": "Do you like it here?"
        },
        {
            "id": "690410202",
            "speaker": "Mona",
            "text": "Of course! The conditions and facilities are first-class, and it's very comfortable here."
        },
        {
            "id": "690410203",
            "speaker": "Mona",
            "text": "So comfortable that... I'm a bit worried that it might be hard to adjust once I leave.",
            "choices": [
                {
                    "id": "690410204",
                    "text": "Then... shouldn't you leave before it's too late?",
                    "response": [
                        {
                            "id": "690410205",
                            "speaker": "Mona",
                            "text": "Wh—What? No! Are you serious?"
                        },
                        {
                            "id": "690410210",
                            "speaker": "Mona",
                            "text": "Huh?"
                        },
                        {
                            "id": "690410211",
                            "speaker": "Mona",
                            "text": "Why you...! Hmph... since you're letting me stay here for free, I'll let that pass..."
                        },
                        {
                            "id": "690410212",
                            "speaker": "Mona",
                            "text": "Hmm... Let me think of a way to repay you somehow."
                        },
                        {
                            "id": "690410213",
                            "speaker": "Mona",
                            "text": "This way, we won't be indebted to each other."
                        }
                    ]
                },
                {
                    "id": "690410206",
                    "text": "You can stay forever.",
                    "response": [
                        {
                            "id": "690410207",
                            "speaker": "Mona",
                            "text": "R—Really?"
                        },
                        {
                            "id": "690410208",
                            "speaker": "Mona",
                            "text": "Being able to live in such a wonderful place without having to pay rent... Am I dreaming?"
                        }
                    ]
                },
                {
                    "id": "690410209",
                    "text": "There goes the Great Astrologist's pride..."
                }
            ]
        }
    ]
}