{
    "talkId": "6912504",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Columbina": 24,
        "Player": 23
    },
    "dialogues": [
        {
            "id": "691250401",
            "speaker": "Player",
            "text": "Anything you'd like to do?"
        },
        {
            "id": "691250402",
            "speaker": "Columbina",
            "text": "Um... I'm already here as your guest. Would it really be appropriate to have you fulfill my requests as well?",
            "choices": [
                {
                    "id": "691250403",
                    "text": "It's fine.",
                    "response": [
                        {
                            "id": "691250405",
                            "speaker": "Columbina",
                            "text": "Very well then. In truth, I do have something I need help with."
                        },
                        {
                            "id": "691250406",
                            "speaker": "Player",
                            "text": "I'm all ears."
                        },
                        {
                            "id": "691250407",
                            "speaker": "Columbina",
                            "text": "Lauma said that she would introduce me to the Frostmoon Scions of today, in the hope that I might integrate into this family."
                        },
                        {
                            "id": "691250408",
                            "speaker": "Columbina",
                            "text": "I'm glad she said so, but... also a little worried."
                        },
                        {
                            "id": "691250409",
                            "speaker": "Player",
                            "text": "What are you worried about?"
                        },
                        {
                            "id": "691250410",
                            "speaker": "Columbina",
                            "text": "I rarely interact much with strangers, so I worry that I may not be capable of keeping up the conversation. I do not wish to make them feel uncomfortable."
                        },
                        {
                            "id": "691250411",
                            "speaker": "Columbina",
                            "text": "Could you help me... rehearse? Or rather, simulate situations I might encounter."
                        },
                        {
                            "id": "691250412",
                            "speaker": "Player",
                            "text": "What do I need to do, precisely?"
                        },
                        {
                            "id": "691250413",
                            "speaker": "Columbina",
                            "text": "It's simple. Ask me questions that the Scions might ask, and I will answer. If my reply is inappropriate, let me know.",
                            "choices": [
                                {
                                    "id": "691250414",
                                    "text": "Honestly, all you need to do is be yourself...",
                                    "response": [
                                        {
                                            "id": "691250415",
                                            "speaker": "Columbina",
                                            "text": "I know. But this is a rare opportunity, and I wish to get along better with them, so..."
                                        },
                                        {
                                            "id": "691250417",
                                            "speaker": "Columbina",
                                            "text": "Then let's begin."
                                        },
                                        {
                                            "id": "691250418",
                                            "speaker": "Player",
                                            "text": "Will you leave us again, Lady Moon Goddess?"
                                        },
                                        {
                                            "id": "691250419",
                                            "speaker": "Columbina",
                                            "text": "I will.",
                                            "choices": [
                                                {
                                                    "id": "691250420",
                                                    "text": "...Come again?",
                                                    "response": [
                                                        {
                                                            "id": "691250422",
                                                            "speaker": "Columbina",
                                                            "text": "Hmm? I'll travel, won't I? That means I'll leave.",
                                                            "choices": [
                                                                {
                                                                    "id": "691250423",
                                                                    "text": "You need to be clear when it comes to things like this...",
                                                                    "response": [
                                                                        {
                                                                            "id": "691250425",
                                                                            "speaker": "Columbina",
                                                                            "text": "Oh. I see. I will be clear.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "691250426",
                                                                                    "text": "And just in case...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "691250428",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Sure."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250429",
                                                                                            "speaker": "Player",
                                                                                            "text": "Might you bless my marriage proposal, that it be accepted?"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250430",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "No."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250431",
                                                                                            "speaker": "Player",
                                                                                            "text": "Can you bless my child so that they might grow taller?"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250432",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "If your child happens to be a Rimehorn Deer..."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250433",
                                                                                            "speaker": "Player",
                                                                                            "text": "In cases like these, you can just say no as well."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250434",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Very well. No."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250435",
                                                                                            "speaker": "Player",
                                                                                            "text": "Are there any guests you'd like to invite to visit us?"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250436",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Sandrone of the Fatui, and Arlecchino, too. They are quite curious as to my life here."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250437",
                                                                                            "speaker": "Player",
                                                                                            "text": "Err, that might not go over too well..."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250438",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Huh...? They mustn't see? Would they not approve?"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250439",
                                                                                            "speaker": "Player",
                                                                                            "text": "I'm saying it wouldn't go over well with the Frostmoon Scions..."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250440",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "I see. In that case, I'd like to invite Maalaus, Mr. Albedo, and Miss Nicole."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250441",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Maalaus and Mr. Albedo are talented artists, while Miss Nicole is a gifted writer. I'd like them to chronicle the happy lives that the Frostmoon Scions lead today."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250442",
                                                                                            "speaker": "Player",
                                                                                            "text": "An excellent notion."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250443",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Yes, and as for Sandrone and Arlecchino, I shall sneak them in when the opportunity presents itself."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250444",
                                                                                            "speaker": "Player",
                                                                                            "text": "Now that... is something you can't say."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250445",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Yes. And I will not."
                                                                                        },
                                                                                        {
                                                                                            "id": "691250446",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "Hmm... My answers are not yet good enough, are they?"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250447",
                                                                                            "speaker": "Columbina",
                                                                                            "text": "We should practice more if we have the chance."
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "691250427",
                                                                                    "text": "Let me ask a few questions about tradition..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691250424",
                                                                    "text": "That's not the sort of \"leave\" they'd be asking about..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691250421",
                                                    "text": "Y—You will...?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691250416",
                                    "text": "I understand."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691250404",
                    "text": "This is how I show hospitality to my guests."
                }
            ]
        }
    ]
}