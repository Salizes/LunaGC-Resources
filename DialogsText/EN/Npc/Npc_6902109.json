    "dialogues": [
        {
            "id": "690210901",
            "speaker": "Player",
            "text": "How do you like it here?"
        },
        {
            "id": "690210202",
            "speaker": "Amber",
            "text": "I like it a lot!"
        },
        {
            "id": "690210203",
            "speaker": "Amber",
            "text": "I'm not too fussy about where I stay. After all, as an Outrider, I have to be able to adapt to all kinds of surroundings."
        },
        {
            "id": "690210204",
            "speaker": "Amber",
            "text": "If I had to, I could even sleep on a tree branch.",
            "choices": [
                {
                    "id": "690210205",
                    "text": "That's some impressive survival skills!",
                    "response": [
                        {
                            "id": "690210206",
                            "speaker": "Amber",
                            "text": "Y—You really think so...?"
                        },
                        {
                            "id": "690210209",
                            "speaker": "Amber",
                            "text": "Anyway, don't worry, this place is great!"
                        }
                    ]
                },
                {
                    "id": "690210207",
                    "text": "I hope you're more comfortable here than on a tree branch.",
                    "response": [
                        {
                            "id": "690210208",
                            "speaker": "Amber",
                            "text": "Hahaha, of course I am!"
                        }
                    ]
                }
            ]
        }
    ]
}