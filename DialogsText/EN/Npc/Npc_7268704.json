    "dialogues": [
        {
            "id": "726870401",
            "speaker": "Fushizome",
            "text": "Good day, you two."
        },
        {
            "id": "726870402",
            "speaker": "Fushizome",
            "text": "Are you interested in the art of ikebana?",
            "choices": [
                {
                    "id": "726870403",
                    "text": "\"Ikebana\"?",
                    "response": [
                        {
                            "id": "726870404",
                            "speaker": "Paimon",
                            "text": "Huh, Paimon feels like we've heard about this one before..."
                        },
                        {
                            "id": "726870405",
                            "speaker": "Fushizome",
                            "text": "That's wonderful."
                        },
                        {
                            "id": "726870406",
                            "speaker": "Fushizome",
                            "text": "I am currently organizing an event to show off the wonders of ikebana."
                        },
                        {
                            "id": "726870407",
                            "speaker": "Fushizome",
                            "text": "In a few days, you, too, will be able to experience its charm."
                        },
                        {
                            "id": "726870408",
                            "speaker": "Player",
                            "text": "Oh, now I'm curious..."
                        },
                        {
                            "id": "726870409",
                            "speaker": "Paimon",
                            "text": "Alrighty, we'll come back in a couple of days, then!"
                        }
                    ]
                },
                {
                    "id": "726870410",
                    "text": "I might be... at some point.",
                    "response": [
                        {
                            "id": "726870411",
                            "speaker": "Fushizome",
                            "text": "Well then, you can come down here in a few days to try ikebana out for yourself. Perhaps you, too, will be charmed by this art."
                        }
                    ]
                }
            ]
        }
    ]
