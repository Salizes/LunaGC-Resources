{
    "talkId": "6903507",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "Qiqi": 14
    },
    "dialogues": [
        {
            "id": "690350701",
            "speaker": "Player",
            "text": "Would you like to have a chat with me?"
        },
        {
            "id": "690350301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
        },
        {
            "id": "690350302",
            "speaker": "Qiqi",
            "text": "Chat... chat..."
        },
        {
            "id": "690350303",
            "speaker": "Qiqi",
            "text": "That would be nice. Chatting with you would be great."
        },
        {
            "id": "690350304",
            "speaker": "Qiqi",
            "text": "...But..."
        },
        {
            "id": "690350305",
            "speaker": "Player",
            "text": "But what?"
        },
        {
            "id": "690350306",
            "speaker": "Qiqi",
            "text": "...I'll forget."
        },
        {
            "id": "690350307",
            "speaker": "Qiqi",
            "text": "I'll forget everything we said..."
        },
        {
            "id": "690350308",
            "speaker": "Qiqi",
            "text": "...I'll forget what your voice sounded like..."
        },
        {
            "id": "690350309",
            "speaker": "Qiqi",
            "text": "...And... the happy feeling... I'll forget that too...",
            "choices": [
                {
                    "id": "690350310",
                    "text": "But you will be happy in the moment, right? That's what's important.",
                    "response": [
                        {
                            "id": "690350311",
                            "speaker": "Qiqi",
                            "text": "Oh... really?"
                        },
                        {
                            "id": "690350312",
                            "speaker": "Qiqi",
                            "text": "I suppose that... if I was sad now... you would be sad, too."
                        },
                        {
                            "id": "690350316",
                            "speaker": "Qiqi",
                            "text": "Okay. Qiqi wants to smile."
                        },
                        {
                            "id": "690350317",
                            "speaker": "Player",
                            "text": "Aww, what a cute smile."
                        },
                        {
                            "id": "690350318",
                            "speaker": "Qiqi",
                            "text": "Oh..."
                        },
                        {
                            "id": "690350319",
                            "speaker": "Qiqi",
                            "text": "...It's because you're here."
                        }
                    ]
                },
                {
                    "id": "690350313",
                    "text": "I'll come and chat with you every day.",
                    "response": [
                        {
                            "id": "690350314",
                            "speaker": "Qiqi",
                            "text": "Every day...?"
                        },
                        {
                            "id": "690350315",
                            "speaker": "Qiqi",
                            "text": "So, every day will be... happy?"
                        }
                    ]
                }
            ]
        }
    ]
}