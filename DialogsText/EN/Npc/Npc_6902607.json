{
    "talkId": "6902607",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "Xiao": 15
    },
    "dialogues": [
        {
            "id": "690260701",
            "speaker": "Player",
            "text": "Want to chat?"
        },
        {
            "id": "690260301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Want to chat?</color>"
        },
        {
            "id": "690260302",
            "speaker": "Xiao",
            "text": "...Idle chatter?"
        },
        {
            "id": "690260303",
            "speaker": "Xiao",
            "text": "...If you wish, I'll accompany you.",
            "choices": [
                {
                    "id": "690260304",
                    "text": "I thought you'd refuse.",
                    "response": [
                        {
                            "id": "690260305",
                            "speaker": "Xiao",
                            "text": "Hm?"
                        },
                        {
                            "id": "690260306",
                            "speaker": "Xiao",
                            "text": "To make a request but prepare yourself for rejection..."
                        },
                        {
                            "id": "690260307",
                            "speaker": "Xiao",
                            "text": "Human interaction really is troublesome."
                        },
                        {
                            "id": "690260311",
                            "speaker": "Xiao",
                            "text": "Generally, I don't partake in activities like \"chatting.\""
                        },
                        {
                            "id": "690260312",
                            "speaker": "Xiao",
                            "text": "But if it's with you... I'll try."
                        },
                        {
                            "id": "690260313",
                            "speaker": "Player",
                            "text": "How have you been?"
                        },
                        {
                            "id": "690260314",
                            "speaker": "Xiao",
                            "text": "Are you asking about the effects of my karmic debt?"
                        },
                        {
                            "id": "690260315",
                            "speaker": "Xiao",
                            "text": "...No issues."
                        },
                        {
                            "id": "690260316",
                            "speaker": "Xiao",
                            "text": "It is of my own doing, so I alone will bear the consequences."
                        },
                        {
                            "id": "690260317",
                            "speaker": "Xiao",
                            "text": "...I don't know if it's related to you, but recently, the pain from my karmic debt has been less excruciating."
                        },
                        {
                            "id": "690260318",
                            "speaker": "Xiao",
                            "text": "It's much easier to bear than before."
                        },
                        {
                            "id": "690260319",
                            "speaker": "Xiao",
                            "text": "As for any excess concerns... Best to leave that for yourself."
                        }
                    ]
                },
                {
                    "id": "690260308",
                    "text": "You seem a bit reluctant.",
                    "response": [
                        {
                            "id": "690260309",
                            "speaker": "Xiao",
                            "text": "That's not it."
                        },
                        {
                            "id": "690260310",
                            "speaker": "Xiao",
                            "text": "I didn't expect you to make such a request."
                        }
                    ]
                }
            ]
        }
    ]
}