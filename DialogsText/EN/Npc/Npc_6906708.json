{
    "talkId": "6906708",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Collei": 14,
        "Player": 10
    },
    "dialogues": [
        {
            "id": "690670301",
            "speaker": "Player",
            "text": "Want to chat?"
        },
        {
            "id": "690670302",
            "speaker": "Collei",
            "text": "Sounds good!"
        },
        {
            "id": "690670303",
            "speaker": "Collei",
            "text": "..."
        },
        {
            "id": "690670304",
            "speaker": "Collei",
            "text": "...Um, sorry, I thought you were gonna go first."
        },
        {
            "id": "690670305",
            "speaker": "Collei",
            "text": "I don't have much experience in starting conversations... so I don't really know where to start."
        },
        {
            "id": "690670306",
            "speaker": "Player",
            "text": "Don't worry. As it happens, I've got something I wanted to tell you."
        },
        {
            "id": "690670307",
            "speaker": "Collei",
            "text": "Oh... Sure, go ahead! I'm all ears.",
            "choices": [
                {
                    "id": "690670308",
                    "text": "Amber told me a few things about you...",
                    "response": [
                        {
                            "id": "690670309",
                            "speaker": "Collei",
                            "text": "Amber!? She mentioned me? What did she say? Wait, lemme grab my notebook, I need to write this down!",
                            "choices": [
                                {
                                    "id": "690670310",
                                    "text": "Seeing you flourishing...",
                                    "response": [
                                        {
                                            "id": "690670312",
                                            "speaker": "Collei",
                                            "text": "Heh, I don't know about flourishing — I've still got a long way to go... Was there anything else?",
                                            "choices": [
                                                {
                                                    "id": "690670313",
                                                    "text": "She mentioned your recent letter...",
                                                    "response": [
                                                        {
                                                            "id": "690670315",
                                                            "speaker": "Collei",
                                                            "text": "Oh... I, um, I did my best..."
                                                        },
                                                        {
                                                            "id": "690670320",
                                                            "speaker": "Collei",
                                                            "text": "I learned a few new words recently. I wanted to get the hang of them, so I tried to use them all in my letter."
                                                        },
                                                        {
                                                            "id": "690670321",
                                                            "speaker": "Collei",
                                                            "text": "But if that made it too difficult to read, I guess I was getting ahead of myself."
                                                        },
                                                        {
                                                            "id": "690670322",
                                                            "speaker": "Collei",
                                                            "text": "I need to take it slowly and use new words more carefully. Better to mix in a few new words with what I already know."
                                                        },
                                                        {
                                                            "id": "690670323",
                                                            "speaker": "Player",
                                                            "text": "I can spell-check your letters for you."
                                                        },
                                                        {
                                                            "id": "690670324",
                                                            "speaker": "Collei",
                                                            "text": "Really? Wow, thanks! Oh, and in that case, I need to call you \"Master,\" too!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690670314",
                                                    "text": "She said there were quite a few spelling mistakes..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690670311",
                                    "text": "Makes her really happy."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690670316",
                    "text": "Kaeya told me a few things about you...",
                    "response": [
                        {
                            "id": "690670317",
                            "speaker": "Collei",
                            "text": "K—Kaeya!? ...I'm sorry, I suddenly have a stomachache..."
                        },
                        {
                            "id": "690670318",
                            "speaker": "Player",
                            "text": "He said you made quite a few spelling mistakes in your letter."
                        },
                        {
                            "id": "690670319",
                            "speaker": "Collei",
                            "text": "Oh, is that it? I was sure he'd gone and... Ahem, never mind."
                        }
                    ]
                }
            ]
        }
    ]
}