{
    "talkId": "6902907",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Klee": 16,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690290701",
            "speaker": "Player",
            "text": "Would you like to have a chat with me?"
        },
        {
            "id": "690290301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
        },
        {
            "id": "690290302",
            "speaker": "Klee",
            "text": "Okay, I'll come! I like chatting."
        },
        {
            "id": "690290303",
            "speaker": "Klee",
            "text": "Ah, I can show you the latest cool thing I found.",
            "choices": [
                {
                    "id": "690290304",
                    "text": "Another cool thing?",
                    "response": [
                        {
                            "id": "690290306",
                            "speaker": "Klee",
                            "text": "Look at this! An awesome fishing net!"
                        },
                        {
                            "id": "690290307",
                            "speaker": "Klee",
                            "text": "Lemme teach you! You spread the net into the lake like this... Wait for the right moment and..."
                        },
                        {
                            "id": "690290308",
                            "speaker": "Klee",
                            "text": "Woosh! You scoop it up."
                        },
                        {
                            "id": "690290309",
                            "speaker": "Klee",
                            "text": "You have to make sure you're quietly hiding, then take them by surprise!",
                            "choices": [
                                {
                                    "id": "690290310",
                                    "text": "That was pretty impressive.",
                                    "response": [
                                        {
                                            "id": "690290311",
                                            "speaker": "Klee",
                                            "text": "Hehe, Klee told you all her secrets. Now you can be as amazing as Klee!"
                                        },
                                        {
                                            "id": "690290314",
                                            "speaker": "Klee",
                                            "text": "This way is a bit more annoying than using bombs though."
                                        },
                                        {
                                            "id": "690290315",
                                            "speaker": "Klee",
                                            "text": "Fish are slippery and flop around a lot, so they'll jump back into the water if you don't hold them tight."
                                        },
                                        {
                                            "id": "690290316",
                                            "speaker": "Klee",
                                            "text": "But... it's also fun to play with fish like this!",
                                            "choices": [
                                                {
                                                    "id": "690290317",
                                                    "text": "If you're with me, then don't worry, you can use your bombs.",
                                                    "response": [
                                                        {
                                                            "id": "690290318",
                                                            "speaker": "Klee",
                                                            "text": "Oh! Really?"
                                                        },
                                                        {
                                                            "id": "690290319",
                                                            "speaker": "Klee",
                                                            "text": "Then wait for me! I can make a lot of bombs really fast because I already prepared the materials!"
                                                        },
                                                        {
                                                            "id": "690290323",
                                                            "speaker": "Klee",
                                                            "text": "Hee hee, I'm super happy!"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690290320",
                                                    "text": "Let's have a fishing competition next time.",
                                                    "response": [
                                                        {
                                                            "id": "690290321",
                                                            "speaker": "Klee",
                                                            "text": "Okay!"
                                                        },
                                                        {
                                                            "id": "690290322",
                                                            "speaker": "Klee",
                                                            "text": "#If {F#Miss}{M#Mr.} Honorary Knight loses, then you have to cook dinner for Klee!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690290312",
                                    "text": "Why aren't you bombing the fish?",
                                    "response": [
                                        {
                                            "id": "690290313",
                                            "speaker": "Klee",
                                            "text": "#Cause this is {F#Miss}{M#Mr.} Honorary Knight's house, so Klee should be careful not to blow stuff up..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690290305",
                    "text": "What is it?"
                }
            ]
        }
    ]
}