    "dialogues": [
        {
            "id": "690161401",
            "speaker": "Player",
            "text": "How do you like it here?"
        },
        {
            "id": "690160701",
            "speaker": "Diluc",
            "text": "It's not bad.",
            "choices": [
                {
                    "id": "690160702",
                    "text": "...\"Not bad\"?",
                    "response": [
                        {
                            "id": "690160704",
                            "speaker": "Diluc",
                            "text": "..."
                        },
                        {
                            "id": "690160705",
                            "speaker": "Diluc",
                            "text": "Apologies, that wasn't intended as a slight against this residence."
                        },
                        {
                            "id": "690160706",
                            "speaker": "Diluc",
                            "text": "Nor did I mean to upset you."
                        },
                        {
                            "id": "690160707",
                            "speaker": "Diluc",
                            "text": "All I meant was... It could take me some time to get accustomed to lodging here."
                        },
                        {
                            "id": "690160708",
                            "speaker": "Diluc",
                            "text": "...But don't take it the wrong way."
                        }
                    ]
                },
                {
                    "id": "690160703",
                    "text": "So it's true what people say about your sophisticated tastes..."
                }
            ]
        }
    ]
}