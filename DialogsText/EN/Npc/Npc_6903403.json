{
    "talkId": "6903403",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Noelle": 15,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690340301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Would you like to have a chat with me?</color>"
        },
        {
            "id": "690340209",
            "speaker": "Noelle",
            "text": "It would be my pleasure!"
        },
        {
            "id": "690340302",
            "speaker": "Noelle",
            "text": "Do you know something? Ever since I came here, I don't believe I've picked up a single item of lost property."
        },
        {
            "id": "690340303",
            "speaker": "Noelle",
            "text": "I'm still not used to it...",
            "choices": [
                {
                    "id": "690340304",
                    "text": "...Huh?",
                    "response": [
                        {
                            "id": "690340305",
                            "speaker": "Noelle",
                            "text": "What I mean is, I often used to find odds and ends while performing my cleaning duties."
                        },
                        {
                            "id": "690340308",
                            "speaker": "Noelle",
                            "text": "For example... A faded headband under a cabinet."
                        },
                        {
                            "id": "690340309",
                            "speaker": "Noelle",
                            "text": "Or a ball hidden in a bush by a kitten."
                        },
                        {
                            "id": "690340310",
                            "speaker": "Noelle",
                            "text": "Or a bookmark in a corner of the library, keys dropped at the side of the road, an unsigned letter of confession stuck in the door of the church...",
                            "choices": [
                                {
                                    "id": "690340311",
                                    "text": "Sounds like cleaning is quite exhausting...",
                                    "response": [
                                        {
                                            "id": "690340312",
                                            "speaker": "Noelle",
                                            "text": "No, no, not at all! It is a great honor to perform my duties."
                                        },
                                        {
                                            "id": "690340315",
                                            "speaker": "Noelle",
                                            "text": "Speaking of cleaning..."
                                        },
                                        {
                                            "id": "690340316",
                                            "speaker": "Noelle",
                                            "text": "This place always seems so clean and tidy."
                                        },
                                        {
                                            "id": "690340317",
                                            "speaker": "Player",
                                            "text": "In no small part due to your efforts."
                                        },
                                        {
                                            "id": "690340318",
                                            "speaker": "Noelle",
                                            "text": "Thank you...!"
                                        },
                                        {
                                            "id": "690340319",
                                            "speaker": "Noelle",
                                            "text": "It's always very fulfilling to work here! More so than when I'm cleaning for the Knights or anywhere else."
                                        },
                                        {
                                            "id": "690340320",
                                            "speaker": "Noelle",
                                            "text": "Because... this is your home."
                                        }
                                    ]
                                },
                                {
                                    "id": "690340313",
                                    "text": "Where do all these things end up?",
                                    "response": [
                                        {
                                            "id": "690340314",
                                            "speaker": "Noelle",
                                            "text": "I always do my utmost to reunite each item with its owner! But the ones that go unclaimed remain at the Knights of Favonius headquarters."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690340306",
                    "text": "Wait, so you go around collecting random lost items?",
                    "response": [
                        {
                            "id": "690340307",
                            "speaker": "Noelle",
                            "text": "N—No, they're just items I find while cleaning..."
                        }
                    ]
                }
            ]
        }
    ]
}