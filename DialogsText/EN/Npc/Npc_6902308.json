{
    "talkId": "6902308",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "Xiangling": 17
    },
    "dialogues": [
        {
            "id": "690230801",
            "speaker": "Player",
            "text": "Anything you'd like to do?"
        },
        {
            "id": "690230401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Anything you'd like to do?</color>"
        },
        {
            "id": "690230402",
            "speaker": "Xiangling",
            "text": "I want to go adventuring with you!",
            "choices": [
                {
                    "id": "690230403",
                    "text": "Again? Isn't that what we always do?",
                    "response": [
                        {
                            "id": "690230404",
                            "speaker": "Xiangling",
                            "text": "Mm-hmm! Sure is!"
                        },
                        {
                            "id": "690230405",
                            "speaker": "Xiangling",
                            "text": "But even so, it's still the thing I wanna do most!"
                        },
                        {
                            "id": "690230408",
                            "speaker": "Xiangling",
                            "text": "I want to go adventuring with you into the unknown, collect strange new ingredients from all over Teyvat, and invent new recipes for you to sample!"
                        },
                        {
                            "id": "690230409",
                            "speaker": "Xiangling",
                            "text": "Ahh... the more I consider it, the more I think nothing could ever make me happier!"
                        },
                        {
                            "id": "690230410",
                            "speaker": "Player",
                            "text": "(Happiness à la Xiangling is beautifully simple...)"
                        },
                        {
                            "id": "690230411",
                            "speaker": "Xiangling",
                            "text": "Huh? You okay?"
                        },
                        {
                            "id": "690230412",
                            "speaker": "Xiangling",
                            "text": "You seem very quiet... Y—You don't like the idea?"
                        },
                        {
                            "id": "690230413",
                            "speaker": "Xiangling",
                            "text": "I won't add any strange seasonings... promise!"
                        },
                        {
                            "id": "690230414",
                            "speaker": "Xiangling",
                            "text": "Um — what I mean is... I'll definitely get your opinion before acting on any eureka moments!"
                        },
                        {
                            "id": "690230415",
                            "speaker": "Xiangling",
                            "text": "A—Also, I won't slow you down when we're out in the wilderness!"
                        },
                        {
                            "id": "690230416",
                            "speaker": "Xiangling",
                            "text": "And if I encounter any serious enemies, I promise I won't cause any trouble. First sign of danger, I'll run as fast as I can...",
                            "choices": [
                                {
                                    "id": "690230417",
                                    "text": "I never said I didn't like the idea...",
                                    "response": [
                                        {
                                            "id": "690230418",
                                            "speaker": "Xiangling",
                                            "text": "Phew! ...You scared the heck out of me."
                                        },
                                        {
                                            "id": "690230421",
                                            "speaker": "Xiangling",
                                            "text": "...Awesome!"
                                        },
                                        {
                                            "id": "690230422",
                                            "speaker": "Xiangling",
                                            "text": "A—Anyway, I'll make sure to keep working on my cooking... a—and any other skills that might come in handy!"
                                        },
                                        {
                                            "id": "690230423",
                                            "speaker": "Xiangling",
                                            "text": "Anything to put a smile on your face!"
                                        }
                                    ]
                                },
                                {
                                    "id": "690230419",
                                    "text": "What you said got me thinking, that's all.",
                                    "response": [
                                        {
                                            "id": "690230420",
                                            "speaker": "Xiangling",
                                            "text": "Ohhhh..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690230406",
                    "text": "I thought you'd want me to sample one of your creations.",
                    "response": [
                        {
                            "id": "690230407",
                            "speaker": "Xiangling",
                            "text": "Taste-testing is all part of the adventure!"
                        }
                    ]
                }
            ]
        }
    ]
}