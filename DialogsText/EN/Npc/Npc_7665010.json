{
    "talkId": "7665010",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Lauma": 10,
        "Paimon": 4,
        "Player": 8,
        "Weasel Thief": 3
    },
    "dialogues": [
        {
            "id": "766501001",
            "speaker": "Paimon",
            "text": "Hey Lauma, we're here to visit!",
            "choices": [
                {
                    "id": "766501002",
                    "text": "Whoa, what happened here?",
                    "response": [
                        {
                            "id": "766501004",
                            "speaker": "Paimon",
                            "text": "Yeah, boxes piled up everywhere, some of them opened up, loose items strewn all over the floor... Isn't this supposed to be a library?",
                            "choices": [
                                {
                                    "id": "766501005",
                                    "text": "Seems more like a storeroom at this point.",
                                    "response": [
                                        {
                                            "id": "766501007",
                                            "speaker": "Paimon",
                                            "text": "Look, Lauma's over there talking to a Weasel Thief... What are they plotting this time? Let's go see."
                                        },
                                        {
                                            "id": "766501008",
                                            "speaker": "Weasel Thief",
                                            "text": "..."
                                        },
                                        {
                                            "id": "766501009",
                                            "speaker": "Lauma",
                                            "text": "*sigh* Be that as it may, we don't have any urgent excavation work for you at the moment... So please, stop digging holes all over the place, alright?"
                                        },
                                        {
                                            "id": "766501010",
                                            "speaker": "Weasel Thief",
                                            "text": "♪"
                                        },
                                        {
                                            "id": "766501011",
                                            "speaker": "Lauma",
                                            "text": "That's a good child. Here, this Mora is for you."
                                        },
                                        {
                                            "id": "766501012",
                                            "speaker": "Weasel Thief",
                                            "text": "♪"
                                        },
                                        {
                                            "id": "766501013",
                                            "speaker": "Paimon",
                                            "text": "That's the Weasel Thief from last time, right? What was Lauma saying? Have they found another relic?"
                                        },
                                        {
                                            "id": "766501014",
                                            "speaker": "Lauma",
                                            "text": "#Hello there, {NICKNAME}, Paimon. Welcome to the library. Is there anything I can help you with?",
                                            "choices": [
                                                {
                                                    "id": "766501015",
                                                    "text": "I saw you talking to the Weasel Thief.",
                                                    "response": [
                                                        {
                                                            "id": "766501017",
                                                            "speaker": "Lauma",
                                                            "text": "No. I was just giving the little one a bit of a stern warning. It's been getting a little overexcited lately, and it's starting to bother the community."
                                                        },
                                                        {
                                                            "id": "766501018",
                                                            "speaker": "Lauma",
                                                            "text": "Its passion for treasure-hunting has only grown since we retrieved the Lunar Semblance... It comes to me all the time, asking when the next treasure hunt will be."
                                                        },
                                                        {
                                                            "id": "766501019",
                                                            "speaker": "Lauma",
                                                            "text": "I keep repeating that we now have more than enough documents and relics in our library to occupy our research, but alas...",
                                                            "choices": [
                                                                {
                                                                    "id": "766501020",
                                                                    "text": "It can't change its nature.",
                                                                    "response": [
                                                                        {
                                                                            "id": "766501022",
                                                                            "speaker": "Lauma",
                                                                            "text": "Yes. But it doesn't quite understand what constitutes a \"relic,\" so it simply digs up anything that seems valuable and drops it off here."
                                                                        },
                                                                        {
                                                                            "id": "766501023",
                                                                            "speaker": "Lauma",
                                                                            "text": "It has at least promised me that it won't go digging around again, but there's already a big backlog of items from previous digs... There's no way around it. I'll just have to go through and sort them one by one."
                                                                        },
                                                                        {
                                                                            "id": "766501024",
                                                                            "speaker": "Lauma",
                                                                            "text": "Sorry, you two. I'm afraid I won't be able to accompany you on your sightseeing today."
                                                                        },
                                                                        {
                                                                            "id": "766501025",
                                                                            "speaker": "Lauma",
                                                                            "text": "Phew... Now then, what's in this box again...?"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "766501021",
                                                                    "text": "It went off treasure-hunting on its own?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "766501016",
                                                    "text": "Have you found some more buried relics?"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "766501006",
                                    "text": "Are they doing some more renovations?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766501003",
                    "text": "...This is a lot of stuff."
                }
            ]
        }
    ]
}