{
    "talkId": "6905205",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Ei": 12,
        "Player": 8
    },
    "dialogues": [
        {
            "id": "690520501",
            "speaker": "Player",
            "text": "Anything you want to do?"
        },
        {
            "id": "690520502",
            "speaker": "Ei",
            "text": "Yes. Unsheathe your weapon.",
            "choices": [
                {
                    "id": "690520503",
                    "text": "Wait, you mean... now?",
                    "response": [
                        {
                            "id": "690520505",
                            "speaker": "Ei",
                            "text": "Hmph. Then I will come again once your preparation is complete. I have time."
                        },
                        {
                            "id": "690520506",
                            "speaker": "Ei",
                            "text": "I will use my blade to confirm whether you are out of practice or not."
                        },
                        {
                            "id": "690520507",
                            "speaker": "Player",
                            "text": "Wait, are you serious?"
                        },
                        {
                            "id": "690520508",
                            "speaker": "Ei",
                            "text": "Naturally."
                        },
                        {
                            "id": "690520509",
                            "speaker": "Ei",
                            "text": "The moment that blades are crossed in battle also becomes a kind of Eternity. I shall use this moment to feel your inner being."
                        },
                        {
                            "id": "690520510",
                            "speaker": "Ei",
                            "text": "A simple and direct method, yet more clear than any language could convey. It even allows me to verify my own existence.",
                            "choices": [
                                {
                                    "id": "690520511",
                                    "text": "Something seems a bit off...",
                                    "response": [
                                        {
                                            "id": "690520513",
                                            "speaker": "Ei",
                                            "text": "Huh? So you could see through my guise? Oh. I thought my impression was accurate enough."
                                        },
                                        {
                                            "id": "690520514",
                                            "speaker": "Ei",
                                            "text": "Never mind. I'll be honest with you then, I desire to spar with you."
                                        },
                                        {
                                            "id": "690520515",
                                            "speaker": "Ei",
                                            "text": "After all, few have ever proved capable of withstanding my blade. It would be a pleasure to train with you."
                                        },
                                        {
                                            "id": "690520516",
                                            "speaker": "Ei",
                                            "text": "However, I feared that you would be hesitant to strike me, so I used the identity of the Shogun.",
                                            "choices": [
                                                {
                                                    "id": "690520517",
                                                    "text": "There's no need to trick me into it...",
                                                    "response": [
                                                        {
                                                            "id": "690520519",
                                                            "speaker": "Ei",
                                                            "text": "Ah, you don't refuse. May I assume you accept then?"
                                                        },
                                                        {
                                                            "id": "690520520",
                                                            "speaker": "Ei",
                                                            "text": "Hehe, you should prepare yourself. I certainly won't go easy on you."
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690520518",
                                                    "text": "That's an odd request..."
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690520512",
                                    "text": "Ei? Is that you?"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690520504",
                    "text": "I'm not mentally prepared for this."
                }
            ]
        }
    ]
}