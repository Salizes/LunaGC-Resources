    "dialogues": [
        {
            "id": "400122501",
            "speaker": "Jean",
            "text": "The ocean really is beautiful at night...",
            "choices": [
                {
                    "id": "400122502",
                    "text": "Do you want to chat?",
                    "response": [
                        {
                            "id": "400122503",
                            "speaker": "Jean",
                            "text": "Sure! What would you like to talk about, Traveler?",
                            "choices": [
                                {
                                    "id": "400122504",
                                    "text": "How's work these days with the Knights...",
                                    "response": [
                                        {
                                            "id": "400122505",
                                            "speaker": "Jean",
                                            "text": "Work? As long as Lisa's there, I'm not worried. She's more hardworking than anyone once she gets going."
                                        },
                                        {
                                            "id": "400122506",
                                            "speaker": "Jean",
                                            "text": "Still, I put a lot on her plate this time. I do feel a little guilty..."
                                        },
                                        {
                                            "id": "400122507",
                                            "speaker": "Jean",
                                            "text": "Hmm, I must send her a gift. It's a good thing that I know what she likes.",
                                            "choices": [
                                                {
                                                    "id": "400122504",
                                                    "text": "How's work these days with the Knights..."
                                                },
                                                {
                                                    "id": "400122508",
                                                    "text": "Tell me about these islands...",
                                                    "response": [
                                                        {
                                                            "id": "400122509",
                                                            "speaker": "Jean",
                                                            "text": "I've never visited an archipelago like this before. It certainly is a place like no other. It has something of the unknown about it, and seems to have its fair share of dangers... and yet the mystery is all part of its beauty."
                                                        },
                                                        {
                                                            "id": "400122510",
                                                            "speaker": "Jean",
                                                            "text": "It has a charm that I can't quite put my finger on. I think I'm slowly beginning to understand what drives adventurers to go in search of unknown places."
                                                        },
                                                        {
                                                            "id": "400122511",
                                                            "speaker": "Jean",
                                                            "text": "Traveler, you're an adventurer... do you understand what I mean?"
                                                        },
                                                        {
                                                            "id": "400122512",
                                                            "speaker": "Jean",
                                                            "text": "Of course, safety still comes first when adventuring.",
                                                            "choices": [
                                                                {
                                                                    "id": "400122504",
                                                                    "text": "How's work these days with the Knights..."
                                                                },
                                                                {
                                                                    "id": "400122508",
                                                                    "text": "Tell me about these islands..."
                                                                },
                                                                {
                                                                    "id": "400122513",
                                                                    "text": "Tell me about yourself...",
                                                                    "response": [
                                                                        {
                                                                            "id": "400122514",
                                                                            "speaker": "Jean",
                                                                            "text": "You know... I think I've come to realize that I'm lacking a certain... fun side?"
                                                                        },
                                                                        {
                                                                            "id": "400122515",
                                                                            "speaker": "Jean",
                                                                            "text": "Sorry, I don't know exactly how to put it... Traveler, I want to ask you something."
                                                                        },
                                                                        {
                                                                            "id": "400122516",
                                                                            "speaker": "Player",
                                                                            "text": "Sure."
                                                                        },
                                                                        {
                                                                            "id": "400122517",
                                                                            "speaker": "Jean",
                                                                            "text": "Do you think that I'm... too serious?"
                                                                        },
                                                                        {
                                                                            "id": "400122518",
                                                                            "speaker": "Jean",
                                                                            "text": "I guess that's why everyone wants me to get more rest and relaxation... Apologies."
                                                                        },
                                                                        {
                                                                            "id": "400122519",
                                                                            "speaker": "Player",
                                                                            "text": "No, no, that's what makes Jean so sweet."
                                                                        },
                                                                        {
                                                                            "id": "400122520",
                                                                            "speaker": "Jean",
                                                                            "text": "Huh? I—I never thought that anyone would consider my personality as \"sweet\"..."
                                                                        },
                                                                        {
                                                                            "id": "400122521",
                                                                            "speaker": "Jean",
                                                                            "text": "Thank you for your constant kind words and comfort, Traveler."
                                                                        },
                                                                        {
                                                                            "id": "400122522",
                                                                            "speaker": "Jean",
                                                                            "text": "Whatever the case, I think I know what everyone is getting at. I'll do my best to improve.",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400122504",
                                                                                    "text": "How's work these days with the Knights..."
                                                                                },
                                                                                {
                                                                                    "id": "400122508",
                                                                                    "text": "Tell me about these islands..."
                                                                                },
                                                                                {
                                                                                    "id": "400122513",
                                                                                    "text": "Tell me about yourself..."
                                                                                },
                                                                                {
                                                                                    "id": "400122523",
                                                                                    "text": "About what happened today...",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400122524",
                                                                                            "speaker": "Jean",
                                                                                            "text": "I honestly never thought that all of us would end up here..."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122525",
                                                                                            "speaker": "Jean",
                                                                                            "text": "I don't know if this is right, but... I think it's made Klee very happy."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122526",
                                                                                            "speaker": "Jean",
                                                                                            "text": "She likes having fun and being around people. She can take care of the excitement, and I'll take care of everyone's safety."
                                                                                        },
                                                                                        {
                                                                                            "id": "400122527",
                                                                                            "speaker": "Jean",
                                                                                            "text": "What a beautiful view. The ocean is good company... I hope we can all find some peace and happiness while we're here.",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "400122504",
                                                                                                    "text": "How's work these days with the Knights..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122508",
                                                                                                    "text": "Tell me about these islands..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122513",
                                                                                                    "text": "Tell me about yourself..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122523",
                                                                                                    "text": "About what happened today..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122528",
                                                                                                    "text": "I won't disturb you.",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "400122529",
                                                                                                            "speaker": "Jean",
                                                                                                            "text": "Alright, good night."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "400122528",
