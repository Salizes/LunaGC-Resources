{
    "talkId": "6903408",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Noelle": 8,
        "Player": 6
    },
    "dialogues": [
        {
            "id": "690340801",
            "speaker": "Player",
            "text": "Is there anything you'd like to do?"
        },
        {
            "id": "690340401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
        },
        {
            "id": "690340402",
            "speaker": "Noelle",
            "text": "Huh? You're asking me...?"
        },
        {
            "id": "690340403",
            "speaker": "Noelle",
            "text": "I... I want to take your measurements and make an outfit for you.",
            "choices": [
                {
                    "id": "690340404",
                    "text": "Where has that idea come from?",
                    "response": [
                        {
                            "id": "690340407",
                            "speaker": "Noelle",
                            "text": "If you wore clothes that I made for you..."
                        },
                        {
                            "id": "690340408",
                            "speaker": "Noelle",
                            "text": "It'd most certainly be a wonderfully momentous occasion...",
                            "choices": [
                                {
                                    "id": "690340409",
                                    "text": "Well, if you insist... Much obliged!",
                                    "response": [
                                        {
                                            "id": "690340411",
                                            "speaker": "Noelle",
                                            "text": "Okay... Alright then..."
                                        },
                                        {
                                            "id": "690340412",
                                            "speaker": "Noelle",
                                            "text": "Excellent! Time to get busy-busy again!"
                                        },
                                        {
                                            "id": "690340413",
                                            "speaker": "Noelle",
                                            "text": "Only, this must be the happiest kind of busy in all of Teyvat."
                                        }
                                    ]
                                },
                                {
                                    "id": "690340410",
                                    "text": "I'll be sure to get you something in return."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690340405",
                    "text": "So you even know how to sew, too?",
                    "response": [
                        {
                            "id": "690340406",
                            "speaker": "Noelle",
                            "text": "Oh, of course... They... don't call me the, uh, \"Wondermaid\" for nothing..."
                        }
                    ]
                }
            ]
        }
    ]
}