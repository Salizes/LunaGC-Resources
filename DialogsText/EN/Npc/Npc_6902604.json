{
    "talkId": "6902604",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "Xiao": 13
    },
    "dialogues": [
        {
            "id": "690260401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
        },
        {
            "id": "690260402",
            "speaker": "Xiao",
            "text": "If you have free time, we can go to Liyue Harbor together..."
        },
        {
            "id": "690260403",
            "speaker": "Xiao",
            "text": "If not... never mind.",
            "choices": [
                {
                    "id": "690260404",
                    "text": "Of course we can.",
                    "response": [
                        {
                            "id": "690260405",
                            "speaker": "Xiao",
                            "text": "Uh... alright."
                        },
                        {
                            "id": "690260408",
                            "speaker": "Xiao",
                            "text": "I have no intention of getting close to the lives of mortals."
                        },
                        {
                            "id": "690260409",
                            "speaker": "Xiao",
                            "text": "But I know that you often enter and leave the city, walking amidst the crowd."
                        },
                        {
                            "id": "690260410",
                            "speaker": "Xiao",
                            "text": "The stories of these times, or their joys... If I don't experience such things myself, it'll be hard to understand your thoughts."
                        },
                        {
                            "id": "690260411",
                            "speaker": "Player",
                            "text": "So... you're doing this for me?"
                        },
                        {
                            "id": "690260412",
                            "speaker": "Xiao",
                            "text": "Yes, to understand you."
                        },
                        {
                            "id": "690260413",
                            "speaker": "Xiao",
                            "text": "I had a feeling that it would be difficult, but after having such thoughts, I can't simply sit back and do nothing."
                        },
                        {
                            "id": "690260414",
                            "speaker": "Xiao",
                            "text": "I will control myself while I am in the city."
                        },
                        {
                            "id": "690260415",
                            "speaker": "Xiao",
                            "text": "I'll try to speak... as little as possible.",
                            "choices": [
                                {
                                    "id": "690260416",
                                    "text": "I'll be with you.",
                                    "response": [
                                        {
                                            "id": "690260418",
                                            "speaker": "Xiao",
                                            "text": "Hmm..."
                                        },
                                        {
                                            "id": "690260419",
                                            "speaker": "Xiao",
                                            "text": "Let me know when you're ready to go."
                                        }
                                    ]
                                },
                                {
                                    "id": "690260417",
                                    "text": "You can say whatever you want. I'll bail you out."
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690260406",
                    "text": "Finally decided to integrate into city life?",
                    "response": [
                        {
                            "id": "690260407",
                            "speaker": "Xiao",
                            "text": "Ahem..."
                        }
                    ]
                }
            ]
        }
    ]
}