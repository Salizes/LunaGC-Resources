{
    "talkId": "6903508",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "Qiqi": 10
    },
    "dialogues": [
        {
            "id": "690350801",
            "speaker": "Player",
            "text": "Is there anything you'd like to do?"
        },
        {
            "id": "690350401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>Is there anything you'd like to do?</color>"
        },
        {
            "id": "690350402",
            "speaker": "Qiqi",
            "text": "I... want to get a pet finch."
        },
        {
            "id": "690350403",
            "speaker": "Qiqi",
            "text": "Then we can... look after it here... together."
        },
        {
            "id": "690350404",
            "speaker": "Qiqi",
            "text": "If you find some seeds, I can feed it."
        },
        {
            "id": "690350405",
            "speaker": "Qiqi",
            "text": "We can build a nest... so the wind and rain won't disturb it."
        },
        {
            "id": "690350406",
            "speaker": "Qiqi",
            "text": "I will take it on walks during the daytime... and it can stretch with me before bedtime.",
            "choices": [
                {
                    "id": "690350407",
                    "text": "You'd be like the finch's older sister.",
                    "response": [
                        {
                            "id": "690350409",
                            "speaker": "Qiqi",
                            "text": "Yes! I will be a good... role model."
                        },
                        {
                            "id": "690350410",
                            "speaker": "Qiqi",
                            "text": "I'll protect it... and you too.",
                            "choices": [
                                {
                                    "id": "690350411",
                                    "text": "And I'll make sure to look after you both, too.",
                                    "response": [
                                        {
                                            "id": "690350413",
                                            "speaker": "Qiqi",
                                            "text": "Mm-hmm!"
                                        },
                                        {
                                            "id": "690350414",
                                            "speaker": "Qiqi",
                                            "text": "You, Qiqi, and a nice little finch..."
                                        },
                                        {
                                            "id": "690350415",
                                            "speaker": "Qiqi",
                                            "text": "*sigh* That would be quite nice..."
                                        }
                                    ]
                                },
                                {
                                    "id": "690350412",
                                    "text": "Thanks, Qiqi, counting on you!"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690350408",
                    "text": "It'd be sure to grow up strong and healthy."
                }
            ]
        }
    ]
}