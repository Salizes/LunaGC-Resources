    "talks": [
        {
            "id": "4121401",
            "objective": "Look for Albedo",
            "dialogues": [
                {
                    "id": "412140101",
                    "speaker": "Paimon",
                    "text": "We're back! It's us again!"
                },
                {
                    "id": "412140102",
                    "speaker": "Albedo",
                    "text": "Traveler, Paimon, welcome back."
                },
                {
                    "id": "412140103",
                    "speaker": "Paimon",
                    "text": "Paimon's already used to meeting Albedo like that.",
                    "choices": [
                        {
                            "id": "412140104",
                            "text": "I've fulfilled your request.",
                            "response": [
                                {
                                    "id": "412140106",
                                    "speaker": "Albedo",
                                    "text": "Thank you so much. I knew I could count on you."
                                },
                                {
                                    "id": "412140107",
                                    "speaker": "Player",
                                    "text": "Count on me to help you?"
                                },
                                {
                                    "id": "412140108",
                                    "speaker": "Albedo",
                                    "text": "Naturally, you were crucial to my research."
                                },
                                {
                                    "id": "412140109",
                                    "speaker": "Paimon",
                                    "text": "Ehehe, glad to hear that~"
                                },
                                {
                                    "id": "412140110",
                                    "speaker": "Albedo",
                                    "text": "I'll never forget your kindness."
                                },
                                {
                                    "id": "412140111",
                                    "speaker": "Player",
                                    "text": "Now you can take the sword back."
                                },
                                {
                                    "id": "412140112",
                                    "speaker": "Paimon",
                                    "text": "Should be powerful enough, right?"
                                },
                                {
                                    "id": "412140113",
                                    "speaker": "Albedo",
                                    "text": "More or less... but tell me... How do you feel?"
                                },
                                {
                                    "id": "412140114",
                                    "speaker": "Player",
                                    "text": "Same old."
                                },
                                {
                                    "id": "412140115",
                                    "speaker": "Albedo",
                                    "text": "Good. There's no side effects, no corruption or poison."
                                },
                                {
                                    "id": "412140116",
                                    "speaker": "Albedo",
                                    "text": "Looks like... I've been correct all along."
                                },
                                {
                                    "id": "412140117",
                                    "speaker": "Paimon",
                                    "text": "This guy, pretending to be a prophet!"
                                },
                                {
                                    "id": "412140118",
                                    "speaker": "Albedo",
                                    "text": "How do you like the sword?",
                                    "choices": [
                                        {
                                            "id": "412140119",
                                            "text": "It's a nice weapon.",
                                            "response": [
                                                {
                                                    "id": "412140121",
                                                    "speaker": "Albedo",
                                                    "text": "Is that so? Regardless, it's reached the desired state."
                                                },
                                                {
                                                    "id": "412140122",
                                                    "speaker": "Paimon",
                                                    "text": "Why are you holding the sword? Albedo, what're you trying to do? Don't mess around!"
                                                },
                                                {
                                                    "id": "412140123",
                                                    "speaker": "Albedo",
                                                    "text": "I want to extract the purified life force from within it."
                                                },
                                                {
                                                    "id": "412140124",
                                                    "speaker": "Paimon",
                                                    "text": "Can this force exist outside of the sword?"
                                                },
                                                {
                                                    "id": "412140125",
                                                    "speaker": "Albedo",
                                                    "text": "What's impossible for some... might be just within my reach."
                                                },
                                                {
                                                    "id": "412140126",
                                                    "speaker": "Albedo",
                                                    "text": "...All done."
                                                },
                                                {
                                                    "id": "412140127",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, this energy looks like a ball of light..."
                                                },
                                                {
                                                    "id": "412140128",
                                                    "speaker": "Paimon",
                                                    "text": "Ah! You put it into a mysterious bottle!"
                                                },
                                                {
                                                    "id": "412140129",
                                                    "speaker": "Albedo",
                                                    "text": "This sword might not be a divine weapon..."
                                                },
                                                {
                                                    "id": "412140130",
                                                    "speaker": "Albedo",
                                                    "text": "...But it'll make a fine memento. I hope it can be of some help during your travels.",
                                                    "choices": [
                                                        {
                                                            "id": "412140131",
                                                            "text": "Really?",
                                                            "response": [
                                                                {
                                                                    "id": "412140133",
                                                                    "speaker": "Albedo",
                                                                    "text": "I needed it for the sake of my research. I've already obtained the results of the experiment. This sword belongs to you, a person who knows how to use it."
                                                                },
                                                                {
                                                                    "id": "412140134",
                                                                    "speaker": "Albedo",
                                                                    "text": "Thank you for your assistance with completing this research. Well then, goodbye."
                                                                },
                                                                {
                                                                    "id": "412140135",
                                                                    "speaker": "Albedo",
                                                                    "text": "This dragon's life force resonates with me..."
                                                                },
                                                                {
                                                                    "id": "412140136",
                                                                    "speaker": "Albedo",
                                                                    "text": "Not because it's a dragon, but because I am... me."
                                                                },
                                                                {
                                                                    "id": "412140137",
                                                                    "speaker": "Albedo",
                                                                    "text": "Rhinedottir... Master... Is this your creation, the giant dragon Durin?"
                                                                },
                                                                {
                                                                    "id": "412140138",
                                                                    "speaker": "Albedo",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "412140139",
                                                                    "speaker": "Albedo",
                                                                    "text": "Was the two of us meeting really a good thing?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "412140132",
                                                            "text": "You don't need it anymore?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412140120",
                                            "text": "It's no good."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412140105",
                            "text": "I've done what you wanted, as promised."
                        }
                    ]
                }
            ]
        },
        {
