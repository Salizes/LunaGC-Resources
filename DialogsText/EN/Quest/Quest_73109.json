    "talks": [
        {
            "id": "7310901",
            "objective": "",
            "dialogues": [
                {
                    "id": "731090101",
                    "speaker": "Javi",
                    "text": "This is strange... It should be around here. Why can't I find it?"
                },
                {
                    "id": "731090102",
                    "speaker": "Player",
                    "text": "What are you looking for?"
                },
                {
                    "id": "731090103",
                    "speaker": "Javi",
                    "text": "You're... Oh, the Traveler, right? I've heard about you."
                },
                {
                    "id": "731090104",
                    "speaker": "Javi",
                    "text": "I'm Javi, a... normal salesperson. I'm looking for the \"Dream Box\" I buried before."
                },
                {
                    "id": "731090105",
                    "speaker": "Paimon",
                    "text": "That's a strange name... What is in it?"
                },
                {
                    "id": "731090106",
                    "speaker": "Javi",
                    "text": "Well... If I have to put it into words, it contains my childhood \"dreams to be realized.\""
                },
                {
                    "id": "731090107",
                    "speaker": "Player",
                    "text": "Why did you do that?"
                },
                {
                    "id": "731090108",
                    "speaker": "Javi",
                    "text": "Hahaha, that was a childhood game I played with friends."
                },
                {
                    "id": "731090109",
                    "speaker": "Javi",
                    "text": "We each wrote down the most precious dream we had then, and buried it here. We have agreed on a time when we are gonna gather here again and dig our \"Dream Boxes\" out."
                },
                {
                    "id": "731090110",
                    "speaker": "Javi",
                    "text": "Now the time comes, but... Seems that I'm the only one remembering the promise."
                },
                {
                    "id": "731090111",
                    "speaker": "Javi",
                    "text": "*sigh* That's okay, though... As long as they keep their dreams."
                },
                {
                    "id": "731090112",
                    "speaker": "Javi",
                    "text": "Anyway, I'm coming to dig my box out, so that I can have some closure."
                },
                {
                    "id": "731090113",
                    "speaker": "Javi",
                    "text": "But I searched around and found nothing. Could it be that someone took it?",
                    "choices": [
                        {
                            "id": "731090114",
                            "text": "Did you leave a mark?",
                            "response": [
                                {
                                    "id": "731090118",
                                    "speaker": "Javi",
                                    "text": "I remember burying it beside a tree..."
                                },
                                {
                                    "id": "731090119",
                                    "speaker": "Paimon",
                                    "text": "A tree? B—But Paimon sees lots of trees here!"
                                },
                                {
                                    "id": "731090120",
                                    "speaker": "Javi",
                                    "text": "I didn't expect this as a child, you know. We only set up a tiny sign as a reminder."
                                },
                                {
                                    "id": "731090121",
                                    "speaker": "Javi",
                                    "text": "But it's all gone after all this time, and the trees nearby have totally grown different..."
                                },
                                {
                                    "id": "731090122",
                                    "speaker": "Javi",
                                    "text": "I just got the vague impression that the box was buried somewhere near."
                                },
                                {
                                    "id": "731090123",
                                    "speaker": "Javi",
                                    "text": "Traveler, could you help me find it?",
                                    "choices": [
                                        {
                                            "id": "731090124",
                                            "text": "But how?",
                                            "response": [
                                                {
                                                    "id": "731090125",
                                                    "speaker": "Javi",
                                                    "text": "I buried the box near a tree, so... let's try digging beside the trees."
                                                },
                                                {
                                                    "id": "731090126",
                                                    "speaker": "Javi",
                                                    "text": "Please, lend me a hand, Traveler. I'll pay you."
                                                },
                                                {
                                                    "id": "731090130",
                                                    "speaker": "Javi",
                                                    "text": "Look at all the trees here. I will never find it without help..."
                                                },
                                                {
                                                    "id": "731090131",
                                                    "speaker": "Player",
                                                    "text": "Fine..."
                                                },
                                                {
                                                    "id": "731090132",
                                                    "speaker": "Javi",
                                                    "text": "Hehe, thank you. We'll split, then. I'm staying here, and you can search there."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090127",
                                            "text": "It has already flown away...",
                                            "response": [
                                                {
                                                    "id": "731090128",
                                                    "speaker": "Javi",
                                                    "text": "Yes, my dream has flown away, and that's exactly why I'm digging the box out to see my dream back then."
                                                },
                                                {
                                                    "id": "731090129",
                                                    "speaker": "Javi",
                                                    "text": "Please, Traveler, just a tiny favor here. I'll have your payment ready."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090115",
                            "text": "So your dream has flown away...",
                            "response": [
                                {
                                    "id": "731090116",
                                    "speaker": "Javi",
                                    "text": "Hahaha... Can't say I disagree, since I can't even remember what I wrote..."
                                },
                                {
                                    "id": "731090117",
                                    "speaker": "Javi",
                                    "text": "But even if my dream can fly away, the box cannot."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310902",
            "objective": "Help Javi look for his \"dream\"",
            "dialogues": []
        },
        {
            "id": "7310903",
            "objective": "Give the \"dream\" to Javi",
            "dialogues": [
                {
                    "id": "731090301",
                    "speaker": "Javi",
                    "text": "Oh no. This isn't my Dream Box.",
                    "choices": [
                        {
                            "id": "731090302",
                            "text": "We've got a box.",
                            "response": [
                                {
                                    "id": "731090303",
                                    "speaker": "Javi",
                                    "text": "Haha... I've got one, too..."
                                },
                                {
                                    "id": "731090305",
                                    "speaker": "Javi",
                                    "text": "I even opened it, and found a piece of paper with Ami's name on it."
                                },
                                {
                                    "id": "731090306",
                                    "speaker": "Javi",
                                    "text": "I remember that kid, the daughter of Jahangir, who was always found near the food shop."
                                },
                                {
                                    "id": "731090307",
                                    "speaker": "Javi",
                                    "text": "So she dreamed of becoming a florist, who would care for a lot of flowers..."
                                },
                                {
                                    "id": "731090308",
                                    "speaker": "Javi",
                                    "text": "That was unexpected. I always thought Jahangir was gonna pass the shop to her.",
                                    "choices": [
                                        {
                                            "id": "731090309",
                                            "text": "Let's see your dream first.",
                                            "response": [
                                                {
                                                    "id": "731090311",
                                                    "speaker": "Javi",
                                                    "text": "Oh! I almost forgot, I must take a look at my own dream first..."
                                                },
                                                {
                                                    "id": "731090312",
                                                    "speaker": "Javi",
                                                    "text": "Lemme see..."
                                                },
                                                {
                                                    "id": "731090313",
                                                    "speaker": "Javi",
                                                    "text": "\"I hope to be a Vanara, and live in the forest forever...\""
                                                },
                                                {
                                                    "id": "731090314",
                                                    "speaker": "Javi",
                                                    "text": "So that's my childhood dream? My goodness, I can't believe that's what I wished for..."
                                                },
                                                {
                                                    "id": "731090315",
                                                    "speaker": "Javi",
                                                    "text": "Come on... Kiddo, being a Vanara won't pay you much.",
                                                    "choices": [
                                                        {
                                                            "id": "731090316",
                                                            "text": "I don't see anything wrong with that.",
                                                            "response": [
                                                                {
                                                                    "id": "731090318",
                                                                    "speaker": "Javi",
                                                                    "text": "That's just some childish ideas. For someone at my age, dreams..."
                                                                },
                                                                {
                                                                    "id": "731090319",
                                                                    "speaker": "Javi",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "731090320",
                                                                    "speaker": "Javi",
                                                                    "text": "Better think about ways to get more Mora, and that's what gives some good sleep."
                                                                },
                                                                {
                                                                    "id": "731090321",
                                                                    "speaker": "Javi",
                                                                    "text": "Enough about my boring dream, let's talk about Ami."
                                                                },
                                                                {
                                                                    "id": "731090322",
                                                                    "speaker": "Javi",
                                                                    "text": "I should definitely do something to make amends to her since I opened her \"Dream Box\" without consent."
                                                                },
                                                                {
                                                                    "id": "731090323",
                                                                    "speaker": "Javi",
                                                                    "text": "Well... Let me think, being a florist starts with learning how to plant flowers."
                                                                },
                                                                {
                                                                    "id": "731090324",
                                                                    "speaker": "Javi",
                                                                    "text": "I happened to have a spare flower pot that I can give her."
                                                                },
                                                                {
                                                                    "id": "731090325",
                                                                    "speaker": "Javi",
                                                                    "text": "Traveler, do you happen to know somewhere to get some flower seeds?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "731090326",
                                                                            "text": "Leave it to me.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731090332",
                                                                                    "speaker": "Javi",
                                                                                    "text": "I'm counting on you for the seeds, Traveler. See you beside Jahangir's shop."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "731090327",
                                                                            "text": "Why are you doing this?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731090328",
                                                                                    "speaker": "Javi",
                                                                                    "text": "Hahaha... Let's just say I'm being spontaneous."
                                                                                },
                                                                                {
                                                                                    "id": "731090329",
                                                                                    "speaker": "Javi",
                                                                                    "text": "I will never realize my dream, because of all the years behind me, and... the fact that I don't actually care about the dream anymore."
                                                                                },
                                                                                {
                                                                                    "id": "731090330",
                                                                                    "speaker": "Javi",
                                                                                    "text": "But Ami is still young. She can still try to realize her dream."
                                                                                },
                                                                                {
                                                                                    "id": "731090331",
                                                                                    "speaker": "Javi",
                                                                                    "text": "As a boring adult, gifting her a flower pot is the least I can do. Hope that would show my support and encourage her."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731090317",
                                                            "text": "Dreams are never good or bad."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090310",
                                            "text": "Here, your \"Dream Box.\""
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090304",
                            "text": "You got one, too?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310904",
            "objective": "Collect Sumeru Rose Seeds",
            "dialogues": []
        },
        {
            "id": "7310905",
            "objective": "Talk to Ami",
            "dialogues": [
                {
                    "id": "731090501",
                    "speaker": "Ami",
                    "text": "Is this... for me?"
                },
                {
                    "id": "731090502",
                    "speaker": "Ami",
                    "text": "I wasn't serious about the box or the paper! So it's alright, you don't need to apologize!"
                },
                {
                    "id": "731090503",
                    "speaker": "Javi",
                    "text": "Don't worry, this flower pot has no use for me anyway. Please take it."
                },
                {
                    "id": "731090504",
                    "speaker": "Javi",
                    "text": "I've asked someone to find some seeds. They should arrive at any minute...",
                    "choices": [
                        {
                            "id": "731090505",
                            "text": "Seeds are coming!",
                            "response": [
                                {
                                    "id": "731090507",
                                    "speaker": "Javi",
                                    "text": "Huh? When did you arrive? I didn't even notice..."
                                },
                                {
                                    "id": "731090508",
                                    "speaker": "Javi",
                                    "text": "Ahem... Ami, you wanted to be a florist, right? You can start with planting these."
                                },
                                {
                                    "id": "731090509",
                                    "speaker": "Ami",
                                    "text": "Thanks... But if I do that beside my dad's shop, bugs might get into the pot..."
                                },
                                {
                                    "id": "731090510",
                                    "speaker": "Ami",
                                    "text": "That would be a pity, for the bugs in the pot, and the grown-ups having bugs in their food."
                                },
                                {
                                    "id": "731090511",
                                    "speaker": "Ami",
                                    "text": "But if I move the flowers further, I might forget about them. That's also a pity, for the dying flowers..."
                                },
                                {
                                    "id": "731090512",
                                    "speaker": "Ami",
                                    "text": "Besides, dad is always busy, and he never lets me go far..."
                                },
                                {
                                    "id": "731090513",
                                    "speaker": "Javi",
                                    "text": "Um... We can take care of it together, if you want. How about that?"
                                },
                                {
                                    "id": "731090514",
                                    "speaker": "Javi",
                                    "text": "Although I could only visit after work, I do have some free time."
                                },
                                {
                                    "id": "731090515",
                                    "speaker": "Ami",
                                    "text": "Great! But dad might say no..."
                                },
                                {
                                    "id": "731090516",
                                    "speaker": "Javi",
                                    "text": "Mr. Jahangir and I are basically friends. He should agree if we talk to him together."
                                },
                                {
                                    "id": "731090517",
                                    "speaker": "Ami",
                                    "text": "Okay! I... I want more flowers, then! Sumeru Rose is my favorite! Someday... I'll surround my dad's shop with Sumeru Roses!"
                                },
                                {
                                    "id": "731090518",
                                    "speaker": "Javi",
                                    "text": "Good, that's a beautiful dream, little girl. Let's do our best for that!",
                                    "choices": [
                                        {
                                            "id": "731090519",
                                            "text": "Please save one for me.",
                                            "response": [
                                                {
                                                    "id": "731090521",
                                                    "speaker": "Ami",
                                                    "text": "Thank you! Lemme think... I want a Sweet Flower, too, and what else..."
                                                },
                                                {
                                                    "id": "731090522",
                                                    "speaker": "Javi",
                                                    "text": "So the kid is really into flowers. Hope she could stick to that dream..."
                                                },
                                                {
                                                    "id": "731090523",
                                                    "speaker": "Javi",
                                                    "text": "Hehe... Hope she won't grow up like me, a common and boring guy."
                                                },
                                                {
                                                    "id": "731090524",
                                                    "speaker": "Javi",
                                                    "text": "Ahem! Thanks for your help, Traveler. Please take this as compensation for your trouble.",
                                                    "choices": [
                                                        {
                                                            "id": "731090525",
                                                            "text": "Living with all your heart is more than common.",
                                                            "response": [
                                                                {
                                                                    "id": "731090527",
                                                                    "speaker": "Javi",
                                                                    "text": "Thanks. I'm not complaining, though."
                                                                },
                                                                {
                                                                    "id": "731090528",
                                                                    "speaker": "Javi",
                                                                    "text": "I was just... having some thoughts after seeing the \"dream\" I've buried."
                                                                },
                                                                {
                                                                    "id": "731090529",
                                                                    "speaker": "Javi",
                                                                    "text": "Alright, I should leave now. Thanks for your help today, Traveler."
                                                                },
                                                                {
                                                                    "id": "731090530",
                                                                    "speaker": "Javi",
                                                                    "text": "Maybe I should... write down another \"dream\" and bury it back there..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731090526",
                                                            "text": "Living with all your heart is never boring."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731090520",
                                            "text": "You can do it!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731090506",
                            "text": "Here, the flower seeds."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310930",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731093001",
                    "speaker": "Javi",
                    "text": "Nothing here either..."
                },
                {
                    "id": "731093002",
                    "speaker": "Javi",
                    "text": "*sigh* Come on, the box can't have grown legs..."
                }
            ]
        },
        {
            "id": "7310999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731099901",
                    "speaker": "Paimon",
                    "text": "Nothing here... Let's check the next tree."
                },
                {
                    "id": "731099902",
                    "speaker": "Paimon",
                    "text": "No, nothing. Maybe someone has taken it..."
                },
                {
                    "id": "731099903",
                    "speaker": "Paimon",
                    "text": "Huh? There's actually a box here. Let's bring it back to him."
                }
            ]
        }
    ]
}