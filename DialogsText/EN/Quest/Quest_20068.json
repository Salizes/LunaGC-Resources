{
    "quest": {
        "id": "20068",
        "title": "Sorry, Timmie!",
        "description": "Timmie seems to have a bone to pick with you over some matter. Perhaps Sister Grace might know a way to help resolve things between you two...",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 58,
        "total_speaker_counts": {
            "Grace": 29,
            "Player": 14,
            "Timmie": 15
        }
    },
    "talks": [
        {
            "id": "2006801",
            "objective": "Talk to Grace",
            "dialogues": [
                {
                    "id": "200680101",
                    "speaker": "Grace",
                    "text": "Ah, whatever shall I do..."
                },
                {
                    "id": "200680102",
                    "speaker": "Player",
                    "text": "Um, what happened?"
                },
                {
                    "id": "200680103",
                    "speaker": "Grace",
                    "text": "Oh, it's you. You've come at just the right moment. Timmie's told me what you did to the ducks."
                },
                {
                    "id": "200680104",
                    "speaker": "Grace",
                    "text": "You... you... How should I say this? It's not as if I haven't heard of your deeds..."
                },
                {
                    "id": "200680105",
                    "speaker": "Grace",
                    "text": "But did you really have to use your courage and strength in that way?",
                    "choices": [
                        {
                            "id": "200680106",
                            "text": "I was too hungry...",
                            "response": [
                                {
                                    "id": "200680109",
                                    "speaker": "Grace",
                                    "text": "If you really were hungry, you could have done some honest work."
                                },
                                {
                                    "id": "200680110",
                                    "speaker": "Grace",
                                    "text": "With your capabilities, you'd definitely have a place at the Adventurers' Guild."
                                },
                                {
                                    "id": "200680113",
                                    "speaker": "Grace",
                                    "text": "Ah, it's all water under the bridge at this point. But Timmie's been quite down because of this."
                                },
                                {
                                    "id": "200680114",
                                    "speaker": "Grace",
                                    "text": "I... Timmie's father once taught me how to make a certain dish. Mondstadt Hash Brown with Philanemo Mushrooms is Timmie's favorite."
                                },
                                {
                                    "id": "200680115",
                                    "speaker": "Grace",
                                    "text": "Why don't you help me find three Philanemo Mushrooms, so we can make some for Timmie? That should perk him up a bit, and also serve by way of apology.",
                                    "choices": [
                                        {
                                            "id": "200680116",
                                            "text": "Leave it to me.",
                                            "response": [
                                                {
                                                    "id": "200680118",
                                                    "speaker": "Grace",
                                                    "text": "Well then, off you go."
                                                },
                                                {
                                                    "id": "200680120",
                                                    "speaker": "Grace",
                                                    "text": "As for the Philanemo Mushrooms... I remember that you can find some under the eaves of the houses in the southern part of the city."
                                                },
                                                {
                                                    "id": "200680121",
                                                    "speaker": "Grace",
                                                    "text": "Please come back soon!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200680117",
                                            "text": "It shall be done!",
                                            "response": [
                                                {
                                                    "id": "200680119",
                                                    "speaker": "Grace",
                                                    "text": "Just three is enough! What are you planning to do with this many mushrooms? Are you going to bribe Timmie with a meal every time you annoy him?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200680107",
                            "text": "It was an accident, really!",
                            "response": [
                                {
                                    "id": "200680111",
                                    "speaker": "Grace",
                                    "text": "You accidentally hit those ducks and pigeons? Did you accidentally defeat the tough enemies you've encountered on your adventures too?"
                                }
                            ]
                        },
                        {
                            "id": "200680108",
                            "text": "Strength comes from daily practice such as this.",
                            "response": [
                                {
                                    "id": "200680112",
                                    "speaker": "Grace",
                                    "text": "You... I... Forget it. Looks like your \"strength\" really is all-rounded."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006802",
            "objective": "Bring 3 Philanemo Mushrooms to Grace",
            "dialogues": [
                {
                    "id": "200680201",
                    "speaker": "Grace",
                    "text": "Did you find any Philanemo Mushrooms? I believe that you should be able to find some under the eaves of the city's houses..."
                }
            ]
        },
        {
            "id": "2006804",
            "objective": "Wait for Grace to finish making Mondstadt Hash Brown",
            "dialogues": [
                {
                    "id": "200680401",
                    "speaker": "Grace",
                    "text": "Thank you, these should be enough. Please wait a moment..."
                },
                {
                    "id": "200680402",
                    "speaker": "Grace",
                    "text": "This should be fine. Please give this Mondstadt Hash Brown to Timmie."
                },
                {
                    "id": "200680403",
                    "speaker": "Grace",
                    "text": "And please, don't... do such things in the future. It's not worth the trouble."
                },
                {
                    "id": "200680404",
                    "speaker": "Grace",
                    "text": "Please listen to my advice. Don't disappoint Timmie... or me."
                },
                {
                    "id": "200680405",
                    "speaker": "Grace",
                    "text": "Well, if only everyone listened to advice. If that were the case, Sister Victoria wouldn't be so busy."
                }
            ]
        },
        {
            "id": "2006803",
            "objective": "Talk to Timmie",
            "dialogues": [
                {
                    "id": "200680301",
                    "speaker": "Timmie",
                    "text": "...Eat, eat. Eat and go, quickly...",
                    "choices": [
                        {
                            "id": "200680302",
                            "text": "What's up?",
                            "response": [
                                {
                                    "id": "200680305",
                                    "speaker": "Timmie",
                                    "text": "You again!"
                                },
                                {
                                    "id": "200680308",
                                    "speaker": "Timmie",
                                    "text": "What are you planning? Are you trying to hurt the ducks and the pigeons?",
                                    "choices": [
                                        {
                                            "id": "200680309",
                                            "text": "This hash brown is for you.",
                                            "response": [
                                                {
                                                    "id": "200680311",
                                                    "speaker": "Timmie",
                                                    "text": "A hash brown? Huh. How did you know how to make this?"
                                                },
                                                {
                                                    "id": "200680312",
                                                    "speaker": "Timmie",
                                                    "text": "I know, you must have asked Mommy!"
                                                },
                                                {
                                                    "id": "200680313",
                                                    "speaker": "Timmie",
                                                    "text": "Hmph. Are you trying to bribe me, just like that? I know what you've done to the birds!"
                                                },
                                                {
                                                    "id": "200680314",
                                                    "speaker": "Timmie",
                                                    "text": "...Still, since Mommy's sent you over with the hash brown, I guess that's her way of telling me to stop making trouble."
                                                },
                                                {
                                                    "id": "200680315",
                                                    "speaker": "Timmie",
                                                    "text": "She still needs to take care of Nora and Glory. It would be immature of me to make things harder for her."
                                                },
                                                {
                                                    "id": "200680316",
                                                    "speaker": "Timmie",
                                                    "text": "But let's be clear, I haven't forgiven you! I just don't wanna make trouble for Mommy. Got it?"
                                                },
                                                {
                                                    "id": "200680317",
                                                    "speaker": "Timmie",
                                                    "text": "Still... Hmph. I bet that because I'm a kid, you're just going to forget your promise whenever you feel like it."
                                                },
                                                {
                                                    "id": "200680318",
                                                    "speaker": "Timmie",
                                                    "text": "Once Daddy is back, I'm telling him all about you!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200680310",
                                            "text": "Please take this hash brown!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200680303",
                            "text": "Hey, Timmie...",
                            "response": [
                                {
                                    "id": "200680306",
                                    "speaker": "Timmie",
                                    "text": "You again? Leave me alone!"
                                }
                            ]
                        },
                        {
                            "id": "200680304",
                            "text": "Has something happened?",
                            "response": [
                                {
                                    "id": "200680307",
                                    "speaker": "Timmie",
                                    "text": "How can you even ask me that?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200680501",
                    "speaker": "Grace",
                    "text": "Please give that hash brown to Timmie.",
                    "choices": [
                        {
                            "id": "200680502",
                            "text": "This \"Mommy\" Timmie talks about...",
                            "response": [
                                {
                                    "id": "200680503",
                                    "speaker": "Grace",
                                    "text": "It's me. I've been taking care of the children who need care for a while now."
                                },
                                {
                                    "id": "200680504",
                                    "speaker": "Grace",
                                    "text": "Timmie's the one I've looked after longest. He's even come to call me Mommy."
                                },
                                {
                                    "id": "200680505",
                                    "speaker": "Grace",
                                    "text": "But in truth, I'm not his real family."
                                }
                            ]
                        },
                        {
                            "id": "200680506",
                            "text": "Why's Timmie so mad?",
                            "response": [
                                {
                                    "id": "200680507",
                                    "speaker": "Grace",
                                    "text": "How can you even ask such a thing?"
                                },
                                {
                                    "id": "200680508",
                                    "speaker": "Grace",
                                    "text": "That child hasn't got many friends or people he's close to in this city. So other than Nora and Glory, he only has the small animals to keep him company."
                                },
                                {
                                    "id": "200680509",
                                    "speaker": "Grace",
                                    "text": "In fact, those pigeons even..."
                                },
                                {
                                    "id": "200680510",
                                    "speaker": "Grace",
                                    "text": "...No, never mind. Please give the hash brown to Timmie as soon as you can."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200680601",
                    "speaker": "Timmie",
                    "text": "...Why isn't he back yet..."
                },
                {
                    "id": "200680602",
                    "speaker": "Player",
                    "text": "Hey, Timmie..."
                },
                {
                    "id": "200680603",
                    "speaker": "Timmie",
                    "text": "Why are you back again!? Go away! The pigeons and the ducks... You're scaring them off!"
                }
            ]
        }
    ]
}