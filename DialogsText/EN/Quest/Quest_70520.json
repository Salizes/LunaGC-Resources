        }
    },
    "talks": [
        {
            "id": "7052001",
            "objective": "Go back to the shop and check how the charity event is going",
            "dialogues": [
                {
                    "id": "705200101",
                    "speaker": "Bernhard",
                    "text": "Honorary Knight, Paimon! Good news! We have some new helpers!"
                },
                {
                    "id": "705200102",
                    "speaker": "Bernhard",
                    "text": "These two store owners heard about our charity sale. They want to donate their earnings and join us."
                },
                {
                    "id": "705200103",
                    "speaker": "Paimon",
                    "text": "What? A donation? Are you sure?"
                },
                {
                    "id": "705200104",
                    "speaker": "Mats",
                    "text": "Absolutely!"
                },
                {
                    "id": "705200105",
                    "speaker": "Mats",
                    "text": "Each extra donation means one extra person getting the help they need. Both Pauline and I think that's more important than us making more money than we technically need."
                },
                {
                    "id": "705200106",
                    "speaker": "Pauline",
                    "text": "This year's Weinlesefest is busier than previous years, so we met our target earnings more quickly than we expected. That's enough for us."
                },
                {
                    "id": "705200107",
                    "speaker": "Pauline",
                    "text": "It doesn't seem right to leave the important task of caring for our most vulnerable to you alone. We just want to help however we can. Please, it's the least we can do."
                },
                {
                    "id": "705200108",
                    "speaker": "Player",
                    "text": "We are extremely grateful."
                },
                {
                    "id": "705200109",
                    "speaker": "Paimon",
                    "text": "Yeah! Ahh, this is the warmest, fuzziest feeling ever..."
                },
                {
                    "id": "705200110",
                    "speaker": "Paimon",
                    "text": "Hmm, but this does mean that we'll have to change the name of our shop! Uhh, how about... Favonian Goodies and Buddies.",
                    "choices": [
                        {
                            "id": "705200111",
                            "text": "Adding words... one way to make a big name for ourselves.",
                            "response": [
                                {
                                    "id": "705200113",
                                    "speaker": "Paimon",
                                    "text": "Alright, let's give this all we've got and make this a charity event to remember!"
                                },
                                {
                                    "id": "705200114",
                                    "speaker": "Black Screen",
                                    "text": "With two new staff, the scale of the charity sale grows..."
                                },
                                {
                                    "id": "705200115",
                                    "speaker": "Paimon",
                                    "text": "Over here for snacks, fresh flowers, and general goods! Folks, grab bargains at Favonian Goodies and Buddies!"
                                },
                                {
                                    "id": "705200116",
                                    "speaker": "Paimon",
                                    "text": "Huh? Hey, look, it's Albedo!"
                                },
                                {
                                    "id": "705200117",
                                    "speaker": "Albedo",
                                    "text": "Hello there.",
                                    "choices": [
                                        {
                                            "id": "705200118",
                                            "text": "Welcome to our store!",
                                            "response": [
                                                {
                                                    "id": "705200120",
                                                    "speaker": "Paimon",
                                                    "text": "Looking to buy anything in particular, Albedo?"
                                                },
                                                {
                                                    "id": "705200121",
                                                    "speaker": "Albedo",
                                                    "text": "I'm not in dire need of anything right now. I just heard that you were running the Knights of Favonius' stall, and thought I'd come over."
                                                },
                                                {
                                                    "id": "705200122",
                                                    "speaker": "Albedo",
                                                    "text": "As it happens, Timaeus and I made some progress in our research recently, so I took the opportunity to bring you a batch of our finished product. Consider it our contribution to the charity effort."
                                                },
                                                {
                                                    "id": "705200123",
                                                    "speaker": "Paimon",
                                                    "text": "Aw, so you came all the way here just to help us out? That's so nice of you!"
                                                },
                                                {
                                                    "id": "705200124",
                                                    "speaker": "Paimon",
                                                    "text": "Let's take a look here, we got bottles of... wait, what is this stuff?"
                                                },
                                                {
                                                    "id": "705200125",
                                                    "speaker": "Albedo",
                                                    "text": "It's an Extra-Strong Sobriety Potion that can sober up the intoxicated and alleviate hangovers."
                                                },
                                                {
                                                    "id": "705200126",
                                                    "speaker": "Albedo",
                                                    "text": "Please hand them out for free to anyone who needs them. Having some complimentary items will undoubtedly help you attract more customers."
                                                },
                                                {
                                                    "id": "705200127",
                                                    "speaker": "Paimon",
                                                    "text": "Sounds like a super-useful invention! It must have taken you ages..."
                                                },
                                                {
                                                    "id": "705200128",
                                                    "speaker": "Albedo",
                                                    "text": "Oh? It must have been a while since I demonstrated my capabilities to you."
                                                },
                                                {
                                                    "id": "705200129",
                                                    "speaker": "Albedo",
                                                    "text": "I most likely wouldn't have had any interest in research like this in the past."
                                                },
                                                {
                                                    "id": "705200130",
                                                    "speaker": "Albedo",
                                                    "text": "But now I think that it's worthwhile using alchemy to make people's lives easier in small ways like this."
                                                },
                                                {
                                                    "id": "705200131",
                                                    "speaker": "Paimon",
                                                    "text": "Definitely! Well, Paimon assumes so, 'cause Paimon's never been drunk before... but plenty of our customers probably have been."
                                                },
                                                {
                                                    "id": "705200132",
                                                    "speaker": "Paimon",
                                                    "text": "It would definitely ruin the mood if someone fell into the lake or tripped over a rock after having one too many glasses of festive cheer."
                                                },
                                                {
                                                    "id": "705200133",
                                                    "speaker": "Player",
                                                    "text": "We can't take all this and give nothing in return."
                                                },
                                                {
                                                    "id": "705200134",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah, Albedo, you should take some snacks back with you and share them with Klee. It's on the house!"
                                                },
                                                {
                                                    "id": "705200135",
                                                    "speaker": "Albedo",
                                                    "text": "Alright then, I shan't refuse."
                                                },
                                                {
                                                    "id": "705200136",
                                                    "speaker": "Albedo",
                                                    "text": "I had no idea you two had such keen business sense."
                                                },
                                                {
                                                    "id": "705200137",
                                                    "speaker": "Albedo",
                                                    "text": "It's a savvy choice of location for selling snacks. There's a festive mood all around, and the division of labor is eminently sensible."
                                                },
                                                {
                                                    "id": "705200138",
                                                    "speaker": "Albedo",
                                                    "text": "If any other knight of Favonius were running the show, it would be a much more... generic operation."
                                                },
                                                {
                                                    "id": "705200139",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, getting complimented by Albedo is an amazing feeling... This must be how it feels to drink an Extra-Strong Sobriety Potion when you wake up with a groggy head!"
                                                },
                                                {
                                                    "id": "705200140",
                                                    "speaker": "Paimon",
                                                    "text": "Anyway... it sounds like you know quite a lot about running a charity sale yourself, Albedo!"
                                                },
                                                {
                                                    "id": "705200141",
                                                    "speaker": "Albedo",
                                                    "text": "Well, I provided a dozen or so landscape paintings for a previous charity event, also run by the Knights of Favonius."
                                                },
                                                {
                                                    "id": "705200142",
                                                    "speaker": "Paimon",
                                                    "text": "They must have been worth a fortune!"
                                                },
                                                {
                                                    "id": "705200143",
                                                    "speaker": "Albedo",
                                                    "text": "Well, the people buying them certainly thought so."
                                                },
                                                {
                                                    "id": "705200144",
                                                    "speaker": "Albedo",
                                                    "text": "Some felt that my painting style was a rare one worth investing in, and offered a large sum of money for each work."
                                                },
                                                {
                                                    "id": "705200145",
                                                    "speaker": "Albedo",
                                                    "text": "This, plus the sizable profits made from auctioning some of my still life paintings, seemed to give Alice an idea."
                                                },
                                                {
                                                    "id": "705200146",
                                                    "speaker": "Albedo",
                                                    "text": "She used her personal connections to apply for some sort of certification for my artwork... I believe they call it \"copyright\"?"
                                                },
                                                {
                                                    "id": "705200147",
                                                    "speaker": "Albedo",
                                                    "text": "Later, many artists began to imitate my landscape paintings, and they became a common sight throughout Mondstadt.",
                                                    "choices": [
                                                        {
                                                            "id": "705200148",
                                                            "text": "That sounds familiar...",
                                                            "response": [
                                                                {
                                                                    "id": "705200150",
                                                                    "speaker": "Albedo",
                                                                    "text": "According to the rules of the copyright that Alice applied for, the artists need to pay me a portion of their revenue for each landscape painting of this style that they sell."
                                                                },
                                                                {
                                                                    "id": "705200151",
                                                                    "speaker": "Albedo",
                                                                    "text": "Wealth was never one of my goals. I don't care where the money goes, so I entrusted it to the Knights of Favonius and let them manage it."
                                                                },
                                                                {
                                                                    "id": "705200152",
                                                                    "speaker": "Albedo",
                                                                    "text": "I suppose it would be fitting to use it to pay for the destruction that Alice has created."
                                                                },
                                                                {
                                                                    "id": "705200153",
                                                                    "speaker": "Albedo",
                                                                    "text": "But from what I hear, they use it all on charitable initiatives, which is also a noble cause.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705200154",
                                                                            "text": "So you've never participated in a charity sale...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705200156",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "You never cease to amaze, Albedo..."
                                                                                },
                                                                                {
                                                                                    "id": "705200157",
                                                                                    "speaker": "Albedo",
                                                                                    "text": "Though it was hardly my original intention, I have come to embrace my unexpected philanthropic achievements.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705200158",
                                                                                            "text": "Good for you.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705200159",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "#Thank you, {NICKNAME}."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200162",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "Well then, I will be returning to the workshop. I wish you and the shop all the best."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200163",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Thanks for your contribution, and good luck with your research!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200164",
                                                                                                    "speaker": "Black Screen",
                                                                                                    "text": "You make some snacks for Albedo to take back with him..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705200165",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Come again when you're free!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705200160",
                                                                                            "text": "I want to learn to paint.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705200161",
                                                                                                    "speaker": "Albedo",
                                                                                                    "text": "And I am only too happy to share my expertise with you, however... practice is the most essential factor."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705200155",
                                                                            "text": "Yet you've done more for charity than any of us..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705200149",
                                                            "text": "So it all came from you..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705200119",
                                            "text": "It's been a while."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705200112",
                            "text": "Sounds good to me."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705200201",
                    "speaker": "Bernhard",
                    "text": "Honorary Knight, Paimon, two shop owners wish to join up with us. The scale of our charity sale is expanding!"
                },
                {
                    "id": "705200202",
                    "speaker": "Black Screen",
                    "text": "You meet the two shop owners who have joined up..."
                },
                {
                    "id": "705200203",
                    "speaker": "Bernhard",
                    "text": "Now, if I might trouble you two again, please direct our three shops and continue this charity sale!"
                }
            ]
        }
    ]
}