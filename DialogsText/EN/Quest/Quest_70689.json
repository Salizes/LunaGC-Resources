{
    "quest": {
        "id": "70689",
        "title": "The Many Matters Learned in One's Travels",
        "description": "Katheryne of the Adventurers' Guild seems to be looking for you...",
        "rewards": [
            {
                "itemId": 220124,
                "count": 1
            }
        ],
        "rewards_formatted": "Travel Accounts x1",
        "chapter": {
            "icon": "",
