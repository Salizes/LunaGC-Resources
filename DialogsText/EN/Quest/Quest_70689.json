    },
    "talks": [
        {
            "id": "7068901",
            "objective": "Talk to Katheryne",
            "dialogues": [
                {
                    "id": "706890114",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>Any news?</color>"
                },
                {
                    "id": "706890101",
                    "speaker": "Katheryne",
                    "text": "#Ah, {NICKNAME}, you've come at just the right time — I have something for you.",
                    "choices": [
                        {
                            "id": "706890102",
                            "text": "A letter for help? Or a clue to some treasure?",
                            "response": [
                                {
                                    "id": "706890104",
                                    "speaker": "Katheryne",
                                    "text": "...You're certainly very familiar with the kind of work we do, but I'm afraid this has nothing to do with any of the above commissions."
                                },
                                {
                                    "id": "706890105",
                                    "speaker": "Katheryne",
                                    "text": "Please, take this brand-new Adventurers' Guild notebook.",
                                    "choices": [
                                        {
                                            "id": "706890106",
                                            "text": "But I already have the Adventurer Handbook...",
                                            "response": [
                                                {
                                                    "id": "706890108",
                                                    "speaker": "Katheryne",
                                                    "text": "The Adventurer Handbook is for recording details of your completed commissions and intel on all sorts of monsters."
                                                },
                                                {
                                                    "id": "706890109",
                                                    "speaker": "Katheryne",
                                                    "text": "Whereas this notebook is for recording the marvelous people and wonderful events you encounter on your travels.",
                                                    "choices": [
                                                        {
                                                            "id": "706890110",
                                                            "text": "Oh...",
                                                            "response": [
                                                                {
                                                                    "id": "706890112",
                                                                    "speaker": "Katheryne",
                                                                    "text": "I hope it will be of help to you. Anyway, that's all for now, my \"commission\" is complete."
                                                                },
                                                                {
                                                                    "id": "706890113",
                                                                    "speaker": "Katheryne",
                                                                    "text": "#Safe travels, {NICKNAME}. Ad astra abyssosque!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706890111",
                                                            "text": "That actually sounds kind of useful."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706890107",
                                            "text": "Why are you giving me a new one?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706890103",
                            "text": "An escort commission, or a search and rescue?"
                        }
                    ]
                }
            ]
        },
