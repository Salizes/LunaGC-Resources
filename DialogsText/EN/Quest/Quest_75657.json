    "talks": [
        {
            "id": "7565701",
            "objective": "",
            "dialogues": [
                {
                    "id": "756570201",
                    "speaker": "Paimon",
                    "text": "#Over here, {NICKNAME}, over here!"
                },
                {
                    "id": "756570202",
                    "speaker": "Paimon",
                    "text": "Remember this place? It's where our journey began."
                },
                {
                    "id": "756570203",
                    "speaker": "Paimon",
                    "text": "We've been to so many places since then! Time really flies, huh... Just thinking about it makes Paimon kinda emotional. Ooh, she could write a poem right now!",
                    "choices": [
                        {
                            "id": "756570204",
                            "text": "Please, go right ahead, O great bard Paimon~",
                            "response": [
                                {
                                    "id": "756570207",
                                    "speaker": "Paimon",
                                    "text": "Ah, vast Teyvat!"
                                },
                                {
                                    "id": "756570208",
                                    "speaker": "Paimon",
                                    "text": "How far have we traveled, yet not seen your full breadth!",
                                    "choices": [
                                        {
                                            "id": "756570209",
                                            "text": "(Remain silent.)",
                                            "response": [
                                                {
                                                    "id": "756570211",
                                                    "speaker": "Paimon",
                                                    "text": "Ah! Ah... Huh, and the thought's gone.",
                                                    "choices": [
                                                        {
                                                            "id": "756570212",
                                                            "text": "Hahahaha!",
                                                            "response": [
                                                                {
                                                                    "id": "756570213",
                                                                    "speaker": "Paimon",
                                                                    "text": "Yeah, yeah, laugh it up. Paimon's used to it by now."
                                                                },
                                                                {
                                                                    "id": "756570216",
                                                                    "speaker": "Paimon",
                                                                    "text": "But seriously, it's easy to forget where we started after all this traveling."
                                                                },
                                                                {
                                                                    "id": "756570217",
                                                                    "speaker": "Paimon",
                                                                    "text": "For example, Paimon can't quite remember what Sweet Madames taste like nowadays, and that was one of her favorite dishes, too..."
                                                                },
                                                                {
                                                                    "id": "756570218",
                                                                    "speaker": "Paimon",
                                                                    "text": "That's why Paimon bought this album in the first place, to take pictures of the places we've been and the people we've met."
                                                                },
                                                                {
                                                                    "id": "756570219",
                                                                    "speaker": "Paimon",
                                                                    "text": "\"The end is close once we get back to where we started.\" That happens pretty often in light novels and films, doesn't it?"
                                                                },
                                                                {
                                                                    "id": "756570220",
                                                                    "speaker": "Paimon",
                                                                    "text": "That's why we're taking a picture here. Not to feel all sad and stuff, but 'cause we hope to always remember the road we've taken, all the better to tread the road ahead...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756570221",
                                                                            "text": "Have you been eavesdropping on my conversations with Kazuha?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756570224",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "C'mon, we were trying to create an atmosphere here — and now it's all gone."
                                                                                },
                                                                                {
                                                                                    "id": "756570225",
                                                                                    "speaker": "Player",
                                                                                    "text": "Don't worry, I understand what you mean."
                                                                                },
                                                                                {
                                                                                    "id": "756570226",
                                                                                    "speaker": "Player",
                                                                                    "text": "We'll forge ahead."
                                                                                },
                                                                                {
                                                                                    "id": "756570227",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hehe, sure, as long as you get it."
                                                                                },
                                                                                {
                                                                                    "id": "756570228",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Alright! Your model for this picture is going to be Teyvat's number one guide! So, what pose would you like to go for?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756570229",
                                                                                            "text": "Let's go with a fun pose!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756570232",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Yup yup! How's this?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "756570233",
                                                                                                            "text": "Perfect. Say cheese!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570234",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Paimon's ready!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "756570239",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "The fun pose might work better."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "756570240",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Alrighty then!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756570235",
                                                                                                            "text": "Let's roll with the natural pose instead.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570236",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "No problem!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756570237",
                                                                                                            "text": "Let's go with a casual posture instead.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756570238",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Sure!"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756570230",
                                                                                            "text": "Let's have a natural pose."
                                                                                        },
                                                                                        {
                                                                                            "id": "756570231",
                                                                                            "text": "Just take up a casual pose."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756570222",
                                                                            "text": "What? Paimon is evolving!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756570223",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Well... Yeah, Paimon was listening when you and Kazuha were chatting."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756570214",
                                                            "text": "Do you mean to reflect on how tough this journey's been?",
                                                            "response": [
                                                                {
                                                                    "id": "756570215",
                                                                    "speaker": "Paimon",
                                                                    "text": "That's right! Hehe, you sure know Paimon well."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756570210",
                                            "text": "That didn't rhyme at all."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756570205",
                            "text": "Pfft.",
                            "response": [
                                {
                                    "id": "756570206",
                                    "speaker": "Paimon",
                                    "text": "Oh, don't interrupt. Let Paimon think..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
