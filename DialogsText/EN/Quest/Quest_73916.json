            "dialogues": [
                {
                    "id": "739160101",
                    "speaker": "Player",
                    "text": "Cherish what I have..."
                },
                {
                    "id": "739160102",
                    "speaker": "Bhai",
                    "text": "When I was young, I used to travel around with the fleet, which taught me to cherish every drop of water and every flower."
                },
                {
                    "id": "739160103",
                    "speaker": "Bhai",
                    "text": "The surging waves, the soaring seagulls, or the swaying seaweed on the shores are all testaments to life."
                },
                {
                    "id": "739160104",
                    "speaker": "Bhai",
                    "text": "You'll understand that when you get to see as much as I have. Don't follow in that old fogey's footsteps!"
                }
            ]
