        {
            "id": "7220301",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030101",
                    "speaker": "Nonno",
                    "text": "Ooh, you got me!"
                },
                {
                    "id": "722030102",
                    "speaker": "Nonno",
                    "text": "Let's play again next time!"
                }
            ]
        },
        {
            "id": "7220302",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030201",
                    "speaker": "Nonno",
                    "text": "Agh, you found me again! You're pretty good at this!"
                },
                {
                    "id": "722030202",
                    "speaker": "Nonno",
                    "text": "I won't get caught next time!"
                }
            ]
        },
        {
            "id": "7220303",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030301",
                    "speaker": "Nonno",
                    "text": "Wait, seriously? No, I just didn't hide well enough!"
                },
                {
                    "id": "722030302",
                    "speaker": "Nonno",
                    "text": "Another round! Let's go for another round!"
                }
            ]
        },
        {
            "id": "7220304",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030401",
                    "speaker": "Nonno",
                    "text": "Ah, if only everyone was as good at this as you!"
                },
                {
                    "id": "722030402",
                    "speaker": "Nonno",
                    "text": "We're good friends now, aren't we?"
                }
            ]
        },
        {
            "id": "7220305",
            "objective": "",
            "dialogues": [
                {
                    "id": "722030501",
                    "speaker": "Nonno",
                    "text": "Haha, you found me again!"
                },
                {
                    "id": "722030502",
                    "speaker": "Nonno",
                    "text": "Y'know, I'll miss you, but... I came this time to say goodbye. The golden man says we've gotta go."
                },
                {
                    "id": "722030503",
                    "speaker": "Nonno",
                    "text": "But don't worry about me! Where I'm going, there's tons of people to play with! I wish you could come too, but the golden man says that it's not time yet..."
                },
                {
                    "id": "722030504",
                    "speaker": "Nonno",
                    "text": "It's totally fine, though! Totally! I'll just wait for you there... and if I can't wait, I'll turn into little bits of light and look for you in your dreams!"
                },
                {
                    "id": "722030505",
                    "speaker": "Player",
                    "text": "Have a good trip, now."
                },
                {
                    "id": "722030506",
                    "speaker": "Nonno",
                    "text": "Yeah, I will! It was fun playing with you. Thanks a bunch!"
                },
                {
                    "id": "722030507",
                    "speaker": "Nonno",
                    "text": "I won't be alone anymore, this is great..."
                }
            ]
        },
