    "talks": [
        {
            "id": "1080501",
            "objective": "",
            "dialogues": [
                {
                    "id": "698140101",
                    "speaker": "Diona",
                    "text": "Pew-Pew~!",
                    "choices": [
                        {
                            "id": "698140102",
                            "text": "Hunting alone, Diona?",
                            "response": [
                                {
                                    "id": "698140104",
                                    "speaker": "Diona",
                                    "text": "Hmph. Hunters of the Kätzlein bloodline return successful even when they go solo."
                                },
                                {
                                    "id": "698140105",
                                    "speaker": "Player",
                                    "text": "Wouldn't shouting \"Pew-Pew\" scare the animals off?"
                                },
                                {
                                    "id": "698140106",
                                    "speaker": "Diona",
                                    "text": "N—No way! Can't you see that my arrows fly faster than the sound of my voice?"
                                },
                                {
                                    "id": "698140107",
                                    "speaker": "Player",
                                    "text": "Ah, so the \"pew-pew\" is for a cutesy, dramatic effect..."
                                },
                                {
                                    "id": "698140108",
                                    "speaker": "Diona",
                                    "text": "Hey, cut that out! I can hear you, you know! Don't underestimate Kätzlein ears!"
                                },
                                {
                                    "id": "698140109",
                                    "speaker": "Diona",
                                    "text": "Hmph. Whatever, I'm not going to argue with you. Here, have some meat. I caught more than I need, and I'd have shared it with everyone anyway if I brought it back.",
                                    "choices": [
                                        {
                                            "id": "698140110",
                                            "text": "Thanks, Diona.",
                                            "response": [
                                                {
                                                    "id": "698140112",
                                                    "speaker": "Diona",
                                                    "text": "Hehehe, you'd best remember it — and vote for me if the town ever chooses a champion. Last thing I need is for you to help give that silly old dad of mine a big head."
                                                },
                                                {
                                                    "id": "698140113",
                                                    "speaker": "Howl From Somewhere Unseen",
                                                    "text": "Reeowwr!"
                                                },
                                                {
                                                    "id": "698140114",
                                                    "speaker": "Diona",
                                                    "text": "Ahhh!",
                                                    "choices": [
                                                        {
                                                            "id": "698140115",
                                                            "text": "Huh. It seems like the Kätzlein bloodline...",
                                                            "response": [
                                                                {
                                                                    "id": "698140117",
                                                                    "speaker": "Diona",
                                                                    "text": "I—I'm not afraid of those wolves, you hear? A—Absolutely not!"
                                                                },
                                                                {
                                                                    "id": "698140118",
                                                                    "speaker": "Diona",
                                                                    "text": "It would just... be too much trouble if we were to fight, that's all! And I'm not sharing my catch with them after I worked so hard for it..."
                                                                },
                                                                {
                                                                    "id": "698140119",
                                                                    "speaker": "Diona",
                                                                    "text": "Hey, what are you standing around for? They're practically on top of us! ...Ugh, c'mon, let's just go already!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698140116",
                                                            "text": "...Faces some troubles of its own."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698140111",
                                            "text": "You're the finest hunter in Springvale."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698140103",
                            "text": "Would you like some help?"
                        }
                    ]
                }
            ]
        }
    ]
