    "talks": [
        {
            "id": "1080401",
            "objective": "",
            "dialogues": [
                {
                    "id": "698090101",
                    "speaker": "Amber",
                    "text": "Phew! That's another lost adventurer escorted... Are the paths around here really that bad?",
                    "choices": [
                        {
                            "id": "698090102",
                            "text": "Absolutely awful.",
                            "response": [
                                {
                                    "id": "698090104",
                                    "speaker": "Amber",
                                    "text": "Hmm? Oh, don't you worry! I'm the Knights of Favonius's..."
                                },
                                {
                                    "id": "698090105",
                                    "speaker": "Player",
                                    "text": "No. 1 Outrider."
                                },
                                {
                                    "id": "698090106",
                                    "speaker": "Amber",
                                    "text": "I never thought I'd meet you here! Are you back in Mondstadt for a visit?"
                                },
                                {
                                    "id": "698090107",
                                    "speaker": "Amber",
                                    "text": "You've got great timing. Sara just came up with a brand new dish, and she's looking for people to give it a taste."
                                },
                                {
                                    "id": "698090108",
                                    "speaker": "Amber",
                                    "text": "Kaeya and Jean should be back at headquarters, and so is Klee..."
                                },
                                {
                                    "id": "698090109",
                                    "speaker": "Amber",
                                    "text": "Oh, whoops. Am I talking too much? Not holding you up, am I?",
                                    "choices": [
                                        {
                                            "id": "698090110",
                                            "text": "No, no, not at all.",
                                            "response": [
                                                {
                                                    "id": "698090112",
                                                    "speaker": "Amber",
                                                    "text": "As long as I'm not getting in your way. Oh, here, take this! You haven't had any of my cooking in a while, right? I just made it, so eat it while it's hot!"
                                                },
                                                {
                                                    "id": "698090113",
                                                    "speaker": "Amber",
                                                    "text": "Though I'd love to talk with you some more, lots of adventurers have been getting lost in these woods recently."
                                                },
                                                {
                                                    "id": "698090114",
                                                    "speaker": "Amber",
                                                    "text": "In order to escort them all into the city, I've been doing lots of extra patrols these past few days. Any more and I won't be able to keep up..."
                                                },
                                                {
                                                    "id": "698090115",
                                                    "speaker": "Player",
                                                    "text": "With you here, they're in safe hands."
                                                },
                                                {
                                                    "id": "698090116",
                                                    "speaker": "Amber",
                                                    "text": "That's for sure! Okay, I've gotta run now. If there's anything you need, just come find me at headquarters!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698090111",
                                            "text": "Don't worry, Amber. It's fine."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698090103",
                            "text": "Sorry, I'm lost."
                        }
                    ]
                }
            ]
        }
    ]
}