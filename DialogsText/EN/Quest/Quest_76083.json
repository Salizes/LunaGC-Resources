                                {
                                    "id": "760830404",
                                    "speaker": "Kuuhenki",
                                    "text": "!!!"
                                },
                                {
                                    "id": "760830405",
                                    "speaker": "Paimon",
                                    "text": "Hmph, that was way too obvious!"
                                },
                                {
                                    "id": "760830406",
                                    "speaker": "The Damselette",
                                    "text": "I'm afraid this riddle was a little too simple for us."
                                }
                            ]
                        },
                        {
                            "id": "760830407",
                            "text": "Unagi.",
                            "response": [
                                {
                                    "id": "760830408",
