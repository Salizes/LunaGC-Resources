    "talks": [
        {
            "id": "2050301",
            "objective": "",
            "dialogues": [
                {
                    "id": "205030101",
                    "speaker": "Paimon",
                    "text": "From now on, the adventures will probably get more and more dangerous. We should make sure we're prepared."
                }
            ]
        },
        {
            "id": "2050302",
            "objective": "Talk to Wagner the blacksmith",
            "dialogues": [
                {
                    "id": "205030201",
                    "speaker": "Wagner",
                    "text": "What?",
                    "choices": [
                        {
                            "id": "205030202",
                            "text": "I'm looking for a weapon.",
                            "response": [
                                {
                                    "id": "205030203",
                                    "speaker": "Wagner",
                                    "text": "Over there. Take your pick. Or, if you need something else I can make it on request."
                                },
                                {
                                    "id": "205030207",
                                    "speaker": "Paimon",
                                    "text": "Wow, he does bespoke weaponry..."
                                },
                                {
                                    "id": "205030208",
                                    "speaker": "Wagner",
                                    "text": "Of course. I sell weapons, make them to order, and do refinements. All in the job description for a blacksmith."
                                },
                                {
                                    "id": "205030209",
                                    "speaker": "Wagner",
                                    "text": "All you need is the ore.",
                                    "choices": [
                                        {
                                            "id": "205030210",
                                            "text": "Where can I get ore from?",
                                            "response": [
                                                {
                                                    "id": "205030211",
                                                    "speaker": "Wagner",
                                                    "text": "Anywhere. Everywhere."
                                                },
                                                {
                                                    "id": "205030214",
                                                    "speaker": "Wagner",
                                                    "text": "You look confused. Listen, I'll tell you where the nearest deposits are."
                                                },
                                                {
                                                    "id": "205030215",
                                                    "speaker": "Wagner",
                                                    "text": "Bring some back and I'll help you forge what you need."
                                                },
                                                {
                                                    "id": "205030216",
                                                    "speaker": "Player",
                                                    "text": "Great. Thanks!"
                                                },
                                                {
                                                    "id": "205030217",
                                                    "speaker": "Wagner",
                                                    "text": "No need. I have other things to do."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205030212",
                                            "text": "Do you sell it here?",
                                            "response": [
                                                {
                                                    "id": "205030213",
                                                    "speaker": "Wagner",
                                                    "text": "No. Buy from someone else, I barely have enough for myself."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205030204",
                            "text": "I want to find a weapon for Paimon.",
                            "response": [
                                {
                                    "id": "205030205",
                                    "speaker": "Paimon",
                                    "text": "This is the first Paimon's heard about it! What, so you want Paimon on the front line now!?"
                                },
                                {
                                    "id": "205030206",
                                    "speaker": "Wagner",
                                    "text": "She's a tiny one isn't she. It'd need to be purpose-built."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050303",
            "objective": "",
            "dialogues": [
                {
                    "id": "205030301",
                    "speaker": "Paimon",
                    "text": "There's the blacksmith!"
                }
            ]
        },
        {
            "id": "2050304",
            "objective": "Collect three Iron Chunks and give them to Wagner",
            "dialogues": [
                {
                    "id": "205030401",
                    "speaker": "Paimon",
                    "text": "He seems like a short-tempered guy... Was it something we said?"
                }
            ]
        },
        {
            "id": "2050305",
            "objective": "Talk to Wagner the blacksmith",
            "dialogues": [
                {
                    "id": "205030501",
                    "speaker": "Wagner",
                    "text": "What do you want?",
                    "choices": [
                        {
                            "id": "205030502",
                            "text": "I've got the Iron Chunks.",
                            "response": [
                                {
                                    "id": "205030504",
                                    "speaker": "Wagner",
                                    "text": "Oh. Yes. I'd forgotten about that."
                                },
                                {
                                    "id": "205030505",
                                    "speaker": "Wagner",
                                    "text": "These are okay I guess. Should be able to salvage something from them."
                                },
                                {
                                    "id": "205030506",
                                    "speaker": "Wagner",
                                    "text": "I'd like something made"
                                }
                            ]
                        },
                        {
                            "id": "205030503",
                            "text": "Remember, you sent me to get Iron Chunks..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050306",
            "objective": "",
            "dialogues": [
                {
                    "id": "205030601",
                    "speaker": "Wagner",
                    "text": "If you ever find ore in the future, you can always come and see me."
                },
                {
                    "id": "205030602",
                    "speaker": "Wagner",
                    "text": "Ideally when I'm not busy."
                },
                {
                    "id": "205030603",
                    "speaker": "Player",
                    "text": "You seem to be in a bad mood."
                },
                {
                    "id": "205030604",
                    "speaker": "Wagner",
                    "text": "A blacksmith's work takes focus and concentration. It does not take small talk with customers."
                },
                {
                    "id": "205030605",
                    "speaker": "Wagner",
                    "text": "When the craft is good, business is good. That's all there is to this trade, and anyone who tells you different is trying to con you."
                },
                {
                    "id": "205030606",
                    "speaker": "Wagner",
                    "text": "If there's nothing else, I'll carry on with my work."
                }
            ]
        }
    ]
}