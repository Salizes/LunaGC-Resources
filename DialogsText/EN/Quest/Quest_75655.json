    "talks": [
        {
            "id": "7565501",
            "objective": "",
            "dialogues": [
                {
                    "id": "756550201",
                    "speaker": "Collei",
                    "text": "#Huh? Oh, it's you, {NICKNAME}! What's the plan today?",
                    "choices": [
                        {
                            "id": "756550202",
                            "text": "We're here to take some pictures of Sumeru City.",
                            "response": [
                                {
                                    "id": "756550204",
                                    "speaker": "Collei",
                                    "text": "Ah, photography! True, Akademiya researchers often come here to snap a few shots of the city."
                                },
                                {
                                    "id": "756550205",
                                    "speaker": "Collei",
                                    "text": "Most who do are from Vahumana and Kshahrewar, apparently to study urban infrastructure... and um, architectural history or something like that.",
                                    "choices": [
                                        {
                                            "id": "756550206",
                                            "text": "Well, aren't you familiar with the Darshans?",
                                            "response": [
                                                {
                                                    "id": "756550207",
                                                    "speaker": "Collei",
                                                    "text": "Not... really. I just know about their research fields and how they set their courses up. I'm still a long way from being a real scholar, though."
                                                },
                                                {
                                                    "id": "756550210",
                                                    "speaker": "Collei",
                                                    "text": "But if you wanted me to take the selection exam... Heh, I doubt I'd pass even the first round of the written test."
                                                },
                                                {
                                                    "id": "756550211",
                                                    "speaker": "Collei",
                                                    "text": "I wish I could reach the level of a researcher, of course, but it's still a dream at the moment...",
                                                    "choices": [
                                                        {
                                                            "id": "756550212",
                                                            "text": "You'll make it someday.",
                                                            "response": [
                                                                {
                                                                    "id": "756550214",
                                                                    "speaker": "Collei",
                                                                    "text": "#Thanks so much, {NICKNAME}. Anyway, I'll do my best to learn the basics first!"
                                                                },
                                                                {
                                                                    "id": "756550215",
                                                                    "speaker": "Collei",
                                                                    "text": "Honestly, I'm just happy to learn something new every day."
                                                                },
                                                                {
                                                                    "id": "756550216",
                                                                    "speaker": "Collei",
                                                                    "text": "And right now, my goal is to be the best Forest Ranger I can be."
                                                                },
                                                                {
                                                                    "id": "756550217",
                                                                    "speaker": "Collei",
                                                                    "text": "Guiding those who've gotten lost in the rainforest, helping people who've accidentally ingested poison, protecting the rainforest flora and fauna..."
                                                                },
                                                                {
                                                                    "id": "756550218",
                                                                    "speaker": "Collei",
                                                                    "text": "We Forest Rangers do lots of things. Everyone needs me, and I'm more than willing to help!"
                                                                },
                                                                {
                                                                    "id": "756550219",
                                                                    "speaker": "Collei",
                                                                    "text": "I've only done a couple of little things here and there, but still, everyone recognizes my work."
                                                                },
                                                                {
                                                                    "id": "756550220",
                                                                    "speaker": "Collei",
                                                                    "text": "Guess I'm lucky to have all these people who care about me... and to have made friends with someone as amazing as you.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756550221",
                                                                            "text": "I'm glad that we're friends, Collei.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756550223",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Haha, alright. Anyway, if there's anything I can help you with, just let me know."
                                                                                },
                                                                                {
                                                                                    "id": "756550224",
                                                                                    "speaker": "Player",
                                                                                    "text": "I'd like you to help me with some photos."
                                                                                },
                                                                                {
                                                                                    "id": "756550225",
                                                                                    "speaker": "Collei",
                                                                                    "text": "I can do that! How should I pose?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756550226",
                                                                                            "text": "Let's have a natural pose.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756550228",
                                                                                                    "speaker": "Collei",
                                                                                                    "text": "Sure. How does this look?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "756550229",
                                                                                                            "text": "Perfect. Say cheese!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756550230",
                                                                                                                    "speaker": "Collei",
                                                                                                                    "text": "I'm ready."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756550231",
                                                                                                            "text": "The fun pose might work better."
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756550232",
                                                                                                            "text": "Let's go with a casual pose instead.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756550233",
                                                                                                                    "speaker": "Collei",
                                                                                                                    "text": "Sure!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "756550234",
                                                                                                            "text": "Let's roll with the natural pose instead.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "756550235",
                                                                                                                    "speaker": "Collei",
                                                                                                                    "text": "Alright."
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756550227",
                                                                                            "text": "Let's go with a fun pose!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756550222",
                                                                            "text": "We're both amazing. Don't you forget that!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756550213",
                                                            "text": "You can do it, Collei!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756550208",
                                            "text": "Take any classes in those Darshans, by any chance?",
                                            "response": [
                                                {
                                                    "id": "756550209",
                                                    "speaker": "Collei",
                                                    "text": "Well, I'm not a student yet, so I can't attend the classes, but Master has introduced some of the basics of their research to me."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756550203",
                            "text": "We're looking for people to take photos with."
                        }
