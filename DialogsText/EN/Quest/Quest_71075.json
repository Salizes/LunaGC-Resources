        {
            "id": "7107501",
            "objective": "",
            "dialogues": [
                {
                    "id": "710750101",
                    "speaker": "???",
                    "text": "Hey, you! Yes, you!"
                },
                {
                    "id": "710750102",
                    "speaker": "???",
                    "text": "Someone familiar with this place like you could find what that Erge lug couldn't, I'll bet."
                },
                {
                    "id": "710750103",
                    "speaker": "???",
                    "text": "No? Well, I'll just wait for someone who can, make 'em find it, and get it off them."
                },
                {
                    "id": "710750104",
                    "speaker": "\"The Qingce Kid\"",
                    "text": "They call me The Qingce Kid, and no measly motley of Chasm miners is going to stop me, or I'll never show my face again out there. Well then! Give me the thing."
                },
                {
                    "id": "710750105",
                    "speaker": "\"The Qingce Kid\"",
                    "text": "We'll take the Millelith's treasure, thank you very much!",
                    "choices": [
                        {
                            "id": "710750106",
                            "text": "I don't know what you're looking for...",
                            "response": [
                                {
                                    "id": "710750108",
                                    "speaker": "\"The Qingce Kid\"",
                                    "text": "And what you say goes, eh?"
                                },
                                {
                                    "id": "710750109",
                                    "speaker": "\"The Qingce Kid\"",
                                    "text": "...Hmph. You know, I thought all that running around would've made you look a bit tougher."
                                },
                                {
                                    "id": "710750110",
                                    "speaker": "\"The Qingce Kid\"",
                                    "text": "Well, I'll give you a choice. You can give me the Helm of Warding, or you can give it to me after I've knocked your lights out."
                                },
                                {
                                    "id": "710750111",
                                    "speaker": "Player",
                                    "text": "...I doubt you actually want to fight me."
                                },
                                {
                                    "id": "710750112",
                                    "speaker": "\"The Qingce Kid\"",
                                    "text": "Oh, look who's talking big?"
                                },
                                {
                                    "id": "710750113",
                                    "speaker": "\"The Qingce Kid\"",
                                    "text": "Looks like you'll have to learn the hard way!"
                                }
                            ]
                        },
                        {
                            "id": "710750107",
                            "text": "...But you won't find it here."
                        }
                    ]
                }
            ]
        }
    ]
