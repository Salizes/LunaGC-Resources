{
    "quest": {
        "id": "71664",
        "title": "Vibro-Crystal Projections",
        "description": "A certain researcher from Fontaine is currently performing some esoteric research in The Chasm.",
        "rewards": [
            {
                "itemId": 104002,
                "count": 4
            },
            {
                "itemId": 202,
                "count": 10000
            }
        ],
        "rewards_formatted": "Adventurer's Experience x4, Mora x10000",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 82,
        "total_speaker_counts": {
            "Katheryne": 6,
            "Paimon": 24,
            "Patrice": 35,
            "Player": 17
        }
    },
    "talks": [
        {
            "id": "7166401",
            "objective": "Go to the Liyue Adventurers' Guild",
            "dialogues": [
                {
                    "id": "716640101",
                    "speaker": "Katheryne",
                    "text": "Ah, I've been waiting for you, Traveler."
                },
                {
                    "id": "716640102",
                    "speaker": "Katheryne",
                    "text": "Recently, the Adventurers' Guild has received a rather important commission. Judging from my experience, you are the best person for the job.",
                    "choices": [
                        {
                            "id": "716640103",
                            "text": "An important commission, you say...",
                            "response": [
                                {
                                    "id": "716640105",
                                    "speaker": "Paimon",
                                    "text": "Oh, come on. Don't worry, Katheryne, we're used to it already!"
                                },
                                {
                                    "id": "716640106",
                                    "speaker": "Paimon",
                                    "text": "And you wouldn't have troubled us if the rewards weren't worth it either, right?"
                                },
                                {
                                    "id": "716640107",
                                    "speaker": "Katheryne",
                                    "text": "Well, that is true... As expected of the two of you — as straightforward as ever."
                                },
                                {
                                    "id": "716640108",
                                    "speaker": "Katheryne",
                                    "text": "Well, then I will get straight to the point as well. The person who gave this commission out is named Patrice, and he is a researcher from Fontaine."
                                },
                                {
                                    "id": "716640109",
                                    "speaker": "Katheryne",
                                    "text": "He hopes to get a few assistants to help him conduct his studies. He is presently inspecting the outskirts of The Chasm."
                                },
                                {
                                    "id": "716640110",
                                    "speaker": "Katheryne",
                                    "text": "Although we were not given a great amount of detail concerning the nature of this research, I believe that you are quite used to such commissions..."
                                },
                                {
                                    "id": "716640111",
                                    "speaker": "Player",
                                    "text": "That's true..."
                                },
                                {
                                    "id": "716640112",
                                    "speaker": "Paimon",
                                    "text": "Well, let's do it like we always do. First up, to The Chasm!"
                                }
                            ]
                        },
                        {
                            "id": "716640104",
                            "text": "Well, this sounds familiar."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7166402",
            "objective": "Look for Patrice near The Chasm",
            "dialogues": [
                {
                    "id": "716640201",
                    "speaker": "Patrice",
                    "text": "We can't have any more delays. We need to move onto the verification stage as soon as possible... Worse comes to worst, I'll do it myself."
                },
                {
                    "id": "716640202",
                    "speaker": "Patrice",
                    "text": "\"Research halted temporarily due to accidental injury.\" I think that'll buy me some time..."
                },
                {
                    "id": "716640203",
                    "speaker": "Patrice",
                    "text": "As long as I don't lose my life, I'd call it a better trade than having to go to court back home!"
                },
                {
                    "id": "716640204",
                    "speaker": "Paimon",
                    "text": "#What's he talking to himself about? Let's go say hi, {NICKNAME}."
                },
                {
                    "id": "716640205",
                    "speaker": "Player",
                    "text": "Hello, are you Patrice?"
                },
                {
                    "id": "716640206",
                    "speaker": "Patrice",
                    "text": "Aaahhh! Where did you two come from... and how do you know my name?"
                },
                {
                    "id": "716640207",
                    "speaker": "Patrice",
                    "text": "Wait, you aren't plainclothes Millelith, are you? Are you here to kick me out? I've already shown you my field inspection permit!"
                },
                {
                    "id": "716640208",
                    "speaker": "Patrice",
                    "text": "I swear to you, I did not enter any restricted areas! If you don't believe me, go ask that black-haired, fierce-looking lady!"
                },
                {
                    "id": "716640209",
                    "speaker": "Paimon",
                    "text": "Uh, Paimon doesn't know who you're talking about, but you can relax."
                },
                {
                    "id": "716640210",
                    "speaker": "Paimon",
                    "text": "We're friendly, professional adventurers. We received your commission from the Guild, and we're here to help!"
                },
                {
                    "id": "716640211",
                    "speaker": "Patrice",
                    "text": "Oh, so you're the reinforcements? Wonderful, wonderful! Now that you're here, we finally have a chance! I was going to die here at this rate..."
                },
                {
                    "id": "716640212",
                    "speaker": "Paimon",
                    "text": "Wow, your research sounds more like torture..."
                },
                {
                    "id": "716640213",
                    "speaker": "Patrice",
                    "text": "No, no! Research itself is sacred! The highest calling! The thing in my way is what one might call... additional factors."
                },
                {
                    "id": "716640214",
                    "speaker": "Paimon",
                    "text": "Additional factors? Like what?"
                },
                {
                    "id": "716640215",
                    "speaker": "Patrice",
                    "text": "Well, like how I will kick the bucket should this research fail."
                },
                {
                    "id": "716640216",
                    "speaker": "Paimon",
                    "text": "...!?",
                    "choices": [
                        {
                            "id": "716640217",
                            "text": "That sounds like defeatist talk.",
                            "response": [
                                {
                                    "id": "716640219",
                                    "speaker": "Patrice",
                                    "text": "*sigh* If only I were joking."
                                },
                                {
                                    "id": "716640220",
                                    "speaker": "Patrice",
                                    "text": "Independent researchers must apply for funding to conduct their studies, but using them means that you'll be assuming the social responsibility that comes with their use."
                                },
                                {
                                    "id": "716640221",
                                    "speaker": "Patrice",
                                    "text": "To spend large sums and not produce any results therefore makes you no different from a criminal deserving of judgment!"
                                },
                                {
                                    "id": "716640222",
                                    "speaker": "Patrice",
                                    "text": "If I return empty-handed, I will almost certainly face at least a few dozen charges, including but not limited to, \"wasting public funds\" and \"misappropriating academic resources.\""
                                },
                                {
                                    "id": "716640223",
                                    "speaker": "Patrice",
                                    "text": "Such crimes will surely land me the harshest punishments... Never mind the bankruptcy or the sullying of my name — if I am indeed judged, I might really die!"
                                },
                                {
                                    "id": "716640224",
                                    "speaker": "Paimon",
                                    "text": "Eh? That sounds way too extreme!"
                                },
                                {
                                    "id": "716640225",
                                    "speaker": "Paimon",
                                    "text": "So is that why you put up so much Mora for assistants to help you?",
                                    "choices": [
                                        {
                                            "id": "716640226",
                                            "text": "Fontaine sounds like a scary place.",
                                            "response": [
                                                {
                                                    "id": "716640227",
                                                    "speaker": "Patrice",
                                                    "text": "Nay, my homeland is innocent! It is those \"additional factors\" that are to blame!"
                                                },
                                                {
                                                    "id": "716640230",
                                                    "speaker": "Paimon",
                                                    "text": "Alright, calm down, we get that the situation is serious. This research concerns your future, and even your life, right?"
                                                },
                                                {
                                                    "id": "716640231",
                                                    "speaker": "Paimon",
                                                    "text": "Just leave it to us. We'll help get you out of this!"
                                                },
                                                {
                                                    "id": "716640232",
                                                    "speaker": "Patrice",
                                                    "text": "As things stand, I suppose I have no other choice.",
                                                    "choices": [
                                                        {
                                                            "id": "716640233",
                                                            "text": "What do you need us to do exactly?",
                                                            "response": [
                                                                {
                                                                    "id": "716640235",
                                                                    "speaker": "Patrice",
                                                                    "text": "Yes, let's get down to it. So, my research topic is called Vibro-Crystal Harmonics."
                                                                },
                                                                {
                                                                    "id": "716640236",
                                                                    "speaker": "Patrice",
                                                                    "text": "Simply put, this is the process of stimulating the elemental energy within gems and crystals, and using this elemental power as a source of energy."
                                                                },
                                                                {
                                                                    "id": "716640237",
                                                                    "speaker": "Paimon",
                                                                    "text": "That sounds super convenient! Paimon can totally see it being used to make practical and awesome machines..."
                                                                },
                                                                {
                                                                    "id": "716640238",
                                                                    "speaker": "Paimon",
                                                                    "text": "But what do these gems have to do with this vibey-raidey thing you're talking about again?"
                                                                },
                                                                {
                                                                    "id": "716640239",
                                                                    "speaker": "Player",
                                                                    "text": "I suppose these gems are the \"Vibro-Crystals.\""
                                                                },
                                                                {
                                                                    "id": "716640240",
                                                                    "speaker": "Patrice",
                                                                    "text": "Pre-cisely! Not long ago, when someone tried activating gems, they discovered that a certain wondrous resonance could occur between special types of gems."
                                                                },
                                                                {
                                                                    "id": "716640241",
                                                                    "speaker": "Patrice",
                                                                    "text": "These gems were thus named \"Vibro-Crystals.\""
                                                                },
                                                                {
                                                                    "id": "716640242",
                                                                    "speaker": "Patrice",
                                                                    "text": "When the Transmitter Crystal half of the Vibro-Crystal set has been stimulated in a certain way, it will release a certain energy that will trigger a resonance with the Receiver Crystal half."
                                                                },
                                                                {
                                                                    "id": "716640243",
                                                                    "speaker": "Patrice",
                                                                    "text": "The two energies from the Vibro-Crystals will stack and multiply one another many, many times over! I've called this resonance type \"harmonics.\""
                                                                },
                                                                {
                                                                    "id": "716640244",
                                                                    "speaker": "Patrice",
                                                                    "text": "At the moment, I have reached a critical stage in my work: which is verifying my hypothesis of these \"harmonics.\"",
                                                                    "choices": [
                                                                        {
                                                                            "id": "716640245",
                                                                            "text": "I have a feeling...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "716640247",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Paimon guesses that you'll need us to help you prove your theory by using the power of the Vibro-Crystals to defeat monsters and prove that the \"harmonics\" association occurs."
                                                                                },
                                                                                {
                                                                                    "id": "716640248",
                                                                                    "speaker": "Patrice",
                                                                                    "text": "Exactly! Why, you're both quite bright, aren't you?"
                                                                                },
                                                                                {
                                                                                    "id": "716640249",
                                                                                    "speaker": "Patrice",
                                                                                    "text": "I've chosen a suitable area that has a great many steles in it mounted with Vibro-Crystal sets. Tell me once you're ready."
                                                                                },
                                                                                {
                                                                                    "id": "716640250",
                                                                                    "speaker": "Patrice",
                                                                                    "text": "I will tell you precisely what needs to be tested. Just follow my instructions as you engage in battle, and we should be fine."
                                                                                },
                                                                                {
                                                                                    "id": "716640251",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Huh. This really does seem like what we do all the time... Paimon almost feels kinda bored.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "716640252",
                                                                                            "text": "Well, I'm interested...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "716640253",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "You've beaten more super-strong opponents than you can count on both hands, so of course this sort of commission should be easy-peasy!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640256",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Ah, very impressive! Liyue truly is an excellent place, filled with high-quality ore and highly-reliable adventurers!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640257",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Ah, I suppose coming all this way to save material costs was the right decision after all."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640258",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "I was originally most worried about having to run over budget, but I think I shall now retain 20% of my funds even after paying to commission you."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640259",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Once this is done, I shall use the remaining amount to hire a newswriter to publish my results. Always good to get the word out there, after all."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640260",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "I can see it now! \"Behold, Patrice's True Tale of the Vibro-Crystals!\""
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640261",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "What? Seriously? That doesn't sound like the title of an academic essay at all!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640262",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Ah, but titles must be strange and bizarre to attract the eye of the public and bring in investment! When that happens, we can even discuss bonuses."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640263",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Bonuses? Paimon's not sure what you mean..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640264",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "Well, if the Vibro-Crystal Harmonics effect is used to create commercial products, I shall receive a share of the profit in royalties. And of course, some of my share shall go to you."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640265",
                                                                                                    "speaker": "Patrice",
                                                                                                    "text": "That said, this is contingent upon our research progress..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640266",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Ooh, so that's how it is, huh? Alrighty, Paimon's excited now! It's fine, you can use whatever title you want!",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "716640267",
                                                                                                            "text": "Paimon...",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "716640269",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "#Whatever, {NICKNAME}, let's get this done, and get it done quick!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "716640270",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "After that, we can go discuss this \"bonuses\" thing with Mr. Patrice, hehe..."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "716640268",
                                                                                                            "text": "You're salivating..."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "716640254",
                                                                                            "text": "Well, you're free to give it a shot, Paimon.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "716640255",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Uhhh, what? P—Paimon's just saying that it would be great if your adventures were all interesting and challenging... Paimon isn't complaining!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "716640246",
                                                                            "text": "I've got it."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "716640234",
                                                            "text": "Could you explain your research topic a bit?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716640228",
                                            "text": "These \"additional factors\" sound horrifying.",
                                            "response": [
                                                {
                                                    "id": "716640229",
                                                    "speaker": "Patrice",
                                                    "text": "And yet they have their uses. As long as you are not considered guilty, you can enjoy all manner of conveniences. We people of Fontaine have all benefited from that system in the past."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716640218",
                            "text": "That's a pretty funny one, I'll give you that."
                        }
                    ]
                }
            ]
        }
    ]
}