            "objective": "Talk to Qianqian",
            "dialogues": [
                {
                    "id": "1903203101",
                    "speaker": "Qianqian",
                    "text": "*sobbing* Huh...? Um..."
                },
                {
                    "id": "1903203102",
                    "speaker": "Qianqian",
                    "text": "Um... Can... C—Can you help me...?",
                    "choices": [
                        {
                            "id": "1903203103",
                            "text": "Help you?",
                            "response": [
                                {
                                    "id": "1903203105",
                                    "speaker": "Qianqian",
                                    "text": "Um, that exorcist... with that blue hair... is so scary!"
                                },
                                {
                                    "id": "1903203106",
                                    "speaker": "Qianqian",
                                    "text": "C—Can you lead him away from here? He makes me feel so frightened...",
                                    "choices": [
                                        {
                                            "id": "1903203107",
                                            "text": "Are you being affected by his yang energy?",
                                            "response": [
                                                {
                                                    "id": "1903203109",
                                                    "speaker": "Qianqian",
                                                    "text": "I wouldn't dare get anywhere near him... His energy... It's so horrible! It'll make me disappear!"
                                                },
                                                {
                                                    "id": "1903203110",
                                                    "speaker": "Qianqian",
                                                    "text": "...I don't want to disappear! Please, help me...",
                                                    "choices": [
                                                        {
                                                            "id": "1903203111",
                                                            "text": "I wonder if he'd consider you an evil spirit...",
                                                            "response": [
                                                                {
                                                                    "id": "1903203113",
                                                                    "speaker": "Qianqian",
                                                                    "text": "...Well... I—I have an idea."
                                                                },
                                                                {
                                                                    "id": "1903203114",
                                                                    "speaker": "Qianqian",
                                                                    "text": "Um... I—I saw the exorcist with blue hair a—arguing with someone over there a few minutes ago."
                                                                },
                                                                {
                                                                    "id": "1903203115",
                                                                    "speaker": "Qianqian",
                                                                    "text": "I'll scare those troublemakers away, but y—you have to ask the exorcist to let me go, okay?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "1903203116",
                                                                            "text": "Are you telling the truth?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "1903203117",
                                                                                    "speaker": "Qianqian",
                                                                                    "text": "O—Of course... Qianqian never lies."
                                                                                },
                                                                                {
                                                                                    "id": "1903203120",
                                                                                    "speaker": "Qianqian",
                                                                                    "text": "So, um... What do you say?"
                                                                                },
                                                                                {
                                                                                    "id": "1903203121",
                                                                                    "speaker": "Player",
                                                                                    "text": "He'll be the one that decides, but I'll try to explain the situation as best I can."
                                                                                },
                                                                                {
                                                                                    "id": "1903203122",
                                                                                    "speaker": "Qianqian",
                                                                                    "text": "Um... Uh, okay... So, I'll take that as a \"yes\"?"
                                                                                },
                                                                                {
                                                                                    "id": "1903203123",
                                                                                    "speaker": "Qianqian",
                                                                                    "text": "I hope the exorcist with blue hair is a good person."
                                                                                },
                                                                                {
                                                                                    "id": "1903203124",
                                                                                    "speaker": "Qianqian",
                                                                                    "text": "Um... So, I'll help him, and you'll go talk to him. Hopefully, then he'll leave me alone... Sound good?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "1903203118",
                                                                            "text": "I can get him out of trouble myself.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "1903203119",
                                                                                    "speaker": "Qianqian",
                                                                                    "text": "...Yeah but... it'll be complicated. I've already got a plan, you must believe me!"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "1903203112",
                                                            "text": "He'll have to be the one that decides what to do."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "1903203108",
                                            "text": "No wonder we haven't seen you all day."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "1903203104",
                            "text": "Why me?"
                        }
                    ]
                }
            ]
        },
