    "talks": [
        {
            "id": "7650701",
            "objective": "Go to Nasha Town",
            "dialogues": [
                {
                    "id": "765070101",
                    "speaker": "Paimon",
                    "text": "#Whoa, {NICKNAME}, look! It feels like we just got this album yesterday, but we've filled it up so fast! And all the photos are so pretty!",
                    "choices": [
                        {
                            "id": "765070102",
                            "text": "Time flies when you're having fun.",
                            "response": [
                                {
                                    "id": "765070104",
                                    "speaker": "Paimon",
                                    "text": "Hehe, Paimon couldn't have guessed that we'd find so many beautiful places and take so many pictures of our friends..."
                                },
                                {
                                    "id": "765070105",
                                    "speaker": "Paimon",
                                    "text": "Ooh, and look at this one! We worked hard to find the perfect angle for it, and the end result's super awesome!",
                                    "choices": [
                                        {
                                            "id": "765070106",
                                            "text": "All thanks to you guiding us there, Paimon.",
                                            "response": [
                                                {
                                                    "id": "765070108",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, of course! Paimon's the bestest guide around!"
                                                },
                                                {
                                                    "id": "765070109",
                                                    "speaker": "Paimon",
                                                    "text": "And anyway, the amazing memories we've made have recouped the costs and then some!"
                                                },
                                                {
                                                    "id": "765070110",
                                                    "speaker": "Paimon",
                                                    "text": "#{NICKNAME}, how do you feel taking photos with this Kamera? Do you think your skills have improved by leaps and bounds? Are we any closer to getting the better of the legendary Pierre Leblanc?",
                                                    "choices": [
                                                        {
                                                            "id": "765070111",
                                                            "text": "My skills...? Well, I've still got a long way to go.",
                                                            "response": [
                                                                {
                                                                    "id": "765070113",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hehe, you're right! Being happy is the most important thing of all! Besides, Paimon thinks the photos you took are more than a match for any master photographer."
                                                                },
                                                                {
                                                                    "id": "765070114",
                                                                    "speaker": "Paimon",
                                                                    "text": "Each one contains stories we've seen together, after all. As far as Paimon's concerned, that's something irreplaceable."
                                                                },
                                                                {
                                                                    "id": "765070115",
                                                                    "speaker": "Paimon",
                                                                    "text": "In the future, once we... Umm, when we go to other places for adventures, and think back on all these beautiful memories... That'll be super interesting, won't it?"
                                                                },
                                                                {
                                                                    "id": "765070116",
                                                                    "speaker": "Player",
                                                                    "text": "Let's take more pictures together in the future."
                                                                },
                                                                {
                                                                    "id": "765070117",
                                                                    "speaker": "Paimon",
                                                                    "text": "Yeah! It's a promise, then! Our next photo album will be bigger, better, and full of even more special memories!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765070112",
                                                            "text": "It's all about enjoying the process."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765070107",
                                            "text": "It's all thanks to your emergency funds, Paimon."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765070103",
                            "text": "There's a memory behind every picture."
                        }
                    ]
                }
            ]
        }
    ]
