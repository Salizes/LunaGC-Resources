    "talks": [
        {
            "id": "7220801",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080101",
                    "speaker": "Ipe",
                    "text": "You're pretty good at fishing! Reckon there's room for improvement, though!",
                    "choices": [
                        {
                            "id": "722080102",
                            "text": "Eh!?",
                            "response": [
                                {
                                    "id": "722080104",
                                    "speaker": "Ipe",
                                    "text": "Ahaha, sorry, sorry... I always forget to say hi and all. Easy to forget that I might scare people, you know?"
                                },
                                {
                                    "id": "722080105",
                                    "speaker": "Player",
                                    "text": "Doesn't seem to stop you from enjoying it..."
                                },
                                {
                                    "id": "722080106",
                                    "speaker": "Ipe",
                                    "text": "Aw, come on~ Scaring kids is fun from time to time, don'cha think?"
                                },
                                {
                                    "id": "722080107",
                                    "speaker": "Ipe",
                                    "text": "*cough* Anyway, let's get back to talking about fishing.",
                                    "choices": [
                                        {
                                            "id": "722080108",
                                            "text": "What, is it serious business?",
                                            "response": [
                                                {
                                                    "id": "722080110",
                                                    "speaker": "Ipe",
                                                    "text": "Well, so, I know this isn't the best look... But when I was fishing earlier, I dropped the charm that Makiri gave me. It's got blessings from her ancestral spirits and the Great Thunderbird in it."
                                                },
                                                {
                                                    "id": "722080111",
                                                    "speaker": "Ipe",
                                                    "text": "I... I don't know what I'd tell her if she found out that I lost it after we board the boat..."
                                                },
                                                {
                                                    "id": "722080112",
                                                    "speaker": "Ipe",
                                                    "text": "The golden boat-guy said that he'd scrounge some people up to help me search, but it doesn't look like anyone's coming! So I thought that since you're here, you can help me out too!",
                                                    "choices": [
                                                        {
                                                            "id": "722080113",
                                                            "text": "And here I thought you were the reliable one...",
                                                            "response": [
                                                                {
                                                                    "id": "722080115",
                                                                    "speaker": "Ipe",
                                                                    "text": "My usual fishing spot's just over there, but... my memory's getting weaker and weaker somehow, so I'm afraid that I've gotta leave it to you to help me search...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "722080116",
                                                                            "text": "Since it's a place of ancient memory...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "722080118",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "Eh? What do you mean? Is this some way in which you outsiders find things?"
                                                                                },
                                                                                {
                                                                                    "id": "722080119",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "*sigh* Well, whatever it might be, you should be able to find the charm as long as you find the right spot."
                                                                                },
                                                                                {
                                                                                    "id": "722080120",
                                                                                    "speaker": "Player",
                                                                                    "text": "And how will I search for the charm itself?"
                                                                                },
                                                                                {
                                                                                    "id": "722080121",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "Uhh... By fishing it out of the water?"
                                                                                },
                                                                                {
                                                                                    "id": "722080122",
                                                                                    "speaker": "Player",
                                                                                    "text": "...I guess that works."
                                                                                },
                                                                                {
                                                                                    "id": "722080123",
                                                                                    "speaker": "Ipe",
                                                                                    "text": "Thank you, friend from afar! May the Great Thunderbird and our ancestors protect you!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "722080117",
                                                                            "text": "I guess the \"feather\" should do the trick..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722080114",
                                                            "text": "You're hopeless...",
                                                            "response": [
                                                                {
                                                                    "id": "722080199",
                                                                    "speaker": "Ipe",
                                                                    "text": "There is an isle west of the Autake Plains that faces three waterfalls. It should be in the sea further west of that small island..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722080109",
                                            "text": "You really love fishing, don't you..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722080103",
                            "text": "What happened to greeting before deciding to just show up?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220803",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080301",
                    "speaker": "Ipe",
                    "text": "Hey! You're back!"
                },
                {
                    "id": "722080302",
                    "speaker": "Player",
                    "text": "Is this what you were looking for?"
                }
            ]
        },
        {
            "id": "7220804",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080401",
                    "speaker": "Ipe",
                    "text": "You're back! Did you find the charm?"
                },
                {
                    "id": "722080402",
                    "speaker": "Player",
                    "text": "I need a bit more time."
                },
                {
                    "id": "722080403",
                    "speaker": "Ipe",
                    "text": "Ah, I see, I see. No rush, y'know? Stay safe while you're at it too, friend from afar."
                },
                {
                    "id": "722080404",
                    "speaker": "Ipe",
                    "text": "You'll find an isle west of the Autake Plains that faces three waterfalls. The charm I'm searching for is in the waters west of that small island..."
                }
            ]
        },
        {
            "id": "7220806",
            "objective": "",
            "dialogues": [
                {
                    "id": "722080201",
                    "speaker": "Ipe",
                    "text": "Thank you so much! Now I can finally board the boat in peace..."
                },
                {
                    "id": "722080202",
                    "speaker": "Player",
                    "text": "Where is that boat going, anyway?"
                },
                {
                    "id": "722080203",
                    "speaker": "Ipe",
                    "text": "To the land of gold, the land of dreams. A realm with no fog. We'll meet again in dreams, friend."
                }
            ]
        }
    ]
}