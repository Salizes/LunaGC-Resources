    "talks": [
        {
            "id": "4020001",
            "objective": "Go with Yelan to the Court of Fontaine",
            "dialogues": [
                {
                    "id": "402000101",
                    "speaker": "Yelan",
                    "text": "What a nice night..."
                },
                {
                    "id": "402000102",
                    "speaker": "Yelan",
                    "text": "Fresh Romaritime Flowers, fragrant perfume from the shop on the corner, the rich aroma of coffee beans, all blended together in the night breeze... Makes for quite the relaxing atmosphere."
                },
                {
                    "id": "402000103",
                    "speaker": "Yelan",
                    "text": "If only we were on a rooftop terrace somewhere, enjoying a few glasses of sparkling wine and getting pleasantly tipsy...",
                    "choices": [
                        {
                            "id": "402000104",
                            "text": "Hey, you're on vacation now! Why not?",
                            "response": [
                                {
                                    "id": "402000106",
                                    "speaker": "Yelan",
                                    "text": "Alright... Then let's look for a place to stop. I wonder what special drinks the hidden taverns of this city offer..."
                                },
                                {
                                    "id": "402000107",
                                    "speaker": "Yelan",
                                    "text": "Ah, but first. I wanted to head to the Confrerie of Cabriere before it closes. Mind helping me pick out some perfume to go with this outfit?"
                                },
                                {
                                    "id": "402000108",
                                    "speaker": "Yelan",
                                    "text": "I also heard about the intricate timepieces, clockwork furnishings, and fine jewelry you can get around here. There should be quite a few souvenirs worth perusing.",
                                    "choices": [
                                        {
                                            "id": "402000109",
                                            "text": "The longer you work, the more you want to spend?",
                                            "response": [
                                                {
                                                    "id": "402000111",
                                                    "speaker": "Yelan",
                                                    "text": "Well, with the most cultured traveler in all of Teyvat by my side, I should take advantage of this opportunity. I'm counting on you not to steer me wrong..."
                                                },
                                                {
                                                    "id": "402000112",
                                                    "speaker": "Yelan",
                                                    "text": "Mm, I'm satisfied. This has been a nice trip abroad... a very nice trip indeed."
                                                },
                                                {
                                                    "id": "402000113",
                                                    "speaker": "Yelan",
                                                    "text": "I wish I could take my time, maybe extend my stay a few more days. No one likes to be rushed on vacation.",
                                                    "choices": [
                                                        {
                                                            "id": "402000114",
                                                            "text": "Wait, I thought you were going to enjoy your time off?",
                                                            "response": [
                                                                {
                                                                    "id": "402000116",
                                                                    "speaker": "Yelan",
                                                                    "text": "It can't be helped. Duty calls."
                                                                },
                                                                {
                                                                    "id": "402000117",
                                                                    "speaker": "Yelan",
                                                                    "text": "I still have to write up a formal report on the case and help develop a more sophisticated cargo inspection system. Then, I'm off to the location of my next assignment..."
                                                                },
                                                                {
                                                                    "id": "402000118",
                                                                    "speaker": "Yelan",
                                                                    "text": "Nod-Krai.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "402000119",
                                                                            "text": "That's where Paimon and I are headed next, too.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "402000121",
                                                                                    "speaker": "Yelan",
                                                                                    "text": "No, nothing like that. Just meeting an intelligence partner to decide on a mutually-beneficial agreement going forward, and to set some boundaries."
                                                                                },
                                                                                {
                                                                                    "id": "402000122",
                                                                                    "speaker": "Yelan",
                                                                                    "text": "I'll fill you in later. For now, why don't we take a picture together to commemorate this exciting trip to Fontaine?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "402000123",
                                                                                            "text": "And you taking me under your wing.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "402000125",
                                                                                                    "speaker": "Yelan",
                                                                                                    "text": "#That's right. After this, I know I can trust you to have my back, {NICKNAME}. Or should I say... Agent."
                                                                                                },
                                                                                                {
                                                                                                    "id": "402000126",
                                                                                                    "speaker": "Yelan",
                                                                                                    "text": "I say we put the Forensic Imaging Device to use one last time to take this picture."
                                                                                                },
                                                                                                {
                                                                                                    "id": "402000127",
                                                                                                    "speaker": "Yelan",
                                                                                                    "text": "Perhaps we'll cross paths in Nod-Krai. If so, I hope this collaboration was just the first of many."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "402000124",
                                                                                            "text": "And the success of our operation."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "402000120",
                                                                            "text": "Is your business there urgent? Has something happened?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "402000115",
                                                            "text": "Why does it sound like you're about to get back to work?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000110",
                                            "text": "Alright, I'm down for a shopping spree!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000105",
                            "text": "You deserve to celebrate! Let's cheers to a job well done!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4020002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "402000201",
                    "speaker": "Paimon",
                    "text": "So you're saying that Officer Fonck is going to take us to where the bad guys are being questioned, right?"
                },
                {
                    "id": "402000202",
                    "speaker": "Edler",
                    "text": "That's right. We're giving you the chance to check out our secret base..."
                },
                {
                    "id": "402000203",
                    "speaker": "Edler",
                    "text": "Haha, I'm only joking. To make sure we don't disturb everyone's day-to-day work, we've set up shop in a remote house. Once we set off, you'd better stay close to me, okay?"
                },
                {
                    "id": "402000204",
                    "speaker": "Paimon",
                    "text": "#Don't worry! Paimon's a very experienced guide, she and {NICKNAME} have been to all sorts of confusing places. No way she'll get lost in Fontaine!"
                },
                {
                    "id": "402000205",
                    "speaker": "Paimon",
                    "text": "#Ah, {NICKNAME} is here."
                },
                {
                    "id": "402000206",
                    "speaker": "Paimon",
                    "text": "That was quick! Is Yelan one of those close-your-eyes-for-a-second-and-okay-that's-enough-rest-let's-get-back-to-work sort of people?",
                    "choices": [
                        {
                            "id": "402000207",
                            "text": "We haven't started our vacation yet.",
                            "response": [
                                {
                                    "id": "402000209",
                                    "speaker": "Paimon",
                                    "text": "Hehe, Paimon's fine, there's no need to worry. You're not the only one who can grow!"
                                },
                                {
                                    "id": "402000210",
                                    "speaker": "Paimon",
                                    "text": "Everything's been taken care of, so you and Yelan can go and enjoy your holiday!"
                                },
                                {
                                    "id": "402000211",
                                    "speaker": "Paimon",
                                    "text": "Throw all your troubles aside and have fun!"
                                },
                                {
                                    "id": "402000212",
                                    "speaker": "Edler",
                                    "text": "And for my part, I'll make sure Inspector Paimon's well looked after. Whatever she wants to learn, whatever she wants to eat, we'll ensure her needs are met!",
                                    "choices": [
                                        {
                                            "id": "402000213",
                                            "text": "I'll be on my way then!",
                                            "response": [
                                                {
                                                    "id": "402000215",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon's gonna make a really good student inspector!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000214",
                                            "text": "Good luck, Paimon!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000208",
                            "text": "I was a little worried, so I came by to check up on you."
                        }
                    ]
                }
            ]
        }
    ]
