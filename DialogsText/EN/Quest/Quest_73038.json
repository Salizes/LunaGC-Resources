        "rewards_formatted": "Adventure EXP x100, Primogem x20, Mora x10000, Stories of You and the Aranara x1",
        "chapter": {
            "icon": "UI_ChapterIcon_Sumeru",
            "id": "10082",
            "num": "Aranyaka: Part IV",
            "title": "In the End, the Forest Will Remember"
        },
        "total_dialogue_lines": 98,
        "total_speaker_counts": {
            "Arana": 22,
            "Black Screen": 3,
            "Paimon": 20,
            "Player": 15,
            "Rana": 38
        }
    },
    "talks": [
        {
            "id": "7303801",
            "objective": "Talk to Arana",
            "dialogues": [
                {
                    "id": "730380101",
                    "speaker": "Arana",
                    "text": "An Ashvattha Tree... Strange. The Ashvattha Tree shouldn't be here. Golden Nara, White Floaty... Arana doesn't recognize you. But you look familiar. Who are you?"
                },
                {
                    "id": "730380102",
                    "speaker": "Paimon",
                    "text": "So Arana really did forget everything..."
                },
                {
                    "id": "730380103",
                    "speaker": "Paimon",
                    "text": "#Paimon's name is Paimon, and {M#he}{F#she} is {NICKNAME}."
                },
                {
                    "id": "730380104",
                    "speaker": "Player",
                    "text": "We're your friends, Arana."
                },
                {
                    "id": "730380105",
                    "speaker": "Arana",
                    "text": "Mm. Arana believes you. You smell kind..."
                },
                {
                    "id": "730380106",
                    "speaker": "Arana",
                    "text": "Arana understands now. There seemed to be a hole in my heart through which important memories slipped away. But, seeing you and the Ashvattha Tree, Arana understands much more now."
                },
                {
                    "id": "730380107",
                    "speaker": "Arana",
                    "text": "Arana saw that you took the Bija, yes? Arana gave many memories to the Ashvattha Tree to grow that fruit, to help a friend."
                },
                {
                    "id": "730380108",
                    "speaker": "Paimon",
                    "text": "Clever Arana... So do you remember that friend?"
                },
                {
                    "id": "730380109",
                    "speaker": "Arana",
                    "text": "No. But, it's okay. You have the Bija, so you must be friends that Arana trusts, and Nara that the Ashvattha Tree recognizes."
                },
                {
                    "id": "730380110",
                    "speaker": "Arana",
                    "text": "Please take the Bija to Arana's friend in need.",
                    "choices": [
                        {
                            "id": "730380111",
                            "text": "We will.",
                            "response": [
                                {
                                    "id": "730380112",
                                    "speaker": "Paimon",
                                    "text": "Arana, come with us! Your friend must want to see you again!"
                                },
                                {
                                    "id": "730380114",
                                    "speaker": "Arana",
                                    "text": "..."
                                },
                                {
                                    "id": "730380115",
                                    "speaker": "Arana",
                                    "text": "Arana doesn't want to go. Arana has forgotten. If my friend sees that they've been forgotten, they will be sad and think that Arana doesn't cherish them."
                                },
                                {
                                    "id": "730380116",
                                    "speaker": "Paimon",
                                    "text": "The friend you wanted to help is a great person... uh, a great Nara. Even if you forget her, Arana, she would still want to be your friend."
                                },
                                {
                                    "id": "730380117",
                                    "speaker": "Paimon",
                                    "text": "So let's go together, alright?"
                                },
                                {
                                    "id": "730380118",
                                    "speaker": "Arana",
                                    "text": "...Okay."
                                },
                                {
                                    "id": "730380119",
                                    "speaker": "Arana",
                                    "text": "You are Arana's friends, so Arana believes you."
                                }
                            ]
                        },
                        {
                            "id": "730380113",
                            "text": "Let's head off together."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7303802",
            "objective": "Return to Rana",
            "dialogues": [
                {
                    "id": "730380201",
                    "speaker": "Arana",
                    "text": "This is Arana's Ararakalari..."
                },
                {
                    "id": "730380202",
                    "speaker": "Arana",
                    "text": "Is she... Arana's Nara friend?"
                },
                {
                    "id": "730380203",
                    "speaker": "Paimon",
                    "text": "#Yes. Now, {NICKNAME}..."
                },
                {
                    "id": "730380204",
                    "speaker": "Player",
                    "text": "(Use the Bija.)"
                }
            ]
        },
        {
            "id": "7303803",
            "objective": "Talk to Rana",
            "dialogues": [
                {
                    "id": "730380301",
                    "speaker": "Rana",
                    "text": "..."
                },
                {
                    "id": "730380302",
                    "speaker": "Paimon",
                    "text": "Are you awake...?",
                    "choices": [
                        {
                            "id": "730380303",
                            "text": "Can you hear me?",
                            "response": [
                                {
                                    "id": "730380305",
                                    "speaker": "Rana",
                                    "text": "#Oh, did I fall asleep again... Where am I? Hey, {NICKNAME}, Paimon, I'm so glad you're alright! I was worried you'd be affected by The Withering. And..."
                                },
                                {
                                    "id": "730380306",
                                    "speaker": "Rana",
                                    "text": "Arana? Is that you, Arana..."
                                },
                                {
                                    "id": "730380307",
                                    "speaker": "Arana",
                                    "text": "Hello, Nara friend."
                                },
                                {
                                    "id": "730380308",
                                    "speaker": "Rana",
                                    "text": "I've always been waiting for you... You know, I had this long, long dream where I met you for the first time..."
                                },
                                {
                                    "id": "730380309",
                                    "speaker": "Rana",
                                    "text": "In the dream, I got lost in the forest. I couldn't find my parents or my way home. I was crying. You heard it, and you found me and sang to me..."
                                },
                                {
                                    "id": "730380310",
                                    "speaker": "Rana",
                                    "text": "Then we became best friends. I often came to hang out with you in the forest. You gave me a flower as a gift, and you taught me so many things, so many secrets of the forest."
                                },
                                {
                                    "id": "730380311",
                                    "speaker": "Rana",
                                    "text": "Like how Starshrooms are the reflection of stars in the sky. Like how seeing the Nilotpala Lotus bloom..."
                                },
                                {
                                    "id": "730380312",
                                    "speaker": "Arana",
                                    "text": "Seeing the Nilotpala Lotus bloom will grant you luck until the next moon rises."
                                },
                                {
                                    "id": "730380313",
                                    "speaker": "Rana",
                                    "text": "Yes! That's it! And then I dreamed that..."
                                },
                                {
                                    "id": "730380314",
                                    "speaker": "Rana",
                                    "text": "I dreamed that I grew up quickly into a reliable Forest Watcher who could protect everyone in Vimara Village. Reliable grown-ups don't believe in forest fairy tales."
                                },
                                {
                                    "id": "730380315",
                                    "speaker": "Rana",
                                    "text": "I dreamed that I had forgotten all about you. I came to think that the stories about Aranara were just fairy tales for children. That the forest was just land with many trees, and that there was no such thing as magic..."
                                },
                                {
                                    "id": "730380316",
                                    "speaker": "Rana",
                                    "text": "I was so scared when I woke up. Scared that I had forgotten all about you. I wouldn't know what to do if that happened... But thankfully, it was just a dream! I'm just so relieved to see you again!"
                                },
                                {
                                    "id": "730380317",
                                    "speaker": "Rana",
                                    "text": "Arana, where have you been? I've been waiting for you, for you to take me to the forest... the magical forest full of mysteries that only appears when I'm with you..."
                                },
                                {
                                    "id": "730380318",
                                    "speaker": "Arana",
                                    "text": "Sorry... Arana no longer remembers."
                                },
                                {
                                    "id": "730380319",
                                    "speaker": "Rana",
                                    "text": "Eh...?"
                                },
                                {
                                    "id": "730380320",
                                    "speaker": "Paimon",
                                    "text": "Yeah... Rana, it's not Arana's fault. Here's what happened..."
                                },
                                {
                                    "id": "730380321",
                                    "speaker": "Black Screen",
                                    "text": "\"We met Arana while looking for you. Arana said...\""
                                },
                                {
                                    "id": "730380322",
                                    "speaker": "Black Screen",
                                    "text": "The Fungi in Mawtiyima Forest, the fight at the Rain's End, the inside of the Ruin Golem, the song amidst the roses. Aranara acting as brothers and sisters, the joyful scenes of Festival Utsava...\\nGently, you tell Rana and Arana about all that you encountered together with the Aranara."
                                },
                                {
                                    "id": "730380323",
                                    "speaker": "Rana",
                                    "text": "So it was I who forgot everything..."
                                },
                                {
                                    "id": "730380324",
                                    "speaker": "Paimon",
                                    "text": "Bija grows from memories... Paimon thinks that Arana must've treasured those memories of you greatly, which is how the fruit could help you bring back some memories while it was healing you..."
                                },
                                {
                                    "id": "730380325",
                                    "speaker": "Rana",
                                    "text": "#Thank you, {NICKNAME}, Paimon... You went through so much trouble to help me...",
                                    "choices": [
                                        {
                                            "id": "730380326",
                                            "text": "Don't mention it. This was a most rewarding adventure for us, too.",
                                            "response": [
                                                {
                                                    "id": "730380327",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah! Besides, Arana and Arama are the ones you should be thanking..."
                                                },
                                                {
                                                    "id": "730380329",
                                                    "speaker": "Rana",
                                                    "text": "Thank you, and sorry, Arana..."
                                                },
                                                {
                                                    "id": "730380330",
                                                    "speaker": "Rana",
                                                    "text": "*sob* How could I forget about you... You must hate me, don't you..."
                                                },
                                                {
                                                    "id": "730380331",
                                                    "speaker": "Arana",
                                                    "text": "Arana doesn't know. Arana has forgotten."
                                                },
                                                {
                                                    "id": "730380332",
                                                    "speaker": "Arana",
                                                    "text": "But, it's okay. Since past-Arana was willing to let memories go for Rana's sake, current-Arana knows that you are the most important Nara, even more precious than memories."
                                                },
                                                {
                                                    "id": "730380333",
                                                    "speaker": "Paimon",
                                                    "text": "Um, Paimon's not sure if it's fair to Arana to say this..."
                                                },
                                                {
                                                    "id": "730380334",
                                                    "speaker": "Paimon",
                                                    "text": "#But Araja said Aranara have long lives! Paimon thinks that you two can still create many precious memories together, just like Paimon and {NICKNAME} do!"
                                                },
                                                {
                                                    "id": "730380335",
                                                    "speaker": "Rana",
                                                    "text": "You're right... We still have a lot of time with each other. We can explore the vastness of the forest, the world, and the future together."
                                                },
                                                {
                                                    "id": "730380336",
                                                    "speaker": "Arana",
                                                    "text": "Yes!"
                                                },
                                                {
                                                    "id": "730380337",
                                                    "speaker": "Rana",
                                                    "text": "#Marana... So The Withering problem was pretty much settled while I was asleep. I don't know how to thank you, {NICKNAME}, Paimon and all the Aranara..."
                                                },
                                                {
                                                    "id": "730380338",
                                                    "speaker": "Rana",
                                                    "text": "I know it seems impulsive, but I would like to go on a journey with Arana. I'm just worried that the children in Vimara Village might be put at risk again..."
                                                },
                                                {
                                                    "id": "730380339",
                                                    "speaker": "Paimon",
                                                    "text": "Gah! Paimon almost forgot that we still haven't solved our bad guy problem..."
                                                },
                                                {
                                                    "id": "730380340",
                                                    "speaker": "Player",
                                                    "text": "I already have some clues about who we're up against."
                                                },
                                                {
                                                    "id": "730380341",
                                                    "speaker": "Paimon",
                                                    "text": "What? Who? Why didn't Paimon know anything about that?"
                                                },
                                                {
                                                    "id": "730380342",
                                                    "speaker": "Rana",
                                                    "text": "Really? Who? Come, I must give them a few hard knocks to go!",
                                                    "choices": [
                                                        {
                                                            "id": "730380343",
                                                            "text": "Leave this to me.",
                                                            "response": [
                                                                {
                                                                    "id": "730380345",
                                                                    "speaker": "Rana",
                                                                    "text": "Right..."
                                                                },
                                                                {
                                                                    "id": "730380346",
                                                                    "speaker": "Rana",
                                                                    "text": "#I believe you, {NICKNAME}."
                                                                },
                                                                {
                                                                    "id": "730380347",
                                                                    "speaker": "Rana",
                                                                    "text": "This might come out strange... but I do think that this bad guy did bring something other than trouble. I mean, if the children hadn't gotten lost, I wouldn't have increased my patrol frequency..."
                                                                },
                                                                {
                                                                    "id": "730380348",
                                                                    "speaker": "Rana",
                                                                    "text": "And if I hadn't done that, I wouldn't have run into those Fungi and met two kind and honest souls who would never leave someone in need behind..."
                                                                },
                                                                {
                                                                    "id": "730380349",
                                                                    "speaker": "Rana",
                                                                    "text": "#It all happened so that I got to know you. {NICKNAME}, Paimon, you've both been such a great help. You saved me and helped reunite me with my best friend..."
                                                                },
                                                                {
                                                                    "id": "730380350",
                                                                    "speaker": "Rana",
                                                                    "text": "#I can't thank you enough, {NICKNAME} and Paimon."
                                                                },
                                                                {
                                                                    "id": "730380351",
                                                                    "speaker": "Paimon",
                                                                    "text": "It's okay, Rana! That said, Iotham, Kavus, and Sudabeh are going to miss you if you leave..."
                                                                },
                                                                {
                                                                    "id": "730380352",
                                                                    "speaker": "Rana",
                                                                    "text": "#They are stronger than you think. And they know {NICKNAME}, too. Besides, it's not like I'm never coming back!"
                                                                },
                                                                {
                                                                    "id": "730380353",
                                                                    "speaker": "Rana",
                                                                    "text": "#I will return one day and tell them tons of great stories, and I will introduce Arana to them, just like how I introduced {NICKNAME}."
                                                                },
                                                                {
                                                                    "id": "730380354",
                                                                    "speaker": "Paimon",
                                                                    "text": "That's good, that's good... Paimon was getting worried that you wouldn't come back..."
                                                                },
                                                                {
                                                                    "id": "730380355",
                                                                    "speaker": "Rana",
                                                                    "text": "So Arana, will you go travel with me?"
                                                                },
                                                                {
                                                                    "id": "730380356",
                                                                    "speaker": "Arana",
                                                                    "text": "Of course."
                                                                },
                                                                {
                                                                    "id": "730380357",
                                                                    "speaker": "Rana",
                                                                    "text": "You've lost so many memories because of me. But just as Paimon said, we can create our memories together to fill the void in your heart."
                                                                },
                                                                {
                                                                    "id": "730380358",
                                                                    "speaker": "Rana",
                                                                    "text": "My name is Rana. Would you like to be my friend?"
                                                                },
                                                                {
                                                                    "id": "730380359",
                                                                    "speaker": "Arana",
                                                                    "text": "Yes. Narana, we used to be best friends, and we will be best friends again."
                                                                },
                                                                {
                                                                    "id": "730380360",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hey, look! That's..."
                                                                },
                                                                {
                                                                    "id": "730380361",
                                                                    "speaker": "Black Screen",
                                                                    "text": "From Rana's chest, glows a light with the warmth of heartbeat, faint yet bright.\\nShe tries to cover and touch the light with her hands, but the light source burrows into her hands as if consciously. \\nWhen the light fades out, a delicate ornament appears in her hand."
                                                                },
                                                                {
                                                                    "id": "730380362",
                                                                    "speaker": "Player",
                                                                    "text": "A Vision."
                                                                },
                                                                {
                                                                    "id": "730380363",
                                                                    "speaker": "Paimon",
                                                                    "text": "This is the first time Paimon has seen something like this happen with her own eyes..."
                                                                },
                                                                {
                                                                    "id": "730380364",
                                                                    "speaker": "Rana",
                                                                    "text": "So my wish was recognized by the gods..."
                                                                },
                                                                {
                                                                    "id": "730380365",
                                                                    "speaker": "Rana",
                                                                    "text": "#Great! Now that I have this, I can embark on this journey with no more worries! I should even be able to handle the remnants of The Withering just fine. If only I could look as good in a fight as you, {NICKNAME}!"
                                                                },
                                                                {
                                                                    "id": "730380366",
                                                                    "speaker": "Rana",
                                                                    "text": "Ah, I've got so many things to do. First, I'll let everyone know I'm awake. Oh, and I need to tell Tighnari about my plans to travel."
                                                                },
                                                                {
                                                                    "id": "730380367",
                                                                    "speaker": "Rana",
                                                                    "text": "#Thank you again, Paimon, Arana. And thank you, {NICKNAME}."
                                                                },
                                                                {
                                                                    "id": "730380368",
                                                                    "speaker": "Arana",
                                                                    "text": "#Thank you, Golden Nara {NICKNAME} and Paimon. Arana has lost those memories, but Arana knows you are good Nara. You helped Arana meet Narana. Arana is so happy.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730380369",
                                                                            "text": "It's been a pleasure to know you all.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730380370",
                                                                                    "speaker": "Player",
                                                                                    "text": "Take care."
                                                                                },
                                                                                {
                                                                                    "id": "730380373",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Rana and Arana... Paimon hopes you enjoy your journey. And that you won't forget about us!"
                                                                                },
                                                                                {
                                                                                    "id": "730380374",
                                                                                    "speaker": "Rana",
                                                                                    "text": "\"Do not yield to the wind, or the rain. Do not yield to the winter snow, or the summer heat...\""
                                                                                },
                                                                                {
                                                                                    "id": "730380375",
                                                                                    "speaker": "Rana",
                                                                                    "text": "#I heard this poem once. {NICKNAME}, Paimon, I'm sure we'll meet again someday. And you'll see a stronger me then for sure!"
                                                                                },
                                                                                {
                                                                                    "id": "730380376",
                                                                                    "speaker": "Arana",
                                                                                    "text": "We'll see each other again for sure!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730380372",
                                                                            "text": "Time to bid farewell."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730380344",
                                                            "text": "There's no hard evidence yet."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730380328",
                                            "text": "You should thank Arana and Arama instead."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730380304",
                            "text": "She looks fine."
                        }
                    ]
                }
            ]
        }
    ]
}