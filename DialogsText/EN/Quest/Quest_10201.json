    "talks": [
        {
            "id": "1020101",
            "objective": "Find the treasure trove in the Whispering Woods",
            "dialogues": [
                {
                    "id": "102010101",
                    "speaker": "Klee",
                    "text": "We're here! This is the place!"
                },
                {
                    "id": "102010102",
                    "speaker": "Klee",
                    "text": "Look, this is where my huuuge treasure was buried..."
                },
                {
                    "id": "102010103",
                    "speaker": "Paimon",
                    "text": "And where there's now a huuuge empty hole in the ground..."
                },
                {
                    "id": "102010104",
                    "speaker": "Player",
                    "text": "Wait — who's that over there?"
                },
                {
                    "id": "102010105",
                    "speaker": "Paimon",
                    "text": "It's... an Abyss Mage!? Hey, maybe he's the one Jean was warning us about."
                },
                {
                    "id": "102010106",
                    "speaker": "Paimon",
                    "text": "What's that in his hand?"
                },
                {
                    "id": "102010107",
                    "speaker": "Klee",
                    "text": "My treasure!"
                },
                {
                    "id": "102010108",
                    "speaker": "Paimon",
                    "text": "...Wha!?"
                },
                {
                    "id": "102010109",
                    "speaker": "Abyss Mage",
                    "text": "Hmph! I see the little girl's brought her friends with her! Time for a change of plan..."
                },
                {
                    "id": "102010110",
                    "speaker": "Paimon",
                    "text": "Hey, you! If you think you're so tough, get back here and fight!"
                },
                {
                    "id": "102010111",
                    "speaker": "Player",
                    "text": "After him!"
                }
            ]
        },
        {
            "id": "1020112",
            "objective": "Talk to Klee",
            "dialogues": []
        },
        {
            "id": "1020102",
            "objective": "Chase down the Abyss Mage with Klee (If the Abyss Mage gets more than 50m away, the quest will be failed)",
            "dialogues": [
                {
                    "id": "102010201",
                    "speaker": "Klee",
                    "text": "What's an Abyss Mage? I play in the forest all the time, but I've never seen one before."
                }
            ]
        },
        {
            "id": "1020103",
            "objective": "Pursuit I",
            "dialogues": [
                {
                    "id": "102010301",
                    "speaker": "Paimon",
                    "text": "A gateway to a domain! The Abyss Mage must have snuck inside.",
                    "choices": [
                        {
                            "id": "102010302",
                            "text": "Then he has no way out.",
                            "response": [
                                {
                                    "id": "102010304",
                                    "speaker": "Klee",
                                    "text": "*panting* ..."
                                },
                                {
                                    "id": "102010305",
                                    "speaker": "Paimon",
                                    "text": "Klee, do you need a rest?"
                                },
                                {
                                    "id": "102010306",
                                    "speaker": "Paimon",
                                    "text": "Why don't you wait here while we get your treasure back for you?"
                                },
                                {
                                    "id": "102010307",
                                    "speaker": "Klee",
                                    "text": "...No, I'm coming with you!"
                                },
                                {
                                    "id": "102010308",
                                    "speaker": "Klee",
                                    "text": "It's my treasure that Mr. Fluffball stole, and it's up to me to get it back!",
                                    "choices": [
                                        {
                                            "id": "102010309",
                                            "text": "I admire your courage.",
                                            "response": [
                                                {
                                                    "id": "102010311",
                                                    "speaker": "Klee",
                                                    "text": "Hee-hee, don't worry. Klee is a big girl!"
                                                },
                                                {
                                                    "id": "102010312",
                                                    "speaker": "Klee",
                                                    "text": "#Come on, {F#Miss}{M#Mr.} Honorary Knight! Let's goooo!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102010310",
                                            "text": "But these domains can be dangerous."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102010303",
                            "text": "Let's keep up the chase."
                        }
                    ]
                }
            ]
        },
        {
            "id": "1020114",
            "objective": "",
            "dialogues": [
                {
                    "id": "102010601",
                    "speaker": "Paimon",
                    "text": "Game's up. Now hand it over!"
                },
                {
                    "id": "102010602",
                    "speaker": "Abyss Mage",
                    "text": "Grr..."
                },
                {
                    "id": "102010603",
                    "speaker": "Abyss Mage",
                    "text": "You fools think I would give this up so easily after what I have been through to acquire it?"
                },
                {
                    "id": "102010604",
                    "speaker": "Abyss Mage",
                    "text": "Hehe..."
                }
            ]
        },
        {
            "id": "1020104",
            "objective": "Combat I",
            "dialogues": [
                {
                    "id": "102010401",
                    "speaker": "Abyss Mage",
                    "text": "Hmph. You followed me. I must say, I'm impressed."
                },
                {
                    "id": "102010402",
                    "speaker": "Abyss Mage",
                    "text": "But this is as far as you will get."
                },
                {
                    "id": "102010403",
                    "speaker": "Paimon",
                    "text": "Oh yeah? What are you gonna do?"
                },
                {
                    "id": "102010404",
                    "speaker": "Abyss Mage",
                    "text": "Mwuhahaha! Ahahahaha!"
                },
                {
                    "id": "102010405",
                    "speaker": "Abyss Mage",
                    "text": "Oh, the human proclivity to gossip has provided us with everything we need..."
                },
                {
                    "id": "102010406",
                    "speaker": "Abyss Mage",
                    "text": "We learned that your little red friend had in her possession the most powerful treasure in all of Mondstadt."
                },
                {
                    "id": "102010407",
                    "speaker": "Abyss Mage",
                    "text": "That treasure is now in my hands. There is nothing you can do!"
                },
                {
                    "id": "102010408",
                    "speaker": "Abyss Mage",
                    "text": "Now your precious treasure shall be your undoing!"
                },
                {
                    "id": "102010409",
                    "speaker": "Klee",
                    "text": "No, no, wait! D—Don't touch it!"
                },
                {
                    "id": "102010410",
                    "speaker": "Abyss Mage",
                    "text": "Hah! Oh, how you fret now your predicament is finally clear to you!"
                },
                {
                    "id": "102010411",
                    "speaker": "Abyss Mage",
                    "text": "Now, what have we here — a flame symbol? Mwuhahaha..."
                },
                {
                    "id": "102010412",
                    "speaker": "???",
                    "text": "*bang*"
                },
                {
                    "id": "102010501",
                    "speaker": "Klee",
                    "text": "NO!"
                },
                {
                    "id": "102010502",
                    "speaker": "Klee",
                    "text": "I broke the survival rules... \"Explosions can hurt people... Jean can be dreadful...\""
                },
                {
                    "id": "102010503",
                    "speaker": "Klee",
                    "text": "This is it... This time I'm done for... *sobs*"
                },
                {
                    "id": "102010504",
                    "speaker": "Paimon",
                    "text": "..."
                },
                {
                    "id": "102010505",
                    "speaker": "Paimon",
                    "text": "Wait, so Klee's treasure is a bomb!?",
                    "choices": [
                        {
                            "id": "102010506",
                            "text": "That was epic...",
                            "response": [
                                {
                                    "id": "102010508",
                                    "speaker": "Paimon",
                                    "text": "No wonder Klee was rumored to be the strongest fighter in Mondstadt."
                                },
                                {
                                    "id": "102010509",
                                    "speaker": "Paimon",
                                    "text": "Paimon for one is never picking a fight with her. Ever."
                                },
                                {
                                    "id": "102010510",
                                    "speaker": "Paimon",
                                    "text": "Hold on... Why has she gone and run off?",
                                    "choices": [
                                        {
                                            "id": "102010511",
                                            "text": "Something to do with the survival rules...",
                                            "response": [
                                                {
                                                    "id": "102010513",
                                                    "speaker": "Paimon",
                                                    "text": "Seems like it!"
                                                },
                                                {
                                                    "id": "102010514",
                                                    "speaker": "Paimon",
                                                    "text": "Well then, let's head to the <color=#00E1FFFF>Knights' headquarters</color> and report to Jean."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "102010512",
                                            "text": "Something to do with Jean..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "102010507",
                            "text": "It made short work of that Abyss Mage!"
                        }
                    ]
                }
            ]
        },
