    "talks": [
        {
            "id": "45109",
            "objective": "Go to Wolvendom",
            "dialogues": []
        },
        {
            "id": "45101",
            "objective": "Go to Wolvendom",
            "dialogues": [
                {
                    "id": "4510101",
                    "speaker": "Paimon",
                    "text": "This is Wolvendom. People from Mondstadt hardly ever come here..."
                },
                {
                    "id": "4510102",
                    "speaker": "Paimon",
                    "text": "Even though it's not so far away from the city, the environment here is totally untouched. It's a wild place ruled by the laws of nature."
                },
                {
                    "id": "4510103",
                    "speaker": "Paimon",
                    "text": "It's survival of the fittest out here. Even the slimes around here are huuuge!"
                },
                {
                    "id": "4510104",
                    "speaker": "Paimon",
                    "text": "...Like those super-duper massive ones over there!"
                },
                {
                    "id": "4510105",
                    "speaker": "Player",
                    "text": "...Eek, they've seen us! Prepare for battle!"
                }
            ]
        },
        {
            "id": "45102",
            "objective": "Talk to Paimon",
            "dialogues": []
        },
        {
            "id": "45107",
            "objective": "Talk to Paimon",
            "dialogues": []
        },
        {
            "id": "45103",
            "objective": "Defeat the slimes",
            "dialogues": [
                {
                    "id": "4510301",
                    "speaker": "Paimon",
                    "text": "*panting* Th—Thank you— Aaah! Wolves! Ruuuun!"
                },
                {
                    "id": "4510303",
                    "speaker": "???",
                    "text": "Do not worry. Wolves friends. But, you are...?"
                },
                {
                    "id": "4510304",
                    "speaker": "Paimon",
                    "text": "We're just some boring old travelers passing through..."
                },
                {
                    "id": "4510305",
                    "speaker": "???",
                    "text": "Don't smell boring. You smell... *sniff* familiar..."
                },
                {
                    "id": "4510306",
                    "speaker": "Paimon",
                    "text": "...We smell?"
                },
                {
                    "id": "4510307",
                    "speaker": "???",
                    "text": "You smell like Knights of Favonius. They are friends.",
                    "choices": [
                        {
                            "id": "4510308",
                            "text": "What's your name?",
                            "response": [
                                {
                                    "id": "4510310",
                                    "speaker": "Razor",
                                    "text": "I am Razor."
                                },
                                {
                                    "id": "4510311",
                                    "speaker": "Paimon",
                                    "text": "Are you one of the Knights of Favonius too?"
                                },
                                {
                                    "id": "4510312",
                                    "speaker": "Razor",
                                    "text": "I am not."
                                },
                                {
                                    "id": "4510314",
                                    "speaker": "Paimon",
                                    "text": "Huh?"
                                },
                                {
                                    "id": "4510315",
                                    "speaker": "Player",
                                    "text": "What's with the wolf pack?"
                                },
                                {
                                    "id": "4510316",
                                    "speaker": "Razor",
                                    "text": "My wolf pack... they are my family."
                                },
                                {
                                    "id": "4510317",
                                    "speaker": "Paimon",
                                    "text": "...Your family!?"
                                },
                                {
                                    "id": "4510318",
                                    "speaker": "Razor",
                                    "text": "Yes. They raised me. We live together. We are family."
                                },
                                {
                                    "id": "4510319",
                                    "speaker": "Paimon",
                                    "text": "So many questions..."
                                },
                                {
                                    "id": "4510320",
                                    "speaker": "Razor",
                                    "text": "They are angry with me. I help you, exposed our ambush, boar ran away."
                                },
                                {
                                    "id": "4510321",
                                    "speaker": "Paimon",
                                    "text": "#Oh, ah... don't worry, Paimon will get {NICKNAME} to catch you another boar."
                                },
                                {
                                    "id": "4510322",
                                    "speaker": "Paimon",
                                    "text": "#{NICKNAME} is stronger than {M#he}{F#she} looks."
                                },
                                {
                                    "id": "4510323",
                                    "speaker": "Razor",
                                    "text": "N—No need. When knights try to help, wolves go hungry..."
                                },
                                {
                                    "id": "4510324",
                                    "speaker": "Paimon",
                                    "text": "Don't be silly! Wait here — we won't screw this up, just watch!"
                                }
                            ]
                        },
                        {
                            "id": "4510309",
                            "text": "Are you also one of the Knights?",
                            "response": [
                                {
                                    "id": "4510313",
                                    "speaker": "Razor",
                                    "text": "I am Razor. I am no knight."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "45104",
            "objective": "Thank the boy for his help",
            "dialogues": []
        },
        {
            "id": "45105",
            "objective": "Collect enough Raw Meat",
            "dialogues": [
                {
                    "id": "4510501",
                    "speaker": "Razor",
                    "text": "...You really want to help?"
                },
                {
                    "id": "4510502",
                    "speaker": "Razor",
                    "text": "Wolves hunt on instinct. Works every time. But... setting trap sounds fun."
                },
                {
                    "id": "4510503",
                    "speaker": "Razor",
                    "text": "First, we set trap. Next, chase boar in — yes?"
                },
                {
                    "id": "4510504",
                    "speaker": "Razor",
                    "text": "Hope it won't explode..."
                }
            ]
        },
        {
            "id": "45108",
            "objective": "Hunting Tip",
            "dialogues": [
                {
                    "id": "4510801",
                    "speaker": "Paimon",
                    "text": "Ho-ho! Time to show us what you're made of!"
                }
            ]
        },
        {
            "id": "45106",
            "objective": "Give three chunks of Raw Meat to Razor",
            "dialogues": [
                {
                    "id": "4510601",
                    "speaker": "Paimon",
                    "text": "Haha! Told you we could do it!"
                },
                {
                    "id": "4510602",
                    "speaker": "Razor",
                    "text": "I— thanks, but..."
                },
                {
                    "id": "4510603",
                    "speaker": "Razor",
                    "text": "...Wolves catch five or six every hunt... *sigh* Tonight, they go hungry..."
                },
                {
                    "id": "4510604",
                    "speaker": "Paimon",
                    "text": "Uh-oh..."
                },
                {
                    "id": "4510605",
                    "speaker": "Razor",
                    "text": "Don't worry. You tried."
                },
                {
                    "id": "4510606",
                    "speaker": "Razor",
                    "text": "At least you did better than other knight friend... the red one, burny girl."
                },
                {
                    "id": "4510607",
                    "speaker": "Razor",
                    "text": "If she was here, whole mountain is fire. Can't catch even one boar."
                },
                {
                    "id": "4510608",
                    "speaker": "Razor",
                    "text": "I must go now."
                },
                {
                    "id": "4510609",
                    "speaker": "Razor",
                    "text": "Here is not safe. Careful. Always watching."
                },
                {
                    "id": "4510610",
                    "speaker": "Paimon",
                    "text": "What a weirdo..."
                },
                {
                    "id": "4510611",
                    "speaker": "Paimon",
                    "text": "\"Burny girl\"? From the Knights of Favonius? What is he—"
                },
                {
                    "id": "4510612",
                    "speaker": "Paimon",
                    "text": "#{NICKNAME}, who do you think it is?"
                }
            ]
        }
    ]
}