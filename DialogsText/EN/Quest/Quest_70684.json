            "title": ""
        },
        "total_dialogue_lines": 93,
        "total_speaker_counts": {
            "\"Charcoal\"": 3,
            "Black Screen": 2,
            "Paimon": 19,
            "Player": 15,
            "Sansa": 33,
            "Venti": 21
        }
    },
    "talks": [
        {
            "id": "7068401",
            "objective": "Talk to Sansa",
            "dialogues": [
                {
                    "id": "706840101",
                    "speaker": "Sansa",
                    "text": "Uh, h—hi everyone...! I'm Sansa, and I'm a... or, well, I'm working on becoming a bard. Uh... Th—Thanks for coming out today, and um... yeah, uh... I guess I'll start the song now..."
                },
                {
                    "id": "706840102",
                    "speaker": "Sansa",
                    "text": "\"All goes quiet on Starsnatch Cliff. High in the trees, all is...\" Wait, sorry, that's not right."
                },
                {
                    "id": "706840103",
                    "speaker": "Sansa",
                    "text": "\"High in the trees, no whiff of the wind, no sign of... the birds, no flapping of wings...\" Uh, then it goes... \"Pause\"... \"Pause for a moment, and\"..."
                },
                {
                    "id": "706840104",
                    "speaker": "Sansa",
                    "text": "Oh gosh, this is so embarrassing, I'm making a complete mess of this... I didn't get tongue-tied at all on the forty-second time or the ninetieth time, so why can't I get it right now?"
                },
                {
                    "id": "706840105",
                    "speaker": "Paimon",
                    "text": "The forty-second and ninetieth time...?"
                },
                {
                    "id": "706840106",
                    "speaker": "Sansa",
                    "text": "Yep! I rehearsed this a hundred times to try and perfect my performance. So this is my one-hundred-and-first time playing this song, but my first time performing it live..."
                },
                {
                    "id": "706840107",
                    "speaker": "Sansa",
                    "text": "*sigh* I really thought it would go well this time, but nope — I blew it again. Though not for lack of practice, surely... I guess I need to figure out what I was doing right on my forty-second and ninetieth attempts, and keep practicing...",
                    "choices": [
                        {
                            "id": "706840108",
                            "text": "A hundred rehearsals is plenty.",
                            "response": [
                                {
                                    "id": "706840110",
                                    "speaker": "Paimon",
                                    "text": "Right! That amount of practice should have been more than enough. If it still isn't working... Maybe it's more a question of how you've been practicing?"
                                },
                                {
                                    "id": "706840111",
                                    "speaker": "Paimon",
                                    "text": "#Actually, {NICKNAME} here has loads of experience with performing music. Why don't you tell us what your method is? Maybe we can give you some suggestions!",
                                    "choices": [
                                        {
                                            "id": "706840112",
                                            "text": "Oh, please. I dabble.",
                                            "response": [
                                                {
                                                    "id": "706840114",
                                                    "speaker": "Paimon",
                                                    "text": "And, uh, Paimon can give... give you pro tips from an audience perspective! As a highly seasoned and professional audience... person!"
                                                },
                                                {
                                                    "id": "706840115",
                                                    "speaker": "Sansa",
                                                    "text": "Aw... That's so kind of you, I'm touched that you're willing to help me. Gimme a second — lemme just check my notes... or actually, why don't I just give you my notes so you can read them for yourself?"
                                                },
                                                {
                                                    "id": "706840116",
                                                    "speaker": "Paimon",
                                                    "text": "Uh... Notes about what?"
                                                },
                                                {
                                                    "id": "706840117",
                                                    "speaker": "Sansa",
                                                    "text": "Just things I jot down after each practice. Stuff to watch out for, areas to improve on, et cetera... Oh, but you can ignore the second half, that's just my random thoughts on other people's performances and trying out different instruments..."
                                                },
                                                {
                                                    "id": "706840118",
                                                    "speaker": "Black Screen",
                                                    "text": "The worn-out notebook records Sansa's detailed reflections on her rehearsals. But the \"random thoughts\" in the second half are quite verbose... it sounds less like journaling and more like an essay or research report..."
                                                },
                                                {
                                                    "id": "706840119",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa, this is denser than the encyclopedias in the Mondstadt Library! So are you like, a music scholar? Collector? Librarian?"
                                                },
                                                {
                                                    "id": "706840120",
                                                    "speaker": "Sansa",
                                                    "text": "Hehe, well, my parents always hoped I'd become a scholar, so they made me take classes in all of those things and more... But now, I'm applying everything I've learned in academia to becoming a bard!"
                                                },
                                                {
                                                    "id": "706840121",
                                                    "speaker": "Player",
                                                    "text": "That sounds logical... but feels off somehow."
                                                },
                                                {
                                                    "id": "706840122",
                                                    "speaker": "Sansa",
                                                    "text": "#Well, I'm all ears. Where do you think I'm going wrong, {NICKNAME}? Have I misunderstood some core principles of music theory, perhaps? Or am I approaching my rehearsals wrong?",
                                                    "choices": [
                                                        {
                                                            "id": "706840123",
                                                            "text": "Uhh... I'm not sure I'm qualified to answer that...",
                                                            "response": [
                                                                {
                                                                    "id": "706840125",
                                                                    "speaker": "Paimon",
                                                                    "text": "Paimon never knew being a bard was such hard work. The Tone-Deaf Bard always makes it look so easy. He never seems stressed out at all..."
                                                                },
                                                                {
                                                                    "id": "706840126",
                                                                    "speaker": "Paimon",
                                                                    "text": "And still, his singing and lyre playing always sound really great. Hmm, unless he's actually been practicing in secret?"
                                                                },
                                                                {
                                                                    "id": "706840127",
                                                                    "speaker": "Venti",
                                                                    "text": "#Hehe. Looking for me, {NICKNAME}?"
                                                                },
                                                                {
                                                                    "id": "706840128",
                                                                    "speaker": "Sansa",
                                                                    "text": "*gasp* Venti!"
                                                                },
                                                                {
                                                                    "id": "706840129",
                                                                    "speaker": "Paimon",
                                                                    "text": "Aah! Tone-Deaf Bard? Where'd you come from!?"
                                                                },
                                                                {
                                                                    "id": "706840130",
                                                                    "speaker": "Player",
                                                                    "text": "Which wind brought you here?"
                                                                },
                                                                {
                                                                    "id": "706840131",
                                                                    "speaker": "Venti",
                                                                    "text": "Why, the sweet wind of reminiscence, of course. Sweet, with a hint of exotic flora, blowing from a land far away."
                                                                },
                                                                {
                                                                    "id": "706840132",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmph, well Paimon sure hasn't missed that attitude..."
                                                                },
                                                                {
                                                                    "id": "706840133",
                                                                    "speaker": "Venti",
                                                                    "text": "Hehehe. Actually, I was just out taking a stroll in the countryside, when inspiration struck me like an apple falling from a tree. So I grabbed a leaf and hastily wrote down a few lines of verse..."
                                                                },
                                                                {
                                                                    "id": "706840134",
                                                                    "speaker": "Venti",
                                                                    "text": "But before I could finish, there was a \"whoosh\"..."
                                                                },
                                                                {
                                                                    "id": "706840135",
                                                                    "speaker": "Sansa",
                                                                    "text": "...A whoosh?"
                                                                },
                                                                {
                                                                    "id": "706840136",
                                                                    "speaker": "Venti",
                                                                    "text": "Yes, the sound of a mischievous wind who insisted on being the first one to read my new poem. It whipped the leaf right out of my hand and whisked it away. I was about to give chase, but then I saw a dark silhouette appear and grab the leaf in its mouth."
                                                                },
                                                                {
                                                                    "id": "706840137",
                                                                    "speaker": "Venti",
                                                                    "text": "I sneezed a few times, and when I'd recovered, my second avid reader had vanished without a trace."
                                                                },
                                                                {
                                                                    "id": "706840138",
                                                                    "speaker": "Venti",
                                                                    "text": "Now I'm having the urge to sneeze again just thinking about it..."
                                                                },
                                                                {
                                                                    "id": "706840139",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmm, so it must have been a cat that stole the leaf, right? And with your allergies, you can't exactly go chasing it down...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "706840140",
                                                                            "text": "But we can help.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706840142",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "I can help too, Venti! Your music has always been a huge inspiration to me, so it would be my honor!"
                                                                                },
                                                                                {
                                                                                    "id": "706840143",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "And, um... After we find it, could I... get some advice on songwriting from you...?"
                                                                                },
                                                                                {
                                                                                    "id": "706840144",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Sorry! I know I shouldn't spring that on you... I was just worried if I stayed quiet now, I might be too shy to ask later, and I didn't wanna let the opportunity slip by, so... I'm sorry! I hope I didn't make this weird!"
                                                                                },
                                                                                {
                                                                                    "id": "706840145",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Hahaha, it's fine. If problems are the veins on a leaf, inspiration is like the nutrients that flow through them — you've got to grab them when you can."
                                                                                },
                                                                                {
                                                                                    "id": "706840146",
                                                                                    "speaker": "Venti",
                                                                                    "text": "So whatever questions you have, ask away. I'll gladly share my thoughts with you."
                                                                                },
                                                                                {
                                                                                    "id": "706840147",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Wow, really!? Okay, I'll just grab my... Wait, where's my notebook? Oh, it's right here... Sorry, gimme a second!"
                                                                                },
                                                                                {
                                                                                    "id": "706840148",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "Sansa frantically flicks through to the \"Questions\" page in her notebook, takes a deep breath, then explains her background and the issues she's having..."
                                                                                },
                                                                                {
                                                                                    "id": "706840149",
                                                                                    "speaker": "Venti",
                                                                                    "text": "I see... Well, it sounds like you've already mastered music theory and your instrument. I don't think you need my input on either of those."
                                                                                },
                                                                                {
                                                                                    "id": "706840150",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Huh? But then, why did her performance go so badly despite all the effort she put in? There's gotta be a reason for it!"
                                                                                },
                                                                                {
                                                                                    "id": "706840151",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "I guess I just lack that natural talent... Maybe I'm not meant to be a bard, heh..."
                                                                                },
                                                                                {
                                                                                    "id": "706840152",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Do you still remember why you wanted to become a bard in the first place?"
                                                                                },
                                                                                {
                                                                                    "id": "706840153",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Lemme think... Maybe it was a sense of yearning. Back when my parents forced me to stay in my room and study, I'd always hear this bard singing outside the window..."
                                                                                },
                                                                                {
                                                                                    "id": "706840154",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "His wonderful melodies and beautiful voice were like a soft breeze that stirred my heart... I remember thinking to myself... If I became a bard, could I be free, like him?"
                                                                                },
                                                                                {
                                                                                    "id": "706840155",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Yeah, that's it. I wanted to be free and happy just like him. And like him, I wanted to share that joy with the whole world..."
                                                                                },
                                                                                {
                                                                                    "id": "706840156",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "But I get so nervous when I'm performing in front of a crowd. I try to mitigate that by doing plenty of practice to make sure nothing goes wrong, but it's no use. As soon as the performance starts, I get tongue-tied..."
                                                                                },
                                                                                {
                                                                                    "id": "706840157",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Well, I think you are a true bard."
                                                                                },
                                                                                {
                                                                                    "id": "706840158",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "What? But... I can't even get my words out..."
                                                                                },
                                                                                {
                                                                                    "id": "706840159",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Didn't you say that you dreamed of becoming a bard for the sake of freedom and happiness?"
                                                                                },
                                                                                {
                                                                                    "id": "706840160",
                                                                                    "speaker": "Venti",
                                                                                    "text": "A bard's voice is like the wind — nothing can tie it down, and nothing can stand in its way. Otherwise, you wouldn't have heard that bard's voice from your bedroom where you were studying."
                                                                                },
                                                                                {
                                                                                    "id": "706840161",
                                                                                    "speaker": "Venti",
                                                                                    "text": "I do believe you're a true bard. But... there's too much noise in your ears, and you've allowed that to drown out your own thoughts. That's what's holding you back."
                                                                                },
                                                                                {
                                                                                    "id": "706840162",
                                                                                    "speaker": "Player",
                                                                                    "text": "Stop worrying about what other people think."
                                                                                },
                                                                                {
                                                                                    "id": "706840163",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Exactly! If you really wanna share freedom and joy with the world, first you need to be the freest and happiest person of them all!"
                                                                                },
                                                                                {
                                                                                    "id": "706840164",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Nice, Paimon. Sounds like you have the makings of a bard, too."
                                                                                },
                                                                                {
                                                                                    "id": "706840165",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "So I've gotta be my freest, happiest self in order to share that with others... Yeah, that makes a lot of sense! Thank you all so much, I'll be sure to take that to heart!"
                                                                                },
                                                                                {
                                                                                    "id": "706840166",
                                                                                    "speaker": "Venti",
                                                                                    "text": "#Well, since we're all here, why not give it another shot with {NICKNAME} and I accompanying you on our instruments?"
                                                                                },
                                                                                {
                                                                                    "id": "706840167",
                                                                                    "speaker": "Player",
                                                                                    "text": "I'd be happy to."
                                                                                },
                                                                                {
                                                                                    "id": "706840168",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "In that case, Paimon will be the audience. Paimon is the most professional... and freest audience you'll ever find! Hehe."
                                                                                },
                                                                                {
                                                                                    "id": "706840169",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "That was... that was my first ever successful performance in front of a crowd! For once, I didn't stumble over my words. Ah, I'm so happy..."
                                                                                },
                                                                                {
                                                                                    "id": "706840170",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Once the music started, it felt like I became one with the wind. I could roam freely, and nothing could stop me..."
                                                                                },
                                                                                {
                                                                                    "id": "706840171",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "The audience definitely felt it too. Look, even that cat came to check out the show! ...Wait... a cat!?"
                                                                                },
                                                                                {
                                                                                    "id": "706840172",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Aha, it must be my second avid reader! Let's go ask it about its thoughts on my... my... achoo!"
                                                                                },
                                                                                {
                                                                                    "id": "706840173",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Oh, Charcoal, so it was you! I'm sorry, that's my neighbor's cat. Whenever I'm rehearsing, it always comes to sit on the windowsill and listen in..."
                                                                                },
                                                                                {
                                                                                    "id": "706840174",
                                                                                    "speaker": "\"Charcoal\"",
                                                                                    "text": "Meow~"
                                                                                },
                                                                                {
                                                                                    "id": "706840175",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "What was that in its mouth? Was it the leaf with Venti's poem?"
                                                                                },
                                                                                {
                                                                                    "id": "706840176",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "Charcoal, that belongs to Venti. It's very important to him. Could you give it back?"
                                                                                },
                                                                                {
                                                                                    "id": "706840177",
                                                                                    "speaker": "\"Charcoal\"",
                                                                                    "text": "Meow~"
                                                                                },
                                                                                {
                                                                                    "id": "706840178",
                                                                                    "speaker": "Sansa",
                                                                                    "text": "You've helped me so much. I feel bad that I have no way to repay you..."
                                                                                },
                                                                                {
                                                                                    "id": "706840179",
                                                                                    "speaker": "Venti",
                                                                                    "text": "Hey, you've helped me plenty. You got my missing inspiration back, didn't you? That's a huge he... hah.. hachoo!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "706840180",
                                                                                            "text": "Let's ask kitty for a critique.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "706840182",
                                                                                                    "speaker": "\"Charcoal\"",
                                                                                                    "text": "Meow~"
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840183",
                                                                                                    "speaker": "Venti",
                                                                                                    "text": "Aw, you liked it? Whoa, not so close... Achoo! No more peeking! I haven't finished writing it yet!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840184",
                                                                                                    "speaker": "Venti",
                                                                                                    "text": "Whew, what a friendly feline... My friends, I hope to see you at my next performance!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840185",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Gone like the wind..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840186",
                                                                                                    "speaker": "Sansa",
                                                                                                    "text": "I can hardly believe I got a personal lesson from Venti himself... I must find time to thank him properly. ...Oh, and of course, I owe you two a huge thank-you as well."
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840187",
                                                                                                    "speaker": "Sansa",
                                                                                                    "text": "I can't offer much, but... why don't you take this songbook? It's from back when I was studying — I noted down all kinds of tunes from many parts of the world. Maybe you'll find it useful!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840188",
                                                                                                    "speaker": "Sansa",
                                                                                                    "text": "Oh, and as well as tunes, I also collected all kinds of instruments! You're welcome to try them out any time you want. It'd be great to have another musician to trade tips with."
                                                                                                },
                                                                                                {
                                                                                                    "id": "706840189",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hehe, awesome! We'll definitely take you up on that."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "706840181",
                                                                                            "text": "Did you like the poem, kitty?"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "706840141",
                                                                            "text": "I'll ask the cat what it thought of the poem."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706840124",
                                                            "text": "It feels like your efforts are misdirected."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706840113",
                                            "text": "I'm just a hobbyist, but I can share my thoughts if you'd like."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706840109",
                            "text": "Maybe the problem isn't the amount of practice, but something else."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7068402",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706840201",
                    "speaker": "Sansa",
                    "text": "Please take this collection of sheet music."
                },
                {
                    "id": "706840202",
                    "speaker": "Player",
                    "text": "(Take the sheet music collection.)"
                },
                {
                    "id": "706840203",
                    "speaker": "Sansa",
                    "text": "If you want to try out different instruments, feel free to come find me any time."
                }
            ]
        },
        {
            "id": "7068499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "706849901",
                    "speaker": "Paimon",
                    "text": "That's quite a crowd over there. Is someone doing a performance? Let's go see!"
                }
            ]
        }
    ]
}