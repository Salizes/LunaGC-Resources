{
    "quest": {
        "id": "70684",
        "title": "To the Winds of Freedom",
        "description": "The bard Sansa seems to have encountered some problems...",
        "rewards": [
            {
                "itemId": 220110,
                "count": 1
            }
        ],
        "rewards_formatted": "Repertoire of Myriad Melodies x1",
        "chapter": {
            "icon": "",
