    "talks": [
        {
            "id": "7451001",
            "objective": "Talk to the two people at the stall",
            "dialogues": [
                {
                    "id": "745100101",
                    "speaker": "Paimon",
                    "text": "We won! Our Fungi companions did it!"
                },
                {
                    "id": "745100102",
                    "speaker": "Haniyyah",
                    "text": "Hats off to you, you two!"
                },
                {
                    "id": "745100103",
                    "speaker": "Haniyyah",
                    "text": "Your taming talents are beyond common sense, and the Fungi remain undefeated under your command even when facing enemies that themselves defy reason!",
                    "choices": [
                        {
                            "id": "745100104",
                            "text": "Wow, praise from Haniyyah!",
                            "response": [
                                {
                                    "id": "745100106",
                                    "speaker": "Paimon",
                                    "text": "Paimon remembers seeing the Great Snowboar King and Maguu Kenki before, but this time, you even brought out a \"Blade Pup.\""
                                },
                                {
                                    "id": "745100107",
                                    "speaker": "Paimon",
                                    "text": "You really went all out when you set that lineup, huh?"
                                },
                                {
                                    "id": "745100108",
                                    "speaker": "Souka",
                                    "text": "Well, these enemies are all legends in adventurers' stories from all over the world! Our players will definitely resonate with them."
                                },
                                {
                                    "id": "745100109",
                                    "speaker": "Souka",
                                    "text": "As a writer, I'm a huge fan of characters from different works battling one another. I get excited just thinking about it!"
                                },
                                {
                                    "id": "745100110",
                                    "speaker": "Souka",
                                    "text": "Anyway, dear Twin Stars of Brilliant Valor, you've played every stage of our game. What do you think?",
                                    "choices": [
                                        {
                                            "id": "745100111",
                                            "text": "There aren't enough stages.",
                                            "response": [
                                                {
                                                    "id": "745100112",
                                                    "speaker": "Haniyyah",
                                                    "text": "This fits with our second prediction. I suppose we'll have to make more stages based on the highest specs for the next preview event."
                                                },
                                                {
                                                    "id": "745100117",
                                                    "speaker": "Haniyyah",
                                                    "text": "Anyway, Souka will do more research and design more formidable and interesting enemies, so that the game will grow on the Fontainians."
                                                },
                                                {
                                                    "id": "745100118",
                                                    "speaker": "Haniyyah",
                                                    "text": "That way, Fonta, our generous sponsor, will feel confident in continuing to fund us."
                                                },
                                                {
                                                    "id": "745100119",
                                                    "speaker": "Haniyyah",
                                                    "text": "Once we have enough money, we can host a tournament just like the Nilotpala Cup..."
                                                },
                                                {
                                                    "id": "745100120",
                                                    "speaker": "Haniyyah",
                                                    "text": "No, something bigger! And we'll improve the system such that it'll be as exciting and interesting as can be!"
                                                },
                                                {
                                                    "id": "745100121",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, Paimon's getting excited just thinking about it!",
                                                    "choices": [
                                                        {
                                                            "id": "745100122",
                                                            "text": "Let me know if you need help!",
                                                            "response": [
                                                                {
                                                                    "id": "745100124",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "This is a long-term plan, so we're not too concerned about our short-term progress."
                                                                },
                                                                {
                                                                    "id": "745100125",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "With guidance from Souka and Balfour, I can safely say that I'm in the business, too. So don't worry, we shan't trouble you with details!"
                                                                },
                                                                {
                                                                    "id": "745100126",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Even when the preview event and the business negotiations are over, Souka and I will stay in Fontaine for a while, traveling with the Fungi."
                                                                },
                                                                {
                                                                    "id": "745100127",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "We'd like to send you letters periodically to keep you updated on the project, and to let you know how the Fungi are doing."
                                                                },
                                                                {
                                                                    "id": "745100128",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "But that'll require a contact address, or we won't be able to reach you, just like last time..."
                                                                },
                                                                {
                                                                    "id": "745100129",
                                                                    "speaker": "Paimon",
                                                                    "text": "A contact address?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "745100130",
                                                                            "text": "Well, somewhere we go every few days.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "745100132",
                                                                                    "speaker": "Souka",
                                                                                    "text": "Perfect! Then on behalf of Haniyyah and the Fungi, I shall write you two regularly!"
                                                                                },
                                                                                {
                                                                                    "id": "745100133",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "It's a deal, then!"
                                                                                },
                                                                                {
                                                                                    "id": "745100134",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "Our game's still pretty hot right now, so the event will last a while."
                                                                                },
                                                                                {
                                                                                    "id": "745100135",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "If you're not too busy, don't forget to come by!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "745100136",
                                                                                            "text": "Sure thing!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "745100138",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hehe, Paimon's feeling a lot better, now that Haniyyah, Souka, and the Fungi companions won't be far away anymore, and we won't be apart for too long."
                                                                                                },
                                                                                                {
                                                                                                    "id": "745100139",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Paimon's really looking forward to the next Beast Tamers Tournament now. How're things gonna go this time?"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "745100137",
                                                                                            "text": "We have plenty of time!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "745100131",
                                                                            "text": "I guess... the Adventurers' Guild?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745100123",
                                                            "text": "We know a little about management, too!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745100113",
                                            "text": "The number of stages is just right.",
                                            "response": [
                                                {
                                                    "id": "745100114",
                                                    "speaker": "Haniyyah",
                                                    "text": "Thank you! But it might also be that you were busy and didn't have much time for this. We'll prepare more backup stages, just in case."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745100115",
                                            "text": "I'm fine with whatever you come up with, as long as our Fungi companions get more screentime!",
                                            "response": [
                                                {
                                                    "id": "745100116",
                                                    "speaker": "Haniyyah",
                                                    "text": "Ha, you haven't changed. As Souka said, you're our boss now. If there's anything you want to see in the game, just let us know."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745100105",
                            "text": "You were quite formidable, too!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7451002",
            "objective": "Wait till 6:00 – 12:00 the next day",
