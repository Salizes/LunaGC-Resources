    "talks": [
        {
            "id": "7408103",
            "objective": "",
            "dialogues": [
                {
                    "id": "740810301",
                    "speaker": "Paimon",
                    "text": "Whoa... Who knew there was such a huge space under the water, with strange devices too!"
                },
                {
                    "id": "740810302",
                    "speaker": "Paimon",
                    "text": "Paimon doesn't have a clue what that device is for, but it looks like its been abandoned for a long time, and nobody's been here either..."
                },
                {
                    "id": "740810303",
                    "speaker": "Paimon",
                    "text": "Let's be careful!"
                }
            ]
        },
