    "talks": [
        {
            "id": "7565201",
            "objective": "",
            "dialogues": [
                {
                    "id": "756520201",
                    "speaker": "Amber",
                    "text": "#Hey, it's you, {NICKNAME}! Fancy meeting you in the Whispering Woods again. What are the odds?"
                },
                {
                    "id": "756520202",
                    "speaker": "Amber",
                    "text": "It's been a while, hasn't it? What've you been busy with lately?",
                    "choices": [
                        {
                            "id": "756520203",
                            "text": "Taking photos to keep a record of the places we've been.",
                            "response": [
                                {
                                    "id": "756520205",
                                    "speaker": "Amber",
                                    "text": "Haha, that makes sense! This place is so beautiful and serene, it really does make for good photos."
                                },
                                {
                                    "id": "756520206",
                                    "speaker": "Amber",
                                    "text": "This is my favorite patrol segment when I'm out on scouting missions."
                                },
                                {
                                    "id": "756520207",
                                    "speaker": "Amber",
                                    "text": "This was where we met for the first time, too. I even mistook you for some kind of suspicious character back then, too! Ah, I'm getting embarrassed just thinking about it..."
                                },
                                {
                                    "id": "756520208",
                                    "speaker": "Amber",
                                    "text": "After all, it was thanks to your help that we averted the crisis with Dvalin, and restored peace to Mondstadt."
                                },
                                {
                                    "id": "756520209",
                                    "speaker": "Amber",
                                    "text": "#But your {M#sister}{F#brother}... I put up so many missing posters, but it seems like it wasn't of any help...",
                                    "choices": [
                                        {
                                            "id": "756520210",
                                            "text": "It's fine, Amber.",
                                            "response": [
                                                {
                                                    "id": "756520212",
                                                    "speaker": "Amber",
                                                    "text": "Thanks. But still, please feel free to tell me if there's anything I can help you with."
                                                },
                                                {
                                                    "id": "756520213",
                                                    "speaker": "Amber",
                                                    "text": "Amber, Outrider of the Knights of Favonius, Mondstadt's Gliding Champion, and your friend — at your service!"
                                                },
                                                {
                                                    "id": "756520214",
                                                    "speaker": "Player",
                                                    "text": "In that case, step into the frame, please!"
                                                },
                                                {
                                                    "id": "756520215",
                                                    "speaker": "Amber",
                                                    "text": "No problem! What kind of pose do you think I should do?",
                                                    "choices": [
                                                        {
                                                            "id": "756520216",
                                                            "text": "A cool pose.",
                                                            "response": [
                                                                {
                                                                    "id": "756520219",
                                                                    "speaker": "Amber",
                                                                    "text": "Sure. Will this work?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756520220",
                                                                            "text": "Awesome. Say cheese!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520221",
                                                                                    "speaker": "Amber",
                                                                                    "text": "I'm ready."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520222",
                                                                            "text": "The fun pose might work better.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520223",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Sure!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520224",
                                                                            "text": "Let's roll with the formal pose instead.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756520225",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Alright then!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756520226",
                                                                            "text": "Let's go with the cool pose instead."
                                                                        },
                                                                        {
                                                                            "id": "756520227",
                                                                            "text": "Let me think about it a bit more."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756520217",
                                                            "text": "Let's go with a fun pose!"
                                                        },
                                                        {
                                                            "id": "756520218",
                                                            "text": "A formal pose."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756520211",
                                            "text": "You did all you could."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756520204",
                            "text": "Taking photos to commemorate my legendary career with."
                        }
                    ]
                }
            ]
        }
    ]
