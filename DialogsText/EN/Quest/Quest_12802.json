    "talks": [
        {
            "id": "1280201",
            "objective": "",
            "dialogues": [
                {
                    "id": "698390101",
                    "speaker": "Gendou Ringo",
                    "text": "#Hello, {NICKNAME}. Are you here for a fortune slip? Apologies, but now isn't the best time."
                },
                {
                    "id": "698390102",
                    "speaker": "Player",
                    "text": "I mean... I still see three boxes, so your stall's ready, right?"
                },
                {
                    "id": "698390103",
                    "speaker": "Gendou Ringo",
                    "text": "It is, and so are the bamboo slips within. However, we've run out of the corresponding fortune slips... That is, the paper slips expounding on the fortune.",
                    "choices": [
                        {
                            "id": "698390104",
                            "text": "That's a thing that happens?",
                            "response": [
                                {
                                    "id": "698390106",
                                    "speaker": "Gendou Ringo",
                                    "text": "That depends on your fortune. We are currently preparing new slips."
                                },
                                {
                                    "id": "698390107",
                                    "speaker": "Player",
                                    "text": "And how do I check that fortune?"
                                },
                                {
                                    "id": "698390108",
                                    "speaker": "Gendou Ringo",
                                    "text": "Draw a slip."
                                },
                                {
                                    "id": "698390109",
                                    "speaker": "Player",
                                    "text": "...And when can I draw a slip?"
                                },
                                {
                                    "id": "698390110",
                                    "speaker": "Gendou Ringo",
                                    "text": "That depends on your fortune.",
                                    "choices": [
                                        {
                                            "id": "698390111",
                                            "text": "...We're going in circles, you know.",
                                            "response": [
                                                {
                                                    "id": "698390112",
                                                    "speaker": "Gendou Ringo",
                                                    "text": "We are — and you've looped around to great fortune indeed."
                                                },
                                                {
                                                    "id": "698390115",
                                                    "speaker": "Player",
                                                    "text": "Wait. How do you know that?"
                                                },
                                                {
                                                    "id": "698390116",
                                                    "speaker": "Yae Miko",
                                                    "text": "Oh my. I was just wondering who wandered by... Why, it's you, little one! Are you here for a fortune slip?",
                                                    "choices": [
                                                        {
                                                            "id": "698390117",
                                                            "text": "That's right.",
                                                            "response": [
                                                                {
                                                                    "id": "698390119",
                                                                    "speaker": "Yae Miko",
                                                                    "text": "That they are, yes! Everyone in Inazuma seems to be getting more anxious by the year. Oh, won't someone think of the rising paper consumption..."
                                                                },
                                                                {
                                                                    "id": "698390120",
                                                                    "speaker": "Yae Miko",
                                                                    "text": "We just restocked earlier, too, and poof! Gone again. Even the \"great fortune\" slips are nearly gone. *sigh* Truly, the troubles of being a Guuji never cease..."
                                                                },
                                                                {
                                                                    "id": "698390121",
                                                                    "speaker": "Yae Miko",
                                                                    "text": "Still, you're in luck today. Here you are, Ringo. 300 fresh \"good fortune\" slips, written by yours truly in a single sitting. Should be enough to tide us over.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698390122",
                                                                            "text": "Th—Three hundred!?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698390124",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "Well now... That depends on everyone's fortune, of course."
                                                                                },
                                                                                {
                                                                                    "id": "698390125",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "Now, little one, aren't you here to seek yours? Go on. I'll cover your eyes while you draw a slip."
                                                                                },
                                                                                {
                                                                                    "id": "698390126",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "Now, be sure to draw well! These aren't your everyday fortunes, you know. These are Guuji Yae's special slips!"
                                                                                },
                                                                                {
                                                                                    "id": "698390127",
                                                                                    "speaker": "Yae Miko",
                                                                                    "text": "See? Ringo was right. Yours is a \"great fortune\" after all.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698390128",
                                                                                            "text": "You heard that? How?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698390129",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Oh, come now. You're in the Grand Narukami Shrine. Is it so strange that my ears would be a little sharper within its bounds?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390132",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "This fortune slip was personally written by the current Guuji of the Grand Narukami Shrine herself, Yae Miko, so it's quite potent. Guard it well, lest it ends up in the hands of a tanuki or baku."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390133",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Alright then. As always, I leave the rest to you, Ringo."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390134",
                                                                                                    "speaker": "Gendou Ringo",
                                                                                                    "text": "Yes, Lady Guuji."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390135",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "Huh? By the rest, you mean..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390136",
                                                                                                    "speaker": "Gendou Ringo",
                                                                                                    "text": "That's exactly what she means. What Lady Guuji wrote were the \"good\" fortune slips. The bad ones are yet to be completed."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390137",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Alas, any fortune I write would simply be too potent. Surely, such power shouldn't be used to foretell doom and gloom?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390138",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Safer, then, to have dear Ringo pen the \"Misfortune\" slips. The well-being of every visitor to our shrine is at stake!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698390139",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Now, I'm off to write the Modest Fortunes. Do enjoy your wonderful fortune today, little one.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "698390140",
                                                                                                            "text": "She's just trying to slack off, isn't she?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "698390142",
                                                                                                                    "speaker": "Gendou Ringo",
                                                                                                                    "text": "#...Please enjoy your wonderful fortune today, {NICKNAME}."
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "698390141",
                                                                                                            "text": "Nothing but an excuse to get out of writing too many fortunes."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698390130",
                                                                                            "text": "Miko, did you...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698390131",
                                                                                                    "speaker": "Yae Miko",
                                                                                                    "text": "Shh. Now, now. Don't let the whole world know, or youkai might come and snatch your good luck away."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698390123",
                                                                            "text": "And just how long will it take to go through those!?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698390118",
                                                            "text": "But Ringo here said they were long gone."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698390113",
                                            "text": "And how long are we going to do this?",
                                            "response": [
                                                {
                                                    "id": "698390114",
                                                    "speaker": "Gendou Ringo",
                                                    "text": "Till right about... now. Congratulations on your great fortune."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698390105",
                            "text": "So, when will I be able to draw one?"
                        }
                    ]
                }
            ]
        }
    ]
}