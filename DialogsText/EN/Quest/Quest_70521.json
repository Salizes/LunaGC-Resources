    "talks": [
        {
            "id": "7052101",
            "objective": "",
            "dialogues": [
                {
                    "id": "705210101",
                    "speaker": "Paimon",
                    "text": "Eula, Amber, you're here!"
                },
                {
                    "id": "705210102",
                    "speaker": "Eula",
                    "text": "Ah. Found you."
                },
                {
                    "id": "705210103",
                    "speaker": "Paimon",
                    "text": "Huh? Wait, you came here looking for us?"
                },
                {
                    "id": "705210104",
                    "speaker": "Amber",
                    "text": "Of course! Do you have any idea how popular your charity stall is? Everyone's been talking about it..."
                },
                {
                    "id": "705210105",
                    "speaker": "Amber",
                    "text": "\"Favonian Goodies and Buddies, run by the Honorary Knight and their sidekick, is selling all kinds of fantastic treasures — and even giving away some wonderful others for FREE! Don't miss out!\""
                },
                {
                    "id": "705210106",
                    "speaker": "Paimon",
                    "text": "Ugh, so after all that, Paimon's back to being the sidekick? Hmm... Still, Paimon's really happy to hear that people are giving good reviews!",
                    "choices": [
                        {
                            "id": "705210107",
                            "text": "It's all thanks to our customers.",
                            "response": [
                                {
                                    "id": "705210109",
                                    "speaker": "Paimon",
                                    "text": "Anyway, what have you two been up to these days? Did you go off on a trip or something? We haven't seen you around all festival."
                                },
                                {
                                    "id": "705210110",
                                    "speaker": "Amber",
                                    "text": "Haha, that's because we're still working."
                                },
                                {
                                    "id": "705210111",
                                    "speaker": "Paimon",
                                    "text": "Huh? You still have to work?",
                                    "choices": [
                                        {
                                            "id": "705210112",
                                            "text": "You don't get any time off during the festival?",
                                            "response": [
                                                {
                                                    "id": "705210114",
                                                    "speaker": "Eula",
                                                    "text": "Technically, Amber and I are on a \"vacation schedule.\""
                                                },
                                                {
                                                    "id": "705210115",
                                                    "speaker": "Eula",
                                                    "text": "There are more merchant caravans than usual traveling the route between Dornman Port and Mondstadt City during the festival. Extra traffic means extra security is required."
                                                },
                                                {
                                                    "id": "705210116",
                                                    "speaker": "Paimon",
                                                    "text": "Because of monsters and bandits and stuff?"
                                                },
                                                {
                                                    "id": "705210117",
                                                    "speaker": "Eula",
                                                    "text": "Yes. The Reconnaissance Company is tasked with patrolling this route during the festive period..."
                                                },
                                                {
                                                    "id": "705210118",
                                                    "speaker": "Eula",
                                                    "text": "As well as traveling with the caravans to ensure essential goods are delivered without incident, we have to investigate suspicious locations to eliminate any emerging threats."
                                                },
                                                {
                                                    "id": "705210119",
                                                    "speaker": "Paimon",
                                                    "text": "Whew, that seems like a lot of work... sounds like you'll be working non-stop around the clock right up until the end of the Weinlesefest!"
                                                },
                                                {
                                                    "id": "705210120",
                                                    "speaker": "Eula",
                                                    "text": "Of course not. We take shifts."
                                                },
                                                {
                                                    "id": "705210121",
                                                    "speaker": "Eula",
                                                    "text": "While one team is on duty, another is resting, and a third team is on standby in case of emergencies."
                                                },
                                                {
                                                    "id": "705210122",
                                                    "speaker": "Eula",
                                                    "text": "These three teams rotate periodically."
                                                },
                                                {
                                                    "id": "705210123",
                                                    "speaker": "Amber",
                                                    "text": "Eula's such an experienced captain. She arranged everything this way so that the Reconnaissance Company can meet the intense demand during the festival, while still giving everyone a chance to take some time off. Gotta say, great organizing, Eula!"
                                                },
                                                {
                                                    "id": "705210124",
                                                    "speaker": "Eula",
                                                    "text": "Yes, alright, Amber. I did my job, like I always do. I really don't see what the fuss is all about...",
                                                    "choices": [
                                                        {
                                                            "id": "705210125",
                                                            "text": "Quite the glowing review, Outrider.",
                                                            "response": [
                                                                {
                                                                    "id": "705210126",
                                                                    "speaker": "Amber",
                                                                    "text": "Hehehe, that's not the half of it. When you've got the time, I should tell you the story of when Eula got made captain. Now that's a good one."
                                                                },
                                                                {
                                                                    "id": "705210129",
                                                                    "speaker": "Amber",
                                                                    "text": "Ahem... Anyway, we didn't come here just to chit-chat... I'll let Eula do the honors."
                                                                },
                                                                {
                                                                    "id": "705210130",
                                                                    "speaker": "Eula",
                                                                    "text": "Okay. I need 40 portions of Knights' Special Northern Smoked Chicken, and 40 of Favonius-Favored Pile 'Em Up..."
                                                                },
                                                                {
                                                                    "id": "705210131",
                                                                    "speaker": "Paimon",
                                                                    "text": "That's such a huge order! What's the occasion?"
                                                                },
                                                                {
                                                                    "id": "705210132",
                                                                    "speaker": "Paimon",
                                                                    "text": "Wait... are the Knights of Favonius having an official feast? How come nobody told us about it..."
                                                                },
                                                                {
                                                                    "id": "705210133",
                                                                    "speaker": "Amber",
                                                                    "text": "Haha, nothing quite as glamorous as all that. Captain Eula wants some supplies to reward her team members with."
                                                                },
                                                                {
                                                                    "id": "705210134",
                                                                    "speaker": "Eula",
                                                                    "text": "Correct. Scouts use up an enormous amount of energy in a single day. Each meal, they eat enough to feed, hmm... four to five normal people."
                                                                },
                                                                {
                                                                    "id": "705210135",
                                                                    "speaker": "Eula",
                                                                    "text": "Plus, a long-standing member has recently returned to our ranks after a long absence. I thought it would be fitting to celebrate the occasion."
                                                                },
                                                                {
                                                                    "id": "705210136",
                                                                    "speaker": "Eula",
                                                                    "text": "Of all the things I could have bought, I thought it would be best to have the money go to you. That way, I can support a charitable cause while I'm at it."
                                                                },
                                                                {
                                                                    "id": "705210137",
                                                                    "speaker": "Paimon",
                                                                    "text": "Paimon agrees! You made the right decision, Eula! It's what we business owners call a win-win situation!"
                                                                },
                                                                {
                                                                    "id": "705210138",
                                                                    "speaker": "Player",
                                                                    "text": "Thank you for your generous contribution!"
                                                                },
                                                                {
                                                                    "id": "705210139",
                                                                    "speaker": "Paimon",
                                                                    "text": "Also, about this \"long-standing member\" you mentioned... Is it that guy we met recently...?"
                                                                },
                                                                {
                                                                    "id": "705210140",
                                                                    "speaker": "Eula",
                                                                    "text": "Mika, the front-line land surveyor. He was a vital member of our team before the Grand Master borrowed him for the expedition."
                                                                },
                                                                {
                                                                    "id": "705210141",
                                                                    "speaker": "Paimon",
                                                                    "text": "Mika, yeah, that's the one! Paimon never would've thought that shy little guy was such a strong knight!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705210142",
                                                                            "text": "But he seemed scared of us.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705210144",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Mika's not afraid of you guys. That was his way of showing respect to you... although admittedly it is kind of a roundabout way of doing it."
                                                                                },
                                                                                {
                                                                                    "id": "705210145",
                                                                                    "speaker": "Amber",
                                                                                    "text": "He thinks all mighty people have unique personalities, and prefers to understand what makes them tick and the way they think before properly interacting with them."
                                                                                },
                                                                                {
                                                                                    "id": "705210146",
                                                                                    "speaker": "Amber",
                                                                                    "text": "He says it makes it easier to communicate that way."
                                                                                },
                                                                                {
                                                                                    "id": "705210147",
                                                                                    "speaker": "Eula",
                                                                                    "text": "He was the same way toward me and Amber at first. As we gradually got to know each other, he started acting more naturally."
                                                                                },
                                                                                {
                                                                                    "id": "705210148",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Interesting... sounds like Mika's the one with the unique personality.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705210149",
                                                                                            "text": "I'll remember that.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705210151",
                                                                                                    "speaker": "Eula",
                                                                                                    "text": "Mm-hmm. It'll just take a little time, that's all."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210152",
                                                                                                    "speaker": "Eula",
                                                                                                    "text": "You are a high-profile figure within the Knights of Favonius. As his commanding officer, I have a duty to make sure no misunderstandings arise between you."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210153",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Heh, it's alright, Eula, we get it. You're just looking after him."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210154",
                                                                                                    "speaker": "Amber",
                                                                                                    "text": "Wait! Eula, did you just pay for my portion, too?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210155",
                                                                                                    "speaker": "Amber",
                                                                                                    "text": "I was supposed to pay for mine separately... I'm not an official member of the Reconnaissance Company."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210156",
                                                                                                    "speaker": "Eula",
                                                                                                    "text": "If you want to get official about it, then fine: it's officially my treat. There, now stop worrying."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210157",
                                                                                                    "speaker": "Black Screen",
                                                                                                    "text": "You hand Eula and Amber the meals they purchased. They thank you and leave."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210158",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Ooh, thanks to Eula and Amber, we made a whole day's worth of Mora in one fell swoop!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210159",
                                                                                                    "speaker": "Bernhard",
                                                                                                    "text": "Honorary Knight, Paimon! I have the most wonderful news—"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210160",
                                                                                                    "speaker": "Bernhard",
                                                                                                    "text": "Thanks to your sterling efforts, the funds we've raised in this charity sale have blown our original predictions right out of the water! It's a phenomenal success!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705210161",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Paimon told you so! We're good at this stuff.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705210162",
                                                                                                            "text": "Great work, everyone.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705210164",
                                                                                                                    "speaker": "Bernhard",
                                                                                                                    "text": "Ah, but you two deserve all the credit. It's your expert management that made this event what it was."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210165",
                                                                                                                    "speaker": "Bernhard",
                                                                                                                    "text": "I've handed over all the revenue to the person responsible for managing our charitable funds. And with that, the event finally comes to a close."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210166",
                                                                                                                    "speaker": "Bernhard",
                                                                                                                    "text": "As a gesture of our appreciation, we'd like to give you both a fee for all your hard work. You've more than earned it!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210167",
                                                                                                                    "speaker": "Bernhard",
                                                                                                                    "text": "After this, I feel like I could even run a shop of my own in the future! Haha, maybe we'll get the chance to work together one day!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210168",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "It feels like we accomplished a lot together!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705210169",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "If the chance ever comes up, let's do it again!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705210163",
                                                                                                            "text": "You did great as well, Bernhard."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705210150",
                                                                                            "text": "I'm sure we'll get along just fine."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705210143",
                                                                            "text": "He barely said two words before running away..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705210127",
                                                            "text": "Captain Eula, you are an inspiration to us all.",
                                                            "response": [
                                                                {
                                                                    "id": "705210128",
                                                                    "speaker": "Eula",
                                                                    "text": "Enough. Both of you. The festive spirit is turning you into giddy little children."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705210113",
                                            "text": "You got stuck with the holiday shift, huh?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705210108",
                            "text": "We owe everything to them."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052102",
            "objective": "Go back to the shop and check how the charity event is going",
            "dialogues": []
        },
        {
            "id": "7052199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705219901",
                    "speaker": "Paimon",
                    "text": "Time really flies. The charity sale has been going on for a long time now. Paimon wonders how much money we've made..."
                },
                {
                    "id": "705219902",
                    "speaker": "Paimon",
                    "text": "Let's go back to Favonian Goodies and Buddies and take a look!"
                }
            ]
        }
    ]
}