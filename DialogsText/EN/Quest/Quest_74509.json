    "talks": [
        {
            "id": "7450901",
            "objective": "Talk to the two people at the stall",
            "dialogues": [
                {
                    "id": "745090101",
                    "speaker": "Black Screen",
                    "text": "After a while, you and Paimon arrive at the Lil' Fungi's Fun-Tastic Fiesta booth..."
                },
                {
                    "id": "745090102",
                    "speaker": "Souka",
                    "text": "Oh, the Twin Stars of Brilliant Valor! Are you back for more of Lil' Fungi's Fun-Tastic Fiesta?"
                },
                {
                    "id": "745090103",
                    "speaker": "Souka",
                    "text": "Ms. Enghiene received orders to return to the Maison Gardiennage, so I'll be playing against you for now!"
                },
                {
                    "id": "745090104",
                    "speaker": "Paimon",
                    "text": "Hey, Souka! You're back!"
                },
                {
                    "id": "745090105",
                    "speaker": "Paimon",
                    "text": "Paimon was pretty surprised when we met Haniyyah, but you've taken it to the next level! Your outfit is so... Well, you sure are enthusiastic!"
                },
                {
                    "id": "745090106",
                    "speaker": "Souka",
                    "text": "And that's a good thing, because I have a lot of work... I need to stay motivated."
                },
                {
                    "id": "745090107",
                    "speaker": "Souka",
                    "text": "And that's why I'll cut my problems down, one clean axe-swing at a time!",
                    "choices": [
                        {
                            "id": "745090108",
                            "text": "How are things at the newspaper?",
                            "response": [
                                {
                                    "id": "745090110",
                                    "speaker": "Souka",
                                    "text": "Our plan is progressing steadily. Novel events like these attract a lot of attention, and the paper won't miss any promotion opportunities!"
                                },
                                {
                                    "id": "745090111",
                                    "speaker": "Souka",
                                    "text": "We didn't get the most important page, but it's clear that the event's becoming more popular."
                                },
                                {
                                    "id": "745090112",
                                    "speaker": "Haniyyah",
                                    "text": "That's right. We've seen an increase in ordinary citizens who wanted to give our game a try recently."
                                },
                                {
                                    "id": "745090113",
                                    "speaker": "Haniyyah",
                                    "text": "Many have been talking about what's the best Fungi team with which to win a round quickly."
                                },
                                {
                                    "id": "745090114",
                                    "speaker": "Haniyyah",
                                    "text": "I've also heard that people have been looking to play against you two, so they can see how the experts play.",
                                    "choices": [
                                        {
                                            "id": "745090115",
                                            "text": "We'd like to keep a low profile.",
                                            "response": [
                                                {
                                                    "id": "745090117",
                                                    "speaker": "Paimon",
                                                    "text": "Unless the two of you play against us, of course. You know our strategies very well already..."
                                                },
                                                {
                                                    "id": "745090118",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon thinks a match between you and us... will be a real test of technique!"
                                                },
                                                {
                                                    "id": "745090119",
                                                    "speaker": "Souka",
                                                    "text": "Well, you're here now, so why don't we play a friendly round?"
                                                },
                                                {
                                                    "id": "745090120",
                                                    "speaker": "Souka",
                                                    "text": "Come to think of it, the last time we went head-to-head with you was during the first Nilotpala Cup Beast Tamers Tournament, where you beat me most soundly."
                                                },
                                                {
                                                    "id": "745090121",
                                                    "speaker": "Souka",
                                                    "text": "How nostalgic. After that, Haniyyah and I went through a lot together, and many things changed. I bet it was the same with you."
                                                },
                                                {
                                                    "id": "745090122",
                                                    "speaker": "Souka",
                                                    "text": "But your... seasoned courage and fearless aura are still as unwavering and sturdy as crystal."
                                                },
                                                {
                                                    "id": "745090123",
                                                    "speaker": "Souka",
                                                    "text": "That alone was enough for us to decide that we'd follow you, back when we were preparing Fungus Mechanicus. I think we made the right choice!"
                                                },
                                                {
                                                    "id": "745090124",
                                                    "speaker": "Paimon",
                                                    "text": "Uh, why are you reminiscing all of a sudden? Is it something that writers do?",
                                                    "choices": [
                                                        {
                                                            "id": "745090125",
                                                            "text": "I miss those times, too.",
                                                            "response": [
                                                                {
                                                                    "id": "745090127",
                                                                    "speaker": "Souka",
                                                                    "text": "Yes! What an incredible line!"
                                                                },
                                                                {
                                                                    "id": "745090128",
                                                                    "speaker": "Souka",
                                                                    "text": "Anyway, as one of the designers of the game, I've got an ace up my sleeve!"
                                                                },
                                                                {
                                                                    "id": "745090129",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Are you talking about \"that,\" Souka?"
                                                                },
                                                                {
                                                                    "id": "745090130",
                                                                    "speaker": "Souka",
                                                                    "text": "That's right. I'll get started, and then Haniyyah will control powerful opponents against you. It should make for an exciting match!"
                                                                },
                                                                {
                                                                    "id": "745090131",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "Let's do this, Golden Comet, Silver Companion!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "745090132",
                                                                            "text": "Alright!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "745090134",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "After all this time, you're going up against Haniyyah again... Ooh, this is so exciting!"
                                                                                },
                                                                                {
                                                                                    "id": "745090135",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "But this is a friendly match, so let's just have fun!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "745090133",
                                                                            "text": "It's on!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745090126",
                                                            "text": "We can make new memories together."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745090116",
                                            "text": "Alas, so many people, and such hurry to lose..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745090109",
                            "text": "How are the advertisements coming along?"
                        }
                    ]
                }
            ]
        },
        {
