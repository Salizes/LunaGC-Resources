    "talks": [
        {
            "id": "35401",
            "objective": "Keep heading towards Mondstadt",
            "dialogues": []
        },
        {
            "id": "35402",
            "objective": "Talk to the perky girl",
            "dialogues": [
                {
                    "id": "3540401",
                    "speaker": "???",
                    "text": "May the Anemo God protect you, stranger!"
                },
                {
                    "id": "3540402",
                    "speaker": "Amber",
                    "text": "I am Amber, Outrider for the Knights of Favonius."
                },
                {
                    "id": "3540403",
                    "speaker": "Amber",
                    "text": "You don't look like citizens of Mondstadt. Explain yourselves!"
                },
                {
                    "id": "3540404",
                    "speaker": "Paimon",
                    "text": "We're not looking for trouble."
                },
                {
                    "id": "3540405",
                    "speaker": "Amber",
                    "text": "That's what all the troublemakers say."
                },
                {
                    "id": "3540406",
                    "speaker": "Player",
                    "text": "#Hello, I'm {NICKNAME}."
                },
                {
                    "id": "3540407",
                    "speaker": "Amber",
                    "text": "...Doesn't sound like a local name to me."
                },
                {
                    "id": "3540408",
                    "speaker": "Amber",
                    "text": "And this... mascot, what's the deal with it?",
                    "choices": [
                        {
                            "id": "3540409",
                            "text": "We're friends.",
                            "response": [
                                {
                                    "id": "3540410",
                                    "speaker": "Paimon",
                                    "text": "We've only been traveling partners for two months, but..."
                                },
                                {
                                    "id": "3540411",
                                    "speaker": "Paimon",
                                    "text": "We've already become the very best of friends!"
                                },
                                {
                                    "id": "3540414",
                                    "speaker": "Amber",
                                    "text": "So to sum it up, you're traveling partners, right?"
                                },
                                {
                                    "id": "3540415",
                                    "speaker": "Amber",
                                    "text": "Well look, there's been a large dragon sighted around Mondstadt recently. Best you get inside the city as soon as possible."
                                },
                                {
                                    "id": "3540416",
                                    "speaker": "Amber",
                                    "text": "It's not far from here, I'll escort you there."
                                },
                                {
                                    "id": "3540417",
                                    "speaker": "Paimon",
                                    "text": "Oh? Aren't you out here for some other reason?"
                                },
                                {
                                    "id": "3540418",
                                    "speaker": "Amber",
                                    "text": "I am. But not to worry, I can keep you both safe while doing that too."
                                },
                                {
                                    "id": "3540419",
                                    "speaker": "Amber",
                                    "text": "Besides... I'm still not sure if I can trust you two just yet!",
                                    "choices": [
                                        {
                                            "id": "3540420",
                                            "text": "Why so suspicious?",
                                            "response": [
                                                {
                                                    "id": "3540422",
                                                    "speaker": "Amber",
                                                    "text": "Oh, ahh... I'm sorry. Probably not something I should say as a knight."
                                                },
                                                {
                                                    "id": "3540423",
                                                    "speaker": "Amber",
                                                    "text": "I give you my apologies, uh... strange yet... respectable travelers."
                                                },
                                                {
                                                    "id": "3540424",
                                                    "speaker": "Paimon",
                                                    "text": "That sounded so fake!"
                                                },
                                                {
                                                    "id": "3540425",
                                                    "speaker": "Amber",
                                                    "text": "Do you have something against the type of language usage prescribed by the Knights of Favonius Handbook!?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3540421",
                                            "text": "That's a rather rude way to speak to guests."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3540412",
                            "text": "Emergency food.",
                            "response": [
                                {
                                    "id": "3540413",
                                    "speaker": "Paimon",
                                    "text": "Hey! That's even worse than being a mascot!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
