    "talks": [
        {
            "id": "7226201",
            "objective": "",
            "dialogues": [
                {
                    "id": "722620101",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Ooh. The sea here is pretty."
                },
                {
                    "id": "722620102",
                    "speaker": "Paimon",
                    "text": "Eh? Dihua Marsh isn't a sea."
                },
                {
                    "id": "722620103",
                    "speaker": "Player",
                    "text": "Its waters are connected to the sea, though..."
                },
                {
                    "id": "722620104",
                    "speaker": "Paimon",
                    "text": "Hmm, that's true... but it still feels wrong to call Dihua Marsh the sea."
                },
                {
                    "id": "722620105",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Mm... Not really understanding. \"Sea\" and \"Not the Sea,\" what's the difference?",
                    "choices": [
                        {
                            "id": "722620106",
                            "text": "The taste of the water?",
                            "response": [
                                {
                                    "id": "722620107",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Ooh! Forest water is a bit sweet, so not the sea!"
                                },
                                {
                                    "id": "722620108",
                                    "speaker": "Paimon",
                                    "text": "But if Cider Lake is full of cider, what would it count as...?"
                                },
                                {
                                    "id": "722620109",
                                    "speaker": "Player",
                                    "text": "Something Venti would truly love."
                                },
                                {
                                    "id": "722620120",
                                    "speaker": "Paimon",
                                    "text": "That issue aside, though. Is it just Paimon, or is Kichiboushi getting better at speaking?",
                                    "choices": [
                                        {
                                            "id": "722620121",
                                            "text": "According to what Ioroi said before...",
                                            "response": [
                                                {
                                                    "id": "722620123",
                                                    "speaker": "Paimon",
                                                    "text": "What did Ioroi say again? \"I am the renowned bake-danuki, Ioroi\"... Uh, no, that's not it..."
                                                },
                                                {
                                                    "id": "722620124",
                                                    "speaker": "Paimon",
                                                    "text": "\"Ooh... I do so wish to scratch mine belly.\" \"Oh...!\" Hmm, that's not it, either."
                                                },
                                                {
                                                    "id": "722620125",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "Mmhaha, Paimon good at imitator. Very funny!"
                                                },
                                                {
                                                    "id": "722620126",
                                                    "speaker": "Player",
                                                    "text": "\"As we get more used to Kichiboushi's aura...\""
                                                },
                                                {
                                                    "id": "722620127",
                                                    "speaker": "Paimon",
                                                    "text": "Oh yeah, that's right! The more used we are to Kichiboushi's aura, the better we'll be able to understand him!"
                                                },
                                                {
                                                    "id": "722620128",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "#And training, mm! Kichiboushi going with {NICKNAME} and Paimon, learning lots of new things!",
                                                    "choices": [
                                                        {
                                                            "id": "722620129",
                                                            "text": "Paimon's a good guide, eh?",
                                                            "response": [
                                                                {
                                                                    "id": "722620130",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh..."
                                                                },
                                                                {
                                                                    "id": "722620131",
                                                                    "speaker": "Paimon",
                                                                    "text": "#You remember all that from back then, huh, {NICKNAME}? That's nice of you..."
                                                                },
                                                                {
                                                                    "id": "722620132",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "#Mm! Thank you, Paimon and {NICKNAME}."
                                                                },
                                                                {
                                                                    "id": "722620136",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "This \"is-or-isn't-a-sea\" is very pretty. The tall, tall house behind it is very pretty too. Help Kichiboushi taking a photo?"
                                                                },
                                                                {
                                                                    "id": "722620137",
                                                                    "speaker": "Player",
                                                                    "text": "Leave it to me."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722620133",
                                                            "text": "Companions who adventure together, grow together.",
                                                            "response": [
                                                                {
                                                                    "id": "722620134",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Mm! Companions."
                                                                },
                                                                {
                                                                    "id": "722620135",
                                                                    "speaker": "Paimon",
                                                                    "text": "The best of companions!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722620122",
                                            "text": "Ioroi did say something about this before we left..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722620110",
                            "text": "The sea is a large-scale water body beyond the mainland.",
                            "response": [
                                {
                                    "id": "722620111",
                                    "speaker": "Paimon",
                                    "text": "Wow, that's... a rather strict definition. But that brings us back to the question of \"boundaries,\" right?"
                                },
                                {
                                    "id": "722620112",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "#{NICKNAME} says Dihua Marsh is connected to sea. So the difference between \"land-land\" and \"not-land-land\" is?"
                                },
                                {
                                    "id": "722620113",
                                    "speaker": "Paimon",
                                    "text": "...Guess your strict definition isn't solving our problems, huh?"
                                }
                            ]
                        },
                        {
                            "id": "722620114",
                            "text": "These concepts are all man-made constructs. They don't have inherent meaning.",
                            "response": [
                                {
                                    "id": "722620115",
                                    "speaker": "Player",
                                    "text": "If Dihua Marsh thinks it's a sea, then it's the sea."
                                },
                                {
                                    "id": "722620116",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "So Kichiboushi thinks to be an adeptus, so is an adeptus?"
                                },
                                {
                                    "id": "722620117",
                                    "speaker": "Paimon",
                                    "text": "#Hey! Don't listen to {F#her}{M#him}, Kichiboushi. What in the world are you talking about, {NICKNAME}?"
                                },
                                {
                                    "id": "722620118",
                                    "speaker": "Paimon",
                                    "text": "But though it was kind of messy, you had a good point. You can become any kind of bake-danuki you wanna be, Kichiboushi! Who knows, you might even become a tanuki adeptus!"
                                },
                                {
                                    "id": "722620119",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "A tanuki adeptus! Yey!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226202",
            "objective": "Go to a place from which you can view Dihua Marsh",
            "dialogues": []
        },
        {
            "id": "7226203",
            "objective": "Take a picture of Kichiboushi",
            "dialogues": [
                {
                    "id": "722620301",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Ooh... Why..."
                },
                {
                    "id": "722620302",
                    "speaker": "Paimon",
                    "text": "Come on, Kichiboushi, why did you just charge straight into the hilichurl stronghold?"
                },
                {
                    "id": "722620303",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Thought we could... play..."
                },
                {
                    "id": "722620304",
                    "speaker": "Paimon",
                    "text": "Eh? Why? The hilichurls are dangerous monsters...",
                    "choices": [
                        {
                            "id": "722620305",
                            "text": "Now, I wouldn't call them dangerous...",
                            "response": [
                                {
                                    "id": "722620306",
                                    "speaker": "Paimon",
                                    "text": "Come on! Kichiboushi isn't anywhere as seasoned a combatant as you!"
                                },
                                {
                                    "id": "722620309",
                                    "speaker": "Player",
                                    "text": "Hmm, when we first met in Chinju Forest..."
                                },
                                {
                                    "id": "722620310",
                                    "speaker": "Paimon",
                                    "text": "That's right! Weren't you hiding in the form of some other object while being surrounded by hilichurls?"
                                },
                                {
                                    "id": "722620311",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "When we first met... First met... I'm thinking... Ooh, yes."
                                },
                                {
                                    "id": "722620312",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Then, was playing Hide-and-Seek with the hilichurl. Forest hilichurls do not attack bake-danuki. They play with us often."
                                },
                                {
                                    "id": "722620313",
                                    "speaker": "Paimon",
                                    "text": "Eh? So you've developed a harmonious relationship?"
                                },
                                {
                                    "id": "722620314",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Not knowing why the hilichurls here are like this. Mmm..."
                                },
                                {
                                    "id": "722620315",
                                    "speaker": "Paimon",
                                    "text": "Either way, you need to be more careful out here. Even when it comes to hilichurls... Well, especially when it comes to the hilichurls..."
                                },
                                {
                                    "id": "722620316",
                                    "speaker": "Paimon",
                                    "text": "#Ugh, this is getting complicated. You explain, {NICKNAME}."
                                },
                                {
                                    "id": "722620317",
                                    "speaker": "Player",
                                    "text": "You need to differentiate between the good people and the bad."
                                },
                                {
                                    "id": "722620318",
                                    "speaker": "Paimon",
                                    "text": "Yup! That's how you can protect yourself in the future."
                                },
                                {
                                    "id": "722620319",
                                    "speaker": "Player",
                                    "text": "But don't forget to keep a good and open heart."
                                },
                                {
                                    "id": "722620320",
                                    "speaker": "Paimon",
                                    "text": "Yup, that's right! That'll help you enjoy the good things in life!"
                                },
                                {
                                    "id": "722620321",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Mm..."
                                },
                                {
                                    "id": "722620322",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "#{NICKNAME} and Paimon say complicated things. Kichiboushi not understand."
                                },
                                {
                                    "id": "722620323",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "But Kichiboushi knows you're good people. So Kichiboushi learn."
                                },
                                {
                                    "id": "722620324",
                                    "speaker": "Paimon",
                                    "text": "#Alright, enough of that for now. For now, time to learn how to fish from {NICKNAME}."
                                },
                                {
                                    "id": "722620325",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Mm! Fishing!"
                                }
                            ]
                        },
                        {
                            "id": "722620307",
                            "text": "Aye, they're truly perilous!",
                            "response": [
                                {
                                    "id": "722620308",
                                    "speaker": "Paimon",
                                    "text": "Hey, there's no need to scare him either!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226204",
            "objective": "Talk to Kichiboushi",
            "dialogues": [
                {
                    "id": "722620201",
                    "speaker": "Paimon",
                    "text": "And it's done!"
                },
                {
                    "id": "722620202",
                    "speaker": "Paimon",
                    "text": "Next up..."
                },
                {
                    "id": "722620203",
                    "speaker": "Paimon",
                    "text": "How about this? Kichiboushi, have you ever gone fishing?"
                },
                {
                    "id": "722620204",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Fishing?"
                },
                {
                    "id": "722620205",
                    "speaker": "Paimon",
                    "text": "Looks like you haven't. Alright then, let's head for the water's edge!"
                },
                {
                    "id": "722620206",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Yey!"
                }
            ]
        },
        {
            "id": "7226205",
            "objective": "Catch up with Kichiboushi",
            "dialogues": [
                {
                    "id": "722620501",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Really to play with the water."
                },
                {
                    "id": "722620502",
                    "speaker": "Player",
                    "text": "Not now, you'll scare the fish off."
                },
                {
                    "id": "722620503",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Mm. Okay."
                }
            ]
        },
        {
            "id": "7226206",
            "objective": "Defeat the hilichurls",
            "dialogues": [
                {
                    "id": "722620601",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Hmm. Why not go into water to catchy fish?",
                    "choices": [
                        {
                            "id": "722620602",
                            "text": "Some fish can't be caught that way.",
                            "response": [
                                {
                                    "id": "722620605",
                                    "speaker": "Paimon",
                                    "text": "That's right! Fishing is a great way to train!",
                                    "choices": [
                                        {
                                            "id": "722620606",
                                            "text": "You try, Kichiboushi.",
                                            "response": [
                                                {
                                                    "id": "722620607",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "Mm?"
                                                },
                                                {
                                                    "id": "722620610",
                                                    "speaker": "Black Screen",
                                                    "text": "In the end, Kichiboushi is the one to try fishing.\\nAs expected, he doesn't catch much of anything.\\nIn the end, the three of you give up fishing and play by the water instead."
                                                },
                                                {
                                                    "id": "722620611",
                                                    "speaker": "Paimon",
                                                    "text": "Being damp at all kinda sucks, but it was pretty fun to play in the water!"
                                                },
                                                {
                                                    "id": "722620612",
                                                    "speaker": "\"Kichiboushi\"",
                                                    "text": "Kichiboushi is very happy! But fishing is hard."
                                                },
                                                {
                                                    "id": "722620613",
                                                    "speaker": "Paimon",
                                                    "text": "#Yup. But if you do learn to fish, you might make some unexpected friends some day. Right, {NICKNAME}?",
                                                    "choices": [
                                                        {
                                                            "id": "722620614",
                                                            "text": "That's true.",
                                                            "response": [
                                                                {
                                                                    "id": "722620617",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Hard to understand... But Kichiboushi understands."
                                                                },
                                                                {
                                                                    "id": "722620618",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "#Playing with {NICKNAME} and Paimon is very fun. {NICKNAME} and Paimon are Kichiboushi's good friends."
                                                                },
                                                                {
                                                                    "id": "722620619",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Training is great!"
                                                                },
                                                                {
                                                                    "id": "722620620",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh yeah, speaking of which, Ioroi's goal was to take Kichiboushi to eight places to train..."
                                                                },
                                                                {
                                                                    "id": "722620621",
                                                                    "speaker": "Paimon",
                                                                    "text": "Dragonspine, Guyun Stone Forest, Mondstadt, Liyue Harbor, Mt. Hulao... We've finished most of your training already!"
                                                                },
                                                                {
                                                                    "id": "722620622",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Mm, that's true..."
                                                                },
                                                                {
                                                                    "id": "722620623",
                                                                    "speaker": "Paimon",
                                                                    "text": "So where should we go next?"
                                                                },
                                                                {
                                                                    "id": "722620624",
                                                                    "speaker": "Player",
                                                                    "text": "I'll leave that decision to you."
                                                                },
                                                                {
                                                                    "id": "722620625",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Ooh, that's not something Paimon hears from you often, {NICKNAME}!"
                                                                },
                                                                {
                                                                    "id": "722620626",
                                                                    "speaker": "Paimon",
                                                                    "text": "Alright, then! Leave this to Paimon!"
                                                                },
                                                                {
                                                                    "id": "722620627",
                                                                    "speaker": "\"Kichiboushi\"",
                                                                    "text": "Leave it to Paimon, mm!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722620615",
                                                            "text": "Yes, though food expenses might increase as a result.",
                                                            "response": [
                                                                {
                                                                    "id": "722620616",
                                                                    "speaker": "Paimon",
                                                                    "text": "Come on!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722620608",
                                            "text": "You try, Paimon.",
                                            "response": [
                                                {
                                                    "id": "722620609",
                                                    "speaker": "Paimon",
                                                    "text": "The fish would pull Paimon right into the sea!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722620603",
                            "text": "It might be quite troublesome, but it's more interesting this way."
                        },
                        {
                            "id": "722620604",
                            "text": "This is also a form of training."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226207",
            "objective": "Talk to Kichiboushi",
            "dialogues": []
        },
        {
            "id": "7226208",
            "objective": "Head to your destination",
            "dialogues": [
                {
                    "id": "722620401",
                    "speaker": "Paimon",
                    "text": "Haha, this place looks pretty good."
                },
                {
                    "id": "722620402",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Kichiboushi wants to play with water!"
                },
                {
                    "id": "722620403",
                    "speaker": "Paimon",
                    "text": "Hey, hey, not now! You'll scare the fish away!"
                },
                {
                    "id": "722620404",
                    "speaker": "Black Screen",
                    "text": "You teach Kichiboushi the basics of fishing.\\nYou try to keep things simple, but as to how much he understands..."
                },
                {
                    "id": "722620405",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Fish!"
                },
                {
                    "id": "722620406",
                    "speaker": "Player",
                    "text": "Got it?"
                },
                {
                    "id": "722620407",
                    "speaker": "\"Kichiboushi\"",
                    "text": "Mmhaha! Fish are silly. Get tricked by food!",
                    "choices": [
                        {
                            "id": "722620408",
                            "text": "Huh, that sounds like Paimon!",
                            "response": [
                                {
                                    "id": "722620409",
                                    "speaker": "Paimon",
                                    "text": "Hey, come on!"
                                },
                                {
                                    "id": "722620413",
                                    "speaker": "Paimon",
                                    "text": "Well, everyone likes gourmet food!"
                                },
                                {
                                    "id": "722620414",
                                    "speaker": "Paimon",
                                    "text": "#Well then, {NICKNAME}, time to show Kichiboushi what you can do!"
                                }
                            ]
                        },
                        {
                            "id": "722620410",
                            "text": "You're not so different, Kichiboushi.",
                            "response": [
                                {
                                    "id": "722620411",
                                    "speaker": "\"Kichiboushi\"",
                                    "text": "Mm?"
                                }
                            ]
                        },
                        {
                            "id": "722620412",
                            "text": "That happens to me too."
                        }
                    ]
                }
            ]
        },
