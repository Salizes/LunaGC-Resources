    "talks": [
        {
            "id": "7467101",
            "objective": "Talk to Macadell",
            "dialogues": [
                {
                    "id": "746710101",
                    "speaker": "Macadell",
                    "text": "Blast! Core output is still too inconsistent. My project is done for if it goes on like this..."
                },
                {
                    "id": "746710102",
                    "speaker": "Player",
                    "text": "What are you doing?"
                },
                {
                    "id": "746710103",
                    "speaker": "Macadell",
                    "text": "AAAAH! Y—You scared me! It could have turned messy had I pushed this button!"
                },
                {
                    "id": "746710104",
                    "speaker": "Macadell",
                    "text": "Judging by your look... You're not from the Adventurers' Guild.",
                    "choices": [
                        {
                            "id": "746710105",
                            "text": "Did you publish a commission with the Guild?",
                            "response": [
                                {
                                    "id": "746710106",
                                    "speaker": "Macadell",
                                    "text": "No, I don't have the money for that... And I'm no good at dealing with adventurers."
                                },
                                {
                                    "id": "746710109",
                                    "speaker": "Macadell",
                                    "text": "I'm just \"collaborating\" on a project with the Adventurers' Guild..."
                                },
                                {
                                    "id": "746710110",
                                    "speaker": "Macadell",
                                    "text": "Oops, I forgot to introduce myself. I am Macadell, a researcher with the Fontaine Research Institute."
                                },
                                {
                                    "id": "746710111",
                                    "speaker": "Macadell",
                                    "text": "The project I worked on was the \"Portable Mini Pneumousia Storage Device.\""
                                },
                                {
                                    "id": "746710112",
                                    "speaker": "Macadell",
                                    "text": "Thanks to the combined efforts of my fellow team members, we built the first prototype."
                                },
                                {
                                    "id": "746710113",
                                    "speaker": "Macadell",
                                    "text": "Then... Well, like everyone knows, a huge explosion occurred at the Institute."
                                },
                                {
                                    "id": "746710114",
                                    "speaker": "Macadell",
                                    "text": "The project leader and most of the members of the project team perished in the blast."
                                },
                                {
                                    "id": "746710115",
                                    "speaker": "Macadell",
                                    "text": "Apart from me, there's basically nobody else who can continue the work and push the research forward..."
                                },
                                {
                                    "id": "746710116",
                                    "speaker": "Macadell",
                                    "text": "But... given the turmoil within the Institute, I must demonstrate its value as soon as possible in order to keep the project alive."
                                },
                                {
                                    "id": "746710117",
                                    "speaker": "Macadell",
                                    "text": "So, after consulting with all parties, the Adventurers' Guild and I reached an accord."
                                },
                                {
                                    "id": "746710118",
                                    "speaker": "Macadell",
                                    "text": "I wanted to use the prototype Portable Mini Pneumousia Storage Device as the core to create a Pressurized Impactor."
                                },
                                {
                                    "id": "746710119",
                                    "speaker": "Macadell",
                                    "text": "I wanted to use the operational performance of the Pressurized Impactors to prove the Portable Mini Pneumousia Storage Device's reliability."
                                },
                                {
                                    "id": "746710120",
                                    "speaker": "Macadell",
                                    "text": "And I did successfully build the machine, and began operating it.",
                                    "choices": [
                                        {
                                            "id": "746710121",
                                            "text": "Sounds like everything went fine.",
                                            "response": [
                                                {
                                                    "id": "746710122",
                                                    "speaker": "Macadell",
                                                    "text": "Hahaha, yes, indeed... Until the Pressurized Impactor started running."
                                                },
                                                {
                                                    "id": "746710125",
                                                    "speaker": "Macadell",
                                                    "text": "*sigh* I'd get a headache every time I talk about this."
                                                },
                                                {
                                                    "id": "746710126",
                                                    "speaker": "Macadell",
                                                    "text": "I have no idea if the problem is with the prototype's design, or flaws in the Pressurized Impactor's method of energy transfer..."
                                                },
                                                {
                                                    "id": "746710127",
                                                    "speaker": "Macadell",
                                                    "text": "The power going from the Portable Mini Pneumousia Storage Device to the Pressurized Impactor always fluctuated wildly."
                                                },
                                                {
                                                    "id": "746710128",
                                                    "speaker": "Macadell",
                                                    "text": "And that made the Impactor's output unpredictable as well!"
                                                },
                                                {
                                                    "id": "746710129",
                                                    "speaker": "Macadell",
                                                    "text": "When the output is high, this machine can easily crush rocks. But when output is low, even drilling a hole in mud is challenging."
                                                },
                                                {
                                                    "id": "746710130",
                                                    "speaker": "Macadell",
                                                    "text": "Given the situation with the Institute, it was basically impossible for me to go back and rebuild the Portable Mini Pneumousia Storage Device..."
                                                },
                                                {
                                                    "id": "746710131",
                                                    "speaker": "Macadell",
                                                    "text": "I can only install an extra surveillance device on the prototype to monitor the strength of its energy output in real-time."
                                                },
                                                {
                                                    "id": "746710132",
                                                    "speaker": "Macadell",
                                                    "text": "I just have to activate the Pressurized Impactor when the output is at its highest peak to maximize the potential!",
                                                    "choices": [
                                                        {
                                                            "id": "746710133",
                                                            "text": "That's way too convoluted!",
                                                            "response": [
                                                                {
                                                                    "id": "746710134",
                                                                    "speaker": "Macadell",
                                                                    "text": "But that's the best and cheapest solution I could think of... What else can I do?"
                                                                },
                                                                {
                                                                    "id": "746710137",
                                                                    "speaker": "Macadell",
                                                                    "text": "*sigh* The Adventurers' Guild is probably thinking the same thing. That's why they haven't sent anyone yet..."
                                                                },
                                                                {
                                                                    "id": "746710138",
                                                                    "speaker": "Macadell",
                                                                    "text": "What are we going to do? If we don't have the test data, I can't report back to the Institute..."
                                                                },
                                                                {
                                                                    "id": "746710139",
                                                                    "speaker": "Macadell",
                                                                    "text": "Traveler, if you don't mind, could you help me out?"
                                                                },
                                                                {
                                                                    "id": "746710140",
                                                                    "speaker": "Macadell",
                                                                    "text": "I assure you, my device is totally reliable! I even made a bunch of plug-ins for it that can enhance its various functionalities!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746710141",
                                                                            "text": "What if I can't get the timing right?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746710142",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "It's okay, the worst scenario is... that it doesn't have enough output. It won't blow up or anything."
                                                                                },
                                                                                {
                                                                                    "id": "746710143",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "All you have to do is wait for the next energy peak, then turn the machine on to get the maximum output."
                                                                                },
                                                                                {
                                                                                    "id": "746710148",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Relax, Traveler. This machine is totally safe, and... after the test is over, I'll even pay you!"
                                                                                },
                                                                                {
                                                                                    "id": "746710149",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Then I'll leave it to you! My future, the future of this machine... And my future place in this project! It's all in your hands!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746710144",
                                                                            "text": "It won't blow up on me, will it?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746710145",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "That's absolutely not possible. I added a lot of safety and monitoring devices, so the worst case scenario that it doesn't have enough output. An explosion is impossible."
                                                                                },
                                                                                {
                                                                                    "id": "746710146",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "And even if you miss an energy peak, that's all right too."
                                                                                },
                                                                                {
                                                                                    "id": "746710147",
                                                                                    "speaker": "Macadell",
                                                                                    "text": "Just wait for the next energy peak, then turn the machine on to get the maximum output."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746710135",
                                                            "text": "That's not going to work...",
                                                            "response": [
                                                                {
                                                                    "id": "746710136",
                                                                    "speaker": "Macadell",
                                                                    "text": "Please don't say that! It's the best solution I've got. I swear, it's really useful!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746710123",
                                            "text": "That doesn't sound like a problem.",
                                            "response": [
                                                {
                                                    "id": "746710124",
                                                    "speaker": "Macadell",
                                                    "text": "Yes, other than the machine itself, everything worked perfectly."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746710107",
                            "text": "Did you hire adventurers for protection?",
                            "response": [
                                {
                                    "id": "746710108",
                                    "speaker": "Macadell",
                                    "text": "I can't afford them. They ask far too much for their services..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}