    "talks": [
        {
            "id": "7050301",
            "objective": "Talk to Luka and enter the tavern",
            "dialogues": [
                {
                    "id": "705030101",
                    "speaker": "Eula",
                    "text": "A small Foamy Reef, please... Thank you.",
                    "choices": [
                        {
                            "id": "705030102",
                            "text": "Eula?",
                            "response": [
                                {
                                    "id": "705030104",
                                    "speaker": "Eula",
                                    "text": "I... I'm fine."
                                },
                                {
                                    "id": "705030105",
                                    "speaker": "Paimon",
                                    "text": "Huh... There's something off about Eula. Was she already drinking before she got here?"
                                },
                                {
                                    "id": "705030106",
                                    "speaker": "Paimon",
                                    "text": "But, Foamy Reef has coffee in it. Would it upset her stomach if she has coffee after liquor?"
                                },
                                {
                                    "id": "705030107",
                                    "speaker": "Paimon",
                                    "text": "For her tummy's sake, let's water it down before serving it to her!"
                                }
                            ]
                        },
                        {
                            "id": "705030103",
                            "text": "What's the matter?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050305",
            "objective": "Head to the counter and get ready to open for business",
            "dialogues": []
        },
        {
            "id": "7050304",
            "objective": "Talk to Eula",
            "dialogues": []
        },
        {
            "id": "7050302",
            "objective": "Mix Eula the specified drink",
            "dialogues": [
                {
                    "id": "705030201",
                    "speaker": "Eula",
                    "text": "This tastes pretty good..."
                },
                {
                    "id": "705030202",
                    "speaker": "Paimon",
                    "text": "Wow, she didn't even notice how much water we added. She must've had a lot to drink."
                },
                {
                    "id": "705030203",
                    "speaker": "Eula",
                    "text": "One more, bartender... Huh? W—Wait, it's you guys?",
                    "choices": [
                        {
                            "id": "705030204",
                            "text": "We're learning to become bartenders...",
                            "response": [
                                {
                                    "id": "705030206",
                                    "speaker": "Eula",
                                    "text": "Ugh..."
                                },
                                {
                                    "id": "705030207",
                                    "speaker": "Eula",
                                    "text": "Sorry. I just came here from The Cat's Tail. Perhaps I had a little too much to drink...",
                                    "choices": [
                                        {
                                            "id": "705030208",
                                            "text": "Is something troubling you?",
                                            "response": [
                                                {
                                                    "id": "705030210",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah. It's pretty lonely to drink by yourself. You'll feel better if you talk to us!"
                                                },
                                                {
                                                    "id": "705030211",
                                                    "speaker": "Eula",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "705030212",
                                                    "speaker": "Eula",
                                                    "text": "I suppose I always do drink alone."
                                                },
                                                {
                                                    "id": "705030213",
                                                    "speaker": "Eula",
                                                    "text": "As long as I'm in Mondstadt, I'll never be welcome at taverns. I was actually feeling good today and wanted a drink, but they still wouldn't get off my back..."
                                                },
                                                {
                                                    "id": "705030214",
                                                    "speaker": "Eula",
                                                    "text": "#Tell me, {NICKNAME}, how did you manage to make so many friends?"
                                                },
                                                {
                                                    "id": "705030215",
                                                    "speaker": "Eula",
                                                    "text": "People always sound so appreciative and are always smiling when they talk about you."
                                                },
                                                {
                                                    "id": "705030216",
                                                    "speaker": "Eula",
                                                    "text": "But as for me, just mentioning my family name is enough to make everyone..."
                                                },
                                                {
                                                    "id": "705030217",
                                                    "speaker": "Player",
                                                    "text": "Hey, don't think like that."
                                                },
                                                {
                                                    "id": "705030218",
                                                    "speaker": "Paimon",
                                                    "text": "You didn't choose to be born into the Lawrence clan, and we don't care about that kind of thing. The Eula we know is a great person!"
                                                },
                                                {
                                                    "id": "705030219",
                                                    "speaker": "Paimon",
                                                    "text": "But you don't like being straightforward. You always pretend to hold a grudge, and you try to hide your tenderness away from everyone..."
                                                },
                                                {
                                                    "id": "705030220",
                                                    "speaker": "Eula",
                                                    "text": "Hey, who said I was pretending.",
                                                    "choices": [
                                                        {
                                                            "id": "705030221",
                                                            "text": "Others will accept you, Eula...",
                                                            "response": [
                                                                {
                                                                    "id": "705030223",
                                                                    "speaker": "Eula",
                                                                    "text": "Do you think so? Heh, it's impossible to imagine, even when I'm this drunk..."
                                                                },
                                                                {
                                                                    "id": "705030224",
                                                                    "speaker": "Eula",
                                                                    "text": "Even after being a Knight of Favonius for all this time, people still... whatever."
                                                                },
                                                                {
                                                                    "id": "705030225",
                                                                    "speaker": "Player",
                                                                    "text": "Winds always change their course."
                                                                },
                                                                {
                                                                    "id": "705030226",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh, right! Tone-Deaf Bard said something wise like that, too."
                                                                },
                                                                {
                                                                    "id": "705030227",
                                                                    "speaker": "Paimon",
                                                                    "text": "Just be yourself, Eula... and keep moving forward."
                                                                },
                                                                {
                                                                    "id": "705030228",
                                                                    "speaker": "Paimon",
                                                                    "text": "Sooner or later you'll change what people think about the Lawrence clan!"
                                                                },
                                                                {
                                                                    "id": "705030229",
                                                                    "speaker": "Player",
                                                                    "text": "Yes, just be patient."
                                                                },
                                                                {
                                                                    "id": "705030230",
                                                                    "speaker": "Eula",
                                                                    "text": "Okay, thank you..."
                                                                },
                                                                {
                                                                    "id": "705030231",
                                                                    "speaker": "Eula",
                                                                    "text": "I... ahem! I should go now."
                                                                },
                                                                {
                                                                    "id": "705030232",
                                                                    "speaker": "Player",
                                                                    "text": "Would you like me to walk you back?"
                                                                },
                                                                {
                                                                    "id": "705030233",
                                                                    "speaker": "Eula",
                                                                    "text": "No need. I want to remember what you said, and I won't be able to think about anything else until I write everything down."
                                                                },
                                                                {
                                                                    "id": "705030234",
                                                                    "speaker": "Paimon",
                                                                    "text": "Eula sure is a lot more open after a few drinks."
                                                                },
                                                                {
                                                                    "id": "705030235",
                                                                    "speaker": "Paimon",
                                                                    "text": "But it does feel like something's missing without her signature revenge line."
                                                                },
                                                                {
                                                                    "id": "705030236",
                                                                    "speaker": "Paimon",
                                                                    "text": "Uh-oh... When she wakes up in the morning, do you think she'll come threatening us to forget about what happened today?"
                                                                },
                                                                {
                                                                    "id": "705030237",
                                                                    "speaker": "Player",
                                                                    "text": "Hmm, maybe."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705030222",
                                                            "text": "There will be many people who accept you one day, Eula..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705030209",
                                            "text": "I'm here if you want to talk."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705030205",
                            "text": "You only just now noticed us?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050303",
            "objective": "Give the drink to Eula",
            "dialogues": []
        }
    ]
