    "talks": [
        {
            "id": "7308001",
            "objective": "",
            "dialogues": [
                {
                    "id": "730800101",
                    "speaker": "Player",
                    "text": "(Let's uncover the \"bad guy\" in Vimara Village.)"
                },
                {
                    "id": "730800102",
                    "speaker": "Paimon",
                    "text": "Hello, Alphonso!"
                },
                {
                    "id": "730800103",
                    "speaker": "Alphonso",
                    "text": "#It's you guys. {NICKNAME}, what can I do for you? If you're looking for Rana, she's gone already."
                },
                {
                    "id": "730800104",
                    "speaker": "Player",
                    "text": "I want to talk to you about something..."
                },
                {
                    "id": "730800105",
                    "speaker": "Player",
                    "text": "The \"bad guy\" hiding in Vimara Village."
                },
                {
                    "id": "730800106",
                    "speaker": "Paimon",
                    "text": "#After all, Rana only felt relaxed enough to go on a journey after {NICKNAME} promised her to deal with the bad guy."
                },
                {
                    "id": "730800107",
                    "speaker": "Alphonso",
                    "text": "I see. I understand now. Even though I don't have a clue, feel free to ask."
                },
                {
                    "id": "730800108",
                    "speaker": "Player",
                    "text": "First, let's recap what happened."
                },
                {
                    "id": "730800109",
                    "speaker": "Paimon",
                    "text": "So, who was the first missing child in Vimara Village?",
                    "choices": [
                        {
                            "id": "730800110",
                            "text": "Sudabeh.",
                            "response": [
                                {
                                    "id": "730800119",
                                    "speaker": "Paimon",
                                    "text": "Paimon remembers now, it's Sudabeh! She heard that there were herbs that could improve Amadhiah's sight and then sneaked into the woods."
                                },
                                {
                                    "id": "730800120",
                                    "speaker": "Alphonso",
                                    "text": "That's right. We were worried when it happened and organized a search party."
                                },
                                {
                                    "id": "730800121",
                                    "speaker": "Paimon",
                                    "text": "Paimon remembers now! Rana did say you organized the search party, and brought curry along too..."
                                },
                                {
                                    "id": "730800122",
                                    "speaker": "Player",
                                    "text": "Who told Sudabeh about the herbs?"
                                },
                                {
                                    "id": "730800123",
                                    "speaker": "Alphonso",
                                    "text": "...I did. Sudabeh is a good kid who cares about Amadhiah. I recall mentioning it to her one day, but I also said..."
                                },
                                {
                                    "id": "730800124",
                                    "speaker": "Paimon",
                                    "text": "Yeah, Paimon knows! She said you told her not to wander the forest alone. But she really cares about Amadhiah."
                                },
                                {
                                    "id": "730800125",
                                    "speaker": "Alphonso",
                                    "text": "Any other questions?"
                                },
                                {
                                    "id": "730800126",
                                    "speaker": "Paimon",
                                    "text": "So, who was the second that went missing?",
                                    "choices": [
                                        {
                                            "id": "730800127",
                                            "text": "Kavus.",
                                            "response": [
                                                {
                                                    "id": "730800135",
                                                    "speaker": "Alphonso",
                                                    "text": "Kavus... He said he was going to see a \"friend\" in the forest for his missing sister."
                                                },
                                                {
                                                    "id": "730800136",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah, he did mention that! Do you know who Kavus' friend is, Alphonso?"
                                                },
                                                {
                                                    "id": "730800137",
                                                    "speaker": "Alphonso",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "730800138",
                                                    "speaker": "Alphonso",
                                                    "text": "How would I know? I didn't find Kavus or his friend in the woods. As you know, he came back suddenly not remembering anything, just like Sudabeh."
                                                },
                                                {
                                                    "id": "730800139",
                                                    "speaker": "Alphonso",
                                                    "text": "Any other questions? No more children went missing after that."
                                                },
                                                {
                                                    "id": "730800140",
                                                    "speaker": "Player",
                                                    "text": "You got this, Paimon."
                                                },
                                                {
                                                    "id": "730800141",
                                                    "speaker": "Paimon",
                                                    "text": "Eh? Okay. Ahem... Well, Iotham was supposed to go missing next, but we and Rana ran into him and brought him back."
                                                },
                                                {
                                                    "id": "730800142",
                                                    "speaker": "Player",
                                                    "text": "How did it happen exactly?"
                                                },
                                                {
                                                    "id": "730800143",
                                                    "speaker": "Paimon",
                                                    "text": "According to him, he heard Alphonso say there were huge mushrooms in a cave, so he wanted to get some for Rana."
                                                },
                                                {
                                                    "id": "730800144",
                                                    "speaker": "Paimon",
                                                    "text": "Then the Fatui followed him. He got scared, ran, and ended up trapped in a Withering Zone..."
                                                },
                                                {
                                                    "id": "730800145",
                                                    "speaker": "Alphonso",
                                                    "text": "What, he went into a Withering Zone? How come he never told me that? That's unacceptable...!"
                                                },
                                                {
                                                    "id": "730800146",
                                                    "speaker": "Alphonso",
                                                    "text": "Wait, if he was in the Withering Zone, how did he make it back? I understand that you can master the elements without a Vision, but still..."
                                                },
                                                {
                                                    "id": "730800147",
                                                    "speaker": "Paimon",
                                                    "text": "(Uh, should we tell Alphonso about Arana?)",
                                                    "choices": [
                                                        {
                                                            "id": "730800148",
                                                            "text": "(That should be fine.)",
                                                            "response": [
                                                                {
                                                                    "id": "730800150",
                                                                    "speaker": "Paimon",
                                                                    "text": "You'll probably find this hard to believe, Alphonso, but there are fairies called Aranara in the forest. Iotham and the gang are friends with them, so the Aranara helped him."
                                                                },
                                                                {
                                                                    "id": "730800151",
                                                                    "speaker": "Alphonso",
                                                                    "text": "Aranara...?"
                                                                },
                                                                {
                                                                    "id": "730800152",
                                                                    "speaker": "Paimon",
                                                                    "text": "But going after the kids... the Fatui are so despicable!"
                                                                },
                                                                {
                                                                    "id": "730800153",
                                                                    "speaker": "Alphonso",
                                                                    "text": "..."
                                                                },
                                                                {
                                                                    "id": "730800154",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hmm, we still don't know who the bad guy hiding in Vimara Village is..."
                                                                },
                                                                {
                                                                    "id": "730800155",
                                                                    "speaker": "Player",
                                                                    "text": "I think someone's watching us over there, Paimon."
                                                                },
                                                                {
                                                                    "id": "730800156",
                                                                    "speaker": "Paimon",
                                                                    "text": "Where? Don't tell Paimon it's the bad guy we're looking for!"
                                                                },
                                                                {
                                                                    "id": "730800157",
                                                                    "speaker": "Player",
                                                                    "text": "Go check it out."
                                                                },
                                                                {
                                                                    "id": "730800158",
                                                                    "speaker": "Paimon",
                                                                    "text": "Just Paimon alone?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730800159",
                                                                            "text": "Yell if you're in trouble and I'll be right there.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730800161",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Fine. Can't have {NICKNAME} do everything, anyway. Paimon's got this!"
                                                                                },
                                                                                {
                                                                                    "id": "730800162",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "Paimon leaves excitedly."
                                                                                },
                                                                                {
                                                                                    "id": "730800163",
                                                                                    "speaker": "Alphonso",
                                                                                    "text": "Why bother?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "730800164",
                                                                                            "text": "She'll be happier if she doesn't know.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "730800166",
                                                                                                    "speaker": "Alphonso",
                                                                                                    "text": "Let's talk elsewhere."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "730800165",
                                                                                            "text": "Some things are better left untold."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730800160",
                                                                            "text": "You're small and can fly. Perfect for scouting."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730800149",
                                                            "text": "(He ought to know.)"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730800128",
                                            "text": "Sudabeh.",
                                            "response": [
                                                {
                                                    "id": "730800129",
                                                    "speaker": "Paimon",
                                                    "text": "No, no, didn't we just get done with Sudabeh? Paimon remembers it was her brother... Kavus, right?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730800130",
                                            "text": "Iotham.",
                                            "response": [
                                                {
                                                    "id": "730800131",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon doesn't think that's right... We saved Iotham when he got lost. The second should be Sudabeh's big brother Kavus, right?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730800132",
                                            "text": "Changchang.",
                                            "response": [
                                                {
                                                    "id": "730800133",
                                                    "speaker": "Paimon",
                                                    "text": "Changchang is in Liyue! What's this got to do with Changchang!?"
                                                },
                                                {
                                                    "id": "730800134",
                                                    "speaker": "Paimon",
                                                    "text": "#...Are you okay, {NICKNAME}? Paimon remembers, the second kid was Sudabeh's big brother named Kavus, right?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730800111",
                            "text": "Kavus.",
                            "response": [
                                {
                                    "id": "730800112",
                                    "speaker": "Alphonso",
                                    "text": "That should be Sudabeh."
                                }
                            ]
                        },
                        {
                            "id": "730800113",
                            "text": "Iotham.",
                            "response": [
                                {
                                    "id": "730800114",
                                    "speaker": "Paimon",
                                    "text": "No, Iotham was the last one that went missing."
                                },
                                {
                                    "id": "730800115",
                                    "speaker": "Alphonso",
                                    "text": "It's Sudabeh."
                                }
                            ]
                        },
                        {
                            "id": "730800116",
                            "text": "Timmie.",
                            "response": [
                                {
                                    "id": "730800117",
                                    "speaker": "Paimon",
                                    "text": "Timmie? No, this has nothing to do with Timmie! Isn't he in Mondstadt?"
                                },
                                {
                                    "id": "730800118",
                                    "speaker": "Alphonso",
                                    "text": "Who's Timmie? Sudabeh should be the first one that went missing, right?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7308002",
            "objective": "",
            "dialogues": [
                {
                    "id": "730800201",
                    "speaker": "Alphonso",
                    "text": "When did you start suspecting me? Is it because Sudabeh and Iotham both mentioned me?"
                },
                {
                    "id": "730800202",
                    "speaker": "Player",
                    "text": "You know my name."
                },
                {
                    "id": "730800203",
                    "speaker": "Player",
                    "text": "But Rana never told you my name."
                },
                {
                    "id": "730800204",
                    "speaker": "Alphonso",
                    "text": "Or maybe I have great hearing and overheard your name when Rana introduced you to Amadhiah."
                },
                {
                    "id": "730800205",
                    "speaker": "Player",
                    "text": "She never told Amadhiah that, either."
                },
                {
                    "id": "730800206",
                    "speaker": "Alphonso",
                    "text": "How careless of me. But besides the Fatui, the Adventurers' Guild also has an extensive network, so why don't you think I'm an adventurer?",
                    "choices": [
                        {
                            "id": "730800207",
                            "text": "You seem to know me very well.",
                            "response": [
                                {
                                    "id": "730800208",
                                    "speaker": "Player",
                                    "text": "You know I could control the elements without a Vision."
                                },
                                {
                                    "id": "730800209",
                                    "speaker": "Alphonso",
                                    "text": "You're quite famous for your exploits. I don't have to be a Fatuus to know that. The bottom line is, you don't have anything concrete to prove that I'm with them."
                                },
                                {
                                    "id": "730800212",
                                    "speaker": "Player",
                                    "text": "True, but that's not important."
                                },
                                {
                                    "id": "730800213",
                                    "speaker": "Alphonso",
                                    "text": "You're right. Only the court demands proof, whereas a keen hound needs merely a scent to track the prey."
                                },
                                {
                                    "id": "730800214",
                                    "speaker": "Alphonso",
                                    "text": "Of course, a clever hound would avoid the scent it shouldn't sniff, as to not run into a dragon at the trail's end. But, from your track record, you're not one to quit."
                                },
                                {
                                    "id": "730800215",
                                    "speaker": "Player",
                                    "text": "You warned Rana not to patrol the forest..."
                                },
                                {
                                    "id": "730800216",
                                    "speaker": "Player",
                                    "text": "Because you didn't want her to interfere with the Fatui."
                                },
                                {
                                    "id": "730800217",
                                    "speaker": "Alphonso",
                                    "text": "There's truth to that, but more importantly, I didn't want her to get hurt. The other Fatui aren't like me. They felt nothing toward her or Vimara Village."
                                },
                                {
                                    "id": "730800218",
                                    "speaker": "Player",
                                    "text": "Who are you really, \"Alphonso\"?"
                                },
                                {
                                    "id": "730800219",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "The name given to me at birth is buried in freezing snow. The name granted me by the House of the Hearth is Trofin Snezhevich."
                                },
                                {
                                    "id": "730800220",
                                    "speaker": "Player",
                                    "text": "Trofin Snezhevich of the House of the Hearth..."
                                },
                                {
                                    "id": "730800221",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Your reaction tells me you probably encountered my \"brothers and sisters\" before."
                                },
                                {
                                    "id": "730800222",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Oh, don't tell me who you ran into or their status. Should they have revealed their identities to you..."
                                },
                                {
                                    "id": "730800223",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Assuming they are still alive, then they would have betrayed Her Majesty already. If they're dead... I'd rather not know about it."
                                },
                                {
                                    "id": "730800224",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "House of the Hearth is a shelter founded by \"The Knave.\" Children raised in the House aren't related, but our bonds are tighter than blood."
                                },
                                {
                                    "id": "730800225",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "After coming of age, those with potential undergo training to become agents, then infiltrate different locations to await orders. Unfortunately, I was deemed as \"having potential.\""
                                },
                                {
                                    "id": "730800226",
                                    "speaker": "Player",
                                    "text": "What is your order?"
                                },
                                {
                                    "id": "730800227",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Capture Aranara. It's an order from \"The Doctor,\" so that he can study the connections between Aranara, dreams, and The Withering."
                                },
                                {
                                    "id": "730800228",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Weaponizing dreams and The Withering seems to be one of his projects. Of course, I and every Fatuus you defeated are his \"source of study.\""
                                },
                                {
                                    "id": "730800229",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "We can't see Aranara, but Kavus, Sudabeh, and Iotham have what it takes to befriend them."
                                },
                                {
                                    "id": "730800230",
                                    "speaker": "Player",
                                    "text": "So you let the Fatui abduct them to lure the Aranara out."
                                },
                                {
                                    "id": "730800231",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Correct, and the Aranara did show up. But their power truly was amazing, able to free those kids right under the nose of heavy security..."
                                },
                                {
                                    "id": "730800232",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "The Doctor has eyes on something truly incredible this time..."
                                },
                                {
                                    "id": "730800233",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "#I've got a question for you too, {NICKNAME}. Why would the Aranara erase the abduction and rescue from Kavus and Sudabeh's memory? To avoid being exposed?"
                                },
                                {
                                    "id": "730800234",
                                    "speaker": "Player",
                                    "text": "Arana doesn't want the children to remember anything like that at all."
                                },
                                {
                                    "id": "730800235",
                                    "speaker": "Player",
                                    "text": "Arana doesn't want them to be violent when they grow up."
                                },
                                {
                                    "id": "730800236",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "I see. So that Aranara is named Arana? That sounds a lot like Rana, a very pretty name. Please thank her on my behalf when you get a chance."
                                },
                                {
                                    "id": "730800237",
                                    "speaker": "Player",
                                    "text": "Why would you thank her?"
                                },
                                {
                                    "id": "730800238",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Vimara Village feels like a real home to me. Rana and Iotham feel like blood relatives I should've had. Kavus and Sudabeh are my precious siblings."
                                },
                                {
                                    "id": "730800239",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "I hope they will grow up happy, healthy, righteous, and kind."
                                },
                                {
                                    "id": "730800240",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "So, even though Arana has made my \"job\" that much more difficult, I appreciate what she did very much."
                                },
                                {
                                    "id": "730800241",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Oh, I finally get it. Just like you distracted Paimon, the children ought not to know the dirty deeds."
                                },
                                {
                                    "id": "730800242",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "\"Youngster, you should enjoy childhood, do what you like, see what you want to see. But also remember the dark days...\""
                                },
                                {
                                    "id": "730800243",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "That's the House's teachings. Because facing the darker side of life is inevitable for grown-ups, you need to be prepared as a child, so you can protect yourself and those you love."
                                },
                                {
                                    "id": "730800244",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Maybe what you're doing also makes sense. If I hadn't grown up in the House of the Hearth and became a spy in Vimara Village... If only I were born in Vimara Village."
                                },
                                {
                                    "id": "730800245",
                                    "speaker": "Player",
                                    "text": "All this talk is meaningless."
                                },
                                {
                                    "id": "730800246",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "I know. I just feel sorry. I wish I'd always been \"Alphonso,\" not \"Trofin Snezhevich.\" I wish I really was Iotham's big brother."
                                },
                                {
                                    "id": "730800247",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "I want to be a good person, but I belong to an organization. I want to be family to Rana and the kids, but I've already got a \"family\" I can't turn my back on."
                                },
                                {
                                    "id": "730800248",
                                    "speaker": "Trofin Snezhevich",
                                    "text": "Many of my fellows have powers rivaling the Lord Harbingers and are not subject to any city or state. That's something even a free, honorary knight like you probably couldn't comprehend...",
                                    "choices": [
                                        {
                                            "id": "730800249",
                                            "text": "I do comprehend.",
                                            "response": [
                                                {
                                                    "id": "730800250",
                                                    "speaker": "Player",
                                                    "text": "But what you did is inexcusable."
                                                },
                                                {
                                                    "id": "730800253",
                                                    "speaker": "Trofin Snezhevich",
                                                    "text": "Well, that's all I've got to say. So, what are you going to do with me now?",
                                                    "choices": [
                                                        {
                                                            "id": "730800254",
                                                            "text": "Don't come near Vimara Village or let me see you again.",
                                                            "response": [
                                                                {
                                                                    "id": "730800255",
                                                                    "speaker": "Trofin Snezhevich",
                                                                    "text": "I see. Got it. You won't see me again. I'm not returning to the Fatui, either, since I blew my mission and brought shame to my \"siblings.\""
                                                                },
                                                                {
                                                                    "id": "730800256",
                                                                    "speaker": "Trofin Snezhevich",
                                                                    "text": "Iotham will probably be waiting for \"Alphonso\" to come back forever...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730800257",
                                                                            "text": "Go now. Paimon should be here any minute.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730800258",
                                                                                    "speaker": "Trofin Snezhevich",
                                                                                    "text": "Goodbye. No, farewell."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730800259",
                                                                            "text": "(Battle) I changed my mind.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730800260",
                                                                                    "speaker": "Trofin Snezhevich",
                                                                                    "text": "#I've foreseen the ending for the wicked, but I won't go down without a fight. You might be {NICKNAME} and I might not have a chance, but I'll still fight, because..."
                                                                                },
                                                                                {
                                                                                    "id": "730800261",
                                                                                    "speaker": "Trofin Snezhevich",
