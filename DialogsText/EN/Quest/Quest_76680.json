    "talks": [
        {
            "id": "7668001",
            "objective": "Talk to Blue Bolt",
            "dialogues": [
                {
                    "id": "766800101",
                    "speaker": "Blue Bolt",
                    "text": "#Oh hey there, {NICKNAME}! Hello, Paimon!"
                },
                {
                    "id": "766800102",
                    "speaker": "Blue Bolt",
                    "text": "Since we ran into each other, wanna see my weasel, Sproutie? I've got it with me, and it's super adorable!"
                },
                {
                    "id": "766800103",
                    "speaker": "Sproutie",
                    "text": "...Meow?"
                },
                {
                    "id": "766800104",
                    "speaker": "Blue Bolt",
                    "text": "Hey, hey, hey, that's not how you're supposed to sound, Sproutie! I don't think the two of them here understand Ashru's tongue anyway."
                },
                {
                    "id": "766800105",
                    "speaker": "Sproutie",
                    "text": "...Coo?"
                },
                {
                    "id": "766800106",
                    "speaker": "Blue Bolt",
                    "text": "No, speaking like finches won't work here either. Miss Basima has already returned to Sumeru to recuperate."
                },
                {
                    "id": "766800107",
                    "speaker": "Blue Bolt",
                    "text": "I'm sorry, Sproutie is clearly a little confused after hanging out so much with the other animals. It can't quite find its own wavelength, heh heh..."
                },
                {
                    "id": "766800108",
                    "speaker": "Blue Bolt",
                    "text": "I should let it rest for a while.",
                    "choices": [
                        {
                            "id": "766800109",
                            "text": "Are you an animal expert too?",
                            "response": [
                                {
                                    "id": "766800111",
                                    "speaker": "Paimon",
                                    "text": "Hmm... Why does Paimon get the sense that you're talking to us like we're already old friends? Did you run a background check on us or something?"
                                },
                                {
                                    "id": "766800112",
                                    "speaker": "Blue Bolt",
                                    "text": "Relax, relax... We're on the same team..."
                                },
                                {
                                    "id": "766800113",
                                    "speaker": "Blue Bolt",
                                    "text": "I work for Miss Yelan, and you're her absolute, top-tier, number-one guests. I don't even need to tell you how close that makes us, right?",
                                    "choices": [
                                        {
                                            "id": "766800114",
                                            "text": "Yeah, that does make you one of us.",
                                            "response": [
                                                {
                                                    "id": "766800116",
                                                    "speaker": "Paimon",
                                                    "text": "Gosh, you should've said so sooner! Paimon was getting a little nervous for a second there..."
                                                },
                                                {
                                                    "id": "766800117",
                                                    "speaker": "Paimon",
                                                    "text": "Anyway, what are you doing here in the middle of nowhere with Sproutie?"
                                                },
                                                {
                                                    "id": "766800118",
                                                    "speaker": "Blue Bolt",
                                                    "text": "We're standing guard here... Or rather, I'm checking to see if my \"Hoard Guard Unit\" can actually work properly.",
                                                    "choices": [
                                                        {
                                                            "id": "766800119",
                                                            "text": "\"Hoard Guard\"?",
                                                            "response": [
                                                                {
                                                                    "id": "766800121",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "Since we're on the same side, I guess there's no harm in telling you..."
                                                                },
                                                                {
                                                                    "id": "766800122",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "I have a supply point hidden underground, not far from here. However, the gate's been getting busted open by monsters left and right lately."
                                                                },
                                                                {
                                                                    "id": "766800123",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "So, at great personal expense, I had the Whiz-Kid Mechanic over at Clink-Clank Krumkake Craftshop build me my very own guard unit."
                                                                },
                                                                {
                                                                    "id": "766800124",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "Ahem, more accurately speaking, it's really more like a security system. One that's capable of identifying deployment locations, with multiple functions that can be combined in various ways."
                                                                },
                                                                {
                                                                    "id": "766800125",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "Talk about good timing! The Whiz-Kid is showcasing her work at a convention soon. She sold me this set as an early test run."
                                                                },
                                                                {
                                                                    "id": "766800126",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "So, I set up a layered defense for the supply point. It's an open invitation for our honored guests — I mean, monsters — to walk straight into my trap."
                                                                },
                                                                {
                                                                    "id": "766800127",
                                                                    "speaker": "Blue Bolt",
                                                                    "text": "Now, not only can we test out different ways to protect the supply point, but we'll also gather plenty of data for the Whiz-Kid. Talk about killing two birds with one stone!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "766800128",
                                                                            "text": "You've managed to snag yourself one of Aino's creations, I see.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "766800130",
                                                                                    "speaker": "Blue Bolt",
                                                                                    "text": "Wanna give it a whirl? I've already used them to fend off quite a number of monsters. It's quite the stress reliever, actually."
                                                                                },
                                                                                {
                                                                                    "id": "766800131",
                                                                                    "speaker": "Blue Bolt",
                                                                                    "text": "Come on, give it a try. You can let off some steam, and I might be able to learn something from your approach at the same time!"
                                                                                },
                                                                                {
                                                                                    "id": "766800132",
                                                                                    "speaker": "Blue Bolt",
                                                                                    "text": "Of course, you'll be handsomely remunerated. Since we're all on the same team, it's only fair that I pay you twice the standard consultant rate.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "766800133",
                                                                                            "text": "Too right! We're on the same team, so you can't be stingy!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "766800135",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hmm... Yeah! Helping you is helping Yelan anyway, so everybody wins!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "766800136",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Alright then! We'll show you what experience looks like in practice!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "766800134",
                                                                                            "text": "Heh, you're too kind..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "766800129",
                                                                            "text": "That does sound rather interesting."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766800120",
                                                            "text": "\"Guard Unit\"?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766800115",
                                            "text": "Any friend of Yelan's is a friend of ours too."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766800110",
                            "text": "Are you a friend of animals too?"
                        }
                    ]
                }
            ]
        }
    ]
}