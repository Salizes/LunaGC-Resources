            "dialogues": [
                {
                    "id": "745300301",
                    "speaker": "Player",
                    "text": "Give me a second, I'm considering my options."
                }
            ]
        },
        {
            "id": "7453004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745300401",
                    "speaker": "Kachina",
                    "text": "Ah, you're back!",
                    "choices": [
                        {
                            "id": "745300402",
                            "text": "You seem to be in a good mood, Kachina.",
                            "response": [
                                {
                                    "id": "745300404",
                                    "speaker": "Kachina",
                                    "text": "Hehe. I found some awesome ore during this excavation!"
                                },
                                {
                                    "id": "745300405",
                                    "speaker": "Kachina",
                                    "text": "If polished properly, it could turn into a big, shiny gemstone!"
                                },
                                {
                                    "id": "745300406",
                                    "speaker": "Player",
                                    "text": "That's great!"
                                },
                                {
                                    "id": "745300407",
                                    "speaker": "Kachina",
                                    "text": "Right? To be honest, the dig didn't get off to a good start, and I almost went home empty-handed."
                                },
                                {
                                    "id": "745300408",
                                    "speaker": "Kachina",
                                    "text": "But I thought to myself that I should hang on a little longer. So I did, and then I held out a little longer, and a little longer..."
                                },
                                {
                                    "id": "745300409",
                                    "speaker": "Kachina",
                                    "text": "I don't know how many times I repeated that... but I got it in the end!"
                                },
                                {
                                    "id": "745300410",
                                    "speaker": "Kachina",
                                    "text": "I only realized that the sun was setting when I got outside... I wound up digging all day.",
                                    "choices": [
                                        {
                                            "id": "745300411",
                                            "text": "That's our Kachina, alright.",
                                            "response": [
                                                {
                                                    "id": "745300413",
                                                    "speaker": "Kachina",
                                                    "text": "R—Really? I—I... kinda get shy in front of Kameras... I'm not sure this'll go well..."
                                                },
                                                {
                                                    "id": "745300414",
                                                    "speaker": "Kachina",
                                                    "text": "But... I'll do my best!",
                                                    "choices": [
                                                        {
                                                            "id": "745300415",
                                                            "text": "You're already doing your best, Kachina.",
                                                            "response": [
                                                                {
                                                                    "id": "745300417",
                                                                    "speaker": "Kachina",
                                                                    "text": "Okay then! I'll leave it to you."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745300416",
                                                            "text": "You're great just the way you are."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745300412",
                                            "text": "Let me take a picture of you shining bright!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745300403",
                            "text": "Has something good happened?"
                        }
                    ]
                }
            ]
        }
    ]
