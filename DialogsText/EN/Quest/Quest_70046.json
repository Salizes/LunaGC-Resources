        },
        "total_dialogue_lines": 34,
        "total_speaker_counts": {
            "Jala": 15,
            "Paimon": 11,
            "Player": 8
        }
    },
    "talks": [
        {
            "id": "7004601",
            "objective": "Talk to the strange fisherman",
            "dialogues": [
                {
                    "id": "700460101",
                    "speaker": "Jala",
                    "text": "Perfect, it looks like I'm all set..."
                },
                {
                    "id": "700460102",
                    "speaker": "Jala",
                    "text": "Put your back into it, Jala! You'll round 'em all up in a few days!",
                    "choices": [
                        {
                            "id": "700460103",
                            "text": "R—Round up?",
                            "response": [
                                {
                                    "id": "700460105",
                                    "speaker": "Paimon",
                                    "text": "Eek! A poacher in Fontaine... Does animal trafficking make so much money nowadays?"
                                },
                                {
                                    "id": "700460106",
                                    "speaker": "Paimon",
                                    "text": "Not on Paimon's watch! You're coming to the Maison Gardiennage with us!"
                                },
                                {
                                    "id": "700460107",
                                    "speaker": "Jala",
                                    "text": "...Huh. It's you two."
                                },
                                {
                                    "id": "700460108",
                                    "speaker": "Jala",
                                    "text": "Well, sure. I just came from the Maison, in fact. Need me to show you the way?"
                                },
                                {
                                    "id": "700460109",
                                    "speaker": "Paimon",
                                    "text": "?",
                                    "choices": [
                                        {
                                            "id": "700460110",
                                            "text": "Good. I like straightforward people!",
                                            "response": [
                                                {
                                                    "id": "700460111",
                                                    "speaker": "Paimon",
                                                    "text": "Wait, something's not right... You're not scared by the thought of being arrested at all. You must be a regular offender... Or maybe..."
                                                },
                                                {
                                                    "id": "700460114",
                                                    "speaker": "Jala",
                                                    "text": "I could be standing on the right side of the law, eh?"
                                                },
                                                {
                                                    "id": "700460115",
                                                    "speaker": "Jala",
                                                    "text": "More accurately, the Maison has hired me as a special environmental protection consultant — an \"Unchained Hunter.\""
                                                },
                                                {
                                                    "id": "700460116",
                                                    "speaker": "Jala",
                                                    "text": "Specifically, I'm hunting invasive species of fish that have made their way into Fontaine's waters."
                                                },
                                                {
                                                    "id": "700460117",
                                                    "speaker": "Paimon",
                                                    "text": "Invasive... species?",
                                                    "choices": [
                                                        {
                                                            "id": "700460118",
                                                            "text": "That sounds familiar.",
                                                            "response": [
                                                                {
                                                                    "id": "700460119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Right! Paimon thinks we heard about something like that back in Mondstadt..."
                                                                },
                                                                {
                                                                    "id": "700460122",
                                                                    "speaker": "Jala",
                                                                    "text": "Well, let's not dwell on the past. What matters is the here and now."
                                                                },
                                                                {
                                                                    "id": "700460123",
                                                                    "speaker": "Jala",
                                                                    "text": "These invasive species were let loose by some merchants who hold strange beliefs."
                                                                },
                                                                {
                                                                    "id": "700460124",
                                                                    "speaker": "Jala",
                                                                    "text": "Some of the fish are extremely aggressive, others reproduce incredibly fast, and others were raised on special feed. All told, they're a huge problem for all the local aquatic life."
                                                                },
                                                                {
                                                                    "id": "700460125",
                                                                    "speaker": "Jala",
                                                                    "text": "If these fish occupy the habitats of local creatures and mess up the ecosystem, Fontaine's water quality might be affected."
                                                                },
                                                                {
                                                                    "id": "700460126",
                                                                    "speaker": "Jala",
                                                                    "text": "The impact on Fontainians' health might be something we'd only feel in the future. But the flavor of a drink like Fonta could change instantly, and that'll spell untold trouble for the economy.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "700460127",
                                                                            "text": "Fonta shall not fall! Not today!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "700460129",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "All this understatement makes the problem sound worse! We can't just sit back and do nothing!"
                                                                                },
                                                                                {
                                                                                    "id": "700460130",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Now, we're old hands at catching fish, so why don't we help you out?"
                                                                                },
                                                                                {
                                                                                    "id": "700460131",
                                                                                    "speaker": "Jala",
                                                                                    "text": "Yes! I've been waiting for you to say that!"
                                                                                },
                                                                                {
                                                                                    "id": "700460132",
                                                                                    "speaker": "Jala",
                                                                                    "text": "I've already set up a capture zone into which we can lure all those invasive fish using bait..."
                                                                                },
                                                                                {
                                                                                    "id": "700460133",
                                                                                    "speaker": "Jala",
                                                                                    "text": "So it's time to strut your stuff, Honorary Knight and Helper in White! As for me, I'll support you from the rear!"
                                                                                },
                                                                                {
                                                                                    "id": "700460134",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Is it just Paimon, or does she... understand us really well?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "700460128",
                                                                            "text": "I don't really drink Fonta, but I understand its importance."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "700460120",
                                                            "text": "What's that?",
                                                            "response": [
                                                                {
                                                                    "id": "700460121",
                                                                    "speaker": "Paimon",
                                                                    "text": "Paimon's memory is fuzzy, but we heard about something like that in Mondstadt ages ago, she's sure of it..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700460112",
                                            "text": "Maybe... there's been a misunderstanding?",
                                            "response": [
                                                {
                                                    "id": "700460113",
                                                    "speaker": "Paimon",
                                                    "text": "True. She's not scared by the thought of being arrested at all. She must be a regular offender... Or maybe..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700460104",
                            "text": "A p—poacher?"
                        }
                    ]
                }
            ]
        }
    ]
}