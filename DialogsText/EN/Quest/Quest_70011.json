            "objective": "Talk to the hilichurl",
            "dialogues": [
                {
                    "id": "700110101",
                    "speaker": "Cautious Hilichurl",
                    "text": "Yaya dala! Kundala?"
                },
                {
                    "id": "700110102",
                    "speaker": "Ella Musk",
                    "text": "Mimi nye odomu! Kundala nye!"
                },
                {
                    "id": "700110103",
                    "speaker": "Cautious Hilichurl",
                    "text": "Nye Odomu? Yoyo mani mi?"
                },
                {
                    "id": "700110104",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo, mimi plata odomu! Mimi mani ye!"
                },
                {
                    "id": "700110105",
                    "speaker": "Cautious Hilichurl",
                    "text": "Mani...? Zido mi, mi dada. Nye kundala? Mi plata yeye!"
                },
                {
                    "id": "700110106",
                    "speaker": "Paimon",
                    "text": "Whew... This one's got a real bad temper...",
                    "choices": [
                        {
                            "id": "700110107",
                            "text": "Miss Musk, please... Be careful...",
                            "response": [
                                {
                                    "id": "700110109",
                                    "speaker": "Ella Musk",
                                    "text": "No, thank you. Everything's fine. I can understand."
                                },
                                {
                                    "id": "700110110",
                                    "speaker": "Paimon",
                                    "text": "...Huh?"
                                },
                                {
                                    "id": "700110111",
                                    "speaker": "Ella Musk",
                                    "text": "It just wants us to help defeat an enemy. ...Here, on the Map."
                                },
                                {
                                    "id": "700110113",
                                    "speaker": "Player",
                                    "text": "I see..."
                                },
                                {
                                    "id": "700110114",
                                    "speaker": "Ella Musk",
                                    "text": "Okay then, the location is marked on your Map — the rest is in your hands!"
                                },
                                {
                                    "id": "700110115",
                                    "speaker": "Cautious Hilichurl",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700110108",
                            "text": "Need me to step in?"
                        }
                    ]
                }
            ]
        },
        {
