    "talks": [
        {
            "id": "2204101",
            "objective": "Talk to Neko",
            "dialogues": [
                {
                    "id": "220410101",
                    "speaker": "Neko",
                    "text": "You time your arrival well. I was just fretting about something."
                },
                {
                    "id": "220410102",
                    "speaker": "Player",
                    "text": "What's the matter?"
                },
                {
                    "id": "220410103",
                    "speaker": "Neko",
                    "text": "Do you recall that child, Konbumaru?"
                },
                {
                    "id": "220410104",
                    "speaker": "Neko",
                    "text": "That little rascal went off to play nearby and has not returned. I am most worried."
                },
                {
                    "id": "220410105",
                    "speaker": "Neko",
                    "text": "Please, help to search for Konbumaru and bring him back.",
                    "choices": [
                        {
                            "id": "220410106",
                            "text": "Consider it done.",
                            "response": [
                                {
                                    "id": "220410107",
                                    "speaker": "Neko",
                                    "text": "Wonderful. Remember, you need to find Konbumaru and bring him back."
                                }
                            ]
                        },
                        {
                            "id": "220410108",
                            "text": "Is it the only one who ran off?",
                            "response": [
                                {
                                    "id": "220410109",
                                    "speaker": "Neko",
                                    "text": "Indeed... Perhaps it was my previous scolding that displeased it so."
                                },
                                {
                                    "id": "220410110",
                                    "speaker": "Neko",
                                    "text": "Ah, why will this child not listen to instruction..."
                                },
                                {
                                    "id": "220410111",
                                    "speaker": "Neko",
                                    "text": "Either way, please find Konbumaru and bring him back here."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204102",
            "objective": "Look for \"Konbumaru\"",
            "dialogues": [
                {
                    "id": "220410201",
                    "speaker": "Neko",
                    "text": "I am counting on you to bring Konbumaru back to this shrine."
                }
            ]
        },
        {
            "id": "2204103",
            "objective": "Talk to Neko",
            "dialogues": [
                {
                    "id": "220410301",
                    "speaker": "Neko",
                    "text": "How does your task go? Have you found Konbumaru?"
                },
                {
                    "id": "220410302",
                    "speaker": "Player",
                    "text": "Sure did."
                },
                {
                    "id": "220410303",
                    "speaker": "Paimon",
                    "text": "...Wait, what? It's run off again!",
                    "choices": [
                        {
                            "id": "220410304",
                            "text": "I'll go get it back!",
                            "response": [
                                {
                                    "id": "220410306",
                                    "speaker": "Neko",
                                    "text": "No, there's no need to give chase."
                                },
                                {
                                    "id": "220410307",
                                    "speaker": "Neko",
                                    "text": "It is me that that child is still angry at... I will teach them a lesson personally later."
                                },
                                {
                                    "id": "220410308",
                                    "speaker": "Neko",
                                    "text": "Ah, it is almost old enough to be an adult cat. Why is it still so stubborn? What would we do if it frightened the humans coming to the shrine?"
                                },
                                {
                                    "id": "220410309",
                                    "speaker": "Neko",
                                    "text": "Right. This is for you as thanks for your help."
                                },
                                {
                                    "id": "220410310",
                                    "speaker": "Neko",
                                    "text": "*sigh* Why can't this child be as teachable as Meshi..."
                                }
                            ]
                        },
                        {
                            "id": "220410305",
                            "text": "Well, I never..."
                        }
                    ]
                }
            ]
        }
    ]
}