    "talks": [
        {
            "id": "7352701",
            "objective": "Talk to the engineer",
            "dialogues": [
                {
                    "id": "735270101",
                    "speaker": "???",
                    "text": "I never imagined that you two would follow the sound of the broadcast here, especially after being warned!"
                },
                {
                    "id": "735270102",
                    "speaker": "???",
                    "text": "Pardon me, but this attraction isn't officially open to the public yet. Please wait a few minutes for me to make some final adjustments...",
                    "choices": [
                        {
                            "id": "735270103",
                            "text": "What are you planning?",
                            "response": [
                                {
                                    "id": "735270105",
                                    "speaker": "Paimon",
                                    "text": "Paimon heard words that sounded super scary! Water cannons! Must be that huge thing over there..."
                                },
                                {
                                    "id": "735270106",
                                    "speaker": "Paimon",
                                    "text": "Whoa, it's scary just to look at!"
                                },
                                {
                                    "id": "735270107",
                                    "speaker": "Paimon",
                                    "text": "Just what are you trying to do here!? We won't let you get away with it!"
                                },
                                {
                                    "id": "735270108",
                                    "speaker": "Chatillon",
                                    "text": "No, no, you misunderstand!"
                                },
                                {
                                    "id": "735270109",
                                    "speaker": "Chatillon",
                                    "text": "I'm Chatillon, head of project \"Spino Blaster\"! This project simulates naval battles, but much more fun and casual!"
                                },
                                {
                                    "id": "735270110",
                                    "speaker": "Chatillon",
                                    "text": "\"Spino Blaster\" is approved by Lady Idyia, so you know it's safe!"
                                },
                                {
                                    "id": "735270111",
                                    "speaker": "Chatillon",
                                    "text": "If you wish to verify the truth of that, please see this document signed by Lady Idyia herself."
                                },
                                {
                                    "id": "735270112",
                                    "speaker": "Black Screen",
                                    "text": "The suspicious engineer offers proof in the form of official documents written in obtuse legalese, all with Idyia's distinct signature.\\nThe margins even contain a few remarks and well-wishes from Idyia in her inimitable style..."
                                },
                                {
                                    "id": "735270113",
                                    "speaker": "Paimon",
                                    "text": "So it's a project approved by Idyia... you scared us half to death!"
                                },
                                {
                                    "id": "735270114",
                                    "speaker": "Paimon",
                                    "text": "So, what's the deal with the water cannons?"
                                },
                                {
                                    "id": "735270115",
                                    "speaker": "Chatillon",
                                    "text": "That's just a simplified nickname! Its full name is so long that I'm pretty sure most people would go for something shorter based on its appearance."
                                },
                                {
                                    "id": "735270116",
                                    "speaker": "Chatillon",
                                    "text": "Anyway, its water bullets are completely harmless! At most, they might soak the guests standing near their target."
                                },
                                {
                                    "id": "735270117",
                                    "speaker": "Chatillon",
                                    "text": "Some guests enjoy the sudden coolness from being splashed, but some hate how their clothes stick to their body afterward, and we don't want anyone to have a bad experience!"
                                },
                                {
                                    "id": "735270118",
                                    "speaker": "Chatillon",
                                    "text": "So if possible, I would like to post warning signs around the area."
                                },
                                {
                                    "id": "735270119",
                                    "speaker": "Paimon",
                                    "text": "Paimon didn't think you were so considerate, that's a great idea!",
                                    "choices": [
                                        {
                                            "id": "735270120",
                                            "text": "Now I'm curious...",
                                            "response": [
                                                {
                                                    "id": "735270122",
                                                    "speaker": "Chatillon",
                                                    "text": "It's called the Crocomorph Vortex-Based Crocodilian-Armored Heavy Naval Battleship-Style Recreational Water Blasting Cannon! The name accurately reflects both the appearance and its underlying principles!"
                                                },
                                                {
                                                    "id": "735270123",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, you weren't kidding! Paimon can't even repeat it, much less understand it..."
                                                },
                                                {
                                                    "id": "735270124",
                                                    "speaker": "Paimon",
                                                    "text": "But just calling it a water cannon kinda misses the point, right? Why not call it a Crococannon?"
                                                },
                                                {
                                                    "id": "735270125",
                                                    "speaker": "Chatillon",
                                                    "text": "The... the alliteration..."
                                                },
                                                {
                                                    "id": "735270126",
                                                    "speaker": "Chatillon",
                                                    "text": "That's perfect! Simple and easy to remember, yet it captures the sound of shells whizzing by your eyes in a simulated naval battle! I love it!"
                                                },
                                                {
                                                    "id": "735270127",
                                                    "speaker": "Chatillon",
                                                    "text": "Crococannon, fire away!"
                                                },
                                                {
                                                    "id": "735270128",
                                                    "speaker": "Paimon",
                                                    "text": "Crococannon bubbleball away!",
                                                    "choices": [
                                                        {
                                                            "id": "735270129",
                                                            "text": "Are you serious?",
                                                            "response": [
                                                                {
                                                                    "id": "735270131",
                                                                    "speaker": "Chatillon",
                                                                    "text": "After all, not only do we have great chemistry, but you'll get to enjoy the one-of-a-kind fun!"
                                                                },
                                                                {
                                                                    "id": "735270132",
                                                                    "speaker": "Chatillon",
                                                                    "text": "Say, how about you two be the first to try out \"Spino Blaster\"?"
                                                                },
                                                                {
                                                                    "id": "735270133",
                                                                    "speaker": "Chatillon",
                                                                    "text": "The rules are simple. Adjust the Crococannon and hit balloon targets with bubbleballs to earn points! When you earn a high enough score, you can win prizes!"
                                                                },
                                                                {
                                                                    "id": "735270134",
                                                                    "speaker": "Paimon",
                                                                    "text": "Well, after all this hype, Paimon kinda does want to see what it's like to use a Crococannon!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "735270135",
                                                                            "text": "All right, count me in!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "735270137",
                                                                                    "speaker": "Chatillon",
                                                                                    "text": "Perfect! Let me finish a few final adjustments, and then you can get started!"
                                                                                },
                                                                                {
                                                                                    "id": "735270138",
                                                                                    "speaker": "Chatillon",
                                                                                    "text": "Enjoy yourselves!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "735270136",
                                                                            "text": "Crococannon, open fi— water!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735270130",
                                                            "text": "Paimon doesn't like being made fun of..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735270121",
                                            "text": "What's its full name?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735270104",
                            "text": "Stop it, now!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7352799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735279901",
                    "speaker": "???",
                    "text": "Attention, visitors below! Attention, visitors below! You are in water cannon range and are at risk of being hit. Please vacate the zone immediately!"
                },
                {
                    "id": "735279902",
                    "speaker": "Paimon",
                    "text": "Was that a warning? And did he say \"water cannon\"...? That doesn't sound good!"
                },
                {
                    "id": "735279903",
                    "speaker": "Paimon",
                    "text": "The broadcast came from over there. Let's see what's going on!"
                }
            ]
        }
    ]
}