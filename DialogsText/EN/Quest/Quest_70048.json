            "dialogues": [
                {
                    "id": "700480101",
                    "speaker": "Freminet",
                    "text": "#Ah, it's you, {NICKNAME}. Sorry, I didn't realize you were here..."
                },
                {
                    "id": "700480102",
                    "speaker": "Freminet",
                    "text": "This resort is huge, and there's barely anyone I recognize. Luckily, I've run into you."
                },
                {
                    "id": "700480103",
                    "speaker": "Player",
                    "text": "What are you up to, Freminet?"
                },
                {
                    "id": "700480104",
                    "speaker": "Freminet",
                    "text": "I'm observing the sea around Natlan. There are aquatic creatures here I've never seen before, like those two over there.",
