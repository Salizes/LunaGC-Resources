    "talks": [
        {
            "id": "7405103",
            "objective": "",
            "dialogues": [
                {
                    "id": "740510201",
                    "speaker": "Xingye",
                    "text": "What're we gonna do now, Boss? The filming's not done and the Kamera's lost..."
                },
                {
                    "id": "740510202",
                    "speaker": "Ms. Qiu",
                    "text": "Alright, stop sighing. Didn't we go post a commission at the Adventurers' Guild?"
                },
                {
                    "id": "740510203",
                    "speaker": "Ms. Qiu",
                    "text": "There's only one thing we got left to do today, and that's to wait..."
                },
                {
                    "id": "740510204",
                    "speaker": "Yifeng",
                    "text": "Yeah, but our half-finished film is still in the Kamera."
                },
                {
                    "id": "740510205",
                    "speaker": "Yifeng",
                    "text": "Even though the machine's pretty hardy, if the film gets damaged..."
                },
                {
                    "id": "740510206",
                    "speaker": "Ms. Qiu",
                    "text": "Then...",
                    "choices": [
                        {
                            "id": "740510207",
                            "text": "What Film Kamera?",
                            "response": [
                                {
                                    "id": "740510208",
                                    "speaker": "Ms. Qiu",
                                    "text": "Well, well! Didn't I say help was coming? As I said, all we had to do was wait!"
                                },
                                {
                                    "id": "740510221",
                                    "speaker": "Yifeng",
                                    "text": "When did the Adventurers' Guild get this efficient?"
                                },
                                {
                                    "id": "740510209",
                                    "speaker": "Xingye",
                                    "text": "Hmm, it seems like some Fontainians aren't that slow-going after all."
                                },
                                {
                                    "id": "740510210",
                                    "speaker": "Ms. Qiu",
                                    "text": "Hello there, adventurer. You must be here for the commission to help us get our Film Kamera back, right?"
                                },
                                {
                                    "id": "740510211",
                                    "speaker": "Ms. Qiu",
                                    "text": "We were attacked by monsters over there, can you please hurry...",
                                    "choices": [
                                        {
                                            "id": "740510212",
                                            "text": "I didn't accept any commission.",
                                            "response": [
                                                {
                                                    "id": "740510214",
                                                    "speaker": "Xingye",
                                                    "text": "Oh..."
                                                },
                                                {
                                                    "id": "740510215",
                                                    "speaker": "Yifeng",
                                                    "text": "Then..."
                                                },
                                                {
                                                    "id": "740510216",
                                                    "speaker": "Ms. Qiu",
                                                    "text": "That's fine! It's all fine. I knew the Adventurers' Guild wasn't reliable..."
                                                },
                                                {
                                                    "id": "740510217",
                                                    "speaker": "Ms. Qiu",
                                                    "text": "Adventurer, would you like to accept an emergency commission? The pay's real good.",
                                                    "choices": [
                                                        {
                                                            "id": "740510218",
                                                            "text": "That sounds fine...",
                                                            "response": [
                                                                {
                                                                    "id": "740510220",
                                                                    "speaker": "Ms. Qiu",
                                                                    "text": "Great! Fantastic! I need you to go over and help us get our Film Kamera back! We'd be in your debt!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740510219",
                                                            "text": "As long as the pay's good."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740510213",
                                            "text": "I was just passing through."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740510222",
                            "text": "What's wrong?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7405104",
            "objective": "Defeat all monsters and retrieve the Film Kamera",
            "dialogues": [
                {
                    "id": "740510401",
                    "speaker": "Ms. Qiu",
                    "text": ""
                },
                {
                    "id": "740510402",
                    "speaker": "Xingye",
                    "text": ""
                }
            ]
        },
        {
            "id": "7405105",
            "objective": "Talk to Ms. Qiu and her company",
            "dialogues": [
                {
                    "id": "740510301",
                    "speaker": "Ms. Qiu",
                    "text": "Great! The Film Kamera is intact, and the film hasn't been destroyed..."
                },
                {
                    "id": "740510328",
                    "speaker": "Ms. Qiu",
                    "text": "Thank the Archons. I thought we were gonna have to start shooting all over again.",
                    "choices": [
                        {
                            "id": "740510302",
                            "text": "Why are you filming here?",
                            "response": [
                                {
                                    "id": "740510329",
                                    "speaker": "Ms. Qiu",
                                    "text": "It's a long story..."
                                },
                                {
                                    "id": "740510305",
                                    "speaker": "Ms. Qiu",
                                    "text": "Most people there are in the tea business but we... don't have any interest in tea..."
                                },
                                {
                                    "id": "740510306",
                                    "speaker": "Ms. Qiu",
                                    "text": "So, we changed professions and started filming dokumentari films to help promote tea vendors in the village."
                                },
                                {
                                    "id": "740510307",
                                    "speaker": "Yifeng",
                                    "text": "In truth, there are too many people in the tea business, and we just couldn't compete."
                                },
                                {
                                    "id": "740510308",
                                    "speaker": "Xingye",
                                    "text": "The skilled helpers we had at the store left one by one to work elsewhere, so if we just stuck to making tea, we'd be starving."
                                },
                                {
                                    "id": "740510309",
                                    "speaker": "Ms. Qiu",
                                    "text": "Can't you two... not make things sound so depressing!?"
                                },
                                {
                                    "id": "740510310",
                                    "speaker": "Ms. Qiu",
                                    "text": "We've made plenty of Mora shooting these tea dokumentaris in the village."
                                },
                                {
                                    "id": "740510311",
                                    "speaker": "Yifeng",
                                    "text": "But recently, some others in the village have also started to shoot their own promotional films."
                                },
                                {
                                    "id": "740510312",
                                    "speaker": "Xingye",
                                    "text": "Some of them are even performing an opera in them. They're making a real big show of it."
                                },
                                {
                                    "id": "740510313",
                                    "speaker": "Ms. Qiu",
                                    "text": "So that's why we're in Fontaine. We're trying to seek advice from master filmmakers!"
                                },
                                {
                                    "id": "740510314",
                                    "speaker": "Player",
                                    "text": "So, you're here to learn about filmmaking in Fontaine?"
                                },
                                {
                                    "id": "740510315",
                                    "speaker": "Ms. Qiu",
                                    "text": "Yeah. We found this \"lighting expert\" called Geisert."
                                },
                                {
                                    "id": "740510316",
                                    "speaker": "Ms. Qiu",
                                    "text": "He's real good at using lighting to film... what was it again?"
                                },
                                {
                                    "id": "740510317",
                                    "speaker": "Yifeng",
                                    "text": "\"Narratives.\""
                                },
                                {
                                    "id": "740510318",
                                    "speaker": "Ms. Qiu",
                                    "text": "Yeah! Applying lighting to his \"narratives.\""
                                },
                                {
                                    "id": "740510319",
                                    "speaker": "Ms. Qiu",
                                    "text": "With Mr. Geisert's advice, we can definitely shoot the best films in all of Qiaoying Village!"
                                },
                                {
                                    "id": "740510320",
                                    "speaker": "Xingye",
                                    "text": "Boss, last month you said we were going to shoot the best films in Liyue."
                                },
                                {
                                    "id": "740510321",
                                    "speaker": "Ms. Qiu",
                                    "text": "You have to adjust your expectations realistically when doing business... What do you know?"
                                },
                                {
                                    "id": "740510322",
                                    "speaker": "Ms. Qiu",
                                    "text": "Anyway, thanks for your help, Traveler. Here, take this Mora."
                                },
                                {
                                    "id": "740510323",
                                    "speaker": "Ms. Qiu",
                                    "text": "Xingye, Yifeng, pack that up quick! We gotta finish shooting our sample and show it to Mr. Geisert."
                                },
                                {
                                    "id": "740510324",
                                    "speaker": "Ms. Qiu",
                                    "text": "Watch the lighting! The Kamera's gotta be angled toward the light source in this way. We gotta capture that... high-definition lighting!"
                                },
                                {
                                    "id": "740510325",
                                    "speaker": "Ms. Qiu",
                                    "text": "You all read that book, right? The lighting's gotta have a sense of texture? You get what I'm saying?"
                                },
                                {
                                    "id": "740510326",
                                    "speaker": "Xingye",
                                    "text": "Boss, we might've read Mr. Geisert's book..."
                                },
                                {
                                    "id": "740510327",
                                    "speaker": "Yifeng",
                                    "text": "But with what we got, we're not going to be able to capture that high-definition lighting tactility you want no matter how much we struggle..."
                                }
                            ]
                        },
                        {
                            "id": "740510303",
                            "text": "Seems you aren't from Fontaine either."
                        }
                    ]
                }
            ]
        },
