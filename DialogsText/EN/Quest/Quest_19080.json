            "dialogues": [
                {
                    "id": "190802501",
                    "speaker": "Kaeya",
                    "text": "Hey, you didn't think I was being serious, did you? Do I really strike you as the kind of person to keep track of favors in a notebook?"
                }
            ]
        },
        {
            "id": "1908027",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190802701",
                    "speaker": "Tea Master Liu Su",
                    "text": "O woe is him, the hero that perishes before his time. O woe is his children, whose hearts will forever mourn his passing... But what will become of Bravebeard's younger sister, you ask? Till next time, dear listeners... All will be revealed in the next chapter."
                }
            ]
        },
        {
            "id": "1908035",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190803501",
                    "speaker": "Aunt Zhang",
                    "text": "That con-artist is human scum!"
                },
                {
                    "id": "190803502",
                    "speaker": "Guangzhi",
                    "text": "Don't worry, Wu. We'll come with you to the Ministry to report the case."
                },
                {
                    "id": "190803503",
                    "speaker": "Captain Wu",
                    "text": "Surely I'll be able to get my Mora back... probably... hopefully..."
                }
            ]
        },
        {
            "id": "1908036",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190803601",
                    "speaker": "Guangzhi",
                    "text": "Don't worry. You can count on us."
                },
                {
                    "id": "190803602",
                    "speaker": "Aunt Zhang",
                    "text": "Absolutely. We're all neighbors here. Old Wu's problems are our problems too."
                }
            ]
        },
