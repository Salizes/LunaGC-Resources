            "objective": "Talk to the other hilichurl willing to make conversation",
            "dialogues": [
                {
                    "id": "700140101",
                    "speaker": "Perplexed Hilichurl",
                    "text": "Odomu! Ya dala?"
                },
                {
                    "id": "700140102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo, Odomu nye! Muhe mani?"
                },
                {
                    "id": "700140103",
                    "speaker": "Perplexed Hilichurl",
                    "text": "Mani? Mani! Yoyo mani mi?"
                },
                {
                    "id": "700140104",
                    "speaker": "Ella Musk",
                    "text": "Dada! Muhe mani yeye!"
                },
                {
                    "id": "700140105",
                    "speaker": "Perplexed Hilichurl",
                    "text": "Dada! Mosi mita!"
                },
                {
                    "id": "700140106",
                    "speaker": "Perplexed Hilichurl",
                    "text": "Dada odomu! Kundala dada! Kundala zido, mi dada!"
                },
                {
                    "id": "700140107",
                    "speaker": "Ella Musk",
                    "text": "Ya zido? Ye? Mi?"
                },
                {
                    "id": "700140108",
                    "speaker": "Perplexed Hilichurl",
                    "text": "Mi!"
                },
                {
                    "id": "700140109",
                    "speaker": "Ella Musk",
                    "text": "I'm guessing that based on your experience over the past few days, you should be quite clear what this one wants. Thanks in advance."
                },
                {
                    "id": "700140110",
                    "speaker": "Ella Musk",
                    "text": "The location is marked on the map. Hope you manage to find what you've been looking for this time!"
                },
                {
                    "id": "700140111",
                    "speaker": "Perplexed Hilichurl",
                    "text": "Dada, Valo!"
                }
            ]
        },
        {
