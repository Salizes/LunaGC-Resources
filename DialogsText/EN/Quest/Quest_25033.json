    "talks": [
        {
            "id": "2503301",
            "objective": "Talk to Tlatem",
            "dialogues": [
                {
                    "id": "250330101",
                    "speaker": "Tlatem",
                    "text": "Good boy, good boy! Eaten your fill today? Ready to train?"
                },
                {
                    "id": "250330102",
                    "speaker": "Qica",
                    "text": "Raar, oroo, rrooh!"
                },
                {
                    "id": "250330103",
                    "speaker": "Tlatem",
                    "text": "Pretty energetic today, aren't we? Awesome! Let's do this!"
                },
                {
                    "id": "250330104",
                    "speaker": "Player",
                    "text": "Yeah, let's do this!"
                },
                {
                    "id": "250330106",
                    "speaker": "Tlatem",
                    "text": "Huh? Oh, hello there! We're doing some more mountain climbing training right now."
                },
                {
                    "id": "250330107",
                    "speaker": "Qica",
                    "text": "Rroo! Wrroo!"
                },
                {
                    "id": "250330108",
                    "speaker": "Qica",
                    "text": "Wrooo, rrooh...",
                    "choices": [
                        {
                            "id": "250330109",
                            "text": "How's the training coming along?",
                            "response": [
                                {
                                    "id": "250330110",
                                    "speaker": "Tlatem",
                                    "text": "Well... we're \"making progress.\" Qica's made it up a lot further this time."
                                },
                                {
                                    "id": "250330111",
                                    "speaker": "Tlatem",
                                    "text": "It's just that Qica's not very familiar with how you climb mountains, and..."
                                },
                                {
                                    "id": "250330116",
                                    "speaker": "Tlatem",
                                    "text": "Could you demonstrate for us again, by the way?",
                                    "choices": [
                                        {
                                            "id": "250330117",
                                            "text": "Sure I can.",
                                            "response": [
                                                {
                                                    "id": "250330118",
                                                    "speaker": "Tlatem",
                                                    "text": "Thank you so much! I'm sure I'll be able to catch your movements this time."
                                                },
                                                {
                                                    "id": "250330119",
                                                    "speaker": "Tlatem",
                                                    "text": "You keep your eyes peeled too, alright, Qica?"
                                                },
                                                {
                                                    "id": "250330120",
                                                    "speaker": "Qica",
                                                    "text": "Roar!"
                                                },
                                                {
                                                    "id": "250330123",
                                                    "speaker": "Tlatem",
                                                    "text": "We're counting on you!"
                                                },
                                                {
                                                    "id": "250330124",
                                                    "speaker": "Tlatem",
                                                    "text": "So what we'll do is time you while you climb."
                                                },
                                                {
                                                    "id": "250330125",
                                                    "speaker": "Qica",
                                                    "text": "Wroo, roooh..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250330121",
                                            "text": "Watch closely this time, alright?",
                                            "response": [
                                                {
                                                    "id": "250330122",
                                                    "speaker": "Tlatem",
                                                    "text": "Of course! Qica and I won't miss a thing this time!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250330112",
                            "text": "Looks like he's recovering nicely.",
                            "response": [
                                {
                                    "id": "250330113",
                                    "speaker": "Tlatem",
                                    "text": "That's right. Mom says I'm getting real good at caring for him."
                                },
                                {
                                    "id": "250330114",
                                    "speaker": "Tlatem",
                                    "text": "Qica's improved loads. He can climb way higher than he could last time."
                                },
                                {
                                    "id": "250330115",
                                    "speaker": "Tlatem",
                                    "text": "It's just that Qica's not very familiar with how you climb mountains, and..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2503302",
            "objective": "Climb to the top of the mountain",
            "dialogues": [
                {
                    "id": "250330201",
                    "speaker": "Tlatem",
                    "text": "You're amazing! You're just about as fast as Mayta!",
                    "choices": [
                        {
                            "id": "250330202",
                            "text": "I did make a few errors...",
                            "response": [
                                {
                                    "id": "250330204",
                                    "speaker": "Tlatem",
                                    "text": "Heh, you're plenty fast already. Qica and I can't compare at all."
                                },
                                {
                                    "id": "250330205",
                                    "speaker": "Tlatem",
                                    "text": "*sigh* We'll be training for a long time before we can match you, I'd say..."
                                },
                                {
                                    "id": "250330206",
                                    "speaker": "Qica",
                                    "text": "Wroo, roooh...",
                                    "choices": [
                                        {
                                            "id": "250330207",
                                            "text": "You can do it, Qica!",
                                            "response": [
                                                {
                                                    "id": "250330209",
                                                    "speaker": "Qica",
                                                    "text": "Wroo!? Hroo, Rrooh..."
                                                },
                                                {
                                                    "id": "250330210",
                                                    "speaker": "Tlatem",
                                                    "text": "That's a good boy, Qica. Remember what Uncle Yawar said? We'll get stronger as long as we keep working hard!"
                                                },
                                                {
                                                    "id": "250330211",
                                                    "speaker": "Qica",
                                                    "text": "Roar..."
                                                },
                                                {
                                                    "id": "250330212",
                                                    "speaker": "Tlatem",
                                                    "text": "Anyway, thanks a lot for your help. Here, have this fruit!"
                                                },
                                                {
                                                    "id": "250330213",
                                                    "speaker": "Tlatem",
                                                    "text": "Qica just picked it up — and you know, he's moving way faster than he used to!"
                                                },
                                                {
                                                    "id": "250330214",
                                                    "speaker": "Tlatem",
                                                    "text": "Hehe, I'm sure he's gotten this good because he's had you to look to as an example!"
                                                },
                                                {
                                                    "id": "250330215",
                                                    "speaker": "Qica",
                                                    "text": "Wroo, rrooh!"
                                                },
                                                {
                                                    "id": "250330216",
                                                    "speaker": "Tlatem",
                                                    "text": "Alright then, we're going to head back and look for Mayta. He should be back at the tribe settlement right now..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250330208",
                                            "text": "I believe in you two."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250330203",
                            "text": "It wasn't a perfect run..."
                        }
                    ]
                }
            ]
        },
