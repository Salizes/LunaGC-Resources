    "talks": [
        {
            "id": "7334808",
            "objective": "",
            "dialogues": [
                {
                    "id": "733480801",
                    "speaker": "Sadife",
                    "text": "Thanks again for your help, and please do not hesitate to reach out in case you need anything."
                }
            ]
        },
        {
            "id": "7334806",
            "objective": "Search for the Purbiruni scholar",
            "dialogues": [
                {
                    "id": "733480901",
                    "speaker": "Iris",
                    "text": "*sigh* This paltry funding is by no means enough for my research...",
                    "choices": [
                        {
                            "id": "733480902",
                            "text": "Um, excuse me...",
                            "response": [
                                {
                                    "id": "733480904",
                                    "speaker": "Iris",
                                    "text": "A Purbiruni researcher? Right, you must be looking for Sadife. A guest for him... Quite unusual."
                                },
                                {
                                    "id": "733480905",
                                    "speaker": "Iris",
                                    "text": "He's been back taking care of things at the Akademiya lately, and should be nearby... What's the matter?"
                                },
                                {
                                    "id": "733480906",
                                    "speaker": "Player",
                                    "text": "About Khedive's recommendation letter..."
                                },
                                {
                                    "id": "733480907",
                                    "speaker": "Iris",
                                    "text": "Khedive? So his research has wrapped up? Being rich must be nice, having a whole observation team supporting him..."
                                },
                                {
                                    "id": "733480908",
                                    "speaker": "Iris",
                                    "text": "...whereas I can't even get a subsidy for a field trip..."
                                },
                                {
                                    "id": "733480909",
                                    "speaker": "Player",
                                    "text": "You know about Khedive?"
                                },
                                {
                                    "id": "733480910",
                                    "speaker": "Iris",
                                    "text": "Of course! We poor researchers, who scrounge for funding and never make any Mora, all know about his fabulous wealth."
                                },
                                {
                                    "id": "733480911",
                                    "speaker": "Paimon",
                                    "text": "Whoa, you mean... this Khedive... and the researchers in his family, they're all loaded!?"
                                },
                                {
                                    "id": "733480912",
                                    "speaker": "Paimon",
                                    "text": "Does this mean we can get a big fat reward?"
                                },
                                {
                                    "id": "733480913",
                                    "speaker": "Iris",
                                    "text": "No way. Khedive is the exception. Don't go getting any unrealistic thoughts about the Purbiruni and Pursina researchers."
                                },
                                {
                                    "id": "733480914",
                                    "speaker": "Iris",
                                    "text": "Especially those majoring in Astrology and minoring in History and Biology... In their fields, the unlucky ones can't even manage to apply for research funding."
                                },
                                {
                                    "id": "733480915",
                                    "speaker": "Iris",
                                    "text": "Also, they always repeat something like \"Wisdom shall not be sold for gold\"..."
                                },
                                {
                                    "id": "733480916",
                                    "speaker": "Iris",
                                    "text": "*ahem* I shouldn't have said that... There's your man. Go ask him about anything else you want to know."
                                }
                            ]
                        },
                        {
                            "id": "733480903",
                            "text": "About a Purbiruni researcher..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334801",
            "objective": "Search for Sadife",
            "dialogues": [
                {
                    "id": "733480101",
                    "speaker": "Sadife",
                    "text": "But... Without those samples...",
                    "choices": [
                        {
                            "id": "733480102",
                            "text": "About the Purbirunis...",
                            "response": [
                                {
                                    "id": "733480104",
                                    "speaker": "Sadife",
                                    "text": "Yes, and the current Herbad. How may I help you?"
                                },
                                {
                                    "id": "733480105",
                                    "speaker": "Sadife",
                                    "text": "Scholarly inquiries, perhaps? You don't look like an Akademiya researcher, though..."
                                },
                                {
                                    "id": "733480106",
                                    "speaker": "Player",
                                    "text": "About Khedive's recommendation letter..."
                                },
                                {
                                    "id": "733480107",
                                    "speaker": "Sadife",
                                    "text": "Was this letter really personally written by Khedive? Wait a moment while I read it..."
                                },
                                {
                                    "id": "733480108",
                                    "speaker": "Sadife",
                                    "text": "Hmm, so his research at The Chasm is going well."
                                },
                                {
                                    "id": "733480109",
                                    "speaker": "Sadife",
                                    "text": "...Research on Fungi... aquatic environment... fossils... unique geological features... samples..."
                                },
                                {
                                    "id": "733480110",
                                    "speaker": "Sadife",
                                    "text": "Nice, perfect, astounding! He is still an astute scholar and outstanding researcher, of course he didn't disappoint!"
                                },
                                {
                                    "id": "733480111",
                                    "speaker": "Sadife",
                                    "text": "Hmph... I hate admitting this in front of an outsider, but the researchers of Pursina are certainly gifted..."
                                },
                                {
                                    "id": "733480112",
                                    "speaker": "Sadife",
                                    "text": "Moreover, Khedive did emphasize your repeated and exceptional contributions in his letter."
                                },
                                {
                                    "id": "733480113",
                                    "speaker": "Sadife",
                                    "text": "With your assistance, his research really was \"as smooth as a cat soaring in the air,\" wasn't it?",
                                    "choices": [
                                        {
                                            "id": "733480114",
                                            "text": "Please don't say that again...",
                                            "response": [
                                                {
                                                    "id": "733480116",
                                                    "speaker": "Sadife",
                                                    "text": "Is that so? Ahem, sorry about that."
                                                },
                                                {
                                                    "id": "733480117",
                                                    "speaker": "Sadife",
                                                    "text": "Another glorious chapter of Pursina will be written into the record books upon his return to the Akademiya..."
                                                },
                                                {
                                                    "id": "733480118",
                                                    "speaker": "Sadife",
                                                    "text": "Um... and the thousand-year friendship between Purbiruni and Pursina will be enhanced even further!"
                                                },
                                                {
                                                    "id": "733480119",
                                                    "speaker": "Sadife",
                                                    "text": "Please accept my gratitude, Traveler, on behalf of the Purbirunis and Pursinas."
                                                },
                                                {
                                                    "id": "733480120",
                                                    "speaker": "Sadife",
                                                    "text": "Oh, right! He also mentioned gifts for you... not a problem, just a moment."
                                                },
                                                {
                                                    "id": "733480121",
                                                    "speaker": "Player",
                                                    "text": "Not another letter, please..."
                                                },
                                                {
                                                    "id": "733480122",
                                                    "speaker": "Sadife",
                                                    "text": "Of course not another letter! For your hard work assisting Khedive's research, it is only fitting that you are compensated with Mora."
                                                },
                                                {
                                                    "id": "733480123",
                                                    "speaker": "Sadife",
                                                    "text": "But... Please forgive me. Today was such a busy day, I didn't bring much with me. If you would, please wait here for a second..."
                                                },
                                                {
                                                    "id": "733480124",
                                                    "speaker": "Paimon",
                                                    "text": "Another proud researcher, huh? But... He seems really different from Khedive."
                                                },
                                                {
                                                    "id": "733480125",
                                                    "speaker": "Paimon",
                                                    "text": "He seems... actually poor..."
                                                },
                                                {
                                                    "id": "733480126",
                                                    "speaker": "Sadife",
                                                    "text": "H-How? We Purbirunis are born researchers, and never worry about something as mundane as money..."
                                                },
                                                {
                                                    "id": "733480127",
                                                    "speaker": "Sadife",
                                                    "text": "It's just that we invest most of our money in our research. As for everything else... we tighten our belts."
                                                },
                                                {
                                                    "id": "733480128",
                                                    "speaker": "Sadife",
                                                    "text": "But this never interferes with our research. Rather, freedom from material things allows us to see the way to wisdom all the more clearly."
                                                },
                                                {
                                                    "id": "733480129",
                                                    "speaker": "Sadife",
                                                    "text": "I'll be on my way and get your payment soon. But before that, I must reluctantly make a request..."
                                                },
                                                {
                                                    "id": "733480130",
                                                    "speaker": "Sadife",
                                                    "text": "Khedive referred to you as a vigorous, experienced, outstanding, elite adventurer the likes of which is rarely seen..."
                                                },
                                                {
                                                    "id": "733480131",
                                                    "speaker": "Sadife",
                                                    "text": "If you would, I'm saying if! Could you please do me a favor? Not long ago, I was exploring the desert alone for some geological research..."
                                                },
                                                {
                                                    "id": "733480132",
                                                    "speaker": "Sadife",
                                                    "text": "And... I didn't hire a guard because... I was short on cash. I thought a quick trip would be safe, just get in and get out."
                                                },
                                                {
                                                    "id": "733480133",
                                                    "speaker": "Sadife",
                                                    "text": "But I got unlucky, and ran into Treasure Hoarders on the way back."
                                                },
                                                {
                                                    "id": "733480134",
                                                    "speaker": "Sadife",
                                                    "text": "Though I managed to escape unharmed back to the city, the case with all of my samples and notes was lost!"
                                                },
                                                {
                                                    "id": "733480135",
                                                    "speaker": "Sadife",
                                                    "text": "That case is totally worthless to merchants and Treasure Hoarders... But to me! It means the world. Priceless!"
                                                },
                                                {
                                                    "id": "733480136",
                                                    "speaker": "Sadife",
                                                    "text": "I had no luck finding an adventurer kind enough to help... Traveler, can I ask for your help? Please?",
                                                    "choices": [
                                                        {
                                                            "id": "733480137",
                                                            "text": "I'll help.",
                                                            "response": [
                                                                {
                                                                    "id": "733480139",
                                                                    "speaker": "Sadife",
                                                                    "text": "I can't thank you enough! Without you, I don't know what I'd do..."
                                                                },
                                                                {
                                                                    "id": "733480140",
                                                                    "speaker": "Sadife",
                                                                    "text": "I marked the spot where I was attacked on the map, here. The case must be somewhere nearby!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733480138",
                                                            "text": "Leave it to me."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480115",
                                            "text": "Hearing it from him was enough..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480103",
                            "text": "Excuse me, are you a Purbiruni researcher?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334802",
            "objective": "Find Sadife's case",
            "dialogues": [
                {
                    "id": "733480201",
                    "speaker": "Dara",
                    "text": "Whoa! Stop! Stop that! Just stop!"
                },
                {
                    "id": "733480202",
                    "speaker": "Dara",
                    "text": "*panting* Come on, this is absolutely unnecessary. It's just a case of books, take it if you like!",
                    "choices": [
                        {
                            "id": "733480203",
                            "text": "That's all?",
                            "response": [
                                {
                                    "id": "733480205",
                                    "speaker": "Dara",
                                    "text": "I swear it! This is all we dug out here!"
                                },
                                {
                                    "id": "733480206",
                                    "speaker": "Dara",
                                    "text": "Other than books, we did find some bottled mud and rocks... Well, there were some nice gems, actually..."
                                },
                                {
                                    "id": "733480207",
                                    "speaker": "Player",
                                    "text": "Did you take them?"
                                },
                                {
                                    "id": "733480208",
                                    "speaker": "Paimon",
                                    "text": "Hey! You better give those gems back! Those are precious geological samples!"
                                },
                                {
                                    "id": "733480209",
                                    "speaker": "Dara",
                                    "text": "Geological... samples...",
                                    "choices": [
                                        {
                                            "id": "733480210",
                                            "text": "Give them back.",
                                            "response": [
                                                {
                                                    "id": "733480212",
                                                    "speaker": "Dara",
                                                    "text": "Yes! Sure! As you say! All of them! Quick, put everything back now..."
                                                },
                                                {
                                                    "id": "733480213",
                                                    "speaker": "Dara",
                                                    "text": "See... Everything is back in the case. So, that's our cue to hit the road... Hehe..."
                                                },
                                                {
                                                    "id": "733480214",
                                                    "speaker": "Paimon",
                                                    "text": "Great, that should be everything Sadife wants. Let's bring the case back to him."
                                                },
                                                {
                                                    "id": "733480215",
                                                    "speaker": "Paimon",
                                                    "text": "Still, he actually visited the desert alone, collected all those samples and wrote so many notes! Paimon thinks he's a great researcher!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480211",
                                            "text": "On the count of THREE."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480204",
                            "text": "You sure there's nothing else?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334807",
            "objective": "Defeat the Treasure Hoarders",
            "dialogues": []
        },
        {
            "id": "7334803",
            "objective": "Talk to Dara",
            "dialogues": []
        },
        {
            "id": "7334805",
            "objective": "Report back to Sadife",
            "dialogues": [
                {
                    "id": "733480301",
                    "speaker": "Sadife",
                    "text": "Traveler, you've returned! About my case...",
                    "choices": [
                        {
                            "id": "733480302",
                            "text": "Here.",
                            "response": [
                                {
                                    "id": "733480304",
                                    "speaker": "Sadife",
                                    "text": "Excellent! Thank you so much... To think you had a recommendation letter, and yet I still made you do so much work... Please accept this payment.",
                                    "choices": [
                                        {
                                            "id": "733480305",
                                            "text": "As the Purbirunis always say...",
                                            "response": [
                                                {
                                                    "id": "733480306",
                                                    "speaker": "Sadife",
                                                    "text": "Huh? So you actually know about that? Yes, Purbiruni does have this commandment..."
                                                },
                                                {
                                                    "id": "733480307",
                                                    "speaker": "Sadife",
                                                    "text": "But this admonishment is to prevent us from betraying the principles of research for monetary or other external reasons."
                                                },
                                                {
                                                    "id": "733480308",
                                                    "speaker": "Sadife",
                                                    "text": "After all, a researcher who pursues research for profit... is unworthy of the title."
                                                },
                                                {
                                                    "id": "733480309",
                                                    "speaker": "Sadife",
                                                    "text": "But you went to such great lengths to help me, and thus you deserve a reward commensurate with your efforts."
                                                },
                                                {
                                                    "id": "733480310",
                                                    "speaker": "Sadife",
                                                    "text": "Thanks again for your help, and please do not hesitate to reach out in case you need anything."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480311",
                                            "text": "Is it that \"Wisdom shall not be sold for gold\"?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480303",
                            "text": "I got it."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334804",
            "objective": "Report back to Khedive",
            "dialogues": [
                {
                    "id": "733480401",
                    "speaker": "Khedive",
                    "text": "Look who's here, eh? Did you find a Purbiruni? Not that hard, right?",
                    "choices": [
                        {
                            "id": "733480402",
                            "text": "We did, but...",
                            "response": [
                                {
                                    "id": "733480404",
                                    "speaker": "Khedive",
                                    "text": "Hmm? You seem pretty hesitant. Did someone give you any trouble?"
                                },
                                {
                                    "id": "733480405",
                                    "speaker": "Black Screen",
                                    "text": "You tell Khedive about everything that happened with Sadife..."
                                },
                                {
                                    "id": "733480406",
                                    "speaker": "Khedive",
                                    "text": "Ah, Sadife... He's known for his stubbornness, even his teachers can't always deal with him..."
                                },
                                {
                                    "id": "733480407",
                                    "speaker": "Khedive",
                                    "text": "He even turns down every single source of funding, and insists on working alone, to \"keep his research pure\"..."
                                },
                                {
                                    "id": "733480408",
                                    "speaker": "Paimon",
                                    "text": "So that's \"Wisdom shall not be sold for gold\" at work?"
                                },
                                {
                                    "id": "733480409",
                                    "speaker": "Khedive",
                                    "text": "Well, that's the Purbiruni rule... Haha, Pursina is much more flexible."
                                },
                                {
                                    "id": "733480410",
                                    "speaker": "Khedive",
                                    "text": "Well... To be fair, it's just because I am rather well off.",
                                    "choices": [
                                        {
                                            "id": "733480411",
                                            "text": "How did you make your money?",
                                            "response": [
                                                {
                                                    "id": "733480413",
                                                    "speaker": "Khedive",
                                                    "text": "What's with that skeptical face? I earned my wealth with hard work, okay? Do you even know how hard futures trading is?",
                                                    "choices": [
                                                        {
                                                            "id": "733480414",
                                                            "text": "F-Futures trading?",
                                                            "response": [
                                                                {
                                                                    "id": "733480416",
                                                                    "speaker": "Khedive",
                                                                    "text": "I tell you... One has to know transaction volumes, market trends, and then make the right investment decisions..."
                                                                },
                                                                {
                                                                    "id": "733480417",
                                                                    "speaker": "Khedive",
                                                                    "text": "At first I thought I'd just invest a little bit for fun, I didn't want it to impact my research..."
                                                                },
                                                                {
                                                                    "id": "733480418",
                                                                    "speaker": "Khedive",
                                                                    "text": "Who would have thought that... Ugh! I made more and more Mora, and the money I had sitting in the exchange grew and grew..."
                                                                },
                                                                {
                                                                    "id": "733480419",
                                                                    "speaker": "Khedive",
                                                                    "text": "I am a professional researcher! My interest lies in research and academic work! It's scholarly results that I'm after, not Mora! That's what I have been telling myself..."
                                                                },
                                                                {
                                                                    "id": "733480420",
                                                                    "speaker": "Khedive",
                                                                    "text": "However, whenever I'm in Sumeru City, I'm drawn to the exchange, and find myself trading futures, transaction after transaction..."
                                                                },
                                                                {
                                                                    "id": "733480421",
                                                                    "speaker": "Khedive",
                                                                    "text": "So my bank account balance kept increasing, while my research... No progress AT ALL!"
                                                                },
                                                                {
                                                                    "id": "733480422",
                                                                    "speaker": "Khedive",
                                                                    "text": "So! Here I am, having hired an entire team for an expedition to The Chasm. Staying far away from anywhere with an exchange is the only way I can get any research done!"
                                                                },
                                                                {
                                                                    "id": "733480423",
                                                                    "speaker": "Khedive",
                                                                    "text": "Without satisfactory results, I... I won't leave The Chasm!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733480415",
                                                            "text": "You make money through futures trading?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733480412",
                                            "text": "Why are you so rich?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733480403",
                            "text": "Something happened..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7334805",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733480501",
                    "speaker": "Sadife",
                    "text": "I'm counting on you. Your payment will be ready soon."
                }
            ]
        },
        {
            "id": "7334810",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733481001",
                    "speaker": "Iris",
                    "text": "How on earth can I get funding... Ugh..."
                }
            ]
        },
        {
            "id": "7334811",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733481101",
                    "speaker": "Hawa",
                    "text": "I'd better get some rest. All this reading is making me dizzy..."
                }
            ]
        },
        {
            "id": "7334899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733489901",
                    "speaker": "Paimon",
                    "text": "Okay, since we're already at the Akademiya... why not try looking for some of the Purbiruni mentioned by Khedive? But where should we start..."
                },
                {
                    "id": "733489902",
                    "speaker": "Iris",
                    "text": "(No, no! I can't go back to the exchange, one more loss in futures trading and I won't even be able to afford food...)"
                },
                {
                    "id": "733489903",
                    "speaker": "Hawa",
                    "text": "(The ancient characters... They're overlapping...)"
                },
                {
                    "id": "733489904",
                    "speaker": "Sadife",
                    "text": "(Khedive... Doesn't that sound like a Pursina? How come this traveler has a hand-written letter of his?)"
                },
                {
                    "id": "733489905",
                    "speaker": "Paimon",
                    "text": "Hmm, this should be the place. Let's... start... digging..."
                },
                {
                    "id": "733489906",
                    "speaker": "Sadife",
                    "text": "(Great! Seems relatively undamaged...)"
                },
                {
                    "id": "733489907",
                    "speaker": "Sadife",
                    "text": "(If the samples are gone...)"
                }
            ]
        }
    ]
}