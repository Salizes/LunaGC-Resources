        {
            "id": "701107",
            "objective": "Talk to Paimon",
            "dialogues": [
                {
                    "id": "70110701",
                    "speaker": "Paimon",
                    "text": "Let's see how your Kamera skills are these days... Whoa, wait a sec, Paimon sees something."
                },
                {
                    "id": "70110702",
                    "speaker": "Paimon",
                    "text": "Come on, quick! It looks like a train carriage!"
                }
            ]
        },
        {
            "id": "701108",
            "objective": "Check on the defunct train",
            "dialogues": [
                {
                    "id": "70110801",
                    "speaker": "Paimon",
                    "text": "Paimon's heard that Snezhnaya has loads of railways and trains. This must be one of them! But... why is it abandoned?"
                },
                {
                    "id": "70110802",
                    "speaker": "Paimon",
                    "text": "Brrr... It's still so cold..."
                },
                {
                    "id": "70110803",
                    "speaker": "Player",
                    "text": "Still feeling chilly from getting buried in the snow?"
                },
                {
                    "id": "70110804",
                    "speaker": "Paimon",
                    "text": "Dunno... maybe? Also, is it just Paimon, or is the snow getting heavier?"
                },
                {
                    "id": "70110805",
                    "speaker": "Paimon",
                    "text": "...",
                    "choices": [
                        {
                            "id": "70110806",
                            "text": "This never happened in Nod-Krai.",
                            "response": [
                                {
                                    "id": "70110807",
                                    "speaker": "Paimon",
                                    "text": "Yeah. So it can't just be because of the cold..."
                                },
                                {
                                    "id": "70110810",
                                    "speaker": "Paimon",
                                    "text": "Ugh... It's hard to describe, but Paimon feels so weird... She's never felt like this before."
                                },
                                {
                                    "id": "70110811",
                                    "speaker": "Paimon",
                                    "text": "Everything feels heavy... Getting kinda dizzy, too..."
                                },
                                {
                                    "id": "70110812",
                                    "speaker": "Player",
                                    "text": "Should we turn back?"
                                },
                                {
                                    "id": "70110813",
                                    "speaker": "Paimon",
                                    "text": "Oh, no need. Paimon's just feeling a little low on energy, that's all. It's nothing serious. Not worth ruining our travel plans over.",
                                    "choices": [
                                        {
                                            "id": "70110814",
                                            "text": "Well, don't push yourself, okay?",
                                            "response": [
                                                {
                                                    "id": "70110816",
                                                    "speaker": "Paimon",
                                                    "text": "Yep, sure thing! Snezhnaya, here we come!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "70110815",
                                            "text": "If you start feeling worse, tell me right away."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "70110808",
                            "text": "If you're cold, come a little closer.",
                            "response": [
                                {
                                    "id": "70110809",
                                    "speaker": "Paimon",
                                    "text": "Aw, thanks for offering. But this isn't just the weather..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
