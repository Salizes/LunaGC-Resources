            "dialogues": [
                {
                    "id": "70111701",
                    "speaker": "Eye of Graeae",
                    "text": "Scanning local environment... Exit has been sealed off with ice..."
                },
                {
                    "id": "70111702",
                    "speaker": "Player",
                    "text": "Maybe we can use Pyro?"
                },
                {
                    "id": "70111703",
                    "speaker": "Eye of Graeae",
                    "text": "That would not be an efficient approach. One moment... Usable Construct Blueprint detected nearby..."
                },
                {
                    "id": "70111704",
                    "speaker": "Eye of Graeae",
                    "text": "You can use this to clear the solid ice ahead of you more quickly."
                }
            ]
        },
        {
