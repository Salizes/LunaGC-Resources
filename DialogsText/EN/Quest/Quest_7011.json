        {
            "id": "701113",
            "objective": "Continue exploring up ahead",
            "dialogues": [
                {
                    "id": "70111301",
                    "speaker": "???",
                    "text": "Incoming entity detected. Authorization... granted. Initiating original..."
                },
                {
                    "id": "70111302",
                    "speaker": "???",
                    "text": "Hello, Transcend... Descender, who has reached the eve of Tomorrow. Eye of Graeae, at your service."
                },
                {
                    "id": "70111303",
                    "speaker": "Eye of Graeae",
                    "text": "Time since last activation: ... Time measurement unavailable due to the influence of... Anyway, it must have been a very long time."
                },
                {
                    "id": "70111304",
                    "speaker": "Player",
                    "text": "Um... What are you?"
                },
                {
                    "id": "70111305",
                    "speaker": "Eye of Graeae",
                    "text": "I am, uh... I was born to fulfill a mission: to reach Tomorrow."
                },
                {
                    "id": "70111306",
                    "speaker": "Eye of Graeae",
                    "text": "To this end, I must... I must... Strange, what was it...? Wait, my body..."
                },
                {
                    "id": "70111307",
                    "speaker": "Eye of Graeae",
                    "text": "Huh? Why is my body like this?",
                    "choices": [
                        {
                            "id": "70111308",
                            "text": "I was about to ask you.",
                            "response": [
                                {
                                    "id": "70111309",
                                    "speaker": "Eye of Graeae",
                                    "text": "Apologies. After a long period of inactivity, it appears that a lot of data has been lost."
                                },
                                {
                                    "id": "70111312",
                                    "speaker": "Eye of Graeae",
                                    "text": "Anyway, I was created so that humanity could reach Tomorrow... But I am unable to load further details at this moment."
                                },
                                {
                                    "id": "70111313",
                                    "speaker": "Eye of Graeae",
                                    "text": "Nevertheless, serving humanity remains my primary objective. I have detected a drop in your surface body temperature. You cannot remain active in this state for much longer..."
                                },
                                {
                                    "id": "70111314",
                                    "speaker": "Eye of Graeae",
                                    "text": "In accordance with my preset programming, upon reactivation, I must ask the one who awakened me the following question:"
                                },
                                {
                                    "id": "70111315",
                                    "speaker": "Eye of Graeae",
                                    "text": "Will you accept me, Transcender? I will assist you, protect you, and fulfill my mission until we reach Tomorrow...",
                                    "choices": [
                                        {
                                            "id": "70111316",
                                            "text": "Uh, no thanks. This is all a bit too strange for me...",
                                            "response": [
                                                {
                                                    "id": "70111317",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "I understand your position. However, given your current physical condition, I must suggest that you reconsider."
                                                },
                                                {
                                                    "id": "70111318",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "Before I was activated, you called out a name. Presumably that of your missing companion?"
                                                },
                                                {
                                                    "id": "70111319",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "If you agree to accept me, after helping you get out of here, I will search for said companion and pinpoint their location."
                                                },
                                                {
                                                    "id": "70111320",
                                                    "speaker": "Player",
                                                    "text": "...Really? You can do that?"
                                                },
                                                {
                                                    "id": "70111321",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "To answer your question: Yes."
                                                },
                                                {
                                                    "id": "70111322",
                                                    "speaker": "Player",
                                                    "text": "...Then I accept."
                                                },
                                                {
                                                    "id": "70111323",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "You have made a very wise decision."
                                                },
                                                {
                                                    "id": "70111330",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "Now that we have reached an accord, you will be my new user. May I ask your name?"
                                                },
                                                {
                                                    "id": "70111331",
                                                    "speaker": "Player",
                                                    "text": "#{NICKNAME}."
                                                },
                                                {
                                                    "id": "70111332",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "Very well. I will remember this name until the mission is complete."
                                                },
                                                {
                                                    "id": "70111333",
                                                    "speaker": "Player",
                                                    "text": "What is your mission, exactly?"
                                                },
                                                {
                                                    "id": "70111334",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "I need to... I need to recover my body, retrieve the power to unlock Tomorrow, and help the suffering masses to reach the far shores where the Empty Ark floats..."
                                                },
                                                {
                                                    "id": "70111335",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "I can sense my power scattered across this ice-covered land. I even have a vague sense of where it might be found... But right now, that is not essential."
                                                },
                                                {
                                                    "id": "70111336",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "The key right now is you. You must survive and reunite with your companion."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "70111324",
                                            "text": "I will accept you.",
                                            "response": [
                                                {
                                                    "id": "70111325",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "You have made a very wise decision."
                                                },
                                                {
                                                    "id": "70111326",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "Now, I detected that you called out a name earlier. Presumably that of your missing companion?"
                                                },
                                                {
                                                    "id": "70111327",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "The name was \"Paimon.\" After helping you get out of here, I will search for a match in the nearby area and pinpoint their location."
                                                },
                                                {
                                                    "id": "70111328",
                                                    "speaker": "Player",
                                                    "text": "Wait... You can do that?"
                                                },
                                                {
                                                    "id": "70111329",
                                                    "speaker": "Eye of Graeae",
                                                    "text": "Merely the tip of the iceberg."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "70111310",
                            "text": "Oh... so you weren't born like this?",
                            "response": [
                                {
                                    "id": "70111311",
                                    "speaker": "Eye of Graeae",
                                    "text": "I have been like this since I was created... And yet, I also have memories and an awareness of a physical form that I once had. But this contradicts my current status..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
