        {
            "id": "701132",
            "objective": "Go to the house where Paimon might be",
            "dialogues": [
                {
                    "id": "70113201",
                    "speaker": "Black Screen",
                    "text": "You meet up with Paimon in the house..."
                }
            ]
        },
        {
            "id": "701131",
            "objective": "Go outside the house",
            "dialogues": []
        },
        {
            "id": "701129",
            "objective": "Use the Eye of Graeae",
            "dialogues": []
        },
        {
            "id": "701130",
            "objective": "Drive the train using the Eye of Graeae",
            "dialogues": []
        },
        {
            "id": "701126",
            "objective": "Drive the train out of the blizzard",
            "dialogues": [
                {
                    "id": "70112601",
                    "speaker": "Eye of Graeae",
                    "text": "Heading north from here, we will soon arrive at..."
                },
                {
                    "id": "70112602",
                    "speaker": "Eye of Graeae",
                    "text": "Wait, there's an error message... \"Could not detect clear tracks\"...?"
                },
                {
                    "id": "70112603",
                    "speaker": "Paimon",
                    "text": "Um, what exactly does \"clear\" mean...?"
                },
                {
                    "id": "70112604",
                    "speaker": "Eye of Graeae",
                    "text": "Brace for impact, friends! Preparing to enter impromptu flight mode..."
                }
            ]
        },
        {
            "id": "701128",
            "objective": "Talk to Paimon and the Eye of Graeae",
            "dialogues": []
        },
        {
            "id": "701127",
            "objective": "Talk to Paimon and the Eye of Graeae",
            "dialogues": [
                {
                    "id": "70112701",
                    "speaker": "Eye of Graeae",
                    "text": "How strange. Not only was the station's status different from my records, but even the railroads and the terrain itself have changed substantially..."
                },
                {
                    "id": "70112702",
                    "speaker": "Player",
                    "text": "Paimon, are you okay?"
                },
                {
                    "id": "70112703",
                    "speaker": "Paimon",
                    "text": "Yeah, thanks to your quick reflexes..."
                },
                {
                    "id": "70112704",
                    "speaker": "Eye of Graeae",
                    "text": "My sincere apologies for putting you in danger. I'm afraid I'm as confused by all this as you are...",
                    "choices": [
                        {
                            "id": "70112705",
                            "text": "We need to find a way to update your databanks...",
                            "response": [
                                {
                                    "id": "70112707",
                                    "speaker": "Eye of Graeae",
                                    "text": "Agreed — this is likely a consequence of outdated railroad data. The discrepancies between the old data and present reality are far greater than I anticipated..."
                                },
                                {
                                    "id": "70112708",
                                    "speaker": "Eye of Graeae",
                                    "text": "Fortunately, our crash landing has at least brought us much closer to the town. According to the data, anyway."
                                },
                                {
                                    "id": "70112709",
                                    "speaker": "Paimon",
                                    "text": "Your data had better be right this time..."
                                },
                                {
                                    "id": "70112710",
                                    "speaker": "Eye of Graeae",
                                    "text": "I can assure you, it certainly is. Please look this way, and you will see a Kresnik's Torch."
                                },
                                {
                                    "id": "70112711",
                                    "speaker": "Eye of Graeae",
                                    "text": "It seems our ill-fated train ride was a blessing in disguise. We have taken the shortest possible route."
                                },
                                {
                                    "id": "70112712",
                                    "speaker": "Player",
                                    "text": "It wasn't what you'd call comfortable, though..."
                                },
                                {
                                    "id": "70112713",
                                    "speaker": "Eye of Graeae",
                                    "text": "Rest assured that I will take user preferences into account next time I plan a route. Next time, I will get it right..."
                                }
                            ]
                        },
                        {
                            "id": "70112706",
                            "text": "Shame about the train."
                        }
                    ]
                }
            ]
        },
        {
            "id": "701199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "70119901",
                    "speaker": "Paimon",
                    "text": "Look, a deer! It looks similar to the ones in Nod-Krai, y'know, just minus the effects of kuuvahki."
                },
                {
                    "id": "70119902",
                    "speaker": "Paimon",
                    "text": "That's a sure sign that we're officially in Snezhnaya now."
                },
                {
                    "id": "70119903",
                    "speaker": "Paimon",
                    "text": "There's gotta be a treasure chest around here somewhere. No adventure is complete without a chest or two..."
                },
                {
                    "id": "70119910",
                    "speaker": "Paimon",
                    "text": "What's wrong? Come on, let's go."
                },
                {
                    "id": "70119911",
                    "speaker": "Paimon",
                    "text": "Seems like this snowstorm is getting worse by the minute... Paimon can... barely fly..."
                },
                {
                    "id": "70119912",
                    "speaker": "Paimon",
                    "text": "Ooh, look, there's a cabin over there! Whew, let's get out of this storm!"
                },
                {
                    "id": "70119915",
                    "speaker": "Player",
                    "text": "Paimon...? Paiiiiimoooon...!"
                },
                {
                    "id": "70119925",
                    "speaker": "Eye of Graeae",
                    "text": "Low power... Please use Kresnik Kristall to replenish energy reserves..."
                }
            ]
        }
    ]
}