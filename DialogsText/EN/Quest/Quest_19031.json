            "dialogues": [
                {
                    "id": "1903102101",
                    "speaker": "Fu San'er",
                    "text": "It's dangerous to walk alone here, isn't it?"
                },
                {
                    "id": "1903102102",
                    "speaker": "Fu San'er",
                    "text": "You have no idea who... or what you'll meet.",
                    "choices": [
                        {
                            "id": "1903102103",
                            "text": "...",
                            "response": [
                                {
                                    "id": "1903102105",
                                    "speaker": "Fu San'er",
                                    "text": "Hmm, you seem to be pretty calm. You know, there's a saying, \"you can't keep your shoes dry if you keep walking along the river.\""
                                },
                                {
                                    "id": "1903102106",
                                    "speaker": "Fu San'er",
                                    "text": "You're bound to run into something in such a strange and eerie place..."
                                },
                                {
                                    "id": "1903102107",
                                    "speaker": "Fu San'er",
                                    "text": "And what you encounter here could become a nightmare that haunts you for the rest of your life.",
                                    "choices": [
                                        {
                                            "id": "1903102108",
                                            "text": "Oh, really?",
                                            "response": [
                                                {
                                                    "id": "1903102110",
                                                    "speaker": "Fu San'er",
                                                    "text": "Huh? How are you so calm? People usually run away in terror before I can even finish a sentence.",
                                                    "choices": [
                                                        {
                                                            "id": "1903102111",
                                                            "text": "You look like just another average person to me.",
                                                            "response": [
                                                                {
                                                                    "id": "1903102112",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "Yeah... but a more sophisticated way to play a ghost is to create a creepy atmosphere that scares people psychologically."
                                                                },
                                                                {
                                                                    "id": "1903102113",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "In which case, my appearance becomes irrelevant."
                                                                },
                                                                {
                                                                    "id": "1903102117",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "*sigh* Besides, I'll never be able to scare someone like you who doesn't believe in ghosts to begin with."
                                                                },
                                                                {
                                                                    "id": "1903102118",
                                                                    "speaker": "Player",
                                                                    "text": "Sounds like you're just slacking off to me..."
                                                                },
                                                                {
                                                                    "id": "1903102119",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "Hey, that's not true! Oh, I'd better go find some wimps to scare now!"
                                                                },
                                                                {
                                                                    "id": "1903102120",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "You should go back and find your partner. He might be terrified by now."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "1903102114",
                                                            "text": "Don't you have a costume or anything like that?",
                                                            "response": [
                                                                {
                                                                    "id": "1903102115",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "Yes, I have one, but it's too hot to wear... and besides, a more sophisticated way to play a ghost is to create a creepy atmosphere that scares people psychologically."
                                                                },
                                                                {
                                                                    "id": "1903102116",
                                                                    "speaker": "Fu San'er",
                                                                    "text": "In which case, my appearance becomes irrelevant."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "1903102109",
                                            "text": "Sorry, I don't get it... What are you doing here?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "1903102104",
                            "text": "Hello."
                        }
                    ]
                }
            ]
