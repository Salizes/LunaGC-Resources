    "talks": [
        {
            "id": "7002401",
            "objective": "Go to the Adventurers' Guild",
            "dialogues": [
                {
                    "id": "700240101",
                    "speaker": "Katheryne",
                    "text": "Traveler! Please, over here."
                },
                {
                    "id": "700240102",
                    "speaker": "Katheryne",
                    "text": "Apologies, but I need a moment of your time. Would you be interested in taking on a new commission?",
                    "choices": [
                        {
                            "id": "700240103",
                            "text": "Can't hurt to learn more about it.",
                            "response": [
                                {
                                    "id": "700240105",
                                    "speaker": "Katheryne",
                                    "text": "The situation is this. The Guild has recently received several reports that the hilichurls in the wild are once again starting to band together and disrupt the merchant route."
                                },
                                {
                                    "id": "700240106",
                                    "speaker": "Katheryne",
                                    "text": "We have dispatched a significant number of adventurers to investigate..."
                                },
                                {
                                    "id": "700240107",
                                    "speaker": "Katheryne",
                                    "text": "All of whom have reported a strange phenomenon — that whenever they discover a group of hilichurls gathering together, there is always a certain unusual hilichurl in their midst..."
                                },
                                {
                                    "id": "700240108",
                                    "speaker": "Katheryne",
                                    "text": "We believe that this \"Unusual Hilichurl\" could be a key factor in the recent disturbances."
                                },
                                {
                                    "id": "700240114",
                                    "speaker": "Katheryne",
                                    "text": "So, we require someone to capture the Unusual Hilichurl, or at the very least chase it away."
                                },
                                {
                                    "id": "700240109",
                                    "speaker": "Katheryne",
                                    "text": "Traveler, are you interested in accepting this commission?",
                                    "choices": [
                                        {
                                            "id": "700240110",
                                            "text": "Sure.",
                                            "response": [
                                                {
                                                    "id": "700240112",
                                                    "speaker": "Katheryne",
                                                    "text": "Thank you! I have marked some locations for you on your Map."
                                                },
                                                {
                                                    "id": "700240113",
                                                    "speaker": "Katheryne",
                                                    "text": "Hilichurl activity has been reported in each of these areas. Please begin your investigation by visiting them."
                                                },
                                                {
                                                    "id": "700240115",
                                                    "speaker": "Katheryne",
                                                    "text": "Should you encounter the Unusual Hilichurl... Please exercise due caution."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700240111",
                                            "text": "I will keep my eyes open when I'm out and about."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700240104",
                            "text": "What kind of commission?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002402",
            "objective": "Go out into the wild to investigate",
            "dialogues": [
                {
                    "id": "700240201",
                    "speaker": "Ella Musk",
                    "text": "Phew... That was close. Good thing you came when you did...",
                    "choices": [
                        {
                            "id": "700240202",
                            "text": "I'll say...",
                            "response": [
                                {
                                    "id": "700240204",
                                    "speaker": "Ella Musk",
                                    "text": "*sigh*..."
                                },
                                {
                                    "id": "700240205",
                                    "speaker": "Ella Musk",
                                    "text": "I don't understand, everything was going so well... What was it that I said?"
                                },
                                {
                                    "id": "700240206",
                                    "speaker": "Ella Musk",
                                    "text": "Well, anyway... Thank you for saving me..."
                                },
                                {
                                    "id": "700240207",
                                    "speaker": "Paimon",
                                    "text": "She looks really upset..."
                                },
                                {
                                    "id": "700240208",
                                    "speaker": "Ella Musk",
                                    "text": "Well... You saw what happened."
                                },
                                {
                                    "id": "700240223",
                                    "speaker": "Ella Musk",
                                    "text": "My previous strategy of attempting to interact with hilichurls on my own is manifestly too risky..."
                                },
                                {
                                    "id": "700240209",
                                    "speaker": "Ella Musk",
                                    "text": "But still... It's a shame for a golden opportunity to converse with a hilichurl to just go to waste...",
                                    "choices": [
                                        {
                                            "id": "700240210",
                                            "text": "I see...",
                                            "response": [
                                                {
                                                    "id": "700240212",
                                                    "speaker": "Ella Musk",
                                                    "text": "It looks like my vocabulary compilation work for the dictionary is going to have to be postponed once again..."
                                                },
                                                {
                                                    "id": "700240224",
                                                    "speaker": "Ella Musk",
                                                    "text": "If only I had someone who could verify the accuracy of the book's contents on my behalf..."
                                                },
                                                {
                                                    "id": "700240213",
                                                    "speaker": "Player",
                                                    "text": "I can help."
                                                },
                                                {
                                                    "id": "700240214",
                                                    "speaker": "Ella Musk",
                                                    "text": "R—Really? That's great! ...Right then, be sure to take this book with you!"
                                                },
                                                {
                                                    "id": "700240215",
                                                    "speaker": "Paimon",
                                                    "text": "Wow... That was a fast transition from sulking to bossing us around..."
                                                },
                                                {
                                                    "id": "700240216",
                                                    "speaker": "Ella Musk",
                                                    "text": "If you encounter any communication difficulties, you'll be able to resolve them simply by consulting this book! ...In principle, at least."
                                                },
                                                {
                                                    "id": "700240217",
                                                    "speaker": "Player",
                                                    "text": "...In principle?"
                                                },
                                                {
                                                    "id": "700240218",
                                                    "speaker": "Paimon",
                                                    "text": "You mean you don't even know what you wrote in your own book!?"
                                                },
                                                {
                                                    "id": "700240219",
                                                    "speaker": "Ella Musk",
                                                    "text": "You only find out where the problems in your research lie through real-world application! Without putting them through their paces, how am I supposed to know for sure whether my theories hold water?"
                                                },
                                                {
                                                    "id": "700240225",
                                                    "speaker": "Ella Musk",
                                                    "text": "Hmm... Nope, never mind, you probably wouldn't understand what I was about to say anyway. But that aside... thank you, once again, for saving me."
                                                },
                                                {
                                                    "id": "700240220",
                                                    "speaker": "Ella Musk",
                                                    "text": "Now, if you don't mind, I will join you. Let's go find a hilichurl to interact with."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "700240211",
                                            "text": "Is there anything I can do?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "700240203",
                            "text": "Are you alright...?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002403",
            "objective": "Rescue Ella Musk",
            "dialogues": []
        },
