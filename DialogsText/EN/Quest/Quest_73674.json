    "talks": [
        {
            "id": "7367401",
            "objective": "Talk to Ulman",
            "dialogues": [
                {
                    "id": "736740101",
                    "speaker": "Ulman",
                    "text": "Didn't you bring me here, little one? Keep moving!"
                },
                {
                    "id": "736740102",
                    "speaker": "Ulman",
                    "text": "Never mind, you better stay put...",
                    "choices": [
                        {
                            "id": "736740103",
                            "text": "What are you up to?",
                            "response": [
                                {
                                    "id": "736740106",
                                    "speaker": "Ulman",
                                    "text": "I'm duped by it, again... Let me give you a rundown from the beginning."
                                },
                                {
                                    "id": "736740107",
                                    "speaker": "Ulman",
                                    "text": "For starters, you may not believe Seelie are somehow easily drawn to me."
                                },
                                {
                                    "id": "736740108",
                                    "speaker": "Ulman",
                                    "text": "Among the Seelie that came to follow me, I found one kind that is particularly keen on treasure-seeking."
                                },
                                {
                                    "id": "736740109",
                                    "speaker": "Ulman",
                                    "text": "I'm not good at naming. I'll just call them Treasure-Seeking Seelie."
                                },
                                {
                                    "id": "736740110",
                                    "speaker": "Ulman",
                                    "text": "They excel at treasure-seeking. With their help, I dug up a lot of treasures and made a profit with them."
                                },
                                {
                                    "id": "736740111",
                                    "speaker": "Ulman",
                                    "text": "But sometimes they suddenly tune out on me. I don't know if they're tired of the seeking, or just think I'm too boring..."
                                },
                                {
                                    "id": "736740112",
                                    "speaker": "Ulman",
                                    "text": "Then I'd find a helper favored by the Seelie."
                                },
                                {
                                    "id": "736740113",
                                    "speaker": "Ulman",
                                    "text": "The helper takes Treasure-Seeking Seelie to locate the treasures, and I sell them for a fair price."
                                },
                                {
                                    "id": "736740114",
                                    "speaker": "Ulman",
                                    "text": "They say ruins and antiques are everywhere in Sumeru. So I came to look for my fortune."
                                },
                                {
                                    "id": "736740115",
                                    "speaker": "Ulman",
                                    "text": "And I attracted a bunch of Seelie here, of course. Some Treasure-Seeking Seelie brought me here."
                                },
                                {
                                    "id": "736740116",
                                    "speaker": "Ulman",
                                    "text": "But they ignored me again not long after I scooped up some dirt..."
                                },
                                {
                                    "id": "736740117",
                                    "speaker": "Ulman",
                                    "text": "Eh? Why did it suddenly start to move? Could it be..."
                                },
                                {
                                    "id": "736740118",
                                    "speaker": "Ulman",
                                    "text": "Traveler, are you interested in treasure-seeking with Seelie?",
                                    "choices": [
                                        {
                                            "id": "736740119",
                                            "text": "Me?",
                                            "response": [
                                                {
                                                    "id": "736740121",
                                                    "speaker": "Ulman",
                                                    "text": "That won't be necessary. Just follow it and dig where it stops."
                                                },
                                                {
                                                    "id": "736740122",
                                                    "speaker": "Ulman",
                                                    "text": "How's that sound? Just give it a try... If you scoop up some treasure, I'll only want the \"Ancient Iron Coins\" if there is any. The rest is all yours!"
                                                },
                                                {
                                                    "id": "736740123",
                                                    "speaker": "Ulman",
                                                    "text": "And say you do help me find some of those coins, I'll pay you for them at a fair price.",
                                                    "choices": [
                                                        {
                                                            "id": "736740124",
                                                            "text": "I could give it a go...",
                                                            "response": [
                                                                {
                                                                    "id": "736740125",
                                                                    "speaker": "Ulman",
                                                                    "text": "That's the spirit! I like you!"
                                                                },
                                                                {
                                                                    "id": "736740130",
                                                                    "speaker": "Ulman",
                                                                    "text": "Anyways, we are partners now!"
                                                                },
                                                                {
                                                                    "id": "736740131",
                                                                    "speaker": "Ulman",
                                                                    "text": "Take this notebook. I recorded on it some hidden treasure sites I found before but haven't had a chance for a dig."
                                                                },
                                                                {
                                                                    "id": "736740132",
                                                                    "speaker": "Ulman",
                                                                    "text": "I'm counting on you then, Traveler. Come back and bring me the \"Ancient Iron Coins\" if you find any."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736740126",
                                                            "text": "What are \"Ancient Iron Coins\"?",
                                                            "response": [
                                                                {
                                                                    "id": "736740127",
                                                                    "speaker": "Ulman",
                                                                    "text": "Simply put, it's a kind of antique."
                                                                },
                                                                {
                                                                    "id": "736740128",
                                                                    "speaker": "Ulman",
                                                                    "text": "With good connections, I'll be able to exchange the coins for some decent stuff."
                                                                },
                                                                {
                                                                    "id": "736740129",
                                                                    "speaker": "Ulman",
                                                                    "text": "I haven't found any good connections though..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736740120",
                                            "text": "I don't know their language..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736740104",
                            "text": "Is this... a Seelie?",
                            "response": [
                                {
                                    "id": "736740105",
                                    "speaker": "Ulman",
                                    "text": "You mean the little one? Ugh, sort of..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7367403",
            "objective": "",
            "dialogues": [
                {
                    "id": "736740301",
                    "speaker": "Ulman",
                    "text": "Didn't you bring me here, little one? Keep moving!"
                },
                {
                    "id": "736740302",
                    "speaker": "Ulman",
                    "text": "Never mind, you better stay put...",
                    "choices": [
                        {
                            "id": "736740303",
                            "text": "Ulman?",
                            "response": [
                                {
                                    "id": "736740305",
                                    "speaker": "Ulman",
                                    "text": "Traveler? It's been a while."
                                },
                                {
                                    "id": "736740306",
                                    "speaker": "Ulman",
                                    "text": "Are you still bumming around the world? I've heard many amazing stories about you. You're really phenomenal."
                                },
                                {
                                    "id": "736740307",
                                    "speaker": "Ulman",
                                    "text": "What troubles are you gonna fix this time in Sumeru?",
                                    "choices": [
                                        {
                                            "id": "736740308",
                                            "text": "Don't jinx me.",
                                            "response": [
                                                {
                                                    "id": "736740309",
                                                    "speaker": "Ulman",
                                                    "text": "Right, back to business, Traveler. How about another team-up action?"
                                                },
                                                {
                                                    "id": "736740313",
                                                    "speaker": "Ulman",
                                                    "text": "The land of Sumeru is strewn with treasures. Mora everywhere."
                                                },
                                                {
                                                    "id": "736740314",
                                                    "speaker": "Ulman",
                                                    "text": "Seelie are drawn to me as usual. And the Treasure-Seeking Seelie we got so familiar with are among them too."
                                                },
                                                {
                                                    "id": "736740315",
                                                    "speaker": "Ulman",
                                                    "text": "Same as before. You and the Seelie look for treasures, and I'll prepare your payment."
                                                },
                                                {
                                                    "id": "736740316",
                                                    "speaker": "Ulman",
                                                    "text": "We'll surely rake it in as a team!",
                                                    "choices": [
                                                        {
                                                            "id": "736740317",
                                                            "text": "\"Iron Coins\" again?",
                                                            "response": [
                                                                {
                                                                    "id": "736740318",
                                                                    "speaker": "Ulman",
                                                                    "text": "No. This time I'm looking for \"Ancient Iron Coins,\" which are worth more."
                                                                },
                                                                {
                                                                    "id": "736740319",
                                                                    "speaker": "Player",
                                                                    "text": "It's just another coin!"
                                                                },
                                                                {
                                                                    "id": "736740320",
                                                                    "speaker": "Ulman",
                                                                    "text": "It's not! The antique ones sell for more Mora."
                                                                },
                                                                {
                                                                    "id": "736740326",
                                                                    "speaker": "Ulman",
                                                                    "text": "So it's a deal then. Let's make a pile as a team like we used to!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "736740321",
                                                            "text": "Can't you find someone else?",
                                                            "response": [
                                                                {
                                                                    "id": "736740322",
                                                                    "speaker": "Ulman",
                                                                    "text": "Well, you always team up with the one you are familiar with."
                                                                },
                                                                {
                                                                    "id": "736740323",
                                                                    "speaker": "Ulman",
                                                                    "text": "And we're friends! I look out for my friends."
                                                                },
                                                                {
                                                                    "id": "736740324",
                                                                    "speaker": "Player",
                                                                    "text": "Last time we met, you didn't have that silver tongue."
                                                                },
                                                                {
                                                                    "id": "736740325",
                                                                    "speaker": "Ulman",
                                                                    "text": "Hehe, that's what you must have to persuade your buyers."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "736740310",
                                            "text": "Not before I \"fix\" you first.",
                                            "response": [
                                                {
                                                    "id": "736740311",
                                                    "speaker": "Ulman",
                                                    "text": "Haha, better not. I wouldn't be strong enough to take your fixing punches."
                                                },
                                                {
                                                    "id": "736740312",
                                                    "speaker": "Ulman",
                                                    "text": "Seriously, Traveler. How about we team up again?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "736740304",
                            "text": "What are you doing here?"
                        }
                    ]
                }
            ]
        }
    ]
}