    "talks": [
        {
            "id": "7566001",
            "objective": "",
            "dialogues": [
                {
                    "id": "756600101",
                    "speaker": "Xilonen",
                    "text": "Phew... The weather sure is nice. This trip out was well worth it."
                },
                {
                    "id": "756600102",
                    "speaker": "Xilonen",
                    "text": "Hmm? Do my eyes deceive me, or do I spy our \"Tum{RUBY#[D]Hope}aini\"?",
                    "choices": [
                        {
                            "id": "756600103",
                            "text": "What a coincidence, Xilonen.",
                            "response": [
                                {
                                    "id": "756600105",
                                    "speaker": "Black Screen",
                                    "text": "You tell Xilonen about Irade and the exam stages..."
                                },
                                {
                                    "id": "756600106",
                                    "speaker": "Xilonen",
                                    "text": "Ah, I see... I almost forgot. I did lend her a hand earlier. In fact, our tribe's stage is nearby."
                                },
                                {
                                    "id": "756600107",
                                    "speaker": "Xilonen",
                                    "text": "At first, she only got the \"Calamity of Tetlahuitl,\" Nkunga, and the \"Sand Dagger of Seit'aad,\" Amuru, to help her out."
                                },
                                {
                                    "id": "756600108",
                                    "speaker": "Xilonen",
                                    "text": "But those two aren't big on \"mobility,\" preferring head-on clashes, so the resulting feedback was skewed."
                                },
                                {
                                    "id": "756600109",
                                    "speaker": "Xilonen",
                                    "text": "First thing Pacal did after hearing that was to ask me to give some suggestions.",
                                    "choices": [
                                        {
                                            "id": "756600110",
                                            "text": "So the current stage is your work, then?",
                                            "response": [
                                                {
                                                    "id": "756600111",
                                                    "speaker": "Xilonen",
                                                    "text": "More or less. Pacal, Irade, and I made a few minor modifications after some discussion."
                                                },
                                                {
                                                    "id": "756600112",
                                                    "speaker": "Xilonen",
                                                    "text": "Now, the stages are more about getting yourself to advantageous ground quick and managing a shifting fulcrum in the heat of battle.",
                                                    "choices": [
                                                        {
                                                            "id": "756600116",
                                                            "text": "Allow me to accept your trial, then!",
                                                            "response": [
                                                                {
                                                                    "id": "756600118",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Please, everyone in Natlan has witnessed your strength. I doubt there's a challenge out there that could trip you up."
                                                                },
                                                                {
                                                                    "id": "756600119",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Anyway, the stage is over there. Go try it out if you're interested."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756600117",
                                                            "text": "Let's hope you didn't make this too difficult..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756600113",
                                            "text": "You... really make just about everything, don't you...",
                                            "response": [
                                                {
                                                    "id": "756600114",
                                                    "speaker": "Xilonen",
                                                    "text": "Eh, it's just a few simple devices. They weren't that hard to build."
                                                },
                                                {
                                                    "id": "756600115",
                                                    "speaker": "Xilonen",
                                                    "text": "A one-time effort on my part for a continuous pipeline of stronger warriors for our tribe? That's a good deal — especially since I can use that extra free time to work through my commission backlog...",
                                                    "choices": [
                                                        {
                                                            "id": "756600116",
                                                            "text": "Allow me to accept your trial, then!"
                                                        },
                                                        {
                                                            "id": "756600117",
                                                            "text": "Let's hope you didn't make this too difficult..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756600104",
                            "text": "I took Irade's commission."
                        }
                    ]
                }
            ]
        }
    ]
}