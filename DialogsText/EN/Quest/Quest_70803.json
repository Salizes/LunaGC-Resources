    "talks": [
        {
            "id": "7080301",
            "objective": "",
            "dialogues": [
                {
                    "id": "708030101",
                    "speaker": "Paimon",
                    "text": "Huh? Who is this guy...",
                    "choices": [
                        {
                            "id": "708030102",
                            "text": "Is he... Joel's father?",
                            "response": [
                                {
                                    "id": "708030104",
                                    "speaker": "Reckless Pallad",
                                    "text": "Oh, you're here, Traveler!"
                                },
                                {
                                    "id": "708030105",
                                    "speaker": "Reckless Pallad",
                                    "text": "Allow me to introduce Joserf. He's Joel's father."
                                },
                                {
                                    "id": "708030106",
                                    "speaker": "Joel",
                                    "text": "Dad! This is that traveler I was telling you about. The traveler's helped me out loads in the past, and this time we even built a snowman together."
                                },
                                {
                                    "id": "708030107",
                                    "speaker": "Joserf",
                                    "text": "Joel has told me everything about you. I can't thank you enough.",
                                    "choices": [
                                        {
                                            "id": "708030108",
                                            "text": "I'm glad you're finally reunited...",
                                            "response": [
                                                {
                                                    "id": "708030110",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, this is amazing!"
                                                },
                                                {
                                                    "id": "708030111",
                                                    "speaker": "Cyrus",
                                                    "text": "Not bad, Pallad, not bad at all! You did great work this time!"
                                                },
                                                {
                                                    "id": "708030112",
                                                    "speaker": "Paimon",
                                                    "text": "\"This time\"? Did something happen the last time?"
                                                },
                                                {
                                                    "id": "708030113",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "Uh... You remember the person I said I found the last time on Dragonspine, right?"
                                                },
                                                {
                                                    "id": "708030114",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "After you accompanied me up the mountain and helped me to defeat those monsters, I continued searching the area."
                                                },
                                                {
                                                    "id": "708030115",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "During my search, I accidentally tripped and rolled my way down the mountain..."
                                                },
                                                {
                                                    "id": "708030116",
                                                    "speaker": "Paimon",
                                                    "text": "You... rolled..."
                                                },
                                                {
                                                    "id": "708030117",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "Thankfully, the snow was very thick below. I wasn't hurt."
                                                },
                                                {
                                                    "id": "708030118",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "And I was just getting ready to head back when I heard noises at the side... and then someone just popped out of nowhere."
                                                },
                                                {
                                                    "id": "708030119",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "I didn't realize that this was the person I was looking for at first. In fact, I mistook him for a fellow adventurer in the search party."
                                                },
                                                {
                                                    "id": "708030120",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "But after a few words of conversation, it was clear that he was having memory problems. He didn't even know his own name."
                                                },
                                                {
                                                    "id": "708030121",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "The temperature was freezing, and there was no time to deal with all that there and then, so I convinced him to come back to the camp with me and figure everything else out after we got there."
                                                },
                                                {
                                                    "id": "708030122",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "We got back to the camp, ran into Joel, and the moment he saw him, he froze for a second, with this completely stunned expression on his face, and then he started crying out: \"Dad! Dad!\" That's when Joserf suddenly started to remember."
                                                },
                                                {
                                                    "id": "708030123",
                                                    "speaker": "Joel",
                                                    "text": "Daddy..."
                                                },
                                                {
                                                    "id": "708030124",
                                                    "speaker": "Joserf",
                                                    "text": "Daddy's right here, Joel. Daddy's right here."
                                                },
                                                {
                                                    "id": "708030125",
                                                    "speaker": "Paimon",
                                                    "text": "Joserf, don't you remember anything else at all?"
                                                },
                                                {
                                                    "id": "708030126",
                                                    "speaker": "Paimon",
                                                    "text": "The Boar Princess, feeding the foxes...?"
                                                },
                                                {
                                                    "id": "708030127",
                                                    "speaker": "Joserf",
                                                    "text": "I'm sorry, I have no recollection. Maybe it's because of the head trauma? I'm not sure..."
                                                },
                                                {
                                                    "id": "708030128",
                                                    "speaker": "Joserf",
                                                    "text": "I woke up and found myself covered in blood. My things were gone and there was nothing to indicate who I was or how I got there."
                                                },
                                                {
                                                    "id": "708030129",
                                                    "speaker": "Joserf",
                                                    "text": "I crawled into a cave and settled in for a slow recovery. After my legs and feet were a little better, my hunting skills were what kept me alive."
                                                },
                                                {
                                                    "id": "708030130",
                                                    "speaker": "Joel",
                                                    "text": "Dad... I was so worried about you."
                                                },
                                                {
                                                    "id": "708030131",
                                                    "speaker": "Joserf",
                                                    "text": "I'm alright now, Joel. Don't cry, daddy's not going anywhere. I'm here to stay."
                                                },
                                                {
                                                    "id": "708030132",
                                                    "speaker": "Paimon",
                                                    "text": "So what's the plan now, Joserf?"
                                                },
                                                {
                                                    "id": "708030133",
                                                    "speaker": "Joserf",
                                                    "text": "I... I just want to stay with my family for a while longer."
                                                },
                                                {
                                                    "id": "708030134",
                                                    "speaker": "Cyrus",
                                                    "text": "It's wonderful that you were able to return safe and sound! I suppose there's our happy ending now, hahah!"
                                                },
                                                {
                                                    "id": "708030135",
                                                    "speaker": "Cyrus",
                                                    "text": "That said, Pallad, you've still got some way to go before your adventuring skills are up to scratch. I mean, losing your footing and rolling down the mountain like that..."
                                                },
                                                {
                                                    "id": "708030136",
                                                    "speaker": "Cyrus",
                                                    "text": "You're having some remedial classes with me once we get back to the Guild, I say!"
                                                },
                                                {
                                                    "id": "708030137",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "Huh? B—But Cyrus... I think I kinda made up for my mistakes this time, y'know..."
                                                },
                                                {
                                                    "id": "708030138",
                                                    "speaker": "Cyrus",
                                                    "text": "No buts! Back to the Guild we go!"
                                                },
                                                {
                                                    "id": "708030139",
                                                    "speaker": "Reckless Pallad",
                                                    "text": "Guild Master, please!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "708030109",
                                            "text": "I'm glad you're okay..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "708030103",
                            "text": "A gigantic version of Joel..."
                        }
                    ]
                }
            ]
        },
