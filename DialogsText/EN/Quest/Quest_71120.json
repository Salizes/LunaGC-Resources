            "dialogues": [
                {
                    "id": "711200101",
                    "speaker": "Sitting Tiger",
                    "text": "Hey, keep off! This is the boss man's turf!"
                },
                {
                    "id": "711200102",
                    "speaker": "Paimon",
                    "text": "Whoa, so mean!",
                    "choices": [
                        {
                            "id": "711200103",
                            "text": "Who are you people?",
                            "response": [
                                {
                                    "id": "711200104",
                                    "speaker": "Coiled Serpent",
                                    "text": "That's up to you. If you're nice, we can be pals. But if you get nosy, we'll have to do something about it."
                                },
                                {
                                    "id": "711200105",
                                    "speaker": "Sitting Tiger",
                                    "text": "You should grow a brain and go back the way you came!"
                                },
                                {
                                    "id": "711200109",
                                    "speaker": "Paimon",
                                    "text": "You're so suspicious!"
                                },
                                {
                                    "id": "711200110",
                                    "speaker": "Coiled Serpent",
                                    "text": "Suspicious? Whoa there... We're just the doormen. If anyone's acting suspicious, it's you weirdos poking your heads everywhere!"
                                },
                                {
                                    "id": "711200111",
                                    "speaker": "Sitting Tiger",
                                    "text": "Whatever, we've got nothin' to say to you! Just quit bothering us!"
                                }
                            ]
                        },
                        {
                            "id": "711200106",
                            "text": "Who is this \"boss man\" you speak of?",
                            "response": [
                                {
                                    "id": "711200107",
                                    "speaker": "Sitting Tiger",
                                    "text": "Who is the \"boss man\"...? Ha! If I told you, you'd keel over with fright!"
                                },
                                {
                                    "id": "711200108",
                                    "speaker": "Coiled Serpent",
                                    "text": "It's for your own good, pal! Leave well alone what you shouldn't mess with."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112051",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711205199",
                    "speaker": "Black Screen",
                    "text": "You insert the charging core into the rusty slot of the Ruin Guard. The stiff ancient machinery slowly begins to move."
                }
            ]
        },
        {
            "id": "7112091",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711209101",
                    "speaker": "Sitting Tiger",
                    "text": "You two again!?"
                },
                {
                    "id": "711209102",
                    "speaker": "Coiled Serpent",
                    "text": "Stop snooping around, friends. Just pretend you didn't see us, and we'll pretend didn't see you.",
                    "choices": [
                        {
                            "id": "711209103",
                            "text": "What are you guarding?",
                            "response": [
                                {
                                    "id": "711209104",
                                    "speaker": "Coiled Serpent",
                                    "text": "Take a guess what we're paid to do, buddy."
                                },
                                {
                                    "id": "711209105",
                                    "speaker": "Paimon",
                                    "text": "What!? Why?"
                                },
                                {
                                    "id": "711209106",
                                    "speaker": "Coiled Serpent",
                                    "text": "*ahem* Cough cough...!"
                                },
                                {
                                    "id": "711209107",
                                    "speaker": "Coiled Serpent",
                                    "text": "(I'll only tell the two of you, so don't tell anyone... C'mon, come closer now...)"
                                },
                                {
                                    "id": "711209108",
                                    "speaker": "Paimon",
                                    "text": "(Sure, Paimon's listening!)"
                                },
                                {
                                    "id": "711209109",
                                    "speaker": "Coiled Serpent",
                                    "text": "It's to get rid of people like you!"
                                },
                                {
                                    "id": "711209110",
                                    "speaker": "Paimon",
                                    "text": "Waaah!"
                                }
                            ]
                        },
                        {
                            "id": "711209111",
                            "text": "I just heard a weird noise from inside the cave...",
                            "response": [
                                {
                                    "id": "711209112",
                                    "speaker": "Sitting Tiger",
                                    "text": "I farted!"
                                },
                                {
                                    "id": "711209113",
                                    "speaker": "Coiled Serpent",
                                    "text": "Uh... right. He farted."
                                },
                                {
                                    "id": "711209114",
                                    "speaker": "Paimon",
                                    "text": "S—So everything's okay then..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7112092",
            "objective": "Additional",
            "dialogues": [
