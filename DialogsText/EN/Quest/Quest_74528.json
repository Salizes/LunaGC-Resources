        },
        {
            "id": "7452804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745280401",
                    "speaker": "Skirk",
                    "text": "Ah. It's you. It seems our paths cross once again.",
                    "choices": [
                        {
                            "id": "745280402",
                            "text": "Haven't seen you in a while, Skirk.",
                            "response": [
                                {
                                    "id": "745280404",
                                    "speaker": "Skirk",
                                    "text": "I am observing the \"scars\" left upon this world. An explosion destroyed this place utterly..."
                                },
                                {
                                    "id": "745280405",
                                    "speaker": "Skirk",
                                    "text": "But now, people have built something new atop that wreckage."
                                },
                                {
                                    "id": "745280406",
                                    "speaker": "Skirk",
                                    "text": "All things must end. But where one thing perishes, something new can be born."
                                },
                                {
                                    "id": "745280407",
                                    "speaker": "Skirk",
                                    "text": "You've grown stronger since we last met. It seems you have not neglected your training. That's good.",
                                    "choices": [
                                        {
                                            "id": "745280408",
                                            "text": "I do actually have a small request...",
                                            "response": [
                                                {
                                                    "id": "745280410",
                                                    "speaker": "Skirk",
                                                    "text": "A picture? I am merely a passerby as far as this world is concerned. Why should I leave marks of my existence behind?",
                                                    "choices": [
                                                        {
                                                            "id": "745280411",
                                                            "text": "You're not a passerby where I'm concerned.",
                                                            "response": [
                                                                {
                                                                    "id": "745280413",
                                                                    "speaker": "Skirk",
                                                                    "text": "...If it is something you have decided to do, then do it."
                                                                },
                                                                {
                                                                    "id": "745280414",
                                                                    "speaker": "Skirk",
                                                                    "text": "I will be here. You can begin anytime."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745280412",
                                                            "text": "Every reunion is worth commemorating."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745280409",
                                            "text": "I'd like to take a picture of you?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745280403",
                            "text": "Here on some sort of business?"
                        }
                    ]
                }
            ]
        }
    ]
