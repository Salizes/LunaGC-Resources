    "talks": [
        {
            "id": "1180001",
            "objective": "",
            "dialogues": [
                {
                    "id": "698240101",
                    "speaker": "Hu Tao",
                    "text": "Ai-yai-yai, yai-yai! Xiangling, you smell wonderful today. Let me have another whiff, would you?"
                },
                {
                    "id": "698240102",
                    "speaker": "Xiangling",
                    "text": "Hehe, smells great, doesn't it? This is the first of Ying'er's new batch. She sent me a small box of samples."
                },
                {
                    "id": "698240103",
                    "speaker": "Xiangling",
                    "text": "#Oh, hey, {NICKNAME}! Come over, come over! Give this scent a try. What do you think?",
                    "choices": [
                        {
                            "id": "698240104",
                            "text": "It sure smells good...",
                            "response": [
                                {
                                    "id": "698240106",
                                    "speaker": "Hu Tao",
                                    "text": "Not bad, got it in one! Your nose is as sharp as mine. Mmm, this scent really is spot-on, too.",
                                    "choices": [
                                        {
                                            "id": "698240107",
                                            "text": "A perfume? Then, this is...?",
                                            "response": [
                                                {
                                                    "id": "698240109",
                                                    "speaker": "Xiangling",
                                                    "text": "Ding ding ding, that's right! Just a few days ago, I was passing by Ying'er's place and saw her looking all worried, so I asked her what was wrong."
                                                },
                                                {
                                                    "id": "698240110",
                                                    "speaker": "Xiangling",
                                                    "text": "She told me that she wanted to make some new perfumes that would be really appealing, but that she'd been racking her brains for days without any good ideas."
                                                },
                                                {
                                                    "id": "698240111",
                                                    "speaker": "Xiangling",
                                                    "text": "So she asked me if I could think of a scent that would be novel, popular, but also something completely untried by any other perfumer."
                                                },
                                                {
                                                    "id": "698240112",
                                                    "speaker": "Xiangling",
                                                    "text": "Hehe, so I said to her that most perfumes are made from flowers or plant extracts — so why not try making one that smells like food? It'd definitely be really fun!"
                                                },
                                                {
                                                    "id": "698240113",
                                                    "speaker": "Hu Tao",
                                                    "text": "Ai-ya, fun is right, but there's just one teeny little problem — the longer you smell it, the louder your tummy starts to grumble."
                                                },
                                                {
                                                    "id": "698240114",
                                                    "speaker": "Hu Tao",
                                                    "text": "Hear that, Xiangling? That's mine going \"feed me, feed me\"!",
                                                    "choices": [
                                                        {
                                                            "id": "698240115",
                                                            "text": "*growl* *gurgle*...",
                                                            "response": [
                                                                {
                                                                    "id": "698240117",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Hahaha, alright, no problem! Come on in, I'll have two plates of Almond Tofu ready for you in no time!"
                                                                },
                                                                {
                                                                    "id": "698240118",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Whew... This perfume sure packs a punch! I wonder if she can maybe make some... Grilled Tiger Fish next time? Or Golden Shrimp Balls, maybe?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698240116",
                                                            "text": "Hey, look! I'm starving too!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698240108",
                                            "text": "Is this... an Almond Tofu-flavored perfume?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698240105",
                            "text": "Did you just make some almond tofu?"
                        }
                    ]
                }
            ]
        }
    ]
