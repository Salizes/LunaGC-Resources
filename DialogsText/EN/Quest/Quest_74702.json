    "talks": [
        {
            "id": "7470201",
            "objective": "Talk to Sandrone",
            "dialogues": [
                {
                    "id": "747020101",
                    "speaker": "Marionette",
                    "text": "Oh, you've been bringing back so many fish lately. The aquarium is starting to look like a real ocean habitat."
                },
                {
                    "id": "747020102",
                    "speaker": "Paimon",
                    "text": "Hehehe, we're practically pro fishie-fetchers already!"
                },
                {
                    "id": "747020103",
                    "speaker": "Marionette",
                    "text": "You appear to take great pride in your work."
                },
                {
                    "id": "747020104",
                    "speaker": "Paimon",
                    "text": "You betcha! But behind the sense of accomplishment, there's something else... something more like...",
                    "choices": [
                        {
                            "id": "747020105",
                            "text": "Regret?",
                            "response": [
                                {
                                    "id": "747020107",
                                    "speaker": "Paimon",
                                    "text": "Yeah, that's it! That's how Paimon's feeling underneath."
                                },
                                {
                                    "id": "747020108",
                                    "speaker": "Marionette",
                                    "text": "Why is that?"
                                },
                                {
                                    "id": "747020109",
                                    "speaker": "Paimon",
                                    "text": "Paimon's not sure... It just feels like something's missing...",
                                    "choices": [
                                        {
                                            "id": "747020110",
                                            "text": "Maybe a restaurant?",
                                            "response": [
                                                {
                                                    "id": "747020111",
                                                    "speaker": "Paimon",
                                                    "text": "Hey! Don't say stuff like that! How could anyone bear to eat such beautiful fishies!?"
                                                },
                                                {
                                                    "id": "747020114",
                                                    "speaker": "Paimon",
                                                    "text": "We're missing visitors to come and admire our amazing handiwork!"
                                                },
                                                {
                                                    "id": "747020115",
                                                    "speaker": "Marionette",
                                                    "text": "You're saying... you want to open the aquarium to visitors?"
                                                },
                                                {
                                                    "id": "747020116",
                                                    "speaker": "Paimon",
                                                    "text": "Would that not be okay?",
                                                    "choices": [
                                                        {
                                                            "id": "747020117",
                                                            "text": "Are you worried it'll be too noisy?",
                                                            "response": [
                                                                {
                                                                    "id": "747020119",
                                                                    "speaker": "Paimon",
                                                                    "text": "If that's the case, just leave everything to us! We'll take care of advertising and all the day-to-day stuff — you just focus on your own work."
                                                                },
                                                                {
                                                                    "id": "747020120",
                                                                    "speaker": "Marionette",
                                                                    "text": "If that's what you want..."
                                                                },
                                                                {
                                                                    "id": "747020121",
                                                                    "speaker": "Player",
                                                                    "text": "We can split the revenue 30/70!"
                                                                },
                                                                {
                                                                    "id": "747020122",
                                                                    "speaker": "Paimon",
                                                                    "text": "Huh...? We only get 70%?"
                                                                },
                                                                {
                                                                    "id": "747020123",
                                                                    "speaker": "Player",
                                                                    "text": "No, Sandrone gets 70%."
                                                                },
                                                                {
                                                                    "id": "747020124",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh, right, of course... Sandrone is the one renting this boat, after all..."
                                                                },
                                                                {
                                                                    "id": "747020125",
                                                                    "speaker": "Marionette",
                                                                    "text": "Ugh, you make me sound like some sort of tyrannical landlord. You're putting in the work, so you should get the lion's share. I'm not stingy like Pantalone."
                                                                },
                                                                {
                                                                    "id": "747020126",
                                                                    "speaker": "Paimon",
                                                                    "text": "So that means... you're giving us the all-clear?"
                                                                },
                                                                {
                                                                    "id": "747020127",
                                                                    "speaker": "Marionette",
                                                                    "text": "Sure, you have my blessing. Just make sure it doesn't get in the way of my research."
                                                                },
                                                                {
                                                                    "id": "747020128",
                                                                    "speaker": "Paimon",
                                                                    "text": "Woohoo! The Wingalet Gloop-Gloop Funderwater Fisharium is officially open for business!"
                                                                },
                                                                {
                                                                    "id": "747020129",
                                                                    "speaker": "Marionette",
                                                                    "text": "*sigh* Of course you already thought of a name..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "747020118",
                                                            "text": "Are you worried it'll cause lots of problems?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "747020112",
                                            "text": "Maybe visitors?",
                                            "response": [
                                                {
                                                    "id": "747020113",
                                                    "speaker": "Paimon",
                                                    "text": "Oh! That's it!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "747020106",
                            "text": "Loneliness?"
                        }
                    ]
                }
            ]
        }
    ]
}