    "talks": [
        {
            "id": "7001601",
            "objective": "Talk to the hilichurl",
            "dialogues": [
                {
                    "id": "700160101",
                    "speaker": "Lonely Hilichurl",
                    "text": "...Yaya dala?"
                },
                {
                    "id": "700160102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo, mimi mosi mita, Muhe mita?"
                },
                {
                    "id": "700160103",
                    "speaker": "Lonely Hilichurl",
                    "text": "Mita...? Gusha... Dada ika odomu Plata mimi, mimi mosi gusha..."
                },
                {
                    "id": "700160104",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!"
                },
                {
                    "id": "700160105",
                    "speaker": "Lonely Hilichurl",
                    "text": "Mani...? Dada! Kundala zido mi, mi dada, mimi tomo!"
                },
                {
                    "id": "700160106",
                    "speaker": "Paimon",
                    "text": "Seems they're really getting into their conversation...",
                    "choices": [
                        {
                            "id": "700160107",
                            "text": "Quite extraordinary, Miss Musk.",
                            "response": [
                                {
                                    "id": "700160109",
                                    "speaker": "Ella Musk",
                                    "text": "It just isn't fond of talking. But I still managed to get the information we needed."
                                },
                                {
                                    "id": "700160110",
                                    "speaker": "Ella Musk",
                                    "text": "All we need to do is defeat its enemy. That's where you guys come in!"
                                },
                                {
                                    "id": "700160111",
                                    "speaker": "Lonely Hilichurl",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700160108",
                            "text": "That was a very smooth interaction indeed."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7001602",
            "objective": "Go to the designated location for a fight",
            "dialogues": [
                {
                    "id": "700160201",
                    "speaker": "Lonely Hilichurl",
                    "text": "Yoyo dada! Mimi tomo!"
                },
                {
                    "id": "700160202",
                    "speaker": "Ella Musk",
                    "text": "Mimi muhe du, du ya Wei zido dala si."
                },
                {
                    "id": "700160203",
                    "speaker": "Lonely Hilichurl",
                    "text": "Mi mito nye. Mi mito du, du ya mito Wei."
                },
                {
                    "id": "700160204",
                    "speaker": "Ella Musk",
                    "text": "It directed us to this location. It said someone here will have seen it before."
                },
                {
                    "id": "700160205",
                    "speaker": "Player",
                    "text": "Valo! Tomo!"
                },
                {
                    "id": "700160206",
                    "speaker": "Lonely Hilichurl",
                    "text": "Valo, valo..."
                }
            ]
        },
