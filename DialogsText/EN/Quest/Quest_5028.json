        {
            "id": "502802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50280202",
                    "speaker": "Ororon",
                    "text": "#{M#His}{F#Her} soul is noble and pure. \"Hero\" is just {M#his}{F#her} starting point"
                },
                {
                    "id": "50280207",
                    "speaker": "Chasca",
                    "text": "#I wish to soar with {M#him}{F#her}, and see the world beyond the sky"
                },
                {
                    "id": "50280208",
                    "speaker": "Iansan",
                    "text": "#Wherever {M#he}{F#she} calls home... surely that land is a place of freedom and warmth."
                },
                {
                    "id": "50280211",
                    "speaker": "Xilonen",
                    "text": "#I admire {M#his}{F#her} wisdom, how {M#he}{F#she} always lives in the moment"
                },
                {
                    "id": "50280212",
                    "speaker": "Mualani",
                    "text": "#Being {M#his}{F#her} friend makes me so happy!"
                }
            ]
        },
        {
            "id": "502803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50280302",
                    "speaker": "Xbalanque",
                    "text": "Accursed angels, banished ■■ — you should have long since ■■■■!"
                }
            ]
        },
        {
            "id": "502899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50289901",
                    "speaker": "Cochanina",
                    "text": "I have witnessed the light of this flame dozens of times. Once the wood is spent, night will return."
                },
                {
                    "id": "50289902",
                    "speaker": "Cochanina",
                    "text": "Failure, failure, failure, failure, failure..."
                }
            ]
        }
    ]
