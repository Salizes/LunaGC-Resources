        {
            "id": "502805",
            "objective": "Continue \"your\" journey",
            "dialogues": [
                {
                    "id": "50280501",
                    "speaker": "Voice in the Void",
                    "text": "The lives of the Descenders are more valuable than you can imagine."
                },
                {
                    "id": "50280502",
                    "speaker": "Voice in the Void",
                    "text": "You have destroyed this world's hope with your own hands."
                },
                {
                    "id": "50280503",
                    "speaker": "Mavuika",
                    "text": "If I was fated to fail, then why do you fear?"
                },
                {
                    "id": "50280504",
                    "speaker": "Voice in the Void",
                    "text": "..."
                },
                {
                    "id": "50280505",
                    "speaker": "Mavuika",
                    "text": "(We embark on a pilgrimage, for the wishes of the people.)"
                },
                {
                    "id": "50280506",
                    "speaker": "Mavuika",
                    "text": "(We choose to battle, to earn a glorious name.)"
                },
                {
                    "id": "50280507",
                    "speaker": "Mavuika",
                    "text": "(And in the end, we burn to cinders for a dream.)"
                },
                {
                    "id": "50280508",
                    "speaker": "Mavuika",
                    "text": "(And so this cycle continued, time after time...)"
                }
            ]
        },
