        {
            "id": "37101",
            "objective": "Leave the Knights of Favonius Headquarters",
            "dialogues": [
                {
                    "id": "3710101",
                    "speaker": "Paimon",
                    "text": "There's something you didn't tell them."
                },
                {
                    "id": "3710102",
                    "speaker": "Paimon",
                    "text": "The dragon and the crystal weren't the only things we saw.",
                    "choices": [
                        {
                            "id": "3710103",
                            "text": "I'd like to investigate it on my own first.",
                            "response": [
                                {
                                    "id": "3710105",
                                    "speaker": "Paimon",
                                    "text": "So you do remember him, that green guy."
                                },
                                {
                                    "id": "3710106",
                                    "speaker": "Paimon",
                                    "text": "He looked just like that guy down there!",
                                    "choices": [
                                        {
                                            "id": "3710107",
                                            "text": "The exact same shade of green, what a coincidence.",
                                            "response": [
                                                {
                                                    "id": "3710108",
                                                    "speaker": "Paimon",
                                                    "text": "See? See?"
                                                },
                                                {
                                                    "id": "3710109",
                                                    "speaker": "Paimon",
                                                    "text": "Wait... Hold on a minute... That..."
                                                },
                                                {
                                                    "id": "3710110",
                                                    "speaker": "Paimon",
                                                    "text": "That's the same guy!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3710111",
                                            "text": "Well... Looks like him...",
                                            "response": [
                                                {
                                                    "id": "3710112",
                                                    "speaker": "Paimon",
                                                    "text": "What!?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3710104",
                            "text": "I don't think he's a bad guy."
                        }
                    ]
                }
            ]
        },
