        }
    },
    "talks": [
        {
            "id": "2003301",
            "objective": "Talk to Anna",
            "dialogues": [
                {
                    "id": "200330101",
                    "speaker": "Anna",
                    "text": "Traveler, come have a look! What do you think? Does this look good on me?"
                },
                {
                    "id": "200330102",
                    "speaker": "Player",
                    "text": "Oh, this uniform...!"
                },
                {
                    "id": "200330103",
                    "speaker": "Anna",
                    "text": "That's right! I passed the Adventurers' Guild exam. That makes me an officially-recognized adventurer!",
                    "choices": [
                        {
                            "id": "200330104",
                            "text": "You look awesome!",
                            "response": [
                                {
                                    "id": "200330106",
                                    "speaker": "Anna",
                                    "text": "Hehe, thanks. I tried to persuade my brother to give the exam a go too, but he refused no matter what I said..."
                                },
                                {
                                    "id": "200330107",
                                    "speaker": "Anthony",
                                    "text": "I've got no interest in adventures... And anyway, who'll take care of our parents if we both become adventurers?"
                                },
                                {
                                    "id": "200330108",
                                    "speaker": "Anna",
                                    "text": "Well, then we can bring them along! We can travel the whole world together!"
                                },
                                {
                                    "id": "200330109",
                                    "speaker": "Anthony",
                                    "text": "You... Alright, alright. You're an adventurer now, so do your best. Leave matters at home to me."
                                },
                                {
                                    "id": "200330110",
                                    "speaker": "Anthony",
                                    "text": "But remember, don't get yourself injured, and don't overtax yourself..."
                                },
                                {
                                    "id": "200330111",
                                    "speaker": "Anna",
                                    "text": "Oh, fine, fine, I get it! Heading out now, I've got a commission to finish!"
                                },
                                {
                                    "id": "200330112",
                                    "speaker": "Anna",
                                    "text": "Traveler, do you mind coming with me? I've got so many things I want to ask you about being an adventurer!",
                                    "choices": [
                                        {
                                            "id": "200330113",
                                            "text": "Sure.",
                                            "response": [
                                                {
                                                    "id": "200330115",
                                                    "speaker": "Anna",
                                                    "text": "Now let me see. This commission is..."
                                                },
                                                {
                                                    "id": "200330116",
                                                    "speaker": "Anna",
                                                    "text": "Transport Balloon Escort!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "200330114",
                                            "text": "Okay. Let's go!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "200330105",
                            "text": "Congratulations!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003302",
            "objective": "Go with Anna to complete her Adventurers' Guild commission",
            "dialogues": [
                {
                    "id": "200330201",
                    "speaker": "Anna",
                    "text": "And we're done! Thanks, Traveler. This went pretty well, I think."
                },
                {
                    "id": "200330202",
                    "speaker": "Anna",
                    "text": "But is this the usual fare for adventurers?",
                    "choices": [
                        {
                            "id": "200330203",
                            "text": "There will be others.",
                            "response": [
                                {
                                    "id": "200330204",
                                    "speaker": "Paimon",
                                    "text": "What's with that hapless tone..."
                                },
                                {
                                    "id": "200330207",
                                    "speaker": "Anna",
                                    "text": "Is that so... Nice! I'll keep working at it, then!"
                                },
                                {
                                    "id": "200330208",
                                    "speaker": "Anna",
                                    "text": "Once I've saved up enough Mora, I'll bring my brother and our parents out on a trip!"
                                },
                                {
                                    "id": "200330209",
                                    "speaker": "Anna",
                                    "text": "My brother always wanted to travel... But I fell ill, and he had to stay back to take care of me."
                                },
                                {
                                    "id": "200330210",
                                    "speaker": "Anna",
                                    "text": "But I'm well now, and I've even become an adventurer."
                                },
                                {
                                    "id": "200330211",
                                    "speaker": "Anna",
                                    "text": "Hehe. When the time comes, I'll help my brother fulfill some of his dreams too!"
                                }
                            ]
                        },
                        {
                            "id": "200330205",
                            "text": "You'll understand in time...",
                            "response": [
                                {
                                    "id": "200330206",
                                    "speaker": "Anna",
                                    "text": "Hey, not that tired look..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2003303",
            "objective": "Go with Anna to complete her Adventurers' Guild commission",
            "dialogues": [
                {
                    "id": "200330301",
                    "speaker": "Anthony",
                    "text": "Please take care of Anna, Traveler. Her excitement might have gotten to her head lately..."
                },
                {
                    "id": "200330302",
                    "speaker": "Player",
                    "text": "Do you not want her to become an adventurer?"
                },
                {
                    "id": "200330303",
                    "speaker": "Anthony",
                    "text": "..."
                },
                {
                    "id": "200330304",
                    "speaker": "Anthony",
                    "text": "I respect my sister's wishes."
                },
                {
                    "id": "200330305",
                    "speaker": "Anthony",
                    "text": "Now that she's well again after such a long struggle with her illness, she deserves a chance to pursue her dreams."
                },
                {
                    "id": "200330306",
                    "speaker": "Anthony",
                    "text": "As her brother, I'll support her... all the way."
                },
                {
                    "id": "200330307",
                    "speaker": "Anthony",
                    "text": "That's all I have to say."
                }
            ]
        },
        {
            "id": "2003304",
            "objective": "Talk to Anna",
            "dialogues": []
        }
    ]
}