{
    "quest": {
        "id": "20033",
        "title": "Anna the Adventurer!",
        "description": "It appears that Anna from Mondstadt has successfully become an adventurer.",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 34,
        "total_speaker_counts": {
            "Anna": 16,
