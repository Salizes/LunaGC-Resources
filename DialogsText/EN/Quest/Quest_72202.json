        {
            "id": "7220201",
            "objective": "",
            "dialogues": [
                {
                    "id": "722020101",
                    "speaker": "Chise",
                    "text": "Has the Great Thunderbird... forsaken me?",
                    "choices": [
                        {
                            "id": "722020102",
                            "text": "Err, hello?",
                            "response": [
                                {
                                    "id": "722020104",
                                    "speaker": "Chise",
                                    "text": "O mighty Thunderbird, please... Do not be angry..."
                                },
                                {
                                    "id": "722020105",
                                    "speaker": "Chise",
                                    "text": "I will do my best to read your decrees and your instructions... But..."
                                },
                                {
                                    "id": "722020106",
                                    "speaker": "Chise",
                                    "text": "But why do you reject me... Why... *sobs*"
                                },
                                {
                                    "id": "722020107",
                                    "speaker": "Chise",
                                    "text": "Why can't I enter the fog you created...",
                                    "choices": [
                                        {
                                            "id": "722020108",
                                            "text": "Read... What are you talking about?",
                                            "response": [
                                                {
                                                    "id": "722020109",
                                                    "speaker": "Chise",
                                                    "text": "The Stormstones you left behind... I will do something about them. But the silver boat is coming. My time is short..."
                                                },
                                                {
                                                    "id": "722020110",
                                                    "speaker": "Player",
                                                    "text": "What are these Stormstones you're talking about?"
                                                },
                                                {
                                                    "id": "722020111",
                                                    "speaker": "Chise",
                                                    "text": "The Stormstones of the Autake Plains... Only those who can wield the thunder can bring them back to life, and only those who can traverse the fog can find them..."
                                                },
                                                {
                                                    "id": "722020112",
                                                    "speaker": "Chise",
                                                    "text": "To stand tall like the Thunderbird... to unfurl one's wings like the Thunderbird..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722020113",
                                            "text": "Wait a moment. Hasn't the fog dispersed?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722020103",
                            "text": "Need any help?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220202",
            "objective": "",
            "dialogues": [
                {
                    "id": "722020201",
                    "speaker": "Chise",
                    "text": "Ah... O Great Thunderbird... Have you forgiven me?"
                }
