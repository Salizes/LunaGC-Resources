    "talks": [
        {
            "id": "7550801",
            "objective": "Go to the People of the Springs",
            "dialogues": [
                {
                    "id": "755080101",
                    "speaker": "Mualani",
                    "text": "Hey!"
                },
                {
                    "id": "755080102",
                    "speaker": "Mualani",
                    "text": "Our guests of honor are here! Now we can really get this party started!"
                },
                {
                    "id": "755080103",
                    "speaker": "Paimon",
                    "text": "Hey, Mualani! Oh, and Xilonen's here too!"
                },
                {
                    "id": "755080104",
                    "speaker": "Paimon",
                    "text": "And... Mizuki? You're back from Inazuma already!"
                },
                {
                    "id": "755080105",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "That's right! My friends in Natlan are like family to me. I like to think of the People of the Springs as my home away from home."
                },
                {
                    "id": "755080106",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "If I want to help people here, I definitely can't neglect the Natlan branch of my practice."
                },
                {
                    "id": "755080107",
                    "speaker": "Xilonen",
                    "text": "Miss Mizuki's work ethic is impeccable."
                },
                {
                    "id": "755080108",
                    "speaker": "Xilonen",
                    "text": "She puts the rest of us service-providers to shame...",
                    "choices": [
                        {
                            "id": "755080109",
                            "text": "Wait, so... Are you one of her clients, too?",
                            "response": [
                                {
                                    "id": "755080111",
                                    "speaker": "Xilonen",
                                    "text": "Well, I've had some weird dreams lately... Like, a client expediting a commission from a four-week time-frame to just one."
                                },
                                {
                                    "id": "755080112",
                                    "speaker": "Xilonen",
                                    "text": "Or, like a rush order for some kind of spherical accessory with an element of danger to it...",
                                    "choices": [
                                        {
                                            "id": "755080113",
                                            "text": "I know this one. Slimes and Fungi.",
                                            "response": [
                                                {
                                                    "id": "755080115",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, you made that connection pretty fast, Traveler. Almost as if you're the one sending Xilonen weird commissions through her dreams..."
                                                },
                                                {
                                                    "id": "755080116",
                                                    "speaker": "Xilonen",
                                                    "text": "Huh, are those creatures... dangerous?"
                                                },
                                                {
                                                    "id": "755080117",
                                                    "speaker": "Xilonen",
                                                    "text": "Anyway, the expedited time frame isn't even the hardest part. Spherical designs are tricky, and when you rush it, you end up with something that isn't even good."
                                                },
                                                {
                                                    "id": "755080118",
                                                    "speaker": "Xilonen",
                                                    "text": "Point being, I've been having nothing but those kinds of dreams. So, I wrapped up all my orders and decided to visit Miss Mizuki for help..."
                                                },
                                                {
                                                    "id": "755080119",
                                                    "speaker": "Xilonen",
                                                    "text": "And, it worked like a charm! When I took a nap that afternoon, all the weird dreams were gone!"
                                                },
                                                {
                                                    "id": "755080120",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "It was my pleasure to help, Miss Xilonen."
                                                },
                                                {
                                                    "id": "755080121",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Although, I'm not sure how much credit I can really take for the disappearance of those dreams..."
                                                },
                                                {
                                                    "id": "755080122",
                                                    "speaker": "Mualani",
                                                    "text": "In any case, everyone's feeling good and well-rested now! Which means, it's party time!"
                                                },
                                                {
                                                    "id": "755080123",
                                                    "speaker": "Mualani",
                                                    "text": "A party on the water, to be exact! It's a tradition in my tribe, and we're gonna have a blast!",
                                                    "choices": [
                                                        {
                                                            "id": "755080124",
                                                            "text": "A party on the water, huh...",
                                                            "response": [
                                                                {
                                                                    "id": "755080126",
                                                                    "speaker": "Paimon",
                                                                    "text": "Yeah! Let's party!"
                                                                },
                                                                {
                                                                    "id": "755080127",
                                                                    "speaker": "Paimon",
                                                                    "text": "...Although, what does that involve, exactly? Obviously, delicious food and drinks are a given..."
                                                                },
                                                                {
                                                                    "id": "755080128",
                                                                    "speaker": "Paimon",
                                                                    "text": "But, how do people in Natlan like to party?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "755080129",
                                                                            "text": "High-speed surfing with a Koholasaur?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "755080132",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Wait... Are you being serious?"
                                                                                },
                                                                                {
                                                                                    "id": "755080133",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "Oho, do I spy a fellow extreme sports enthusiast!? To tell you the truth, those activities were where my mind first went to as well!"
                                                                                },
                                                                                {
                                                                                    "id": "755080134",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "But, according to Chief Amina... *ahem*... \"Not everyone likes high-adrenaline activities!\""
                                                                                },
                                                                                {
                                                                                    "id": "755080135",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "\"Even beach volleyball can be dangerous. It's all fun and games until you spike the ball straight into your friend!\""
                                                                                },
                                                                                {
                                                                                    "id": "755080136",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "\"This event is supposed to be fun, not something that scars people and creates even more work for Miss Mizuki in the process!\""
                                                                                },
                                                                                {
                                                                                    "id": "755080137",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Well, she does have a point. I'm always happy to help, but I'd rather not have a hand in creating my own patients' trauma. It's better if no one gets hurt."
                                                                                },
                                                                                {
                                                                                    "id": "755080138",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "Mhm-hmm, which is why I came to you for advice!"
                                                                                },
                                                                                {
                                                                                    "id": "755080139",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "So, what's the plan?"
                                                                                },
                                                                                {
                                                                                    "id": "755080140",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Well, not everyone has a background in extreme sports, and we don't want that to deter people from participating in this event."
                                                                                },
                                                                                {
                                                                                    "id": "755080141",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "As we were chatting, I happened to mention the Mikawa Flower Festival and its more laid-back approach to games, and Miss Mualani really latched onto that idea."
                                                                                },
                                                                                {
                                                                                    "id": "755080142",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "So, we decided to give Akitsu Haneasobi a distinctive Natlanese twist! The result is \"Rhythm Ball\" — a relaxing game that doesn't sacrifice on fun."
                                                                                },
                                                                                {
                                                                                    "id": "755080143",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "An Inazuman game... with a Natlanese twist! What a cool idea!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "755080144",
                                                                                            "text": "There's the Children of Echoes' Dance-Off Stage.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "755080146",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Wow, and you haven't even heard the band at full volume! You must have a good sense of rhythm..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080147",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Which, as you can imagine, is perfect for \"Rhythm Ball.\" The goal is to smash all the blocks by hitting the balls to the beat of the music."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080148",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "No complex techniques, no safety issues, just instinct. It's a game everyone can enjoy."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080149",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Oh, of course, with your skill, you could even add extra layers to the music, or bring out a new sense of rhythm."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080150",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "After all, different DJs can give the same song a whole new feel. And, in a game that involves beats, the player can showcase that same creativity!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080151",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "Who knows... In your hands, the background track could go from an easy-listening, chill-out piece to something with a trance or artcore twist!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080152",
                                                                                                    "speaker": "Xilonen",
                                                                                                    "text": "I can't wait to see what you come up with."
                                                                                                },
                                                                                                {
                                                                                                    "id": "755080153",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "#Uh-huh, yeah, whatever you say... Well, sounds like something you can do, right, {NICKNAME}?",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "755080154",
                                                                                                            "text": "Yeah, music and games! Right up my alley!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "755080156",
                                                                                                                    "speaker": "Mualani",
                                                                                                                    "text": "Yes! That's the spirit! As long as you and Paimon can play your hearts out, it's mission accomplished!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080157",
                                                                                                                    "speaker": "Mualani",
                                                                                                                    "text": "Oh, and I'll grab some snacks and drinks for the rest of us while we watch!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080158",
                                                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                                                    "text": "Just remember to pace yourself, okay, Traveler?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080159",
                                                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                                                    "text": "I'm sure you don't want an endless loop of Dance-Off Stage music stuck in your head before bed tonight."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080160",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Well, thanks, everyone! This sounds like a blast!"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "755080161",
                                                                                                                    "speaker": "Paimon",
                                                                                                                    "text": "Plus, if Xilonen's the one DJ-ing, an endless loop of music in our dreams... doesn't sound too bad!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "755080155",
                                                                                                            "text": "Sure! I'll give it my best shot!"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "755080145",
                                                                                            "text": "I can really feel the beat of the music."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "755080130",
                                                                            "text": "Skydiving from the back of a Qucusaur?"
                                                                        },
                                                                        {
                                                                            "id": "755080131",
                                                                            "text": "Rope-less bungee jumping with a Yumkasaur... Tried that one, actually."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755080125",
                                                            "text": "Sounds fun."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755080114",
                                            "text": "Are you talking about Specters and Ball Octopuses?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755080110",
                            "text": "Or could it be... that you've worked together before?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7550899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "755089901",
                    "speaker": "Paimon",
                    "text": "Oh, what a surprise! A letter from Mualani!"
                },
                {
                    "id": "755089902",
                    "speaker": "Paimon",
                    "text": "It says... the People of the Springs are hosting a... music festival?"
                },
                {
                    "id": "755089903",
                    "speaker": "Paimon",
                    "text": "Well, that sounds fun! Let's go check it out!"
                }
            ]
        }
    ]
}