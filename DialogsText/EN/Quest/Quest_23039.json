    "talks": [
        {
            "id": "2303901",
            "objective": "Talk to Ebeid",
            "dialogues": [
                {
                    "id": "230390101",
                    "speaker": "Ebeid",
                    "text": "#{F#Miss}{M#Mister}! Wait!"
                },
                {
                    "id": "230390102",
                    "speaker": "Ebeid",
                    "text": "Are you... an adventurer? I mean the kind of adventurers who are skilled in battle and travel to many places.",
                    "choices": [
                        {
                            "id": "230390103",
                            "text": "You could say that.",
                            "response": [
                                {
                                    "id": "230390105",
                                    "speaker": "Ebeid",
                                    "text": "#Look, Hilmi! I said {M#he}{F#she} must be an adventurer!"
                                },
                                {
                                    "id": "230390106",
                                    "speaker": "Hilmi",
                                    "text": "But don't adventurers always wear those green outfits?",
                                    "choices": [
                                        {
                                            "id": "230390107",
                                            "text": "I'm too skilled to need that green outfit.",
                                            "response": [
                                                {
                                                    "id": "230390109",
                                                    "speaker": "Hilmi",
                                                    "text": "Wow!"
                                                },
                                                {
                                                    "id": "230390110",
                                                    "speaker": "Ebeid",
                                                    "text": "Wow!"
                                                },
                                                {
                                                    "id": "230390111",
                                                    "speaker": "Ebeid",
                                                    "text": "In that case, you can definitely help us!"
                                                },
                                                {
                                                    "id": "230390112",
                                                    "speaker": "Ebeid",
                                                    "text": "Do you see that big warehouse in the village? Habachi said we must keep watch over it because many important things are kept there."
                                                },
                                                {
                                                    "id": "230390113",
                                                    "speaker": "Hilmi",
                                                    "text": "He also told us that if any bad guys come, he'll shut down the lift and cut off the bridge."
                                                },
                                                {
                                                    "id": "230390114",
                                                    "speaker": "Ebeid",
                                                    "text": "But the lift is some distance away from the warehouse. To shut it down, Habachi will have to run really fast."
                                                },
                                                {
                                                    "id": "230390115",
                                                    "speaker": "Ebeid",
                                                    "text": "We thought we could train with him, but he's been ignoring our offer..."
                                                },
                                                {
                                                    "id": "230390116",
                                                    "speaker": "Hilmi",
                                                    "text": "How I wish he could instead ignore us when we try to sneak out to skip stones! Like that's gonna happen... Hmph!"
                                                },
                                                {
                                                    "id": "230390117",
                                                    "speaker": "Ebeid",
                                                    "text": "Ahem, anyway, if Habachi happens to be exhausted when the bad guys come, we'll shut down the lift for him."
                                                },
                                                {
                                                    "id": "230390118",
                                                    "speaker": "Ebeid",
                                                    "text": "You're an adventurer, so you must be a fast runner, too! Please train with us.",
                                                    "choices": [
                                                        {
                                                            "id": "230390119",
                                                            "text": "Sure. Let's run together.",
                                                            "response": [
                                                                {
                                                                    "id": "230390120",
                                                                    "speaker": "Ebeid",
                                                                    "text": "Yay! Thank you!"
                                                                },
                                                                {
                                                                    "id": "230390126",
                                                                    "speaker": "Hilmi",
                                                                    "text": "We've chosen the starting point. Let's go there!"
                                                                },
                                                                {
                                                                    "id": "230390127",
                                                                    "speaker": "Hilmi",
                                                                    "text": "Hehe, I will be your rival. For the record, I'm a really good runner!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230390121",
                                                            "text": "You can trust Habachi...",
                                                            "response": [
                                                                {
                                                                    "id": "230390122",
                                                                    "speaker": "Ebeid",
                                                                    "text": "Play with us, please!"
                                                                },
                                                                {
                                                                    "id": "230390123",
                                                                    "speaker": "Ebeid",
                                                                    "text": "#Play with us, please, nice {M#Mister}{F#Miss}!"
                                                                },
                                                                {
                                                                    "id": "230390124",
                                                                    "speaker": "Player",
                                                                    "text": "Okay..."
                                                                },
                                                                {
                                                                    "id": "230390125",
                                                                    "speaker": "Ebeid",
                                                                    "text": "Yay! Thank you!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390108",
                                            "text": "I'm quite special and don't need that outfit."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390104",
                            "text": "That's sort of accurate."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303902",
            "objective": "Participate in the racing competition",
            "dialogues": []
        },
        {
            "id": "2303904",
            "objective": "Talk to Hilmi",
            "dialogues": [
                {
                    "id": "230390401",
                    "speaker": "Hilmi",
                    "text": "*huff* I—I won!",
                    "choices": [
                        {
                            "id": "230390402",
                            "text": "C—Congratulations...",
                            "response": [
                                {
                                    "id": "230390404",
                                    "speaker": "Hilmi",
                                    "text": "Hehe, I told you how good I am! You underestimated me, didn't you?"
                                },
                                {
                                    "id": "230390405",
                                    "speaker": "Ebeid",
                                    "text": "But even if we can run this fast, we can't outrun Habachi. I just don't understand why.",
                                    "choices": [
                                        {
                                            "id": "230390406",
                                            "text": "There might be a shortcut.",
                                            "response": [
                                                {
                                                    "id": "230390408",
                                                    "speaker": "Ebeid",
                                                    "text": "Is that so? But I don't think there's any shortcut around."
                                                },
                                                {
                                                    "id": "230390409",
                                                    "speaker": "Hilmi",
                                                    "text": "#{F#Miss}{M#Mister}, can you play with us next time..."
                                                },
                                                {
                                                    "id": "230390410",
                                                    "speaker": "Hilmi",
                                                    "text": "I mean... train with us! Um... Let's train that \"tracking in the wilderness\" thing!"
                                                },
                                                {
                                                    "id": "230390411",
                                                    "speaker": "Ebeid",
                                                    "text": "You're right! Since we can't outrun Habachi, we can get around him..."
                                                },
                                                {
                                                    "id": "230390412",
                                                    "speaker": "Hilmi",
                                                    "text": "We tried that before, didn't we? But it never worked..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390407",
                                            "text": "He might be playing some trick."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390403",
                            "text": "You were... almost flying..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303905",
            "objective": "Talk to Hilmi",
            "dialogues": [
                {
                    "id": "230390501",
                    "speaker": "Hilmi",
                    "text": "Huff... You ran so fast!",
                    "choices": [
                        {
                            "id": "230390502",
                            "text": "Because I—I'm an adventurer...",
                            "response": [
                                {
                                    "id": "230390504",
                                    "speaker": "Ebeid",
                                    "text": "We aren't fast enough. Habachi can definitely catch us... What do we do?"
                                },
                                {
                                    "id": "230390505",
                                    "speaker": "Hilmi",
                                    "text": "Besides, he's not even out of breath each time he catches us. He doesn't even look like he was running.",
                                    "choices": [
                                        {
                                            "id": "230390506",
                                            "text": "There might be a shortcut.",
                                            "response": [
                                                {
                                                    "id": "230390508",
                                                    "speaker": "Ebeid",
                                                    "text": "Is that so? But I don't think there's any shortcut around."
                                                },
                                                {
                                                    "id": "230390509",
                                                    "speaker": "Hilmi",
                                                    "text": "#{F#Miss}{M#Mister}, can you play with us next time..."
                                                },
                                                {
                                                    "id": "230390510",
                                                    "speaker": "Hilmi",
                                                    "text": "I mean... train with us! Um... Let's train that \"tracking in the wilderness\" thing!"
                                                },
                                                {
                                                    "id": "230390511",
                                                    "speaker": "Ebeid",
                                                    "text": "You're right! Since we can't outrun Habachi, we can get around him..."
                                                },
                                                {
                                                    "id": "230390512",
                                                    "speaker": "Hilmi",
                                                    "text": "We tried that before, didn't we? But it never worked..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390507",
                                            "text": "He might be playing some trick."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390503",
                            "text": "Because I've run many, many times."
                        }
                    ]
                }
            ]
        }
    ]
