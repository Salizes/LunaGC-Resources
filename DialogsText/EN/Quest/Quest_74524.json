            "dialogues": [
                {
                    "id": "745240101",
                    "speaker": "Yae Miko",
                    "text": "How did it go? Are your pictures worthy of Lady Guuji Yae's beauty?"
                }
            ]
        },
        {
            "id": "7452402",
            "objective": "",
            "dialogues": [
                {
                    "id": "745240201",
                    "speaker": "Player",
                    "text": "Let's continue the photoshoot!"
                }
            ]
        },
        {
            "id": "7452403",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745240301",
                    "speaker": "Player",
                    "text": "Give me a second, I'm considering my options."
                }
            ]
        },
        {
            "id": "7452404",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745240401",
                    "speaker": "Yae Miko",
                    "text": "Well, well, little one. What are the odds? Or did you come running after hearing about my itinerary for the day?",
                    "choices": [
                        {
                            "id": "745240402",
                            "text": "Did you just go to see the Shogun?",
                            "response": [
                                {
                                    "id": "745240404",
                                    "speaker": "Yae Miko",
                                    "text": "Why, haven't you got a good nose? But no, I was merely bringing some snacks and popular light novels over to a friend who is... not the outgoing sort."
                                },
                                {
                                    "id": "745240405",
                                    "speaker": "Player",
                                    "text": "Is Ei following the latest series as well?"
                                },
                                {
                                    "id": "745240406",
                                    "speaker": "Yae Miko",
                                    "text": "To hear her put it, she means to \"learn about recent changes to Inazumans' preferences in entertainment and leisure.\""
                                },
                                {
                                    "id": "745240407",
                                    "speaker": "Yae Miko",
                                    "text": "She even discussed the topic with me. It started as a serious analysis of reader preferences, of course..."
                                },
                                {
                                    "id": "745240408",
                                    "speaker": "Yae Miko",
                                    "text": "...But before long, she suddenly asked me, \"So, what happened to that character in the end?\""
                                },
                                {
                                    "id": "745240409",
                                    "speaker": "Yae Miko",
                                    "text": "Hehe, it appears that even the mighty Raiden Ei is not immune to the allure of a thrilling tale.",
                                    "choices": [
                                        {
                                            "id": "745240410",
                                            "text": "The look on your face as you said there...",
                                            "response": [
                                                {
                                                    "id": "745240412",
                                                    "speaker": "Yae Miko",
                                                    "text": "Oh? Is that your true purpose for being here?"
                                                },
                                                {
                                                    "id": "745240413",
                                                    "speaker": "Yae Miko",
                                                    "text": "Oh, how you must have missed me during your travels, to want to take these pictures."
                                                },
                                                {
                                                    "id": "745240414",
                                                    "speaker": "Yae Miko",
                                                    "text": "Go on then. But do be discerning with your choice of angles."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745240411",
                                            "text": "...Is worthy of remembrance indeed."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745240403",
                            "text": "I can smell something sweet..."
                        }
                    ]
                }
            ]
        }
    ]
}