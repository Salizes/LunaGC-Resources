    "talks": [
        {
            "id": "7268201",
            "objective": "Talk to Kayabuki",
            "dialogues": [
                {
                    "id": "726820101",
                    "speaker": "Kayabuki Ikkei",
                    "text": "Hello there, blond-haired outlander...",
                    "choices": [
                        {
                            "id": "726820102",
                            "text": "We meet again.",
                            "response": [
                                {
                                    "id": "726820104",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Um, your blond hair looks familiar... Are you..."
                                },
                                {
                                    "id": "726820105",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Ah yes! You are the eye-catching Golden Whirlwind from the Hyakunin Ikki last time..."
                                },
                                {
                                    "id": "726820106",
                                    "speaker": "Player",
                                    "text": "G—Golden Whirlwind...?"
                                },
                                {
                                    "id": "726820107",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Previously, I was watching the excellent performances of the participants in a corner of the tournament venue, seeking to be inspired by the most thrilling fighting scenes. And there you were, taking out opponents like a golden whirlwind sweeping away weeds and grass...",
                                    "choices": [
                                        {
                                            "id": "726820108",
                                            "text": "Ugh, please, spare me the flattery.",
                                            "response": [
                                                {
                                                    "id": "726820113",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Anyway, some people have organized another Hyakunin Ikki recently.",
                                                    "choices": [
                                                        {
                                                            "id": "726820114",
                                                            "text": "What is this Hyakunin Ikki?",
                                                            "response": [
                                                                {
                                                                    "id": "726820115",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "It's a free-for-all tournament whereby people engage in a hearty fight to celebrate, or simply to eliminate bad luck. It's a festival where both martial artists and monsters put their grievances aside and forget their identities, just to enjoy the sheer excitement of fighting."
                                                                },
                                                                {
                                                                    "id": "726820116",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "They say that those who stand out from the crowd will be awarded various treasures."
                                                                },
                                                                {
                                                                    "id": "726820117",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "The identities of the organizers and sponsors are still shrouded in mystery though."
                                                                },
                                                                {
                                                                    "id": "726820119",
                                                                    "speaker": "Kayabuki Ikkei",
                                                                    "text": "Whatever the case, this is not a topic to be discussed out in the open. Follow me..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726820118",
                                                            "text": "I see..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726820109",
                                            "text": "...Go on, don't stop.",
                                            "response": [
                                                {
                                                    "id": "726820110",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Ahem... \"Spectators with the keen eyes of a swordmaster must have noticed it — the blond-haired outsider was unleashing Kouranka Daitatsumaki, a technique that was deemed forbidden even amongst ancient martial arts...!\""
                                                },
                                                {
                                                    "id": "726820111",
                                                    "speaker": "Player",
                                                    "text": "?"
                                                },
                                                {
                                                    "id": "726820112",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Having been inspired by your marvelous fight, I wrote this story."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726820103",
                            "text": "Do you have a commission for me?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7268202",
            "objective": "Talk to Kayabuki",
            "dialogues": [
                {
                    "id": "726820201",
                    "speaker": "Kayabuki Ikkei",
                    "text": "Here we are."
                },
                {
                    "id": "726820202",
                    "speaker": "Kayabuki Ikkei",
                    "text": "Once we enter this suspicious-looking gate, we'll be in the tournament venue for this iteration of Hyakunin Ikki.",
                    "choices": [
                        {
                            "id": "726820203",
                            "text": "Oh, that's pretty exciting.",
                            "response": [
                                {
                                    "id": "726820205",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "The rules probably have not changed much. Monsters, adventurers, and warriors from across the world, who share a common yearning for fight, will quench their thirst on this stage through passionate battle."
                                },
                                {
                                    "id": "726820206",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Just like last time, feel free to bring your friends and companions! After all, the \"Hyakunin\" in \"Hyakunin Ikki\" means the more, the merrier!"
                                },
                                {
                                    "id": "726820207",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "I'm looking forward to your performance."
                                },
                                {
                                    "id": "726820208",
                                    "speaker": "Player",
                                    "text": "Are you not going to participate this time either?"
                                },
                                {
                                    "id": "726820209",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "Oh, of course I will — as a spectator, cheering you on!"
                                },
                                {
                                    "id": "726820210",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "After all, what I aspire to do is write the most thrilling action novels, not become a gallant warrior like you."
                                },
                                {
                                    "id": "726820211",
                                    "speaker": "Kayabuki Ikkei",
                                    "text": "...And my gut tells me that your star will shine brightest in this arena.",
                                    "choices": [
                                        {
                                            "id": "726820212",
                                            "text": "I will do my best.",
                                            "response": [
                                                {
                                                    "id": "726820214",
                                                    "speaker": "Kayabuki Ikkei",
                                                    "text": "Yes, I'm sure you'll show me the most dazzling blade-dance again this time."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726820213",
                                            "text": "Wait to be impressed."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726820204",
                            "text": "That's quite troublesome."
                        }
                    ]
                }
            ]
        }
    ]
}