{
    "quest": {
        "id": "74716",
        "title": "Betterments in Aquatic Circumstances...",
        "description": "Freminet seems to have something to tell us...",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
