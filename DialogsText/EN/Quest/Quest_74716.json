    },
    "talks": [
        {
            "id": "7471601",
            "objective": "Talk to Freminet",
            "dialogues": [
                {
                    "id": "747160101",
                    "speaker": "Freminet",
                    "text": "Fantastic... That's pretty much all of the major junk retrieved."
                },
                {
                    "id": "747160102",
                    "speaker": "Freminet",
                    "text": "I'm sorry you've had to work so hard, you two."
                },
                {
                    "id": "747160103",
                    "speaker": "Paimon",
                    "text": "Don't feel like you have to apologize, Freminet! The way Paimon sees it, we haven't been \"working\" — we've been fishing up goodies!",
                    "choices": [
                        {
                            "id": "747160104",
                            "text": "We helped to restore the environment.",
                            "response": [
                                {
                                    "id": "747160106",
                                    "speaker": "Freminet",
                                    "text": "Thank you... I've had such a happy and fulfilling time, and it's all thanks to you."
                                },
                                {
                                    "id": "747160107",
                                    "speaker": "Paimon",
                                    "text": "You're welcome! Besides, it was a team effort! Aaaand, Paimon thinks you've made some real progress. You've been a great help both underwater and on land!"
                                },
                                {
                                    "id": "747160108",
                                    "speaker": "Player",
                                    "text": "There's no need to blush."
                                },
                                {
                                    "id": "747160109",
                                    "speaker": "Freminet",
                                    "text": "Oh, uh... Alright."
                                },
                                {
                                    "id": "747160110",
                                    "speaker": "Freminet",
                                    "text": "..."
                                },
                                {
                                    "id": "747160111",
                                    "speaker": "Freminet",
                                    "text": "I'm sorry, besides \"thank you,\" I really don't know what else to say at times like these."
                                },
                                {
                                    "id": "747160112",
                                    "speaker": "Freminet",
                                    "text": "Maybe... I still need a little more practice?"
                                },
                                {
                                    "id": "747160113",
                                    "speaker": "Paimon",
                                    "text": "Take your time, there's no hurry. Just keep working on it at your own pace!",
                                    "choices": [
                                        {
                                            "id": "747160114",
                                            "text": "If we get the chance, let's cooperate again in the future.",
                                            "response": [
                                                {
                                                    "id": "747160116",
                                                    "speaker": "Freminet",
                                                    "text": "Alright, it's a deal."
                                                },
                                                {
                                                    "id": "747160117",
                                                    "speaker": "Freminet",
                                                    "text": "...Now that the cleanup's over, I was planning on going back underwater to spend some time alone."
                                                },
                                                {
                                                    "id": "747160118",
                                                    "speaker": "Freminet",
                                                    "text": "But weirdly enough, after talking with you... even the sky itself seems calmer. I just wanted to... share this feeling with you."
                                                },
                                                {
                                                    "id": "747160119",
                                                    "speaker": "Freminet",
                                                    "text": "Anyway... I'd best head back and meet up with Lyney and the others."
                                                },
                                                {
                                                    "id": "747160120",
                                                    "speaker": "Freminet",
                                                    "text": "I'll leave the rest of the underwater survey data with you. I hope you find what you're looking for."
                                                },
                                                {
                                                    "id": "747160121",
                                                    "speaker": "Marionette",
                                                    "text": "Hey, I could hear you celebrating from above decks. Has something good happened?"
                                                },
                                                {
                                                    "id": "747160122",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah! All that junk that was upsetting the fishies has pretty much been cleared away. We also found the rest of the piano pieces!"
                                                },
                                                {
                                                    "id": "747160123",
                                                    "speaker": "Marionette",
                                                    "text": "Really? Let me take a look..."
                                                },
                                                {
                                                    "id": "747160124",
                                                    "speaker": "Marionette",
                                                    "text": "...Well, I'll be. With these components, I can finally fix the piano."
                                                },
                                                {
                                                    "id": "747160125",
                                                    "speaker": "Marionette",
                                                    "text": "It might not be exactly how it was before, but it should be able to play beautiful music again."
                                                },
                                                {
                                                    "id": "747160126",
                                                    "speaker": "Paimon",
                                                    "text": "Aww. You sound really happy, Sandrone!"
                                                },
                                                {
                                                    "id": "747160127",
                                                    "speaker": "Marionette",
                                                    "text": "D—Do I? Whatever, I'll go fix it right away. It shouldn't take me long. In the meantime, could I trouble you to spruce this place up a bit?"
                                                },
                                                {
                                                    "id": "747160128",
                                                    "speaker": "Marionette",
                                                    "text": "Such a wonderful instrument deserves a proper stage to set the scene."
                                                },
                                                {
                                                    "id": "747160129",
                                                    "speaker": "Paimon",
                                                    "text": "Aww... She sure looks happy..."
                                                },
                                                {
                                                    "id": "747160130",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa! What a beautiful piano!",
                                                    "choices": [
                                                        {
                                                            "id": "747160131",
                                                            "text": "It's very elegant!",
                                                            "response": [
                                                                {
                                                                    "id": "747160133",
                                                                    "speaker": "Marionette",
                                                                    "text": "Hmph, of course it is. It was me who fixed it, after all! I also reinforced the mechanical linkages and retouched the exterior."
                                                                },
                                                                {
                                                                    "id": "747160134",
                                                                    "speaker": "Marionette",
                                                                    "text": "You two didn't do too badly yourselves. This stage is truly worthy of this piano."
                                                                },
                                                                {
                                                                    "id": "747160135",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hehe, it was nothing! Anyway, that's enough chitchat. Aren't you gonna play us a song?"
                                                                },
                                                                {
                                                                    "id": "747160136",
                                                                    "speaker": "Marionette",
                                                                    "text": "...Huh? Right now?"
                                                                },
                                                                {
                                                                    "id": "747160137",
                                                                    "speaker": "Paimon",
                                                                    "text": "When else? Why fix the piano if you're not gonna play?"
                                                                },
                                                                {
                                                                    "id": "747160138",
                                                                    "speaker": "Marionette",
                                                                    "text": "How about... we leave the performance on hold for today! There's plenty of time for me to play for you later.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "747160139",
                                                                            "text": "Forgot your sheet music?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "747160141",
                                                                                    "speaker": "Marionette",
                                                                                    "text": "Hmph... Absolute nonsense! I—I just want to sit with it quietly for a while and reminisce about the past!"
                                                                                },
                                                                                {
                                                                                    "id": "747160142",
                                                                                    "speaker": "Marionette",
                                                                                    "text": "And don't think a few cheap taunts are gonna get me to play. Hmph, practice first, performance later!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "747160140",
                                                                            "text": "Feeling shy?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "747160132",
                                                            "text": "It's gorgeous!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "747160115",
                                            "text": "If you need any help, you can always count on us."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "747160105",
                            "text": "And we found a whole bunch of treasure."
                        }
                    ]
                }
            ]
        }
    ]
}