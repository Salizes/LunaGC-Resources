    "talks": [
        {
            "id": "1100001",
            "objective": "Meet the girl in the forest",
            "dialogues": [
                {
                    "id": "110000101",
                    "speaker": "Paimon",
                    "text": "Hey, look! There's a girl over there."
                }
            ]
        },
        {
            "id": "1100003",
            "objective": "Talk to Xiangling",
            "dialogues": [
                {
                    "id": "110000301",
                    "speaker": "???",
                    "text": "Shh! Keep it down, I'm hunting..."
                },
                {
                    "id": "110000302",
                    "speaker": "???",
                    "text": "I've always heard about the wide range of ingredients you can find in Mondstadt, and it looks like it's true!",
                    "choices": [
                        {
                            "id": "110000303",
                            "text": "Are you a hunter?",
                            "response": [
                                {
                                    "id": "110000305",
                                    "speaker": "???",
                                    "text": "No — I'm a chef! A chef on a mission to find rare and exotic ingredients from all corners of the world!"
                                },
                                {
                                    "id": "110000306",
                                    "speaker": "Xiangling",
                                    "text": "My name's Xiangling, I'm from Liyue Harbor. And you?"
                                },
                                {
                                    "id": "110000307",
                                    "speaker": "Player",
                                    "text": "#I'm {NICKNAME}."
                                },
                                {
                                    "id": "110000308",
                                    "speaker": "Paimon",
                                    "text": "Hello, my name's Paimon!"
                                },
                                {
                                    "id": "110000309",
                                    "speaker": "Xiangling",
                                    "text": "Paimon!"
                                },
                                {
                                    "id": "110000310",
                                    "speaker": "Paimon",
                                    "text": "Why are you looking at me like that?"
                                },
                                {
                                    "id": "110000311",
                                    "speaker": "Xiangling",
                                    "text": "What an exotic creature, is it edible?",
                                    "choices": [
                                        {
                                            "id": "110000312",
                                            "text": "We're friends.",
                                            "response": [
                                                {
                                                    "id": "110000313",
                                                    "speaker": "Xiangling",
                                                    "text": "What a bummer. Can't eat it if it's your friend."
                                                },
                                                {
                                                    "id": "110000316",
                                                    "speaker": "Xiangling",
                                                    "text": "You seem like good friends. I have a good friend too, called Guoba."
                                                },
                                                {
                                                    "id": "110000317",
                                                    "speaker": "Paimon",
                                                    "text": "Isn't that the name of a Liyue snack?"
                                                },
                                                {
                                                    "id": "110000318",
                                                    "speaker": "Xiangling",
                                                    "text": "Hee-hee... Both the snack and my friend have a special place in my heart."
                                                },
                                                {
                                                    "id": "110000319",
                                                    "speaker": "Xiangling",
                                                    "text": "Anyway — can you do some hunting for me?"
                                                },
                                                {
                                                    "id": "110000320",
                                                    "speaker": "Xiangling",
                                                    "text": "There's lots of game around here that would be amazing to cook with."
                                                },
                                                {
                                                    "id": "110000321",
                                                    "speaker": "Xiangling",
                                                    "text": "I can't catch anything to save my life and I don't want to miss out!"
                                                },
                                                {
                                                    "id": "110000322",
                                                    "speaker": "Paimon",
                                                    "text": "Sounds like a bit of an ordeal..."
                                                },
                                                {
                                                    "id": "110000323",
                                                    "speaker": "Xiangling",
                                                    "text": "Don't be like that... C'mon, I'll whip you up a tasty snack later!"
                                                },
                                                {
                                                    "id": "110000324",
                                                    "speaker": "Paimon",
                                                    "text": "Ooh, you had me at tasty snack! Don't worry, we're the bestest hunters ever!",
                                                    "choices": [
                                                        {
                                                            "id": "110000325",
                                                            "text": "Whose side are you on!?",
                                                            "response": [
                                                                {
                                                                    "id": "110000327",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Hee-hee, don't worry about it, your friend has already given me a response."
                                                                },
                                                                {
                                                                    "id": "110000328",
                                                                    "speaker": "Xiangling",
                                                                    "text": "I don't care how it's done, so long as you bring me back some raw meat."
                                                                },
                                                                {
                                                                    "id": "110000329",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Great, then I'll leave you to it!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110000326",
                                                            "text": "You could always ask me first..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110000314",
                                            "text": "Dig in.",
                                            "response": [
                                                {
                                                    "id": "110000315",
                                                    "speaker": "Paimon",
                                                    "text": "No! For the last time, Paimon is NOT EMERGENCY FOOD!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110000304",
                            "text": "Are you an adventurer?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1100004",
            "objective": "Help Xiangling collect Raw Meat",
            "dialogues": [
                {
                    "id": "110000401",
                    "speaker": "Xiangling",
                    "text": "These boars look healthy, and active too. I bet their meat is superb quality!"
                },
                {
                    "id": "110000402",
                    "speaker": "Xiangling",
                    "text": "Ugh, just thinking about it is making me hungry..."
                }
            ]
        },
        {
            "id": "1100005",
            "objective": "Give three chunks of Raw Meat to Xiangling",
            "dialogues": [
                {
                    "id": "110000501",
                    "speaker": "Xiangling",
                    "text": "Wowee! This is great! Some of it I'll shallow fry, some of it I'll deep fry with mushrooms— ooh, and I wonder how well it goes with Slime Condensate...",
                    "choices": [
                        {
                            "id": "110000502",
                            "text": "She's off in her own world...",
                            "response": [
                                {
                                    "id": "110000503",
                                    "speaker": "Paimon",
                                    "text": "Paimon thinks she's forgotten about us..."
                                },
                                {
                                    "id": "110000506",
                                    "speaker": "Xiangling",
                                    "text": "Uh, sorry! I got all excited thinking about new recipes."
                                },
                                {
                                    "id": "110000507",
                                    "speaker": "Xiangling",
                                    "text": "As promised, a tasty snack! Go on, try it! And tell me what you think."
                                },
                                {
                                    "id": "110000508",
                                    "speaker": "Paimon",
                                    "text": "Are we your food testers now?"
                                },
                                {
                                    "id": "110000509",
                                    "speaker": "Paimon",
                                    "text": "Oh gosh, this is... delicious!"
                                },
                                {
                                    "id": "110000510",
                                    "speaker": "Paimon",
                                    "text": "Can you tell us how to make it?"
                                },
                                {
                                    "id": "110000511",
                                    "speaker": "Xiangling",
                                    "text": "Hee-hee, sure! The only thing is I haven't written down the recipe yet, hmm..."
                                },
                                {
                                    "id": "110000512",
                                    "speaker": "Xiangling",
                                    "text": "I got it! I'll make another one now so you can watch. I'm sure you'll pick it up straight away."
                                },
                                {
                                    "id": "110000513",
                                    "speaker": "Paimon",
                                    "text": "This seems pretty hard to make, it'll take more than that to learn how to make it. And we don't have a frying pan or any condiments."
                                },
                                {
                                    "id": "110000514",
                                    "speaker": "Xiangling",
                                    "text": "Come on, it's simple!"
                                },
                                {
                                    "id": "110000515",
                                    "speaker": "Xiangling",
                                    "text": "We can fry on a slab of stone and cook using some boar fat. Build a stove from rocks, use dry grass for kindling, twigs for firewood..."
                                },
                                {
                                    "id": "110000516",
                                    "speaker": "Xiangling",
                                    "text": "Sweet flowers will do for sugar. As for salt, I found a load of rock salt in a cave the other day, there's still plenty left.",
                                    "choices": [
                                        {
                                            "id": "110000517",
                                            "text": "Seems like she's done this a million times before...",
                                            "response": [
                                                {
                                                    "id": "110000519",
                                                    "speaker": "Xiangling",
                                                    "text": "Hee-hee, I just can't help myself when there's a chance to try something new. But I can't exactly bring my whole kitchen with me every time I leave the house either."
                                                },
                                                {
                                                    "id": "110000520",
                                                    "speaker": "Xiangling",
                                                    "text": "Give me a second while I get everything ready."
                                                },
                                                {
                                                    "id": "110000521",
                                                    "speaker": "Allan",
                                                    "text": "Hey! What do you think you're doing?"
                                                },
                                                {
                                                    "id": "110000601",
                                                    "speaker": "Allan",
                                                    "text": "This is the boars' natural habitat, you can't hunt them here! You'll send them all running."
                                                },
                                                {
                                                    "id": "110000602",
                                                    "speaker": "Allan",
                                                    "text": "We hunters know better than to kill the chicken to get at the egg."
                                                },
                                                {
                                                    "id": "110000603",
                                                    "speaker": "Xiangling",
                                                    "text": "Oh! I get it."
                                                },
                                                {
                                                    "id": "110000604",
                                                    "speaker": "Xiangling",
                                                    "text": "The freshest, best-quality meat comes from free-range boars that grow up in the environment nature intended for them! If they all ran off..."
                                                },
                                                {
                                                    "id": "110000605",
                                                    "speaker": "Xiangling",
                                                    "text": "...It would be a major blow to gastronomy— no, to all mankind!",
                                                    "choices": [
                                                        {
                                                            "id": "110000606",
                                                            "text": "That's, uh, one way of understanding it.",
                                                            "response": [
                                                                {
                                                                    "id": "110000608",
                                                                    "speaker": "Xiangling",
                                                                    "text": "I'm sorry. I got excited and didn't think of the impact we'd have."
                                                                },
                                                                {
                                                                    "id": "110000609",
                                                                    "speaker": "Allan",
                                                                    "text": "*sigh* You should apologize to Draff."
                                                                },
                                                                {
                                                                    "id": "110000610",
                                                                    "speaker": "Allan",
                                                                    "text": "As our leader, he always stresses the importance of respecting the rules of the hunt. I'm afraid he is very upset right now.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110000611",
                                                                            "text": "What are we going to do?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110000613",
                                                                                    "speaker": "Xiangling",
                                                                                    "text": "I made a mistake, and I should go and apologize."
                                                                                },
                                                                                {
                                                                                    "id": "110000614",
                                                                                    "speaker": "Player",
                                                                                    "text": "Let us come with you."
                                                                                },
                                                                                {
                                                                                    "id": "110000615",
                                                                                    "speaker": "Xiangling",
                                                                                    "text": "Hee-hee, thanks guys. I'll cook up some more tasty snacks for you once this is over."
                                                                                },
                                                                                {
                                                                                    "id": "110000616",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Okay. Don't worry, Paimon'll remember even if you forget."
                                                                                },
                                                                                {
                                                                                    "id": "110000617",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Draff ought to be in Springvale. Let's go!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110000612",
                                                                            "text": "I think the hunter is right."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110000607",
                                                            "text": "That's not even close to what he meant..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110000518",
                                            "text": "I'm tired just listening to it!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110000504",
                            "text": "I want to try Slime Condensate!",
                            "response": [
                                {
                                    "id": "110000505",
                                    "speaker": "Paimon",
                                    "text": "#Yay! {NICKNAME} has finally come around to my food preferences."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}