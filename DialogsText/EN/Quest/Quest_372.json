    "talks": [
        {
            "id": "37201",
            "objective": "Find the Green Fellow",
            "dialogues": [
                {
                    "id": "3720101",
                    "speaker": "Green Fellow",
                    "text": "Wait, you guys are..."
                },
                {
                    "id": "3720102",
                    "speaker": "Green Fellow",
                    "text": "Oh, that's right! You're the ones that scared Dvalin away."
                },
                {
                    "id": "3720103",
                    "speaker": "Paimon",
                    "text": "Dvalin? Who's that?",
                    "choices": [
                        {
                            "id": "3720104",
                            "text": "That's Stormterror's real name.",
                            "response": [
                                {
                                    "id": "3720106",
                                    "speaker": "Paimon",
                                    "text": "Huh? ...Oh, right. Most people seem to call him \"Stormterror.\""
                                },
                                {
                                    "id": "3720107",
                                    "speaker": "Paimon",
                                    "text": "Why do you call him that... are you two meant to be close or something?"
                                },
                                {
                                    "id": "3720108",
                                    "speaker": "Green Fellow",
                                    "text": "Oh, so close..."
                                },
                                {
                                    "id": "3720109",
                                    "speaker": "Paimon",
                                    "text": "#Hey, {NICKNAME}. Paimon thinks this guy has a screw loose...",
                                    "choices": [
                                        {
                                            "id": "3720110",
                                            "text": "Ahh... hi.",
                                            "response": [
                                                {
                                                    "id": "3720111",
                                                    "speaker": "Green Fellow",
                                                    "text": "Good day, outlander. Seems we meet again."
                                                },
                                                {
                                                    "id": "3720113",
                                                    "speaker": "Venti",
                                                    "text": "I'm Venti the bard."
                                                },
                                                {
                                                    "id": "3720114",
                                                    "speaker": "Venti",
                                                    "text": "Three-time winner of the \"Most Popular Bard of Mondstadt,\" to be precise."
                                                },
                                                {
                                                    "id": "3720115",
                                                    "speaker": "Venti",
                                                    "text": "So, what do you need from me?"
                                                },
                                                {
                                                    "id": "3720116",
                                                    "speaker": "Paimon",
                                                    "text": "Given you recognize us, Paimon doesn't believe we need to explain any further."
                                                },
                                                {
                                                    "id": "3720117",
                                                    "speaker": "Paimon",
                                                    "text": "Of course it's about Stormterror."
                                                },
                                                {
                                                    "id": "3720118",
                                                    "speaker": "Venti",
                                                    "text": "Storm...?"
                                                },
                                                {
                                                    "id": "3720119",
                                                    "speaker": "Paimon",
                                                    "text": "Hey! Cut it with the amnesia act!"
                                                },
                                                {
                                                    "id": "3720120",
                                                    "speaker": "Paimon",
                                                    "text": "#{NICKNAME}, show it to him."
                                                },
                                                {
                                                    "id": "3720121",
                                                    "speaker": "Venti",
                                                    "text": "Oh! Isn't this—"
                                                },
                                                {
                                                    "id": "3720122",
                                                    "speaker": "Paimon",
                                                    "text": "What!? The crystal has been purified!? When?",
                                                    "choices": [
                                                        {
                                                            "id": "3720123",
                                                            "text": "Not sure how this happened.",
                                                            "response": [
                                                                {
                                                                    "id": "3720125",
                                                                    "speaker": "Venti",
                                                                    "text": "Dvalin, he..."
                                                                },
                                                                {
                                                                    "id": "3720126",
                                                                    "speaker": "Venti",
                                                                    "text": "The anguish he feels... has brought him to tears..."
                                                                },
                                                                {
                                                                    "id": "3720127",
                                                                    "speaker": "Paimon",
                                                                    "text": "Tears...?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3720124",
                                                            "text": "The last time I checked, it was full of impurities."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3720112",
                                            "text": "I'm sorry, you are...?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3720105",
                            "text": "Lisa told us already, weren't you listening?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "37202",
            "objective": "Listen to the Bard's performance",
            "dialogues": [
                {
                    "id": "3720201",
                    "speaker": "Venti",
                    "text": "He was once such a gentle child. Now so full of rage and suffering..."
                },
                {
                    "id": "3720202",
                    "speaker": "Player",
                    "text": "..."
                },
                {
                    "id": "3720203",
                    "speaker": "Venti",
                    "text": "I also came across a Teardrop Crystal."
                },
                {
                    "id": "3720204",
                    "speaker": "Venti",
                    "text": "Can you purify it?"
                },
                {
                    "id": "3720205",
                    "speaker": "Player",
                    "text": "...*nods*"
                }
            ]
        },
        {
            "id": "37203",
            "objective": "Talk to the mysterious bard",
            "dialogues": []
        },
        {
            "id": "37205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3720501",
                    "speaker": "Paimon",
                    "text": "Ehhhh!?"
                },
                {
                    "id": "3720502",
                    "speaker": "Venti",
                    "text": "You... really do have some wonderful abilities..."
                },
                {
                    "id": "3720503",
                    "speaker": "Venti",
                    "text": "Someone like you is going to end up getting written into a bard's poem."
                },
                {
                    "id": "3720504",
                    "speaker": "Venti",
                    "text": "#Oh, a hero so bright, should {M#he}{F#she} stand in the light. Though stand in the shade, and you'll be met by a blade..."
                },
                {
                    "id": "3720505",
                    "speaker": "Venti",
                    "text": "Alas... I've really not the time to compose a melody for you at this moment."
                },
                {
                    "id": "3720506",
                    "speaker": "Venti",
                    "text": "Anyway, even if Dvalin is not taken down, his life will still wither away in the breeze..."
                },
                {
                    "id": "3720507",
                    "speaker": "Venti",
                    "text": "He'll burn himself out in the flames of anger...",
                    "choices": [
                        {
                            "id": "3720508",
                            "text": "I also feel sorry for Dvalin.",
                            "response": [
                                {
                                    "id": "3720509",
                                    "speaker": "Venti",
                                    "text": "Thank you for that, and you for purifying the Teardrop Crystal."
                                },
                                {
                                    "id": "3720510",
                                    "speaker": "Venti",
                                    "text": "But I have my own plans for what is to follow."
                                },
                                {
                                    "id": "3720517",
                                    "speaker": "Paimon",
                                    "text": "Oh? And what plan would that be?"
                                },
                                {
                                    "id": "3720518",
                                    "speaker": "Venti",
                                    "text": "Seeing this tear has brought to mind a friend so dear."
                                },
                                {
                                    "id": "3720519",
                                    "speaker": "Paimon",
                                    "text": "Friend?"
                                },
                                {
                                    "id": "3720520",
                                    "speaker": "Venti",
                                    "text": "Heh-heh, one must be going."
                                },
                                {
                                    "id": "3720521",
                                    "speaker": "Paimon",
                                    "text": "Hey! Where're you running off to!?"
                                },
                                {
                                    "id": "3720522",
                                    "speaker": "Venti",
                                    "text": "To the \"Symbol of Mondstadt's Hero.\" Bye-bye~"
                                },
                                {
                                    "id": "3720523",
                                    "speaker": "Paimon",
                                    "text": "#Huh... {NICKNAME}, what do you make of that?"
                                },
                                {
                                    "id": "3720524",
                                    "speaker": "Player",
                                    "text": "This \"weirdo\" as you put it — we need to keep an eye on him..."
                                },
                                {
                                    "id": "3720525",
                                    "speaker": "Paimon",
                                    "text": "As far as he's concerned, you're a weirdo too ya know..."
                                },
                                {
                                    "id": "3720526",
                                    "speaker": "Player",
                                    "text": "You know..."
                                },
                                {
                                    "id": "3720527",
                                    "speaker": "Paimon",
                                    "text": "Know what?"
                                },
                                {
                                    "id": "3720528",
                                    "speaker": "Player",
                                    "text": "His voice seems familiar..."
                                }
                            ]
                        },
                        {
                            "id": "3720511",
                            "text": "Is there anything I can do to help?",
                            "response": [
                                {
                                    "id": "3720512",
                                    "speaker": "Venti",
                                    "text": "I really must thank you for purifying the Teardrop Crystal, it has helped me greatly."
                                },
                                {
                                    "id": "3720513",
                                    "speaker": "Venti",
                                    "text": "But I've already come to devise my own plan."
                                }
                            ]
                        },
                        {
                            "id": "3720514",
                            "text": "As a knight, I suggest you turn yourself in along with the dragon.",
                            "response": [
                                {
                                    "id": "3720515",
                                    "speaker": "Venti",
                                    "text": "Do you really deem that necessary?"
                                },
                                {
                                    "id": "3720516",
                                    "speaker": "Venti",
                                    "text": "You can forget about me turning us in for now... I have another plan."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}