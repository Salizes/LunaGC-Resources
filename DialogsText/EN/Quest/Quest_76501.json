    "talks": [
        {
            "id": "7650101",
            "objective": "",
            "dialogues": [
                {
                    "id": "765010101",
                    "speaker": "Lauma",
                    "text": "#Ah. {NICKNAME}, Paimon. It's you. The birds of the woods just spoke of your coming. Do you come with some important matter, or... do you perhaps require my guidance?",
                    "choices": [
                        {
                            "id": "765010102",
                            "text": "We're just looking around.",
                            "response": [
                                {
                                    "id": "765010104",
                                    "speaker": "Lauma",
                                    "text": "This place is well-nourished by the moon's radiance. The plant and animal life dwelling within it are both different from those anywhere else in the world."
                                },
                                {
                                    "id": "765010105",
                                    "speaker": "Lauma",
                                    "text": "So yes, I would call it a good place to take excellent photos."
                                },
                                {
                                    "id": "765010106",
                                    "speaker": "Lauma",
                                    "text": "Please, feel free to look around. Should you have any questions, do not hesitate to approach me. I shall answer as best I can.",
                                    "choices": [
                                        {
                                            "id": "765010107",
                                            "text": "This place really gives off a sense of tranquility.",
                                            "response": [
                                                {
                                                    "id": "765010109",
                                                    "speaker": "Lauma",
                                                    "text": "Yes. This is where I meditate, where I commune with all living things in whispers."
                                                },
                                                {
                                                    "id": "765010110",
                                                    "speaker": "Lauma",
                                                    "text": "Just standing here helps set my heart at ease."
                                                },
                                                {
                                                    "id": "765010111",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, you're a real poet, Lauma!",
                                                    "choices": [
                                                        {
                                                            "id": "765010112",
                                                            "text": "I do, in fact, have a small request...",
                                                            "response": [
                                                                {
                                                                    "id": "765010114",
                                                                    "speaker": "Paimon",
                                                                    "text": "Yeah. You fit super well with the background, like the center of a beautiful painting! You'd look awesome in a photo, for sure!"
                                                                },
                                                                {
                                                                    "id": "765010115",
                                                                    "speaker": "Lauma",
                                                                    "text": "You'd like to... take a picture of me? That would be a novel experience. If you believe that the serenity of this place and my form are worth immortalizing through the frame, I'd be glad to oblige."
                                                                },
                                                                {
                                                                    "id": "765010116",
                                                                    "speaker": "Lauma",
                                                                    "text": "Indeed, I would be honored to add another lovely memory to your journey."
                                                                },
                                                                {
                                                                    "id": "765010117",
                                                                    "speaker": "Lauma",
                                                                    "text": "So, how may I assist you? Will you need me to look in a certain direction, or will things work as-is?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765010118",
                                                                            "text": "Just be yourself.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765010120",
                                                                                    "speaker": "Lauma",
                                                                                    "text": "Alright, I will leave it to you, then. May inspiration, fleeting though it should be, grace you with its presence."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765010119",
                                                                            "text": "I'll catch you at your most inspiring, don't you worry."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765010113",
                                                            "text": "We'd like to take a picture of you."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765010108",
                                            "text": "Do you usually hang out in this area, Lauma?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765010103",
                            "text": "And looking for some photo-op material while we're at it."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650104",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010401",
                    "speaker": "Lauma",
                    "text": "Are you ready? If you believe the time to be right, we may begin."
                }
            ]
        },
        {
            "id": "7650105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010501",
                    "speaker": "Player",
                    "text": "I'm ready. Let's get this photoshoot going!"
                }
            ]
        },
        {
            "id": "7650106",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010601",
                    "speaker": "Player",
                    "text": "Hold on, I need a moment to consider the angle we'll be taking."
                }
            ]
        },
        {
            "id": "7650107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010701",
                    "speaker": "Lauma",
                    "text": "#Ah. {NICKNAME}, Paimon. It's you. The birds of the woods just spoke of your coming. Do you come with some important matter, or... do you perhaps require my guidance?",
                    "choices": [
                        {
                            "id": "765010702",
                            "text": "We're just looking around.",
                            "response": [
                                {
                                    "id": "765010704",
                                    "speaker": "Lauma",
                                    "text": "Ah, I see. Feel free to take the sights in and take pictures of them as you please."
                                },
                                {
                                    "id": "765010705",
                                    "speaker": "Lauma",
                                    "text": "That said, I don't see your Kamera anywhere on you. Without it, even the most peerless vistas cannot be transformed into pictures to be remembered, no?"
                                }
                            ]
                        },
                        {
                            "id": "765010703",
                            "text": "And looking for some photo-op material while we're at it."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "765010801",
                    "speaker": "Lauma",
                    "text": "How did it go? Have you found the photo-taking material you envisioned?",
                    "choices": [
                        {
                            "id": "765010803",
                            "text": "We're good. Let the photo-op begin!",
                            "response": [
                                {
