    "talks": [
        {
            "id": "7053502",
            "objective": "Go to the Knights of Favonius Library",
            "dialogues": [
                {
                    "id": "705350201",
                    "speaker": "Klee",
                    "text": "Okay, got it!"
                },
                {
                    "id": "705350202",
                    "speaker": "Klee",
                    "text": "But... fish taste best when they're freshly blasted. Grill them over a fire and they'll turn extra crispy and smell sooo good!"
                },
                {
                    "id": "705350203",
                    "speaker": "Lisa",
                    "text": "Don't worry, Jean has... informed me about all that a while ago."
                },
                {
                    "id": "705350204",
                    "speaker": "Lisa",
                    "text": "So, I went ahead and placed some orders at Good Hunter. Over the next few days, their chefs will be preparing the best fish fresh from the lake, and cooking them right away."
                },
                {
                    "id": "705350205",
                    "speaker": "Lisa",
                    "text": "Freshly cooked fish served with Klee's favorite spices and my specially prepared desserts... Hehe, I'm sure it'll be just as delicious as your catches."
                },
                {
                    "id": "705350206",
                    "speaker": "Klee",
                    "text": "Okay! Then I'll trust your taste, Lisa!"
                },
                {
                    "id": "705350207",
                    "speaker": "Klee",
                    "text": "I promise I'll stay in the city and play Dodoco's Bomb-Tastic Adventure! I won't go fish blasting or make any trouble for Albedo's friend!"
                },
                {
                    "id": "705350208",
                    "speaker": "Klee",
                    "text": "#Anyway, I'm gonna go look for {F#Miss}{M#Mr.} Honorary Knight and Paimon now!"
                },
                {
                    "id": "705350209",
                    "speaker": "Paimon",
                    "text": "Hehe, is someone looking for us?",
                    "choices": [
                        {
                            "id": "705350210",
                            "text": "It's pretty rare to see you two together.",
                            "response": [
                                {
                                    "id": "705350212",
                                    "speaker": "Klee",
                                    "text": "#{F#Miss}{M#Mr.} Honorary Knight and Paimon!"
                                },
                                {
                                    "id": "705350213",
                                    "speaker": "Klee",
                                    "text": "Klee was just thinking about you, and then you appeared! How'd you do that? Oh! Did you somehow magically hear Klee's thoughts!?"
                                },
                                {
                                    "id": "705350214",
                                    "speaker": "Lisa",
                                    "text": "Oh? Little cutie and Paimon, you're here just in time. Looks like I won't have to go to the trouble of writing you a letter now.",
                                    "choices": [
                                        {
                                            "id": "705350215",
                                            "text": "Klee's wishes summoned us here!",
                                            "response": [
                                                {
                                                    "id": "705350217",
                                                    "speaker": "Paimon",
                                                    "text": "We had some time on our hands and wanted to look for something to read in the library... Anyway, what's \"Dodoco's Bomb-Tastic Adventure\"? It sounds way more fun than reading a book!"
                                                },
                                                {
                                                    "id": "705350218",
                                                    "speaker": "Klee",
                                                    "text": "It's a new game Lisa made for me! We came up with the name together. You're amazing, Paimon! You remembered the name so quickly!"
                                                },
                                                {
                                                    "id": "705350219",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa, you can design games, Lisa? Paimon thought that you were just into the books."
                                                },
                                                {
                                                    "id": "705350220",
                                                    "speaker": "Lisa",
                                                    "text": "Hehe, I merely drew some inspiration from Shroomsplosion, a game from back when I was a student. It really didn't take too much effort."
                                                },
                                                {
                                                    "id": "705350221",
                                                    "speaker": "Lisa",
                                                    "text": "As long as we keep Klee happy during these unique circumstances, I'm willing to design as many games as she likes."
                                                },
                                                {
                                                    "id": "705350222",
                                                    "speaker": "Player",
                                                    "text": "Unique circumstances?"
                                                },
                                                {
                                                    "id": "705350223",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, now that Paimon thinks about it, Klee mentioned Albedo's friend, right? Did something happen in Mondstadt?"
                                                },
                                                {
                                                    "id": "705350224",
                                                    "speaker": "Lisa",
                                                    "text": "It's not too serious, but the situation still has to be treated with caution."
                                                },
                                                {
                                                    "id": "705350225",
                                                    "speaker": "Lisa",
                                                    "text": "Recently, fish species native to Sumeru have begun appearing in Cider Lake. Allowing them to spread would put the ecological balance of Mondstadt's waters at risk."
                                                },
                                                {
                                                    "id": "705350226",
                                                    "speaker": "Lisa",
                                                    "text": "Luckily, Klee noticed some fish she'd never seen before while she snuck out to play. She caught a few and showed them to Kaeya."
                                                },
                                                {
                                                    "id": "705350227",
                                                    "speaker": "Lisa",
                                                    "text": "If it weren't for Klee, I'm afraid most of the local species would've already receded by the time ordinary citizens fully grasp the situation."
                                                },
                                                {
                                                    "id": "705350228",
                                                    "speaker": "Lisa",
                                                    "text": "And if a change occurs in the underwater ecosystem, it could very well affect the quality of water in Cider Lake. Consequently, the entire wine industry of Mondstadt could be in danger... and that poses a major threat to our economy."
                                                },
                                                {
                                                    "id": "705350229",
                                                    "speaker": "Klee",
                                                    "text": "Hehe, I saved the day! I even got praised by Master Jean!",
                                                    "choices": [
                                                        {
                                                            "id": "705350230",
                                                            "text": "Good job, Klee!",
                                                            "response": [
                                                                {
                                                                    "id": "705350232",
                                                                    "speaker": "Paimon",
                                                                    "text": "So that's what happened... Good thing Klee noticed the fish before things got out of control."
                                                                },
                                                                {
                                                                    "id": "705350233",
                                                                    "speaker": "Lisa",
                                                                    "text": "The Investigation Team sent out a few members to inspect Cider Lake and look for the origin of the intruding species."
                                                                },
                                                                {
                                                                    "id": "705350234",
                                                                    "speaker": "Lisa",
                                                                    "text": "To avoid disturbing these little invaders, Klee has to keep her treasured bombs away for some time."
                                                                },
                                                                {
                                                                    "id": "705350235",
                                                                    "speaker": "Lisa",
                                                                    "text": "The Investigation Team's instruments are extremely sensitive, so any explosion within a certain distance of the lake would affect their data."
                                                                },
                                                                {
                                                                    "id": "705350236",
                                                                    "speaker": "Lisa",
                                                                    "text": "Jean said that Klee would definitely get bored being cooped up inside the city all the time."
                                                                },
                                                                {
                                                                    "id": "705350237",
                                                                    "speaker": "Lisa",
                                                                    "text": "Albedo's busy making improvements to the Reconnaissance Company's experimental equipment, while Kaeya just left for a business trip. So, the task of looking after her fell on my shoulders..."
                                                                },
                                                                {
                                                                    "id": "705350238",
                                                                    "speaker": "Klee",
                                                                    "text": "#But I'm not bored anymore, because Lisa invented Dodoco's Bomb-Tastic Adventure! {M#Mr.}{F#Miss} Honorary Knight and Paimon, let's play together!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705350239",
                                                                            "text": "Count us in!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705350241",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Alright, the game table is right over there in the garden. The orders I've placed at Good Hunter will also be delivered there."
                                                                                },
                                                                                {
                                                                                    "id": "705350242",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Please enjoy yourselves! It's not every day that you get to play games with Klee, surrounded by the scent of flowers on the breeze, with delicious food delivered right to you~"
                                                                                },
                                                                                {
                                                                                    "id": "705350243",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Wait Lisa, are you not coming with us?"
                                                                                },
                                                                                {
                                                                                    "id": "705350244",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Don't you think it'd be a little unfair if the game's creator joined in? I don't want to spoil the fun."
                                                                                },
                                                                                {
                                                                                    "id": "705350245",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Besides, as the librarian, I still have my basic responsibilities to take care of."
                                                                                },
                                                                                {
                                                                                    "id": "705350246",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "That just sounds like another excuse for staying indoors..."
                                                                                },
                                                                                {
                                                                                    "id": "705350247",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Run along now, have fun playing with Klee!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705350248",
                                                                                            "text": "We'll take good care of Klee!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705350250",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Okay then, we'll catch you later, Lisa!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705350249",
                                                                                            "text": "Thanks, Lisa!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705350240",
                                                                            "text": "We'll play until sundown!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705350231",
                                                            "text": "Well-deserved praise, indeed!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705350216",
                                            "text": "We were brought here by the magic of pure coincidence!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705350211",
                            "text": "Sounds like you two just made an important agreement."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7053503",
            "objective": "Go to the garden",
            "dialogues": [
                {
                    "id": "705350301",
                    "speaker": "Klee",
                    "text": "#We're here, {M#Mr.}{F#Miss} Honorary Knight! This is where we'll play Dodoco's Bomb-Tastic Adventure!"
                },
                {
                    "id": "705350302",
                    "speaker": "Paimon",
                    "text": "Whoa, Lisa really picked a good spot! Paimon loves it here already."
                },
                {
                    "id": "705350303",
                    "speaker": "Paimon",
                    "text": "Alright, teach us how to play, Klee!",
                    "choices": [
                        {
                            "id": "705350304",
                            "text": "Dodo-Adventures!",
                            "response": [
                                {
                                    "id": "705350306",
                                    "speaker": "Klee",
                                    "text": "Hehe! Yeah, let's play!"
                                }
                            ]
                        },
                        {
                            "id": "705350305",
                            "text": "Kaboooom!"
                        }
                    ]
                }
            ]
        }
    ]
