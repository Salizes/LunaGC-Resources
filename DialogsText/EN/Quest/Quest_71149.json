    "talks": [
        {
            "id": "7114901",
            "objective": "Talk to Pingxi",
            "dialogues": [
                {
                    "id": "711490101",
                    "speaker": "Pingxi",
                    "text": "The arrangements this year came together pretty nicely. Phew... At least I don't have to trouble Lady Keqing to come and review personally."
                },
                {
                    "id": "711490116",
                    "speaker": "Pingxi",
                    "text": "Ugh! I've got to stop dwelling on these things! I'm the God of Fortune I'm the God of Fortune I'm the God of Fortune..."
                },
                {
                    "id": "711490103",
                    "speaker": "Player",
                    "text": "And you are...?"
                },
                {
                    "id": "711490117",
                    "speaker": "Pingxi",
                    "text": "I'm the God of Fortune!",
                    "choices": [
                        {
                            "id": "711490118",
                            "text": "I... I can tell...",
                            "response": [
                                {
                                    "id": "711490120",
                                    "speaker": "Pingxi",
                                    "text": "#Huh? Isn't this {NICKNAME}? Goodness, if I'd known you were the one coming, I wouldn't have to memorize so many lines..."
                                },
                                {
                                    "id": "711490121",
                                    "speaker": "Pingxi",
                                    "text": "And given the looks of you, I presume that you are here to celebrate Lantern Rite?"
                                },
                                {
                                    "id": "711490122",
                                    "speaker": "Pingxi",
                                    "text": "It's about time you showed up! Look around — it's even more lively than last year's Lantern Rite, isn't it?",
                                    "choices": [
                                        {
                                            "id": "711490123",
                                            "text": "Every Lantern Rite...",
                                            "response": [
                                                {
                                                    "id": "711490125",
                                                    "speaker": "Pingxi",
                                                    "text": "Of course! You know what they say, \"Xiao Lanterns soar and fill the night, step by step we seek new heights!\" We've gotta improve in everything we do."
                                                },
                                                {
                                                    "id": "711490126",
                                                    "speaker": "Pingxi",
                                                    "text": "Aiya, let's not dwell on that during the festivities. Come come, let me show you where the fun happens."
                                                },
                                                {
                                                    "id": "711490127",
                                                    "speaker": "Pingxi",
                                                    "text": "Let me think... Hm... Got it! First things first — you have to release Xiao Lanterns. It's Lantern Rite after all."
                                                },
                                                {
                                                    "id": "711490128",
                                                    "speaker": "Pingxi",
                                                    "text": "And then, we also set up a bunch of Auspicious Treasure Trees around Liyue Harbor. As long as you prune their branches properly, the Fortune Coins inside are yours."
                                                },
                                                {
                                                    "id": "711490129",
                                                    "speaker": "Pingxi",
                                                    "text": "How many trees did we put out again...? Was it 21? Yes, 21 trees."
                                                },
                                                {
                                                    "id": "711490130",
                                                    "speaker": "Pingxi",
                                                    "text": "Actually, there's an Auspicious Treasure Tree not too far away! If you're interested, you can help to prune it. Don't worry, it's very simple."
                                                },
                                                {
                                                    "id": "711490131",
                                                    "speaker": "Pingxi",
                                                    "text": "And finally, you can also check out the Bulletin Board. It's right beside me."
                                                },
                                                {
                                                    "id": "711490132",
                                                    "speaker": "Pingxi",
                                                    "text": "Many tourists from other nations have joined us for Lantern Rite in the recent years, so the Ministry of Civil Affairs prepared a special Bulletin Board for them."
                                                },
                                                {
                                                    "id": "711490102",
                                                    "speaker": "Pingxi",
                                                    "text": "Whatever issues they run into, or if there's anything they need help with, they can write it down and post it on the Bulletin Board."
                                                },
                                                {
                                                    "id": "711490133",
                                                    "speaker": "Pingxi",
                                                    "text": "We at the Ministry of Civil Affairs will make sure everyone who comes to Liyue for Lantern Rite leaves with a smile, hehe!",
                                                    "choices": [
                                                        {
                                                            "id": "711490134",
                                                            "text": "That's the Ministry of Civil Affairs for you.",
                                                            "response": [
                                                                {
                                                                    "id": "711490136",
                                                                    "speaker": "Pingxi",
                                                                    "text": "Of course!"
                                                                },
                                                                {
                                                                    "id": "711490137",
                                                                    "speaker": "Pingxi",
                                                                    "text": "#By the way, {NICKNAME}, I remember you're really good at taking pictures, aren't you?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "711490138",
                                                                            "text": "I know a little.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "711490140",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "Hahaha, don't be so modest. I just wanted to... ask you for a little favor."
                                                                                },
                                                                                {
                                                                                    "id": "711490141",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "It's really simple, I promise! All you have to do is take a commemorative photo for some tourists."
                                                                                },
                                                                                {
                                                                                    "id": "711490142",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "We originally hired a few photographers to take commemorative photos for everyone, but we didn't expect that there would be so many tourists this year. There suddenly weren't enough photographers to go around."
                                                                                },
                                                                                {
                                                                                    "id": "711490143",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "#It's too late to hire new photographers... You're the only one I can count on, {NICKNAME}!"
                                                                                },
                                                                                {
                                                                                    "id": "711490144",
                                                                                    "speaker": "Pingxi",
                                                                                    "text": "Please! For the tourists, for Lantern Rite, for Liyue! You're the only one who can help us!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "711490145",
                                                                                            "text": "Leave it to me!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "711490147",
                                                                                                    "speaker": "Pingxi",
                                                                                                    "text": "#You're a lifesaver, {NICKNAME}! I'll tell you the tourists' names and their designated locations right away."
                                                                                                },
                                                                                                {
                                                                                                    "id": "711490148",
                                                                                                    "speaker": "Pingxi",
                                                                                                    "text": "I'm counting on you! With your help, this year's Lantern Rite will be flawless."
                                                                                                },
                                                                                                {
                                                                                                    "id": "711490149",
                                                                                                    "speaker": "Pingxi",
                                                                                                    "text": "Here, these Xiao Lanterns are for you! Hehe, Happy Lantern Rite!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "711490146",
                                                                                            "text": "For Lantern Rite!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "711490139",
                                                                            "text": "Nope, I'm a complete rookie."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711490135",
                                                            "text": "That's Liyue for you..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711490124",
                                            "text": "Feels more impressive than the year before..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "711490119",
                            "text": "That's a very auspicious outfit..."
                        }
                    ]
                }
            ]
        }
    ]
}