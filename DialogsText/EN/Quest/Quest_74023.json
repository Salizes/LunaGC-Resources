    "talks": [
        {
            "id": "7402301",
            "objective": "",
            "dialogues": [
                {
                    "id": "740230101",
                    "speaker": "Paimon",
                    "text": "Phew, this looks so much better. Salsa would be proud of us if she saw this, don't you think so, Traveler?"
                },
                {
                    "id": "740230102",
                    "speaker": "???",
                    "text": "Robbers! A robbery in broad daylight!"
                },
                {
                    "id": "740230103",
                    "speaker": "Paimon",
                    "text": "Huh!? Robbers? Where?"
                },
                {
                    "id": "740230104",
                    "speaker": "???",
                    "text": "I'm talking about you two! Not only did you destroy my masterpiece, you even took the chest...",
                    "choices": [
                        {
                            "id": "740230105",
                            "text": "So it really was the work of an Adventurers' Guild member...",
                            "response": [
                                {
                                    "id": "740230106",
                                    "speaker": "???",
                                    "text": "What work on earth? I should be asking you guys about what you did!"
                                },
                                {
                                    "id": "740230109",
                                    "speaker": "Paimon",
                                    "text": "So, these ugly things are your \"masterpieces\"?"
                                },
                                {
                                    "id": "740230110",
                                    "speaker": "???",
                                    "text": "The audacity! What do you mean \"ugly things\"? Haven't you heard of installation art?"
                                },
                                {
                                    "id": "740230111",
                                    "speaker": "???",
                                    "text": "Looks like Fontaine's art education still has a long way to go... Oh, but you two don't look like you're from Fontaine."
                                },
                                {
                                    "id": "740230112",
                                    "speaker": "Paimon",
                                    "text": "#That's because we are not from Fontaine. Paimon's Paimon, and {M#he}{F#she} is {NICKNAME}. We are also members of the Adventurers' Guild.",
                                    "choices": [
                                        {
                                            "id": "740230113",
                                            "text": "We are members of an evil organization... *sob*",
                                            "response": [
                                                {
                                                    "id": "740230114",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah, but we don't have to wear uniforms. So we're not bad guys in green, yay!"
                                                },
                                                {
                                                    "id": "740230117",
                                                    "speaker": "Ubu",
                                                    "text": "I'm Ubu, an adventurer and installation artist. Seeing how you guys are making zero sense, I'm guessing you're often up to crazy shenanigans... I won't pursue this matter this time."
                                                },
                                                {
                                                    "id": "740230118",
                                                    "speaker": "Paimon",
                                                    "text": "Huh? Actually..."
                                                },
                                                {
                                                    "id": "740230119",
                                                    "speaker": "Ubu",
                                                    "text": "What? I need to restore the work, so if you want to say thank you, do it quickly."
                                                },
                                                {
                                                    "id": "740230120",
                                                    "speaker": "Salsa",
                                                    "text": "I have nothing to thank you for, but I sure have a million things I wanna yell at you for!"
                                                },
                                                {
                                                    "id": "740230121",
                                                    "speaker": "Paimon",
                                                    "text": "Salsa!"
                                                },
                                                {
                                                    "id": "740230122",
                                                    "speaker": "Salsa",
                                                    "text": "With me around, you don't have to be scared, Paimon!"
                                                },
                                                {
                                                    "id": "740230123",
                                                    "speaker": "Salsa",
                                                    "text": "Evil green guy, we have destroyed all of the traps laid by you! Stop trying to ruin our beautiful Fontaine with your sinister traps!"
                                                },
                                                {
                                                    "id": "740230124",
                                                    "speaker": "Ubu",
                                                    "text": "Ruin? Wait, \"destroyed all\"? ...You destroyed all of my artworks!?"
                                                },
                                                {
                                                    "id": "740230125",
                                                    "speaker": "Paimon",
                                                    "text": "Umm, we didn't exactly destroy them... We just rearranged them to suit the surrounding scenery..."
                                                },
                                                {
                                                    "id": "740230126",
                                                    "speaker": "Ubu",
                                                    "text": "You...! You brats and plebeians! How could you hope to understand art! To turn my installation art, my works into something so mediocre and mundane..."
                                                },
                                                {
                                                    "id": "740230127",
                                                    "speaker": "Paimon",
                                                    "text": "But is it really art? Paimon doesn't know much about it, but can you really call something that looks so out of place art?"
                                                },
                                                {
                                                    "id": "740230128",
                                                    "speaker": "Ubu",
                                                    "text": "Of course, the boundaries of art are set by the artist. A work created by an artist is naturally called a work of art."
                                                },
                                                {
                                                    "id": "740230129",
                                                    "speaker": "Salsa",
                                                    "text": "Who's the artist?"
                                                },
                                                {
                                                    "id": "740230130",
                                                    "speaker": "Ubu",
                                                    "text": "It is I, Ubu, the extraordinary installation artist."
                                                },
                                                {
                                                    "id": "740230131",
                                                    "speaker": "Salsa",
                                                    "text": "In that case, as the founder of the \"Alliance of Artists to Overthrow the Evil Organization and Protect the Future of Fontaine,\" I declare that I do not recognize it as art."
                                                },
                                                {
                                                    "id": "740230132",
                                                    "speaker": "Ubu",
                                                    "text": "\"Overthrow the E—\" ...What?",
                                                    "choices": [
                                                        {
                                                            "id": "740230133",
                                                            "text": "Overthrow the Evil Organization.",
                                                            "response": [
                                                                {
                                                                    "id": "740230134",
                                                                    "speaker": "Paimon",
                                                                    "text": "It refers to the Adventurers' Guild that is ruining the scenery with, umm, installation art..."
                                                                },
                                                                {
                                                                    "id": "740230136",
                                                                    "speaker": "Ubu",
                                                                    "text": "What a joke, I've never heard of such an alliance. Kid, what gives you the right to say that my work isn't art?"
                                                                },
                                                                {
                                                                    "id": "740230137",
                                                                    "speaker": "Salsa",
                                                                    "text": "I'm a painter, so you could say I'm an artist. Of course I'm qualified."
                                                                },
                                                                {
                                                                    "id": "740230138",
                                                                    "speaker": "Ubu",
                                                                    "text": "Huh? Look, kid, being an artist isn't some child's play. You can't say you're an artist just because you want to become one. You gotta have works that are recognized by people..."
                                                                },
                                                                {
                                                                    "id": "740230139",
                                                                    "speaker": "Salsa",
                                                                    "text": "So what makes you qualified? Your works, the installation art you speak of... Those evil traps? Do people clap when they see them?"
                                                                },
                                                                {
                                                                    "id": "740230140",
                                                                    "speaker": "Ubu",
                                                                    "text": "That's because there are too many plebeians who can't comprehend the charm of my works. True art is always the least understood...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "740230141",
                                                                            "text": "You should start from making art that people can actually understand.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740230142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yeah, if no one understands, it's either too avant-garde, or simply..."
                                                                                },
                                                                                {
                                                                                    "id": "740230145",
                                                                                    "speaker": "Ubu",
                                                                                    "text": "No... It can't be! My works are perfect! There is absolutely nothing wrong with them! You guys just don't understand, people just don't understand..."
                                                                                },
                                                                                {
                                                                                    "id": "740230146",
                                                                                    "speaker": "Ubu",
                                                                                    "text": "Darn it, I'm not giving up! This isn't over!"
                                                                                },
                                                                                {
                                                                                    "id": "740230147",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "Ubu stumbles away..."
                                                                                },
                                                                                {
                                                                                    "id": "740230148",
                                                                                    "speaker": "Salsa",
                                                                                    "text": "What a stubborn enemy! But I'm not giving up either! The future of Fontaine's art rests on my shoulders!"
                                                                                },
                                                                                {
                                                                                    "id": "740230149",
                                                                                    "speaker": "Player",
                                                                                    "text": "We all have a goal to work towards."
                                                                                },
                                                                                {
                                                                                    "id": "740230150",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Is this a good thing? It probably is, right?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "740230143",
                                                                            "text": "Simply put, no one understands it at all.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "740230144",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Which sounds like a failure..."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740230135",
                                                            "text": "Basically, we have to take you down."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740230115",
                                            "text": "Well hello there, buddy.",
                                            "response": [
                                                {
                                                    "id": "740230116",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon doesn't think you can call someone buddy when you don't even know their name..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740230107",
                            "text": "Wait, it's the evil green guy!",
                            "response": [
                                {
                                    "id": "740230108",
                                    "speaker": "???",
                                    "text": "Hah, a robber who is spouting nonsense. What a day it is today!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7402304",
            "objective": "Talk to Paimon",
            "dialogues": [
                {
                    "id": "740230201",
                    "speaker": "Paimon",
                    "text": "Hmm... Paimon can't stand how these objects look... Somehow, it reminds Paimon of those ugly things we saw last time..."
                },
                {
                    "id": "740230202",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Why is there a Hydro Monument buried underground</color>? Paimon doesn't get it..."
                },
                {
                    "id": "740230203",
                    "speaker": "Paimon",
                    "text": "#{NICKNAME}, should we rearrange it? Just like how Salsa taught us!"
                }
            ]
        },
        {
            "id": "7402302",
            "objective": "Place the Hydro Elemental Monument again",
            "dialogues": []
        },
        {
            "id": "7402303",
            "objective": "Talk to the person in green",
            "dialogues": []
        },
        {
            "id": "7402303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740230301",
                    "speaker": "Salsa",
                    "text": "#Hello, {NICKNAME} and Paimon!",
                    "choices": [
                        {
                            "id": "740230302",
                            "text": "Did you manage to recruit new members for the alliance?",
                            "response": [
                                {
                                    "id": "740230303",
                                    "speaker": "Salsa",
                                    "text": "I found prospective members who are willing to participate, but I need to carry out a rigorous assessment to make sure they have the right qualifications. After all, Fontaine's future is at stake."
                                }
                            ]
                        },
                        {
                            "id": "740230304",
                            "text": "Not rushing home today?",
                            "response": [
                                {
                                    "id": "740230305",
                                    "speaker": "Salsa",
                                    "text": "I've finished my homework, so I thought I'd hang around a little longer before heading home..."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}