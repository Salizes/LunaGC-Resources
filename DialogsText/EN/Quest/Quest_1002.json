    "talks": [
        {
            "id": "100201",
            "objective": "Meet the adepti in Jueyun Karst",
            "dialogues": []
        },
        {
            "id": "100202",
            "objective": "",
            "dialogues": [
                {
                    "id": "10020201",
                    "speaker": "???",
                    "text": "And who might we be? Those that dare enter Jueyun Karst?",
                    "choices": [
                        {
                            "id": "10020202",
                            "text": "I was sent here.",
                            "response": [
                                {
                                    "id": "10020203",
                                    "speaker": "Player",
                                    "text": "Please take a look at this."
                                },
                                {
                                    "id": "10020204",
                                    "speaker": "???",
                                    "text": "A Sigil of Permission... Many a season has passed since one was last in the presence of such an item."
                                },
                                {
                                    "id": "10020205",
                                    "speaker": "Moon Carver",
                                    "text": "He before you is the mighty and illuminated adeptus, Moon Carver. Speak, traveler. What business have you here?"
                                },
                                {
                                    "id": "10020206",
                                    "speaker": "Paimon",
                                    "text": "Actually..."
                                },
                                {
                                    "id": "10020207",
                                    "speaker": "Millelith Sergeant",
                                    "text": "It's the assassin! They dared to flee here to Jueyun Karst!"
                                },
                                {
                                    "id": "10020208",
                                    "speaker": "Millelith Soldier",
                                    "text": "Sir, we've already stepped too far into Jueyun Karst ourselves..."
                                },
                                {
                                    "id": "10020209",
                                    "speaker": "Millelith Sergeant",
                                    "text": "We... Argh, there's no choice. Apprehending the assassin is top priority, we must press on!"
                                },
                                {
                                    "id": "10020210",
                                    "speaker": "Moon Carver",
                                    "text": "...disturbing our borders."
                                },
                                {
                                    "id": "10020211",
                                    "speaker": "Moon Carver",
                                    "text": "See them gone. One will not have interruption."
                                }
                            ]
                        },
                        {
                            "id": "10020203",
                            "text": "Please take a look at this."
                        }
                    ]
                }
            ]
        },
        {
            "id": "100204",
            "objective": "Fight with support from the adepti",
            "dialogues": []
        },
        {
            "id": "100205",
            "objective": "",
            "dialogues": [
                {
                    "id": "10020501",
                    "speaker": "Moon Carver",
                    "text": "We've digressed. State your purpose, traveler."
                },
                {
                    "id": "10020502",
                    "speaker": "Paimon",
                    "text": "Well..."
                },
                {
                    "id": "10020503",
                    "speaker": "Moon Carver",
                    "text": "Preposterous..."
                },
                {
                    "id": "10020504",
                    "speaker": "Moon Carver",
                    "text": "PREPOSTEROUS!!!"
                },
                {
                    "id": "10020505",
                    "speaker": "Moon Carver",
                    "text": "The Liyue Qixing... utterly disappointing."
                },
                {
                    "id": "10020506",
                    "speaker": "Moon Carver",
                    "text": "How could someone possibly assassinate Rex Lapis during the Rite of Descension..."
                },
                {
                    "id": "10020507",
                    "speaker": "Moon Carver",
                    "text": "And then place suspicion upon the attendees!?"
                },
                {
                    "id": "10020508",
                    "speaker": "Moon Carver",
                    "text": "..."
                },
                {
                    "id": "10020509",
                    "speaker": "Moon Carver",
                    "text": "Traveler, of the unjust accusations placed upon you, one has become aware."
                },
                {
                    "id": "10020510",
                    "speaker": "Moon Carver",
                    "text": "The mind knows its answer. Though one must consult with one's fellows, lest the mind be misguided."
                },
                {
                    "id": "10020511",
                    "speaker": "Moon Carver",
                    "text": "Go. Take your Sigil of Permission, carry with you a message.",
                    "choices": [
                        {
                            "id": "10020512",
                            "text": "Who should I look for?",
                            "response": [
                                {
                                    "id": "10020513",
                                    "speaker": "Player",
                                    "text": "Where should I go?"
                                },
                                {
                                    "id": "10020514",
                                    "speaker": "Moon Carver",
                                    "text": "Mountain Shaper and Cloud Retainer can be found here. Only fate will decide if you shall find them — only fate."
                                },
                                {
                                    "id": "10020515",
                                    "speaker": "Moon Carver",
                                    "text": "There exists a Conqueror of Demons, a Guardian Yaksha. Go to Wangshu Inn. There you shall seek him."
                                }
                            ]
                        },
                        {
                            "id": "10020513",
                            "text": "Where should I go?"
                        }
                    ]
                }
            ]
        }
    ]
}