    "talks": [
        {
            "id": "4121501",
            "objective": "",
            "dialogues": [
                {
                    "id": "412100301",
                    "speaker": "Paimon",
                    "text": "Albedo!"
                },
                {
                    "id": "412100302",
                    "speaker": "Player",
                    "text": "Hey there. It's us again."
                },
                {
                    "id": "412100303",
                    "speaker": "Albedo",
                    "text": "Hmm? Why are you here?"
                },
                {
                    "id": "412100304",
                    "speaker": "Albedo",
                    "text": "Are you lost?"
                },
                {
                    "id": "412100305",
                    "speaker": "Paimon",
                    "text": "No we're not!",
                    "choices": [
                        {
                            "id": "412100306",
                            "text": "Sucrose has commissioned us to probe you for secrets.",
                            "response": [
                                {
                                    "id": "412100308",
                                    "speaker": "Albedo",
                                    "text": "A secret?"
                                },
                                {
                                    "id": "412100309",
                                    "speaker": "Paimon",
                                    "text": "Hey! What are you doing!?"
                                },
                                {
                                    "id": "412100310",
                                    "speaker": "Paimon",
                                    "text": "Our mission calls for a delicate approach!"
                                },
                                {
                                    "id": "412100311",
                                    "speaker": "Player",
                                    "text": "Well, we weren't fooling him either way."
                                },
                                {
                                    "id": "412100312",
                                    "speaker": "Paimon",
                                    "text": "Uh... Sure, but still..."
                                },
                                {
                                    "id": "412100313",
                                    "speaker": "Albedo",
                                    "text": "Actually, you've arrived at just the right moment. I have business with you too, in fact."
                                },
                                {
                                    "id": "412100314",
                                    "speaker": "Albedo",
                                    "text": "Here you go."
                                },
                                {
                                    "id": "412100315",
                                    "speaker": "Paimon",
                                    "text": "Huh? What's this?"
                                },
                                {
                                    "id": "412100316",
                                    "speaker": "Albedo",
                                    "text": "As you can see, it is a sword.",
                                    "choices": [
                                        {
                                            "id": "412100317",
                                            "text": "Into forging, are you?",
                                            "response": [
                                                {
                                                    "id": "412100319",
                                                    "speaker": "Albedo",
                                                    "text": "I did not make this sword. However, I did add some alchemical touches to it."
                                                },
                                                {
                                                    "id": "412100320",
                                                    "speaker": "Albedo",
                                                    "text": "Would you like to try it out?"
                                                },
                                                {
                                                    "id": "412100321",
                                                    "speaker": "Player",
                                                    "text": "You're giving it to me?"
                                                },
                                                {
                                                    "id": "412100322",
                                                    "speaker": "Albedo",
                                                    "text": "My research indicates that this sword has some... unique properties. Only you can use it."
                                                },
                                                {
                                                    "id": "412100323",
                                                    "speaker": "Albedo",
                                                    "text": "But I need to gather data from it quite urgently — so, could I bother you to use it in battle?"
                                                },
                                                {
                                                    "id": "412100324",
                                                    "speaker": "Paimon",
                                                    "text": "Waaait a second. How can there be a sword that only one person can use?"
                                                },
                                                {
                                                    "id": "412100325",
                                                    "speaker": "Player",
                                                    "text": "Any adverse side effects?"
                                                },
                                                {
                                                    "id": "412100326",
                                                    "speaker": "Albedo",
                                                    "text": "Very astute of you. This sword has indeed had a curse laid upon it."
                                                },
                                                {
                                                    "id": "412100327",
                                                    "speaker": "Albedo",
                                                    "text": "An ordinary person would be unable to wield it at all. However, you are an exception."
                                                },
                                                {
                                                    "id": "412100328",
                                                    "speaker": "Paimon",
                                                    "text": "Huh...?"
                                                },
                                                {
                                                    "id": "412100329",
                                                    "speaker": "Albedo",
                                                    "text": "Or perhaps I should say that only you are immune to the curse. As such, who could I find to help me, if not you?"
                                                },
                                                {
                                                    "id": "412100330",
                                                    "speaker": "Albedo",
                                                    "text": "We gain little from saying more. Go find some monsters nearby — after all, some things are best discovered through practice."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "412100318",
                                            "text": "Is smithing part of an alchemist's qualifications, too?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "412100307",
                            "text": "Sucrose says that you conceal some unspeakable secret."
                        }
                    ]
                }
            ]
        }
    ]
}