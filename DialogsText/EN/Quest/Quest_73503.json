            ]
        },
        {
            "id": "7350302",
            "objective": "Set up the riddles with Drusus",
            "dialogues": [
                {
                    "id": "735030201",
                    "speaker": "Drusus",
                    "text": "Okay! Let's set up the second riddle here. Once this riddle is solved, the final chest can be found."
                },
                {
                    "id": "735030202",
                    "speaker": "Drusus",
                    "text": "I'm going to place the final treasure... there."
                },
                {
                    "id": "735030203",
                    "speaker": "Paimon",
                    "text": "Huh..."
                },
                {
                    "id": "735030204",
                    "speaker": "Player",
                    "text": "Um..."
                },
                {
                    "id": "735030205",
                    "speaker": "Paimon",
                    "text": "Isn't this just an ordinary little hill with an ordinary little waterfall next to it?"
                },
                {
                    "id": "735030206",
                    "speaker": "Drusus",
                    "text": "That's right! But it will soon be anything but ordinary because of our riddles."
                },
                {
                    "id": "735030207",
                    "speaker": "Drusus",
                    "text": "Okay, Traveler, what do you suggest for this riddle?",
                    "choices": [
                        {
                            "id": "735030208",
                            "text": "Let's make it a bit straightforward this time...",
                            "response": [
                                {
                                    "id": "735030209",
                                    "speaker": "Drusus",
                                    "text": "Eh? You think so? Hm... True, the riddle solvers would be pretty tired when they get here..."
                                },
                                {
                                    "id": "735030210",
                                    "speaker": "Drusus",
                                    "text": "Alright, straightforward it is.",
                                    "choices": [
                                        {
                                            "id": "735030219",
                                            "text": "Not exactly trained for it..."
                                        },
                                        {
                                            "id": "735030220",
                                            "text": "Well, practice makes perfect...",
                                            "response": [
                                                {
                                                    "id": "735030221",
                                                    "speaker": "Drusus",
                                                    "text": "I see. As expected of the Traveler! How knowledgeable... Okay, I will put up the riddle you wrote here."
                                                },
                                                {
                                                    "id": "735030222",
                                                    "speaker": "Black Screen",
                                                    "text": "Drusus starts putting up the riddle..."
                                                },
                                                {
                                                    "id": "735030223",
                                                    "speaker": "Drusus",
                                                    "text": "Done! This little notice board should be obvious enough."
                                                },
                                                {
                                                    "id": "735030224",
                                                    "speaker": "Drusus",
                                                    "text": "Then let's go set up the last treasure chest now."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735030211",
                            "text": "Let's use the waterfall as a theme.",
                            "response": [
                                {
                                    "id": "735030212",
                                    "speaker": "Drusus",
                                    "text": "Hmm... The waterfall is indeed a very clear theme."
                                },
                                {
                                    "id": "735030213",
                                    "speaker": "Drusus",
                                    "text": "No problem, let's use it as a theme. As for the difficulty of this last riddle... Let's tone it down a bit.",
                                    "choices": [
                                        {
                                            "id": "735030219",
                                            "text": "Not exactly trained for it..."
                                        },
                                        {
                                            "id": "735030220",
                                            "text": "Well, practice makes perfect..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735030214",
                            "text": "Hehe, let me write something.",
                            "response": [
                                {
                                    "id": "735030215",
                                    "speaker": "Paimon",
                                    "text": "Hey! You're laughing more and more!"
                                },
                                {
                                    "id": "735030216",
                                    "speaker": "Player",
                                    "text": "It's done."
                                },
                                {
                                    "id": "735030217",
                                    "speaker": "Drusus",
                                    "text": "\"The green umbrella gazes at the pearl curtain.\""
                                },
                                {
                                    "id": "735030218",
                                    "speaker": "Drusus",
                                    "text": "Hm... This riddle sounds special... Did you learn this from somewhere?",
                                    "choices": [
                                        {
                                            "id": "735030219",
                                            "text": "Not exactly trained for it..."
                                        },
                                        {
                                            "id": "735030220",
                                            "text": "Well, practice makes perfect..."
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350304",
            "objective": "Set up the treasure with Drusus",
            "dialogues": [
                {
                    "id": "735030401",
                    "speaker": "Drusus",
                    "text": "This is the last chest. There's no need for riddles for this one."
                },
                {
                    "id": "735030402",
                    "speaker": "Drusus",
                    "text": "But what should I put in it...",
                    "choices": [
                        {
                            "id": "735030403",
                            "text": "Something valuable enough.",
                            "response": [
                                {
                                    "id": "735030404",
                                    "speaker": "Drusus",
                                    "text": "That makes sense. The content of this chest should be at least worthy of the riddle solver's hard thinking along their journey."
                                },
                                {
                                    "id": "735030405",
                                    "speaker": "Drusus",
                                    "text": "Speaking of value, the most logical would be Mora, of course. Ah, I'll just put some Mora in there..."
                                },
                                {
                                    "id": "735030413",
                                    "speaker": "Drusus",
                                    "text": "Okay, this set of riddles is finished now. Thank you for your help, Traveler."
                                },
                                {
                                    "id": "735030414",
                                    "speaker": "Drusus",
                                    "text": "These are for you, as a reward."
                                },
                                {
                                    "id": "735030415",
                                    "speaker": "Drusus",
                                    "text": "*sigh* I was planning on discussing riddles with you in more depth, but I have to return to the Akademiya to tend to some matters first."
                                },
                                {
                                    "id": "735030416",
                                    "speaker": "Drusus",
                                    "text": "If you discover any strange new riddles in your travels, or get stumped by one, please come to me by all means."
                                },
                                {
                                    "id": "735030417",
                                    "speaker": "Drusus",
                                    "text": "We can discuss them in detail together, then... Put together new riddles for other adventurers! Hahaha!"
                                },
                                {
                                    "id": "735030418",
                                    "speaker": "Drusus",
                                    "text": "Farewell, Traveler. I wish you safe travels."
                                },
                                {
                                    "id": "735030419",
                                    "speaker": "Drusus",
                                    "text": "I hope that Treasure Hoarder named Narzam won't cause any serious trouble..."
                                }
                            ]
                        },
                        {
                            "id": "735030406",
                            "text": "Something of practical value.",
                            "response": [
                                {
                                    "id": "735030407",
                                    "speaker": "Drusus",
                                    "text": "Practical value? Hm... What can be of enough practical value?"
                                },
                                {
                                    "id": "735030408",
                                    "speaker": "Drusus",
                                    "text": "Oh right! I got a recipe from someone a few days ago. Let's put it in this chest as a reward."
                                }
                            ]
                        },
                        {
                            "id": "735030409",
                            "text": "This process of thought is the greatest treasure.",
                            "response": [
                                {
                                    "id": "735030410",
                                    "speaker": "Drusus",
                                    "text": "Hahahahaha! You're right! So true! The thinking process is indeed a priceless and valuable experience! Compared to it, other things are almost worthless."
                                },
                                {
                                    "id": "735030411",
                                    "speaker": "Paimon",
                                    "text": "That's simply not true! Put some Mora in it, or a recipe! Some vegetables or fruits at the very least, don't put nothing!"
                                },
                                {
                                    "id": "735030412",
                                    "speaker": "Drusus",
                                    "text": "I'm kidding, I'm kidding. I'll definitely put something in as a reward."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
