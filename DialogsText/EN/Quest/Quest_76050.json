                            "text": "It's... a Long-Necked Rhino.",
                            "response": [
                                {
                                    "id": "760500311",
                                    "speaker": "Paimon",
                                    "text": "Yikes! A Long-Necked Rhino with a serious neck injury, maybe!"
                                },
                                {
                                    "id": "760500312",
                                    "speaker": "The Damselette",
                                    "text": "Hmm... I've never seen such a creature before."
                                },
                                {
                                    "id": "760500313",
                                    "speaker": "The Damselette",
                                    "text": "The correct answer was \"Rimehorn Deer.\""
                                },
                                {
                                    "id": "760500314",
                                    "speaker": "The Damselette",
                                    "text": "Come back now, little ones."
                                }
