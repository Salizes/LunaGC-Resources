    "talks": [
        {
            "id": "7605001",
            "objective": "Meet The Damselette",
            "dialogues": [
                {
                    "id": "760500101",
                    "speaker": "Kuuhenki",
                    "text": "~!"
                },
                {
                    "id": "760500102",
                    "speaker": "Kuuhenki",
                    "text": "!!!"
                },
                {
                    "id": "760500103",
                    "speaker": "Paimon",
                    "text": "Wow, it's so lively here today! All those kuuhenki are dancing around Columbina!"
                },
                {
                    "id": "760500104",
                    "speaker": "Paimon",
                    "text": "Uh, wait a sec... That's not dancing. Looks more like they're trying to... bury her alive in a pile of cuteness!"
                },
                {
                    "id": "760500105",
                    "speaker": "The Damselette",
                    "text": "H—Help me..."
                },
                {
                    "id": "760500106",
                    "speaker": "Player",
                    "text": "Give me your hand."
                },
                {
                    "id": "760500107",
                    "speaker": "The Damselette",
                    "text": "Phew... Thank you..."
                },
                {
                    "id": "760500108",
                    "speaker": "Paimon",
                    "text": "Why were the kuuhenki acting like that just now...? They're not usually that energetic, are they?"
                },
                {
                    "id": "760500109",
                    "speaker": "Kuuhenki",
                    "text": "~!"
                },
                {
                    "id": "760500110",
                    "speaker": "The Damselette",
                    "text": "Well..."
                },
                {
                    "id": "760500111",
                    "speaker": "The Damselette",
                    "text": "I decided to play a game with the little ones, and it seems they became quite invested..."
                },
                {
                    "id": "760500112",
                    "speaker": "Paimon",
                    "text": "Crowding around you like that after playtime... Kinda like puppies, aren't they?"
                },
                {
                    "id": "760500113",
                    "speaker": "Player",
                    "text": "Maybe that's their way of showing gratitude."
                },
                {
                    "id": "760500114",
                    "speaker": "The Damselette",
                    "text": "Mm... Only this time, their gratitude felt more like getting caught in an unexpected snow drift..."
                },
                {
                    "id": "760500115",
                    "speaker": "Paimon",
                    "text": "You say that, but Paimon bets you never pass up a chance to spoil them!"
                },
                {
                    "id": "760500116",
                    "speaker": "The Damselette",
                    "text": "In any case, would the two of you like to give it a try?",
                    "choices": [
                        {
                            "id": "760500117",
                            "text": "You mean... being surrounded like that?",
                            "response": [
                                {
                                    "id": "760500118",
                                    "speaker": "The Damselette",
                                    "text": "Hm... That can be arranged. You just need to get the right answer."
                                },
                                {
                                    "id": "760500121",
                                    "speaker": "Paimon",
                                    "text": "Oh, sure thing. It'll be cool to see what sort of game's got the kuuhenki so obsessed."
                                },
                                {
                                    "id": "760500122",
                                    "speaker": "The Damselette",
                                    "text": "Go on now."
                                },
                                {
                                    "id": "760500123",
                                    "speaker": "Kuuhenki",
                                    "text": "~!"
                                },
                                {
                                    "id": "760500124",
                                    "speaker": "Kuuhenki",
                                    "text": "!!!"
                                }
                            ]
                        },
                        {
                            "id": "760500119",
                            "text": "You mean... playing a game with the kuuhenki?",
                            "response": [
                                {
                                    "id": "760500120",
                                    "speaker": "The Damselette",
                                    "text": "Yes."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7605003",
            "objective": "Play with the kuuhenki",
            "dialogues": [
                {
                    "id": "760500901",
                    "speaker": "Kuuhenki",
                    "text": "~!"
                },
                {
                    "id": "760500902",
                    "speaker": "Kuuhenki",
                    "text": "!!!"
                },
                {
                    "id": "760500903",
                    "speaker": "Paimon",
                    "text": "Hehe, guess this means we did good?"
                },
                {
                    "id": "760500904",
                    "speaker": "Player",
                    "text": "They really are so soft and squishy."
                },
                {
                    "id": "760500905",
                    "speaker": "Paimon",
                    "text": "Wait, we get a reward even though we got it wrong? Huh, well... Paimon doesn't mind a consolation prize."
                },
                {
                    "id": "760500906",
                    "speaker": "Player",
                    "text": "Who's a good little kuuhenki..."
                },
                {
                    "id": "760500907",
                    "speaker": "The Damselette",
                    "text": "The kuuhenki have taken a liking to you."
                },
                {
                    "id": "760500908",
                    "speaker": "The Damselette",
                    "text": "I can feel it... They are at ease in your presence."
                },
                {
                    "id": "760500909",
                    "speaker": "The Damselette",
                    "text": "Just as Rimehorn Deer fawns are given to bathing in the moonlight, so too are the kuuhenki drawn to that which radiates from your heart."
                },
                {
                    "id": "760500910",
                    "speaker": "Paimon",
                    "text": "Oh? And what would that be, exactly?"
                },
                {
                    "id": "760500911",
                    "speaker": "The Damselette",
                    "text": "A certain kindness and gentleness, I suppose."
                }
            ]
        },
        {
            "id": "7605002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760500201",
                    "speaker": "The Damselette",
                    "text": "If you'd like, you're more than welcome to play with the kuuhenki again sometime."
                }
            ]
        },
        {
            "id": "7605003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760500301",
                    "speaker": "The Damselette",
                    "text": "All you need to do is guess the image."
