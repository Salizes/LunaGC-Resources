{
    "quest": {
        "id": "76123",
        "title": "A Gift From Her",
        "description": "Columbina seems to have something she wants to do in the Silvermoon Hall...",
        "rewards": [
            {
                "itemId": 108950,
                "count": 1
            }
        ],
        "rewards_formatted": "Moonlit Mirage x1",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 90,
        "total_speaker_counts": {
            "Black Screen": 2,
            "Columbina": 36,
            "Kuuhenki": 1,
            "Longplume Ibis": 1,
            "Luonnotar": 1,
            "Paimon": 21,
            "Player": 28
        }
    },
    "talks": [
        {
            "id": "7612301",
            "objective": "Meet Columbina",
            "dialogues": [
                {
                    "id": "761230101",
                    "speaker": "Paimon",
                    "text": "That smells great! Did we make it in time for Columbina's mealtime again?"
                },
                {
                    "id": "761230102",
                    "speaker": "Paimon",
                    "text": "Huh. Are those kuuhenki... lining up? For soup that Columbina's serving?"
                },
                {
                    "id": "761230103",
                    "speaker": "Columbina",
                    "text": "Just a moment."
                },
                {
                    "id": "761230104",
                    "speaker": "Kuuhenki",
                    "text": "~!"
                },
                {
                    "id": "761230105",
                    "speaker": "Paimon",
                    "text": "Wow, this is really good!"
                },
                {
                    "id": "761230106",
                    "speaker": "Paimon",
                    "text": "Refreshing, tasty fruit soup — Paimon's never had anything quite like it!"
                },
                {
                    "id": "761230107",
                    "speaker": "Columbina",
                    "text": "Another serving?"
                },
                {
                    "id": "761230108",
                    "speaker": "Paimon",
                    "text": "Make that two!"
                },
                {
                    "id": "761230109",
                    "speaker": "Luonnotar",
                    "text": "...!"
                },
                {
                    "id": "761230110",
                    "speaker": "Player",
                    "text": "Are you learning to cook?"
                },
                {
                    "id": "761230111",
                    "speaker": "Columbina",
                    "text": "Yes. I asked Ineffa for some basic recipes, and have made several attempts. The kuuhenki and animals have both responded quite positively."
                },
                {
                    "id": "761230112",
                    "speaker": "Player",
                    "text": "Having any issues in the kitchen?"
                },
                {
                    "id": "761230113",
                    "speaker": "Columbina",
                    "text": "Well... My sleeves are too wide. They brush against the pot if I'm not careful..."
                },
                {
                    "id": "761230114",
                    "speaker": "Player",
                    "text": "(So, it's not the cooking itself that's giving you trouble.)"
                },
                {
                    "id": "761230115",
                    "speaker": "Columbina",
                    "text": "I struggle somewhat with making desserts, though."
                },
                {
                    "id": "761230116",
                    "speaker": "Columbina",
                    "text": "You have to get the temperature and proportions just right..."
                },
                {
                    "id": "761230117",
                    "speaker": "Player",
                    "text": "(She must not have cooked much for herself in the past, then.)"
                },
                {
                    "id": "761230118",
                    "speaker": "Player",
                    "text": "(Besides, desserts and snacks are particularly hard to get right if you're working solo...)"
                },
                {
                    "id": "761230119",
                    "speaker": "Player",
                    "text": "Would you like me to help?"
                },
                {
                    "id": "761230120",
                    "speaker": "Columbina",
                    "text": "Sure. Let's start with krumkake, shall we?"
                },
                {
                    "id": "761230121",
                    "speaker": "Black Screen",
                    "text": "Some time later..."
                },
                {
                    "id": "761230122",
                    "speaker": "Columbina",
                    "text": "Would you like to try one?",
                    "choices": [
                        {
                            "id": "761230123",
                            "text": "(Take a nibble.)",
                            "response": [
                                {
                                    "id": "761230125",
                                    "speaker": "Columbina",
                                    "text": "..."
                                },
                                {
                                    "id": "761230126",
                                    "speaker": "Player",
                                    "text": "(Oh wow, that first bite probably soured my face into a prune...)"
                                },
                                {
                                    "id": "761230127",
                                    "speaker": "Player",
                                    "text": "(But after you swallow some, the sweetness resurfaces... Maybe it gets better once you get used to it...)"
                                },
                                {
                                    "id": "761230128",
                                    "speaker": "Columbina",
                                    "text": "What do you think?",
                                    "choices": [
                                        {
                                            "id": "761230129",
                                            "text": "Passable...",
                                            "response": [
                                                {
                                                    "id": "761230131",
                                                    "speaker": "Paimon",
                                                    "text": "Did Paimon miss anything?"
                                                },
                                                {
                                                    "id": "761230132",
                                                    "speaker": "Player",
                                                    "text": "Try this real quick, would you?"
                                                },
                                                {
                                                    "id": "761230133",
                                                    "speaker": "Paimon",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "761230134",
                                                    "speaker": "Paimon",
                                                    "text": "Gaaaah, it's so sour! Wh—What are you trying to do to Paimon!?"
                                                },
                                                {
                                                    "id": "761230135",
                                                    "speaker": "Columbina",
                                                    "text": "Haha..."
                                                },
                                                {
                                                    "id": "761230136",
                                                    "speaker": "Player",
                                                    "text": "The aftertaste is pretty good, though."
                                                },
                                                {
                                                    "id": "761230137",
                                                    "speaker": "Paimon",
                                                    "text": "It's all about the initial taste! Couldn't one of you have warned me to take a smaller bite!?"
                                                },
                                                {
                                                    "id": "761230138",
                                                    "speaker": "Paimon",
                                                    "text": "If you hadn't said anything, Paimon would've thought this was a prank! Watching people's faces pucker or something..."
                                                },
                                                {
                                                    "id": "761230139",
                                                    "speaker": "Columbina",
                                                    "text": "Okay. Let me try again."
                                                },
                                                {
                                                    "id": "761230140",
                                                    "speaker": "Black Screen",
                                                    "text": "More time passes..."
                                                },
                                                {
                                                    "id": "761230141",
                                                    "speaker": "Columbina",
                                                    "text": "Here. Try this batch."
                                                },
                                                {
                                                    "id": "761230142",
                                                    "speaker": "Player",
                                                    "text": "(Whoa...! This is way better!)",
                                                    "choices": [
                                                        {
                                                            "id": "761230143",
                                                            "text": "It's delicious!",
                                                            "response": [
                                                                {
                                                                    "id": "761230145",
                                                                    "speaker": "Paimon",
                                                                    "text": "Really? Paimon wants some too! ...Mmm! That's the stuff! Sooo tasty!"
                                                                },
                                                                {
                                                                    "id": "761230146",
                                                                    "speaker": "Columbina",
                                                                    "text": "Good enough to be given as a gift?"
                                                                },
                                                                {
                                                                    "id": "761230147",
                                                                    "speaker": "Paimon",
                                                                    "text": "Totally! Wait, did you learn how to cook and make krumkake because you wanted to make a present for someone?"
                                                                },
                                                                {
                                                                    "id": "761230148",
                                                                    "speaker": "Columbina",
                                                                    "text": "Yes... For my friends."
                                                                },
                                                                {
                                                                    "id": "761230149",
                                                                    "speaker": "Player",
                                                                    "text": "That's a great idea."
                                                                },
                                                                {
                                                                    "id": "761230150",
                                                                    "speaker": "Columbina",
                                                                    "text": "Do you still remember the first time you came here together? You had prepared some food for me."
                                                                },
                                                                {
                                                                    "id": "761230151",
                                                                    "speaker": "Columbina",
                                                                    "text": "Though the food couldn't do much to replenish the power I had lost, eating it did make me feel more relaxed."
                                                                },
                                                                {
                                                                    "id": "761230152",
                                                                    "speaker": "Columbina",
                                                                    "text": "I did not give it much thought then, but now I understand."
                                                                },
                                                                {
                                                                    "id": "761230153",
                                                                    "speaker": "Columbina",
                                                                    "text": "The time and effort put into carefully preparing food by hand is what gives it soul."
                                                                },
                                                                {
                                                                    "id": "761230154",
                                                                    "speaker": "Columbina",
                                                                    "text": "What I enjoyed was not simply the food itself, but the warmth and kindness in the hands that made it."
                                                                },
                                                                {
                                                                    "id": "761230155",
                                                                    "speaker": "Columbina",
                                                                    "text": "And the less those hands seek reciprocity, the greater the warmth and kindness required to match it in turn."
                                                                },
                                                                {
                                                                    "id": "761230156",
                                                                    "speaker": "Paimon",
                                                                    "text": "Awww, Paimon's gonna blush if you go on like that... To be honest, we were at least kinda hoping to get on your good side back there.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "761230157",
                                                                            "text": "But things are different now.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "761230159",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Indeed. But now that I understand all this, I'd like to do a little more... It's a wonderful feeling."
                                                                                },
                                                                                {
                                                                                    "id": "761230160",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Would you come with me to visit our friends?"
                                                                                },
                                                                                {
                                                                                    "id": "761230161",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Apart from the krumkake, I have also prepared a few other gifts. Ah, but they must be sent in secret."
                                                                                },
                                                                                {
                                                                                    "id": "761230162",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Why \"in secret,\" if you don't mind Paimon asking?"
                                                                                },
                                                                                {
                                                                                    "id": "761230163",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Well, you've always been the ones to \"pleasantly surprise\" me. I'd like to see how my friends will react when the tables are turned."
                                                                                },
                                                                                {
                                                                                    "id": "761230164",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Phew. We were running all over! Finally done."
                                                                                },
                                                                                {
                                                                                    "id": "761230165",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Their reactions were kind of surprising, though. Some didn't even realize they were gifts from you, Columbina..."
                                                                                },
                                                                                {
                                                                                    "id": "761230166",
                                                                                    "speaker": "Player",
                                                                                    "text": "Aino just got straight to snacking..."
                                                                                },
                                                                                {
                                                                                    "id": "761230167",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "It's fine. I expected as much. What's important is that they were happy to receive the gifts."
                                                                                },
                                                                                {
                                                                                    "id": "761230168",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "In that case, Lauma definitely knew the krumkakes and wreath on her desk came from you."
                                                                                },
                                                                                {
                                                                                    "id": "761230169",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Paimon can understand her being hesitant about wearing the wreath, but seriously, she stared at the krumkakes for a good ten minutes and still couldn't bring herself to eat one..."
                                                                                },
                                                                                {
                                                                                    "id": "761230170",
                                                                                    "speaker": "Player",
                                                                                    "text": "I was getting worried that she might enshrine them..."
                                                                                },
                                                                                {
                                                                                    "id": "761230171",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "It seems Jahoda got quite the fright, though... Perhaps we shouldn't have slipped the gifts directly behind her..."
                                                                                },
                                                                                {
                                                                                    "id": "761230172",
                                                                                    "speaker": "Player",
                                                                                    "text": "She almost jumped out of her skin."
                                                                                },
                                                                                {
                                                                                    "id": "761230173",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Maybe she's just naturally more alert? Still, she seemed to calm down when Ashru came over to paw at the scratching post you sent."
                                                                                },
                                                                                {
                                                                                    "id": "761230174",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "As for our other friends who aren't in Nod-Krai, I'm counting on you to deliver their gifts."
                                                                                },
                                                                                {
                                                                                    "id": "761230175",
                                                                                    "speaker": "Longplume Ibis",
                                                                                    "text": "!!!"
                                                                                },
                                                                                {
                                                                                    "id": "761230176",
                                                                                    "speaker": "Player",
                                                                                    "text": "I must say, you're quite good at preparing presents."
                                                                                },
                                                                                {
                                                                                    "id": "761230177",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Here."
                                                                                },
                                                                                {
                                                                                    "id": "761230178",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Ooh! Is it finally our turn?"
                                                                                },
                                                                                {
                                                                                    "id": "761230179",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Huh? Candies? Paimon thought we'd get krumkakes like everyone else."
                                                                                },
                                                                                {
                                                                                    "id": "761230180",
                                                                                    "speaker": "Columbina",
                                                                                    "text": "Well, you already had some of those while taste-testing. Some variety is nice, don't you think?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "761230181",
                                                                                            "text": "Yeah... They're really good, too.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "761230183",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "That's good to hear."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230184",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "And there's one more gift. Here, for you."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230185",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "This is... a wind glider?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230186",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "I've heard it said that the skies belong to the birds, and the land, to the beasts..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230187",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "While the vast space between the two is reserved for adventurers wearing wing gliders."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230188",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "With this by your side, may your path forward ever be lit as with moonlight."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230189",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "It's perfect. Thank you."
                                                                                                },
                                                                                                {
                                                                                                    "id": "761230190",
                                                                                                    "speaker": "Columbina",
                                                                                                    "text": "And thank you, for your companionship."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "761230182",
                                                                                            "text": "Better than the Moon-Prayer Night candies, even."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "761230158",
                                                                            "text": "If there's anything you'd like to eat, just say the word."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "761230144",
                                                            "text": "You sure learn fast!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761230130",
                                            "text": "But there's room for improvement..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "761230124",
                            "text": "(Chow down.)"
                        }
                    ]
                }
            ]
        }
    ]
}