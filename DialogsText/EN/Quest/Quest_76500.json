    "talks": [
        {
            "id": "7650001",
            "objective": "Go to Nasha Town",
            "dialogues": [
                {
                    "id": "765000101",
                    "speaker": "Paimon",
                    "text": "#{NICKNAME}! Over here! Paimon's got something awesome to show you!"
                },
                {
                    "id": "765000102",
                    "speaker": "Paimon",
                    "text": "Ta-da! Look at this! It took Paimon forever to dig up this treasure from that bustling market!",
                    "choices": [
                        {
                            "id": "765000103",
                            "text": "I say, this is... an elder statesman amongst Kameras.",
                            "response": [
                                {
                                    "id": "765000106",
                                    "speaker": "Paimon",
                                    "text": "According to the mysterious shopkeeper, this was the Kamera used by that super famous Fontainian photographer from a few decades ago: the legendary Pierre Leblanc!"
                                },
                                {
                                    "id": "765000107",
                                    "speaker": "Paimon",
                                    "text": "Rumor has it that the photos he took with this Kamera were all smash hits, and they'd often make it onto the front page of The Steambird!"
                                },
                                {
                                    "id": "765000108",
                                    "speaker": "Paimon",
                                    "text": "If you use this legendary Kamera, your photos will be like... doubly legendary! And then we can sell them for Mora!",
                                    "choices": [
                                        {
                                            "id": "765000109",
                                            "text": "This Kamera... was expensive, wasn't it?",
                                            "response": [
                                                {
                                                    "id": "765000110",
                                                    "speaker": "Paimon",
                                                    "text": "It was okay! After all, Paimon's got her emergency funds to fall back on!"
                                                },
                                                {
                                                    "id": "765000111",
                                                    "speaker": "Paimon",
                                                    "text": "As long as you like it, Paimon's willing to empty her pockets!",
                                                    "choices": [
                                                        {
                                                            "id": "765000116",
                                                            "text": "Wow. In that case, thank you, Paimon. It's a wonderful gift.",
                                                            "response": [
                                                                {
                                                                    "id": "765000118",
                                                                    "speaker": "Paimon",
                                                                    "text": "Yay! Paimon's happy if you're happy! Now that we've arrived in a new nation, let's put this Kamera to good use and take pictures of all the new things we see!"
                                                                },
                                                                {
                                                                    "id": "765000119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Paimon's also prepared a new photo album for you, just for the occasion. Paimon's reliable AND thoughtful, you see!"
                                                                },
                                                                {
                                                                    "id": "765000120",
                                                                    "speaker": "Paimon",
                                                                    "text": "Okie dokie, enough chitchat! Those photos aren't going to take themselves. Let's go!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765000117",
                                                            "text": "I'll make sure to take many legendary photos with it."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765000112",
                                            "text": "You didn't run into any shady merchants, did you, Paimon?",
                                            "response": [
                                                {
                                                    "id": "765000113",
                                                    "speaker": "Paimon",
                                                    "text": "Relax! To be absolutely sure, Paimon already had a very reliable engineer verify it — this is definitely the exact model the great master Leblanc used back in the day, no doubt about it!"
                                                },
                                                {
                                                    "id": "765000114",
                                                    "speaker": "Paimon",
                                                    "text": "But wait, there's more! When the engineer opened it up, they found a tiny engraving inside with Leblanc's initials! That's hard evidence right there, hehe!"
                                                },
                                                {
                                                    "id": "765000115",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon's such a reliable guide, isn't she? Come rain or shine, she won't let you down!",
                                                    "choices": [
                                                        {
                                                            "id": "765000116",
                                                            "text": "Wow. In that case, thank you, Paimon. It's a wonderful gift."
                                                        },
                                                        {
                                                            "id": "765000117",
                                                            "text": "I'll make sure to take many legendary photos with it."
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765000104",
                            "text": "Are you getting into antiques, Paimon?",
                            "response": [
                                {
                                    "id": "765000105",
                                    "speaker": "Paimon",
                                    "text": "No, silly! This is a surprise gift Paimon prepared just for you!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}