            "dialogues": [
                {
                    "id": "719510101",
                    "speaker": "Player",
                    "text": "I really respect Lady Ningguang."
                },
                {
                    "id": "719510102",
                    "speaker": "Baiwen",
                    "text": "Many people do, including myself."
                },
                {
                    "id": "719510103",
                    "speaker": "Baiwen",
                    "text": "The Tianquan's words can move mountains, and everyone knows it. My task is to help oversee Lady Ningguang's intelligence network."
                },
                {
                    "id": "719510104",
                    "speaker": "Baiwen",
                    "text": "Lady Ningguang's razor-sharp mind tears through vast amounts of information at pace, and quickly reaches a verdict. These pearls of wisdom are then discarded from the Jade Chamber, giving guidance on \"prosperity\" to the world below..."
                },
                {
                    "id": "719510105",
                    "speaker": "Baiwen",
                    "text": "Do you, too, wish to learn of such things?"
                }
            ]
        }
