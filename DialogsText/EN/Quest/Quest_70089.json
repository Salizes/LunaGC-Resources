            "dialogues": [
                {
                    "id": "700890101",
                    "speaker": "Paimon",
                    "text": "Huh, there's someone here!"
                },
                {
                    "id": "700890102",
                    "speaker": "???",
                    "text": "Not this one either..."
                },
                {
                    "id": "700890103",
                    "speaker": "Paimon",
                    "text": "Hey, what are you doing?"
                },
                {
                    "id": "700890104",
                    "speaker": "???",
                    "text": "I'm trying to find my way back. I only remember that I need to find an Anemo Archon Statue."
                },
                {
                    "id": "700890105",
                    "speaker": "???",
                    "text": "I don't remember anything else."
                },
                {
                    "id": "700890106",
                    "speaker": "Paimon",
                    "text": "Your way back?"
                },
                {
                    "id": "700890107",
                    "speaker": "???",
                    "text": "It's a vague sense of homesickness, but I can't remember anything at all."
                },
                {
                    "id": "700890108",
                    "speaker": "???",
                    "text": "When I woke up, the only thing I had was a note in my hand that said, \"You are 'Maukie.'\""
                },
                {
                    "id": "700890109",
                    "speaker": "\"Maukie\"",
                    "text": "So I suppose my name is Maukie."
                },
                {
                    "id": "700890110",
                    "speaker": "\"Maukie\"",
                    "text": "I should be going now. Goodbye."
                },
                {
                    "id": "700890111",
                    "speaker": "Paimon",
                    "text": "What a strange person. But he doesn't seem like a bad guy."
                },
                {
                    "id": "700890112",
                    "speaker": "Paimon",
                    "text": "Are you alright?"
                },
                {
                    "id": "700890113",
                    "speaker": "Player",
                    "text": "I had a strange vision."
                },
                {
                    "id": "700890114",
                    "speaker": "Paimon",
                    "text": "A strange vision? Could it be because that person touched the statue just now?"
                }
            ]
        }
    ]
