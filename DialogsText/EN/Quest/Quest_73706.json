    "talks": [
        {
            "id": "7370601",
            "objective": "Talk to Collei",
            "dialogues": [
                {
                    "id": "737060101",
                    "speaker": "Collei",
                    "text": "Good news, everyone!"
                },
                {
                    "id": "737060102",
                    "speaker": "Collei",
                    "text": "The Fieldwise center is getting a lot of praise from important scholars all throughout the Akademiya..."
                },
                {
                    "id": "737060103",
                    "speaker": "Collei",
                    "text": "Soon, they'll send a team of specialists to take over the management of this place based on our recommendations!"
                },
                {
                    "id": "737060104",
                    "speaker": "Collei",
                    "text": "So, thank you for all the support!"
                },
                {
                    "id": "737060105",
                    "speaker": "Amber",
                    "text": "Wow, sounds like your hard work paid off, Collei!"
                },
                {
                    "id": "737060106",
                    "speaker": "Faruzan",
                    "text": "And you're overseeing the transition yourself... Well done."
                },
                {
                    "id": "737060107",
                    "speaker": "Faruzan",
                    "text": "The young students today could learn a thing or two from you, Collei. Your confidence, your proactiveness, your leadership... It's admirable."
                },
                {
                    "id": "737060108",
                    "speaker": "Faruzan",
                    "text": "Not like some of the ones I teach, so focused on theses and research, with no practical skills to speak of."
                },
                {
                    "id": "737060109",
                    "speaker": "Collei",
                    "text": "T—To be honest, I don't feel all that confident. Being the go-between for all the different Darshans, coordinating everything... I still can't quite believe I managed it."
                },
                {
                    "id": "737060110",
                    "speaker": "Collei",
                    "text": "#Oh, but {NICKNAME} and Paimon played a huge role in that too. I can't thank you both enough...",
                    "choices": [
                        {
                            "id": "737060111",
                            "text": "It was nothing!",
                            "response": [
                                {
                                    "id": "737060113",
                                    "speaker": "Paimon",
                                    "text": "Yeah, we're used to this kinda work. So, for us, this was more like... a super special camping trip with friends!"
                                },
                                {
                                    "id": "737060114",
                                    "speaker": "Paimon",
                                    "text": "Y'know, a few puzzles here, a little exercise there... It was super fun! Pretty much a piece of cake!"
                                },
                                {
                                    "id": "737060115",
                                    "speaker": "Paimon",
                                    "text": "Aw, man... Now Paimon's hungry..."
                                },
                                {
                                    "id": "737060116",
                                    "speaker": "Paimon",
                                    "text": "Hey, now that we're all done, why don't we go get some food to celebrate?"
                                },
                                {
                                    "id": "737060117",
                                    "speaker": "Dehya",
                                    "text": "Hah, Candace and I are two steps ahead of you!"
                                },
                                {
                                    "id": "737060118",
                                    "speaker": "Candace",
                                    "text": "This way, everyone."
                                },
                                {
                                    "id": "737060119",
                                    "speaker": "Paimon",
                                    "text": "Woohoo! A feast!"
                                },
                                {
                                    "id": "737060120",
                                    "speaker": "Amber",
                                    "text": "Mm! Perfect timing!"
                                },
                                {
                                    "id": "737060121",
                                    "speaker": "Paimon",
                                    "text": "Aww, it's been a while since we've had such a delicious spread of dishes from Sumeru... Paimon feels like she could eat twice as much... No, three times as much as normal!",
                                    "choices": [
                                        {
                                            "id": "737060122",
                                            "text": "We should come around more often then.",
                                            "response": [
                                                {
                                                    "id": "737060124",
                                                    "speaker": "Paimon",
                                                    "text": "Hah, is that a challenge?"
                                                },
                                                {
                                                    "id": "737060125",
                                                    "speaker": "Paimon",
                                                    "text": "Careful what you wish for. We have your wallet to think about."
                                                },
                                                {
                                                    "id": "737060126",
                                                    "speaker": "Faruzan",
                                                    "text": "Mmm! It's been a while since I've had food from the desert region..."
                                                },
                                                {
                                                    "id": "737060127",
                                                    "speaker": "Faruzan",
                                                    "text": "It's nothing like I remember..."
                                                },
                                                {
                                                    "id": "737060128",
                                                    "speaker": "Faruzan",
                                                    "text": "Now, this is the real deal. Everything I've tried before pales in comparison."
                                                },
                                                {
                                                    "id": "737060129",
                                                    "speaker": "Candace",
                                                    "text": "That means a lot, Madam Faruzan."
                                                },
                                                {
                                                    "id": "737060130",
                                                    "speaker": "Candace",
                                                    "text": "If all the researchers who came to our village were so polite, we would have an occasion to offer feasts like this more often."
                                                },
                                                {
                                                    "id": "737060131",
                                                    "speaker": "Dehya",
                                                    "text": "By the way... You planning on doing any sight-seeing, Miss Amber? You came all this way, after all."
                                                },
                                                {
                                                    "id": "737060132",
                                                    "speaker": "Amber",
                                                    "text": "Oh, for sure!"
                                                },
                                                {
                                                    "id": "737060133",
                                                    "speaker": "Amber",
                                                    "text": "I hear that there's a forest full of gigantic trees northwest of Port Ormos, with trunks bigger than the entire width of the Good Hunter restaurant..."
                                                },
                                                {
                                                    "id": "737060134",
                                                    "speaker": "Amber",
                                                    "text": "I'd love to see it for myself."
                                                },
                                                {
                                                    "id": "737060135",
                                                    "speaker": "Amber",
                                                    "text": "Ooh, and I bet I could climb up and then glide down from the tree tops! That sounds so fun!"
                                                },
                                                {
                                                    "id": "737060136",
                                                    "speaker": "Collei",
                                                    "text": "In that case, I'll give you some snacks to take with you... like a dense cake or some dumplings."
                                                },
                                                {
                                                    "id": "737060137",
                                                    "speaker": "Collei",
                                                    "text": "The wind's strong up there, so you don't want anything too crumbly. Oh, and you'll need a thicker water skin, so it doesn't break if it drops..."
                                                },
                                                {
                                                    "id": "737060138",
                                                    "speaker": "Paimon",
                                                    "text": "Ooh, dumplings sound great... so soft and chewy. Great thinking, Collei!"
                                                },
                                                {
                                                    "id": "737060139",
                                                    "speaker": "Amber",
                                                    "text": "As for the desert, I'd love to check out some of the ruins, like that giant one shaped like an hourglass!"
                                                },
                                                {
                                                    "id": "737060140",
                                                    "speaker": "Amber",
                                                    "text": "I'll just observe from a distance, though. Your ruins could be protected sites, so... better to not barge in."
                                                },
                                                {
                                                    "id": "737060141",
                                                    "speaker": "Amber",
                                                    "text": "Besides, there could be someone sleeping in there, haha."
                                                },
                                                {
                                                    "id": "737060142",
                                                    "speaker": "Candace",
                                                    "text": "I'm glad to hear that, Miss Amber. It's for the best..."
                                                },
                                                {
                                                    "id": "737060143",
                                                    "speaker": "Collei",
                                                    "text": "Hm, your body won't be used to the desert environment, though, so traveling could be tough."
                                                },
                                                {
                                                    "id": "737060144",
                                                    "speaker": "Collei",
                                                    "text": "You'll need to bring moisturizing ointment, and essential oils for the skin...",
                                                    "choices": [
                                                        {
                                                            "id": "737060145",
                                                            "text": "So, we're even thinking about skin care...",
                                                            "response": [
                                                                {
                                                                    "id": "737060147",
                                                                    "speaker": "Amber",
                                                                    "text": "Honestly, though, helping set up the Fieldwise Center was the real highlight of this trip."
                                                                },
                                                                {
                                                                    "id": "737060148",
                                                                    "speaker": "Amber",
                                                                    "text": "And thanks to you, Collei, I got to make some new friends, too! So, I couldn't be happier!"
                                                                },
                                                                {
                                                                    "id": "737060149",
                                                                    "speaker": "Amber",
                                                                    "text": "Feel free to drop in on me in Mondstadt any time! I'll show you the best our city has to offer!"
                                                                },
                                                                {
                                                                    "id": "737060150",
                                                                    "speaker": "Dehya",
                                                                    "text": "Don't mind if I do!"
                                                                },
                                                                {
                                                                    "id": "737060151",
                                                                    "speaker": "Dehya",
                                                                    "text": "I had some Dandelion Wine while I was in Fontaine, and man... that was the stuff. So sweet and fragrant... Not a single bitter note in there at all!"
                                                                },
                                                                {
                                                                    "id": "737060152",
                                                                    "speaker": "Dehya",
                                                                    "text": "And that was the imported stuff! I bet the taste is even better when it's fresh!"
                                                                },
                                                                {
                                                                    "id": "737060153",
                                                                    "speaker": "Dehya",
                                                                    "text": "I'm looking forward to downing a couple of barrels already!"
                                                                },
                                                                {
                                                                    "id": "737060154",
                                                                    "speaker": "Candace",
                                                                    "text": "Ahem... It couldn't hurt to take a break from wine, either. Those children gave you some Henna Berry thorn powder, remember? You could make some tea..."
                                                                },
                                                                {
                                                                    "id": "737060155",
                                                                    "speaker": "Dehya",
                                                                    "text": "Aha... Ahaha... C—Come on, Candace, it's just a taste. The barrels aren't even that big... We're talking, like, three to five cups per, tops."
                                                                },
                                                                {
                                                                    "id": "737060156",
                                                                    "speaker": "Dehya",
                                                                    "text": "And, don't worry, I'd make sure to bring back souvenirs for everyone!"
                                                                },
                                                                {
                                                                    "id": "737060157",
                                                                    "speaker": "Faruzan",
                                                                    "text": "Well, I've heard the Knights of Favonius Library has quite the collection."
                                                                },
                                                                {
                                                                    "id": "737060158",
                                                                    "speaker": "Faruzan",
                                                                    "text": "I wonder if there are tomes that approach engineering from a different angle — could be worth perusing..."
                                                                },
                                                                {
                                                                    "id": "737060159",
                                                                    "speaker": "Amber",
                                                                    "text": "I'm not sure about the exact number, but the library's pretty huge, alright."
                                                                },
                                                                {
                                                                    "id": "737060160",
                                                                    "speaker": "Amber",
                                                                    "text": "What kind of books are you interested in, Madam Faruzan? I can write them down and have Lisa get them ready for you."
                                                                },
                                                                {
                                                                    "id": "737060161",
                                                                    "speaker": "Amber",
                                                                    "text": "Either way, just leave your Mondstadt travel plans to me!"
                                                                },
                                                                {
                                                                    "id": "737060162",
                                                                    "speaker": "Faruzan",
                                                                    "text": "Lisa... Lisa Minci? Cyrus's prized student, who he never stops bragging about...? So, that's where she's hiding!"
                                                                },
                                                                {
                                                                    "id": "737060163",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ahhh, this is kinda nice, isn't it?"
                                                                },
                                                                {
                                                                    "id": "737060164",
                                                                    "speaker": "Paimon",
                                                                    "text": "Friends of ours meeting other friends of ours, then becoming friends in their own right...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737060165",
                                                                            "text": "The world doesn't stand still, after all.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737060167",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yeah! Maybe we should start introducing our friends to each other! Paimon can think of a few who might get along..."
                                                                                },
                                                                                {
                                                                                    "id": "737060168",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Not a bad idea, right? Just imagine all the fun we could have, hehe!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737060166",
                                                                            "text": "It's nice to have friends all over, don't you think?"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737060146",
                                                            "text": "This is a whole new level of thoughtfulness..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737060123",
                                            "text": "I'm still waiting for the day you clean out an entire restaurant."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737060112",
                            "text": "A total team effort!"
                        }
                    ]
                }
            ]
        }
    ]
}