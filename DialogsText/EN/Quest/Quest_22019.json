{
    "quest": {
        "id": "22019",
        "title": "Bantan Sango Case File: Case-Closing Time",
        "description": "It's about time to close the serial theft case in Inazuma.",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
