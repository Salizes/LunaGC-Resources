    "talks": [
        {
            "id": "46801",
            "objective": "",
            "dialogues": [
                {
                    "id": "4680201",
                    "speaker": "Player",
                    "text": "Is there anything I can do to help?"
                },
                {
                    "id": "4680202",
                    "speaker": "Tunner",
                    "text": "You are...?"
                },
                {
                    "id": "4680203",
                    "speaker": "Tunner",
                    "text": "...Ah, travelers. How kind of you."
                },
                {
                    "id": "4680204",
                    "speaker": "Tunner",
                    "text": "Now is the ripening season for grapes. But a herd of boars came out of nowhere and they have their eyes set on the vineyard."
                },
                {
                    "id": "4680205",
                    "speaker": "Tunner",
                    "text": "I can't chase them away by myself and my son is not with me now, so all I can do now is to watch them wreck my land..."
                },
                {
                    "id": "4680206",
                    "speaker": "Tunner",
                    "text": "If you can help me kick those boars out, I'll repay you handsomely!"
                }
            ]
        },
        {
            "id": "46801",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680101",
                    "speaker": "Tunner",
                    "text": "My grape vines are destroyed... These boars..."
                }
            ]
        },
        {
            "id": "46803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680301",
                    "speaker": "Player",
                    "text": "I've got something else to do..."
                },
                {
                    "id": "4680302",
                    "speaker": "Tunner",
                    "text": "Well then, guess I can only wait until my son's back to punish those boars."
                }
            ]
        },
        {
            "id": "46804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "4680401",
                    "speaker": "Tunner",
                    "text": "Hello. Do you have any message from my son?",
                    "choices": [
                        {
                            "id": "4680601",
                            "text": "And you are...?",
                            "response": [
                                {
                                    "id": "4680602",
                                    "speaker": "Tunner",
                                    "text": "Me? Pals in the winery call me Old Tunner. I'm a farmer here at the Dawn Winery."
                                },
                                {
                                    "id": "4680603",
                                    "speaker": "Tunner",
                                    "text": "My family has been farming here for generations. Most of the good wines you've had were probably fermented using the grapes here."
                                },
                                {
                                    "id": "4680604",
                                    "speaker": "Tunner",
                                    "text": "Every owner of the winery has been treating our family very generously."
                                },
                                {
                                    "id": "4680605",
                                    "speaker": "Tunner",
                                    "text": "But I don't think it's a good thing for my son to inherit this land and become a farmer for his whole life...",
                                    "choices": [
                                        {
                                            "id": "4680601",
                                            "text": "And you are...?"
                                        },
                                        {
                                            "id": "4680701",
                                            "text": "Your son?",
                                            "response": [
                                                {
                                                    "id": "4680702",
                                                    "speaker": "Tunner",
                                                    "text": "Guy! His name is Guy, my beloved son!"
                                                },
                                                {
                                                    "id": "4680703",
                                                    "speaker": "Tunner",
                                                    "text": "What? You've never heard of him? Hahaha, that's fine. Sooner or later, you'll know him. The whole Mondstadt will know him..."
                                                },
                                                {
                                                    "id": "4680704",
                                                    "speaker": "Tunner",
                                                    "text": "My son, Guy, told me he was going to be the strongest Knight of Favonius! I believe in him."
                                                },
                                                {
                                                    "id": "4680705",
                                                    "speaker": "Tunner",
                                                    "text": "I spent all my hard-earned money for his sake, to give him a better future than mine."
                                                },
                                                {
                                                    "id": "4680706",
                                                    "speaker": "Tunner",
                                                    "text": "Guy is determined to fulfill his dream! He became a squire at 16, so our household has been relying on him since.",
                                                    "choices": [
                                                        {
                                                            "id": "4680601",
                                                            "text": "And you are...?"
                                                        },
                                                        {
                                                            "id": "4680701",
                                                            "text": "Your son?"
                                                        },
                                                        {
                                                            "id": "4680801",
                                                            "text": "Goodbye.",
                                                            "response": [
                                                                {
                                                                    "id": "4680802",
                                                                    "speaker": "Tunner",
                                                                    "text": "Goodbye! If you meet my son, please tell him to come home once in a while!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4680801",
                                            "text": "Goodbye."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4680701",
                            "text": "Your son?"
                        },
                        {
                            "id": "4680801",
                            "text": "Goodbye."
                        }
                    ]
                }
            ]
        },
        {
            "id": "46805",
