            "dialogues": [
                {
                    "id": "6051101",
                    "speaker": "Sucrose",
                    "text": "#Mr. Albedo! {NICKNAME}!"
                },
                {
                    "id": "6051102",
                    "speaker": "Albedo",
                    "text": "Everything good, here?"
                },
                {
                    "id": "6051103",
                    "speaker": "Sucrose",
                    "text": "All good! A few monsters made it into the city, but Master Diluc and Mr. Kaeya helped me take care of them."
                },
                {
                    "id": "6051104",
                    "speaker": "Sucrose",
                    "text": "I have some spare time right now, so I was planning to make some potions to help the people fighting!"
                },
                {
                    "id": "6051105",
                    "speaker": "Albedo",
                    "text": "A sound plan."
                },
                {
                    "id": "6051106",
                    "speaker": "Albedo",
                    "text": "Remember to be careful. I know it's unlikely, but if you encounter a situation you can't handle, retreat to somewhere safe. Don't worry about the front line."
                },
                {
                    "id": "6051107",
                    "speaker": "Sucrose",
                    "text": "Understood!"
                }
            ]
        },
        {
            "id": "60502",
            "objective": "",
            "dialogues": [
                {
                    "id": "6050201",
                    "speaker": "Kaeya",
                    "text": "Fantastic job defending this place, you two."
                },
                {
                    "id": "6050202",
                    "speaker": "Diluc",
                    "text": "We'll take it from here."
                },
                {
                    "id": "6050203",
                    "speaker": "Lawrence",
                    "text": "Captain Kaeya, Swan is—"
                },
                {
                    "id": "6050204",
                    "speaker": "Swan",
                    "text": "Hey! I'm fine. It's your leg we should be worried about..."
                },
                {
                    "id": "6050205",
                    "speaker": "Kaeya",
                    "text": "Swan, Lawrence, you should both get treated at the Church. Don't push yourselves. We'll take care of things here."
                },
                {
                    "id": "6050206",
                    "speaker": "Swan",
                    "text": "But, Master Diluc... Didn't you leave the Knights of Favonius?"
                },
                {
                    "id": "6050207",
                    "speaker": "Diluc",
                    "text": "What, are Knights the only ones capable of defending this gate?"
                },
                {
                    "id": "6050208",
                    "speaker": "Kaeya",
                    "text": "It's fine. Master Diluc is just... altruistic as always. If a civilian is willing to help out, who are we to turn him away?"
                },
                {
                    "id": "6050209",
                    "speaker": "Swan",
                    "text": "...Understood. We're grateful for the support."
                },
                {
                    "id": "6050210",
                    "speaker": "Lawrence",
                    "text": "Yeah, thanks a million! We'll be back soon."
                },
                {
                    "id": "6050211",
                    "speaker": "Black Screen",
                    "text": ""
                }
            ]
        },
