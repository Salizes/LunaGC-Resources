    "talks": [
        {
            "id": "2301101",
            "objective": "Talk to Viktor",
            "dialogues": [
                {
                    "id": "230110101",
                    "speaker": "Viktor",
                    "text": "Hmm... How should I carve this again...",
                    "choices": [
                        {
                            "id": "230110102",
                            "text": "Hi!",
                            "response": [
                                {
                                    "id": "230110104",
                                    "speaker": "Viktor",
                                    "text": "Ugh, who's there? Stop bothering me already, I'm..."
                                },
                                {
                                    "id": "230110105",
                                    "speaker": "Viktor",
                                    "text": "Eh!? Traveler!? What brings you here to Sumeru?"
                                },
                                {
                                    "id": "230110106",
                                    "speaker": "Viktor",
                                    "text": "Come on, Rudolf can't have sent you to beat me up, right? I did nothing but send Lily a little gift way back when!",
                                    "choices": [
                                        {
                                            "id": "230110107",
                                            "text": "I'm just stopping by...",
                                            "response": [
                                                {
                                                    "id": "230110108",
                                                    "speaker": "Viktor",
                                                    "text": "So you're still traveling. Just can't stop, can you?"
                                                },
                                                {
                                                    "id": "230110112",
                                                    "speaker": "Viktor",
                                                    "text": "But, you know... I didn't expect to see you here in Sumeru..."
                                                },
                                                {
                                                    "id": "230110113",
                                                    "speaker": "Viktor",
                                                    "text": "My original orders were to relocate from Mondstadt to Snezhnaya."
                                                },
                                                {
                                                    "id": "230110114",
                                                    "speaker": "Viktor",
                                                    "text": "But another order came and I was sent to Sumeru City to assist Mr. Vsevolod. Moreover, I was told that I was being transferred to Lord Pulcinella's command.",
                                                    "choices": [
                                                        {
                                                            "id": "230110115",
                                                            "text": "Pulcinella?",
                                                            "response": [
                                                                {
                                                                    "id": "230110117",
                                                                    "speaker": "Viktor",
                                                                    "text": "Yes... Well, no. I shall stop here, or Mr. Vsevolod would criticize my insensitivity to affairs of confidentiality."
                                                                },
                                                                {
                                                                    "id": "230110118",
                                                                    "speaker": "Viktor",
                                                                    "text": "*sigh* The names of our Lord Harbingers are no secret. I can never understand why he's so antsy about it."
                                                                },
                                                                {
                                                                    "id": "230110119",
                                                                    "speaker": "Player",
                                                                    "text": "So, what are you doing in Sumeru?"
                                                                },
                                                                {
                                                                    "id": "230110120",
                                                                    "speaker": "Viktor",
                                                                    "text": "Oh, Mr. Vsevolod and I are mainly responsible for logistical support and coordination. In short, we go shopping a lot."
                                                                },
                                                                {
                                                                    "id": "230110121",
                                                                    "speaker": "Viktor",
                                                                    "text": "It doesn't sound like a big deal, but it's certainly nicer than idling away in the Mondstadt Cathedral."
                                                                },
                                                                {
                                                                    "id": "230110122",
                                                                    "speaker": "Viktor",
                                                                    "text": "Hehe, my current job also comes with lots of free time, and no one's keeping an eye on me..."
                                                                },
                                                                {
                                                                    "id": "230110123",
                                                                    "speaker": "Viktor",
                                                                    "text": "So I picked back my childhood wood carving hobby back up. And guess what, Sumeru happens to be rich in wood. Perfect for practice!"
                                                                },
                                                                {
                                                                    "id": "230110124",
                                                                    "speaker": "Viktor",
                                                                    "text": "And you know what? My wood carvings are actually popular among kids. They have been bothering me about it, so I promised to carve one for them each.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230110125",
                                                                            "text": "Aren't you with the Fatui?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230110126",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Yes, so what? I mean... Who says a Fatuus can't make toys for kids?"
                                                                                },
                                                                                {
                                                                                    "id": "230110127",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Besides, I'm just the supply guy. As for all those fancy great deals, I'll just leave them to the Lords."
                                                                                },
                                                                                {
                                                                                    "id": "230110130",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "All in all, that's the situation here. I wasn't able to return to Snezhnaya, but I kinda like Sumeru. There's food, entertainment, and a pretty nice environment here."
                                                                                },
                                                                                {
                                                                                    "id": "230110131",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "After work, I just grab some food and get myself a nice sunny spot for some wood carving."
                                                                                },
                                                                                {
                                                                                    "id": "230110132",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "However... Haha, everyone gives me those skeptical looks, just like the one you gave me when we first talked."
                                                                                },
                                                                                {
                                                                                    "id": "230110133",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "But there's nothing I can do. I'm a Fatuus after all.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "230110134",
                                                                                            "text": "I still don't really trust you even now.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230110136",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "Okay... Basically, I'm quite happy with my life now, and I even managed to keep some savings."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230110137",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "If these days continue, I might just settle down here in Sumeru..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230110138",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "Ahem, well, that's enough of that. Now that you're also here, Traveler, let's continue our \"equivalent exchange,\" if you're in."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230110139",
                                                                                                    "speaker": "Viktor",
                                                                                                    "text": "But I'm also out of stories, so your payment will be in real currency this time around.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "230110140",
                                                                                                            "text": "Well, that works better for me.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "230110143",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Alright, let me make the commission clear."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "230110144",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "I ordered some wood from Hamawi lately, but it hasn't been delivered yet."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "230110145",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "I can't go talk to him during working hours, or Mr. Vsevolod will scold me for sure."
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "230110146",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Traveler, would you please do me a favor and ask Hamawi about my wood delivery?",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "230110147",
                                                                                                                            "text": "Just get my payment ready.",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "230110148",
                                                                                                                                    "speaker": "Viktor",
                                                                                                                                    "text": "Rest assured. I won't let you down."
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "230110151",
                                                                                                                                    "speaker": "Viktor",
                                                                                                                                    "text": "Anyway, I'll leave this to you, Traveler."
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "230110149",
                                                                                                                            "text": "You sure you're not up to anything...?",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "230110150",
                                                                                                                                    "speaker": "Viktor",
                                                                                                                                    "text": "Come on, when did I play dirty tricks in our trades before? Don't worry, I can't be bothered, anyway... What's wrong with a peaceful, simple life?"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "230110141",
                                                                                                            "text": "Am I taking commissions from the Fatui?",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "230110142",
                                                                                                                    "speaker": "Viktor",
                                                                                                                    "text": "Of course not, you'll just be doing commissions for Viktor."
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "230110135",
                                                                                            "text": "Who says I trust you now? Stop cottoning up to me!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230110128",
                                                                            "text": "You're not trying to pump the kids for information... Are you?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230110129",
                                                                                    "speaker": "Viktor",
                                                                                    "text": "Hey! I'd never do that! What's with your horrible stereotype of us Fatui?"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230110116",
                                                            "text": "Another Harbinger?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230110109",
                                            "text": "That's right, come back to Mondstadt with me!",
                                            "response": [
                                                {
                                                    "id": "230110110",
                                                    "speaker": "Viktor",
                                                    "text": "Ha, ha, ha, alright. Want a pair of shackles to lead me away while you're at it?"
                                                },
                                                {
                                                    "id": "230110111",
                                                    "speaker": "Viktor",
                                                    "text": "Okay, enough joking around. I've got things to deal with."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230110103",
                            "text": "V—Viktor?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2301102",
            "objective": "Talk to Hamawi",
            "dialogues": [
                {
                    "id": "230110301",
                    "speaker": "Hamawi",
                    "text": "What awful luck..."
                },
                {
                    "id": "230110302",
                    "speaker": "Player",
                    "text": "About Viktor's wood delivery..."
                },
                {
                    "id": "230110303",
                    "speaker": "Hamawi",
                    "text": "Are you talking about the wood that the Fatuus ordered?"
                },
                {
                    "id": "230110304",
                    "speaker": "Hamawi",
                    "text": "*sigh* I knew dealing with the Fatui wouldn't end well."
                },
                {
                    "id": "230110305",
                    "speaker": "Hamawi",
                    "text": "We were attacked by monsters while transporting that wood. All of us made it back alive, but our cart didn't. We were forced to leave the wood by the roadside."
                },
                {
                    "id": "230110306",
                    "speaker": "Hamawi",
                    "text": "I dare not go over there, nor can I find someone to get rid of those monsters so soon..."
                },
                {
                    "id": "230110308",
                    "speaker": "Player",
                    "text": "We aren't Fatui..."
                },
                {
                    "id": "230110309",
                    "speaker": "Hamawi",
                    "text": "Aren't you a Fatuus? Then why are you helping him?"
                },
                {
                    "id": "230110310",
                    "speaker": "Hamawi",
                    "text": "Anyway, I can only leave my cart there for now and see if I can hire someone to deal with the situation."
                },
                {
                    "id": "230110311",
                    "speaker": "Hamawi",
                    "text": "If you are anxious to get the wood, I'll mark the approximate location of the cart on the map for you, then you can go take a look for yourself."
                },
                {
                    "id": "230110312",
                    "speaker": "Hamawi",
                    "text": "*sigh* Nothing good ever comes of things that the Fatui are involved in..."
                }
            ]
        },
        {
            "id": "2301107",
            "objective": "",
            "dialogues": [
                {
                    "id": "230110701",
                    "speaker": "Viktor",
                    "text": "How did it go? Has my wood arrived?"
                },
                {
                    "id": "230110702",
                    "speaker": "Black Screen",
                    "text": "You tell Viktor what happened..."
                },
                {
                    "id": "230110703",
                    "speaker": "Viktor",
                    "text": "Monsters again? Why does it feel like every cart in the world is being attacked by monsters..."
                },
                {
                    "id": "230110704",
                    "speaker": "Viktor",
                    "text": "Never mind, as long my wood gets here."
                },
                {
                    "id": "230110705",
                    "speaker": "Viktor",
                    "text": "Oh, right. Here's the payment I promised you. You can tally it up if you like."
                },
                {
                    "id": "230110706",
                    "speaker": "Viktor",
                    "text": "Uh, by the way... Um, is Lily doing well?"
                },
                {
                    "id": "230110707",
                    "speaker": "Viktor",
                    "text": "I didn't say goodbye to her before I left. I hope she isn't angry...",
                    "choices": [
                        {
                            "id": "230110708",
                            "text": "She's doing really well.",
                            "response": [
                                {
                                    "id": "230110709",
                                    "speaker": "Viktor",
                                    "text": "Alright. Ahem... Don't look at me like that. I was just a little concerned!"
                                },
                                {
                                    "id": "230110714",
                                    "speaker": "Viktor",
                                    "text": "Anyway, count your compensation. I prepared the exact amount, Traveler."
                                }
                            ]
                        },
                        {
                            "id": "230110710",
                            "text": "Go back and visit her yourself.",
                            "response": [
                                {
                                    "id": "230110711",
                                    "speaker": "Viktor",
                                    "text": "Mr. Vsevolod will give me a real hiding if I do that. Forget it."
                                },
                                {
                                    "id": "230110712",
                                    "speaker": "Viktor",
                                    "text": "I don't quite dare to send a letter directly either."
                                },
                                {
                                    "id": "230110713",
                                    "speaker": "Viktor",
                                    "text": "Receiving a letter from a Fatuus sounds like a bad thing, either. Hahaha..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
