    "talks": [
        {
            "id": "7332801",
            "objective": "",
            "dialogues": [
                {
                    "id": "733280101",
                    "speaker": "Paimon",
                    "text": "Hey there, Jeht!"
                },
                {
                    "id": "733280102",
                    "speaker": "Jeht",
                    "text": "#{NICKNAME}? And Paimon, too!"
                },
                {
                    "id": "733280103",
                    "speaker": "Benben",
                    "text": "Beep beep!"
                },
                {
                    "id": "733280104",
                    "speaker": "Jeht",
                    "text": "Haha, see what I told you? We'd meet again!"
                },
                {
                    "id": "733280105",
                    "speaker": "Player",
                    "text": "What are you doing here?"
                },
                {
                    "id": "733280106",
                    "speaker": "Jeht",
                    "text": "Well, that's a proper lady's little secret."
                },
                {
                    "id": "733280107",
                    "speaker": "Paimon",
                    "text": "?"
                },
                {
                    "id": "733280108",
                    "speaker": "Jeht",
                    "text": "#{M#It means no probing! Even I wanna keep some things to myself, you know...}{F#Find me an izakaya and amuse me, and I might divulge a secret or two... Didn't you know that already?}"
                },
                {
                    "id": "733280109",
                    "speaker": "Jeht",
                    "text": "#{M#Pfft, sorry 'bout that, but according to the rules we've gotta follow as guards-for-hire, I can't tell you anything.}{F#Haha, I'm just joking! There are some rules we must follow as guards... We mustn't say a word about the goods we're escorting. My apologies.}"
                },
                {
                    "id": "733280110",
                    "speaker": "Paimon",
                    "text": "Hmph, you sound all secretive!"
                },
                {
                    "id": "733280111",
                    "speaker": "Jeht",
                    "text": "So... How have you been?",
                    "choices": [
                        {
                            "id": "733280112",
                            "text": "Not bad.",
                            "response": [
                                {
                                    "id": "733280114",
                                    "speaker": "Jeht",
                                    "text": "Yeah... The same with me."
                                },
                                {
                                    "id": "733280115",
                                    "speaker": "Jeht",
                                    "text": "Alright, I won't keep you any longer. *sigh* I've got my own business to deal with."
                                },
                                {
                                    "id": "733280116",
                                    "speaker": "Paimon",
                                    "text": "Huh, you're so busy, Jeht. You weren't like this before."
                                },
                                {
                                    "id": "733280117",
                                    "speaker": "Jeht",
                                    "text": "Pfft... Well, that's a \"stable\" job for ya, though what I'm doing is pretty much the same as before."
                                },
                                {
                                    "id": "733280118",
                                    "speaker": "Jeht",
                                    "text": "It really hasn't taken too long for me to start missing my old, carefree days..."
                                },
                                {
                                    "id": "733280119",
                                    "speaker": "Jeht",
                                    "text": "I don't know what you've been doing lately, but I always look forward to listening to your stories... and I've got plenty to share with you, too."
                                },
                                {
                                    "id": "733280120",
                                    "speaker": "Jeht",
                                    "text": "But we're in no hurry. Good stories are like wine. Gotta let them age properly, you know? Travelers in the desert used to live on these stories once upon a time, hehe!"
                                },
                                {
                                    "id": "733280121",
                                    "speaker": "Jeht",
                                    "text": "Mm... Anyway, stay safe."
                                },
                                {
                                    "id": "733280122",
                                    "speaker": "Player",
                                    "text": "You too, Jeht."
                                },
                                {
                                    "id": "733280123",
                                    "speaker": "Jeht",
                                    "text": "Yeah, lemme give you a thousand hugs. I'll be praying for your safety."
                                },
                                {
                                    "id": "733280124",
                                    "speaker": "Benben",
                                    "text": "Beep!"
                                },
                                {
                                    "id": "733280125",
                                    "speaker": "Jeht",
                                    "text": "Haha, Benben will be doing so too!"
                                }
                            ]
                        },
                        {
                            "id": "733280113",
                            "text": "I'm doing okay..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7332802",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "733280201",
                    "speaker": "Jeht",
                    "text": "Well, here's your a thousand hugs! Until next time!",
                    "choices": [
                        {
                            "id": "733280202",
                            "text": "Where will we meet again?",
                            "response": [
                                {
                                    "id": "733280203",
                                    "speaker": "Jeht",
                                    "text": "Who knows? Maybe in Celestia?"
                                },
                                {
                                    "id": "733280204",
                                    "speaker": "Jeht",
                                    "text": "Hahahaha! I was joking! But if you want to see me there, I will definitely be there."
                                },
                                {
                                    "id": "733280205",
                                    "speaker": "Jeht",
                                    "text": "Don't ask me why. I just know it."
                                },
                                {
                                    "id": "733280208",
                                    "speaker": "Jeht",
                                    "text": "Anyway, until next time!"
                                }
                            ]
                        },
                        {
                            "id": "733280206",
                            "text": "A thousand hugs to you too.",
                            "response": [
                                {
                                    "id": "733280207",
                                    "speaker": "Jeht",
                                    "text": "Haha, thanks!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
