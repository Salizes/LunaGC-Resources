    "talks": [
        {
            "id": "7001901",
            "objective": "Talk to the other hilichurl willing to make conversation",
            "dialogues": [
                {
                    "id": "700190101",
                    "speaker": "Sleep-Deprived Hilichurl",
                    "text": "Yoyo dala si?"
                },
                {
                    "id": "700190102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo. Mimi mani ye."
                },
                {
                    "id": "700190103",
                    "speaker": "Sleep-Deprived Hilichurl",
                    "text": "Yoyo mani mi? Mi muhe Upa Celi nini. Mi muhe mi nunu si, mi muhe mi nye."
                },
                {
                    "id": "700190104",
                    "speaker": "Ella Musk",
                    "text": "It says it doesn't want to see the sun. It wants to fall asleep and never wake up again... Goodness knows what could be causing it so much anguish."
                },
                {
                    "id": "700190105",
                    "speaker": "Sleep-Deprived Hilichurl",
                    "text": "Biat. Mi muhe <color=#00E1FFFF>celi lata</color>. Mi nunu nye."
                },
                {
                    "id": "700190106",
                    "speaker": "Ella Musk",
                    "text": "Hmm, why don't we try giving it something it wants, to try and make it feel better?"
                }
            ]
        },
        {
            "id": "7001902",
            "objective": "Give an item to the hilichurl",
            "dialogues": [
                {
                    "id": "700190301",
                    "speaker": "Sleep-Deprived Hilichurl",
                    "text": "Yeye dada."
                },
                {
                    "id": "700190302",
                    "speaker": "Sleep-Deprived Hilichurl",
                    "text": "Wei? Du odomu tomo zido mi si, du zido <color=#00E1FFFF>unta nunu</color>!"
                },
                {
                    "id": "700190303",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Unta nunu</color>... It's trying to tell us the time, right?",
                    "choices": [
                        {
                            "id": "700190304",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700190306",
                                    "speaker": "Sleep-Deprived Hilichurl",
                                    "text": "Valo, mi tomo!"
                                },
                                {
                                    "id": "700190307",
                                    "speaker": "Paimon",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700190305",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7001904",
            "objective": "",
            "dialogues": [
                {
                    "id": "700190401",
                    "speaker": "Sleep-Deprived Hilichurl",
                    "text": "Nye nye nye!"
                },
                {
                    "id": "700190402",
                    "speaker": "Player",
                    "text": "That didn't seem quite right."
                }
            ]
        },
        {
