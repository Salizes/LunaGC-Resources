    "talks": [
        {
            "id": "7466801",
            "objective": "",
            "dialogues": [
                {
                    "id": "746680101",
                    "speaker": "Paimon",
                    "text": "Eh? Did light just start flooding from that Statue of The Seven just now...?"
                },
                {
                    "id": "746680102",
                    "speaker": "Paimon",
                    "text": "That's so weird! Did anything like this ever happen before?",
                    "choices": [
                        {
                            "id": "746680103",
                            "text": "It's normal for a Statue of The Seven to glow.",
                            "response": [
                                {
                                    "id": "746680107",
                                    "speaker": "Paimon",
                                    "text": "#{NICKNAME}, you didn't feel uncomfortable at all?",
                                    "choices": [
                                        {
                                            "id": "746680108",
                                            "text": "Huh? Water... the water is speaking to me...",
                                            "response": [
                                                {
                                                    "id": "746680109",
                                                    "speaker": "Paimon",
                                                    "text": "Like Paimon's gonna believe you! If you can crack jokes like that, you must be fine."
                                                },
                                                {
                                                    "id": "746680112",
                                                    "speaker": "Paimon",
                                                    "text": "Though, after it lit up like that, the air does feel a lot more humid. Maybe it's because of all that Hydro energy that was released?"
                                                },
                                                {
                                                    "id": "746680113",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, Paimon heard that in Fontaine, if you can use Elemental Energy properly, you can even swim underwater! Maybe you can even find sunken treasure!"
                                                },
                                                {
                                                    "id": "746680114",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon'll leave diving for treasure to you. Paimon will... stand on the shore and wait for you!",
                                                    "choices": [
                                                        {
                                                            "id": "746680115",
                                                            "text": "It'll be lonely, going underwater alone...",
                                                            "response": [
                                                                {
                                                                    "id": "746680117",
                                                                    "speaker": "Paimon",
                                                                    "text": "Waaah! But... but... being in the water is scary!"
                                                                },
                                                                {
                                                                    "id": "746680118",
                                                                    "speaker": "Paimon",
                                                                    "text": "What if Paimon accidentally gets swept in a current and gets all turned around and dizzy, and then she won't be able to fly away no matter what..."
                                                                },
                                                                {
                                                                    "id": "746680119",
                                                                    "speaker": "Paimon",
                                                                    "text": "Just like before Paimon met you, back in Mondstadt..."
                                                                },
                                                                {
                                                                    "id": "746680120",
                                                                    "speaker": "Player",
                                                                    "text": "Then I'll fish you out again!"
                                                                },
                                                                {
                                                                    "id": "746680121",
                                                                    "speaker": "Paimon",
                                                                    "text": "...Really? Th—Then maybe Paimon can try going underwater with you. Hmph! You'd better not go back on your word!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746680116",
                                                            "text": "You could try doing something for once, Paimon."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746680110",
                                            "text": "Wow, I feel like I'm using gills to breathe...",
                                            "response": [
                                                {
                                                    "id": "746680111",
                                                    "speaker": "Paimon",
                                                    "text": "Good for you! First try growing a pair of gills and show Paimon! Hmph! Seems like you're feeling pretty good! Paimon can't believe Paimon was actually worried about you for a moment there..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746680105",
                            "text": "A rush of water?",
                            "response": [
                                {
                                    "id": "746680106",
                                    "speaker": "Paimon",
                                    "text": "It certainly is the nation of the Hydro Archon! Even the Statues of The Seven are water fountains... YEAH RIGHT! That light wasn't normal at all!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
