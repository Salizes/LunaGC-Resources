        {
            "id": "2302506",
            "objective": "Set the beacons up",
            "dialogues": [
                {
                    "id": "230250601",
                    "speaker": "Farghani",
                    "text": "Hopefully there won't be any more data errors this time..."
                }
            ]
        },
        {
            "id": "2302507",
            "objective": "Talk to Farghani",
            "dialogues": [
                {
                    "id": "230250701",
                    "speaker": "Farghani",
                    "text": "Huh? Have you finished setting up all the beacons?"
                },
                {
                    "id": "230250702",
                    "speaker": "Player",
                    "text": "We're all set."
                },
                {
                    "id": "230250703",
                    "speaker": "Farghani",
                    "text": "Thank you so much. Please take this as your payment."
                },
                {
                    "id": "230250704",
                    "speaker": "Farghani",
                    "text": "Now all I have to do is wait for them to collect the data, and then I'll be able to confirm my deduction!"
                },
                {
                    "id": "230250705",
                    "speaker": "Farghani",
                    "text": "Still, how am I supposed to go up and retrieve the beacons...?"
                }
            ]
        },
        {
            "id": "2302508",
            "objective": "Talk to Farghani",
            "dialogues": [
                {
                    "id": "230250801",
                    "speaker": "Farghani",
                    "text": "Ah, Traveler, you've finally come!"
                },
                {
                    "id": "230250802",
                    "speaker": "Player",
                    "text": "How's your research going?"
                },
                {
                    "id": "230250803",
                    "speaker": "Farghani",
                    "text": "Thanks to you, I've made huge progress in the past few days. The beacons should be collecting data as we speak."
                },
                {
                    "id": "230250804",
                    "speaker": "Farghani",
                    "text": "Now I only have to retrieve the data and verify my new conjectures!",
                    "choices": [
                        {
                            "id": "230250805",
                            "text": "All you have done these days is make conjectures!?",
                            "response": [
                                {
                                    "id": "230250807",
                                    "speaker": "Farghani",
                                    "text": "Well, I've optimized some equations and calibrated my instruments. After all..."
                                },
                                {
                                    "id": "230250808",
                                    "speaker": "Farghani",
                                    "text": "I won't be able to climb up to the locations where you set those beacons."
                                },
                                {
                                    "id": "230250809",
                                    "speaker": "Farghani",
                                    "text": "I'm afraid I'll have to trouble you to retrieve those beacons.",
                                    "choices": [
                                        {
                                            "id": "230250810",
                                            "text": "Well, alright then...",
                                            "response": [
                                                {
                                                    "id": "230250811",
                                                    "speaker": "Farghani",
                                                    "text": "Please, Traveler! I will take care of the payment, do not fret."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230250812",
                                            "text": "Why don't you take retrieval into account next time...",
                                            "response": [
                                                {
                                                    "id": "230250813",
                                                    "speaker": "Farghani",
                                                    "text": "I have weighed some options, you know. Adding a retrieval device, expanding our range of applications... things like that."
                                                },
                                                {
                                                    "id": "230250814",
                                                    "speaker": "Farghani",
                                                    "text": "But they require a higher budget, and I'm not sure how this might affect the data precision."
                                                },
                                                {
                                                    "id": "230250815",
                                                    "speaker": "Farghani",
                                                    "text": "Anyways, I'll be counting on you this time as well!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230250806",
                            "text": "You haven't made any progress at all..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302511",
            "objective": "Go to where the beacons were set up",
            "dialogues": []
        },
        {
            "id": "2302509",
            "objective": "Retrieve the beacons",
            "dialogues": [
                {
                    "id": "230250901",
                    "speaker": "Farghani",
                    "text": "Hopefully there won't be any more data errors this time..."
                }
            ]
        },
        {
            "id": "2302510",
            "objective": "Talk to Farghani",
            "dialogues": [
                {
                    "id": "230251001",
                    "speaker": "Farghani",
                    "text": "What? Monsters, out there? This doesn't make sense. The environmental parameters showed that..."
                },
                {
                    "id": "230251002",
                    "speaker": "Farghani",
                    "text": "Could the beacons have become variables themselves? Perhaps their vibrations and sounds attracted the monsters..."
                },
                {
                    "id": "230251003",
                    "speaker": "Farghani",
                    "text": "Oh no, will these things affect the data? Ah, sorry. I've been talking to myself again."
                },
                {
                    "id": "230251004",
                    "speaker": "Farghani",
                    "text": "I didn't expect to cause you extra trouble. My apologies, and please, take this as your payment."
                },
                {
                    "id": "230251005",
                    "speaker": "Farghani",
                    "text": "I should be more conscientious with my measurements next time."
                }
            ]
        }
    ]
