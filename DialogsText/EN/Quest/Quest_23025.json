    "talks": [
        {
            "id": "2302502",
            "objective": "Talk to Farghani",
            "dialogues": [
                {
                    "id": "230250201",
                    "speaker": "Farghani",
                    "text": "Hey, friend, can I have a moment of your time?",
                    "choices": [
                        {
                            "id": "230250202",
                            "text": "What is it?",
                            "response": [
                                {
                                    "id": "230250208",
                                    "speaker": "Farghani",
                                    "text": "Now, have you ever thought about this: what will happen if the sky falls?",
                                    "choices": [
                                        {
                                            "id": "230250209",
                                            "text": "You are worrying too much...",
                                            "response": [
                                                {
                                                    "id": "230250212",
                                                    "speaker": "Farghani",
                                                    "text": "That may be so. But why doesn't the sky fall? Why won't the earth collapse? Without accurate measurements, we'll never have answers to these questions."
                                                },
                                                {
                                                    "id": "230250213",
                                                    "speaker": "Farghani",
                                                    "text": "In fact, I've come up with a model that explains these questions perfectly. I just need more observational data to support it...",
                                                    "choices": [
                                                        {
                                                            "id": "230250214",
                                                            "text": "So, do you need my help?",
                                                            "response": [
                                                                {
                                                                    "id": "230250223",
                                                                    "speaker": "Farghani",
                                                                    "text": "So you are willing to help, then? Many thanks to you!"
                                                                },
                                                                {
                                                                    "id": "230250224",
                                                                    "speaker": "Farghani",
                                                                    "text": "I've chosen a perfect spot for my observations, but some monsters are active there."
                                                                },
                                                                {
                                                                    "id": "230250225",
                                                                    "speaker": "Farghani",
                                                                    "text": "Please, drive them away so I can conduct my observations safely.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230250226",
                                                                            "text": "Sure.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230250227",
                                                                                    "speaker": "Farghani",
                                                                                    "text": "Thanks a lot. Let's be on our way, then."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230250228",
                                                                            "text": "Do you need to be at the scene yourself?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230250229",
                                                                                    "speaker": "Farghani",
                                                                                    "text": "I need to get some data on-site to find the cause of any discrepancies in my calculations."
                                                                                },
                                                                                {
                                                                                    "id": "230250230",
                                                                                    "speaker": "Farghani",
                                                                                    "text": "Fixating on a pile of papers will only lead you further away from the correct answer, so let's hit the road."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230250215",
                                                            "text": "Good luck. See you.",
                                                            "response": [
                                                                {
                                                                    "id": "230250216",
                                                                    "speaker": "Farghani",
                                                                    "text": "Wait, wait! Please reconsider. If my work is published, it could be earthshaking!"
                                                                },
                                                                {
                                                                    "id": "230250217",
                                                                    "speaker": "Farghani",
                                                                    "text": "You will then be a collaborator in this great theoretical undertaking. I can also put your name in the acknowledgments..."
                                                                },
                                                                {
                                                                    "id": "230250218",
                                                                    "speaker": "Farghani",
                                                                    "text": "Or... Or you could even be my co-author..."
                                                                },
                                                                {
                                                                    "id": "230250219",
                                                                    "speaker": "Player",
                                                                    "text": "Are things really this urgent?"
                                                                },
                                                                {
                                                                    "id": "230250220",
                                                                    "speaker": "Farghani",
                                                                    "text": "If I can't get results, I'm afraid that I'll have a problem getting research funding... And that would be far more devastating than the sky falling.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230250221",
                                                                            "text": "I wouldn't demand co-authorship."
                                                                        },
                                                                        {
                                                                            "id": "230250222",
                                                                            "text": "I prefer to be paid fairly."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230250210",
                                            "text": "Technically, it can't."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230250203",
                            "text": "I'm really busy right now.",
                            "response": [
                                {
                                    "id": "230250204",
                                    "speaker": "Farghani",
                                    "text": "Oh, please don't say that. What could be more serious than the incoming collapse of one's own house?"
                                },
                                {
                                    "id": "230250205",
                                    "speaker": "Player",
                                    "text": "Your house is... collapsing?"
                                },
                                {
                                    "id": "230250206",
                                    "speaker": "Farghani",
                                    "text": "Ahem... Of course not. But say you live in a house, and you've never seen it in its entirety, and no one has ever guaranteed its structural strength..."
                                },
                                {
                                    "id": "230250207",
                                    "speaker": "Farghani",
                                    "text": "Wouldn't living in this house every day worry you somehow? Such is also the case with living in this world."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302503",
            "objective": "Defeat the enemies near the destination",
            "dialogues": []
        },
        {
            "id": "2302504",
            "objective": "Talk to Farghani",
            "dialogues": [
                {
                    "id": "230250401",
                    "speaker": "Farghani",
                    "text": "Hmm... So that's it. Introduce this variable, and the discrepancies can be explained."
                },
                {
                    "id": "230250402",
                    "speaker": "Farghani",
                    "text": "But does that change my other deductions?"
                },
                {
                    "id": "230250403",
                    "speaker": "Player",
                    "text": "Any progress?"
                },
                {
                    "id": "230250404",
                    "speaker": "Farghani",
                    "text": "Sorry, I forgot that you were still here... Here's your payment."
                },
                {
                    "id": "230250405",
                    "speaker": "Farghani",
                    "text": "As for my progress... I've fixed some issues, but new ones have emerged. That's research, I guess."
                },
                {
                    "id": "230250406",
                    "speaker": "Farghani",
                    "text": "I might have to keep troubling you, Traveler, until I reach a final conclusion."
                }
            ]
        },
        {
