    "talks": [
        {
            "id": "7469701",
            "objective": "Talk to Yumemizuki Mizuki",
            "dialogues": [
                {
                    "id": "746970101",
                    "speaker": "Paimon",
                    "text": "Huh? Isn't that Mizuki and her two mini baku? Are they talking to Barbeloth already?"
                },
                {
                    "id": "746970102",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "#{NICKNAME} and Paimon...? Lady Barbeloth was just talking about you. I was wondering if we might cross paths."
                },
                {
                    "id": "746970103",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "Hehe... It seems like fate has already arranged our meeting place."
                },
                {
                    "id": "746970104",
                    "speaker": "Player",
                    "text": "Are you here on holiday, Mizuki?"
                },
                {
                    "id": "746970105",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "Hmm... I suppose you could say that. If the prep work for this educational film about psychology I'm doing goes smoothly, I should indeed have time for some leisure. Though until then, I still need to focus on my work.",
                    "choices": [
                        {
                            "id": "746970106",
                            "text": "A film about psychology?",
                            "response": [
                                {
                                    "id": "746970108",
                                    "speaker": "Paimon",
                                    "text": "Whoa, films can do that? That's amazing!"
                                },
                                {
                                    "id": "746970109",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "Mmhmm, it's a new idea I came up with. Back when I was promoting Aisa Bathhouse, I took inspiration from Fontainian cinema and recorded a few variety show episodes."
                                },
                                {
                                    "id": "746970110",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "People seemed to love it. Not only did they watch every episode, they even remembered all the psychological concepts we showcased."
                                },
                                {
                                    "id": "746970111",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "So I thought, why not make a few films about mental disorders as a fun and educational way to explain basic psychological concepts."
                                },
                                {
                                    "id": "746970112",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "...If I can raise everyone's basic awareness, perhaps people can develop a more objective understanding of what mental disorders are."
                                },
                                {
                                    "id": "746970157",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "...Perhaps I can stop people from blindly dismissing these conditions as made-up nonsense, or treating them like some terrifying bogeyman."
                                },
                                {
                                    "id": "746970113",
                                    "speaker": "Yumemizuki Mizuki",
                                    "text": "And maybe my future therapy sessions will go a little more smoothly...",
                                    "choices": [
                                        {
                                            "id": "746970114",
                                            "text": "You've clearly put a lot of thought into this...",
                                            "response": [
                                                {
                                                    "id": "746970116",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "That's right. After all, illnesses of the mind are invisible and hard to pin down. Trying to get a hold on them, or even just detecting their existence, is sometimes far from easy."
                                                },
                                                {
                                                    "id": "746970117",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "But even I don't know how to pin them down to fit neatly into a script..."
                                                },
                                                {
                                                    "id": "746970118",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "I'm a bit embarrassed to admit it, but even though I've written quite a few papers about mental health, I'm completely stuck when it comes to writing a film script."
                                                },
                                                {
                                                    "id": "746970119",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Sometimes, I stay cooped up in my room all day, endlessly going over a few lines of dialogue or a few seconds of plot... Even then, I might come away with nothing to show at the end of it.",
                                                    "choices": [
                                                        {
                                                            "id": "746970120",
                                                            "text": "That sounds exhausting...",
                                                            "response": [
                                                                {
                                                                    "id": "746970122",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Maybe you're just missing a little spark of inspiration? When Paimon and {NICKNAME} get stuck on one thing, we do something else, and then... *ding*! The answer just pops into our heads!"
                                                                },
                                                                {
                                                                    "id": "746970123",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Hmm, it seems like great minds think alike, Paimon. That's why I came here, to experience a form of divination quite unlike the fortune slips I'm used to."
                                                                },
                                                                {
                                                                    "id": "746970124",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "I'm hoping this mage's Lunar Arcana can bring me some fresh inspiration."
                                                                },
                                                                {
                                                                    "id": "746970125",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Inspiration... Anya once said that she wanted to write a fairy tale for every card in the Lunar Arcana. But there were so many stories she wanted to write, and so little time... Heh..."
                                                                },
                                                                {
                                                                    "id": "746970126",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Since you're looking for inspiration, go ahead and draw a card, Miss Youkai. I hope that mage's unfinished fairy tale can lead you to the inspiration for your own story."
                                                                },
                                                                {
                                                                    "id": "746970127",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Alright, Lady Barbeloth. But... most of what I know about divination relates to... the Grand Narukami Shrine. Fortune telling with cards is a first for me."
                                                                },
                                                                {
                                                                    "id": "746970128",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "If I do anything that breaks the proper ritual etiquette, please set me straight."
                                                                },
                                                                {
                                                                    "id": "746970129",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Oh my, the reversed Moon..."
                                                                },
                                                                {
                                                                    "id": "746970130",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "The upright and reversed meanings of the Moon are similar — \"escapism,\" \"illusion,\" \"self-deception\"..."
                                                                },
                                                                {
                                                                    "id": "746970158",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Like someone traveling beneath a dark moon, having lost their way forward but not knowing how to break free.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "746970131",
                                                                            "text": "That doesn't sound good...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "746970133",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yeah, why does the meaning of this card sound like a warning...? Paimon's got a really bad feeling about this..."
                                                                                },
                                                                                {
                                                                                    "id": "746970134",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "However, since Miss Yumemizuki can still hear this prophecy, it means the situation is not yet too dire."
                                                                                },
                                                                                {
                                                                                    "id": "746970135",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "With a little effort, you may be able to exit the haze that obscures your path ahead, and find what you seek..."
                                                                                },
                                                                                {
                                                                                    "id": "746970136",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Escapism, illusion... and \"self-deception\"?"
                                                                                },
                                                                                {
                                                                                    "id": "746970137",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Taking the card at face value, yes. To put it more plainly..."
                                                                                },
                                                                                {
                                                                                    "id": "746970138",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "You're running from an answer that's right before your eyes, searching far when you should be looking near."
                                                                                },
                                                                                {
                                                                                    "id": "746970139",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Are you saying there's someone who can review my script standing right in front of me?"
                                                                                },
                                                                                {
                                                                                    "id": "746970140",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "It's not limited to just the script... But how you interpret the meaning behind the card is entirely up to you."
                                                                                },
                                                                                {
                                                                                    "id": "746970141",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "746970142",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "The answer is right in front of my eyes, yet I'm searching far when I should be looking near... I think I understand what you're getting at."
                                                                                },
                                                                                {
                                                                                    "id": "746970143",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Heh... When you put it like that, I really have been deceiving myself... Or rather, I couldn't help but \"search far when I should be looking near.\""
                                                                                },
                                                                                {
                                                                                    "id": "746970144",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "I thought about visiting Yae Publishing House and asking Guuji Yae for advice, but then..."
                                                                                },
                                                                                {
                                                                                    "id": "746970145",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "From a clinical perspective, I suppose this counts as \"unconscious avoidance\"..."
                                                                                },
                                                                                {
                                                                                    "id": "746970146",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "Thank you for your divination, Lady Barbeloth. You really helped me find inspiration after all."
                                                                                },
                                                                                {
                                                                                    "id": "746970147",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "There's no need to thank me. I did nothing. You untangled the threads of fate yourself. I merely placed the loose ends in your hands."
                                                                                },
                                                                                {
                                                                                    "id": "746970148",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "However, Guuji Yae is also someone swept along by fate."
                                                                                },
                                                                                {
                                                                                    "id": "746970149",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Intertwining threads often bring trouble. With that in mind, keeping your distance wouldn't necessarily be a bad thing."
                                                                                },
                                                                                {
                                                                                    "id": "746970150",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "If I simply ask for some feedback on my script, surely that wouldn't bring fate into the mix, would it?"
                                                                                },
                                                                                {
                                                                                    "id": "746970151",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "As I said, how you interpret things is not up to me, Miss Yumemizuki. I cannot see every twist in your future from reading a single card."
                                                                                },
                                                                                {
                                                                                    "id": "746970152",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Who can perceive every obstacle on the path of fate before it trips them up?"
                                                                                },
                                                                                {
                                                                                    "id": "746970153",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Sometimes, it's just like that little brat said..."
                                                                                },
                                                                                {
                                                                                    "id": "746970154",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "\"...Fate is called as such, for it cannot be changed, nor can it be reversed. It can only but be accepted.\""
                                                                                },
                                                                                {
                                                                                    "id": "746970155",
                                                                                    "speaker": "Yumemizuki Mizuki",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "746970156",
                                                                                    "speaker": "Barbeloth",
                                                                                    "text": "Anyway, Miss Youkai, I look forward to watching your film. Hehehe..."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "746970132",
                                                                            "text": "That sounds a little negative..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746970121",
                                                            "text": "You need to relax..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746970115",
                                            "text": "You've really considered this thoroughly..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746970107",
                            "text": "Is this a new form of therapy?"
                        }
                    ]
                }
            ]
        },
