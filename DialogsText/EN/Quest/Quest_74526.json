        },
        {
            "id": "7452604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745260401",
                    "speaker": "Nilou",
                    "text": "#Ah, {NICKNAME}, it's you.",
                    "choices": [
                        {
                            "id": "745260402",
                            "text": "Are you practicing, Nilou?",
                            "response": [
                                {
                                    "id": "745260404",
                                    "speaker": "Nilou",
                                    "text": "No, no, not at all. I'm just putting a new dance together, one inspired by Padisarahs basking in the sun after the rain, dew drops hanging off the petals."
                                },
                                {
                                    "id": "745260405",
                                    "speaker": "Nilou",
                                    "text": "We're still in the early planning stages, and many of the movements are still quite unrefined. I feel like there's still something missing...",
                                    "choices": [
                                        {
                                            "id": "745260406",
                                            "text": "Even the description sounds beautiful.",
                                            "response": [
                                                {
                                                    "id": "745260408",
                                                    "speaker": "Nilou",
                                                    "text": "You want to take a picture of me? Um, like I said, these dance steps aren't quite ready for prime-time yet...",
                                                    "choices": [
                                                        {
                                                            "id": "745260409",
                                                            "text": "A practice session before the dance takes its final shape...",
                                                            "response": [
                                                                {
                                                                    "id": "745260411",
                                                                    "speaker": "Nilou",
                                                                    "text": "Okay, I've got it! In that case, I'll give these movements my all... Be sure to capture the moment when the flowers are in bloom."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745260410",
                                                            "text": "That too, is part of art."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745260407",
                                            "text": "Would you mind if I took a picture of you, then?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745260403",
                            "text": "I'm not disturbing you, am I?"
                        }
                    ]
                }
            ]
        }
    ]
