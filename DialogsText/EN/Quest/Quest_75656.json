    "talks": [
        {
            "id": "7565601",
            "objective": "",
            "dialogues": [
                {
                    "id": "756560201",
                    "speaker": "Lynette",
                    "text": "...So you did come over. I was wondering if you'd notice me. Looks like my concealment failed this time."
                },
                {
                    "id": "756560202",
                    "speaker": "Lynette",
                    "text": "#Oh well. I didn't put much effort into it anyway. One moment... {NICKNAME} Observation Mode, off. Chat Mode activated."
                },
                {
                    "id": "756560203",
                    "speaker": "Lynette",
                    "text": "Previous observation indicates that you are more likely to be enjoying the scenery than just wandering about. Are you here on business?",
                    "choices": [
                        {
                            "id": "756560204",
                            "text": "We're looking for a good spot for a picture.",
                            "response": [
                                {
                                    "id": "756560206",
                                    "speaker": "Lynette",
                                    "text": "Photos... Have you finally decided to end your travels and work at The Steambird?"
                                },
                                {
                                    "id": "756560207",
                                    "speaker": "Lynette",
                                    "text": "Understandable. An adventurer's income is unstable, and you have Paimon to feed as well — that can't be easy.",
                                    "choices": [
                                        {
                                            "id": "756560208",
                                            "text": "Aye, but they're real slave drivers. Six days of work, one day off.",
                                            "response": [
                                                {
                                                    "id": "756560209",
                                                    "speaker": "Lynette",
                                                    "text": "You followed up with a joke of your own. Wow. I underestimated you."
                                                },
                                                {
                                                    "id": "756560212",
                                                    "speaker": "Lynette",
                                                    "text": "If you've come here to take pictures, they must be of the Court of Fontaine."
                                                },
                                                {
                                                    "id": "756560213",
                                                    "speaker": "Player",
                                                    "text": "Sharp as always, Lynette."
                                                },
                                                {
                                                    "id": "756560214",
                                                    "speaker": "Lynette",
                                                    "text": "Many Steambird reporters come here to take panoramic shots of the Court, and sometimes they gossip on the side."
                                                },
                                                {
                                                    "id": "756560215",
                                                    "speaker": "Lynette",
                                                    "text": "All I need to do is keep a low profile and listen silently."
                                                },
                                                {
                                                    "id": "756560216",
                                                    "speaker": "Lynette",
                                                    "text": "But having come so many times, I've picked up some photography skills along the way... So, do you require an assistant?",
                                                    "choices": [
                                                        {
                                                            "id": "756560217",
                                                            "text": "We need a model more, really.",
                                                            "response": [
                                                                {
                                                                    "id": "756560219",
                                                                    "speaker": "Lynette",
                                                                    "text": "Understood. I prefer work that doesn't require much talking anyway. How do you want me to pose?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756560220",
                                                                            "text": "Let's have a formal pose.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756560222",
                                                                                    "speaker": "Lynette",
                                                                                    "text": "Sure. Will this work?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756560223",
                                                                                            "text": "Perfect. Say cheese!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756560224",
                                                                                                    "speaker": "Lynette",
                                                                                                    "text": "I'm ready."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756560225",
                                                                                            "text": "The fun pose might work better."
                                                                                        },
                                                                                        {
                                                                                            "id": "756560226",
                                                                                            "text": "Let's go with a casual posture instead.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756560227",
                                                                                                    "speaker": "Lynette",
                                                                                                    "text": "Then we'll do that."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756560228",
                                                                                            "text": "Let's roll with the formal pose instead.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756560229",
                                                                                                    "speaker": "Lynette",
                                                                                                    "text": "Works for me."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756560221",
                                                                            "text": "Let's go with a fun pose!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756560218",
                                                            "text": "If you don't mind Lynette, could you move into the frame?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756560210",
                                            "text": "No, no, I'm a loyal member of the Adventurers' Guild!",
                                            "response": [
                                                {
                                                    "id": "756560211",
                                                    "speaker": "Lynette",
                                                    "text": "Hmm. I didn't expect you to be so earnest about the Guild. My apologies for the joke. I did not mean to doubt your adventurous spirit."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756560205",
                            "text": "I'm looking for someone to help with some photos."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7565603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "756560307",
                    "speaker": "Player",
                    "text": "Just take up a casual pose."
                },
                {
                    "id": "756560312",
                    "speaker": "Lynette",
                    "text": "Works for me."
                },
                {
                    "id": "756560314",
                    "speaker": "Lynette",
                    "text": "Let's go with that."
                },
                {
                    "id": "756560316",
                    "speaker": "Lynette",
                    "text": "Sure."
                }
            ]
        }
    ]
}