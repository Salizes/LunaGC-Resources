            "dialogues": [
                {
                    "id": "745190101",
                    "speaker": "Noelle",
                    "text": "How are things going for you, Honorary Knight? If there's anything I can do to help, just say the word!"
                }
            ]
        },
        {
            "id": "7451902",
            "objective": "",
            "dialogues": [
                {
                    "id": "745190201",
                    "speaker": "Player",
                    "text": "Let's continue the photoshoot!"
                }
            ]
        },
        {
            "id": "7451903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745190301",
                    "speaker": "Player",
                    "text": "Give me a second, I'm considering my options."
                }
            ]
        },
        {
            "id": "7451904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745190401",
                    "speaker": "Noelle",
                    "text": "Oh, hello there, Honorary Knight! Are you here to see Master Jean... Or is there something I can help you with?",
                    "choices": [
                        {
                            "id": "745190402",
                            "text": "I'm just having a little stroll.",
                            "response": [
                                {
                                    "id": "745190404",
                                    "speaker": "Noelle",
                                    "text": "I'm currently conducting a routine cleanup of the area around the Knights of Favonius offices. Most of the dust has been cleaned out at this point. Next, I'll be re-organizing our old files."
                                },
                                {
                                    "id": "745190405",
                                    "speaker": "Noelle",
                                    "text": "Those documents have piled up for a while now. I'm thinking that everyone will have an easier time looking them up if I sort them into different categories."
                                },
                                {
                                    "id": "745190406",
                                    "speaker": "Noelle",
                                    "text": "Also, I can learn a lot from those who came before me in the process. That's a form of training too, isn't it?"
                                },
                                {
                                    "id": "745190407",
                                    "speaker": "Player",
                                    "text": "You're as serious about your work as ever, Noelle."
                                },
                                {
                                    "id": "745190408",
                                    "speaker": "Noelle",
                                    "text": "Just doing my duty. You and the other Knights are always pushing forward, so I've got to catch up as soon as I can.",
                                    "choices": [
                                        {
                                            "id": "745190409",
                                            "text": "Your resolve deserves remembrance...",
                                            "response": [
                                                {
                                                    "id": "745190411",
                                                    "speaker": "Noelle",
                                                    "text": "Huh? Me? I mean, you're most welcome! It's just... I just finished cleaning, so I'll be covered in dust...",
                                                    "choices": [
                                                        {
                                                            "id": "745190412",
                                                            "text": "Ah, but that's the point! I mean to capture you at your hardest-working!",
                                                            "response": [
                                                                {
                                                                    "id": "745190414",
                                                                    "speaker": "Noelle",
                                                                    "text": "Um... I—Isn't it a bit too soon to call me that? But if you want to take the photo... It would be my honor, covered in dust though I may be!"
                                                                },
                                                                {
                                                                    "id": "745190415",
                                                                    "speaker": "Noelle",
                                                                    "text": "I'm sure you'll hit the shutter at the perfect moment!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745190413",
                                                            "text": "I mean to set the Maid Knight's \"decisive breakthrough\" onto film!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745190410",
                                            "text": "...So allow me to take a photo of you!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745190403",
                            "text": "What are you busy with, Noelle?"
                        }
                    ]
                }
            ]
        }
    ]
}