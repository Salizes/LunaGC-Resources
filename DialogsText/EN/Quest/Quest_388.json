            "dialogues": [
                {
                    "id": "3880101",
                    "speaker": "Paimon",
                    "text": "It's a storm <color=#00E1FFFF>barrier</color>!"
                },
                {
                    "id": "3880102",
                    "speaker": "Paimon",
                    "text": "It looks so dangerous..."
                },
                {
                    "id": "3880103",
                    "speaker": "Venti",
                    "text": "Let me at it."
                },
                {
                    "id": "3880104",
                    "speaker": "Venti",
                    "text": "Although this wooden lyre is all I have..."
                },
                {
                    "id": "3880105",
                    "speaker": "Venti",
                    "text": "I don't need the lyre to break through this kind of storm barri— Ah, wait, what is that?"
                },
                {
                    "id": "3880106",
                    "speaker": "Jean",
                    "text": "Enemy attack! Prepare yourselves!"
                }
            ]
        },
        {
            "id": "38802",
            "objective": "Defeat the assailants",
            "dialogues": []
        },
        {
            "id": "38803",
            "objective": "Disperse the wind barrier",
            "dialogues": [
                {
                    "id": "3880301",
                    "speaker": "Venti",
                    "text": "Ahh..."
                },
                {
                    "id": "3880302",
                    "speaker": "Venti",
                    "text": "The hilichurls usually do not venture into areas with high elemental concentrations."
                },
                {
                    "id": "3880303",
                    "speaker": "Venti",
                    "text": "It puts a heavy burden on their bodies."
                },
                {
                    "id": "3880304",
                    "speaker": "Diluc",
                    "text": "The Abyss Order must be manipulating them behind the scenes, yet they shouldn't have been able to determine that we would come."
                },
                {
                    "id": "3880305",
                    "speaker": "Diluc",
                    "text": "They're presumably spreading their forces to halt our plans."
                },
                {
                    "id": "3880306",
                    "speaker": "Venti",
                    "text": "Without further ado..."
                },
                {
                    "id": "3880307",
                    "speaker": "Venti",
                    "text": "I suppose I can play faster if my only audience is the wind."
                }
            ]
        },
        {
            "id": "38804",
            "objective": "Talk to Venti",
            "dialogues": [
                {
                    "id": "3880401",
                    "speaker": "Paimon",
                    "text": "It actually opened! You're not entirely useless, Tone-Deaf Bard!"
                },
                {
                    "id": "3880402",
                    "speaker": "Jean",
                    "text": "This is it. We are now entering <color=#00E1FFFF>Stormterror's Lair</color>."
                },
                {
                    "id": "3880403",
                    "speaker": "Jean",
                    "text": "Watch yourselves. Let's move."
                }
            ]
        },
        {
            "id": "38408",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3840801",
                    "speaker": "Venti",
                    "text": "I shall see it to the end with my own eyes."
                },
                {
                    "id": "3840802",
                    "speaker": "Jean",
                    "text": "The Knights of Favonius shall exert our utmost efforts for Mondstadt!"
                },
                {
                    "id": "3840803",
                    "speaker": "Diluc",
                    "text": "Aren't you going yet?"
