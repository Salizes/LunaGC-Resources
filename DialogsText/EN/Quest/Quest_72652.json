    "talks": [
        {
            "id": "7265201",
            "objective": "Talk to the Crux Fleet crew member",
            "dialogues": [
                {
                    "id": "726520101",
                    "speaker": "???",
                    "text": "Ho there, Traveler! How've you been? Interested in doing some work for the Crux Fleet?",
                    "choices": [
                        {
                            "id": "726520102",
                            "text": "The Crux Fleet...?",
                            "response": [
                                {
                                    "id": "726520104",
                                    "speaker": "???",
                                    "text": "Eh? Oh, right! Haha, my apologies."
                                },
                                {
                                    "id": "726520105",
                                    "speaker": "Muzhen",
                                    "text": "I'm Muzhen, Chief Technical Officer of the Alcor. I spend most of my time below deck, so it's no surprise that you're not familiar with me."
                                },
                                {
                                    "id": "726520106",
                                    "speaker": "Muzhen",
                                    "text": "Well, Sea Drake kicked me out and made me come outside, haha."
                                },
                                {
                                    "id": "726520107",
                                    "speaker": "Muzhen",
                                    "text": "\"Move those lazy bones of yours and go get some sun, it'll do you good!,\" he said. So here I am, on shore, thanks to him..."
                                },
                                {
                                    "id": "726520108",
                                    "speaker": "Muzhen",
                                    "text": "Hah! Not that he'd get off the boat himself though! Why, he'd faint the moment he sets foot on dry land.",
                                    "choices": [
                                        {
                                            "id": "726520109",
                                            "text": "Oh...",
                                            "response": [
                                                {
                                                    "id": "726520111",
                                                    "speaker": "Muzhen",
                                                    "text": "Ah, yes. How rude of me to forget about the real business while making fun of someone else."
                                                },
                                                {
                                                    "id": "726520112",
                                                    "speaker": "Muzhen",
                                                    "text": "Well, I've got some technical preparation-related errands that you can run to help prepare for the next leg of Captain Beidou's journey."
                                                },
                                                {
                                                    "id": "726520113",
                                                    "speaker": "Muzhen",
                                                    "text": "These things are usually handled by the Captain herself. The person in command of The Crux must have the pioneering spirit to explore the unknown..."
                                                },
                                                {
                                                    "id": "726520114",
                                                    "speaker": "Muzhen",
                                                    "text": "This is our rule, after all, and whoever is the boss will have to take up such duties."
                                                },
                                                {
                                                    "id": "726520115",
                                                    "speaker": "Muzhen",
                                                    "text": "Still, the Captain has priority matters she needs to attend to at the moment. Certainly not matters that should be delayed by a few small odd jobs."
                                                },
                                                {
                                                    "id": "726520116",
                                                    "speaker": "Paimon",
                                                    "text": "So you're pushing them off to us, then?"
                                                },
                                                {
                                                    "id": "726520117",
                                                    "speaker": "Muzhen",
                                                    "text": "Well, y'see, I'm a Technical Officer, not a fighter... And it's not as if the rest of the crew don't have things to do. No one's got the time to spare."
                                                },
                                                {
                                                    "id": "726520118",
                                                    "speaker": "Muzhen",
                                                    "text": "Well then. That's all for the chit-chat. Here's the skinny..."
                                                },
                                                {
                                                    "id": "726520119",
                                                    "speaker": "Muzhen",
                                                    "text": "The person who ordered our next shipment wants some samples... Specifically, samples of components from some special Ruin machines."
                                                },
                                                {
                                                    "id": "726520120",
                                                    "speaker": "Muzhen",
                                                    "text": "According to the eyewitness reports this particular employer sent us, these machines... or organisms, are hidden throughout the islands of Inazuma. Very fascinating beings.",
                                                    "choices": [
                                                        {
                                                            "id": "726520121",
                                                            "text": "And who might this employer be...?",
                                                            "response": [
                                                                {
                                                                    "id": "726520122",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Oh ho? Trying to get me to spill the beans on our trade secrets huh?"
                                                                },
                                                                {
                                                                    "id": "726520123",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Haha! Not to worry. I'd be more than happy to tell you if I knew... even though technically speaking, it'd be a capital offense."
                                                                },
                                                                {
                                                                    "id": "726520124",
                                                                    "speaker": "Muzhen",
                                                                    "text": "I don't know who our employer is, anyway, so you'll have to excuse me. It's not something you should be concerned about, anyway."
                                                                },
                                                                {
                                                                    "id": "726520134",
                                                                    "speaker": "Player",
                                                                    "text": "So, where do we find them?"
                                                                },
                                                                {
                                                                    "id": "726520135",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Hah! See, now you're the asking the right questions."
                                                                },
                                                                {
                                                                    "id": "726520136",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Trouble is that I've got no clue where they are either."
                                                                },
                                                                {
                                                                    "id": "726520137",
                                                                    "speaker": "Muzhen",
                                                                    "text": "However, we've discovered strange Electro phenomena occurring in some regions of the islands. According to my observations, there is a huge gap in frequency between occurrences of such phenomena in these places compared to others across Inazuma."
                                                                },
                                                                {
                                                                    "id": "726520138",
                                                                    "speaker": "Muzhen",
                                                                    "text": "I would hazard a guess that we're most likely to find good leads if we investigate these anomalous areas first."
                                                                },
                                                                {
                                                                    "id": "726520139",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Should you find any by-products from those phenomena, please bring them back here for me to study."
                                                                },
                                                                {
                                                                    "id": "726520140",
                                                                    "speaker": "Muzhen",
                                                                    "text": "As for remuneration, don't worry, I've got you covered on that front."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726520125",
                                                            "text": "Mechanical organisms?",
                                                            "response": [
                                                                {
                                                                    "id": "726520126",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Aye. The miners at The Chasm once dug up similar things. Word is that they're related to the disaster that happened five hundred years ago."
                                                                },
                                                                {
                                                                    "id": "726520127",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Whatever the case, they're an ominous bunch, wandering through the ruins as they do. Gets me scared and excited all at once..."
                                                                },
                                                                {
                                                                    "id": "726520128",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Just thinking about one of them makes my hands itch. Wish I could pry one open and have a look inside..."
                                                                },
                                                                {
                                                                    "id": "726520129",
                                                                    "speaker": "Muzhen",
                                                                    "text": "It's alright if you don't understand. You're not a technician, after all."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726520130",
                                                            "text": "Interesting, you say...",
                                                            "response": [
                                                                {
                                                                    "id": "726520131",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Well, I mean... Wouldn't you want to open one up yourself?"
                                                                },
                                                                {
                                                                    "id": "726520132",
                                                                    "speaker": "Paimon",
                                                                    "text": "Not... really...?"
                                                                },
                                                                {
                                                                    "id": "726520133",
                                                                    "speaker": "Muzhen",
                                                                    "text": "Hmph. Alright then... I guess only a fellow technician would understand how I feel."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726520110",
                                            "text": "Do you need a hand with anything?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726520103",
                            "text": "Do I know you?"
                        }
                    ]
                }
            ]
        },
        {
