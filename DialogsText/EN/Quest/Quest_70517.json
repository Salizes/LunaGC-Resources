    "talks": [
        {
            "id": "7051701",
            "objective": "Go to the spot Paimon mentioned",
            "dialogues": [
                {
                    "id": "705170101",
                    "speaker": "Paimon",
                    "text": "This place sure looks pretty normal."
                },
                {
                    "id": "705170102",
                    "speaker": "Paimon",
                    "text": "Guess there won't be anything to eat here...",
                    "choices": [
                        {
                            "id": "705170103",
                            "text": "Don't give yourself away too soon, Paimon.",
                            "response": [
                                {
                                    "id": "705170105",
                                    "speaker": "Paimon",
                                    "text": "*cough* W—Well, y'know, looking for secrets is hungry work! Everyone knows that!"
                                },
                                {
                                    "id": "705170106",
                                    "speaker": "Paimon",
                                    "text": "And anyway, we've recently been eating barbecue a lot to save time. Aren't you sick of that already?"
                                },
                                {
                                    "id": "705170107",
                                    "speaker": "Paimon",
                                    "text": "If we can find some shells or conches, we can stew them with some fruit."
                                },
                                {
                                    "id": "705170108",
                                    "speaker": "Paimon",
                                    "text": "They'll be fresh and sweet and springy...",
                                    "choices": [
                                        {
                                            "id": "705170109",
                                            "text": "That sounds pretty terrible. Not my cup of tea.",
                                            "response": [
                                                {
                                                    "id": "705170110",
                                                    "speaker": "Paimon",
                                                    "text": "Come on, give it go! It might open a whole new culinary world to you!"
                                                },
                                                {
                                                    "id": "705170113",
                                                    "speaker": "Paimon",
                                                    "text": "#Wait a moment! Look over there, {NICKNAME}."
                                                },
                                                {
                                                    "id": "705170114",
                                                    "speaker": "Paimon",
                                                    "text": "That's weird, that device just appeared all of a sudden."
                                                },
                                                {
                                                    "id": "705170115",
                                                    "speaker": "Paimon",
                                                    "text": "And there's some luggage nearby, too. Is that Fatui gear?"
                                                },
                                                {
                                                    "id": "705170116",
                                                    "speaker": "Player",
                                                    "text": "Huh. Right on the Mora, Paimon. Good work."
                                                },
                                                {
                                                    "id": "705170117",
                                                    "speaker": "Paimon",
                                                    "text": "Right? Paimon was right on the Mora..."
                                                },
                                                {
                                                    "id": "705170118",
                                                    "speaker": "Paimon",
                                                    "text": "Waaait a moment. There's nothing good about this discovery!"
                                                },
                                                {
                                                    "id": "705170119",
                                                    "speaker": "Paimon",
                                                    "text": "If this is Fatui business, then there's gotta be some scheme afoot!"
                                                },
                                                {
                                                    "id": "705170120",
                                                    "speaker": "Paimon",
                                                    "text": "If we leave this thing be, things might eventually get out of control."
                                                },
                                                {
                                                    "id": "705170121",
                                                    "speaker": "Paimon",
                                                    "text": "Whatever the case, let's see what we can do about that device first. If you think we should, let's have a look through that Fatui gear."
                                                },
                                                {
                                                    "id": "705170122",
                                                    "speaker": "Paimon",
                                                    "text": "#Let's do this like we always do, {NICKNAME}, and then we can kick back and start looking for something to eat instead!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705170111",
                                            "text": "Sounds like how you'd taste, Paimon.",
                                            "response": [
                                                {
                                                    "id": "705170112",
                                                    "speaker": "Paimon",
                                                    "text": "Hey! Paimon isn't some aquacultural product!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705170104",
                            "text": "Well, that's your enthusiasm explained..."
                        }
                    ]
                }
            ]
        }
    ]
