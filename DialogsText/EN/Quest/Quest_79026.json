    "talks": [
        {
            "id": "7902601",
            "objective": "",
            "dialogues": [
                {
                    "id": "790260101",
                    "speaker": "Twilight Theater Head",
                    "text": "Welcome! Welcome!"
                },
                {
                    "id": "790260102",
                    "speaker": "Twilight Theater Head",
                    "text": "Welcome!"
                },
                {
                    "id": "790260104",
                    "speaker": "Twilight Theater Head",
                    "text": "#You must be the world-famous {NICKNAME}! And this must be the Traveler's best companion, Paimon!"
                },
                {
                    "id": "790260105",
                    "speaker": "Paimon",
                    "text": "Wow! How did you know our names?"
                },
                {
                    "id": "790260106",
                    "speaker": "Twilight Theater Head",
                    "text": "You are the island's most distinguished guests, of course I know who you are! After all, I am..."
                },
                {
                    "id": "790260107",
                    "speaker": "Paimon",
                    "text": "You are...?"
                },
                {
                    "id": "790260108",
                    "speaker": "Twilight Theater Head",
                    "text": "I am the world-famous Head of Twilight Theater!"
                },
                {
                    "id": "790260109",
                    "speaker": "Player",
                    "text": "I can't believe someone would call himself world-famous."
                },
                {
                    "id": "790260110",
                    "speaker": "Paimon",
                    "text": "You say you're world-famous, but we've never heard of you."
                },
                {
                    "id": "790260111",
                    "speaker": "Twilight Theater Head",
                    "text": "It's fine! Now you have!"
                },
                {
                    "id": "790260112",
                    "speaker": "Twilight Theater Head",
                    "text": "After a painstaking amount of work, our play, \"Tale of the Sword-Wielding Princess,\" is finally ready for the stage!"
                },
                {
                    "id": "790260113",
                    "speaker": "Twilight Theater Head",
                    "text": "There are five acts in this play, each with two scenes..."
                },
                {
                    "id": "790260114",
                    "speaker": "Twilight Theater Head",
                    "text": "My distinguished guests, you have come at the perfect time! The show is about to start! Please take a seat!"
                },
                {
                    "id": "790260115",
                    "speaker": "Twilight Theater Head",
                    "text": "I still need to take care of something backstage. Please excuse me."
                },
                {
                    "id": "790260116",
                    "speaker": "Twilight Theater Head",
                    "text": "You are about to witness the debut of Twilight Theater's best ever play! Please sit back and enjoy!"
                }
            ]
        },
