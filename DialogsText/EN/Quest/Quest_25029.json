    "talks": [
        {
            "id": "2502901",
            "objective": "Talk to Tlatem",
            "dialogues": [
                {
                    "id": "250290101",
                    "speaker": "Tlatem",
                    "text": "Come on, don't be discouraged. You just need to get well, and... keep trying! You'll make it to the mountaintop in no time!"
                },
                {
                    "id": "250290102",
                    "speaker": "Qica",
                    "text": "Grooo... Groooo..."
                },
                {
                    "id": "250290103",
                    "speaker": "Tlatem",
                    "text": "Are you hungry? Hmm... Then why don't I get you something to eat?"
                },
                {
                    "id": "250290104",
                    "speaker": "Qica",
                    "text": "Hroo... Oroo..."
                },
                {
                    "id": "250290105",
                    "speaker": "Player",
                    "text": "What are you up to?"
                },
                {
                    "id": "250290106",
                    "speaker": "Tlatem",
                    "text": "I'm playing with my buddy Qica. He's still small, but Mom says he'll be the equal of any other Yumkasaurus when he grows up!"
                },
                {
                    "id": "250290107",
                    "speaker": "Qica",
                    "text": "Hroo... Rroooh..."
                },
                {
                    "id": "250290108",
                    "speaker": "Tlatem",
                    "text": "Don't be sad. Your body's just too frail at the moment, and you were injured previously to boot."
                },
                {
                    "id": "250290109",
                    "speaker": "Tlatem",
                    "text": "Mom says you'll get better for sure. You've just gotta eat well and train with me."
                },
                {
                    "id": "250290110",
                    "speaker": "Qica",
                    "text": "Rooh? Rrrooh...",
                    "choices": [
                        {
                            "id": "250290111",
                            "text": "(Pet Qica.)",
                            "response": [
                                {
                                    "id": "250290112",
                                    "speaker": "Qica",
                                    "text": "Grooo... Groooo..."
                                },
                                {
                                    "id": "250290119",
                                    "speaker": "Tlatem",
                                    "text": "Haha. Well, would you look at the time? We've got training coming up soon, so let's get eating!"
                                },
                                {
                                    "id": "250290120",
                                    "speaker": "Tlatem",
                                    "text": "Mom made these dried fruits, you know! Fried them in a big pot before adding lots of nice-smelling condiments..."
                                },
                                {
                                    "id": "250290121",
                                    "speaker": "Tlatem",
                                    "text": "Right, and she sprinkled in lots of sugar and petals, too... Either way, it tastes great! Just a moment, I'll give you some..."
                                },
                                {
                                    "id": "250290122",
                                    "speaker": "Tlatem",
                                    "text": "Wait. Where'd my dried fruits go? I'm sure I put them in my bag..."
                                },
                                {
                                    "id": "250290123",
                                    "speaker": "Qica",
                                    "text": "...Hroo, rrooo..."
                                },
                                {
                                    "id": "250290124",
                                    "speaker": "Tlatem",
                                    "text": "Whoa! Qica! Did you eat it all? C'mon, I've told you not to get greedy... You're gonna have trouble moving around if you eat too much!"
                                },
                                {
                                    "id": "250290125",
                                    "speaker": "Qica",
                                    "text": "...Rrooh, oroo...",
                                    "choices": [
                                        {
                                            "id": "250290126",
                                            "text": "Well, it's good to have an appetite.",
                                            "response": [
                                                {
                                                    "id": "250290128",
                                                    "speaker": "Qica",
                                                    "text": "Hroo, rroooh!"
                                                },
                                                {
                                                    "id": "250290129",
                                                    "speaker": "Tlatem",
                                                    "text": "Is that so? In that case... I wanna be like Qica. I wanna eat lots, get bigger fast, and help Mom out."
                                                },
                                                {
                                                    "id": "250290130",
                                                    "speaker": "Tlatem",
                                                    "text": "Alright then, Qica! Let's get training!"
                                                },
                                                {
                                                    "id": "250290131",
                                                    "speaker": "Qica",
                                                    "text": "Roar!"
                                                },
                                                {
                                                    "id": "250290132",
                                                    "speaker": "Tlatem",
                                                    "text": "Let's see... How about we practice mountain climbing today?"
                                                },
                                                {
                                                    "id": "250290133",
                                                    "speaker": "Qica",
                                                    "text": "R—Roar..."
                                                },
                                                {
                                                    "id": "250290134",
                                                    "speaker": "Tlatem",
                                                    "text": "Oh come on, keep your chin up! We'll do it just like last time. It won't be too hard at all!"
                                                },
                                                {
                                                    "id": "250290135",
                                                    "speaker": "Qica",
                                                    "text": "...Roar!"
                                                },
                                                {
                                                    "id": "250290136",
                                                    "speaker": "Tlatem",
                                                    "text": "Right, Uncle Yawar told me last time that we'll have to find a reasonable \"training goal\" if we're gonna train right..."
                                                },
                                                {
                                                    "id": "250290137",
                                                    "speaker": "Tlatem",
                                                    "text": "Now, if only I could find a proper adventurer, and get them to help set some targets...",
                                                    "choices": [
                                                        {
                                                            "id": "250290138",
                                                            "text": "I'm pretty decent as adventurers go...",
                                                            "response": [
                                                                {
                                                                    "id": "250290140",
                                                                    "speaker": "Tlatem",
                                                                    "text": "Really? Uh, then... Would you mind helping me?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "250290141",
                                                                            "text": "Need me to take you mountain climbing?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "250290143",
                                                                                    "speaker": "Tlatem",
                                                                                    "text": "No no, wait. If you're that good, there's no way we'll be able to keep up with you."
                                                                                },
                                                                                {
                                                                                    "id": "250290144",
                                                                                    "speaker": "Tlatem",
                                                                                    "text": "So what we'll do is time you while you climb."
                                                                                },
                                                                                {
                                                                                    "id": "250290145",
                                                                                    "speaker": "Tlatem",
                                                                                    "text": "Alright then. Climb that mountain as fast as you can. We're counting on you!"
                                                                                },
                                                                                {
                                                                                    "id": "250290146",
                                                                                    "speaker": "Qica",
                                                                                    "text": "Rawr! Rrooh!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "250290142",
                                                                            "text": "Alright then. Follow me, let's get started!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "250290139",
                                                            "text": "Proper adventurer, you say? Look no further."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250290127",
                                            "text": "He who eats more grows more."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250290113",
                            "text": "How did he get hurt?",
                            "response": [
                                {
                                    "id": "250290114",
                                    "speaker": "Tlatem",
                                    "text": "I don't know... but maybe Mom does! Qica was already ill when she brought him in."
                                },
                                {
                                    "id": "250290115",
                                    "speaker": "Tlatem",
                                    "text": "He couldn't eat and didn't even have the strength to move. All I could do was dissolve some medicine in water and have him drink it every day."
                                },
                                {
                                    "id": "250290116",
                                    "speaker": "Tlatem",
                                    "text": "He recovered in the end, but... his body is still really weak, so he can't scamper all over the cliffsides like the other Yumkasaurs."
                                },
                                {
                                    "id": "250290117",
                                    "speaker": "Tlatem",
                                    "text": "That's really upsetting for him, so I'm trying to help him get back into tip-top shape... stronger than any other Yumkasaurus!"
                                },
                                {
                                    "id": "250290118",
                                    "speaker": "Qica",
                                    "text": "Roar!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502902",
            "objective": "Climb to the top of the mountain",
            "dialogues": [
                {
                    "id": "250290201",
                    "speaker": "Tlatem",
                    "text": "Good boy, good boy! Eaten your fill today? Ready to train?"
                },
                {
                    "id": "250290202",
                    "speaker": "Qica",
                    "text": "Raar, oroo, rrooh!"
                },
                {
                    "id": "250290203",
                    "speaker": "Tlatem",
                    "text": "Pretty energetic today, aren't we? Awesome! Let's do this!"
                },
                {
                    "id": "250290204",
                    "speaker": "Player",
                    "text": "Yeah, let's do this!"
                },
                {
                    "id": "250290206",
                    "speaker": "Tlatem",
                    "text": "Huh? Oh, hello there! We're doing some more mountain climbing training right now."
                },
                {
                    "id": "250290207",
                    "speaker": "Qica",
                    "text": "Rroo! Wrroo!"
                },
                {
                    "id": "250290208",
                    "speaker": "Qica",
                    "text": "Wrooo, rrooh...",
                    "choices": [
                        {
                            "id": "250290209",
                            "text": "How's the training coming along?",
                            "response": [
                                {
                                    "id": "250290210",
                                    "speaker": "Tlatem",
                                    "text": "Well... we're \"making progress.\" Qica's made it up a lot further this time."
                                },
                                {
                                    "id": "250290211",
                                    "speaker": "Tlatem",
                                    "text": "It's just that Qica's not very familiar with how you climb mountains, and..."
                                },
                                {
                                    "id": "250290216",
                                    "speaker": "Tlatem",
                                    "text": "Could you demonstrate for us again, by the way?",
                                    "choices": [
                                        {
                                            "id": "250290217",
                                            "text": "Sure I can.",
                                            "response": [
                                                {
                                                    "id": "250290218",
                                                    "speaker": "Tlatem",
                                                    "text": "Thank you so much! I'm sure I'll be able to catch your movements this time."
                                                },
                                                {
                                                    "id": "250290219",
                                                    "speaker": "Tlatem",
                                                    "text": "You keep your eyes peeled too, alright, Qica?"
                                                },
                                                {
                                                    "id": "250290220",
                                                    "speaker": "Qica",
                                                    "text": "Roar!"
                                                },
                                                {
                                                    "id": "250290223",
                                                    "speaker": "Tlatem",
                                                    "text": "We're counting on you!"
                                                },
                                                {
                                                    "id": "250290224",
                                                    "speaker": "Tlatem",
                                                    "text": "So what we'll do is time you while you climb."
                                                },
                                                {
                                                    "id": "250290225",
                                                    "speaker": "Qica",
                                                    "text": "Hrroo, roooh..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "250290221",
                                            "text": "Watch closely this time, alright?",
                                            "response": [
                                                {
                                                    "id": "250290222",
                                                    "speaker": "Tlatem",
                                                    "text": "Of course! Qica and I won't miss a thing this time!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "250290212",
                            "text": "Looks like he's recovering nicely.",
                            "response": [
                                {
                                    "id": "250290213",
                                    "speaker": "Tlatem",
                                    "text": "That's right. Mom says I'm getting real good at caring for him."
                                },
                                {
                                    "id": "250290214",
                                    "speaker": "Tlatem",
                                    "text": "Qica's improved loads. He can climb way higher than he could last time."
                                },
                                {
                                    "id": "250290215",
                                    "speaker": "Tlatem",
                                    "text": "It's just that Qica's not very familiar with how you climb mountains, and..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502903",
            "objective": "",
            "dialogues": [
                {
                    "id": "250290301",
                    "speaker": "Tlatem",
                    "text": "You're amazing! You're just about as fast as Mayta!",
                    "choices": [
                        {
                            "id": "250290302",
                            "text": "H—Heh, it didn't quite go as well as I'd hoped...",
                            "response": [
                                {
                                    "id": "250290303",
                                    "speaker": "Tlatem",
                                    "text": "Really? You mean you could've been faster still? Wow. Guess you really are an expert adventurer, huh..."
                                },
                                {
                                    "id": "250290306",
                                    "speaker": "Tlatem",
                                    "text": "If we set this time as our goal... Hmm..."
                                },
                                {
                                    "id": "250290307",
                                    "speaker": "Qica",
                                    "text": "Hrroo, roooh..."
                                },
                                {
                                    "id": "250290308",
                                    "speaker": "Tlatem",
                                    "text": "...Yeah, I know, it's going to be a bit difficult for you, huh?"
                                },
                                {
                                    "id": "250290309",
                                    "speaker": "Tlatem",
                                    "text": "Guess I'll go show Mayta your climbing time. Maybe he can come up with a more... reasonable training plan for us?"
                                },
                                {
                                    "id": "250290310",
                                    "speaker": "Tlatem",
                                    "text": "Anyway, thanks a lot for your help. Here, have this Cacahuatl!"
                                },
                                {
                                    "id": "250290311",
                                    "speaker": "Tlatem",
                                    "text": "We picked it ourselves, so it's super fresh, and it'll make super tasty chocolate!"
                                },
                                {
                                    "id": "250290312",
                                    "speaker": "Qica",
                                    "text": "Orrooo, orrooo!"
                                },
                                {
                                    "id": "250290313",
                                    "speaker": "Tlatem",
                                    "text": "In that case, we'll head out now. I wonder if Mayta's back at the settlement. He hasn't gone out climbing again, has he..."
                                }
                            ]
                        },
                        {
                            "id": "250290304",
                            "text": "Who's Mayta?",
                            "response": [
                                {
                                    "id": "250290305",
                                    "speaker": "Tlatem",
                                    "text": "He's a friend of mine who's real good at mountain climbing. Apart from Big Sis Roca, almost no one's his match."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2502905",
            "objective": "",
            "dialogues": [
                {
                    "id": "250290601",
                    "speaker": "Paimon",
                    "text": ""
                }
