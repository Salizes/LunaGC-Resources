    "talks": [
        {
            "id": "7268301",
            "objective": "Go look at the person drawing",
            "dialogues": [
                {
                    "id": "726830101",
                    "speaker": "Asagiri",
                    "text": "*cough* No... This is still no good... It won't do..."
                },
                {
                    "id": "726830102",
                    "speaker": "Asagiri",
                    "text": "Any further delay and I'll miss the next submission deadline... *sob*...",
                    "choices": [
                        {
                            "id": "726830103",
                            "text": "Hello...",
                            "response": [
                                {
                                    "id": "726830105",
                                    "speaker": "Asagiri",
                                    "text": "Huh!?"
                                },
                                {
                                    "id": "726830106",
                                    "speaker": "Asagiri",
                                    "text": "I'm sorry—soooo sorry! I will submit it today!"
                                },
                                {
                                    "id": "726830107",
                                    "speaker": "Paimon",
                                    "text": "Whoa! Hang on, we..."
                                },
                                {
                                    "id": "726830108",
                                    "speaker": "Asagiri",
                                    "text": "Miss Moriko, please just give me..."
                                },
                                {
                                    "id": "726830109",
                                    "speaker": "Asagiri",
                                    "text": "Huh? So you aren't Miss Moriko... Thank goodness... Ugh *coughing*"
                                },
                                {
                                    "id": "726830110",
                                    "speaker": "Player",
                                    "text": "So who is Miss Moriko..."
                                },
                                {
                                    "id": "726830111",
                                    "speaker": "Asagiri",
                                    "text": "Miss Moriko is my executive editor."
                                },
                                {
                                    "id": "726830112",
                                    "speaker": "Asagiri",
                                    "text": "My name is Asagiri. I'm a, um, a freelance illustrator of sorts. Miss Moriko is... the executive editor in charge of my work."
                                },
                                {
                                    "id": "726830113",
                                    "speaker": "Paimon",
                                    "text": "An illustrator? What does that mean?"
                                },
                                {
                                    "id": "726830114",
                                    "speaker": "Asagiri",
                                    "text": "I suppose you've read some light novels of Yae Publishing House, haven't you?"
                                },
                                {
                                    "id": "726830115",
                                    "speaker": "Asagiri",
                                    "text": "Have you noticed that a light novel usually contains a few pages of pure pictures?"
                                },
                                {
                                    "id": "726830116",
                                    "speaker": "Asagiri",
                                    "text": "Such pictures are what we call illustrations, and those who draw them are illustrators."
                                },
                                {
                                    "id": "726830117",
                                    "speaker": "Asagiri",
                                    "text": "To serve an important scene or plot, or to give the protagonist a face, some authors will have people draw them an illustration."
                                },
                                {
                                    "id": "726830118",
                                    "speaker": "Asagiri",
                                    "text": "The illustration not only creates a more immersive reading experience but also enriches the novel."
                                },
                                {
                                    "id": "726830119",
                                    "speaker": "Paimon",
                                    "text": "Oh, Paimon gets it now. It's no simple business to make light novels..."
                                },
                                {
                                    "id": "726830120",
                                    "speaker": "Asagiri",
                                    "text": "I can recommend a few novels to you! For example... ahem! *coughing*"
                                },
                                {
                                    "id": "726830121",
                                    "speaker": "Player",
                                    "text": "Are you alright?"
                                },
                                {
                                    "id": "726830122",
                                    "speaker": "Asagiri",
                                    "text": "I'm fine. I've never been very healthy — with all the midnight-oil burning and meal skipping during my work..."
                                },
                                {
                                    "id": "726830123",
                                    "speaker": "Asagiri",
                                    "text": "*cough* As a result, my health keeps deteriorating..."
                                },
                                {
                                    "id": "726830124",
                                    "speaker": "Paimon",
                                    "text": "Since you're unwell, why are you still working here out in the open? Can't you draw at home?"
                                },
                                {
                                    "id": "726830125",
                                    "speaker": "Asagiri",
                                    "text": "I'm here to gather some inspiration."
                                },
                                {
                                    "id": "726830126",
                                    "speaker": "Asagiri",
                                    "text": "My muse has left me recently. I've missed the deadlines for a few illustrations."
                                },
                                {
                                    "id": "726830127",
                                    "speaker": "Asagiri",
                                    "text": "Miss Moriko has postponed the deadlines for me several times. She'll be so mad if I dare delay any further."
                                },
                                {
                                    "id": "726830128",
                                    "speaker": "Asagiri",
                                    "text": "I was thinking that maybe a walk in the open would bring my muse back, so I decided to go on a trip."
                                },
                                {
                                    "id": "726830129",
                                    "speaker": "Asagiri",
                                    "text": "But as it turned out... Haha... You see, it hadn't taken long before I ended up in this miserable state..."
                                },
                                {
                                    "id": "726830130",
                                    "speaker": "Asagiri",
                                    "text": "*sigh* I'd better put up a request at the Adventurers' Guild and see if any adventurer with a Kamera can help out."
                                },
                                {
                                    "id": "726830131",
                                    "speaker": "Paimon",
                                    "text": "Huh? Speaking of the Kamera...",
                                    "choices": [
                                        {
                                            "id": "726830132",
                                            "text": "I do have one...",
                                            "response": [
                                                {
                                                    "id": "726830133",
                                                    "speaker": "Asagiri",
                                                    "text": "Really!? You have a Kamera?"
                                                },
                                                {
                                                    "id": "726830135",
                                                    "speaker": "Asagiri",
                                                    "text": "I—I wanted to have an adventurer take pictures for me using the Kamera!"
                                                },
                                                {
                                                    "id": "726830136",
                                                    "speaker": "Asagiri",
                                                    "text": "I've heard about many fascinating locations out there — say, the lofty snow mountain near Mondstadt and the area in Liyue where there are many pillars..."
                                                },
                                                {
                                                    "id": "726830137",
                                                    "speaker": "Asagiri",
                                                    "text": "And what's more! There's this place named \"Jueyun Karst.\" They say that the adepti live there!"
                                                },
                                                {
                                                    "id": "726830138",
                                                    "speaker": "Asagiri",
                                                    "text": "The abode of the adepti... The thought of it gives me thrills..."
                                                },
                                                {
                                                    "id": "726830139",
                                                    "speaker": "Asagiri",
                                                    "text": "But sadly, my health doesn't allow me to really go there..."
                                                },
                                                {
                                                    "id": "726830140",
                                                    "speaker": "Asagiri",
                                                    "text": "However, if you can capture their sceneries with the Kamera, I can surely... Ugh *coughing*"
                                                },
                                                {
                                                    "id": "726830141",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa! Take it easy!",
                                                    "choices": [
                                                        {
                                                            "id": "726830142",
                                                            "text": "Leave it to me.",
                                                            "response": [
                                                                {
                                                                    "id": "726830144",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Really!? That's wonderful! There are many places on my wish list. Gimme a second. Let me find the list."
                                                                },
                                                                {
                                                                    "id": "726830145",
                                                                    "speaker": "Asagiri",
                                                                    "text": "And don't you worry about the finances. I have quite some savings."
                                                                },
                                                                {
                                                                    "id": "726830146",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Where is my notebook? Where is it? My notebook..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726830143",
                                                            "text": "I will work this out."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726830134",
                                            "text": "But what can it do?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726830104",
                            "text": "Excuse me..."
                        }
                    ]
                }
            ]
        },
