    "talks": [
        {
            "id": "7603601",
            "objective": "Meet The Damselette",
            "dialogues": [
                {
                    "id": "760360101",
                    "speaker": "The Damselette",
                    "text": "Not this blue, then?"
                },
                {
                    "id": "760360102",
                    "speaker": "Kuuhenki",
                    "text": "...",
                    "choices": [
                        {
                            "id": "760360103",
                            "text": "Columbina?",
                            "response": [
                                {
                                    "id": "760360105",
                                    "speaker": "The Damselette",
                                    "text": "Oh? It's you."
                                },
                                {
                                    "id": "760360106",
                                    "speaker": "The Damselette",
                                    "text": "Could you help me? I'll be sure to return the favor."
                                },
                                {
                                    "id": "760360107",
                                    "speaker": "Paimon",
                                    "text": "Are you kidding? You know you don't owe us anything, right...",
                                    "choices": [
                                        {
                                            "id": "760360108",
                                            "text": "You've helped us a lot in the past...",
                                            "response": [
                                                {
                                                    "id": "760360110",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah. We'd help you even if you had nothing to give us."
                                                },
                                                {
                                                    "id": "760360111",
                                                    "speaker": "Paimon",
                                                    "text": "So, what sorta help do you need?"
                                                },
                                                {
                                                    "id": "760360112",
                                                    "speaker": "The Damselette",
                                                    "text": "Well... To be precise, this creature is the one that needs help."
                                                },
                                                {
                                                    "id": "760360113",
                                                    "speaker": "Kuuhenki",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "760360114",
                                                    "speaker": "Paimon",
                                                    "text": "The kuuhenki?"
                                                },
                                                {
                                                    "id": "760360115",
                                                    "speaker": "The Damselette",
                                                    "text": "Yes. This little one procured a paint brush somewhere, and upon returning to my side, proceeded to swish about happily."
                                                },
                                                {
                                                    "id": "760360116",
                                                    "speaker": "The Damselette",
                                                    "text": "I found a canvas and some paint for her, but though some time has passed, her attempts to mix the colors she desires have met with little success."
                                                },
                                                {
                                                    "id": "760360117",
                                                    "speaker": "Luonnotar",
                                                    "text": "...!"
                                                },
                                                {
                                                    "id": "760360118",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa, where did you come from?"
                                                },
                                                {
                                                    "id": "760360119",
                                                    "speaker": "Luonnotar",
                                                    "text": "!!!"
                                                },
                                                {
                                                    "id": "760360120",
                                                    "speaker": "Kuuhenki",
                                                    "text": "??"
                                                },
                                                {
                                                    "id": "760360121",
                                                    "speaker": "Luonnotar",
                                                    "text": "...!"
                                                },
                                                {
                                                    "id": "760360122",
                                                    "speaker": "Paimon",
                                                    "text": "Uh... Are we playing charades? Sorry. We didn't catch any of that.."
                                                },
                                                {
                                                    "id": "760360123",
                                                    "speaker": "Luonnotar",
                                                    "text": "..."
                                                },
                                                {
                                                    "id": "760360124",
                                                    "speaker": "Luonnotar",
                                                    "text": "!!!"
                                                },
                                                {
                                                    "id": "760360125",
                                                    "speaker": "Kuuhenki",
                                                    "text": "!!!"
                                                },
                                                {
                                                    "id": "760360126",
                                                    "speaker": "Paimon",
                                                    "text": "Huh, looks like she's taken an interest in your pack."
                                                },
                                                {
                                                    "id": "760360127",
                                                    "speaker": "The Damselette",
                                                    "text": "Perhaps you carry suitable colors on your person?"
                                                },
                                                {
                                                    "id": "760360128",
                                                    "speaker": "Paimon",
                                                    "text": "Uh, we don't usually carry around stuff like that... Speaking of which, where did you find the paint? No offense, but you, uh, don't look like the painting sort."
                                                },
                                                {
                                                    "id": "760360129",
                                                    "speaker": "The Damselette",
                                                    "text": "This little one was quite impatient, so I made some paint using the colorful flowers nearby."
                                                },
                                                {
                                                    "id": "760360130",
                                                    "speaker": "Paimon",
                                                    "text": "Huh, could Luonnotar be looking for other colorful things to make paint with, then?"
                                                },
                                                {
                                                    "id": "760360131",
                                                    "speaker": "Paimon",
                                                    "text": "C'mon, let's see what we've got in our packs."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760360109",
                                            "text": "It's us who should be \"returning the favor\"..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760360104",
                            "text": "What happened?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603602",
            "objective": "Give the kuuhenki some objects with vivid colors",
            "dialogues": [
                {
                    "id": "760360201",
                    "speaker": "Kuuhenki",
                    "text": "!!!"
                },
                {
                    "id": "760360202",
                    "speaker": "Paimon",
                    "text": "Okay, relax, don't worry, we're searching. Colorful plants from Nod-Krai would be the number-one choice, right?"
                }
            ]
        },
        {
            "id": "7603603",
            "objective": "Talk to the kuuhenki",
            "dialogues": [
                {
                    "id": "760360301",
                    "speaker": "Paimon",
                    "text": "Will these do?"
                },
                {
                    "id": "760360302",
                    "speaker": "The Damselette",
                    "text": "Yes. The kuuhenki looks quite satisfied."
                },
                {
                    "id": "760360303",
                    "speaker": "Maalaus",
                    "text": "!"
                },
                {
                    "id": "760360304",
                    "speaker": "Paimon",
                    "text": "Man, Paimon never knew kuuhenki could do art."
                },
                {
                    "id": "760360305",
                    "speaker": "The Damselette",
                    "text": "Kuuhenki are much like us, in truth. Each one has its own personality and hobbies."
                },
                {
                    "id": "760360306",
                    "speaker": "Paimon",
                    "text": "Wait, does that mean you can tell all the kuuhenki in Nod-Krai apart from each other?"
                },
                {
                    "id": "760360307",
                    "speaker": "The Damselette",
                    "text": "The ones I've met, yes."
                },
                {
                    "id": "760360308",
                    "speaker": "Paimon",
                    "text": "That's impressive! Especially because, other than Luonnotar, all the other kuuhenki kinda look the same..."
                },
                {
                    "id": "760360309",
                    "speaker": "Paimon",
                    "text": "So, what is this little painter's name?"
                },
                {
                    "id": "760360310",
                    "speaker": "The Damselette",
                    "text": "Name...?"
                },
                {
                    "id": "760360311",
                    "speaker": "Paimon",
                    "text": "Wait... They do have names, don't they?"
                },
                {
                    "id": "760360312",
                    "speaker": "The Damselette",
                    "text": "We recognize each other, and that's enough. We don't need names... I don't have one either."
                },
                {
                    "id": "760360313",
                    "speaker": "Paimon",
                    "text": "That doesn't mean mean you have to continue the cycle!"
                },
                {
                    "id": "760360314",
                    "speaker": "Paimon",
                    "text": "Hmm... Let's think... \"Luonnotar\" means \"a creature born beneath the Moon Goddess's blessing\"..."
                },
                {
                    "id": "760360315",
                    "speaker": "Paimon",
                    "text": "So... What would \"painting\" be in the language of the Frostmoon Scions?"
                },
                {
                    "id": "760360316",
                    "speaker": "The Damselette",
                    "text": "I think it would be... Maa... naus? Maalaus? Yes. Maalaus."
                },
                {
                    "id": "760360317",
                    "speaker": "Paimon",
                    "text": "Ooh, sounds nice! Let's go with that!"
                },
                {
                    "id": "760360318",
                    "speaker": "Maalaus",
                    "text": "??"
                },
                {
                    "id": "760360319",
                    "speaker": "Paimon",
                    "text": "What is it, Maalaus? Done with your painting?"
                },
                {
                    "id": "760360320",
                    "speaker": "Maalaus",
                    "text": "!!!"
                },
                {
                    "id": "760360321",
                    "speaker": "Paimon",
                    "text": "Ooh! Let's see, let's see... Whoa. What in the...!"
                },
                {
                    "id": "760360322",
                    "speaker": "Player",
                    "text": "What's the matter?"
                },
                {
                    "id": "760360323",
                    "speaker": "Paimon",
                    "text": "This is amazing!"
                },
                {
                    "id": "760360324",
                    "speaker": "Paimon",
                    "text": "Paimon was expecting something a lot more childish... or, y'know, Melusine-like..."
                },
                {
                    "id": "760360325",
                    "speaker": "The Damselette",
                    "text": "The kuuhenki are adept at sensing their surroundings. When it comes to recreating what they've seen, they tend to capture things exactly as they were."
                },
                {
                    "id": "760360326",
                    "speaker": "Player",
                    "text": "So, is this a drawing of Columbina, Maalaus?"
                },
                {
                    "id": "760360327",
                    "speaker": "Maalaus",
                    "text": "!!!"
                },
                {
                    "id": "760360328",
                    "speaker": "The Damselette",
                    "text": "Hm...?"
                },
                {
                    "id": "760360329",
                    "speaker": "Paimon",
                    "text": "...It looks like Columbina when she was first born."
                },
                {
                    "id": "760360330",
                    "speaker": "The Damselette",
                    "text": "Huh?"
                },
                {
                    "id": "760360331",
                    "speaker": "Paimon",
                    "text": "Lauma said your birth was recorded by the Frostmoon Scions... But, this painting does look a bit different.",
                    "choices": [
                        {
                            "id": "760360332",
                            "text": "And kuuhenki...",
                            "response": [
                                {
                                    "id": "760360334",
                                    "speaker": "The Damselette",
                                    "text": "This little one, Maalaus, was one of the first kuuhenki born. It's possible this is Maalaus' interpretation of how things looked back then."
                                },
                                {
                                    "id": "760360335",
                                    "speaker": "Paimon",
                                    "text": "Seems like you're trying to help us get to know your goddess, huh, Maalaus?"
                                },
                                {
                                    "id": "760360336",
                                    "speaker": "Maalaus",
                                    "text": "!"
                                },
                                {
                                    "id": "760360337",
                                    "speaker": "The Damselette",
                                    "text": "..."
                                },
                                {
                                    "id": "760360338",
                                    "speaker": "Paimon",
                                    "text": "Don't worry, Maalaus. We appreciate it! We're all friends here!"
                                },
                                {
                                    "id": "760360339",
                                    "speaker": "Maalaus",
                                    "text": "!!!"
                                },
                                {
                                    "id": "760360340",
                                    "speaker": "Paimon",
                                    "text": "Wow, that was quick. You've finished another painting already?"
                                },
                                {
                                    "id": "760360341",
                                    "speaker": "The Damselette",
                                    "text": "...?"
                                },
                                {
                                    "id": "760360342",
                                    "speaker": "Paimon",
                                    "text": "This... must depict the Frostmoon Scions worshipping Columbina as their goddess."
                                },
                                {
                                    "id": "760360343",
                                    "speaker": "Paimon",
                                    "text": "Hmm? What's she doing by the altar? The details are too small to make out."
                                },
                                {
                                    "id": "760360344",
                                    "speaker": "Maalaus",
                                    "text": "!"
                                },
                                {
                                    "id": "760360345",
                                    "speaker": "Paimon",
                                    "text": "Oh, so she was eating the offerings!"
                                },
                                {
                                    "id": "760360346",
                                    "speaker": "The Damselette",
                                    "text": "...Was I not supposed to?"
                                },
                                {
                                    "id": "760360347",
                                    "speaker": "Paimon",
                                    "text": "Oh, no no no. It's just a bit, um... unconventional?"
                                },
                                {
                                    "id": "760360348",
                                    "speaker": "Player",
                                    "text": "Looks like you were having a good time..."
                                },
                                {
                                    "id": "760360349",
                                    "speaker": "The Damselette",
                                    "text": "Well... They were delicious..."
                                },
                                {
                                    "id": "760360350",
                                    "speaker": "Paimon",
                                    "text": "Fair point."
                                },
                                {
                                    "id": "760360351",
                                    "speaker": "Maalaus",
                                    "text": "!"
                                },
                                {
                                    "id": "760360352",
                                    "speaker": "The Damselette",
                                    "text": "Yes, I understand."
                                },
                                {
                                    "id": "760360353",
                                    "speaker": "The Damselette",
                                    "text": "Give me your hand.",
                                    "choices": [
                                        {
                                            "id": "760360354",
                                            "text": "Seriously, you don't have to give us anything...",
                                            "response": [
                                                {
                                                    "id": "760360356",
                                                    "speaker": "The Damselette",
                                                    "text": "It's not like that. This is proof that we're \"friends.\""
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760360355",
                                            "text": "This is not for eating, you know..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760360333",
                            "text": "Shouldn't have existed before the Moon Goddess' birth..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7603699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760369901",
                    "speaker": "Paimon",
                    "text": "Last time, Columbina told us a whole bunch about the Fatui. Wonder what sort of things she'll talk about today... Let's hope she's in the mood to share!"
                },
                {
                    "id": "760369902",
                    "speaker": "Paimon",
                    "text": "Columbina?"
                },
                {
                    "id": "760369903",
                    "speaker": "Paimon",
                    "text": "Huh, it looks like something's bothering her!"
                },
                {
                    "id": "760369904",
                    "speaker": "The Damselette",
                    "text": "Is it this one?"
                },
                {
                    "id": "760369905",
                    "speaker": "The Damselette",
                    "text": "Not this one either, then?"
                },
                {
                    "id": "760369906",
                    "speaker": "The Damselette",
                    "text": "What about this?"
                }
            ]
        }
    ]
}