    "talks": [
        {
            "id": "2204301",
            "objective": "Talk to Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220430101",
                    "speaker": "Ooshima Junpei",
                    "text": "Huh, how did I run out of wood..."
                },
                {
                    "id": "220430102",
                    "speaker": "Ooshima Junpei",
                    "text": "Oh, hey there, Traveler! You're just the person I was hoping to see. Do you mind doing me a favor?",
                    "choices": [
                        {
                            "id": "220430103",
                            "text": "What's that?",
                            "response": [
                                {
                                    "id": "220430105",
                                    "speaker": "Ooshima Junpei",
                                    "text": "I've been trying to make smaller-scale wood carvings of our provisional head priestess."
                                },
                                {
                                    "id": "220430106",
                                    "speaker": "Ooshima Junpei",
                                    "text": "I've been thinking to bring a batch of these to Narukami Island to see if they'll sell..."
                                },
                                {
                                    "id": "220430107",
                                    "speaker": "Ooshima Junpei",
                                    "text": "If they do, they would make for a source of consistent income for me.",
                                    "choices": [
                                        {
                                            "id": "220430108",
                                            "text": "Oh, I think they'll sell alright.",
                                            "response": [
                                                {
                                                    "id": "220430109",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Hahaha. Thanks for your well-wishes."
                                                },
                                                {
                                                    "id": "220430110",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "That said, I think I've got faith in our Lady Neko's charisma."
                                                },
                                                {
                                                    "id": "220430118",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Well, never mind that for now. Let's talk about the matter at hand..."
                                                },
                                                {
                                                    "id": "220430119",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "So, the issue is that I'm running out of the wood I was using to practice."
                                                },
                                                {
                                                    "id": "220430120",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Could you help me collect 10 blocks of Otogi Wood, Traveler?",
                                                    "choices": [
                                                        {
                                                            "id": "220430121",
                                                            "text": "Sure.",
                                                            "response": [
                                                                {
                                                                    "id": "220430122",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "I'll leave it to you, then. You're a really great help."
                                                                },
                                                                {
                                                                    "id": "220430126",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Bring those Otogi Wood blocks to me once you're done."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220430123",
                                                            "text": "Do you really need that many?",
                                                            "response": [
                                                                {
                                                                    "id": "220430124",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Well, I've only just started practicing, so it's best to be on the safe side and prepare more material."
                                                                },
                                                                {
                                                                    "id": "220430125",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Well, I'm counting on you, Traveler."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220430111",
                                            "text": "What's with the wood carvings all of a sudden?",
                                            "response": [
                                                {
                                                    "id": "220430112",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Oh, well... Do you know what my payment from our head priestess has been so far?"
                                                },
                                                {
                                                    "id": "220430113",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "They're generally these... bottles, cups, plates, and things like that."
                                                },
                                                {
                                                    "id": "220430114",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "They do look a bit old, but when I went to have them appraised, we found out that these things are in fact a bit \"ancient\"... and valuable, too."
                                                },
                                                {
                                                    "id": "220430115",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "But to tell the truth, it was pretty troublesome and tiring getting them sold every time."
                                                },
                                                {
                                                    "id": "220430116",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Also, this really doesn't make for a particularly stable income... If the head priestess were to run out of these things one day, wouldn't that basically put me out of a job?"
                                                },
                                                {
                                                    "id": "220430117",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "As such, I've decided to pursue a new business venture."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220430104",
                            "text": "What are you doing?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204302",
            "objective": "Give Ooshima Junpei 10 Otogi Wood",
            "dialogues": [
                {
                    "id": "220430201",
                    "speaker": "Ooshima Junpei",
                    "text": "Have you found those 10 blocks of Otogi Wood?"
                }
            ]
        },
        {
            "id": "2204303",
            "objective": "Talk to Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220430301",
                    "speaker": "Ooshima Junpei",
                    "text": "Hmm, yes, these will do, I think. Sorry for asking you to help after you came all this way to reach the shrine... Please take these."
                },
                {
                    "id": "220430302",
                    "speaker": "Ooshima Junpei",
                    "text": "Once I've gotten my wood-carving act together, I'll also send you my best work!"
                },
                {
                    "id": "220430303",
                    "speaker": "Ooshima Junpei",
                    "text": "Hmm, what pose should I carve for the provisional head priestess in this time..."
                }
            ]
        }
    ]
}