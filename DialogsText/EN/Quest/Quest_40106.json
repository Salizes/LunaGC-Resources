    "talks": [
        {
            "id": "4010603",
            "objective": "",
            "dialogues": [
                {
                    "id": "401060301",
                    "speaker": "Dori",
                    "text": "Well, how did it go? I assume that Lord Sangemah Bay's assistance helped you discover something, yes?"
                },
                {
                    "id": "401060302",
                    "speaker": "Paimon",
                    "text": "You mean..."
                },
                {
                    "id": "401060303",
                    "speaker": "Dori",
                    "text": "Sachin was not a good person, and there's definitely something wrong with that Diadem of Knowledge!",
                    "choices": [
                        {
                            "id": "401060304",
                            "text": "Indeed.",
                            "response": [
                                {
                                    "id": "401060306",
                                    "speaker": "Dori",
                                    "text": "Then in that case, shouldn't you be doing something about it?"
                                },
                                {
                                    "id": "401060307",
                                    "speaker": "Dori",
                                    "text": "For instance, telling the Akademiya that they should give up the Diadem—"
                                },
                                {
                                    "id": "401060308",
                                    "speaker": "Paimon",
                                    "text": "We already told the Akademiya, but..."
                                },
                                {
                                    "id": "401060309",
                                    "speaker": "Dori",
                                    "text": "But what?"
                                },
                                {
                                    "id": "401060310",
                                    "speaker": "Paimon",
                                    "text": "Kaveh smashed the diadem."
                                },
                                {
                                    "id": "401060311",
                                    "speaker": "Dori",
                                    "text": "Whaaaaat!?"
                                },
                                {
                                    "id": "401060312",
                                    "speaker": "Paimon",
                                    "text": "Calm down, Dori! Why are you getting so worked up?"
                                },
                                {
                                    "id": "401060313",
                                    "speaker": "Dori",
                                    "text": "..."
                                },
                                {
                                    "id": "401060314",
                                    "speaker": "Dori",
                                    "text": "My diadem... My beautiful diadem..."
                                },
                                {
                                    "id": "401060315",
                                    "speaker": "Dori",
                                    "text": "Ah, this was supposed to be the perfect plan! I feed you the information, you discover the issue with the diadem, and then I just wait until the Akademiya sells it off at a low price..."
                                },
                                {
                                    "id": "401060316",
                                    "speaker": "Dori",
                                    "text": "And now it was all for nothing! Grr, curse that Kaveh! The interest rate on the Mora he owes me is about to get much higher!"
                                },
                                {
                                    "id": "401060317",
                                    "speaker": "Paimon",
                                    "text": "Ohhh, so that's why you told us about this. Yeah, Paimon did think you were being unusually generous..."
                                },
                                {
                                    "id": "401060318",
                                    "speaker": "Dori",
                                    "text": "My diadem! Ugh, I'm furious! That's it, no extension on his payment this month, no matter what reason he gives!"
                                }
                            ]
                        },
                        {
                            "id": "401060305",
                            "text": "We also discovered that."
                        }
                    ]
                }
            ]
        },
        {
            "id": "4010299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401029905",
                    "speaker": "Kaveh",
                    "text": "(Did he leave these notes there on purpose, or was this sheer coincidence? No... But if it wasn't a coincidence, then...)"
                }
            ]
        },
        {
            "id": "4010604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401060401",
                    "speaker": "Kaveh",
                    "text": "\"Little decisions\"? What could've been going through his mind when he wrote that..."
                }
            ]
        }
    ]
