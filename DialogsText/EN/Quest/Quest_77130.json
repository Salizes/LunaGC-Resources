            "dialogues": [
                {
                    "id": "771300101",
                    "speaker": "Paimon",
                    "text": "Hmm... Yeah. That's the big guy from before, though we didn't get a good look at him before... And to be honest, he doesn't look much like a giant Snegovik..."
                },
                {
                    "id": "771300102",
                    "speaker": "Paimon",
                    "text": "Paimon didn't know they could grow that huge.",
                    "choices": [
                        {
                            "id": "771300103",
                            "text": "Something might have gone haywire somehow...",
                            "response": [
                                {
                                    "id": "771300104",
                                    "speaker": "Paimon",
                                    "text": "Haywire, you say... So were those chains meant to keep him from losing control? Still, it's so sad that he's had to live like that."
                                },
                                {
                                    "id": "771300107",
                                    "speaker": "Paimon",
                                    "text": "...Yeah. Yikes."
                                },
                                {
                                    "id": "771300108",
                                    "speaker": "Paimon",
                                    "text": "Also, does... does he want to go out to sea?"
                                },
                                {
                                    "id": "771300109",
                                    "speaker": "Paimon",
                                    "text": "#Let's follow him, shall we, {NICKNAME}?"
                                },
                                {
                                    "id": "771300110",
                                    "speaker": "Player",
                                    "text": "It is quite concerning, yes..."
                                },
                                {
                                    "id": "771300111",
                                    "speaker": "Paimon",
                                    "text": "Hmm. Big Guy over there hasn't gone around causing any damage... Kinda weird, really. Where does he want to go, exactly?"
                                }
                            ]
                        },
                        {
                            "id": "771300105",
                            "text": "It would be nice if you could grow up like that, Paimon.",
                            "response": [
                                {
                                    "id": "771300106",
                                    "speaker": "Paimon",
                                    "text": "That big? Nah, Paimon's gonna pass. How much would she need to eat to fill her tummy if she got that huge?"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
