    "talks": [
        {
            "id": "7651101",
            "objective": "Go to the docks next to Nasha Town",
            "dialogues": [
                {
                    "id": "765110101",
                    "speaker": "Sieciech",
                    "text": "If Lady Nefer is right, the expert we've been waiting for should be arriving any moment now."
                },
                {
                    "id": "765110102",
                    "speaker": "Kaedehara Kazuha",
                    "text": "#Indeed, Mr. Sieciech. The evening wind has already carried word of {M#his}{F#her} presence..."
                },
                {
                    "id": "765110103",
                    "speaker": "Kaedehara Kazuha",
                    "text": "#Greetings to you,{NICKNAME} and Paimon. It's been a while."
                },
                {
                    "id": "765110104",
                    "speaker": "Kaedehara Kazuha",
                    "text": "Seeing you both in such good spirits truly gladdens me.",
                    "choices": [
                        {
                            "id": "765110105",
                            "text": "Kazuha? Is that you???",
                            "response": [
                                {
                                    "id": "765110107",
                                    "speaker": "Paimon",
                                    "text": "Wow, didn't expect you to see you here in Nod-Krai, let alone chatting with a Lightkeeper!"
                                },
                                {
                                    "id": "765110108",
                                    "speaker": "Paimon",
                                    "text": "Hmm... Hold on a second... why does everything feel kinda tense around here?"
                                },
                                {
                                    "id": "765110109",
                                    "speaker": "Kaedehara Kazuha",
                                    "text": "That is hardly surprising. The competition is at its climax, and the masters of martial arts who have gathered here from various lands are now waiting for the final result.",
                                    "choices": [
                                        {
                                            "id": "765110110",
                                            "text": "A competition?",
                                            "response": [
                                                {
                                                    "id": "765110112",
                                                    "speaker": "Sieciech",
                                                    "text": "That's right — welcome to the finals of the Nod-Krai Technical Martial Challenge!"
                                                },
                                                {
                                                    "id": "765110113",
                                                    "speaker": "Sieciech",
                                                    "text": "In contrast to a freewheeling, anything-goes style of combat, the emphasis in this championship is on the competitor's use and mastery of weapon techniques."
                                                },
                                                {
                                                    "id": "765110114",
                                                    "speaker": "Sieciech",
                                                    "text": "That's why our committee asked the Adventurers' Guild to bring in a master swordsman from the Crux Fleet as our consultant!"
                                                },
                                                {
                                                    "id": "765110115",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, it's all coming together now! So you're a judge for the competition this time, Kazuha!"
                                                },
                                                {
                                                    "id": "765110116",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "That is correct. I was a little surprised myself. I did not expect word of the Crux Clash to reach Nod-Krai."
                                                },
                                                {
                                                    "id": "765110117",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "Captain Beidou and the others were just at a trade show in Nasha Town. Now that their business here has concluded, they are unlikely to come back anytime soon."
                                                },
                                                {
                                                    "id": "765110118",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "As for myself, I presently have some leisure time and possess a measure of experience from the Crux Clash. For that reason, I accepted Mr. Sieciech's invitation."
                                                },
                                                {
                                                    "id": "765110119",
                                                    "speaker": "Sieciech",
                                                    "text": "Thanks to Mr. Kazuha's keen eye and his almost perfectly impartial judgment, we've been able to make good calls even in the most chaotic matches."
                                                },
                                                {
                                                    "id": "765110120",
                                                    "speaker": "Sieciech",
                                                    "text": "But now, we've run into a problem: each of the three finalists has their own strengths, and none of them can overcome the others' techniques."
                                                },
                                                {
                                                    "id": "765110121",
                                                    "speaker": "Sieciech",
                                                    "text": "At this rate, they could fight for days and still yield no result."
                                                },
                                                {
                                                    "id": "765110122",
                                                    "speaker": "Paimon",
                                                    "text": "No result? In a competition? Oof, Paimon's never heard of that before..."
                                                },
                                                {
                                                    "id": "765110123",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "In my opinion, we would do well to proceed with that plan."
                                                },
                                                {
                                                    "id": "765110124",
                                                    "speaker": "Sieciech",
                                                    "text": "Agreed. We'll have to rely on our expert among experts here to resolve our problem."
                                                },
                                                {
                                                    "id": "765110125",
                                                    "speaker": "Paimon",
                                                    "text": "#Huh? What's going on? Why is {NICKNAME} the star here all of a sudden?"
                                                },
                                                {
                                                    "id": "765110126",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "If you were to demonstrate a portion of your skill, it might be enough to break the stalemate.",
                                                    "choices": [
                                                        {
                                                            "id": "765110127",
                                                            "text": "Hmm? Do you want me to put on an exhibition match?",
                                                            "response": [
                                                                {
                                                                    "id": "765110129",
                                                                    "speaker": "Kaedehara Kazuha",
                                                                    "text": "No, not quite. As the champion of the Crux Clash — and a true master of martial arts — you will serve as the final trial to determine the victor."
                                                                },
                                                                {
                                                                    "id": "765110130",
                                                                    "speaker": "Kaedehara Kazuha",
                                                                    "text": "You will face each of the three finalists in turn, and we will assess them based on the challenge they present to you."
                                                                },
                                                                {
                                                                    "id": "765110131",
                                                                    "speaker": "Kaedehara Kazuha",
                                                                    "text": "The finalist who achieves the highest score will be crowned champion."
                                                                },
                                                                {
                                                                    "id": "765110132",
                                                                    "speaker": "Sieciech",
                                                                    "text": "And to recognize your contribution, we'll award you half of the original prize money as compensation."
                                                                },
                                                                {
                                                                    "id": "765110133",
                                                                    "speaker": "Paimon",
                                                                    "text": "That's... a rather unheard-of solution, Paimon thinks..."
                                                                },
                                                                {
                                                                    "id": "765110134",
                                                                    "speaker": "Paimon",
                                                                    "text": "But it'll definitely break the deadlock, and we'll come out better on the other side too! Pretty neat solution, Kazuha!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765110135",
                                                                            "text": "I have to admit, I've never seen anything like this before.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765110137",
                                                                                    "speaker": "Sieciech",
                                                                                    "text": "Heh, that settles it then!"
                                                                                },
                                                                                {
                                                                                    "id": "765110138",
                                                                                    "speaker": "Kaedehara Kazuha",
                                                                                    "text": "#Thank you for doing this, {NICKNAME}."
                                                                                },
                                                                                {
                                                                                    "id": "765110139",
                                                                                    "speaker": "Kaedehara Kazuha",
                                                                                    "text": "Each of your three opponents has their own signature skill — I am confident you will enjoy the bouts and demonstrate the bearing of a true champion at the same time."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765110136",
                                                                            "text": "It's certainly a novel approach."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765110128",
                                                            "text": "You want me to create more buzz?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765110111",
                                            "text": "Of martial arts?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765110106",
                            "text": "Long time no see!"
                        }
                    ]
                }
            ]
        }
    ]
}