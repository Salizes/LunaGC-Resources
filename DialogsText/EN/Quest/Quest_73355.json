    "talks": [
        {
            "id": "7335501",
            "objective": "Go to Bayda Harbor",
            "dialogues": [
                {
                    "id": "733550101",
                    "speaker": "Paimon",
                    "text": "Hey, a Fungus just floated past. Should it be doing that?"
                },
                {
                    "id": "733550102",
                    "speaker": "Paimon",
                    "text": "Normally, it's pretty dangerous to have Fungi wandering around the city, right? Unless we're talking about the special cases, the super well-behaved ones that have undergone training..."
                },
                {
                    "id": "733550103",
                    "speaker": "Paimon",
                    "text": "Now that Paimon thinks about it... Why does this feel so familiar? Haven't we been through something similar before?",
                    "choices": [
                        {
                            "id": "733550104",
                            "text": "Hold on, is that Bongo-Head?",
                            "response": [
                                {
                                    "id": "733550105",
                                    "speaker": "Paimon",
                                    "text": "That's right! It's Bongo-Head! The Fungi friend we met back in Sumeru!"
                                },
                                {
                                    "id": "733550106",
                                    "speaker": "Paimon",
                                    "text": "Woahhh! It's been so, so long since we last saw it! Come on, let's go say hi!"
                                }
                            ]
                        },
                        {
                            "id": "733550107",
                            "text": "What \"special cases\" again?",
                            "response": [
                                {
                                    "id": "733550108",
                                    "speaker": "Paimon",
                                    "text": "Paimon thinks that's... Bongo-Head? The Fungi friend we met back in Sumeru!"
                                },
                                {
                                    "id": "733550109",
                                    "speaker": "Paimon",
                                    "text": "Woahhh! It's been so, so long since we last saw it! Come on, let's go say hi!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7335502",
            "objective": "Talk to Haniyyah",
            "dialogues": [
                {
                    "id": "733550201",
                    "speaker": "Haniyyah",
                    "text": "Hmm? Looks like I don't need to leave a message at the Adventurers' Guild. Fate will always bring us back together..."
                },
                {
                    "id": "733550202",
                    "speaker": "Haniyyah",
                    "text": "We meet again, Golden Comet, Silver Companion. It's been a long time."
                },
                {
                    "id": "733550203",
                    "speaker": "Haniyyah",
                    "text": "You're both so radiant and full of life. It feels as though no time has passed at all.",
                    "choices": [
                        {
                            "id": "733550204",
                            "text": "Long time no see, Haniyyah!",
                            "response": [
                                {
                                    "id": "733550205",
                                    "speaker": "Paimon",
                                    "text": "It's really you, Haniyyah and Bongo-Head!"
                                },
                                {
                                    "id": "733550206",
                                    "speaker": "Paimon",
                                    "text": "No wonder that message felt so familiar... Guess that means the bond between Paimon and Bongo-Head is still as strong as ever!"
                                },
                                {
                                    "id": "733550207",
                                    "speaker": "Bongo-Head",
                                    "text": "♪~"
                                },
                                {
                                    "id": "733550212",
                                    "speaker": "Haniyyah",
                                    "text": "I imagined many different ways we might reunite. A grand feast, or a creative welcome ceremony, something that would give you a huge surprise."
                                },
                                {
                                    "id": "733550213",
                                    "speaker": "Haniyyah",
                                    "text": "But in the end, they all felt a little too formal. You've been busy, and I was worried that taking up too much of your time might cause you trouble."
                                },
                                {
                                    "id": "733550214",
                                    "speaker": "Haniyyah",
                                    "text": "Besides, our Fungi friends prefer a calm and peaceful environment these days. So, let's keep it simple and reunite in a manner that is both relaxed and easygoing."
                                },
                                {
                                    "id": "733550215",
                                    "speaker": "Souka",
                                    "text": "That's right! The prose that Haniyyah's been reading really paid off. A calm state of mind does wonders for our lives, after all!"
                                },
                                {
                                    "id": "733550216",
                                    "speaker": "Souka",
                                    "text": "At the end of the day, carefree chitchat like this is the greatest joy of all."
                                },
                                {
                                    "id": "733550217",
                                    "speaker": "Kindlejoy",
                                    "text": "♫~"
                                },
                                {
                                    "id": "733550218",
                                    "speaker": "Paimon",
                                    "text": "Souka's here too! There's also Kindlejoy, and... Who's this?"
                                },
                                {
                                    "id": "733550219",
                                    "speaker": "Souka",
                                    "text": "This is my very own Fungi friend, Stormstress! You and Bongo-Head knocked us out back in the round of 32."
                                },
                                {
                                    "id": "733550220",
                                    "speaker": "Paimon",
                                    "text": "Ehehe, you remember it so well...",
                                    "choices": [
                                        {
                                            "id": "733550221",
                                            "text": "It's all starting to come back to me now...",
                                            "response": [
                                                {
                                                    "id": "733550223",
                                                    "speaker": "Souka",
                                                    "text": "Anyway, as you can see, dear big shots, we no longer need the chains of dates or places for our next meeting..."
                                                },
                                                {
                                                    "id": "733550224",
                                                    "speaker": "Souka",
                                                    "text": "Haniyyah and I have purchased this commercial district and transformed it into the Lil' Fungi Playground!"
                                                },
                                                {
                                                    "id": "733550225",
                                                    "speaker": "Paimon",
                                                    "text": "Wait, so you're saying these facilities here aren't rented for the new tabletop game, but..."
                                                },
                                                {
                                                    "id": "733550226",
                                                    "speaker": "Haniyyah",
                                                    "text": "You've got it. From now on, we'll be living in Bayda Harbor and promoting the Fungus-themed tabletop game, as well as sharing our theories on communicating with animals."
                                                },
                                                {
                                                    "id": "733550227",
                                                    "speaker": "Haniyyah",
                                                    "text": "Feel free to drop by and play with the Fungi friends whenever you have time!"
                                                },
                                                {
                                                    "id": "733550228",
                                                    "speaker": "Bongo-Head",
                                                    "text": "♪~",
                                                    "choices": [
                                                        {
                                                            "id": "733550229",
                                                            "text": "Yay! Fungi friends!",
                                                            "response": [
                                                                {
                                                                    "id": "733550231",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh my goodness! This is easily one of the best things Paimon's heard all day!"
                                                                },
                                                                {
                                                                    "id": "733550232",
                                                                    "speaker": "Paimon",
                                                                    "text": "After the first Fungi Tournament, Paimon thought of sooo many ideas for playing together with Bongo-Head. Now we can finally make them all happen!"
                                                                },
                                                                {
                                                                    "id": "733550233",
                                                                    "speaker": "Paimon",
                                                                    "text": "Too bad we didn't prepare any treats for the Fungi friends... How amazing would it be if we could cuddle up with them and enjoy a table full of delicious food!"
                                                                },
                                                                {
                                                                    "id": "733550234",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "No need to worry about that. In the process of refining On Fungi Communities, I've been conducting foundational research on the food that Fungi enjoy."
                                                                },
                                                                {
                                                                    "id": "733550235",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "My goal is to identify ingredients that both Fungi and humans can eat, so our buddies don't have to live off every flavor of Marvelous Jelly all year long."
                                                                },
                                                                {
                                                                    "id": "733550236",
                                                                    "speaker": "Haniyyah",
                                                                    "text": "One day, I'll find the ingredients that satisfy both human and Fungi tastes, and design delicious dishes we can all enjoy together!"
                                                                },
                                                                {
                                                                    "id": "733550237",
                                                                    "speaker": "Souka",
                                                                    "text": "And when it comes to putting theory into practice, I'll be our master chef! Just in case Haniyyah ends up ruining our eleventh pot."
                                                                },
                                                                {
                                                                    "id": "733550238",
                                                                    "speaker": "Paimon",
                                                                    "text": "Sounds like the day we sit in a circle and share a meal with our Fungi friends isn't far off, right?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "733550239",
                                                                            "text": "We'll be waiting for your good news, Haniyyah!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "733550241",
                                                                                    "speaker": "Haniyyah",
                                                                                    "text": "In that case, please do come back and visit the Lil' Fungi Playground when you get the chance. We, and all our Fungi friends, will always be here."
                                                                                },
                                                                                {
                                                                                    "id": "733550242",
                                                                                    "speaker": "Souka",
                                                                                    "text": "Who knows? The surprise might arrive even sooner than you expect."
                                                                                },
                                                                                {
                                                                                    "id": "733550243",
                                                                                    "speaker": "Bongo-Head",
                                                                                    "text": "♪!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "733550240",
                                                                            "text": "We can't wait for Souka's feast!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "733550230",
                                                            "text": "We can see each other all the time now!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733550222",
                                            "text": "The warm, welcoming atmosphere is helping me relax..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733550208",
                            "text": "Though I can't quite remember... Hello to you both!",
                            "response": [
                                {
                                    "id": "733550209",
                                    "speaker": "Paimon",
                                    "text": "It really is Haniyyah and Bongo-Head! We met at the Nilotpala Cup Beast Tamers Tournament. They're longtime friends of ours!"
                                },
                                {
                                    "id": "733550210",
                                    "speaker": "Paimon",
                                    "text": "Paimon remembers that we saw them near Port Ormos and in the Court of Fontaine afterwards, too. It's been so long already..."
                                },
                                {
                                    "id": "733550211",
                                    "speaker": "Bongo-Head",
                                    "text": "♪~"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}