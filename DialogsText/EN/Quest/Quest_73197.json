    "talks": [
        {
            "id": "7319701",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970101",
                    "speaker": "Bimarstan's Proverb Column",
                    "text": "This is the Proverb Column that holds the dicta of the Akademiya's previous researchers. Only by following the steps of our trail-blazing pioneers may we behold the light of wisdom."
                },
                {
                    "id": "731970102",
                    "speaker": "Bimarstan's Proverb Column",
                    "text": "As the old saying goes, \"There is nothing new under the sun.\""
                }
            ]
        },
        {
            "id": "7319702",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970201",
                    "speaker": "Pursina",
                    "text": "\"A healthy body makes a healthy soul, and a healthy soul guarantees a healthy body.\""
                }
            ]
        },
        {
            "id": "7319703",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970301",
                    "speaker": "Suhrawardi",
                    "text": "\"Researchers are the guardians of the body and soul.\""
                }
            ]
        },
        {
            "id": "7319704",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970401",
                    "speaker": "Albiruni",
                    "text": "\"Seek wisdom, not knowledge.\""
                }
            ]
        },
        {
            "id": "7319705",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970501",
                    "speaker": "Hipakretisa",
                    "text": "\"A doctor who knows nothing about astrology has no right to call themselves a doctor.\""
                }
            ]
        },
        {
            "id": "7319706",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970601",
                    "speaker": "Alva Nikola",
                    "text": "\"Loneliness is the guide to new enlightment.\""
                }
            ]
        },
        {
            "id": "7319707",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970701",
                    "speaker": "Masudi",
                    "text": "\"On a chessboard lies the truth of the world. The beauty of the stars lie within each and every move.\""
                }
            ]
        },
        {
            "id": "7319708",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970801",
                    "speaker": "Ayesha",
                    "text": "\"We know more than we can say.\""
                }
            ]
        },
        {
            "id": "7319709",
            "objective": "",
            "dialogues": [
                {
                    "id": "731970901",
                    "speaker": "Fadhlan",
                    "text": "\"It would seem that, while The Seven stand shoulder-to-shoulder in their roles as Archons of the mortal realm, there are moments where their paths diverge and even run directly counter to one another.\""
                }
            ]
        },
        {
            "id": "7319710",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971001",
                    "speaker": "Pursina",
                    "text": "\"Even the most fragile little Vishap has the potential to be a dragon.\""
                }
            ]
        },
        {
            "id": "7319711",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971101",
                    "speaker": "Iskandar",
                    "text": "\"Seek violence, and violence shall find you.\""
                }
            ]
        },
        {
            "id": "7319712",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971201",
                    "speaker": "Vistahm",
                    "text": "\"Facts are clearer than words.\""
                }
            ]
        },
        {
            "id": "7319713",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971301",
                    "speaker": "Pir Nagar",
                    "text": "\"There is no cure for love...\""
                }
            ]
        },
        {
            "id": "7319714",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971401",
                    "speaker": "Pir Kavikavus",
                    "text": "\"It has been proven that Akasha has no signal on Devantaka Mountain.\""
                }
            ]
        },
        {
            "id": "7319715",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971501",
                    "speaker": "Mahitab",
                    "text": "\"When a man sighs, Sumpter Beasts also stay quiet.\""
                }
            ]
        },
        {
            "id": "7319716",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971601",
                    "speaker": "Cyrus",
                    "text": "\"Change is the only constant.\""
                }
            ]
        },
        {
            "id": "7319717",
            "objective": "",
            "dialogues": [
                {
                    "id": "731971701",
                    "speaker": "Imhotep",
                    "text": "\"I want to go where the cats went after I die...\""
                }
            ]
        }
    ]
}