    "talks": [
        {
            "id": "7406501",
            "objective": "",
            "dialogues": [
                {
                    "id": "740650101",
                    "speaker": "Decembre",
                    "text": "#Well, well! If it isn't {NICKNAME} and Paimon!",
                    "choices": [
                        {
                            "id": "740650102",
                            "text": "Do we know you?",
                            "response": [
                                {
                                    "id": "740650104",
                                    "speaker": "Decembre",
                                    "text": "Don't be so cold. I'll never forget what you did for me that other time."
                                },
                                {
                                    "id": "740650105",
                                    "speaker": "Paimon",
                                    "text": "That other time... Ah! We still have so much to ask you!"
                                },
                                {
                                    "id": "740650106",
                                    "speaker": "Decembre",
                                    "text": "I—Is that so? Ugh, oh, what's this? My memory, it's acting up again! What happened then, I wonder? I can't remember a thing!"
                                },
                                {
                                    "id": "740650107",
                                    "speaker": "Decembre",
                                    "text": "The wise say it's better to look toward the future than look back into the past. So let's talk about our future collaboration, and let bygones be bygones, shall we?"
                                },
                                {
                                    "id": "740650108",
                                    "speaker": "Decembre",
                                    "text": "I have a few jobs on hand that pay quite well, but I don't have anyone to help out. If you're free, would you like to have a go?"
                                },
                                {
                                    "id": "740650109",
                                    "speaker": "Paimon",
                                    "text": "Hmph! Don't you go thinking we're that easy to dupe..."
                                },
                                {
                                    "id": "740650110",
                                    "speaker": "Player",
                                    "text": "And just how good is the compensation?"
                                },
                                {
                                    "id": "740650111",
                                    "speaker": "Paimon",
                                    "text": "Hey!"
                                },
                                {
                                    "id": "740650112",
                                    "speaker": "Decembre",
                                    "text": "This is why I'm so fond of talking business with people like you. What do they call it again? Right, being quick to catch on!"
                                },
                                {
                                    "id": "740650113",
                                    "speaker": "Decembre",
                                    "text": "How about I state a number that's guaranteed to satisfy you?"
                                },
                                {
                                    "id": "740650114",
                                    "speaker": "Decembre",
                                    "text": "A hundred Coupons! What do you think?"
                                },
                                {
                                    "id": "740650115",
                                    "speaker": "Paimon",
                                    "text": "A hundred!?"
                                },
                                {
                                    "id": "740650116",
                                    "speaker": "Decembre",
                                    "text": "Mmm, I see you are moved by my generosity.",
                                    "choices": [
                                        {
                                            "id": "740650117",
                                            "text": "That won't even buy us a bottle cork.",
                                            "response": [
                                                {
                                                    "id": "740650118",
                                                    "speaker": "Paimon",
                                                    "text": "Yeah! Paimon can't believe you had the gall to make that offer!"
                                                },
                                                {
                                                    "id": "740650121",
                                                    "speaker": "Decembre",
                                                    "text": "Am I not being generous enough? You young 'uns really are so... You just don't know what's good for you!"
                                                },
                                                {
                                                    "id": "740650122",
                                                    "speaker": "Decembre",
                                                    "text": "You should know, there're hordes of poor wretches who'd give an arm to do easy and profitable work like this..."
                                                },
                                                {
                                                    "id": "740650123",
                                                    "speaker": "Maupoil",
                                                    "text": "Decembre, you slippery little fraud, I've finally caught you! Last time I caught you hanging around the mail room, you were also swindling newcomers into commissions for you for a fraction of the actual fee..."
                                                },
                                                {
                                                    "id": "740650124",
                                                    "speaker": "Maupoil",
                                                    "text": "#{NICKNAME} and Paimon? You didn't fall for his lies, did you?",
                                                    "choices": [
                                                        {
                                                            "id": "740650125",
                                                            "text": "I'm devastated... We've already been tricked once!",
                                                            "response": [
                                                                {
                                                                    "id": "740650126",
                                                                    "speaker": "Maupoil",
                                                                    "text": "*sigh* Then I'm too late."
                                                                },
                                                                {
                                                                    "id": "740650130",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Anyways, don't believe a word he says. He targets newcomers or anyone unaware of the rules and cheats them. There's already a long list of victims."
                                                                },
                                                                {
                                                                    "id": "740650131",
                                                                    "speaker": "Decembre",
                                                                    "text": "My word, \"swindle\"!? You make it sound so awful. Is there any difference between us? Don't you guards use Coupons to make people do miscellaneous work for you, too?"
                                                                },
                                                                {
                                                                    "id": "740650132",
                                                                    "speaker": "Maupoil",
                                                                    "text": "We don't pocket a portion of their compensation."
                                                                },
                                                                {
                                                                    "id": "740650133",
                                                                    "speaker": "Decembre",
                                                                    "text": "What are you hinting at? Don't slander me without any proof!"
                                                                },
                                                                {
                                                                    "id": "740650134",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Oh, you want to see some proof? Let's go then. Solitary is quiet and spacious — a perfect place for you to peruse all the proof. Seriously, I still have trouble to deal with at the Geode Mine Shaft after this..."
                                                                },
                                                                {
                                                                    "id": "740650135",
                                                                    "speaker": "Maupoil",
                                                                    "text": "#Oh, {NICKNAME} and Paimon. If possible, could you help me..."
                                                                },
                                                                {
                                                                    "id": "740650136",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hey, it's not like we have all the time in the world, either!"
                                                                },
                                                                {
                                                                    "id": "740650137",
                                                                    "speaker": "Player",
                                                                    "text": "I'm sure you pay handsomely — I'll do it."
                                                                },
                                                                {
                                                                    "id": "740650138",
                                                                    "speaker": "Paimon",
                                                                    "text": "Hey!"
                                                                },
                                                                {
                                                                    "id": "740650139",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Haha! Payment will be provided in accordance with regulations, of course. I'm sure you know the standards, and you know I won't try to defraud you."
                                                                },
                                                                {
                                                                    "id": "740650140",
                                                                    "speaker": "Maupoil",
                                                                    "text": "Anyway, some Fontemer Aberrants have been spotted in the Geode Mine Shaft... They may pose a threat if left unchecked, so they must be dealt with as soon as possible."
                                                                },
                                                                {
                                                                    "id": "740650141",
                                                                    "speaker": "Maupoil",
                                                                    "text": "I'll take this guy to solitary first. Handing him over to my colleagues will take some time... I'll meet up with you as soon as I'm done."
                                                                },
                                                                {
                                                                    "id": "740650142",
                                                                    "speaker": "Paimon",
                                                                    "text": "Alright, but don't take too long."
                                                                },
                                                                {
                                                                    "id": "740650143",
                                                                    "speaker": "Maupoil",
                                                                    "text": "I'll do my best. But the paperwork... It's not something I can speed up. I'll leave the business at the mine shaft to you then."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "740650127",
                                                            "text": "But not this time.",
                                                            "response": [
                                                                {
                                                                    "id": "740650128",
                                                                    "speaker": "Maupoil",
                                                                    "text": "This time?"
                                                                },
                                                                {
                                                                    "id": "740650129",
                                                                    "speaker": "Paimon",
                                                                    "text": "Uh... Things happened before this..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740650119",
                                            "text": "I'll pay you 100, you work, and I'll profit.",
                                            "response": [
                                                {
                                                    "id": "740650120",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa! Is that what you were planning!?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740650103",
                            "text": "I have a bad feeling about this..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7406502",
            "objective": "Defeat the wandering Fontemer Aberrants in the Geode Mine Shaft",
            "dialogues": []
        },
        {
            "id": "7406503",
            "objective": "Report to Maupoil",
            "dialogues": [
                {
                    "id": "740650301",
                    "speaker": "Paimon",
                    "text": "You're only just arriving here now? We've already driven away all the Fontemer Aberrants."
                },
                {
                    "id": "740650302",
                    "speaker": "Maupoil",
                    "text": "So, it's finally happened to me."
                },
                {
                    "id": "740650303",
                    "speaker": "Paimon",
                    "text": "What's finally happened?"
                },
                {
                    "id": "740650304",
                    "speaker": "Maupoil",
                    "text": "Arriving at the scene and finding out that all the work has been done by someone else, of course! I mean, there's nothing for me to do here."
                },
                {
                    "id": "740650305",
                    "speaker": "Maupoil",
                    "text": "This is for you. Thank you so much! I'll certainly manage to get a good night's sleep tonight!"
                }
            ]
        }
    ]
}