            "dialogues": [
                {
                    "id": "711610301",
                    "speaker": "Emilie",
                    "text": "#...{NICKNAME}? Heh... Happy Holidays, it's been some time since we last spoke.",
                    "choices": [
                        {
                            "id": "711610311",
                            "text": "I've released my Xiao Lantern, too.",
                            "response": [
                                {
                                    "id": "711610312",
                                    "speaker": "Emilie",
                                    "text": "Is that your Xiao Lantern? It's beautiful! I'm thinking of buying a few more to take back to Fontaine..."
                                },
                                {
                                    "id": "711610313",
                                    "speaker": "Emilie",
                                    "text": "In any case, I hope your wishes come true.",
                                    "choices": [
                                        {
                                            "id": "711610302",
                                            "text": "Happy Holidays, Emilie.",
                                            "response": [
                                                {
                                                    "id": "711610304",
                                                    "speaker": "Emilie",
                                                    "text": "You could say that. I had already planned to come to Liyue to research floral essences, so when I heard there was a merchant ship heading here, I decided to join them."
                                                },
                                                {
                                                    "id": "711610305",
                                                    "speaker": "Emilie",
                                                    "text": "I had no idea I'd arrive just in time for Lantern Rite. In deference to the season, I've decided to put all work aside and simply enjoy myself."
                                                },
                                                {
                                                    "id": "711610306",
                                                    "speaker": "Emilie",
                                                    "text": "I even asked a young lady to teach me to craft Xiao Lanterns. In fact, I was just about to release it."
                                                },
                                                {
                                                    "id": "711610307",
                                                    "speaker": "Player",
                                                    "text": "I bet it's absolutely gorgeous!"
                                                },
                                                {
                                                    "id": "711610308",
                                                    "speaker": "Emilie",
                                                    "text": "Thank you. She told me it's tradition to write down a wish before releasing it."
                                                },
                                                {
                                                    "id": "711610309",
                                                    "speaker": "Emilie",
                                                    "text": "Still, I'm not quite sure what to write..."
                                                },
                                                {
                                                    "id": "711610310",
                                                    "speaker": "Black Screen",
                                                    "text": "You and Emilie release a Xiao Lantern together..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "711610303",
                                            "text": "Here to see the sights?"
                                        }
                                    ]
