    "talks": [
        {
            "id": "7651001",
            "objective": "Talk to Edler and Wislawa",
            "dialogues": [
                {
                    "id": "765100101",
                    "speaker": "Edler",
                    "text": "...That should be enough to prove this isn't some sort of secret weapon."
                },
                {
                    "id": "765100102",
                    "speaker": "Wislawa",
                    "text": "Hmm... Sure does. Now you just need to make it a little tougher, and it might pose a challenge to adults as well."
                },
                {
                    "id": "765100103",
                    "speaker": "Paimon",
                    "text": "Whoa! The atmosphere's getting all tense again, you don't think they're going to..."
                },
                {
                    "id": "765100104",
                    "speaker": "Player",
                    "text": "Come to blows?"
                },
                {
                    "id": "765100105",
                    "speaker": "Wislawa",
                    "text": "#You're not far wrong... Hey, {NICKNAME}, since you're here, why not help us referee a fair fight?"
                },
                {
                    "id": "765100106",
                    "speaker": "Edler",
                    "text": "*sigh* I don't know where this obsession with sparring has come from. Is it because I beat you so easily the last time? If that's what this is about, then let's just get it over with."
                },
                {
                    "id": "765100107",
                    "speaker": "Edler",
                    "text": "#{NICKNAME}, keep your eyes peeled and see who blinks first!"
                },
                {
                    "id": "765100108",
                    "speaker": "Wislawa",
                    "text": "Hmph! All those empty words aren't going to save you!",
                    "choices": [
                        {
                            "id": "765100109",
                            "text": "Edler looks stronger...",
                            "response": [
                                {
                                    "id": "765100111",
                                    "speaker": "Edler",
                                    "text": "..."
                                },
                                {
                                    "id": "765100112",
                                    "speaker": "Wislawa",
                                    "text": "..."
                                },
                                {
                                    "id": "765100113",
                                    "speaker": "Player",
                                    "text": "...!"
                                },
                                {
                                    "id": "765100114",
                                    "speaker": "Paimon",
                                    "text": "Whoa! Aren't they only supposed to be sparring!?"
                                },
                                {
                                    "id": "765100115",
                                    "speaker": "Edler",
                                    "text": "It's not too late to admit defeat! I'll give you three seconds..."
                                },
                                {
                                    "id": "765100116",
                                    "speaker": "Edler",
                                    "text": "Three, two, one..."
                                },
                                {
                                    "id": "765100117",
                                    "speaker": "Paimon",
                                    "text": "Whoa!"
                                },
                                {
                                    "id": "765100118",
                                    "speaker": "Black Screen",
                                    "text": "There is a loud, metallic clack followed by calm silence..."
                                },
                                {
                                    "id": "765100119",
                                    "speaker": "Edler",
                                    "text": "It's alright, Paimon, you can open your eyes."
                                },
                                {
                                    "id": "765100120",
                                    "speaker": "Wislawa",
                                    "text": "It turns out the most \"tense\" person here was you..."
                                },
                                {
                                    "id": "765100121",
                                    "speaker": "Paimon",
                                    "text": "Wh—What? Wislawa, you're not hurt!?",
                                    "choices": [
                                        {
                                            "id": "765100122",
                                            "text": "Edler only fired a warning shot.",
                                            "response": [
                                                {
                                                    "id": "765100124",
                                                    "speaker": "Edler",
                                                    "text": "Of course. I don't want to end up stuck in some foreign prison..."
                                                },
                                                {
                                                    "id": "765100125",
                                                    "speaker": "Edler",
                                                    "text": "I had to put on a show. Let her know I'm not some cowardly merchant she can just push around."
                                                },
                                                {
                                                    "id": "765100126",
                                                    "speaker": "Edler",
                                                    "text": "This way, the next time we meet, she'll think twice before causing me trouble."
                                                },
                                                {
                                                    "id": "765100127",
                                                    "speaker": "Paimon",
                                                    "text": "#But, {NICKNAME}, how did you know what was going on? You're not tense at all!",
                                                    "choices": [
                                                        {
                                                            "id": "765100128",
                                                            "text": "Edler's expression was too relaxed.",
                                                            "response": [
                                                                {
                                                                    "id": "765100130",
                                                                    "speaker": "Wislawa",
                                                                    "text": "You're sharp. A well-placed threat's the fastest way to make someone surrender. It's just a shame that shortcuts are seldom so easy to take."
                                                                },
                                                                {
                                                                    "id": "765100131",
                                                                    "speaker": "Wislawa",
                                                                    "text": "#Not to mention, {NICKNAME} is here... Anyway, I'm still standing."
                                                                },
                                                                {
                                                                    "id": "765100132",
                                                                    "speaker": "Wislawa",
                                                                    "text": "I just hope the next time we meet, I get a chance to..."
                                                                },
                                                                {
                                                                    "id": "765100133",
                                                                    "speaker": "Edler",
                                                                    "text": "Don't start with all that again. How many chances do you think we'll have to meet?"
                                                                },
                                                                {
                                                                    "id": "765100134",
                                                                    "speaker": "Edler",
                                                                    "text": "If the next time I see you, you happen to be on duty, I'll be forced to respond appropriately to any actions you take."
                                                                },
                                                                {
                                                                    "id": "765100135",
                                                                    "speaker": "Edler",
                                                                    "text": "But if you're on holiday again, let's play another wargame or two — for the sake of my business."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765100129",
                                                            "text": "Edler said it herself — \"see who blinks first.\""
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765100123",
                                            "text": "There were no bullets in the musket."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765100110",
                            "text": "Wislawa looks bigger..."
                        }
                    ]
                }
            ]
        }
    ]
}