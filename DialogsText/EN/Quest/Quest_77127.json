            "dialogues": [
                {
                    "id": "771270301",
                    "speaker": "Paimon",
                    "text": "Hey, are you all right?"
                },
                {
                    "id": "771270302",
                    "speaker": "Gloomy Jack Frost",
                    "text": "Ohhh... Ya-ho..."
                },
                {
                    "id": "771270303",
                    "speaker": "Black Screen",
                    "text": "The gloomy Jack Frost points to its own head..."
                },
                {
                    "id": "771270304",
                    "speaker": "Paimon",
                    "text": "Ah... Paimon gets it now! You're sad because everyone else has a hat, but you don't!"
                },
                {
                    "id": "771270305",
                    "speaker": "Gloomy Jack Frost",
                    "text": "Ya-ho, Ya-ho...",
                    "choices": [
                        {
                            "id": "771270306",
                            "text": "Aw, poor thing...",
                            "response": [
                                {
                                    "id": "771270307",
                                    "speaker": "Paimon",
                                    "text": "True..."
                                },
                                {
                                    "id": "771270310",
                                    "speaker": "Paimon",
                                    "text": "Let's see... If this little guy is only sad because it doesn't have a hat, why don't we just find one for it?"
                                },
                                {
                                    "id": "771270311",
                                    "speaker": "Gloomy Jack Frost",
                                    "text": "Ya-ho ya-ho!"
                                },
                                {
                                    "id": "771270312",
                                    "speaker": "Paimon",
                                    "text": "But where are we supposed to find one?"
                                },
                                {
                                    "id": "771270313",
                                    "speaker": "Gloomy Jack Frost",
                                    "text": "Ya-ho, Ya-ho!"
                                },
                                {
                                    "id": "771270314",
                                    "speaker": "Paimon",
                                    "text": "Oh, you know where one is?"
                                },
                                {
                                    "id": "771270315",
                                    "speaker": "Gloomy Jack Frost",
                                    "text": "Ya-ho..."
                                },
                                {
                                    "id": "771270316",
                                    "speaker": "Paimon",
                                    "text": "Ah... So that's it! There's a hat <color=#00E1FFFF>down that well</color>... Or rather, it probably just fell down there by accident, didn't it?"
                                },
                                {
                                    "id": "771270317",
                                    "speaker": "Paimon",
                                    "text": "We'll go down and get it for you!"
                                },
                                {
                                    "id": "771270318",
                                    "speaker": "Gloomy Jack Frost",
                                    "text": "Ya-ho! Ya-ho!"
                                }
                            ]
                        },
                        {
                            "id": "771270308",
                            "text": "Don't let that senseless comparison get the better of you.",
                            "response": [
                                {
                                    "id": "771270309",
                                    "speaker": "Paimon",
                                    "text": "Paimon doubts it gets what you're talking about."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7712702",
            "objective": "",
            "dialogues": [
