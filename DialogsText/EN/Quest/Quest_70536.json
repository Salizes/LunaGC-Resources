    "talks": [
        {
            "id": "7053601",
            "objective": "Return to the game table in the garden",
            "dialogues": [
                {
                    "id": "705360101",
                    "speaker": "Klee",
                    "text": "Hehe, Dodoco defeated lots of bad Spikey Fish Warriors! Even the Spikey Fish King was no match!"
                },
                {
                    "id": "705360102",
                    "speaker": "Klee",
                    "text": "Dodoco, Jumpy Dumpty, and Klee's Sparks 'n' Splash are the best!",
                    "choices": [
                        {
                            "id": "705360103",
                            "text": "Truly unstoppable!",
                            "response": [
                                {
                                    "id": "705360105",
                                    "speaker": "Paimon",
                                    "text": "This game reminds Paimon of the incident happening in Cider Lake... Did Lisa base its theme on that?"
                                },
                                {
                                    "id": "705360106",
                                    "speaker": "Paimon",
                                    "text": "But come to think of it, why go to the trouble of finding the invading species when they could just ask Klee to blow up every suspicious fish?"
                                },
                                {
                                    "id": "705360107",
                                    "speaker": "Paimon",
                                    "text": "They could even give us some bombs and let us handle this!",
                                    "choices": [
                                        {
                                            "id": "705360108",
                                            "text": "You and Klee are like two peas in a pod.",
                                            "response": [
                                                {
                                                    "id": "705360110",
                                                    "speaker": "Lisa",
                                                    "text": "Well well, from the looks on your faces, it seems like you're having fun."
                                                },
                                                {
                                                    "id": "705360111",
                                                    "speaker": "Klee",
                                                    "text": "It's Lisa!"
                                                },
                                                {
                                                    "id": "705360112",
                                                    "speaker": "Paimon",
                                                    "text": "You're here!"
                                                },
                                                {
                                                    "id": "705360113",
                                                    "speaker": "Paimon",
                                                    "text": "We loved playing Dodoco's Bomb-Tastic Adventure! What a fun game you designed!"
                                                },
                                                {
                                                    "id": "705360114",
                                                    "speaker": "Lisa",
                                                    "text": "Thanks for playing, I'm glad you enjoyed it. Hmm, perhaps I should come up with some new updates?"
                                                },
                                                {
                                                    "id": "705360115",
                                                    "speaker": "Klee",
                                                    "text": "Oooh, yay! Klee wants to see Dodoco going on adventures in all kinds of places!"
                                                },
                                                {
                                                    "id": "705360116",
                                                    "speaker": "Klee",
                                                    "text": "No, wait... You must've spent a looong time working on the game, it must be exhausting! We shouldn't make Lisa work too hard..."
                                                },
                                                {
                                                    "id": "705360117",
                                                    "speaker": "Lisa",
                                                    "text": "Aw, thank you for being so considerate."
                                                },
                                                {
                                                    "id": "705360118",
                                                    "speaker": "Lisa",
                                                    "text": "But if it helps keep you happy while you stay inside the city, I'll be more than happy to spend as much time as needed."
                                                },
                                                {
                                                    "id": "705360119",
                                                    "speaker": "Lisa",
                                                    "text": "Of course, I understand that you prefer going on your own adventures whenever you like. The game is just meant to be a new way to pass the time."
                                                },
                                                {
                                                    "id": "705360120",
                                                    "speaker": "Lisa",
                                                    "text": "Anyway, I have some great news, and I've also brought a gift for you, cuties."
                                                },
                                                {
                                                    "id": "705360121",
                                                    "speaker": "Klee",
                                                    "text": "A gift!"
                                                },
                                                {
                                                    "id": "705360122",
                                                    "speaker": "Klee",
                                                    "text": "#Actually, I have a gift for {M#Mr.}{F#Miss} Honorary Knight and Paimon, too!"
                                                },
                                                {
                                                    "id": "705360123",
                                                    "speaker": "Lisa",
                                                    "text": "We'll get to the gifts in a moment, let me tell you the news first.",
                                                    "choices": [
                                                        {
                                                            "id": "705360124",
                                                            "text": "Is the incident in Cider Lake resolved?",
                                                            "response": [
                                                                {
                                                                    "id": "705360126",
                                                                    "speaker": "Lisa",
                                                                    "text": "That's right. Two Knights from the Investigation Team found the invasive species' nest and swiftly disposed of it."
                                                                },
                                                                {
                                                                    "id": "705360127",
                                                                    "speaker": "Lisa",
                                                                    "text": "The Knights have also determined the cause of their invasion."
                                                                },
                                                                {
                                                                    "id": "705360128",
                                                                    "speaker": "Lisa",
                                                                    "text": "The species were accidentally introduced to the lake by a merchant without any malicious intent, so the Knights let her go after some lecturing and issuing a fine."
                                                                },
                                                                {
                                                                    "id": "705360129",
                                                                    "speaker": "Paimon",
                                                                    "text": "Phew... Luckily they didn't cause too much trouble. But even Paimon thinks that merchant was way too careless!",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705360130",
                                                                            "text": "The water in Cider Lake is safe!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705360132",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Is it time for gifts yet? Can Klee go first?"
                                                                                },
                                                                                {
                                                                                    "id": "705360133",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Of course."
                                                                                },
                                                                                {
                                                                                    "id": "705360134",
                                                                                    "speaker": "Lisa",
                                                                                    "text": "Klee's been returning home on time every day without being reminded by anyone, so I've been wondering what you're up to lately..."
                                                                                },
                                                                                {
                                                                                    "id": "705360135",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Hehe~"
                                                                                },
                                                                                {
                                                                                    "id": "705360136",
                                                                                    "speaker": "Klee",
                                                                                    "text": "When I was home at night, I looked through Albedo's crafting book and learned to make this!"
                                                                                },
                                                                                {
                                                                                    "id": "705360137",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Tada!"
                                                                                },
                                                                                {
                                                                                    "id": "705360138",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Whoa, it's Dodoco throwing a Jumpy Dumpty!"
                                                                                },
                                                                                {
                                                                                    "id": "705360139",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Yep! I made a figure that looks like the Dodoco from Dodoco's Bomb-Tastic Adventure!"
                                                                                },
                                                                                {
                                                                                    "id": "705360140",
                                                                                    "speaker": "Klee",
                                                                                    "text": "Even though I can't make it throw real bombs..."
                                                                                },
                                                                                {
                                                                                    "id": "705360141",
                                                                                    "speaker": "Klee",
                                                                                    "text": "I hope it'll remind you of the fun we had together and blast away your troubles and boredom!"
                                                                                },
                                                                                {
                                                                                    "id": "705360142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "A big Dodoco toy! Paimon loves surprises like this!"
                                                                                },
                                                                                {
                                                                                    "id": "705360143",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "With this, it'll feel like we're adventuring with Klee and Dodoco wherever we go!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705360144",
                                                                                            "text": "Thank you for the creative and thoughtful gift, Klee!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705360146",
                                                                                                    "speaker": "Klee",
                                                                                                    "text": "Hehe, I'm so happy you like my gift! I worked super hard on it!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360147",
                                                                                                    "speaker": "Klee",
                                                                                                    "text": "What's your gift, Lisa? I wanna see!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360148",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Well, I'm afraid my gift is a lot less creative than yours."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360149",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "It's a storybook about Dodoco's Bomb-Tastic Adventures—"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360150",
                                                                                                    "speaker": "Klee",
                                                                                                    "text": "An adventure story! Yay!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360151",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Wow, a whole storybook!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360152",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "The little cuties returned to Mondstadt and joined Klee on an adventure with Dodoco!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360153",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "Together they defeated the bad Spikey Fish Warriors and then enjoyed an afternoon tea..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360154",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "A most fitting way to end Dodoco's Bomb-Tastic Adventure."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360155",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Did you plan out the whole story while designing the game?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360156",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "No. As the protagonists of the story, you, little cutie, and Klee all played an important part in bringing the story to life."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360157",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "I've left a blank spot in the book specially for illustrations..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360158",
                                                                                                    "speaker": "Lisa",
                                                                                                    "text": "But I just thought of an even better idea — since we're all here on this special occasion, why don't I take a photo of you together?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705360159",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Sure! We got to see our friends and play games together, that's definitely worth celebrating!",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705360160",
                                                                                                            "text": "Let's take a group photo!",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705360162",
                                                                                                                    "speaker": "Klee",
                                                                                                                    "text": "#C'mon then, {M#Mr.}{F#Miss} Honorary Knight and Paimon! Ready, Lisa?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705360163",
                                                                                                                    "speaker": "Klee",
                                                                                                                    "text": "Klee had so much fun today! Three, two, one... Dodoco!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705360161",
                                                                                                            "text": "You gotta treasure the small joys in life!"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705360145",
                                                                                            "text": "Dodoco will come with us on all our adventures from now on!"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705360131",
                                                                            "text": "Mondstadt's wine industry is safe!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705360125",
                                                            "text": "Can Klee play outside again?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705360109",
                                            "text": "Nope, no bombs for Paimon."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705360104",
                            "text": "Take that, bad fish!"
                        }
                    ]
                }
            ]
        }
    ]
}