    "talks": [
        {
            "id": "48101",
            "objective": "Talk to Amber",
            "dialogues": [
                {
                    "id": "4810101",
                    "speaker": "Amber",
                    "text": "#Hey {NICKNAME}! I've been looking for you everywhere! How's that wind glider I gave you last time?",
                    "choices": [
                        {
                            "id": "4810102",
                            "text": "Pretty good.",
                            "response": [
                                {
                                    "id": "4810104",
                                    "speaker": "Amber",
                                    "text": "Seems like it's really growing on you!"
                                },
                                {
                                    "id": "4810105",
                                    "speaker": "Amber",
                                    "text": "But then again, you don't have a gliding license, do you?"
                                },
                                {
                                    "id": "4810106",
                                    "speaker": "Paimon",
                                    "text": "A gliding license? Hmm... What's that?"
                                },
                                {
                                    "id": "4810107",
                                    "speaker": "Amber",
                                    "text": "Isn't it obvious? You gotta have a gliding license to legally glide in Mondstadt."
                                },
                                {
                                    "id": "4810108",
                                    "speaker": "Paimon",
                                    "text": "#Oh... but {NICKNAME} and Paimon have been gliding for ages now. This is the first we've heard about it!"
                                },
                                {
                                    "id": "4810109",
                                    "speaker": "Amber",
                                    "text": "Yeah, you've been gliding all over the place... Everyone's noticed!"
                                },
                                {
                                    "id": "4810110",
                                    "speaker": "Paimon",
                                    "text": "Eh-he."
                                },
                                {
                                    "id": "4810111",
                                    "speaker": "Paimon",
                                    "text": "Sooo... You came looking for us because you wanna give us a gliding license?"
                                },
                                {
                                    "id": "4810112",
                                    "speaker": "Amber",
                                    "text": "No way! The Knights of Favonius have strict rules."
                                },
                                {
                                    "id": "4810113",
                                    "speaker": "Amber",
                                    "text": "You need to pass an exam, and only then will the Knights issue your license."
                                },
                                {
                                    "id": "4810114",
                                    "speaker": "Amber",
                                    "text": "#Today I'm here as an examiner, to oversee {NICKNAME}'s official gliding exam!"
                                },
                                {
                                    "id": "4810115",
                                    "speaker": "Amber",
                                    "text": "I gave you your wind glider, so this is my responsibility — at least, that's what Acting Grand Master Jean would say."
                                },
                                {
                                    "id": "4810116",
                                    "speaker": "Paimon",
                                    "text": "An exam! What a pain in the butt. Then again, since Amber is the examiner...",
                                    "choices": [
                                        {
                                            "id": "4810117",
                                            "text": "...Maybe you can cut me some slack?",
                                            "response": [
                                                {
                                                    "id": "4810118",
                                                    "speaker": "Amber",
                                                    "text": "No with a capital N-O! Do not challenge the authority of examiner Amber!"
                                                },
                                                {
                                                    "id": "4810121",
                                                    "speaker": "Amber",
                                                    "text": "I mean... The whole city saw how well you flew the day that Stormterror attacked, so I'm sure you'll have no problems!"
                                                },
                                                {
                                                    "id": "4810122",
                                                    "speaker": "Amber",
                                                    "text": "But we do need to respect the rules and glide properly."
                                                },
                                                {
                                                    "id": "4810123",
                                                    "speaker": "Amber",
                                                    "text": "Here. Take this gliding manual. No need to memorize it, just be familiar with everything in there."
                                                },
                                                {
                                                    "id": "4810124",
                                                    "speaker": "Amber",
                                                    "text": "For example: only one person per wind glider, no carrying anything over the set weight limit, no taking off using an Anemo Slime, and so on and so forth."
                                                },
                                                {
                                                    "id": "4810125",
                                                    "speaker": "Amber",
                                                    "text": "Anyway, be sure to read it, okay? I had to read a load of big, thick books too when Lisa was teaching me magic..."
                                                },
                                                {
                                                    "id": "4810126",
                                                    "speaker": "Paimon",
                                                    "text": "Wow, that's a big old book... Paimon thinks we best get started!"
                                                },
                                                {
                                                    "id": "4810127",
                                                    "speaker": "Amber",
                                                    "text": "Great. Come find me when you're done, I'll be at Windrise."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4810119",
                                            "text": "It's fine. I can do this.",
                                            "response": [
                                                {
                                                    "id": "4810120",
                                                    "speaker": "Amber",
                                                    "text": "#I'm sure {NICKNAME} will glide through it!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4810103",
                            "text": "I keep getting carried away and gliding too high."
                        }
                    ]
                }
            ]
        },
        {
            "id": "48102",
            "objective": "Read Amber's Gliding Guide (Hidden)",
            "dialogues": []
        },
        {
