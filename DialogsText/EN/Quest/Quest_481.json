                {
                    "id": "4810401",
                    "speaker": "Paimon",
                    "text": "*sigh* The Knights of Favonius gliding manual does NOT sound like a fun read..."
                },
                {
                    "id": "4810402",
                    "speaker": "Player",
                    "text": "Well, guess I'd better get started."
                }
            ]
        },
        {
            "id": "48105",
            "objective": "Play - Fable",
            "dialogues": []
        },
        {
            "id": "48106",
            "objective": "Paimon's Doubts",
            "dialogues": [
                {
                    "id": "4810601",
                    "speaker": "Paimon",
                    "text": "Hmm... That's a cool story... But is the Knights' gliding manual really written in that style?",
                    "choices": [
                        {
                            "id": "4810602",
                            "text": "It reads like a fairytale...",
                            "response": [
                                {
                                    "id": "4810604",
                                    "speaker": "Paimon",
                                    "text": "Huh. Anyway, let's go find Amber."
                                }
                            ]
                        },
                        {
                            "id": "4810603",
                            "text": "People in Mondstadt really understand the romance in learning to glide."
                        }
                    ]
                }
            ]
        }
