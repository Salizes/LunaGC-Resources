    "talks": [
        {
            "id": "7105801",
            "objective": "",
            "dialogues": [
                {
                    "id": "710580101",
                    "speaker": "???",
                    "text": "*cough*... W—Wait! Stop! Who are you? Why are you here...?"
                },
                {
                    "id": "710580102",
                    "speaker": "???",
                    "text": "And... why are you attacking me?"
                },
                {
                    "id": "710580103",
                    "speaker": "Paimon",
                    "text": "You are one to talk! We saw you sneaking around!"
                },
                {
                    "id": "710580104",
                    "speaker": "Player",
                    "text": "Since you're the bad guy here, why don't you explain yourself first?"
                },
                {
                    "id": "710580105",
                    "speaker": "???",
                    "text": "...Katarina. My name is Katarina Snezhevna."
                },
                {
                    "id": "710580106",
                    "speaker": "Katarina",
                    "text": "My name is the most I can divulge. My apologies."
                },
                {
                    "id": "710580107",
                    "speaker": "Paimon",
                    "text": "Uh... We just want to know what's happening. We aren't trying to interrogate you!"
                },
                {
                    "id": "710580108",
                    "speaker": "Katarina",
                    "text": "S—Sorry. That really is all I can disclose."
                },
                {
                    "id": "710580109",
                    "speaker": "Player",
                    "text": "What are the Fatui doing here?"
                },
                {
                    "id": "710580110",
                    "speaker": "Katarina",
                    "text": "That's classified."
                },
                {
                    "id": "710580111",
                    "speaker": "Player",
                    "text": "..."
                },
                {
                    "id": "710580112",
                    "speaker": "Paimon",
                    "text": "Come on, bad guys do have a thing for being secretive!"
                },
                {
                    "id": "710580113",
                    "speaker": "Katarina",
                    "text": "Hehe, you're right. We're the bad guys and that's what we do."
                },
                {
                    "id": "710580114",
                    "speaker": "Katarina",
                    "text": "Alright, time's up for the question-and-answer session.. We've got company!"
                }
            ]
        },
        {
            "id": "7105802",
            "objective": "The defeated Fatui Mage seems to have something to tell you.",
            "dialogues": []
        },
        {
            "id": "7105803",
            "objective": "Defeat the Floating Fungi that emerged",
            "dialogues": []
        },
        {
            "id": "7105804",
            "objective": "Continue talking to the Fatui Mage",
            "dialogues": [
                {
                    "id": "710580201",
                    "speaker": "Katarina",
                    "text": "Thank you... for not stabbing me in the back.",
                    "choices": [
                        {
                            "id": "710580202",
                            "text": "The feeling's mutual.",
                            "response": [
                                {
                                    "id": "710580204",
                                    "speaker": "Katarina",
                                    "text": "Pfft... Although I don't know where you got that impression, this isn't a romantic place to try hitting on me... Come to my hideout if you wish to talk."
                                },
                                {
                                    "id": "710580207",
                                    "speaker": "Black Screen",
                                    "text": "Katarina leaves."
                                },
                                {
                                    "id": "710580205",
                                    "speaker": "Paimon",
                                    "text": "Eh? Isn't she a Fatuus? Is it really OK to just let her go instead of sending her to the Millelith?"
                                },
                                {
                                    "id": "710580206",
                                    "speaker": "Paimon",
                                    "text": "Hmph... Alright, Paimon gets it. Forget it. She didn't hurt us, after all. Let's let her off the hook this time, shall we?"
                                }
                            ]
                        },
                        {
                            "id": "710580203",
                            "text": "So, the Fatui all have trust issues, huh?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7105805",
            "objective": "Go to the Fatui Mage's hidden encampment",
            "dialogues": [
                {
                    "id": "710580501",
                    "speaker": "Katarina",
                    "text": "As expected, you came. Please take a seat."
                },
                {
                    "id": "710580502",
                    "speaker": "Katarina",
                    "text": "Lemme see what's left... Black tea is out... Sugar, out too... Alright, here's some milk— Ugh, it's turned sour. Gotta throw it away later. Um, my apologies."
                },
                {
                    "id": "710580503",
                    "speaker": "Katarina",
                    "text": "But there is plenty of Fire-Water, plus some hardtack and sour jam to go with it — enough for a tea party."
                },
                {
                    "id": "710580504",
                    "speaker": "Paimon",
                    "text": "Whoa...! Do you people really consider Fire-Water to be a standard tea party thing?"
                },
                {
                    "id": "710580505",
                    "speaker": "Katarina",
                    "text": "Yep, what's the problem with it?",
                    "choices": [
                        {
                            "id": "710580506",
                            "text": "Uh... I'll pass.",
                            "response": [
                                {
                                    "id": "710580507",
                                    "speaker": "Katarina",
                                    "text": "What? Hehe, no one's gonna call you out on drinking here. Just suit yourself!",
                                    "choices": [
                                        {
                                            "id": "710580510",
                                            "text": "What are you doing?",
                                            "response": [
                                                {
                                                    "id": "710580512",
                                                    "speaker": "Katarina",
                                                    "text": "\"Sharing food and intel at the right moment is conducive to silencing a curious mouth.\""
                                                },
                                                {
                                                    "id": "710580513",
                                                    "speaker": "Katarina",
                                                    "text": "...that's what our handbook says."
                                                },
                                                {
                                                    "id": "710580514",
                                                    "speaker": "Player",
                                                    "text": "Well, where's the intel?"
                                                },
                                                {
                                                    "id": "710580515",
                                                    "speaker": "Katarina",
                                                    "text": "Uh? I just shared it."
                                                },
                                                {
                                                    "id": "710580516",
                                                    "speaker": "Paimon",
                                                    "text": "Huh? Did you tell us anything?"
                                                },
                                                {
                                                    "id": "710580517",
                                                    "speaker": "Katarina",
                                                    "text": "Fatui Advance Team Handbook, Appendix 4-4, Article 32: \"Sharing food and intel at the right moment is conducive to silencing a curious mouth.\" You're welcome."
                                                },
                                                {
                                                    "id": "710580518",
                                                    "speaker": "Katarina",
                                                    "text": "You saved my life and in return, I divulged classified content from our handbook. Hehe, how's that for sincerity?"
                                                },
                                                {
                                                    "id": "710580519",
                                                    "speaker": "Paimon",
                                                    "text": "What's the use of that!?"
                                                },
                                                {
                                                    "id": "710580520",
                                                    "speaker": "Katarina",
                                                    "text": "Hehe, jokes aside... Actually, I'm very grateful for your help, but my kind gesture doesn't mean anything else."
                                                },
                                                {
                                                    "id": "710580521",
                                                    "speaker": "Paimon",
                                                    "text": "Uh... with what you people have done, Paimon finds it hard to believe in your \"kind gesture\"..."
                                                },
                                                {
                                                    "id": "710580522",
                                                    "speaker": "Player",
                                                    "text": "What are you up to, really?"
                                                },
                                                {
                                                    "id": "710580523",
                                                    "speaker": "Katarina",
                                                    "text": "It's no surprise that outsiders fail to understand the cause of the Fatui. But when we aren't talking about what we pursue or which side we are on, we are just a bunch of ordinary people."
                                                },
                                                {
                                                    "id": "710580524",
                                                    "speaker": "Katarina",
                                                    "text": "...Besides, all our agendas and deeds are just preparatory work for the final battle."
                                                },
                                                {
                                                    "id": "710580525",
                                                    "speaker": "Player",
                                                    "text": "The final battle...?"
                                                },
                                                {
                                                    "id": "710580526",
                                                    "speaker": "Katarina",
                                                    "text": "Yes, in the end, all of us shall face a common enemy and the inescapable long night... Everyone in Snezhnaya has been thusly warned."
                                                },
                                                {
                                                    "id": "710580527",
                                                    "speaker": "Katarina",
                                                    "text": "So, every drop of tears and blood of mankind, shed for the sake of this cruel world... They shall not be shed in vain."
                                                },
                                                {
                                                    "id": "710580528",
                                                    "speaker": "Katarina",
                                                    "text": "Let's have a toast! No? Hmph, I'll just suit myself...",
                                                    "choices": [
                                                        {
                                                            "id": "710580529",
                                                            "text": "Is this how you justify the evil you've done?",
                                                            "response": [
                                                                {
                                                                    "id": "710580530",
                                                                    "speaker": "Katarina",
                                                                    "text": "Maybe you're right... I don't know, nor do I care to know. You wanted an explanation, and I gave you one. You're free to not find it to your liking. That's all."
                                                                },
                                                                {
                                                                    "id": "710580534",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ugh... Where did all that deep stuff suddenly come from..."
                                                                },
                                                                {
                                                                    "id": "710580535",
                                                                    "speaker": "Katarina",
                                                                    "text": "By the way, I've introduced myself, but I don't know your name yet.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "710580536",
                                                                            "text": "#{NICKNAME}.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "710580538",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "And Paimon's Paimon!"
                                                                                },
                                                                                {
                                                                                    "id": "710580539",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Oh! Your names...!"
                                                                                },
                                                                                {
                                                                                    "id": "710580540",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hehehe! We're pretty well-known all over the Teyvat, aren't we?"
                                                                                },
                                                                                {
                                                                                    "id": "710580541",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Sorry, I've never heard of you... Either of you, actually."
                                                                                },
                                                                                {
                                                                                    "id": "710580542",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "What!?"
                                                                                },
                                                                                {
                                                                                    "id": "710580543",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Please don't take it the wrong way — I was sent down here a long time ago. I barely know anything about what's happening on the surface save for the news we get through our supply lines."
                                                                                },
                                                                                {
                                                                                    "id": "710580544",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Eh... Doesn't that mean..."
                                                                                },
                                                                                {
                                                                                    "id": "710580545",
                                                                                    "speaker": "Player",
                                                                                    "text": "That your supply line's long been cut off?"
                                                                                },
                                                                                {
                                                                                    "id": "710580546",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "..."
                                                                                },
                                                                                {
                                                                                    "id": "710580547",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Tea party's over! I need to get some rest. Excuse me!"
                                                                                },
                                                                                {
                                                                                    "id": "710580548",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Hey! We haven't even started eating yet!"
                                                                                },
                                                                                {
                                                                                    "id": "710580549",
                                                                                    "speaker": "Katarina",
                                                                                    "text": "Leave already! Didn't you just frown upon my Fire-Water?"
                                                                                },
                                                                                {
                                                                                    "id": "710580550",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "That's because Paimon didn't think it was drinkable at all!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "710580551",
                                                                                            "text": "Alright, Paimon...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "710580553",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hmph!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580554",
                                                                                                    "speaker": "Katarina",
                                                                                                    "text": "#By the way, uh...! {NICKNAME}, please wait—"
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580555",
                                                                                                    "speaker": "Katarina",
                                                                                                    "text": "Uh, it's nothing. I'm just thinking... that if it were you..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "710580556",
                                                                                                    "speaker": "Katarina",
                                                                                                    "text": "Please come back another day... if you don't find it too troublesome."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "710580552",
                                                                                            "text": "People have different food preferences, y'know..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "710580537",
                                                                            "text": "#You might've heard about me. I'm {NICKNAME}."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710580531",
                                                            "text": "That's quite a lofty-sounding explanation...",
                                                            "response": [
                                                                {
                                                                    "id": "710580532",
                                                                    "speaker": "Katarina",
                                                                    "text": "Ha...! You know what? You should try the liquor and jam from Snezhnaya."
                                                                },
                                                                {
                                                                    "id": "710580533",
                                                                    "speaker": "Katarina",
                                                                    "text": "Don't take it all too seriously, and don't think too much about it. Just trust what you want to trust. That's what we call \"belief.\""
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710580511",
                                            "text": "What are you up to?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710580508",
                            "text": "We are not here for your tea party...",
                            "response": [
                                {
                                    "id": "710580509",
                                    "speaker": "Katarina",
                                    "text": "I know. I know... Don't get so serious.",
                                    "choices": [
                                        {
                                            "id": "710580510",
                                            "text": "What are you doing?"
                                        },
                                        {
                                            "id": "710580511",
                                            "text": "What are you up to?"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
