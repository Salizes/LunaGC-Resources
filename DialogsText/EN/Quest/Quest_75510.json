    "talks": [
        {
            "id": "7551001",
            "objective": "Talk to Vigee",
            "dialogues": [
                {
                    "id": "755100101",
                    "speaker": "Little Pinecone",
                    "text": "Although the Masked Warrior can't fly about like the Peacemaker, all she has to do to win is time her charges right!"
                },
                {
                    "id": "755100102",
                    "speaker": "Flammabomb Wood Figure",
                    "text": "You blithering idiot! You can't just think of how fast she can run in a straight line — if she can't turn or hit anything, it won't make any difference!"
                },
                {
                    "id": "755100103",
                    "speaker": "Vigee",
                    "text": "That's enough, children. We can have a civilized discussion, can't we?"
                },
                {
                    "id": "755100104",
                    "speaker": "Flammabomb Wood Figure",
                    "text": "We're being civilized...! It's just, well, when we talk about great warriors, we get pumped up!"
                },
                {
                    "id": "755100105",
                    "speaker": "Little Pinecone",
                    "text": "Don'cha worry none, Miss Vigee! We might be at war, but we're gonna fight with reason and evidence!"
                },
                {
                    "id": "755100106",
                    "speaker": "Flammabomb Wood Figure",
                    "text": "...Oho! I just thought of a new strategy. I challenge you again!"
                },
                {
                    "id": "755100107",
                    "speaker": "Little Pinecone",
                    "text": "Rematch, rematch!",
                    "choices": [
                        {
                            "id": "755100108",
                            "text": "...Sure is lively here.",
                            "response": [
                                {
                                    "id": "755100110",
                                    "speaker": "Vigee",
                                    "text": "A new customer! Hello there!"
                                },
                                {
                                    "id": "755100111",
                                    "speaker": "Vigee",
                                    "text": "Judging by your attire, you're a traveler, aren't you? We've got that in common!"
                                },
                                {
                                    "id": "755100112",
                                    "speaker": "Vigee",
                                    "text": "Do you want to try out this interactive woven scroll I've created with the children?",
                                    "choices": [
                                        {
                                            "id": "755100113",
                                            "text": "\"Interactive woven scroll\"?",
                                            "response": [
                                                {
                                                    "id": "755100115",
                                                    "speaker": "Vigee",
                                                    "text": "Simply put, it's a game that combines Liyue's paper theater, Inazuma's comics, and Fontaine's film technology."
                                                },
                                                {
                                                    "id": "755100116",
                                                    "speaker": "Vigee",
                                                    "text": "It's inspired by our local heroes, and adds the concept of \"crossover challenges\" to create a novel story."
                                                },
                                                {
                                                    "id": "755100117",
                                                    "speaker": "Vigee",
                                                    "text": "Give it a try! Who knows, it might be a new experience for you."
                                                },
                                                {
                                                    "id": "755100118",
                                                    "speaker": "Player",
                                                    "text": "With pleasure!"
                                                },
                                                {
                                                    "id": "755100119",
                                                    "speaker": "Vigee",
                                                    "text": "Wonderful! Have a great time!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755100114",
                                            "text": "A scroll that moves on its own?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755100109",
                            "text": "What's going on?"
                        }
                    ]
                }
            ]
        },
