    "talks": [
        {
            "id": "7002001",
            "objective": "Talk to the other hilichurl willing to make conversation",
            "dialogues": [
                {
                    "id": "700200102",
                    "speaker": "Solitary Hilichurl",
                    "text": "Odomu! Ya dala?"
                },
                {
                    "id": "700200103",
                    "speaker": "Ella Musk",
                    "text": "Wait. Let me handle this."
                },
                {
                    "id": "700200104",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo, Odomu nye! Muhe mani?"
                },
                {
                    "id": "700200105",
                    "speaker": "Solitary Hilichurl",
                    "text": "Mani? Mani! Yoyo mani mi?"
                },
                {
                    "id": "700200106",
                    "speaker": "Ella Musk",
                    "text": "Dada!"
                },
                {
                    "id": "700200107",
                    "speaker": "Solitary Hilichurl",
                    "text": "Dada!",
                    "choices": [
                        {
                            "id": "700200108",
                            "text": "That seemed to go well.",
                            "response": [
                                {
                                    "id": "700200110",
                                    "speaker": "Ella Musk",
                                    "text": "I asked if it wanted any help from us, and sure enough, it seems like it does."
                                },
                                {
                                    "id": "700200111",
                                    "speaker": "Solitary Hilichurl",
                                    "text": "Dada odomu! Kundala dada! Kundala zido, mi dada! Muhe yeye!"
                                },
                                {
                                    "id": "700200112",
                                    "speaker": "Ella Musk",
                                    "text": "Oh... It's basically saying that it wants us to help it... defeat a strong enemy."
                                },
                                {
                                    "id": "700200113",
                                    "speaker": "Ella Musk",
                                    "text": "Ya zido? Ye? Mi?"
                                },
                                {
                                    "id": "700200114",
                                    "speaker": "Solitary Hilichurl",
                                    "text": "Mi! Mi!"
                                },
                                {
                                    "id": "700200115",
                                    "speaker": "Ella Musk",
                                    "text": "Okay, the enemy's location is marked on the Map. Over to you!"
                                },
                                {
                                    "id": "700200116",
                                    "speaker": "Solitary Hilichurl",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700200109",
                            "text": "What did you say?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002002",
            "objective": "Go to the designated location for a fight",
            "dialogues": [
                {
                    "id": "700200201",
                    "speaker": "Solitary Hilichurl",
                    "text": "Yeye dada! Mosi mita!"
                },
                {
                    "id": "700200202",
                    "speaker": "Solitary Hilichurl",
                    "text": "Odomu tomo zido mi! Mi mani yeye! <color=#00E1FFFF>Unta nunu</color>!"
                },
                {
                    "id": "700200203",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Unta nunu</color>... Paimon thinks that has something to do with time. You should definitely check that in the handbook.",
                    "choices": [
                        {
                            "id": "700200204",
                            "text": "Uhh... Th—Thank you...",
                            "response": [
                                {
                                    "id": "700200206",
                                    "speaker": "Solitary Hilichurl",
                                    "text": "Valo, tomo!"
                                },
                                {
                                    "id": "700200207",
                                    "speaker": "Paimon",
                                    "text": "Hehe, valo!"
                                }
                            ]
                        },
                        {
                            "id": "700200205",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
