    "talks": [
        {
            "id": "39301",
            "objective": "Activate the seal at the entrance",
            "dialogues": [
                {
                    "id": "3930101",
                    "speaker": "Venti",
                    "text": "I'm thinking about turning these adventures into songs after we're done...",
                    "choices": [
                        {
                            "id": "3930102",
                            "text": "Well, we certainly have gone through quite a lot recently.",
                            "response": [
                                {
                                    "id": "3930104",
                                    "speaker": "Venti",
                                    "text": "Hopefully, this song will be sung for years to come by the people of Mondstadt, just like The Legend of Vennessa."
                                },
                                {
                                    "id": "3930105",
                                    "speaker": "Jean",
                                    "text": "I have loved that song since I was small."
                                },
                                {
                                    "id": "3930106",
                                    "speaker": "Jean",
                                    "text": "#How are you feeling today {NICKNAME}?"
                                },
                                {
                                    "id": "3930107",
                                    "speaker": "Jean",
                                    "text": "I am completely prepared and fully confident that we can do this.",
                                    "choices": [
                                        {
                                            "id": "3930108",
                                            "text": "You're so reliable, Master Jean.",
                                            "response": [
                                                {
                                                    "id": "3930110",
                                                    "speaker": "Paimon",
                                                    "text": "Even Master Diluc accompanied us to the very end."
                                                },
                                                {
                                                    "id": "3930111",
                                                    "speaker": "Paimon",
                                                    "text": "Despite only being an accidentally involved..."
                                                },
                                                {
                                                    "id": "3930112",
                                                    "speaker": "Paimon",
                                                    "text": "...Bystander."
                                                },
                                                {
                                                    "id": "3930113",
                                                    "speaker": "Diluc",
                                                    "text": "You shared your secret with me, and I only returned your trust to the same extent.",
                                                    "choices": [
                                                        {
                                                            "id": "3930114",
                                                            "text": "So \"trust\" is what drove Master Diluc here.",
                                                            "response": [
                                                                {
                                                                    "id": "3930115",
                                                                    "speaker": "Paimon",
                                                                    "text": "As for Master Jean... \"responsibility\" perhaps?"
                                                                },
                                                                {
                                                                    "id": "3930116",
                                                                    "speaker": "Paimon",
                                                                    "text": "What about the Tone-Deaf Bard?"
                                                                },
                                                                {
                                                                    "id": "3930121",
                                                                    "speaker": "Venti",
                                                                    "text": "It's \"freedom.\""
                                                                },
                                                                {
                                                                    "id": "3930122",
                                                                    "speaker": "Paimon",
                                                                    "text": "Freedom...?"
                                                                },
                                                                {
                                                                    "id": "3930123",
                                                                    "speaker": "Venti",
                                                                    "text": "When you first arrived at Mondstadt, did no one tell you that Mondstadt is the City of Freedom?"
                                                                },
                                                                {
                                                                    "id": "3930124",
                                                                    "speaker": "Player",
                                                                    "text": "Amber..."
                                                                },
                                                                {
                                                                    "id": "3930125",
                                                                    "speaker": "Venti",
                                                                    "text": "Hahaha... She really is a child of freedom!"
                                                                },
                                                                {
                                                                    "id": "3930126",
                                                                    "speaker": "Venti",
                                                                    "text": "Mondstadt is a romantic city, without the reign of a king."
                                                                },
                                                                {
                                                                    "id": "3930127",
                                                                    "speaker": "Venti",
                                                                    "text": "And its citizens enjoy the most freedom amongst the seven nations."
                                                                },
                                                                {
                                                                    "id": "3930128",
                                                                    "speaker": "Venti",
                                                                    "text": "I hope the dragon that once protected Mondstadt will soon be free too..."
                                                                },
                                                                {
                                                                    "id": "3930129",
                                                                    "speaker": "Venti",
                                                                    "text": "No one should have deceived him by telling him that Mondstadt betrayed him."
                                                                },
                                                                {
                                                                    "id": "3930130",
                                                                    "speaker": "Venti",
                                                                    "text": "And no one should have told him that it was his eternal duty to protect the city."
                                                                },
                                                                {
                                                                    "id": "3930131",
                                                                    "speaker": "Venti",
                                                                    "text": "He has the right and freedom to choose his own way of life."
                                                                },
                                                                {
                                                                    "id": "3930132",
                                                                    "speaker": "Paimon",
                                                                    "text": "Venti..."
                                                                },
                                                                {
                                                                    "id": "3930133",
                                                                    "speaker": "Venti",
                                                                    "text": "#Well then, {NICKNAME}, may the thousands of years of wind that have blown through Mondstadt go with you."
                                                                },
                                                                {
                                                                    "id": "3930134",
                                                                    "speaker": "Venti",
                                                                    "text": "Just like the last time, I shall channel Anemo energy for you.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "3930135",
                                                                            "text": "...\"Last time\"?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "3930137",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Oh! No wonder {NICKNAME} said his voice sounds familiar!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "3930136",
                                                                            "text": "I knew it! It was YOUR voice I heard."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3930117",
                                                            "text": "So \"responsibility\" is what drove Master Jean here.",
                                                            "response": [
                                                                {
                                                                    "id": "3930118",
                                                                    "speaker": "Paimon",
                                                                    "text": "As for Master Diluc... \"trust\" perhaps?"
                                                                },
                                                                {
                                                                    "id": "3930119",
                                                                    "speaker": "Paimon",
                                                                    "text": "What about the Tone-Deaf Bard?"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "3930120",
                                                            "text": "What about Venti?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3930109",
                                            "text": "Rest assured, I'm also completely prepared!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3930103",
                            "text": "We're practically old partners now."
                        }
                    ]
                }
            ]
        },
        {
            "id": "39302",
            "objective": "Go back to the top of the tower",
            "dialogues": [
                {
                    "id": "3930201",
                    "speaker": "Venti",
                    "text": "Turning winds that nurture life into winds that speak of adventure doesn't sound bad to me."
                },
                {
                    "id": "3930202",
                    "speaker": "Venti",
                    "text": "The fate of <color=#00E1FFFF>Dvalin</color> rests in your hands, so take good care of him, alright?"
                }
            ]
        }
    ]
