    "talks": [
        {
            "id": "7250101",
            "objective": "Talk to Asagiri",
            "dialogues": []
        },
        {
            "id": "7250102",
            "objective": "Talk to Asagiri",
            "dialogues": [
                {
                    "id": "725010201",
                    "speaker": "Asagiri",
                    "text": "Why does Miss Moriko always give me these weird commissions?",
                    "choices": [
                        {
                            "id": "725010202",
                            "text": "Are you still drawing illustrations?",
                            "response": [
                                {
                                    "id": "725010204",
                                    "speaker": "Asagiri",
                                    "text": "Ah, Traveler, what brings you here? It's been a while, and I thought you'd traveled to other nations."
                                },
                                {
                                    "id": "725010205",
                                    "speaker": "Asagiri",
                                    "text": "*sigh* How I wish I was in a better condition. Then I could travel as freely as you do."
                                },
                                {
                                    "id": "725010206",
                                    "speaker": "Asagiri",
                                    "text": "And Miss Moriko wouldn't be able to come and nag me on work progress every day..."
                                },
                                {
                                    "id": "725010207",
                                    "speaker": "Asagiri",
                                    "text": "My illustrations last time were well received. Many novelists have since been requesting my works."
                                },
                                {
                                    "id": "725010230",
                                    "speaker": "Asagiri",
                                    "text": "Although Miss Moriko has rejected many jobs for me, the remaining commissions are still overwhelming..."
                                },
                                {
                                    "id": "725010209",
                                    "speaker": "Asagiri",
                                    "text": "At first, I thought outside of Inazuma, Liyue and Mondstadt would be the furthest stages for their stories to unfold..."
                                },
                                {
                                    "id": "725010210",
                                    "speaker": "Asagiri",
                                    "text": "Yet they now have protagonists adventuring in Sumeru, and Fontaine even."
                                },
                                {
                                    "id": "725010216",
                                    "speaker": "Asagiri",
                                    "text": "Well, enough of my complaints. Traveler, is your Kamera still functional?",
                                    "choices": [
                                        {
                                            "id": "725010217",
                                            "text": "It's working alright...",
                                            "response": [
                                                {
                                                    "id": "725010219",
                                                    "speaker": "Asagiri",
                                                    "text": "Well, my payment last time was quite decent, wasn't it?"
                                                },
                                                {
                                                    "id": "725010220",
                                                    "speaker": "Asagiri",
                                                    "text": "So, Traveler, please take more pictures throughout the world for me!",
                                                    "choices": [
                                                        {
                                                            "id": "725010221",
                                                            "text": "*sigh* Fine, leave it to me...",
                                                            "response": [
                                                                {
                                                                    "id": "725010222",
                                                                    "speaker": "Asagiri",
                                                                    "text": "I'll be counting on you then! Hehe, I've got my notebook ready!"
                                                                },
                                                                {
                                                                    "id": "725010223",
                                                                    "speaker": "Asagiri",
                                                                    "text": "If you hadn't shown up, I'd ask Miss Moriko to look for you..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "725010224",
                                                            "text": "You know you can just put up a request at the Adventurers' Guild, right?",
                                                            "response": [
                                                                {
                                                                    "id": "725010225",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Whoa! That won't do! Please, please, please help me! I've put up commissions but just couldn't find someone savvy enough to handle the Kamera."
                                                                },
                                                                {
                                                                    "id": "725010226",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Just help me this time, will you? If I so much as missed another deadline, Miss Moriko'd definitely knock on my door, threatening to move in!"
                                                                },
                                                                {
                                                                    "id": "725010227",
                                                                    "speaker": "Asagiri",
                                                                    "text": "My stomach is already telling me that it doesn't want the Sakura Chazuke she'll make! Traveler, you have to help me!"
                                                                },
                                                                {
                                                                    "id": "725010228",
                                                                    "speaker": "Player",
                                                                    "text": "Okay, okay, I got it..."
                                                                },
                                                                {
                                                                    "id": "725010229",
                                                                    "speaker": "Asagiri",
                                                                    "text": "Phew... What a relief. Wait a bit. Let me look for my notebook..."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "725010218",
                                            "text": "Do you want me to take more pictures?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "725010203",
                            "text": "You ran out of inspiration again?"
                        }
                    ]
                }
            ]
        }
    ]
}