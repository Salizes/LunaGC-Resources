    "talks": [
        {
            "id": "7502801",
            "objective": "",
            "dialogues": [
                {
                    "id": "750280101",
                    "speaker": "Mouse",
                    "text": "Ugh, you're... tougher than you look..."
                },
                {
                    "id": "750280102",
                    "speaker": "Night Owl",
                    "text": "Gah. Who did we offend... Who'd send someone on this day, of all days, to come whack us..."
                },
                {
                    "id": "750280103",
                    "speaker": "Night Owl",
                    "text": "#Please, {M#Big Bro}{F#Big Sis}. How have we offended you? Just... let us know. We won't do it again."
                },
                {
                    "id": "750280104",
                    "speaker": "Mouse",
                    "text": "Hey, you little rascal! You're really gonna grovel before this piece of work?"
                },
                {
                    "id": "750280105",
                    "speaker": "Night Owl",
                    "text": "You think talking tough's going to make us a living? I can see it now, I tell you. We're just living like thieves and crooks. There's nothing special about trafficking Saurians, is there?"
                },
                {
                    "id": "750280106",
                    "speaker": "Night Owl",
                    "text": "If the only alternative's being robbed by a stronger crook, why shouldn't I go with them instead?"
                },
                {
                    "id": "750280107",
                    "speaker": "Night Owl",
                    "text": "#And not to brag, {M#Big Bro}{F#Big Sis}, but I'm sure I'd be way more useful to you than these two. Just call me if you need anything. I'll settle it, nice and clean."
                },
                {
                    "id": "750280108",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Hmm?",
                    "choices": [
                        {
                            "id": "750280109",
                            "text": "Well, I do happen to be shopping about for a sidekick.",
                            "response": [
                                {
                                    "id": "750280110",
                                    "speaker": "Paimon",
                                    "text": "Are you serious!? No way! Paimon vetoes this motion!"
                                },
                                {
                                    "id": "750280112",
                                    "speaker": "Paimon",
                                    "text": "Also, you're a bunch of bad eggs anyway! No way good guys like us would team up with Saurian traffickers like you!",
                                    "choices": [
                                        {
                                            "id": "750280113",
                                            "text": "Yup, there's no one good-er than me.",
                                            "response": [
                                                {
                                                    "id": "750280117",
                                                    "speaker": "Paimon",
                                                    "text": "#Ahem! Anyway, whatever designs you have on the Saurians, better stop now, or we'll... Well, {NICKNAME} will show you what's what."
                                                },
                                                {
                                                    "id": "750280118",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "Rawr!"
                                                },
                                                {
                                                    "id": "750280119",
                                                    "speaker": "Black Screen",
                                                    "text": "The two traffickers leave amidst a cloud of resentment..."
                                                },
                                                {
                                                    "id": "750280120",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon wonders how that Qucusaurus is doing. Shall we go see to it?"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750280114",
                                            "text": "Well, there's always room for accommodation.",
                                            "response": [
                                                {
                                                    "id": "750280115",
                                                    "speaker": "Paimon",
                                                    "text": "#Hey, you're gonna be a bad influence on {REALNAME[ID(2)|SHOWHOST(true)]}! Don't worry, little guy, there's no way we're teaming up with this lot!"
                                                },
                                                {
                                                    "id": "750280116",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "Rrrah... Rawr!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750280111",
                            "text": "Thanks for your consideration, but no need."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502807",
            "objective": "Talk to the suspicious warriors",
            "dialogues": []
        },
        {
            "id": "7502802",
            "objective": "Check on the injured Saurian",
            "dialogues": [
                {
                    "id": "750280201",
                    "speaker": "Qucusaurus",
                    "text": "Roar..."
                },
                {
                    "id": "750280202",
                    "speaker": "Paimon",
                    "text": "Oh no, it looks so weak... It must have suffered so much..."
                },
                {
                    "id": "750280203",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Wooo... Rrrooo...",
                    "choices": [
                        {
                            "id": "750280204",
                            "text": "If only there was something we could do to help...",
                            "response": [
                                {
                                    "id": "750280207",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rrah... Rawr! Raaawr!"
                                },
                                {
                                    "id": "750280208",
                                    "speaker": "Paimon",
                                    "text": "#What is it? Do you have an idea, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                                },
                                {
                                    "id": "750280209",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                }
                            ]
                        },
                        {
                            "id": "750280205",
                            "text": "We can't take care of it forever, can we...",
                            "response": [
                                {
                                    "id": "750280206",
                                    "speaker": "Paimon",
                                    "text": "But there's gotta be something we can do to make it feel better, even if it's only for a short time..."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7502803",
            "objective": "Follow your Saurian buddy",
            "dialogues": [
                {
                    "id": "750280301",
                    "speaker": "Qucusaurus",
                    "text": "(It looks incredibly weak. If only there was some way to revive it...)"
                }
            ]
        },
        {
            "id": "7502804",
            "objective": "Check out what your Saurian buddy has found",
            "dialogues": [
                {
                    "id": "750280401",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Raaawr! Rawr!"
                },
                {
                    "id": "750280402",
                    "speaker": "Paimon",
                    "text": "Do you think Embercore Flowers might help it out?"
                },
                {
                    "id": "750280403",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr!"
                },
                {
                    "id": "750280404",
                    "speaker": "Paimon",
                    "text": "Sure, we can give it a go!"
                }
            ]
        },
        {
            "id": "7502805",
            "objective": "Try healing the Qucusaurus",
            "dialogues": []
        },
        {
            "id": "7502806",
            "objective": "Check on the Qucusaurus",
            "dialogues": [
                {
                    "id": "750280601",
                    "speaker": "Qucusaurus",
                    "text": "..."
                },
                {
                    "id": "750280602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr... Rawr!"
                },
                {
                    "id": "750280603",
                    "speaker": "Paimon",
                    "text": "Looks like it's kinda reinvigorated?"
                },
                {
                    "id": "750280605",
                    "speaker": "Paimon",
                    "text": "Heh. Flew away just like that... Guess it still doesn't trust us, huh?",
                    "choices": [
                        {
                            "id": "750280606",
                            "text": "Trust isn't built overnight, you know.",
                            "response": [
                                {
                                    "id": "750280607",
                                    "speaker": "Paimon",
                                    "text": "#That's true. We had to work hard to reach the understanding we've got with {REALNAME[ID(2)|SHOWHOST(true)]} too!"
                                },
                                {
                                    "id": "750280610",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr! Rawr rawr!"
                                },
                                {
                                    "id": "750280611",
                                    "speaker": "Paimon",
                                    "text": "#And it's not like we did it to earn its gratitude or anything, don'cha think, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                                },
                                {
                                    "id": "750280612",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                },
                                {
                                    "id": "750280613",
                                    "speaker": "Paimon",
                                    "text": "#Hehe, you're a generous little Saurian, aren't you? Just like Paimon and {NICKNAME}!"
                                }
                            ]
                        },
                        {
                            "id": "750280608",
                            "text": "Looks like it'll fly on its own power just fine.",
                            "response": [
                                {
                                    "id": "750280609",
                                    "speaker": "Paimon",
                                    "text": "#Sure does. Great idea, {REALNAME[ID(2)|SHOWHOST(true)]}!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}