        },
        "total_dialogue_lines": 70,
        "total_speaker_counts": {
            "???": 3,
            "Chichikova": 28,
            "Flammabomb Wood Figure": 4,
            "Little Pinecone": 3,
            "Paimon": 20,
            "Player": 12
        }
    },
    "talks": [
        {
            "id": "7750401",
            "objective": "",
            "dialogues": [
                {
                    "id": "775040101",
                    "speaker": "???",
                    "text": "Hm? More fresh recruits?"
                },
                {
                    "id": "775040102",
                    "speaker": "Paimon",
                    "text": "Huh? Fresh recruits? Is she talking about us?"
                },
                {
                    "id": "775040103",
                    "speaker": "???",
                    "text": "You don't dress like locals, and you've been poking around nearby... Friends of Little Pinecone and Wood Figure, are you?"
                },
                {
                    "id": "775040104",
                    "speaker": "???",
                    "text": "Actually, never mind! Welcome to Morepesok's \"Mutual Aid Advancement Network\"!"
                },
                {
                    "id": "775040105",
                    "speaker": "Chichikova",
                    "text": "You're in capable hands now — the hands of Chichikova, blessed by Lady Katheryne, recognized by Talalikhin, and favored by the \"New Edge\"!"
                },
                {
                    "id": "775040106",
                    "speaker": "Paimon",
                    "text": "Mutual Aid... Advancement Network? Paimon's never heard of that one before..."
                },
                {
                    "id": "775040107",
                    "speaker": "Chichikova",
                    "text": "It's exactly what it sounds like! We're a group that helps people train, improve, and get stronger together."
                },
                {
                    "id": "775040108",
                    "speaker": "Chichikova",
                    "text": "If you've got the ambition to make your mark on the world, then come along with us!",
                    "choices": [
                        {
                            "id": "775040109",
                            "text": "Count me in! I've got ambition to spare.",
                            "response": [
                                {
                                    "id": "775040111",
                                    "speaker": "Chichikova",
                                    "text": "Then come with me. I'll introduce you to the others."
                                },
                                {
                                    "id": "775040112",
                                    "speaker": "Chichikova",
                                    "text": "We're just about to start this round of activities, so you arrived at the perfect time!"
                                },
                                {
                                    "id": "775040113",
                                    "speaker": "Paimon",
                                    "text": "Hey, wait a second! Why'd you run with that so quickly?"
                                },
                                {
                                    "id": "775040114",
                                    "speaker": "Paimon",
                                    "text": "Paimon knows you're not one to brag, but are we seriously doing the whole \"new recruits\" act?",
                                    "choices": [
                                        {
                                            "id": "775040115",
                                            "text": "No harm in playing along with someone that fired up, right?",
                                            "response": [
                                                {
                                                    "id": "775040117",
                                                    "speaker": "Paimon",
                                                    "text": "Whoa... Has Nicole been giving you ideas? Now you want to act out some light-novel scenario or something?"
                                                },
                                                {
                                                    "id": "775040118",
                                                    "speaker": "Paimon",
                                                    "text": "...Huh. Paimon kind of wants to try it too."
                                                },
                                                {
                                                    "id": "775040119",
                                                    "speaker": "Chichikova",
                                                    "text": "You follow Chichikova to a meeting spot near the station."
                                                },
                                                {
                                                    "id": "775040120",
                                                    "speaker": "Chichikova",
                                                    "text": "Here we are! This is our base."
                                                },
                                                {
                                                    "id": "775040121",
                                                    "speaker": "Paimon",
                                                    "text": "Oh, so they're not all from Snezhnaya? There are kids from Natlan and Liyue too?"
                                                },
                                                {
                                                    "id": "775040122",
                                                    "speaker": "Little Pinecone",
                                                    "text": "Huh? Wood Figure, doesn't that person seem kind of familiar?"
                                                },
                                                {
                                                    "id": "775040123",
                                                    "speaker": "Flammabomb Wood Figure",
                                                    "text": "Wait, Little Pinecone... I'm not seeing things, right? That's... Th-Th-That's...!"
                                                },
                                                {
                                                    "id": "775040124",
                                                    "speaker": "Flammabomb Wood Figure",
                                                    "text": "Tu-Tu-Tu-Tu-...",
                                                    "choices": [
                                                        {
                                                            "id": "775040125",
                                                            "text": "Too cute for words?",
                                                            "response": [
                                                                {
                                                                    "id": "775040127",
                                                                    "speaker": "Paimon",
                                                                    "text": "Shh..."
                                                                },
                                                                {
                                                                    "id": "775040128",
                                                                    "speaker": "Paimon",
                                                                    "text": "#How should Paimon put this...? Um... {NICKNAME} is trying to keep who {M#he}{F#she} really is under wraps for now."
                                                                },
                                                                {
                                                                    "id": "775040129",
                                                                    "speaker": "Flammabomb Wood Figure",
                                                                    "text": "Could that mean... you're carrying out a special mission? I think I understand."
                                                                },
                                                                {
                                                                    "id": "775040130",
                                                                    "speaker": "Little Pinecone",
                                                                    "text": "We'll keep it a secret!"
                                                                },
                                                                {
                                                                    "id": "775040173",
                                                                    "speaker": "Chichikova",
                                                                    "text": "Huh? I don't get it... What do you mean by all that?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "775040131",
                                                                            "text": "That was the password.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "775040133",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yep, exactly! We're in Little Pinecone and Wood Figure's circle now, so of course we know the lingo."
                                                                                },
                                                                                {
                                                                                    "id": "775040134",
                                                                                    "speaker": "Flammabomb Wood Figure",
                                                                                    "text": "Me? Her? Tumaini... in our circle?"
                                                                                },
                                                                                {
                                                                                    "id": "775040135",
                                                                                    "speaker": "Little Pinecone",
                                                                                    "text": "W-W-We have to write to Vigee right away and tell her!"
                                                                                },
                                                                                {
                                                                                    "id": "775040136",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "Wow, you two really know your stuff! No wonder you crossed mountains and seas to get here, all the way from scorching Natlan to frosty Snezhnaya..."
                                                                                },
                                                                                {
                                                                                    "id": "775040137",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "Want some rye bread and warm soup? Warm up, catch your breath, and then we'll get down to business!"
                                                                                },
                                                                                {
                                                                                    "id": "775040138",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "You're already looking after everyone like a real big sister."
                                                                                },
                                                                                {
                                                                                    "id": "775040139",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "Of course! The two big brothers who trusted me with the Network are professional adventurers. I want to follow in their footsteps and become a true expert at helping people."
                                                                                },
                                                                                {
                                                                                    "id": "775040140",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Sharing snacks does help everyone bounce back fast, but snacks alone won't turn you into a master helper..."
                                                                                },
                                                                                {
                                                                                    "id": "775040141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "So, what's the rest of the plan?"
                                                                                },
                                                                                {
                                                                                    "id": "775040142",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "Hehe, our secret is \"share it all\"..."
                                                                                },
                                                                                {
                                                                                    "id": "775040143",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "The Adventurers' Guild is more like a loose network than a strict organization. Lady Katheryne hands out commissions, and the capable adventurers rise to the top."
                                                                                },
                                                                                {
                                                                                    "id": "775040144",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "But sometimes, the strong start seeing each other as rivals. They keep their best tricks to themselves, and that means all that hard-earned experience never gets shared among fellow adventurers."
                                                                                },
                                                                                {
                                                                                    "id": "775040145",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "For example, there might be a simple way to beat a certain monster, but if no one shares it, group after group has to learn the hard way and come back battered and bruised."
                                                                                },
                                                                                {
                                                                                    "id": "775040146",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yeah, that makes sense... Come to think of it, this kind of thing happens in plenty of other fields too..."
                                                                                },
                                                                                {
                                                                                    "id": "775040147",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "Right! As a big brother from Fontaine put it, \"All across Teyvat, people keep inventing the same wheel every day.\""
                                                                                },
                                                                                {
                                                                                    "id": "775040148",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Paimon gets it. Adventurers don't all know one another, and they don't exactly gather after every commission to swap tips, do they?"
                                                                                },
                                                                                {
                                                                                    "id": "775040149",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "I don't really understand why they do things that way. Anyway, our Mutual Aid Advancement Network is going to change that."
                                                                                },
                                                                                {
                                                                                    "id": "775040150",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "The most important thing in our Network is sharing all kinds of tips and tools among ourselves — just like sharing tasty food."
                                                                                },
                                                                                {
                                                                                    "id": "775040151",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "We share maps marked with important locations, notes full of special techniques, ancient sword manuals, pieces of legendary swords... all sorts of good stuff."
                                                                                },
                                                                                {
                                                                                    "id": "775040152",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "Of course, members can share any spare equipment and supplies they have here too. Sometimes they even exchange gifts."
                                                                                },
                                                                                {
                                                                                    "id": "775040153",
                                                                                    "speaker": "Chichikova",
                                                                                    "text": "When everyone brings what they can, all those strengths come together. That way, more and more people can solve all kinds of problems more and more easily!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "775040154",
                                                                                            "text": "That's an interesting idea.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "775040156",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "So, how's it going so far?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040157",
                                                                                                    "speaker": "Chichikova",
                                                                                                    "text": "Ahem... Well, we only just got things going again, so we're not exactly back at full strength yet."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040158",
                                                                                                    "speaker": "Chichikova",
                                                                                                    "text": "I figured the first step should be getting everyone familiar with Snezhnaya, so I made a plan for us to explore all kinds of places."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040159",
                                                                                                    "speaker": "Chichikova",
                                                                                                    "text": "Just make it to the marked location, have a proper look around, snap some records with our Kamera, and try your hand at whatever setups you find out there. Do all that, and we'll count it as a success!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040160",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Y-Yeah, fair enough. You and the others are still pretty young, so charging straight into the hard stuff would be a little dangerous."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040161",
                                                                                                    "speaker": "Chichikova",
                                                                                                    "text": "We may not have any big accomplishments yet... but before the Network was placed in my hands, it really did make a difference for a lot of people."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040162",
                                                                                                    "speaker": "Chichikova",
                                                                                                    "text": "I believe that if we all work hard and encourage each other day by day, we'll keep getting stronger!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040163",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Okay, that's some real motivation! You’ve definitely got the right attitude."
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040164",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "#And when it comes to exploring places no one knows very well, {NICKNAME} and Paimon are just the team for the job. So let's pitch in and give them a hand!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "775040165",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Besides... Chichikova gave us such a warm welcome. Not to mention the rye bread and hearty soup.",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "775040166",
                                                                                                            "text": "Supporting each other like this feels pretty nice.",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "775040168",
                                                                                                                    "speaker": "Chichikova",
                                                                                                                    "text": "I'll go get ready, then I'll be off too! If your trip turns up anything good, come back and tell us about it. Oh, and check the base mailbox while you're here, okay?"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "775040169",
                                                                                                                    "speaker": "Chichikova",
                                                                                                                    "text": "You never know what little surprises might turn up!"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "775040167",
                                                                                                            "text": "It's pretty interesting watching new adventurers grow."
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "775040155",
                                                                                            "text": "That's a goal worth working toward."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "775040132",
                                                                            "text": "Just some insider lingo."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775040126",
                                                            "text": "Too evil to forgive?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040116",
                                            "text": "Maybe it'd be fun to try being normal for once."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040110",
                            "text": "That's us, fresh recruits, ready to be shown the ropes."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7750402",
            "objective": "Go have a look around Morepesok",
            "dialogues": []
        }
    ]
}