    "talks": [
        {
            "id": "30700",
            "objective": "Meet Kaeya at the temple",
            "dialogues": []
        },
        {
            "id": "30701",
            "objective": "Talk to Kaeya",
            "dialogues": [
                {
                    "id": "3071101",
                    "speaker": "Kaeya",
                    "text": "You've arrived."
                },
                {
                    "id": "3071102",
                    "speaker": "Kaeya",
                    "text": "Come closer. Can you smell that?",
                    "choices": [
                        {
                            "id": "3071103",
                            "text": "...I can't smell anything.",
                            "response": [
                                {
                                    "id": "3071105",
                                    "speaker": "Kaeya",
                                    "text": "Something must have happened in the <color=#00E1FFFF>temple</color>."
                                },
                                {
                                    "id": "3071106",
                                    "speaker": "Kaeya",
                                    "text": "I imagine there will be slimes, hilichurls, and... whatever is giving Stormterror extra power."
                                },
                                {
                                    "id": "3071107",
                                    "speaker": "Kaeya",
                                    "text": "Oh yes, it is going to be lively in there indeed!",
                                    "choices": [
                                        {
                                            "id": "3071108",
                                            "text": "Will it be dangerous?",
                                            "response": [
                                                {
                                                    "id": "3071109",
                                                    "speaker": "Kaeya",
                                                    "text": "As bustling as it may be — no, I can't imagine it will be dangerous at all."
                                                },
                                                {
                                                    "id": "3071112",
                                                    "speaker": "Kaeya",
                                                    "text": "It's a pity that the Temple of the Wolf has been disturbed by such an atrocity."
                                                },
                                                {
                                                    "id": "3071113",
                                                    "speaker": "Kaeya",
                                                    "text": "#Let's head in, {NICKNAME}."
                                                },
                                                {
                                                    "id": "3071114",
                                                    "speaker": "Kaeya",
                                                    "text": "No one makes offerings to The Four Winds anymore, yet the old winds never vanish..."
                                                },
                                                {
                                                    "id": "3071115",
                                                    "speaker": "Kaeya",
                                                    "text": "We need to clear out the temples, for The Four Winds."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3071110",
                                            "text": "No doubt nothing more than a disorderly mob of creatures.",
                                            "response": [
                                                {
                                                    "id": "3071111",
                                                    "speaker": "Kaeya",
                                                    "text": "Oh, ho-ho! You're quite the brave one, aren't you!"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3071104",
                            "text": "It's the smell of burnt Pyro Slimes."
                        }
                    ]
                }
            ]
        },
        {
            "id": "30702",
            "objective": "Enter the temple",
            "dialogues": []
        },
        {
            "id": "30710",
            "objective": "Talk to Kaeya",
            "dialogues": [
                {
                    "id": "3071201",
                    "speaker": "Kaeya",
                    "text": "Let me show you how the Knights of Favonius conquer our adversaries!"
                }
            ]
        },
        {
            "id": "30703",
            "objective": "Explore the temple's depths",
            "dialogues": []
        },
        {
            "id": "30715",
            "objective": "Talk to Kaeya",
            "dialogues": [
                {
                    "id": "3071501",
                    "speaker": "Kaeya",
                    "text": "Bravo! What a performance!"
                },
                {
                    "id": "3071502",
                    "speaker": "Kaeya",
                    "text": "You are, to my surprise, a well-trained knight."
                },
                {
                    "id": "3071503",
                    "speaker": "Kaeya",
                    "text": "The battles you just fought were sights to behold.",
                    "choices": [
                        {
                            "id": "3071504",
                            "text": "Thanks, that's nice of you to say...",
                            "response": [
                                {
                                    "id": "3071506",
                                    "speaker": "Kaeya",
                                    "text": "Haha, I see you already have the knightly virtue of modesty."
                                },
                                {
                                    "id": "3071507",
                                    "speaker": "Kaeya",
                                    "text": "Stories of your heroic deeds to save Mondstadt from destruction shall be known throughout the City of Freedom, well into the future."
                                },
                                {
                                    "id": "3071508",
                                    "speaker": "Kaeya",
                                    "text": "Please do visit me at our headquarters when you have the time."
                                },
                                {
                                    "id": "3071509",
                                    "speaker": "Kaeya",
                                    "text": "I also know a lovely tavern, if that's more your thing."
                                }
                            ]
                        },
                        {
                            "id": "3071505",
                            "text": "Not worth complimenting really..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "30713",
            "objective": "Kaeya cutscene",
            "dialogues": []
        },
        {
            "id": "30704",
