    "talks": [
        {
            "id": "7550901",
            "objective": "Return to the party venue",
            "dialogues": [
                {
                    "id": "755090101",
                    "speaker": "Mualani",
                    "text": "Mizuki! Mizuki! Amina just told me some amazing news!"
                },
                {
                    "id": "755090102",
                    "speaker": "Mualani",
                    "text": "Thanks to the party, the People of the Springs had forty percent more visitors than normal! And to think, we barely did anything to promote it!"
                },
                {
                    "id": "755090103",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "That's great! I also have some good news... Over the past few days, the number of patients at my practice has dropped by ninety percent!"
                },
                {
                    "id": "755090104",
                    "speaker": "Yumemizuki Mizuki",
                    "text": "If our goal was to lift people's spirits and give them a space to let go of their worries, I think we can safely say... That's a job well done!"
                },
                {
                    "id": "755090105",
                    "speaker": "Mualani",
                    "text": "Haha, then let's go even bigger next time! Add even more games!"
                },
                {
                    "id": "755090106",
                    "speaker": "Mualani",
                    "text": "That way, there's something for everyone — hot springs if you want relaxation, games if you want fun... As far as vacations go, you can't get much better than that!"
                },
                {
                    "id": "755090107",
                    "speaker": "Paimon",
                    "text": "Hey! Mualani! Mizuki!",
                    "choices": [
                        {
                            "id": "755090108",
                            "text": "The musical genius has returned!",
                            "response": [
                                {
                                    "id": "755090110",
                                    "speaker": "Mualani",
                                    "text": "Hehe, say no more! It's written all over your face! You had a blast, didn't you?"
                                },
                                {
                                    "id": "755090111",
                                    "speaker": "Paimon",
                                    "text": "Are you kidding!? An all-you-can-eat, self-serve buffet? Paimon was on cloud nine! She had five servings of Hot Spring O'Clock!"
                                },
                                {
                                    "id": "755090112",
                                    "speaker": "Paimon",
                                    "text": "#And {NICKNAME} was even more obsessed with the Rhythm Ball than Paimon with the free food!",
                                    "choices": [
                                        {
                                            "id": "755090113",
                                            "text": "Ehe.",
                                            "response": [
                                                {
                                                    "id": "755090115",
                                                    "speaker": "Mualani",
                                                    "text": "Honestly, watching you play was quite the spectacle! An expert performance if I ever saw one!"
                                                },
                                                {
                                                    "id": "755090116",
                                                    "speaker": "Mualani",
                                                    "text": "You should help me brainstorm the next time we host something like this! We can come up with even more fun games!"
                                                },
                                                {
                                                    "id": "755090117",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "#As far as I know, that does seem to be one of {NICKNAME}'s many talents."
                                                },
                                                {
                                                    "id": "755090118",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "I look forward to working with you again, Miss Mualani. Although, it would be easier if you had a designated office space... Why don't I help you open a consultancy?"
                                                },
                                                {
                                                    "id": "755090119",
                                                    "speaker": "Mualani",
                                                    "text": "Ooh, I like the sound of that! Let me ask around! If there's space... We could put it right next to your clinic!"
                                                },
                                                {
                                                    "id": "755090120",
                                                    "speaker": "Yumemizuki Mizuki",
                                                    "text": "Good idea! I'd love nothing more than to be neighbors.",
                                                    "choices": [
                                                        {
                                                            "id": "755090121",
                                                            "text": "Man, I want to live here, too!",
                                                            "response": [
                                                                {
                                                                    "id": "755090123",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ooh, all-you-can-eat buffets and hot springs every day... Oh yeah, that sounds like the life, hehe..."
                                                                },
                                                                {
                                                                    "id": "755090124",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Well, if you had a permanent address, it would be easier to track you down if we need something."
                                                                },
                                                                {
                                                                    "id": "755090125",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Never knew the day would come when I'd sound like one of my clients."
                                                                },
                                                                {
                                                                    "id": "755090126",
                                                                    "speaker": "Paimon",
                                                                    "text": "Oh, Xilonen!"
                                                                },
                                                                {
                                                                    "id": "755090127",
                                                                    "speaker": "Paimon",
                                                                    "text": "The music you picked for Rhythm Ball was excellent! Every time we played the game, we would start dancing before we knew it!"
                                                                },
                                                                {
                                                                    "id": "755090128",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Glad to hear it."
                                                                },
                                                                {
                                                                    "id": "755090129",
                                                                    "speaker": "Xilonen",
                                                                    "text": "From what I've observed over the past few days, you have great potential as \"fusion\" artists."
                                                                },
                                                                {
                                                                    "id": "755090130",
                                                                    "speaker": "Xilonen",
                                                                    "text": "It could be because you've encountered music from all sorts of different cultures. When you're immersed in the melody, it's almost like you can incorporate different beats on instinct."
                                                                },
                                                                {
                                                                    "id": "755090131",
                                                                    "speaker": "Xilonen",
                                                                    "text": "The most cutting-edge music often involves some form of \"fusion.\" So, I have a feeling I'll be coming to you for inspiration one day."
                                                                },
                                                                {
                                                                    "id": "755090132",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Here, I want you to have this. Give it a listen sometime."
                                                                },
                                                                {
                                                                    "id": "755090133",
                                                                    "speaker": "Paimon",
                                                                    "text": "What is it?"
                                                                },
                                                                {
                                                                    "id": "755090134",
                                                                    "speaker": "Mualani",
                                                                    "text": "No way! One of Xilonen's mixtapes! At Xochicuicatl Records, that would sell in a heartbeat!"
                                                                },
                                                                {
                                                                    "id": "755090135",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "Ah, yes. Not everyone can get their hands on the records or equipment Miss Xilonen recommends. It's a source of anxiety for some people. I once treated a patient for that very reason..."
                                                                },
                                                                {
                                                                    "id": "755090136",
                                                                    "speaker": "Xilonen",
                                                                    "text": "...You can treat even that, Miss Mizuki?"
                                                                },
                                                                {
                                                                    "id": "755090137",
                                                                    "speaker": "Yumemizuki Mizuki",
                                                                    "text": "All I did was help her manage her emotions. I told her to consider getting a job at the record store. Then, she would be one of the first to get information on your latest recommendations."
                                                                },
                                                                {
                                                                    "id": "755090138",
                                                                    "speaker": "Xilonen",
                                                                    "text": "Hah, good idea... I just hope she can keep it to herself, or job applications are about to become just as hard to snag...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "755090139",
                                                                            "text": "Well, thanks for this.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "755090141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Yeah! Paimon can't wait to hear it!"
                                                                                },
                                                                                {
                                                                                    "id": "755090142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Next time, we'll help you come up with an even better game... With music that's just as amazing as this time, of course!"
                                                                                },
                                                                                {
                                                                                    "id": "755090143",
                                                                                    "speaker": "Mualani",
                                                                                    "text": "That's a promise! People won't know what hit 'em!"
                                                                                },
                                                                                {
                                                                                    "id": "755090144",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Man, the party isn't even over, and Paimon already can't wait for the next one! The People of the Springs really know how to live it up..."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "755090140",
                                                                            "text": "I'll give it a good listen."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755090122",
                                                            "text": "More time in the People of the Springs... Count us in!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755090114",
                                            "text": "No, no, no. Nothing can compare to your obsession with food!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755090109",
                            "text": "Two happy visitors here to give you a five-star review!"
                        }
                    ]
                }
            ]
        }
    ]
}