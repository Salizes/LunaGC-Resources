    "talks": [
        {
            "id": "1302801",
            "objective": "Explain the situation to the waiting Fungi",
            "dialogues": [
                {
                    "id": "130280113",
                    "speaker": "Nahida",
                    "text": "They've been here for a very long time..."
                },
                {
                    "id": "130280101",
                    "speaker": "Nahida",
                    "text": "I really want to do something for them so that they'll have a chance to meet again..."
                },
                {
                    "id": "130280102",
                    "speaker": "Paimon",
                    "text": "Yeah, and apart from these two Fungi, Paimon's also a little worried about the Floating Anemo Fungus's camp."
                },
                {
                    "id": "130280103",
                    "speaker": "Nahida",
                    "text": "Mm-hmm. I feel the same."
                },
                {
                    "id": "130280104",
                    "speaker": "Nahida",
                    "text": "I have an idea. Why don't we bring them over to live with the other Fungi?"
                },
                {
                    "id": "130280105",
                    "speaker": "Nahida",
                    "text": "Both sides have previously lived in the presence of an elemental life-form, so their habits should be similar."
                },
                {
                    "id": "130280106",
                    "speaker": "Paimon",
                    "text": "Yeah, so they can look out for each other!"
                },
                {
                    "id": "130280107",
                    "speaker": "Nahida",
                    "text": "Would you like to come with us?"
                },
                {
                    "id": "130280108",
                    "speaker": "Floating Hydro Fungus",
                    "text": "...?"
                },
                {
                    "id": "130280109",
                    "speaker": "Floating Hydro Fungus",
                    "text": "♪~"
                },
                {
                    "id": "130280110",
                    "speaker": "Floating Hydro Fungus",
                    "text": "..."
                },
                {
                    "id": "130280111",
                    "speaker": "Paimon",
                    "text": "Looks like it's been convinced."
                },
                {
                    "id": "130280112",
                    "speaker": "Nahida",
                    "text": "Okay, let's go."
                }
            ]
        },
        {
            "id": "1302802",
            "objective": "Take the Fungi to their new home",
            "dialogues": [
                {
                    "id": "130280201",
                    "speaker": "Black Screen",
                    "text": "After arriving at the camp, the two Fungi receive a warm welcome."
                },
                {
                    "id": "130280202",
                    "speaker": "Paimon",
                    "text": "Ooh, seems like the Fungi here recognize us. They're so friendly and gentle."
                },
                {
                    "id": "130280203",
                    "speaker": "Nahida",
                    "text": "That elemental life-form must've been held in high regard by everyone living here."
                },
                {
                    "id": "130280204",
                    "speaker": "Paimon",
                    "text": "Huh? Are you trying to play with Paimon?"
                },
                {
                    "id": "130280205",
                    "speaker": "Floating Anemo Fungus",
                    "text": "♩~♩~"
                },
                {
                    "id": "130280206",
                    "speaker": "Paimon",
                    "text": "#Well, okay then! {NICKNAME}, Paimon'll be over there playing with the Fungi!",
                    "choices": [
                        {
                            "id": "130280207",
                            "text": "Off you go.",
                            "response": [
                                {
                                    "id": "130280209",
                                    "speaker": "Nahida",
                                    "text": "I owe you an apology. When the Fire Seed shattered while we were inside Apep... I had planned to sacrifice my power."
                                },
                                {
                                    "id": "130280210",
                                    "speaker": "Nahida",
                                    "text": "Did Paimon tell you that?",
                                    "choices": [
                                        {
                                            "id": "130280211",
                                            "text": "Yeah, and I was a little worried.",
                                            "response": [
                                                {
                                                    "id": "130280213",
                                                    "speaker": "Nahida",
                                                    "text": "I wasn't calm enough. I should've given it some more thought and made a better judgment of the situation."
                                                },
                                                {
                                                    "id": "130280214",
                                                    "speaker": "Nahida",
                                                    "text": "When I realized that the Dendro Dragon was in danger and that Sumeru's safety was being threatened, I couldn't help feeling anxious and scared."
                                                },
                                                {
                                                    "id": "130280215",
                                                    "speaker": "Nahida",
                                                    "text": "If I decided not to take action when things can still be done, or if time ran out before I've used up all my energy..."
                                                },
                                                {
                                                    "id": "130280216",
                                                    "speaker": "Nahida",
                                                    "text": "Using my powers may be the easiest way out, but it's also the most difficult."
                                                },
                                                {
                                                    "id": "130280217",
                                                    "speaker": "Player",
                                                    "text": "You still have room for \"growth.\""
                                                },
                                                {
                                                    "id": "130280218",
                                                    "speaker": "Nahida",
                                                    "text": "Yes, and I think I learned a lot from them."
                                                },
                                                {
                                                    "id": "130280219",
                                                    "speaker": "Nahida",
                                                    "text": "I understand what it means to have their wishes come true, but I'm still unable to accept it."
                                                },
                                                {
                                                    "id": "130280220",
                                                    "speaker": "Nahida",
                                                    "text": "Why did it sound so peacefully content when it was doing something that just... makes you want to cry?"
                                                },
                                                {
                                                    "id": "130280221",
                                                    "speaker": "Nahida",
                                                    "text": "Looks like I still haven't fully grasped the concept of \"empathy\" yet...",
                                                    "choices": [
                                                        {
                                                            "id": "130280222",
                                                            "text": "This isn't your fault.",
                                                            "response": [
                                                                {
                                                                    "id": "130280224",
                                                                    "speaker": "Nahida",
                                                                    "text": "Thank you for comforting me..."
                                                                },
                                                                {
                                                                    "id": "130280225",
                                                                    "speaker": "Nahida",
                                                                    "text": "Feelings are really complex things, and there is still a lot for me to learn."
                                                                },
                                                                {
                                                                    "id": "130280226",
                                                                    "speaker": "Nahida",
                                                                    "text": "Huh?"
                                                                },
                                                                {
                                                                    "id": "130280227",
                                                                    "speaker": "Floating Hydro Fungus",
                                                                    "text": "♪~"
                                                                },
                                                                {
                                                                    "id": "130280228",
                                                                    "speaker": "Floating Hydro Fungus",
                                                                    "text": "♪~♪~"
                                                                },
                                                                {
                                                                    "id": "130280229",
                                                                    "speaker": "Nahida",
                                                                    "text": "They're even taking care of the crops... Are they simply mirroring the elemental life-forms' behaviors?"
                                                                },
                                                                {
                                                                    "id": "130280230",
                                                                    "speaker": "Nahida",
                                                                    "text": "But since that Fungus even learned to speak, all of this might be due to the long-term effects of elemental power."
                                                                },
                                                                {
                                                                    "id": "130280231",
                                                                    "speaker": "Player",
                                                                    "text": "Time is a powerful thing."
                                                                },
                                                                {
                                                                    "id": "130280232",
                                                                    "speaker": "Nahida",
                                                                    "text": "That's right. And now, we don't have to worry about the safety of these two Fungi anymore."
                                                                },
                                                                {
                                                                    "id": "130280233",
                                                                    "speaker": "Nahida",
                                                                    "text": "From now on, I'll be keeping an eye on this Fungi camp and come check on them once in a while."
                                                                },
                                                                {
                                                                    "id": "130280234",
                                                                    "speaker": "Nahida",
                                                                    "text": "I want to preserve the traces they left behind in order to create an opportunity for them to meet in the future."
                                                                },
                                                                {
                                                                    "id": "130280235",
                                                                    "speaker": "Nahida",
                                                                    "text": "After all, that Fungus remembered the name \"Nur.\" Its memories came back.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "130280236",
                                                                            "text": "I believe in their bonds as a family.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "130280238",
                                                                                    "speaker": "Nahida",
                                                                                    "text": "Mm. Let's think of it as a beautiful wish then."
                                                                                },
                                                                                {
                                                                                    "id": "130280239",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Nahida, the Fungi brought over some fruit! Come and have some!"
                                                                                },
                                                                                {
                                                                                    "id": "130280240",
                                                                                    "speaker": "Nahida",
                                                                                    "text": "Okay, I'm coming!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "130280237",
                                                                            "text": "I believe in miracles."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "130280223",
                                                            "text": "I feel the same."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "130280212",
                                            "text": "Yeah, and I was a little angry."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "130280208",
                            "text": "Have fun."
                        }
                    ]
                }
            ]
        }
    ]
}