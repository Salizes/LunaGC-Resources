{
    "quest": {
        "id": "22045",
        "title": "Shadow of the Cat",
        "description": "Ooshima Junpei, who works at the Asase Shrine, seems to be troubled over the matter of his wooden carving...",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 34,
        "total_speaker_counts": {
