        }
    },
    "talks": [
        {
            "id": "2204501",
            "objective": "Talk to Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220450101",
                    "speaker": "Ooshima Junpei",
                    "text": "Hmm, this still doesn't feel quite right..."
                },
                {
                    "id": "220450102",
                    "speaker": "Player",
                    "text": "What's wrong?"
                },
                {
                    "id": "220450103",
                    "speaker": "Ooshima Junpei",
                    "text": "Ah, Traveler, you're here! Just the person I wanted to see."
                },
                {
                    "id": "220450104",
                    "speaker": "Ooshima Junpei",
                    "text": "Recently, I've gotten the feeling that the wood carvings I've been making... don't have... you know, life.",
                    "choices": [
                        {
                            "id": "220450105",
                            "text": "Well, they are made of wood.",
                            "response": [
                                {
                                    "id": "220450106",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Oh, that's not what I mean..."
                                },
                                {
                                    "id": "220450108",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Hmm. How do I explain this? What I'm looking for is..."
                                },
                                {
                                    "id": "220450109",
                                    "speaker": "Ooshima Junpei",
                                    "text": "You see, our provisional head priestess is mostly asleep, but at times, she will wake and wander about."
                                },
                                {
                                    "id": "220450110",
                                    "speaker": "Ooshima Junpei",
                                    "text": "While on her walks, she will hop or jump, pounce at some fallen leaves, or stretch, and things like that..."
                                },
                                {
                                    "id": "220450111",
                                    "speaker": "Ooshima Junpei",
                                    "text": "I want to capture that in motion. I want to make carvings using these actions as a basis. That's what I mean by \"life.\"",
                                    "choices": [
                                        {
                                            "id": "220450112",
                                            "text": "Well, go see for yourself, then...",
                                            "response": [
                                                {
                                                    "id": "220450114",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Well, I, uh... I'm a little embarrassed to do that."
                                                },
                                                {
                                                    "id": "220450115",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Whatever we say, she is my boss. I feel like if I were to squat beside her and observe, I might make her unhappy..."
                                                },
                                                {
                                                    "id": "220450116",
                                                    "speaker": "Ooshima Junpei",
                                                    "text": "Your relationship, on the other hand, should be way better. So, could you help me take a few pictures to use as reference material?",
                                                    "choices": [
                                                        {
                                                            "id": "220450117",
                                                            "text": "Alright, alright, I got it...",
                                                            "response": [
                                                                {
                                                                    "id": "220450121",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Alright, thanks so much, Traveler. Just bring me those pictures once you're done taking them."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "220450118",
                                                            "text": "No guarantees on capturing the actions you want...",
                                                            "response": [
                                                                {
                                                                    "id": "220450119",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "No problem. You don't have to go for those big movements. I don't think my carving technique could keep up with that at the moment..."
                                                                },
                                                                {
                                                                    "id": "220450120",
                                                                    "speaker": "Ooshima Junpei",
                                                                    "text": "Just capture a few poses. I think that'll do for now."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220450113",
                                            "text": "Well, she's right over there..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220450107",
                            "text": "What sort of \"life\" are you looking to inject into your art?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204502",
            "objective": "Take a picture of Neko from the right side",
            "dialogues": [
                {
                    "id": "220450201",
                    "speaker": "Ooshima Junpei",
                    "text": "I'll leave the picture-taking business to you. Just bring them to me once you're done."
                }
            ]
        },
        {
            "id": "2204503",
            "objective": "Take a picture of Neko from the left side",
            "dialogues": [
                {
                    "id": "220450301",
                    "speaker": "Neko",
                    "text": "Mm? What are you doing?"
                },
                {
                    "id": "220450302",
                    "speaker": "Player",
                    "text": "Taking pictures."
                },
                {
                    "id": "220450303",
                    "speaker": "Neko",
                    "text": "...And what are those? You truly are strange."
                },
                {
                    "id": "220450304",
                    "speaker": "Neko",
                    "text": "Eh, it matters not. Continue as you were — just refrain from messing the shrine up."
                }
            ]
        },
        {
            "id": "2204504",
            "objective": "Give the pictures to Ooshima Junpei",
            "dialogues": [
                {
                    "id": "220450401",
                    "speaker": "Ooshima Junpei",
                    "text": "How did it go? Did you get the pictures?"
                },
                {
                    "id": "220450402",
                    "speaker": "Player",
                    "text": "Wasn't that hard."
                },
                {
                    "id": "220450403",
                    "speaker": "Ooshima Junpei",
                    "text": "Let me see... Ooh! This angle... This pose... Pretty good! Pretty good indeed!",
                    "choices": [
                        {
                            "id": "220450404",
                            "text": "Well, aren't you excited...",
                            "response": [
                                {
                                    "id": "220450406",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Oh, they'll more than do!"
                                },
                                {
                                    "id": "220450407",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Thank you so much, Traveler. Please take these. I'll start practicing in just a moment."
                                },
                                {
                                    "id": "220450408",
                                    "speaker": "Ooshima Junpei",
                                    "text": "Oh ho ho, this is pretty good..."
                                }
                            ]
                        },
                        {
                            "id": "220450405",
                            "text": "Will these do?"
                        }
                    ]
                }
            ]
        }
    ]
}