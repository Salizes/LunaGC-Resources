        {
            "id": "7900002",
            "objective": "Find the treasure",
            "dialogues": [
                {
                    "id": "790000201",
                    "speaker": "Paimon",
                    "text": "It opened! Let's have a look at what's inside!"
                }
            ]
        },
        {
            "id": "7900006",
            "objective": "",
            "dialogues": [
                {
                    "id": "790000401",
                    "speaker": "Paimon",
                    "text": "Found it! Treasure, treasure... Wonder what'll we find inside..."
                },
                {
                    "id": "790000402",
                    "speaker": "Paimon",
                    "text": "Eh? There's a lock on it. And it's coded, too... Looks like we'll need the code to open it...",
                    "choices": [
                        {
                            "id": "790000403",
                            "text": "We can just shatter it, can't we?",
                            "response": [
                                {
                                    "id": "790000405",
                                    "speaker": "Paimon",
                                    "text": "Wait! What will happen if the stuff inside breaks as well?"
                                },
                                {
                                    "id": "790000406",
                                    "speaker": "Paimon",
                                    "text": "Let's find a way to unlock it instead, shall we?"
                                },
                                {
                                    "id": "790000410",
                                    "speaker": "Paimon",
                                    "text": "But since this chest contains \"family heirlooms\" and is locked using a code..."
                                },
                                {
                                    "id": "790000411",
                                    "speaker": "Paimon",
                                    "text": "That's gotta mean that the person who locked it thinks that the code they left behind is easy enough to remember."
                                },
                                {
                                    "id": "790000412",
                                    "speaker": "Paimon",
                                    "text": "Looks like our only chance are those conches that store sounds."
                                },
                                {
                                    "id": "790000413",
                                    "speaker": "Paimon",
                                    "text": "Let's listen to the sounds inside those conches again. Let's hope that they can give us some clues about the code..."
                                }
                            ]
                        },
                        {
                            "id": "790000404",
                            "text": "Looks like we'll have to find a way to unlock it.",
                            "response": [
                                {
                                    "id": "790000407",
                                    "speaker": "Paimon",
                                    "text": "But Paimon doesn't see any stone tablets, potraits, notes, carvings or notes nearby..."
                                },
                                {
                                    "id": "790000408",
                                    "speaker": "Player",
                                    "text": "There's a dearth of scholars, Treasure Hoarders, and adventurers, too."
                                },
                                {
                                    "id": "790000409",
                                    "speaker": "Paimon",
                                    "text": "Yeah. Hmm... This is an unprecedented test!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
