            "dialogues": [
                {
                    "id": "749360101",
                    "speaker": "Player",
                    "text": "About the Fortress of Meropide..."
                },
                {
                    "id": "749360102",
                    "speaker": "Darcy",
                    "text": "I actually like living here! When I was outside, I lived a life with my days and nights all topsy turvy, sleepless at night, dispirited and listless during the day..."
                },
                {
                    "id": "749360103",
                    "speaker": "Darcy",
                    "text": "But ever since I arrived in the Fortress of Meropide, I've led a regular and healthy life!"
                },
                {
                    "id": "749360104",
                    "speaker": "Darcy",
                    "text": "If you have had similar issues, I recommend you stay a while longer!"
                }
            ]
        }
