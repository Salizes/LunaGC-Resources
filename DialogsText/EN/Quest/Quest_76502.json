    "talks": [
        {
            "id": "7650201",
            "objective": "",
            "dialogues": [
                {
                    "id": "765020101",
                    "speaker": "Aino",
                    "text": "#Hey, it's you, {NICKNAME}! And Paimon, too! Well? What's up? Need my genius for some super hyper mega commission?"
                },
                {
                    "id": "765020102",
                    "speaker": "Aino",
                    "text": "Tell you what, I'll give you a twenty percent friend discount on my services! Just bring me snacks... Ooh yeah, and keep that secret from Ineffa!",
                    "choices": [
                        {
                            "id": "765020103",
                            "text": "We're just looking around.",
                            "response": [
                                {
                                    "id": "765020105",
                                    "speaker": "Aino",
                                    "text": "Hehe, then this is the rightest spot of 'em all! My craftshop is one-hundred-ten-percent shiny-awesome-sauce by mass. You won't find better anywhere else, bet'cha bottom Mora!"
                                },
                                {
                                    "id": "765020106",
                                    "speaker": "Aino",
                                    "text": "Just watch your step, or one component or another might send ya faceplantin' and stuff.",
                                    "choices": [
                                        {
                                            "id": "765020107",
                                            "text": "This robot looks pretty... unique.",
                                            "response": [
                                                {
                                                    "id": "765020109",
                                                    "speaker": "Aino",
                                                    "text": "Hehe! Whaddya think? Knuckle Duckle, this one's called. Designed it to sort trash and scrap metal."
                                                },
                                                {
                                                    "id": "765020110",
                                                    "speaker": "Aino",
                                                    "text": "But, ah, I built it too tough, and its cantilevers, mega agile. So I thought, \"Eh, why not give it super-dee-duper defenses to match?\""
                                                },
                                                {
                                                    "id": "765020111",
                                                    "speaker": "Aino",
                                                    "text": "That way, it'll turn any baddies fixing to sneaky-beaky into my craftshop into non-recyclable garbage, easy!"
                                                },
                                                {
                                                    "id": "765020112",
                                                    "speaker": "Paimon",
                                                    "text": "Your ideas are as wild as ever, huh?",
                                                    "choices": [
                                                        {
                                                            "id": "765020113",
                                                            "text": "Well, since the opportunity's presenting itself...",
                                                            "response": [
                                                                {
                                                                    "id": "765020115",
                                                                    "speaker": "Aino",
                                                                    "text": "M—Me? With Knuckle Duckle? W—Well, uh, people are usually into my inventions. Don't get photos of me taken nearly as often..."
                                                                },
                                                                {
                                                                    "id": "765020116",
                                                                    "speaker": "Aino",
                                                                    "text": "But if you wanna catch this whiz-kid and her bestest unbeatable battle bot in action using your Kamera, you can... Yeah, you can totally do that!"
                                                                },
                                                                {
                                                                    "id": "765020117",
                                                                    "speaker": "Aino",
                                                                    "text": "It's just... I don't usually take photos of myself, so I dunno much about looking cool and stuff... Not sure the pictures are gonna come out okay, y'know...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765020118",
                                                                            "text": "Just be yourself.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765020120",
                                                                                    "speaker": "Aino",
                                                                                    "text": "Niiice! All you, then! Make sure to catch Knuckle Duckle at its awesomest too!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765020119",
                                                                            "text": "I'll make sure to hit the shutter when you're at your best!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765020114",
                                                            "text": "Could we take a picture of you?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765020108",
                                            "text": "Is it one of yours?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765020104",
                            "text": "And looking for some photo-op material while we're at it."
                        }
                    ]
                }
            ]
        },
