    "talks": [
        {
            "id": "7604901",
            "objective": "Meet The Damselette",
            "dialogues": [
                {
                    "id": "760490603",
                    "speaker": "Player",
                    "text": "Let's try calm and gentle..."
                },
                {
                    "id": "760490604",
                    "speaker": "The Damselette",
                    "text": "That was lovely. So you really did memorize my tune."
                },
                {
                    "id": "760490605",
                    "speaker": "Paimon",
                    "text": "Hehe, only 'cause you're such a great singer! Whenever we hear your voice, sometimes we stop for a bit just to listen..."
                },
                {
                    "id": "760490606",
                    "speaker": "The Damselette",
                    "text": "Hm, the kuuhenki seemed quite enraptured with your performance as well. Perhaps they picked up a few things..."
                },
                {
                    "id": "760490607",
                    "speaker": "The Damselette",
                    "text": "I might require your educational assistance again in the future."
                },
                {
                    "id": "760490608",
                    "speaker": "The Damselette",
                    "text": "Come, give me your hand."
                },
                {
                    "id": "760490609",
                    "speaker": "Paimon",
                    "text": "Huh? No, no, this was a free performance. No tuition fee required!"
                },
                {
                    "id": "760490610",
                    "speaker": "The Damselette",
                    "text": "Hmm? Tuition fee?"
                },
                {
                    "id": "760490611",
                    "speaker": "The Damselette",
                    "text": "I only thought... the gentle glow of moonlight would make a fitting accompaniment for such a beautiful melody."
                }
            ]
        },
        {
            "id": "7604901",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490101",
                    "speaker": "The Damselette",
                    "text": "...Hmm, a half-step too high, perhaps. Let's try that again, shall we?"
                },
                {
                    "id": "760490102",
                    "speaker": "Paimon",
                    "text": "Hey there, Columbina!"
                },
                {
                    "id": "760490103",
                    "speaker": "Paimon",
                    "text": "Wait, are you... teaching the kuuhenki how to play the lyre?"
                },
                {
                    "id": "760490104",
                    "speaker": "The Damselette",
                    "text": "Yes. They were so happy to have it fixed, they practically haven't left my side."
                },
                {
                    "id": "760490105",
                    "speaker": "The Damselette",
                    "text": "Playing the lyre has never been my forte, though. I'm more accustomed to hearing others play."
                },
                {
                    "id": "760490106",
                    "speaker": "Paimon",
                    "text": "Ohhh, right! If you had a band, you'd totally be in charge of vocals, huh..."
                },
                {
                    "id": "760490107",
                    "speaker": "Paimon",
                    "text": "#When it comes to instruments, though... {NICKNAME}'s pretty much a prodigy! From the lyre to the Djem Djem Drum, this one can do it all!",
                    "choices": [
                        {
                            "id": "760490108",
                            "text": "I'm nothing special, honestly...",
                            "response": [
                                {
                                    "id": "760490110",
                                    "speaker": "The Damselette",
                                    "text": "Oh, is that so? In that case... Perhaps you could teach them instead?",
                                    "choices": [
                                        {
                                            "id": "760490111",
                                            "text": "Alright then, why not?",
                                            "response": [
                                                {
                                                    "id": "760490113",
                                                    "speaker": "The Damselette",
                                                    "text": "I was having them practice the song I usually sing. Perhaps you remember how it goes..."
                                                },
                                                {
                                                    "id": "760490114",
                                                    "speaker": "The Damselette",
                                                    "text": "Or... A different tune works as well. Rarely do the kuuhenki get to hear music from other places. I would be quite interested to hear something like that too."
                                                },
                                                {
                                                    "id": "760490115",
                                                    "speaker": "Player",
                                                    "text": "(Hmm, what should I play...)",
                                                    "choices": [
                                                        {
                                                            "id": "760490202",
                                                            "text": "Let's try the one Columbina always sings...",
                                                            "response": [
                                                                {
                                                                    "id": "760490201",
                                                                    "speaker": "Player",
                                                                    "text": "(But what tone should I go for...)",
                                                                    "choices": [
                                                                        {
                                                                            "id": "760490603",
                                                                            "text": "Let's try calm and gentle..."
                                                                        },
                                                                        {
                                                                            "id": "760490701",
                                                                            "text": "Let's make it cheerful...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "760490702",
                                                                                    "speaker": "The Damselette",
                                                                                    "text": "Oh, it's over already? I could listen to that forever..."
                                                                                },
                                                                                {
                                                                                    "id": "760490703",
                                                                                    "speaker": "The Damselette",
                                                                                    "text": "As I once told you, this is the only lullaby I can remember."
                                                                                },
                                                                                {
                                                                                    "id": "760490704",
                                                                                    "speaker": "The Damselette",
                                                                                    "text": "Although I have yet to discern the meaning behind it, after hearing you play, I feel like whatever answer is waiting for me, up there on the moon... at the very least, it must be a beautiful one."
                                                                                },
                                                                                {
                                                                                    "id": "760490705",
                                                                                    "speaker": "The Damselette",
                                                                                    "text": "Here, give me your hand."
                                                                                },
                                                                                {
                                                                                    "id": "760490706",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "It's okay. Seriously, you don't need to give us anything in return."
                                                                                },
                                                                                {
                                                                                    "id": "760490707",
                                                                                    "speaker": "The Damselette",
                                                                                    "text": "Ah, that wasn't my intention... I only wished to adorn your melody with a ray of gentle moonlight."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "760490801",
                                                            "text": "Let's try something from another nation...",
                                                            "response": [
                                                                {
                                                                    "id": "760490802",
                                                                    "speaker": "The Damselette",
                                                                    "text": "How curious... I have heard melodies like this before, but your playing lends a whole new dimension..."
                                                                },
                                                                {
                                                                    "id": "760490803",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Ah, maybe because {NICKNAME} was channeling {M#his}{F#her} emotional connection to that place..."
                                                                },
                                                                {
                                                                    "id": "760490804",
                                                                    "speaker": "The Damselette",
                                                                    "text": "What's curious is that... I feel as if I can picture the landscape just by listening to the melody. I wonder how the real thing compares to my imagination..."
                                                                },
                                                                {
                                                                    "id": "760490805",
                                                                    "speaker": "Paimon",
                                                                    "text": "You should just go see it someday! We can be your tour guides!"
                                                                },
                                                                {
                                                                    "id": "760490806",
                                                                    "speaker": "The Damselette",
                                                                    "text": "Mm... Perhaps. If that day ever comes."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "760490112",
                                            "text": "But what should I play?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "760490109",
                            "text": "Though I have been known to dabble..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7604903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490301",
                    "speaker": "The Damselette",
                    "text": "The kuuhenki seem quite content for the day. Even so... I may have to trouble you to drop by again when they wish to learn more."
                }
            ]
        },
        {
            "id": "7604907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760490709",
                    "speaker": "The Damselette",
                    "text": "We have pierced through cloud and fog, and together, witnessed the answer on the moon... Its beauty is like the music your strings now sing."
                }
            ]
        }
    ]
}