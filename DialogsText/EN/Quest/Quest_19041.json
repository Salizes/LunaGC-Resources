            "objective": "Additional",
            "dialogues": [
                {
                    "id": "1904101304",
                    "speaker": "Player",
                    "text": "Come on, I'm not as great as you make out..."
                },
                {
                    "id": "1904101306",
                    "speaker": "Player",
                    "text": "I've always wanted to go adventuring with you, too."
                },
                {
                    "id": "1904101391",
                    "speaker": "Player",
                    "text": "I do."
                },
                {
                    "id": "1904101392",
                    "speaker": "Player",
                    "text": "No, I usually leave straight away."
                }
            ]
        },
        {
            "id": "19041014",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "1904101403",
                    "speaker": "Player",
                    "text": "It's okay, I like adventures too."
                },
                {
                    "id": "1904101405",
                    "speaker": "Player",
                    "text": "Let's change the topic."
                }
            ]
        },
        {
            "id": "19041015",
            "objective": "Additional",
            "dialogues": [
                {
