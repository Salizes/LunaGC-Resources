        {
            "id": "7180003",
            "objective": "",
            "dialogues": [
                {
                    "id": "718000301",
                    "speaker": "Madame Ping",
                    "text": "",
                    "choices": [
                        {
                            "id": "718000302",
                            "text": "My clothes are soaked through...",
                            "response": [
                                {
                                    "id": "718000303",
                                    "speaker": "Madame Ping",
                                    "text": "I'm terribly sorry, children, how absent-minded of me. I had thought there was only a little water inside."
                                },
                                {
                                    "id": "718000304",
                                    "speaker": "Madame Ping",
                                    "text": "At least this teapot is more or less clean now. There are a few final nooks and crannies to attend to, but all in good time."
                                },
                                {
                                    "id": "718000307",
                                    "speaker": "Paimon",
                                    "text": "Granny, did you put the whole Bishui River in there or something!?"
                                },
                                {
                                    "id": "718000308",
                                    "speaker": "Madame Ping",
                                    "text": "Foolish child, I wouldn't dream of doing such a thing — wherever would the poor city folks draw their water from if I did that? No, I was careful to use only half of the river's water."
                                },
                                {
                                    "id": "718000309",
                                    "speaker": "Madame Ping",
                                    "text": "Sorry for causing you a little spot of bother on this occasion. Please accept these as thanks for your help."
                                },
                                {
                                    "id": "718000310",
                                    "speaker": "Madame Ping",
                                    "text": "Oh, and I mustn't forget to return the water from the teapot back to the river some time..."
                                }
                            ]
                        },
                        {
                            "id": "718000305",
                            "text": "Should be spick and span in there by now.",
                            "response": [
                                {
                                    "id": "718000306",
                                    "speaker": "Madame Ping",
                                    "text": "Well, mostly. There are still a few nooks and crannies, mind you, that one shall have to get inside and clean out."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
