            "dialogues": [
                {
                    "id": "719330101",
                    "speaker": "Player",
                    "text": "Isn't it inconvenient to get around at night?"
                },
                {
                    "id": "719330102",
                    "speaker": "Ziwei",
                    "text": "That is the case, somewhat."
                },
                {
                    "id": "719330103",
                    "speaker": "Ziwei",
                    "text": "But the stars will only appear in the night sky, so it can't be helped. I have also developed a countermeasure."
                },
                {
                    "id": "719330104",
                    "speaker": "Ziwei",
                    "text": "This is known as a Small Lamp Grass, which glows in the dark. It's not bright, but it gives you a sense of security."
                },
                {
                    "id": "719330105",
                    "speaker": "Ziwei",
                    "text": "If you often travel in the dark yourself, consider bringing a few of these along."
                }
            ]
        }
    ]
