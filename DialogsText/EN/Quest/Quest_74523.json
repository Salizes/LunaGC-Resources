            "dialogues": [
                {
                    "id": "745230101",
                    "speaker": "Kaedehara Kazuha",
                    "text": "What do you think? Have the verses carried on the wind reached your Kamera as well?"
                }
            ]
        },
        {
            "id": "7452302",
            "objective": "",
            "dialogues": [
                {
                    "id": "745230201",
                    "speaker": "Player",
                    "text": "Let's continue the photoshoot!"
                }
            ]
        },
        {
            "id": "7452303",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745230301",
                    "speaker": "Player",
                    "text": "Give me a second, I'm considering my options."
                }
            ]
        },
        {
            "id": "7452304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745230401",
                    "speaker": "Kaedehara Kazuha",
                    "text": "The wind here carries a touch of sea-salt and the distant woody scent of merchant ships... and it brings news of old friends, too."
                },
                {
                    "id": "745230402",
                    "speaker": "Kaedehara Kazuha",
                    "text": "#Have you been well, {NICKNAME}?",
                    "choices": [
                        {
                            "id": "745230403",
                            "text": "It's been a while, Kazuha.",
                            "response": [
                                {
                                    "id": "745230405",
                                    "speaker": "Kaedehara Kazuha",
                                    "text": "The Crux is presently docked in Inazuma for resupply. I decided to take the rare opportunity to visit my homeland, to take in its sights and sounds, and listen to the wind that blows here."
                                },
                                {
                                    "id": "745230406",
                                    "speaker": "Kaedehara Kazuha",
                                    "text": "The winds of Ritou are always more clamorous than elsewhere, mixed with partings and reunions, hope and confusion... It is a place where you can hear a great many stories.",
                                    "choices": [
                                        {
                                            "id": "745230407",
                                            "text": "Would you mind if I took a picture of you?",
                                            "response": [
                                                {
                                                    "id": "745230409",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "Hehe. All things in this world have their shape, and so it is with the wind, albeit glimpsed in the falling leaves, the rising waves, or in the moment when a traveler's clothes flutter."
                                                },
                                                {
                                                    "id": "745230410",
                                                    "speaker": "Kaedehara Kazuha",
                                                    "text": "I hope that my presence will allow you to give shape to this ephemeral force.",
                                                    "choices": [
                                                        {
                                                            "id": "745230411",
                                                            "text": "Here we go, then.",
                                                            "response": [
                                                                {
                                                                    "id": "745230413",
                                                                    "speaker": "Kaedehara Kazuha",
                                                                    "text": "In that case, may you write the verse that best describes this moment."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745230412",
                                                            "text": "Just stay as you were earlier and feel the wind."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745230408",
                                            "text": "I'd like to capture the wind that blows at this moment as well."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745230404",
                            "text": "What brings you here?"
                        }
                    ]
                }
            ]
        }
    ]
}