    "talks": [
        {
            "id": "7304701",
            "objective": "",
            "dialogues": [
                {
                    "id": "730470101",
                    "speaker": "Araja",
                    "text": "#Nara {NICKNAME}, Paimon, we meet again. Hehehe..."
                },
                {
                    "id": "730470102",
                    "speaker": "Paimon",
                    "text": "You look very happy, Araja!"
                },
                {
                    "id": "730470103",
                    "speaker": "Araja",
                    "text": "Hoho... I am indeed very happy to see Vanarana so lively, with so many Aranara having returned home. Ah, I never thought that I'd be able to participate in Festival Utsava in person...",
                    "choices": [
                        {
                            "id": "730470104",
                            "text": "You haven't participated in it before?",
                            "response": [
                                {
                                    "id": "730470107",
                                    "speaker": "Araja",
                                    "text": "The stories say that I did participate. It was a long, long time ago..."
                                },
                                {
                                    "id": "730470108",
                                    "speaker": "Araja",
                                    "text": "I, Aramuhukunda, Arana, Araji... Many of us Aranara celebrated Festival Utsava together with Nara Varuna."
                                },
                                {
                                    "id": "730470109",
                                    "speaker": "Araja",
                                    "text": "It was a very difficult time. But we still laughed and sang together during Festival Utsava. I like this story very much."
                                },
                                {
                                    "id": "730470110",
                                    "speaker": "Paimon",
                                    "text": "Huh? Then you did participate, didn't you?"
                                },
                                {
                                    "id": "730470111",
                                    "speaker": "Araja",
                                    "text": "Oh, I did participate, in the stories. But I no longer remember that. Those stories were all things that Arana and the others told me later."
                                },
                                {
                                    "id": "730470112",
                                    "speaker": "Paimon",
                                    "text": "Hmmm... Araja is starting to sound a lot like a grandpa. Maybe Araja's just getting too old and can't remember clearly!"
                                },
                                {
                                    "id": "730470113",
                                    "speaker": "Araja",
                                    "text": "#Perhaps this is for the best... Anyway, Nara {NICKNAME}, Paimon, will you take this?"
                                },
                                {
                                    "id": "730470114",
                                    "speaker": "Paimon",
                                    "text": "It's a flower..."
                                },
                                {
                                    "id": "730470115",
                                    "speaker": "Araja",
                                    "text": "Yes. I hope that this flower will follow you in your future travels.",
                                    "choices": [
                                        {
                                            "id": "730470116",
                                            "text": "I'll accept it.",
                                            "response": [
                                                {
                                                    "id": "730470118",
                                                    "speaker": "Araja",
                                                    "text": "Nara time is much more precious than Aranara time, so I will not keep you from enjoying yourselves. Go look for Arakavi later. He is also preparing for the Festival Utsava ceremony."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730470117",
                                            "text": "Thanks."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730470105",
                            "text": "I'm very happy too.",
                            "response": [
                                {
                                    "id": "730470106",
                                    "speaker": "Paimon",
                                    "text": "Paimon's really happy too! But haven't you ever participated in Festival Utsava before, Araja?"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
