            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745290301",
                    "speaker": "Player",
                    "text": "Give me a second, I'm considering my options."
                }
            ]
        },
        {
            "id": "7452904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745290401",
                    "speaker": "Citlali",
                    "text": "#Oh, good. You're here, {NICKNAME}.",
                    "choices": [
                        {
                            "id": "745290402",
                            "text": "Long time no see, Citlali.",
                            "response": [
                                {
                                    "id": "745290404",
                                    "speaker": "Citlali",
                                    "text": "Oh, please, I go out for walks once in a while, thank you very much."
                                },
                                {
                                    "id": "745290405",
                                    "speaker": "Citlali",
                                    "text": "And in any case, my divinations last night predicted that good things would come to me if I went out today."
                                },
                                {
                                    "id": "745290406",
                                    "speaker": "Citlali",
                                    "text": "If this doesn't count as fulfillment of said fortune, I don't know what does.",
                                    "choices": [
                                        {
                                            "id": "745290407",
                                            "text": "Then let us add one to the tally of positives.",
                                            "response": [
                                                {
                                                    "id": "745290409",
                                                    "speaker": "Citlali",
                                                    "text": "Well, it's not that you can't... It's just... I stayed up all night two days ago to finish the latest light novel volume!"
                                                },
                                                {
                                                    "id": "745290410",
                                                    "speaker": "Citlali",
                                                    "text": "So... Look me over real quick. Do I look okay? The dark circles around my eyes should be gone now, right?",
                                                    "choices": [
                                                        {
                                                            "id": "745290411",
                                                            "text": "You're right as rain.",
                                                            "response": [
                                                                {
                                                                    "id": "745290413",
                                                                    "speaker": "Citlali",
                                                                    "text": "Really? No tricks now..."
                                                                },
                                                                {
                                                                    "id": "745290414",
                                                                    "speaker": "Citlali",
                                                                    "text": "Just so we're clear, I'm keeping all the ones that don't pass muster. You only get the best of the lot."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745290412",
                                                            "text": "You're as radiant as ever!"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745290408",
                                            "text": "Let me take a picture of you!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745290403",
                            "text": "What a surprise — you're not sleeping in today."
                        }
                    ]
                }
            ]
        }
    ]
