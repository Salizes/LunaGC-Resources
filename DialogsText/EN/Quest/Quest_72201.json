    "talks": [
        {
            "id": "7220101",
            "objective": "",
            "dialogues": [
                {
                    "id": "722010101",
                    "speaker": "Rero",
                    "text": "Ah, kind passers-by, please, please take pity on me...",
                    "choices": [
                        {
                            "id": "722010102",
                            "text": "What's happening?",
                            "response": [
                                {
                                    "id": "722010104",
                                    "speaker": "Rero",
                                    "text": "Thank you, thank you for listening to these old bones pour out their woes... *sigh* Come here, come here, do let me say a little more..."
                                },
                                {
                                    "id": "722010105",
                                    "speaker": "Rero",
                                    "text": "I have not seen my life take a single good turn, not ever..."
                                },
                                {
                                    "id": "722010106",
                                    "speaker": "Rero",
                                    "text": "When I was but a newborn, the presiding priest accidentally knocked a lamp over, burning all the long hair on my aunt's head."
                                },
                                {
                                    "id": "722010107",
                                    "speaker": "Player",
                                    "text": "Oh dear..."
                                },
                                {
                                    "id": "722010108",
                                    "speaker": "Rero",
                                    "text": "Later, I contracted some strange illness, and from then on suffered from a chronic ungainliness. Still later on, I fell from my cradle, breaking six ribs..."
                                },
                                {
                                    "id": "722010109",
                                    "speaker": "Rero",
                                    "text": "And when I grew a little older, my father hit me over the head with his shovel by mistake as he fought to save my cousin, who had almost choked to death on mushrooms..."
                                },
                                {
                                    "id": "722010110",
                                    "speaker": "Rero",
                                    "text": "And then there was the time when my beloved finch was eaten by the Wen Kamuy our family kept, before that same Wen Kamuy was knocked off a cliff by a boar..."
                                },
                                {
                                    "id": "722010111",
                                    "speaker": "Rero",
                                    "text": "After that, the girl I liked accidentally sacrificed the priest to the Great Thunderbird, and she was exiled from the island..."
                                },
                                {
                                    "id": "722010112",
                                    "speaker": "Rero",
                                    "text": "When I grew up, my grandma died from grief at my ugliness and gloominess, and my grandpa soon followed..."
                                },
                                {
                                    "id": "722010113",
                                    "speaker": "Rero",
                                    "text": "Then after that..."
                                },
                                {
                                    "id": "722010114",
                                    "speaker": "Player",
                                    "text": "You could at least take comfort in your family, right?"
                                },
                                {
                                    "id": "722010115",
                                    "speaker": "Rero",
                                    "text": "Ah, speaking of my family... When I came of age, our witch doctor told me that I wouldn't be able to have children, because I'd grown a... One moment, let me show you...",
                                    "choices": [
                                        {
                                            "id": "722010116",
                                            "text": "Uh, I'll pass!",
                                            "response": [
                                                {
                                                    "id": "722010118",
                                                    "speaker": "Rero",
                                                    "text": "*sigh* Alright. But would you listen to just one last thing? If you don't mind, I'd like you to do just this last thing for me...",
                                                    "choices": [
                                                        {
                                                            "id": "722010119",
                                                            "text": "Well, go ahead.",
                                                            "response": [
                                                                {
                                                                    "id": "722010121",
                                                                    "speaker": "Rero",
                                                                    "text": "Some time ago, I accidentally dropped my golden ring into my wife's grave as I was burying her..."
                                                                },
                                                                {
                                                                    "id": "722010122",
                                                                    "speaker": "Rero",
                                                                    "text": "That is the last thing I have in my possession, but I dare not dig it out, for fear that her spirit might be angered..."
                                                                },
                                                                {
                                                                    "id": "722010123",
                                                                    "speaker": "Player",
                                                                    "text": "Uh, so this is a grave-robbing gig?"
                                                                },
                                                                {
                                                                    "id": "722010124",
                                                                    "speaker": "Rero",
                                                                    "text": "Well, uh... I mean, you're an outsider... You do all sorts of strange things, don't you?"
                                                                },
                                                                {
                                                                    "id": "722010125",
                                                                    "speaker": "Rero",
                                                                    "text": "Um. No, no, wait... I meant to say that an outsider like you would be able to avoid angering the local spirits, yes..."
                                                                },
                                                                {
                                                                    "id": "722010126",
                                                                    "speaker": "Rero",
                                                                    "text": "Go to Chirai Shrine. Her grave should be right beside it..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722010120",
                                                            "text": "As long as it's not some weird stuff again..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722010117",
                                            "text": "Too much information, thank you!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722010103",
                            "text": "Do you need help?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220102",
            "objective": "",
            "dialogues": [
                {
                    "id": "722010201",
                    "speaker": "Rero",
                    "text": "Ah-hahahahah! Ah my, ah me... I'm all out of breath..."
                },
                {
                    "id": "722010202",
                    "speaker": "Rero",
                    "text": "Ahaha... I'm tearing up over here! Ah, dear Chikapu, if only you were here to see this!",
                    "choices": [
                        {
                            "id": "722010203",
                            "text": "I gotta admit, you're pissing me off.",
                            "response": [
                                {
                                    "id": "722010205",
                                    "speaker": "Rero",
                                    "text": "Hahaha... I'm sorry, I'm sorry. Please, don't be angry..."
                                },
                                {
                                    "id": "722010206",
                                    "speaker": "Rero",
                                    "text": "I and my wife have always enjoyed playing pranks on others. We've never pulled the same trick twice, you know? And everyone enjoyed them, too!"
                                },
                                {
                                    "id": "722010207",
                                    "speaker": "Rero",
                                    "text": "Later, she suffered from a serious illness and left this world early... She told me then that I had to play a trick on someone in front of her grave, or her spirit wouldn't be able to move on..."
                                },
                                {
                                    "id": "722010208",
                                    "speaker": "Rero",
                                    "text": "So I did. It was Chikapu's wish. How did it go? Pretty good, huh?",
                                    "choices": [
                                        {
                                            "id": "722010209",
                                            "text": "It was kinda lame.",
                                            "response": [
                                                {
                                                    "id": "722010212",
                                                    "speaker": "Rero",
                                                    "text": "Ah, come on! You outsiders are no fun!"
                                                },
                                                {
                                                    "id": "722010213",
                                                    "speaker": "Rero",
                                                    "text": "Well, I've still got a trusty water-spraying trick, if you'd like to see it... No? Aw, come on!"
                                                },
                                                {
                                                    "id": "722010214",
                                                    "speaker": "Rero",
                                                    "text": "Alright, alright, I'm leaving! See you!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722010210",
                                            "text": "You nearly got us killed!"
                                        },
                                        {
                                            "id": "722010211",
                                            "text": "I'm gonna have trouble trusting you from now on..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722010204",
                            "text": "Care to share what this is all about?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220103",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722010301",
                    "speaker": "Rero",
                    "text": "Go to Chirai Shrine. Her grave should be right beside it..."
                }
            ]
        }
    ]
