    "talks": [
        {
            "id": "7002301",
            "objective": "Talk to the other hilichurl willing to make conversation",
            "dialogues": [
                {
                    "id": "700230101",
                    "speaker": "Diligent Hilichurl",
                    "text": "Ya!"
                },
                {
                    "id": "700230102",
                    "speaker": "Ella Musk",
                    "text": "Mimi ika yaya nye! Mimi tomo, mimi mani ye."
                },
                {
                    "id": "700230103",
                    "speaker": "Diligent Hilichurl",
                    "text": "Mani. Mi muhe mani. Unu du mani! Hahahahaha."
                },
                {
                    "id": "700230104",
                    "speaker": "Ella Musk",
                    "text": "This one just told a joke in Hilichurlian, then laughed at its own joke. They must have such a spiritually impoverished existence... Poor things."
                },
                {
                    "id": "700230105",
                    "speaker": "Diligent Hilichurl",
                    "text": "Mi muhe <color=#00E1FFFF>kucha gusha</color>. Kucha gusha dada. Unu gusha dada!"
                },
                {
                    "id": "700230106",
                    "speaker": "Ella Musk",
                    "text": "He wants to... Actually, never mind, you can find everything you need to know inside the handbook."
                }
            ]
        },
        {
            "id": "7002302",
            "objective": "Give an item to the hilichurl",
            "dialogues": [
                {
                    "id": "700230301",
                    "speaker": "Diligent Hilichurl",
                    "text": "Yeye dada! Mosi mita!"
                },
                {
                    "id": "700230302",
                    "speaker": "Diligent Hilichurl",
                    "text": "Hahahaha, kucha gusha unu gusha. Unu kucha si!"
                },
                {
                    "id": "700230303",
                    "speaker": "Diligent Hilichurl",
                    "text": "Wei? Odomu tomo zido mi! <color=#00E1FFFF>Mosi aba nunu</color>!"
                },
                {
                    "id": "700230304",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Mosi aba nunu</color>... Does the handbook say what that phrase means?",
                    "choices": [
                        {
                            "id": "700230305",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700230307",
                                    "speaker": "Diligent Hilichurl",
                                    "text": "Valo, mi tomo!"
                                }
                            ]
                        },
                        {
                            "id": "700230306",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002304",
            "objective": "",
            "dialogues": [
                {
                    "id": "700230401",
                    "speaker": "Diligent Hilichurl",
                    "text": "Nye nye nye. Kucha, gusha. Hahahaha. Kucha gusha, kucha, gusha. Hahaha."
                },
                {
                    "id": "700230402",
                    "speaker": "Paimon",
                    "text": "That didn't seem right."
                },
                {
                    "id": "700230403",
                    "speaker": "Player",
                    "text": "(But it certainly made it smile...)"
                }
            ]
        },
        {
            "id": "7002302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700230201",
                    "speaker": "Diligent Hilichurl",
                    "text": "Mi muhe unu boya gusha."
                },
                {
                    "id": "700230202",
                    "speaker": "Player",
                    "text": "(Is it this one?)"
                }
            ]
        },
        {
            "id": "7002399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700239901",
                    "speaker": "Paimon",
                    "text": "Hold on a second... Why are we fighting the hilichurls' battles for them, again?"
                }
            ]
        }
    ]
