    "talks": [
        {
            "id": "7220601",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060101",
                    "speaker": "Abe",
                    "text": "Hey! I'm over here, you know?"
                },
                {
                    "id": "722060102",
                    "speaker": "Abe",
                    "text": "Young people these days... Don't you kids have any kind of courtesy at all?",
                    "choices": [
                        {
                            "id": "722060103",
                            "text": "S—Sorry!",
                            "response": [
                                {
                                    "id": "722060104",
                                    "speaker": "Abe",
                                    "text": "Hmph! That's more like it. As for those mushrooms, let's just call that my gift... But don't you touch the rest however you like!"
                                }
                            ]
                        },
                        {
                            "id": "722060105",
                            "text": "Are these your mushrooms?",
                            "response": [
                                {
                                    "id": "722060106",
                                    "speaker": "Abe",
                                    "text": "None of your business! Just stop picking them however you like and get out of here!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220603",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060201",
                    "speaker": "Paimon",
                    "text": "Eek! That guy just now... Did you see that!?",
                    "choices": [
                        {
                            "id": "722060202",
                            "text": "Nope.",
                            "response": [
                                {
                                    "id": "722060204",
                                    "speaker": "Paimon",
                                    "text": "Uhh, that's just too spooky. Let's just grab a few mushrooms and get out of here, shall we?"
                                }
                            ]
                        },
                        {
                            "id": "722060203",
                            "text": "Must've been an illusion."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220604",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060401",
                    "speaker": "Abe",
                    "text": "How's it going? I'm ready and waiting to have my horizons broadened!"
                },
                {
                    "id": "722060402",
                    "speaker": "Player",
                    "text": "Will these mushrooms do for you?"
                }
            ]
        },
        {
            "id": "7220605",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060301",
                    "speaker": "Abe",
                    "text": "Hey! Hey! Didn't I warn you lot before!? Are you hard of hearing, or do you just not have eyes, huh?"
                },
                {
                    "id": "722060302",
                    "speaker": "Player",
                    "text": "Oh, look, a ghost!"
                },
                {
                    "id": "722060303",
                    "speaker": "Abe",
                    "text": "Eek! Ghost? Where? Where!?",
                    "choices": [
                        {
                            "id": "722060304",
                            "text": "Right here.",
                            "response": [
                                {
                                    "id": "722060306",
                                    "speaker": "Abe",
                                    "text": "Aaaagh! Go! Shoo! Evil begone! By my clan's name, Abe, depart from this place!"
                                },
                                {
                                    "id": "722060307",
                                    "speaker": "Abe",
                                    "text": "...What? N—No! That can't be! I've... I've never encountered such a wicked spirit in all my years! Wh—Why aren't you leaving?"
                                },
                                {
                                    "id": "722060308",
                                    "speaker": "Player",
                                    "text": "Why, I've come from beyond this island."
                                },
                                {
                                    "id": "722060309",
                                    "speaker": "Abe",
                                    "text": "An evil spirit from beyond the Sea of Fog? I—I'm not afraid of you! Just you wait! Th—The Great Thunderbird will exorcise you!",
                                    "choices": [
                                        {
                                            "id": "722060310",
                                            "text": "Your Thunderbird is long gone.",
                                            "response": [
                                                {
                                                    "id": "722060312",
                                                    "speaker": "Abe",
                                                    "text": "Wh—What did you say?",
                                                    "choices": [
                                                        {
                                                            "id": "722060313",
                                                            "text": "Everyone's left.",
                                                            "response": [
                                                                {
                                                                    "id": "722060315",
                                                                    "speaker": "Abe",
                                                                    "text": "What... What are you saying? D—Don't you try to scare me like that. Ohhh, I—I'm getting goosebumps already..."
                                                                },
                                                                {
                                                                    "id": "722060316",
                                                                    "speaker": "Abe",
                                                                    "text": "Still, there have been fewer and fewer people on the island lately. Kina also told me that everyone was getting onboard the boat... *sigh* Who knows where that kid's run off to now..."
                                                                },
                                                                {
                                                                    "id": "722060317",
                                                                    "speaker": "Abe",
                                                                    "text": "Wait a moment. Spirit from beyond this island... Aren't you leaving too? On the silver boat by the seashore?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "722060318",
                                                                            "text": "I saw no boat there.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "722060320",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Huh... I knew it. I knew outsiders wouldn't be able to see that boat."
                                                                                },
                                                                                {
                                                                                    "id": "722060321",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Still, thanks for telling me to get onboard, evil spirit. It's... It's just that I've lived here for so long, and yet there's so much I still haven't seen or done... I can't just leave this place!"
                                                                                },
                                                                                {
                                                                                    "id": "722060322",
                                                                                    "speaker": "Player",
                                                                                    "text": "What will you need?"
                                                                                },
                                                                                {
                                                                                    "id": "722060323",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Need? Eh? I mean, it's not as if I need anything. I'd just like to see something new, you know?"
                                                                                },
                                                                                {
                                                                                    "id": "722060324",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Once, when I was still very young, I made a bet with Una that there were different kinds of mushrooms outside our island, but she wouldn't believe me."
                                                                                },
                                                                                {
                                                                                    "id": "722060325",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Later, her husband went out to sea, leaving for lands where the outsiders live. He never returned, and they say his spirit wanders the lands beyond... Poor guy."
                                                                                },
                                                                                {
                                                                                    "id": "722060326",
                                                                                    "speaker": "Abe",
                                                                                    "text": "Una's been living alone ever since then. Every time I think about it, I... *sigh*",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "722060327",
                                                                                            "text": "Don't worry about her too much.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "722060329",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "I even begged the priest, you know? At the very least, we had to give someone a place to stay... Ah, right, right! The mushrooms!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060330",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "*cough* Well, I'll be boarding the boat soon, and I don't really have that many regrets... I just haven't seen anything that lies beyond our island. Still, that which concerns me most has to be those mushrooms I take care of every day..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060331",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "Please, help me bring back some mushrooms from beyond the Sea of Fog. I'd love to see what they look like!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060332",
                                                                                                    "speaker": "Abe",
                                                                                                    "text": "Please help me, evil outsider spirit!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "722060328",
                                                                                            "text": "So about the mushrooms..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "722060319",
                                                                            "text": "That ship was not made to bear me hence."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722060314",
                                                            "text": "It's time to leave."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722060311",
                                            "text": "The Sea of Fog is a thing of the past."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722060305",
                            "text": "That's me!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220607",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060501",
                    "speaker": "Abe",
                    "text": "Ooh! Haha... Wow, they've got such odd shapes! Do they have souls, too? Do they contain peoples' memories?"
                },
                {
                    "id": "722060502",
                    "speaker": "Abe",
                    "text": "And these soft, wing-like things... Can they fly?"
                },
                {
                    "id": "722060503",
                    "speaker": "Abe",
                    "text": "Ah, me and my endless curiosity! The boatman's getting annoyed now, I think. I'm sorry, but I reckon I must go. Yes, I must..."
                }
            ]
        }
    ]
}