        {
            "id": "7000601",
            "objective": "Talk to the hilichurl",
            "dialogues": [
                {
                    "id": "700060102",
                    "speaker": "Hungry Hilichurl",
                    "text": "Mi muhe mosi! Mi muhe mita, <color=#00E1FFFF>mita movo lata</color>!"
                },
                {
                    "id": "700060103",
                    "speaker": "Ella Musk",
                    "text": "Oh, it's hungry... Let's see what it wants, shall we?"
                },
                {
                    "id": "700060104",
                    "speaker": "Ella Musk",
                    "text": "It appears to want... some sort of meat? But I'm not sure what, exactly, so could you please check the handbook?"
                }
            ]
        },
        {
            "id": "7000602",
            "objective": "Give an item to the hilichurl",
            "dialogues": [
                {
                    "id": "700060301",
                    "speaker": "Hungry Hilichurl",
                    "text": "Yeye tomo! Mosi mita!"
                },
                {
                    "id": "700060302",
                    "speaker": "Player",
                    "text": "Mosi mita!"
                },
                {
                    "id": "700060303",
                    "speaker": "Ella Musk",
                    "text": "Success!"
                },
                {
                    "id": "700060304",
                    "speaker": "Ella Musk",
                    "text": "Du odomu tomo dala?"
                },
                {
                    "id": "700060305",
                    "speaker": "Hungry Hilichurl",
                    "text": "Mi mito nye. Ya zido mito, mi mito! Mi zido!"
                },
                {
                    "id": "700060306",
                    "speaker": "Ella Musk",
                    "text": "It said... it also doesn't know, but it knows someone else who knows. And it marked their location on the Map for us!"
                },
                {
                    "id": "700060307",
                    "speaker": "Ella Musk",
                    "text": "So let's find them!"
                }
            ]
        },
        {
            "id": "7000604",
