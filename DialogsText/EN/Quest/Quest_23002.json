    "talks": [
        {
            "id": "2300201",
            "objective": "Talk to Hanbei",
            "dialogues": [
                {
                    "id": "230020101",
                    "speaker": "Hanbei",
                    "text": "The mushrooms here don't look too bad. I'll put them on my shopping list..."
                },
                {
                    "id": "230020102",
                    "speaker": "Paimon",
                    "text": "Hanbei? Now that's a familiar name. Paimon's sure we've heard that one somewhere...",
                    "choices": [
                        {
                            "id": "230020103",
                            "text": "...Was it the guy at Tatarasuna?",
                            "response": [
                                {
                                    "id": "230020105",
                                    "speaker": "Paimon",
                                    "text": "Yikes! He's the guy who made a complete mess of the Mikage Furnace!",
                                    "choices": [
                                        {
                                            "id": "230020106",
                                            "text": "I think he's here as a foreign attaché...",
                                            "response": [
                                                {
                                                    "id": "230020108",
                                                    "speaker": "Paimon",
                                                    "text": "So he really is here in Sumeru. Paimon thought that whole foreign attaché thing was just a joke..."
                                                },
                                                {
                                                    "id": "230020109",
                                                    "speaker": "Hanbei",
                                                    "text": "#Eh? {M#Blond}{F#Blonde} hair... and a small flying thing..."
                                                },
                                                {
                                                    "id": "230020110",
                                                    "speaker": "Hanbei",
                                                    "text": "Are you the Traveler?",
                                                    "choices": [
                                                        {
                                                            "id": "230020111",
                                                            "text": "That's right.",
                                                            "response": [
                                                                {
                                                                    "id": "230020114",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Haha, so it really is you. Yousuke's letter mentioned how you helped Mr. Xavier deal with the Mikage Furnace."
                                                                },
                                                                {
                                                                    "id": "230020115",
                                                                    "speaker": "Hanbei",
                                                                    "text": "*sigh* I feel so ashamed. I was tied up with administrative work when the two of you were fixing the Mikage Furnace."
                                                                },
                                                                {
                                                                    "id": "230020116",
                                                                    "speaker": "Player",
                                                                    "text": "Is administrative work really more important than the Mikage Furnace..."
                                                                },
                                                                {
                                                                    "id": "230020117",
                                                                    "speaker": "Paimon",
                                                                    "text": "You've got your priorities all wrong!"
                                                                },
                                                                {
                                                                    "id": "230020118",
                                                                    "speaker": "Hanbei",
                                                                    "text": "The Mikage Furnace's maintenance wouldn't have progressed so smoothly without administrative work, you know."
                                                                },
                                                                {
                                                                    "id": "230020119",
                                                                    "speaker": "Hanbei",
                                                                    "text": "I was evacuating the people nearby, prepping the materials for repairs, redirecting the appropriate manpower, and even coordinating production..."
                                                                },
                                                                {
                                                                    "id": "230020120",
                                                                    "speaker": "Hanbei",
                                                                    "text": "All these things would have been a complete mess without administrative support."
                                                                },
                                                                {
                                                                    "id": "230020121",
                                                                    "speaker": "Player",
                                                                    "text": "It's just like Toranosuke said..."
                                                                },
                                                                {
                                                                    "id": "230020122",
                                                                    "speaker": "Paimon",
                                                                    "text": "You live up to your reputation..."
                                                                },
                                                                {
                                                                    "id": "230020123",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Toranosuke... That man has such blatant disregard for administrative work. I always end up with extra work when working with him."
                                                                },
                                                                {
                                                                    "id": "230020124",
                                                                    "speaker": "Hanbei",
                                                                    "text": "But I'm not in charge of the Mikage Furnace anymore. I'm serving as foreign attaché in Sumeru now, and I manage the mushroom trade."
                                                                },
                                                                {
                                                                    "id": "230020125",
                                                                    "speaker": "Hanbei",
                                                                    "text": "Ah, Traveler, I've heard about your deeds from Yousuke, and I do believe that you are a truly reliable person."
                                                                },
                                                                {
                                                                    "id": "230020126",
                                                                    "speaker": "Hanbei",
                                                                    "text": "If you don't mind, could you help me with something?"
                                                                },
                                                                {
                                                                    "id": "230020127",
                                                                    "speaker": "Hanbei",
                                                                    "text": "I've been searching for a reliable mushroom supplier, and I've met with many merchants here."
                                                                },
                                                                {
                                                                    "id": "230020128",
                                                                    "speaker": "Hanbei",
                                                                    "text": "But they always select only their best to put on display..."
                                                                },
                                                                {
                                                                    "id": "230020129",
                                                                    "speaker": "Hanbei",
                                                                    "text": "I think a visit to their farms is necessary to assess the quality of their supply."
                                                                },
                                                                {
                                                                    "id": "230020130",
                                                                    "speaker": "Hanbei",
                                                                    "text": "But as you can see, I have no experience in conducting surveys in the wild. And I don't think I'll make it out of the forest alive if I go alone."
                                                                },
                                                                {
                                                                    "id": "230020131",
                                                                    "speaker": "Hanbei",
                                                                    "text": "So, I would like you to help me go there and gather some mushrooms...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230020132",
                                                                            "text": "Well, I can do that...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230020134",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "You'll do it? Wonderful! Don't worry about your payment, I've even prepared the contract documentation."
                                                                                },
                                                                                {
                                                                                    "id": "230020135",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Take a look at this. Yes, this document. This is your hiring contract, compensation breakdown, and a disclosure and confidentiality agreement. Oh, I almost forgot, here's a map of the mushroom farm..."
                                                                                },
                                                                                {
                                                                                    "id": "230020136",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "You are exhausted after carefully looking through all the documents with Hanbei..."
                                                                                },
                                                                                {
                                                                                    "id": "230020137",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Good, now you're fully informed. I'll be sending a report to the Shogunate, and we can finalize everything once I have the Shogunate's approval."
                                                                                },
                                                                                {
                                                                                    "id": "230020138",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "But I'll pay you out of my own pocket until then. After all, I can't delay this any longer."
                                                                                },
                                                                                {
                                                                                    "id": "230020139",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Of course, I'll be filing the necessary documents for this as well. Your compensation does come with tax implications."
                                                                                },
                                                                                {
                                                                                    "id": "230020140",
                                                                                    "speaker": "Player",
                                                                                    "text": "I... I'm going to gather mushrooms now!"
                                                                                },
                                                                                {
                                                                                    "id": "230020141",
                                                                                    "speaker": "Hanbei",
                                                                                    "text": "Eh? Oh... I'll leave it to you then."
                                                                                },
                                                                                {
                                                                                    "id": "230020142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "We won't get caught up in some trouble again, right?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "230020143",
                                                                                            "text": "We won't if I keep an eye on him.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230020144",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Really? Okay, you do have a point..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230020147",
                                                                                                    "speaker": "Hanbei",
                                                                                                    "text": "Eh? Why do you look so doubtful... Don't you worry, I've made very thorough preparations, so there won't be any issues during this process."
                                                                                                },
                                                                                                {
                                                                                                    "id": "230020148",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "We're not talking about that kind of trouble... *sigh* Let's just get his mushrooms for him, shall we?"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "230020145",
                                                                                            "text": "I wonder what kind of trouble he'll cause this time.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "230020146",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Hey! If that really happens, we won't have anyone to help us out here!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230020133",
                                                                            "text": "Let's talk about payment first..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230020112",
                                                            "text": "This is Paimon...",
                                                            "response": [
                                                                {
                                                                    "id": "230020113",
                                                                    "speaker": "Paimon",
                                                                    "text": "Paimon's Paimon! Not some \"small flying thing\"!"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230020107",
                                            "text": "I think he's here for the mushrooms..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230020104",
                            "text": "Toranosuke and Yousuke both mentioned him..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "2300202",
            "objective": "Go pick mushrooms",
            "dialogues": [
                {
                    "id": "230020201",
                    "speaker": "Hanbei",
                    "text": "So, did you manage to gather the mushrooms?"
                }
            ]
        },
        {
            "id": "2300203",
            "objective": "Pick mushrooms",
            "dialogues": [
                {
                    "id": "230020301",
                    "speaker": "Hanbei",
                    "text": "Wonderful. This is plenty. They look pretty good too..."
                },
                {
                    "id": "230020302",
                    "speaker": "Hanbei",
                    "text": "Here's your payment, thanks for the help."
                },
                {
                    "id": "230020303",
                    "speaker": "Player",
                    "text": "Is this before or after taxes?"
                },
                {
                    "id": "230020304",
                    "speaker": "Hanbei",
                    "text": "After taxes, of course. Don't worry, I wouldn't make you go all the way back to Inazuma just to pay for overdue taxes."
                },
                {
                    "id": "230020305",
                    "speaker": "Hanbei",
                    "text": "But I can't guarantee there haven't been any changes to the Shogunate's tax policies..."
                },
                {
                    "id": "230020306",
                    "speaker": "Hanbei",
                    "text": "Hmm... I should write a letter to Yousuke regarding this matter."
                }
            ]
        },
        {
            "id": "2300204",
            "objective": "Bring the mushrooms to Hanbei",
            "dialogues": [
                {
                    "id": "230020401",
                    "speaker": "Hanbei",
                    "text": "Wonderful. This is plenty. They look pretty good too..."
                },
                {
                    "id": "230020402",
                    "speaker": "Player",
                    "text": "I gathered some extra mushrooms."
                },
                {
                    "id": "230020403",
                    "speaker": "Hanbei",
                    "text": "Haha, that's great! Please give them to me too. I'll count them into your payment calculations."
                },
                {
                    "id": "230020404",
                    "speaker": "Hanbei",
                    "text": "Here's your payment, thanks for the help."
                },
                {
                    "id": "230020405",
                    "speaker": "Player",
                    "text": "Is this before or after taxes?"
                },
                {
                    "id": "230020406",
                    "speaker": "Hanbei",
                    "text": "After taxes. Don't worry, I wouldn't make you go all the way back to Inazuma just to pay for overdue taxes."
                },
                {
                    "id": "230020407",
                    "speaker": "Hanbei",
                    "text": "That said, I can't guarantee there haven't been any changes to the Shogunate's tax policies since..."
                },
                {
                    "id": "230020408",
                    "speaker": "Hanbei",
                    "text": "Hmm... I should write a letter to Yousuke regarding this matter."
                }
            ]
        },
        {
            "id": "2300206",
            "objective": "Talk to Hanbei",
            "dialogues": []
        },
        {
            "id": "2300205",
            "objective": "Talk to Hanbei",
            "dialogues": []
        },
        {
            "id": "2300205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230020501",
                    "speaker": "Hanbei",
                    "text": "This merchant's mushroom supply doesn't look very reliable either..."
                },
                {
                    "id": "230020502",
                    "speaker": "Paimon",
                    "text": "Why does he look so troubled? Has he gotten himself into some kind of trouble again?"
                },
                {
                    "id": "230020503",
                    "speaker": "Hanbei",
                    "text": "Traveler, you're here. The quality of the mushrooms you gathered was really good."
                },
                {
                    "id": "230020504",
                    "speaker": "Hanbei",
                    "text": "Can I ask you to gather more for me? I plan to compare them with the mushrooms from other suppliers.",
                    "choices": [
                        {
                            "id": "230020505",
                            "text": "Leave it to me.",
                            "response": [
                                {
                                    "id": "230020506",
                                    "speaker": "Hanbei",
                                    "text": "Thank you."
                                }
                            ]
                        },
                        {
                            "id": "230020507",
                            "text": "How many suppliers have you met with?",
                            "response": [
                                {
                                    "id": "230020508",
                                    "speaker": "Hanbei",
                                    "text": "Um, five or six, but their supply doesn't seem very reliable, which makes me feel rather uneasy."
                                },
                                {
                                    "id": "230020509",
                                    "speaker": "Hanbei",
                                    "text": "I'll look for other suppliers, and I'll leave the mushroom gathering to you."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}