    "talks": [
        {
            "id": "7621302",
            "objective": "",
            "dialogues": [
                {
                    "id": "762130101",
                    "speaker": "Paimon",
                    "text": "Huh? Looks like the books are in the way over here..."
                },
                {
                    "id": "762130102",
                    "speaker": "Congshen",
                    "text": "Are you looking for a book?"
                },
                {
                    "id": "762130103",
                    "speaker": "Paimon",
                    "text": "Um... Not really. We're just wondering a teensy-weensy bit about what's inside there..."
                },
                {
                    "id": "762130104",
                    "speaker": "Player",
                    "text": "It seems we could get in there from the side..."
                },
                {
                    "id": "762130105",
                    "speaker": "Congshen",
                    "text": "You can't go in there."
                },
                {
                    "id": "762130106",
                    "speaker": "Congshen",
                    "text": "I move the books, and I move the books. If that is not so, then it is yet to be complete.",
                    "choices": [
                        {
                            "id": "762130107",
                            "text": "I don't get it...",
                            "response": [
                                {
                                    "id": "762130108",
                                    "speaker": "Congshen",
                                    "text": "I move the books."
                                }
                            ]
                        },
                        {
                            "id": "762130109",
                            "text": "And what do you mean by \"move the books\"?",
                            "response": [
                                {
                                    "id": "762130110",
                                    "speaker": "Congshen",
                                    "text": "If the books aren't here, then they must have been moved. All I do is cast my eye on them."
                                },
                                {
                                    "id": "762130111",
                                    "speaker": "Player",
                                    "text": "Then let me give it a try with Dex."
                                },
                                {
                                    "id": "762130112",
                                    "speaker": "Congshen",
                                    "text": "Go straight to it."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7621302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "762130201",
                    "speaker": "Congshen",
                    "text": "Dreams, illusions, bubbles, and shadows — why labor to grasp them? Even if you study the principles for a thousand years, if you keep your mind completely still and \"unborn,\" you simply won't understand.",
                    "choices": [
                        {
                            "id": "762130202",
                            "text": "So... are you looking for a book?",
                            "response": [
                                {
                                    "id": "762130203",
                                    "speaker": "Congshen",
                                    "text": "Have you ever been here before?",
                                    "choices": [
                                        {
                                            "id": "762130204",
                                            "text": "What?",
                                            "response": [
                                                {
                                                    "id": "762130207",
                                                    "speaker": "Congshen",
                                                    "text": "Then you understand.",
                                                    "choices": [
                                                        {
                                                            "id": "762130208",
                                                            "text": "Understand... understand what?",
                                                            "response": [
                                                                {
                                                                    "id": "762130210",
                                                                    "speaker": "Congshen",
                                                                    "text": "When you need to sleep, sleep. When you need to understand, understand."
                                                                },
                                                                {
                                                                    "id": "762130211",
                                                                    "speaker": "Congshen",
                                                                    "text": "You should head back now. When the world ends, just go with it."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "762130209",
                                                            "text": "And how could I understand that?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "762130205",
                                            "text": "Yes, I have."
                                        },
                                        {
                                            "id": "762130206",
                                            "text": "No, I haven't."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "762130212",
                            "text": "You're talking in riddles. I'm leaving. Goodbye.",
                            "response": [
                                {
                                    "id": "762130213",
                                    "speaker": "Congshen",
                                    "text": "Go ahead."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}