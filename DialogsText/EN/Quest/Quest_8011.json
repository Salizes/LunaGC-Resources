    "talks": [
        {
            "id": "801113",
            "objective": "Go inside",
            "dialogues": []
        },
        {
            "id": "801101",
            "objective": "Follow the hilichurl",
            "dialogues": [
                {
                    "id": "80110101",
                    "speaker": "Eide",
                    "text": "That's... that's not Caribert.",
                    "choices": [
                        {
                            "id": "80110102",
                            "text": "No, it's not.",
                            "response": [
                                {
                                    "id": "80110104",
                                    "speaker": "Eide",
                                    "text": "Right. Caribert's scarf was a gift I once gave to his mother. I use it now as a marker of sorts."
                                },
                                {
                                    "id": "80110105",
                                    "speaker": "Eide",
                                    "text": "M—My eyes must be going... how could I not recognize my own son? Ugh, this decrepit body of mine... *sigh*",
                                    "choices": [
                                        {
                                            "id": "80110106",
                                            "text": "Still, this hilichurl...",
                                            "response": [
                                                {
                                                    "id": "80110108",
                                                    "speaker": "Eide",
                                                    "text": "Yes... It doesn't seem interested in us in the least. It seems intent on walking in that direction... Where could it be going?",
                                                    "choices": [
                                                        {
                                                            "id": "80110109",
                                                            "text": "No idea.",
                                                            "response": [
                                                                {
                                                                    "id": "80110111",
                                                                    "speaker": "Eide",
                                                                    "text": "Yes... The more we know about hilichurls, the better."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80110110",
                                                            "text": "Let's go have a look."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80110107",
                                            "text": "There's something strange about it."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80110103",
                            "text": "There's no silk scarf around his arm."
                        }
                    ]
                }
            ]
        },
        {
            "id": "801102",
            "objective": "Follow the hilichurl",
            "dialogues": [
                {
                    "id": "80110201",
                    "speaker": "Eide",
                    "text": "What a ghastly place... Has it always existed? I swear I've never noticed it before...",
                    "choices": [
                        {
                            "id": "80110202",
                            "text": "Look...",
                            "response": [
                                {
                                    "id": "80110204",
                                    "speaker": "Eide",
                                    "text": "Huh. It looks like they're... worshiping. Sometimes walking, sometimes kneeling in worship... And it appears to be in earnest."
                                },
                                {
                                    "id": "80110205",
                                    "speaker": "Eide",
                                    "text": "I've never seen anything like this in all my life. What in the world does this place conceal?"
                                },
                                {
                                    "id": "80110206",
                                    "speaker": "Eide",
                                    "text": "Oh, there's only one way to find out."
                                },
                                {
                                    "id": "80110207",
                                    "speaker": "Player",
                                    "text": "(The air here, and this creepy scene... it's eerily familiar...)"
                                }
                            ]
                        },
                        {
                            "id": "80110203",
                            "text": "What are those hilichurls doing?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "801114",
            "objective": "Follow the hilichurl to the cavern",
            "dialogues": []
        },
        {
            "id": "801103",
            "objective": "Follow the hilichurl to the cavern",
            "dialogues": [
                {
                    "id": "80110301",
                    "speaker": "???",
                    "text": "Halt, humans. Fate has not granted you the right to enter this place..."
                },
                {
                    "id": "80110302",
                    "speaker": "Player",
                    "text": "(An Abyss Herald? No, he doesn't look like someone from the Abyss Order...)"
                },
                {
                    "id": "80110303",
                    "speaker": "???",
                    "text": "Hmm, do you insist on an audience?"
                },
                {
                    "id": "80110304",
                    "speaker": "???",
                    "text": "...Very well, then I grant you the trial of destiny."
                }
            ]
        },
        {
            "id": "801104",
            "objective": "Talk to Eide",
            "dialogues": []
        },
        {
            "id": "801105",
            "objective": "Continue exploring",
            "dialogues": [
                {
                    "id": "80110501",
                    "speaker": "Eide",
                    "text": "I think... we've made it to the end..."
                },
                {
                    "id": "80110502",
                    "speaker": "Player",
                    "text": "What is that thing!?"
                },
                {
                    "id": "80110503",
                    "speaker": "Player",
                    "text": "(Wrapped in chains, hanging in midair, emanating a sinister aura... There's no mistaking it. It's just like the Defiled Statue!)"
                },
                {
                    "id": "80110504",
                    "speaker": "Player",
                    "text": "(So it does have something to do with the Abyss Order. And these worshiping hilichurls remind me a little too much of the Grand Thief...)"
                },
                {
                    "id": "80110505",
                    "speaker": "Player",
                    "text": "Eide, this place is bad news. We've got to go!"
                },
                {
                    "id": "80110506",
                    "speaker": "Eide",
                    "text": "..."
                },
                {
                    "id": "80110507",
                    "speaker": "Player",
                    "text": "Eide?"
                },
                {
                    "id": "80110508",
                    "speaker": "Voice Inside the Head",
                    "text": "...O dear creature, why do you bow down? For fear of the unknown? Or for a power that you covet?"
                },
                {
                    "id": "80110509",
                    "speaker": "Player",
                    "text": "(Whose voice is that? It must be coming from right inside my head... Can't Eide hear it?)"
                },
                {
                    "id": "80110510",
                    "speaker": "Voice Inside the Head",
                    "text": "...O dear creature, why do you bow down? For I am no god... I am but a \"Sinner.\""
                },
                {
                    "id": "80110511",
                    "speaker": "Player",
                    "text": "(A \"Sinner\"...?)"
                },
                {
                    "id": "80110512",
                    "speaker": "Voice Inside the Head",
                    "text": "You are like a flower born in sin yet pure, spotless... I know your fate well."
                },
                {
                    "id": "80110513",
                    "speaker": "Voice Inside the Head",
                    "text": "You need no longer hold back your resentment, nor accept the countless lies."
                },
                {
                    "id": "80110514",
                    "speaker": "Voice Inside the Head",
                    "text": "Go forth, become a transcendent one, rise beyond the fate bestowed upon you..."
                },
                {
                    "id": "80110515",
                    "speaker": "Voice Inside the Head",
                    "text": "And I shall shed a tear at the end of time... as I gaze back upon your life."
                },
                {
                    "id": "80110516",
                    "speaker": "Player",
                    "text": "(...Who in the world are you? What do these words mean?)"
                },
                {
                    "id": "80110517",
                    "speaker": "Voice Inside the Head",
                    "text": "..."
                },
                {
                    "id": "80110518",
                    "speaker": "Player",
                    "text": "(The voice... it's gone...)"
                },
                {
                    "id": "80110519",
                    "speaker": "Player",
                    "text": "!!!"
                },
                {
                    "id": "80110520",
                    "speaker": "Player",
                    "text": "...Eide?"
                },
                {
                    "id": "80110521",
                    "speaker": "Eide",
                    "text": "*pant* *pant* ...What just happened?"
                },
                {
                    "id": "80110522",
                    "speaker": "Eide",
                    "text": "When I saw that thing, my heart was instantly at peace... I—I was overcome by a sense of awe... or joy, perhaps."
                },
                {
                    "id": "80110523",
                    "speaker": "Player",
                    "text": "Are you alright now?"
                },
                {
                    "id": "80110524",
                    "speaker": "Eide",
                    "text": "I am... I feel good, in fact... I—I feel better than I did before I came in here. How peculiar..."
                },
                {
                    "id": "80110525",
                    "speaker": "Player",
                    "text": "Something's not right about this place. We need to get out of here."
                },
                {
                    "id": "80110526",
                    "speaker": "Eide",
                    "text": "Oh, i—is that so? Alright, as you wish."
                }
            ]
        },
