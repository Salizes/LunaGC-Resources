    "talks": [
        {
            "id": "1280101",
            "objective": "",
            "dialogues": [
                {
                    "id": "698310101",
                    "speaker": "Dori",
                    "text": "I see, I see... So no ninjutsu can disguise someone as a potion bottle after all..."
                },
                {
                    "id": "698310102",
                    "speaker": "Dori",
                    "text": "But think about it! A human-sized bottle... Now, wouldn't that be an eye-catching sight?"
                },
                {
                    "id": "698310103",
                    "speaker": "Sayu",
                    "text": "Really? But making a ninja gadget like that would take forever — and it'd be a real pain, too...",
                    "choices": [
                        {
                            "id": "698310104",
                            "text": "What are you trying to sell this time?",
                            "response": [
                                {
                                    "id": "698310106",
                                    "speaker": "Dori",
                                    "text": "#Ehhh!? {NICKNAME}!? Wh—What brings you here?"
                                },
                                {
                                    "id": "698310107",
                                    "speaker": "Player",
                                    "text": "Sayu, what's she pushing on you?"
                                },
                                {
                                    "id": "698310108",
                                    "speaker": "Sayu",
                                    "text": "Mm. I ran into Dori while I was shopping, and she dragged me into helping film an \"advertisement.\""
                                },
                                {
                                    "id": "698310109",
                                    "speaker": "Sayu",
                                    "text": "She talked so fast I couldn't even get a word in and bought me lots of snacks and drinks, so I've been listening to her talk this whole time."
                                },
                                {
                                    "id": "698310110",
                                    "speaker": "Dori",
                                    "text": "Hehe, this little potion is nothing less than the newest, most valuable treasure in Lord Sangemah Bay's portfolio!"
                                },
                                {
                                    "id": "698310111",
                                    "speaker": "Dori",
                                    "text": "Behold! Feast your eyes on the \"Ultra-Amazing Miracle Tonic Guaranteed to Make You Taller with Zero Effort!\""
                                },
                                {
                                    "id": "698310112",
                                    "speaker": "Player",
                                    "text": "The name's a \"guaranteed\" mouthful, never mind the potion..."
                                },
                                {
                                    "id": "698310113",
                                    "speaker": "Dori",
                                    "text": "C'mon, customers these days don't have the patience for in-depth pamphlets or detailed explanations!"
                                },
                                {
                                    "id": "698310114",
                                    "speaker": "Dori",
                                    "text": "So, I just crammed everything they need to know about the potion and its effects into the name. It's a bit long, sure, but it gets the point across loud and clear."
                                },
                                {
                                    "id": "698310115",
                                    "speaker": "Sayu",
                                    "text": "Sounds nice... But I don't have any Mora. The shrine maiden took all my allowance...",
                                    "choices": [
                                        {
                                            "id": "698310116",
                                            "text": "Huh? Why?",
                                            "response": [
                                                {
                                                    "id": "698310119",
                                                    "speaker": "Sayu",
                                                    "text": "I've never really understood budgeting, and always spent too fast... So by the end of the month, I never had anything left..."
                                                },
                                                {
                                                    "id": "698310120",
                                                    "speaker": "Sayu",
                                                    "text": "Once the shrine maiden found out, she insisted on helping me do an... audit. Then she sat me down and went through my expenses all night long..."
                                                },
                                                {
                                                    "id": "698310121",
                                                    "speaker": "Sayu",
                                                    "text": "Turns out, I keep buying random stuff, none of which I can actually use. My house is stuffed full of unopened Komaniya Express packages."
                                                },
                                                {
                                                    "id": "698310122",
                                                    "speaker": "Sayu",
                                                    "text": "She helped me go through them, and discovered five different types of height-boosting medicines, six kinds of nutritional supplements... and a whole bunch of different shoes and insoles..."
                                                },
                                                {
                                                    "id": "698310123",
                                                    "speaker": "Sayu",
                                                    "text": "So she said that starting this month, she'll manage my stipend. If I want to buy something, I have to ask her first. No more impulse buying."
                                                },
                                                {
                                                    "id": "698310124",
                                                    "speaker": "Dori",
                                                    "text": "*ahem* So, Miss Ninja... Hypothetically — and I do mean hypothetically — if you were to tell that kind shrine maiden you wished to purchase my potion...",
                                                    "choices": [
                                                        {
                                                            "id": "698310125",
                                                            "text": "She'd never approve the expense!",
                                                            "response": [
                                                                {
                                                                    "id": "698310127",
                                                                    "speaker": "Dori",
                                                                    "text": "#Please, {NICKNAME}! Such harsh language! Are you implying that I, Lord Sangemah Bay, am lying!?"
                                                                },
                                                                {
                                                                    "id": "698310128",
                                                                    "speaker": "Player",
                                                                    "text": "You probably aren't lying."
                                                                },
                                                                {
                                                                    "id": "698310129",
                                                                    "speaker": "Dori",
                                                                    "text": "But of course! In matters of business, would I ever..."
                                                                },
                                                                {
                                                                    "id": "698310130",
                                                                    "speaker": "Player",
                                                                    "text": "You just aren't telling the truth!"
                                                                },
                                                                {
                                                                    "id": "698310131",
                                                                    "speaker": "Dori",
                                                                    "text": "#{NICKNAME}! H—How could you! Is that really how you see me!? You know that I'm neither the largest nor fastest of felines...",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698310132",
                                                                            "text": "You're not a \"cheetah.\"",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698310135",
                                                                                    "speaker": "Dori",
                                                                                    "text": "#Gaaah! Living up to your name and fame, {NICKNAME}. To be so well-versed in such knowledge, you are well-traveled indeed...."
                                                                                },
                                                                                {
                                                                                    "id": "698310136",
                                                                                    "speaker": "Dori",
                                                                                    "text": "#Fine, forget it! Miss Ninja, since {NICKNAME} is your friend, allow me to make you a special offer."
                                                                                },
                                                                                {
                                                                                    "id": "698310137",
                                                                                    "speaker": "Dori",
                                                                                    "text": "#(Tch... She was about to buy, too! But with {NICKNAME} here and acting all familiar with Sayu, I can't mark it up...)"
                                                                                },
                                                                                {
                                                                                    "id": "698310138",
                                                                                    "speaker": "Dori",
                                                                                    "text": "As long as you're willing to help me make the ad, this potion... is on the house!"
                                                                                },
                                                                                {
                                                                                    "id": "698310139",
                                                                                    "speaker": "Dori",
                                                                                    "text": "(Yes! That's the ticket! Short-term loss, long-term profit! Once sales take off, I'll earn every Mora back a dozen times over!)"
                                                                                },
                                                                                {
                                                                                    "id": "698310140",
                                                                                    "speaker": "Dori",
                                                                                    "text": "During the production of the advertisement, all potions you consume shall be free of charge."
                                                                                },
                                                                                {
                                                                                    "id": "698310141",
                                                                                    "speaker": "Dori",
                                                                                    "text": "#And... and that's not all! {NICKNAME}, here, take this bottle! A free sample!",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698310142",
                                                                                            "text": "Did I just hear the word \"free\" escape your lips...?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698310144",
                                                                                                    "speaker": "Sayu",
                                                                                                    "text": "Really? But with my height... Can we really film an ad?"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698310145",
                                                                                                    "speaker": "Dori",
                                                                                                    "text": "Not to worry! When it comes to making an ad, height simply isn't a problem!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698310146",
                                                                                                    "speaker": "Dori",
                                                                                                    "text": "All you need to do is use your ninjutsu, and — poof! — turn yourself into a potion bottle, and then burst open with another big poof!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698310147",
                                                                                                    "speaker": "Dori",
                                                                                                    "text": "And then, potion bottles will come raining down from the sky... Now that'll wow audiences for sure."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698310148",
                                                                                                    "speaker": "Sayu",
                                                                                                    "text": "Uh... um... I can't do that with my ninjutsu..."
                                                                                                },
                                                                                                {
                                                                                                    "id": "698310149",
                                                                                                    "speaker": "Dori",
                                                                                                    "text": "No problem! I managed to hire a magician from Fontaine to help. We'll film the ad together, and soon, it'll be seen across Teyvat!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "698310150",
                                                                                                    "speaker": "Sayu",
                                                                                                    "text": "Then I need to go ask for some time off... I've been working so hard lately, she'll definitely approve it..."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698310143",
                                                                                            "text": "Unbelievable..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698310133",
                                                                            "text": "And aren't \"lion.\""
                                                                        },
                                                                        {
                                                                            "id": "698310134",
                                                                            "text": "Don't even think about using corny jokes to weasel out of this!"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698310126",
                                                            "text": "Who'd let Sayu buy that kinda potion!?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698310117",
                                            "text": "What!? That's wage theft!",
                                            "response": [
                                                {
                                                    "id": "698310118",
                                                    "speaker": "Sayu",
                                                    "text": "No, not at all. It's just for safekeeping. If I need money, I can ask her for it."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698310105",
                            "text": "What scheme are you cooking up this time?"
                        }
                    ]
                }
            ]
        }
    ]
}