    "talks": [
        {
            "id": "2210401",
            "objective": "Talk to Verr Goldet",
            "dialogues": [
                {
                    "id": "221040101",
                    "speaker": "Verr Goldet",
                    "text": "This is getting so stressful..."
                },
                {
                    "id": "221040102",
                    "speaker": "Player",
                    "text": "What's wrong?"
                },
                {
                    "id": "221040103",
                    "speaker": "Verr Goldet",
                    "text": "Oh, my apologies! When did you get here?"
                },
                {
                    "id": "221040104",
                    "speaker": "Verr Goldet",
                    "text": "The monster presence in this area is steadily growing, and although my husband insists they wouldn't dare set foot in the inn..."
                },
                {
                    "id": "221040105",
                    "speaker": "Verr Goldet",
                    "text": "He's the only one sufficiently prepared to fight back if they ever did. That concerns me a little."
                },
                {
                    "id": "221040106",
                    "speaker": "Verr Goldet",
                    "text": "If you can spare the time, could you secure the surrounding area for me?",
                    "choices": [
                        {
                            "id": "221040107",
                            "text": "Okay.",
                            "response": [
                                {
                                    "id": "221040109",
                                    "speaker": "Verr Goldet",
                                    "text": "You have my gratitude."
                                },
                                {
                                    "id": "221040113",
                                    "speaker": "Verr Goldet",
                                    "text": "I am grateful for your help. You will be adequately compensated."
                                }
                            ]
                        },
                        {
                            "id": "221040108",
                            "text": "What is it about this inn...",
                            "response": [
                                {
                                    "id": "221040110",
                                    "speaker": "Verr Goldet",
                                    "text": "Huh? There's nothing out-of-the-ordinary about the inn. It's just a little out of the way and sees a lot of traffic."
                                },
                                {
                                    "id": "221040111",
                                    "speaker": "Verr Goldet",
                                    "text": "But it's worthwhile. Travelers braving the wilderness need somewhere to get a good night's sleep and eat a proper meal."
                                },
                                {
                                    "id": "221040112",
                                    "speaker": "Verr Goldet",
                                    "text": "That's what my husband and I think, anyway. It's the simple truth."
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210402",
            "objective": "Go and check the suspicious location",
            "dialogues": [
                {
                    "id": "221040201",
                    "speaker": "Verr Goldet",
                    "text": "Is it done?"
                },
                {
                    "id": "221040202",
                    "speaker": "Player",
                    "text": "Not yet."
                },
                {
                    "id": "221040203",
                    "speaker": "Verr Goldet",
                    "text": "Take your time... And please, be careful. Something about this area just makes me uneasy."
                }
            ]
        },
        {
            "id": "2210403",
            "objective": "Defeat all opponents",
            "dialogues": [
                {
                    "id": "221040301",
                    "speaker": "Verr Goldet",
                    "text": "Is it done?"
                },
                {
                    "id": "221040302",
                    "speaker": "Player",
                    "text": "Yes."
                },
                {
                    "id": "221040303",
                    "speaker": "Verr Goldet",
                    "text": "Wonderful. I think we can all afford to relax now."
                },
                {
                    "id": "221040304",
                    "speaker": "Verr Goldet",
                    "text": "As promised — compensation for your trouble."
                }
            ]
        },
        {
