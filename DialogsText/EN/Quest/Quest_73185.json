        {
            "id": "7318501",
            "objective": "Rescue the person surrounded by monsters",
            "dialogues": [
                {
                    "id": "731850101",
                    "speaker": "Elber",
                    "text": "Whew. Thanks, Traveler...",
                    "choices": [
                        {
                            "id": "731850102",
                            "text": "It's good to see they're alright.",
                            "response": [
                                {
                                    "id": "731850104",
                                    "speaker": "Elber",
                                    "text": "I'm Elber, a businessman. I was just relaxing here..."
                                },
                                {
                                    "id": "731850105",
                                    "speaker": "Elber",
                                    "text": "I never expected to get attacked by those hilichurls...",
                                    "choices": [
                                        {
                                            "id": "731850106",
                                            "text": "Didn't you have any guard with you?",
                                            "response": [
                                                {
                                                    "id": "731850108",
                                                    "speaker": "Paimon",
                                                    "text": "We have heard in town that normally merchants would hire the Eremites to escort their goods."
                                                },
                                                {
                                                    "id": "731850109",
                                                    "speaker": "Elber",
                                                    "text": "Well, that costs you Mora..."
                                                },
                                                {
                                                    "id": "731850110",
                                                    "speaker": "Elber",
                                                    "text": "The prices they asked for were just astronomical."
                                                },
                                                {
                                                    "id": "731850111",
                                                    "speaker": "Elber",
                                                    "text": "I'm running a small business. Can't afford that kind of price..."
                                                },
                                                {
                                                    "id": "731850112",
                                                    "speaker": "Elber",
                                                    "text": "I thought, well, I know a thing or two about fighting monsters anyway, and it's not a long haul, so I might as well go on my own."
                                                },
                                                {
                                                    "id": "731850113",
                                                    "speaker": "Elber",
                                                    "text": "But I didn't expect the hilichurls to spook my two Sumpter Beasts."
                                                },
                                                {
                                                    "id": "731850114",
                                                    "speaker": "Elber",
                                                    "text": "I was run down by one before I could even react, and when I came to my feet, I got kicked by the other one."
                                                },
                                                {
                                                    "id": "731850115",
                                                    "speaker": "Paimon",
                                                    "text": "Uh-oh..."
                                                },
                                                {
                                                    "id": "731850116",
                                                    "speaker": "Elber",
                                                    "text": "They soon ran away, and I was besieged by the hilichurls... Lucky for me, you were here to help."
                                                },
                                                {
                                                    "id": "731850117",
                                                    "speaker": "Elber",
                                                    "text": "But all my stuff is on those two Sumpter Beasts... Traveler, could you please help bring them back for me?",
                                                    "choices": [
                                                        {
                                                            "id": "731850118",
                                                            "text": "I don't want to get kicked...",
                                                            "response": [
                                                                {
                                                                    "id": "731850120",
                                                                    "speaker": "Elber",
                                                                    "text": "Don't worry. They are gentle in nature, it's just those hilichurls knocked over their food."
                                                                },
                                                                {
                                                                    "id": "731850121",
                                                                    "speaker": "Elber",
                                                                    "text": "They had traveled so far with the loads and were very hungry. That's why they got so restive after their food was knocked over..."
                                                                },
                                                                {
                                                                    "id": "731850122",
                                                                    "speaker": "Paimon",
                                                                    "text": "So they were disrupted when eating and their food was messed up..."
                                                                },
                                                                {
                                                                    "id": "731850123",
                                                                    "speaker": "Paimon",
                                                                    "text": "Ugh... Paimon is getting angry just thinking about that!"
                                                                },
                                                                {
                                                                    "id": "731850124",
                                                                    "speaker": "Player",
                                                                    "text": "You are quick to catch on to that, Paimon."
                                                                },
                                                                {
                                                                    "id": "731850125",
                                                                    "speaker": "Elber",
                                                                    "text": "Well, I'll just leave the food to you."
                                                                },
                                                                {
                                                                    "id": "731850126",
                                                                    "speaker": "Elber",
                                                                    "text": "Please feed the Sumpter Beasts when you find them."
                                                                },
                                                                {
                                                                    "id": "731850127",
                                                                    "speaker": "Elber",
                                                                    "text": "They won't throw tantrums as long as there's food."
                                                                },
                                                                {
                                                                    "id": "731850128",
                                                                    "speaker": "Elber",
                                                                    "text": "I noticed one of them knocked over the hilichurls and ran away..."
                                                                },
                                                                {
                                                                    "id": "731850129",
                                                                    "speaker": "Elber",
                                                                    "text": "The other one seems to have been taken away by the hilichurls."
                                                                },
                                                                {
                                                                    "id": "731850130",
                                                                    "speaker": "Elber",
                                                                    "text": "I'll mark their locations roughly and leave the rest to you, Traveler."
                                                                },
                                                                {
                                                                    "id": "731850131",
                                                                    "speaker": "Elber",
                                                                    "text": "You'll be fairly paid for the return of my goods!"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731850119",
                                                            "text": "They could knock me over..."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731850107",
                                            "text": "No one was protecting you?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731850103",
                            "text": "It was nothing."
                        }
                    ]
                }
            ]
        },
