        {
            "id": "7318504",
            "objective": "Defeat all the hilichurls",
            "dialogues": [
                {
                    "id": "731850401",
                    "speaker": "Paimon",
                    "text": "Whoa! This Sumpter Beast is huge. It must hurt so bad getting kicked by it."
                },
                {
                    "id": "731850402",
                    "speaker": "Paimon",
                    "text": "Feed it with the food Mr. Elber gave us."
                },
                {
                    "id": "731850403",
                    "speaker": "Player",
                    "text": "Nice and slow..."
                },
                {
                    "id": "731850404",
                    "speaker": "Player",
                    "text": "Are these enough for it...?"
                },
                {
                    "id": "731850405",
                    "speaker": "Paimon",
                    "text": "It seems to be in a good mood."
                },
                {
                    "id": "731850406",
                    "speaker": "Paimon",
                    "text": "Let's bring it back."
                },
                {
                    "id": "731850407",
                    "speaker": "Black Screen",
                    "text": "You go back to Elber with the Sumpter Beast..."
                },
                {
                    "id": "731850408",
                    "speaker": "Black Screen",
                    "text": "The Sumpter Beast gulps down the food. It seems to be in a better mood now..."
                },
                {
                    "id": "731850409",
                    "speaker": "Elber",
                    "text": "Whew... I thought I'd lost it."
                },
                {
                    "id": "731850410",
                    "speaker": "Elber",
                    "text": "Thank you, Traveler. I can't express my gratitude enough."
                },
                {
                    "id": "731850411",
                    "speaker": "Elber",
                    "text": "I must check its condition now. Hope it wasn't hurt..."
                },
                {
                    "id": "731850412",
                    "speaker": "Elber",
                    "text": "Traveler, please help me find the other Sumpter Beast."
                },
                {
                    "id": "731850413",
                    "speaker": "Elber",
                    "text": "You got my two Sumpter Beasts back! Thank you so much, Traveler!"
                },
                {
                    "id": "731850414",
                    "speaker": "Elber",
                    "text": "I'll return to the city as soon as I have my goods in order."
                },
                {
                    "id": "731850415",
                    "speaker": "Elber",
                    "text": "*sigh* I'll make sure to hire some escorts next time..."
                },
                {
                    "id": "731850416",
                    "speaker": "Player",
                    "text": "About the picked-up goods"
                }
            ]
        },
