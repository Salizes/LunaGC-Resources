    "talks": [
        {
            "id": "7509402",
            "objective": "Investigate the hidden chamber",
            "dialogues": [
                {
                    "id": "751260601",
                    "speaker": "Paimon",
                    "text": "To think that these things happened... Milchi, and the person who left these notes behind... Everyone was so brave..."
                },
                {
                    "id": "751260602",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr!"
                },
                {
                    "id": "751260603",
                    "speaker": "Paimon",
                    "text": "This is... This is that hibernating Saurian egg mentioned in those notes!"
                },
                {
                    "id": "751260604",
                    "speaker": "Paimon",
                    "text": "#Are you trying to say that we should use the incubator to hatch it, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                },
                {
                    "id": "751260605",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "Rawr! Rawr!"
                },
                {
                    "id": "751260606",
                    "speaker": "Paimon",
                    "text": "Hmm, the egg does look like it's in good shape, and there's a manual for the incubator. Let's give it a try, shall we?",
                    "choices": [
                        {
                            "id": "751260607",
                            "text": "No clue if it'll work, but we can give it a go.",
                            "response": [
                                {
                                    "id": "751260609",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr!"
                                }
                            ]
                        },
                        {
                            "id": "751260608",
                            "text": "Nice, looks like our little buddy's about to meet a new friend!"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509405",
            "objective": "Investigate the hidden chamber",
            "dialogues": []
        },
        {
            "id": "7509404",
            "objective": "Investigate the hidden chamber",
            "dialogues": []
        },
        {
            "id": "7509406",
            "objective": "Activate the incubator",
            "dialogues": [
                {
                    "id": "750940601",
                    "speaker": "Paimon",
                    "text": "Whew... That sure was scary, with those monsters attacking out of nowhere like that. Good thing we're super strong, huh?",
                    "choices": [
                        {
                            "id": "750940602",
                            "text": "Guess I'll be counting on you next time, Paimon.",
                            "response": [
                                {
                                    "id": "750940603",
                                    "speaker": "Paimon",
                                    "text": "Huh? No no no, Paimon can't do that! Who'd want to fight those scary monsters, anyway!?"
                                },
                                {
                                    "id": "750940606",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Rawr! Rawr!"
                                },
                                {
                                    "id": "750940607",
                                    "speaker": "Paimon",
                                    "text": "Heh, looks like he's getting anxious already. Let's just find a way to hatch the egg first!"
                                },
                                {
                                    "id": "750940608",
                                    "speaker": "Player",
                                    "text": "Activate the incubator."
                                },
                                {
                                    "id": "750940609",
                                    "speaker": "Black Screen",
                                    "text": "The incubator is back in action...\\nAll you need to do now is wait...\\nHours pass, but nothing happens to the Saurian egg. It doesn't change at all..."
                                },
                                {
                                    "id": "750940610",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "Err... Errh?"
                                },
                                {
                                    "id": "750940611",
                                    "speaker": "Paimon",
                                    "text": "Weird. Nothing seems to have happened. Have we messed something up? Let's try again!",
                                    "choices": [
                                        {
                                            "id": "750940612",
                                            "text": "Let's try again...",
                                            "response": [
                                                {
                                                    "id": "750940613",
                                                    "speaker": "Black Screen",
                                                    "text": "You reboot the incubator as the instructions indicate...\\nBut just as with your previous attempt, nothing happens to the Saurian egg..."
                                                },
                                                {
                                                    "id": "750940614",
                                                    "speaker": "Paimon",
                                                    "text": "Aw... How long do we need to wait? Paimon's zoning out over here... Also, she's getting dizzy... and hungry..."
                                                },
                                                {
                                                    "id": "750940615",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "Rrah... Grgh..."
                                                },
                                                {
                                                    "id": "750940616",
                                                    "speaker": "Paimon",
                                                    "text": "Huh!? Wait! Wait! It moved!",
                                                    "choices": [
                                                        {
                                                            "id": "750940617",
                                                            "text": "Let's wait a little longer, shall we?",
                                                            "response": [
                                                                {
                                                                    "id": "750940618",
                                                                    "speaker": "Black Screen",
                                                                    "text": "After a long while...\\nThe Saurian egg remains unchanged. No reaction, no sign of hatching."
                                                                },
                                                                {
                                                                    "id": "750940619",
                                                                    "speaker": "Paimon",
                                                                    "text": "Still nothing... Could this incubator be broken? But its lights are on! Hmm. Is the problem with the egg, then?"
                                                                },
                                                                {
                                                                    "id": "750940620",
                                                                    "speaker": "Paimon",
                                                                    "text": "...Hmm, waiting around doesn't seem like it'll help... Should we just take the egg with us?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "750940621",
                                                                            "text": "No matter how hungry you get, don't even think about eating it, alright...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750940622",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "Wraah! Wraah!"
                                                                                },
                                                                                {
                                                                                    "id": "750940623",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Come on, of course not! Also, don't give {REALNAME[ID(2)|SHOWHOST(true)]} any strange ideas!"
                                                                                },
                                                                                {
                                                                                    "id": "750940626",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Well, little fella, Paimon means that... if the problem's with the egg, it might never..."
                                                                                },
                                                                                {
                                                                                    "id": "750940634",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "Rroo..."
                                                                                },
                                                                                {
                                                                                    "id": "750940635",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "#Don't be sad, {REALNAME[ID(2)|SHOWHOST(true)]}. There's nothing we can do about it...",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "750940636",
                                                                                            "text": "Perhaps the environment here isn't suitable...",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "750940638",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "Y'know, you're right! Maybe the egg isn't hatching because it thinks Natlan hasn't changed and isn't suited to be its home!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940639",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "After all, it's been hiding inside here for so long, right? Of course it doesn't know what a wonderful place Natlan's become!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940640",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "So, let's take it back and take good care of it! We'll tell it stories about beautiful landscapes, thrilling adventures, and all the wonderful people we've met — every single day!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940641",
                                                                                                    "speaker": "Paimon",
                                                                                                    "text": "In short, we'll let it know how great Natlan is now! Once it gets excited enough, it'll surely hatch on its own!"
                                                                                                },
                                                                                                {
                                                                                                    "id": "750940642",
                                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                                    "text": "...Brwarh."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "750940637",
                                                                                            "text": "Or perhaps... the egg doesn't believe that this is the right time..."
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "750940624",
                                                                            "text": "#What do you think, {REALNAME[ID(2)|SHOWHOST(true)]}?",
                                                                            "response": [
                                                                                {
                                                                                    "id": "750940625",
                                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                                    "text": "Err... Errh?"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750940627",
                                                            "text": "No, it didn't.",
                                                            "response": [
                                                                {
                                                                    "id": "750940628",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Huh!? But... Just now... Was Paimon imagining things? No, it can't be. Did you see that, {REALNAME[ID(2)|SHOWHOST(true)]}?"
                                                                },
                                                                {
                                                                    "id": "750940629",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "Err... Errh?"
                                                                },
                                                                {
                                                                    "id": "750940630",
                                                                    "speaker": "Paimon",
                                                                    "text": "#Ah... So you didn't see it either? Was it really just Paimon's imagination, then? So, what do we do, {NICKNAME}? Are we gonna just wait?"
                                                                },
                                                                {
                                                                    "id": "750940631",
                                                                    "speaker": "Paimon",
                                                                    "text": "Or... could the problem be with the egg? B—But, if that's the case, does that mean it'll never hatch?"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750940632",
                                            "text": "The egg itself might be the issue here.",
                                            "response": [
                                                {
                                                    "id": "750940633",
                                                    "speaker": "Paimon",
                                                    "text": "Huh? So, does... does this mean that it might never hatch?"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750940604",
                            "text": "Hmph, is that all they've got?",
                            "response": [
                                {
                                    "id": "750940605",
                                    "speaker": "Paimon",
                                    "text": "Exactly! You'd think they'd be super strong with how scary they looked! But really, our little fella hits harder than they do!"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
