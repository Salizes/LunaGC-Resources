        },
        {
            "id": "7452703",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745270301",
                    "speaker": "Player",
                    "text": "Give me a second, I'm considering my options."
                }
            ]
        },
        {
            "id": "7452704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "745270401",
                    "speaker": "Escoffier",
                    "text": "#Ah, it's you, {NICKNAME}.",
                    "choices": [
                        {
                            "id": "745270402",
                            "text": "It's been a while, Escoffier.",
                            "response": [
                                {
                                    "id": "745270404",
                                    "speaker": "Escoffier",
                                    "text": "I'm not heading up the kitchen today. I'm here as a taste-tester."
                                },
                                {
                                    "id": "745270405",
                                    "speaker": "Escoffier",
                                    "text": "Savanna's trying to come up with something new, and has asked me to check on her. That said, this is... the fifth take on the same dish so far."
                                },
                                {
                                    "id": "745270406",
                                    "speaker": "Escoffier",
                                    "text": "If it's not the texture of the ingredients being affected by a few seconds' disparity in temperature control, then it's the aroma of the spices used dominating due to over-seasoning."
                                },
                                {
                                    "id": "745270407",
                                    "speaker": "Player",
                                    "text": "You're as exacting as ever, I see."
                                },
                                {
                                    "id": "745270408",
                                    "speaker": "Escoffier",
                                    "text": "Of course! Cooking is a science, and our friendship isn't going to change that. In fact, our friendship and our duty to our customers demand that I be strict.",
                                    "choices": [
                                        {
                                            "id": "745270409",
                                            "text": "I do actually have a small request...",
                                            "response": [
                                                {
                                                    "id": "745270411",
                                                    "speaker": "Escoffier",
                                                    "text": "...At a time like this? If the pictures are going up for public display, might I suggest finding another moment?"
                                                },
                                                {
                                                    "id": "745270412",
                                                    "speaker": "Escoffier",
                                                    "text": "We need to put the set together with care, and carefully adjust the lighting and angle for the best possible results...",
                                                    "choices": [
                                                        {
                                                            "id": "745270413",
                                                            "text": "I'm just taking a commemorative photo.",
                                                            "response": [
                                                                {
                                                                    "id": "745270415",
                                                                    "speaker": "Escoffier",
                                                                    "text": "...Alright. There's a bit of time before the sixth redo, anyway."
                                                                },
                                                                {
                                                                    "id": "745270416",
                                                                    "speaker": "Escoffier",
                                                                    "text": "In that case, let's see whether your lens or that new dish will come out on top."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745270414",
                                                            "text": "I'm also looking to test out this new lens."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745270410",
                                            "text": "Would you mind if I took a picture of you, then?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745270403",
                            "text": "Are you cooking up an all-new recipe?"
                        }
                    ]
                }
            ]
        }
    ]
