            "dialogues": [
                {
                    "id": "761160101",
                    "speaker": "Anezka",
                    "text": "Hey, if it isn't our — and Bobik's — lifelong friends!",
                    "choices": [
                        {
                            "id": "761160102",
                            "text": "So, what are your plans...",
                            "response": [
                                {
                                    "id": "761160103",
                                    "speaker": "Anezka",
                                    "text": "We'll remain here for a while yet. I mean, Drzislav's lab door has been breached, so we've gotta remain in the vicinity to prevent those villains from finding their way in!"
                                },
                                {
                                    "id": "761160104",
                                    "speaker": "Anezka",
                                    "text": "Once we've fixed the door, or once Slava gets back, we'll most likely take a page outta your book and go traveling with Bobik!"
                                }
                            ]
                        },
                        {
                            "id": "761160105",
                            "text": "So, about Drzislav...",
                            "response": [
                                {
                                    "id": "761160106",
                                    "speaker": "Anezka",
                                    "text": "I've no idea where he might be... But if you do meet him in your travels, do say hi to him on our behalf!"
                                },
                                {
                                    "id": "761160107",
                                    "speaker": "Anezka",
                                    "text": "I'd love to stay up and drink all night at The Flagship with him again!"
                                }
                            ]
                        },
                        {
                            "id": "761160108",
                            "text": "So, how's Bobik doing...",
                            "response": [
                                {
                                    "id": "761160109",
                                    "speaker": "Anezka",
                                    "text": "Ooh, miss him already, do ya? Don't worry, just come over whenever you're free, and you can play with him!"
                                }
                            ]
                        },
                        {
                            "id": "761160110",
                            "text": "See you around.",
                            "response": [
                                {
                                    "id": "761160111",
                                    "speaker": "Anezka",
                                    "text": "Yup. Don't worry, we'll certainly meet again. We're best friends who've stuck with one another through thick and thin, after all!"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
