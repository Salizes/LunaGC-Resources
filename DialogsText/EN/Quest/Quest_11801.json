    "talks": [
        {
            "id": "1180101",
            "objective": "",
            "dialogues": [
                {
                    "id": "698350101",
                    "speaker": "Kamisato Ayato",
                    "text": "...This style has a certain lighthearted charm. I believe Ayaka would find it pleasing."
                },
                {
                    "id": "698350102",
                    "speaker": "Player",
                    "text": "Doing some clothing shopping, Ayato?"
                },
                {
                    "id": "698350103",
                    "speaker": "Kamisato Ayato",
                    "text": "#Now, this is a fortuitous encounter, {NICKNAME}. I had previously pre-ordered a batch of fabrics from Ogura's, and they would typically be delivered to the Kamisato Estate for us to make our selection."
                },
                {
                    "id": "698350104",
                    "speaker": "Kamisato Ayato",
                    "text": "However, as I was already at Tenshukaku today for discussions with Her Excellency, the Almighty Shogun, I thought I might as well stop by and review them in person.",
                    "choices": [
                        {
                            "id": "698350105",
                            "text": "So, you choose the fabrics personally...",
                            "response": [
                                {
                                    "id": "698350107",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Were these meant for ordinary use, then they would naturally be handled by the relevant staff."
                                },
                                {
                                    "id": "698350108",
                                    "speaker": "Kamisato Ayato",
                                    "text": "However, consideration for attire used in official functions begins with the fabric and colors. These I often see to personally."
                                },
                                {
                                    "id": "698350109",
                                    "speaker": "Kamisato Ayato",
                                    "text": "After all... Given the Kamisato Clan's role within the Yashiro Commission, overseeing cultural and civil matters, even minor choices regarding textile patterns draw public scrutiny."
                                },
                                {
                                    "id": "698350110",
                                    "speaker": "Kamisato Ayato",
                                    "text": "Many merchants market their products using \"Yashiro Commission-approved\" labels after our annual procurements."
                                },
                                {
                                    "id": "698350111",
                                    "speaker": "Kamisato Ayato",
                                    "text": "I did once delegate the task, but... vendors rushed to offer my representative bribes, heh, and the temptation proved too much for him... It was no small matter to resolve."
                                },
                                {
                                    "id": "698350112",
                                    "speaker": "Kamisato Ayato",
                                    "text": "I have personally overseen such matters since. A stitch in time saves nine.",
                                    "choices": [
                                        {
                                            "id": "698350113",
                                            "text": "That sounds... exhausting.",
                                            "response": [
                                                {
                                                    "id": "698350115",
                                                    "speaker": "Kamisato Ayato",
                                                    "text": "Heh. The Yashiro Commission's duties are never simple. I've grown accustomed to it."
                                                },
                                                {
                                                    "id": "698350116",
                                                    "speaker": "Kamisato Ayato",
                                                    "text": "#I've already narrowed it down to two candidates, yet I find myself hesitating between them... {NICKNAME}, would you lend me your judgment?",
                                                    "choices": [
                                                        {
                                                            "id": "698350117",
                                                            "text": "Err, this is pretty important...",
                                                            "response": [
                                                                {
                                                                    "id": "698350119",
                                                                    "speaker": "Kamisato Ayato",
                                                                    "text": "You are one of our most esteemed guests. More importantly, you're Ayaka's close friend. Rather than being merely okay, I would say none are better suited."
                                                                },
                                                                {
                                                                    "id": "698350120",
                                                                    "speaker": "Kamisato Ayato",
                                                                    "text": "In any case, your bearing and sophistication assure me of your excellent taste in fabrics.",
                                                                    "choices": [
                                                                        {
                                                                            "id": "698350121",
                                                                            "text": "Then... I pick the one on the left.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "698350123",
                                                                                    "speaker": "Kamisato Ayato",
                                                                                    "text": "Mm. A fine choice. Excuse me, this is the one. Please bundle five bolts for delivery to the Kamisato estate."
                                                                                },
                                                                                {
                                                                                    "id": "698350124",
                                                                                    "speaker": "Kamisato Ayato",
                                                                                    "text": "My gratitude. It was quite the dilemma."
                                                                                },
                                                                                {
                                                                                    "id": "698350125",
                                                                                    "speaker": "Kamisato Ayato",
                                                                                    "text": "I still have a few other matters to attend to. Once the garments are ready, please do visit our estate.",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "698350126",
                                                                                            "text": "I'll be there.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698350129",
                                                                                                    "speaker": "Kamisato Ayato",
                                                                                                    "text": "#Farewell for now, {NICKNAME}. Until our next meeting."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "698350127",
                                                                                            "text": "I hope the clothes turn out beautifully.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "698350128",
                                                                                                    "speaker": "Kamisato Ayato",
                                                                                                    "text": "With the quality fabric you selected, their beauty is assured."
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "698350122",
                                                                            "text": "Then... I pick the one on the right."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "698350118",
                                                            "text": "Are you sure it's okay for me to choose...?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "698350114",
                                            "text": "I never realized clothing could be so complicated..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "698350106",
                            "text": "Here I thought you'd have one of your subordinates do that for you."
                        }
                    ]
                }
            ]
        }
    ]
}