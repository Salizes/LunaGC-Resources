                    "text": "..."
                },
                {
                    "id": "752520103",
                    "speaker": "Icahua",
                    "text": "Is something the matter?"
                },
                {
                    "id": "752520109",
                    "speaker": "Player",
                    "text": "Your hairstyle is really striking."
                },
                {
                    "id": "752520104",
                    "speaker": "Icahua",
                    "text": "Thanks. But I'm busy, so please don't stand around here."
                },
                {
                    "id": "752520110",
                    "speaker": "Player",
                    "text": "What are you working on?"
                },
                {
                    "id": "752520105",
                    "speaker": "Icahua",
                    "text": "You don't need to know."
                },
                {
                    "id": "752520106",
                    "speaker": "Icahua",
                    "text": "..."
                },
                {
                    "id": "752520107",
                    "speaker": "Icahua",
                    "text": "Why are you still here?"
                }
            ]
        },
        {
            "id": "7525205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "752520501",
                    "speaker": "Player",
                    "text": "Who are you?"
                },
                {
                    "id": "752520502",
