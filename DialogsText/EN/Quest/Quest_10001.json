    "talks": [
        {
            "id": "100010",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001001",
                    "speaker": "Yujing Terrace Infiltration AI1",
                    "text": "Someone assassinated Rex Lapis! You'd be wise to cooperate with our investigation."
                },
                {
                    "id": "10001002",
                    "speaker": "Yujing Terrace Infiltration AI2",
                    "text": "Who would harm Rex Lapis!? I don't believe it!"
                },
                {
                    "id": "10001003",
                    "speaker": "Yujing Terrace Infiltration AI3",
                    "text": "Just what exactly happened!?"
                },
                {
                    "id": "10001004",
                    "speaker": "Yujing Terrace Infiltration AI4",
                    "text": "In broad daylight! What kind of dark magic is this?"
                },
                {
                    "id": "10001021",
                    "speaker": "Crowd",
                    "text": "I... I know nothing, I swear..."
                },
                {
                    "id": "10001022",
                    "speaker": "Crowd",
                    "text": "The smoke, it's too thick. I can't see..."
                },
                {
                    "id": "10001023",
                    "speaker": "Crowd",
                    "text": "I didn't do it! Please, have mercy!"
                },
                {
                    "id": "10001024",
                    "speaker": "Crowd",
                    "text": "Rex Lapis... Rex Lapis... How..."
                },
                {
                    "id": "10001051",
                    "speaker": "Paimon",
                    "text": "This spot is no good, it's too obvious..."
                }
            ]
        },
        {
            "id": "100012",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001201",
                    "speaker": "Yujing Terrace Infiltration AI1",
                    "text": "There's nowhere to run!"
                },
                {
                    "id": "10001202",
                    "speaker": "Childe",
                    "text": "#Hey {M#buddy}{F#girlie}— Hold still."
                },
                {
                    "id": "10001203",
                    "speaker": "Player",
                    "text": "Huh?"
                },
                {
                    "id": "10001204",
                    "speaker": "Childe",
                    "text": "Come with me."
                },
                {
                    "id": "10001205",
                    "speaker": "Yujing Terrace Infiltration AI1",
                    "text": "There they are!"
                },
                {
                    "id": "10001206",
                    "speaker": "Yujing Terrace Infiltration AI1",
                    "text": "Seize them!"
                },
                {
                    "id": "10001207",
                    "speaker": "Yujing Terrace Infiltration AI1",
                    "text": "Stop! Stop!"
                }
            ]
        },
        {
            "id": "100015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "10001521",
                    "speaker": "Paimon",
                    "text": "#Oh no... {NICKNAME}, there's a whole bunch of soldiers out there too!"
                },
                {
                    "id": "10001522",
                    "speaker": "Paimon",
                    "text": "Your identity... You may not be the killer, but we can't let them get you!"
                },
                {
                    "id": "10001523",
                    "speaker": "Paimon",
                    "text": "But... can we even get out of here safely?"
                }
            ]
        }
