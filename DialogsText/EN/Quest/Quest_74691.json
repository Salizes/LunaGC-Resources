    "talks": [
        {
            "id": "7469101",
            "objective": "Take a little walk around...",
            "dialogues": [
                {
                    "id": "746910101",
                    "speaker": "Paimon",
                    "text": "...What!? I—Is Paimon seeing things? Is that... a Dodoco?",
                    "choices": [
                        {
                            "id": "746910102",
                            "text": "Paimon, we're in Fontaine.",
                            "response": [
                                {
                                    "id": "746910104",
                                    "speaker": "Paimon",
                                    "text": "N—No! There really is a Dodoco over there, and it looks just like... It looks like Barbeloth!",
                                    "choices": [
                                        {
                                            "id": "746910105",
                                            "text": "Oh, great...",
                                            "response": [
                                                {
                                                    "id": "746910107",
                                                    "speaker": "Barbeloth",
                                                    "text": "#Oh my, what a coincidence this is. {NICKNAME}, Paimon."
                                                },
                                                {
                                                    "id": "746910108",
                                                    "speaker": "Paimon",
                                                    "text": "Why's there something so fishy about hearing such a powerful fortune teller use the word \"coincidence\"..."
                                                },
                                                {
                                                    "id": "746910109",
                                                    "speaker": "Barbeloth",
                                                    "text": "Perhaps, but it's no lie. This truly is a pleasant surprise."
                                                },
                                                {
                                                    "id": "746910110",
                                                    "speaker": "Barbeloth",
                                                    "text": "#As a Descender from beyond this world, {NICKNAME}'s fate is not anchored in Teyvat."
                                                },
                                                {
                                                    "id": "746910111",
                                                    "speaker": "Barbeloth",
                                                    "text": "Hence why most Fortune Tellers, including myself, are unable to predict your future."
                                                },
                                                {
                                                    "id": "746910112",
                                                    "speaker": "Barbeloth",
                                                    "text": "But happily, this particular coincidence couldn't have been any more fortuitous. I recently happened to glimpse a peculiar omen."
                                                },
                                                {
                                                    "id": "746910113",
                                                    "speaker": "Barbeloth",
                                                    "text": "And since I had some free time, I decided to perform a brief divination and follow the omen's course... just for a spot of fun, you understand."
                                                },
                                                {
                                                    "id": "746910114",
                                                    "speaker": "Barbeloth",
                                                    "text": "Oh, yes — and while I was following this omen, I caught a few ethereal threads of fate and glimpsed the faces of their owners. Here, take a look for yourselves."
                                                },
                                                {
                                                    "id": "746910115",
                                                    "speaker": "Player",
                                                    "text": "These are all people we know..."
                                                },
                                                {
                                                    "id": "746910116",
                                                    "speaker": "Barbeloth...?",
                                                    "text": "See? Didn't I tell you? Someone with so many friends was bound to recognize them all.",
                                                    "choices": [
                                                        {
                                                            "id": "746910117",
                                                            "text": "I know that voice...",
                                                            "response": [
                                                                {
                                                                    "id": "746910119",
                                                                    "speaker": "Alice",
                                                                    "text": "Hi, you two! It's been a while, hasn't it? I thought I'd lend a hand with Barbie's divination."
                                                                },
                                                                {
                                                                    "id": "746910120",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Indeed, if Alice hadn't insisted, I'd have treated these names as minor variables and discarded them from the divination."
                                                                },
                                                                {
                                                                    "id": "746910121",
                                                                    "speaker": "Alice",
                                                                    "text": "But then you would have missed out on this fun little excursion, wouldn't you?"
                                                                },
                                                                {
                                                                    "id": "746910122",
                                                                    "speaker": "Alice",
                                                                    "text": "Besides, as mages, we couldn't possibly disappoint the little cuties involved in the prophecy, now could we?"
                                                                },
                                                                {
                                                                    "id": "746910123",
                                                                    "speaker": "Alice",
                                                                    "text": "It's the dream of every child to receive wonderful gifts, go on grand undertakings, and watch mysterious prophecies unfold... Which is all to say, we simply had to see this one through!"
                                                                },
                                                                {
                                                                    "id": "746910124",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "...And there's no point arguing with Alice. Anyway, if I can gather these minor variables together, I should be able to adjust my divination."
                                                                },
                                                                {
                                                                    "id": "746910125",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "So here I am, seeking them out — and, if possible, offering them a little fortune telling."
                                                                },
                                                                {
                                                                    "id": "746910126",
                                                                    "speaker": "Player",
                                                                    "text": "Uhm... So, when will they be here?"
                                                                },
                                                                {
                                                                    "id": "746910127",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "I don't have time to go around divining things like that, but I'm sure it won't be long."
                                                                },
                                                                {
                                                                    "id": "746910128",
                                                                    "speaker": "Paimon",
                                                                    "text": "Is that why you've set up this stall? So you can sit and wait for them to arrive?"
                                                                },
                                                                {
                                                                    "id": "746910129",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Don't worry, I'm not just sitting around twiddling my thumbs. This Dodoco is simply a stand-in — I'm still working on my research."
                                                                },
                                                                {
                                                                    "id": "746910130",
                                                                    "speaker": "Alice",
                                                                    "text": "That's right! And I installed sensors on Barbie's Dodoco. As soon as the right person shows up, she'll receive an instant notification."
                                                                },
                                                                {
                                                                    "id": "746910131",
                                                                    "speaker": "Alice",
                                                                    "text": "And Dodoco will give a happy little wiggle to make sure our visitors are drawn on in."
                                                                },
                                                                {
                                                                    "id": "746910132",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "What are you doing back here? Take your arm off that, you'll knock my Scryglass onto the floor! And hold that cup steady, I don't want you spilling hot chocolate on my manuscripts!"
                                                                },
                                                                {
                                                                    "id": "746910133",
                                                                    "speaker": "Alice",
                                                                    "text": "Alright, keep your hat on! Just one second... There you go. Barbie, this one's yours. I hardly put any sugar in it, I promise."
                                                                },
                                                                {
                                                                    "id": "746910134",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "When you say \"hardly any sugar,\" I can't help but feel like we're not speaking the same language..."
                                                                },
                                                                {
                                                                    "id": "746910135",
                                                                    "speaker": "Alice",
                                                                    "text": "Hahaha, back to business! After we've followed up on Barbie's divination, I was hoping to gather everyone up — everyone involved, that is — and throw a huge party."
                                                                },
                                                                {
                                                                    "id": "746910136",
                                                                    "speaker": "Alice",
                                                                    "text": "I've even decided how we can send out the invitations. Don't worry, I've already picked out the most beautiful birds available."
                                                                },
                                                                {
                                                                    "id": "746910137",
                                                                    "speaker": "Alice",
                                                                    "text": "Picture it... In the dead of night, a huge, pure-white bird flies through your window with a mysterious letter in its beak. Then you open it, and a whole new world appears before your eyes..."
                                                                },
                                                                {
                                                                    "id": "746910138",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "Unfortunately, as I told Alice, doing that would only serve to disrupt the path of fate. Besides, dealing with such small prophecies is a real pain, so it's off the cards."
                                                                },
                                                                {
                                                                    "id": "746910139",
                                                                    "speaker": "Alice",
                                                                    "text": "Fate is such a spoilsport! Nevertheless, we can still have a party. When the time is right, I'll invite everyone myself!"
                                                                },
                                                                {
                                                                    "id": "746910140",
                                                                    "speaker": "Alice",
                                                                    "text": "#And, as I do hate waiting for parties... {NICKNAME}, Paimon, can I leave the job of bringing your friends here to this stall to you?"
                                                                },
                                                                {
                                                                    "id": "746910141",
                                                                    "speaker": "Player",
                                                                    "text": "Is... Is that okay?"
                                                                },
                                                                {
                                                                    "id": "746910142",
                                                                    "speaker": "Paimon",
                                                                    "text": "Haha... Then we'd be the ones disrupting the path of fate, right?"
                                                                },
                                                                {
                                                                    "id": "746910143",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "#Hmm... Seeing as the people in the prophecy already have ties to {NICKNAME}, in theory, their fates are already intertwined..."
                                                                },
                                                                {
                                                                    "id": "746910144",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "#If {NICKNAME} steps in to invite them and hurry things along, it shouldn't have too large an effect on the divination..."
                                                                },
                                                                {
                                                                    "id": "746910145",
                                                                    "speaker": "Alice",
                                                                    "text": "Reliable as always! For the sake of the party, it's in your hands. I promise to save you the best seats — closest to the cake!"
                                                                },
                                                                {
                                                                    "id": "746910146",
                                                                    "speaker": "Alice",
                                                                    "text": "Barbie... Why are you tearing that paper apart? What are you doing?"
                                                                },
                                                                {
                                                                    "id": "746910147",
                                                                    "speaker": "Barbeloth",
                                                                    "text": "I'm using it to plug my ears. Between you and Nicole, if my head isn't hurting, then my ears are. Ugh! I miss Octavia..."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746910118",
                                                            "text": "Alice?"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746910106",
                                            "text": "The Dodocos have finally risen up..."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746910103",
                            "text": "You've probably just got Dodocos on the brain."
                        }
                    ]
                }
            ]
        }
    ]
}