            "dialogues": [
                {
                    "id": "4260101",
                    "speaker": "Paimon",
                    "text": "Gonna rest for a while. What's your plan?",
                    "choices": [
                        {
                            "id": "4260102",
                            "text": "I'm thinking of doing a quest.",
                            "response": [
                                {
                                    "id": "4260103",
                                    "speaker": "Paimon",
                                    "text": "That's easy! Just click on the exclamation mark at the top-left corner of the screen and you can view all the quests you have taken on so far."
                                },
                                {
                                    "id": "4260104",
                                    "speaker": "Paimon",
                                    "text": "Some quests are really hard, and there's no way you will be able to complete them until you reach the right level for that quest. If your level isn't high enough, you're too weak."
                                },
                                {
                                    "id": "4260117",
                                    "speaker": "Paimon",
                                    "text": "Anything else?",
                                    "choices": [
                                        {
                                            "id": "4260102",
                                            "text": "I'm thinking of doing a quest."
                                        },
                                        {
                                            "id": "4260105",
                                            "text": "Perhaps I should look around a bit more...",
                                            "response": [
                                                {
                                                    "id": "4260106",
                                                    "speaker": "Paimon",
                                                    "text": "Some areas are way more dangerous than others."
                                                },
                                                {
                                                    "id": "4260107",
                                                    "speaker": "Paimon",
                                                    "text": "You should train in some of the easier areas first, so you don't get beaten to a pulp so soon."
                                                },
                                                {
                                                    "id": "4260108",
                                                    "speaker": "Paimon",
                                                    "text": "Alfry of the Adventurers' Guild knows Teyvat like the back of her hand."
                                                },
                                                {
                                                    "id": "4260109",
                                                    "speaker": "Paimon",
                                                    "text": "She lives in downtown Mondstadt not far from the gate. You should go ask her about the areas that suit you."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4260110",
                                            "text": "I think I need to become stronger.",
                                            "response": [
                                                {
                                                    "id": "4260111",
                                                    "speaker": "Paimon",
                                                    "text": "Well, you can't get stronger without handy weapons or rare Artifacts."
                                                },
                                                {
                                                    "id": "4260112",
                                                    "speaker": "Paimon",
                                                    "text": "Heard there's a lot of 'em in dungeons, but they're dangerous places. You'll probably get hurt."
                                                },
                                                {
                                                    "id": "4260113",
                                                    "speaker": "Paimon",
                                                    "text": "But... if you're too chicken to earn them, you could always purchase them here in Mondstadt."
                                                },
                                                {
                                                    "id": "4260114",
                                                    "speaker": "Paimon",
                                                    "text": "Weapons and Artifacts can also be enhanced and ascended."
                                                },
                                                {
                                                    "id": "4260115",
                                                    "speaker": "Paimon",
                                                    "text": "But you'll have to figure out the rest by yourself."
                                                },
                                                {
                                                    "id": "4260116",
                                                    "speaker": "Paimon",
                                                    "text": "Oh yeah, suppose your own level is pretty important too..."
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4260118",
                                            "text": "I'm not sure yet... I need to think on it a bit more.",
                                            "response": [
