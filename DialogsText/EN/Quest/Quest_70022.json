        {
            "id": "7002201",
            "objective": "Talk to the other hilichurl willing to make conversation",
            "dialogues": [
                {
                    "id": "700220101",
                    "speaker": "Curious Hilichurl",
                    "text": "Odomu tomo? Kundala? Mosi mita?"
                },
                {
                    "id": "700220102",
                    "speaker": "Ella Musk",
                    "text": "Mimi tomo! Mosi mita!"
                },
                {
                    "id": "700220103",
                    "speaker": "Curious Hilichurl",
                    "text": "Tomo mosi mita! Tomo mani mimi?"
                },
                {
                    "id": "700220104",
                    "speaker": "Ella Musk",
                    "text": "Mimi mani ye! Plata yaya ika?"
                },
                {
                    "id": "700220105",
                    "speaker": "Curious Hilichurl",
                    "text": "Plata ika odomu! Zido mi! Mi muhe yeye! Mi mita yeye!"
                },
                {
                    "id": "700220106",
                    "speaker": "Paimon",
                    "text": "Seems like they're having a great conversation!",
                    "choices": [
                        {
                            "id": "700220107",
                            "text": "Look at this Hilichurlian scholar in action!",
                            "response": [
                                {
                                    "id": "700220109",
                                    "speaker": "Ella Musk",
                                    "text": "Haha, it said that it's very happy to make friends with us. But we need to do one small favor for it first..."
                                },
                                {
                                    "id": "700220110",
                                    "speaker": "Ella Musk",
                                    "text": "We need to help it defeat a challenging enemy. I've marked the location on the Map for you."
                                },
                                {
                                    "id": "700220111",
                                    "speaker": "Curious Hilichurl",
                                    "text": "Dada, Valo!"
                                },
                                {
                                    "id": "700220112",
                                    "speaker": "Ella Musk",
                                    "text": "Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700220108",
                            "text": "Things are getting lively..."
                        }
                    ]
                }
            ]
        },
        {
            "id": "7002202",
            "objective": "Go to the designated location for a fight",
            "dialogues": [
                {
                    "id": "700220201",
                    "speaker": "Curious Hilichurl",
                    "text": "Mosi mita! Yeye mimi dada tomo!"
                },
                {
                    "id": "700220202",
                    "speaker": "Curious Hilichurl",
                    "text": "Odomu tomo zido mi! <color=#00E1FFFF>Unta mosi dada</color>!"
                },
                {
                    "id": "700220203",
                    "speaker": "Paimon",
                    "text": "<color=#00E1FFFF>Unta mosi dada</color>... Paimon remembers that means... uh... umm...",
                    "choices": [
                        {
                            "id": "700220204",
                            "text": "Mosi mita dada!",
                            "response": [
                                {
                                    "id": "700220206",
                                    "speaker": "Curious Hilichurl",
                                    "text": "Valo, mi tomo!"
                                }
                            ]
                        },
                        {
                            "id": "700220205",
                            "text": "Tomo, valo!"
                        }
                    ]
                }
            ]
        },
        {
