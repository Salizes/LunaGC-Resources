    "talks": [
        {
            "id": "7565301",
            "objective": "",
            "dialogues": [
                {
                    "id": "756530201",
                    "speaker": "Xiangling",
                    "text": "#{NICKNAME}, it's you! Long time no see! Funny, I just mentioned you to Guoba yesterday, and here we are."
                },
                {
                    "id": "756530202",
                    "speaker": "Xiangling",
                    "text": "I guess that's what they call \"fate,\" huh?"
                },
                {
                    "id": "756530203",
                    "speaker": "Xiangling",
                    "text": "Ah, right. Where are you headed?",
                    "choices": [
                        {
                            "id": "756530204",
                            "text": "I was going to take a picture of this bridge.",
                            "response": [
                                {
                                    "id": "756530206",
                                    "speaker": "Xiangling",
                                    "text": "Photo-taking? Ooh, that's a coincidence. I've taken an interest in that lately myself."
                                },
                                {
                                    "id": "756530207",
                                    "speaker": "Xiangling",
                                    "text": "We've been using the same poster at the restaurant for so long. It's high time we got a new one."
                                },
                                {
                                    "id": "756530208",
                                    "speaker": "Xiangling",
                                    "text": "I've been thinking that we could draw passersby in more easily with some beautiful shots of our dishes."
                                },
                                {
                                    "id": "756530209",
                                    "speaker": "Xiangling",
                                    "text": "As the old saying goes: \"A fine meal is three parts color, three parts aroma, three parts taste, and one part advertising.\""
                                },
                                {
                                    "id": "756530210",
                                    "speaker": "Xiangling",
                                    "text": "...Of course, I added that last bit myself."
                                },
                                {
                                    "id": "756530211",
                                    "speaker": "Xiangling",
                                    "text": "Dad always talks about the first three — it's as common culinary wisdom as can be.",
                                    "choices": [
                                        {
                                            "id": "756530212",
                                            "text": "Hardworking as always, huh, Xiangling?",
                                            "response": [
                                                {
                                                    "id": "756530213",
                                                    "speaker": "Xiangling",
                                                    "text": "Hehe. Thanks!"
                                                },
                                                {
                                                    "id": "756530216",
                                                    "speaker": "Xiangling",
                                                    "text": "Finding rare ingredients, creating new dishes, learning how to advertise... I've still got a long way to go in my culinary journey."
                                                },
                                                {
                                                    "id": "756530217",
                                                    "speaker": "Xiangling",
                                                    "text": "Haha, now that you mention it, it's been a long time since our first meeting, hasn't it?"
                                                },
                                                {
                                                    "id": "756530218",
                                                    "speaker": "Xiangling",
                                                    "text": "But many things have stayed the same, too, haven't they? You're still traveling, and I'm still coming up with new dishes."
                                                },
                                                {
                                                    "id": "756530219",
                                                    "speaker": "Xiangling",
                                                    "text": "It's my goal not only to keep Wanmin Restaurant open, but to make it better and better."
                                                },
                                                {
                                                    "id": "756530220",
                                                    "speaker": "Xiangling",
                                                    "text": "So long as I've got strength in my arms, I'll be stir-frying and wok-tossing even when I'm an old granny, delivering delicious, piping hot dishes from pot to plate."
                                                },
                                                {
                                                    "id": "756530221",
                                                    "speaker": "Xiangling",
                                                    "text": "Remember to stop by for a meal more often, alright?",
                                                    "choices": [
                                                        {
                                                            "id": "756530222",
                                                            "text": "I will.",
                                                            "response": [
                                                                {
                                                                    "id": "756530223",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Alright then, it's a deal!"
                                                                },
                                                                {
                                                                    "id": "756530227",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Ah, right, I'm kinda getting off-topic here. You were talking about taking some pictures, right? Need any help?"
                                                                },
                                                                {
                                                                    "id": "756530228",
                                                                    "speaker": "Player",
                                                                    "text": "Yup. Step into the frame, please!"
                                                                },
                                                                {
                                                                    "id": "756530229",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Oh, sure, that's a piece of cake! What pose should I do?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756530230",
                                                                            "text": "Let's have a normal pose.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756530233",
                                                                                    "speaker": "Xiangling",
                                                                                    "text": "Like this?",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756530234",
                                                                                            "text": "Awesome. Say cheese!",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530235",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "I'm ready."
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530236",
                                                                                            "text": "The fun pose might work better.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530237",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Sure, let's go with that!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530238",
                                                                                            "text": "Let's go with the joyful pose instead, shall we?",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530239",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Sure, let's go with that!"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756530240",
                                                                                            "text": "Let's roll with the normal pose instead.",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756530241",
                                                                                                    "speaker": "Xiangling",
                                                                                                    "text": "Sure!"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756530231",
                                                                            "text": "A fun pose."
                                                                        },
                                                                        {
                                                                            "id": "756530232",
                                                                            "text": "A joyful pose."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756530224",
                                                            "text": "We'll see.",
                                                            "response": [
                                                                {
                                                                    "id": "756530225",
                                                                    "speaker": "Xiangling",
                                                                    "text": "Haha, are you worried that you won't be able to walk over by then?"
                                                                },
                                                                {
                                                                    "id": "756530226",
                                                                    "speaker": "Xiangling",
                                                                    "text": "If that's the case, just write to me — I'll send you some food that keeps easily."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756530214",
                                            "text": "Things haven't been too tiring, have they, Xiangling?",
                                            "response": [
                                                {
                                                    "id": "756530215",
                                                    "speaker": "Xiangling",
                                                    "text": "No way — if anything, my motivation grows the more I do things I enjoy."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756530205",
                            "text": "I'm looking for people to take photos with."
                        }
                    ]
                }
            ]
        }
    ]
}