    "talks": [
        {
            "id": "7418905",
            "objective": "",
            "dialogues": [
                {
                    "id": "741890501",
                    "speaker": "Permingeat",
                    "text": "One moment please. Would you like to hear a secret about the treasure?"
                },
                {
                    "id": "741890502",
                    "speaker": "Player",
                    "text": "What secret?"
                },
                {
                    "id": "741890503",
                    "speaker": "Permingeat",
                    "text": "It has to do with treasure and the key to opening the gate. How does that sound? Interested?",
                    "choices": [
                        {
                            "id": "741890504",
                            "text": "You're not asking me to fight monsters again, are you?",
                            "response": [
                                {
                                    "id": "741890506",
                                    "speaker": "Permingeat",
                                    "text": "Of course not! We wouldn't dream of asking tavern guests to run errands."
                                },
                                {
                                    "id": "741890507",
                                    "speaker": "Permingeat",
                                    "text": "See this naval artillery by my side and the rubble it's pointed at?"
                                },
                                {
                                    "id": "741890508",
                                    "speaker": "Permingeat",
                                    "text": "Activate the cannon and blow up those rocks, and any treasure you uncover is yours for the taking."
                                },
                                {
                                    "id": "741890509",
                                    "speaker": "Player",
                                    "text": "Who on Teyvat named that cannon?"
                                },
                                {
                                    "id": "741890510",
                                    "speaker": "Permingeat",
                                    "text": "The helmsman did. I'm not entirely sure myself where he acquired it.",
                                    "choices": [
                                        {
                                            "id": "741890511",
                                            "text": "Out with it. What parts are missing?",
                                            "response": [
                                                {
                                                    "id": "741890513",
                                                    "speaker": "Permingeat",
                                                    "text": "I think you've been misinformed, friend. The cannon is entirely intact and fully powered. I tend to it every day."
                                                },
                                                {
                                                    "id": "741890514",
                                                    "speaker": "Permingeat",
                                                    "text": "But before you activate the cannon, I would like you to answer several questions."
                                                },
                                                {
                                                    "id": "741890515",
                                                    "speaker": "Permingeat",
                                                    "text": "It's per the request from the helmsman. He called it a good source of amusement for guests at the tavern, something to slow down their drinking and keep them here longer."
                                                },
                                                {
                                                    "id": "741890516",
                                                    "speaker": "Player",
                                                    "text": "I'm not sure about this, but ask away."
                                                },
                                                {
                                                    "id": "741890517",
                                                    "speaker": "Permingeat",
                                                    "text": "Question 1: How many tables are there in The Rusty Rudder?"
                                                },
                                                {
                                                    "id": "741890518",
                                                    "speaker": "Permingeat",
                                                    "text": "Question 2: How many employees do we have at The Rusty Rudder?"
                                                },
                                                {
                                                    "id": "741890519",
                                                    "speaker": "Permingeat",
                                                    "text": "Question 3: What is not served in The Rusty Rudder?"
                                                },
                                                {
                                                    "id": "741890520",
                                                    "speaker": "Permingeat",
                                                    "text": "That's it. You only need to answer these three questions correctly to activate the cannon, blow up the rubble, and get the treasure."
                                                },
                                                {
                                                    "id": "741890521",
                                                    "speaker": "Player",
                                                    "text": "What will happen after I get the treasure?"
                                                },
                                                {
                                                    "id": "741890522",
                                                    "speaker": "Permingeat",
                                                    "text": "After that, I'll find the right time to place another suitable prize in the cave and seal it with rubble."
                                                },
                                                {
                                                    "id": "741890523",
                                                    "speaker": "Permingeat",
                                                    "text": "The treasure is waiting to be claimed once the next guest activates the artillery.",
                                                    "choices": [
                                                        {
                                                            "id": "741890524",
                                                            "text": "That's a lot of work for you.",
                                                            "response": [
                                                                {
                                                                    "id": "741890528",
                                                                    "speaker": "Permingeat",
                                                                    "text": "That's all. You may look for the answers now. Meanwhile, I'll stay here and wait for you."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890525",
                                                            "text": "Talk about a horrible boss.",
                                                            "response": [
                                                                {
                                                                    "id": "741890526",
                                                                    "speaker": "Permingeat",
                                                                    "text": "I find it hard to disagree with your remark, but I have yet to find a way to point the cannon at the helmsman without him detecting it."
                                                                },
                                                                {
                                                                    "id": "741890527",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Besides, rashly shooting in the wrong direction may harm other guests at the tavern, which stands in conflict with my moral principles."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741890512",
                                            "text": "Out with it. How is it powered?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741890505",
                            "text": "You're not asking me to find someone or something for you again, are you?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7418903",
            "objective": "",
            "dialogues": [
                {
                    "id": "741890301",
                    "speaker": "Permingeat",
                    "text": "All correct! Congratulations, you may activate the cannon."
                },
                {
                    "id": "741890302",
                    "speaker": "Permingeat",
                    "text": "Hold on a sec, let me cover my ears first."
                }
            ]
        },
        {
            "id": "7418904",
            "objective": "",
            "dialogues": [
                {
                    "id": "741890401",
                    "speaker": "Permingeat",
                    "text": "Have you found the answers to the questions? Let me remind you of the questions first."
                },
                {
                    "id": "741890402",
                    "speaker": "Permingeat",
                    "text": "Question 1: How many tables are there in The Rusty Rudder?"
                },
                {
                    "id": "741890403",
                    "speaker": "Permingeat",
                    "text": "Question 2: How many employees do we have at The Rusty Rudder?"
                },
                {
                    "id": "741890404",
                    "speaker": "Permingeat",
                    "text": "Question 3: What is not served in The Rusty Rudder?"
                },
                {
                    "id": "741890405",
                    "speaker": "Permingeat",
                    "text": "Are you ready to answer the questions?",
                    "choices": [
                        {
                            "id": "741890406",
                            "text": "We're ready.",
                            "response": [
                                {
                                    "id": "741890409",
                                    "speaker": "Permingeat",
                                    "text": "Then let's begin. First question. How many tables are there in The Rusty Rudder?",
                                    "choices": [
                                        {
                                            "id": "741890410",
                                            "text": "Three.",
                                            "response": [
                                                {
                                                    "id": "741890411",
                                                    "speaker": "Permingeat",
                                                    "text": "Correct! One step closer to activating the cannon."
                                                },
                                                {
                                                    "id": "741890414",
                                                    "speaker": "Permingeat",
                                                    "text": "Question 2: How many employees do we have at The Rusty Rudder?",
                                                    "choices": [
                                                        {
                                                            "id": "741890417",
                                                            "text": "One.",
                                                            "response": [
                                                                {
                                                                    "id": "741890425",
                                                                    "speaker": "Permingeat",
                                                                    "text": "I'm sorry to break it to you, but that's the wrong answer. Do you want to try again?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741890426",
                                                                            "text": "I'll do it again."
                                                                        },
                                                                        {
                                                                            "id": "741890427",
                                                                            "text": "Let me consider this further...",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741890428",
                                                                                    "speaker": "Permingeat",
                                                                                    "text": "Then I'll be waiting for your answers to my questions! You can find me right here whenever you're ready."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890415",
                                                            "text": "Three.",
                                                            "response": [
                                                                {
                                                                    "id": "741890416",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Correct! One step closer to activating the cannon."
                                                                },
                                                                {
                                                                    "id": "741890419",
                                                                    "speaker": "Permingeat",
                                                                    "text": "Question 3: What is not served in The Rusty Rudder?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741890420",
                                                                            "text": "Cheese."
                                                                        },
                                                                        {
                                                                            "id": "741890421",
                                                                            "text": "Romaritime Flower.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741890422",
                                                                                    "speaker": "Permingeat",
                                                                                    "text": "All correct! Congratulations, you may activate the cannon."
                                                                                },
                                                                                {
                                                                                    "id": "741890423",
                                                                                    "speaker": "Permingeat",
                                                                                    "text": "Hold on a sec, let me cover my ears first."
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741890424",
                                                                            "text": "Milk."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741890418",
                                                            "text": "I am your employee."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741890412",
                                            "text": "Two."
                                        },
                                        {
                                            "id": "741890413",
                                            "text": "There aren't any."
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741890407",
                            "text": "I still need to give it some more thought.",
                            "response": [
                                {
                                    "id": "741890408",
                                    "speaker": "Permingeat",
                                    "text": "Then I'll be waiting for your answers to my questions! You can find me right here whenever you're ready."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
