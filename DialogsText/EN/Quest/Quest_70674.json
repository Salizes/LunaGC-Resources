    "talks": [
        {
            "id": "7067401",
            "objective": "Talk to Honglang",
            "dialogues": [
                {
                    "id": "706740101",
                    "speaker": "Honglang",
                    "text": "Why is it in Mondstadt this time...",
                    "choices": [
                        {
                            "id": "706740102",
                            "text": "Honglang?",
                            "response": [
                                {
                                    "id": "706740104",
                                    "speaker": "Honglang",
                                    "text": "Traveler? What a coincidence! I didn't expect you to be here..."
                                },
                                {
                                    "id": "706740105",
                                    "speaker": "Honglang",
                                    "text": "As for the present situation... Well, just look at this door next to me. I suppose you already understand.",
                                    "choices": [
                                        {
                                            "id": "706740106",
                                            "text": "So a Domain of that kind has appeared again?",
                                            "response": [
                                                {
                                                    "id": "706740108",
                                                    "speaker": "Honglang",
                                                    "text": "That's right. Thanks to your help in investigating that other Domain, we were able to obtain all manner of important data."
                                                },
                                                {
                                                    "id": "706740109",
                                                    "speaker": "Honglang",
                                                    "text": "However, there wasn't any way of getting more useful information on that Domain from the outside. Not for lack of trying by the Guild, but still."
                                                },
                                                {
                                                    "id": "706740110",
                                                    "speaker": "Honglang",
                                                    "text": "As such, we were getting ready to send more people into it. We'd even called people from other Guilds in... but then it vanished."
                                                },
                                                {
                                                    "id": "706740111",
                                                    "speaker": "Honglang",
                                                    "text": "And that was the last we heard of it until it showed up today in Mondstadt. I only got here in time thanks to timely notice from our colleagues in Mondstadt."
                                                },
                                                {
                                                    "id": "706740112",
                                                    "speaker": "Player",
                                                    "text": "Have you started exploring it?"
                                                },
                                                {
                                                    "id": "706740113",
                                                    "speaker": "Honglang",
                                                    "text": "Of course. Why would I fall back with the prize before me?"
                                                },
                                                {
                                                    "id": "706740114",
                                                    "speaker": "Honglang",
                                                    "text": "The rules of this Domain haven't changed a great deal. It still creates various things based on the imaginations of those who enter it."
                                                },
                                                {
                                                    "id": "706740115",
                                                    "speaker": "Honglang",
                                                    "text": "But as we plumbed its depths, we found that this Domain is now able to create certain \"enemies.\""
                                                },
                                                {
                                                    "id": "706740116",
                                                    "speaker": "Honglang",
                                                    "text": "They would attack us, and we actually felt real pain when they did."
                                                },
                                                {
                                                    "id": "706740117",
                                                    "speaker": "Honglang",
                                                    "text": "How should I put this... It was no different from a real battle, which the other adventurers found rather interesting."
                                                },
                                                {
                                                    "id": "706740118",
                                                    "speaker": "Honglang",
                                                    "text": "However, some of them conjured foes they could not beat, and wound up needing help to beat them..."
                                                },
                                                {
                                                    "id": "706740119",
                                                    "speaker": "Honglang",
                                                    "text": "*cough* But never mind that. If you're willing, Traveler, could you explore this Domain together with us once again?",
                                                    "choices": [
                                                        {
                                                            "id": "706740120",
                                                            "text": "No problem.",
                                                            "response": [
                                                                {
                                                                    "id": "706740121",
                                                                    "speaker": "Honglang",
                                                                    "text": "Hahaha, wonderful, then! With your help, I'm sure that progress will be smooth indeed."
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706740122",
                                                            "text": "It won't be too dangerous, will it...",
                                                            "response": [
                                                                {
                                                                    "id": "706740123",
                                                                    "speaker": "Honglang",
                                                                    "text": "Um, I reckon you'll be fine. Just be cautious!"
                                                                },
                                                                {
                                                                    "id": "706740124",
                                                                    "speaker": "Honglang",
                                                                    "text": "Regardless, if you're willing to explore this Domain with us, I'm sure that progress will be smooth indeed."
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706740107",
                                            "text": "Is this the same sort of Domain as that other one you were investigating?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706740103",
                            "text": "This is..."
                        }
                    ]
                }
            ]
        }
    ]
}