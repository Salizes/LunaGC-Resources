{
    "quest": {
        "id": "21035",
        "title": "The Day the Sword Departs",
        "description": "Sun Yu, a disciple of the Guhua Clan, seems to be deep in thought about something...",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
