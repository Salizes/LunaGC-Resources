    "talks": [
        {
            "id": "2103501",
            "objective": "Talk to Sun Yu",
            "dialogues": [
                {
                    "id": "210350101",
                    "speaker": "Sun Yu",
                    "text": "*sigh* Que'er...",
                    "choices": [
                        {
                            "id": "210350102",
                            "text": "Sun Yu?",
                            "response": [
                                {
                                    "id": "210350104",
                                    "speaker": "Sun Yu",
                                    "text": "Traveler? What a coincidence! I didn't expect to see you here..."
                                },
                                {
                                    "id": "210350105",
                                    "speaker": "Sun Yu",
                                    "text": "I... I'm doing some training here, and I'm about to leave Liyue soon to travel abroad.",
                                    "choices": [
                                        {
                                            "id": "210350106",
                                            "text": "What's with the trip away all of a sudden?",
                                            "response": [
                                                {
                                                    "id": "210350108",
                                                    "speaker": "Sun Yu",
                                                    "text": "*sigh* Well, this is kind of embarrassing... I've long been talking about reviving the Guhua Clan, but what I've been doing all this time... This so-called \"seeking the guidance of the adepti\" is merely just me hanging about in Jueyun Karst..."
                                                },
                                                {
                                                    "id": "210350109",
                                                    "speaker": "Sun Yu",
                                                    "text": "Although I'm grateful to Que'er for her company, deep down I'm aware that such behavior is nothing but meaningless to the revival of the Guhua Clan..."
                                                },
                                                {
                                                    "id": "210350110",
                                                    "speaker": "Sun Yu",
                                                    "text": "Some time ago, when I was doing grocery shopping back in the city, I happened to have a conversation with a merchant from Fontaine."
                                                },
                                                {
                                                    "id": "210350111",
                                                    "speaker": "Sun Yu",
                                                    "text": "He said to me, \"You can't find the solution to a problem at the place of its occurrence.\""
                                                },
                                                {
                                                    "id": "210350112",
                                                    "speaker": "Sun Yu",
                                                    "text": "I've pondered over these words for quite a while. Perhaps, this Fontaine merchant was suggesting that I travel to places other than Liyue.",
                                                    "choices": [
                                                        {
                                                            "id": "210350113",
                                                            "text": "Traveling can be eye-opening.",
                                                            "response": [
                                                                {
                                                                    "id": "210350115",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "That's exactly what I thought! But... Que'er doesn't want to leave Liyue."
                                                                },
                                                                {
                                                                    "id": "210350116",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Usually, her bouts of temper aren't serious and can often even be meant in jest. It doesn't take much for me to placate her."
                                                                },
                                                                {
                                                                    "id": "210350117",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "But this time, she seemed to be really infuriated. No matter what I said, she refused to listen, and she even ran back to the city alone... *sigh*"
                                                                },
                                                                {
                                                                    "id": "210350118",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "But I'm not gonna bore you further with these trivial things. That aside, Traveler, can I ask you for a favor?"
                                                                },
                                                                {
                                                                    "id": "210350119",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Although I've learned some defensive techniques before, I hardly ever really tried my skills out. If I'm going to travel abroad, I'll definitely run into some sort of fight sooner or later..."
                                                                },
                                                                {
                                                                    "id": "210350120",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Traveler, I've heard many stories of you adventuring all over the world, and you must know a lot of ways to deal with monsters."
                                                                },
                                                                {
                                                                    "id": "210350121",
                                                                    "speaker": "Sun Yu",
                                                                    "text": "Can you accompany me to find some monsters around and fight them? You know, offer me some guidance along the way as well?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "210350122",
                                                                            "text": "No problem.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "210350125",
                                                                                    "speaker": "Sun Yu",
                                                                                    "text": "Let's see... There's one place where monsters gather right ahead. Let's go there first, shall we?"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "210350123",
                                                                            "text": "I'm afraid you can't see my moves clearly.",
                                                                            "response": [
                                                                                {
                                                                                    "id": "210350124",
                                                                                    "speaker": "Sun Yu",
                                                                                    "text": "Y—You are really that skilled? Hahaha, well, then please do me another favor and slow down a bit."
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "210350114",
                                                            "text": "Take it simply as a distraction even."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210350107",
                                            "text": "Aren't you going to revive the Guhua Clan?"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210350103",
                            "text": "What are you doing here?"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103502",
            "objective": "Defeat all opponents",
            "dialogues": [
                {
                    "id": "210350201",
                    "speaker": "Sun Yu",
                    "text": "*huff* That was tough..."
                },
                {
                    "id": "210350202",
                    "speaker": "Sun Yu",
                    "text": "I apologize. Look at me, making a fool of myself. I didn't expect that I would be so nervous when confronting real monsters..."
                },
                {
                    "id": "210350203",
                    "speaker": "Sun Yu",
                    "text": "Needless to say, I still need more training. Anyway, thank you, Traveler. Please, take these as your reward."
                },
                {
                    "id": "210350204",
                    "speaker": "Player",
                    "text": "Are you really leaving?"
                },
                {
                    "id": "210350205",
                    "speaker": "Sun Yu",
                    "text": "I haven't fully decided yet. I still need more time to think it through. Meanwhile, I'll see if I can convince Que'er to leave with me..."
                }
            ]
        },
        {
            "id": "2103503",
            "objective": "Talk to Sun Yu",
            "dialogues": []
        },
        {
            "id": "2103599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210359907",
                    "speaker": "Sun Yu",
                    "text": "This's the place. Let's do it!"
                }
            ]
        }
