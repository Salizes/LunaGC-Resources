    "talks": [
        {
            "id": "7370701",
            "objective": "",
            "dialogues": [
                {
                    "id": "737050101",
                    "speaker": "Collei",
                    "text": "#{NICKNAME}, Paimon! Over here!"
                },
                {
                    "id": "737050102",
                    "speaker": "Collei",
                    "text": "Welcome to the home base of the \"Fieldwise Center\"!"
                },
                {
                    "id": "737050103",
                    "speaker": "Collei",
                    "text": "As you can see, the core projects are already up and running, so we can get to work at any time!"
                },
                {
                    "id": "737050104",
                    "speaker": "Paimon",
                    "text": "Huh... This feels like... one of those places light novels talk about. Y'know, the adventuring hubs where rookies gather to take quests and stuff?"
                },
                {
                    "id": "737050105",
                    "speaker": "Paimon",
                    "text": "Oh! And almost like a school festival at the same time, with everyone getting together to learn and then forming teams to hone their skills... Hehe, it's so exciting!",
                    "choices": [
                        {
                            "id": "737050106",
                            "text": "Yeah, I'm pumped!",
                            "response": [
                                {
                                    "id": "737050108",
                                    "speaker": "Collei",
                                    "text": "Well, this place isn't quite as decked out as a school festival, but Master Tighnari said the Akademiya plans to be generous with the resources."
                                },
                                {
                                    "id": "737050109",
                                    "speaker": "Collei",
                                    "text": "Anyway, before students and researchers head out on dangerous field missions, they can come here for advice and emergency training..."
                                },
                                {
                                    "id": "737050110",
                                    "speaker": "Collei",
                                    "text": "We even have professionals on staff that can join their teams to serve as guides or safety personnel."
                                },
                                {
                                    "id": "737050111",
                                    "speaker": "Amber",
                                    "text": "Yeah, you can think of it like a \"Forward Operating Base\" — equal parts theoretical training and field practice!"
                                },
                                {
                                    "id": "737050112",
                                    "speaker": "Amber",
                                    "text": "We'll familiarize new recruits with potential challenges in the wild and take them through drills so there's no reason to panic during the real thing!"
                                },
                                {
                                    "id": "737050113",
                                    "speaker": "Paimon",
                                    "text": "Amber? You're here, too?",
                                    "choices": [
                                        {
                                            "id": "737050114",
                                            "text": "Is the Outrider getting new job responsibilities?",
                                            "response": [
                                                {
                                                    "id": "737050116",
                                                    "speaker": "Amber",
                                                    "text": "Haha, surprised? I know I was!"
                                                },
                                                {
                                                    "id": "737050117",
                                                    "speaker": "Amber",
                                                    "text": "I'm off duty right now, so I was planning to just drop in on Collei for a bit..."
                                                },
                                                {
                                                    "id": "737050118",
                                                    "speaker": "Amber",
                                                    "text": "But, I didn't realize how busy she'd be! I'm not the type of person to sit around and watch. So, I decided to be her assistant!"
                                                },
                                                {
                                                    "id": "737050119",
                                                    "speaker": "Collei",
                                                    "text": "Sorry, Amber. I didn't mean to put you to work during your time off..."
                                                },
                                                {
                                                    "id": "737050120",
                                                    "speaker": "Amber",
                                                    "text": "Don't worry about it! A little relaxation balanced out with some fulfilling work is a great vacation in my book! Plus, I've learned a whole bunch of stuff, too!"
                                                },
                                                {
                                                    "id": "737050121",
                                                    "speaker": "Amber",
                                                    "text": "#And, I got to see {NICKNAME} and Paimon again! I mean, it just keeps getting better!"
                                                },
                                                {
                                                    "id": "737050122",
                                                    "speaker": "Amber",
                                                    "text": "We should have a giant feast once we're done here. How does that sound?"
                                                },
                                                {
                                                    "id": "737050123",
                                                    "speaker": "Paimon",
                                                    "text": "Hehe, a feast with the first friend we met in Sumeru, and the first friend we met on our whole journey..."
                                                },
                                                {
                                                    "id": "737050124",
                                                    "speaker": "Paimon",
                                                    "text": "That sounds just about as awesome as a giant plate of Sticky Honey Roast!",
                                                    "choices": [
                                                        {
                                                            "id": "737050125",
                                                            "text": "Well, we should get this show on the road, then.",
                                                            "response": [
                                                                {
                                                                    "id": "737050127",
                                                                    "speaker": "Amber",
                                                                    "text": "Alright! Down to business, then..."
                                                                },
                                                                {
                                                                    "id": "737050128",
                                                                    "speaker": "Amber",
                                                                    "text": "Collei and I are in charge of the scouting speedsters project. The focus is using devices and machines to pass through hazardous areas, survey terrain, and get details on potential threats."
                                                                },
                                                                {
                                                                    "id": "737050129",
                                                                    "speaker": "Collei",
                                                                    "text": "Plus, Amurta research indicates that, during dangerous situations, having the support of an adorable companion can help set adventurers' minds at ease and prevent excess nerves..."
                                                                },
                                                                {
                                                                    "id": "737050130",
                                                                    "speaker": "Amber",
                                                                    "text": "So, we took inspiration from Cuilein-Anbar and Baron Bunny to create two scouting devices that are both adorable and useful — \"Cuilein An-bot\" and \"Bar-drone Bunny\". So far, feedback has been pretty positive!"
                                                                },
                                                                {
                                                                    "id": "737050131",
                                                                    "speaker": "Collei",
                                                                    "text": "Once we've collected enough data, the Akademiya will continue to refine the Scouting Buddies and release even more designs!"
                                                                },
                                                                {
                                                                    "id": "737050132",
                                                                    "speaker": "Paimon",
                                                                    "text": "A bunch of Cuilien-Anbars and Baron Bunnies running around the wilderness... What is that gonna look like?",
                                                                    "choices": [
                                                                        {
                                                                            "id": "737050133",
                                                                            "text": "Like a sight for sore eyes, no doubt!",
                                                                            "response": [
                                                                                {
                                                                                    "id": "737050135",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Plus, with you to guide our two little scouts, we'll be able to obtain some great data."
                                                                                },
                                                                                {
                                                                                    "id": "737050136",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Once you have a more complete understanding of the Fieldwise Center, you should come test them out."
                                                                                },
                                                                                {
                                                                                    "id": "737050137",
                                                                                    "speaker": "Collei",
                                                                                    "text": "Now, come with me. I'll introduce you to the other consultants."
                                                                                },
                                                                                {
                                                                                    "id": "737050138",
                                                                                    "speaker": "Amber",
                                                                                    "text": "Oh, yeah! The lady with the greenish-blue hair also has a super adorable device over there!"
                                                                                },
                                                                                {
                                                                                    "id": "737050139",
                                                                                    "speaker": "Amber",
                                                                                    "text": "But, it does something completely different than our scouting buddies."
                                                                                },
                                                                                {
                                                                                    "id": "737050140",
                                                                                    "speaker": "Amber",
                                                                                    "text": "I'm looking forward to seeing it in action!"
                                                                                },
                                                                                {
                                                                                    "id": "737050141",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "Oh, hey! Another familiar face!"
                                                                                },
                                                                                {
                                                                                    "id": "737050142",
                                                                                    "speaker": "Paimon",
                                                                                    "text": "C'mon! Let's go say hi!"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "737050134",
                                                                            "text": "It's kind of hard to picture..."
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737050126",
                                                            "text": "Let's work hard, so we can feast harder."
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050115",
                                            "text": "You've been calling in reinforcements from far and wide, Collei!"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050107",
                            "text": "What kind of light novels have you been reading, Paimon..."
                        }
                    ]
                }
            ]
        }
    ]
}