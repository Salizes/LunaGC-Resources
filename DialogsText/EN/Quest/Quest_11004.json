        {
            "id": "1100403",
            "objective": "Talk to Xiangling",
            "dialogues": [
                {
                    "id": "110040301",
                    "speaker": "Xiangling",
                    "text": "♪ Got myself a Cryo Regisvine, cook it up for dinner time... ♪"
                },
                {
                    "id": "110040302",
                    "speaker": "Paimon",
                    "text": "♪ Even better if it's paired with a bit of swine... ♪",
                    "choices": [
                        {
                            "id": "110040303",
                            "text": "Stop encouraging her!",
                            "response": [
                                {
                                    "id": "110040304",
                                    "speaker": "Xiangling",
                                    "text": "Lighten up a little! What in the world could bring more joy than finding rare ingredients?"
                                },
                                {
                                    "id": "110040307",
                                    "speaker": "Xiangling",
                                    "text": "Wait, there's something else here too!"
                                },
                                {
                                    "id": "110040308",
                                    "speaker": "Paimon",
                                    "text": "This must be the boar that hunter was chasing."
                                },
                                {
                                    "id": "110040309",
                                    "speaker": "Paimon",
                                    "text": "But Paimon's never seen one with this pattern before."
                                },
                                {
                                    "id": "110040310",
                                    "speaker": "Xiangling",
                                    "text": "Where have I seen this before? Hmm... Aha! It was in the \"Historia Naturalis Liyue\"!"
                                },
                                {
                                    "id": "110040311",
                                    "speaker": "Xiangling",
                                    "text": "This pattern is unmistakable. It belongs to a breed of boar that went extinct 300 years ago!"
                                },
                                {
                                    "id": "110040312",
                                    "speaker": "Paimon",
                                    "text": "Wow! How is this one still alive after so long!?",
                                    "choices": [
                                        {
                                            "id": "110040313",
                                            "text": "Accidental cryopreservation?",
                                            "response": [
                                                {
                                                    "id": "110040314",
                                                    "speaker": "Paimon",
                                                    "text": "Could be..."
                                                },
                                                {
                                                    "id": "110040317",
                                                    "speaker": "Xiangling",
                                                    "text": "I read that this boar was hunted to extinction because its meat was so highly prized."
                                                },
                                                {
                                                    "id": "110040318",
                                                    "speaker": "Xiangling",
                                                    "text": "Cryo Regisvine and extinct boar. Not one, but two priceless treasures!"
                                                },
                                                {
                                                    "id": "110040319",
                                                    "speaker": "Player",
                                                    "text": "This'll be our winning ticket."
                                                },
                                                {
                                                    "id": "110040320",
                                                    "speaker": "Xiangling",
                                                    "text": "Right. Now let's get back to Springvale!"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110040315",
                                            "text": "Won the genetic lottery?",
                                            "response": [
                                                {
                                                    "id": "110040316",
                                                    "speaker": "Paimon",
                                                    "text": "Paimon's pretty sure that's not really possible..."
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110040305",
                            "text": "♪ Wash 'em down with a glass of wine... ♪",
                            "response": [
                                {
                                    "id": "110040306",
                                    "speaker": "Xiangling",
                                    "text": "Hee-hee... Your version just ruins it."
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
